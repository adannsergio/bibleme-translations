\p
\v 3 \w Então ele foi|strong="H1980"\w* \w e tomou|strong="H3947"\w* \w a Gômer|strong="H1586"\w*, \w filha de|strong="H1323"\w* \w Diblaim|strong="H1691"\w*; \w e ela concebeu|strong="H2029"\w* \w e lhe|strong="H9033"\w* \add deu à\add* \w luz|strong="H3205"\w* \add um\add* \w filho|strong="H1121"\w*.\x - \xo 1:3 \xt ISA 8:3; HOS 3:1; EZK 4:1; ISA 8:1-3\x*
