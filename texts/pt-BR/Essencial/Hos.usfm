\v 8 \w Efraim|strong="H0669"\w*, \w o que tenho eu|strong="H4100,H9030"\w* \w mais|strong="H5750"\w* \w com os ídolos|strong="H6091"\w*? \w Eu|strong="H0589"\w* \w respondo|strong="H6030"\w* \w e cuido dele|strong="H7789"\w*; \w eu|strong="H0589"\w* \w sou como um cipreste|strong="H1265"\w* \w viçoso|strong="H7488"\w*; \w de mim|strong="H4480"\w* \w o seu fruto|strong="H6529"\w* \add é\add* \w encontrado|strong="H4672"\w*.\x - \xo 14:8 \xt JER 29:11; PSA 52:8; JHN 15:4; 2CO 6:16; PSA 23:3; GAL 5:22\x*
\q1
\v 9 \w Quem|strong="H4310"\w* \add é\add* \w sábio|strong="H2450"\w* \w que entenda|strong="H0995"\w* \add estas\add* \w coisas|strong="H0428"\w*, \w e discernimento|strong="H0995"\w* \w para que as conheça|strong="H3045"\w*? \w Porque|strong="H3588"\w* \w retos|strong="H3477"\w* \w são os caminhos|strong="H1870"\w* \w do SENHOR|strong="H3068"\w*, \w e os justos|strong="H6662"\w* \w andam|strong="H1980"\w* \w neles|strong="H9038"\w*, \w mas os transgressores|strong="H6586"\w* \w tropeçam|strong="H3782"\w* \w neles|strong="H9038"\w*.\x - \xo 14:9 \xt JER 29:11; PSA 107:43; ISA 55:8; ISA 44:18; PRO 10:29; PSA 119:1\x*
