\usfm 3.0
\ide UTF-8
\rem Essencial pt-BR 0.1 “Primícias” · © Contribuidores do projeto bibleme Traduções · CC BY 4.0 · https://www.bibleme.com.br/translations
\rem [IA-rascunho] Texto produzido por IA a partir do grego (SBLGNT), com revisão cruzada de agentes de IA especialistas (grego, português, teologia paulina, grupos de livros; piso de 3 revisões por capítulo). NÃO é revisão humana: material de risco até revisão humana e verificação pública de semelhança com traduções protegidas (RFC-0004 §6, pendente por falta de textos de referência locais). Strong e alinhamento: proposto.
\rem Texto-base: SBLGNT, SBL e Logos Bible Software, CC BY 4.0. Strong, lema e morfologia: STEPBible TAGNT, Tyndale House Cambridge e STEPBible.org, CC BY 4.0 (STEPBible.github.io/STEPBible-Data).
\rem Convenções gerais (valem para o texto todo, sem nota em cada versículo; lista completa em convencoes.md): 2ª pessoa do singular e do plural → “você/vocês”; presente histórico → pretérito; ἰδού → “olhe/olhem”; ἀμήν → “Em verdade” (início de fala) ou “Amém” (fim de oração); ἀποκριθεὶς εἶπεν → “respondeu”; ὅτι recitativo → aspas; ἀδελφοί → “irmãos e irmãs” quando o grupo inclui mulheres; moedas e medidas sem conversão.
\rem Notas de rodapé: Lit. (sentido literal ou alternativas), Variante (outras leituras do texto grego), Nota cultural (citações do AT e contexto), Acréscimo (palavra da tradução sem correspondente no grego), Não traduzido (palavra grega sem equivalente em português), Tradução (escolha contextual ou difícil). Referências cruzadas (\x): OpenBible, notas e paralelos de vocabulário.
\h Efésios
\toc1 Efésios
\toc2 Efésios
\mt1 Efésios
\c 1
\p
\v 1 \w Paulo|strong="G3972"\w*, \w apóstolo|strong="G652"\w*\f + \fr 1.1: \ft Lit.: Ἀπόστολος, “enviado”.\f* \w de Cristo Jesus|strong="G5547,G2424"\w* \w por vontade|strong="G1223,G2307"\w* \w de Deus|strong="G2316"\w*, \w aos santos|strong="G3588,G40"\w*\f + \fr 1.1: \ft Lit.: Ἅγιοι, “santos”: pessoas consagradas.\f* \w que estão|strong="G3588,G1510"\w* \w em Éfeso|strong="G1722,G2181"\w* \w e|strong="G2532"\w* \w fiéis|strong="G4103"\w* \w em Cristo Jesus|strong="G1722,G5547,G2424"\w*:\f + \fr 1.1: \ft Variante: “em Éfeso” (ἐν Ἐφέσῳ) está entre colchetes no SBLGNT e é omitido no apêndice de WH (WHapp); o RP traz a ordem “Jesus Cristo”.\f*\x - \xo 1:1 \xt COL 1:1; 2CO 1:1; COL 1:2; 1CO 1:1; GAL 1:1; 2TI 1:1\x*
\v 2 \w Graça|strong="G5485"\w* \w e|strong="G2532"\w* \w paz|strong="G1515"\w* \w a vocês|strong="G4771"\w* \w da parte de Deus|strong="G575,G2316"\w* \w nosso Pai|strong="G3962,G3165"\w* \w e|strong="G2532"\w* \w do Senhor|strong="G2962"\w* \w Jesus Cristo|strong="G2424,G5547"\w*.\x - \xo 1:2 \xt GAL 1:3; 1CO 1:3; PHM 1:3; 2CO 1:2; 2TH 1:2; PHP 1:2\x*
\p
\v 3 \w Bendito|strong="G2128"\w*\f + \fr 1.3: \ft Lit.: Εὐλογητός, “bendito, digno de louvor”: fórmula de louvor a Deus.\f* \w seja o|strong="G3588"\w* \w Deus|strong="G2316"\w* \w e|strong="G2532"\w* \w Pai|strong="G3962"\w* \w do nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus Cristo|strong="G2424,G5547"\w*, \w que nos abençoou|strong="G3588,G2127,G3165"\w* \w com toda|strong="G1722,G3956"\w* \w bênção|strong="G2129"\w* \w espiritual|strong="G4152"\w*\f + \fr 1.3: \ft Lit.: Πνευματικός, “espiritual”: do Espírito ou pertencente ao âmbito do Espírito.\f* \w nas regiões celestes|strong="G1722,G3588,G2032"\w*\f + \fr 1.3: \ft Lit.: Ἐν τοῖς ἐπουρανίοις, neutro plural: “nas (regiões, coisas) celestes”.\f* \w em Cristo|strong="G1722,G5547"\w*,\f + \fr 1.3: \ft Acréscimo: verbo ser/estar suprido em “seja o”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:3 \xt EPH 6:12; 1PE 1:3; 2CO 5:17; 2CO 1:3; EPH 2:6; PSA 68:19\x*
\v 4 \w assim como|strong="G2531"\w* \w nos escolheu|strong="G1586,G3165"\w* \w nele|strong="G1722,G846"\w* \w antes da fundação|strong="G4253,G2602"\w* \w do mundo|strong="G2889"\w*, \w para sermos|strong="G1511,G3165"\w* \w santos|strong="G40"\w* \w e|strong="G2532"\w* \w sem defeito|strong="G299"\w* \w diante dele|strong="G2714,G846"\w* \w em amor|strong="G1722,G26"\w*\f + \fr 1.4: \ft Lit.: Ἐν ἀγάπῃ: “em amor”; pode ligar-se a “santos e sem mancha” ou a “tendo destinado de antemão” (v. 5).\f*,\x - \xo 1:4 \xt 2TI 1:9; REV 13:8; ROM 8:29; 1PE 1:20; ROM 8:28-30; COL 1:22\x*
\v 5 \w tendo nos destinado de antemão|strong="G4309,G3165"\w* \w para a adoção como filhos|strong="G1519,G5206"\w*\f + \fr 1.5: \ft Lit.: Υἱοθεσία, “adoção como filhos”.\f* \w por meio de Jesus Cristo|strong="G1223,G2424,G5547"\w* \w para ele|strong="G1519,G846"\w*, \w conforme|strong="G2596"\w* \w o bom agrado|strong="G3588,G2107"\w* \w da vontade|strong="G3588,G2307"\w* \w dele|strong="G846"\w*\f + \fr 1.5: \ft Lit.: προορίζω, “destinar de antemão”; ver Rm 8:29.\f*,\x - \xo 1:5 \xt ROM 8:29; EPH 1:11; EPH 1:9; PHP 2:13; GAL 3:26; GAL 4:5\x*
\v 6 \w para louvor|strong="G1519,G1868"\w* \w da glória|strong="G1391"\w* \w da graça|strong="G3588,G5485"\w* \w dele|strong="G846"\w*, \w com a qual|strong="G3739"\w* \w nos agraciou|strong="G5487,G3165"\w* \w no Amado|strong="G1722,G3588,G25"\w*,\f + \fr 1.6: \ft Variante: o RP traz “na qual” (ἐν ᾗ) em lugar de “com a qual” (ἧς).\f*\x - \xo 1:6 \xt EPH 1:12; PHP 1:11; ISA 43:25; ROM 5:8; ISA 1:18; ROM 3:22-26\x*
\v 7 \w nele|strong="G1722,G3739"\w* \w temos|strong="G2192"\w* \w o resgate|strong="G3588,G629"\w* \w por meio do sangue|strong="G1223,G3588,G129"\w* \w dele|strong="G846"\w*, \w o perdão|strong="G3588,G859"\w* \w das transgressões|strong="G3588,G3900"\w*, \w segundo a riqueza|strong="G2596,G3588,G4149"\w* \w da graça|strong="G3588,G5485"\w* \w dele|strong="G846"\w*\x - \xo 1:7 \xt COL 1:14; ROM 3:24; HEB 9:22; MAT 26:28; 1PE 2:24; 1JN 1:7\x*
\v 8 \w a qual|strong="G3739"\w* \w transbordou|strong="G4052"\w* \w para nós|strong="G1519,G3165"\w* \w em toda|strong="G1722,G3956"\w* \w sabedoria|strong="G4678"\w* \w e|strong="G2532"\w* \w prudência|strong="G5428"\w*,\f + \fr 1.8: \ft Lit.: Φρόνησις, “prudência, inteligência prática”. Ἐν πάσῃ σοφίᾳ καὶ φρονήσει pode ligar-se a “transbordou” ou a “tendo dado a conhecer” (v. 9).\f*\x - \xo 1:8 \xt ISA 43:25; ROM 5:8; ISA 1:18; EXO 34:6; PSA 130:7; PSA 103:8\x*
\v 9 \w tendo dado a conhecer|strong="G1107"\w* \w a nós|strong="G3165"\w* \w o mistério|strong="G3588,G3466"\w* \w da vontade|strong="G3588,G2307"\w* \w dele|strong="G846"\w*, \w conforme|strong="G2596"\w* \w o bom agrado|strong="G3588,G2107"\w* \w dele|strong="G846"\w*, \w que ele propôs|strong="G3739,G4388"\w* \w nele|strong="G1722,G846"\w*\f + \fr 1.9: \ft Lit.: Ἐν αὐτῷ: “nele”; pode se referir a Cristo ou ao próprio Deus (ἐν αὑτῷ, “em si mesmo”).\f*,\x - \xo 1:9 \xt ROM 8:28; EPH 3:3; EPH 1:5; EPH 6:19; ISA 46:10; ISA 55:11\x*
\v 10 \w para uma administração|strong="G1519,G3622"\w* \w da plenitude|strong="G3588,G4138"\w* \w dos tempos|strong="G3588,G2540"\w*, \w reunir sob uma só cabeça|strong="G346"\w*\f + \fr 1.10: \ft Lit.: Ἀνακεφαλαιόω, “reunir sob uma só cabeça, resumir”; tem a mesma raiz de κεφαλή, “cabeça”.\f* \w todas as coisas|strong="G3588,G3956"\w* \w em Cristo|strong="G1722,G3588,G5547"\w*, \w as que estão|strong="G3588,G1909"\w* \w nos céus|strong="G3588,G3772"\w* \w e|strong="G2532"\w* \w as que estão|strong="G3588,G1909"\w* \w sobre a terra|strong="G3588,G1093"\w*, \w nele|strong="G1722,G846"\w*,\f + \fr 1.10: \ft Acréscimo: “as que estão”, “as que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 1:10 \xt ROM 8:28; 1CO 10:26; COL 1:20; ISA 46:10; COL 1:16; ISA 55:11\x*
\v 11 \w nele|strong="G1722,G3739"\w* \w também|strong="G2532"\w* \w recebemos uma herança|strong="G2820"\w*\f + \fr 1.11: \ft Lit.: Ἐκληρώθημεν, “fomos sorteados / recebemos uma porção”: pode ser “recebemos herança” ou “fomos feitos herança (de Deus)”.\f*, \w tendo sido destinados de antemão|strong="G4309"\w* \w conforme o propósito|strong="G2596,G4286"\w* \w daquele que opera|strong="G3588,G1754"\w* \w todas as coisas|strong="G3588,G3956"\w* \w segundo|strong="G2596"\w* \w o plano|strong="G3588,G1012"\w* \w da vontade|strong="G3588,G2307"\w* \w dele|strong="G846"\w*,\x - \xo 1:11 \xt EPH 1:5; ROM 8:28; ROM 8:29; ACT 4:28; PHP 2:13; PRO 19:21\x*
\v 12 \w para que|strong="G1519,G3588"\w* \w sejamos|strong="G1511,G3165"\w* \w para louvor|strong="G1519,G1868"\w* \w da glória|strong="G1391"\w* \w dele|strong="G846"\w*, \w nós que antes esperamos|strong="G3588,G4276"\w*\f + \fr 1.12: \ft Lit.: Προελπίζω, “esperar de antemão”; o grego não diz antes de quê.\f* \w em Cristo|strong="G1722,G3588,G5547"\w*;\x - \xo 1:12 \xt EPH 1:6; PRO 3:5; PHP 1:11; EPH 1:14; 1PE 1:21; JER 17:7\x*
\v 13 \w nele|strong="G1722,G3739"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w*, \w tendo ouvido|strong="G191"\w* \w a palavra|strong="G3588,G3056"\w* \w da verdade|strong="G3588,G225"\w*, \w a boa notícia|strong="G3588,G2098"\w* \w da salvação|strong="G3588,G4991"\w* \w de vocês|strong="G4771"\w*, \w nele|strong="G1722,G3739"\w* \w também|strong="G2532"\w* \w tendo crido|strong="G4100"\w*, \w foram selados|strong="G4972"\w* \w com o Espírito|strong="G3588,G4151"\w* \w Santo|strong="G3588,G40"\w* \w da promessa|strong="G3588,G1860"\w*,\x - \xo 1:13 \xt EPH 4:30; 2CO 1:22; ROM 1:16; 2TI 2:19; JAS 1:21; 2TI 2:15\x*
\v 14 \w o qual|strong="G3739"\w* \w é|strong="G1510"\w* \w garantia|strong="G728"\w*\f + \fr 1.14: \ft Lit.: Ἀρραβών, “penhor, primeira parcela de um pagamento que garante o restante”.\f* \w da nossa herança|strong="G3588,G2817,G3165"\w*, \w para o resgate|strong="G1519,G629"\w* \w da posse|strong="G3588,G4047"\w*\f + \fr 1.14: \ft Lit.: Περιποίησις, “aquisição, posse”, também “preservação”.\f*, \w para louvor|strong="G1519,G1868"\w* \w da glória|strong="G3588,G1391"\w* \w dele|strong="G846"\w*.\f + \fr 1.14: \ft Variante: Treg e o RP trazem ὅς (“o qual”, masculino, concordando com “Espírito”) em lugar de ὅ (“que”, neutro).\f*\x - \xo 1:14 \xt EPH 1:12; PHP 1:11; EPH 4:30; 2CO 1:22; 2CO 5:5; JHN 4:14\x*
\p
\v 15 \w Por isso|strong="G1223,G3778"\w* \w eu também|strong="G2532_A,G1473"\w*, \w tendo ouvido|strong="G191"\w* \w da fé|strong="G3588,G4102"\w* \w que há entre vocês|strong="G2596,G4771"\w* \w no Senhor|strong="G1722,G3588,G2962"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w do amor|strong="G3588,G26"\w* \w que têm|strong="G3588"\w* \w por todos|strong="G1519,G3956"\w* \w os santos|strong="G3588,G40"\w*,\f + \fr 1.15: \ft Variante: WH omite “o amor que” (ἀγάπην τὴν): lê-se “a fé… no Senhor Jesus e por todos os santos”.\f*\f + \fr 1.15: \ft Acréscimo: “que há entre vocês”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 1:15 \xt COL 1:4; PHM 1:5; 1TI 1:14; COL 1:9; PHP 1:3; JHN 14:1\x*
\v 16 \w não paro|strong="G3756,G3973"\w* \w de agradecer|strong="G2168"\w* \w por vocês|strong="G5228,G4771"\w*, \w fazendo menção|strong="G3417,G4160"\w* \w nas minhas orações|strong="G1909,G3588,G4335,G3165"\w*,\f + \fr 1.16: \ft Variante: o RP acrescenta “de vocês” (ὑμῶν) depois de “menção”.\f*\x - \xo 1:16 \xt PHP 1:3; PHM 1:4; 1TH 1:2; EPH 6:18; COL 1:9; EPH 3:14\x*
\v 17 \w para que|strong="G2443"\w* \w Deus|strong="G3588,G2316"\w* \w do nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus Cristo|strong="G2424,G5547"\w*, \w o Pai|strong="G3588,G3962"\w* \w da glória|strong="G3588,G1391"\w*, \w dê|strong="G1325"\w* \w a vocês|strong="G4771"\w* \w espírito|strong="G4151"\w*\f + \fr 1.17: \ft Lit.: Πνεῦμα: “espírito” ou “Espírito”; aqui, lido como disposição dada por Deus.\f* \w de sabedoria|strong="G4678"\w* \w e|strong="G2532"\w* \w de revelação|strong="G602"\w* \w no conhecimento|strong="G1722,G1922"\w* \w dele|strong="G846"\w*,\x - \xo 1:17 \xt COL 1:9; ISA 11:2; JAS 3:17-18; PRO 2:6; PRO 2:5; COL 3:16\x*
\v 18 \w com os olhos|strong="G3588,G3788"\w* \w do coração|strong="G3588,G2588"\w* \w de vocês|strong="G4771"\w* \w iluminados|strong="G5461"\w*, \w para que saibam|strong="G1519,G3588,G6063,G4771"\w* \w qual é|strong="G5101,G1510"\w* \w a esperança|strong="G3588,G1680"\w* \w do chamado|strong="G3588,G2821"\w* \w dele|strong="G846"\w*, \w qual é|strong="G5101"\w* \w a riqueza|strong="G3588,G4149"\w* \w da glória|strong="G3588,G1391"\w* \w da herança|strong="G3588,G2817"\w* \w dele|strong="G846"\w* \w entre os santos|strong="G1722,G3588,G40"\w*,\f + \fr 1.18: \ft Variante: o RP acrescenta “e” (καί) antes do segundo “qual é”.\f*\f + \fr 1.18: \ft Acréscimo: verbo ser/estar suprido em “qual é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:18 \xt COL 1:27; EPH 4:4; PHP 4:19; ROM 12:2; ACT 26:18; PRO 2:6\x*
\v 19 \w e|strong="G2532"\w* \w qual é|strong="G5101"\w* \w a imensa grandeza|strong="G3588,G5235,G3174"\w* \w do poder|strong="G3588,G1411"\w* \w dele|strong="G846"\w* \w para conosco|strong="G1519,G3165"\w*, \w os que creem|strong="G3588,G4100"\w*, \w segundo|strong="G2596"\w* \w a ação|strong="G3588,G1753"\w* \w da força|strong="G3588,G2904"\w* \w do vigor|strong="G3588,G2479"\w* \w dele|strong="G846"\w*\f + \fr 1.19: \ft Acréscimo: verbo ser/estar suprido em “qual é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:19 \xt EPH 6:10; EPH 3:20; EPH 3:7; COL 1:29; ROM 8:11; 2PE 1:3\x*
\v 20 \w a qual|strong="G3739"\w* \w ele operou|strong="G1754"\w* \w em Cristo|strong="G1722,G3588,G5547"\w*, \w ressuscitando-o|strong="G1453,G846"\w* \w dentre os mortos|strong="G1537,G3498"\w* \w e|strong="G2532"\w* \w fazendo-o sentar|strong="G2523"\w* \w à sua direita|strong="G1722,G1188,G846"\w* \w nas regiões celestes|strong="G1722,G3588,G2032"\w*\f + \fr 1.20: \ft Variante: WH traz o perfeito ἐνήργηκεν (“tem operado”); Treg, NA28 e o RP trazem o aoristo ἐνήργησεν (“operou”). O RP traz “dentre os mortos” com artigo (ἐκ τῶν νεκρῶν) e o verbo finito ἐκάθισεν (“sentou”) em lugar do particípio καθίσας.\f*\x - \xo 1:20 \xt MRK 16:19; ROM 8:11; MAT 28:18; PSA 110:1; 2PE 1:3; MAT 11:27\x*
\v 21 \w muito acima|strong="G5231"\w* \w de todo governo|strong="G3956,G746"\w* \w e|strong="G2532"\w* \w autoridade|strong="G1849"\w* \w e|strong="G2532"\w* \w poder|strong="G1411"\w* \w e|strong="G2532"\w* \w senhorio|strong="G2963"\w* \w e|strong="G2532"\w* \w de todo nome|strong="G3956,G3686"\w* \w que se nomeia|strong="G3687"\w*, \w não só|strong="G3756,G3441"\w* \w nesta era|strong="G1722,G3588,G165,G3778"\w* \w mas também|strong="G235,G2532"\w* \w na que há de vir|strong="G1722,G3588,G3195"\w*;\x - \xo 1:21 \xt COL 1:16; EPH 6:12; MAT 28:18; PSA 110:1; 2PE 1:3; MAT 11:27\x*
\v 22 \w e|strong="G2532"\w* \w sujeitou|strong="G5293"\w* \w todas as coisas|strong="G3956"\w* \w debaixo|strong="G5259"\w* \w dos pés|strong="G3588,G4228"\w* \w dele|strong="G846"\w*\f + \fr 1.22: \ft Nota cultural: Eco do Salmo 8:6 (8:7 no grego): todas as coisas sob os pés.\f*, \w e|strong="G2532"\w* \w o deu|strong="G846,G1325"\w* \w como cabeça|strong="G2776"\w* \w sobre todas as coisas|strong="G5228,G3956"\w* \w à comunidade|strong="G3588,G1577"\w*,\f + \fr 1.22: \ft Lit.: Ὑπὲρ πάντα: “acima de todas as coisas” ou “no tocante a tudo”.\f*\x - \xo 1:22 \xt PSA 8:6; COL 1:18; 1CO 15:27; EPH 5:23; MAT 28:18; PSA 110:1\x*
\v 23 \w a qual|strong="G3748"\w* \w é|strong="G1510"\w* \w o corpo|strong="G3588,G4983"\w* \w dele|strong="G846"\w*, \w a plenitude|strong="G3588,G4138"\w* \w daquele que|strong="G3588"\w* \w preenche|strong="G4137"\w*\f + \fr 1.23: \ft Lit.: Πληρουμένου: voz média ou passiva; pode ser “está sendo preenchido” ou “preenche (para si)”.\f* \w todas as coisas|strong="G3588,G3956"\w* \w em todos|strong="G1722,G3956"\w*.\x - \xo 1:23 \xt EPH 3:19; COL 1:18; MAT 11:27; PHP 2:9; COL 1:19; COL 2:10\x*
\c 2
\p
\v 1 \w E|strong="G2532"\w* \w vocês|strong="G4771"\w*, \w que estavam|strong="G1510"\w* \w mortos|strong="G3498"\w* \w nas transgressões|strong="G3588,G3900"\w* \w e|strong="G2532"\w* \w nos pecados|strong="G3588,G266"\w* \w de vocês|strong="G4771"\w*,\x - \xo 2:1 \xt COL 2:13; EPH 2:5; ROM 5:20; ROM 5:6; COL 3:1-4; GEN 6:5\x*
\v 2 \w nos quais|strong="G1722,G3739"\w* \w outrora|strong="G4218"\w* \w viveram|strong="G4043"\w* \w segundo a era|strong="G2596,G3588,G165"\w* \w deste mundo|strong="G3588,G2889,G3778"\w*, \w segundo o governante|strong="G2596,G3588,G758"\w* \w da autoridade|strong="G3588,G1849"\w*\f + \fr 2.2: \ft Lit.: Ἐξουσία, “autoridade”, também “domínio, esfera de poder”.\f* \w do ar|strong="G3588,G109"\w*, \w do espírito|strong="G3588,G4151"\w* \w que agora|strong="G3588,G3568"\w* \w opera|strong="G1754"\w* \w nos filhos|strong="G1722,G3588,G5207"\w* \w da desobediência|strong="G3588,G543"\w*;\x - \xo 2:2 \xt EPH 6:12; JHN 12:31; JHN 14:30; ROM 12:2; ROM 11:30; EPH 5:8\x*
\v 3 \w entre os quais|strong="G1722,G3739"\w*\f + \fr 2.3: \ft Lit.: Ἐν οἷς: “entre os quais” ou “nos quais”.\f* \w também|strong="G2532"\w* \w nós|strong="G3165"\w* \w todos|strong="G3956"\w* \w vivemos|strong="G390"\w* \w outrora|strong="G4218"\w* \w nos desejos|strong="G1722,G3588,G1939"\w* \w da nossa|strong="G3588,G3165"\w* \w carne|strong="G4561"\w*, \w fazendo|strong="G4160"\w* \w as vontades|strong="G3588,G2307"\w* \w da carne|strong="G3588,G4561"\w* \w e|strong="G2532"\w* \w dos pensamentos|strong="G3588,G1271"\w*, \w e|strong="G2532"\w* \w éramos|strong="G1510"\w* \w por natureza|strong="G5449"\w* \w filhos|strong="G5043"\w* \w de ira|strong="G3709"\w*\f + \fr 2.3: \ft Lit.: Τέκνα… ὀργῆς: “filhos de ira”, semitismo para quem está sujeito à ira.\f*, \w como também|strong="G5613,G2532"\w* \w os demais|strong="G3588,G3062"\w*;\x - \xo 2:3 \xt 1PE 4:2; ROM 5:6; PSA 14:3; GAL 5:16; GEN 6:5; TIT 3:3\x*
\v 4 \w mas|strong="G1161"\w* \w Deus|strong="G3588,G2316"\w*, \w sendo rico|strong="G4145,G1510"\w* \w em misericórdia|strong="G1722,G1656"\w*, \w por causa|strong="G1223"\w* \w do muito amor|strong="G3588,G4183,G26"\w* \w dele|strong="G846"\w* \w com que nos amou|strong="G3739,G25,G3165"\w*,\x - \xo 2:4 \xt 1JN 4:8; 1JN 4:10; JHN 3:16; ROM 5:6; PHP 1:6; 1PE 1:3\x*
\v 5 \w mesmo|strong="G2532"\w* \w estando nós|strong="G1510,G3165"\w* \w mortos|strong="G3498"\w* \w nas transgressões|strong="G3588,G3900"\w*, \w nos deu vida junto|strong="G4806"\w* \w com Cristo|strong="G3588,G5547"\w* — \w pela graça|strong="G5485"\w* \w vocês estão|strong="G1510"\w* \w salvos|strong="G4982"\w*\f + \fr 2.5: \ft Lit.: Σεσῳσμένοι ἐστέ, perfeito perifrástico: “foram e continuam salvos”.\f*—\x - \xo 2:5 \xt EPH 2:8; EPH 2:1; COL 2:13; ROM 5:6; PHP 1:6; 1JN 4:10\x*
\v 6 \w e|strong="G2532"\w* \w nos ressuscitou com ele|strong="G4891"\w* \w e|strong="G2532"\w* \w nos fez sentar com ele|strong="G4776"\w* \w nas regiões celestes|strong="G1722,G3588,G2032"\w* \w em Cristo Jesus|strong="G1722,G5547,G2424"\w*,\x - \xo 2:6 \xt COL 3:1; EPH 1:3; PHP 1:6; ROM 12:1; COL 2:12; EPH 2:1\x*
\v 7 \w para que|strong="G2443"\w* \w mostrasse|strong="G1731"\w* \w nas eras|strong="G1722,G3588,G165"\w* \w que vêm|strong="G3588,G1904"\w* \w a imensa riqueza|strong="G3588,G5235,G4149"\w* \w da graça|strong="G3588,G5485"\w* \w dele|strong="G846"\w* \w em bondade|strong="G1722,G5544"\w* \w para conosco|strong="G1909,G3165"\w* \w em Cristo Jesus|strong="G1722,G5547,G2424"\w*.\x - \xo 2:7 \xt ROM 5:8; PHP 1:6; ROM 12:1; JHN 6:44; TIT 3:4; JHN 1:16\x*
\v 8 \w Pois|strong="G1063"\w* \w pela graça|strong="G3588,G5485"\w* \w vocês estão|strong="G1510"\w* \w salvos|strong="G4982"\w* \w por meio da fé|strong="G1223,G4102"\w*; \w e|strong="G2532"\w* \w isto|strong="G3778"\w* \w não vem|strong="G3756,G1537"\w* \w de vocês|strong="G4771"\w*\f + \fr 2.8: \ft Lit.: Τοῦτο, neutro: “isto” pode se referir a toda a frase, à salvação ou à fé; “graça” e “fé” são femininos e não concordam em gênero com o pronome.\f*, \w de Deus|strong="G2316"\w* \w é o dom|strong="G3588,G1435"\w*;\f + \fr 2.8: \ft Acréscimo: verbo ser/estar suprido em “é o dom”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:8 \xt EPH 2:5; LUK 7:50; JHN 1:12-13; ROM 3:22-26; ROM 4:16; TIT 3:5\x*
\v 9 \w não vem de|strong="G3756,G1537"\w* \w obras|strong="G2041"\w*, \w para que|strong="G2443"\w* \w ninguém|strong="G3361,G5100"\w* \w se glorie|strong="G2744"\w*\f + \fr 2.9: \ft Lit.: καυχάομαι e família (καύχημα, καύχησις): “gloriar-se”; também “orgulhar-se”, “vangloriar-se”, “gabar-se” e “alegrar-se com confiança”. O sentido vai do positivo (confiança, motivo de alegria) ao negativo (jactância), conforme o contexto.\f*.\x - \xo 2:9 \xt TIT 3:5; LUK 7:50; 2TI 1:9; PHP 1:6; ROM 12:1; 2CO 4:7\x*
\v 10 \w Pois|strong="G1063"\w* \w somos|strong="G1510"\w* \w feitura|strong="G4161"\w*\f + \fr 2.10: \ft Lit.: Ποίημα, “coisa feita, obra (de artesão)”.\f* \w dele|strong="G846"\w*, \w criados|strong="G2936"\w* \w em Cristo Jesus|strong="G1722,G5547,G2424"\w* \w para boas obras|strong="G1909,G2041,G18"\w*, \w as quais|strong="G3739"\w* \w Deus|strong="G3588,G2316"\w* \w preparou de antemão|strong="G4282"\w*, \w para que|strong="G2443"\w* \w nelas|strong="G1722,G846"\w* \w vivamos|strong="G4043"\w*.\x - \xo 2:10 \xt 2CO 5:17; 2CO 9:8; COL 1:10; EPH 4:24; HEB 13:21; PHP 1:6\x*
\p
\v 11 \w Por isso|strong="G1352"\w* \w lembrem-se|strong="G3421"\w* \w de que|strong="G3754"\w* \w outrora|strong="G4218"\w* \w vocês|strong="G4771"\w*, \w os gentios|strong="G3588,G1484"\w*\f + \fr 2.11: \ft Lit.: Ἔθνη, “nações”; aqui, os povos não judeus (gentios), em contraste com a circuncisão.\f* \w na carne|strong="G1722,G4561"\w*, \w chamados|strong="G3588,G3004"\w* \w incircuncisão|strong="G203"\w* \w por aquela|strong="G5259,G3588"\w* \w chamada|strong="G3004"\w* \w circuncisão|strong="G4061"\w* \w na carne|strong="G1722,G4561"\w* \w feita por mãos|strong="G5499"\w*,\x - \xo 2:11 \xt COL 2:11; COL 2:13; ROM 11:17; COL 3:11; MAT 8:11; ROM 2:28-29\x*
\v 12 \w que vocês estavam|strong="G3754,G1510"\w* \w naquele tempo|strong="G3588,G2540,G1565"\w* \w sem Cristo|strong="G5565,G5547"\w*, \w afastados|strong="G526"\w* \w da cidadania|strong="G3588,G4174"\w*\f + \fr 2.12: \ft Lit.: Πολιτεία, “cidadania, comunidade cívica”; compare πολίτευμα em Fp 3:20.\f* \w de Israel|strong="G3588,G2474"\w* \w e|strong="G2532"\w* \w estrangeiros|strong="G3581"\w* \w às alianças|strong="G3588,G1242"\w* \w da promessa|strong="G3588,G1860"\w*, \w sem ter|strong="G3361,G2192"\w* \w esperança|strong="G1680"\w* \w e|strong="G2532"\w* \w sem Deus|strong="G112"\w* \w no mundo|strong="G1722,G3588,G2889"\w*.\x - \xo 2:12 \xt PHP 3:20; COL 1:21; GAL 4:8; EPH 4:18; ROM 9:4; 1PE 1:3\x*
\v 13 \w Mas agora|strong="G3570,G1161"\w* \w em Cristo Jesus|strong="G1722,G5547,G2424"\w* \w vocês|strong="G4771"\w*, \w que outrora|strong="G3739,G4218"\w* \w estavam|strong="G1510"\w* \w longe|strong="G3112"\w*, \w ficaram perto|strong="G1096,G1451"\w* \w pelo sangue|strong="G1722,G3588,G129"\w* \w de Cristo|strong="G3588,G5547"\w*.\x - \xo 2:13 \xt EPH 2:17; ACT 2:39; GAL 3:28; COL 1:20; ROM 5:9; COL 1:13-14\x*
\v 14 \w Pois|strong="G1063"\w* \w ele|strong="G846"\w* \w é|strong="G1510"\w* \w a nossa paz|strong="G3588,G1515,G3165"\w*, \w aquele que|strong="G3588"\w* \w fez|strong="G4160"\w* \w os dois|strong="G3588,G297"\w*\f + \fr 2.14: \ft Lit.: Ἀμφότερα, neutro plural: “as duas coisas”; aqui, os dois grupos.\f* \w um|strong="G1520"\w* \w e|strong="G2532"\w* \w derrubou|strong="G3089"\w* \w o muro|strong="G3588,G3320"\w* \w da separação|strong="G3588,G5418"\w*\f + \fr 2.14: \ft Lit.: Μεσότοιχον τοῦ φραγμοῦ: “o muro do meio da cerca”: o muro que é a barreira.\f*, \w a inimizade|strong="G3588,G2189"\w* \w na carne|strong="G1722,G3588,G4561"\w* \w dele|strong="G846"\w*,\f + \fr 2.14: \ft Lit.: Τὴν ἔχθραν pode ser aposto de “muro” ou objeto de “tendo anulado” (v. 15).\f*\x - \xo 2:14 \xt ISA 26:3; COL 2:14; JHN 16:33; GAL 3:28; ISA 9:6; COL 1:20\x*
\v 15 \w a lei|strong="G3588,G3551"\w* \w dos mandamentos|strong="G3588,G1785"\w* \w em decretos|strong="G1722,G1378"\w* \w tendo anulado|strong="G2673"\w*, \w para que|strong="G2443"\w* \w criasse|strong="G2936"\w* \w os dois|strong="G3588,G1417"\w* \w em si mesmo|strong="G1722,G1438"\w* \w em um só|strong="G1519,G1520"\w* \w novo|strong="G2537"\w* \w ser humano|strong="G444"\w*, \w fazendo|strong="G4160"\w* \w paz|strong="G1515"\w*,\f + \fr 2.15: \ft Variante: o SBLGNT e WH trazem αὑτῷ (“em si mesmo”); Treg e NA28 trazem αὐτῷ (“nele”); o RP traz ἑαυτῷ (“em si mesmo”).\f*\x - \xo 2:15 \xt 2CO 5:17; EPH 4:24; ISA 26:3; COL 2:14; JHN 16:33; ISA 9:6\x*
\v 16 \w e|strong="G2532"\w* \w reconciliasse|strong="G604"\w* \w os dois|strong="G3588,G297"\w* \w em um só corpo|strong="G1722,G1520,G4983"\w* \w com Deus|strong="G3588,G2316"\w* \w por meio da cruz|strong="G1223,G3588,G4716"\w*, \w tendo matado|strong="G615"\w* \w a inimizade|strong="G3588,G2189"\w* \w nela|strong="G1722,G846"\w*;\f + \fr 2.16: \ft Lit.: Ἐν αὐτῷ: “nela” (a cruz) ou “nele” (Cristo).\f*\x - \xo 2:16 \xt COL 1:20; ISA 26:3; COL 2:14; JHN 16:33; ISA 9:6; GAL 3:28\x*
\v 17 \w e|strong="G2532"\w* \w tendo vindo|strong="G2064"\w*, \w anunciou como boa notícia|strong="G2097"\w* \w paz|strong="G1515"\w* \w a vocês|strong="G4771"\w* \w que estavam|strong="G3588"\w* \w longe|strong="G3112"\w* \w e|strong="G2532"\w* \w paz|strong="G1515"\w* \w aos que estavam|strong="G3588"\w* \w perto|strong="G1451"\w*;\f + \fr 2.17: \ft Variante: o RP omite a segunda ocorrência de “paz” (εἰρήνην).\f*\f + \fr 2.17: \ft Acréscimo: verbo ser/estar suprido em “aos que estavam”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula; “que estavam”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 2:17 \xt EPH 2:13; ACT 10:36; JHN 16:33; ISA 9:6; GAL 3:28; ROM 10:15\x*
\v 18 \w porque|strong="G3754"\w* \w por meio dele|strong="G1223,G846"\w* \w temos|strong="G2192"\w* \w o acesso|strong="G3588,G4318"\w*, \w nós, os dois|strong="G3588,G297"\w*, \w em um só|strong="G1722,G1520"\w* \w Espírito|strong="G4151"\w*\f + \fr 2.18: \ft Lit.: Ἐν ἑνὶ πνεύματι: “em um só Espírito” ou “em um só espírito”.\f* \w ao Pai|strong="G4314,G3588,G3962"\w*.\x - \xo 2:18 \xt JHN 14:6; JHN 10:9; ROM 8:26; HEB 4:16; ROM 5:2; MAT 28:19\x*
\p
\v 19 \w Portanto|strong="G686,G3767"\w*, \w já não são|strong="G2089,G3756,G1510"\w* \w estrangeiros|strong="G3581"\w* \w e|strong="G2532"\w* \w residentes temporários|strong="G3941"\w*, \w mas|strong="G235"\w* \w são|strong="G1510"\w* \w concidadãos|strong="G4847"\w* \w dos santos|strong="G3588,G40"\w* \w e|strong="G2532"\w* \w membros da casa|strong="G3609"\w* \w de Deus|strong="G3588,G2316"\w*,\x - \xo 2:19 \xt GAL 6:10; MAT 16:18; PHP 3:20; GAL 3:28; 1JN 3:1; GAL 3:26-28\x*
\v 20 \w edificados|strong="G2026"\w* \w sobre o alicerce|strong="G1909,G3588,G2310"\w* \w dos apóstolos|strong="G3588,G652"\w* \w e|strong="G2532"\w* \w profetas|strong="G4396"\w*, \w sendo|strong="G1510"\w* \w pedra angular|strong="G204"\w* \w o próprio|strong="G846"\w* \w Cristo Jesus|strong="G5547,G2424"\w*,\x - \xo 2:20 \xt 1CO 3:10; MAT 16:18; REV 21:14; 1PE 2:5; ISA 28:16; 1CO 3:11\x*
\v 21 \w no qual|strong="G1722,G3739"\w* \w todo o edifício|strong="G3956,G3619"\w*\f + \fr 2.21: \ft Lit.: Πᾶσα οἰκοδομή, sem artigo: “todo edifício” ou “o edifício inteiro”.\f*, \w bem ajustado|strong="G4883"\w*, \w cresce|strong="G837"\w* \w para ser santuário|strong="G1519,G3485"\w* \w santo|strong="G40"\w* \w no Senhor|strong="G1722,G2962"\w*,\f + \fr 2.21: \ft Acréscimo: verbo ser/estar suprido em “para ser santuário”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:21 \xt 1CO 6:19; MAT 16:18; 1CO 3:16; 1PE 2:5; PSA 118:22; 1CO 3:9\x*
\v 22 \w no qual|strong="G1722,G3739"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w estão sendo edificados juntos|strong="G4925"\w* \w para ser morada|strong="G1519,G2732"\w* \w de Deus|strong="G3588,G2316"\w* \w no Espírito|strong="G1722,G4151"\w*.\f + \fr 2.22: \ft Lit.: Ἐν πνεύματι: “no Espírito” ou “em espírito”.\f*\f + \fr 2.22: \ft Acréscimo: verbo ser/estar suprido em “para ser morada”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:22 \xt MAT 16:18; 1CO 6:19; 1CO 3:16; 1PE 2:5; PSA 118:22; 1CO 3:9\x*
\c 3
\p
\v 1 \w Por esta razão|strong="G3778,G5484"\w* \w eu|strong="G1473"\w*, \w Paulo|strong="G3972"\w*, \w o prisioneiro|strong="G3588,G1198"\w* \w de Cristo Jesus|strong="G3588,G5547,G2424"\w* \w em favor de vocês|strong="G5228,G4771"\w*, \w os gentios|strong="G3588,G1484"\w*\f + \fr 3.1: \ft Lit.: Ἔθνη, “nações”; aqui e adiante no capítulo, os povos não judeus (gentios).\f*—\f + \fr 3.1: \ft Lit.: A frase é interrompida; é retomada no v. 14 com a mesma expressão, “por esta razão”.\f*\x - \xo 3:1 \xt PHM 1:1; PHM 1:9; 2TI 1:8; COL 1:24; EPH 4:1; EPH 6:20\x*
\v 2 \w se é que|strong="G1487,G1065"\w* \w ouviram|strong="G191"\w* \w da administração|strong="G3588,G3622"\w* \w da graça|strong="G3588,G5485"\w* \w de Deus|strong="G3588,G2316"\w* \w que me foi dada|strong="G3588,G1325,G3165"\w* \w para vocês|strong="G1519,G4771"\w*;\f + \fr 3.2: \ft Acréscimo: verbo ser/estar suprido em “se é que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:2 \xt COL 1:25; 1TI 1:11; EPH 4:7; EPH 3:7; 2TI 1:11; GAL 1:15-16\x*
\v 3 \w por revelação|strong="G2596,G602"\w* \w foi dado a conhecer|strong="G1107"\w* \w a mim|strong="G3165"\w* \w o mistério|strong="G3588,G3466"\w*, \w como|strong="G2531"\w* \w escrevi antes|strong="G4270"\w* \w em poucas palavras|strong="G1722,G3641"\w*,\f + \fr 3.3: \ft Variante: o SBLGNT, que segue Holmes e a margem de WH, não traz “que” (ὅτι) antes de “por revelação”; WH, Treg, NA28 e o RP o trazem. O RP traz ἐγνώρισέν (“ele deu a conhecer”) em lugar do passivo ἐγνωρίσθη.\f*\x - \xo 3:3 \xt EPH 1:9; EPH 6:19; GAL 1:12; REV 10:7; 1CO 2:10; REV 1:1\x*
\v 4 \w ao lerem isso|strong="G4314,G3739,G314"\w* \w vocês podem|strong="G1410"\w* \w perceber|strong="G3539"\w* \w a minha compreensão|strong="G3588,G4907,G3165"\w* \w do mistério|strong="G1722,G3588,G3466"\w* \w de Cristo|strong="G3588,G5547"\w*,\x - \xo 3:4 \xt 2TI 2:7; COL 2:2; REV 10:7; EPH 1:9; 1TI 3:16; 1CO 2:16\x*
\v 5 \w o qual|strong="G3739"\w* \w em outras gerações|strong="G2087,G1074"\w* \w não foi dado a conhecer|strong="G3756,G1107"\w* \w aos filhos|strong="G3588,G5207"\w* \w dos seres humanos|strong="G3588,G444"\w*\f + \fr 3.5: \ft Lit.: Υἱοῖς τῶν ἀνθρώπων, “filhos dos seres humanos”: semitismo para a humanidade.\f*, \w como|strong="G5613"\w* \w agora|strong="G3568"\w* \w foi revelado|strong="G601"\w* \w aos santos|strong="G3588,G40"\w* \w apóstolos|strong="G652"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w profetas|strong="G4396"\w* \w no Espírito|strong="G1722,G4151"\w*,\x - \xo 3:5 \xt COL 1:26; 1CO 2:10; GAL 3:28; EPH 1:17; REV 10:7; EPH 1:9\x*
\v 6 \w que os gentios|strong="G3588,G1484"\w* \w são|strong="G1511"\w* \w co-herdeiros|strong="G4789"\w* \w e|strong="G2532"\w* \w membros do mesmo corpo|strong="G4954"\w* \w e|strong="G2532"\w* \w co-participantes|strong="G4830"\w* \w da promessa|strong="G3588,G1860"\w* \w em Cristo Jesus|strong="G1722,G5547,G2424"\w* \w por meio da boa notícia|strong="G1223,G3588,G2098"\w*.\f + \fr 3.6: \ft Variante: o RP traz “da promessa dele, em o Cristo” (αὐτοῦ ἐν τῷ Χριστῷ) em lugar de “da promessa em Cristo Jesus” (ἐν Χριστῷ Ἰησοῦ).\f*\x - \xo 3:6 \xt GAL 3:29; ROM 8:17; COL 3:11; GAL 3:28; REV 10:7; EPH 1:9\x*
\v 7 \w Da qual|strong="G3739"\w* \w me tornei|strong="G1096"\w* \w servo|strong="G1249"\w* \w conforme o dom|strong="G2596,G3588,G1431"\w* \w da graça|strong="G3588,G5485"\w* \w de Deus|strong="G3588,G2316"\w* \w que me foi dada|strong="G3588,G1325,G3165"\w* \w segundo a ação|strong="G2596,G3588,G1753"\w* \w do poder|strong="G3588,G1411"\w* \w dele|strong="G846"\w*—\x - \xo 3:7 \xt EPH 3:20; EPH 1:19; COL 1:29; 2CO 9:15; GAL 3:28; REV 10:7\x*
\v 8 \w a mim|strong="G1473"\w*, \w o mais insignificante|strong="G3588,G1646"\w*\f + \fr 3.8: \ft Lit.: Ἐλαχιστότερος, comparativo formado sobre o superlativo “o menor”: “mais que o menor”.\f* \w de todos|strong="G3956"\w* \w os santos|strong="G40"\w*, \w foi dada|strong="G1325"\w* \w esta|strong="G3588,G3778"\w* \w graça|strong="G5485"\w* — \w anunciar como boa notícia|strong="G2097"\w* \w aos gentios|strong="G3588,G1484"\w* \w a insondável riqueza|strong="G3588,G421,G4149"\w* \w de Cristo|strong="G3588,G5547"\w*,\f + \fr 3.8: \ft Variante: o RP traz “entre os gentios” (ἐν τοῖς ἔθνεσιν).\f*\x - \xo 3:8 \xt ROM 11:33; 2SA 7:18; ISA 6:8; PHP 4:19; 1CO 15:9; COL 1:27\x*
\v 9 \w e|strong="G2532"\w* \w iluminar|strong="G5461"\w* \w todos|strong="G3956"\w* \w sobre qual é|strong="G5101"\w* \w a administração|strong="G3588,G3622"\w* \w do mistério|strong="G3588,G3466"\w* \w que esteve escondido|strong="G3588,G613"\w* \w desde as eras|strong="G575,G3588,G165"\w* \w em Deus|strong="G1722,G3588,G2316"\w*, \w que criou|strong="G3588,G2936"\w* \w todas as coisas|strong="G3588,G3956"\w*,\f + \fr 3.9: \ft Variante: WH omite “todos” (πάντας); o RP acrescenta “por meio de Jesus Cristo” (διὰ Ἰησοῦ Χριστοῦ) depois de “criou todas as coisas”.\f*\f + \fr 3.9: \ft Acréscimo: verbo ser/estar suprido em “sobre qual é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:9 \xt COL 1:26; 1CO 2:7; GEN 1:1; JHN 1:1; MAT 13:35; JHN 1:3\x*
\v 10 \w para que|strong="G2443"\w* \w seja dada a conhecer|strong="G1107"\w* \w agora|strong="G3568"\w* \w aos governos|strong="G3588,G746"\w* \w e|strong="G2532"\w* \w às autoridades|strong="G3588,G1849"\w* \w nas regiões celestes|strong="G1722,G3588,G2032"\w* \w por meio da comunidade|strong="G1223,G3588,G1577"\w* \w a multiforme|strong="G3588,G4182"\w* \w sabedoria|strong="G4678"\w* \w de Deus|strong="G3588,G2316"\w*,\f + \fr 3.10: \ft Lit.: Πολυποίκιλος, “de muitas cores, multifacetada”.\f*\f + \fr 3.10: \ft Tradução: ἀρχαῖς (ἀρχή, G746) está aqui como “aos governos”; o termo pode ser “princípio”, “começo”, “governo”, “governante” ou “domínio”, e o contexto decide.\f*\x - \xo 3:10 \xt EPH 6:12; EPH 1:3; GAL 3:28; 1PE 1:12; COL 1:16; MAT 16:18\x*
\v 11 \w segundo o propósito|strong="G2596,G4286"\w* \w das eras|strong="G3588,G165"\w*\f + \fr 3.11: \ft Lit.: Πρόθεσιν τῶν αἰώνων: “propósito das eras”; pode ser “propósito eterno” ou “propósito que age ao longo das eras”.\f*, \w o qual|strong="G3739"\w* \add ele\add* \w fez|strong="G4160"\w* \w em Cristo Jesus|strong="G1722,G3588,G5547,G2424"\w*, \w nosso Senhor|strong="G3588,G2962,G3165"\w*,\f + \fr 3.11: \ft Acréscimo: “ele” (em “o qual ele fez em”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 3:11 \xt ROM 8:28; 2TI 1:9; EPH 1:11; JER 32:17; EPH 1:4; EPH 1:6\x*
\v 12 \w no qual|strong="G1722,G3739"\w* \w temos|strong="G2192"\w* \w a coragem|strong="G3588,G3954"\w* \w e|strong="G2532"\w* \w o acesso|strong="G4318"\w* \w com confiança|strong="G1722,G4006"\w* \w por meio da fé|strong="G1223,G3588,G4102"\w* \w nele|strong="G846"\w*,\f + \fr 3.12: \ft Lit.: Τῆς πίστεως αὐτοῦ: “a fé nele” (genitivo objetivo) ou “a fidelidade/fé dele” (genitivo subjetivo).\f*\x - \xo 3:12 \xt ROM 5:2; HEB 4:16; HEB 13:6; 1JN 5:14; EPH 2:18; JHN 14:13\x*
\v 13 \w Por isso|strong="G1352"\w* \w peço|strong="G154"\w* \w que não se perca o ânimo|strong="G3361,G1573"\w*\f + \fr 3.13: \ft Lit.: Ἐγκακεῖν, “desanimar”; o sujeito não está expresso: pode ser Paulo ou os leitores.\f* \w nas minhas|strong="G1722,G3588,G3165"\w* \w aflições|strong="G2347"\w* \w em favor de vocês|strong="G5228,G4771"\w*, \w que são|strong="G3748,G1510"\w* \w glória|strong="G1391"\w* \w de vocês|strong="G4771"\w*.\x - \xo 3:13 \xt GAL 6:9; PRO 24:10; ISA 55:6; COL 1:24; 1PE 4:16; 2TH 3:13\x*
\p
\v 14 \w Por esta razão|strong="G3778,G5484"\w* \w dobro|strong="G2578"\w* \w os meus joelhos|strong="G3588,G1119,G3165"\w* \w diante do Pai|strong="G4314,G3588,G3962"\w*,\f + \fr 3.14: \ft Variante: o RP acrescenta “de nosso Senhor Jesus Cristo” (τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ) depois de “Pai”.\f*\x - \xo 3:14 \xt PHP 2:10; ROM 11:4; ROM 14:11; PSA 95:6; JHN 14:1; EPH 1:16-19\x*
\v 15 \w de quem|strong="G1537,G3739"\w* \w toda família|strong="G3956,G3965"\w*\f + \fr 3.15: \ft Lit.: Πατριά, “família, linhagem”, da mesma raiz de πατήρ, “pai”.\f* \w nos céus|strong="G1722,G3772"\w* \w e|strong="G2532"\w* \w sobre a terra|strong="G1909,G1093"\w* \w recebe nome|strong="G3687"\w*,\x - \xo 3:15 \xt JHN 14:1; 2TI 2:19; COL 1:9; ZEC 14:9; 1PE 4:16; EPH 1:10\x*
\v 16 \w para que|strong="G2443"\w* \w ele dê|strong="G1325"\w* \w a vocês|strong="G4771"\w*, \w segundo a riqueza|strong="G2596,G3588,G4149"\w* \w da glória|strong="G3588,G1391"\w* \w dele|strong="G846"\w*, \w serem fortalecidos|strong="G2901"\w* \w com poder|strong="G1411"\w* \w por meio do Espírito|strong="G1223,G3588,G4151"\w* \w dele|strong="G846"\w* \w no ser humano|strong="G1519,G3588,G444"\w* \w interior|strong="G2080"\w*,\x - \xo 3:16 \xt PHP 4:19; 2CO 12:9; ISA 41:10; PHP 4:13; COL 1:11; JHN 14:15\x*
\v 17 \w que Cristo habite|strong="G2730,G3588,G5547"\w* \w por meio da fé|strong="G1223,G3588,G4102"\w* \w nos corações|strong="G1722,G3588,G2588"\w* \w de vocês|strong="G4771"\w*; \w em amor|strong="G1722,G26"\w*\f + \fr 3.17: \ft Lit.: Ἐν ἀγάπῃ: pode ligar-se a “enraizados e alicerçados” ou a “habite”.\f*, \w enraizados|strong="G4492"\w* \w e|strong="G2532"\w* \w alicerçados|strong="G2311"\w*,\x - \xo 3:17 \xt COL 2:7; 2CO 6:16; JHN 14:15; COL 1:27; PSA 145:19; 1JN 4:4\x*
\v 18 \w para que tenham forças|strong="G2443,G1840"\w* \w para compreender|strong="G2638"\w*\f + \fr 3.18: \ft Lit.: Καταλαμβάνομαι, “agarrar, compreender”.\f* \w junto com todos|strong="G4862,G3956"\w* \w os santos|strong="G3588,G40"\w* \w qual é|strong="G5101"\w* \w a largura|strong="G3588,G4114"\w* \w e|strong="G2532"\w* \w o comprimento|strong="G3372"\w* \w e|strong="G2532"\w* \w a altura|strong="G5311"\w* \w e|strong="G2532"\w* \w a profundidade|strong="G899"\w*,\f + \fr 3.18: \ft Acréscimo: verbo ser/estar suprido em “qual é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:18 \xt JHN 14:15; PSA 145:19; PSA 103:11; EPH 1:17; ROM 5:5; ROM 8:39\x*
\v 19 \w e|strong="G5037"\w* \w conhecer|strong="G1097"\w* \w o amor|strong="G3588,G26"\w* \w de Cristo|strong="G3588,G5547"\w* \w que excede|strong="G5235"\w* \w o conhecimento|strong="G3588,G1108"\w*, \w para que sejam cheios|strong="G2443,G4137"\w* \w até toda|strong="G1519,G3956"\w* \w a plenitude|strong="G3588,G4138"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 3:19 \xt EPH 1:23; PSA 145:19; PSA 16:11; EPH 1:17; PHP 4:7; ROM 5:5\x*
\p
\v 20 \w E|strong="G1161"\w* \w àquele que pode|strong="G3588,G1410"\w* \w fazer|strong="G4160"\w* \w muito além de tudo|strong="G5228,G3956,G1537,G4057,G5228"\w*\f + \fr 3.20: \ft Lit.: Ὑπὲρ πάντα… ὑπερεκπερισσοῦ: “acima de tudo… de modo superabundante”.\f* \w o que|strong="G3739"\w* \w pedimos|strong="G154"\w* \w ou|strong="G2228"\w* \w pensamos|strong="G3539"\w*, \w segundo o poder|strong="G2596,G3588,G1411"\w* \w que opera|strong="G3588,G1754"\w* \w em nós|strong="G1722,G3165"\w*,\x - \xo 3:20 \xt 1CO 2:9; 2CO 9:8; EPH 1:19; JER 32:17; JER 32:27; JER 33:3\x*
\v 21 \w a ele|strong="G846"\w* \w seja a glória|strong="G3588,G1391"\w* \w na comunidade|strong="G1722,G3588,G1577"\w* \w e|strong="G2532"\w* \w em Cristo Jesus|strong="G1722,G5547,G2424"\w* \w por todas as gerações|strong="G1519,G3956,G3588,G1074"\w* \w da era|strong="G3588,G165"\w* \w das eras|strong="G3588,G165"\w*\f + \fr 3.21: \ft Lit.: Εἰς πάσας τὰς γενεὰς τοῦ αἰῶνος τῶν αἰώνων, literalmente “para todas as gerações da era das eras”; expressa duração sem limite.\f*. \w Amém|strong="G281"\w*.\f + \fr 3.21: \ft Variante: o RP omite “e” (καί) entre “na comunidade” e “em Cristo Jesus”.\f*\f + \fr 3.21: \ft Acréscimo: verbo ser/estar suprido em “seja a glória”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:21 \xt ROM 11:36; PHP 4:20; GAL 1:5; JUD 1:25; 2PE 3:18; 1PE 5:11\x*
\c 4
\p
\v 1 \w Exorto|strong="G3870"\w* \w portanto|strong="G3767"\w* \w vocês|strong="G4771"\w*, \w eu|strong="G1473"\w*, \w o prisioneiro|strong="G3588,G1198"\w* \w no Senhor|strong="G1722,G2962"\w*, \w a viverem|strong="G4043"\w* \w de modo digno|strong="G516"\w* \w do chamado|strong="G3588,G2821"\w* \w com que foram chamados|strong="G3739,G2564"\w*,\x - \xo 4:1 \xt COL 1:10; 1TH 2:12; ROM 12:1; EPH 2:10; EPH 4:4; PHP 1:27\x*
\v 2 \w com toda|strong="G3326,G3956"\w* \w humildade|strong="G5012"\w* \w e|strong="G2532"\w* \w mansidão|strong="G4236"\w*, \w com paciência|strong="G3326,G3115"\w*, \w suportando|strong="G430"\w* \w uns aos outros|strong="G240"\w* \w em amor|strong="G1722,G26"\w*,\x - \xo 4:2 \xt COL 3:12; COL 3:13; PHP 2:3; 1CO 13:7; 1CO 1:10; 1CO 13:4\x*
\v 3 \w esforçando-se|strong="G4704"\w* \w por guardar|strong="G5083"\w* \w a unidade|strong="G3588,G1775"\w* \w do Espírito|strong="G3588,G4151"\w*\f + \fr 4.3: \ft Lit.: Τοῦ πνεύματος: “do Espírito” ou “do espírito (comum)”.\f* \w no vínculo|strong="G1722,G3588,G4886"\w* \w da paz|strong="G3588,G1515"\w*:\x - \xo 4:3 \xt PSA 133:1; 1CO 1:10; ACT 4:32; COL 3:13-15; 1CO 12:12-13; 1JN 3:18\x*
\v 4 \w um só|strong="G1520"\w* \w corpo|strong="G4983"\w* \w e|strong="G2532"\w* \w um só|strong="G1520"\w* \w Espírito|strong="G4151"\w*, \w assim como|strong="G2531,G2532"\w* \w foram chamados|strong="G2564"\w* \w em uma só|strong="G1722,G1520"\w* \w esperança|strong="G1680"\w* \w do chamado|strong="G3588,G2821"\w* \w de vocês|strong="G4771"\w*;\x - \xo 4:4 \xt EPH 1:18; EPH 4:1; COL 3:15; 1CO 7:20; 1JN 3:3; PSA 133:1\x*
\v 5 \w um só|strong="G1520"\w* \w Senhor|strong="G2962"\w*, \w uma só|strong="G1520"\w* \w fé|strong="G4102"\w*, \w um só|strong="G1520"\w* \w batismo|strong="G908"\w*;\x - \xo 4:5 \xt PSA 133:1; 1CO 1:10; ACT 4:32; ZEC 14:9; 1CO 12:13; 1CO 8:6\x*
\v 6 \w um só|strong="G1520"\w* \w Deus|strong="G2316"\w* \w e|strong="G2532"\w* \w Pai|strong="G3962"\w* \w de todos|strong="G3956"\w*, \w que está|strong="G3588"\w* \w sobre todos|strong="G1909,G3956"\w* \w e|strong="G2532"\w* \w por meio de todos|strong="G1223,G3956"\w* \w e|strong="G2532"\w* \w em todos|strong="G1722,G3956"\w*.\f + \fr 4.6: \ft Lit.: Πάντων, πᾶσιν podem ser masculinos (“todos”) ou neutros (“todas as coisas”).\f*\f + \fr 4.6: \ft Variante: o RP acrescenta “nós” (ἡμῖν) depois de “em todos”.\f*\f + \fr 4.6: \ft Acréscimo: “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 4:6 \xt PSA 133:1; 1CO 1:10; ACT 4:32; ZEC 14:9; ROM 11:36; 1CO 8:6\x*
\p
\v 7 \w Mas|strong="G1161"\w* \w a cada um|strong="G1520,G1538"\w* \w de nós|strong="G3165"\w* \w foi dada|strong="G1325"\w* \w a graça|strong="G3588,G5485"\w* \w conforme a medida|strong="G2596,G3588,G3358"\w* \w do dom|strong="G3588,G1431"\w* \w de Cristo|strong="G3588,G5547"\w*.\x - \xo 4:7 \xt ROM 12:3; 2CO 9:15; 1CO 1:10; JHN 1:16; 1PE 4:10; 1CO 12:7\x*
\v 8 \w Por isso|strong="G1352"\w* \w diz|strong="G3004"\w*: “\w Tendo subido|strong="G305"\w* \w às alturas|strong="G1519,G5311"\w*, \w levou cativo|strong="G162"\w* \w um cativeiro|strong="G161"\w*\f + \fr 4.8: \ft Lit.: Αἰχμαλωτεύω αἰχμαλωσίαν, literalmente “levou cativo um cativeiro”: levou prisioneiros.\f*, \w deu|strong="G1325"\w* \w dons|strong="G1390"\w* \w aos seres humanos|strong="G3588,G444"\w*.”\f + \fr 4.8: \ft Nota cultural: Citação de Salmo 68:18 (67:19 no grego), com diferença: o Salmo fala em receber dons entre os homens; Efésios diz “deu dons”.\f*\f + \fr 4.8: \ft Variante: WH, Treg e o RP trazem “e deu” (καὶ ἔδωκεν); o SBLGNT e NA28 trazem “deu”.\f*\x - \xo 4:8 \xt PSA 68:18; COL 2:15; JHN 1:16; EPH 4:11; JHN 20:17; PRO 30:4\x*
\v 9 \w O|strong="G3588"\w* “\w subiu|strong="G305"\w*”, \w o que significa|strong="G5101,G1510"\w* \w senão|strong="G1487,G3361"\w* \w que|strong="G3754"\w* \w também|strong="G2532"\w* \w desceu|strong="G2597"\w* \w às partes|strong="G1519,G3313"\w* \w mais baixas|strong="G3588,G2737"\w* \w da terra|strong="G3588,G1093"\w*\f + \fr 4.9: \ft Variante: o RP acrescenta “primeiro” (πρῶτον) antes de “desceu”.\f*\f + \fr 4.9: \ft Lit.: Τὰ κατώτερα μέρη τῆς γῆς: “as partes mais baixas da terra”; pode ser a própria terra ou o que está debaixo da terra (o mundo dos mortos).\f*?\x - \xo 4:9 \xt JHN 3:13; JHN 1:16; PSA 68:18; JHN 20:17; PRO 30:4; PSA 24:7\x*
\v 10 \w Aquele que desceu|strong="G3588,G2597"\w* \w é o mesmo|strong="G846,G1510"\w* \w que também|strong="G2532"\w* \w subiu|strong="G3588,G305"\w* \w muito acima|strong="G5231"\w* \w de todos os céus|strong="G3956,G3588,G3772"\w*, \w para preencher|strong="G2443,G4137"\w* \w todas as coisas|strong="G3588,G3956"\w*.\x - \xo 4:10 \xt JHN 3:13; JHN 1:16; PSA 68:18; JHN 20:17; COL 3:1; PRO 30:4\x*
\v 11 \w E|strong="G2532"\w* \w ele mesmo|strong="G846"\w* \w deu|strong="G1325"\w*: \w uns como|strong="G3588,G3303"\w* \w apóstolos|strong="G652"\w*, \w outros como|strong="G3588,G1161"\w* \w profetas|strong="G4396"\w*, \w outros como|strong="G3588,G1161"\w* \w evangelistas|strong="G2099"\w*\f + \fr 4.11: \ft Lit.: Εὐαγγελιστής, “anunciador da boa notícia”.\f*, \w outros como|strong="G3588,G1161"\w* \w pastores|strong="G4166"\w* \w e|strong="G2532"\w* \w mestres|strong="G1320"\w*,\x - \xo 4:11 \xt JER 3:15; 1CO 12:29; 1CO 12:28; 2TI 3:16; EPH 2:20; 2TI 4:5\x*
\v 12 \w para o preparo|strong="G4314,G3588,G2677"\w*\f + \fr 4.12: \ft Lit.: Καταρτισμός, “preparo, equipamento, restauração”.\f* \w dos santos|strong="G3588,G40"\w* \w para a obra|strong="G1519,G2041"\w* \w de serviço|strong="G1248"\w*, \w para a edificação|strong="G1519,G3619"\w* \w do corpo|strong="G3588,G4983"\w* \w de Cristo|strong="G3588,G5547"\w*,\f + \fr 4.12: \ft Lit.: As três expressões (πρὸς… εἰς… εἰς) podem ser paralelas ou subordinadas umas às outras.\f*\x - \xo 4:12 \xt PHP 1:6; 2TI 3:16; JER 3:15; 1CO 12:28; 1TH 5:11; JHN 1:16\x*
\v 13 \w até que cheguemos|strong="G3360,G2658"\w* \w todos nós|strong="G3588,G3956"\w* \w à unidade|strong="G1519,G3588,G1775"\w* \w da fé|strong="G3588,G4102"\w* \w e|strong="G2532"\w* \w do conhecimento|strong="G3588,G1922"\w* \w do Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w*, \w a um homem|strong="G1519,G435"\w* \w perfeito|strong="G5046"\w*\f + \fr 4.13: \ft Lit.: Ἀνήρ, “homem adulto”; aqui é figura do crescimento da comunidade, em contraste com as “crianças” do v. 14.\f*, \w à medida|strong="G1519,G3358"\w* \w da estatura|strong="G2244"\w*\f + \fr 4.13: \ft Lit.: Ἡλικία, “estatura” ou “idade”.\f* \w da plenitude|strong="G3588,G4138"\w* \w de Cristo|strong="G3588,G5547"\w*,\x - \xo 4:13 \xt 2TI 3:16; GAL 4:19; COL 1:28; 1CO 12:28; JHN 1:16; 1CO 3:1\x*
\v 14 \w para que|strong="G2443"\w* \w já não sejamos|strong="G3371,G1510"\w* \w crianças|strong="G3516"\w*, \w jogados pelas ondas|strong="G2831"\w* \w e|strong="G2532"\w* \w levados de um lado a outro|strong="G4064"\w* \w por todo vento|strong="G3956,G417"\w* \w de ensino|strong="G3588,G1319"\w*, \w pela trapaça|strong="G1722,G3588,G2940"\w*\f + \fr 4.14: \ft Lit.: Κυβεία, literalmente “jogo de dados”: trapaça.\f* \w de seres humanos|strong="G3588,G444"\w*, \w com astúcia|strong="G1722,G3834"\w* \w para a artimanha|strong="G4314,G3588,G3180"\w* \w do erro|strong="G3588,G4106"\w*,\x - \xo 4:14 \xt 2TI 3:16; EPH 6:11; HEB 13:9; JAS 1:6; ROM 16:17-18; 2CO 11:3\x*
\v 15 \w mas, sendo verdadeiros|strong="G226,G1161"\w*\f + \fr 4.15: \ft Lit.: Ἀληθεύω, “dizer a verdade, ser verdadeiro, viver na verdade”.\f* \w em amor|strong="G1722,G26"\w*, \w cresçamos|strong="G837"\w* \w em direção a ele|strong="G1519,G846"\w* \w em todas as coisas|strong="G3588,G3956"\w*, \w o qual|strong="G3739"\w* \w é|strong="G1510"\w* \w a cabeça|strong="G3588,G2776"\w*, \w Cristo|strong="G5547"\w*,\x - \xo 4:15 \xt 2TI 3:16; 2PE 3:18; 1PE 2:2; 1JN 3:18; EPH 4:25; ZEC 8:16\x*
\v 16 \w do qual|strong="G1537,G3739"\w* \w todo o corpo|strong="G3956,G3588,G4983"\w*, \w bem ajustado|strong="G4883"\w* \w e|strong="G2532"\w* \w unido|strong="G4822"\w* \w por meio de toda|strong="G1223,G3956"\w* \w junta|strong="G860"\w* \w de suprimento|strong="G3588,G2024"\w*, \w segundo a ação|strong="G2596,G1753"\w* \w na medida|strong="G1722,G3358"\w* \w de cada|strong="G1520,G1538"\w* \w parte|strong="G3313"\w*, \w produz|strong="G4160"\w* \w o crescimento|strong="G3588,G838"\w* \w do corpo|strong="G3588,G4983"\w* \w para a sua edificação|strong="G1519,G3619,G1438"\w* \w em amor|strong="G1722,G26"\w*.\x - \xo 4:16 \xt COL 2:19; EPH 2:21; 2TI 3:16; JHN 15:5; COL 1:18; 1CO 12:12\x*
\p
\v 17 \w Digo|strong="G3004"\w* \w isto|strong="G3778"\w* \w portanto|strong="G3767"\w*, \w e|strong="G2532"\w* \w dou testemunho solene|strong="G3143"\w* \w no Senhor|strong="G1722,G2962"\w*: \w que vocês já não|strong="G3371,G4771"\w* \w vivam|strong="G4043"\w* \w como também|strong="G2531,G2532"\w* \w os gentios|strong="G3588,G1484"\w* \w vivem|strong="G4043"\w* \w na futilidade|strong="G1722,G3153"\w* \w da mente|strong="G3588,G3563"\w* \w deles|strong="G846"\w*,\f + \fr 4.17: \ft Variante: o RP acrescenta “demais” (λοιπά) antes de “gentios”.\f*\x - \xo 4:17 \xt ROM 12:2; 2CO 6:14; ROM 1:21; 2TI 2:19; 1PE 4:3; 1PE 1:18\x*
\v 18 \w estando com a mente obscurecida|strong="G4656,G3588,G1271,G1510"\w*, \w afastados|strong="G526"\w* \w da vida|strong="G3588,G2222"\w* \w de Deus|strong="G3588,G2316"\w*, \w por causa|strong="G1223"\w* \w da ignorância|strong="G3588,G52"\w* \w que há|strong="G3588,G1510"\w* \w neles|strong="G1722,G846"\w*, \w por causa|strong="G1223"\w* \w do endurecimento|strong="G3588,G4457"\w* \w do coração|strong="G3588,G2588"\w* \w deles|strong="G846"\w*,\x - \xo 4:18 \xt ROM 12:2; COL 1:21; COL 1:13; 2CO 6:14; ROM 1:21; 2TI 2:19\x*
\v 19 \w os quais|strong="G3748"\w*, \w tendo perdido a sensibilidade|strong="G524"\w*, \w se entregaram|strong="G1438,G3860"\w* \w à libertinagem|strong="G3588,G766"\w* \w para a prática|strong="G1519,G2039"\w* \w de toda|strong="G3956"\w* \w impureza|strong="G167"\w* \w com ganância|strong="G1722,G4124"\w*.\x - \xo 4:19 \xt ROM 12:2; GAL 5:19; COL 3:5; EPH 5:3; 2CO 6:14; 2TI 2:19\x*
\v 20 \w Mas|strong="G1161"\w* \w vocês|strong="G4771"\w* \w não aprenderam assim|strong="G3756,G3779,G3129"\w* \w a Cristo|strong="G3588,G5547"\w*,\f + \fr 4.20: \ft Lit.: Μανθάνω τὸν Χριστόν: “aprender Cristo”: expressão incomum, não “aprender sobre Cristo”.\f*\x - \xo 4:20 \xt ROM 12:2; 2CO 6:14; 2TI 2:19; TIT 2:11-14; MAT 28:20; JHN 6:45\x*
\v 21 \w se é que|strong="G1487,G1065"\w* \w o ouviram|strong="G846,G191"\w*\f + \fr 4.21: \ft Lit.: Αὐτὸν ἠκούσατε: “ouviram a ele” ou “ouviram dele”.\f* \w e|strong="G2532"\w* \w nele|strong="G1722,G846"\w* \w foram ensinados|strong="G1321"\w*, \w conforme|strong="G2531"\w* \w há|strong="G1510"\w* \w verdade|strong="G225"\w* \w em Jesus|strong="G1722,G3588,G2424"\w*,\f + \fr 4.21: \ft Acréscimo: verbo ser/estar suprido em “se é que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:21 \xt ISA 48:17; 2TI 2:19; JHN 6:45; MAT 28:20; JHN 17:17; 1JN 5:20\x*
\v 22 \w que vocês deixem de lado|strong="G659,G4771"\w*\f + \fr 4.22: \ft Lit.: Infinitivo que continua o conteúdo do ensino (v. 21).\f*, \w quanto ao modo de vida|strong="G2596,G3588,G391"\w* \w anterior|strong="G4387"\w*, \w o velho|strong="G3588,G3820"\w* \w ser humano|strong="G444"\w* \w que se corrompe|strong="G3588,G5351"\w* \w segundo os desejos|strong="G2596,G3588,G1939"\w* \w do engano|strong="G3588,G539"\w*,\x - \xo 4:22 \xt 2CO 5:17; PSA 51:10; ROM 12:2; 2CO 3:18; ROM 6:6; HEB 12:1\x*
\v 23 \w que sejam renovados|strong="G365"\w* \w no espírito|strong="G3588,G4151"\w* \w da mente|strong="G3588,G3563"\w* \w de vocês|strong="G4771"\w*,\x - \xo 4:23 \xt 2CO 5:17; PSA 51:10; ROM 12:2; 2CO 3:18; COL 3:10; ROM 8:6\x*
\v 24 \w e|strong="G2532"\w* \w que se vistam|strong="G1746"\w* \w do novo|strong="G3588,G2537"\w* \w ser humano|strong="G444"\w*, \w criado|strong="G3588,G2936"\w* \w segundo Deus|strong="G2596,G2316"\w* \w em justiça|strong="G1722,G1343"\w* \w e|strong="G2532"\w* \w santidade|strong="G3742"\w*\f + \fr 4.24: \ft Lit.: Ὁσιότης, “devoção, santidade”.\f* \w da verdade|strong="G3588,G225"\w*.\x - \xo 4:24 \xt COL 3:10; LUK 1:75; 2CO 5:17; EPH 2:10; PSA 51:10; ROM 12:2\x*
\p
\v 25 \w Por isso|strong="G1352"\w*, \w tendo deixado de lado|strong="G659"\w* \w a mentira|strong="G3588,G5579"\w*, \w falem|strong="G2980"\w* \w verdade|strong="G225"\w* \w cada um|strong="G1538"\w* \w com o seu próximo|strong="G3326,G3588,G4139,G846"\w*\f + \fr 4.25: \ft Nota cultural: Eco de Zacarias 8:16 (LXX).\f*, \w porque|strong="G3754"\w* \w somos|strong="G1510"\w* \w uns dos outros|strong="G240"\w* \w membros|strong="G3196"\w*.\f + \fr 4.25: \ft Lit.: Μέλη, “membros” (partes de um corpo).\f*\x - \xo 4:25 \xt ZEC 8:16; ROM 12:5; COL 3:9; EPH 4:15; PRO 12:22; EPH 4:22\x*
\v 26 \w Fiquem irados|strong="G3710"\w*\f + \fr 4.26: \ft Nota cultural: Eco do Salmo 4:5 (4:4 no hebraico), no grego: ὀργίζεσθε καὶ μὴ ἁμαρτάνετε.\f* \w e|strong="G2532"\w* \w não pequem|strong="G3361,G264"\w*; \w o|strong="G3588"\w* \w sol|strong="G2246"\w* \w não se ponha|strong="G3361,G1931"\w* \w sobre a irritação|strong="G1909,G3950"\w* \w de vocês|strong="G4771"\w*,\x - \xo 4:26 \xt PSA 4:5; JAS 1:19; PSA 4:4; PSA 37:8; EPH 4:31; ECC 7:9\x*
\v 27 \w nem deem|strong="G3366,G1325"\w* \w lugar|strong="G5117"\w* \w ao diabo|strong="G3588,G1228"\w*.\x - \xo 4:27 \xt 1PE 5:8; JAS 4:7; EPH 6:16; MAT 5:22; EPH 6:11; 2CO 2:10-11\x*
\v 28 \w Quem rouba|strong="G3588,G2813"\w* \w não roube mais|strong="G3371,G2813"\w*, \w mas antes|strong="G3123,G1161"\w* \w trabalhe duro|strong="G2872"\w*, \w fazendo|strong="G2038"\w* \w com as próprias|strong="G3588,G2398"\w* \w mãos|strong="G5495"\w* \w o que é bom|strong="G3588,G18"\w*, \w para que tenha|strong="G2443,G2192"\w* \w o que repartir|strong="G3330"\w* \w com quem|strong="G3588"\w* \w tem|strong="G2192"\w* \w necessidade|strong="G5532"\w*.\f + \fr 4.28: \ft Variante: WH omite “próprias” (ἰδίαις); o RP traz “o que é bom” depois de “mãos”.\f*\f + \fr 4.28: \ft Acréscimo: verbo ser/estar suprido em “o que é bom”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:28 \xt 1TH 4:11; HEB 13:16; EXO 20:15; MAT 28:20; 1TI 6:18; GEN 2:15\x*
\v 29 \w Que nenhuma palavra|strong="G3956,G3056,G3361"\w* \w podre|strong="G4550"\w* \w saia|strong="G1607"\w* \w da boca|strong="G1537,G3588,G4750"\w* \w de vocês|strong="G4771"\w*; \w mas, se há algo|strong="G235,G1487,G5100"\w* \w bom|strong="G18"\w* \w para a edificação|strong="G4314,G3619"\w* \w conforme a necessidade|strong="G3588,G5532"\w*\f + \fr 4.29: \ft Lit.: Οἰκοδομὴν τῆς χρείας: literalmente “edificação da necessidade”: edificação conforme a necessidade do momento.\f*, \w para que dê|strong="G2443,G1325"\w* \w graça|strong="G5485"\w* \w aos que ouvem|strong="G3588,G191"\w*.\f + \fr 4.29: \ft Acréscimo: verbo ser/estar suprido em “mas, se há algo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:29 \xt COL 4:6; PRO 18:21; 1TH 5:11; ECC 10:12; LUK 4:22; PRO 15:7\x*
\v 30 \w E|strong="G2532"\w* \w não entristeçam|strong="G3361,G3076"\w* \w o Espírito|strong="G3588,G4151"\w* \w Santo|strong="G3588,G40"\w* \w de Deus|strong="G3588,G2316"\w*, \w no qual|strong="G1722,G3739"\w* \w foram selados|strong="G4972"\w* \w para o dia|strong="G1519,G2250"\w* \w do resgate|strong="G629"\w*.\x - \xo 4:30 \xt EPH 1:13; 1TH 5:19; ISA 63:10; 2TI 2:19; ACT 7:51; PSA 51:11\x*
\v 31 \w Toda amargura|strong="G3956,G4088"\w* \w e|strong="G2532"\w* \w fúria|strong="G2372"\w* \w e|strong="G2532"\w* \w ira|strong="G3709"\w* \w e|strong="G2532"\w* \w gritaria|strong="G2906"\w* \w e|strong="G2532"\w* \w calúnia|strong="G988"\w* \w seja removida|strong="G142"\w* \w de vocês|strong="G575,G4771"\w*, \w junto com|strong="G4862"\w* \w toda|strong="G3956"\w* \w maldade|strong="G2549"\w*.\x - \xo 4:31 \xt COL 3:8; EPH 4:26; JAS 1:19; 1PE 3:8; 1PE 2:1; ECC 7:9\x*
\v 32 \w Sejam|strong="G1096"\w* \w bondosos|strong="G5543"\w* \w uns com os outros|strong="G1519,G240"\w*, \w compassivos|strong="G2155"\w*\f + \fr 4.32: \ft Lit.: Εὔσπλαγχνος, “de bons sentimentos”, literalmente “de boas entranhas”.\f*, \w perdoando|strong="G5483"\w* \w uns aos outros|strong="G1438"\w*, \w assim como|strong="G2531,G2532"\w* \w Deus|strong="G3588,G2316"\w* \w em Cristo|strong="G1722,G5547"\w* \w perdoou|strong="G5483"\w* \w vocês|strong="G4771"\w*.\f + \fr 4.32: \ft Variante: o SBLGNT, que segue Holmes e a margem de WH, não traz “e” (δέ) depois de “sejam”; WH, Treg, NA28 e o RP o trazem. O RP traz “a nós” (ἡμῖν) em lugar de “a vocês” (ὑμῖν).\f*\x - \xo 4:32 \xt COL 3:13; COL 3:12; 1CO 13:4; MAT 6:14; MAT 5:7; MRK 11:25\x*
\c 5
\p
\v 1 \w Sejam|strong="G1096"\w*, \w portanto|strong="G3767"\w*, \w imitadores|strong="G3402"\w* \w de Deus|strong="G3588,G2316"\w*, \w como filhos|strong="G5613,G5043"\w* \w amados|strong="G27"\w*,\x - \xo 5:1 \xt 1JN 4:11; 1PE 1:15; EPH 4:32; MAT 5:48; LUK 6:35-36; COL 3:12\x*
\v 2 \w e|strong="G2532"\w* \w vivam|strong="G4043"\w* \w em amor|strong="G1722,G26"\w*, \w assim como|strong="G2531,G2532"\w* \w Cristo|strong="G3588,G5547"\w* \w nos amou|strong="G25,G3165"\w* \w e|strong="G2532"\w* \w se entregou|strong="G3860,G1438"\w* \w por nós|strong="G5228,G3165"\w* \w como oferta|strong="G4376"\w* \w e|strong="G2532"\w* \w sacrifício|strong="G2378"\w* \w a Deus|strong="G3588,G2316"\w*, \w como aroma|strong="G1519,G3744"\w* \w suave|strong="G2175"\w*.\f + \fr 5.2: \ft Nota cultural: Ὀσμὴ εὐωδίας, “aroma suave”: linguagem do culto sacrificial no grego do AT (LXX).\f*\f + \fr 5.2: \ft Variante: WH e Treg trazem “amou vocês” (ὑμᾶς) em lugar de “nos amou” (ἡμᾶς); WH traz “por vocês” (ὑμῶν) em lugar de “por nós” (ἡμῶν).\f*\x - \xo 5:2 \xt JHN 13:34; JHN 15:13; EPH 5:25; PHP 4:18; 1JN 3:16; HEB 12:2\x*
\v 3 \w Mas|strong="G1161"\w* \w imoralidade sexual|strong="G4202"\w* \w e|strong="G2532"\w* \w toda impureza|strong="G167,G3956"\w* \w ou|strong="G2228"\w* \w ganância|strong="G4124"\w* \w nem sequer|strong="G3366"\w* \w seja mencionada|strong="G3687"\w* \w entre vocês|strong="G1722,G4771"\w*, \w como convém|strong="G2531,G4241"\w* \w a santos|strong="G40"\w*,\x - \xo 5:3 \xt COL 3:5; GAL 5:19; EPH 4:19; EPH 4:29; EPH 5:5; 1TH 4:3\x*
\v 4 \w e|strong="G2532"\w* \w obscenidade|strong="G151"\w* \w e|strong="G2532"\w* \w conversa tola|strong="G3473"\w* \w ou|strong="G2228"\w* \w gracejo vulgar|strong="G2160"\w*\f + \fr 5.4: \ft Lit.: Εὐτραπελία, “graça de palavra, brincadeira”; aqui em sentido negativo.\f*, \w coisas que não convêm|strong="G3739,G3756,G433"\w*, \w mas|strong="G235"\w* \w antes|strong="G3123"\w* \w ação de graças|strong="G2169"\w*.\f + \fr 5.4: \ft Variante: o RP traz “o que não convém” (τὰ οὐκ ἀνήκοντα) em lugar de “coisas que não convêm” (ἃ οὐκ ἀνῆκεν).\f*\x - \xo 5:4 \xt 1CO 6:9; GAL 5:19; COL 3:8; EPH 4:29; JAS 1:26; COL 3:5\x*
\v 5 \w Pois|strong="G1063"\w* \w isto|strong="G3778"\w* \w vocês sabem e reconhecem|strong="G6063,G1097"\w*\f + \fr 5.5: \ft Lit.: Ἴστε γινώσκοντες: “vocês sabem, reconhecendo” (indicativo) ou “saibam, reconhecendo” (imperativo).\f* \w que todo|strong="G3754,G3956"\w* \w imoral sexual|strong="G4205"\w* \w ou|strong="G2228"\w* \w impuro|strong="G169"\w* \w ou|strong="G2228"\w* \w ganancioso|strong="G4123"\w*, \w que é|strong="G3739,G1510"\w* \w idólatra|strong="G1496"\w*, \w não tem|strong="G3756,G2192"\w* \w herança|strong="G2817"\w* \w no reino|strong="G1722,G3588,G932"\w* \w de Cristo|strong="G3588,G5547"\w* \w e|strong="G2532"\w* \w de Deus|strong="G2316"\w*.\f + \fr 5.5: \ft Lit.: Τοῦ Χριστοῦ καὶ θεοῦ, com um só artigo: “de Cristo e de Deus” (duas pessoas) ou “do Cristo, que é Deus”.\f*\f + \fr 5.5: \ft Variante: o RP traz ὅς (“quem”, masculino, referindo-se à pessoa) em lugar de ὅ (“o que”, neutro, referindo-se à ganância); traz também ἔστε (“sejam”) em lugar de ἴστε (“sabem”).\f*\x - \xo 5:5 \xt 1CO 6:9; 1CO 5:11; REV 22:15; 1CO 5:10; REV 21:8; GAL 5:19\x*
\v 6 \w Que ninguém|strong="G3367"\w* \w engane|strong="G538"\w* \w vocês|strong="G4771"\w* \w com palavras|strong="G3056"\w* \w vazias|strong="G2756"\w*, \w pois|strong="G1063"\w* \w por causa disto|strong="G1223,G3778"\w* \w vem|strong="G2064"\w* \w a ira|strong="G3588,G3709"\w* \w de Deus|strong="G3588,G2316"\w* \w sobre os filhos|strong="G1909,G3588,G5207"\w* \w da desobediência|strong="G3588,G543"\w*.\x - \xo 5:6 \xt COL 3:6; 2CO 6:14; COL 2:8; GAL 6:7; 1CO 15:33; REV 21:8\x*
\v 7 \w Portanto|strong="G3767"\w*, \w não se tornem|strong="G3361,G1096"\w* \w co-participantes|strong="G4830"\w* \w deles|strong="G846"\w*;\x - \xo 5:7 \xt 2CO 6:14; 2TI 2:19; REV 18:4; 1TI 5:22; EPH 5:11; 1PE 4:2\x*
\v 8 \w pois|strong="G1063"\w* \w vocês eram|strong="G1510"\w* \w outrora|strong="G4218"\w* \w trevas|strong="G4655"\w*, \w mas agora|strong="G3568,G1161"\w* \w luz|strong="G5457"\w* \w no Senhor|strong="G1722,G2962"\w*; \w vivam|strong="G4043"\w* \w como filhos|strong="G5613,G5043"\w* \w da luz|strong="G5457"\w*,\x - \xo 5:8 \xt 2CO 6:14; JHN 8:12; COL 1:13; 1TH 5:5; ISA 60:1; 1JN 1:7\x*
\v 9 \w pois|strong="G1063"\w* \w o fruto|strong="G3588,G2590"\w* \w da luz|strong="G3588,G5457"\w* \add está\add* \w em toda|strong="G1722,G3956"\w* \w benevolência|strong="G19"\w* \w e|strong="G2532"\w* \w justiça|strong="G1343"\w* \w e|strong="G2532"\w* \w verdade|strong="G225"\w*,\f + \fr 5.9: \ft Variante: o RP traz “do Espírito” (πνεύματος) em lugar de “da luz” (φωτός).\f*\f + \fr 5.9: \ft Acréscimo: “está” (em “da luz está em toda”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 5:9 \xt GAL 5:22; MAT 5:14; ROM 12:2; JHN 3:21; 2CO 6:14; PHP 1:11\x*
\v 10 \w avaliando|strong="G1381"\w* \w o que é|strong="G5101,G1510"\w* \w agradável|strong="G2101"\w* \w ao Senhor|strong="G3588,G2962"\w*;\x - \xo 5:10 \xt ROM 12:2; MAT 5:14; 2CO 6:14; 1PE 2:9; ROM 12:1; 1TH 5:21\x*
\v 11 \w e|strong="G2532"\w* \w não participem|strong="G3361,G4790"\w* \w das obras|strong="G3588,G2041"\w* \w infrutíferas|strong="G3588,G175"\w* \w das trevas|strong="G3588,G4655"\w*, \w mas antes|strong="G3123,G1161"\w* \w também|strong="G2532"\w* \w exponham|strong="G1651"\w*\f + \fr 5.11: \ft Lit.: Ἐλέγχω, “expor, repreender, convencer da falta”.\f*,\x - \xo 5:11 \xt MAT 5:14; JHN 3:19; 2CO 6:14; 1PE 2:9; ROM 13:12; 1TI 5:20\x*
\v 12 \w pois|strong="G1063"\w* \w as coisas que são feitas|strong="G3588,G1096"\w* \w em secreto|strong="G2931"\w* \w por eles|strong="G5259,G846"\w* \w é vergonhoso|strong="G150,G1510"\w* \w até mesmo|strong="G2532"\w* \w mencionar|strong="G3004"\w*;\x - \xo 5:12 \xt MAT 5:14; 2CO 6:14; JHN 3:20; 2TI 3:16; LUK 4:18; EPH 5:3\x*
\v 13 \w mas todas as coisas|strong="G3588,G1161,G3956"\w* \w expostas|strong="G1651"\w* \w pela luz|strong="G5259,G3588,G5457"\w* \w se tornam manifestas|strong="G5319"\w*,\x - \xo 5:13 \xt PSA 119:105; JHN 3:20; MAT 5:14; 2CO 6:14; HEB 4:12; ISA 9:2\x*
\v 14 \w pois|strong="G1063"\w* \w tudo o que|strong="G3956,G3588"\w* \w é manifestado|strong="G5319"\w* \w luz|strong="G5457"\w* \w é|strong="G1510"\w*. \w Por isso|strong="G1352"\w* \w diz|strong="G3004"\w*: “\w Desperte|strong="G1453"\w*, \w você que dorme|strong="G3588,G2518"\w*, \w e|strong="G2532"\w* \w levante-se|strong="G450"\w* \w dentre os mortos|strong="G1537,G3588,G3498"\w*, \w e|strong="G2532"\w* \w Cristo|strong="G3588,G5547"\w* \w brilhará|strong="G2017"\w* \w sobre você|strong="G4771"\w*.”\f + \fr 5.14: \ft Nota cultural: O texto não indica a fonte da citação; há ecos de Isaías (26:19; 60:1), e pode ser um texto cristão de uso litúrgico.\f*\f + \fr 5.14: \ft Tradução: Ἔγειρε (ἐγείρω, G1453) está aqui como “Desperte”; o termo pode ser “levantar”, “ressuscitar”, “despertar” ou “erguer”, e o contexto decide.\f*\x - \xo 5:14 \xt ISA 60:1; MAT 5:14; ROM 13:11; ISA 26:19; 1TH 5:6; 2CO 6:14\x*
\v 15 \w Vejam|strong="G991"\w* \w com atenção|strong="G199"\w* \w portanto|strong="G3767"\w* \w como|strong="G4459"\w* \w vocês vivem|strong="G4043"\w*, \w não como|strong="G3361,G5613"\w* \w sem sabedoria|strong="G781"\w* \w mas|strong="G235"\w* \w como|strong="G5613"\w* \w sábios|strong="G4680"\w*,\x - \xo 5:15 \xt COL 4:5; JAS 3:13; PHP 1:27; 1CO 14:20; PRO 14:8; EPH 5:17\x*
\v 16 \w aproveitando|strong="G1805"\w* \w o tempo oportuno|strong="G3588,G2540"\w*, \w porque|strong="G3754"\w* \w os dias|strong="G3588,G2250"\w* \w são maus|strong="G4190,G1510"\w*.\f + \fr 5.16: \ft Lit.: Ἐξαγοράζω, literalmente “comprar de volta, resgatar”; “aproveitando o tempo oportuno” verte a imagem de comprar ou resgatar o καιρός (“tempo oportuno”).\f*\x - \xo 5:16 \xt COL 4:5; PSA 90:12; JHN 9:4; ECC 9:10; AMO 5:13; EPH 6:13\x*
\v 17 \w Por isso|strong="G1223,G3778"\w* \w não sejam|strong="G3361,G1096"\w* \w insensatos|strong="G878"\w*, \w mas|strong="G235"\w* \w compreendam|strong="G4920"\w* \w qual é|strong="G5101"\w* \w a vontade|strong="G3588,G2307"\w* \w do Senhor|strong="G3588,G2962"\w*;\f + \fr 5.17: \ft Acréscimo: verbo ser/estar suprido em “qual é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:17 \xt PSA 90:12; ROM 12:2; COL 4:5; 1TH 5:18; COL 1:9; 1TH 4:3\x*
\v 18 \w e|strong="G2532"\w* \w não se embriaguem|strong="G3361,G3182"\w* \w com vinho|strong="G3631"\w*, \w no qual|strong="G1722,G3739"\w* \w há|strong="G1510"\w* \w desregramento|strong="G810"\w*, \w mas|strong="G235"\w* \w sejam cheios|strong="G4137"\w* \w no Espírito|strong="G1722,G4151"\w*,\f + \fr 5.18: \ft Lit.: Ἐν πνεύματι: “no Espírito” ou “com o espírito”; ἐν pode indicar o âmbito ou aquilo de que se é cheio.\f*\x - \xo 5:18 \xt LUK 1:15; PRO 20:1; ROM 13:13; ACT 2:4; GAL 5:21; ACT 11:24\x*
\v 19 \w falando|strong="G2980"\w* \w uns aos outros|strong="G1438"\w* \w com salmos|strong="G5568"\w* \w e|strong="G2532"\w* \w hinos|strong="G5215"\w* \w e|strong="G2532"\w* \w cânticos|strong="G5603"\w* \w espirituais|strong="G4152"\w*, \w cantando|strong="G103"\w* \w e|strong="G2532"\w* \w louvando com música|strong="G5567"\w* \w em seu coração|strong="G3588,G2588,G4771"\w* \w ao Senhor|strong="G3588,G2962"\w*,\f + \fr 5.19: \ft Variante: NA28 acrescenta “em” (ἐν) antes de “uns aos outros”; Treg e o RP acrescentam “em” antes de “seu coração”.\f*\x - \xo 5:19 \xt COL 3:16; 1CO 14:26; PSA 95:2; ACT 16:25; PSA 147:7; JAS 5:13\x*
\v 20 \w agradecendo|strong="G2168"\w* \w sempre|strong="G3842"\w* \w por todas as coisas|strong="G5228,G3956"\w* \w em nome|strong="G1722,G3686"\w* \w do nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus Cristo|strong="G2424,G5547"\w* \w a Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w Pai|strong="G3962"\w*,\x - \xo 5:20 \xt COL 3:17; 1CO 1:4; 1TH 5:18; COL 1:3; 2TH 1:3; PHP 4:6\x*
\v 21 \w submetendo-se|strong="G5293"\w* \w uns aos outros|strong="G240"\w* \w no temor|strong="G1722,G5401"\w* \w de Cristo|strong="G5547"\w*.\f + \fr 5.21: \ft Lit.: Ὑποτασσόμενοι: particípio que continua a série dos vv. 19-20; o v. 21 une o que precede ao que segue (vv. 22ss).\f*\f + \fr 5.21: \ft Variante: o TR traz “de Deus” (θεοῦ) em lugar de “de Cristo” (Χριστοῦ).\f*\x - \xo 5:21 \xt 1PE 5:5; PHP 2:3; GAL 5:13; EPH 5:24; JAS 4:7; EPH 5:22\x*
\p
\v 22 \w As esposas|strong="G3588,G1135"\w* \w aos próprios maridos|strong="G3588,G2398,G435"\w* \add submetam-se\add* \w como ao Senhor|strong="G5613,G3588,G2962"\w*,\f + \fr 5.22: \ft Lit.: Γυναῖκες… ἀνδράσιν: “mulheres… homens”; no contexto, esposas e maridos. O verbo vem de v. 21 (“submetendo-se”).\f*\f + \fr 5.22: \ft Variante: o SBLGNT, WH e NA28 não têm verbo neste v. 22; Treg traz ὑποτασσέσθωσαν e o RP, ὑποτάσσεσθε (ambos “submetam-se”).\f*\f + \fr 5.22: \ft Acréscimo: “submetam-se” (em “próprios maridos submetam se como ao”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 5:22 \xt COL 3:18; 1PE 3:1; 1CO 11:8; 1CO 11:3; TIT 2:5; 1CO 7:2\x*
\v 23 \w porque|strong="G3754"\w* \w o marido|strong="G435"\w* \w é|strong="G1510"\w* \w cabeça|strong="G2776"\w* \w da esposa|strong="G3588,G1135"\w*, \w como também|strong="G5613,G2532"\w* \w Cristo|strong="G3588,G5547"\w* \w é cabeça|strong="G2776"\w* \w da comunidade|strong="G3588,G1577"\w*, \w ele mesmo|strong="G846"\w* \w Salvador|strong="G4990"\w* \w do corpo|strong="G3588,G4983"\w*.\f + \fr 5.23: \ft Lit.: Κεφαλή, “cabeça”; o texto desenvolve a relação da cabeça com o corpo nos vv. 23-30, sem defini-la aqui.\f*\f + \fr 5.23: \ft Acréscimo: verbo ser/estar suprido em “é cabeça”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:23 \xt 1CO 11:3; COL 1:18; EPH 5:25; EPH 1:22; 1PE 3:1; ROM 7:4\x*
\v 24 \w Mas|strong="G235"\w* \w assim como|strong="G5613"\w* \w a comunidade|strong="G3588,G1577"\w* \w se submete|strong="G5293"\w* \w a Cristo|strong="G3588,G5547"\w*, \w assim também|strong="G3779,G2532"\w* \w as esposas|strong="G3588,G1135"\w* \w aos maridos|strong="G3588,G435"\w* \w em tudo|strong="G1722,G3956"\w*.\f + \fr 5.24: \ft Variante: o RP traz ὥσπερ em lugar de ὡς (ambos “assim como”) e acrescenta “próprios” (ἰδίοις) antes de “maridos”.\f*\x - \xo 5:24 \xt 1CO 14:34; 1PE 3:1; EPH 5:33; 1CO 11:3; COL 3:18; TIT 2:5\x*
\v 25 \w Maridos|strong="G3588,G435"\w*, \w amem|strong="G25"\w* \w as esposas|strong="G3588,G1135"\w*, \w assim como|strong="G2531,G2532"\w* \w Cristo|strong="G3588,G5547"\w* \w amou|strong="G25"\w* \w a comunidade|strong="G3588,G1577"\w* \w e|strong="G2532"\w* \w se entregou|strong="G1438,G3860"\w* \w por ela|strong="G5228,G846"\w*,\f + \fr 5.25: \ft Variante: o RP acrescenta “próprias” (ἑαυτῶν) depois de “esposas”.\f*\x - \xo 5:25 \xt COL 3:19; EPH 5:28; EPH 5:33; EPH 5:2; GAL 2:20; EPH 5:23\x*
\v 26 \w para que|strong="G2443"\w* \w a santificasse|strong="G846,G37"\w*, \w tendo-a purificado|strong="G2511"\w* \w pelo banho|strong="G3588,G3067"\w* \w da água|strong="G3588,G5204"\w* \w com a palavra|strong="G1722,G4487"\w*,\f + \fr 5.26: \ft Lit.: Ἐν ῥήματι, “com uma palavra”: pode ligar-se a “purificado” ou a “santificasse”.\f*\x - \xo 5:26 \xt JHN 3:5; HEB 10:22; JHN 15:3; JHN 17:17; EZK 36:25; PRO 31:10\x*
\v 27 \w para que|strong="G2443"\w* \w ele mesmo|strong="G846"\w* \w apresentasse|strong="G3936"\w* \w a si|strong="G1438"\w* \w gloriosa|strong="G1741"\w* \w a comunidade|strong="G3588,G1577"\w*, \w sem ter|strong="G3361,G2192"\w* \w mancha|strong="G4696"\w* \w ou|strong="G2228"\w* \w ruga|strong="G4512"\w* \w ou algo|strong="G2228,G5100"\w* \w do tipo|strong="G3588,G5108"\w*, \w mas para que|strong="G235,G2443"\w* \w seja|strong="G1510"\w* \w santa|strong="G40"\w* \w e|strong="G2532"\w* \w sem defeito|strong="G299"\w*.\f + \fr 5.27: \ft Variante: o RP traz αὐτήν (“a ela”) em lugar de αὐτός (“ele mesmo”).\f*\x - \xo 5:27 \xt PRO 31:10; 1PE 3:7; ISA 54:5; 1CO 1:8; COL 1:22; COL 1:28\x*
\v 28 \w Assim|strong="G3779"\w* \w devem|strong="G3784"\w* \w também|strong="G2532"\w* \w os maridos|strong="G3588,G435"\w* \w amar|strong="G25"\w* \w as próprias|strong="G3588,G1438"\w* \w esposas|strong="G1135"\w* \w como|strong="G5613"\w* \w aos próprios|strong="G3588,G1438"\w* \w corpos|strong="G4983"\w*; \w quem ama|strong="G3588,G25"\w* \w a própria|strong="G3588,G1438"\w* \w esposa|strong="G1135"\w* \w ama a si mesmo|strong="G1438,G25"\w*,\x - \xo 5:28 \xt EPH 5:25; COL 3:19; EPH 5:33; GEN 2:24; 1JN 4:11; 1CO 11:8\x*
\v 29 \w pois|strong="G1063"\w* \w ninguém|strong="G3762"\w* \w jamais|strong="G4218"\w* \w odiou|strong="G3404"\w* \w a própria|strong="G3588,G1438"\w* \w carne|strong="G4561"\w*, \w mas|strong="G235"\w* \w a alimenta|strong="G1625,G846"\w* \w e|strong="G2532"\w* \w a cuida com carinho|strong="G2282"\w*, \w assim como|strong="G2531,G2532"\w* \w Cristo|strong="G3588,G5547"\w* \w a comunidade|strong="G3588,G1577"\w*,\f + \fr 5.29: \ft Variante: o RP traz “o Senhor” (κύριος) em lugar de “Cristo” (Χριστός).\f*\x - \xo 5:29 \xt GEN 2:24; GEN 2:23; PRO 31:10; COL 3:19; ECC 3:8; COL 2:23\x*
\v 30 \w porque|strong="G3754"\w* \w membros|strong="G3196"\w* \w somos|strong="G1510"\w* \w do corpo|strong="G3588,G4983"\w* \w dele|strong="G846"\w*.\f + \fr 5.30: \ft Variante: o RP acrescenta “da carne dele e dos ossos dele” (ἐκ τῆς σαρκὸς αὐτοῦ καὶ ἐκ τῶν ὀστέων αὐτοῦ).\f*\x - \xo 5:30 \xt 1CO 12:27; ROM 12:5; 1CO 12:14; 1CO 12:12; 1CO 6:15; 1CO 12:19\x*
\v 31 “\w Por isso|strong="G473,G3778"\w* \w deixará|strong="G2641"\w* \w o homem|strong="G444"\w*\f + \fr 5.31: \ft Lit.: Ἄνθρωπος, “ser humano”; na citação de Gênesis, “o homem”.\f* \w o pai|strong="G3588,G3962"\w* \w e|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w* \w e|strong="G2532"\w* \w se unirá|strong="G4347"\w* \w à sua mulher|strong="G3588,G1135,G846"\w*, \w e|strong="G2532"\w* \w os dois|strong="G3588,G1417"\w* \w serão|strong="G1510"\w* \w uma só|strong="G1519,G1520"\w* \w carne|strong="G4561"\w*.”\f + \fr 5.31: \ft Nota cultural: Citação de Gênesis 2:24, conforme o grego (LXX), com pequenas diferenças de redação.\f*\f + \fr 5.31: \ft Variante: o SBLGNT e Treg trazem o dativo “à sua mulher” (τῇ γυναικί); WH, NA28 e o RP trazem “junto de sua mulher” (πρὸς τὴν γυναῖκα). Treg omite os artigos antes de “pai” e “mãe”; o RP acrescenta “dele” (αὐτοῦ) depois de “pai”.\f*\x - \xo 5:31 \xt GEN 2:24; MRK 10:7; MAT 19:5; PRO 31:10; 1CO 6:16; EPH 1:23\x*
\v 32 \w Este|strong="G3588,G3778"\w* \w mistério|strong="G3466"\w* \w é grande|strong="G3173,G1510"\w*, \w mas eu|strong="G1473,G1161"\w* \w digo|strong="G3004"\w* \w em relação a|strong="G1519"\w* \w Cristo|strong="G5547"\w* \w e|strong="G2532"\w* \w em relação à|strong="G1519,G3588"\w* \w comunidade|strong="G1577"\w*.\f + \fr 5.32: \ft Lit.: Εἰς Χριστὸν καὶ εἰς τὴν ἐκκλησίαν: “a respeito de Cristo e da comunidade”, ou “em direção a”.\f*\x - \xo 5:32 \xt 1TI 3:16; PRO 31:10; MAT 16:18; REV 19:7; REV 12:1; 2CO 11:2\x*
\v 33 \w Contudo|strong="G4133"\w*, \w também vocês|strong="G2532,G4771"\w*, \w cada um|strong="G3588,G1538"\w* \w em particular|strong="G2596,G1520"\w*, \w ame|strong="G25"\w* \w assim|strong="G3779"\w* \w a própria|strong="G3588,G1438"\w* \w esposa|strong="G1135"\w* \w como a si mesmo|strong="G5613,G1438"\w*, \w e|strong="G1161"\w* \w a esposa|strong="G3588,G1135"\w* \w que|strong="G2443"\w* \w respeite|strong="G5399"\w*\f + \fr 5.33: \ft Lit.: Φοβέομαι, “temer, respeitar com reverência”.\f* \w o marido|strong="G3588,G435"\w*.\x - \xo 5:33 \xt EPH 5:28; 1CO 7:2; EPH 5:25; COL 3:19; EPH 5:24; EPH 5:22\x*
\c 6
\p
\v 1 \w Filhos e filhas|strong="G3588,G5043"\w*, \w obedeçam|strong="G5219"\w* \w aos pais|strong="G3588,G1118"\w* \w de vocês|strong="G4771"\w* \w no Senhor|strong="G1722,G2962"\w*, \w pois|strong="G1063"\w* \w isto|strong="G3778"\w* \w é|strong="G1510"\w* \w justo|strong="G1342"\w*;\x - \xo 6:1 \xt COL 3:20; EXO 20:12; PRO 3:2; PRO 23:22; DEU 5:16; PRO 6:20\x*
\v 2 “\w Honre|strong="G5091"\w* \w o seu pai|strong="G3588,G3962,G4771"\w* \w e|strong="G2532"\w* \w a sua mãe|strong="G3588,G3384"\w*”\f + \fr 6.2: \ft Nota cultural: Citação de Êxodo 20:12 (e Deuteronômio 5:16).\f*, \w que é|strong="G3748,G1510"\w* \w o primeiro|strong="G4413"\w* \w mandamento|strong="G1785"\w* \w com promessa|strong="G1722,G1860"\w*,\x - \xo 6:2 \xt EXO 20:12; DEU 5:16; MAT 15:4; COL 3:20; PRO 3:2; DEU 27:16\x*
\v 3 “\w para que lhe vá bem|strong="G2443,G2095,G4771,G1096"\w* \w e|strong="G2532"\w* \w você viva muito tempo|strong="G1510,G3118"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*.”\f + \fr 6.3: \ft Lit.: Γῆ, “terra”; na citação, pode ser a terra prometida.\f*\x - \xo 6:3 \xt EXO 20:12; DEU 5:16; COL 3:20; PRO 3:2; PSA 128:2; 1TI 5:4\x*
\v 4 \w E|strong="G2532"\w* \w pais|strong="G3588,G3962"\w*, \w não provoquem à ira|strong="G3361,G3949"\w* \w os filhos|strong="G3588,G5043"\w* \w de vocês|strong="G4771"\w*, \w mas|strong="G235"\w* \w criem-nos|strong="G1625,G846"\w* \w na formação|strong="G1722,G3809"\w*\f + \fr 6.4: \ft Lit.: Παιδεία, “educação, formação, disciplina”; νουθεσία, “advertência, orientação”.\f* \w e|strong="G2532"\w* \w na advertência|strong="G3559"\w* \w do Senhor|strong="G2962"\w*.\x - \xo 6:4 \xt PRO 22:6; DEU 4:9; COL 3:21; PRO 29:15; PRO 19:18; DEU 6:7\x*
\p
\v 5 \w Escravos|strong="G3588,G1401"\w*, \w obedeçam|strong="G5219"\w* \w aos que são senhores|strong="G3588,G2962"\w* \w segundo a carne|strong="G2596,G4561"\w*, \w com temor|strong="G3326,G5401"\w* \w e|strong="G2532"\w* \w tremor|strong="G5156"\w*, \w com sinceridade|strong="G1722,G572"\w* \w de coração|strong="G3588,G2588"\w* \w de vocês|strong="G4771"\w*, \w como a Cristo|strong="G5613,G3588,G5547"\w*,\f + \fr 6.5: \ft Variante: o RP traz a ordem “senhores segundo a carne” (κυρίοις κατὰ σάρκα).\f*\f + \fr 6.5: \ft Acréscimo: verbo ser/estar suprido em “aos que são senhores”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:5 \xt COL 3:22; PHP 2:12; 1PE 2:18; EPH 6:1; TIT 2:9; EPH 6:7\x*
\v 6 \w não por|strong="G3361,G2596"\w* \w serviço só para ser visto|strong="G3787"\w*, \w como quem busca agradar a pessoas|strong="G5613,G441"\w*, \w mas|strong="G235"\w* \w como escravos|strong="G5613,G1401"\w* \w de Cristo|strong="G5547"\w*, \w fazendo|strong="G4160"\w* \w a vontade|strong="G3588,G2307"\w* \w de Deus|strong="G3588,G2316"\w*, \w de toda a alma|strong="G1537,G5590"\w*\f + \fr 6.6: \ft Acréscimo: verbo ser/estar suprido em “serviço só para ser visto”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:6 \xt COL 3:22; COL 3:23; GAL 1:10; MAT 6:10; MAT 7:21; 1TH 2:4\x*
\v 7 \w com boa vontade|strong="G3326,G2133"\w* \w servindo|strong="G1398"\w*, \w como ao Senhor|strong="G5613,G3588,G2962"\w* \w e|strong="G2532"\w* \w não a pessoas|strong="G3756,G444"\w*,\x - \xo 6:7 \xt COL 3:23; 1CO 10:31; COL 3:22; EPH 6:5-6; ROM 12:11; 1PE 2:15\x*
\v 8 \w sabendo|strong="G6063"\w* \w que|strong="G3754"\w* \w cada um|strong="G1538"\w*, \w o que quer que|strong="G3739,G302"\w* \w fizer|strong="G4160"\w* \w de bom|strong="G18"\w*, \w isto|strong="G3778"\w* \w receberá de volta|strong="G2865"\w* \w da parte do Senhor|strong="G3844,G2962"\w*, \w seja escravo|strong="G1535,G1401"\w* \w ou livre|strong="G1535,G1658"\w*.\f + \fr 6.8: \ft Variante: WH e NA28 trazem “se cada um fizer algo de bom” (ἕκαστος ἐάν τι); Treg traz ἕκαστος ὃ ἂν, como o SBLGNT; o RP traz ὃ ἐάν τι ἕκαστος e “do” (τοῦ) antes de “Senhor”.\f*\f + \fr 6.8: \ft Acréscimo: verbo ser/estar suprido em “seja escravo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:8 \xt 2CO 5:10; COL 3:24; MAT 16:27; COL 4:1; ROM 12:11; LUK 14:14\x*
\v 9 \w E|strong="G2532"\w* \w senhores|strong="G3588,G2962"\w*, \w façam o mesmo|strong="G3588,G846,G4160"\w* \w para com eles|strong="G4314,G846"\w*, \w abrindo mão|strong="G447"\w* \w da ameaça|strong="G3588,G547"\w*, \w sabendo|strong="G6063"\w* \w que|strong="G3754"\w* \w o Senhor|strong="G3588,G2962"\w* \w deles|strong="G2532,G846"\w* \w e|strong="G2532"\w* \w de vocês|strong="G4771"\w* \w está|strong="G1510"\w* \w nos céus|strong="G1722,G3772"\w*, \w e|strong="G2532"\w* \w parcialidade|strong="G4382"\w* \w não há|strong="G3756,G1510"\w* \w junto a ele|strong="G3844,G846"\w*.\x - \xo 6:9 \xt ROM 2:11; ACT 10:34; COL 4:1; COL 3:25; DEU 10:17; JOB 31:13\x*
\p
\v 10 \w Quanto ao mais|strong="G3588,G3064"\w*, \w fortaleçam-se|strong="G1743"\w* \w no Senhor|strong="G1722,G2962"\w* \w e|strong="G2532"\w* \w na força|strong="G1722,G3588,G2904"\w* \w do vigor|strong="G3588,G2479"\w* \w dele|strong="G846"\w*.\f + \fr 6.10: \ft Variante: o RP traz “No mais, meus irmãos” (Τὸ λοιπόν, ἀδελφοί μου) em lugar de “Quanto ao mais” (Τοῦ λοιποῦ).\f*\x - \xo 6:10 \xt EPH 1:19; 1CO 16:13; ISA 40:31; JOS 1:9; PHP 4:13; DEU 31:6\x*
\v 11 \w Vistam|strong="G1746"\w* \w a armadura completa|strong="G3588,G3833"\w* \w de Deus|strong="G3588,G2316"\w*, \w para que possam|strong="G4314,G3588,G1410,G4771"\w* \w manter-se firmes|strong="G2476"\w* \w contra as artimanhas|strong="G4314,G3588,G3180"\w* \w do diabo|strong="G3588,G1228"\w*;\x - \xo 6:11 \xt EPH 6:13; 1PE 5:8; 2CO 10:4; JAS 4:7; ROM 13:12; 1TH 5:8\x*
\v 12 \w porque|strong="G3754"\w* \w a nossa luta|strong="G3165,G3588,G3823"\w*\f + \fr 6.12: \ft Lit.: Πάλη, “luta corpo a corpo”.\f* \w não é|strong="G3756,G1510"\w* \w contra sangue|strong="G4314,G129"\w* \w e|strong="G2532"\w* \w carne|strong="G4561"\w*, \w mas|strong="G235"\w* \w contra os governos|strong="G4314,G3588,G746"\w*, \w contra as autoridades|strong="G4314,G3588,G1849"\w*, \w contra os governantes do mundo|strong="G4314,G3588,G2888"\w*\f + \fr 6.12: \ft Lit.: Κοσμοκράτωρ, “governante do mundo”.\f* \w destas trevas|strong="G3588,G4655,G3778"\w*, \w contra as forças espirituais|strong="G4314,G3588,G4152"\w*\f + \fr 6.12: \ft Lit.: Τὰ πνευματικά, neutro plural: “as (forças, coisas) espirituais”.\f* \w da maldade|strong="G3588,G4189"\w* \w nas regiões celestes|strong="G1722,G3588,G2032"\w*.\f + \fr 6.12: \ft Variante: o RP traz “desta era de trevas” (τοῦ σκότους τοῦ αἰῶνος τούτου) em lugar de “destas trevas” (τοῦ σκότους τούτου).\f*\x - \xo 6:12 \xt EPH 3:10; EPH 1:3; 2CO 4:4; COL 1:13; EPH 2:2; JAS 4:7\x*
\v 13 \w Por isso|strong="G1223,G3778"\w* \w tomem|strong="G353"\w* \w a armadura completa|strong="G3588,G3833"\w* \w de Deus|strong="G3588,G2316"\w*, \w para que possam|strong="G2443,G1410"\w* \w resistir|strong="G436"\w* \w no dia|strong="G1722,G3588,G2250"\w* \w mau|strong="G3588,G4190"\w* \w e|strong="G2532"\w*, \w tendo realizado|strong="G2716"\w*\f + \fr 6.13: \ft Lit.: Κατεργάζομαι, “realizar, levar a cabo”; também “vencer”.\f* \w tudo|strong="G537"\w*, \w manter-se firmes|strong="G2476"\w*.\x - \xo 6:13 \xt EPH 6:11; 1CO 16:13; 1CO 10:13; 2CO 10:4; 1JN 4:4; PSA 1:1\x*
\v 14 \w Mantenham-se firmes|strong="G2476"\w*, \w portanto|strong="G3767"\w*, \w tendo cingido|strong="G4024"\w* \w a cintura|strong="G3588,G3751"\w* \w de vocês|strong="G4771"\w* \w com a verdade|strong="G1722,G225"\w*, \w e|strong="G2532"\w* \w tendo vestido|strong="G1746"\w* \w a couraça|strong="G3588,G2382"\w* \w da justiça|strong="G3588,G1343"\w*,\f + \fr 6.14: \ft Nota cultural: O conjunto da armadura lembra imagens de Isaías (por exemplo, 11:5 e 59:17).\f*\x - \xo 6:14 \xt 1TH 5:8; LUK 12:35; 1CO 16:13; ISA 59:17; 2CO 10:4; ISA 11:5\x*
\v 15 \w e|strong="G2532"\w* \w tendo calçado|strong="G5265"\w* \w os pés|strong="G3588,G4228"\w* \w com a prontidão|strong="G1722,G2091"\w*\f + \fr 6.15: \ft Lit.: Ἑτοιμασία, “prontidão, preparo”; pode ter também o sentido de “base firme”.\f* \w da boa notícia|strong="G3588,G2098"\w* \w da paz|strong="G3588,G1515"\w*,\x - \xo 6:15 \xt 1CO 16:13; 2CO 10:4; ISA 52:7; ROM 10:15; EPH 6:13; 1TI 6:12\x*
\v 16 \w em tudo|strong="G1722,G3956"\w*\f + \fr 6.16: \ft Lit.: Ἐν πᾶσιν: “em tudo” ou “sobre tudo, acima de tudo”.\f*, \w tendo tomado|strong="G353"\w* \w o escudo grande|strong="G3588,G2375"\w* \w da fé|strong="G3588,G4102"\w*, \w com o qual|strong="G1722,G3739"\w* \w poderão|strong="G1410"\w* \w apagar|strong="G4570"\w* \w todas as flechas|strong="G3956,G3588,G956"\w* \w do Maligno|strong="G3588,G4190"\w* \w incendiadas|strong="G4448"\w*:\f + \fr 6.16: \ft Variante: o TR e o Byz trazem ἐπὶ (“acima de”) em lugar de ἐν (“em”) no início; o SBLGNT não traz o artigo τὰ antes de “incendiadas”, que NA28, WH, Treg, TR e Byz trazem.\f*\f + \fr 6.16: \ft Lit.: Τοῦ πονηροῦ: “do Maligno” (masculino, pessoal) ou “do mal” (neutro); a forma grega é a mesma.\f*\x - \xo 6:16 \xt EPH 6:13; 1CO 16:13; 2CO 10:4; 1PE 5:8-9; 1JN 5:4-5; 1TI 6:12\x*
\v 17 \w e|strong="G2532"\w* \w o capacete|strong="G3588,G4030"\w* \w da salvação|strong="G3588,G4992"\w* \w recebam|strong="G1209"\w*, \w e|strong="G2532"\w* \w a espada|strong="G3588,G3162"\w* \w do Espírito|strong="G3588,G4151"\w*, \w que é|strong="G3739,G1510"\w* \w palavra|strong="G4487"\w* \w de Deus|strong="G2316"\w*,\f + \fr 6.17: \ft Variante: o RP traz o infinitivo δέξασθαι (“receber”) em lugar do imperativo δέξασθε (“recebam”).\f*\x - \xo 6:17 \xt 1CO 16:13; HEB 4:12; MAT 4:4; 2CO 10:4; EPH 6:13; ISA 59:17\x*
\v 18 \w por meio de toda|strong="G1223,G3956"\w* \w oração|strong="G4335"\w* \w e|strong="G2532"\w* \w súplica|strong="G1162"\w*, \w orando|strong="G4336"\w* \w em todo tempo|strong="G1722,G3956,G2540"\w* \w no Espírito|strong="G1722,G4151"\w*, \w e|strong="G2532"\w* \w para isso mesmo|strong="G1519,G846"\w* \w vigiando|strong="G69"\w* \w com toda|strong="G1722,G3956"\w* \w persistência|strong="G4343"\w* \w e|strong="G2532"\w* \w súplica|strong="G1162"\w* \w por todos|strong="G4012,G3956"\w* \w os santos|strong="G3588,G40"\w*,\x - \xo 6:18 \xt PHP 4:6; 1TI 2:1; MRK 13:33; LUK 21:36; 1CO 16:13; 1TH 5:17\x*
\v 19 \w e|strong="G2532"\w* \w por mim|strong="G5228,G1473"\w*, \w para que|strong="G2443"\w* \w me seja dada|strong="G3165,G1325"\w* \w palavra|strong="G3056"\w* \w ao abrir|strong="G1722,G457"\w* \w a minha boca|strong="G3588,G4750,G3165"\w*, \w com coragem|strong="G1722,G3954"\w* \w dar a conhecer|strong="G1107"\w* \w o mistério|strong="G3588,G3466"\w* \w da boa notícia|strong="G3588,G2098"\w*\x - \xo 6:19 \xt EPH 1:9; EPH 3:3; LUK 21:15; COL 4:3; ACT 4:29; 2TH 3:1\x*
\v 20 \w em favor do qual|strong="G5228,G3739"\w* \w sirvo como embaixador|strong="G4243"\w*\f + \fr 6.20: \ft Lit.: Πρεσβεύω, “atuar como embaixador”.\f* \w em uma corrente|strong="G1722,G254"\w*, \w para que|strong="G2443"\w* \w nele|strong="G1722,G846"\w* \w eu fale com coragem|strong="G3955"\w* \w como|strong="G5613"\w* \w é necessário|strong="G1163"\w* \w que eu|strong="G3165"\w* \w fale|strong="G2980"\w*.\x - \xo 6:20 \xt 2CO 5:20; COL 4:3; ACT 12:5; MAT 18:19; COL 4:1; PHP 1:14\x*
\p
\v 21 \w Para que|strong="G2443"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w saibam|strong="G6063"\w* \w a minha situação|strong="G3588,G2596,G1473"\w*, \w o que faço|strong="G5101,G4238"\w*, \w Tíquico|strong="G5190"\w*, \w o amado|strong="G3588,G27"\w* \w irmão|strong="G80"\w* \w e|strong="G2532"\w* \w fiel|strong="G4103"\w* \w servo|strong="G1249"\w* \w no Senhor|strong="G1722,G2962"\w*, \w dará a conhecer|strong="G1107"\w* \w a vocês|strong="G4771"\w* \w tudo|strong="G3956"\w*,\x - \xo 6:21 \xt COL 4:7; ACT 20:4; COL 1:2; 2TI 4:12; 1TH 3:2; 1CO 4:17\x*
\v 22 \w a quem|strong="G3739"\w* \w envio|strong="G3992"\w*\f + \fr 6.22: \ft Lit.: Ἔπεμψα, aoristo epistolar (“enviei”, do ponto de vista de quem lê a carta); traduzido no presente.\f* \w a vocês|strong="G4314,G4771"\w* \w exatamente para isto|strong="G1519,G846,G3778"\w*, \w para que|strong="G2443"\w* \w saibam|strong="G1097"\w* \w como estamos|strong="G3588,G4012,G3165"\w* \w e|strong="G2532"\w* \w ele encoraje|strong="G3870"\w* \w os corações|strong="G3588,G2588"\w* \w de vocês|strong="G4771"\w*.\f + \fr 6.22: \ft Acréscimo: verbo ser/estar suprido em “como estamos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:22 \xt COL 4:8; 1TH 3:2; 1CO 14:3; COL 2:2; COL 4:7; PHP 2:25\x*
\v 23 \w Paz|strong="G1515"\w* \w aos irmãos e irmãs|strong="G3588,G80"\w* \w e|strong="G2532"\w* \w amor|strong="G26"\w* \w com fé|strong="G3326,G4102"\w* \w da parte de Deus|strong="G575,G2316"\w* \w Pai|strong="G3962"\w* \w e|strong="G2532"\w* \w do Senhor|strong="G2962"\w* \w Jesus Cristo|strong="G2424,G5547"\w*.\x - \xo 6:23 \xt PHM 1:5; 1TI 1:14; 1PE 5:14; COL 1:4; ROM 5:1; GAL 5:6\x*
\v 24 \w A graça|strong="G3588,G5485"\w* \w esteja com|strong="G3326"\w* \w todos|strong="G3956"\w* \w os que amam|strong="G3588,G25"\w* \w o nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus Cristo|strong="G2424,G5547"\w* \w em incorruptibilidade|strong="G1722,G861"\w*.\f + \fr 6.24: \ft Lit.: Ἐν ἀφθαρσίᾳ: “em incorruptibilidade”; pode ser entendido como “com amor incorruptível/sincero” ou “em imortalidade”.\f*\f + \fr 6.24: \ft Variante: o RP acrescenta “Amém” (Ἀμήν).\f*\f + \fr 6.24: \ft Acréscimo: verbo ser/estar suprido em “esteja com”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:24 \xt JHN 14:15; NUM 6:24; LUK 7:47; 1PE 1:8; JHN 21:15; 1CO 16:22\x*
