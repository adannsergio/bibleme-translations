\v 26 \w Mas a mim|strong="H9030,H0589"\w*, \w teu servo|strong="H5650"\w*, \w e a Zadoque|strong="H6659"\w*, \w o sacerdote|strong="H3548"\w*, \w e a Benaia|strong="H1141"\w*, \w filho|strong="H1121"\w* \w de Joiada|strong="H3077"\w*, \w e a Salomão|strong="H8010"\w*, \w teu servo|strong="H5650"\w*, \w não|strong="H3808"\w* \w nos convidou|strong="H7121"\w*.\x - \xo 1:26 \xt 1KI 1:32; 1KI 1:8; 1KI 4:4; 1KI 2:35; 1KI 1:38; 1KI 2:25\x*
\v 27 \w Será que|strong="H0518,H0854"\w* \w de meu senhor|strong="H0113"\w*, \w o rei|strong="H4428"\w*, \w veio|strong="H1961"\w* \w esta coisa|strong="H1697,H2088"\w*, \w e não|strong="H3808"\w* \w a revelaste|strong="H3045"\w* \w ao teu servo|strong="H5650"\w*\f + \fr 1.27: \ft Variante: a Ketiv tem "aos teus servos" (עַבְדֶיךָ, plural); a Qere, que seguimos, "ao teu servo" (עַבְדְּךָ, singular)\f*, \w sobre quem|strong="H4310"\w* \w se assentará|strong="H3427"\w* \w no trono|strong="H5921,H3678"\w* \w de meu senhor|strong="H0113"\w*, \w o rei|strong="H4428"\w*, \w depois dele|strong="H0310"\w*?"\x - \xo 1:27 \xt 1KI 1:20; 1KI 1:24; 1KI 1:37; 1KI 1:17\x*
\p
