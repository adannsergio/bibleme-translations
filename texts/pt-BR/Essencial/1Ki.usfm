\v 12 \w Agora|strong="H6258"\w*, \w vem|strong="H1980"\w*, \w deixa-me|strong="H3289"\w* \w te dar|strong="H3289"\w* \w um conselho|strong="H4994,H6098"\w*, \w e salva|strong="H4422"\w* \w a tua vida|strong="H5315"\w* \w e|strong="H0853"\w* \w a vida|strong="H5315"\w* \w do teu filho|strong="H1121"\w* \w Salomão|strong="H8010"\w*.\x - \xo 1:12 \xt ISA 14:26; 1KI 12:13; 2SA 16:23\x*
