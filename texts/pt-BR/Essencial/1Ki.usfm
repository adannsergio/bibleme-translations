\v 21 \w E será que|strong="H1961"\w*, \w quando|strong="H7901"\w* \w meu senhor|strong="H0113"\w*, \w o rei|strong="H4428"\w*, \w se deitar com|strong="H7901,H5973"\w* \w os seus pais|strong="H0001"\w*, \w eu|strong="H1961,H0589"\w* \w e meu filho|strong="H1121"\w* \w Salomão|strong="H8010"\w* \w seremos|strong="H1961"\w* \w culpados|strong="H2400"\w*."\x - \xo 1:21 \xt 1KI 2:10; 1TH 4:13; DEU 31:16; 2SA 7:12\x*
\p
\v 22 \w E eis|strong="H2009"\w* \w que, enquanto ela ainda|strong="H5750"\w* \w estava|strong="H5750"\w* \w falando|strong="H1696"\w* \w com|strong="H5973"\w* \w o rei|strong="H4428"\w*, \w Natã|strong="H5416"\w*, \w o profeta|strong="H5030"\w*, \w chegou|strong="H0935"\w*.\x - \xo 1:22 \xt 2SA 12:25; DEU 34:10; 1KI 1:10; PSA 51:0\x*
