\v 1 \w E o rei|strong="H4428"\w* \w Davi|strong="H1732"\w* \add estava\add* \w velho|strong="H2204"\w*, \w avançado|strong="H0935"\w* \w em dias|strong="H3117"\w*; \w cobriam-no|strong="H3680"\w* \w com as roupas|strong="H0899"\w*, \w mas não|strong="H3808"\w* \w conseguia aquecer-se|strong="H2552,H9033"\w*.\x - \xo 1:1 \xt ECC 4:11; PSA 90:10; 1CH 29:27-28; JOS 23:1-2; 1CH 23:1; 2SA 5:4\x*
\v 2 \w Seus servos|strong="H5650"\w* \w disseram-lhe|strong="H0559,H9033"\w*: "\w Busquem|strong="H1245"\w* \w para o meu senhor|strong="H0113"\w*, \w o rei|strong="H4428"\w*, \add uma\add* \w jovem|strong="H5291"\w* \w virgem|strong="H1330"\w*; \w que ela fique|strong="H5975"\w* \w diante do rei|strong="H6440,H4428"\w* \w e seja|strong="H1961,H9033"\w* \add sua\add* \w cuidadora|strong="H5532"\w*, \w e durma|strong="H7901"\w* \w em seu colo|strong="H2436"\w*, \w para que se aqueça|strong="H2552"\w* \w o meu senhor|strong="H0113"\w*, \w o rei|strong="H4428"\w*."\x - \xo 1:2 \xt ECC 4:11; EST 2:2; GEN 16:5; MIC 7:5; 1SA 16:21-22; 2SA 12:3\x*
\v 3 \w E buscaram|strong="H1245"\w* \add uma\add* \w jovem|strong="H5291"\w* \w bela|strong="H3303"\w* \w em todo|strong="H3605"\w* \w o território|strong="H1366"\w* \w de Israel|strong="H3478"\w*, \w e encontraram|strong="H4672"\w* \w Abisague|strong="H0049"\w*, \w a sunamita|strong="H7767"\w*, \w e a trouxeram|strong="H0935,H0853"\w* \w ao rei|strong="H4428"\w*.\x - \xo 1:3 \xt 1KI 2:17; 1KI 2:21; ECC 4:11; EST 2:4; JOS 19:18; 2KI 4:8\x*
\v 4 \w E a jovem|strong="H5291"\w* \w era|strong="H3303"\w* \w bela|strong="H3303"\w* \w até o extremo|strong="H5704,H3966"\w*; \w e ela se tornou|strong="H1961"\w* \w cuidadora|strong="H4428,H5532"\w* \w do rei|strong="H4428"\w* \w e o servia|strong="H8334"\w*; \w mas o rei|strong="H4428"\w* \w não|strong="H3808"\w* \w a conheceu|strong="H3045"\w*.\x - \xo 1:4 \xt ECC 4:11; MAT 1:25; 1KI 1:2\x*
