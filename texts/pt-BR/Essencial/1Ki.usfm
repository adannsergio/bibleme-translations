\v 9 \w Adonias sacrificou|strong="H2076,H0138"\w* \w ovelhas|strong="H6629"\w*, \w bois|strong="H1241"\w* \w e animais cevados|strong="H4806"\w* \w junto à|strong="H5973"\w* \w pedra|strong="H0068"\w* \w de Zoelete|strong="H2120"\w*, \w que|strong="H0834"\w* \w está ao lado|strong="H0681"\w* \w de En-Rogel|strong="H5883"\w*, \w e convidou|strong="H7121"\w* \w todos|strong="H3605"\w* \w os seus irmãos|strong="H0251"\w*, \w os filhos|strong="H1121"\w* \w do rei|strong="H4428"\w*, \w e todos|strong="H3605"\w* \w os homens|strong="H0582"\w* \w de Judá|strong="H3063"\w*, \w servos|strong="H5650"\w* \w do rei|strong="H4428"\w*.\x - \xo 1:9 \xt 1KI 1:25; 2SA 17:17; JOS 15:7; 2CH 18:2\x*
\v 10 \w Mas a Natã|strong="H0853,H5416"\w*, \w o profeta|strong="H5030"\w*, \w e a Benaia|strong="H1141"\w*, \w e aos guerreiros|strong="H0853,H1368"\w*, \w e a Salomão|strong="H0853,H8010"\w*, \w seu irmão|strong="H0251"\w*, \w não|strong="H3808"\w* \w convidou|strong="H7121"\w*.\x - \xo 1:10 \xt 1KI 1:8; 1KI 1:26; 1KI 1:32; 1KI 1:22; 2SA 12:25; 2SA 12:24\x*
