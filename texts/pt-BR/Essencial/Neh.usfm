\v 1 \w E houve|strong="H1961"\w* \w um clamor|strong="H6818"\w* \w do povo|strong="H5971"\w* \w e de suas mulheres|strong="H0802"\w*, \w grande|strong="H1419"\w*, \w contra|strong="H0413"\w* \w os seus irmãos|strong="H0251"\w* \w judeus|strong="H3064"\w*.\x - \xo 5:1 \xt EXO 11:6; ECC 4:1; ISA 5:7; PSA 82:4; DEU 15:7-11; EXO 21:2\x*
