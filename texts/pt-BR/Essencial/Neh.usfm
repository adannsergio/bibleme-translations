\v 1 \w E aconteceu|strong="H1961"\w* \w que, quando|strong="H0834"\w* \w se ouviu dizer|strong="H8085"\w* \w a Sambalate|strong="H5571"\w*, \w e a Tobias|strong="H2900"\w*, \w e a Gesém|strong="H1654"\w*, \w o árabe|strong="H6163"\w*, \w e ao resto|strong="H3499"\w* \w dos nossos inimigos|strong="H0341"\w*, \w que|strong="H3588"\w* \w eu tinha reconstruído|strong="H1129"\w* \w o muro|strong="H2346"\w* \w e que não|strong="H3808"\w* \w restava|strong="H3498"\w* \w nele|strong="H9034"\w* \w brecha alguma|strong="H6556"\w* — \w embora|strong="H1571"\w* \w até|strong="H5704"\w* \w aquele tempo|strong="H6256,H1931"\w* \w eu não tivesse|strong="H3808"\w* \w colocado|strong="H5975"\w* \w as portas|strong="H1817"\w* \w nos portões|strong="H8179"\w*—\x - \xo 6:1 \xt NEH 2:19; PSA 147:13; NEH 2:10; NEH 4:1; NEH 3:1; NEH 3:3\x*
\v 2 \w Mandaram|strong="H7971"\w* \w Sambalate|strong="H5571"\w* \w e Gesém|strong="H1654"\w*-\w me|strong="H0413"\w* \w dizer|strong="H0559"\w*: "\w Venha|strong="H1980"\w*, \w e vamos nos encontrar|strong="H3259"\w* \w juntos|strong="H3162"\w* \w em Hacefirim|strong="H3715"\w*, \w na planície|strong="H1237"\w* \w de Ono|strong="H0207"\w*."\w Mas eles|strong="H1992"\w* \w estavam planejando|strong="H2803"\w* \w me fazer|strong="H6213,H9030"\w* \w mal|strong="H7451"\w*.\x - \xo 6:2 \xt 1CH 8:12; NEH 2:19; PSA 37:12; NEH 11:35; NEH 6:16\x*
\v 3 \w E eu lhes enviei|strong="H7971,H5921"\w* \w mensageiros|strong="H4397"\w*, \w dizendo|strong="H0559"\w*: "\w Eu|strong="H0589"\w* \w estou fazendo|strong="H6213"\w* \w uma grande obra|strong="H4399,H1419"\w*, \w e não|strong="H3808"\w* \w posso|strong="H3201"\w* \w descer|strong="H3381"\w*; \w por que|strong="H4100"\w* \w cessaria|strong="H7673"\w* \w a obra|strong="H4399"\w*, \w se|strong="H0834"\w* \w eu a deixasse|strong="H7503"\w* \w para descer|strong="H3381"\w* \w até vocês|strong="H0413"\w*?"\x - \xo 6:3 \xt JHN 9:4; MAT 10:16; 1TI 4:15-16; ACT 6:2; ECC 9:10; LUK 14:30\x*
\v 4 \w E eles me enviaram|strong="H7971,H0413"\w* \w esta mesma mensagem|strong="H1697,H2088"\w* \w quatro|strong="H0702"\w* \w vezes|strong="H6471"\w*, \w e eu lhes respondi|strong="H7725,H0853"\w* \w da mesma maneira|strong="H1697,H2088"\w*.\x - \xo 6:4 \xt LUK 18:5; EXO 25:12; EXO 37:3\x*
\v 5 \w E enviou|strong="H7971,H0413"\w* \w Sambalate|strong="H5571"\w* \w esta mesma mensagem|strong="H1697,H2088"\w* \w pela quinta vez|strong="H6471,H2549"\w*, \w por meio do seu servo|strong="H5288"\w*, \w com uma carta|strong="H0107"\w* \w aberta|strong="H6605"\w* \w na mão|strong="H3027"\w*.\x - \xo 6:5 \xt 2CO 11:13-15; 2TH 2:10; 2CO 2:11; 2KI 18:26-28; EPH 6:11\x*
\v 6 \w Estava escrito|strong="H3789"\w* \w nela|strong="H9034"\w*: "\w Ouviu-se|strong="H8085"\w* \w entre as nações|strong="H1471"\w*, \w e Gasmu|strong="H1654"\w* \w diz|strong="H0559"\w* \add que\add* \w você|strong="H0859"\w* \w e os judeus|strong="H3064"\w* \w estão planejando|strong="H2803"\w* \w se rebelar|strong="H4775"\w*; \w por isso|strong="H5921,H3651"\w* \w você|strong="H0859"\w* \w está reconstruindo|strong="H1129"\w* \w o muro|strong="H2346"\w*; \w e você|strong="H0859"\w* \w está prestes a ser|strong="H1933"\w* \w rei|strong="H4428"\w* \w deles|strong="H9038"\w*, \w conforme|strong="H1697"\w* \w estas palavras|strong="H0428"\w*."\x - \xo 6:6 \xt NEH 2:19; NEH 6:13; 1PE 3:16; EZR 4:12; JER 20:10; ROM 3:8\x*
\v 7 \w E também|strong="H1571"\w* \w profetas|strong="H5030"\w* \w você designou|strong="H5975"\w* \w para proclamarem|strong="H7121"\w* \w a seu respeito|strong="H5921"\w* \w em Jerusalém|strong="H3389"\w*, \w dizendo|strong="H0559"\w*: "\w Há um rei|strong="H4428"\w* \w em Judá|strong="H3063"\w*!"\w E agora|strong="H6258"\w* \w isso será ouvido|strong="H8085"\w* \w pelo rei|strong="H4428"\w*, \w conforme|strong="H1697"\w* \w estas palavras|strong="H0428"\w*; \w vamos, pois|strong="H6258,H1980"\w* \w nos aconselhar|strong="H3289"\w* \w juntos|strong="H3162"\w*.\x - \xo 6:7 \xt PRO 26:24-26; JER 20:10; PSA 71:10\x*
\v 8 \w E eu enviei|strong="H7971,H0413"\w* \w dizer|strong="H0559"\w*: "\w Não|strong="H3808"\w* \w aconteceu|strong="H1961"\w* \w nada parecido com essas palavras|strong="H1697,H0428"\w* \w que|strong="H0834"\w* \w você|strong="H0859"\w* \w está dizendo|strong="H0559"\w*; \w pois|strong="H3588"\w* \w você|strong="H0859"\w* \w as está inventando|strong="H0908"\w* \w do seu próprio coração|strong="H3820"\w*."\x - \xo 6:8 \xt 1KI 12:33; PSA 52:2; JOB 13:4; JER 20:10\x*
\v 9 \w Porque|strong="H3588"\w* \w todos eles|strong="H3605"\w* \w queriam nos intimidar|strong="H3372,H0853"\w*, \w dizendo|strong="H0559"\w*: "\w As suas mãos|strong="H3027"\w* \w vão desanimar|strong="H7503"\w* \w da|strong="H4480"\w* \w obra|strong="H4399"\w*, \w e ela não|strong="H3808"\w* \w será feita|strong="H6213"\w*."\w Mas agora|strong="H6258"\w*, \w fortalece|strong="H2388"\w* \w as minhas mãos|strong="H3027"\w*!\x - \xo 6:9 \xt 2KI 12:14; 2CH 15:7; 1CH 28:20; JOB 6:21; 2CH 34:10; ZEP 3:16\x*
\p
\v 10 \w E eu|strong="H0589"\w* \w fui|strong="H0935"\w* \w à casa|strong="H1004"\w* \w de Semaías|strong="H8098"\w*, \w filho de|strong="H1121"\w* \w Delaías|strong="H1806"\w*, \w filho de|strong="H1121"\w* \w Meetabel|strong="H4105"\w*, \w que|strong="H1931"\w* \w estava fechado em casa|strong="H6113"\w*; \w e ele disse|strong="H0559"\w*: "\w Vamos nos encontrar|strong="H3259"\w* \w na|strong="H0413"\w* \w casa|strong="H1004"\w* \w de Deus|strong="H0430"\w*, \w dentro|strong="H0413,H8432"\w* \w do templo|strong="H1964"\w*, \w e fechemos|strong="H5462"\w* \w as portas|strong="H1817"\w* \w do templo|strong="H1964"\w*, \w porque|strong="H3588"\w* \w vêm|strong="H0935"\w* \w para matar você|strong="H2026"\w*; \w sim, de noite|strong="H3915"\w* \w vêm|strong="H0935"\w* \w para matar você|strong="H2026"\w*."\x - \xo 6:10 \xt PSA 27:5; JER 36:5; JER 20:10; LUK 13:31; MAT 7:15; PSA 11:3\x*
\v 11 \w E eu disse|strong="H0559"\w*: "\w Será que um homem|strong="H0376"\w* \w como eu|strong="H3644"\w* \w haveria de fugir|strong="H1272"\w*? \w E quem|strong="H4310"\w*, \w como eu|strong="H3644"\w*, \w que|strong="H0834"\w* \w poderia entrar|strong="H0935"\w* \w no|strong="H0413"\w* \w templo|strong="H1964"\w* \w e continuar vivo|strong="H2421"\w*? \w Não|strong="H3808"\w* \w entrarei|strong="H0935"\w*."\x - \xo 6:11 \xt PSA 27:5; PRO 28:1; ACT 21:13; PSA 11:1-2; ACT 20:24; DAN 6:10\x*
\v 12 \w E percebi|strong="H5234"\w* \w que|strong="H2009"\w* \w não|strong="H3808"\w* \add foi\add* \w Deus|strong="H0430"\w* \add quem o\add* \w enviou|strong="H7971"\w*, \w pois|strong="H3588"\w* \w proferiu|strong="H1696"\w* \w aquela profecia|strong="H5016"\w* \w contra mim|strong="H5921"\w*; \w Tobias|strong="H2900"\w* \w e Sambalate|strong="H5571"\w* \w o tinham contratado|strong="H7936"\w*.\x - \xo 6:12 \xt 2PE 2:1; EZK 13:22; JER 20:10; PRO 27:8; PSA 11:3\x*
\v 13 \w Para que|strong="H4616"\w* \w ele estivesse contratado|strong="H7936,H1931"\w*, \w para que|strong="H4616"\w* \w eu tivesse medo|strong="H3372"\w* \w e assim agisse|strong="H6213,H3651"\w* \w e pecasse|strong="H2398"\w*, \w e isso se tornasse|strong="H1961"\w* \w para eles|strong="H9038"\w* \w um nome|strong="H8034"\w* \w mau|strong="H7451"\w*, \w para que|strong="H4616"\w* \w me pudessem difamar|strong="H2778"\w*.\x - \xo 6:13 \xt 2PE 2:1; JER 20:10; 2CO 11:12; 2TI 1:7; JAS 4:17; NEH 6:6\x*
\v 14 \w Lembre-se|strong="H2142"\w*, \w meu Deus|strong="H0430"\w*, \w de Tobias|strong="H2900"\w* \w e de Sambalate|strong="H5571"\w*, \w conforme estas obras deles|strong="H4639,H0428"\w*; \w e também|strong="H1571"\w* \w de Noadias|strong="H5129"\w*, \w a profetisa|strong="H5031"\w*, \w e do resto|strong="H3499"\w* \w dos profetas|strong="H5030"\w* \w que|strong="H0834"\w* \w estavam|strong="H1961"\w* \w me intimidando|strong="H3372,H0853"\w*.\x - \xo 6:14 \xt 2PE 2:1; NEH 13:29; 2TI 4:14-15; ACT 21:9; NEH 6:9\x*
\p
