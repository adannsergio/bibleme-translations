\v 20 \w E eu respondi-lhes|strong="H7725,H0853,H1697"\w* \w e lhes disse|strong="H0559,H9038"\w*: "\w O Deus|strong="H0430"\w* \w dos céus|strong="H8064"\w* \w é quem|strong="H1931"\w* \w nos dará sucesso|strong="H6743,H9035"\w*; \w e nós|strong="H0587"\w*, \w seus servos|strong="H5650"\w*, \w nos levantaremos|strong="H6965"\w* \w e construiremos|strong="H1129"\w*; \w mas vocês|strong="H9036"\w* \w não têm|strong="H0369"\w* \w parte|strong="H2506"\w*, \w nem direito|strong="H6666"\w*, \w nem memória|strong="H2146"\w* \w em Jerusalém|strong="H3389"\w*."\x - \xo 2:20 \xt ACT 8:21; EZR 4:3; JER 29:12; NEH 2:4; ACT 10:31; ISA 56:5\x*
\c 3
\p
