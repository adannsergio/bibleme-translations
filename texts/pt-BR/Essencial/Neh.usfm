\v 17 \w E eu disse|strong="H0559"\w*-\w lhes|strong="H0413"\w*: "\w Vocês|strong="H0859"\w* \w veem|strong="H7200"\w* \w a desgraça|strong="H7451"\w* \w em que estamos|strong="H0834,H0587,H9034"\w*, \w que|strong="H0834"\w* \w Jerusalém|strong="H3389"\w* \w está em ruínas|strong="H2720"\w*, \w e as suas portas|strong="H8179"\w* \add foram\add* \w queimadas|strong="H3341"\w* \w pelo fogo|strong="H0784"\w*; \w Venham|strong="H1980"\w*, \w e reconstruamos|strong="H1129"\w* \w o muro|strong="H2346"\w* \w de Jerusalém|strong="H3389"\w*, \w e não|strong="H3808"\w* \w sejamos|strong="H1961"\w* \w mais|strong="H5750"\w* \w motivo de vergonha|strong="H2781"\w*."\x - \xo 2:17 \xt NEH 1:3; ISA 58:12; JER 29:12; EZK 5:14; ISA 35:3-4; LAM 3:45-46\x*
\v 18 \w E eu contei|strong="H5046,H9038"\w* \w da mão|strong="H0853,H3027"\w* \w do meu Deus|strong="H0430"\w*, \w que|strong="H0834"\w* \w estava|strong="H1931"\w* \w boa|strong="H2896"\w* \w sobre mim|strong="H5921"\w*, \w e também|strong="H0637"\w* \w das palavras|strong="H1697"\w* \w do rei|strong="H4428"\w*, \w que|strong="H0834"\w* \w ele tinha me dito|strong="H0559,H9030"\w*. \w E disseram|strong="H0559"\w*: "\w Vamos nos levantar|strong="H6965"\w* \w e construir|strong="H1129"\w*!"\w E fortaleceram|strong="H2388"\w* \w as suas mãos|strong="H3027"\w* \w para o bem|strong="H2896"\w*.\x - \xo 2:18 \xt 1CH 19:13; 1SA 23:16; PHP 2:13; 2CH 32:5; EPH 6:10; HAG 1:13-14\x*
