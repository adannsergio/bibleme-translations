\c 4
\p
\v 1 \w E aconteceu|strong="H1961"\w* \w que, quando|strong="H0834"\w* \w ouviu|strong="H8085"\w* \w Sambalate|strong="H5571"\w* \w que|strong="H3588"\w* \w nós estávamos|strong="H0587"\w* \w construindo|strong="H1129"\w* \w o muro|strong="H2346"\w*, \w ele se indignou|strong="H2734,H9033"\w* \w e ficou muito irritado|strong="H3707,H7235"\w*, \w e ridicularizou|strong="H3932"\w* \w os judeus|strong="H5921,H3064"\w*.\x - \xo 4:1 \xt JER 30:17; NEH 2:10; HEB 11:36; NEH 6:16; PSA 35:15-16; ACT 5:17\x*
\v 2 \w E ele disse|strong="H0559"\w* \w diante|strong="H6440"\w* \w dos seus irmãos|strong="H0251"\w* \w e do exército|strong="H2428"\w* \w de Samaria|strong="H8111"\w*, \w e disse|strong="H0559"\w*: "\w O que|strong="H4100"\w* \w esses judeus|strong="H3064"\w* \w fracos|strong="H0537"\w* \w estão fazendo|strong="H6213"\w*? \w Será que vão se fortalecer|strong="H5800,H9038"\w*? \w Será que vão oferecer sacrifícios|strong="H2076"\w*? \w Será que vão terminar|strong="H3615"\w* \w em um dia|strong="H3117"\w*? \w Será que vão dar vida de novo|strong="H2421"\w* \w às pedras|strong="H0068"\w* \w dos montes|strong="H6194"\w* \w de entulho|strong="H6083"\w*, \w que|strong="H1992"\w* \w estão queimadas|strong="H8313"\w*?"\x - \xo 4:2 \xt JER 30:17; ECC 9:10; ZEC 4:10; 1CO 1:27; EZR 4:9-10; JER 26:18\x*
\v 3 \w E Tobias|strong="H2900"\w*, \w o amonita|strong="H5984"\w*, \w estava ao lado dele|strong="H0681"\w*, \w e disse|strong="H0559"\w*: "\w Mesmo|strong="H1571"\w* \w o que|strong="H0834"\w* \w eles|strong="H1992"\w* \w estão construindo|strong="H1129"\w* — \w se|strong="H0518"\w* \w uma raposa|strong="H7776"\w* \w subir|strong="H5927"\w*, \w derrubará|strong="H6555"\w* \w o seu muro|strong="H2346"\w* \w de pedras|strong="H0068"\w*!"\x - \xo 4:3 \xt JER 30:17; ZEC 4:10; 2SA 10:2; NEH 2:10; NEH 2:19; PRO 22:10\x*
\v 4 \w Ouça|strong="H8085"\w*, \w nosso Deus|strong="H0430"\w*, \w que|strong="H3588"\w* \w nos tornamos|strong="H1961"\w* \w objeto de desprezo|strong="H0939"\w*; \w e faça voltar|strong="H7725"\w* \w a vergonha deles|strong="H2781"\w* \w sobre|strong="H0413"\w* \w a própria cabeça deles|strong="H7218"\w*, \w e entregue-os|strong="H5414"\w* \w como despojo|strong="H0961"\w* \w numa terra|strong="H0776"\w* \w de cativeiro|strong="H7633"\w*.\x - \xo 4:4 \xt 2CH 28:14; JER 30:17; PSA 79:12; ZEC 4:10; PSA 123:3; PRO 3:34\x*
\v 5 \w E não|strong="H0408"\w* \w cubra|strong="H3680"\w* \w a iniquidade deles|strong="H5921,H5771"\w*, \w e o pecado deles|strong="H2403"\w* \w diante de você|strong="H6440"\w* \w não|strong="H0408"\w* \w seja apagado|strong="H4229"\w*; \w porque|strong="H3588"\w* \w provocaram|strong="H3707"\w* \w diante|strong="H5048"\w* \w dos construtores|strong="H1129"\w*.\x - \xo 4:5 \xt PSA 109:14; JER 18:23; PSA 69:27; ISA 43:25; ISA 44:22; 2TI 4:14\x*
\v 6 \w E construímos|strong="H1129"\w* \w o muro|strong="H2346"\w*, \w e foi unido|strong="H7194"\w* \w todo|strong="H3605"\w* \w o muro|strong="H2346"\w* \w até|strong="H5704"\w* \w a metade dele|strong="H2677"\w*; \w porque|strong="H1961"\w* \w o povo|strong="H5971"\w* \w tinha vontade|strong="H3820"\w* \w de trabalhar|strong="H6213"\w*.\x - \xo 4:6 \xt PHP 2:13; 1CH 29:3; ECC 9:10; HEB 13:21; NEH 6:15; 1CH 29:14\x*
\p
\v 7 \w E aconteceu|strong="H1961"\w* \w que, quando|strong="H0834"\w* \w ouviram|strong="H8085"\w* \w Sambalate|strong="H5571"\w*, \w e Tobias|strong="H2900"\w*, \w e os árabes|strong="H6163"\w*, \w e os amonitas|strong="H5984"\w* \w e os asdoditas|strong="H0796"\w* \w que|strong="H3588"\w* \w o reparo|strong="H0724"\w* \w dos muros|strong="H2346"\w* \w de Jerusalém|strong="H3389"\w* \w avançava|strong="H5927"\w*, \w que|strong="H3588"\w* \w as brechas|strong="H6555"\w* \w tinham começado|strong="H2490"\w* \w a ser fechadas|strong="H5640"\w*, \w eles se indignaram|strong="H2734,H9038"\w* \w muito|strong="H3966"\w*.\x - \xo 4:7 \xt NEH 2:10; NEH 6:1; NEH 6:16; NEH 4:1; EZR 4:4; 2SA 10:2\x*
\v 8 \w E se uniram|strong="H7194"\w* \w todos eles|strong="H3605,H3162"\w* \w para vir|strong="H0935"\w* \w lutar|strong="H3898"\w* \w contra Jerusalém|strong="H3389"\w* \w e causar|strong="H6213"\w* \w confusão|strong="H8442"\w* \w nela|strong="H9033"\w*.\x - \xo 4:8 \xt DAN 9:25; EZR 4:4; 1CO 9:12; PSA 83:3-11\x*
\v 9 \w E oramos|strong="H6419"\w* \w ao|strong="H0413"\w* \w nosso Deus|strong="H0430"\w*, \w e colocamos|strong="H5975"\w* \w uma guarda|strong="H4929"\w* \w contra eles|strong="H5921"\w*, \w de dia|strong="H3119"\w* \w e de noite|strong="H3915"\w*, \w por causa deles|strong="H6440"\w*.\x - \xo 4:9 \xt 2CH 6:20; 1PE 5:8; ECC 9:10; ACT 4:24-30; PSA 50:15; LUK 21:36\x*
\v 10 \w E disse|strong="H0559"\w* \w Judá|strong="H3063"\w*: "\w A força|strong="H3581"\w* \w dos carregadores|strong="H5449"\w* \w falhou|strong="H3782"\w*, \w e o entulho|strong="H6083"\w* \w é muito|strong="H7235"\w*; \w e nós|strong="H0587"\w* \w não|strong="H3808"\w* \w conseguiremos|strong="H3201"\w* \w reconstruir|strong="H1129"\w* \w o muro|strong="H2346"\w*."\x - \xo 4:10 \xt ECC 9:10; HAG 1:2; NEH 6:9; 2CH 34:13; NEH 4:2\x*
\v 11 \w E disseram|strong="H0559"\w* \w os nossos adversários|strong="H6862"\w*: "\w Não|strong="H3808"\w* \w saberão|strong="H3045"\w* \w nem|strong="H3808"\w* \w verão|strong="H7200"\w*, \w até|strong="H5704"\w* \w que|strong="H0834"\w* \w cheguemos|strong="H0935"\w* \w no|strong="H0413"\w* \w meio deles|strong="H8432"\w*, \w e os matemos|strong="H2026"\w*, \w e façamos cessar|strong="H7673"\w* \w a obra|strong="H4399"\w*."\x - \xo 4:11 \xt ECC 9:10; EZR 4:4; NEH 6:9; NEH 4:9\x*
\v 12 \w E aconteceu|strong="H1961"\w* \w que, quando|strong="H0834"\w* \w vieram|strong="H0935"\w* \w os judeus|strong="H3064"\w* \w que moravam|strong="H3427"\w* \w perto deles|strong="H0681"\w*, \w e nos disseram|strong="H0559,H9035"\w* \w dez|strong="H6235"\w* \w vezes|strong="H6471"\w*: "\w De todos|strong="H3605"\w* \w os lugares|strong="H4725"\w* \w que|strong="H0834"\w*, \add vocês devem\add* \w voltar|strong="H7725"\w* \add para\add* \w nós|strong="H5921"\w*."\f + \fr 4.12: \ft Lit.: hebraico "מִכָּל־הַמְּקֹמוֹת אֲשֶׁר־תָּשׁוּבוּ עָלֵינוּ", de sentido obscuro; traduzido aqui como aviso de que, de todas as direções, seria preciso recuar para junto deles\f*\x - \xo 4:12 \xt JOB 19:3; ECC 9:10; NEH 6:9; GEN 31:7; DAN 1:20\x*
\p
\v 13 \w E coloquei|strong="H5975"\w* \w nos lugares baixos|strong="H8482,H4725"\w* \w detrás|strong="H0310"\w* \w do muro|strong="H2346"\w*, \w nos lugares abertos|strong="H6706"\w*\f + \fr 4.13: \ft Variante: a Qere e a Ketiv diferem só na forma gramatical de "lugares abertos" (צְחִיחִים/צְחִחִיִּים); sem efeito perceptível no sentido\f*, \w e coloquei|strong="H5975"\w* \w o povo|strong="H5971"\w* \w por famílias|strong="H4940"\w*, \w com|strong="H5973"\w* \w as suas espadas|strong="H2719"\w*, \w as suas lanças|strong="H7420"\w* \w e os seus arcos|strong="H7198"\w*.\x - \xo 4:13 \xt ECC 9:10; NEH 6:9; EPH 6:11-20; NEH 4:17-18\x*
\v 14 \w E eu olhei|strong="H7200"\w*, \w e me levantei|strong="H6965"\w*, \w e disse|strong="H0559"\w* \w aos nobres|strong="H0413,H2715"\w*, \w e aos oficiais|strong="H0413,H5461"\w* \w e ao resto|strong="H0413,H3499"\w* \w do povo|strong="H5971"\w*: "\w Não|strong="H0408"\w* \add tenham\add* \w medo|strong="H3372"\w* \w deles|strong="H6440"\w*; \w lembrem-se|strong="H2142"\w* \w do Senhor|strong="H0136"\w*, \w grande|strong="H1419"\w* \w e temível|strong="H3372"\w*, \w e lutem|strong="H3898"\w* \w pelos seus irmãos|strong="H5921,H0251"\w*, \w seus filhos|strong="H1121"\w* \w e suas filhas|strong="H1323"\w*, \w suas mulheres|strong="H0802"\w* \w e suas casas|strong="H1004"\w*."\x - \xo 4:14 \xt 2SA 10:12; NUM 14:9; 2CH 20:15; ISA 41:10-14; HEB 13:6; PSA 66:3\x*
\v 15 \w E aconteceu|strong="H1961"\w* \w que, quando|strong="H0834"\w* \w ouviram|strong="H8085"\w* \w os nossos inimigos|strong="H0341"\w* \w que|strong="H3588"\w* \w tínhamos sido avisados|strong="H3045,H9035"\w* \w e tinha frustrado|strong="H6565"\w* \w Deus|strong="H0430"\w* \w o plano deles|strong="H6098"\w*, \w todos nós|strong="H3605"\w* \w voltamos|strong="H7725"\w* \w ao|strong="H0413"\w* \w muro|strong="H2346"\w*, \w cada um|strong="H0376"\w* \w ao|strong="H0413"\w* \w seu trabalho|strong="H4399"\w*.\x - \xo 4:15 \xt ISA 8:10; JOB 5:12; 2SA 17:14; ROM 12:11; ISA 44:25; PSA 33:10-11\x*
