\h João (suplemento)
\mt1 João (versículos ausentes do SBLGNT)
\c 5
\v 4 \w Pois|strong="G1063"\w* \w um anjo|strong="G32"\w* \w descia|strong="G2597"\w* \w de tempos em tempos|strong="G2596,G2540"\w* \w no tanque|strong="G1722,G3588,G2861"\w* \w e|strong="G2532"\w* \w agitava|strong="G5015"\w* \w a água|strong="G3588,G5204"\w*; \w o primeiro|strong="G3588,G4413"\w*, \w então|strong="G3767"\w*, \w que entrava|strong="G1684"\w* \w depois|strong="G3326"\w* \w da agitação|strong="G3588,G5016"\w* \w da água|strong="G3588,G5204"\w*, \w ficava curado|strong="G5199,G1096"\w* \w de qualquer|strong="G3739,G1221"\w* \w doença|strong="G3553"\w* \w que o dominasse|strong="G2722"\w*.\f + \fr 5.4: \ft Lit.: ταραχή, “perturbação, agitação”; κατείχετο, “era mantido preso, dominado”.\f*\f + \fr 5.4: \ft Variante: versículo ausente do SBLGNT; o TAGNT o traz nas edições TR e Byz.\f*
