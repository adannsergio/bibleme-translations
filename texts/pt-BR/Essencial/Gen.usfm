\v 2 \w E Sarai disse|strong="H0559,H8297"\w* \w a Abrão|strong="H0413,H0087"\w*: \add "Eis\add* \w que|strong="H2009,H4994"\w* \w o SENHOR|strong="H3068"\w* \w me impediu|strong="H6113"\w* \w de ter filhos|strong="H3205"\w*; \w entre|strong="H0935,H4994"\w*, \w por favor|strong="H4994"\w*, \w na minha serva|strong="H0413,H8198"\w*, \w talvez|strong="H0194"\w* \w eu tenha filhos|strong="H1129"\w* \add por meio\add* \w dela|strong="H4480"\w*."\w E Abrão|strong="H0087"\w* \w ouviu|strong="H8085"\w* \w a voz|strong="H6963"\w* \w de Sarai|strong="H8297"\w*.\x - \xo 16:2 \xt GEN 16:6; GEN 25:21; GEN 30:2; EXO 21:4; GEN 18:10; GEN 19:31\x*
