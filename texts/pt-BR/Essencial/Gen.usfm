\v 8 \w e disse|strong="H0559"\w*: "\w Agar|strong="H1904"\w*, \w serva|strong="H8198"\w* \w de Sarai|strong="H8297"\w*, \add de\add* \w onde|strong="H0335,H2088"\w* \add você\add* \w vem|strong="H0935"\w*, \w e para onde|strong="H0575"\w* \w vai|strong="H1980"\w*?"\w E ela disse|strong="H0559"\w*: "\w Estou|strong="H0595"\w* \w fugindo|strong="H1272"\w* \w da presença|strong="H6440"\w* \w de Sarai|strong="H8297"\w*, \w minha senhora|strong="H1404"\w*."\x - \xo 16:8 \xt EXO 3:2; GEN 3:9; ACT 9:4; GEN 4:10; PRO 27:8; 1KI 19:9\x*
\v 9 \w E o anjo|strong="H0559,H9034,H4397"\w* \w do SENHOR|strong="H3068"\w* \add lhe\add* \w disse|strong="H0559"\w*: "\w Volte|strong="H7725"\w* \w para a sua senhora|strong="H0413,H1404"\w* \w e humilhe-se|strong="H6031"\w* \w sob as suas mãos|strong="H8478,H3027"\w*."\x - \xo 16:9 \xt HEB 13:17; EXO 3:2; GEN 16:13; JDG 13:3; 1PE 5:5-6; EPH 6:5\x*
