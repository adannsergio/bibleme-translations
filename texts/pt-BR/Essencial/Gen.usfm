\v 12 \w E disse|strong="H0559"\w*: "\w SENHOR|strong="H3068"\w*, \w Deus|strong="H0430"\w* \w do meu senhor|strong="H0113,H0085"\w* \w Abraão|strong="H0085"\w*, \add faça\add* \w acontecer|strong="H7136,H4994"\w*, \w por favor|strong="H4994"\w*, \w diante|strong="H6440"\w* \w de mim|strong="H6440"\w* \w hoje|strong="H3117"\w*, \w e faça|strong="H6213"\w* \w bondade|strong="H2617"\w*\f + \fr 24.12: \ft Lit.: hebraico "chesed"\f* \w com|strong="H5973"\w* \w o meu senhor|strong="H0113,H0085"\w* \w Abraão|strong="H0085"\w*.\x - \xo 24:12 \xt GEN 24:42; GEN 24:27; GEN 26:24; EXO 3:6; GEN 24:21; GEN 27:20\x*
