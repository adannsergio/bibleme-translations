\v 5 \w E o servo lhe disse|strong="H0559,H0413,H5650"\w*: "\w Talvez|strong="H0194"\w* \w a mulher|strong="H3808,H0802"\w* \w não|strong="H3808,H0014"\w* \w queira|strong="H0014"\w* \w vir comigo|strong="H1980,H0310"\w* \w a esta|strong="H0413,H0776,H2063"\w* \w terra|strong="H0776"\w*; \w acaso devo levar|strong="H7725"\w* \w o seu filho|strong="H1121"\w* \add de\add* \w volta|strong="H7725"\w* \w à terra|strong="H0413,H0776"\w* \add de\add* \w onde|strong="H0834,H8033"\w* \w saiu|strong="H3318"\w*?"\x - \xo 24:5 \xt GEN 24:39; GEN 24:8; GEN 24:37; JER 4:2; JOS 2:17; MAL 2:15\x*
\v 6 \w E Abraão lhe disse|strong="H0559,H0413,H0085"\w*: "\w Cuide-se|strong="H8104,H9031"\w*, \w para que não|strong="H6435,H7725"\w* \w leve|strong="H7725"\w* \w o meu filho|strong="H1121"\w* \w de volta|strong="H8033"\w* \add para\add* \w lá|strong="H8033"\w*.\x - \xo 24:6 \xt DEU 12:13; DEU 6:12; DEU 12:19; HEB 11:15; 2PE 2:20-22; GAL 5:1\x*
