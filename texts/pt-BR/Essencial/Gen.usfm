\v 11 \w E o anjo|strong="H0559,H9034,H4397"\w* \w do SENHOR|strong="H3068"\w* \add lhe\add* \w disse|strong="H0559"\w* \add ainda: "Eis\add* \w que|strong="H2009"\w* \w está|strong="H2009"\w* \w grávida|strong="H2030"\w*, \w e dará à luz|strong="H3205"\w* \w um filho|strong="H1121"\w*, \w e chamará|strong="H7121"\w* \w o seu nome|strong="H8034"\w* \w Ismael|strong="H3458"\w*\f + \fr 16.11: \ft Lit.: "Ismael" (Yishma'el) significa "Deus ouve"\f*, \w porque|strong="H3588"\w* \w o SENHOR|strong="H3068"\w* \w ouviu|strong="H8085"\w* \w a sua aflição|strong="H0413,H6040"\w*.\x - \xo 16:11 \xt ISA 7:14; GEN 29:32; EXO 2:23; EXO 2:10; EXO 3:7; GEN 21:17\x*
\v 12 \w E ele|strong="H1931"\w* \w será|strong="H1961"\w* \w como um jumento selvagem|strong="H6501,H0120"\w*: \w a sua mão|strong="H3027"\w* \w contra|strong="H3605"\w* \w todos|strong="H3605"\w*, \w e a mão|strong="H3027"\w* \w de todos|strong="H3605"\w* \add contra\add* \w ele|strong="H9033"\w*; \w e habitará|strong="H7931"\w* \w diante|strong="H5921,H6440"\w* \w de todos|strong="H3605"\w* \w os seus irmãos|strong="H0251"\w*."\x - \xo 16:12 \xt JOB 11:12; GEN 21:20; GEN 25:18; EXO 3:2; JOB 39:5; GEN 17:20\x*
\p
\v 13 \w E ela chamou|strong="H7121"\w* \w o nome|strong="H8034"\w* \w do SENHOR|strong="H3068"\w*, \w que|strong="H1696"\w* \w falava|strong="H1696"\w* \add com\add* \w ela|strong="H0413"\w*, \w de "Tu és|strong="H0859,H0410"\w* \w o Deus|strong="H0410"\w* \w que me vê|strong="H7210"\w* "\f + \fr 16.13: \ft Lit.: literalmente "Deus de visão/que vê"\f*, \w pois|strong="H3588"\w* \w disse|strong="H0559"\w*: "\w Será que|strong="H1571,H1988"\w* \w eu vi|strong="H7200"\w* \w depois daquele que me vê|strong="H0310,H7200"\w*?"\f + \fr 16.13: \ft Lit.: frase difícil; sentido provável: "teria eu continuado a ver depois de ser vista por ele?"\f*\x - \xo 16:13 \xt PSA 139:1-12; GEN 32:30; PRO 15:3; PRO 5:21; GEN 16:7; GEN 22:14\x*
