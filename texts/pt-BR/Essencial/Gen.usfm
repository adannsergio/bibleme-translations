\v 1 \w E Abraão|strong="H0085"\w* \w já era|strong="H2204,H0935,H3117"\w* \w velho|strong="H2204"\w*, \w avançado em dias|strong="H0935,H3117"\w*, \w e o SENHOR|strong="H3068,H1288"\w* \w tinha bendito|strong="H1288"\w* \w Abraão|strong="H0085"\w* \w em tudo|strong="H3605"\w*.\x - \xo 24:1 \xt ISA 51:2; GEN 24:35; GEN 26:12; PSA 112:1-3; GAL 3:9; GEN 13:2\x*
\v 2 \w E Abraão disse|strong="H0559,H0085"\w* \w ao seu servo|strong="H0413,H5650"\w*, \w o mais velho|strong="H2205"\w* \w da sua casa|strong="H1004"\w*, \w que|strong="H4910"\w* \w administrava|strong="H4910"\w* \w tudo|strong="H3605,H0834"\w* \w o que ele tinha|strong="H0834,H9033"\w*: "\w Ponha|strong="H7760,H4994"\w* \w a sua mão|strong="H3027"\w* \w debaixo|strong="H8478"\w* \w da minha coxa|strong="H3409"\w*,\x - \xo 24:2 \xt GEN 24:9; GEN 47:29; GEN 39:4; GEN 15:2; JDG 14:2; 1KI 16:9\x*
