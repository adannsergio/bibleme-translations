\v 21 \w Mas a minha aliança|strong="H0853,H1285"\w* \w estabelecerei|strong="H6965"\w* \w com|strong="H0854"\w* \w Isaque|strong="H3327"\w*, \w que|strong="H0834"\w* \w Sara|strong="H8283"\w* \add lhe dará à\add* \w luz|strong="H3205,H9031"\w* \w neste tempo|strong="H4150,H2088"\w*, \w no ano seguinte|strong="H8141,H0312"\w*."\x - \xo 17:21 \xt GEN 17:19; GEN 18:14; GEN 21:2; GEN 21:3; GEN 21:1; 2KI 4:16\x*
