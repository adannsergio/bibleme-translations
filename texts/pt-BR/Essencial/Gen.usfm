\v 14 \w E o macho|strong="H6189,H2145"\w* \w incircunciso|strong="H6189"\w*, \w que|strong="H0834"\w* \w não|strong="H3808"\w* \w circuncidar|strong="H4135"\w* \w a carne|strong="H1320"\w* \w do seu prepúcio|strong="H6190"\w*, \w essa pessoa|strong="H5315,H1931"\w* \add será\add* \w eliminada|strong="H3772"\w* \w do seu povo|strong="H5971"\w*; \w a minha aliança|strong="H1285"\w* \w quebrou|strong="H6565"\w*."\x - \xo 17:14 \xt EZK 44:7; GEN 17:11; LEV 12:3; EXO 4:24; JHN 7:22; MRK 10:14\x*
\p
\v 15 \w E Deus|strong="H0559,H0430"\w* \w disse|strong="H0559"\w* \w a Abraão|strong="H0413,H0085"\w*: "\w Sarai|strong="H8297"\w*, \w sua mulher|strong="H0802"\w*, \w não|strong="H3808"\w* \w chamará|strong="H7121"\w* \w mais|strong="H0413"\w* \w o seu nome|strong="H8034"\w* \w Sarai|strong="H8297"\w*, \w pois|strong="H3588"\w* \w Sara|strong="H8283"\w* \w será o seu nome|strong="H8034"\w*.\x - \xo 17:15 \xt GEN 21:3; GEN 24:36; GEN 11:29; GEN 18:11; ISA 62:2; GEN 32:28\x*
