\v 5 \w E Sarai disse|strong="H0559,H8297"\w* \w a Abrão|strong="H0413,H0087"\w*: "\w A injustiça|strong="H2555"\w* \w que sofro|strong="H5921"\w* \w é por sua causa|strong="H5921"\w*! \w Eu|strong="H0595"\w* \w pus|strong="H5414"\w* \w a minha serva|strong="H8198"\w* \w em seu colo|strong="H2436"\w*, \w e ela, vendo|strong="H7200,H3588,H2029"\w* \w que|strong="H3588"\w* \w concebeu|strong="H2029"\w*, \w passou a me desprezar|strong="H7043,H5869"\w*; \w que o SENHOR|strong="H3068"\w* \w julgue|strong="H8199"\w* \w entre|strong="H0996"\w* \w mim|strong="H0996"\w* \w e você|strong="H0996"\w*."\x - \xo 16:5 \xt GEN 16:3; 1KI 1:2; 1SA 24:12; JDG 11:27; GEN 31:53; EXO 5:21\x*
