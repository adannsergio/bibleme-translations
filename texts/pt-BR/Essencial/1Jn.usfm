\mt1 1 João
\c 1
\p
\v 1 \w O que|strong="G3739"\w* \w era|strong="G1510"\w* \w desde o princípio|strong="G575,G746"\w*, \w o que|strong="G3739"\w* \w ouvimos|strong="G191"\w*, \w o que|strong="G3739"\w* \w vimos|strong="G3708"\w* \w com os nossos|strong="G3588,G3165"\w* \w olhos|strong="G3788"\w*, \w o que|strong="G3739"\w* \w contemplamos|strong="G2300"\w* \w e|strong="G2532"\w* \w as nossas mãos|strong="G3588,G5495,G3165"\w* \w tocaram|strong="G5584"\w*, \w a respeito|strong="G4012"\w* \w da palavra|strong="G3588,G3056"\w* \w da vida|strong="G3588,G2222"\w*—\f + \fr 1.1: \ft Lit.: λόγος, "palavra"; aqui pode ser a mensagem sobre a vida ou a própria Palavra personificada, como em João 1:1; o texto não decide\f*\x - \xo 1:1 \xt JHN 1:1; LUK 24:39; GEN 1:1; JHN 1:14; JHN 14:6; ACT 4:20\x*
\v 2 \w e|strong="G2532"\w* \w a vida|strong="G3588,G2222"\w* \w se manifestou|strong="G5319"\w*, \w e|strong="G2532"\w* \w nós a vimos|strong="G3708"\w*, \w e|strong="G2532"\w* \w testemunhamos|strong="G3140"\w*, \w e|strong="G2532"\w* \w anunciamos a vocês|strong="G518,G4771"\w* \w a vida eterna|strong="G3588,G2222,G166"\w*, \w que|strong="G3748"\w* \w estava|strong="G1510"\w* \w junto ao Pai|strong="G4314,G3588,G3962"\w* \w e|strong="G2532"\w* \w se manifestou|strong="G5319"\w* \w a nós|strong="G3165"\w*—\x - \xo 1:2 \xt JHN 1:1; 1JN 5:11; JHN 3:11; 1JN 5:13; COL 3:4; 1JN 2:25\x*
\v 3 \w o que|strong="G3739"\w* \w vimos|strong="G3708"\w* \w e|strong="G2532"\w* \w ouvimos|strong="G191"\w*, \w também|strong="G2532"\w* \w anunciamos|strong="G518"\w* \w a vocês|strong="G4771"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w tenham|strong="G2192"\w* \w comunhão|strong="G2842"\w*\f + \fr 1.3: \ft Lit.: κοινωνία, "participação em comum, comunhão"\f* \w conosco|strong="G3326,G3165"\w*; \w e|strong="G2532"\w* \w de fato|strong="G1161"\w* \w a nossa comunhão|strong="G3588,G2842,G1473"\w* \w é com o Pai|strong="G3326,G3588,G3962"\w* \w e|strong="G2532"\w* \w com o seu Filho|strong="G3326,G3588,G5207,G846"\w* \w Jesus Cristo|strong="G2424,G5547"\w*.\f + \fr 1.3: \ft Acréscimo: verbo ser/estar suprido em “é com o Pai”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:3 \xt ACT 2:42; 1CO 1:9; PSA 34:8; JHN 17:3; 1JN 1:1; 1JN 1:7\x*
\v 4 \w E|strong="G2532"\w* \w nós|strong="G3165"\w* \w escrevemos|strong="G1125"\w* \w estas coisas|strong="G3778"\w* \w para que|strong="G2443"\w* \w a nossa alegria|strong="G3588,G5479,G3165"\w* \w seja|strong="G1510"\w* \w completa|strong="G4137"\w*.\f + \fr 1.4: \ft Variante: RP traz "a vocês" (ὑμῖν) em lugar de "nós" (ἡμεῖς): "escrevemos estas coisas a vocês"\f*\x - \xo 1:4 \xt JHN 15:11; JHN 17:13; 2JN 1:12; PHP 2:2; JHN 16:24; ACT 13:52\x*
\p
\v 5 \w E|strong="G2532"\w* \w esta é|strong="G1510,G3778"\w* \w a mensagem|strong="G3588,G31"\w* \w que|strong="G3739"\w* \w ouvimos|strong="G191"\w* \w dele|strong="G575,G846"\w* \w e|strong="G2532"\w* \w anunciamos|strong="G312"\w* \w a vocês|strong="G4771"\w*: \w que|strong="G3754"\w* \w Deus|strong="G3588,G2316"\w* \w é luz|strong="G5457,G1510"\w*, \w e|strong="G2532"\w* \w nele|strong="G1722,G846"\w* \w não há|strong="G3756,G1510"\w* \w nenhuma|strong="G3762"\w* \w escuridão|strong="G4653"\w*.\x - \xo 1:5 \xt JHN 8:12; MAT 5:16; JHN 12:35; JAS 1:17; JHN 1:4; ISA 60:19\x*
\v 6 \w Se dissermos|strong="G1437,G2036"\w* \w que|strong="G3754"\w* \w temos|strong="G2192"\w* \w comunhão|strong="G2842"\w* \w com ele|strong="G3326,G846"\w* \w e|strong="G2532"\w* \w vivermos|strong="G4043"\w*\f + \fr 1.6: \ft Lit.: περιπατέω, literalmente "andar"; designa a maneira de viver\f* \w na escuridão|strong="G1722,G3588,G4655"\w*, \w mentimos|strong="G5574"\w* \w e|strong="G2532"\w* \w não praticamos|strong="G3756,G4160"\w* \w a verdade|strong="G3588,G225"\w*;\x - \xo 1:6 \xt MAT 5:16; 2CO 6:14; JHN 1:4; 1JN 2:4; ISA 9:2; 1JN 4:20\x*
\v 7 \w mas|strong="G1161"\w*, \w se vivermos|strong="G1437,G4043"\w* \w na luz|strong="G1722,G3588,G5457"\w*, \w como|strong="G5613"\w* \w ele|strong="G846"\w* \w está|strong="G1510"\w* \w na luz|strong="G1722,G3588,G5457"\w*, \w temos|strong="G2192"\w* \w comunhão|strong="G2842"\w* \w uns com os outros|strong="G3326,G240"\w*, \w e|strong="G2532"\w* \w o sangue|strong="G3588,G129"\w* \w de Jesus|strong="G2424"\w*, \w o seu Filho|strong="G3588,G5207,G846"\w*, \w nos purifica|strong="G2511,G3165"\w* \w de todo pecado|strong="G575,G3956,G266"\w*.\f + \fr 1.7: \ft Variante: TR e Byz (e RP) acrescentam "Cristo" (Χριστοῦ) depois de "Jesus"; NA28 omite "mas" (δέ)\f*\x - \xo 1:7 \xt EPH 5:8; MAT 5:16; 2CO 6:14; 1JN 1:9; REV 7:14; ROM 13:12\x*
\v 8 \w Se dissermos|strong="G1437,G2036"\w* \w que|strong="G3754"\w* \w não temos|strong="G3756,G2192"\w* \w pecado|strong="G266"\w*, \w enganamos|strong="G4105"\w* \w a nós mesmos|strong="G1438"\w*, \w e|strong="G2532"\w* \w a verdade|strong="G3588,G225"\w* \w não está|strong="G3756,G1510"\w* \w em nós|strong="G1722,G3165"\w*.\x - \xo 1:8 \xt ROM 3:23; JAS 5:19; PRO 28:13; EPH 1:7; JHN 14:6; ECC 7:20\x*
\v 9 \w Se confessarmos|strong="G1437,G3670"\w* \w os nossos pecados|strong="G3588,G266,G3165"\w*, \w ele é|strong="G1510"\w* \w fiel|strong="G4103"\w* \w e|strong="G2532"\w* \w justo|strong="G1342"\w* \w para que|strong="G2443"\w* \w nos perdoe|strong="G863,G3165"\w* \w os pecados|strong="G3588,G266"\w* \w e|strong="G2532"\w* \w nos purifique|strong="G2511,G3165"\w* \w de toda|strong="G575,G3956"\w* \w injustiça|strong="G93"\w*.\x - \xo 1:9 \xt JER 33:8; PRO 28:13; PSA 32:5; ROM 3:23; PSA 51:2; 1JN 1:7\x*
\v 10 \w Se dissermos|strong="G1437,G2036"\w* \w que|strong="G3754"\w* \w não pecamos|strong="G3756,G264"\w*, \w fazemos dele|strong="G4160,G846"\w* \w um mentiroso|strong="G5583"\w*, \w e|strong="G2532"\w* \w a palavra|strong="G3588,G3056"\w* \w dele|strong="G846"\w* \w não está|strong="G3756,G1510"\w* \w em nós|strong="G1722,G3165"\w*.\x - \xo 1:10 \xt ROM 3:23; PRO 28:13; ROM 3:10; 1JN 2:1; 1JN 1:8; ECC 7:20\x*
\c 2
\p
\v 1 \w Meus filhinhos|strong="G5040,G3165"\w*, \w escrevo|strong="G1125"\w* \w estas coisas|strong="G3778"\w* \w a vocês|strong="G4771"\w* \w para que não|strong="G2443,G3361"\w* \w pequem|strong="G264"\w*. \w E|strong="G2532"\w*, \w se alguém|strong="G1437,G5100"\w* \w pecar|strong="G264"\w*, \w temos|strong="G2192"\w* \w junto ao Pai|strong="G4314,G3588,G3962"\w* \w um defensor|strong="G3875"\w*\f + \fr 2.1: \ft Lit.: παράκλητος, literalmente "chamado para junto"; "defensor, advogado, intercessor"; o mesmo termo designa o Espírito em João 14–16\f*, \w Jesus Cristo|strong="G2424,G5547"\w*, \w o justo|strong="G1342"\w*,\x - \xo 2:1 \xt 1JN 3:7; 1JN 2:12; 1TI 2:5; ROM 8:34; HEB 7:25; JHN 14:6\x*
\v 2 \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w é|strong="G1510"\w* \w a propiciação|strong="G2434"\w*\f + \fr 2.2: \ft Lit.: ἱλασμός, "meio de tornar propício"; "propiciação" ou "expiação"\f* \w pelos nossos pecados|strong="G4012,G3588,G266,G3165"\w*, \w e não somente|strong="G3756,G1161,G3441"\w* \w pelos nossos|strong="G4012,G3588,G1473"\w*, \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w pelos de todo|strong="G4012,G3650"\w* \w o mundo|strong="G3588,G2889"\w*.\x - \xo 2:2 \xt 1JN 4:10; 1JN 5:19; JHN 1:29; ISA 53:4; HEB 7:25; 1JN 4:14\x*
\v 3 \w E|strong="G2532"\w* \w nisto|strong="G1722,G3778"\w* \w sabemos|strong="G1097"\w* \w que|strong="G3754"\w* \w o conhecemos|strong="G1097,G846"\w*: \w se guardamos|strong="G1437,G5083"\w* \w os mandamentos|strong="G3588,G1785"\w* \w dele|strong="G846"\w*.\x - \xo 2:3 \xt JHN 14:15; JHN 15:10; 1JN 5:3; 1JN 3:24; 1JN 3:22; JHN 14:21\x*
\v 4 \w Quem diz|strong="G3588,G3004"\w*: “\w Eu o conheço|strong="G1097,G846"\w*” \w e|strong="G2532"\w* \w não guarda|strong="G3361,G5083"\w* \w os mandamentos|strong="G3588,G1785"\w* \w dele|strong="G846"\w* \w é|strong="G1510"\w* \w mentiroso|strong="G5583"\w*, \w e|strong="G2532"\w* \w nele|strong="G1722,G3778"\w* \w a verdade|strong="G3588,G225"\w* \w não está|strong="G3756,G1510"\w*;\x - \xo 2:4 \xt JHN 14:15; JHN 8:55; JHN 8:44; 1JN 3:24; TIT 1:16; 1JN 1:6\x*
\v 5 \w mas|strong="G1161"\w* \w quem|strong="G3739,G302"\w* \w guarda|strong="G5083"\w* \w a palavra|strong="G3588,G3056"\w* \w dele|strong="G846"\w*, \w nesse|strong="G1722,G3778"\w* \w realmente|strong="G230"\w* \w o amor|strong="G3588,G26"\w* \w de Deus|strong="G3588,G2316"\w* \w foi aperfeiçoado|strong="G5048"\w*.\f + \fr 2.5: \ft Lit.: ἡ ἀγάπη τοῦ θεοῦ, "o amor de Deus"; pode ser o amor que Deus tem ou o amor por Deus\f* \w Nisto|strong="G1722,G3778"\w* \w sabemos|strong="G1097"\w* \w que|strong="G3754"\w* \w estamos|strong="G1510"\w* \w nele|strong="G1722,G846"\w*:\x - \xo 2:5 \xt JHN 14:15; JHN 15:10; JHN 13:35; JHN 14:21; 1JN 4:17; 1JN 2:3\x*
\v 6 \w quem diz|strong="G3588,G3004"\w* \w que permanece|strong="G3306"\w* \w nele|strong="G1722,G846"\w* \w deve|strong="G3784"\w* \w também ele mesmo|strong="G2532,G846"\w* \w viver|strong="G4043"\w* \w como|strong="G2531"\w* \w aquele|strong="G1565"\w* \w viveu|strong="G4043"\w*.\f + \fr 2.6: \ft Variante: NA28 e RP acrescentam "assim" (οὕτως) antes de "viver"\f*\x - \xo 2:6 \xt JHN 15:4; PHP 2:5; 1PE 2:21; COL 2:6; JHN 13:15; 1CO 11:1\x*
\p
\v 7 \w Amados|strong="G27"\w*, \w não escrevo|strong="G3756,G1125"\w* \w a vocês|strong="G4771"\w* \w um mandamento|strong="G1785"\w* \w novo|strong="G2537"\w*, \w mas|strong="G235"\w* \w um mandamento|strong="G1785"\w* \w antigo|strong="G3820"\w* \w que vocês tinham|strong="G3739,G2192"\w* \w desde o princípio|strong="G575,G746"\w*; \w o mandamento|strong="G3588,G1785"\w* \w antigo|strong="G3588,G3820"\w* \w é|strong="G1510"\w* \w a palavra|strong="G3588,G3056"\w* \w que vocês ouviram|strong="G3739,G191"\w*.\f + \fr 2.7: \ft Variante: RP traz "Irmãos" (Ἀδελφοί) em lugar de "Amados" (Ἀγαπητοί); TR e Byz (e RP) acrescentam "desde o princípio" (ἀπʼ ἀρχῆς) no fim\f*\x - \xo 2:7 \xt JHN 13:34; 2JN 1:5; MAT 13:52; 1JN 3:11; LEV 19:18; MRK 12:29-34\x*
\v 8 \w De novo|strong="G3825"\w* \w escrevo|strong="G1125"\w* \w a vocês|strong="G4771"\w* \w um mandamento|strong="G1785"\w* \w novo|strong="G2537"\w*, \w o que|strong="G3739"\w* \w é verdadeiro|strong="G1510,G227"\w* \w nele|strong="G1722,G846"\w* \w e|strong="G2532"\w* \w em vocês|strong="G1722,G4771"\w*, \w porque|strong="G3754"\w* \w a escuridão|strong="G3588,G4653"\w* \w está passando|strong="G3855"\w* \w e|strong="G2532"\w* \w a luz|strong="G3588,G5457"\w* \w verdadeira|strong="G3588,G228"\w* \w já brilha|strong="G2235,G5316"\w*.\x - \xo 2:8 \xt JHN 8:12; JHN 12:46; LUK 4:18; JHN 13:34; GAL 6:2; GEN 1:3\x*
\v 9 \w Quem diz|strong="G3588,G3004"\w* \w estar|strong="G1511"\w* \w na luz|strong="G1722,G3588,G5457"\w* \w e|strong="G2532"\w* \w odeia|strong="G3404"\w* \w o seu irmão|strong="G3588,G80,G846"\w*\f + \fr 2.9: \ft Lit.: ἀδελφός, "irmão"; aqui, o outro membro da comunidade, homem ou mulher\f* \w está|strong="G1510"\w* \w na escuridão|strong="G1722,G3588,G4653"\w* \w até agora|strong="G2193,G737"\w*.\x - \xo 2:9 \xt JHN 12:46; 1JN 2:11; JHN 12:35; 1JN 1:7; LUK 4:18; JHN 13:34\x*
\v 10 \w Quem ama|strong="G3588,G25"\w* \w o seu irmão|strong="G3588,G80,G846"\w* \w permanece|strong="G3306"\w* \w na luz|strong="G1722,G3588,G5457"\w*, \w e|strong="G2532"\w* \w nele|strong="G1722,G846"\w* \w não há|strong="G3756,G1510"\w* \w causa de tropeço|strong="G4625"\w*;\x - \xo 2:10 \xt 1JN 3:14; 1JN 4:7; 1JN 1:7; 1CO 13:13; JHN 13:35; LUK 4:18\x*
\v 11 \w mas|strong="G1161"\w* \w quem odeia|strong="G3588,G3404"\w* \w o seu irmão|strong="G3588,G80,G846"\w* \w está|strong="G1510"\w* \w na escuridão|strong="G1722,G3588,G4653"\w* \w e|strong="G2532"\w* \w vive|strong="G4043"\w* \w na escuridão|strong="G1722,G3588,G4653"\w*, \w e|strong="G2532"\w* \w não sabe|strong="G3756,G6063"\w* \w para onde|strong="G4226"\w* \w vai|strong="G5217"\w*, \w porque|strong="G3754"\w* \w a escuridão|strong="G3588,G4653"\w* \w cegou|strong="G5186"\w* \w os olhos|strong="G3588,G3788"\w* \w dele|strong="G846"\w*.\x - \xo 2:11 \xt JHN 12:35; 1JN 2:9; JHN 12:40; GAL 6:2; MAT 6:23; 1JN 4:20\x*
\p
\v 12 \w Escrevo|strong="G1125"\w* \w a vocês|strong="G4771"\w*, \w filhinhos|strong="G5040"\w*, \w porque|strong="G3754"\w* \w os pecados|strong="G3588,G266"\w* \w de vocês|strong="G4771"\w* \w foram perdoados|strong="G863"\w* \w por causa|strong="G1223"\w* \w do nome|strong="G3588,G3686"\w* \w dele|strong="G846"\w*;\x - \xo 2:12 \xt 1JN 2:1; LUK 5:20; LUK 7:48; EPH 4:32; ACT 10:43; EPH 1:7\x*
\v 13 \w escrevo|strong="G1125"\w* \w a vocês|strong="G4771"\w*, \w pais|strong="G3962"\w*, \w porque|strong="G3754"\w* \w conhecem|strong="G1097"\w* \w aquele que existe|strong="G3588"\w* \w desde o princípio|strong="G575,G746"\w*; \w escrevo|strong="G1125"\w* \w a vocês|strong="G4771"\w*, \w jovens|strong="G3495"\w*, \w porque|strong="G3754"\w* \w venceram|strong="G3528"\w* \w o Maligno|strong="G3588,G4190"\w*.\f + \fr 2.13: \ft Lit.: ὁ πονηρός, "o mau"; pode ser lido como "o Maligno", o adversário\f*\f + \fr 2.13: \ft Acréscimo: verbo ser/estar suprido em “aquele que existe”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:13 \xt 1JN 4:4; 1JN 2:14; REV 12:11; 1JN 2:1; 1JN 5:4; JHN 14:7\x*
\v 14 \w Escrevi|strong="G1125"\w*\f + \fr 2.14: \ft Lit.: ἔγραψα, aoristo: "escrevi"; pode ser aoristo epistolar ("escrevo") ou referir-se ao que já foi escrito\f* \w a vocês|strong="G4771"\w*, \w criancinhas|strong="G3813"\w*, \w porque|strong="G3754"\w* \w conhecem|strong="G1097"\w* \w o Pai|strong="G3588,G3962"\w*; \w escrevi|strong="G1125"\w* \w a vocês|strong="G4771"\w*, \w pais|strong="G3962"\w*, \w porque|strong="G3754"\w* \w conhecem|strong="G1097"\w* \w aquele que existe|strong="G3588"\w* \w desde o princípio|strong="G575,G746"\w*; \w escrevi|strong="G1125"\w* \w a vocês|strong="G4771"\w*, \w jovens|strong="G3495"\w*, \w porque|strong="G3754"\w* \w são fortes|strong="G2478,G1510"\w*, \w e|strong="G2532"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w* \w permanece|strong="G3306"\w* \w em vocês|strong="G1722,G4771"\w*, \w e|strong="G2532"\w* \w venceram|strong="G3528"\w* \w o Maligno|strong="G3588,G4190"\w*.\f + \fr 2.14: \ft Variante: RP traz "escrevo" (γράφω), no presente, em lugar de "escrevi" (ἔγραψα) na primeira ocorrência\f*\f + \fr 2.14: \ft Acréscimo: verbo ser/estar suprido em “aquele que existe”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:14 \xt JHN 15:7; PSA 119:11; 1CO 13:13; 1JN 2:13; PRO 20:29; COL 3:16\x*
\p
\v 15 \w Não amem|strong="G3361,G25"\w* \w o mundo|strong="G3588,G2889"\w* \w nem as coisas|strong="G3366,G3588"\w* \w que estão no mundo|strong="G1722,G3588,G2889"\w*. \w Se alguém|strong="G1437,G5100"\w* \w ama|strong="G25"\w* \w o mundo|strong="G3588,G2889"\w*, \w o amor|strong="G3588,G26"\w* \w do Pai|strong="G3588,G3962"\w* \w não está|strong="G3756,G1510"\w* \w nele|strong="G1722,G846"\w*;\f + \fr 2.15: \ft Acréscimo: “que estão no mundo”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 2:15 \xt COL 3:2; JAS 4:4; MAT 6:24; ROM 12:2; COL 3:1-2; 1JN 4:8\x*
\v 16 \w porque|strong="G3754"\w* \w tudo o que|strong="G3956,G3588"\w* \w há no mundo|strong="G1722,G3588,G2889"\w* — \w o desejo|strong="G3588,G1939"\w* \w da carne|strong="G3588,G4561"\w*, \w e|strong="G2532"\w* \w o desejo|strong="G3588,G1939"\w* \w dos olhos|strong="G3588,G3788"\w*, \w e|strong="G2532"\w* \w a arrogância|strong="G3588,G212"\w* \w da vida|strong="G3588,G979"\w*\f + \fr 2.16: \ft Lit.: βίος, "vida, modo de viver, bens necessários à vida"; é diferente de ζωή, "vida"\f* — \w não vem|strong="G3756,G1510"\w* \w do Pai|strong="G1537,G3588,G3962"\w*, \w mas|strong="G235"\w* \w vem|strong="G1510"\w* \w do mundo|strong="G1537,G3588,G2889"\w*;\f + \fr 2.16: \ft Acréscimo: verbo ser/estar suprido em “há no mundo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:16 \xt GAL 5:16; COL 3:2; ROM 12:2; JAS 4:4; MAT 6:24; MAT 6:19\x*
\v 17 \w e|strong="G2532"\w* \w o mundo|strong="G3588,G2889"\w* \w está passando|strong="G3855"\w*, \w e|strong="G2532"\w* \w o desejo|strong="G3588,G1939"\w* \w dele|strong="G846"\w*; \w mas|strong="G1161"\w* \w quem faz|strong="G3588,G4160"\w* \w a vontade|strong="G3588,G2307"\w* \w de Deus|strong="G3588,G2316"\w* \w permanece|strong="G3306"\w* \w para sempre|strong="G1519,G3588,G165"\w*.\x - \xo 2:17 \xt COL 3:2; ROM 12:2; 1PE 4:2; 1CO 7:31; 2JN 1:2; 2CO 4:18\x*
\p
\v 18 \w Criancinhas|strong="G3813"\w*, \w é a última hora|strong="G2078,G5610,G1510"\w*; \w e|strong="G2532"\w*, \w como|strong="G2531"\w* \w vocês ouviram|strong="G191"\w* \w que|strong="G3754"\w* \w um anticristo|strong="G500"\w* \w vem|strong="G2064"\w*, \w agora também|strong="G2532,G3568"\w* \w muitos anticristos|strong="G500,G4183"\w* \w surgiram|strong="G1096"\w*; \w por isso|strong="G3606"\w* \w sabemos|strong="G1097"\w* \w que|strong="G3754"\w* \w é a última hora|strong="G2078,G5610,G1510"\w*.\f + \fr 2.18: \ft Variante: RP acrescenta o artigo (ὁ) antes de "anticristo": "o anticristo vem"\f*\x - \xo 2:18 \xt 1JN 4:3; 2TH 2:3; 2TI 3:1; 1JN 4:1; 2JN 1:7; 1JN 2:22\x*
\v 19 \w De entre nós|strong="G1537,G3165"\w* \w saíram|strong="G1831"\w*\f + \fr 2.19: \ft Lit.: ἐξ ἡμῶν, literalmente "de nós"; ora indica origem ("saíram de entre nós"), ora pertencimento ("não eram dos nossos")\f*, \w mas|strong="G235"\w* \w não eram|strong="G3756,G1510"\w* \w dos nossos|strong="G1537,G3165"\w*; \w pois|strong="G1063"\w*, \w se fossem|strong="G1487,G1510"\w* \w dos nossos|strong="G1537,G3165"\w*, \w teriam permanecido|strong="G3306,G302"\w* \w conosco|strong="G3326,G3165"\w*; \w mas|strong="G235"\w* \w isso foi para que|strong="G2443"\w* \w se manifestasse|strong="G5319"\w* \w que|strong="G3754"\w* \w nenhum deles|strong="G3756,G3956"\w* \w é|strong="G1510"\w* \w dos nossos|strong="G1537,G3165"\w*.\f + \fr 2.19: \ft Acréscimo: verbo ser/estar suprido em “isso foi para que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:19 \xt ACT 20:30; 1CO 11:19; JHN 10:28; JHN 6:66; MAT 12:30; JUD 1:19\x*
\v 20 \w E|strong="G2532"\w* \w vocês|strong="G4771"\w* \w têm|strong="G2192"\w* \w uma unção|strong="G5545"\w*\f + \fr 2.20: \ft Lit.: χρῖσμα, "unção", aquilo com que se unge; aqui é uma imagem, e o texto não a identifica\f* \w que vem do|strong="G575,G3588"\w* \w Santo|strong="G40"\w*, \w e|strong="G2532"\w* \w todos vocês|strong="G3956"\w* \w sabem|strong="G6063"\w*.\f + \fr 2.20: \ft Variante: Tregelles e RP trazem "todas as coisas" (πάντα) em lugar de "todos" (πάντες): "e vocês sabem todas as coisas"; WH omite o primeiro "E" (καί)\f*\x - \xo 2:20 \xt ISA 30:21; PSA 23:5; JHN 14:26; 1JN 2:27; JHN 16:13; 1CO 2:12\x*
\v 21 \w Não escrevi|strong="G3756,G1125"\w* \w a vocês|strong="G4771"\w* \w porque|strong="G3754"\w* \w não conhecem|strong="G3756,G6063"\w* \w a verdade|strong="G3588,G225"\w*, \w mas|strong="G235"\w* \w porque|strong="G3754"\w* \w a conhecem|strong="G6063,G846"\w*, \w e|strong="G2532"\w* \w porque|strong="G3754"\w* \w nenhuma mentira|strong="G3956,G5579,G3756"\w* \w vem|strong="G1510"\w* \w da verdade|strong="G1537,G3588,G225"\w*.\x - \xo 2:21 \xt 1JN 2:27; 1JN 5:13; 2PE 1:12; 2JN 1:7; REV 2:2; JUD 1:5\x*
\v 22 \w Quem|strong="G5101"\w* \w é|strong="G1510"\w* \w o mentiroso|strong="G3588,G5583"\w*, \w senão|strong="G1487,G3361"\w* \w o que nega|strong="G3588,G720"\w* \w que|strong="G3754"\w* \w Jesus|strong="G2424"\w* \w é|strong="G3756,G1510"\w* \w o Cristo|strong="G3588,G5547"\w*? \w Este é|strong="G3778,G1510"\w* \w o anticristo|strong="G3588,G500"\w*, \w o que nega|strong="G3588,G720"\w* \w o Pai|strong="G3588,G3962"\w* \w e|strong="G2532"\w* \w o Filho|strong="G3588,G5207"\w*.\f + \fr 2.22: \ft Lit.: ἀρνούμενος ὅτι… οὐκ ἔστιν: depois de verbo de negar, o grego admite uma negação redundante (οὐκ); o sentido é “nega que Jesus é o Cristo”.\f*\x - \xo 2:22 \xt 2JN 1:7; 1JN 4:3; 1JN 2:18; REV 3:8; 2JN 1:9; JUD 1:4\x*
\v 23 \w Todo aquele que|strong="G3956,G3588"\w* \w nega|strong="G720"\w* \w o Filho|strong="G3588,G5207"\w* \w tampouco|strong="G3761"\w* \w tem|strong="G2192"\w* \w o Pai|strong="G3588,G3962"\w*; \w quem confessa|strong="G3588,G3670"\w* \w o Filho|strong="G3588,G5207"\w* \w tem|strong="G2192"\w* \w também|strong="G2532"\w* \w o Pai|strong="G3588,G3962"\w*.\f + \fr 2.23: \ft Variante: RP omite a segunda metade do verso, "quem confessa o Filho tem também o Pai"\f*\x - \xo 2:23 \xt JHN 1:20; JHN 14:6; MAT 11:27; TIT 1:16; JHN 5:23; LUK 12:8\x*
\v 24 \add Quanto\add* \w a vocês|strong="G4771"\w*, \w o que|strong="G3739"\w* \w ouviram|strong="G191"\w* \w desde o princípio|strong="G575,G746"\w*, \w permaneça|strong="G3306"\w* \w em vocês|strong="G1722,G4771"\w*; \w se|strong="G1437"\w* \w permanecer|strong="G3306"\w* \w em vocês|strong="G1722,G4771"\w* \w o que|strong="G3739"\w* \w ouviram|strong="G191"\w* \w desde o princípio|strong="G575,G746"\w*, \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w permanecerão|strong="G3306"\w* \w no Filho|strong="G1722,G3588,G5207"\w* \w e|strong="G2532"\w* \w no Pai|strong="G1722,G3588,G3962"\w*.\f + \fr 2.24: \ft Variante: TR e Byz (e RP) acrescentam "portanto" (οὖν) depois de "vocês"\f*\f + \fr 2.24: \ft Acréscimo: “Quanto” (em “Quanto a vocês”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 2:24 \xt COL 3:16; JHN 15:4; JHN 14:23; 2CO 1:20; 2JN 1:6; JHN 8:31\x*
\v 25 \w E|strong="G2532"\w* \w esta é|strong="G3778,G1510"\w* \w a promessa|strong="G3588,G1860"\w* \w que|strong="G3739"\w* \w ele mesmo|strong="G846"\w* \w nos fez|strong="G1861,G3165"\w*: \w a vida eterna|strong="G3588,G2222,G166"\w*.\x - \xo 2:25 \xt TIT 1:2; 1JN 5:11; JHN 3:15; JHN 17:2; JHN 6:47; TIT 3:7\x*
\p
\v 26 \w Estas coisas|strong="G3778"\w* \w escrevi|strong="G1125"\w* \w a vocês|strong="G4771"\w* \w a respeito|strong="G4012"\w* \w dos que enganam|strong="G3588,G4105"\w* \w vocês|strong="G4771"\w*.\x - \xo 2:26 \xt JHN 15:4; 2JN 1:7; 2PE 2:1; 1JN 3:7; ACT 20:29-30; MRK 13:22\x*
\v 27 \w E|strong="G2532"\w* \w quanto a vocês|strong="G4771"\w*, \w a unção|strong="G3588,G5545"\w* \w que receberam|strong="G3739,G2983"\w* \w dele|strong="G575,G846"\w* \w permanece|strong="G3306"\w* \w em vocês|strong="G1722,G4771"\w*, \w e|strong="G2532"\w* \w não precisam|strong="G3756,G5532,G2192"\w* \w de que alguém|strong="G2443,G5100"\w* \w ensine|strong="G1321"\w* \w vocês|strong="G4771"\w*; \w mas|strong="G235"\w*, \w como|strong="G5613"\w* \w a unção dele|strong="G3588,G846,G5545"\w* \w ensina vocês|strong="G1321,G4771"\w* \w a respeito de todas as coisas|strong="G4012,G3956"\w*, \w e|strong="G2532"\w* \w é verdadeira|strong="G227,G1510"\w* \w e|strong="G2532"\w* \w não é|strong="G3756,G1510"\w* \w mentira|strong="G5579"\w*, \w e|strong="G2532"\w* \w conforme|strong="G2531"\w* \w ela os ensinou|strong="G1321,G4771"\w*, \w permaneçam|strong="G3306"\w* \w nele|strong="G1722,G846"\w*.\f + \fr 2.27: \ft Lit.: μένετε pode ser imperativo ("permaneçam") ou indicativo ("vocês permanecem")\f*\f + \fr 2.27: \ft Variante: RP traz αὐτό ("a mesma unção") em lugar de αὐτοῦ ("dele") e μενεῖτε ("permanecerão") em lugar de μένετε\f*\x - \xo 2:27 \xt JHN 14:26; JHN 15:7; ISA 30:21; JHN 16:13; 1JN 2:20; 1CO 2:13\x*
\p
\v 28 \w E|strong="G2532"\w* \w agora|strong="G3568"\w*, \w filhinhos|strong="G5040"\w*, \w permaneçam|strong="G3306"\w* \w nele|strong="G1722,G846"\w*, \w para que|strong="G2443"\w*, \w se ele se manifestar|strong="G1437,G5319"\w*, \w tenhamos|strong="G2192"\w* \w confiança|strong="G3954"\w*\f + \fr 2.28: \ft Lit.: παρρησία, "franqueza, ousadia, confiança"\f* \w e|strong="G2532"\w* \w não nos envergonhemos|strong="G3361,G153"\w* \w diante dele|strong="G575,G846"\w* \w na sua vinda|strong="G1722,G3588,G3952,G846"\w*.\f + \fr 2.28: \ft Variante: RP traz "quando" (ὅταν) em lugar de "se" (ἐάν) e ἔχωμεν ("tenhamos", presente) em lugar de σχῶμεν ("venhamos a ter", aoristo)\f*\x - \xo 2:28 \xt PHP 1:20; LUK 21:36; JHN 15:4; 1JN 5:14; 1JN 4:17; MRK 8:38\x*
\v 29 \w Se sabem|strong="G1437,G6063"\w* \w que|strong="G3754"\w* \w ele é|strong="G1510"\w* \w justo|strong="G1342"\w*, \w vocês reconhecem|strong="G1097"\w* \w que|strong="G3754"\w* \w todo aquele que|strong="G3956,G3588"\w* \w pratica|strong="G4160"\w* \w a justiça|strong="G3588,G1343"\w* \w nasceu|strong="G1080"\w* \w dele|strong="G1537,G846"\w*.\f + \fr 2.29: \ft Lit.: γεννάω, "gerar" ou "dar à luz"; no passivo, "ser gerado, nascer"; "dele" pode referir-se a Deus ou a Cristo\f*\f + \fr 2.29: \ft Variante: NA28 e Tregelles acrescentam "também" (καί) depois do segundo "que"\f*\x - \xo 2:29 \xt 1JN 4:7; 1JN 3:7; 2CO 5:21; ACT 22:14; JHN 3:3; 1PE 2:24\x*
\c 3
\p
\v 1 \w Vejam|strong="G1492"\w* \w que amor|strong="G4217,G26"\w* \w nos deu|strong="G1325,G3165"\w* \w o Pai|strong="G3588,G3962"\w*, \w para que|strong="G2443"\w* \w sejamos chamados|strong="G2564"\w* \w filhos|strong="G5043"\w* \w de Deus|strong="G2316"\w* — \w e|strong="G2532"\w* \w somos|strong="G1510"\w*! \w Por isso|strong="G1223,G3778"\w* \w o mundo|strong="G3588,G2889"\w* \w não nos conhece|strong="G3756,G1097,G3165"\w*, \w porque|strong="G3754"\w* \w não o conheceu|strong="G3756,G1097,G846"\w*.\f + \fr 3.1: \ft Variante: RP omite "e somos" (καὶ ἐσμέν) e traz "vocês" (ὑμᾶς) em lugar de "nos" (ἡμᾶς)\f*\x - \xo 3:1 \xt JHN 1:12; JHN 1:10; JHN 17:25; 1JN 4:16; PSA 31:19; GAL 3:26\x*
\v 2 \w Amados|strong="G27"\w*, \w agora|strong="G3568"\w* \w somos|strong="G1510"\w* \w filhos|strong="G5043"\w* \w de Deus|strong="G2316"\w*, \w e|strong="G2532"\w* \w ainda não|strong="G3768"\w* \w se manifestou|strong="G5319"\w* \w o que|strong="G5101"\w* \w seremos|strong="G1510"\w*. \w Sabemos|strong="G6063"\w* \w que|strong="G3754"\w*, \w se for manifestado|strong="G1437,G5319"\w*\f + \fr 3.2: \ft Lit.: o sujeito de φανερωθῇ não está expresso no grego; pode ser Cristo ou aquilo que seremos\f*, \w seremos|strong="G1510"\w* \w semelhantes|strong="G3664"\w* \w a ele|strong="G846"\w*, \w porque|strong="G3754"\w* \w o veremos|strong="G3700,G846"\w* \w como ele|strong="G2531"\w* \w é|strong="G1510"\w*.\x - \xo 3:2 \xt ROM 8:29; EPH 5:1; PSA 31:19; PHP 3:21; COL 3:4; 1CO 13:12\x*
\v 3 \w E|strong="G2532"\w* \w todo aquele que|strong="G3956,G3588"\w* \w tem|strong="G2192"\w* \w esta esperança|strong="G3588,G1680,G3778"\w* \w nele|strong="G1909,G846"\w* \w se purifica|strong="G48,G1438"\w*, \add assim\add* \w como|strong="G2531"\w* \w aquele|strong="G1565"\w* \w é|strong="G1510"\w* \w puro|strong="G53"\w*.\f + \fr 3.3: \ft Acréscimo: “assim” (em “se purifica assim como aquele”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 3:3 \xt EPH 4:4; PHP 4:8; 2CO 7:1; MAT 5:8; JAS 4:8; 1PE 1:13\x*
\v 4 \w Todo aquele que|strong="G3956,G3588"\w* \w pratica|strong="G4160"\w* \w o pecado|strong="G3588,G266"\w* \w pratica|strong="G4160"\w* \w também|strong="G2532"\w* \w a violação da lei|strong="G3588,G458"\w*\f + \fr 3.4: \ft Lit.: ἀνομία, "falta de lei, violação da lei"; ver 2 Tessalonicenses 2:3\f*, \w e|strong="G2532"\w* \w o pecado|strong="G3588,G266"\w* \w é|strong="G1510"\w* \w a violação da lei|strong="G3588,G458"\w*.\x - \xo 3:4 \xt 2TH 2:3; ROM 4:7; HEB 10:17; 1JN 5:17; ROM 3:20; ROM 4:15\x*
\v 5 \w E|strong="G2532"\w* \w vocês sabem|strong="G6063"\w* \w que|strong="G3754"\w* \w aquele|strong="G1565"\w* \w se manifestou|strong="G5319"\w* \w para que|strong="G2443"\w* \w tire|strong="G142"\w* \w os pecados|strong="G3588,G266"\w*, \w e|strong="G2532"\w* \w nele|strong="G1722,G846"\w* \w não há|strong="G3756,G1510"\w* \w pecado|strong="G266"\w*.\f + \fr 3.5: \ft Variante: TR e Byz (e RP) acrescentam "nossos" (ἡμῶν) depois de "pecados"\f*\x - \xo 3:5 \xt JHN 1:29; 1JN 3:8; 2CO 5:21; MAT 1:21; HEB 4:15; HEB 9:28\x*
\v 6 \w Todo aquele que|strong="G3956,G3588"\w* \w permanece|strong="G3306"\w* \w nele|strong="G1722,G846"\w* \w não peca|strong="G3756,G264"\w*\f + \fr 3.6: \ft Lit.: ἁμαρτάνει e ἁμαρτάνων estão no presente, que pode indicar ação contínua ou habitual; o texto não acrescenta "continuamente"\f*; \w todo aquele que|strong="G3956,G3588"\w* \w peca|strong="G264"\w* \w não o viu|strong="G3756,G3708,G846"\w* \w nem o conheceu|strong="G3761,G1097,G846"\w*.\x - \xo 3:6 \xt 1JN 3:9; 1JN 4:13; JHN 16:3; 1JN 2:6; 3JN 1:11; 1JN 2:4\x*
\v 7 \w Filhinhos|strong="G5040"\w*, \w que ninguém|strong="G3367"\w* \w engane|strong="G4105"\w* \w vocês|strong="G4771"\w*; \w quem pratica|strong="G3588,G4160"\w* \w a justiça|strong="G3588,G1343"\w* \w é|strong="G1510"\w* \w justo|strong="G1342"\w*, \w assim como|strong="G2531"\w* \w aquele|strong="G1565"\w* \w é|strong="G1510"\w* \w justo|strong="G1342"\w*;\f + \fr 3.7: \ft Variante: NA28 e WH (na margem) trazem "criancinhas" (παιδία) em lugar de "filhinhos" (τεκνία)\f*\x - \xo 3:7 \xt 2TI 2:19; 1JN 2:1; 1JN 2:29; JAS 1:22; GAL 6:7; 1PE 1:15-16\x*
\v 8 \w Quem pratica|strong="G3588,G4160"\w* \w o pecado|strong="G3588,G266"\w* \w é|strong="G1510"\w* \w do diabo|strong="G1537,G3588,G1228"\w*, \w porque|strong="G3754"\w* \w o diabo|strong="G3588,G1228"\w* \w peca|strong="G264"\w* \w desde o princípio|strong="G575,G746"\w*. \w Para isto|strong="G1519,G3778"\w* \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w* \w se manifestou|strong="G5319"\w*: \w para desfazer|strong="G2443,G3089"\w*\f + \fr 3.8: \ft Lit.: λύω, "soltar, desatar"; aqui, desfazer, destruir\f* \w as obras|strong="G3588,G2041"\w* \w do diabo|strong="G3588,G1228"\w*.\x - \xo 3:8 \xt GEN 3:15; 2TI 2:19; 1JN 3:5; 1PE 5:8; HEB 2:14; JHN 8:44\x*
\v 9 \w Todo aquele que|strong="G3956,G3588"\w* \w nasceu|strong="G1080"\w* \w de Deus|strong="G1537,G3588,G2316"\w* \w não pratica|strong="G3756,G4160"\w* \w pecado|strong="G266"\w*, \w porque|strong="G3754"\w* \w a semente|strong="G4690"\w* \w dele|strong="G846"\w* \w permanece|strong="G3306"\w* \w nele|strong="G1722,G846"\w*\f + \fr 3.9: \ft Lit.: σπέρμα, "semente" ou "descendência"; pode ser a semente divina ou a descendência de Deus\f*, \w e|strong="G2532"\w* \w não pode|strong="G3756,G1410"\w* \w pecar|strong="G264"\w*, \w porque|strong="G3754"\w* \w nasceu|strong="G1080"\w* \w de Deus|strong="G1537,G3588,G2316"\w*.\x - \xo 3:9 \xt 1JN 5:18; 1JN 3:6; 2TI 2:19; 1PE 5:8; JHN 3:3; JHN 8:44\x*
\v 10 \w Nisto|strong="G1722,G3778"\w* \w são manifestos|strong="G5318,G1510"\w* \w os filhos|strong="G3588,G5043"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w os filhos|strong="G3588,G5043"\w* \w do diabo|strong="G3588,G1228"\w*: \w todo aquele que|strong="G3956,G3588"\w* \w não pratica|strong="G3361,G4160"\w* \w a justiça|strong="G1343"\w* \w não é|strong="G3756,G1510"\w* \w de Deus|strong="G1537,G3588,G2316"\w*, \w e|strong="G2532"\w* \w também quem|strong="G3588"\w* \w não ama|strong="G3361,G25"\w* \w o seu irmão|strong="G3588,G80,G846"\w*.\x - \xo 3:10 \xt 2TI 2:19; 1PE 5:8; 1JN 5:2; JHN 8:44; JHN 13:35; 1JN 4:4\x*
\p
\v 11 \w Pois|strong="G3754"\w* \w esta é|strong="G3778,G1510"\w* \w a mensagem|strong="G3588,G31"\w* \w que|strong="G3739"\w* \w vocês ouviram|strong="G191"\w* \w desde o princípio|strong="G575,G746"\w*: \w que nos amemos|strong="G2443,G25"\w* \w uns aos outros|strong="G240"\w*;\x - \xo 3:11 \xt JHN 15:12; 1JN 4:7; JHN 13:34; 2JN 1:5; 1JN 3:23; JHN 13:35\x*
\v 12 \w não como|strong="G3756,G2531"\w* \w Caim|strong="G2535"\w*, \add que\add* \w era|strong="G1510"\w* \w do Maligno|strong="G1537,G3588,G4190"\w* \w e|strong="G2532"\w* \w matou|strong="G4969"\w*\f + \fr 3.12: \ft Lit.: σφάζω, "abater, degolar"\f* \w o seu irmão|strong="G3588,G80,G846"\w*. \w E|strong="G2532"\w* \w por que motivo|strong="G5484,G5101"\w* \w o matou|strong="G4969,G846"\w*? \w Porque|strong="G3754"\w* \w as obras|strong="G3588,G2041"\w* \w dele|strong="G846"\w* \w eram|strong="G1510"\w* \w más|strong="G4190"\w*, \w e as do seu irmão|strong="G3588,G1161,G80,G846"\w* \w justas|strong="G1342"\w*.\f + \fr 3.12: \ft Acréscimo: “que” (em “como Caim que era do”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 3:12 \xt JHN 8:44; JHN 13:35; 1JN 4:7; HEB 11:4; GEN 4:4-15; JUD 1:11\x*
\v 13 \w Não se admirem|strong="G3361,G2296"\w*, \w irmãos e irmãs|strong="G80"\w*\f + \fr 3.13: \ft Lit.: ἀδελφοί, "irmãos"; vocativo plural que inclui homens e mulheres da comunidade\f*, \w se|strong="G1487"\w* \w o mundo|strong="G3588,G2889"\w* \w odeia|strong="G3404"\w* \w vocês|strong="G4771"\w*.\f + \fr 3.13: \ft Variante: TR e Byz (e RP) acrescentam "meus" (μου) depois de "irmãos"; NA28 traz "E não se admirem" (καὶ μή)\f*\x - \xo 3:13 \xt JHN 15:18; JHN 17:14; ROM 12:2; JHN 7:7; MAT 10:22; JHN 13:35\x*
\v 14 \w Nós|strong="G3165"\w* \w sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w passamos|strong="G3327"\w* \w da morte|strong="G1537,G3588,G2288"\w* \w para a vida|strong="G1519,G3588,G2222"\w*, \w porque|strong="G3754"\w* \w amamos|strong="G25"\w* \w os irmãos e irmãs|strong="G3588,G80"\w*; \w quem não ama|strong="G3588,G3361,G25"\w* \w permanece|strong="G3306"\w* \w na morte|strong="G1722,G3588,G2288"\w*\f + \fr 3.14: \ft Variante: TR e Byz (e RP) acrescentam "o irmão" (τὸν ἀδελφόν) depois de "quem não ama"\f*.\x - \xo 3:14 \xt JHN 5:24; 1JN 2:10; PSA 133:1; MAT 5:22; COL 1:13; JHN 13:35\x*
\v 15 \w Todo aquele que|strong="G3956,G3588"\w* \w odeia|strong="G3404"\w* \w o seu irmão|strong="G3588,G80,G846"\w* \w é|strong="G1510"\w* \w assassino|strong="G443"\w*\f + \fr 3.15: \ft Lit.: ἀνθρωποκτόνος, literalmente "matador de gente"\f*, \w e|strong="G2532"\w* \w vocês sabem|strong="G6063"\w* \w que|strong="G3754"\w* \w nenhum assassino|strong="G3956,G443,G3756"\w* \w tem|strong="G2192"\w* \w a vida eterna|strong="G2222,G166"\w* \w permanecendo|strong="G3306"\w* \w nele|strong="G1722,G846"\w*.\x - \xo 3:15 \xt JHN 3:36; PSA 133:1; MAT 5:22; MAT 5:21-22; JHN 13:34; REV 21:8\x*
\v 16 \w Nisto|strong="G1722,G3778"\w* \w conhecemos|strong="G1097"\w* \w o amor|strong="G3588,G26"\w*: \w que|strong="G3754"\w* \w aquele|strong="G1565"\w* \w deu|strong="G5087"\w*\f + \fr 3.16: \ft Lit.: τίθημι τὴν ψυχήν, literalmente "pôr a vida"; "dar a vida"\f* \w a sua vida|strong="G3588,G5590,G846"\w* \w por nós|strong="G5228,G3165"\w*; \w e|strong="G2532"\w* \w nós|strong="G3165"\w* \w devemos|strong="G3784"\w* \w dar a vida|strong="G3588,G5590,G5087"\w* \w pelos irmãos e irmãs|strong="G5228,G3588,G80"\w*.\x - \xo 3:16 \xt JHN 10:11; ROM 5:8; JHN 10:15; 1JN 4:16; JHN 15:13; JHN 5:42\x*
\v 17 \w Mas|strong="G1161"\w* \w quem|strong="G3739,G302"\w* \w tiver|strong="G2192"\w* \w os bens|strong="G3588,G979"\w*\f + \fr 3.17: \ft Lit.: βίος, "vida; meios de vida, bens"; ver 2:16\f* \w do mundo|strong="G3588,G2889"\w* \w e|strong="G2532"\w* \w vir|strong="G2334"\w* \w o seu irmão|strong="G3588,G80,G846"\w* \w em necessidade|strong="G5532,G2192"\w* \w e|strong="G2532"\w* \w fechar|strong="G2808"\w* \w o seu íntimo|strong="G3588,G4698,G846"\w* \w a ele|strong="G575,G846"\w*, \w como|strong="G4459"\w* \w permanece|strong="G3306"\w* \w nele|strong="G1722,G846"\w* \w o amor|strong="G3588,G26"\w* \w de Deus|strong="G3588,G2316"\w*?\x - \xo 3:17 \xt JAS 1:27; 1JN 2:15; HEB 13:16; PSA 133:1; 1JN 4:20; ISA 58:7\x*
\v 18 \w Filhinhos|strong="G5040"\w*, \w não amemos|strong="G3361,G25"\w* \w com palavra|strong="G3056"\w* \w nem com a língua|strong="G3366,G3588,G1100"\w*, \w mas|strong="G235"\w* \w em ação|strong="G1722,G2041"\w* \w e|strong="G2532"\w* \w verdade|strong="G225"\w*.\f + \fr 3.18: \ft Variante: TR e Byz (e RP) acrescentam "meus" (μου) depois de "filhinhos"\f*\f + \fr 3.18: \ft Tradução: ἔργῳ (ἔργον, G2041) está aqui como “em ação”; o termo pode ser “obra”, “trabalho”, “ação”, “feito” ou “ocupação”, e o contexto decide.\f*\x - \xo 3:18 \xt JAS 2:15-16; JAS 1:27; HEB 10:24; ROM 12:9; PSA 133:1; EPH 4:15\x*
\v 19 \w Nisto|strong="G1722,G3778"\w* \w saberemos|strong="G1097"\w* \w que|strong="G3754"\w* \w somos|strong="G1510"\w* \w da verdade|strong="G1537,G3588,G225"\w*, \w e|strong="G2532"\w* \w diante dele|strong="G1715,G846"\w* \w persuadiremos|strong="G3982"\w*\f + \fr 3.19: \ft Lit.: πείθω, "persuadir, convencer"; aqui, acalmar o coração\f* \w o nosso coração|strong="G3588,G2588,G3165"\w*,\f + \fr 3.19: \ft Variante: Tregelles, NA28 e RP trazem "E nisto" (καὶ ἐν); RP traz "conhecemos" (γινώσκομεν), no presente, em lugar de "saberemos" (γνωσόμεθα); Tregelles e RP trazem "corações" no plural (τὰς καρδίας)\f*\x - \xo 3:19 \xt JAS 1:27; PSA 133:1; MAT 25:35; ROM 12:9; JHN 14:21; 1JN 4:7\x*
\v 20 \w porque|strong="G3754"\w*, \w se|strong="G1437"\w* \w o nosso coração|strong="G3588,G2588"\w* \w nos condena|strong="G2607,G3165"\w*, \w Deus|strong="G3588,G2316"\w* \w é maior|strong="G3173,G1510"\w* \add que\add* \w o nosso coração|strong="G3588,G2588,G3165"\w* \w e|strong="G2532"\w* \w conhece|strong="G1097"\w* \w tudo|strong="G3956"\w*\f + \fr 3.20: \ft Lit.: o grego traz dois "ὅτι" seguidos ("que… que"); o segundo foi omitido em português\f*.\f + \fr 3.20: \ft Acréscimo: “que” (em “é maior que o nosso”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 3:20 \xt PSA 145:18; PSA 139:1-4; ROM 12:9; JER 17:10; JHN 14:21; 1JN 4:7\x*
\v 21 \w Amados|strong="G27"\w*, \w se|strong="G1437"\w* \w o coração|strong="G3588,G2588"\w* \w não nos condena|strong="G3361,G2607,G1473"\w*, \w temos|strong="G2192"\w* \w confiança|strong="G3954"\w* \w diante de Deus|strong="G4314,G3588,G2316"\w*,\x - \xo 3:21 \xt 1JN 5:14; PSA 145:18; LUK 11:28; JHN 15:10; JHN 14:21; 1JN 4:7\x*
\v 22 \w e|strong="G2532"\w* \w recebemos|strong="G2983"\w* \w dele|strong="G575,G846"\w* \w tudo o que|strong="G3739,G1437"\w* \w pedirmos|strong="G154"\w*, \w porque|strong="G3754"\w* \w guardamos|strong="G5083"\w* \w os mandamentos|strong="G3588,G1785"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w fazemos|strong="G4160"\w* \w o que agrada|strong="G3588,G701"\w* \w diante dele|strong="G1799,G846"\w*.\x - \xo 3:22 \xt JHN 15:7; LUK 11:9; MRK 11:24; MAT 7:7; JHN 15:10; 1JN 2:3\x*
\v 23 \w E|strong="G2532"\w* \w este é|strong="G3778,G1510"\w* \w o mandamento|strong="G3588,G1785"\w* \w dele|strong="G846"\w*: \w que creiamos|strong="G2443,G4100"\w* \w no nome|strong="G3588,G3686"\w* \w do seu Filho|strong="G3588,G5207,G846"\w* \w Jesus Cristo|strong="G2424,G5547"\w* \w e|strong="G2532"\w* \w nos amemos|strong="G25"\w* \w uns aos outros|strong="G240"\w*, \w conforme|strong="G2531"\w* \w ele nos deu|strong="G1325,G3165"\w* \w mandamento|strong="G1785"\w*.\x - \xo 3:23 \xt JHN 13:34; JHN 15:12; 1JN 4:21; JHN 15:10; 1JN 4:7; JHN 14:21\x*
\v 24 \w E|strong="G2532"\w* \w quem guarda|strong="G3588,G5083"\w* \w os mandamentos|strong="G3588,G1785"\w* \w dele|strong="G846"\w* \w permanece|strong="G3306"\w* \w nele|strong="G1722,G846"\w*, \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w nele|strong="G1722,G846"\w*; \w e|strong="G2532"\w* \w nisto|strong="G1722,G3778"\w* \w sabemos|strong="G1097"\w* \w que|strong="G3754"\w* \w ele permanece|strong="G3306"\w* \w em nós|strong="G1722,G3165"\w*: \w pelo Espírito|strong="G1537,G3588,G4151"\w* \w que|strong="G3739"\w* \w nos deu|strong="G3165,G1325"\w*.\x - \xo 3:24 \xt JHN 15:10; 1JN 2:3; 1JN 4:13; 1JN 4:16; JHN 14:21; 1JN 5:2\x*
\c 4
\p
\v 1 \w Amados|strong="G27"\w*, \w não creiam|strong="G3361,G4100"\w* \w em todo espírito|strong="G3956,G4151"\w*, \w mas|strong="G235"\w* \w ponham à prova|strong="G1381"\w* \w os espíritos|strong="G3588,G4151"\w* \w para ver se|strong="G1487"\w* \w são|strong="G1510"\w* \w de Deus|strong="G1537,G3588,G2316"\w*, \w porque|strong="G3754"\w* \w muitos falsos profetas|strong="G4183,G5578"\w* \w saíram|strong="G1831"\w* \w pelo mundo|strong="G1519,G3588,G2889"\w*.\x - \xo 4:1 \xt 1TH 5:21; 2PE 2:1; MAT 7:15; 1TI 4:1; REV 2:2; PRO 14:15\x*
\v 2 \w Nisto|strong="G1722,G3778"\w* \w vocês reconhecem|strong="G1097"\w* \w o Espírito|strong="G3588,G4151"\w* \w de Deus|strong="G3588,G2316"\w*: \w todo espírito|strong="G3956,G4151"\w* \w que confessa|strong="G3739,G3670"\w* \w Jesus Cristo|strong="G2424,G5547"\w* \w tendo vindo|strong="G2064"\w*\f + \fr 4.2: \ft Lit.: ἐληλυθότα é particípio perfeito: "tendo vindo"; em 2 João 7 o particípio é presente ("vindo")\f* \w em carne|strong="G1722,G4561"\w* \w é|strong="G1510"\w* \w de Deus|strong="G1537,G3588,G2316"\w*,\f + \fr 4.2: \ft Variante: RP traz γινώσκεται ("é reconhecido") em lugar de γινώσκετε ("vocês reconhecem")\f*\x - \xo 4:2 \xt 2JN 1:7; ROM 10:9; JHN 1:14; 1CO 12:3; 1JN 4:15; 1TI 3:16\x*
\v 3 \w e|strong="G2532"\w* \w todo espírito|strong="G3956,G4151"\w* \w que não confessa|strong="G3739,G3361,G3670"\w* \w Jesus|strong="G3588,G2424"\w* \w não é|strong="G3756,G1510"\w* \w de Deus|strong="G1537,G3588,G2316"\w*; \w e|strong="G2532"\w* \w este é|strong="G3778,G1510"\w* \w o espírito do anticristo|strong="G3588,G500"\w*, \w do qual|strong="G3739"\w* \w vocês ouviram|strong="G191"\w* \w que|strong="G3754"\w* \w vem|strong="G2064"\w*, \w e|strong="G2532"\w* \w agora|strong="G3568"\w* \w já está|strong="G1510,G2235"\w* \w no mundo|strong="G1722,G3588,G2889"\w*.\f + \fr 4.3: \ft Variante: TR e Byz (e RP) acrescentam "Cristo vindo em carne" (Χριστὸν ἐν σαρκὶ ἐληλυθότα) depois de "Jesus" e omitem o artigo diante de "Jesus"\f*\x - \xo 4:3 \xt 2JN 1:7; 1JN 2:18; ROM 10:9; JHN 1:14; 1CO 12:3; 1JN 2:22\x*
\v 4 \w Vocês|strong="G4771"\w* \w são|strong="G1510"\w* \w de Deus|strong="G1537,G3588,G2316"\w*, \w filhinhos|strong="G5040"\w*, \w e|strong="G2532"\w* \w os venceram|strong="G3528,G846"\w*, \w porque|strong="G3754"\w* \w maior|strong="G3173"\w* \w é|strong="G1510"\w* \w aquele que|strong="G3588"\w* \w está em vocês|strong="G1722,G4771"\w* \w do que|strong="G2228"\w* \w aquele que|strong="G3588"\w* \w está no mundo|strong="G1722,G3588,G2889"\w*;\f + \fr 4.4: \ft Acréscimo: verbo ser/estar suprido em “está em vocês”, “está no mundo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:4 \xt 1JN 5:4; JHN 16:33; ROM 8:31; ROM 8:37; ROM 12:2; 1JN 4:16\x*
\v 5 \w eles|strong="G846"\w* \w são|strong="G1510"\w* \w do mundo|strong="G1537,G3588,G2889"\w*; \w por isso|strong="G1223,G3778"\w* \w falam|strong="G2980"\w* \w a partir do mundo|strong="G1537,G3588,G2889"\w*, \w e|strong="G2532"\w* \w o mundo|strong="G3588,G2889"\w* \w os ouve|strong="G846,G191"\w*.\x - \xo 4:5 \xt ROM 12:2; 1JN 2:15; 1JN 5:19; JHN 15:19; 1CO 2:12; JHN 8:23\x*
\v 6 \w Nós|strong="G3165"\w* \w somos|strong="G1510"\w* \w de Deus|strong="G1537,G3588,G2316"\w*; \w quem conhece|strong="G3588,G1097"\w* \w Deus|strong="G3588,G2316"\w* \w nos ouve|strong="G191,G3165"\w*; \w quem não é|strong="G3739,G3756,G1510"\w* \w de Deus|strong="G1537,G3588,G2316"\w* \w não nos ouve|strong="G3756,G191,G3165"\w*. \w Por isto|strong="G1537,G3778"\w* \w reconhecemos|strong="G1097"\w* \w o espírito|strong="G3588,G4151"\w* \w da verdade|strong="G3588,G225"\w* \w e|strong="G2532"\w* \w o espírito|strong="G3588,G4151"\w* \w do engano|strong="G3588,G4106"\w*.\x - \xo 4:6 \xt JHN 14:17; 1JN 4:4; JHN 17:3; JHN 18:37; 1JN 5:19; JHN 16:13\x*
\p
\v 7 \w Amados|strong="G27"\w*, \w amemo-nos|strong="G25"\w* \w uns aos outros|strong="G240"\w*, \w porque|strong="G3754"\w* \w o amor|strong="G3588,G26"\w* \w é|strong="G1510"\w* \w de Deus|strong="G1537,G3588,G2316"\w*, \w e|strong="G2532"\w* \w todo aquele que|strong="G3956,G3588"\w* \w ama|strong="G25"\w* \w nasceu|strong="G1080"\w* \w de Deus|strong="G1537,G3588,G2316"\w* \w e|strong="G2532"\w* \w conhece|strong="G1097"\w* \w Deus|strong="G3588,G2316"\w*.\x - \xo 4:7 \xt 1JN 5:1; JHN 13:34; 1JN 4:12; 1JN 2:29; 1TH 4:9; 1CO 13:13\x*
\v 8 \w Quem não ama|strong="G3588,G3361,G25"\w* \w não conheceu|strong="G3756,G1097"\w* \w Deus|strong="G3588,G2316"\w*, \w porque|strong="G3754"\w* \w Deus|strong="G3588,G2316"\w* \w é amor|strong="G26,G1510"\w*.\x - \xo 4:8 \xt 1JN 4:16; EPH 2:4; JHN 5:42; 1JN 4:10; 1CO 13:13; 1CO 8:3\x*
\v 9 \w Nisto|strong="G1722,G3778"\w* \w se manifestou|strong="G5319"\w* \w o amor|strong="G3588,G26"\w* \w de Deus|strong="G3588,G2316"\w* \w entre nós|strong="G1722,G3165"\w*\f + \fr 4.9: \ft Lit.: ἐν ἡμῖν, "em nós" ou "entre nós"\f*: \w que|strong="G3754"\w* \w Deus|strong="G3588,G2316"\w* \w enviou|strong="G649"\w* \w ao mundo|strong="G1519,G3588,G2889"\w* \w o seu Filho|strong="G3588,G5207,G846"\w* \w unigênito|strong="G3588,G3439"\w*\f + \fr 4.9: \ft Lit.: μονογενής, "único de sua espécie, filho único"; "unigênito"\f*, \w para que|strong="G2443"\w* \w vivamos|strong="G2198"\w* \w por meio dele|strong="G1223,G846"\w*.\x - \xo 4:9 \xt JHN 3:16; JHN 1:14; ROM 5:8; 1CO 13:13; 1JN 3:16; LUK 19:10\x*
\v 10 \w Nisto|strong="G1722,G3778"\w* \w está|strong="G1510"\w* \w o amor|strong="G3588,G26"\w*: \w não em que|strong="G3756,G3754"\w* \w nós|strong="G3165"\w* \w tenhamos amado|strong="G25"\w* \w Deus|strong="G3588,G2316"\w*, \w mas|strong="G235"\w* \w em que|strong="G3754"\w* \w ele|strong="G846"\w* \w nos amou|strong="G25,G3165"\w* \w e|strong="G2532"\w* \w enviou|strong="G649"\w* \w o seu Filho|strong="G3588,G5207,G846"\w* \w como propiciação|strong="G2434"\w* \w pelos nossos pecados|strong="G4012,G3588,G266,G3165"\w*.\f + \fr 4.10: \ft Variante: Tregelles e RP trazem "amamos" (ἠγαπήσαμεν), no aoristo, em lugar de "temos amado" (ἠγαπήκαμεν), no perfeito\f*\x - \xo 4:10 \xt 1JN 2:2; EPH 2:4; JHN 3:16; ROM 5:8; 1JN 4:8; 1CO 13:13\x*
\v 11 \w Amados|strong="G27"\w*, \w se|strong="G1487"\w* \w Deus|strong="G3588,G2316"\w* \w nos amou|strong="G25,G3165"\w* \w assim|strong="G3779"\w*, \w também|strong="G2532"\w* \w nós|strong="G3165"\w* \w devemos|strong="G3784"\w* \w amar|strong="G25"\w* \w uns aos outros|strong="G240"\w*.\x - \xo 4:11 \xt JHN 15:12; JHN 13:34; 1JN 3:23; 1CO 13:13; EPH 5:28; 1JN 4:7\x*
\v 12 \w A Deus|strong="G2316"\w* \w ninguém|strong="G3762"\w* \w jamais|strong="G4455"\w* \w contemplou|strong="G2300"\w*; \w se|strong="G1437"\w* \w nos amamos|strong="G25"\w* \w uns aos outros|strong="G240"\w*, \w Deus|strong="G3588,G2316"\w* \w permanece|strong="G3306"\w* \w em nós|strong="G1722,G3165"\w*, \w e|strong="G2532"\w* \w o amor|strong="G3588,G26"\w* \w dele|strong="G846"\w* \w está aperfeiçoado|strong="G5048,G1510"\w* \w em nós|strong="G1722,G3165"\w*.\x - \xo 4:12 \xt 1JN 4:7; 1CO 13:13; 1JN 4:17; 1JN 4:16; 1JN 2:5; 1JN 4:18\x*
\v 13 \w Nisto|strong="G1722,G3778"\w* \w sabemos|strong="G1097"\w* \w que|strong="G3754"\w* \w permanecemos|strong="G3306"\w* \w nele|strong="G1722,G846"\w*, \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w em nós|strong="G1722,G3165"\w*: \w que|strong="G3754"\w* \w nos deu|strong="G1325,G3165"\w* \w do seu Espírito|strong="G1537,G3588,G4151,G846"\w*.\x - \xo 4:13 \xt 1JN 4:16; 1JN 3:24; JHN 14:17; 1CO 13:13; 1JN 3:6; 1JN 4:4\x*
\v 14 \w E|strong="G2532"\w* \w nós|strong="G3165"\w* \w contemplamos|strong="G2300"\w* \w e|strong="G2532"\w* \w testemunhamos|strong="G3140"\w* \w que|strong="G3754"\w* \w o Pai|strong="G3588,G3962"\w* \w enviou|strong="G649"\w* \w o Filho|strong="G3588,G5207"\w* \w como Salvador|strong="G4990"\w* \w do mundo|strong="G3588,G2889"\w*.\x - \xo 4:14 \xt JHN 3:17; 1CO 13:13; JHN 4:42; JHN 10:36; LUK 19:10; GAL 5:22\x*
\v 15 \w Quem|strong="G3739,G1437"\w* \w confessar|strong="G3670"\w* \w que|strong="G3754"\w* \w Jesus|strong="G2424"\w* \w é|strong="G1510"\w* \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w*, \w Deus|strong="G3588,G2316"\w* \w permanece|strong="G3306"\w* \w nele|strong="G1722,G846"\w*, \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w em Deus|strong="G1722,G3588,G2316"\w*.\f + \fr 4.15: \ft Variante: WH acrescenta "Cristo" (Χριστός) depois de "Jesus"\f*\x - \xo 4:15 \xt 2CO 6:16; PSA 91:1; 1CO 13:13; ISA 45:17; MAT 16:16; GAL 5:22\x*
\v 16 \w E|strong="G2532"\w* \w nós|strong="G3165"\w* \w conhecemos|strong="G1097"\w* \w e|strong="G2532"\w* \w cremos|strong="G4100"\w* \w no amor|strong="G3588,G26"\w* \w que|strong="G3739"\w* \w Deus|strong="G3588,G2316"\w* \w tem|strong="G2192"\w* \w por nós|strong="G1722,G3165"\w*\f + \fr 4.16: \ft Lit.: ἐν ἡμῖν, "em nós"; aqui, o amor de Deus dirigido a nós\f*. \w Deus|strong="G3588,G2316"\w* \w é amor|strong="G26,G1510"\w*, \w e|strong="G2532"\w* \w quem permanece|strong="G3588,G3306"\w* \w no amor|strong="G1722,G3588,G26"\w* \w permanece|strong="G3306"\w* \w em Deus|strong="G1722,G3588,G2316"\w*, \w e|strong="G2532"\w* \w Deus|strong="G3588,G2316"\w* \w permanece|strong="G3306"\w* \w nele|strong="G1722,G846"\w*.\x - \xo 4:16 \xt 1CO 13:13; 1JN 4:8; 1JN 4:13; 1JN 3:24; PSA 91:1; JHN 6:69\x*
\v 17 \w Nisto|strong="G1722,G3778"\w* \w o amor|strong="G3588,G26"\w* \w foi aperfeiçoado|strong="G5048"\w* \w entre nós|strong="G3326,G3165"\w*: \w para que|strong="G2443"\w* \w tenhamos|strong="G2192"\w* \w confiança|strong="G3954"\w* \w no dia|strong="G1722,G3588,G2250"\w* \w do juízo|strong="G3588,G2920"\w*, \w porque|strong="G3754"\w*, \w como|strong="G2531"\w* \w aquele|strong="G1565"\w* \w é|strong="G1510"\w*, \w também|strong="G2532"\w* \w nós|strong="G3165"\w* \w somos|strong="G1510"\w* \w neste mundo|strong="G1722,G3588,G2889,G3778"\w*.\x - \xo 4:17 \xt 1CO 13:13; 1JN 2:5; 1JN 4:12; JHN 17:23; 1JN 2:28; ROM 8:29\x*
\v 18 \w Medo|strong="G5401"\w* \w não há|strong="G3756,G1510"\w* \w no amor|strong="G1722,G3588,G26"\w*, \w mas|strong="G235"\w* \w o amor|strong="G3588,G26"\w* \w perfeito|strong="G5046"\w* \w lança|strong="G906"\w* \w para fora|strong="G1854"\w* \w o medo|strong="G3588,G5401"\w*, \w porque|strong="G3754"\w* \w o medo|strong="G3588,G5401"\w* \w tem|strong="G2192"\w* \w castigo|strong="G2851"\w*, \w e|strong="G1161"\w* \w quem teme|strong="G3588,G5399"\w* \w não foi aperfeiçoado|strong="G3756,G5048"\w* \w no amor|strong="G1722,G3588,G26"\w*.\x - \xo 4:18 \xt 2TI 1:7; ROM 8:15; 1CO 13:13; 1JN 4:12; LUK 1:74-75; HEB 12:28\x*
\v 19 \w Nós|strong="G3165"\w* \w amamos|strong="G25"\w* \w porque|strong="G3754"\w* \w ele|strong="G846"\w* \w primeiro|strong="G4413"\w* \w nos amou|strong="G25,G3165"\w*.\f + \fr 4.19: \ft Variante: TR e Byz (e RP) acrescentam "a ele" (αὐτόν) depois de "amamos"\f*\x - \xo 4:19 \xt JHN 14:15; JHN 3:16; 1JN 4:10; ROM 8:28; COL 3:12; 1CO 2:9\x*
\v 20 \w Se alguém|strong="G1437,G5100"\w* \w disser|strong="G2036"\w*: “\w Amo|strong="G25"\w* \w a Deus|strong="G3588,G2316"\w*” \w e|strong="G2532"\w* \w odiar|strong="G3404"\w* \w o seu irmão|strong="G3588,G80,G846"\w*, \w é|strong="G1510"\w* \w mentiroso|strong="G5583"\w*; \w pois|strong="G1063"\w* \w quem não ama|strong="G3588,G3361,G25"\w* \w o seu irmão|strong="G3588,G80,G846"\w*, \w a quem|strong="G3739"\w* \w viu|strong="G3708"\w*, \w não pode|strong="G3756,G1410"\w* \w amar|strong="G25"\w* \w a Deus|strong="G3588,G2316"\w*, \w a quem|strong="G3739"\w* \w não viu|strong="G3756,G3708"\w*.\f + \fr 4.20: \ft Variante: RP traz "como pode" (πῶς) em lugar de "não pode" (οὐ)\f*\x - \xo 4:20 \xt JHN 14:15; JHN 13:35; 1JN 4:7; 1JN 3:17; MAT 5:22; 1JN 1:6\x*
\v 21 \w E|strong="G2532"\w* \w temos|strong="G2192"\w* \w dele|strong="G575,G846"\w* \w este mandamento|strong="G3778,G3588,G1785"\w*: \w que quem|strong="G2443,G3588"\w* \w ama|strong="G25"\w* \w a Deus|strong="G3588,G2316"\w* \w ame|strong="G25"\w* \w também|strong="G2532"\w* \w o seu irmão|strong="G3588,G80,G846"\w*.\x - \xo 4:21 \xt JHN 15:12; JHN 13:34; 1JN 5:2; MRK 12:31; 1JN 3:23; JHN 14:15\x*
\c 5
\p
\v 1 \w Todo aquele que|strong="G3956,G3588"\w* \w crê|strong="G4100"\w* \w que|strong="G3754"\w* \w Jesus|strong="G2424"\w* \w é|strong="G1510"\w* \w o Cristo|strong="G3588,G5547"\w* \w nasceu|strong="G1080"\w* \w de Deus|strong="G1537,G3588,G2316"\w*, \w e|strong="G2532"\w* \w todo aquele que|strong="G3956,G3588"\w* \w ama|strong="G25"\w* \w quem gerou|strong="G3588,G1080"\w* \w ama|strong="G25"\w* \w também|strong="G2532"\w* \w quem nasceu|strong="G3588,G1080"\w* \w dele|strong="G1537,G846"\w*.\x - \xo 5:1 \xt 1JN 4:7; JHN 3:3; JHN 8:42; 1CO 13:13; 1JN 3:9; JHN 1:12-13\x*
\v 2 \w Nisto|strong="G1722,G3778"\w* \w sabemos|strong="G1097"\w* \w que|strong="G3754"\w* \w amamos|strong="G25"\w* \w os filhos|strong="G3588,G5043"\w* \w de Deus|strong="G3588,G2316"\w*: \w quando|strong="G3752"\w* \w amamos|strong="G25"\w* \w Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w praticamos|strong="G4160"\w* \w os mandamentos|strong="G3588,G1785"\w* \w dele|strong="G846"\w*;\f + \fr 5.2: \ft Variante: RP traz "guardamos" (τηρῶμεν) em lugar de "praticamos" (ποιῶμεν)\f*\x - \xo 5:2 \xt JHN 14:15; 1CO 8:3; 1JN 4:21; JHN 13:34; 1JN 3:10; 1JN 2:3\x*
\v 3 \w pois|strong="G1063"\w* \w este é|strong="G3778,G1510"\w* \w o amor|strong="G3588,G26"\w* \w de Deus|strong="G3588,G2316"\w*: \w que guardemos|strong="G2443,G5083"\w* \w os mandamentos|strong="G3588,G1785"\w* \w dele|strong="G846"\w*; \w e|strong="G2532"\w* \w os mandamentos|strong="G3588,G1785"\w* \w dele|strong="G846"\w* \w não são|strong="G3756,G1510"\w* \w pesados|strong="G926"\w*,\x - \xo 5:3 \xt JHN 14:15; JHN 14:21; JHN 15:10; 1JN 2:3; 2JN 1:6; DEU 6:5\x*
\v 4 \w porque|strong="G3754"\w* \w tudo o que|strong="G3956,G3588"\w* \w nasceu|strong="G1080"\w*\f + \fr 5.4: \ft Lit.: πᾶν τὸ γεγεννημένον está no neutro: "tudo o que nasceu"\f* \w de Deus|strong="G1537,G3588,G2316"\w* \w vence|strong="G3528"\w* \w o mundo|strong="G3588,G2889"\w*. \w E|strong="G2532"\w* \w esta é|strong="G3778,G1510"\w* \w a vitória|strong="G3588,G3529"\w* \w que venceu|strong="G3588,G3528"\w* \w o mundo|strong="G3588,G2889"\w*: \w a nossa fé|strong="G3588,G4102,G3165"\w*.\x - \xo 5:4 \xt 1JN 4:4; JHN 16:33; 1CO 15:57; 1JN 2:15; ROM 8:37; 1PE 1:3\x*
\v 5 \w Quem|strong="G5101"\w* \w é|strong="G1510"\w* \w o que vence|strong="G3588,G3528"\w* \w o mundo|strong="G3588,G2889"\w*, \w senão|strong="G1487,G3361"\w* \w o que crê|strong="G3588,G4100"\w* \w que|strong="G3754"\w* \w Jesus|strong="G2424"\w* \w é|strong="G1510"\w* \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w*?\x - \xo 5:5 \xt 1JN 4:4; 1JN 2:15; ROM 8:37; JHN 16:33; MAT 22:37; 1CO 15:57\x*
\p
\v 6 \w Este é|strong="G3778,G1510"\w* \w o que veio|strong="G3588,G2064"\w* \w por meio de|strong="G1223"\w* \w água|strong="G5204"\w* \w e|strong="G2532"\w* \w sangue|strong="G129"\w*, \w Jesus Cristo|strong="G2424,G5547"\w*; \w não somente|strong="G3756,G3441"\w* \w na água|strong="G1722,G3588,G5204"\w*, \w mas|strong="G235"\w* \w na água|strong="G1722,G3588,G5204"\w* \w e|strong="G2532"\w* \w no sangue|strong="G1722,G3588,G129"\w*; \w e|strong="G2532"\w* \w o Espírito|strong="G3588,G4151"\w* \w é|strong="G1510"\w* \w o que testemunha|strong="G3588,G3140"\w*, \w porque|strong="G3754"\w* \w o Espírito|strong="G3588,G4151"\w* \w é|strong="G1510"\w* \w a verdade|strong="G3588,G225"\w*.\f + \fr 5.6: \ft Lit.: "água" e "sangue" não são explicados no texto; várias interpretações foram propostas (batismo e morte de Jesus, nascimento natural, ritos), e a tradução não escolhe\f*\x - \xo 5:6 \xt 1JN 5:8; JHN 19:34; JHN 15:26; JHN 14:6; JHN 3:5; 1TI 3:16\x*
\v 7 \w Porque|strong="G3754"\w* \w são três|strong="G5140,G1510"\w* \w os que testemunham|strong="G3588,G3140"\w*:\f + \fr 5.7: \ft Variante: o TR acrescenta, depois de "os que testemunham", "no céu, o Pai, a Palavra e o Espírito Santo, e estes três são um; e três são os que testemunham na terra" (ἐν τῷ οὐρανῷ ὁ πατήρ, ὁ λόγος καὶ τὸ ἅγιον πνεῦμα, καὶ οὗτοι οἱ τρεῖς ἕν εἰσιν. καὶ τρεῖς εἰσιν οἱ μαρτυροῦντες ἐν τῇ γῇ); o SBLGNT, WH, Tregelles, NA28 e RP não trazem essas palavras\f*\x - \xo 5:7 \xt JHN 1:1; JHN 3:5; MAT 28:19; 2CO 13:14; 1TI 3:16; ACT 5:32\x*
\v 8 \w o Espírito|strong="G3588,G4151"\w*, \w a água|strong="G3588,G5204"\w* \w e|strong="G2532"\w* \w o sangue|strong="G3588,G129"\w*; \w e|strong="G2532"\w* \w os três|strong="G3588,G5140"\w* \w estão de acordo|strong="G1519,G3588,G1520,G1510"\w*.\f + \fr 5.8: \ft Lit.: εἰς τὸ ἕν εἰσιν, literalmente "são para o um"; "estão de acordo, convergem"\f*\x - \xo 5:8 \xt 1JN 5:6; JHN 19:34; JHN 3:5; 1TI 3:16; 1JN 1:7; JHN 15:26\x*
\v 9 \w Se|strong="G1487"\w* \w aceitamos|strong="G2983"\w* \w o testemunho|strong="G3588,G3141"\w* \w dos seres humanos|strong="G3588,G444"\w*, \w o testemunho|strong="G3588,G3141"\w* \w de Deus|strong="G3588,G2316"\w* \w é|strong="G1510"\w* \w maior|strong="G3173"\w*, \w porque|strong="G3754"\w* \w este é|strong="G3778,G1510"\w* \w o testemunho|strong="G3588,G3141"\w* \w de Deus|strong="G3588,G2316"\w*: \w que|strong="G3754"\w* \w testemunhou|strong="G3140"\w* \w a respeito|strong="G4012"\w* \w do seu Filho|strong="G3588,G5207,G846"\w*.\f + \fr 5.9: \ft Variante: RP traz o pronome relativo ἥν ("o que") em lugar de ὅτι ("que") na última parte: "o testemunho de Deus, o que ele testemunhou a respeito do seu Filho"\f*\x - \xo 5:9 \xt REV 1:2; JHN 3:11; JHN 5:31; JHN 3:32; JHN 5:36; JHN 5:32\x*
\v 10 \w Quem crê|strong="G3588,G4100"\w* \w no Filho|strong="G1519,G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w* \w tem|strong="G2192"\w* \w o testemunho|strong="G3588,G3141"\w* \w em si mesmo|strong="G1722,G1438"\w*; \w quem não crê|strong="G3588,G3361,G4100"\w* \w em Deus|strong="G3588,G2316"\w* \w fez dele|strong="G4160,G846"\w* \w um mentiroso|strong="G5583"\w*, \w porque|strong="G3754"\w* \w não creu|strong="G3756,G4100"\w* \w no testemunho|strong="G1519,G3588,G3141"\w* \w que|strong="G3739"\w* \w Deus|strong="G3588,G2316"\w* \w testemunhou|strong="G3140"\w* \w a respeito|strong="G4012"\w* \w do seu Filho|strong="G3588,G5207,G846"\w*.\x - \xo 5:10 \xt REV 1:2; JHN 3:11; MRK 16:16; JHN 1:7; JHN 5:31; JHN 3:32\x*
\v 11 \w E|strong="G2532"\w* \w este é|strong="G3778,G1510"\w* \w o testemunho|strong="G3588,G3141"\w*: \w que|strong="G3754"\w* \w Deus|strong="G3588,G2316"\w* \w nos deu|strong="G1325,G3165"\w* \w a vida eterna|strong="G2222,G166"\w*, \w e|strong="G2532"\w* \w esta vida|strong="G3778,G3588,G2222"\w* \w está|strong="G1510"\w* \w no seu Filho|strong="G1722,G3588,G5207,G846"\w*.\x - \xo 5:11 \xt JHN 17:3; JHN 3:15; JHN 5:24; 1JN 2:25; ACT 4:12; JHN 14:6\x*
\v 12 \w Quem tem|strong="G3588,G2192"\w* \w o Filho|strong="G3588,G5207"\w* \w tem|strong="G2192"\w* \w a vida|strong="G3588,G2222"\w*; \w quem não tem|strong="G3588,G3361,G2192"\w* \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w* \w não tem|strong="G3756,G2192"\w* \w a vida|strong="G3588,G2222"\w*.\x - \xo 5:12 \xt ACT 4:12; JHN 14:6; MRK 16:16; JHN 17:3; JHN 11:25; ISA 45:17\x*
\p
\v 13 \w Estas coisas|strong="G3778"\w* \w escrevi|strong="G1125"\w* \w a vocês|strong="G4771"\w*, \w para que|strong="G2443"\w* \w saibam|strong="G6063"\w* \w que|strong="G3754"\w* \w têm|strong="G2192"\w* \w a vida eterna|strong="G2222,G166"\w*, \w vocês que creem|strong="G3588,G4100"\w* \w no nome|strong="G1519,G3588,G3686"\w* \w do Filho de Deus|strong="G3588,G5207,G2316"\w*.\f + \fr 5.13: \ft Variante: TR e Byz (e RP) trazem "a vocês que creem no nome do Filho de Deus" (τοῖς πιστεύουσιν εἰς τὸ ὄνομα τοῦ υἱοῦ τοῦ θεοῦ) antes de "para que saibam" e "e para que creiam" (καὶ ἵνα πιστεύητε) no fim, em lugar de "vocês que creem" no fim\f*\x - \xo 5:13 \xt JHN 20:31; JHN 3:15; JHN 5:24; JHN 6:47; JHN 1:12; JHN 3:36\x*
\v 14 \w E|strong="G2532"\w* \w esta é|strong="G3778,G1510"\w* \w a confiança|strong="G3588,G3954"\w* \w que|strong="G3739"\w* \w temos|strong="G2192"\w* \w diante dele|strong="G4314,G846"\w*: \w que|strong="G3754"\w*, \w se pedirmos|strong="G1437,G154"\w* \w algo|strong="G5100"\w* \w segundo a vontade|strong="G2596,G3588,G2307"\w* \w dele|strong="G846"\w*, \w ele nos ouve|strong="G191,G3165"\w*.\x - \xo 5:14 \xt JHN 15:7; LUK 11:9; MRK 11:24; PSA 37:4; MAT 7:7; JHN 14:13\x*
\v 15 \w E|strong="G2532"\w*, \w se sabemos|strong="G1437,G6063"\w* \w que|strong="G3754"\w* \w ele nos ouve|strong="G191,G3165"\w* \w em tudo o que|strong="G3739,G1437"\w* \w pedirmos|strong="G154"\w*, \w sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w temos|strong="G2192"\w* \w os pedidos|strong="G3588,G155"\w* \w que|strong="G3739"\w* \w fizemos|strong="G154"\w* \w a ele|strong="G575,G846"\w*.\x - \xo 5:15 \xt LUK 11:9; MRK 11:24; PSA 37:4; MAT 7:7; ISA 65:24; MAT 21:22\x*
\p
\v 16 \w Se alguém|strong="G1437,G5100"\w* \w vir|strong="G1492"\w* \w o seu irmão|strong="G3588,G80,G846"\w* \w pecando|strong="G264"\w* \w um pecado|strong="G266"\w* \w que não é|strong="G3361"\w* \w para a morte|strong="G4314,G2288"\w*, \w pedirá|strong="G154"\w*, \w e|strong="G2532"\w* \w lhe dará|strong="G1325,G846"\w* \w vida|strong="G2222"\w*, \w aos que pecam|strong="G3588,G264"\w* \w não para a morte|strong="G3361,G4314,G2288"\w*. \w Há|strong="G1510"\w* \w pecado|strong="G266"\w* \w para a morte|strong="G4314,G2288"\w*\f + \fr 5.16: \ft Lit.: ἁμαρτία πρὸς θάνατον, literalmente "pecado para a morte"; o texto não define de que pecado se trata\f*; \w não digo|strong="G3756,G3004"\w* \w a respeito desse|strong="G4012,G1565"\w* \w que ele peça|strong="G2443,G2065"\w*.\f + \fr 5.16: \ft Acréscimo: verbo ser/estar suprido em “que não é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:16 \xt JHN 16:23; JHN 16:26; MAT 18:19; GAL 6:1; JAS 5:15; HEB 6:4\x*
\v 17 \w Toda injustiça|strong="G3956,G93"\w* \w é|strong="G1510"\w* \w pecado|strong="G266"\w*, \w e|strong="G2532"\w* \w há|strong="G1510"\w* \w pecado|strong="G266"\w* \w que não é|strong="G3756"\w* \w para a morte|strong="G4314,G2288"\w*.\f + \fr 5.17: \ft Acréscimo: verbo ser/estar suprido em “que não é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:17 \xt 1JN 3:4; JAS 1:15; 1JN 5:16; EZK 18:26-32; JHN 10:28; JAS 4:7-10\x*
\v 18 \w Sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w todo aquele que|strong="G3956,G3588"\w* \w nasceu|strong="G1080"\w* \w de Deus|strong="G1537,G3588,G2316"\w* \w não peca|strong="G3756,G264"\w*, \w mas|strong="G235"\w* \w aquele que|strong="G3588"\w* \w nasceu|strong="G1080"\w* \w de Deus|strong="G1537,G3588,G2316"\w* \w o guarda|strong="G5083,G846"\w*\f + \fr 5.18: \ft Lit.: ὁ γεννηθεὶς ἐκ τοῦ θεοῦ, "aquele que nasceu de Deus", está no aoristo (diferente do perfeito da primeira ocorrência); pode referir-se a Cristo ou ao crente\f*, \w e|strong="G2532"\w* \w o Maligno|strong="G3588,G4190"\w* \w não o toca|strong="G3756,G681,G846"\w*.\f + \fr 5.18: \ft Variante: NA28 e RP trazem ἑαυτόν ("guarda a si mesmo") em lugar de αὐτόν ("o guarda")\f*\x - \xo 5:18 \xt 1JN 3:9; JHN 17:15; JHN 3:3; 1JN 5:4; 1JN 5:1; JUD 1:21\x*
\v 19 \w Sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w somos|strong="G1510"\w* \w de Deus|strong="G1537,G3588,G2316"\w*, \w e|strong="G2532"\w* \w o mundo|strong="G3588,G2889"\w* \w inteiro|strong="G3650"\w* \w jaz|strong="G2749"\w* \w no Maligno|strong="G1722,G3588,G4190"\w*.\x - \xo 5:19 \xt ROM 12:2; 1JN 2:2; MAT 11:27; 1JN 4:4; 2CO 4:4; JHN 14:30\x*
\v 20 \w Sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w* \w veio|strong="G2240"\w*\f + \fr 5.20: \ft Lit.: ἥκω, "ter chegado, estar presente"\f* \w e|strong="G2532"\w* \w nos deu|strong="G1325,G3165"\w* \w entendimento|strong="G1271"\w* \w para que conheçamos|strong="G2443,G1097"\w* \w o Verdadeiro|strong="G3588,G228"\w*; \w e|strong="G2532"\w* \w estamos|strong="G1510"\w* \w no Verdadeiro|strong="G1722,G3588,G228"\w*, \w no seu Filho|strong="G1722,G3588,G5207,G846"\w* \w Jesus Cristo|strong="G2424,G5547"\w*. \w Este é|strong="G3778,G1510"\w* \w o Deus|strong="G3588,G2316"\w* \w verdadeiro|strong="G228"\w* \w e|strong="G2532"\w* \w vida eterna|strong="G2222,G166"\w*.\f + \fr 5.20: \ft Lit.: οὗτος, "este": pode referir-se ao Filho, Jesus Cristo, ou a Deus ("o Verdadeiro"); o texto não decide\f*\f + \fr 5.20: \ft Variante: WH e Tregelles trazem γινώσκομεν (indicativo, "conhecemos") em lugar de γινώσκωμεν (subjuntivo, "conheçamos")\f*\x - \xo 5:20 \xt JHN 17:3; JHN 14:6; 1JN 5:11; JHN 3:15; JHN 1:1; ISA 9:6\x*
\p
\v 21 \w Filhinhos|strong="G5040"\w*, \w guardem-se|strong="G5442,G1438"\w* \w dos ídolos|strong="G575,G3588,G1497"\w*.\f + \fr 5.21: \ft Variante: TR e Byz (e RP) acrescentam "Amém" (ἀμήν) no fim\f*\x - \xo 5:21 \xt 2CO 6:16; 1CO 10:14; 1CO 10:7; EXO 20:3; JOS 6:18; PSA 85:11\x*
