\v 4 \w E Jonas começou|strong="H2490,H3124"\w* \w a entrar|strong="H0935"\w* \w na cidade|strong="H5892"\w*, \w andando um dia|strong="H4109,H3117,H0259"\w*, \w e proclamava|strong="H7121,H0559"\w*, \w dizendo|strong="H0559"\w*: \add "Dentro\add* \w de|strong="H5750"\w* \w quarenta|strong="H0705"\w* \w dias|strong="H3117"\w*, \w Nínive|strong="H5210"\w* \add será\add* \w destruída|strong="H2015"\w*!"\x - \xo 3:4 \xt DEU 18:22; 2KI 20:1; JER 18:7; EST 4:16; 2KI 20:6; EXO 5:1\x*
\v 5 \w E os habitantes|strong="H0582,H5210"\w* \w de Nínive|strong="H5210"\w* \w creram|strong="H0539"\w* \w em|strong="H0430"\w* \w Deus|strong="H0430"\w*, \w e proclamaram|strong="H7121"\w* \w jejum|strong="H6685"\w*, \w e se vestiram|strong="H3847"\w* \w de pano de saco|strong="H8242"\w*, \w desde o maior|strong="H1419"\w* \w até o menor|strong="H5704,H6996"\w* \w deles|strong="H1419,H6996"\w*.\x - \xo 3:5 \xt DAN 9:3; NEH 9:1; 2CH 20:3; JOL 2:12; EZR 8:21; LUK 11:32\x*
\v 6 \w Quando a notícia|strong="H5060,H1697"\w* \w chegou|strong="H5060"\w* \w ao|strong="H0413"\w* \w rei|strong="H4428"\w* \w de Nínive|strong="H5210"\w*, \w ele se levantou|strong="H6965"\w* \w do seu trono|strong="H3678"\w*, \w tirou|strong="H5674"\w* \w o seu manto|strong="H0155,H5921"\w*, \w cobriu-se|strong="H3680"\w* \w de pano de saco|strong="H8242"\w* \w e sentou-se|strong="H3427"\w* \w sobre|strong="H5921"\w* \add as\add* \w cinzas|strong="H0665"\w*.\x - \xo 3:6 \xt DAN 9:3; JOL 2:12; ROM 10:14; 2KI 20:1; EST 4:1; JAS 4:6-10\x*
\v 7 \w E ele mandou proclamar|strong="H2199,H0559"\w* \w em Nínive|strong="H5210"\w*, \w por decreto|strong="H2940,H4428"\w* \w do rei|strong="H4428"\w* \w e dos seus nobres|strong="H1419"\w*, \w dizendo|strong="H0559"\w*: "\w Nem as pessoas|strong="H0120"\w* \w nem os animais|strong="H0929"\w*, \w nem o gado|strong="H1241"\w* \w nem as ovelhas|strong="H6629"\w*, \w provem|strong="H0408,H2938"\w* \w nada|strong="H3972"\w*, \w nem pastem|strong="H0408,H7462"\w*, \w nem bebam|strong="H4325,H0408,H8354"\w* \w água|strong="H4325"\w*.\x - \xo 3:7 \xt JOL 2:12; ROM 10:14; 2KI 20:1; 2CH 20:3; EST 4:16; JOL 1:18\x*
\v 8 \w Mas cubram-se|strong="H3680,H8242"\w* \w de pano de saco|strong="H8242"\w*, \w tanto|strong="H0120"\w* \w as pessoas|strong="H0120"\w* \w quanto os animais|strong="H0929"\w*, \w e clamem|strong="H7121"\w* \w a|strong="H0413"\w* \w Deus|strong="H0430"\w* \w com força|strong="H2394"\w*, \w e cada um|strong="H0376"\w* \add se\add* \w afaste|strong="H7725,H1870"\w* \w do seu mau|strong="H1870,H7451"\w* \w caminho|strong="H1870"\w* \w e|strong="H4480"\w* \w da violência|strong="H2555"\w* \w que|strong="H0834"\w* \w há em suas mãos|strong="H3709"\w*.\x - \xo 3:8 \xt ISA 59:6; JOL 2:12; ROM 10:14; 2KI 20:1; 2CH 20:3; EST 4:16\x*
\v 9 \w Quem|strong="H4310"\w* \w sabe|strong="H3045"\w*? \w Talvez|strong="H7725"\w* \w Deus|strong="H0430"\w* \add se\add* \w volte|strong="H7725"\w* \w e se arrependa|strong="H5162"\w*, \w e desista|strong="H7725,H2740,H0639"\w* \w da sua ira|strong="H2740,H0639"\w* \w ardente|strong="H2740"\w*, \w e não|strong="H3808"\w* \w pereçamos|strong="H0006"\w*."\x - \xo 3:9 \xt EXO 32:12; PSA 85:3; JOL 2:14; ZEP 2:3; 2SA 12:22; JON 1:6\x*
\v 10 \w E Deus|strong="H0430"\w* \w viu|strong="H7200"\w* \w as suas obras|strong="H4639"\w*, \w que|strong="H3588"\w* \w se haviam convertido|strong="H7725"\w* \w do seu mau|strong="H1870,H7451"\w* \w caminho|strong="H1870"\w*; \w e Deus|strong="H0430"\w* \add se\add* \w arrependeu|strong="H5162"\w* \w do mal|strong="H5921,H7451"\w* \w que|strong="H0834"\w* \add tinha\add* \w dito|strong="H1696"\w* \w que lhes faria|strong="H6213,H9038"\w*, \w e não|strong="H3808"\w* \add o\add* \w fez|strong="H6213"\w*.\x - \xo 3:10 \xt EXO 32:14; JER 18:8; JER 26:3; JER 42:10; JER 26:13; ISA 55:7\x*
\c 4
\p
\v 1 \w Isso desagradou|strong="H7489,H0413,H7451,H1419"\w* \w muito|strong="H1419"\w* \w a|strong="H0413"\w* \w Jonas|strong="H3124"\w*, \w e ele ficou irritado|strong="H2734,H9033"\w*.\x - \xo 4:1 \xt JON 4:9; PSA 37:8; LUK 15:28; MAT 20:15; JON 4:4; 2SA 6:8\x*
\v 2 \w Ele orou|strong="H6419"\w* \w ao|strong="H0413"\w* \w SENHOR|strong="H3068"\w* \w e disse|strong="H0559"\w*: "\w Ah|strong="H0577"\w*, \w SENHOR|strong="H3068"\w*! \w Não|strong="H3808"\w* \w era|strong="H2088"\w* \w isto|strong="H2088"\w* \w o que eu dizia|strong="H1697"\w*, \w enquanto eu|strong="H5704,H1961"\w* \add ainda\add* \w estava|strong="H1961"\w* \w na minha terra|strong="H5921,H0127"\w*? \w Por isso|strong="H5921,H3651"\w* \w me apressei|strong="H6923"\w* \w a fugir|strong="H1272"\w* \w para Társis|strong="H8659"\w*, \w pois|strong="H3588"\w* \add eu\add* \w sabia|strong="H3045"\w* \w que|strong="H3588"\w* \w tu|strong="H0859"\w* \w és|strong="H0410"\w* \w um Deus|strong="H0410"\w* \w misericordioso e compassivo|strong="H2587,H7349"\w*, \w tardio em se irar|strong="H0750,H0639"\w* \w e grande|strong="H7227"\w* \w em bondade|strong="H2617"\w*, \w e|strong="H5162"\w* \add que te\add* \w arrependes|strong="H5162"\w* \w do|strong="H5921"\w* \w mal|strong="H7451"\w*.\x - \xo 4:2 \xt EXO 34:6; PSA 86:15; PSA 103:8; JOL 2:13; PSA 145:8; 2CH 30:9\x*
\v 3 \w E agora|strong="H6258"\w*, \w ó|strong="H3068"\w* \w SENHOR|strong="H3068"\w*, \w toma|strong="H3947,H4994"\w* \w a minha vida|strong="H5315"\w* \w de mim|strong="H4480"\w*, \w pois|strong="H3588"\w* \w é melhor|strong="H2896"\w* \w a minha morte|strong="H4194"\w* \w que a minha vida|strong="H2416"\w*."\x - \xo 4:3 \xt ECC 7:1; DEU 30:15; JOB 7:15; JON 4:8; JOB 30:23; 1KI 19:4\x*
\v 4 \w E o SENHOR|strong="H3068"\w* \w disse|strong="H0559"\w*: \add "Faz\add* \w bem|strong="H3190"\w* \w em se irar assim|strong="H2734,H9031"\w*?"\x - \xo 4:4 \xt JON 4:9; MAT 20:15; JAS 2:8; JON 4:1; PSA 106:32-33; JAS 1:19-20\x*
\v 5 \w Então Jonas|strong="H3124"\w* \w saiu|strong="H3318"\w* \add da\add* \w cidade|strong="H5892"\w* \w e se sentou|strong="H3427"\w* \w a|strong="H6924"\w* \w leste|strong="H6924"\w* \w da cidade|strong="H5892"\w*; \w e fez|strong="H6213,H9033"\w* \add para\add* \w si|strong="H9033"\w* \w ali|strong="H8033"\w* \w uma cabana|strong="H5521"\w* \w e se sentou|strong="H3427"\w* \w debaixo dela|strong="H8478"\w*, \w à sombra|strong="H6738"\w*, \w até|strong="H5704"\w* \w ver|strong="H0834,H7200"\w* \w o que|strong="H4100"\w* \w aconteceria|strong="H1961"\w* \w com a cidade|strong="H5892"\w*.\x - \xo 4:5 \xt 1KI 19:9; 1KI 19:13; GEN 19:27-28; ISA 57:17; JER 17:15-16\x*
\v 6 \w E o SENHOR|strong="H3068"\w* \w Deus|strong="H0430"\w* \add fez\add* \w crescer|strong="H4487"\w* \w uma planta|strong="H7021"\w*, \w que cresceu|strong="H5927"\w* \w acima de|strong="H5921"\w* \w Jonas|strong="H3124"\w*, \w para fazer|strong="H1961"\w* \w sombra|strong="H6738"\w* \w sobre|strong="H5921"\w* \w a sua cabeça|strong="H7218"\w* \w e livrá-lo|strong="H5337,H9033"\w* \w do seu mal-estar|strong="H7451"\w*; \w e Jonas|strong="H3124"\w* \w alegrou-se|strong="H8055"\w* \w muito|strong="H8057,H1419"\w* \w com a planta|strong="H5921,H7021"\w*.\x - \xo 4:6 \xt JON 1:17; PSA 103:10-14; 1CO 7:30; EST 5:9; ISA 39:2; JON 4:8\x*
\v 7 \w Mas Deus|strong="H0430"\w* \w enviou|strong="H4487"\w* \w uma lagarta|strong="H8438"\w*, \w quando a aurora|strong="H5927,H7837"\w* \w nasceu|strong="H5927"\w* \w no dia seguinte|strong="H4283"\w*, \w e ela atacou|strong="H5221"\w* \add a\add* \w planta|strong="H7021"\w*, \w que secou|strong="H3001"\w*.\x - \xo 4:7 \xt JOL 1:12; PSA 90:5-6; ISA 40:6-8; JOB 1:21; PSA 102:10; PSA 30:6-7\x*
\v 8 \w E quando o sol|strong="H2224,H8121"\w* \add se\add* \w levantou|strong="H1961,H2224"\w*, \w Deus enviou|strong="H4487,H0430"\w* \w um vento|strong="H7307"\w* \w leste e abrasador|strong="H6921,H2759"\w*, \w e o sol|strong="H8121"\w* \w bateu|strong="H5221"\w* \w sobre|strong="H5921"\w* \w a cabeça|strong="H7218"\w* \w de Jonas|strong="H3124"\w*, \w de modo que ele desfaleceu|strong="H5968"\w*; \w e ele desejou|strong="H7592,H0853,H5315,H4191"\w* \w morrer|strong="H4191"\w*, \w e disse|strong="H0559"\w*: \add "É\add* \w melhor|strong="H2896"\w* \w para mim|strong="H4194"\w* \w morrer|strong="H4194"\w* \w do que viver|strong="H2416"\w*."\x - \xo 4:8 \xt JON 4:3; PSA 121:6; 1KI 19:4; REV 16:8; EXO 14:12; EZK 19:12\x*
\v 9 \w Então Deus|strong="H0430"\w* \w disse|strong="H0559"\w* \w a|strong="H0413"\w* \w Jonas|strong="H3124"\w*: \add "Faz\add* \w bem|strong="H3190"\w* \w em se irar assim|strong="H2734,H9031"\w* \add por\add* \w causa|strong="H5921"\w* \w da planta|strong="H7021"\w*?"\w E ele disse|strong="H0559"\w*: \add "Faço\add* \w bem|strong="H3190,H2734"\w* \w em me irar|strong="H2734"\w*, \w até a morte|strong="H9030,H5704,H4194"\w*!"\x - \xo 4:9 \xt JON 4:4; JON 4:1; 2CO 7:10; JAS 2:8; ECC 7:9; LUK 15:28\x*
\v 10 \w Então o SENHOR|strong="H3068"\w* \w disse|strong="H0559"\w*: "\w Você|strong="H0859"\w* \w teve|strong="H2347"\w* \w compaixão|strong="H2347"\w* \w da planta|strong="H5921,H7021"\w*, \w pela qual|strong="H0834"\w* \w você|strong="H5998"\w* \w não|strong="H3808"\w* \w trabalhou|strong="H5998,H9033"\w* \w nela|strong="H9033"\w*, \w nem a fez crescer|strong="H3808,H1431"\w*, \w e que nasceu|strong="H1121,H3915,H1961"\w* \w numa noite|strong="H3915"\w* \w e numa noite|strong="H1121,H3915"\w* \w pereceu|strong="H0006"\w*;\x - \xo 4:10 \xt LUK 15:32\x*
\v 11 \w e eu|strong="H0589"\w* \w não|strong="H3808"\w* \w teria|strong="H2347"\w* \w compaixão|strong="H2347"\w* \w de|strong="H5921"\w* \w Nínive|strong="H5210"\w*, \w a grande cidade|strong="H5892,H1419"\w*, \w que|strong="H0834"\w* \w tem|strong="H3426,H9034,H7235"\w* \w mais|strong="H8147"\w* \w de cento e vinte mil|strong="H8147,H6240,H7239"\w* \w pessoas|strong="H0120"\w*, \w que|strong="H0834"\w* \w não|strong="H3808"\w* \w sabem|strong="H3045"\w* \w distinguir|strong="H3045"\w* \w a sua mão direita|strong="H0996,H3225"\w* \w da esquerda|strong="H8040"\w*, \w e também|strong="H0929"\w* \w muito|strong="H7227"\w* \w gado|strong="H0929"\w*?"\x - \xo 4:11 \xt JON 1:2; JON 3:2; MAT 18:33; LUK 15:28-32; PSA 145:8-9; PSA 36:6\x*
