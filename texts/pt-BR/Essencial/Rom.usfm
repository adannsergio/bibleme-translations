\p
\v 1 \w Ou|strong="G2228"\w* \w ignoram|strong="G50"\w*, \w irmãos e irmãs|strong="G80"\w* — \w pois|strong="G1063"\w* \w falo|strong="G2980"\w* \w a quem conhece|strong="G1097"\w* \w lei|strong="G3551"\w* —, \w que|strong="G3754"\w* \w a lei|strong="G3588,G3551"\w* \w domina|strong="G2961"\w* \w o ser humano|strong="G3588,G444"\w* \w durante o tempo em que|strong="G1909,G3745,G5550"\w* \w vive|strong="G2198"\w*?\x - \xo 7:1 \xt ROM 6:14; ROM 6:3; ROM 14:9; MRK 10:9; ROM 7:6; ROM 10:4\x*
\v 2 \w Pois|strong="G1063"\w* \w a mulher casada|strong="G3588,G5220,G1135"\w* \w está ligada|strong="G1210"\w* \w pela lei|strong="G3551"\w* \w ao marido|strong="G3588,G435"\w* \w vivo|strong="G2198"\w*; \w mas se|strong="G1437,G1161"\w* \w morrer|strong="G599"\w* \w o marido|strong="G3588,G435"\w*, \w ela fica desobrigada|strong="G2673"\w* \w da lei|strong="G575,G3588,G3551"\w* \w do marido|strong="G3588,G435"\w*.\x - \xo 7:2 \xt 1CO 7:39; GEN 2:23-24; GEN 2:24; EXO 20:14; 1CO 7:4; MRK 10:9\x*
\v 3 \w Portanto|strong="G686,G3767"\w*, \w vivendo|strong="G2198"\w* \w o marido|strong="G3588,G435"\w*, \w será chamada|strong="G5537"\w* \w adúltera|strong="G3428"\w* \w se passar a pertencer|strong="G1437,G1096"\w* \w a outro|strong="G2087"\w* \w homem|strong="G435"\w*; \w mas se|strong="G1437,G1161"\w* \w morrer|strong="G599"\w* \w o marido|strong="G3588,G435"\w*, \w é livre|strong="G1658,G1510"\w* \w da lei|strong="G575,G3588,G3551"\w*, \w de modo que não|strong="G3588,G3361,G1511"\w* \add seja\add* \w adúltera|strong="G846,G3428"\w* \w tendo passado a pertencer|strong="G1096"\w* \w a outro|strong="G2087"\w* \w homem|strong="G435"\w*.\f + \fr 7.3: \ft Acréscimo: “seja” (em “que não seja adúltera tendo”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 7:3 \xt MAT 5:32; EXO 20:14; 1CO 7:39; MRK 10:9; MAT 19:9; MRK 10:11\x*
\v 4 \w De modo que|strong="G5620"\w*, \w meus irmãos e irmãs|strong="G80,G3165"\w*, \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w foram postos à morte|strong="G2289"\w* \w para a lei|strong="G3588,G3551"\w* \w por meio do corpo|strong="G1223,G3588,G4983"\w* \w de Cristo|strong="G3588,G5547"\w*, \w para que se tornem|strong="G1519,G3588,G1096,G4771"\w* \w de outro|strong="G2087"\w*, \w daquele que foi ressuscitado|strong="G3588,G1453"\w* \w dentre os mortos|strong="G1537,G3498"\w*, \w a fim de que|strong="G2443"\w* \add demos\add* \w fruto|strong="G2592"\w* \w para Deus|strong="G3588,G2316"\w*.\f + \fr 7.4: \ft Acréscimo: “demos” (em “de que demos fruto para”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 7:4 \xt GAL 5:22; 1PE 2:24; JHN 15:5; ISA 54:5; ROM 6:14; ROM 8:2\x*
\v 5 \w Pois|strong="G1063"\w* \w quando|strong="G3753"\w* \w estávamos|strong="G1510"\w* \w na carne|strong="G1722,G3588,G4561"\w*, \w as paixões|strong="G3588,G3804"\w* \w dos pecados|strong="G3588,G266"\w*, \w as que vinham|strong="G3588"\w* \w pela lei|strong="G1223,G3588,G3551"\w*, \w atuavam|strong="G1754"\w* \w em nossos membros|strong="G1722,G3588,G3196,G3165"\w* \w para darmos fruto|strong="G1519,G3588,G2592"\w* \w para a morte|strong="G3588,G2288"\w*;\x - \xo 7:5 \xt GAL 5:24; ROM 6:14; ROM 8:6; MAT 6:21; ROM 8:8; EPH 2:3\x*
\v 6 \w mas agora|strong="G3570,G1161"\w* \w fomos desobrigados|strong="G2673"\w* \w da lei|strong="G575,G3588,G3551"\w*, \w tendo morrido|strong="G599"\w* \w para aquilo em que|strong="G1722,G3739"\w* \w estávamos retidos|strong="G2722"\w*, \w de modo que|strong="G5620"\w* \w sirvamos|strong="G1398,G3165"\w* \w em novidade|strong="G1722,G2538"\w* \w de espírito|strong="G4151"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w em velhice|strong="G3821"\w* \w de letra|strong="G1121"\w*.\x - \xo 7:6 \xt 2CO 5:17; 2CO 3:6; ROM 6:4; GAL 3:23-25; ROM 6:14; GAL 5:1\x*
\p
\v 7 \w O que|strong="G5101"\w*, \w então|strong="G3767"\w*, \w diremos|strong="G4483"\w*? \w A lei|strong="G3588,G3551"\w* \w é pecado|strong="G266"\w*? \w De modo nenhum|strong="G3361,G1096"\w*! \w Mas|strong="G235"\w* \w o pecado|strong="G3588,G266"\w* \w não|strong="G3756"\w* \w conheci|strong="G1097"\w* \w a não ser|strong="G1487,G3361"\w* \w pela lei|strong="G1223,G3551"\w*; \w pois|strong="G1063"\w* \w a cobiça|strong="G3588,G5037,G1939"\w* \w não|strong="G3756"\w* \add teria\add* \w conhecido|strong="G1492"\w* \w a não ser que|strong="G1487,G3361"\w* \w a lei|strong="G3588,G3551"\w* \w dissesse|strong="G3004"\w*: \add “Você\add* \w não|strong="G3756"\w* \w cobiçará|strong="G1937"\w*.”\f + \fr 7.7: \ft Nota cultural: cita o décimo mandamento (Êx 20:17; Dt 5:21).\f*\f + \fr 7.7: \ft Tradução: μὴ γένοιτο, literalmente “que não aconteça”: fórmula enfática de rejeição, vertida “De modo nenhum!”.\f*\f + \fr 7.7: \ft Acréscimo: “teria” (em “cobiça não teria conhecido a”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; “Você” (em “lei dissesse Você não cobiçará”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo; verbo ser/estar suprido em “é pecado”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:7 \xt EXO 20:17; DEU 5:21; ROM 6:14; MAT 6:21; 1JN 3:4; ROM 3:20\x*
\v 8 \w Mas o pecado|strong="G1161,G3588,G266"\w*, \w tomando ocasião|strong="G874,G2983"\w* \w por meio do mandamento|strong="G1223,G3588,G1785"\w*, \w produziu|strong="G2716"\w* \w em mim|strong="G1722,G1473"\w* \w toda|strong="G3956"\w* \w cobiça|strong="G1939"\w*; \w pois|strong="G1063"\w* \w sem lei|strong="G5565,G3551"\w* \w o pecado|strong="G266"\w* \w está morto|strong="G3498"\w*.\f + \fr 7.8: \ft Acréscimo: verbo ser/estar suprido em “está morto”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:8 \xt ROM 7:11; ROM 7:13; ROM 6:14; GEN 4:7; 1JN 3:4; GAL 3:19\x*
\v 9 \w E eu|strong="G1473,G1161"\w* \w vivia|strong="G2198"\w* \w sem lei|strong="G5565,G3551"\w* \w outrora|strong="G4218"\w*; \w mas vindo|strong="G2064,G1161"\w* \w o mandamento|strong="G3588,G1785"\w*, \w o pecado|strong="G3588,G266"\w* \w reviveu|strong="G326"\w*,\x - \xo 7:9 \xt ROM 6:14; GEN 4:7; 1JN 3:4; LUK 15:7; GAL 3:19; GAL 3:10\x*
\v 10 \w e eu|strong="G1473,G1161"\w* \w morri|strong="G599"\w*, \w e|strong="G2532"\w* \w verificou-se|strong="G2147"\w* \w para mim|strong="G3165"\w* \w que o mandamento|strong="G3588,G1785"\w* \w que era para vida|strong="G3588,G1519,G2222"\w*, \w esse|strong="G3778"\w*, \w era para morte|strong="G1519,G2288"\w*;\f + \fr 7.10: \ft Acréscimo: verbo ser/estar suprido em “que era para vida”, “era para morte”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:10 \xt ROM 6:14; 1JN 3:4; GAL 3:19; GEN 2:17; GAL 3:10; 1CO 15:56\x*
\v 11 \w pois|strong="G1063"\w* \w o pecado|strong="G3588,G266"\w*, \w tomando ocasião|strong="G874,G2983"\w* \w por meio do mandamento|strong="G1223,G3588,G1785"\w*, \w me enganou|strong="G1818,G3165"\w* \w e|strong="G2532"\w* \w por meio dele|strong="G1223,G846"\w* \w me matou|strong="G615"\w*.\x - \xo 7:11 \xt ROM 7:8; ROM 6:14; ROM 8:6; 1JN 3:4; GAL 3:19; GEN 2:17\x*
\v 12 \w De modo que|strong="G5620"\w* \w a lei|strong="G3588,G3551"\w*, \w de fato|strong="G3303"\w*, \w é santa|strong="G40"\w*, \w e|strong="G2532"\w* \w o mandamento|strong="G3588,G1785"\w* \w é santo|strong="G40"\w* \w e|strong="G2532"\w* \w justo|strong="G1342"\w* \w e|strong="G2532"\w* \w bom|strong="G18"\w*.\f + \fr 7.12: \ft Acréscimo: verbo ser/estar suprido em “é santa”, “é santo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:12 \xt ROM 12:2; 1TI 1:8; PRO 30:5; 1JN 3:4; GAL 3:19; GEN 2:17\x*
\v 13 \w O que é bom|strong="G3588,G18"\w*, \w então|strong="G3767"\w*, \w tornou-se|strong="G1096"\w* \w para mim|strong="G1473"\w* \w morte|strong="G2288"\w*? \w De modo nenhum|strong="G3361,G1096"\w*! \w Mas foi o pecado|strong="G235,G3588,G266"\w*, \w para que se mostrasse|strong="G2443,G5316"\w* \w pecado|strong="G266"\w*, \w produzindo|strong="G2716"\w* \w em mim|strong="G3165"\w* \w morte|strong="G2288"\w* \w por meio do que é bom|strong="G1223,G3588,G18"\w*; \w para que se tornasse|strong="G2443,G1096"\w* \w excessivamente|strong="G2596,G5236"\w* \w pecaminoso|strong="G268"\w* \w o pecado|strong="G3588,G266"\w* \w por meio do mandamento|strong="G1223,G3588,G1785"\w*.\f + \fr 7.13: \ft Tradução: μὴ γένοιτο, literalmente “que não aconteça”: fórmula enfática de rejeição, vertida “De modo nenhum!”.\f*\f + \fr 7.13: \ft Acréscimo: verbo ser/estar suprido em “O que é bom”, “Mas foi o pecado”, “por meio do que é bom”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:13 \xt ROM 7:8; 1JN 3:4; GAL 3:19; GEN 2:17; GAL 3:10; JAS 1:14\x*
\v 14 \w Pois|strong="G1063"\w* \w sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w a lei|strong="G3588,G3551"\w* \w é espiritual|strong="G4152,G1510"\w*; \w mas eu|strong="G1473,G1161"\w* \w sou carnal|strong="G4560,G1510"\w*, \w vendido|strong="G4097"\w* \w sob o pecado|strong="G5259,G3588,G266"\w*.\f + \fr 7.14: \ft Lit.: o “eu” de Rm 7:7-25 é entendido de modos diversos (Paulo antes de Cristo, Paulo cristão, Adão, Israel, a humanidade sob a lei); a tradução mantém a primeira pessoa do grego.\f*\x - \xo 7:14 \xt 1CO 3:1; ROM 12:2; ROM 4:15; ROM 7:12; 1CO 6:12; 1KI 21:20\x*
\v 15 \w Pois|strong="G1063"\w* \w o que|strong="G3739"\w* \w faço|strong="G2716"\w* \w não|strong="G3756"\w* \w compreendo|strong="G1097"\w*; \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w o que|strong="G3739"\w* \w quero|strong="G2309"\w* \w isso|strong="G3778"\w* \w pratico|strong="G4238"\w*, \w mas|strong="G235"\w* \w o que|strong="G3739"\w* \w odeio|strong="G3404"\w* \w isso|strong="G3778"\w* \w faço|strong="G4160"\w*.\f + \fr 7.15: \ft Tradução: Continua o “eu” de 7:14; ver a nota lit desse versículo sobre as leituras possíveis do “eu”.\f*\x - \xo 7:15 \xt ROM 7:19; GAL 5:17; ECC 7:20; NAM 1:7; JAS 3:2; PHP 3:12-14\x*
\v 16 \w Mas se|strong="G1487,G1161"\w* \w o que|strong="G3739"\w* \w não|strong="G3756"\w* \w quero|strong="G2309"\w* \w isso|strong="G3778"\w* \w faço|strong="G4160"\w*, \w concordo|strong="G4852"\w* \w com a lei|strong="G3588,G3551"\w* \w que|strong="G3754"\w* \w é boa|strong="G2570"\w*.\f + \fr 7.16: \ft Tradução: Continua o “eu” de 7:14; ver a nota lit desse versículo sobre as leituras possíveis do “eu”.\f*\f + \fr 7.16: \ft Acréscimo: verbo ser/estar suprido em “é boa”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:16 \xt 1TI 1:8; GAL 4:21; ROM 7:21; MIC 6:8; ROM 4:15; ROM 7:15\x*
\v 17 \w Mas agora|strong="G3570,G1161"\w* \w já não|strong="G2089,G3756"\w* \w sou eu|strong="G1473"\w* \w que o faço|strong="G2716,G846"\w*, \w mas|strong="G235"\w* \w o pecado|strong="G266"\w* \w que habita|strong="G3588,G3611"\w* \w em mim|strong="G1722,G1473"\w*.\f + \fr 7.17: \ft Tradução: Continua o “eu” de 7:14; ver a nota lit desse versículo sobre as leituras possíveis do “eu”.\f*\f + \fr 7.17: \ft Acréscimo: verbo ser/estar suprido em “sou eu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:17 \xt ROM 7:20; ROM 8:1; ROM 4:15; PHP 3:8-9; ROM 7:18; GAL 5:17\x*
\v 18 \w Pois|strong="G1063"\w* \w sei|strong="G6063"\w* \w que|strong="G3754"\w* \w não|strong="G3756"\w* \w habita|strong="G3611"\w* \w em mim|strong="G1722,G1473"\w*, \w isto é|strong="G3778,G1510"\w*, \w na minha|strong="G3165"\w* \w carne|strong="G1722,G3588,G4561"\w*, \w nada de bom|strong="G18"\w*; \w pois|strong="G1063"\w* \w o querer|strong="G3588,G2309"\w* \w está ao meu alcance|strong="G3873,G3165"\w*, \w mas o praticar|strong="G3588,G1161,G2716"\w* \w o bem|strong="G3588,G2570"\w* \w não|strong="G3756"\w* \add está.\add*\f + \fr 7.18: \ft Variante: o RP e o TR acrescentam οὐχ εὑρίσκω (“não encontro”) no fim do verso.\f*\f + \fr 7.18: \ft Acréscimo: “está” (em “bem não está”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 7:18 \xt ROM 7:20; ROM 7:21; ISA 64:6; JHN 3:6; MAT 26:41; PSA 51:5\x*
\v 19 \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w o bem|strong="G18"\w* \w que quero|strong="G3739,G2309"\w* \w faço|strong="G4160"\w*, \w mas|strong="G235"\w* \w o mal|strong="G2556"\w* \w que não|strong="G3739,G3756"\w* \w quero|strong="G2309"\w*, \w isso|strong="G3778"\w* \w pratico|strong="G4238"\w*.\f + \fr 7.19: \ft Tradução: Continua o “eu” de 7:14; ver a nota lit desse versículo sobre as leituras possíveis do “eu”.\f*\x - \xo 7:19 \xt ROM 7:15; 1PE 3:11; ROM 12:21; MAT 26:41; MRK 14:38; PHP 3:12\x*
\v 20 \w Mas se|strong="G1487,G1161"\w* \w o que|strong="G3739"\w* \w não|strong="G3756"\w* \w quero|strong="G2309"\w* \w isso|strong="G3778"\w* \w faço|strong="G4160"\w*, \w já não|strong="G2089,G3756"\w* \w sou eu|strong="G1473"\w* \w que o faço|strong="G2716,G846"\w*, \w mas|strong="G235"\w* \w o pecado|strong="G266"\w* \w que habita|strong="G3588,G3611"\w* \w em mim|strong="G1722,G1473"\w*.\f + \fr 7.20: \ft Tradução: Continua o “eu” de 7:14; ver a nota lit desse versículo sobre as leituras possíveis do “eu”.\f*\f + \fr 7.20: \ft Acréscimo: verbo ser/estar suprido em “sou eu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:20 \xt ROM 7:17; ROM 7:15; ROM 7:18; ROM 8:1; MAT 26:41; MRK 14:38\x*
\v 21 \w Encontro|strong="G2147"\w*, \w então|strong="G686"\w*, \w esta lei|strong="G3588,G3551"\w*: \w que|strong="G3754"\w*\f + \fr 7.21: \ft Lit.: νόμος, aqui “princípio, regra de funcionamento”.\f*, \w quando eu|strong="G3588,G1473"\w* \w quero|strong="G2309"\w* \w fazer|strong="G4160"\w* \w o bem|strong="G3588,G2570"\w*, \w o mal|strong="G3588,G2556"\w* \w está presente|strong="G3873"\w* \w junto a mim|strong="G1473"\w*.\x - \xo 7:21 \xt ROM 7:16; ROM 7:18; MAT 26:41; ROM 8:2; MRK 14:38; PHP 3:12\x*
\v 22 \w Pois|strong="G1063"\w* \w me alegro|strong="G4913"\w* \w com a lei|strong="G3588,G3551"\w* \w de Deus|strong="G3588,G2316"\w* \w segundo o ser humano|strong="G2596,G3588,G444"\w* \w interior|strong="G2080"\w*,\f + \fr 7.22: \ft Tradução: Continua o “eu” de 7:14; ver a nota lit desse versículo sobre as leituras possíveis do “eu”.\f*\x - \xo 7:22 \xt ROM 12:2; PSA 1:2; PSA 119:5; PSA 40:8; MAT 11:28; 2CO 4:16\x*
\v 23 \w mas vejo|strong="G991,G1161"\w* \w outra|strong="G2087"\w* \w lei|strong="G3551"\w* \w nos meus membros|strong="G1722,G3588,G3196,G3165"\w* \w que guerreia contra|strong="G497"\w* \w a lei|strong="G3588,G3551"\w* \w da minha|strong="G3165"\w* \w mente|strong="G3588,G3563"\w* \w e|strong="G2532"\w* \w me leva cativo|strong="G163,G3165"\w* \w na lei|strong="G1722,G3588,G3551"\w* \w do pecado|strong="G3588,G266"\w*, \w que está|strong="G3588,G1510"\w* \w nos meus membros|strong="G1722,G3588,G3196,G3165"\w*.\f + \fr 7.23: \ft Tradução: Continua o “eu” de 7:14; ver a nota lit desse versículo sobre as leituras possíveis do “eu”.\f*\x - \xo 7:23 \xt 2CO 10:5; ROM 7:25; PSA 119:5; JAS 4:1; ISA 61:1; MAT 11:28\x*
\v 24 \w Eu|strong="G1473"\w*, \w miserável ser humano|strong="G5005,G444"\w*! \w Quem|strong="G5101"\w* \w me libertará|strong="G3165,G4506"\w* \w deste|strong="G1537,G3588,G3778"\w* \w corpo|strong="G4983"\w* \w de morte|strong="G3588,G2288"\w*?\f + \fr 7.24: \ft Tradução: Continua o “eu” de 7:14; ver a nota lit desse versículo sobre as leituras possíveis do “eu”.\f*\x - \xo 7:24 \xt PSA 119:5; ISA 61:1; MAT 11:28; ISA 64:6; MAT 26:41; REV 3:17\x*
\v 25 \w Graças|strong="G5485"\w* \w a Deus|strong="G3588,G2316"\w* \w por meio de Jesus|strong="G1223,G2424"\w* \w Cristo|strong="G5547"\w*, \w nosso Senhor|strong="G3588,G2962,G3165"\w*! \w Portanto|strong="G686,G3767"\w*, \w eu mesmo|strong="G846,G1473"\w*, \w com a mente|strong="G3588,G3303,G3563"\w*, \w sirvo|strong="G1398"\w* \w à lei|strong="G3551"\w* \w de Deus|strong="G2316"\w*, \w mas com a carne|strong="G3588,G1161,G4561"\w*, \w à lei|strong="G3551"\w* \w do pecado|strong="G266"\w*.\f + \fr 7.25: \ft Variante: o SBLGNT traz χάρις (sem δέ), como Treg; WH e NA28 trazem χάρις δέ; o RP traz εὐχαριστῶ (“dou graças”).\f*\x - \xo 7:25 \xt ROM 7:23; ROM 6:14; ISA 61:1; MAT 11:28; MAT 26:41; GAL 5:17\x*
