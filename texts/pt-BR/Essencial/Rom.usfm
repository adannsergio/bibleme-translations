\v 1 \w Paulo|strong="G3972"\w*, \w servo|strong="G1401"\w* \w de Cristo|strong="G5547"\w* \w Jesus|strong="G2424"\w*, \w chamado|strong="G2822"\w* \w apóstolo|strong="G652"\w*, \w separado|strong="G873"\w* \w para a boa notícia|strong="G1519,G2098"\w* \w de Deus|strong="G2316"\w*,\f + \fr 1.1: \ft Lit.: δοῦλος aqui como autodesignação devocional, “servo de Deus/Cristo” (eco do hebraico עבד יהוה, “servo do SENHOR”, título de Moisés e dos profetas); onde a mesma palavra descreve a condição social, fica “escravo” (ver convencoes.md).\f*\x - \xo 1:1 \xt 1CO 1:1; JUD 1:1; TIT 1:1; GAL 1:1; ACT 9:15; ROM 15:16\x*
\v 2 \w a qual|strong="G3739"\w* \add Deus\add* \w prometeu antes|strong="G4279"\w* \w por meio|strong="G1223"\w* \w dos seus|strong="G3588,G846"\w* \w profetas|strong="G4396"\w* \w em Escrituras|strong="G1722,G1124"\w* \w santas|strong="G40"\w*\f + \fr 1.2: \ft Acréscimo: “Deus” (em “a qual Deus prometeu antes”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 1:2 \xt TIT 1:2; LUK 1:70; ROM 16:26; ROM 3:21; ACT 10:43; ROM 3:2\x*
\v 3 \w a respeito|strong="G4012"\w* \w do seu|strong="G3588,G846"\w* \w Filho|strong="G5207"\w*, \w que veio a ser|strong="G3588,G1096"\w* \w da descendência|strong="G1537,G4690"\w* \w de Davi|strong="G1138"\w* \w segundo a carne|strong="G2596,G4561"\w*,\x - \xo 1:3 \xt 2TI 2:8; MAT 1:1; MAT 1:23; GAL 4:4; REV 5:5; JER 23:5-6\x*
\v 4 \w que foi designado|strong="G3588,G3724"\w* \w Filho|strong="G5207"\w* \w de Deus|strong="G2316"\w* \w com poder|strong="G1722,G1411"\w* \w segundo o Espírito|strong="G2596,G4151"\w* \w de santidade|strong="G42"\w* \w pela ressurreição|strong="G1537,G386"\w* \w dos mortos|strong="G3498"\w*, \w Jesus Cristo|strong="G2424,G5547"\w* \w nosso Senhor|strong="G3588,G2962,G3165"\w*,\f + \fr 1.4: \ft Lit.: κατὰ πνεῦμα ἁγιωσύνης, “segundo o espírito de santidade”: pode designar o Espírito Santo ou a dimensão espiritual, em contraste com “segundo a carne” (v. 3).\f*\x - \xo 1:4 \xt MAT 16:16; MAT 1:23; PSA 2:7; REV 22:16; JHN 1:14; HEB 5:5-6\x*
\v 5 \w por meio de quem|strong="G1223,G3739"\w* \w recebemos|strong="G2983"\w* \w graça|strong="G5485"\w* \w e|strong="G2532"\w* \w apostolado|strong="G651"\w* \w para a obediência|strong="G1519,G5218"\w* \w da fé|strong="G4102"\w* \w entre todos|strong="G1722,G3956"\w* \w os gentios|strong="G3588,G1484"\w* \w por causa do nome|strong="G5228,G3588,G3686"\w* \w dele|strong="G846"\w*\f + \fr 1.5: \ft Lit.: ὑπακοὴ πίστεως, “obediência da fé”: a fé que é obediência, ou a obediência que a fé produz.\f*,\x - \xo 1:5 \xt GAL 2:8; ROM 15:18; ACT 9:15; 2CO 10:5; ROM 16:26; ACT 6:7\x*
\v 6 \w entre os quais|strong="G1722,G3739"\w* \w estão|strong="G1510"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w*, \w chamados|strong="G2822"\w* \w para pertencer a Jesus Cristo|strong="G2424,G5547"\w*\f + \fr 1.6: \ft Lit.: κλητοὶ Ἰησοῦ Χριστοῦ: literalmente “chamados de Jesus Cristo”; o genitivo indica que são chamados por ele e pertencem a ele.\f*;\x - \xo 1:6 \xt ROM 8:28; 1PE 2:9; REV 17:14; 2PE 1:10; HEB 3:1; 1CO 1:9\x*
\v 7 \w a todos os que estão|strong="G3956,G3588,G1510"\w* \w em Roma|strong="G1722,G4516"\w*, \w amados|strong="G27"\w* \w de Deus|strong="G2316"\w*, \w chamados|strong="G2822"\w* \w santos|strong="G40"\w*: \w graça|strong="G5485"\w* \w a vocês|strong="G4771"\w* \w e|strong="G2532"\w* \w paz|strong="G1515"\w* \w da parte de Deus|strong="G575,G2316"\w*, \w nosso Pai|strong="G3962,G3165"\w*, \w e|strong="G2532"\w* \w do Senhor|strong="G2962"\w* \w Jesus Cristo|strong="G2424,G5547"\w*.\x - \xo 1:7 \xt PHP 1:2; COL 1:2; 2CO 1:2; EPH 1:2; 1CO 1:3; 2TH 1:2\x*
\v 8 \w Primeiro|strong="G4413,G3303"\w*, \w dou graças|strong="G2168"\w* \w ao meu|strong="G3588,G3165"\w* \w Deus|strong="G2316"\w* \w por meio de Jesus Cristo|strong="G1223,G2424,G5547"\w* \w por todos|strong="G4012,G3956"\w* \w vocês|strong="G4771"\w*, \w porque|strong="G3754"\w* \w a fé|strong="G3588,G4102"\w* \w de vocês|strong="G4771"\w* \w é proclamada|strong="G2605"\w* \w em todo|strong="G1722,G3650"\w* \w o mundo|strong="G3588,G2889"\w*.\x - \xo 1:8 \xt PHP 4:19; 1TH 1:2; EPH 1:16; 1CO 1:4; 1TI 2:1; 2TI 1:3\x*
\v 9 \w Pois|strong="G1063"\w* \w é minha|strong="G3165"\w* \w testemunha|strong="G3144"\w* \w Deus|strong="G1510,G3588,G2316"\w*, \w a quem|strong="G3739"\w* \w presto culto|strong="G3000"\w* \w no meu|strong="G1722,G3588,G3165"\w* \w espírito|strong="G4151"\w* \w na boa notícia|strong="G1722,G3588,G2098"\w* \w do seu|strong="G846"\w* \w Filho|strong="G3588,G5207"\w*: \w como|strong="G5613"\w* \w sem cessar|strong="G89"\w* \w faço menção|strong="G3417,G4160"\w* \w de vocês|strong="G4771"\w*\f + \fr 1.9: \ft Acréscimo: verbo ser/estar suprido em “é minha”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:9 \xt 1TH 1:2; 2TI 1:3; 1SA 12:23; EPH 1:16; ROM 1:1; EPH 6:18\x*
\v 10 \w sempre|strong="G3842"\w* \w nas minhas|strong="G1909,G3588,G3165"\w* \w orações|strong="G4335"\w*, \w pedindo|strong="G1189"\w* \w que de algum modo|strong="G1487,G4458"\w*, \w finalmente|strong="G2235,G4218"\w*, \w me seja aberto o caminho|strong="G2137"\w* \w pela vontade|strong="G1722,G3588,G2307"\w* \w de Deus|strong="G3588,G2316"\w* \w para ir|strong="G2064"\w* \w até vocês|strong="G4314,G4771"\w*.\x - \xo 1:10 \xt JAS 4:15; ROM 15:30-32; ACT 18:21; 1TH 3:10; PHM 1:22; GAL 1:3\x*
\v 11 \w Pois|strong="G1063"\w* \w anseio|strong="G1971"\w* \w ver|strong="G1492"\w* \w vocês|strong="G4771"\w*, \w para que|strong="G2443"\w* \w lhes comunique|strong="G3330,G4771"\w* \w algum|strong="G5100"\w* \w dom|strong="G5486"\w* \w espiritual|strong="G4152"\w*, \w de modo que|strong="G1519,G3588"\w* \w sejam fortalecidos|strong="G4741,G4771"\w*;\x - \xo 1:11 \xt ROM 12:6; 2PE 1:12; 2TH 3:3; ROM 16:25; 2CO 1:15; ROM 15:29\x*
\v 12 \w isto é|strong="G3778,G1161,G1510"\w*, \w sermos consolados juntos|strong="G4837"\w* \w entre vocês|strong="G1722,G4771"\w* \w pela fé|strong="G1223,G3588,G4102"\w* \w mútua|strong="G1722,G240"\w* \w tanto a de vocês|strong="G4771,G5037"\w* \w como a minha|strong="G2532,G1473"\w*.\x - \xo 1:12 \xt 2CO 4:13; 2PE 1:1; 1TH 2:8; 1TH 3:10; ROM 15:24; GAL 1:3\x*
\v 13 \w E não quero|strong="G3756,G2309,G1161"\w* \w que vocês ignorem|strong="G4771,G50"\w*, \w irmãos e irmãs|strong="G80"\w*, \w que|strong="G3754"\w* \w muitas vezes|strong="G4178"\w* \w me propus|strong="G4388"\w* \w ir|strong="G2064"\w* \w até vocês|strong="G4314,G4771"\w* — \w e|strong="G2532"\w* \w fui impedido|strong="G2967"\w* \w até agora|strong="G891,G3588,G1204"\w* — \w para que|strong="G2443"\w* \w tivesse|strong="G2192"\w* \w algum|strong="G5100"\w* \w fruto|strong="G2590"\w* \w também|strong="G2532"\w* \w entre vocês|strong="G1722,G4771"\w*, \w assim como|strong="G2531"\w* \w também|strong="G2532"\w* \w entre os demais|strong="G1722,G3588,G3062"\w* \w gentios|strong="G1484"\w*.\x - \xo 1:13 \xt 1TH 4:13; 1TH 2:18; ACT 19:21; PHP 4:17; 2TI 4:17; ROM 15:22\x*
\v 14 \w Tanto a gregos|strong="G1672,G5037,G2532"\w* \w como a bárbaros|strong="G915"\w*, \w tanto a sábios|strong="G4680,G5037,G2532"\w* \w como a ignorantes|strong="G453"\w*, \w sou devedor|strong="G3781,G1510"\w*;\f + \fr 1.14: \ft Lit.: βάρβαρος, “não grego, estrangeiro” (sem o sentido de “selvagem”).\f*\x - \xo 1:14 \xt COL 3:11; 1CO 9:16; ACT 9:15; ACT 22:21; ACT 26:17-18; JAS 3:17-18\x*
\v 15 \w assim|strong="G3779"\w*, \w da minha parte|strong="G3588,G2596,G1473"\w*, \w estou disposto|strong="G4289"\w* \w a anunciar a boa notícia|strong="G2097"\w* \w também|strong="G2532"\w* \w a vocês|strong="G4771"\w* \w que estão em Roma|strong="G3588,G1722,G4516"\w*.\f + \fr 1.15: \ft Acréscimo: verbo ser/estar suprido em “estou disposto”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula; “que estão em Roma”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 1:15 \xt ACT 23:11; ROM 15:20; 1CO 9:17; GAL 1:3; ISA 6:8; 2CO 10:15-16\x*
\v 16 \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w me envergonho|strong="G1870"\w* \w da boa notícia|strong="G3588,G2098"\w*; \w pois|strong="G1063"\w* \w é poder|strong="G1411,G1510"\w* \w de Deus|strong="G2316"\w* \w para salvação|strong="G1519,G4991"\w* \w de todo|strong="G3956"\w* \w aquele que crê|strong="G3588,G4100"\w*, \w do judeu|strong="G2453"\w* \w primeiro|strong="G5037,G4413"\w* \w e|strong="G2532"\w* \w também do grego|strong="G1672"\w*.\f + \fr 1.16: \ft Variante: o RP e o TR acrescentam τοῦ χριστοῦ (“do Cristo”) depois de “boa notícia”.\f*\x - \xo 1:16 \xt 2TI 1:8; MRK 8:38; 1CO 1:24; ROM 2:9; EPH 1:13; 1PE 4:16\x*
\v 17 \w Pois|strong="G1063"\w* \w nela|strong="G1722,G846"\w* \w é revelada|strong="G601"\w* \w a justiça|strong="G1343"\w* \w de Deus|strong="G2316"\w*, \w de fé|strong="G1537,G4102"\w* \w para fé|strong="G1519,G4102"\w*, \w como|strong="G2531"\w* \w está escrito|strong="G1125"\w*: “\w Mas o justo|strong="G3588,G1161,G1342"\w* \w viverá|strong="G2198"\w* \w pela fé|strong="G1537,G4102"\w*.”\f + \fr 1.17: \ft Nota cultural: cita Hc 2:4.\f*\f + \fr 1.17: \ft Lit.: δικαιοσύνη θεοῦ, “justiça de Deus”: a justiça que é atributo de Deus, a que ele exerce ou a que concede; ἐκ πίστεως εἰς πίστιν é expressão de sentido debatido.\f*\f + \fr 1.17: \ft Lit.: Ὁ δίκαιος ἐκ πίστεως ζήσεται: “o justo viverá pela fé” ou “o que é justo pela fé viverá”; no hebraico de Hc 2:4, “o justo viverá pela sua fidelidade (ou fé)”.\f*\x - \xo 1:17 \xt HAB 2:4; GAL 3:11; HEB 10:38; PHP 3:9; MAT 6:33; ROM 3:10\x*
\v 18 \w Pois|strong="G1063"\w* \w é revelada|strong="G601"\w* \w a ira|strong="G3709"\w* \w de Deus|strong="G2316"\w* \w do céu|strong="G575,G3772"\w* \w contra toda|strong="G1909,G3956"\w* \w impiedade|strong="G763"\w* \w e|strong="G2532"\w* \w injustiça|strong="G93"\w* \w dos seres humanos|strong="G444"\w* \w que retêm|strong="G3588,G2722"\w* \w a verdade|strong="G3588,G225"\w* \w na injustiça|strong="G1722,G93"\w*.\f + \fr 1.18: \ft Lit.: Κατεχόντων, de κατέχω: “reter, segurar” ou “suprimir, abafar”; ἐν ἀδικίᾳ: “na injustiça” ou “pela injustiça”.\f*\x - \xo 1:18 \xt EPH 5:6; 1TI 4:1-2; ROM 1:32; COL 3:6; 1CO 6:9; 2TH 2:10\x*
\v 19 \w Porque|strong="G1360"\w* \w o que se pode conhecer|strong="G3588,G1110"\w* \w de Deus|strong="G3588,G2316"\w* \w é manifesto|strong="G5318,G1510"\w* \w neles|strong="G1722,G846"\w*; \w pois|strong="G1063"\w* \w Deus|strong="G3588,G2316"\w* \w lhes manifestou|strong="G846,G5319"\w*.\x - \xo 1:19 \xt PSA 19:1; GEN 1:1; ROM 1:20; ECC 3:11; ACT 14:16-17; ROM 2:1\x*
\v 20 \w Pois|strong="G1063"\w* \w as suas|strong="G846"\w* \w coisas invisíveis|strong="G3588,G517"\w*, \w desde a criação|strong="G575,G2937"\w* \w do mundo|strong="G2889"\w*, \w são vistas claramente|strong="G2529"\w*, \w sendo compreendidas|strong="G3539"\w* \w pelas coisas feitas|strong="G3588,G4161"\w*, \w tanto o seu|strong="G3588,G5037,G846"\w* \w eterno|strong="G126"\w* \w poder|strong="G1411"\w* \w como a divindade|strong="G2532,G2305"\w*, \w de modo que|strong="G1519,G3588"\w* \w eles fiquem|strong="G1511,G846"\w* \w sem desculpa|strong="G379"\w*\f + \fr 1.20: \ft Lit.: θειότης, “divindade, natureza divina”.\f*,\f + \fr 1.20: \ft Lit.: Εἰς τὸ εἶναι αὐτοὺς ἀναπολογήτους: “de modo que fiquem sem desculpa” (resultado) ou “para que fiquem sem desculpa” (finalidade).\f*\x - \xo 1:20 \xt PSA 19:1; COL 1:15; GEN 1:1; ROM 1:19; ISA 40:26; ECC 3:11\x*
\v 21 \w porque|strong="G1360"\w*, \w tendo conhecido|strong="G1097"\w* \w Deus|strong="G3588,G2316"\w*, \w não|strong="G3756"\w* \w o glorificaram|strong="G1392"\w* \w como Deus|strong="G5613,G2316"\w* \w nem|strong="G2228"\w* \w deram graças|strong="G2168"\w*, \w mas|strong="G235"\w* \w se tornaram vãos|strong="G3154"\w* \w nos seus|strong="G846"\w* \w raciocínios|strong="G1722,G3588,G1261"\w*, \w e|strong="G2532"\w* \w foi obscurecido|strong="G4654"\w* \w o seu|strong="G846"\w* \w coração|strong="G3588,G2588"\w* \w sem entendimento|strong="G801"\w*.\x - \xo 1:21 \xt ISA 44:18; 2CO 10:5; EPH 4:17; ROM 1:28; COL 2:8; 2KI 17:15\x*
\v 22 \w Afirmando|strong="G5335"\w* \w ser sábios|strong="G1511,G4680"\w*, \w tornaram-se tolos|strong="G3471"\w*,\x - \xo 1:22 \xt 1CO 1:20; ISA 44:18; JER 10:14; JER 9:23; COL 2:8; 1CO 3:19\x*
\v 23 \w e|strong="G2532"\w* \w trocaram|strong="G236"\w* \w a glória|strong="G3588,G1391"\w* \w do Deus|strong="G3588,G2316"\w* \w incorruptível|strong="G862"\w* \w por uma semelhança|strong="G1722,G3667"\w* \w de imagem|strong="G1504"\w* \w de ser humano|strong="G444"\w* \w corruptível|strong="G5349"\w* \w e|strong="G2532"\w* \w de aves|strong="G4071"\w* \w e|strong="G2532"\w* \w de quadrúpedes|strong="G5074"\w* \w e|strong="G2532"\w* \w répteis|strong="G2062"\w*.\f + \fr 1.23: \ft Nota cultural: ecoa Sl 106:20 e Dt 4:16-18.\f*\x - \xo 1:23 \xt PSA 106:20; DEU 4:16; ISA 44:18; ACT 10:12; JER 10:14; ROM 1:27\x*
\v 24 \w Por isso|strong="G1352"\w* \w os entregou|strong="G3860,G846"\w* \w Deus|strong="G3588,G2316"\w* \w nos desejos|strong="G1722,G3588,G1939"\w* \w dos seus|strong="G3588,G846"\w* \w corações|strong="G2588"\w* \w à impureza|strong="G1519,G167"\w*, \w para serem desonrados|strong="G3588,G818"\w* \w os seus|strong="G846"\w* \w corpos|strong="G3588,G4983"\w* \w entre eles|strong="G1722,G846"\w*,\x - \xo 1:24 \xt PSA 81:11-12; ACT 7:42; PSA 81:12; ACT 14:16; MAT 15:14; 2TH 2:10-12\x*
\v 25 \w os quais|strong="G3748"\w* \w trocaram|strong="G3337"\w* \w a verdade|strong="G3588,G225"\w* \w de Deus|strong="G3588,G2316"\w* \w pela mentira|strong="G1722,G3588,G5579"\w*, \w e|strong="G2532"\w* \w reverenciaram|strong="G4573"\w* \w e|strong="G2532"\w* \w prestaram culto|strong="G3000"\w* \w à criatura|strong="G3588,G2937"\w* \w em vez do|strong="G3844,G3588"\w* \w Criador|strong="G2936"\w*, \w que|strong="G3739"\w* \w é|strong="G1510"\w* \w bendito|strong="G2128"\w* \w para sempre|strong="G1519,G3588,G165"\w*. \w Amém|strong="G281"\w*.\x - \xo 1:25 \xt ROM 9:5; 2CO 11:31; HAB 2:18; JER 13:25; 1JN 2:15-16; PSA 14:1\x*
\v 26 \w Por isso|strong="G1223,G3778"\w* \w os entregou|strong="G3860,G846"\w* \w Deus|strong="G3588,G2316"\w* \w a paixões|strong="G1519,G3806"\w* \w de desonra|strong="G819"\w*; \w pois|strong="G1063"\w* \w as suas|strong="G846"\w* \w mulheres|strong="G3588,G5037,G2338"\w* \w trocaram|strong="G3337"\w* \w o uso|strong="G3588,G5540"\w* \w natural|strong="G5446"\w* \w pelo|strong="G1519,G3588"\w* \w que é contra|strong="G3844"\w* \w natureza|strong="G5449"\w*,\f + \fr 1.26: \ft Lit.: φυσικὴ χρῆσις, “o uso natural”, e παρὰ φύσιν, “contra a natureza”, são expressões do vocabulário moral da época; o alcance exato dos vv. 26-27 é muito discutido entre os intérpretes.\f*\f + \fr 1.26: \ft Acréscimo: verbo ser/estar suprido em “que é contra”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:26 \xt LEV 18:22; 1CO 6:9; JUD 1:7; 1TI 1:10; ROM 1:24; EPH 4:19\x*
\v 27 \w do mesmo modo|strong="G3668,G5037"\w* \w também|strong="G2532"\w* \w os homens|strong="G3588,G730"\w*, \w deixando|strong="G863"\w* \w o uso|strong="G3588,G5540"\w* \w natural|strong="G5446"\w* \w da mulher|strong="G3588,G2338"\w*, \w se inflamaram|strong="G1572"\w* \w no seu|strong="G1722,G3588,G846"\w* \w desejo|strong="G3715"\w* \w uns pelos outros|strong="G1519,G240"\w*, \w homens com homens|strong="G730,G1722"\w* \w praticando|strong="G2716"\w* \w o ato indecoroso|strong="G3588,G808"\w* \w e|strong="G2532"\w* \w recebendo em si mesmos|strong="G1722,G1438,G618"\w* \w a retribuição|strong="G3588,G489"\w* \w devida|strong="G3739,G1163"\w* \w ao seu|strong="G846"\w* \w desvio|strong="G3588,G4106"\w*.\x - \xo 1:27 \xt LEV 18:22; 1CO 6:9; LEV 20:13; ROM 1:23-24; ROM 1:24; JUD 1:7\x*
\v 28 \w E|strong="G2532"\w*, \w como|strong="G2531"\w* \w não|strong="G3756"\w* \w julgaram digno|strong="G1381"\w* \w de ter|strong="G2192"\w* \w Deus|strong="G3588,G2316"\w* \w em reconhecimento|strong="G1722,G1922"\w*, \w os entregou|strong="G3860,G846"\w* \w Deus|strong="G3588,G2316"\w* \w a uma mente|strong="G1519,G3563"\w* \w reprovada|strong="G96"\w*, \w para fazerem|strong="G4160"\w* \w o que não convém|strong="G3588,G3361,G2520"\w*,\f + \fr 1.28: \ft Lit.: há jogo de palavras entre ἐδοκίμασαν (“julgaram digno, aprovaram”) e ἀδόκιμον (“reprovado, sem valor”).\f*\x - \xo 1:28 \xt 2CO 13:5; 2TI 3:8; ISA 44:18; GEN 6:5; 2TH 2:10-12; ROM 1:21\x*
\v 29 \w cheios|strong="G4137"\w* \w de toda|strong="G3956"\w* \w injustiça|strong="G93"\w*, \w maldade|strong="G4189"\w*, \w ganância|strong="G4124"\w*, \w malícia|strong="G2549"\w*; \w repletos|strong="G3324"\w* \w de inveja|strong="G5355"\w*, \w assassinato|strong="G5408"\w*, \w discórdia|strong="G2054"\w*, \w engano|strong="G1388"\w*, \w malignidade|strong="G2550"\w*; \w caluniadores secretos|strong="G5588"\w*,\f + \fr 1.29: \ft Variante: o RP e o TR acrescentam πορνείᾳ (“imoralidade sexual”) depois de “injustiça”.\f*\x - \xo 1:29 \xt 1PE 2:1; GEN 6:5; 2TI 3:2; 1CH 28:9; PSA 14:1; GAL 5:19\x*
\v 30 \w difamadores|strong="G2637"\w*, \w que odeiam a Deus|strong="G2319"\w*, \w insolentes|strong="G5197"\w*, \w soberbos|strong="G5244"\w*, \w jactanciosos|strong="G213"\w*, \w inventores|strong="G2182"\w* \w de males|strong="G2556"\w*, \w desobedientes|strong="G545"\w* \w aos pais|strong="G1118"\w*\f + \fr 1.30: \ft Lit.: θεοστυγής admite “odiados por Deus” ou “que odeiam a Deus”.\f*,\x - \xo 1:30 \xt 2TI 3:2; GEN 6:5; PSA 14:1; GAL 5:19; TIT 3:3; 1JN 5:19\x*
\v 31 \w sem entendimento|strong="G801"\w*, \w infiéis a acordos|strong="G802"\w*, \w sem afeto natural|strong="G794"\w*, \w sem misericórdia|strong="G415"\w*;\f + \fr 1.31: \ft Variante: o RP e o TR acrescentam ἀσπόνδους (“irreconciliáveis”) depois de “sem afeto natural”.\f*\x - \xo 1:31 \xt GEN 6:5; 2TI 3:2; PSA 14:1; GAL 5:19; TIT 3:3; 1JN 5:19\x*
\v 32 \w os quais|strong="G3748"\w*, \w conhecendo|strong="G1921"\w* \w a ordenança|strong="G3588,G1345"\w* \w de Deus|strong="G3588,G2316"\w*, \w de que|strong="G3754"\w* \w os que praticam|strong="G3588,G4238"\w* \w tais coisas|strong="G3588,G5108"\w* \w são dignos|strong="G514,G1510"\w* \w de morte|strong="G2288"\w*, \w não|strong="G3756"\w* \w somente|strong="G3441"\w* \w as fazem|strong="G846,G4160"\w*, \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w aprovam|strong="G4909"\w* \w os que as praticam|strong="G3588,G4238"\w*.\x - \xo 1:32 \xt JAS 4:17; ROM 1:18; 1CO 13:6; PRO 28:4; ROM 1:21; ROM 2:1-5\x*
\c 2
\p
\v 1 \w Por isso|strong="G1352"\w* \w você é|strong="G1510"\w* \w sem desculpa|strong="G379"\w*, \w ó|strong="G5599"\w* \w ser humano|strong="G444"\w*, \w todo o que julga|strong="G3956,G3588,G2919"\w*; \w pois|strong="G1063"\w* \w naquilo em que|strong="G1722,G3739"\w* \w julga|strong="G2919"\w* \w o outro|strong="G3588,G2087"\w*, \w condena|strong="G2632"\w* \w a si mesmo|strong="G4771"\w*, \w pois|strong="G1063"\w* \w as mesmas coisas|strong="G3588,G846"\w* \w pratica|strong="G4238"\w* \w você que julga|strong="G3588,G2919"\w*.\x - \xo 2:1 \xt ROM 2:3; MAT 7:1; LUK 6:37; JHN 8:7; ROM 2:21-23; ROM 1:18-20\x*
\v 2 \w E sabemos|strong="G6063,G1161"\w* \w que|strong="G3754"\w* \w o julgamento|strong="G3588,G2917"\w* \w de Deus|strong="G3588,G2316"\w* \w é|strong="G1510"\w* \w segundo a verdade|strong="G2596,G225"\w* \w sobre os que praticam|strong="G1909,G3588,G4238"\w* \w tais coisas|strong="G3588,G5108"\w*.\x - \xo 2:2 \xt ROM 1:32; MAT 7:1; LUK 6:37; JHN 8:7; PSA 9:7-8; ROM 2:5\x*
\v 3 \w E você pensa|strong="G3049,G1161"\w* \w isto|strong="G3778"\w*, \w ó|strong="G5599"\w* \w ser humano|strong="G444"\w*, \w que julga|strong="G3588,G2919"\w* \w os que praticam|strong="G3588,G4238"\w* \w tais coisas|strong="G3588,G5108"\w* \w e|strong="G2532"\w* \w as faz|strong="G4160,G846"\w*: \w que|strong="G3754"\w* \w você|strong="G4771"\w* \w escapará|strong="G1628"\w* \w do julgamento|strong="G3588,G2917"\w* \w de Deus|strong="G3588,G2316"\w*?\f + \fr 2.3: \ft Tradução: λογίζῃ (λογίζομαι, G3049) está aqui como “E você pensa”; o termo pode ser “considerar”, “contar”, “atribuir”, “calcular” ou “raciocinar”, e o contexto decide.\f*\x - \xo 2:3 \xt ROM 2:1; ROM 1:32; JHN 8:7; ROM 1:18; ROM 2:5; HEB 2:3\x*
\v 4 \w Ou|strong="G2228"\w* \w despreza|strong="G2706"\w* \w a riqueza|strong="G3588,G4149"\w* \w da bondade|strong="G3588,G5544"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w da tolerância|strong="G3588,G463"\w* \w e|strong="G2532"\w* \w da paciência|strong="G3588,G3115"\w*, \w ignorando|strong="G50"\w* \w que|strong="G3754"\w* \w a bondade|strong="G3588,G5543"\w* \w de Deus|strong="G3588,G2316"\w* \w o conduz|strong="G4771,G71"\w* \w ao arrependimento|strong="G1519,G3341"\w*?\x - \xo 2:4 \xt 2PE 3:9; MAT 9:13; ROM 12:1; EXO 34:6; ROM 6:1; 2PE 3:15\x*
\v 5 \w Mas conforme|strong="G2596,G1161"\w* \w a sua|strong="G4771"\w* \w dureza|strong="G3588,G4643"\w* \w e|strong="G2532"\w* \w coração|strong="G2588"\w* \w impenitente|strong="G279"\w*, \w você acumula|strong="G2343"\w* \w para si mesmo|strong="G4771"\w* \w ira|strong="G3709"\w* \w no dia|strong="G1722,G2250"\w* \w da ira|strong="G3709"\w* \w e|strong="G2532"\w* \w da revelação|strong="G602"\w* \w do justo julgamento|strong="G1341"\w* \w de Deus|strong="G3588,G2316"\w*,\f + \fr 2.5: \ft Variante: o RP e o texto bizantino acrescentam καί (“e”) depois de “da ira”.\f*\x - \xo 2:5 \xt MAT 9:13; 2CO 5:10; ECC 8:11; JAS 5:3; ROM 1:32; ISA 48:4\x*
\v 6 \w o qual|strong="G3739"\w* \w retribuirá|strong="G591"\w* \w a cada um|strong="G1538"\w* \w conforme|strong="G2596"\w* \w as obras|strong="G3588,G2041"\w* \w dele|strong="G846"\w*:\f + \fr 2.6: \ft Nota cultural: ecoa Sl 62:12 e Pv 24:12.\f*\x - \xo 2:6 \xt PSA 62:12; PRO 24:12; REV 22:12; MAT 16:27; GAL 6:7; REV 2:23\x*
\v 7 \w aos que|strong="G3588,G3303"\w*, \w com perseverança|strong="G2596,G5281"\w* \w em boa|strong="G18"\w* \w obra|strong="G2041"\w*, \w buscam|strong="G2212"\w* \w glória|strong="G1391"\w* \w e|strong="G2532"\w* \w honra|strong="G5092"\w* \w e|strong="G2532"\w* \w incorruptibilidade|strong="G861"\w*: \w vida|strong="G2222"\w* \w eterna|strong="G166"\w*;\x - \xo 2:7 \xt GAL 6:7; GAL 6:9; ROM 2:10; DEU 11:27; LUK 11:9; GEN 4:7\x*
\v 8 \w mas aos que|strong="G3588,G1161"\w* \w por ambição egoísta|strong="G1537,G2052"\w* \w e|strong="G2532"\w* \w desobedecem|strong="G544"\w* \w à verdade|strong="G3588,G225"\w*, \w obedecendo|strong="G3982"\w* \w à injustiça|strong="G3588,G93"\w*: \w ira|strong="G3709"\w* \w e|strong="G2532"\w* \w furor|strong="G2372"\w*;\f + \fr 2.8: \ft Lit.: ἐριθεία, “ambição egoísta, rivalidade, espírito partidário”.\f*\x - \xo 2:8 \xt GAL 6:7; 2TH 2:12; GEN 4:7; 2CO 5:10; JAS 1:12; REV 22:12\x*
\v 9 \w tribulação|strong="G2347"\w* \w e|strong="G2532"\w* \w angústia|strong="G4730"\w* \w sobre toda|strong="G1909,G3956"\w* \w alma|strong="G5590"\w* \w humana|strong="G444"\w* \w que pratica|strong="G3588,G2716"\w* \w o mal|strong="G3588,G2556"\w*, \w do judeu|strong="G2453"\w* \w primeiro|strong="G5037,G4413"\w* \w e|strong="G2532"\w* \w também do grego|strong="G1672"\w*;\x - \xo 2:9 \xt ROM 1:16; GAL 6:7; GEN 4:7; 2CO 5:10; JAS 1:12; REV 22:12\x*
\v 10 \w mas glória|strong="G1161,G1391"\w* \w e|strong="G2532"\w* \w honra|strong="G5092"\w* \w e|strong="G2532"\w* \w paz|strong="G1515"\w* \w a todo|strong="G3956"\w* \w o que pratica|strong="G3588,G2038"\w* \w o bem|strong="G3588,G18"\w*, \w ao judeu|strong="G2453"\w* \w primeiro|strong="G5037,G4413"\w* \w e|strong="G2532"\w* \w também ao grego|strong="G1672"\w*.\x - \xo 2:10 \xt GAL 6:7; ROM 2:7; GEN 4:7; 2CO 5:10; JAS 1:12; REV 22:12\x*
\v 11 \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w há|strong="G1510"\w* \w parcialidade|strong="G4382"\w* \w da parte de Deus|strong="G3844,G3588,G2316"\w*.\f + \fr 2.11: \ft Lit.: προσωπολημψία, “acepção de pessoas” (julgar pela aparência ou condição, e não pelos atos).\f*\x - \xo 2:11 \xt EPH 6:9; DEU 10:17; ACT 10:34; REV 22:12; 2CH 19:7; GAL 2:6\x*
\v 12 \w Pois|strong="G1063"\w* \w todos os que|strong="G3745"\w* \w sem lei|strong="G460"\w* \w pecaram|strong="G264"\w*, \w sem lei|strong="G460"\w* \w também|strong="G2532"\w* \w perecerão|strong="G622"\w*; \w e|strong="G2532"\w* \w todos os que|strong="G3745"\w* \w na lei|strong="G1722,G3551"\w* \w pecaram|strong="G264"\w*, \w pela lei|strong="G1223,G3551"\w* \w serão julgados|strong="G2919"\w*;\x - \xo 2:12 \xt ROM 6:15; 1CO 9:21; LUK 12:48; ROM 3:19; GAL 3:10; ROM 2:14\x*
\v 13 \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w os ouvintes|strong="G3588,G202"\w* \w da lei|strong="G3551"\w* \w são justos|strong="G1342"\w* \w diante de Deus|strong="G3844,G3588,G2316"\w*, \w mas|strong="G235"\w* \w os que praticam|strong="G3588,G4163"\w* \w a lei|strong="G3551"\w* \w serão declarados justos|strong="G1344"\w*.\f + \fr 2.13: \ft Lit.: Δικαιόω: “declarar justo”, “justificar”; o alcance (declarar ou tornar justo) é discutido entre as tradições.\f*\f + \fr 2.13: \ft Acréscimo: verbo ser/estar suprido em “são justos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:13 \xt JAS 1:22; MAT 7:21; GAL 3:11; GAL 2:16; JAS 4:11; 1JN 3:7\x*
\v 14 \w Pois|strong="G1063"\w* \w quando|strong="G3752"\w* \w gentios|strong="G1484"\w* \w que não|strong="G3588,G3361"\w* \w têm|strong="G2192"\w* \w lei|strong="G3551"\w*, \w por natureza|strong="G5449"\w*, \w fazem|strong="G4160"\w* \w as coisas|strong="G3588"\w* \w da lei|strong="G3588,G3551"\w*, \w estes|strong="G3778"\w*, \w não tendo|strong="G3361,G2192"\w* \w lei|strong="G3551"\w*, \w são|strong="G1510"\w* \w lei|strong="G3551"\w* \w para si mesmos|strong="G1438"\w*;\x - \xo 2:14 \xt GAL 2:15; ROM 2:27; 1CO 9:21; LUK 12:48; ROM 3:19; ROM 1:19-20\x*
\v 15 \w os quais|strong="G3748"\w* \w mostram|strong="G1731"\w* \w a obra|strong="G3588,G2041"\w* \w da lei|strong="G3588,G3551"\w* \w escrita|strong="G1123"\w* \w nos seus|strong="G1722,G846"\w* \w corações|strong="G3588,G2588"\w*, \w a consciência deles|strong="G846,G3588,G4893"\w* \w dá testemunho junto|strong="G4828"\w*, \w e|strong="G2532"\w* \w os raciocínios|strong="G3588,G3053"\w* \w entre si|strong="G3342,G240"\w* \add os\add* \w acusam|strong="G2723"\w* \w ou|strong="G2228"\w* \w também|strong="G2532"\w* \w defendem|strong="G626"\w*,\f + \fr 2.15: \ft Lit.: Μεταξὺ ἀλλήλων, “entre si”: os raciocínios acusam ou defendem uns aos outros, ou acusam ou defendem as pessoas entre si; o grego não traz objeto para “acusam ou defendem” (o “os” é suprido).\f*\f + \fr 2.15: \ft Acréscimo: “os” (em “entre si os acusam ou”): preposição ou artigo que a regência do português exige.\f*\x - \xo 2:15 \xt ROM 9:1; ROM 1:20; PRO 20:27; LUK 12:48; ROM 3:19; 2CO 5:11\x*
\v 16 \w no dia|strong="G1722,G2250"\w* \w em que|strong="G3753"\w* \w julga|strong="G2919"\w* \w Deus|strong="G3588,G2316"\w* \w as coisas ocultas|strong="G3588,G2927"\w* \w dos seres humanos|strong="G3588,G444"\w*, \w segundo|strong="G2596"\w* \w a minha|strong="G3165"\w* \w boa notícia|strong="G3588,G2098"\w*, \w por meio de Cristo|strong="G1223,G5547"\w* \w Jesus|strong="G2424"\w*.\x - \xo 2:16 \xt MAT 12:36; ECC 12:14; HEB 4:13; 1CO 4:5; JHN 12:48; 1CO 3:13\x*
\p
\v 17 \w Mas se|strong="G1487,G1161"\w* \w você|strong="G4771"\w* \w se chama|strong="G2028"\w* \w judeu|strong="G2453"\w*, \w e|strong="G2532"\w* \w se apoia|strong="G1879"\w* \w na lei|strong="G3551"\w*, \w e|strong="G2532"\w* \w se gloria|strong="G2744"\w* \w em Deus|strong="G1722,G2316"\w*,\f + \fr 2.17: \ft Variante: o RP traz Ἴδε (“veja”) em lugar de Εἰ δέ (“mas se”) e τῷ νόμῳ (“na lei”, com artigo).\f*\f + \fr 2.17: \ft Lit.: καυχάομαι e família (καύχημα, καύχησις): “gloriar-se”; também “orgulhar-se”, “vangloriar-se”, “gabar-se” e “alegrar-se com confiança”. O sentido vai do positivo (confiança, motivo de alegria) ao negativo (jactância), conforme o contexto.\f*\x - \xo 2:17 \xt ROM 2:23; GAL 6:13; JAS 4:17; ROM 3:19; MAT 6:23; JHN 5:39\x*
\v 18 \w e|strong="G2532"\w* \w conhece|strong="G1097"\w* \w a vontade|strong="G3588,G2307"\w* \w e|strong="G2532"\w* \w aprova|strong="G1381"\w* \w as coisas|strong="G3588"\w* \w que são melhores|strong="G1308"\w*, \w instruído|strong="G2727"\w* \w pela lei|strong="G1537,G3588,G3551"\w*,\f + \fr 2.18: \ft Lit.: Τὰ διαφέροντα: “as coisas melhores, excelentes” ou “as coisas que diferem”, isto é, discernir o que importa.\f*\x - \xo 2:18 \xt PHP 1:10; JAS 4:17; ROM 3:19; MAT 6:23; JHN 5:39; TIT 1:16\x*
\v 19 \w e|strong="G5037"\w* \w está convencido|strong="G3982"\w* \w de ser você mesmo|strong="G4771,G1511"\w* \w guia|strong="G3595"\w* \w de cegos|strong="G5185"\w*, \w luz|strong="G5457"\w* \w dos que estão|strong="G3588,G1722"\w* \w nas trevas|strong="G4655"\w*,\f + \fr 2.19: \ft Acréscimo: verbo ser/estar suprido em “dos que estão”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:19 \xt LUK 11:35; EPH 5:8; MAT 15:14; MAT 5:14; JAS 4:17; MAT 6:23\x*
\v 20 \w educador|strong="G3810"\w* \w de insensatos|strong="G878"\w*, \w mestre|strong="G1320"\w* \w de crianças|strong="G3516"\w*, \w tendo|strong="G2192"\w* \w a forma|strong="G3588,G3446"\w* \w do conhecimento|strong="G3588,G1108"\w* \w e|strong="G2532"\w* \w da verdade|strong="G3588,G225"\w* \w na lei|strong="G1722,G3588,G3551"\w*—\x - \xo 2:20 \xt MAT 5:14; 2TI 3:5; 2TI 3:16; JAS 4:17; JAS 3:1; MAT 6:23\x*
\v 21 \w você, então, que ensina|strong="G3588,G3767,G1321"\w* \w a outro|strong="G2087"\w*: \w não ensina|strong="G3756,G1321"\w* \w a si mesmo|strong="G4771"\w*? \w Você que proclama|strong="G3588,G2784"\w* \w que não se roube|strong="G3361,G2813"\w*, \w rouba|strong="G2813"\w*?\x - \xo 2:21 \xt JHN 10:10; 2TI 3:5; ROM 2:1; JHN 8:7; JAS 4:17; JAS 3:1\x*
\v 22 \w Você que diz|strong="G3588,G3004"\w* \w que não se cometa adultério|strong="G3361,G3431"\w*, \w comete adultério|strong="G3431"\w*? \w Você que detesta|strong="G3588,G948"\w* \w os ídolos|strong="G3588,G1497"\w*, \w saqueia templos|strong="G2416"\w*?\x - \xo 2:22 \xt 2TI 3:5; ROM 2:1; JHN 8:7; JAS 4:17; LUK 6:41; ROM 1:32\x*
\v 23 \w Você que|strong="G3739"\w* \w se gloria|strong="G2744"\w* \w na lei|strong="G1722,G3551"\w*, \w pela transgressão|strong="G1223,G3588,G3847"\w* \w da lei|strong="G3588,G3551"\w* \w desonra|strong="G818"\w* \w a Deus|strong="G3588,G2316"\w*?\x - \xo 2:23 \xt ROM 2:17; 2TI 3:5; ROM 2:1; JHN 8:7; JAS 4:17; LUK 6:41\x*
\v 24 \w Pois|strong="G1063"\w* “\w o nome|strong="G3588,G3686"\w* \w de Deus|strong="G3588,G2316"\w*, \w por causa de vocês|strong="G1223,G4771"\w*, \w é blasfemado|strong="G987"\w* \w entre os gentios|strong="G1722,G3588,G1484"\w*”, \w como|strong="G2531"\w* \w está escrito|strong="G1125"\w*\f + \fr 2.24: \ft Nota cultural: cita Is 52:5 (cf. Ez 36:20-23).\f*.\x - \xo 2:24 \xt EZK 36:20; ISA 52:5; 2TI 3:5; JHN 8:7; 2PE 2:2; LUK 6:41\x*
\v 25 \w Pois|strong="G1063"\w* \w a circuncisão|strong="G4061"\w*, \w de fato|strong="G3303"\w*, \w é útil|strong="G5623"\w* \w se|strong="G1437"\w* \w você pratica|strong="G4238"\w* \w a lei|strong="G3551"\w*; \w mas se|strong="G1437,G1161"\w* \w você é transgressor|strong="G3848,G1510"\w* \w da lei|strong="G3551"\w*, \w a sua|strong="G4771"\w* \w circuncisão|strong="G3588,G4061"\w* \w se torna|strong="G1096"\w* \w incircuncisão|strong="G203"\w*.\x - \xo 2:25 \xt GAL 6:15; ROM 2:27; 1CO 7:19; GAL 5:6; JHN 8:7; GAL 5:3\x*
\v 26 \w Se|strong="G1437"\w*, \w pois|strong="G3767"\w*, \w o incircunciso|strong="G3588,G203"\w* \w guarda|strong="G5442"\w* \w as exigências justas|strong="G3588,G1345"\w* \w da lei|strong="G3588,G3551"\w*, \w não|strong="G3756"\w* \w será a sua|strong="G846"\w* \w incircuncisão|strong="G3588,G203"\w* \w considerada|strong="G3049"\w* \w como circuncisão|strong="G1519,G4061"\w*?\f + \fr 2.26: \ft Acréscimo: verbo ser/estar suprido em “será a sua”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:26 \xt ROM 4:10; ROM 8:4; 1CO 7:19; GAL 5:6; COL 2:11; LUK 6:42\x*
\v 27 \w E|strong="G2532"\w* \w o incircunciso|strong="G3588,G203"\w* \w por natureza|strong="G1537,G5449"\w*, \w que cumpre|strong="G5055"\w* \w a lei|strong="G3588,G3551"\w*, \w julgará|strong="G2919"\w* \w você|strong="G4771"\w*, \w que|strong="G3588"\w*, \w apesar da letra|strong="G1223,G1121"\w* \w e|strong="G2532"\w* \w circuncisão|strong="G4061"\w*, \w é transgressor|strong="G3848"\w* \w da lei|strong="G3551"\w*.\f + \fr 2.27: \ft Acréscimo: verbo ser/estar suprido em “é transgressor”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:27 \xt ROM 2:14; ROM 2:25; ROM 2:29; 1CO 7:19; 2CO 3:6; LUK 6:42\x*
\v 28 \w Pois|strong="G1063"\w* \w judeu|strong="G2453"\w* \w não|strong="G3756"\w* \w é|strong="G1510"\w* \w quem o é|strong="G3588"\w* \w exteriormente|strong="G1722,G3588,G5318"\w*, \w nem|strong="G3761"\w* \w circuncisão|strong="G4061"\w* \w a que é|strong="G3588"\w* \w exterior|strong="G1722,G3588,G5318"\w*, \w na carne|strong="G1722,G4561"\w*;\f + \fr 2.28: \ft Acréscimo: verbo ser/estar suprido em “quem o é”, “a que é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:28 \xt PHP 3:3; ROM 3:1; ISA 45:17; JER 4:4; GAL 6:15; DEU 30:6\x*
\v 29 \w mas|strong="G235"\w* \w o que é judeu|strong="G3588,G2453"\w* \w no que é oculto|strong="G1722,G3588,G2927"\w*, \w e|strong="G2532"\w* \w circuncisão|strong="G4061"\w* \w do coração|strong="G2588"\w*, \w no espírito|strong="G1722,G4151"\w*, \w não|strong="G3756"\w* \w na letra|strong="G1121"\w*; \w cujo|strong="G3739"\w* \w louvor|strong="G3588,G1868"\w* \w não|strong="G3756"\w* \add vem\add* \w dos|strong="G1537"\w* \w seres humanos|strong="G444"\w*, \w mas|strong="G235"\w* \w de Deus|strong="G1537,G3588,G2316"\w*.\f + \fr 2.29: \ft Nota cultural: alude a Dt 30:6 e Jr 4:4 (circuncisão do coração).\f*\f + \fr 2.29: \ft Lit.: Ἐν πνεύματι: “no espírito” (a interioridade da pessoa) ou “no Espírito” (o Espírito Santo), em contraste com γράμμα, “letra”; cf. Rm 7:6 e 2Co 3:6.\f*\f + \fr 2.29: \ft Acréscimo: “vem” (em “louvor não vem dos seres”): verbo acrescentado: o grego traz a frase sem verbo (construção nominal ou elíptica) e o português exige um, tomado do contexto; verbo ser/estar suprido em “o que é judeu”, “no que é oculto”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:29 \xt DEU 30:6; JER 4:4; 2CO 3:6; ROM 7:6; 1CO 4:5; ROM 2:27\x*
\c 3
\p
\v 1 \w Qual, então, é|strong="G5101,G3767"\w* \w a vantagem|strong="G3588,G4053"\w* \w do judeu|strong="G3588,G2453"\w*, \w ou|strong="G2228"\w* \w qual|strong="G5101"\w* \w a utilidade|strong="G3588,G5622"\w* \w da circuncisão|strong="G3588,G4061"\w*?\f + \fr 3.1: \ft Acréscimo: verbo ser/estar suprido em “Qual, então, é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:1 \xt JHN 6:63; JHN 4:22; ISA 40:8; LUK 7:9; PSA 147:20; GAL 3:19\x*
\v 2 \w Muita|strong="G4183"\w*, \w em todos os sentidos|strong="G2596,G3956,G5158"\w*. \w Primeiro|strong="G4413,G3303"\w*, \w porque|strong="G1063,G3754"\w* \w lhes foram confiados|strong="G4100"\w* \w os oráculos|strong="G3588,G3051"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 3.2: \ft Tradução: ἐπιστεύθησαν (πιστεύω, G4100) está aqui como “lhes foram confiados”; o termo pode ser “crer”, “acreditar”, “confiar” ou, na passiva, “ser confiado a alguém”, e o contexto decide.\f*\x - \xo 3:2 \xt 2TI 3:16; JHN 5:39; JHN 6:63; ROM 1:2; JHN 4:22; 1PE 4:11\x*
\v 3 \w Que importa|strong="G5101,G1063"\w*? \w Se|strong="G1487"\w* \w alguns|strong="G5100"\w* \w foram infiéis|strong="G569"\w*, \w acaso|strong="G3361"\w* \w a infidelidade|strong="G3588,G570"\w* \w deles|strong="G846"\w* \w anulará|strong="G2673"\w* \w a fidelidade|strong="G3588,G4102"\w* \w de Deus|strong="G3588,G2316"\w*\f + \fr 3.3: \ft Lit.: πίστις τοῦ θεοῦ, “fidelidade de Deus”; ἀπιστέω, “ser infiel” (ou “não crer”).\f*?\x - \xo 3:3 \xt 2TI 2:13; ROM 1:17; HEB 4:2; ROM 9:6; ISA 40:8; 2KI 7:2\x*
\v 4 \w De modo nenhum|strong="G3361,G1096"\w*! \w Seja|strong="G1096"\w* \w Deus|strong="G3588,G2316"\w* \w verdadeiro|strong="G227"\w*, \w e|strong="G1161"\w* \w todo|strong="G3956"\w* \w ser humano|strong="G444"\w* \w mentiroso|strong="G5583"\w*, \w como|strong="G2531"\w* \w está escrito|strong="G1125"\w*: “\w para que|strong="G3704,G302"\w* \w seja declarado justo|strong="G1344"\w* \w nas suas|strong="G1722,G3588,G4771"\w* \w palavras|strong="G3056"\w*, \w e|strong="G2532"\w* \w vença|strong="G3528"\w* \w quando|strong="G1722,G3588"\w* \w for julgado|strong="G2919,G4771"\w*\f + \fr 3.4: \ft Nota cultural: cita Sl 51:6 (50:6 na LXX).\f*.”\x - \xo 3:4 \xt PSA 51:6; PSA 51:4; PSA 116:11; GAL 2:17; HEB 6:18; DEU 32:4\x*
\v 5 \w Mas se|strong="G1487,G1161"\w* \w a nossa|strong="G3165"\w* \w injustiça|strong="G3588,G93"\w* \w demonstra|strong="G4921"\w* \w a justiça|strong="G1343"\w* \w de Deus|strong="G2316"\w*, \w o que|strong="G5101"\w* \w diremos|strong="G4483"\w*? \w Será|strong="G3361"\w* \w injusto|strong="G94"\w* \w Deus|strong="G3588,G2316"\w*, \w que traz|strong="G3588,G2018"\w* \w a ira|strong="G3588,G3709"\w*? \w Falo|strong="G3004"\w* \w como ser humano|strong="G2596,G444"\w*.\f + \fr 3.5: \ft Acréscimo: verbo ser/estar suprido em “Será”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:5 \xt ROM 9:14; ROM 6:1; ROM 5:8; ROM 6:19; GAL 3:15; HEB 6:10\x*
\v 6 \w De modo nenhum|strong="G3361,G1096"\w*! \w Caso contrário|strong="G1893"\w*, \w como|strong="G4459"\w* \w julgará|strong="G2919"\w* \w Deus|strong="G3588,G2316"\w* \w o mundo|strong="G3588,G2889"\w*?\x - \xo 3:6 \xt LUK 1:34; MRK 16:16; ROM 6:1; GEN 18:25; ACT 17:31; GAL 6:14\x*
\v 7 \w Mas se|strong="G1487,G1161"\w* \w a verdade|strong="G3588,G225"\w* \w de Deus|strong="G3588,G2316"\w*, \w pela minha|strong="G1722,G3588,G1473"\w* \w mentira|strong="G5582"\w*, \w abundou|strong="G4052"\w* \w para a glória|strong="G1519,G3588,G1391"\w* \w dele|strong="G846"\w*, \w por que|strong="G5101"\w* \w eu também|strong="G2532,G1473"\w* \w ainda|strong="G2089"\w* \w sou julgado|strong="G2919"\w* \w como pecador|strong="G5613,G268"\w*?\x - \xo 3:7 \xt ROM 6:1; ROM 3:4; GEN 27:24; JOB 34:17; JOB 4:17; ROM 9:19\x*
\v 8 \w E|strong="G2532"\w* \w por que não|strong="G3361"\w* \add dizer,\add* \w como|strong="G2531"\w* \w somos caluniados|strong="G987"\w*, \w e|strong="G2532"\w* \w como|strong="G2531"\w* \w dizem|strong="G5346"\w* \w alguns|strong="G5100"\w* \w que nós|strong="G3165"\w* \w dizemos|strong="G3004"\w*: “\w Façamos|strong="G4160"\w* \w o mal|strong="G3588,G2556"\w*, \w para que venha|strong="G2443,G2064"\w* \w o bem|strong="G3588,G18"\w*”? \w Cuja|strong="G3739"\w* \w condenação|strong="G3588,G2917"\w* \w é justa|strong="G1738,G1510"\w*.\f + \fr 3.8: \ft Acréscimo: “dizer” (em “que não dizer como somos”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 3:8 \xt ROM 6:1; ROM 6:15; EXO 23:1; GEN 19:13; GEN 19:8; GEN 27:24\x*
\v 9 \w O que|strong="G5101"\w*, \w então|strong="G3767"\w*? \w Temos vantagem|strong="G4284"\w*? \w De modo algum|strong="G3756,G3843"\w*! \w Pois|strong="G1063"\w* \w já acusamos antes|strong="G4256"\w* \w tanto judeus|strong="G2453,G5037"\w* \w como gregos|strong="G2532,G1672"\w* \w de estarem todos|strong="G3956,G1511"\w* \w sob o pecado|strong="G5259,G266"\w*,\x - \xo 3:9 \xt ROM 3:23; GEN 6:5; ROM 3:19; GAL 3:22; MAT 7:13; ROM 11:32\x*
\q1
\v 10 \w como|strong="G2531"\w* \w está escrito|strong="G1125"\w*: “\w Não|strong="G3756"\w* \w há|strong="G1510"\w* \w justo|strong="G1342"\w*, \w nem sequer|strong="G3761"\w* \w um|strong="G1520"\w*\f + \fr 3.10: \ft Nota cultural: os vv. 10-18 reúnem trechos de Sl 14:1-3 (53:1-3), Sl 5:9, Sl 140:3, Is 59:7-8, Sl 10:7 e Sl 36:1, na forma da LXX (numeração em português; no hebraico, 53:2-4, 5:10, 140:4 e 36:2).\f*;\x - \xo 3:10 \xt PSA 14:1; ISA 59:7-8; PSA 10:7; PSA 140:3; PSA 36:1; PSA 5:9\x*
\q1
\v 11 \w não|strong="G3756"\w* \w há|strong="G1510"\w* \w quem entenda|strong="G3588,G4920"\w*; \w não|strong="G3756"\w* \w há|strong="G1510"\w* \w quem busque|strong="G3588,G1567"\w* \w Deus|strong="G3588,G2316"\w*;\x - \xo 3:11 \xt PSA 14:3; MAT 9:13; PSA 14:2; MAT 7:7; PSA 53:2; ISA 53:6\x*
\q1
\v 12 \w todos|strong="G3956"\w* \w se desviaram|strong="G1578"\w*, \w juntos|strong="G260"\w* \w se tornaram inúteis|strong="G889"\w*; \w não|strong="G3756"\w* \w há|strong="G1510"\w* \w quem pratique|strong="G4160"\w* \w bondade|strong="G5544"\w*, \w não|strong="G3756"\w* \w há|strong="G1510"\w* \w nem|strong="G2193"\w* \w um|strong="G1520"\w*.\x - \xo 3:12 \xt PSA 14:3; MAT 9:13; ISA 53:6; PSA 14:1; GEN 6:5; ECC 7:20\x*
\q1
\v 13 \w Sepulcro|strong="G5028"\w* \w aberto|strong="G455"\w* \w é a garganta|strong="G3588,G2995"\w* \w deles|strong="G846"\w*; \w com as suas|strong="G3588,G846"\w* \w línguas|strong="G1100"\w* \w enganam|strong="G1387"\w*; \w veneno|strong="G2447"\w* \w de áspides|strong="G785"\w* \w sob os seus|strong="G5259,G3588,G846"\w* \w lábios|strong="G5491"\w*;\f + \fr 3.13: \ft Acréscimo: verbo ser/estar suprido em “é a garganta”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:13 \xt JAS 3:8; MAT 9:13; PSA 5:9; PSA 140:3; ISA 53:6; LUK 6:45\x*
\q1
\v 14 \w cuja|strong="G3739"\w* \w boca|strong="G3588,G4750"\w* \w está cheia|strong="G1073"\w* \w de maldição|strong="G685"\w* \w e|strong="G2532"\w* \w amargura|strong="G4088"\w*;\x - \xo 3:14 \xt MAT 9:13; ISA 53:6; PSA 10:7; LUK 6:45; EPH 4:29; GEN 6:5\x*
\q1
\v 15 \w velozes|strong="G3691"\w* \w os seus|strong="G846"\w* \w pés|strong="G3588,G4228"\w* \w para derramar|strong="G1632"\w* \w sangue|strong="G129"\w*;\x - \xo 3:15 \xt MAT 9:13; ISA 53:6; ISA 59:7; PRO 1:16; GEN 6:5; MAT 7:13\x*
\q1
\v 16 \w ruína|strong="G4938"\w* \w e|strong="G2532"\w* \w miséria|strong="G5004"\w* \w nos seus|strong="G1722,G3588,G846"\w* \w caminhos|strong="G3598"\w*;\x - \xo 3:16 \xt MAT 9:13; ISA 53:6; GEN 6:5; MAT 7:13; MAT 15:19; ISA 59:7\x*
\q1
\v 17 \w e|strong="G2532"\w* \w o caminho|strong="G3598"\w* \w da paz|strong="G1515"\w* \w não|strong="G3756"\w* \w conheceram|strong="G1097"\w*;\x - \xo 3:17 \xt LUK 1:79; MAT 9:13; ISA 53:6; ISA 59:8; GEN 6:5; MAT 7:13\x*
\q1
\v 18 \w não|strong="G3756"\w* \w há|strong="G1510"\w* \w temor|strong="G5401"\w* \w de Deus|strong="G2316"\w* \w diante dos seus|strong="G561,G3588,G846"\w* \w olhos|strong="G3788"\w*.”\x - \xo 3:18 \xt MAT 9:13; ISA 53:6; PSA 36:1; GEN 6:5; MAT 7:13; MAT 15:19\x*
\v 19 \w E sabemos|strong="G6063,G1161"\w* \w que|strong="G3754"\w* \w tudo o que|strong="G3745"\w* \w a lei|strong="G3588,G3551"\w* \w diz|strong="G3004"\w*, \w diz|strong="G2980"\w* \w aos que estão|strong="G3588"\w* \w na lei|strong="G1722,G3588,G3551"\w*, \w para que|strong="G2443"\w* \w toda|strong="G3956"\w* \w boca|strong="G4750"\w* \w seja calada|strong="G5420"\w* \w e|strong="G2532"\w* \w todo|strong="G3956"\w* \w o mundo|strong="G3588,G2889"\w* \w se torne|strong="G1096"\w* \w sujeito a julgamento|strong="G5267"\w* \w diante de Deus|strong="G3588,G2316"\w*;\f + \fr 3.19: \ft Acréscimo: verbo ser/estar suprido em “aos que estão”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:19 \xt MAT 9:13; ROM 3:23; GAL 3:10; JHN 1:17; ISA 53:6; ROM 6:14\x*
\v 20 \w porque|strong="G1360"\w* \w por obras|strong="G1537,G2041"\w* \w da lei|strong="G3551"\w* \w não|strong="G3756"\w* \w será declarada justa|strong="G1344"\w* \w nenhuma|strong="G3956"\w* \w carne|strong="G4561"\w* \w diante dele|strong="G1799,G846"\w*; \w pois|strong="G1063"\w* \w pela lei|strong="G1223,G3551"\w* \w vem o conhecimento|strong="G1922"\w* \w do pecado|strong="G266"\w*.\f + \fr 3.20: \ft Nota cultural: ecoa Sl 143:2; “nenhuma carne”, isto é, nenhum ser humano.\f*\x - \xo 3:20 \xt PSA 143:2; GAL 2:16; ROM 3:28; ROM 4:2; MAT 9:13; 1JN 3:4\x*
\p
\v 21 \w Mas agora|strong="G3570,G1161"\w*, \w sem a lei|strong="G5565,G3551"\w*, \w a justiça|strong="G1343"\w* \w de Deus|strong="G2316"\w* \w foi manifestada|strong="G5319"\w*, \w testemunhada|strong="G3140"\w* \w pela lei|strong="G5259,G3588,G3551"\w* \w e|strong="G2532"\w* \w pelos profetas|strong="G3588,G4396"\w*,\f + \fr 3.21: \ft Tradução: δικαιοσύνη θεοῦ, “justiça de Deus”: pode ser a justiça que Deus tem, a que ele dá ou a que ele faz valer; a tradução mantém o genitivo (ver as notas de 3:22-26). πεφανέρωται, “foi manifestada”: perfeito, o resultado dura até agora.\f*\x - \xo 3:21 \xt PHP 3:9; MAT 6:33; 2CO 5:21; MAT 9:13; ROM 1:17; JHN 1:17\x*
\v 22 \w a justiça|strong="G1343,G1161"\w* \w de Deus|strong="G2316"\w* \w mediante a fé|strong="G1223,G4102"\w* \w em Jesus Cristo|strong="G2424,G5547"\w*, \w para todos|strong="G1519,G3956"\w* \w os que creem|strong="G3588,G4100"\w*; \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w há|strong="G1510"\w* \w distinção|strong="G1293"\w*,\f + \fr 3.22: \ft Lit.: πίστις Ἰησοῦ Χριστοῦ: genitivo ambíguo; “fé em Jesus Cristo” (genitivo objetivo, leitura adotada aqui) ou “fidelidade de Jesus Cristo” (genitivo subjetivo).\f*\f + \fr 3.22: \ft Variante: o RP e o TR trazem καὶ ἐπὶ πάντας (“e sobre todos”) em lugar de “para todos”.\f*\x - \xo 3:22 \xt EPH 2:8; ROM 4:5; PHP 3:9; ROM 10:4; GAL 3:6; MAT 6:33\x*
\v 23 \w pois|strong="G1063"\w* \w todos|strong="G3956"\w* \w pecaram|strong="G264"\w* \w e|strong="G2532"\w* \w estão aquém|strong="G5302"\w* \w da glória|strong="G3588,G1391"\w* \w de Deus|strong="G3588,G2316"\w*,\f + \fr 3.23: \ft Tradução: ὑστεροῦνται, “estão aquém, lhes falta, não alcançam”; τῆς δόξης τοῦ θεοῦ, “da glória de Deus”, pode ser a glória que vem de Deus, a que lhe pertence ou a que ele aprova; a tradução mantém o genitivo.\f*\x - \xo 3:23 \xt 1JN 1:8; ECC 7:20; EPH 2:8; PSA 14:3; ROM 3:9; GAL 3:22\x*
\v 24 \w sendo declarados justos|strong="G1344"\w* \w gratuitamente|strong="G1432"\w* \w pela sua|strong="G3588,G846"\w* \w graça|strong="G5485"\w*, \w mediante a redenção|strong="G1223,G3588,G629"\w* \w que há|strong="G3588,G1722"\w* \w em Cristo|strong="G5547"\w* \w Jesus|strong="G2424"\w*;\f + \fr 3.24: \ft Lit.: ἀπολύτρωσις, “redenção, libertação mediante resgate”.\f*\f + \fr 3.24: \ft Acréscimo: “que há”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 3:24 \xt EPH 1:7; EPH 2:8; TIT 3:7; ISA 53:5; 1PE 1:18-19; COL 1:14\x*
\v 25 \w a quem|strong="G3739"\w* \w Deus|strong="G3588,G2316"\w* \w propôs|strong="G4388"\w* \w como propiciatório|strong="G2435"\w*, \w mediante a fé|strong="G1223,G4102"\w*, \w no seu|strong="G1722,G3588,G846"\w* \w sangue|strong="G129"\w*, \w para demonstração|strong="G1519,G1732"\w* \w da justiça|strong="G3588,G1343"\w* \w dele|strong="G846"\w*, \w por ter deixado passar|strong="G1223,G3588,G3929"\w* \w os pecados|strong="G3588,G265"\w* \w anteriormente cometidos|strong="G4266"\w*\f + \fr 3.25: \ft Lit.: ἱλαστήριον, “propiciatório” (a tampa da arca, lugar da expiação, Lv 16) ou “meio de expiação”; o sentido preciso é discutido. πάρεσις, “deixar passar, indulgência”.\f*\x - \xo 3:25 \xt EPH 2:8; ISA 53:5; COL 1:14; LEV 17:11; 2CO 5:21; ROM 3:23-24\x*
\v 26 \w na tolerância|strong="G1722,G3588,G463"\w* \w de Deus|strong="G3588,G2316"\w*, \w para a demonstração|strong="G4314,G3588,G1732"\w* \w da sua|strong="G846"\w* \w justiça|strong="G3588,G1343"\w* \w no tempo presente|strong="G1722,G3588,G3568,G2540"\w*, \w para que ele seja|strong="G1519,G3588,G1511,G846"\w* \w justo|strong="G1342"\w* \w e|strong="G2532"\w* \w declare justo|strong="G1344"\w* \w aquele que|strong="G3588"\w* \w tem fé|strong="G1537,G4102"\w* \w em Jesus|strong="G2424"\w*.\f + \fr 3.26: \ft Tradução: ἐν τῇ ἀνοχῇ, “na tolerância”, pode ligar-se ao v. 25 (os pecados passados) ou ao v. 26; δίκαιον καὶ δικαιοῦντα, “justo e que declara justo”: mantém-se o jogo de palavras da raiz δικ-; τὸν ἐκ πίστεως Ἰησοῦ, “aquele que tem fé em Jesus”: genitivo ambíguo (ver a nota de 3:22), aqui lido como “fé em Jesus”.\f*\x - \xo 3:26 \xt EPH 2:8; ROM 5:1; ISA 53:5; 2CO 5:21; HEB 9:15; EPH 1:6\x*
\v 27 \w Onde está|strong="G4226"\w*, \w então|strong="G3767"\w*, \w o gloriar-se|strong="G3588,G2746"\w*? \w Foi excluído|strong="G1576"\w*. \w Por qual|strong="G1223,G4169"\w* \w lei|strong="G3551"\w*? \w A das obras|strong="G3588,G2041"\w*? \w Não|strong="G3780"\w*, \w mas|strong="G235"\w* \w pela lei|strong="G1223,G3551"\w* \w da fé|strong="G4102"\w*.\f + \fr 3.27: \ft Acréscimo: “Onde está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 3:27 \xt GAL 2:16; EPH 2:13; ROM 8:2; EPH 2:9; ROM 2:23; ROM 4:2\x*
\v 28 \w Pois|strong="G1063"\w* \w concluímos|strong="G3049"\w* \w que o ser humano|strong="G444"\w* \w é declarado justo|strong="G1344"\w* \w pela fé|strong="G4102"\w*, \w sem|strong="G5565"\w* \w obras|strong="G2041"\w* \w da lei|strong="G3551"\w*.\f + \fr 3.28: \ft Tradução: λογιζόμεθα (λογίζομαι, G3049) está aqui como “concluímos”; o termo pode ser “considerar”, “contar”, “atribuir”, “calcular” ou “raciocinar”, e o contexto decide.\f*\x - \xo 3:28 \xt GAL 2:16; ROM 3:20; JAS 2:24; GAL 3:24; ROM 4:5; ROM 5:1\x*
\v 29 \w Ou|strong="G2228"\w* \w Deus|strong="G3588,G2316"\w* \w é só|strong="G3441"\w* \w dos judeus|strong="G2453"\w*? \w Não|strong="G3780"\w* \add é\add* \w também|strong="G2532"\w* \w dos gentios|strong="G1484"\w*? \w Sim|strong="G3483"\w*, \w também|strong="G2532"\w* \w dos gentios|strong="G1484"\w*,\f + \fr 3.29: \ft Acréscimo: “é” (em “judeus Não é também dos”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige; verbo ser/estar suprido em “é só”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:29 \xt ROM 9:24; GAL 3:28; HOS 2:23; JER 32:27; 1TI 2:5; COL 3:11\x*
\v 30 \w já que|strong="G1512"\w* \w Deus é um só|strong="G1520,G3588,G2316"\w*, \w que|strong="G3739"\w* \w declarará justa|strong="G1344"\w* \w a circuncisão|strong="G4061"\w* \w pela fé|strong="G1537,G4102"\w* \w e|strong="G2532"\w* \w a incircuncisão|strong="G203"\w* \w mediante a fé|strong="G1223,G3588,G4102"\w*.\f + \fr 3.30: \ft Acréscimo: verbo ser/estar suprido em “Deus é um só”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:30 \xt GAL 5:6; ROM 5:1; ROM 4:11; GAL 6:15; GAL 2:16; ROM 4:10\x*
\v 31 \w A lei|strong="G3551"\w*, \w então|strong="G3767"\w*, \w anulamos|strong="G2673"\w* \w por meio da fé|strong="G1223,G3588,G4102"\w*? \w De modo nenhum|strong="G3361,G1096"\w*! \w Ao contrário|strong="G235"\w*, \w confirmamos|strong="G2476"\w* \w a lei|strong="G3551"\w*.\f + \fr 3.31: \ft Tradução: μὴ γένοιτο, literalmente “que não aconteça”: fórmula enfática de rejeição, vertida “De modo nenhum!”.\f*\x - \xo 3:31 \xt ROM 4:14; GAL 3:17; MAT 5:17; GAL 2:21; ROM 10:4; 1CO 9:21\x*
\c 4
\p
\v 1 \w O que|strong="G5101"\w*, \w então|strong="G3767"\w*, \w diremos|strong="G4483"\w* \w que achou|strong="G2147"\w* \w Abraão|strong="G11"\w*, \w nosso|strong="G3165"\w* \w antepassado|strong="G3588,G6074"\w* \w segundo a carne|strong="G2596,G4561"\w*?\f + \fr 4.1: \ft Variante: o SBLGNT traz εὑρηκέναι (“que achou”), como Treg e NA28; WH e o RP o omitem ou o deslocam, e o RP traz πατέρα (“pai”) em lugar de προπάτορα (“antepassado”).\f*\x - \xo 4:1 \xt ROM 8:31; JER 6:16; ISA 51:2; ROM 4:16; MAT 3:9; ROM 3:25\x*
\v 2 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w* \w Abraão|strong="G11"\w* \w foi declarado justo|strong="G1344"\w* \w por obras|strong="G1537,G2041"\w*, \w tem|strong="G2192"\w* \w motivo de glória|strong="G2745"\w*, \w mas|strong="G235"\w* \w não|strong="G3756"\w* \w diante de Deus|strong="G4314,G2316"\w*.\x - \xo 4:2 \xt GAL 2:16; ROM 3:20; JER 6:16; EPH 2:9; 1CO 1:31; ROM 3:27\x*
\v 3 \w Pois|strong="G1063"\w* \w o que|strong="G5101"\w* \w a Escritura|strong="G3588,G1124"\w* \w diz|strong="G3004"\w*? “\w E Abraão|strong="G1161,G11"\w* \w creu|strong="G4100"\w* \w em Deus|strong="G3588,G2316"\w*, \w e|strong="G2532"\w* \w isso lhe foi atribuído|strong="G3049,G846"\w* \w como justiça|strong="G1519,G1343"\w*.”\f + \fr 4.3: \ft Nota cultural: cita Gn 15:6.\f*\x - \xo 4:3 \xt GEN 15:6; JAS 2:23; GAL 3:6; ROM 4:22; ROM 4:9; ROM 4:5\x*
\v 4 \w Mas ao que|strong="G3588,G1161"\w* \w trabalha|strong="G2038"\w*, \w o salário|strong="G3588,G3408"\w* \w não|strong="G3756"\w* \w é atribuído|strong="G3049"\w* \w como graça|strong="G2596,G5485"\w*, \w mas|strong="G235"\w* \w como dívida|strong="G2596,G3783"\w*;\x - \xo 4:4 \xt GEN 15:6; 2CH 15:7; JER 6:16; GAL 5:4; GAL 3:6; JHN 6:29\x*
\v 5 \w mas ao que não|strong="G3588,G1161,G3361"\w* \w trabalha|strong="G2038"\w*, \w e que crê|strong="G4100,G1161"\w* \w naquele que declara justo|strong="G1909,G3588,G1344"\w* \w o ímpio|strong="G3588,G765"\w*, \w a sua|strong="G846"\w* \w fé|strong="G3588,G4102"\w* \w é atribuída|strong="G3049"\w* \w como justiça|strong="G1519,G1343"\w*;\x - \xo 4:5 \xt GAL 3:6; ACT 13:39; ROM 5:1; ROM 4:3; PHP 3:9; ROM 3:28\x*
\v 6 \w como|strong="G2509"\w* \w também|strong="G2532"\w* \w Davi|strong="G1138"\w* \w fala|strong="G3004"\w* \w da felicidade|strong="G3588,G3108"\w* \w do ser humano|strong="G3588,G444"\w* \w a quem|strong="G3739"\w* \w Deus|strong="G3588,G2316"\w* \w atribui|strong="G3049"\w* \w justiça|strong="G1343"\w* \w sem|strong="G5565"\w* \w obras|strong="G2041"\w*:\f + \fr 4.6: \ft Lit.: μακαρισμός, “declaração de felicidade, bem-aventurança”.\f*\x - \xo 4:6 \xt ROM 4:9; ROM 4:22; GAL 3:6; PSA 32:1; GEN 15:6; PHP 3:9\x*
\q1
\v 7 “\w Felizes|strong="G3107"\w* \w aqueles cujas|strong="G3739"\w* \w iniquidades|strong="G3588,G458"\w* \w foram perdoadas|strong="G863"\w* \w e|strong="G2532"\w* \w cujos|strong="G3739"\w* \w pecados|strong="G3588,G266"\w* \w foram cobertos|strong="G1943"\w*;\f + \fr 4.7: \ft Nota cultural: cita Sl 32:1-2 (31:1-2 na LXX).\f*\x - \xo 4:7 \xt PSA 32:1; 1JN 3:4; ROM 8:1; LUK 7:48; HEB 10:17; 1JN 2:12\x*
\q1
\v 8 \w feliz|strong="G3107"\w* \w o homem|strong="G435"\w* \w a quem|strong="G3739"\w* \w o Senhor|strong="G2962"\w* \w de modo algum|strong="G3756,G3361"\w* \w atribuirá|strong="G3049"\w* \w pecado|strong="G266"\w*.”\x - \xo 4:8 \xt ROM 8:1; PSA 32:1; MAT 5:3; PSA 32:2; 2CO 5:19; 1PE 2:24\x*
\v 9 \w Esta felicidade|strong="G3588,G3108,G3778"\w*, \w então|strong="G3767"\w*, \w é para a circuncisão|strong="G1909,G3588,G4061"\w* \w ou|strong="G2228"\w* \w também|strong="G2532"\w* \w para a incircuncisão|strong="G1909,G3588,G203"\w*? \w Pois|strong="G1063"\w* \w dizemos|strong="G3004"\w*: “\w Foi atribuída|strong="G3049"\w* \w a Abraão|strong="G3588,G11"\w* \w a fé|strong="G3588,G4102"\w* \w como justiça|strong="G1519,G1343"\w*.”\f + \fr 4.9: \ft Acréscimo: verbo ser/estar suprido em “é para a circuncisão”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:9 \xt ROM 4:3; GAL 3:6; ROM 4:6; ROM 4:11; GEN 15:6; MAT 5:3\x*
\v 10 \w Como|strong="G4459"\w*, \w então|strong="G3767"\w*, \w foi atribuída|strong="G3049"\w*? \w Quando estava|strong="G1510"\w* \w na circuncisão|strong="G1722,G4061"\w* \w ou|strong="G2228"\w* \w na incircuncisão|strong="G1722,G203"\w*? \w Não|strong="G3756"\w* \w na circuncisão|strong="G1722,G4061"\w*, \w mas|strong="G235"\w* \w na incircuncisão|strong="G1722,G203"\w*;\x - \xo 4:10 \xt GAL 6:15; GAL 5:6; ROM 2:26; COL 3:11; ROM 3:30; ACT 15:1\x*
\v 11 \w e|strong="G2532"\w* \w recebeu|strong="G2983"\w* \w o sinal|strong="G4592"\w* \w da circuncisão|strong="G4061"\w*, \w selo|strong="G4973"\w* \w da justiça|strong="G3588,G1343"\w* \w da fé|strong="G3588,G4102"\w* \w que teve|strong="G3588"\w* \w na incircuncisão|strong="G1722,G3588,G203"\w*, \w para ser|strong="G1519,G3588,G1511"\w* \w ele|strong="G846"\w* \w pai|strong="G3962"\w* \w de todos|strong="G3956"\w* \w os que creem|strong="G3588,G4100"\w* \w sendo incircuncisos|strong="G1223,G203"\w*, \w para que lhes fosse atribuída|strong="G1519,G3588,G3049,G846"\w* \w a justiça|strong="G3588,G1343"\w*,\f + \fr 4.11: \ft Acréscimo: verbo ser/estar suprido em “sendo incircuncisos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:11 \xt GAL 3:6; ROM 3:30; ROM 4:3; ROM 4:9; JAS 2:23; GEN 15:6\x*
\v 12 \w e|strong="G2532"\w* \w pai|strong="G3962"\w* \w da circuncisão|strong="G4061"\w* \w para os que|strong="G3588"\w* \w não|strong="G3756"\w* \w são da circuncisão|strong="G1537,G4061"\w* \w somente|strong="G3441"\w*, \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w para os que|strong="G3588"\w* \w seguem|strong="G4748"\w* \w as pegadas|strong="G3588,G2487"\w* \w da fé|strong="G3588,G4102"\w* \w do nosso pai|strong="G3588,G3962,G3165"\w* \w Abraão|strong="G11"\w* \w na incircuncisão|strong="G1722,G203"\w*.\f + \fr 4.12: \ft Acréscimo: verbo ser/estar suprido em “são da circuncisão”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:12 \xt ROM 3:30; JER 6:16; ROM 9:8; GAL 3:28; LUK 19:9; ACT 15:1\x*
\v 13 \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w pela lei|strong="G1223,G3551"\w* \w foi a promessa|strong="G3588,G1860"\w* \w a Abraão|strong="G3588,G11"\w* \w ou|strong="G2228"\w* \w à sua|strong="G846"\w* \w descendência|strong="G3588,G4690"\w*, \w de que|strong="G3588"\w* \w ele|strong="G846"\w* \w seria|strong="G1511"\w* \w herdeiro|strong="G2818"\w* \w do mundo|strong="G2889"\w*, \w mas|strong="G235"\w* \w pela justiça|strong="G1223,G1343"\w* \w da fé|strong="G4102"\w*.\f + \fr 4.13: \ft Acréscimo: verbo ser/estar suprido em “foi a promessa”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:13 \xt GAL 3:29; GAL 3:16; PHP 3:9; ROM 9:8; ROM 4:16; GAL 3:14\x*
\v 14 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w* \w os da lei|strong="G3588,G1537,G3551"\w* \add são\add* \w herdeiros|strong="G2818"\w*, \w foi esvaziada|strong="G2758"\w* \w a fé|strong="G3588,G4102"\w* \w e|strong="G2532"\w* \w anulada|strong="G2673"\w* \w a promessa|strong="G3588,G1860"\w*;\f + \fr 4.14: \ft Acréscimo: “são” (em “da lei são herdeiros foi”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 4:14 \xt ROM 3:31; GAL 3:29; GAL 3:17; GAL 3:12; PHP 3:9; ROM 9:8\x*
\v 15 \w pois|strong="G1063"\w* \w a lei|strong="G3588,G3551"\w* \w produz|strong="G2716"\w* \w ira|strong="G3709"\w*; \w mas onde|strong="G3757,G1161"\w* \w não|strong="G3756"\w* \w há|strong="G1510"\w* \w lei|strong="G3551"\w*, \w nem|strong="G3761"\w* \w transgressão|strong="G3847"\w*.\x - \xo 4:15 \xt 1JN 3:4; ROM 5:13; GAL 3:10; PHP 3:9; 1CO 15:56; ROM 3:20\x*
\v 16 \w Por isso|strong="G1223,G3778"\w* \w é pela fé|strong="G1537,G4102"\w*, \w para que|strong="G2443"\w* \w seja segundo a graça|strong="G2596,G5485"\w*, \w de modo que|strong="G1519,G3588"\w* \w a promessa|strong="G3588,G1860"\w* \w seja firme|strong="G1511,G949"\w* \w para toda|strong="G3956"\w* \w a descendência|strong="G3588,G4690"\w*, \w não|strong="G3756"\w* \w somente|strong="G3441"\w* \w para a que|strong="G3588"\w* \w é da lei|strong="G1537,G3588,G3551"\w*, \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w para a que|strong="G3588"\w* \w é da fé|strong="G1537,G4102"\w* \w de Abraão|strong="G11"\w*, \w que|strong="G3739"\w* \w é|strong="G1510"\w* \w pai|strong="G3962"\w* \w de todos|strong="G3956"\w* \w nós|strong="G3165"\w*—\f + \fr 4.16: \ft Acréscimo: verbo ser/estar suprido em “é pela fé”, “seja segundo a graça”, “é da lei”, “é da fé”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:16 \xt EPH 2:8; GAL 3:16; GAL 3:29; ROM 9:8; ROM 4:13; GAL 3:14\x*
\v 17 \w como|strong="G2531"\w* \w está escrito|strong="G1125"\w*: “\w Pai|strong="G3962"\w* \w de muitas|strong="G4183"\w* \w nações|strong="G1484"\w* \w eu o constituí|strong="G5087,G4771"\w*” — \w diante de Deus|strong="G2713,G2316"\w*, \w em quem|strong="G3739"\w* \w creu|strong="G4100"\w*, \w que dá vida|strong="G3588,G2227"\w* \w aos mortos|strong="G3588,G3498"\w* \w e|strong="G2532"\w* \w chama|strong="G2564"\w* \w as coisas que não são|strong="G3588,G3361,G1510"\w* \w como se fossem|strong="G5613,G1510"\w*\f + \fr 4.17: \ft Nota cultural: cita Gn 17:5.\f*.\x - \xo 4:17 \xt GEN 17:5; JHN 5:21; 1CO 1:28; GEN 17:4; ROM 8:29-30; JHN 11:40\x*
\v 18 \w O qual|strong="G3739"\w*, \w contra a esperança|strong="G3844,G1680"\w*, \w em esperança|strong="G1909,G1680"\w* \w creu|strong="G4100"\w*, \w para que ele|strong="G1519,G3588,G846"\w* \w se tornasse|strong="G1096"\w* \w pai|strong="G3962"\w* \w de muitas|strong="G4183"\w* \w nações|strong="G1484"\w*, \w conforme|strong="G2596"\w* \w o que foi dito|strong="G3588,G2046"\w*: “\w Assim|strong="G3779"\w* \w será|strong="G1510"\w* \w a sua|strong="G4771"\w* \w descendência|strong="G3588,G4690"\w*.”\f + \fr 4.18: \ft Nota cultural: cita Gn 15:5.\f*\x - \xo 4:18 \xt GEN 15:5; ISA 26:3; MRK 11:23; JHN 11:40; GEN 21:1; MRK 5:36\x*
\v 19 \w e|strong="G2532"\w*, \w sem se enfraquecer|strong="G3361,G770"\w* \w na fé|strong="G3588,G4102"\w*, \w considerou|strong="G2657"\w* \w o seu próprio|strong="G3588,G1438"\w* \w corpo|strong="G4983"\w* \w já sem vida|strong="G3499"\w*, \w com cerca de cem anos|strong="G1541,G4225,G5225"\w*, \w e|strong="G2532"\w* \w a falta de vida|strong="G3588,G3500"\w* \w do ventre|strong="G3588,G3388"\w* \w de Sara|strong="G4564"\w*,\f + \fr 4.19: \ft Variante: o RP e o TR acrescentam οὐ (“não”) depois de “fé”, de modo que a frase ficaria “não considerou o seu corpo já sem vida”; o SBLGNT traz σῶμα sem ἤδη (“já”), seguindo Holmes e WH à margem, enquanto WH, Treg, NA28 e o RP trazem ἤδη.\f*\x - \xo 4:19 \xt ISA 26:3; MRK 11:23; JHN 11:40; GEN 21:1; MRK 5:36; PSA 42:5\x*
\v 20 \w mas diante da|strong="G1519,G1161,G3588"\w* \w promessa|strong="G1860"\w* \w de Deus|strong="G3588,G2316"\w* \w não|strong="G3756"\w* \w vacilou|strong="G1252"\w* \w por incredulidade|strong="G3588,G570"\w*, \w mas|strong="G235"\w* \w foi fortalecido|strong="G1743"\w* \w na fé|strong="G3588,G4102"\w*, \w dando glória|strong="G1325,G1391"\w* \w a Deus|strong="G3588,G2316"\w*,\x - \xo 4:20 \xt ISA 26:3; GEN 15:6; MRK 11:23; JHN 11:40; HEB 11:11; GEN 21:1\x*
\v 21 \w e|strong="G2532"\w* \w plenamente convencido|strong="G4135"\w* \w de que|strong="G3754"\w* \w o que|strong="G3739"\w* \w prometeu|strong="G1861"\w* \w é capaz|strong="G1415,G1510"\w* \w também|strong="G2532"\w* \w de cumprir|strong="G4160"\w*.\x - \xo 4:21 \xt EPH 3:20; ISA 26:3; GEN 15:6; MRK 11:23; GEN 18:14; JHN 11:40\x*
\v 22 \w Por isso|strong="G1352"\w* \w lhe foi atribuído|strong="G3049,G846"\w* \w como justiça|strong="G1519,G1343"\w*.\x - \xo 4:22 \xt GAL 3:6; ROM 4:3; JAS 2:23; ROM 4:6; GEN 15:6; MRK 11:23\x*
\v 23 \w Mas não foi escrito|strong="G3756,G1125,G1161"\w* \w somente|strong="G3441"\w* \w por causa dele|strong="G1223,G846"\w* \w que|strong="G3754"\w* \w lhe foi atribuído|strong="G3049,G846"\w*,\x - \xo 4:23 \xt GEN 15:6; MRK 11:23; ROM 15:4; JHN 11:40; 2TI 3:16; MRK 5:36\x*
\v 24 \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w por causa de nós|strong="G1223,G3165"\w*, \w a quem|strong="G3739"\w* \w vai ser atribuído|strong="G3195,G3049"\w*, \w a nós que cremos|strong="G3588,G4100"\w* \w naquele que ressuscitou|strong="G1909,G3588,G1453"\w* \w Jesus|strong="G2424"\w*, \w nosso Senhor|strong="G3588,G2962,G3165"\w*, \w dentre os mortos|strong="G1537,G3498"\w*,\x - \xo 4:24 \xt ACT 13:30; GAL 3:6; ROM 4:3; 2CO 1:9; ROM 10:9; 1CO 15:13\x*
\v 25 \w o qual|strong="G3739"\w* \w foi entregue|strong="G3860"\w* \w por causa|strong="G1223,G3588"\w* \w das nossas|strong="G3165"\w* \w ofensas|strong="G3900"\w* \w e|strong="G2532"\w* \w foi ressuscitado|strong="G1453"\w* \w por causa|strong="G1223,G3588"\w* \w da nossa|strong="G3165"\w* \w declaração de justiça|strong="G1347"\w*\f + \fr 4.25: \ft Lit.: δικαίωσις, “declaração de justiça, justificação”.\f*.\x - \xo 4:25 \xt ROM 5:18; ROM 5:8; ISA 53:5; GEN 15:6; MRK 11:23; 2CO 5:21\x*
\c 5
\p
\v 1 \w Tendo sido declarados justos|strong="G1344"\w* \w pela fé|strong="G1537,G4102"\w*, \w portanto|strong="G3767"\w*, \w temos|strong="G2192"\w* \w paz|strong="G1515"\w* \w com Deus|strong="G4314,G3588,G2316"\w* \w por meio do|strong="G1223,G3588"\w* \w nosso Senhor|strong="G2962,G3165"\w* \w Jesus Cristo|strong="G2424,G5547"\w*,\f + \fr 5.1: \ft Variante: a tradição manuscrita se divide entre ἔχομεν (“temos paz”, indicativo) e ἔχωμεν (“tenhamos paz”, subjuntivo); o texto segue “temos”.\f*\x - \xo 5:1 \xt LUK 7:50; ISA 26:3; ROM 8:1; GAL 2:16; ROM 4:5; ROM 3:28\x*
\v 2 \w por meio de quem|strong="G1223,G3739"\w* \w também|strong="G2532"\w* \w obtivemos|strong="G2192"\w* \w acesso|strong="G3588,G4318"\w* \w pela fé|strong="G3588,G4102"\w* \w a esta|strong="G1519,G3588,G3778"\w* \w graça|strong="G5485"\w* \w na qual|strong="G1722,G3739"\w* \w estamos firmes|strong="G2476"\w*, \w e|strong="G2532"\w* \w nos gloriamos|strong="G2744"\w* \w na esperança|strong="G1909,G1680"\w* \w da glória|strong="G3588,G1391"\w* \w de Deus|strong="G3588,G2316"\w*;\f + \fr 5.2: \ft Lit.: προσαγωγή, “acesso, introdução (à presença de alguém importante)”.\f*\x - \xo 5:2 \xt EPH 3:12; ROM 12:12; LUK 7:50; JHN 14:6; PHP 4:4; PSA 1:1\x*
\v 3 \w e não somente isso|strong="G3756,G3441,G1161"\w*, \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w nos gloriamos|strong="G2744"\w* \w nas tribulações|strong="G1722,G3588,G2347"\w*, \w sabendo|strong="G6063"\w* \w que|strong="G3754"\w* \w a tribulação|strong="G3588,G2347"\w* \w produz|strong="G2716"\w* \w perseverança|strong="G5281"\w*,\x - \xo 5:3 \xt JAS 1:3; 2CO 4:17; ROM 8:28; JAS 1:2-3; JAS 1:12; 2CO 6:4\x*
\v 4 \w e a perseverança|strong="G3588,G1161,G5281"\w*, \w caráter comprovado|strong="G1382"\w*; \w e o caráter comprovado|strong="G3588,G1161,G1382"\w*, \w esperança|strong="G1680"\w*;\f + \fr 5.4: \ft Lit.: δοκιμή, “qualidade de quem foi posto à prova e aprovado”.\f*\x - \xo 5:4 \xt ROM 8:28; JAS 1:3; ROM 15:4; 2CO 4:17; ROM 12:12; HEB 12:11\x*
\v 5 \w e a esperança|strong="G3588,G1161,G1680"\w* \w não|strong="G3756"\w* \w envergonha|strong="G2617"\w*, \w porque|strong="G3754"\w* \w o amor|strong="G3588,G26"\w* \w de Deus|strong="G3588,G2316"\w* \w foi derramado|strong="G1632"\w* \w em nossos corações|strong="G1722,G3588,G2588,G3165"\w* \w por meio do Espírito|strong="G1223,G4151"\w* \w Santo|strong="G40"\w* \w que nos foi dado|strong="G3588,G1325,G3165"\w*.\x - \xo 5:5 \xt 2TI 1:7; ROM 8:28; 1CO 13:13; 2CO 4:17; GAL 4:6; HEB 12:11\x*
\v 6 \w Pois ainda|strong="G1063,G2089"\w*, \w sendo nós|strong="G1510,G3165"\w* \w fracos|strong="G772"\w*, \w ainda|strong="G2089"\w*, \w no tempo certo|strong="G2596,G2540"\w*, \w Cristo|strong="G5547"\w* \w morreu|strong="G599"\w* \w pelos ímpios|strong="G5228,G765"\w*.\f + \fr 5.6: \ft Lit.: o grego traz ἔτι duas vezes: “ainda” quando éramos fracos e, de novo, “ainda”, no tempo certo; a repetição reforça que a morte de Cristo veio antes de qualquer mérito deles.\f*\f + \fr 5.6: \ft Variante: WH traz Εἴ γε (“se, de fato”) em lugar de Ἔτι γάρ (“pois ainda”), lido por Treg, NA28 e pelo RP; o RP omite o segundo ἔτι (“ainda”).\f*\x - \xo 5:6 \xt ROM 5:8; ISA 53:5; LUK 19:10; JHN 15:13; EPH 2:1-5; COL 2:13\x*
\v 7 \w Pois|strong="G1063"\w* \w dificilmente|strong="G3433"\w* \w alguém|strong="G5100"\w* \w morrerá|strong="G599"\w* \w por um justo|strong="G5228,G1342"\w*; \w pois|strong="G1063"\w* \w pelo bom|strong="G5228,G3588,G18"\w*, \w talvez|strong="G5029"\w* \w alguém|strong="G5100"\w* \w até|strong="G2532"\w* \w ouse|strong="G5111"\w* \w morrer|strong="G599"\w*.\x - \xo 5:7 \xt ISA 53:5; JHN 15:13; ROM 8:32; HEB 6:19; 1PE 3:18; ISA 9:6\x*
\v 8 \w Mas|strong="G1161"\w* \w Deus|strong="G3588,G2316"\w* \w demonstra|strong="G4921"\w* \w o seu próprio|strong="G3588,G1438"\w* \w amor|strong="G26"\w* \w para conosco|strong="G1519,G3165"\w*: \w que|strong="G3754"\w*, \w ainda|strong="G2089"\w* \w sendo nós|strong="G1510,G3165"\w* \w pecadores|strong="G268"\w*, \w Cristo|strong="G5547"\w* \w morreu|strong="G599"\w* \w por nós|strong="G5228,G3165"\w*.\x - \xo 5:8 \xt ROM 5:6; 1PE 3:18; JHN 15:13; JHN 3:16; 1JN 4:9; 1JN 3:16\x*
\v 9 \w Muito mais|strong="G4183,G3123"\w*, \w portanto|strong="G3767"\w*, \w tendo sido declarados justos|strong="G1344"\w* \w agora|strong="G3568"\w* \w no sangue|strong="G1722,G3588,G129"\w* \w dele|strong="G846"\w*, \w seremos salvos|strong="G4982"\w* \w por meio dele|strong="G1223,G846"\w* \w da ira|strong="G575,G3588,G3709"\w*.\x - \xo 5:9 \xt ISA 53:5; 1JN 4:10; LUK 6:35; 1TH 1:10; ROM 8:1; EPH 2:13\x*
\v 10 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w*, \w sendo inimigos|strong="G2190,G1510"\w*, \w fomos reconciliados|strong="G2644"\w* \w com Deus|strong="G3588,G2316"\w* \w pela morte|strong="G1223,G3588,G2288"\w* \w do seu|strong="G3588,G846"\w* \w Filho|strong="G5207"\w*, \w muito mais|strong="G4183,G3123"\w*, \w tendo sido reconciliados|strong="G2644"\w*, \w seremos salvos|strong="G4982"\w* \w pela vida|strong="G1722,G3588,G2222"\w* \w dele|strong="G846"\w*;\x - \xo 5:10 \xt JHN 3:16; ISA 53:5; 1JN 4:10; LUK 6:35; ROM 5:6; 2CO 5:18\x*
\v 11 \w e não somente isso|strong="G3756,G3441,G1161"\w*, \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w nos gloriando|strong="G2744"\w* \w em Deus|strong="G1722,G3588,G2316"\w* \w por meio do|strong="G1223,G3588"\w* \w nosso Senhor|strong="G2962,G3165"\w* \w Jesus Cristo|strong="G2424,G5547"\w*, \w por meio de quem|strong="G1223,G3739"\w* \w agora|strong="G3568"\w* \w recebemos|strong="G2983"\w* \w a reconciliação|strong="G3588,G2643"\w*.\x - \xo 5:11 \xt 2CO 5:18; ISA 61:10; 1PE 1:6; PHP 3:1; PSA 51:12; ROM 3:22\x*
\p
\v 12 \w Por isso|strong="G1223,G3778"\w*, \w assim como|strong="G5618"\w* \w por meio de um só|strong="G1223,G1520"\w* \w ser humano|strong="G444"\w* \w o pecado|strong="G3588,G266"\w* \w entrou|strong="G1525"\w* \w no mundo|strong="G1519,G3588,G2889"\w*, \w e|strong="G2532"\w* \w pelo pecado|strong="G1223,G3588,G266"\w* \w a morte|strong="G3588,G2288"\w*, \w e|strong="G2532"\w* \w assim|strong="G3779"\w* \w a morte|strong="G3588,G2288"\w* \w passou|strong="G1330"\w* \w a todos|strong="G1519,G3956"\w* \w os seres humanos|strong="G444"\w*, \w porque|strong="G1909,G3739"\w* \w todos|strong="G3956"\w* \w pecaram|strong="G264"\w*—\f + \fr 5.12: \ft Lit.: ἐφʼ ᾧ pode ser lido como “porque”, “em quem” (em Adão) ou “com o resultado de que”; o sentido é debatido. A frase fica sem conclusão no v. 12 e é retomada a partir do v. 18.\f*\f + \fr 5.12: \ft Nota cultural: refere-se à queda narrada em Gn 3.\f*\x - \xo 5:12 \xt ROM 5:21; 1CO 15:21; ROM 6:23; ROM 5:19; ROM 3:23; PSA 51:5\x*
\v 13 \w pois|strong="G1063"\w* \w até a chegada da lei|strong="G891,G3551"\w* \w o pecado|strong="G266"\w* \w estava|strong="G1510"\w* \w no mundo|strong="G1722,G2889"\w*, \w mas o pecado|strong="G266,G1161"\w* \w não|strong="G3756"\w* \w é imputado|strong="G1677"\w* \w quando não há|strong="G3361,G1510"\w* \w lei|strong="G3551"\w*;\f + \fr 5.13: \ft Lit.: ἐλλογέω, “pôr em conta, imputar”.\f*\x - \xo 5:13 \xt JHN 10:10; 1CO 15:22; ROM 4:15; 1CO 15:21; ACT 17:26; JAS 1:15\x*
\v 14 \w mas|strong="G235"\w* \w reinou|strong="G936"\w* \w a morte|strong="G3588,G2288"\w* \w desde Adão|strong="G575,G76"\w* \w até Moisés|strong="G3360,G3475"\w*, \w mesmo|strong="G2532"\w* \w sobre os que|strong="G1909,G3588"\w* \w não|strong="G3361"\w* \w pecaram|strong="G264"\w* \w à semelhança|strong="G1909,G3588,G3667"\w* \w da transgressão|strong="G3588,G3847"\w* \w de Adão|strong="G76"\w*, \w que|strong="G3739"\w* \w é|strong="G1510"\w* \w figura|strong="G5179"\w* \w daquele que havia de vir|strong="G3588,G3195"\w*.\f + \fr 5.14: \ft Lit.: τύπος, “marca, modelo, figura (tipo)”.\f*\x - \xo 5:14 \xt JHN 10:10; 1CO 15:22; 1CO 15:21; ACT 17:26; JAS 1:15; 1CO 15:45\x*
\v 15 \w Mas|strong="G235"\w* \w não|strong="G3756"\w* \w como|strong="G5613"\w* \w a ofensa|strong="G3588,G3900"\w*, \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w o dom da graça|strong="G3588,G5486"\w*; \w pois|strong="G1063"\w* \w se|strong="G1487"\w* \w pela ofensa|strong="G3588,G3900"\w* \w de um só|strong="G3588,G1520"\w* \w os muitos|strong="G3588,G4183"\w* \w morreram|strong="G599"\w*, \w muito mais|strong="G4183,G3123"\w* \w a graça|strong="G3588,G5485"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w o dom|strong="G3588,G1431"\w* \w pela graça|strong="G1722,G5485"\w* \w de um só|strong="G3588,G1520"\w* \w ser humano|strong="G444"\w*, \w Jesus Cristo|strong="G2424,G5547"\w*, \w abundaram|strong="G4052"\w* \w para os muitos|strong="G1519,G3588,G4183"\w*.\x - \xo 5:15 \xt 2CO 9:15; JHN 10:10; ISA 53:5; 1CO 15:22; TIT 2:11; 1CO 15:21\x*
\v 16 \w E|strong="G2532"\w* \w o dom|strong="G3588,G1434"\w* \w não|strong="G3756"\w* \w é como|strong="G5613"\w* \add o que veio\add* \w por meio de um|strong="G1223,G1520"\w* \w que pecou|strong="G264"\w*; \w pois|strong="G1063"\w* \w o julgamento|strong="G3588,G2917"\w*, \w de fato|strong="G3303"\w*, \w partindo de um|strong="G1537,G1520"\w* \w levou à condenação|strong="G1519,G2631"\w*, \w mas o dom da graça|strong="G3588,G1161,G5486"\w*, \w partindo de muitas|strong="G1537,G4183"\w* \w ofensas|strong="G3900"\w*, \w levou à sentença de justiça|strong="G1519,G1345"\w*.\f + \fr 5.16: \ft Tradução: Continua o paralelismo entre Adão e Cristo iniciado em 5:12 (“um só” e “os muitos”); ver as notas de 5:12 e de 5:15.\f*\f + \fr 5.16: \ft Acréscimo: “o” (em “é como o que veio”): preposição ou artigo que a regência do português exige; “que” (em “como o que veio por”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição; “veio” (em “o que veio por meio”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; verbo ser/estar suprido em “é como”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:16 \xt JHN 10:10; ISA 53:5; 1CO 15:22; 1CO 15:21; ACT 17:26; JAS 1:15\x*
\v 17 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w*, \w pela ofensa|strong="G3588,G3900"\w* \w de um só|strong="G3588,G1520"\w*, \w a morte|strong="G3588,G2288"\w* \w reinou|strong="G936"\w* \w por meio desse um|strong="G1223,G3588,G1520"\w*, \w muito mais|strong="G4183,G3123"\w* \w os que recebem|strong="G3588,G2983"\w* \w a abundância|strong="G3588,G4050"\w* \w da graça|strong="G3588,G5485"\w* \w e|strong="G2532"\w* \w do dom|strong="G3588,G1431"\w* \w da justiça|strong="G3588,G1343"\w* \w reinarão|strong="G936"\w* \w em vida|strong="G1722,G2222"\w* \w por meio de um só|strong="G1223,G3588,G1520"\w*, \w Jesus Cristo|strong="G2424,G5547"\w*.\f + \fr 5.17: \ft Tradução: Continua o paralelismo entre Adão e Cristo iniciado em 5:12 (“um só” e “os muitos”); ver as notas de 5:12 e de 5:15.\f*\x - \xo 5:17 \xt ROM 5:21; ROM 5:15; 1CO 15:21; JHN 10:10; ISA 53:5; 1CO 15:22\x*
\v 18 \w Portanto|strong="G686,G3767"\w*, \w assim como|strong="G5613"\w* \w por uma só|strong="G1223,G1520"\w* \w ofensa|strong="G3900"\w* \add veio\add* \w condenação|strong="G1519,G2631"\w* \w para todos|strong="G1519,G3956"\w* \w os seres humanos|strong="G444"\w*, \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w por um só|strong="G1223,G1520"\w* \w ato de justiça|strong="G1345"\w* \add veio\add* \w declaração de justiça|strong="G1519,G1347"\w* \w que traz vida|strong="G2222"\w* \w para todos|strong="G1519,G3956"\w* \w os seres humanos|strong="G444"\w*;\f + \fr 5.18: \ft Acréscimo: “veio” (em “só ofensa veio condenação para”), “veio” (em “de justiça veio declaração de”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 5:18 \xt ROM 4:25; ROM 8:1; JHN 10:10; ISA 53:5; ROM 5:19; 1CO 15:22\x*
\v 19 \w pois|strong="G1063"\w* \w assim como|strong="G5618"\w* \w pela desobediência|strong="G1223,G3588,G3876"\w* \w de um só|strong="G3588,G1520"\w* \w ser humano|strong="G444"\w* \w os muitos|strong="G3588,G4183"\w* \w foram constituídos|strong="G2525"\w* \w pecadores|strong="G268"\w*, \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w pela obediência|strong="G1223,G3588,G5218"\w* \w de um só|strong="G3588,G1520"\w* \w os muitos|strong="G3588,G4183"\w* \w serão constituídos|strong="G2525"\w* \w justos|strong="G1342"\w*.\f + \fr 5.19: \ft Tradução: Continua o paralelismo entre Adão e Cristo iniciado em 5:12 (“um só” e “os muitos”); ver as notas de 5:12 e de 5:15.\f*\f + \fr 5.19: \ft Lit.: καθίστημι (κατεστάθησαν, καταστήσονται): “constituir, estabelecer, tornar”; aqui “constituídos”.\f*\x - \xo 5:19 \xt 2CO 5:21; JHN 10:10; ROM 5:12; ISA 53:5; PHP 2:8; ROM 5:18\x*
\v 20 \w E a lei|strong="G3551,G1161"\w* \w entrou como acréscimo|strong="G3922"\w*, \w para que|strong="G2443"\w* \w aumentasse|strong="G4121"\w* \w a ofensa|strong="G3588,G3900"\w*; \w mas onde|strong="G3757,G1161"\w* \w aumentou|strong="G4121"\w* \w o pecado|strong="G3588,G266"\w*, \w superabundou|strong="G5248"\w* \w a graça|strong="G3588,G5485"\w*\f + \fr 5.20: \ft Lit.: ἵνα (“para que”): pode indicar finalidade ou consequência.\f*,\x - \xo 5:20 \xt ISA 43:25; ROM 6:1; EPH 2:1; JHN 10:10; ROM 5:8; ISA 53:5\x*
\v 21 \w para que|strong="G2443"\w*, \w assim como|strong="G5618"\w* \w reinou|strong="G936"\w* \w o pecado|strong="G3588,G266"\w* \w na morte|strong="G1722,G3588,G2288"\w*, \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w a graça|strong="G3588,G5485"\w* \w reine|strong="G936"\w* \w por meio da justiça|strong="G1223,G1343"\w* \w para vida|strong="G1519,G2222"\w* \w eterna|strong="G166"\w* \w por meio de Jesus|strong="G1223,G2424"\w* \w Cristo|strong="G5547"\w*, \w nosso Senhor|strong="G3588,G2962,G3165"\w*.\f + \fr 5.21: \ft Tradução: Continua o paralelismo entre Adão e Cristo iniciado em 5:12 (“um só” e “os muitos”); ver as notas de 5:12 e de 5:15.\f*\x - \xo 5:21 \xt ROM 6:23; ROM 5:12; ROM 5:17; ROM 8:2; JHN 3:15; ROM 8:10\x*
