\v 1 \w O que|strong="G5101"\w*, \w então|strong="G3767"\w*, \w diremos|strong="G4483"\w*? \w Permaneceremos|strong="G1961"\w* \w no pecado|strong="G3588,G266"\w*, \w para que|strong="G2443"\w* \w a graça|strong="G3588,G5485"\w* \w aumente|strong="G4121"\w*?\x - \xo 6:1 \xt ROM 5:20; 1PE 2:16; GAL 5:13; ROM 6:15; ROM 2:4; ROM 3:5\x*
\v 2 \w De modo nenhum|strong="G3361,G1096"\w*! \w Nós que|strong="G3748"\w* \w morremos|strong="G599"\w* \w para o pecado|strong="G3588,G266"\w*, \w como|strong="G4459"\w* \w ainda|strong="G2089"\w* \w viveremos|strong="G2198"\w* \w nele|strong="G1722,G846"\w*?\f + \fr 6.2: \ft Tradução: μὴ γένοιτο, literalmente “que não aconteça”: fórmula enfática de rejeição, vertida “De modo nenhum!”.\f*\x - \xo 6:2 \xt ROM 6:7; GAL 2:19; 2CO 5:15; COL 2:20; ROM 14:7; ROM 14:8\x*
\v 3 \w Ou|strong="G2228"\w* \w ignoram|strong="G50"\w* \w que|strong="G3754"\w* \w todos nós que|strong="G3745"\w* \w fomos batizados|strong="G907"\w* \w em Cristo|strong="G1519,G5547"\w* \w Jesus|strong="G2424"\w* \w fomos batizados|strong="G907"\w* \w na morte|strong="G1519,G3588,G2288"\w* \w dele|strong="G846"\w*?\x - \xo 6:3 \xt GAL 3:27; ROM 7:1; MAT 28:19; ACT 2:38; PHP 3:10; COL 2:12\x*
\v 4 \w Fomos sepultados junto|strong="G4916"\w*, \w pois|strong="G3767"\w*, \w com ele|strong="G846"\w* \w por meio do batismo|strong="G1223,G3588,G908"\w* \w na morte|strong="G1519,G3588,G2288"\w*, \w para que|strong="G2443"\w*, \w assim como|strong="G5618"\w* \w foi ressuscitado|strong="G1453"\w* \w Cristo|strong="G5547"\w* \w dentre os mortos|strong="G1537,G3498"\w* \w pela glória|strong="G1223,G3588,G1391"\w* \w do Pai|strong="G3588,G3962"\w*, \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w nós|strong="G3165"\w* \w andemos|strong="G4043"\w* \w em novidade|strong="G1722,G2538"\w* \w de vida|strong="G2222"\w*.\x - \xo 6:4 \xt 2CO 5:17; GAL 2:20; COL 2:12; ROM 8:11; MAT 28:19; PHP 3:10\x*
\v 5 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w* \w nos tornamos unidos|strong="G4854,G1096"\w* \w à semelhança|strong="G3588,G3667"\w* \w da morte|strong="G3588,G2288"\w* \w dele|strong="G846"\w*, \w mas também|strong="G235,G2532"\w* \w da ressurreição|strong="G3588,G386"\w* \add o\add* \w seremos|strong="G1510"\w*.\f + \fr 6.5: \ft Lit.: σύμφυτος, “plantado junto, crescido junto, unido organicamente”.\f*\f + \fr 6.5: \ft Acréscimo: “o” (em “da ressurreição o seremos”): preposição ou artigo que a regência do português exige.\f*\x - \xo 6:5 \xt PHP 3:10; 2CO 5:17; GAL 2:20; ROM 8:11; EPH 2:6; 2CO 4:10\x*
\v 6 \w Sabendo|strong="G1097"\w* \w isto|strong="G3778"\w*: \w que|strong="G3754"\w* \w o nosso|strong="G3165"\w* \w velho|strong="G3820"\w* \w ser humano|strong="G3588,G444"\w* \w foi crucificado junto|strong="G4957"\w*, \w para que fosse anulado|strong="G2443,G2673"\w* \w o corpo|strong="G3588,G4983"\w* \w do pecado|strong="G3588,G266"\w*, \w a fim de que|strong="G3588"\w* \w já não sejamos escravos|strong="G3371,G1398,G3165"\w* \w do pecado|strong="G3588,G266"\w*,\x - \xo 6:6 \xt 2CO 5:17; GAL 2:20; GAL 5:24; EPH 4:22; PHP 3:10; GAL 6:14\x*
\v 7 \w pois|strong="G1063"\w* \w quem morreu|strong="G3588,G599"\w* \w foi libertado|strong="G1344"\w* \w do pecado|strong="G575,G3588,G266"\w*.\f + \fr 6.7: \ft Lit.: δικαιόω, aqui “libertar, absolver” (quem morreu está quite com o pecado), e não “declarar justo” no sentido forense dos caps. 3-5.\f*\x - \xo 6:7 \xt ROM 6:2; JHN 8:24; PHP 3:10; 1PE 4:1; ROM 8:12; 1PE 2:24\x*
\v 8 \w Mas se|strong="G1487,G1161"\w* \w morremos|strong="G599"\w* \w com Cristo|strong="G4862,G5547"\w*, \w cremos|strong="G4100"\w* \w que|strong="G3754"\w* \w também|strong="G2532"\w* \w viveremos com ele|strong="G4800,G846"\w*,\x - \xo 6:8 \xt GAL 2:20; COL 3:3; COL 2:20; PHP 3:10; 2TI 2:11; 2CO 4:10\x*
\v 9 \w sabendo|strong="G6063"\w* \w que|strong="G3754"\w* \w Cristo|strong="G5547"\w*, \w tendo sido ressuscitado|strong="G1453"\w* \w dentre os mortos|strong="G1537,G3498"\w*, \w já não|strong="G2089_A,G3756"\w* \w morre|strong="G599"\w*; \w a morte|strong="G2288"\w* \w já não|strong="G2089_B,G3756"\w* \w domina|strong="G2961"\w* \w sobre ele|strong="G846"\w*.\x - \xo 6:9 \xt ROM 11:6; ROM 14:9; REV 1:18; PHP 3:10; COL 3:1; ROM 6:4\x*
\v 10 \w Pois|strong="G1063"\w* \w o que|strong="G3739"\w* \w morreu|strong="G599"\w*, \w para o pecado|strong="G3588,G266"\w* \w morreu|strong="G599"\w* \w uma vez por todas|strong="G2178"\w*; \w mas o que|strong="G3739,G1161"\w* \w vive|strong="G2198"\w*, \w vive|strong="G2198"\w* \w para Deus|strong="G3588,G2316"\w*.\x - \xo 6:10 \xt ROM 14:7; ROM 6:2; 2CO 5:15; HEB 7:27; COL 2:20; ROM 14:8\x*
\v 11 \w Assim|strong="G3779"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w considerem-se|strong="G3049,G1438"\w* \w mortos|strong="G1511,G3498"\w* \w de fato|strong="G3303"\w* \w para o pecado|strong="G3588,G266"\w*, \w mas vivos|strong="G2198,G1161"\w* \w para Deus|strong="G3588,G2316"\w* \w em Cristo|strong="G1722,G5547"\w* \w Jesus|strong="G2424"\w*.\f + \fr 6.11: \ft Variante: o RP traz a ordem νεκροὺς μὲν εἶναι, e o RP e o TR acrescentam τῷ κυρίῳ ἡμῶν (“nosso Senhor”) depois de “Jesus”.\f*\x - \xo 6:11 \xt LUK 20:38; 1PE 2:24; PHP 3:10; COL 3:3-5; COL 3:1; 1PE 4:1\x*
\v 12 \w Que não reine|strong="G3361,G936"\w*, \w pois|strong="G3767"\w*, \w o pecado|strong="G3588,G266"\w* \w no seu|strong="G1722,G3588,G4771"\w* \w corpo|strong="G4983"\w* \w mortal|strong="G2349"\w*, \w para obedecerem|strong="G1519,G3588,G5219"\w* \w aos|strong="G3588"\w* \w desejos|strong="G1939"\w*\f + \fr 6.12: \ft Variante: o RP e o TR acrescentam αὐτῇ ἐν (“a ele (o corpo), em”) depois de “obedecerem”, o que dá “obedecerem a ele em seus desejos”.\f* \w dele|strong="G846"\w*.\x - \xo 6:12 \xt ROM 8:11; GAL 5:16; ROM 6:16; 1CO 6:18; ROM 6:14; ROM 8:12\x*
\v 13 \w Nem apresentem|strong="G3366,G3936"\w* \w os seus|strong="G4771"\w* \w membros|strong="G3588,G3196"\w* \w como armas|strong="G3696"\w* \w de injustiça|strong="G93"\w* \w ao pecado|strong="G3588,G266"\w*; \w mas|strong="G235"\w* \w apresentem-se|strong="G3936"\w* \w a si mesmos|strong="G1438"\w* \w a Deus|strong="G3588,G2316"\w* \w como|strong="G5616"\w* \w vivos|strong="G2198"\w* \w dentre os mortos|strong="G1537,G3498"\w*, \w e|strong="G2532"\w* \w os seus|strong="G4771"\w* \w membros|strong="G3588,G3196"\w* \w como armas|strong="G3696"\w* \w de justiça|strong="G1343"\w* \w a Deus|strong="G3588,G2316"\w*.\x - \xo 6:13 \xt ROM 12:1; GAL 2:20; ROM 6:16; COL 3:5; EPH 5:14; 1PE 2:24\x*
\v 14 \w Pois|strong="G1063"\w* \w o pecado|strong="G266"\w* \w não|strong="G3756"\w* \w dominará|strong="G2961"\w* \w sobre vocês|strong="G4771"\w*, \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w estão|strong="G1510"\w* \w sob a lei|strong="G5259,G3551"\w*, \w mas|strong="G235"\w* \w sob a graça|strong="G5259,G5485"\w*.\x - \xo 6:14 \xt GAL 5:18; ROM 7:1; JHN 1:17; ROM 8:2; GAL 4:21; GAL 5:1\x*
\v 15 \w O que|strong="G5101"\w*, \w então|strong="G3767"\w*? \w Pecaremos|strong="G264"\w*, \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w estamos|strong="G1510"\w* \w sob a lei|strong="G5259,G3551"\w*, \w mas|strong="G235"\w* \w sob a graça|strong="G5259,G5485"\w*? \w De modo nenhum|strong="G3361,G1096"\w*!\f + \fr 6.15: \ft Tradução: μὴ γένοιτο, literalmente “que não aconteça”: fórmula enfática de rejeição, vertida “De modo nenhum!”.\f*\x - \xo 6:15 \xt GAL 5:18; 1CO 9:20; ROM 2:12; JHN 8:32; ROM 6:1; ROM 8:12\x*
\v 16 \w Não|strong="G3756"\w* \w sabem|strong="G6063"\w* \w que|strong="G3754"\w*, \w a quem|strong="G3739"\w* \w se apresentam|strong="G3936,G1438"\w* \w como escravos|strong="G1401"\w* \w para obedecer|strong="G1519,G5218"\w*, \w escravos|strong="G1401"\w* \w são|strong="G1510"\w* \w daquele|strong="G3739"\w* \w a quem obedecem|strong="G5219"\w*: \w ou|strong="G2273"\w* \w do pecado|strong="G266"\w* \w para morte|strong="G1519,G2288"\w* \w ou|strong="G2228"\w* \w da obediência|strong="G5218"\w* \w para justiça|strong="G1519,G1343"\w*?\x - \xo 6:16 \xt JHN 8:34; ROM 12:1; ROM 6:20; ROM 5:21; JHN 8:32; ISA 61:1\x*
\v 17 \w Mas graças|strong="G5485,G1161"\w* \w a Deus|strong="G3588,G2316"\w* \w que|strong="G3754"\w*, \add embora\add* \w fossem|strong="G1510"\w* \w escravos|strong="G1401"\w* \w do pecado|strong="G3588,G266"\w*, \w obedeceram|strong="G5219,G1161"\w* \w de coração|strong="G1537,G2588"\w* \w ao modelo|strong="G5179"\w* \w de ensino|strong="G1322"\w* \w a que|strong="G1519,G3739"\w* \w foram entregues|strong="G3860"\w*.\f + \fr 6.17: \ft Acréscimo: “embora” (em “Deus que embora fossem escravos”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 6:17 \xt JHN 8:32; ISA 61:1; MAT 6:24; COL 1:13; 1CO 6:11; TIT 3:3\x*
