\v 19 \w Falo|strong="G3004"\w* \w em termos humanos|strong="G442"\w* \w por causa da fraqueza|strong="G1223,G3588,G769"\w* \w da carne|strong="G3588,G4561"\w* \w de vocês|strong="G4771"\w*: \w pois|strong="G1063"\w* \w assim como|strong="G5618"\w* \w apresentaram|strong="G3936"\w* \w os seus|strong="G4771"\w* \w membros|strong="G3588,G3196"\w* \w como escravos|strong="G1401"\w* \w da impureza|strong="G3588,G167"\w* \w e|strong="G2532"\w* \w da iniquidade|strong="G3588,G458"\w* \w para a iniquidade|strong="G1519,G3588,G458"\w*, \w assim|strong="G3779"\w* \w agora|strong="G3568"\w* \w apresentem|strong="G3936"\w* \w os seus|strong="G4771"\w* \w membros|strong="G3588,G3196"\w* \w como escravos|strong="G1401"\w* \w da justiça|strong="G3588,G1343"\w* \w para santificação|strong="G1519,G38"\w*.\x - \xo 6:19 \xt ROM 12:1; ISA 61:1; MAT 6:24; COL 1:13; 1CO 6:11; 1CO 9:27\x*
\v 20 \w Pois|strong="G1063"\w* \w quando|strong="G3753"\w* \w eram|strong="G1510"\w* \w escravos|strong="G1401"\w* \w do pecado|strong="G3588,G266"\w*, \w eram livres|strong="G1658,G1510"\w* \w em relação à justiça|strong="G3588,G1343"\w*.\x - \xo 6:20 \xt 1CO 7:22; ROM 6:16; JHN 8:34; ISA 61:1; MAT 6:24; COL 1:13\x*
\v 21 \w Que fruto|strong="G5101,G2590"\w*, \w então|strong="G3767"\w*, \w tinham|strong="G2192"\w* \w naquele tempo|strong="G5119"\w* \w nas coisas de que|strong="G1909,G3739"\w* \w agora|strong="G3568"\w* \w se envergonham|strong="G1870"\w*? \w Pois|strong="G1063"\w* \w o fim|strong="G3588,G5056"\w* \w delas|strong="G1565"\w* \w é morte|strong="G2288"\w*.\f + \fr 6.21: \ft Acréscimo: verbo ser/estar suprido em “é morte”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:21 \xt ISA 61:1; MAT 6:24; PRO 14:12; ROM 8:6; COL 1:13; MRK 8:36\x*
\v 22 \w Mas agora|strong="G3570,G1161"\w*, \w libertados|strong="G1659"\w* \w do pecado|strong="G575,G3588,G266"\w* \w e feitos escravos|strong="G1402,G1161"\w* \w de Deus|strong="G3588,G2316"\w*, \w têm|strong="G2192"\w* \w o seu|strong="G4771"\w* \w fruto|strong="G3588,G2590"\w* \w para santificação|strong="G1519,G38"\w*, \w e o fim|strong="G3588,G1161,G5056"\w*, \w vida|strong="G2222"\w* \w eterna|strong="G166"\w*.\x - \xo 6:22 \xt ROM 6:18; ROM 8:2; JHN 3:15; JHN 8:32; ISA 61:1; MAT 6:24\x*
\v 23 \w Pois|strong="G1063"\w* \w o salário|strong="G3588,G3800"\w* \w do pecado|strong="G3588,G266"\w* \w é morte|strong="G2288"\w*, \w mas o dom da graça|strong="G3588,G1161,G5486"\w* \w de Deus|strong="G3588,G2316"\w* \w é vida|strong="G2222"\w* \w eterna|strong="G166"\w* \w em Cristo|strong="G1722,G5547"\w* \w Jesus|strong="G2424"\w*, \w nosso Senhor|strong="G3588,G2962,G3165"\w*.\f + \fr 6.23: \ft Lit.: ὀψώνιον, “soldo, ração”, o pagamento devido a um soldado.\f*\f + \fr 6.23: \ft Acréscimo: verbo ser/estar suprido em “é morte”, “é vida”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:23 \xt JHN 5:24; JHN 3:36; ROM 5:21; 1JN 5:11; JHN 3:15; JHN 17:2\x*
