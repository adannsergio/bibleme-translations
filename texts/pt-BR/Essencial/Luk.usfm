\v 1 \w Jesus|strong="G2424"\w*, \w cheio|strong="G4134"\w* \w do Espírito Santo|strong="G4151,G40"\w*, \w voltou|strong="G5290"\w* \w do Jordão|strong="G575,G3588,G2446"\w*, \w e|strong="G2532"\w* \w era conduzido|strong="G71"\w* \w pelo Espírito|strong="G1722,G3588,G4151"\w* \w no deserto|strong="G1722,G3588,G2048"\w*,\x - \xo 4:1 \xt MAT 4:1; ACT 10:38; MRK 1:12; LUK 4:18; ISA 61:1; JHN 3:34\x*
\v 2 \w durante quarenta dias|strong="G2250,G5062"\w*, \w sendo tentado|strong="G3985"\w* \w pelo diabo|strong="G5259,G3588,G1228"\w*. \w E|strong="G2532"\w* \w não comeu|strong="G3756,G5315"\w* \w nada|strong="G3762"\w* \w naqueles dias|strong="G1722,G3588,G2250,G1565"\w*, \w e|strong="G2532"\w* \w quando terminaram|strong="G4931,G846"\w* \w teve fome|strong="G3983"\w*.\f + \fr 4.2: \ft Lit.: πειράζω, “pôr à prova, tentar”.\f*\f + \fr 4.2: \ft Variante: O RP acrescenta “depois” (ὕστερον) depois de “quando terminaram”.\f*\x - \xo 4:2 \xt MAT 4:1; MAT 4:2; JAS 4:7; EXO 34:28; HEB 4:15; 1KI 19:8\x*
\v 3 \w Disse-lhe|strong="G2036,G846"\w* \w o diabo|strong="G3588,G1228"\w*: “\w Se|strong="G1487"\w* \w você é|strong="G1510"\w* \w Filho|strong="G5207"\w* \w de Deus|strong="G3588,G2316"\w*, \w diga|strong="G2036"\w* \w a esta pedra|strong="G3588,G3037,G3778"\w* \w que|strong="G2443"\w* \w se torne|strong="G1096"\w* \w pão|strong="G740"\w*.”\x - \xo 4:3 \xt MAT 4:3; JAS 4:7; MAT 4:1; 1PE 5:9; MRK 1:12; LUK 3:22\x*
\v 4 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhe respondeu|strong="G611,G4314,G846"\w*: “\w Está escrito|strong="G1125"\w*: ‘\w Não só|strong="G3756,G3441"\w* \w de pão|strong="G1909,G740"\w* \w viverá|strong="G2198"\w* \w o ser humano|strong="G3588,G444"\w*.’”\f + \fr 4.4: \ft Nota cultural: cita Dt 8:3; Lucas traz só a primeira parte da frase.\f*\f + \fr 4.4: \ft Variante: Treg e RP acrescentam “mas de toda palavra de Deus” (ἀλλʼ ἐπὶ παντὶ ῥήματι θεοῦ) no fim da citação (como em Mt 4:4); o RP também traz “Jesus lhe respondeu, dizendo” em outra ordem.\f*\x - \xo 4:4 \xt MAT 4:4; DEU 8:3; LUK 4:8; JHN 10:34; JAS 4:7; MAT 4:1\x*
\v 5 \w E|strong="G2532"\w* \w levando-o para cima|strong="G321,G846"\w*, \w mostrou-lhe|strong="G1166,G846"\w* \w todos os reinos|strong="G3956,G3588,G932"\w* \w do mundo habitado|strong="G3588,G3625"\w* \w num instante|strong="G1722,G4743,G5550"\w*\f + \fr 4.5: \ft Variante: NIV e RP acrescentam “o diabo a um monte alto” (ὁ διάβολος εἰς ὄρος ὑψηλόν) depois de “levando-o para cima”.\f*\f + \fr 4.5: \ft Lit.: στιγμὴ χρόνου, “ponto de tempo”, isto é, “num instante”; οἰκουμένη, “terra habitada”.\f*.\x - \xo 4:5 \xt JAS 4:7; MAT 4:1; 1JN 2:16; LUK 9:25; MAT 24:14; MAT 4:8\x*
\v 6 \w E|strong="G2532"\w* \w o diabo|strong="G3588,G1228"\w* \w lhe disse|strong="G2036,G846"\w*: “\w A você|strong="G4771"\w* \w darei|strong="G1325"\w* \w toda esta autoridade|strong="G3588,G1849,G3778,G537"\w* \w e|strong="G2532"\w* \w a glória|strong="G3588,G1391"\w* \w deles|strong="G846"\w*, \w porque|strong="G3754"\w* \w a mim|strong="G1473"\w* \w foi entregue|strong="G3860"\w*, \w e|strong="G2532"\w* \w a quem|strong="G3739"\w* \w eu quiser|strong="G302,G2309"\w* \w a dou|strong="G1325,G846"\w*\f + \fr 4.6: \ft Variante: NA28 e RP trazem ἐάν em lugar de ἄν; a diferença é de forma, e o sentido é o mesmo.\f*\f + \fr 4.6: \ft Lit.: ἐξουσία, “autoridade, poder, domínio”; δόξα, “glória, esplendor”.\f*;\x - \xo 4:6 \xt JAS 4:7; MAT 4:1; JHN 12:31; 1JN 5:19; LUK 9:25; EPH 2:2\x*
\v 7 \w Portanto|strong="G3767"\w*, \w você|strong="G4771"\w*, \w se|strong="G1437"\w* \w adorar|strong="G4352"\w* \w diante de mim|strong="G1799,G1473"\w*, \w toda ela|strong="G3956"\w* \w será|strong="G1510"\w* \w sua|strong="G4771"\w*.”\f + \fr 4.7: \ft Lit.: προσκυνέω, “prostrar-se, prestar homenagem, adorar”.\f*\x - \xo 4:7 \xt REV 4:10; JAS 4:7; MAT 4:1; LUK 9:25; MAT 4:8; 1PE 5:9\x*
\v 8 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w lhe disse|strong="G2036,G846"\w*: “\w Está escrito|strong="G1125"\w*: ‘\w Ao Senhor|strong="G2962"\w*, \w o seu Deus|strong="G3588,G2316,G4771"\w*, \w adorará|strong="G4352"\w* \w e|strong="G2532"\w* \w somente a ele|strong="G846,G3441"\w* \w prestará culto|strong="G3000"\w*.’”\f + \fr 4.8: \ft Nota cultural: cita Dt 6:13.\f*\f + \fr 4.8: \ft Variante: O RP acrescenta “Vá para trás de mim, Satanás” (ὕπαγε ὀπίσω μου Σατανᾶ) antes de “Está escrito” e põe “adorará” antes de “ao Senhor, o seu Deus”; Treg e RP trazem “Jesus lhe disse” em outra ordem.\f*\x - \xo 4:8 \xt DEU 6:13; MAT 4:10; 1SA 7:3; MAT 4:4; LUK 4:4; JAS 4:7\x*
\v 9 \w Levou-o|strong="G71,G846"\w* \w a Jerusalém|strong="G1519,G2419"\w* \w e|strong="G2532"\w* \w o pôs|strong="G2476"\w* \w sobre o pináculo|strong="G1909,G3588,G4419"\w* \w do templo|strong="G3588,G2411"\w*, \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Se|strong="G1487"\w* \w você é|strong="G1510"\w* \w Filho|strong="G5207"\w* \w de Deus|strong="G3588,G2316"\w*, \w jogue-se|strong="G906,G4771"\w* \w daqui|strong="G1782"\w* \w para baixo|strong="G2736"\w*\f + \fr 4.9: \ft Lit.: πτερύγιον, “pequena asa, extremidade, beiral”: a ponta mais alta do santuário.\f*;\x - \xo 4:9 \xt MAT 4:5; JAS 4:7; MAT 4:1; 1PE 5:9; MRK 1:12; MAT 4:6\x*
\v 10 \w pois|strong="G1063"\w* \w está escrito|strong="G1125"\w*: ‘\w Aos seus anjos|strong="G3588,G32,G846"\w* \w dará ordens|strong="G1781"\w* \w a seu respeito|strong="G4012,G4771"\w*, \w para guardar|strong="G3588,G1314"\w* \w você|strong="G4771"\w*,’\x - \xo 4:10 \xt MAT 4:6; PSA 91:11; JAS 4:7; MAT 4:1; LUK 4:4; HEB 1:14\x*
\v 11 \w e|strong="G2532"\w*: ‘\w sobre as mãos|strong="G1909,G5495"\w* \w eles levarão|strong="G142"\w* \w você|strong="G4771"\w*, \w para que nunca|strong="G4218,G3361"\w* \w tropece|strong="G4350"\w* \w em pedra|strong="G4314,G3037"\w* \w o seu pé|strong="G3588,G4228,G4771"\w*.’”\f + \fr 4.11: \ft Nota cultural: cita Sl 91:11-12; o diabo usa a Escritura em sua tentação.\f*\x - \xo 4:11 \xt PSA 91:11; MAT 4:6; JAS 4:7; MAT 4:1; PSA 91:12; 1PE 5:9\x*
\v 12 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w lhe disse|strong="G2036,G846"\w*: “\w Está dito|strong="G2046"\w*: ‘\w Não|strong="G3756"\w* \w porá à prova|strong="G1598"\w* \w o Senhor|strong="G2962"\w*, \w o seu Deus|strong="G3588,G2316,G4771"\w*.’”\f + \fr 4.12: \ft Nota cultural: cita Dt 6:16.\f*\x - \xo 4:12 \xt DEU 6:16; JAS 4:7; MAT 4:1; MAT 4:4; 1PE 5:9; 1CO 10:9\x*
\v 13 \w E|strong="G2532"\w* \w tendo esgotado|strong="G4931"\w* \w toda tentação|strong="G3956,G3986"\w*, \w o diabo|strong="G3588,G1228"\w* \w se afastou|strong="G868"\w* \w dele|strong="G575,G846"\w* \w até outra ocasião|strong="G891,G2540"\w*.\f + \fr 4.13: \ft Lit.: ἄχρι καιροῦ, “até um tempo (oportuno)”: também pode ser entendido como “por algum tempo”.\f*\x - \xo 4:13 \xt JAS 4:7; MAT 4:1; MAT 4:11; HEB 4:15; JHN 14:30; MRK 1:12\x*
\p
\v 14 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w voltou|strong="G5290"\w* \w com o poder|strong="G1722,G3588,G1411"\w* \w do Espírito|strong="G3588,G4151"\w* \w para a Galileia|strong="G1519,G3588,G1056"\w*; \w e|strong="G2532"\w* \w a fama|strong="G5345"\w* \w a respeito dele|strong="G4012,G846"\w* \w se espalhou|strong="G1831"\w* \w por toda|strong="G2596,G3650"\w* \w a região ao redor|strong="G3588,G4066"\w*.\f + \fr 4.14: \ft Lit.: φήμη, “notícia, fama, rumor”.\f*\x - \xo 4:14 \xt MAT 9:26; MRK 1:28; LUK 7:17; LUK 4:1; ACT 10:37; LUK 4:37\x*
\v 15 \w E|strong="G2532"\w* \w ele|strong="G846"\w* \w ensinava|strong="G1321"\w* \w nas sinagogas|strong="G1722,G3588,G4864"\w* \w deles|strong="G846"\w*, \w sendo honrado|strong="G1392"\w* \w por todos|strong="G5259,G3956"\w*.\f + \fr 4.15: \ft Tradução: δοξαζόμενος (δοξάζω, G1392) está aqui como “sendo honrado”; o termo pode ser “glorificar”, “honrar” ou “exaltar”, e o contexto decide.\f*\x - \xo 4:15 \xt LUK 13:10; JHN 6:59; MRK 6:2; MAT 4:23; JHN 18:20; MAT 11:1\x*
\p
\v 16 \w E|strong="G2532"\w* \w foi|strong="G2064"\w* \w a Nazaré|strong="G1519,G3478"\w*, \w onde|strong="G3757"\w* \w tinha sido criado|strong="G1510,G5142"\w*, \w e|strong="G2532"\w* \w entrou|strong="G1525"\w* \w segundo o seu costume|strong="G2596,G3588,G1486,G846"\w* \w no dia|strong="G1722,G3588,G2250"\w* \w do sábado|strong="G3588,G4521"\w* \w na sinagoga|strong="G1519,G3588,G4864"\w*, \w e|strong="G2532"\w* \w se levantou|strong="G450"\w* \w para ler|strong="G314"\w*.\f + \fr 4.16: \ft Lit.: τῶν σαββάτων, plural com sentido singular: “no dia de sábado”.\f*\x - \xo 4:16 \xt ACT 17:2; LUK 13:10; MRK 6:1; MAT 4:23; MAT 2:23; MAT 13:54\x*
\v 17 \w E|strong="G2532"\w* \w foi entregue|strong="G1929"\w* \w a ele|strong="G846"\w* \w o rolo|strong="G975"\w* \w do profeta|strong="G3588,G4396"\w* \w Isaías|strong="G2268"\w*; \w e|strong="G2532"\w*, \w desenrolando|strong="G380"\w* \w o rolo|strong="G3588,G975"\w*, \w encontrou|strong="G2147"\w* \w o lugar|strong="G3588,G5117"\w* \w onde|strong="G3757"\w* \w estava escrito|strong="G1510,G1125"\w*:\f + \fr 4.17: \ft Lit.: βιβλίον, “livro, rolo” (aqui, um rolo de papiro ou de pergaminho).\f*\x - \xo 4:17 \xt MRK 6:1; ISA 61:1-3; MAT 4:23; LUK 4:20; MAT 11:1; PSA 40:9\x*
\v 18 “\w O Espírito|strong="G4151"\w* \w do Senhor|strong="G2962"\w* \w está sobre mim|strong="G1909,G1473"\w*, \w por isso|strong="G3739,G1752"\w* \w me ungiu|strong="G5548,G3165"\w* \w para anunciar a boa notícia|strong="G2097"\w* \w aos pobres|strong="G4434"\w*; \w me enviou|strong="G649,G3165"\w* \w para proclamar|strong="G2784"\w* \w aos cativos|strong="G164"\w* \w libertação|strong="G859"\w* \w e|strong="G2532"\w* \w aos cegos|strong="G5185"\w* \w recuperação da vista|strong="G309"\w*, \w para enviar|strong="G649"\w* \w em liberdade|strong="G1722,G859"\w* \w os oprimidos|strong="G2352"\w*,\f + \fr 4.18: \ft Nota cultural: cita Is 61:1-2, com um elemento de Is 58:6 (“enviar em liberdade os oprimidos”).\f*\f + \fr 4.18: \ft Lit.: ἄφεσις, “libertação, perdão, remissão”; χρίω, “ungir” (de onde vem “o Cristo”, o Ungido).\f*\f + \fr 4.18: \ft Variante: O RP acrescenta “para curar os de coração quebrantado” (ἰάσασθαι τοὺς συντετριμμένους τὴν καρδίαν) depois de “me enviou”.\f*\f + \fr 4.18: \ft Acréscimo: verbo ser/estar suprido em “está sobre mim”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:18 \xt ISA 61:1; ISA 58:6; MAT 11:5; PSA 146:7; ACT 10:38; LUK 7:22\x*
\v 19 \w para proclamar|strong="G2784"\w* \w um ano|strong="G1763"\w* \w favorável|strong="G1184"\w* \w do Senhor|strong="G2962"\w*.”\f + \fr 4.19: \ft Lit.: δεκτός, “aceitável, favorável”; o “ano favorável do Senhor” costuma ser lido como imagem do ano do jubileu (Lv 25).\f*\x - \xo 4:19 \xt ISA 61:1; ISA 61:2; MRK 6:1; PSA 45:7; ISA 63:4; 2CO 6:2\x*
\v 20 \w E|strong="G2532"\w*, \w enrolando|strong="G4428"\w* \w o rolo|strong="G3588,G975"\w* \add e\add* \w devolvendo-o|strong="G591"\w* \w ao ajudante|strong="G3588,G5257"\w*, \w sentou-se|strong="G2523"\w*; \w e|strong="G2532"\w* \w os olhos|strong="G3588,G3788"\w* \w de todos|strong="G3956"\w* \w na sinagoga|strong="G1722,G3588,G4864"\w* \w estavam fixos|strong="G1510,G816"\w* \w nele|strong="G846"\w*.\f + \fr 4.20: \ft Lit.: ὑπηρέτης, “servidor, auxiliar” (aqui, o ajudante da sinagoga).\f*\f + \fr 4.20: \ft Acréscimo: “e” (em “o rolo e devolvendo o”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 4:20 \xt MRK 6:1; PSA 45:7; ISA 42:7; JHN 6:27; LUK 4:17; JHN 8:2\x*
\v 21 \w Começou|strong="G757"\w* \w a dizer-lhes|strong="G3004,G4314,G846"\w*: “\w Hoje|strong="G4594"\w* \w se cumpriu|strong="G4137"\w* \w esta Escritura|strong="G3588,G1124,G3778"\w* \w nos ouvidos|strong="G1722,G3588,G3775"\w* \w de vocês|strong="G4771"\w*.”\x - \xo 4:21 \xt MRK 6:1; PSA 45:7; JHN 4:25-26; LUK 3:22; ACT 3:18; ISA 42:7\x*
\v 22 \w E|strong="G2532"\w* \w todos|strong="G3956"\w* \w davam testemunho|strong="G3140"\w* \w a favor dele|strong="G846"\w* \w e|strong="G2532"\w* \w se admiravam|strong="G2296"\w* \w das palavras|strong="G1909,G3588,G3056"\w* \w de graça|strong="G3588,G5485"\w* \w que saíam|strong="G3588,G1607"\w* \w da boca|strong="G1537,G3588,G4750"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w diziam|strong="G3004"\w*: “\w Não é|strong="G3780,G1510"\w* \w filho|strong="G5207"\w* \w de José|strong="G2501"\w* \w este|strong="G3778"\w*?”\f + \fr 4.22: \ft Lit.: λόγοι τῆς χάριτος, “palavras de graça”: pode ser “palavras graciosas” ou “palavras de favor”.\f*\x - \xo 4:22 \xt EPH 4:29; PSA 45:2; JHN 1:45; ISA 50:4; MRK 6:1; ECC 10:12\x*
\v 23 \w E|strong="G2532"\w* \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Certamente|strong="G3843"\w* \w vocês me dirão|strong="G4483,G3165"\w* \w este provérbio|strong="G3588,G3850,G3778"\w*: ‘\w Médico|strong="G2395"\w*, \w cure|strong="G2323"\w* \w a si mesmo|strong="G4771"\w*’; \w tudo o que|strong="G3745"\w* \w ouvimos|strong="G191"\w* \w que aconteceu|strong="G1096"\w* \w em Cafarnaum|strong="G1519,G3588,G2584"\w*, \w faça|strong="G4160"\w* \w também|strong="G2532"\w* \w aqui|strong="G5602"\w* \w na sua terra|strong="G1722,G3588,G3968,G4771"\w*.”\f + \fr 4.23: \ft Lit.: παραβολή, “parábola, provérbio, comparação”.\f*\x - \xo 4:23 \xt MRK 6:1; MAT 11:6; MAT 7:5; MAT 11:23; MAT 13:54; JHN 4:46-53\x*
\v 24 \w E|strong="G1161"\w* \w disse|strong="G2036"\w*: “\w Em verdade|strong="G281"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w nenhum profeta|strong="G3762,G4396"\w* \w é bem recebido|strong="G1184,G1510"\w* \w na sua terra|strong="G1722,G3588,G3968,G846"\w*.\x - \xo 4:24 \xt JHN 4:44; MAT 13:57; MRK 6:4; MRK 6:1; MAT 11:6; MAT 13:54\x*
\v 25 \w Na verdade|strong="G1909,G225"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w havia|strong="G1510"\w* \w muitas viúvas|strong="G4183,G5503"\w* \w nos dias|strong="G1722,G3588,G2250"\w* \w de Elias|strong="G2243"\w* \w em Israel|strong="G1722,G3588,G2474"\w*, \w quando|strong="G3753"\w* \w o céu se fechou|strong="G2808,G3588,G3772"\w* \w por três anos|strong="G1909,G2094,G5140"\w* \w e|strong="G2532"\w* \w seis meses|strong="G3376,G1803"\w*, \w quando|strong="G5613"\w* \w houve|strong="G1096"\w* \w uma grande fome|strong="G3042,G3173"\w* \w sobre toda a terra|strong="G1909,G3956,G3588,G1093"\w*,\f + \fr 4.25: \ft Nota cultural: a seca do tempo de Elias está em 1Rs 17-18; os “três anos e seis meses” também aparecem em Tg 5:17.\f*\x - \xo 4:25 \xt JAS 5:17; 1KI 17:1; MRK 6:1; 1KI 18:1; MAT 11:6; REV 11:6\x*
\v 26 \w e|strong="G2532"\w* \w a nenhuma|strong="G4314,G3762"\w* \w delas|strong="G846"\w* \w foi enviado|strong="G3992"\w* \w Elias|strong="G2243"\w*, \w a não ser|strong="G1487,G3361"\w* \w a Sarepta|strong="G1519,G4558"\w* \w da região de Sidom|strong="G3588,G4606"\w*, \w a uma mulher|strong="G4314,G1135"\w* \w viúva|strong="G5503"\w*.\x - \xo 4:26 \xt 1KI 17:1; MRK 6:1; 1KI 17:9; MAT 11:6; MAT 11:21; OBA 1:20\x*
\v 27 \w E|strong="G2532"\w* \w havia|strong="G1510"\w* \w muitos leprosos|strong="G4183,G3015"\w* \w em Israel|strong="G1722,G3588,G2474"\w* \w no tempo|strong="G1909"\w* \w do profeta|strong="G3588,G4396"\w* \w Eliseu|strong="G1666"\w*, \w e|strong="G2532"\w* \w nenhum|strong="G3762"\w* \w deles|strong="G846"\w* \w foi purificado|strong="G2511"\w*, \w a não ser|strong="G1487,G3361"\w* \w Naamã|strong="G3497"\w*, \w o sírio|strong="G3588,G4948"\w*.”\f + \fr 4.27: \ft Nota cultural: o termo grego λεπρός cobre vários males de pele, e não só a hanseníase; sobre Naamã, ver 2Rs 5.\f*\x - \xo 4:27 \xt MAT 8:2; MRK 1:40; 2KI 5:1; 2KI 5:14; MRK 6:1; MAT 11:6\x*
\v 28 \w E|strong="G2532"\w* \w todos|strong="G3956"\w* \w na sinagoga|strong="G1722,G3588,G4864"\w* \w se encheram|strong="G4130"\w* \w de ira|strong="G2372"\w* \w ao ouvirem|strong="G191"\w* \w estas coisas|strong="G3778"\w*.\x - \xo 4:28 \xt MRK 6:1; MAT 11:6; ACT 5:33; MAT 13:54; MAT 13:58; ACT 22:21-23\x*
\v 29 \w E|strong="G2532"\w*, \w levantando-se|strong="G450"\w*, \w o expulsaram|strong="G1544,G846"\w* \w para fora|strong="G1854"\w* \w da cidade|strong="G3588,G4172"\w*, \w e|strong="G2532"\w* \w o levaram|strong="G71,G846"\w* \w até a beira|strong="G2193,G3790"\w* \w do monte|strong="G3588,G3735"\w* \w sobre o qual|strong="G1909,G3739"\w* \w estava construída|strong="G3618"\w* \w a cidade|strong="G3588,G4172"\w* \w deles|strong="G846"\w*, \w a fim de|strong="G5620"\w* \w precipitá-lo|strong="G2630,G846"\w*;\f + \fr 4.29: \ft Lit.: ὀφρύς, literalmente “sobrancelha”: aqui “beira, cume”; κατακρημνίζω, “precipitar, jogar de um despenhadeiro”.\f*\x - \xo 4:29 \xt MRK 6:1; JHN 8:59; JHN 10:39; MAT 11:6; ACT 5:33; ACT 21:28-32\x*
\v 30 \w Ele|strong="G846"\w*, \w porém|strong="G1161"\w*, \w passando|strong="G1330"\w* \w pelo meio|strong="G1223,G3319"\w* \w deles|strong="G846"\w*, \w seguiu o seu caminho|strong="G4198"\w*.\x - \xo 4:30 \xt LUK 17:11; MRK 6:1; JHN 10:39; JHN 8:59; JHN 18:6-7; ACT 12:18\x*
\p
\v 31 \w E|strong="G2532"\w* \w desceu|strong="G2718"\w* \w a Cafarnaum|strong="G1519,G2584"\w*, \w cidade|strong="G4172"\w* \w da Galileia|strong="G3588,G1056"\w*. \w E|strong="G2532"\w* \w os ensinava|strong="G1510,G1321,G846"\w* \w aos sábados|strong="G1722,G3588,G4521"\w*;\x - \xo 4:31 \xt MRK 1:21; JHN 6:59; MAT 4:13; MRK 6:2; MAT 10:23; ACT 17:1-3\x*
\v 32 \w e|strong="G2532"\w* \w ficavam assombrados|strong="G1605"\w* \w com o seu ensino|strong="G1909,G3588,G1322,G846"\w*, \w porque|strong="G3754"\w* \w a sua palavra|strong="G3588,G3056,G846"\w* \w tinha autoridade|strong="G1722,G1849,G1510"\w*\f + \fr 4.32: \ft Lit.: ἐκπλήσσομαι, “ficar atônito, admirado”; ἐξουσία, “autoridade, poder”.\f*.\x - \xo 4:32 \xt MRK 1:22; MAT 7:28; MAT 22:33; ACT 13:12; MRK 11:18; LUK 4:36\x*
\v 33 \w E|strong="G2532"\w* \w na sinagoga|strong="G1722,G3588,G4864"\w* \w havia|strong="G1510"\w* \w um homem|strong="G444"\w* \w que tinha|strong="G2192"\w* \w um espírito|strong="G4151"\w* \w de demônio|strong="G1140"\w* \w impuro|strong="G169"\w*, \w e|strong="G2532"\w* \w gritou|strong="G349"\w* \w em alta voz|strong="G5456,G3173"\w*:\f + \fr 4.33: \ft Lit.: πνεῦμα δαιμονίου ἀκαθάρτου, literalmente “espírito de demônio impuro”: expressão que junta “espírito impuro” e “demônio”.\f*\x - \xo 4:33 \xt MRK 1:23; ACT 10:38; ACT 19:15; MAT 4:24\x*
\v 34 “\w Ah|strong="G1436"\w*! \w O que há|strong="G5101"\w* \w entre nós|strong="G3165"\w* \w e|strong="G2532"\w* \w você|strong="G4771"\w*, \w Jesus|strong="G2424"\w* \w de Nazaré|strong="G3479"\w*? \w Veio|strong="G2064"\w* \w para nos destruir|strong="G622,G3165"\w*? \w Sei|strong="G6063"\w* \w quem você é|strong="G4771,G5101,G1510"\w*: \w o Santo|strong="G3588,G40"\w* \w de Deus|strong="G3588,G2316"\w*.”\f + \fr 4.34: \ft Lit.: Ἔα, interjeição de espanto ou irritação; τί ἡμῖν καὶ σοί, literalmente “que (há) para nós e para você?”, fórmula de afastamento; Ναζαρηνός, “de Nazaré”.\f*\f + \fr 4.34: \ft Acréscimo: “O que há”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 4:34 \xt MRK 1:24; JAS 2:19; MAT 8:29; ACT 10:38; ACT 19:15; REV 3:7\x*
\v 35 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w o repreendeu|strong="G2008,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Cale-se|strong="G5392"\w* \w e|strong="G2532"\w* \w saia|strong="G1831"\w* \w dele|strong="G575,G846"\w*.” \w E|strong="G2532"\w*, \w o demônio|strong="G3588,G1140"\w* \w tendo-o jogado|strong="G4496,G846"\w* \w no meio|strong="G1519,G3588,G3319"\w*, \w saiu|strong="G1831"\w* \w dele|strong="G575,G846"\w* \w sem lhe fazer nenhum dano|strong="G3367,G984,G846"\w*.\f + \fr 4.35: \ft Lit.: φιμόω, “amordaçar, calar”; ἐπιτιμάω, “repreender, ordenar com severidade”.\f*\x - \xo 4:35 \xt MRK 1:25; LUK 4:41; ACT 10:38; ACT 19:15; LUK 4:39; MRK 9:20\x*
\v 36 \w E|strong="G2532"\w* \w veio|strong="G1096"\w* \w espanto|strong="G2285"\w* \w sobre todos|strong="G1909,G3956"\w*, \w e|strong="G2532"\w* \w conversavam|strong="G4814"\w* \w uns com os outros|strong="G4314,G240"\w*, \w dizendo|strong="G3004"\w*: “\w Que palavra|strong="G5101,G3588,G3056"\w* \w é esta|strong="G3778"\w*, \w que com autoridade|strong="G3754,G1722,G1849"\w* \w e|strong="G2532"\w* \w poder|strong="G1411"\w* \w dá ordens|strong="G2004"\w* \w aos espíritos|strong="G3588,G4151"\w* \w impuros|strong="G169"\w*, \w e|strong="G2532"\w* \w eles saem|strong="G1831"\w*?”\f + \fr 4.36: \ft Acréscimo: verbo ser/estar suprido em “é esta”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:36 \xt MRK 1:27; ACT 10:38; LUK 4:32; LUK 7:7; MAT 8:9; PSA 29:4\x*
\v 37 \w E|strong="G2532"\w* \w se espalhava|strong="G1607"\w* \w um rumor|strong="G2279"\w* \w a respeito dele|strong="G4012,G846"\w* \w por todo|strong="G1519,G3956"\w* \w lugar|strong="G5117"\w* \w da região ao redor|strong="G3588,G4066"\w*.\x - \xo 4:37 \xt MRK 1:45; ISA 52:13; LUK 4:14; MRK 6:14; MAT 4:23-25; MAT 9:26\x*
\p
\v 38 \w Levantando-se|strong="G450"\w* \w da sinagoga|strong="G575,G3588,G4864"\w* \w entrou|strong="G1525"\w* \w na casa|strong="G1519,G3588,G3614"\w* \w de Simão|strong="G4613"\w*. \w Ora|strong="G1161"\w*, \w a sogra|strong="G3994"\w* \w de Simão|strong="G3588,G4613"\w* \w estava|strong="G1510"\w* \w tomada|strong="G4912"\w* \w por uma febre alta|strong="G4446,G3173"\w*, \w e|strong="G2532"\w* \w pediram-lhe|strong="G2065,G846"\w* \w em favor dela|strong="G4012,G846"\w*.\x - \xo 4:38 \xt MAT 8:14; MRK 1:29; JAS 5:14-15; JHN 11:22; JHN 11:3; LUK 7:3-4\x*
\v 39 \w E|strong="G2532"\w*, \w pondo-se de pé|strong="G2186"\w* \w junto dela|strong="G1883,G846"\w*, \w repreendeu|strong="G2008"\w* \w a febre|strong="G3588,G4446"\w*, \w e|strong="G2532"\w* \w esta a deixou|strong="G863,G846"\w*; \w imediatamente|strong="G3916"\w*, \w levantando-se|strong="G450"\w*, \w os servia|strong="G1247,G846"\w*.\x - \xo 4:39 \xt MAT 8:15; MAT 8:14; LUK 4:41; LUK 4:35; MRK 1:29; LUK 8:24\x*
\v 40 \w Ao pôr do sol|strong="G1416,G3588,G2246"\w*, \w todos os que|strong="G537,G3745"\w* \w tinham|strong="G2192"\w* \w doentes|strong="G770"\w* \w com várias doenças|strong="G3554,G4164"\w* \w os levaram|strong="G71,G846"\w* \w a ele|strong="G4314,G846"\w*; \w ele|strong="G3588"\w*, \w pondo|strong="G2007"\w* \w as mãos|strong="G3588,G5495"\w* \w sobre cada um|strong="G1520,G1538"\w* \w deles|strong="G846"\w*, \w os curava|strong="G2323,G846"\w*.\x - \xo 4:40 \xt MRK 1:32; MAT 8:16; MAT 8:14; MRK 5:23; ACT 19:12; MRK 3:10\x*
\v 41 \w E|strong="G1161"\w* \w saíam|strong="G1831"\w* \w também|strong="G2532"\w* \w demônios|strong="G1140"\w* \w de muitos|strong="G575,G4183"\w*, \w gritando|strong="G2905"\w* \w e|strong="G2532"\w* \w dizendo|strong="G3004"\w*: “\w Você|strong="G4771"\w* \w é|strong="G1510"\w* \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w*!” \w E|strong="G2532"\w*, \w repreendendo-os|strong="G2008"\w*, \w não os deixava|strong="G3756,G1439,G846"\w* \w falar|strong="G2980"\w*, \w porque|strong="G3754"\w* \w sabiam|strong="G1492"\w* \w que ele era|strong="G846,G1511"\w* \w o Cristo|strong="G3588,G5547"\w*.\f + \fr 4.41: \ft Variante: NA28 traz κραυγάζοντα (“gritando”, como o texto); WH, Treg e RP trazem κράζοντα (forma diferente do mesmo verbo); o RP acrescenta “o Cristo” (ὁ χριστός) depois de “Você é”: “Você é o Cristo, o Filho de Deus”.\f*\x - \xo 4:41 \xt MRK 1:25; LUK 4:35; MRK 1:34; MAT 8:14; LUK 4:39; MRK 3:11\x*
\v 42 \w Quando se fez dia|strong="G1096,G2250"\w* \add tendo\add* \w saído|strong="G1831"\w*, \w foi|strong="G4198"\w* \w a um lugar|strong="G1519,G5117"\w* \w deserto|strong="G2048"\w*; \w e|strong="G2532"\w* \w as multidões|strong="G3588,G3793"\w* \w o procuravam|strong="G1934,G846"\w*, \w e|strong="G2532"\w* \w chegaram|strong="G2064"\w* \w até ele|strong="G2193,G846"\w*, \w e|strong="G2532"\w* \w o retinham|strong="G2722,G846"\w* \w para que não partisse|strong="G3588,G3361,G4198"\w* \w de junto deles|strong="G575,G846"\w*.\f + \fr 4.42: \ft Acréscimo: “tendo” (em “fez dia tendo saído foi”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 4:42 \xt MRK 1:35; LUK 6:12; JHN 4:34; MAT 8:18\x*
\v 43 \w Ele|strong="G3588"\w* \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Também|strong="G2532"\w* \w às outras|strong="G3588,G2087"\w* \w cidades|strong="G4172"\w* \w é preciso|strong="G1163"\w* \w que eu anuncie a boa notícia|strong="G2097,G3165"\w* \w do reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*, \w porque|strong="G3754"\w* \w para isso|strong="G1909,G3778"\w* \w fui enviado|strong="G649"\w*.”\x - \xo 4:43 \xt LUK 8:1; MRK 1:38; MAT 9:35; 2TI 4:2; MRK 1:35; JHN 6:38-40\x*
\v 44 \w E|strong="G2532"\w* \w ia proclamando|strong="G1510,G2784"\w* \w nas sinagogas|strong="G1519,G3588,G4864"\w* \w da Judeia|strong="G3588,G2449"\w*.\f + \fr 4.44: \ft Variante: Treg e RP trazem “da Galileia” (Γαλιλαίας) em lugar de “da Judeia”; o RP traz ἐν ταῖς συναγωγαῖς em lugar de εἰς τὰς συναγωγάς (“nas sinagogas”).\f*\x - \xo 4:44 \xt MRK 1:39; ACT 9:20; MAT 9:35; MAT 4:23; LUK 13:10; 2CH 17:7\x*
\c 5
\p
\v 1 \w Aconteceu|strong="G1096,G1161"\w* \add que,\add* \w enquanto|strong="G1722,G3588"\w* \w a multidão|strong="G3588,G3793"\w* \w se apertava|strong="G1945"\w* \w contra ele|strong="G846"\w* \w e|strong="G2532"\w* \w ouvia|strong="G191"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w*, \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w estava|strong="G1510"\w* \w em pé|strong="G2476"\w* \w junto ao lago|strong="G3844,G3588,G3041"\w* \w de Genesaré|strong="G1082"\w*,\f + \fr 5.1: \ft Lit.: λίμνη, “lago” (o mar da Galileia, também chamado lago de Genesaré).\f*\f + \fr 5.1: \ft Variante: O RP traz τοῦ (“para”) em lugar de καί (“e”) antes de “ouvir”.\f*\f + \fr 5.1: \ft Acréscimo: “que” (em “Aconteceu que enquanto a”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 5:1 \xt MRK 1:16; MAT 4:18; MRK 3:9; MAT 14:34; JHN 6:1; MRK 4:1\x*
\v 2 \w e|strong="G2532"\w* \w viu|strong="G1492"\w* \w dois barcos|strong="G1417,G4143"\w* \w parados|strong="G2476"\w* \w junto ao lago|strong="G3844,G3588,G3041"\w*; \w os pescadores|strong="G3588,G231"\w*, \w tendo descido|strong="G576"\w* \w deles|strong="G575,G846"\w*, \w lavavam|strong="G4150"\w* \w as redes|strong="G3588,G1350"\w*.\x - \xo 5:2 \xt MRK 4:1; MAT 4:18; MRK 1:19; JHN 1:40; MAT 4:21\x*
\v 3 \w E|strong="G1161"\w* \w embarcando|strong="G1684"\w* \w em um|strong="G1519,G1520"\w* \w dos barcos|strong="G3588,G4143"\w*, \w que era|strong="G3739,G1510"\w* \w de Simão|strong="G4613"\w*, \w pediu-lhe|strong="G2065,G846"\w* \w que o afastasse|strong="G1877"\w* \w um pouco|strong="G3641"\w* \w da terra|strong="G575,G3588,G1093"\w*; \w e|strong="G1161"\w* \w sentando-se|strong="G2523"\w* \w do barco|strong="G1537,G3588,G4143"\w* \w ensinava|strong="G1321"\w* \w as multidões|strong="G3588,G3793"\w*.\x - \xo 5:3 \xt MRK 4:1; MAT 13:2; MAT 4:18; JHN 1:40; MAT 13:1-2; JHN 1:41-42\x*
\v 4 \w E|strong="G1161"\w* \w quando|strong="G5613"\w* \w parou|strong="G3973"\w* \w de falar|strong="G2980"\w*, \w disse|strong="G2036"\w* \w a Simão|strong="G4314,G3588,G4613"\w*: “\w Leve o barco|strong="G1877"\w* \w para o fundo|strong="G1519,G3588,G899"\w* \w e|strong="G2532"\w* \w lancem|strong="G5465"\w* \w as redes de vocês|strong="G3588,G1350,G4771"\w* \w para a pesca|strong="G1519,G61"\w*.”\f + \fr 5.4: \ft Lit.: o verbo do começo (“leve”) está no singular, dirigido a Simão; “lancem”, no plural, a todos os pescadores.\f*\x - \xo 5:4 \xt JHN 21:6; MAT 17:27; MAT 4:18; JHN 1:40; ACT 21:1; EZK 47:10\x*
\v 5 \w E|strong="G2532"\w* \w Simão|strong="G4613"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: “\w Mestre|strong="G1988"\w*, \w durante toda|strong="G1223,G3650"\w* \w a noite|strong="G3571"\w*, \w tendo trabalhado duro|strong="G2872"\w*, \w nada|strong="G3762"\w* \w pegamos|strong="G2983"\w*; \w mas|strong="G1161"\w* \w por causa da|strong="G1909,G3588"\w* \w sua palavra|strong="G4487,G4771"\w* \w lançarei|strong="G5465"\w* \w as redes|strong="G3588,G1350"\w*.”\f + \fr 5.5: \ft Lit.: ἐπιστάτης, “mestre, chefe, superintendente” (só em Lucas); ῥῆμα, “palavra, ordem”.\f*\f + \fr 5.5: \ft Variante: Treg e RP acrescentam “lhe” (αὐτῷ) depois de “disse”; o RP traz o artigo antes de “Simão” e de “noite” (ὅλης τῆς νυκτός) e lê “a rede” no singular (τὸ δίκτυον).\f*\x - \xo 5:5 \xt JHN 2:5; JHN 15:14; LUK 6:46-48; JHN 21:6; 2KI 5:10-14; EZK 37:4-7\x*
\v 6 \w E|strong="G2532"\w* \w tendo feito|strong="G4160"\w* \w isto|strong="G3778"\w*, \w recolheram|strong="G4788"\w* \w uma grande quantidade|strong="G4128,G4183"\w* \w de peixes|strong="G2486"\w*; \w as redes|strong="G3588,G1350"\w* \w deles|strong="G846"\w* \w estavam se rompendo|strong="G1284"\w*.\f + \fr 5.6: \ft Variante: O RP lê διερρήγνυτο (outra forma de “estavam se rompendo”) e “a rede” no singular (τὸ δίκτυον).\f*\x - \xo 5:6 \xt JHN 21:6; JHN 2:5; MAL 3:10; MAT 4:18; JHN 1:40; 1CO 15:58\x*
\v 7 \w E|strong="G2532"\w* \w fizeram sinais|strong="G2656"\w* \w aos sócios|strong="G3588,G3353"\w* \w do outro|strong="G1722,G3588,G2087"\w* \w barco|strong="G4143"\w* \w para que viessem|strong="G3588,G2064"\w* \w ajudá-los|strong="G4815,G846"\w*; \w e|strong="G2532"\w* \w vieram|strong="G2064"\w*, \w e|strong="G2532"\w* \w encheram|strong="G4130"\w* \w os dois|strong="G297"\w* \w barcos|strong="G3588,G4143"\w*, \w a ponto de|strong="G5620"\w* \w afundarem|strong="G1036,G846"\w*.\x - \xo 5:7 \xt JHN 21:6; MAL 3:10; GAL 6:2; MAT 4:18; PHP 4:3; JHN 1:40\x*
\v 8 \w Vendo isso|strong="G1492"\w* \w Simão Pedro|strong="G4613,G4074"\w* \w caiu|strong="G4363"\w* \w aos joelhos|strong="G3588,G1119"\w* \w de Jesus|strong="G2424"\w*, \w dizendo|strong="G3004"\w*: “\w Afaste-se|strong="G1831"\w* \w de mim|strong="G575,G1473"\w*, \w porque|strong="G3754"\w* \w sou|strong="G1510"\w* \w um homem|strong="G435"\w* \w pecador|strong="G268"\w*, \w Senhor|strong="G2962"\w*.”\x - \xo 5:8 \xt ISA 6:5; MAT 8:8; JOB 42:5-6; REV 1:17; LUK 18:13; MAT 4:18\x*
\v 9 \w pois|strong="G1063"\w* \w espanto|strong="G2285"\w* \w tomou conta|strong="G4023"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w de todos|strong="G3956"\w* \w os que estavam com ele|strong="G3588,G4862,G846"\w*, \w pela pesca|strong="G1909,G3588,G61"\w* \w dos peixes|strong="G3588,G2486"\w* \w que apanharam|strong="G3739,G4815"\w*,\f + \fr 5.9: \ft Acréscimo: “os que estavam com ele”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 5:9 \xt ISA 6:5; PRO 11:30; MAT 4:18; JHN 1:40; LUK 4:32; MRK 9:6\x*
\v 10 \w e igualmente|strong="G3668,G1161,G2532"\w* \w Tiago|strong="G2385"\w* \w e|strong="G2532"\w* \w João|strong="G2491"\w*, \w filhos|strong="G5207"\w* \w de Zebedeu|strong="G2199"\w*, \w que eram|strong="G3739,G1510"\w* \w sócios|strong="G2844"\w* \w de Simão|strong="G3588,G4613"\w*. \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w* \w a Simão|strong="G4314,G3588,G4613"\w*: “\w Não tenha medo|strong="G3361,G5399"\w*; \w de agora em diante|strong="G575,G3588,G3568"\w* \w você estará capturando vivas|strong="G1510,G2221"\w* \w pessoas|strong="G444"\w*.”\f + \fr 5.10: \ft Lit.: ζωγρέω, “apanhar vivo”: o verbo da pesca indica aqui pessoas capturadas vivas (cf. Mt 4:19 e Mc 1:17, “pescadores de homens”).\f*\x - \xo 5:10 \xt MAT 4:19; MRK 1:17; MAT 10:2; MAT 13:47; PRO 11:30; EZK 47:9-10\x*
\v 11 \w E|strong="G2532"\w*, \w tendo trazido|strong="G2609"\w* \w os barcos|strong="G3588,G4143"\w* \w para a terra|strong="G1909,G3588,G1093"\w*, \w deixando|strong="G863"\w* \w tudo|strong="G3956"\w*, \w o seguiram|strong="G190,G846"\w*.\x - \xo 5:11 \xt MAT 4:22; LUK 18:28; MAT 4:20; MAT 19:27; MRK 1:18; LUK 14:33\x*
\p
\v 12 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w quando|strong="G1722,G3588"\w* \w ele estava|strong="G1511,G846"\w* \w em uma|strong="G1722,G1520"\w* \w das cidades|strong="G3588,G4172"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w um homem|strong="G435"\w* \w cheio|strong="G4134"\w* \w de lepra|strong="G3014"\w*; \w e|strong="G2532"\w*, \w ao ver|strong="G1492"\w* \w a Jesus|strong="G3588,G2424"\w*, \w caindo|strong="G4098"\w* \w de rosto no chão|strong="G1909,G4383"\w*, \w suplicou-lhe|strong="G1189,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Senhor|strong="G2962"\w*, \w se quiser|strong="G1437,G2309"\w*, \w pode|strong="G1410"\w* \w me purificar|strong="G3165,G2511"\w*.”\f + \fr 5.12: \ft Acréscimo: “que” (em “E aconteceu que quando ele”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 5:12 \xt MAT 8:2; MRK 1:40; PSA 50:15; LUK 17:12; LUK 17:16; MAT 9:28\x*
\v 13 \w E|strong="G2532"\w*, \w estendendo|strong="G1614"\w* \w a mão|strong="G3588,G5495"\w*, \w tocou nele|strong="G681,G846"\w*, \w dizendo|strong="G2036"\w*: “\w Quero|strong="G2309"\w*; \w seja purificado|strong="G2511"\w*.” \w E|strong="G2532"\w* \w imediatamente|strong="G2112"\w* \w a lepra|strong="G3588,G3014"\w* \w saiu|strong="G565"\w* \w dele|strong="G575,G846"\w*.\f + \fr 5.13: \ft Variante: O SBLGNT traz εἰπών, com o RP; WH, Treg e NA28 trazem λέγων; ambos significam “dizendo”.\f*\x - \xo 5:13 \xt MAT 8:3; MRK 1:42; MRK 1:41; MRK 1:40; 2KI 5:14; MAT 9:29-30\x*
\v 14 \w E|strong="G2532"\w* \w ele|strong="G846"\w* \w ordenou-lhe|strong="G3853,G846"\w* \w que a ninguém|strong="G3367"\w* \w dissesse|strong="G2036"\w*: “\w mas|strong="G235"\w*, \w vá embora|strong="G565"\w*, \w mostre-se|strong="G1166,G4771"\w* \w ao sacerdote|strong="G3588,G2409"\w* \w e|strong="G2532"\w* \w ofereça|strong="G4374"\w* \w pela sua purificação|strong="G4012,G3588,G2512,G4771"\w* \w conforme|strong="G2531"\w* \w Moisés|strong="G3475"\w* \w ordenou|strong="G4367"\w*, \w como testemunho|strong="G1519,G3142"\w* \w para eles|strong="G846"\w*.”\f + \fr 5.14: \ft Nota cultural: a Lei de Moisés regulava o exame pelo sacerdote e a oferta pela purificação (Lv 13-14).\f*\x - \xo 5:14 \xt MRK 1:44; MAT 8:4; MRK 1:40; LEV 14:2; LUK 17:14; MAT 8:2\x*
\v 15 \w Mais ainda|strong="G3123"\w*, \w se espalhava|strong="G1330"\w* \w a notícia|strong="G3588,G3056"\w* \w a respeito dele|strong="G4012,G846"\w*, \w e|strong="G2532"\w* \w se reuniam|strong="G4905"\w* \w muitas multidões|strong="G3793,G4183"\w* \w para ouvir|strong="G191"\w* \w e|strong="G2532"\w* \w ser curadas|strong="G2323"\w* \w das suas doenças|strong="G575,G3588,G769,G846"\w*;\f + \fr 5.15: \ft Variante: O RP acrescenta “por ele” (ὑπʼ αὐτοῦ) depois de “ser curadas”.\f*\x - \xo 5:15 \xt MAT 4:24; MAT 15:30-31; LUK 12:1; MRK 1:45; MAT 4:23-25; MAT 12:16\x*
\v 16 \w ele|strong="G846"\w*, \w porém|strong="G1161"\w*, \w costumava retirar-se|strong="G1510,G5298"\w* \w para lugares desertos|strong="G1722,G3588,G2048"\w* \w e|strong="G2532"\w* \w orar|strong="G4336"\w*.\x - \xo 5:16 \xt MRK 1:35; LUK 6:12; MAT 14:23; MRK 6:46; JHN 6:15; LUK 3:21\x*
\p
\v 17 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w num|strong="G1722,G1520"\w* \w dos dias|strong="G3588,G2250"\w*, \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w estava ensinando|strong="G1510,G1321"\w*, \w e|strong="G2532"\w* \w estavam sentados|strong="G1510,G2521"\w* \w fariseus|strong="G5330"\w* \w e|strong="G2532"\w* \w mestres da Lei|strong="G3547"\w*, \w que tinham vindo|strong="G3739,G1510,G2064"\w* \w de todo|strong="G1537,G3956"\w* \w povoado|strong="G2968"\w* \w da Galileia|strong="G3588,G1056"\w* \w e|strong="G2532"\w* \w da Judeia|strong="G2449"\w* \w e|strong="G2532"\w* \w de Jerusalém|strong="G2419"\w*; \w e|strong="G2532"\w* \w o poder|strong="G1411"\w* \w do Senhor|strong="G2962"\w* \w estava presente|strong="G1510"\w* \w para que ele curasse|strong="G1519,G3588,G2390,G846"\w*.\f + \fr 5.17: \ft Lit.: νομοδιδάσκαλος, “mestre da Lei”.\f*\f + \fr 5.17: \ft Variante: WH e NA28 trazem αὐτόν (“para que ele curasse”); Treg e RP trazem αὐτούς (“para curá-los”).\f*\f + \fr 5.17: \ft Acréscimo: “que” (em “E aconteceu que num dos”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 5:17 \xt LUK 6:19; LUK 8:46; ACT 19:11; MAT 11:5; MRK 5:30; ACT 4:30\x*
\v 18 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w uns homens|strong="G435"\w* \w trazendo|strong="G5342"\w* \w sobre um leito|strong="G1909,G2825"\w* \w um homem|strong="G444"\w* \w que estava|strong="G3739,G1510"\w* \w paralisado|strong="G3886"\w*; \w e|strong="G2532"\w* \w procuravam|strong="G2212"\w* \w levá-lo para dentro|strong="G846,G1533"\w* \w e|strong="G2532"\w* \w pô-lo|strong="G5087"\w* \w diante dele|strong="G1799,G846"\w*.\x - \xo 5:18 \xt MAT 9:2; MRK 2:3; ACT 9:33; JHN 5:5-6; MRK 2:1\x*
\v 19 \w E|strong="G2532"\w*, \w não encontrando|strong="G3361,G2147"\w* \w por onde|strong="G4169"\w* \w o levariam para dentro|strong="G1533,G846"\w* \w por causa|strong="G1223"\w* \w da multidão|strong="G3588,G3793"\w*, \w subindo|strong="G305"\w* \w no telhado|strong="G1909,G3588,G1430"\w*, \w o desceram|strong="G2524,G846"\w* \w por entre as telhas|strong="G1223,G3588,G2766"\w* \w com a maca|strong="G4862,G3588,G2826"\w* \w para o meio|strong="G1519,G3588,G3319"\w* \w diante de Jesus|strong="G1715,G3588,G2424"\w*.\f + \fr 5.19: \ft Lit.: δῶμα, “terraço, telhado (plano)”; κέραμος, “telha de barro”; κλινίδιον, “pequeno leito, maca”.\f*\x - \xo 5:19 \xt MAT 9:2; MRK 2:4; MRK 2:3; LUK 19:4; MAT 10:27; MAT 24:17\x*
\v 20 \w E|strong="G2532"\w*, \w vendo|strong="G1492"\w* \w a fé|strong="G3588,G4102"\w* \w deles|strong="G846"\w*, \w disse|strong="G2036"\w*: “\w Homem|strong="G444"\w*, \w os seus pecados|strong="G3588,G266,G4771"\w* \w estão perdoados|strong="G863"\w* \w a você|strong="G4771"\w*.”\f + \fr 5.20: \ft Lit.: ἄνθρωπε, vocativo: “homem”, forma de tratar alguém; ἀφέωνται, perfeito: “foram perdoados e continuam perdoados”.\f*\x - \xo 5:20 \xt LUK 7:48; MRK 2:5; MAT 9:2; LUK 7:49; 1JN 2:12; LUK 7:47\x*
\v 21 \w E|strong="G2532"\w* \w começaram|strong="G757"\w* \w a raciocinar|strong="G1260"\w* \w os escribas|strong="G3588,G1122"\w* \w e|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w*, \w dizendo|strong="G3004"\w*: “\w Quem é|strong="G5101,G1510"\w* \w este|strong="G3778"\w* \w que fala|strong="G3739,G2980"\w* \w blasfêmias|strong="G988"\w*? \w Quem pode|strong="G5101,G1410"\w* \w perdoar|strong="G863"\w* \w pecados|strong="G266"\w* \w a não ser|strong="G1487,G3361"\w* \w somente|strong="G3441"\w* \w Deus|strong="G3588,G2316"\w*?”\x - \xo 5:21 \xt MRK 2:6; MAT 12:31; MRK 2:7; LUK 7:49; COL 3:13; MAT 9:2\x*
\v 22 \w Jesus|strong="G3588,G2424"\w*, \w percebendo|strong="G1921"\w* \w os raciocínios|strong="G3588,G1261"\w* \w deles|strong="G846"\w*, \w respondeu e lhes disse|strong="G611,G2036,G4314,G846"\w*: “\w Por que|strong="G5101"\w* \w raciocinam|strong="G1260"\w* \w em seus corações|strong="G1722,G3588,G2588,G4771"\w*?\x - \xo 5:22 \xt MRK 2:8; LUK 24:38; MRK 2:6; LUK 9:47; COL 3:13; MAT 9:2\x*
\v 23 \w O que|strong="G5101"\w* \w é|strong="G1510"\w* \w mais fácil|strong="G2123"\w*: \w dizer|strong="G2036"\w*: ‘\w Os seus pecados|strong="G3588,G266,G4771"\w* \w lhe estão perdoados|strong="G863,G4771"\w*’, \w ou|strong="G2228"\w* \w dizer|strong="G2036"\w*: ‘\w Levante-se|strong="G1453"\w* \w e|strong="G2532"\w* \w ande|strong="G4043"\w*’?\x - \xo 5:23 \xt MAT 9:5; MRK 2:9; LUK 7:48; COL 3:13; MAT 9:2; MRK 2:3\x*
\v 24 \w Mas|strong="G1161"\w* \w para que saibam|strong="G2443,G6063"\w* \w que|strong="G3754"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w* \w tem autoridade|strong="G1849,G2192"\w* \w na terra|strong="G1909,G3588,G1093"\w* \w para perdoar|strong="G863"\w* \w pecados|strong="G266"\w*—” \w disse|strong="G2036"\w* \w ao paralítico|strong="G3588,G3886"\w*: “\w Eu lhe digo|strong="G4771,G3004"\w*: \w levante-se|strong="G1453"\w*, \w e|strong="G2532"\w* \w pegando|strong="G142"\w* \w a sua maca|strong="G3588,G2826,G4771"\w*, \w vá|strong="G4198"\w* \w para a sua casa|strong="G1519,G3588,G3624,G4771"\w*.”\f + \fr 5.24: \ft Lit.: ὁ υἱὸς τοῦ ἀνθρώπου, “o Filho do Homem”: expressão que, nos evangelhos, aparece na boca de Jesus; a frase é interrompida por uma fala do narrador (“disse ao paralítico”).\f*\x - \xo 5:24 \xt MAT 9:5; COL 3:13; JHN 5:8; MAT 9:2; MRK 2:3; MRK 2:9\x*
\v 25 \w E|strong="G2532"\w* \w imediatamente|strong="G3916"\w*, \w levantando-se|strong="G450"\w* \w diante deles|strong="G1799,G846"\w*, \w pegando|strong="G142"\w* \w aquilo em que|strong="G1909,G3739"\w* \w estava deitado|strong="G2621"\w*, \w foi embora|strong="G565"\w* \w para a sua casa|strong="G1519,G3588,G3624,G846"\w*, \w glorificando|strong="G1392"\w* \w a Deus|strong="G3588,G2316"\w*.\x - \xo 5:25 \xt MAT 9:5; MAT 9:2; MRK 2:3; MRK 2:9; MAT 9:8; LUK 18:14\x*
\v 26 \w E|strong="G2532"\w* \w o assombro|strong="G1611"\w* \w tomou|strong="G2983"\w* \w a todos|strong="G537"\w*, \w e|strong="G2532"\w* \w glorificavam|strong="G1392"\w* \w a Deus|strong="G3588,G2316"\w*, \w e|strong="G2532"\w* \w ficaram cheios|strong="G4130"\w* \w de temor|strong="G5401"\w*, \w dizendo|strong="G3004"\w*: “\w Vimos|strong="G1492"\w* \w coisas extraordinárias|strong="G3861"\w* \w hoje|strong="G4594"\w*.”\f + \fr 5.26: \ft Lit.: ἔκστασις, “assombro, êxtase, estar fora de si”; παράδοξος, “inesperado, extraordinário”.\f*\x - \xo 5:26 \xt MAT 9:2; MRK 2:3; MAT 9:8; LUK 9:43; ACT 4:21; ISA 52:14\x*
\p
\v 27 \w E|strong="G2532"\w* \w depois|strong="G3326"\w* \w disso|strong="G3778"\w* \w saiu|strong="G1831"\w* \w e|strong="G2532"\w* \w viu|strong="G2300"\w* \w um cobrador de impostos|strong="G5057"\w* \w chamado|strong="G3686"\w* \w Levi|strong="G3017"\w*, \w sentado|strong="G2521"\w* \w na coletoria|strong="G1909,G3588,G5058"\w*, \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Siga-me|strong="G190,G3165"\w*.”\f + \fr 5.27: \ft Lit.: τελώνιον, “posto de cobrança de impostos, coletoria”.\f*\f + \fr 5.27: \ft Tradução: ὀνόματι (ὄνομα, G3686) está aqui como “chamado”; o termo pode ser “nome”, “reputação”, “pessoa” ou “autoridade”, e o contexto decide.\f*\x - \xo 5:27 \xt MRK 2:14; MAT 9:9; MRK 2:13-22; MAT 4:19; MRK 3:18; MAT 19:21\x*
\v 28 \w E|strong="G2532"\w*, \w deixando|strong="G2641"\w* \w tudo|strong="G3956"\w*, \w levantando-se|strong="G450"\w*, \w o seguia|strong="G190,G846"\w*.\x - \xo 5:28 \xt LUK 14:33; MAT 9:9; LUK 5:11; MRK 2:14; MAT 19:27; 1KI 19:19-21\x*
\v 29 \w E|strong="G2532"\w* \w Levi|strong="G3018"\w* \w deu|strong="G4160"\w* \w um grande|strong="G3173"\w* \w banquete|strong="G1403"\w* \w para ele|strong="G846"\w* \w em sua casa|strong="G1722,G3588,G3614,G846"\w*; \w e|strong="G2532"\w* \w havia|strong="G1510"\w* \w uma grande multidão|strong="G3793,G4183"\w* \w de cobradores de impostos|strong="G5057"\w* \w e|strong="G2532"\w* \w de outros|strong="G243"\w* \w que estavam|strong="G3739,G1510"\w* \w à mesa|strong="G2621"\w* \w com eles|strong="G3326,G846"\w*.\f + \fr 5.29: \ft Lit.: δοχή, “recepção, banquete”; κατάκειμαι, “estar reclinado (à mesa)”.\f*\x - \xo 5:29 \xt MRK 2:15; MAT 9:9; LUK 15:1; MRK 2:14; MAT 11:19; MAT 9:10\x*
\v 30 \w E|strong="G2532"\w* \w murmuravam|strong="G1111"\w* \w os fariseus|strong="G3588,G5330"\w* \w e|strong="G2532"\w* \w os escribas|strong="G3588,G1122"\w* \w deles|strong="G846"\w* \w aos discípulos|strong="G4314,G3588,G3101"\w* \w dele|strong="G846"\w*, \w dizendo|strong="G3004"\w*: “\w Por que|strong="G1223,G5101"\w* \w comem|strong="G2068"\w* \w e|strong="G2532"\w* \w bebem|strong="G4095"\w* \w com os cobradores de impostos|strong="G3326,G3588,G5057"\w* \w e|strong="G2532"\w* \w pecadores|strong="G268"\w*?”\x - \xo 5:30 \xt MAT 9:11; MRK 2:16; LUK 15:1; MAT 11:19; MAT 9:10; LUK 15:2\x*
\v 31 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Não precisam|strong="G3756,G5532,G2192"\w* \w de médico|strong="G2395"\w* \w os que estão saudáveis|strong="G3588,G5198"\w*, \w mas|strong="G235"\w* \w os que estão mal|strong="G3588,G2560,G2192"\w*;\x - \xo 5:31 \xt MAT 9:12; MRK 2:17; LUK 19:10; MAT 9:9; LUK 15:1; EZK 34:16\x*
\v 32 \w não vim|strong="G3756,G2064"\w* \w chamar|strong="G2564"\w* \w justos|strong="G1342"\w*, \w mas|strong="G235"\w* \w pecadores|strong="G268"\w* \w ao arrependimento|strong="G1519,G3341"\w*.”\x - \xo 5:32 \xt MAT 9:13; LUK 15:7; MRK 2:17; LUK 19:10; LUK 15:10; MAT 4:17\x*
\p
\v 33 \w Eles|strong="G3588"\w* \w lhe disseram|strong="G2036,G4314,G846"\w*: “\w Os discípulos|strong="G3588,G3101"\w* \w de João|strong="G2491"\w* \w jejuam|strong="G3522"\w* \w com frequência|strong="G4437"\w* \w e|strong="G2532"\w* \w fazem orações|strong="G1162,G4160"\w*, \w do mesmo modo|strong="G3668"\w* \w também|strong="G2532"\w* \w os dos fariseus|strong="G3588,G5330"\w*; \w os seus|strong="G3588,G4771"\w* \w comem|strong="G2068"\w* \w e|strong="G2532"\w* \w bebem|strong="G4095"\w*.”\f + \fr 5.33: \ft Variante: Treg e RP acrescentam “Por que” (διὰ τί) antes de “os discípulos de João”, o que faz da frase uma pergunta.\f*\x - \xo 5:33 \xt MRK 2:18; MAT 9:14; MAT 9:9; JHN 3:25; LUK 18:12; LUK 20:47\x*
\v 34 \w Ele|strong="G3588"\w* \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Por acaso|strong="G3361"\w* \w podem|strong="G1410"\w* \w fazer jejuar|strong="G4160,G3522"\w* \w os convidados do casamento|strong="G3588,G5207,G3567"\w* \w enquanto|strong="G1722,G3739"\w* \w o noivo|strong="G3588,G3566"\w* \w está|strong="G1510"\w* \w com eles|strong="G3326,G846"\w*?\f + \fr 5.34: \ft Lit.: υἱοὶ τοῦ νυμφῶνος, literalmente “filhos da câmara nupcial”: os convidados do casamento.\f*\x - \xo 5:34 \xt MRK 2:19; MAT 9:15; MAT 9:9; MAT 25:1; MAT 9:14; JHN 3:29\x*
\v 35 \w Virão|strong="G2064"\w* \w dias|strong="G2250"\w*, \w e|strong="G2532"\w*, \w quando|strong="G3752"\w* \w for tirado|strong="G522"\w* \w deles|strong="G575,G846"\w* \w o noivo|strong="G3588,G3566"\w*, \w então|strong="G5119"\w* \w jejuarão|strong="G3522"\w* \w naqueles dias|strong="G1722,G1565,G3588,G2250"\w*.”\x - \xo 5:35 \xt MRK 2:20; MAT 9:15; MAT 9:14; MAT 9:9; MAT 25:1; LUK 17:22\x*
\v 36 \w Dizia|strong="G3004"\w* \w também|strong="G2532"\w* \w uma parábola|strong="G3850"\w* \w a eles|strong="G4314,G846"\w*: “\w Ninguém|strong="G3762"\w* \w rasga|strong="G4977"\w* \w um remendo|strong="G1915"\w* \w de uma roupa|strong="G575,G2440"\w* \w nova|strong="G2537"\w* \w e o põe|strong="G1911"\w* \w sobre uma roupa|strong="G1909,G2440"\w* \w velha|strong="G3820"\w*; \w caso contrário|strong="G1487,G1161,G3361,G1065"\w*, \w rasgará|strong="G4977"\w* \w também|strong="G2532"\w* \w a nova|strong="G3588,G2537"\w*, \w e|strong="G2532"\w* \w com a velha|strong="G3588,G3820"\w* \w o remendo|strong="G3588,G1915"\w* \w da nova|strong="G3588,G575,G2537"\w* \w não combinará|strong="G3756,G4856"\w*\f + \fr 5.36: \ft Variante: O RP omite ἀπό e σχίσας (“tendo rasgado”), lê σχίζει (“rasga”) em lugar de σχίσει e συμφωνεῖ (“combina”) em lugar de συμφωνήσει τὸ ἐπίβλημα (“o remendo combinará”).\f*.\x - \xo 5:36 \xt MAT 9:16; MRK 2:21; MAT 9:9; MAT 9:14; 2CO 6:16; DEU 22:11\x*
\v 37 \w E|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w põe|strong="G906"\w* \w vinho novo|strong="G3631,G3501"\w* \w em odres velhos|strong="G1519,G779,G3820"\w*; \w caso contrário|strong="G1487,G1161,G3361,G1065"\w*, \w o vinho novo|strong="G3588,G3631,G3501"\w* \w romperá|strong="G4486"\w* \w os odres|strong="G3588,G779"\w*, \w e|strong="G2532"\w* \w ele mesmo|strong="G846"\w* \w se derramará|strong="G1632"\w*, \w e|strong="G2532"\w* \w os odres|strong="G3588,G779"\w* \w se perderão|strong="G622"\w*;\x - \xo 5:37 \xt MRK 2:22; MAT 9:17; MAT 9:9; MAT 9:14; PSA 119:83; JOS 9:13\x*
\v 38 \w mas|strong="G235"\w* \w vinho novo|strong="G3631,G3501"\w* \w é preciso pôr|strong="G992"\w* \w em odres novos|strong="G1519,G779,G2537"\w*.\f + \fr 5.38: \ft Lit.: βλητέον, adjetivo verbal: “deve-se pôr, é preciso lançar”.\f*\f + \fr 5.38: \ft Variante: Treg e RP acrescentam “e ambos se conservam” (καὶ ἀμφότεροι συντηροῦνται) no fim.\f*\f + \fr 5.38: \ft Acréscimo: verbo ser/estar suprido em “é preciso pôr”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:38 \xt MRK 2:22; MAT 9:17; MAT 9:9; HEB 8:8-13; MAT 9:14; 2CO 5:17\x*
\v 39 \w E|strong="G2532"\w* \w ninguém|strong="G3762"\w*, \w tendo bebido|strong="G4095"\w* \w vinho velho|strong="G3820"\w*, \w quer|strong="G2309"\w* \w o novo|strong="G3501"\w*; \w pois|strong="G1063"\w* \w diz|strong="G3004"\w*: ‘\w O velho|strong="G3588,G3820"\w* \w é|strong="G1510"\w* \w bom|strong="G5543"\w*.’”\f + \fr 5.39: \ft Lit.: χρηστός, “bom, agradável, suave”.\f*\f + \fr 5.39: \ft Variante: WH omite καί (“e”) no começo; o RP acrescenta “imediatamente” (εὐθέως) depois de “vinho velho” e lê χρηστότερος (“melhor”, também NIV) em lugar de χρηστός (“bom”).\f*\x - \xo 5:39 \xt MAT 9:14; HEB 11:39; JER 6:16; MRK 7:7-13; ROM 4:11-12; MRK 2:18\x*
\c 6
\p
\v 1 \w Aconteceu|strong="G1096,G1161"\w* \add que,\add* \w num sábado|strong="G1722,G4521"\w*, \w ele passava|strong="G1279,G846"\w* \w pelas plantações de grãos|strong="G1223,G4702"\w*, \w e|strong="G2532"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w colhiam|strong="G5089"\w* \w e|strong="G2532"\w* \w comiam|strong="G2068"\w* \w as espigas|strong="G3588,G4719"\w*, \w esfregando-as|strong="G5597"\w* \w com as mãos|strong="G3588,G5495"\w*.\f + \fr 6.1: \ft Lit.: σπόριμα, “campos semeados”; ψώχω, “esfregar, debulhar com as mãos”.\f*\f + \fr 6.1: \ft Variante: O RP acrescenta δευτεροπρώτῳ (“segundo-primeiro”) depois de “sábado”, traz o artigo τῶν antes de “plantações” e inverte a ordem de “comiam” e “as espigas”.\f*\f + \fr 6.1: \ft Acréscimo: “que” (em “Aconteceu que num sábado”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 6:1 \xt MAT 12:1; MRK 2:23; DEU 23:25; LEV 23:7\x*
\v 2 \w Alguns|strong="G5100"\w* \w dos fariseus|strong="G3588,G5330"\w* \w disseram|strong="G2036"\w*: “\w Por que|strong="G5101"\w* \w fazem|strong="G4160"\w* \w o que|strong="G3739"\w* \w não é permitido|strong="G3756,G1832"\w* \w aos sábados|strong="G3588,G4521"\w*?”\x - \xo 6:2 \xt MAT 12:2; MRK 2:24; JHN 5:10; LUK 14:3; LUK 6:7; MAT 12:1\x*
\v 3 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo-lhes|strong="G611,G4314,G846"\w*, \w disse|strong="G2036"\w*: “\w Nem isto|strong="G3761,G3778"\w* \w vocês leram|strong="G314"\w*, \w o que|strong="G3739"\w* \w fez|strong="G4160"\w* \w Davi|strong="G1138"\w* \w quando|strong="G3698"\w* \w teve fome|strong="G3983"\w* \w ele mesmo|strong="G846"\w* \w e|strong="G2532"\w* \w os que estavam com ele|strong="G3588,G3326,G846,G1510"\w*?\f + \fr 6.3: \ft Variante: O SBLGNT lê ὁπότε, com o RP; WH, Treg e NA28 lêem ὅτε (ambos significam “quando”); WH e Treg omitem ὄντες (“que estavam”).\f*\x - \xo 6:3 \xt MAT 12:3; MRK 2:25; 1SA 21:3-6; MAT 12:1; 1SA 21:6; MRK 2:23\x*
\v 4 \w Como|strong="G5613"\w* \w entrou|strong="G1525"\w* \w na casa|strong="G1519,G3588,G3624"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w*, \w tomando|strong="G2983"\w* \w os pães|strong="G3588,G740"\w* \w da apresentação|strong="G3588,G4286"\w*, \w comeu|strong="G5315"\w* \w e|strong="G2532"\w* \w deu|strong="G1325"\w* \w aos que estavam com ele|strong="G3588,G3326,G846"\w*, \w os quais|strong="G3739"\w* \w não é permitido|strong="G3756,G1832"\w* \w comer|strong="G5315"\w* \w a não ser|strong="G1487,G3361"\w* \w somente|strong="G3441"\w* \w aos sacerdotes|strong="G3588,G2409"\w*?”\f + \fr 6.4: \ft Nota cultural: refere-se a 1Sm 21:1-6; os pães da apresentação (Êx 25:30; Lv 24:5-9) eram reservados aos sacerdotes.\f*\f + \fr 6.4: \ft Acréscimo: verbo ser/estar suprido em “aos que estavam com ele”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:4 \xt LEV 24:5-9; 1SA 21:1-6; EXO 25:30; MAT 12:4; MRK 2:26; MAT 12:1\x*
\v 5 \w E|strong="G2532"\w* \w lhes dizia|strong="G3004,G846"\w*: “\w O Filho do Homem|strong="G3588,G5207,G444"\w* \w é|strong="G1510"\w* \w Senhor|strong="G2962"\w* \w do sábado|strong="G3588,G4521"\w*.”\f + \fr 6.5: \ft Lit.: ὁ υἱὸς τοῦ ἀνθρώπου, “o Filho do Homem”: expressão que, nos evangelhos, aparece na boca de Jesus.\f*\x - \xo 6:5 \xt MAT 12:1; MAT 12:8; MRK 2:23; MRK 2:27; REV 1:10\x*
\p
\v 6 \w Aconteceu|strong="G1096,G1161"\w*, \w em outro sábado|strong="G1722,G2087,G4521"\w*, \w que ele entrou|strong="G1525,G846"\w* \w na sinagoga|strong="G1519,G3588,G4864"\w* \w e|strong="G2532"\w* \w ensinava|strong="G1321"\w*; \w e|strong="G2532"\w* \w havia|strong="G1510"\w* \w um homem|strong="G444"\w* \w ali|strong="G1563"\w*, \w e|strong="G2532"\w* \w a mão direita|strong="G3588,G5495,G1188"\w* \w dele|strong="G846"\w* \w estava seca|strong="G1510,G3584"\w*.\x - \xo 6:6 \xt MRK 3:1; LUK 13:10; MAT 12:9; JHN 5:3; MAT 4:23; JHN 9:16\x*
\v 7 \w Espreitavam-no|strong="G3906"\w* \w os escribas|strong="G3588,G1122"\w* \w e|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w*, \w para ver se|strong="G1487"\w* \w no sábado|strong="G1722,G3588,G4521"\w* \w ele curava|strong="G2323"\w*, \w a fim de|strong="G2443"\w* \w encontrar|strong="G2147"\w* \w de que acusá-lo|strong="G2723,G846"\w*.\x - \xo 6:7 \xt MRK 3:2; LUK 14:1; LUK 6:2; MRK 3:1; MAT 12:9; LUK 20:20\x*
\v 8 \w Ele|strong="G846"\w*, \w porém|strong="G1161"\w*, \w conhecia|strong="G1492"\w* \w os raciocínios|strong="G3588,G1261"\w* \w deles|strong="G846"\w*, \w e|strong="G1161"\w* \w disse|strong="G2036"\w* \w ao homem|strong="G3588,G435"\w* \w que tinha|strong="G3588,G2192"\w* \w a mão|strong="G3588,G5495"\w* \w seca|strong="G3584"\w*: “\w Levante-se|strong="G1453"\w* \w e|strong="G2532"\w* \w fique em pé|strong="G2476"\w* \w no meio|strong="G1519,G3588,G3319"\w*.” \w E|strong="G2532"\w*, \w levantando-se|strong="G450"\w*, \w ficou em pé|strong="G2476"\w*.\x - \xo 6:8 \xt MRK 3:3; MRK 3:1; MAT 9:4; MAT 12:9; LUK 13:12; ISA 42:4\x*
\v 9 \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Pergunto a vocês|strong="G1905,G4771"\w*: \w é permitido|strong="G1487,G1832"\w* \w no sábado|strong="G3588,G4521"\w* \w fazer o bem|strong="G15"\w* \w ou|strong="G2228"\w* \w fazer o mal|strong="G2554"\w*, \w salvar|strong="G4982"\w* \w uma vida|strong="G5590"\w* \w ou|strong="G2228"\w* \w destruir|strong="G622"\w*\f + \fr 6.9: \ft Variante: O RP traz οὖν (“então”) em lugar de δέ, Ἐπερωτήσω (“perguntarei”) em lugar de Ἐπερωτῶ, τί (“o que”) em lugar de εἰ (“se”), τοῖς σάββασιν (plural) em lugar de τῷ σαββάτῳ e ἀποκτεῖναι (“matar”) em lugar de ἀπολέσαι (“destruir”).\f*\f + \fr 6.9: \ft Lit.: ψυχή, “alma, vida”: aqui “uma vida” (uma pessoa em perigo).\f*?”\x - \xo 6:9 \xt MRK 3:4; LUK 6:2; MRK 3:1; MRK 2:27; MAT 12:9; LUK 13:12\x*
\v 10 \w E|strong="G2532"\w*, \w olhando em volta|strong="G4017"\w* \w para todos|strong="G3956,G846"\w*, \w disse-lhe|strong="G2036,G846"\w*: “\w Estenda|strong="G1614"\w* \w a sua mão|strong="G3588,G5495,G4771"\w*.” \w Ele|strong="G3588"\w* \w fez assim|strong="G4160"\w*, \w e|strong="G2532"\w* \w a mão dele|strong="G3588,G5495,G846"\w* \w foi restaurada|strong="G600"\w*.\f + \fr 6.10: \ft Variante: Treg e RP acrescentam “como a outra” (ὡς ἡ ἄλλη) depois de “dele”; o RP acrescenta também “sadia” (ὑγιής): “sadia como a outra”.\f*\x - \xo 6:10 \xt MRK 3:5; MAT 12:13; MRK 3:1; MAT 12:9; LUK 13:12; EXO 4:6-7\x*
\v 11 \w Eles|strong="G846"\w*, \w porém|strong="G1161"\w*, \w se encheram|strong="G4130"\w* \w de insensatez|strong="G454"\w*, \w e|strong="G2532"\w* \w conversavam|strong="G1255"\w* \w uns com os outros|strong="G4314,G240"\w* \w sobre o que|strong="G5101,G302"\w* \w poderiam fazer|strong="G4160"\w* \w a Jesus|strong="G3588,G2424"\w*.\f + \fr 6.11: \ft Lit.: ἄνοια, “falta de entendimento, insensatez, fúria cega”.\f*\x - \xo 6:11 \xt MRK 3:1; MAT 12:9; MIC 7:7; ACT 5:33; NEH 4:9; PSA 109:4\x*
\p
\v 12 \w Aconteceu|strong="G1096,G1161"\w* \w nesses dias|strong="G1722,G3588,G2250,G3778"\w* \w que ele saiu|strong="G1831,G846"\w* \w para o monte|strong="G1519,G3588,G3735"\w* \w a fim de orar|strong="G4336"\w*, \w e|strong="G2532"\w* \w passou a noite|strong="G1510,G1273"\w* \w em oração|strong="G1722,G3588,G4335"\w* \w a Deus|strong="G3588,G2316"\w*\f + \fr 6.12: \ft Lit.: τῇ προσευχῇ τοῦ θεοῦ, literalmente “na oração de Deus”: “em oração a Deus”.\f*.\x - \xo 6:12 \xt MRK 6:46; MAT 14:23; LUK 9:28; MRK 1:35; HEB 5:7; LUK 5:16\x*
\v 13 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w amanheceu|strong="G1096,G2250"\w*, \w chamou|strong="G4377"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w e|strong="G2532"\w*, \w escolhendo|strong="G1586"\w* \w dentre eles|strong="G575,G846"\w* \w doze|strong="G1427"\w*, \w aos quais|strong="G3739"\w* \w também|strong="G2532"\w* \w deu o nome|strong="G3687"\w* \w de apóstolos|strong="G652"\w*,\f + \fr 6.13: \ft Lit.: ἀπόστολος, “enviado, mensageiro autorizado”.\f*\x - \xo 6:13 \xt JHN 6:70; ACT 1:2; JHN 15:16; MRK 3:13; LUK 9:1; MAT 10:1\x*
\v 14 \w Simão|strong="G4613"\w*, \w a quem|strong="G3739"\w* \w também|strong="G2532"\w* \w deu o nome|strong="G3687"\w* \w Pedro|strong="G4074"\w*, \w e|strong="G2532"\w* \w André|strong="G406"\w*, \w irmão dele|strong="G3588,G80,G846"\w*, \w e|strong="G2532"\w* \w Tiago|strong="G2385"\w* \w e|strong="G2532"\w* \w João|strong="G2491"\w* \w e|strong="G2532"\w* \w Filipe|strong="G5376"\w* \w e|strong="G2532"\w* \w Bartolomeu|strong="G918"\w*,\x - \xo 6:14 \xt JHN 6:8; ACT 1:13; MRK 3:18; MRK 1:29; MAT 10:2; JHN 1:40\x*
\v 15 \w e|strong="G2532"\w* \w Mateus|strong="G3156"\w* \w e|strong="G2532"\w* \w Tomé|strong="G2381"\w* \w e|strong="G2532"\w* \w Tiago|strong="G2385"\w* \w de Alfeu|strong="G256"\w*, \w e|strong="G2532"\w* \w Simão|strong="G4613"\w*, \w chamado|strong="G3588,G2564"\w* \w Zelote|strong="G2208"\w*,\f + \fr 6.15: \ft Lit.: Ἰάκωβον Ἁλφαίου, “Tiago de Alfeu” (relação de filiação subentendida); Ζηλωτής, “zelote, zeloso”.\f*\x - \xo 6:15 \xt ACT 1:13; MRK 3:18; MAT 10:3; MRK 3:13; LUK 9:1; MAT 9:9\x*
\v 16 \w e|strong="G2532"\w* \w Judas|strong="G2455"\w* \w de Tiago|strong="G2385"\w*, \w e|strong="G2532"\w* \w Judas|strong="G2455"\w* \w Iscariotes|strong="G2469"\w*, \w que se tornou|strong="G3739,G1096"\w* \w traidor|strong="G4273"\w*.\f + \fr 6.16: \ft Lit.: Ἰούδαν Ἰακώβου, “Judas de Tiago” (relação subentendida: filho ou irmão).\f*\x - \xo 6:16 \xt JHN 12:4; MAT 26:14; JHN 14:22; MAT 10:4; LUK 22:3; MRK 3:19\x*
\p
\v 17 \w E|strong="G2532"\w*, \w descendo|strong="G2597"\w* \w com eles|strong="G3326,G846"\w*, \w parou|strong="G2476"\w* \w num lugar|strong="G1909,G5117"\w* \w plano|strong="G3977"\w*, \w e|strong="G2532"\w* \w uma grande multidão|strong="G3793,G4183"\w* \w de discípulos|strong="G3101"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w uma grande quantidade|strong="G4128,G4183"\w* \w de povo|strong="G3588,G2992"\w* \w de toda|strong="G575,G3956"\w* \w a Judeia|strong="G3588,G2449"\w* \w e|strong="G2532"\w* \w de Jerusalém|strong="G2419"\w* \w e|strong="G2532"\w* \w do litoral|strong="G3588,G3882"\w* \w de Tiro|strong="G5184"\w* \w e|strong="G2532"\w* \w de Sidom|strong="G4605"\w*,\f + \fr 6.17: \ft Lit.: τόπος πεδινός, “lugar plano” (cf. Mt 5:1, em que o ensino se dá “no monte”).\f*\f + \fr 6.17: \ft Variante: Treg e RP omitem “grande” (πολύς) antes de “multidão”.\f*\x - \xo 6:17 \xt MAT 5:1; MAT 15:30; MAT 11:21; MRK 3:7; MAT 4:25; MAT 14:14\x*
\v 18 \w os quais|strong="G3739"\w* \w vieram|strong="G2064"\w* \w para ouvi-lo|strong="G191,G846"\w* \w e|strong="G2532"\w* \w ser curados|strong="G2390"\w* \w das suas doenças|strong="G575,G3588,G3554,G846"\w*; \w e|strong="G2532"\w* \w os atormentados|strong="G3588,G1776"\w* \w por espíritos|strong="G575,G4151"\w* \w impuros|strong="G169"\w* \w eram curados|strong="G2323"\w*;\x - \xo 6:18 \xt MAT 15:30; ACT 5:16; MAT 15:22; MAT 17:15\x*
\v 19 \w e|strong="G2532"\w* \w toda a multidão|strong="G3956,G3588,G3793"\w* \w procurava|strong="G2212"\w* \w tocá-lo|strong="G681,G846"\w*, \w porque|strong="G3754"\w* \w um poder|strong="G1411"\w* \w saía|strong="G1831"\w* \w dele|strong="G3844,G846"\w* \w e|strong="G2532"\w* \w curava|strong="G2390"\w* \w todos|strong="G3956"\w*.\x - \xo 6:19 \xt LUK 8:46; MRK 5:30; LUK 5:17; MAT 14:36; MRK 3:10; ACT 5:15-16\x*
\q1
\v 20 \w E|strong="G2532"\w* \w ele|strong="G846"\w*, \w levantando|strong="G1869"\w* \w os olhos|strong="G3588,G3788"\w* \w dele|strong="G846"\w* \w para os seus discípulos|strong="G1519,G3588,G3101,G846"\w*, \w dizia|strong="G3004"\w*: “\w Felizes|strong="G3107"\w* \w os pobres|strong="G3588,G4434"\w*, \w porque|strong="G3754"\w* \w de vocês|strong="G4771"\w* \w é|strong="G1510"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 6:20 \xt MAT 5:3; MAT 5:10; MAT 17:8; JHN 17:1; JAS 2:5; LUK 4:18\x*
\q1
\v 21 \w Felizes|strong="G3107"\w* \w os que têm fome|strong="G3588,G3983"\w* \w agora|strong="G3568"\w*, \w porque|strong="G3754"\w* \w serão saciados|strong="G5526"\w*. \w Felizes|strong="G3107"\w* \w os que choram|strong="G3588,G2799"\w* \w agora|strong="G3568"\w*, \w porque|strong="G3754"\w* \w rirão|strong="G1070"\w*.\x - \xo 6:21 \xt MAT 5:6; LUK 6:25; MAT 5:3; MAT 5:4; LUK 6:20; ISA 30:19\x*
\q1
\v 22 \w Felizes|strong="G3107"\w* \w são vocês|strong="G1510"\w* \w quando|strong="G3752"\w* \w as pessoas|strong="G3588,G444"\w* \w odiarem|strong="G3404"\w* \w vocês|strong="G4771"\w*, \w e|strong="G2532"\w* \w quando|strong="G3752"\w* \w os excluírem|strong="G873,G4771"\w* \w e|strong="G2532"\w* \w insultarem|strong="G3679"\w* \w e|strong="G2532"\w* \w rejeitarem|strong="G1544"\w* \w o nome|strong="G3588,G3686"\w* \w de vocês|strong="G4771"\w* \w como mau|strong="G5613,G4190"\w* \w por causa do|strong="G1752,G3588"\w* \w Filho do Homem|strong="G5207,G3588,G444"\w*;\f + \fr 6.22: \ft Lit.: ἐκβάλωσιν τὸ ὄνομα ὑμῶν ὡς πονηρόν, literalmente “lançarem fora o nome de vocês como mau”: difamar; ἀφορίζω, “separar, excluir”.\f*\x - \xo 6:22 \xt MAT 5:11; MAT 5:10; 1PE 4:14; JAS 1:2; LUK 21:17; MAT 5:3\x*
\q1
\v 23 \w alegrem-se|strong="G5463"\w* \w naquele dia|strong="G1722,G1565,G3588,G2250"\w* \w e|strong="G2532"\w* \w saltem de alegria|strong="G4640"\w*, \w pois|strong="G1063"\w* \w olhem|strong="G2400"\w*, \w a recompensa|strong="G3588,G3408"\w* \w de vocês|strong="G4771"\w* \add é\add* \w grande|strong="G4183"\w* \w no céu|strong="G1722,G3588,G3772"\w*; \w pois|strong="G1063"\w* \w da mesma maneira|strong="G2596,G3588,G846"\w* \w os pais|strong="G3588,G3962"\w* \w deles|strong="G846"\w* \w faziam|strong="G4160"\w* \w com os profetas|strong="G3588,G4396"\w*.\f + \fr 6.23: \ft Acréscimo: “é” (em “de vocês é grande no”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 6:23 \xt MAT 5:12; JAS 1:2; MAT 5:3; ROM 5:3; LUK 6:20; 1PE 3:14\x*
\q1
\v 24 \w Mas|strong="G4133"\w* \w ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w ricos|strong="G3588,G4145"\w*, \w porque|strong="G3754"\w* \w já recebem por inteiro|strong="G568"\w* \w o consolo|strong="G3588,G3874"\w* \w de vocês|strong="G4771"\w*.\f + \fr 6.24: \ft Lit.: οὐαί, “ai”, exclamação de lamento ou advertência; ἀπέχω, “receber por inteiro, já ter recebido”.\f*\x - \xo 6:24 \xt MAT 5:3; LUK 16:25; LUK 6:20; JAS 5:1; ECC 3:4; 1TI 6:17\x*
\q1
\v 25 \w Ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w os que estão fartos|strong="G3588,G1705"\w* \w agora|strong="G3568"\w*, \w porque|strong="G3754"\w* \w terão fome|strong="G3983"\w*. \w Ai|strong="G3759"\w* \w dos que riem|strong="G3588,G1070"\w* \w agora|strong="G3568"\w*, \w porque|strong="G3754"\w* \w vão lamentar|strong="G3996"\w* \w e|strong="G2532"\w* \w chorar|strong="G2799"\w*.\x - \xo 6:25 \xt LUK 6:21; JAS 4:9; MAT 5:3; JHN 6:35; MAT 5:6; MAT 5:4\x*
\q1
\v 26 \w Ai|strong="G3759"\w* \w quando|strong="G3752"\w* \w todas as pessoas|strong="G3956,G3588,G444"\w* \w falarem bem|strong="G2573,G2036"\w* \w de vocês|strong="G4771"\w*; \w pois|strong="G1063"\w* \w da mesma maneira|strong="G2596,G3588,G846"\w* \w os pais|strong="G3588,G3962"\w* \w deles|strong="G846"\w* \w faziam|strong="G4160"\w* \w com os falsos profetas|strong="G3588,G5578"\w*.\x - \xo 6:26 \xt MAT 5:3; JHN 15:19; JAS 4:4; MAT 7:15; 1JN 4:5-6; MIC 2:11\x*
\p
\v 27 \w Mas|strong="G235"\w* \w a vocês|strong="G4771"\w* \w digo|strong="G3004"\w*, \w que ouvem|strong="G3588,G191"\w*: \w amem|strong="G25"\w* \w os inimigos|strong="G3588,G2190"\w* \w de vocês|strong="G4771"\w*, \w façam o bem|strong="G2573,G4160"\w* \w aos que odeiam|strong="G3588,G3404"\w* \w vocês|strong="G4771"\w*,\x - \xo 6:27 \xt MAT 5:44; MAT 5:43; LUK 1:71; ROM 12:21; LUK 23:34; ROM 12:20\x*
\v 28 \w abençoem|strong="G2127"\w* \w os que amaldiçoam|strong="G3588,G2672"\w* \w vocês|strong="G4771"\w*, \w orem|strong="G4336"\w* \w por aqueles|strong="G4012,G3588"\w* \w que maltratam|strong="G1908"\w* \w vocês|strong="G4771"\w*.\x - \xo 6:28 \xt ROM 12:14; JAS 3:9; MAT 5:44; ROM 12:21; LUK 23:34; 1PE 3:9\x*
\v 29 \w A quem|strong="G3588"\w* \w bater em você|strong="G5180,G4771"\w* \w na face|strong="G1909,G3588,G4600"\w*, \w ofereça|strong="G3930"\w* \w também|strong="G2532"\w* \w a outra|strong="G3588,G243"\w*; \w e|strong="G2532"\w* \w de quem|strong="G575,G3588"\w* \w tirar|strong="G142"\w* \w o seu manto|strong="G4771,G3588,G2440"\w*, \w não negue|strong="G3361,G2967"\w* \w também|strong="G2532"\w* \w a túnica|strong="G3588,G5509"\w*.\f + \fr 6.29: \ft Lit.: ἱμάτιον, “manto, veste de cima”; χιτών, “túnica, veste de baixo”.\f*\x - \xo 6:29 \xt MAT 5:40; ROM 12:21; 1PE 3:9; ROM 12:19; MAT 5:39; LUK 6:35\x*
\v 30 \w A todo|strong="G3956"\w* \w que pedir|strong="G154"\w* \w a você|strong="G4771"\w*, \w dê|strong="G1325"\w*; \w e|strong="G2532"\w* \w de quem|strong="G575,G3588"\w* \w tomar|strong="G142"\w* \w o que é seu|strong="G3588,G4771"\w*, \w não exija de volta|strong="G3361,G523"\w*.\f + \fr 6.30: \ft Acréscimo: verbo ser/estar suprido em “o que é seu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:30 \xt ROM 12:21; LUK 6:38; MAT 5:39; DEU 15:7-10; MAT 5:42; LUK 6:35\x*
\v 31 \w E|strong="G2532"\w*, \w como|strong="G2531"\w* \w vocês querem|strong="G2309"\w* \w que as pessoas|strong="G2443,G3588,G444"\w* \w façam a vocês|strong="G4160,G4771"\w*, \w façam|strong="G4160"\w* \w a elas|strong="G846"\w* \w do mesmo modo|strong="G3668"\w*.\x - \xo 6:31 \xt MAT 7:12; GAL 5:14; MAT 22:39; JAS 2:8-16; MAT 5:42; LUK 6:35\x*
\v 32 \w E|strong="G2532"\w*, \w se amam|strong="G1487,G25"\w* \w os que amam|strong="G3588,G25"\w* \w vocês|strong="G4771"\w*, \w que mérito|strong="G4169,G5485"\w* \w há|strong="G1510"\w* \w para vocês|strong="G4771"\w*? \w Pois também|strong="G2532,G1063"\w* \w os pecadores|strong="G3588,G268"\w* \w amam|strong="G25"\w* \w os que amam|strong="G3588,G25"\w* \w eles|strong="G846"\w*.\f + \fr 6.32: \ft Lit.: χάρις, “graça, favor, mérito, crédito”: aqui “que crédito vocês têm?”.\f*\x - \xo 6:32 \xt 1PE 2:20; MAT 5:46; MAT 5:42; MAT 5:47; 1PE 2:19; LUK 14:12\x*
\v 33 \w E|strong="G2532"\w*, \w se fazem o bem|strong="G1437,G15"\w* \w aos que fazem o bem|strong="G3588,G15"\w* \w a vocês|strong="G4771"\w*, \w que mérito|strong="G4169,G5485"\w* \w há|strong="G1510"\w* \w para vocês|strong="G4771"\w*? \w Também|strong="G2532"\w* \w os pecadores|strong="G3588,G268"\w* \w fazem|strong="G4160"\w* \w o mesmo|strong="G3588,G846"\w*.\x - \xo 6:33 \xt 1PE 2:20; MAT 5:46; MAT 5:42; LUK 14:12; LUK 10:37; PHP 4:5\x*
\v 34 \w E|strong="G2532"\w*, \w se emprestam|strong="G1437,G1155"\w* \w àqueles de quem|strong="G3844,G3739"\w* \w esperam|strong="G1679"\w* \w receber|strong="G2983"\w*, \w que mérito|strong="G4169,G5485"\w* \w há|strong="G1510"\w* \w para vocês|strong="G4771"\w*? \w Também|strong="G2532"\w* \w pecadores|strong="G268"\w* \w a pecadores|strong="G268"\w* \w emprestam|strong="G1155"\w*, \w para receber de volta|strong="G2443,G618"\w* \w o equivalente|strong="G3588,G2470"\w*.\x - \xo 6:34 \xt MAT 5:44; MAT 5:46; MAT 5:42; LUK 14:12; LUK 6:35; DEU 15:8\x*
\v 35 \w Mas|strong="G4133"\w* \w amem|strong="G25"\w* \w os inimigos|strong="G3588,G2190"\w* \w de vocês|strong="G4771"\w*, \w e|strong="G2532"\w* \w façam o bem|strong="G15"\w* \w e|strong="G2532"\w* \w emprestem|strong="G1155"\w*, \w sem esperar nada em troca|strong="G3367,G560"\w*; \w e|strong="G2532"\w* \w a recompensa|strong="G3588,G3408"\w* \w de vocês|strong="G4771"\w* \w será grande|strong="G1510,G4183"\w*, \w e|strong="G2532"\w* \w serão filhos|strong="G1510,G5207"\w* \w do Altíssimo|strong="G5310"\w*, \w porque|strong="G3754"\w* \w ele|strong="G846"\w* \w é bondoso|strong="G5543,G1510"\w* \w com os ingratos|strong="G1909,G3588,G884"\w* \w e|strong="G2532"\w* \w maus|strong="G4190"\w*.\f + \fr 6.35: \ft Lit.: ἀπελπίζω, “esperar de volta” ou “perder a esperança”; “sem esperar nada em troca” é a leitura mais comum de μηδὲν ἀπελπίζοντες; χρηστός, “bondoso, benigno”.\f*\x - \xo 6:35 \xt MAT 5:44; MAT 5:45; MAT 5:9; EPH 5:1; JHN 13:35; EPH 4:32\x*
\v 36 \w Sejam|strong="G1096"\w* \w compassivos|strong="G3629"\w*, \w assim como|strong="G2531"\w* \w o Pai|strong="G3588,G3962"\w* \w de vocês|strong="G4771"\w* \w é|strong="G1510"\w* \w compassivo|strong="G3629"\w*.\f + \fr 6.36: \ft Variante: O RP acrescenta “portanto” (οὖν) depois de “Sejam”; o SBLGNT traz καθώς, com WH e NIV, e Treg, RP e NA28 trazem καθὼς καί (“assim como também”).\f*\x - \xo 6:36 \xt MIC 6:8; EPH 5:1; COL 3:13; MAT 5:48; 1CO 13:4; 1PE 1:15-16\x*
\v 37 \w E|strong="G2532"\w* \w não julguem|strong="G3361,G2919"\w*, \w e|strong="G2532"\w* \w de modo nenhum|strong="G3756,G3361"\w* \w serão julgados|strong="G2919"\w*; \w e|strong="G2532"\w* \w não condenem|strong="G3361,G2613"\w*, \w e|strong="G2532"\w* \w de modo nenhum|strong="G3756,G3361"\w* \w serão condenados|strong="G2613"\w*. \w Absolvam|strong="G630"\w*, \w e|strong="G2532"\w* \w serão absolvidos|strong="G630"\w*;\f + \fr 6.37: \ft Lit.: ἀπολύω, “soltar, libertar”: aqui “absolver, perdoar”.\f*\x - \xo 6:37 \xt MAT 7:1; EPH 4:32; COL 3:13; JAS 5:9; MRK 11:25; ROM 2:1\x*
\v 38 \w Deem|strong="G1325"\w*, \w e|strong="G2532"\w* \w lhes será dado|strong="G1325,G4771"\w*; \w uma medida|strong="G3358"\w* \w boa|strong="G2570"\w*, \w apertada|strong="G4085"\w*, \w sacudida|strong="G4531"\w*, \w transbordante|strong="G5240"\w*, \w darão|strong="G1325"\w* \w no regaço|strong="G1519,G3588,G2859"\w* \w de vocês|strong="G4771"\w*; \w pois|strong="G1063"\w* \w com a medida|strong="G3739,G3358"\w* \w com que medem|strong="G3354"\w*, \w será medido de volta|strong="G488"\w* \w a vocês|strong="G4771"\w*.”\f + \fr 6.38: \ft Lit.: κόλπος, “regaço, dobra da veste (onde se carregava o grão)”; “darão” está em plural indefinido, sem sujeito expresso.\f*\x - \xo 6:38 \xt MRK 4:24; MAT 7:2; 2CO 9:6; DEU 15:10; PRO 3:9-10; PRO 22:9\x*
\v 39 \w Disse|strong="G2036"\w* \w também|strong="G2532"\w* \w uma parábola|strong="G3850"\w* \w a eles|strong="G846"\w*: “\w Por acaso|strong="G3385"\w* \w pode|strong="G1410"\w* \w um cego|strong="G5185"\w* \w guiar|strong="G3594"\w* \w um cego|strong="G5185"\w*? \w Não cairão|strong="G3780,G1706"\w* \w os dois|strong="G297"\w* \w numa cova|strong="G1519,G999"\w*?\x - \xo 6:39 \xt MAT 15:14; 2TI 3:13; ISA 56:10; ISA 9:16; 1TI 6:3-5; MAT 23:16-26\x*
\v 40 \w Não há|strong="G3756,G1510"\w* \w discípulo|strong="G3101"\w* \w acima do mestre|strong="G5228,G3588,G1320"\w*; \w todo|strong="G3956"\w* \w plenamente formado|strong="G2675"\w* \w será|strong="G1510"\w* \w como|strong="G5613"\w* \w o seu mestre|strong="G3588,G1320,G846"\w*.\f + \fr 6.40: \ft Lit.: κατηρτισμένος, “aperfeiçoado, plenamente formado”.\f*\x - \xo 6:40 \xt MAT 10:24; MAT 5:48; JHN 13:16; JHN 15:20; ISA 56:10; MAT 19:21\x*
\v 41 \w Por que|strong="G5101"\w* \w você olha|strong="G991"\w* \w o cisco|strong="G3588,G2595"\w* \w que está|strong="G3588,G1722"\w* \w no olho|strong="G3588,G3788"\w* \w do seu irmão|strong="G3588,G80,G4771"\w*, \w e|strong="G1161"\w* \w não|strong="G3756"\w* \w percebe|strong="G2657"\w* \w a trave|strong="G3588,G1385"\w* \w que está|strong="G3588,G1722"\w* \w no seu próprio olho|strong="G3588,G2398,G3788"\w*?\f + \fr 6.41: \ft Acréscimo: “que está”, “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 6:41 \xt MAT 7:3; MAT 7:4; MAT 7:5; MAT 7:1; JHN 8:7; JAS 1:24\x*
\v 42 \w Como|strong="G4459"\w* \w pode|strong="G1410"\w* \w dizer|strong="G3004"\w* \w ao seu irmão|strong="G3588,G80,G4771"\w*: ‘\w Irmão|strong="G80"\w*, \w deixe|strong="G863"\w* \w que eu tire|strong="G1544"\w* \w o cisco|strong="G3588,G2595"\w* \w que está|strong="G3588,G1722"\w* \w no seu olho|strong="G3588,G3788,G4771"\w*’, \w você mesmo|strong="G846"\w* \w que não vê|strong="G3756,G991"\w* \w a trave|strong="G3588,G1385"\w* \w no seu olho|strong="G1722,G3588,G3788,G4771"\w*? \w Hipócrita|strong="G5273"\w*, \w tire|strong="G1544"\w* \w primeiro|strong="G4413"\w* \w a trave|strong="G3588,G1385"\w* \w do seu olho|strong="G1537,G3588,G3788,G4771"\w*, \w e|strong="G2532"\w* \w então|strong="G5119"\w* \w enxergará bem|strong="G1227"\w* \w para tirar|strong="G1544"\w* \w o cisco|strong="G3588,G2595"\w* \w que está|strong="G3588,G1722"\w* \w no olho|strong="G3588,G3788"\w* \w do seu irmão|strong="G3588,G80,G4771"\w*.\f + \fr 6.42: \ft Acréscimo: “que está”, “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 6:42 \xt MAT 7:5; MAT 7:3; MAT 7:4; ROM 2:21-29; 1PE 2:1; 1TH 2:10-12\x*
\p
\v 43 \w Pois|strong="G1063"\w* \w não há|strong="G3756,G1510"\w* \w árvore boa|strong="G1186,G2570"\w* \w que produza|strong="G4160"\w* \w fruto podre|strong="G2590,G4550"\w*, \w nem|strong="G3761"\w* \w por outro lado|strong="G3825"\w* \w árvore podre|strong="G1186,G4550"\w* \w que produza|strong="G4160"\w* \w fruto bom|strong="G2590,G2570"\w*.\x - \xo 6:43 \xt MAT 12:33; MAT 7:18; MAT 7:17; MAT 3:10; MAT 7:16; JER 2:21\x*
\v 44 \w Pois|strong="G1063"\w* \w cada árvore|strong="G1538,G1186"\w* \w é conhecida|strong="G1097"\w* \w pelo seu próprio fruto|strong="G1537,G3588,G2398,G2590"\w*; \w pois|strong="G1063"\w* \w não colhem|strong="G3756,G4816"\w* \w figos|strong="G4810"\w* \w de espinhos|strong="G1537,G173"\w*, \w nem|strong="G3761"\w* \w vindimam|strong="G5166"\w* \w uvas|strong="G4718"\w* \w de um espinheiro|strong="G1537,G942"\w*.\x - \xo 6:44 \xt MAT 7:16; MAT 12:33; JAS 3:12; GEN 1:12; GEN 1:11; PRO 20:11\x*
\v 45 \w A pessoa boa|strong="G3588,G18,G444"\w*, \w do bom|strong="G1537,G3588,G18"\w* \w tesouro|strong="G2344"\w* \w do seu coração|strong="G3588,G2588,G846"\w*, \w produz|strong="G4393"\w* \w o que é bom|strong="G3588,G18"\w*; \w e|strong="G2532"\w* \w a má|strong="G3588,G4190"\w*, \w do mau|strong="G1537,G3588,G4190"\w*, \w produz|strong="G4393"\w* \w o que é mau|strong="G3588,G4190"\w*; \w pois|strong="G1063"\w* \w da abundância|strong="G1537,G4051"\w* \w do coração|strong="G2588"\w* \w fala|strong="G2980"\w* \w a sua boca|strong="G3588,G4750,G846"\w*.\f + \fr 6.45: \ft Variante: WH e NA28 omitem “dele” (αὐτοῦ) depois de “coração”; o RP acrescenta “homem” (ἄνθρωπος) depois de “mau” e, depois de “do mau”, “tesouro do seu coração” (também NIV); o RP lê τοῦ περισσεύματος τῆς (“da abundância do”) em lugar de περισσεύματος.\f*\f + \fr 6.45: \ft Acréscimo: verbo ser/estar suprido em “o que é bom”, “o que é mau”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:45 \xt MAT 12:34; PRO 4:23; MAT 12:35; EPH 4:29; JHN 7:38; PSA 37:30-31\x*
\p
\v 46 \w Por que|strong="G5101"\w* \w me chamam|strong="G3165,G2564"\w*: ‘\w Senhor|strong="G2962"\w*, \w Senhor|strong="G2962"\w*’, \w e|strong="G2532"\w* \w não fazem|strong="G3756,G4160"\w* \w o que|strong="G3739"\w* \w digo|strong="G3004"\w*?\x - \xo 6:46 \xt JAS 1:22; MAT 7:21; MAL 1:6; GAL 6:7; MAT 11:29; LUK 5:5\x*
\v 47 \w Todo|strong="G3956"\w* \w aquele que vem|strong="G3588,G2064"\w* \w a mim|strong="G4314,G3165"\w* \w e|strong="G2532"\w* \w ouve|strong="G191"\w* \w as minhas palavras|strong="G3165,G3588,G3056"\w* \w e|strong="G2532"\w* \w as pratica|strong="G4160,G846"\w*, \w mostrarei|strong="G5263"\w* \w a vocês|strong="G4771"\w* \w a quem|strong="G5101"\w* \w ele é semelhante|strong="G1510,G3664"\w*:\x - \xo 6:47 \xt JAS 1:22; MAT 7:24; LUK 11:28; MAT 11:29; LUK 5:5; 2PE 1:10\x*
\v 48 \w é semelhante|strong="G3664,G1510"\w* \w a um homem|strong="G444"\w* \w que constrói|strong="G3618"\w* \w uma casa|strong="G3614"\w*, \w o qual|strong="G3739"\w* \w cavou|strong="G4626"\w*, \w e|strong="G2532"\w* \w aprofundou|strong="G900"\w*, \w e|strong="G2532"\w* \w pôs|strong="G5087"\w* \w o alicerce|strong="G2310"\w* \w sobre a rocha|strong="G1909,G3588,G4073"\w*; \w mas quando houve|strong="G1161,G1096"\w* \w uma enchente|strong="G4132"\w*, \w o rio|strong="G3588,G4215"\w* \w se chocou|strong="G4366"\w* \w contra aquela casa|strong="G3588,G3614,G1565"\w*, \w e|strong="G2532"\w* \w não teve força|strong="G3756,G2480"\w* \w para abalá-la|strong="G4531,G846"\w*, \w por ter sido bem construída|strong="G1223,G3588,G2573,G3618,G846"\w*\f + \fr 6.48: \ft Variante: O RP traz “pois estava fundada sobre a rocha” (τεθεμελίωτο γὰρ ἐπὶ τὴν πέτραν) em lugar de “por ter sido bem construída”.\f*.\x - \xo 6:48 \xt JAS 1:22; MAT 7:24; LUK 11:28; MAT 11:29; 1CO 3:10-15; LUK 5:5\x*
\v 49 \w Mas aquele|strong="G3588,G1161"\w* \w que ouviu|strong="G191"\w* \w e|strong="G2532"\w* \w não praticou|strong="G3361,G4160"\w* \w é semelhante|strong="G3664,G1510"\w* \w a um homem|strong="G444"\w* \w que construiu|strong="G3618"\w* \w uma casa|strong="G3614"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w sem alicerce|strong="G5565,G2310"\w*; \w contra a qual|strong="G3739"\w* \w o rio|strong="G3588,G4215"\w* \w se chocou|strong="G4366"\w*, \w e|strong="G2532"\w* \w imediatamente|strong="G2112"\w* \w desabou|strong="G6081"\w*, \w e|strong="G2532"\w* \w foi|strong="G1096"\w* \w grande|strong="G3173"\w* \w a ruína|strong="G3588,G4485"\w* \w daquela casa|strong="G3588,G3614,G1565"\w*.”\x - \xo 6:49 \xt MAT 7:24; JAS 2:14; 2PE 1:10; JAS 1:25; MAT 7:26; JHN 2:5\x*
\c 7
\p
\v 1 \w Depois que|strong="G1894"\w* \w terminou|strong="G4137"\w* \w todas as suas palavras|strong="G3956,G3588,G4487,G846"\w* \w aos ouvidos|strong="G1519,G3588,G189"\w* \w do povo|strong="G3588,G2992"\w*, \w entrou|strong="G1525"\w* \w em Cafarnaum|strong="G1519,G2584"\w*.\f + \fr 7.1: \ft Lit.: ῥῆμα, “palavra, dito”.\f*\f + \fr 7.1: \ft Tradução: ἐπλήρωσεν (πληρόω, G4137) está aqui como “terminou”; o termo pode ser “cumprir”, “encher”, “completar” ou “levar à plenitude”, e o contexto decide.\f*\x - \xo 7:1 \xt MAT 8:5; LUK 7:1; MAT 7:28-29\x*
\v 2 \w O escravo|strong="G1401"\w* \w de um certo centurião|strong="G1543,G5100"\w*, \w estando mal|strong="G2560,G2192"\w*, \w estava para morrer|strong="G3195,G5053"\w*; \w o qual|strong="G3739"\w* \w lhe era|strong="G1510,G846"\w* \w muito estimado|strong="G1784"\w*\f + \fr 7.2: \ft Lit.: ἑκατόνταρχος, “centurião, oficial romano que comandava cerca de cem soldados”; ἔντιμος, “honrado, estimado, de grande valor”.\f*.\x - \xo 7:2 \xt MAT 8:5; LUK 7:1; 2KI 5:2-3; GEN 24:27; JHN 4:46; COL 3:22-4:1\x*
\v 3 \w Tendo ouvido|strong="G191"\w* \w a respeito de|strong="G4012,G3588"\w* \w Jesus|strong="G2424"\w* \w enviou|strong="G649"\w* \w a ele|strong="G4314,G846"\w* \w anciãos|strong="G4245"\w* \w dos judeus|strong="G3588,G2453"\w*, \w pedindo-lhe|strong="G2065,G846"\w* \w que viesse|strong="G3704,G2064"\w* \w salvar|strong="G1295"\w* \w o escravo|strong="G3588,G1401"\w* \w dele|strong="G846"\w*.\f + \fr 7.3: \ft Lit.: πρεσβύτερος, “mais velho”: pode designar a idade ou um líder do povo ou da comunidade; as traduções usam “ancião” ou “presbítero”, e este livro usa “anciãos”.\f*\x - \xo 7:3 \xt JAS 5:16; MAT 8:5; LUK 7:1; 1TH 5:13; LUK 4:38; JHN 4:47\x*
\v 4 \w Eles|strong="G3588"\w*, \w chegando|strong="G3854"\w* \w a Jesus|strong="G4314,G3588,G2424"\w*, \w lhe pediam|strong="G3870,G846"\w* \w com insistência|strong="G4709"\w*, \w dizendo|strong="G3004"\w*: “\w Ele é digno|strong="G514,G1510"\w* \w de que lhe conceda|strong="G3739,G3930"\w* \w isto|strong="G3778"\w*,\f + \fr 7.4: \ft Variante: O RP traz παρέξει (futuro) em lugar de παρέξῃ (subjuntivo).\f*\x - \xo 7:4 \xt JAS 5:16; MAT 8:5; LUK 7:1; 2TI 4:2; 1TH 5:13; LUK 4:38\x*
\v 5 \w pois|strong="G1063"\w* \w ama|strong="G25"\w* \w a nossa nação|strong="G3588,G1484,G3165"\w* \w e|strong="G2532"\w* \w ele mesmo|strong="G846"\w* \w nos construiu|strong="G3618,G3165"\w* \w a sinagoga|strong="G3588,G4864"\w*.”\x - \xo 7:5 \xt MAT 8:5; 2CH 2:11-12; LUK 7:1; 1TH 5:13; 1CH 29:3-9; 1JN 3:14\x*
\v 6 \w Jesus|strong="G3588,G2424"\w* \w foi|strong="G4198"\w* \w com eles|strong="G4862,G846"\w*. \w Já|strong="G2235"\w*, \w quando ele|strong="G846"\w* \w não estava|strong="G3756,G568"\w* \w longe|strong="G3112"\w* \w da casa|strong="G575,G3588,G3614"\w*, \w o centurião|strong="G3588,G1543"\w* \w enviou|strong="G3992"\w* \w amigos|strong="G5384"\w*, \w dizendo-lhe|strong="G3004,G846"\w*: “\w Senhor|strong="G2962"\w*, \w não se incomode|strong="G3361,G4660"\w*, \w pois|strong="G1063"\w* \w não sou|strong="G3756,G1510"\w* \w digno|strong="G2425"\w* \w de que você entre|strong="G2443,G1525"\w* \w debaixo do meu teto|strong="G5259,G3588,G4721,G3165"\w*\f + \fr 7.6: \ft Lit.: σκύλλω, “incomodar, molestar”; ἱκανός, “suficiente, digno”; στέγη, “teto, abrigo”.\f*;\x - \xo 7:6 \xt MAT 8:8; MAT 8:5; LUK 18:13; LUK 7:1; MRK 5:24; MRK 7:28\x*
\v 7 \w por isso|strong="G1352"\w* \w nem a mim mesmo|strong="G3761,G1473"\w* \w julguei digno|strong="G515"\w* \w de ir|strong="G2064"\w* \w até você|strong="G4314,G4771"\w*; \w mas|strong="G235"\w* \w diga|strong="G2036"\w* \w uma palavra|strong="G3056"\w*, \w e|strong="G2532"\w* \w seja curado|strong="G2390"\w* \w o meu servo|strong="G3588,G3816,G3165"\w*.\f + \fr 7.7: \ft Lit.: παῖς, “menino, servo, criança”: aqui, o mesmo δοῦλος do v. 2.\f*\x - \xo 7:7 \xt MAT 8:8; MAT 8:5; PSA 107:20; LUK 18:13; PSA 33:9; LUK 4:36\x*
\v 8 \w Pois|strong="G2532,G1063"\w* \w também eu|strong="G1473"\w* \w sou|strong="G1510"\w* \w um homem|strong="G444"\w* \w posto|strong="G5021"\w* \w sob autoridade|strong="G5259,G1849"\w*, \w tendo|strong="G2192"\w* \w soldados|strong="G4757"\w* \w sob mim|strong="G5259,G1473"\w*; \w e|strong="G2532"\w* \w digo|strong="G3004"\w* \w a este|strong="G3778"\w*: ‘\w Vá|strong="G4198"\w*’, \w e|strong="G2532"\w* \w ele vai|strong="G4198"\w*; \w e|strong="G2532"\w* \w a outro|strong="G243"\w*: ‘\w Venha|strong="G2064"\w*’, \w e|strong="G2532"\w* \w ele vem|strong="G2064"\w*; \w e|strong="G2532"\w* \w ao meu escravo|strong="G3588,G1401,G3165"\w*: ‘\w Faça|strong="G4160"\w* \w isto|strong="G3778"\w*’, \w e|strong="G2532"\w* \w ele faz|strong="G4160"\w*.”\x - \xo 7:8 \xt MAT 8:9; MAT 8:5; LUK 7:1; MRK 7:28; ISA 56:3; JHN 11:21\x*
\v 9 \w Ouvindo|strong="G191"\w* \w isto|strong="G3778"\w* \w Jesus|strong="G3588,G2424"\w* \w se admirou|strong="G2296"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w*, \w voltando-se|strong="G4762"\w* \w para a multidão|strong="G3588,G3793"\w* \w que o seguia|strong="G190,G846"\w*, \w disse|strong="G2036"\w*: “\w Digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w nem mesmo|strong="G3761"\w* \w em Israel|strong="G1722,G3588,G2474"\w* \w encontrei|strong="G2147"\w* \w tanta fé|strong="G5118,G4102"\w*.”\x - \xo 7:9 \xt MAT 8:10; MAT 8:5; MAT 15:28; LUK 7:1; ROM 3:1-3; JHN 11:21\x*
\v 10 \w E|strong="G2532"\w*, \w tendo voltado|strong="G5290"\w* \w para a casa|strong="G1519,G3588,G3624"\w*, \w os que foram enviados|strong="G3588,G3992"\w* \w encontraram|strong="G2147"\w* \w o escravo|strong="G3588,G1401"\w* \w saudável|strong="G5198"\w*.\f + \fr 7.10: \ft Variante: O RP traz “os enviados, para a casa” em outra ordem e acrescenta “doente” (ἀσθενοῦντα) antes de “escravo”.\f*\x - \xo 7:10 \xt MAT 8:5; LUK 7:1; JHN 4:50-53; MAT 8:13; ACT 10:38; JHN 11:21\x*
\p
\v 11 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w*, \w em seguida|strong="G1722,G3588,G1836"\w*, \w que ele foi|strong="G4198"\w* \w a uma cidade|strong="G1519,G4172"\w* \w chamada|strong="G2564"\w* \w Naim|strong="G3484"\w*, \w e|strong="G2532"\w* \w foram com ele|strong="G4848,G846"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w e|strong="G2532"\w* \w uma grande multidão|strong="G3793,G4183"\w*.\f + \fr 7.11: \ft Lit.: ἐν τῷ ἑξῆς, “no (tempo) seguinte”: “no dia seguinte” ou “logo depois”.\f*\f + \fr 7.11: \ft Variante: O SBLGNT lê ἐπορεύθη, com WH e NA28; Treg e RP lêem ἐπορεύετο (“ia”); o RP acrescenta “muitos” (ἱκανοί) depois de “os seus discípulos”.\f*\x - \xo 7:11 \xt LUK 14:25; ACT 10:38; LUK 9:37\x*
\v 12 \w Quando|strong="G5613"\w* \w se aproximou|strong="G1448"\w* \w da porta|strong="G3588,G4439"\w* \w da cidade|strong="G3588,G4172"\w* \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w estavam levando para fora|strong="G1580"\w* \w um morto|strong="G2348"\w*, \w filho único|strong="G3439,G5207"\w* \w da sua mãe|strong="G3588,G3384,G846"\w*, \w e|strong="G2532"\w* \w ela|strong="G846"\w* \w era viúva|strong="G1510,G5503"\w*; \w e|strong="G2532"\w* \w uma multidão considerável|strong="G3793,G2425"\w* \w da cidade|strong="G3588,G4172"\w* \w estava|strong="G1510"\w* \w com ela|strong="G4862,G846"\w*.\f + \fr 7.12: \ft Lit.: μονογενής, “único, filho único”.\f*\x - \xo 7:12 \xt HEB 11:35; MRK 1:41; ACT 10:38; ECC 7:4; 1TI 5:4-5; 2KI 4:20\x*
\v 13 \w E|strong="G2532"\w*, \w vendo-a|strong="G1492,G846"\w*, \w o Senhor|strong="G3588,G2962"\w* \w compadeceu-se|strong="G4697"\w* \w dela|strong="G1909,G846"\w*, \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Não chore|strong="G3361,G2799"\w*.”\f + \fr 7.13: \ft Lit.: ὁ κύριος, “o Senhor”: título que Lucas usa na narração para Jesus (também em 7:19); σπλαγχνίζομαι, “ter compaixão” (de σπλάγχνα, “entranhas”).\f*\x - \xo 7:13 \xt ISA 63:9; PSA 103:13; HEB 4:15; LAM 3:32-33; LUK 10:33; PSA 86:15\x*
\v 14 \w E|strong="G2532"\w*, \w aproximando-se|strong="G4334"\w*, \w tocou|strong="G681"\w* \w o esquife|strong="G3588,G4673"\w*, \w e|strong="G1161"\w* \w os que o carregavam|strong="G3588,G941"\w* \w pararam|strong="G2476"\w*; \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Jovem|strong="G3495"\w*, \w eu lhe digo|strong="G4771,G3004"\w*: \w levante-se|strong="G1453"\w*.”\f + \fr 7.14: \ft Lit.: σορός, “esquife, féretro aberto”; ἐγέρθητι, “levante-se, seja levantado”.\f*\x - \xo 7:14 \xt MAT 17:7; JHN 11:43; JHN 5:25; JHN 5:21; MRK 5:41; ACT 9:40-41\x*
\v 15 \w E|strong="G2532"\w* \w o morto|strong="G3588,G3498"\w* \w sentou-se|strong="G339"\w* \w e|strong="G2532"\w* \w começou|strong="G757"\w* \w a falar|strong="G2980"\w*, \w e|strong="G2532"\w* \w o entregou|strong="G1325,G846"\w* \w à sua mãe|strong="G3588,G3384,G846"\w*.\x - \xo 7:15 \xt JHN 5:21; MRK 5:41; JHN 11:44; HEB 11:35; JHN 11:43; 2KI 13:21\x*
\v 16 \w E|strong="G1161"\w* \w o temor|strong="G5401"\w* \w tomou|strong="G2983"\w* \w a todos|strong="G3956"\w*, \w e|strong="G2532"\w* \w glorificavam|strong="G1392"\w* \w a Deus|strong="G3588,G2316"\w*, \w dizendo|strong="G3004"\w*: “\w Um grande profeta|strong="G4396,G3173"\w* \w surgiu|strong="G1453"\w* \w entre nós|strong="G1722,G3165"\w*”, \w e|strong="G2532"\w* “\w Deus|strong="G3588,G2316"\w* \w visitou|strong="G1980"\w* \w o seu povo|strong="G3588,G2992,G846"\w*.”\f + \fr 7.16: \ft Tradução: ἠγέρθη (ἐγείρω, G1453) está aqui como “surgiu”; o termo pode ser “levantar”, “ressuscitar”, “despertar” ou “erguer”, e o contexto decide.\f*\x - \xo 7:16 \xt LUK 1:68; MAT 9:8; ACT 2:43; MAT 21:11; LUK 7:39; HEB 11:35\x*
\v 17 \w E|strong="G2532"\w* \w se espalhou|strong="G1831"\w* \w esta notícia|strong="G3588,G3056,G3778"\w* \w por toda|strong="G1722,G3650"\w* \w a Judeia|strong="G3588,G2449"\w* \w a respeito dele|strong="G4012,G846"\w* \w e|strong="G2532"\w* \w por toda|strong="G3956"\w* \w a região ao redor|strong="G3588,G4066"\w*.\f + \fr 7.17: \ft Lit.: λόγος, “palavra, notícia, relato”.\f*\x - \xo 7:17 \xt MRK 1:28; MAT 3:5; LUK 4:14; MAT 9:31; ACT 10:38; LUK 7:14\x*
\p
\v 18 \w E|strong="G2532"\w* \w os discípulos|strong="G3588,G3101"\w* \w dele|strong="G846"\w* \w informaram|strong="G518"\w* \w a João|strong="G2491"\w* \w a respeito de|strong="G4012"\w* \w todas estas coisas|strong="G3956,G3778"\w*. \w E|strong="G2532"\w* \w João|strong="G3588,G2491"\w*, \w chamando|strong="G4341"\w* \w dois|strong="G1417,G5100"\w* \w dos seus discípulos|strong="G3588,G3101,G846"\w*,\x - \xo 7:18 \xt MAT 11:2; JHN 3:26; MAT 11:4\x*
\v 19 \w os enviou|strong="G3992"\w* \w ao Senhor|strong="G4314,G3588,G2962"\w*, \w dizendo|strong="G3004"\w*: “\w Você|strong="G4771"\w* \w é|strong="G1510"\w* \w aquele que vem|strong="G3588,G2064"\w*, \w ou|strong="G2228"\w* \w esperamos|strong="G4328"\w* \w outro|strong="G243"\w*?”\f + \fr 7.19: \ft Lit.: ὁ ἐρχόμενος, “aquele que vem”: título do aguardado, o Messias.\f*\f + \fr 7.19: \ft Variante: O RP lê “Jesus” (Ἰησοῦν) em lugar de “o Senhor” (κύριον); o SBLGNT lê ἄλλον, com NA28 e RP, e WH e Treg lêem ἕτερον (“outro”, no mesmo sentido).\f*\x - \xo 7:19 \xt HEB 10:5; MAT 11:2; ISA 9:6-7; ACT 10:7-8; JHN 4:25; MAL 3:1\x*
\v 20 \w Chegando|strong="G3854"\w* \w a ele|strong="G4314,G846"\w* \w os homens|strong="G3588,G435"\w* \w disseram|strong="G2036"\w*: “\w João|strong="G2491"\w*, \w o Batista|strong="G3588,G910"\w*, \w nos enviou|strong="G649,G3165"\w* \w a você|strong="G4314,G4771"\w*, \w dizendo|strong="G3004"\w*: ‘\w Você|strong="G4771"\w* \w é|strong="G1510"\w* \w aquele que vem|strong="G3588,G2064"\w*, \w ou|strong="G2228"\w* \w esperamos|strong="G4328"\w* \w outro|strong="G243"\w*?’”\x - \xo 7:20 \xt ISA 35:5; MAT 3:1; MRK 8:28; MAT 11:2; ACT 2:22\x*
\v 21 \w Naquela hora|strong="G1722,G1565,G3588,G5610"\w* \w curou|strong="G2323"\w* \w muitos|strong="G4183"\w* \w de doenças|strong="G575,G3554"\w* \w e|strong="G2532"\w* \w de flagelos|strong="G3148"\w* \w e|strong="G2532"\w* \w de espíritos|strong="G4151"\w* \w maus|strong="G4190"\w*, \w e|strong="G2532"\w* \w a muitos cegos|strong="G5185,G4183"\w* \w concedeu como favor|strong="G5483"\w* \w ver|strong="G991"\w*\f + \fr 7.21: \ft Lit.: μάστιξ, “açoite, flagelo”, aqui doença grave; χαρίζομαι, “dar como favor, conceder”.\f*.\x - \xo 7:21 \xt ISA 35:5; MRK 3:10; MAT 11:5; MAT 9:27; ACT 10:38; ACT 1:1\x*
\v 22 \w E|strong="G2532"\w*, \w respondendo|strong="G611"\w*, \w lhes disse|strong="G2036,G846"\w*: “\w Vão|strong="G4198"\w* \add e\add* \w anunciem|strong="G518"\w* \w a João|strong="G2491"\w* \w o que|strong="G3739"\w* \w viram|strong="G1492"\w* \w e|strong="G2532"\w* \w ouviram|strong="G191"\w*: \w cegos|strong="G5185"\w* \w voltam a ver|strong="G308"\w*, \w coxos|strong="G5560"\w* \w andam|strong="G4043"\w*, \w leprosos|strong="G3015"\w* \w são purificados|strong="G2511"\w*, \w surdos|strong="G2974"\w* \w ouvem|strong="G191"\w*, \w mortos|strong="G3498"\w* \w são levantados|strong="G1453"\w*, \w pobres|strong="G4434"\w* \w recebem a boa notícia|strong="G2097"\w*;\f + \fr 7.22: \ft Nota cultural: ecoa Is 35:5-6 e 61:1 (cf. Lc 4:18).\f*\f + \fr 7.22: \ft Acréscimo: “e” (em “disse Vão e anunciem a”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 7:22 \xt ISA 61:1; LUK 4:18; ISA 35:5; MAT 11:5; ISA 29:18; MAT 4:23\x*
\v 23 \w e|strong="G2532"\w* \w feliz é|strong="G3107,G1510"\w* \w aquele|strong="G3739"\w* \w que não|strong="G1437,G3361"\w* \w tropeçar|strong="G4624"\w* \w por minha causa|strong="G1722,G1473"\w*.”\f + \fr 7.23: \ft Lit.: σκανδαλίζω, “fazer tropeçar, levar a cair; ofender”; ἐν ἐμοί, “em mim, a meu respeito”.\f*\x - \xo 7:23 \xt MAT 11:6; ISA 35:5; 1PE 2:7-8; ACT 10:38; ISA 8:14-15; ROM 9:32\x*
\p
\v 24 \w Depois que se foram|strong="G565"\w* \w os mensageiros|strong="G3588,G32"\w* \w de João|strong="G2491"\w* \w começou|strong="G757"\w* \w a dizer|strong="G3004"\w* \w às multidões|strong="G4314,G3588,G3793"\w* \w a respeito de João|strong="G4012,G2491"\w*: “\w O que|strong="G5101"\w* \w vocês saíram|strong="G1831"\w* \w para o deserto|strong="G1519,G3588,G2048"\w* \w para ver|strong="G2300"\w*? \w Um caniço|strong="G2563"\w* \w agitado|strong="G4531"\w* \w pelo vento|strong="G5259,G417"\w*?\f + \fr 7.24: \ft Lit.: ἄγγελος, “mensageiro” (também “anjo”): aqui, os enviados de João.\f*\x - \xo 7:24 \xt MAT 11:7; EPH 4:14; MAT 11:2; JHN 1:23; JHN 1:38; LUK 1:80\x*
\v 25 \w Mas|strong="G235"\w*, \w o que|strong="G5101"\w* \w vocês saíram|strong="G1831"\w* \w para ver|strong="G1492"\w*? \w Um homem|strong="G444"\w* \w vestido|strong="G294"\w* \w com roupas macias|strong="G1722,G3120,G2440"\w*? \w Olhem|strong="G2400"\w*, \w os que|strong="G3588"\w* \w têm|strong="G5225"\w* \w roupa|strong="G1722,G2441"\w* \w esplêndida|strong="G1741"\w* \w e|strong="G2532"\w* \w luxo|strong="G5172"\w* \w estão|strong="G1510"\w* \w nos palácios|strong="G1722,G3588,G933"\w*.\x - \xo 7:25 \xt MAT 11:8; MAT 11:2; JHN 1:38; MAT 11:7; 1KI 10:5; 1TI 5:6\x*
\v 26 \w Mas|strong="G235"\w*, \w o que|strong="G5101"\w* \w vocês saíram|strong="G1831"\w* \w para ver|strong="G1492"\w*? \w Um profeta|strong="G4396"\w*? \w Sim|strong="G3483"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*, \w e|strong="G2532"\w* \w mais do que|strong="G4055"\w* \w um profeta|strong="G4396"\w*.\x - \xo 7:26 \xt MAT 11:9; MAT 11:10; MAL 3:1; LUK 16:16; MAL 4:5; MAT 11:2\x*
\v 27 \w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w aquele sobre quem|strong="G4012,G3739"\w* \w está escrito|strong="G1125"\w*: ‘\w Olhe|strong="G2400"\w*, \w envio|strong="G649"\w* \w o meu mensageiro|strong="G3588,G32,G3165"\w* \w à sua frente|strong="G4253,G4383,G4771"\w*, \w que preparará|strong="G3739,G2680"\w* \w o seu caminho|strong="G3588,G3598,G4771"\w* \w diante de você|strong="G1715,G4771"\w*.’\f + \fr 7.27: \ft Nota cultural: cita Ml 3:1 (com eco de Êx 23:20); cf. Mc 1:2.\f*\f + \fr 7.27: \ft Tradução: ἄγγελόν (ἄγγελος, G32) está aqui como “o meu mensageiro”; o termo pode ser “anjo” (mensageiro celeste) ou “mensageiro” (humano), e o contexto decide.\f*\x - \xo 7:27 \xt MRK 1:2; MAL 3:1; EXO 23:20; MAT 11:10; LUK 1:76; LUK 16:16\x*
\v 28 \w Digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w entre os nascidos de mulheres|strong="G1722,G1084,G1135"\w*, \w ninguém|strong="G3762"\w* \w é|strong="G1510"\w* \w maior|strong="G3173"\w* \w do que João|strong="G2491"\w*; \w mas o menor|strong="G3588,G1161,G3398"\w* \w no reino|strong="G1722,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w é maior|strong="G3173,G1510"\w* \w do que ele|strong="G846"\w*.”\f + \fr 7.28: \ft Variante: O RP acrescenta “pois” (γάρ) depois de “Digo”; Treg e RP acrescentam “profeta” (προφήτης) antes de “do que João” e o RP traz ainda “o Batista” (τοῦ βαπτιστοῦ) depois de “João”.\f*\x - \xo 7:28 \xt MAT 11:11; MAL 3:1; HEB 11:39-40; MAT 13:16-17; COL 1:25-27; LUK 16:16\x*
\v 29 (\w E|strong="G2532"\w* \w todo o povo|strong="G3956,G3588,G2992"\w* \w que ouviu|strong="G191"\w*, \w e|strong="G2532"\w* \w os cobradores de impostos|strong="G3588,G5057"\w*, \w declararam justo|strong="G1344"\w* \w a Deus|strong="G3588,G2316"\w*, \w tendo sido batizados|strong="G907"\w* \w com o batismo|strong="G3588,G908"\w* \w de João|strong="G2491"\w*;\f + \fr 7.29: \ft Lit.: δικαιόω, “declarar justo”: aqui “reconhecer que Deus é justo (que o seu plano está certo)”.\f*\x - \xo 7:29 \xt ACT 19:3; LUK 20:4; LUK 3:12; ACT 19:4; MAT 21:25; MRK 11:30\x*
\v 30 \w os fariseus|strong="G3588,G5330"\w* \w e|strong="G2532"\w* \w os especialistas na Lei|strong="G3588,G3544"\w* \w rejeitaram|strong="G114"\w* \w o propósito|strong="G3588,G1012"\w* \w de Deus|strong="G3588,G2316"\w* \w quanto a si mesmos|strong="G1519,G1438"\w*, \w não tendo sido batizados|strong="G3361,G907"\w* \w por ele|strong="G5259,G846"\w*.)\f + \fr 7.30: \ft Lit.: νομικός, “especialista na Lei, jurista”; βουλή, “plano, propósito, desígnio”.\f*\f + \fr 7.30: \ft Variante: O TR traz “Disse o Senhor” (Εἶπεν δὲ ὁ κύριος) antes de “A quem compararei…”.\f*\x - \xo 7:30 \xt MAT 11:12; PRO 1:25; JHN 1:24; JHN 12:48; LUK 13:34; MAT 11:2\x*
\v 31 “\w A quem|strong="G5101"\w*, \w então|strong="G3767"\w*, \w compararei|strong="G3666"\w* \w as pessoas|strong="G3588,G444"\w* \w desta geração|strong="G3588,G1074,G3778"\w*, \w e|strong="G2532"\w* \w a quem|strong="G5101"\w* \w são semelhantes|strong="G1510,G3664"\w*?\x - \xo 7:31 \xt LUK 13:18; MAT 11:16; MAT 11:2; DEU 32:20; LAM 2:13; MAT 21:25\x*
\v 32 \w São semelhantes|strong="G3664,G1510"\w* \w a crianças|strong="G3813"\w* \w que estão sentadas|strong="G3588,G2521"\w* \w na praça|strong="G1722,G58"\w* \w e|strong="G2532"\w* \w chamam|strong="G4377"\w* \w umas às outras|strong="G240"\w*, \w dizendo|strong="G3739,G3004"\w*: ‘\w Tocamos flauta|strong="G832"\w* \w para vocês|strong="G4771"\w*, \w e|strong="G2532"\w* \w vocês não dançaram|strong="G3756,G3738"\w*; \w cantamos lamentos|strong="G2354"\w*, \w e|strong="G2532"\w* \w vocês não choraram|strong="G3756,G2799"\w*.’\x - \xo 7:32 \xt MAT 11:16; MAT 11:17; MAT 11:2; DEU 32:20; JER 5:3-5; PRO 17:16\x*
\v 33 \w Pois|strong="G1063"\w* \w veio|strong="G2064"\w* \w João|strong="G2491"\w*, \w o Batista|strong="G3588,G910"\w*, \w sem comer|strong="G3361,G2068"\w* \w pão|strong="G740"\w* \w nem beber|strong="G3383,G4095"\w* \w vinho|strong="G3631"\w*, \w e|strong="G2532"\w* \w vocês dizem|strong="G3004"\w*: ‘\w Tem|strong="G2192"\w* \w um demônio|strong="G1140"\w*.’\x - \xo 7:33 \xt MAT 11:18; MAT 5:11; LUK 1:15; MAT 11:16; MAT 11:2; MRK 1:6\x*
\v 34 \w Veio|strong="G2064"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w*, \w comendo|strong="G2068"\w* \w e|strong="G2532"\w* \w bebendo|strong="G4095"\w*, \w e|strong="G2532"\w* \w vocês dizem|strong="G3004"\w*: ‘\w Olhem|strong="G2400"\w*, \w um homem|strong="G444"\w* \w comilão|strong="G5314"\w* \w e|strong="G2532"\w* \w beberrão|strong="G3630"\w*, \w amigo|strong="G5384"\w* \w de cobradores de impostos|strong="G5057"\w* \w e|strong="G2532"\w* \w pecadores|strong="G268"\w*.’\x - \xo 7:34 \xt MAT 11:19; MAT 9:11; MAT 5:11; LUK 19:7; MAT 11:16; LUK 15:2\x*
\v 35 \w E|strong="G2532"\w* \w a sabedoria|strong="G3588,G4678"\w* \w foi declarada justa|strong="G1344"\w* \w por todos|strong="G575,G3956"\w* \w os seus filhos|strong="G3588,G5043,G846"\w*.”\f + \fr 7.35: \ft Lit.: ἐδικαιώθη, “foi declarada justa” ou “foi reconhecida como justa”; “os filhos da sabedoria” são os que a acolhem.\f*\x - \xo 7:35 \xt MAT 11:19; PRO 8:32-36; 1CO 2:14-15; HOS 14:9; PRO 17:16; 1CO 1:24\x*
\p
\v 36 \w Um certo|strong="G5100"\w* \w dos fariseus|strong="G3588,G5330"\w* \w lhe pedia|strong="G2065,G846"\w* \w que comesse|strong="G2443,G5315"\w* \w com ele|strong="G3326,G846"\w*; \w e|strong="G2532"\w*, \w entrando|strong="G1525"\w* \w na casa|strong="G1519,G3588,G3624"\w* \w do fariseu|strong="G3588,G5330"\w*, \w reclinou-se à mesa|strong="G2625"\w*.\f + \fr 7.36: \ft Lit.: κατακλίνομαι, “reclinar-se (à mesa, como se fazia nas refeições)”.\f*\f + \fr 7.36: \ft Variante: O RP traz τὴν οἰκίαν (“a casa”, outra palavra) em lugar de τὸν οἶκον e ἀνεκλίθη (“reclinou-se”) em lugar de κατεκλίθη.\f*\x - \xo 7:36 \xt LUK 14:1; LUK 11:37; MRK 14:3-9; MAT 11:19; MAT 26:5-6; JHN 11:2-16\x*
\v 37 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w uma mulher|strong="G1135"\w* \w que era|strong="G3748,G1510"\w* \w pecadora|strong="G268"\w* \w na cidade|strong="G1722,G3588,G4172"\w*, \w e|strong="G2532"\w*, \w sabendo|strong="G1921"\w* \w que|strong="G3754"\w* \w ele estava à mesa|strong="G2621"\w* \w na casa|strong="G1722,G3588,G3614"\w* \w do fariseu|strong="G3588,G5330"\w*, \w trazendo|strong="G2865"\w* \w um frasco de alabastro|strong="G211"\w* \w com perfume|strong="G3464"\w*,\f + \fr 7.37: \ft Lit.: ἁμαρτωλός, “pecadora”: o texto não diz em que consistia o pecado; ἀλάβαστρον, “frasco de alabastro”.\f*\x - \xo 7:37 \xt MRK 14:3; MAT 26:7; MAT 26:6; JHN 12:3; JHN 11:2; MAT 21:31\x*
\v 38 \w e|strong="G2532"\w*, \w parando|strong="G2476"\w* \w atrás|strong="G3694"\w* \w junto aos pés|strong="G3844,G3588,G4228"\w* \w dele|strong="G846"\w*, \w chorando|strong="G2799"\w*, \w começou|strong="G757"\w* \w a molhar|strong="G1026"\w* \w os pés|strong="G3588,G4228"\w* \w dele|strong="G846"\w* \w com as lágrimas|strong="G3588,G1144"\w*, \w e|strong="G2532"\w* \w os enxugava|strong="G1591"\w* \w com os cabelos|strong="G3588,G2359"\w* \w da sua cabeça|strong="G3588,G2776,G846"\w*, \w e|strong="G2532"\w* \w beijava ternamente|strong="G2705"\w* \w os pés|strong="G3588,G4228"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w os ungia|strong="G218"\w* \w com o perfume|strong="G3588,G3464"\w*.\x - \xo 7:38 \xt JHN 11:2; LUK 7:44; JHN 12:3; MRK 14:3; MAT 26:6; MAT 5:4\x*
\v 39 \w Vendo isso|strong="G1492"\w* \w o fariseu|strong="G3588,G5330"\w* \w que o havia convidado|strong="G3588,G2564,G846"\w* \w disse|strong="G2036"\w* \w consigo mesmo|strong="G1722,G1438"\w*, \w dizendo|strong="G3004"\w*: “\w Este|strong="G3778"\w*, \w se fosse|strong="G1487,G1510"\w* \w profeta|strong="G4396"\w*, \w saberia|strong="G1097,G302"\w* \w quem|strong="G5101"\w* \w e|strong="G2532"\w* \w que tipo de|strong="G4217"\w* \w mulher|strong="G3588,G1135"\w* \w é essa que|strong="G3748"\w* \w o toca|strong="G681,G846"\w*, \w pois|strong="G3754"\w* \w é|strong="G1510"\w* \w pecadora|strong="G268"\w*.”\f + \fr 7.39: \ft Acréscimo: verbo ser/estar suprido em “é essa que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:39 \xt PRO 23:7; MRK 14:3; LUK 19:7; MAT 26:6; PSA 51:17; LUK 15:2\x*
\v 40 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w lhe disse|strong="G2036,G4314,G846"\w*: “\w Simão|strong="G4613"\w*, \w tenho|strong="G2192"\w* \w algo|strong="G5100"\w* \w a dizer|strong="G2036"\w* \w a você|strong="G4771"\w*.” \w Ele|strong="G3588"\w* \w disse|strong="G5346"\w*: “\w Mestre|strong="G1320"\w*, \w diga|strong="G2036"\w*.”\x - \xo 7:40 \xt MAT 6:12; PSA 51:17; MAT 21:31; EPH 1:7; MAT 21:32; MRK 10:31\x*
\v 41 “\w Havia|strong="G1510"\w* \w dois devedores|strong="G1417,G5533"\w* \w de um certo credor|strong="G1157,G5100"\w*: \w um|strong="G3588,G1520"\w* \w devia|strong="G3784"\w* \w quinhentos denários|strong="G1220,G4001"\w*, \w e|strong="G1161"\w* \w o outro|strong="G3588,G2087"\w* \w cinquenta|strong="G4004"\w*.\f + \fr 7.41: \ft Lit.: δηνάριον, moeda romana de prata; em Mt 20:2 é o pagamento de um dia de trabalho.\f*\x - \xo 7:41 \xt MAT 20:2; LUK 16:5; MAT 6:12; PSA 51:17; MAT 21:31; EPH 1:7\x*
\v 42 \w Como eles não tinham|strong="G3361,G2192,G846"\w* \w com que pagar|strong="G591"\w*, \w perdoou a dívida|strong="G5483"\w* \w de ambos|strong="G297"\w*. \w Qual|strong="G5101"\w* \w deles|strong="G846"\w*, \w então|strong="G3767"\w*, \w mais|strong="G4119"\w* \w o amará|strong="G25,G846"\w*?”\f + \fr 7.42: \ft Lit.: χαρίζομαι, “dar graciosamente, perdoar (uma dívida)”.\f*\x - \xo 7:42 \xt MAT 6:12; PSA 51:17; MAT 21:31; EPH 1:7; LUK 10:36; LUK 7:47\x*
\v 43 \w Respondendo|strong="G611"\w*, \w Simão|strong="G4613"\w* \w disse|strong="G2036"\w*: “\w Suponho|strong="G5274"\w* \w que|strong="G3754"\w* \w aquele a quem|strong="G3739"\w* \w mais|strong="G3588,G4119"\w* \w perdoou|strong="G5483"\w*.” \w Ele|strong="G3588"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Você julgou|strong="G2919"\w* \w corretamente|strong="G3723"\w*.”\x - \xo 7:43 \xt LUK 10:28; MAT 6:12; PSA 51:17; MAT 21:31; LUK 7:47; MAT 18:26\x*
\v 44 \w E|strong="G2532"\w*, \w voltando-se|strong="G4762"\w* \w para a mulher|strong="G4314,G3588,G1135"\w*, \w disse|strong="G5346"\w* \w a Simão|strong="G3588,G4613"\w*: “\w Você vê|strong="G991"\w* \w esta mulher|strong="G3778,G3588,G1135"\w*? \w Entrei|strong="G1525"\w* \w na sua casa|strong="G4771,G1519,G3588,G3614"\w*; \w água|strong="G5204"\w* \w para os meus pés|strong="G3165,G1909,G4228"\w* \w você não deu|strong="G3756,G1325"\w*; \w esta|strong="G3778"\w*, \w porém|strong="G1161"\w*, \w molhou|strong="G1026"\w* \w os meus pés|strong="G3165,G3588,G4228"\w* \w com as lágrimas|strong="G3588,G1144"\w* \w e|strong="G2532"\w* \w os enxugou|strong="G1591"\w* \w com os cabelos dela|strong="G3588,G2359,G846"\w*.\f + \fr 7.44: \ft Variante: O RP omite “a mim” (μοι), lê τοὺς πόδας μου (“os meus pés”) em lugar de “pés” e acrescenta “da cabeça” (τῆς κεφαλῆς) depois de “cabelos”.\f*\x - \xo 7:44 \xt LUK 7:38; MAT 6:12; JHN 13:5; PSA 51:17; 1TI 5:10; 1CO 13:7\x*
\v 45 \w Beijo|strong="G5370"\w* \w você não me deu|strong="G3165,G3756,G1325"\w*; \w esta|strong="G3778"\w*, \w porém|strong="G1161"\w*, \w desde que|strong="G575,G3739"\w* \w entrei|strong="G1525"\w*, \w não parou|strong="G3756,G1257"\w* \w de beijar|strong="G2705"\w* \w os meus pés|strong="G3165,G3588,G4228"\w*.\x - \xo 7:45 \xt MAT 6:12; PSA 51:17; 1CO 13:7; MAT 21:31; ISA 61:2; JAS 2:3\x*
\v 46 \w Com óleo|strong="G1637"\w* \w a minha cabeça|strong="G3588,G2776,G3165"\w* \w você não ungiu|strong="G3756,G218"\w*; \w esta|strong="G3778"\w*, \w porém|strong="G1161"\w*, \w com perfume|strong="G3464"\w* \w ungiu|strong="G218"\w* \w os meus pés|strong="G3588,G4228,G3165"\w*.\x - \xo 7:46 \xt LUK 7:38; MAT 6:17; JHN 12:3; MAT 6:12; PSA 23:5; PSA 51:17\x*
\v 47 \w Por isso|strong="G3739,G5484"\w*, \w digo|strong="G3004"\w* \w a você|strong="G4771"\w*: \w estão perdoados|strong="G863"\w* \w os seus pecados|strong="G3588,G266,G846"\w*, \w os muitos|strong="G3588,G4183"\w*, \w porque|strong="G3754"\w* \w amou|strong="G25"\w* \w muito|strong="G4183"\w*; \w mas aquele a quem|strong="G3739,G1161"\w* \w pouco|strong="G3641"\w* \w é perdoado|strong="G863"\w*, \w pouco|strong="G3641"\w* \w ama|strong="G25"\w*.”\f + \fr 7.47: \ft Lit.: ὅτι ἠγάπησεν πολύ, “porque amou muito”: o “porque” pode indicar a causa ou o sinal do perdão; ἀφέωνται, perfeito: “foram perdoados e continuam perdoados”.\f*\x - \xo 7:47 \xt LUK 5:20; 1JN 4:19; 1JN 3:18; PSA 103:3; ROM 12:1; GAL 5:6\x*
\v 48 \w Disse-lhe|strong="G2036,G846"\w*: “\w Os seus pecados|strong="G4771,G3588,G266"\w* \w estão perdoados|strong="G863"\w*.”\x - \xo 7:48 \xt LUK 5:20; ROM 4:7; 1JN 2:12; MRK 2:5; MAT 12:31; JHN 20:23\x*
\v 49 \w E|strong="G2532"\w* \w os que estavam à mesa com ele|strong="G3588,G4873"\w* \w começaram|strong="G757"\w* \w a dizer|strong="G3004"\w* \w entre si|strong="G1722,G1438"\w*: “\w Quem é|strong="G5101,G1510"\w* \w este|strong="G3778"\w* \w que até|strong="G3739,G2532"\w* \w perdoa|strong="G863"\w* \w pecados|strong="G266"\w*?”\x - \xo 7:49 \xt LUK 5:20; ROM 4:7; MRK 2:7; LUK 5:21; 1JN 2:12; MRK 2:5\x*
\v 50 \w Disse|strong="G2036"\w*, \w à mulher|strong="G4314,G3588,G1135"\w*: “\w A sua fé|strong="G3588,G4102,G4771"\w* \w salvou|strong="G4982"\w* \w você|strong="G4771"\w*; \w vá|strong="G4198"\w* \w em paz|strong="G1519,G1515"\w*.”\f + \fr 7.50: \ft Lit.: σέσωκεν, perfeito de σῴζω: “salvou, curou, libertou”.\f*\x - \xo 7:50 \xt LUK 8:48; LUK 18:42; MRK 5:34; MAT 9:22; EPH 2:8; ROM 5:1\x*
\c 8
\p
\v 1 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w*, \w em seguida|strong="G1722,G3588,G2517"\w*, \w que|strong="G2532"\w* \w ele|strong="G846"\w* \w percorria|strong="G1353"\w* \w de cidade em cidade|strong="G2596,G4172"\w* \w e|strong="G2532"\w* \w de povoado em povoado|strong="G2968"\w*, \w proclamando|strong="G2784"\w* \w e|strong="G2532"\w* \w anunciando a boa notícia|strong="G2097"\w* \w do reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*, \w e|strong="G2532"\w* \w os doze|strong="G3588,G1427"\w* \w com ele|strong="G4862,G846"\w*,\x - \xo 8:1 \xt LUK 4:43; LUK 2:10; MAT 4:23; MRK 1:14; ROM 10:15; ACT 10:38\x*
\v 2 \w e|strong="G2532"\w* \w algumas mulheres|strong="G1135,G5100"\w* \w que tinham sido curadas|strong="G3739,G1510,G2323"\w* \w de espíritos|strong="G575,G4151"\w* \w maus|strong="G4190"\w* \w e|strong="G2532"\w* \w doenças|strong="G769"\w*: \w Maria|strong="G3137"\w*, \w chamada|strong="G3588,G2564"\w* \w Madalena|strong="G3094"\w*, \w da qual|strong="G575,G3739"\w* \w tinham saído|strong="G1831"\w* \w sete demônios|strong="G1140,G2033"\w*,\f + \fr 8.2: \ft Lit.: Μαγδαληνή, “de Magdala”.\f*\x - \xo 8:2 \xt MRK 16:9; JHN 19:25; LUK 13:11; LUK 23:49; LUK 10:38; MRK 15:40\x*
\v 3 \w e|strong="G2532"\w* \w Joana|strong="G2489"\w*, \w mulher|strong="G1135"\w* \w de Cuza|strong="G5529"\w*, \w administrador|strong="G2012"\w* \w de Herodes|strong="G2264"\w*, \w e|strong="G2532"\w* \w Susana|strong="G4677"\w* \w e|strong="G2532"\w* \w muitas outras|strong="G2087,G4183"\w*, \w as quais|strong="G3748"\w* \w os serviam|strong="G1247,G846"\w* \w com os bens|strong="G1537,G3588,G5225"\w* \w delas|strong="G846"\w*.\f + \fr 8.3: \ft Lit.: ἐπίτροπος, “administrador, intendente, procurador”; διακονέω, “servir, prover o sustento”.\f*\f + \fr 8.3: \ft Variante: O RP lê ἀπό em lugar de ἐκ (“a partir de”); o sentido é o mesmo.\f*\x - \xo 8:3 \xt 1PE 4:10; LUK 10:38; ACT 9:36-39; 1PE 3:5; 1TI 5:10; 2CO 8:9\x*
\p
\v 4 \w Reunindo-se|strong="G4896"\w* \w uma grande multidão|strong="G3793,G4183"\w*, \w então|strong="G1161"\w*, \w e|strong="G2532"\w* \w os que de cada cidade|strong="G3588,G2596,G4172"\w* \w vinham|strong="G1975"\w* \w a ele|strong="G4314,G846"\w*, \w disse|strong="G2036"\w* \w por meio de uma parábola|strong="G1223,G3850"\w*:\x - \xo 8:4 \xt MAT 13:34; MRK 7:17; MAT 13:1; MRK 4:1; MAT 13:2\x*
\v 5 “\w O semeador|strong="G3588,G4687"\w* \w saiu|strong="G1831"\w* \w para semear|strong="G3588,G4687"\w* \w a sua semente|strong="G3588,G4703,G846"\w*. \w E|strong="G2532"\w*, \w ao semear|strong="G1722,G3588,G4687,G846"\w*, \w uma parte|strong="G3739,G3303"\w* \w caiu|strong="G4098"\w* \w à beira do caminho|strong="G3844,G3588,G3598"\w* \w e|strong="G2532"\w* \w foi pisada|strong="G2662"\w*, \w e|strong="G2532"\w* \w as aves|strong="G3588,G4071"\w* \w do céu|strong="G3588,G3772"\w* \w a comeram|strong="G2719,G846"\w*.\x - \xo 8:5 \xt MRK 4:4; MAT 13:4; MRK 4:3; HEB 2:1; JAS 1:23-24; MRK 4:15\x*
\v 6 \w E|strong="G2532"\w* \w outra parte|strong="G2087"\w* \w caiu|strong="G2667"\w* \w sobre a rocha|strong="G1909,G3588,G4073"\w*, \w e|strong="G2532"\w*, \w tendo brotado|strong="G5453"\w*, \w secou|strong="G3583"\w*, \w por não ter|strong="G1223,G3588,G3361,G2192"\w* \w umidade|strong="G2429"\w*.\x - \xo 8:6 \xt MAT 13:1; HEB 3:7-8; JUD 1:12; MRK 4:1; LUK 8:13; MRK 4:5\x*
\v 7 \w E|strong="G2532"\w* \w outra parte|strong="G2087"\w* \w caiu|strong="G4098"\w* \w no meio|strong="G1722,G3319"\w* \w dos espinhos|strong="G3588,G173"\w*, \w e|strong="G2532"\w* \w os espinhos|strong="G3588,G173"\w*, \w crescendo junto com ela|strong="G4855"\w*, \w a sufocaram|strong="G638,G846"\w*.\x - \xo 8:7 \xt MRK 4:7; JER 4:3; MAT 13:1; LUK 8:14; MRK 4:1; MAT 13:2\x*
\v 8 \w E|strong="G2532"\w* \w outra parte|strong="G2087"\w* \w caiu|strong="G4098"\w* \w na terra boa|strong="G1519,G3588,G1093,G18"\w*, \w e|strong="G2532"\w*, \w tendo brotado|strong="G5453"\w*, \w produziu|strong="G4160"\w* \w fruto|strong="G2590"\w* \w cem vezes maior|strong="G1542"\w*.” \w Dizendo|strong="G3004"\w* \w estas coisas|strong="G3778"\w*, \w exclamava|strong="G5455"\w*: “\w Quem tem|strong="G3588,G2192"\w* \w ouvidos|strong="G3775"\w* \w para ouvir|strong="G191"\w*, \w ouça|strong="G191"\w*.”\f + \fr 8.8: \ft Lit.: ἑκατονταπλασίων, “cem vezes mais, centuplicado”.\f*\x - \xo 8:8 \xt MAT 11:15; LUK 6:27; MAT 13:1; REV 2:11; MRK 4:1; PRO 18:15\x*
\v 9 \w Perguntavam-lhe|strong="G1905,G846"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w o que|strong="G5101"\w* \w significaria|strong="G1510"\w* \w esta parábola|strong="G3778,G3588,G3850"\w*.\x - \xo 8:9 \xt MRK 7:17; MAT 13:1; MRK 4:1; PRO 18:15; HOS 6:3; JHN 15:15\x*
\v 10 \w Ele|strong="G3588"\w* \w disse|strong="G2036"\w*: “\w A vocês|strong="G4771"\w* \w foi dado|strong="G1325"\w* \w conhecer|strong="G1097"\w* \w os mistérios|strong="G3588,G3466"\w* \w do reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*; \w mas aos demais|strong="G3588,G1161,G3062"\w*, \w em parábolas|strong="G1722,G3850"\w*, \w para que|strong="G2443"\w*, \w olhando|strong="G991"\w*, \w não vejam|strong="G3361,G991"\w* \w e|strong="G2532"\w*, \w ouvindo|strong="G191"\w*, \w não entendam|strong="G3361,G4920"\w*.\f + \fr 8.10: \ft Nota cultural: cita Is 6:9; cf. Mc 4:11-12 e Mt 13:11-15.\f*\x - \xo 8:10 \xt ISA 6:9; MRK 4:11; MAT 13:11; MRK 4:12; MAT 13:13; ACT 28:26\x*
\v 11 \w Ora|strong="G1161"\w*, \w a parábola|strong="G3588,G3850"\w* \w é esta|strong="G1510,G3778"\w*: \w a semente|strong="G3588,G4703"\w* \w é|strong="G1510"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 8:11 \xt HEB 4:12; ISA 55:11; ROM 10:17; MAT 13:19; JHN 17:17; 1PE 1:23-25\x*
\v 12 \w Ora|strong="G1161"\w*, \w os que|strong="G3588"\w* \w à beira do caminho|strong="G3844,G3588,G3598"\w* \w são|strong="G1510"\w* \w os que ouviram|strong="G3588,G191"\w*; \w depois|strong="G1534"\w* \w vem|strong="G2064"\w* \w o diabo|strong="G3588,G1228"\w* \w e|strong="G2532"\w* \w tira|strong="G142"\w* \w a palavra|strong="G3588,G3056"\w* \w do coração|strong="G575,G3588,G2588"\w* \w deles|strong="G846"\w*, \w para que não|strong="G2443,G3361"\w*, \w crendo|strong="G4100"\w*, \w sejam salvos|strong="G4982"\w*.\x - \xo 8:12 \xt MRK 4:15; ISA 55:11; MRK 16:16; MAT 13:19; 2TH 2:9-14; REV 12:9\x*
\v 13 \w Ora|strong="G1161"\w*, \w os que|strong="G3588"\w* \w sobre a rocha|strong="G1909,G3588,G4073"\w*: \w os que|strong="G3739"\w*, \w quando|strong="G3752"\w* \w ouvem|strong="G191"\w*, \w recebem com alegria|strong="G3326,G5479,G1209"\w* \w a palavra|strong="G3588,G3056"\w*; \w e|strong="G2532"\w* \w estes|strong="G3778"\w* \w não têm|strong="G3756,G2192"\w* \w raiz|strong="G4491"\w*, \w os quais|strong="G3739"\w* \w creem|strong="G4100"\w* \w por um tempo|strong="G4314,G2540"\w* \w e|strong="G2532"\w* \w em tempo|strong="G1722,G2540"\w* \w de provação|strong="G3986"\w* \w se afastam|strong="G868"\w*.\f + \fr 8.13: \ft Lit.: πειρασμός, “provação, tentação, prova”.\f*\x - \xo 8:13 \xt ISA 55:11; EPH 6:13; MAT 13:19; JHN 15:2; 1JN 2:19; 1CO 13:13\x*
\v 14 \w Ora|strong="G1161"\w*, \w o que|strong="G3588"\w* \w caiu|strong="G4098"\w* \w entre os espinhos|strong="G1519,G3588,G173"\w*: \w estes|strong="G3778"\w* \w são|strong="G1510"\w* \w os que ouviram|strong="G3588,G191"\w*, \w e|strong="G2532"\w*, \w seguindo o seu caminho|strong="G4198"\w*, \w são sufocados|strong="G4846"\w* \w pelas preocupações|strong="G5259,G3308"\w* \w e|strong="G2532"\w* \w pela riqueza|strong="G4149"\w* \w e|strong="G2532"\w* \w pelos prazeres|strong="G2237"\w* \w da vida|strong="G3588,G979"\w*, \w e|strong="G2532"\w* \w não amadurecem|strong="G3756,G5052"\w*.\f + \fr 8.14: \ft Lit.: τελεσφορέω, “levar o fruto até a maturidade”; βίος, “vida (modo de vida e meios de subsistência)”.\f*\x - \xo 8:14 \xt MAT 13:22; MRK 4:7; MRK 4:19; ISA 55:11; GAL 5:22; 2TI 2:4\x*
\v 15 \w Ora|strong="G1161"\w*, \w o que|strong="G3588"\w* \w na terra boa|strong="G1722,G3588,G2570,G1093"\w*: \w estes|strong="G3778"\w* \w são|strong="G1510"\w* \w os que|strong="G3748"\w*, \w com coração|strong="G1722,G2588"\w* \w nobre|strong="G2570"\w* \w e|strong="G2532"\w* \w bom|strong="G18"\w*, \w tendo ouvido|strong="G191"\w* \w a palavra|strong="G3588,G3056"\w*, \w a retêm|strong="G2722"\w* \w e|strong="G2532"\w* \w dão fruto|strong="G2592"\w* \w com perseverança|strong="G1722,G5281"\w*.\f + \fr 8.15: \ft Lit.: καλῇ καὶ ἀγαθῇ, “bela e boa” (“nobre e boa”): expressão para uma disposição íntegra; ὑπομονή, “perseverança, firmeza”.\f*\x - \xo 8:15 \xt MRK 4:20; COL 1:10; MAT 13:23; ISA 55:11; GAL 5:22; HEB 2:1\x*
\v 16 \w Ninguém|strong="G3762"\w*, \w porém|strong="G1161"\w*, \w tendo acendido|strong="G681"\w* \w uma lamparina|strong="G3088"\w*, \w a cobre|strong="G2572,G846"\w* \w com um vaso|strong="G4632"\w* \w ou|strong="G2228"\w* \w a põe|strong="G5087"\w* \w debaixo de uma cama|strong="G5270,G2825"\w*; \w mas|strong="G235"\w* \w a põe|strong="G5087"\w* \w sobre um candeeiro|strong="G1909,G3087"\w*, \w para que os que entram|strong="G2443,G3588,G1531"\w* \w vejam|strong="G991"\w* \w a luz|strong="G3588,G5457"\w*.\x - \xo 8:16 \xt LUK 11:33; MRK 4:21; ISA 55:11; MAT 5:15; ACT 26:18; PHP 2:15-16\x*
\v 17 \w Pois|strong="G1063"\w* \w não há|strong="G3756,G1510"\w* \w nada oculto|strong="G2927"\w* \w que não|strong="G3739,G3756"\w* \w se torne|strong="G1096"\w* \w manifesto|strong="G5318"\w*, \w nem|strong="G3761"\w* \w nada escondido|strong="G614"\w* \w que de modo nenhum|strong="G3739,G3756,G3361"\w* \w seja conhecido|strong="G1097"\w* \w e|strong="G2532"\w* \w venha à luz|strong="G1519,G5318,G2064"\w*.\x - \xo 8:17 \xt MRK 4:22; LUK 12:2; MAT 10:26; ECC 12:14; 1CO 4:5; LUK 11:33\x*
\v 18 \w Prestem atenção|strong="G991"\w*, \w então|strong="G3767"\w*, \w em como|strong="G4459"\w* \w ouvem|strong="G191"\w*; \w pois|strong="G1063"\w* \w a quem|strong="G3739,G302"\w* \w tiver|strong="G2192"\w*, \w lhe será dado|strong="G1325,G846"\w*; \w e|strong="G2532"\w* \w a quem|strong="G3739,G302"\w* \w não tiver|strong="G3361,G2192"\w*, \w até o que|strong="G2532,G3739"\w* \w pensa ter|strong="G1380,G2192"\w* \w lhe será tirado|strong="G142,G575,G846"\w*.”\x - \xo 8:18 \xt MRK 4:24; DEU 4:9; MAT 13:12; MAT 25:29; MRK 4:23-25; LUK 19:26\x*
\p
\v 19 \w Vieram|strong="G3854"\w* \w a ele|strong="G4314,G846"\w* \w a mãe|strong="G3588,G3384"\w* \w e|strong="G2532"\w* \w os irmãos|strong="G3588,G80"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w não conseguiam|strong="G3756,G1410"\w* \w chegar até ele|strong="G4940,G846"\w* \w por causa da multidão|strong="G1223,G3588,G3793"\w*.\x - \xo 8:19 \xt MAT 12:46; MRK 3:31; MRK 3:21\x*
\v 20 \w Foi dito|strong="G518"\w* \w a ele|strong="G846"\w*, \w então|strong="G1161"\w*: “\w A sua mãe|strong="G3588,G3384,G4771"\w* \w e|strong="G2532"\w* \w os seus irmãos|strong="G3588,G80,G4771"\w* \w estão em pé|strong="G2476"\w* \w do lado de fora|strong="G1854"\w*, \w querendo|strong="G2309"\w* \w ver você|strong="G1492,G4771"\w*.”\x - \xo 8:20 \xt MAT 12:46; MAT 12:47; MRK 3:31\x*
\v 21 \w Ele|strong="G3588"\w*, \w respondendo|strong="G611"\w*, \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Minha mãe|strong="G3384,G3165"\w* \w e|strong="G2532"\w* \w meus irmãos|strong="G80,G3165"\w* \w são estes|strong="G3778,G1510"\w*: \w os que ouvem|strong="G3588,G191"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w a praticam|strong="G4160"\w*.”\x - \xo 8:21 \xt MRK 3:33; MAT 12:48; LUK 1:60; LUK 11:28; ROM 10:17; MAT 12:50\x*
\p
\v 22 \w Aconteceu|strong="G1096,G1161"\w*, \w num|strong="G1722,G1520"\w* \w dos dias|strong="G3588,G2250"\w*, \w que|strong="G2532"\w* \w ele|strong="G846"\w* \w embarcou|strong="G1684"\w* \w num barco|strong="G1519,G4143"\w* \w e|strong="G2532"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w*, \w e|strong="G2532"\w* \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Passemos|strong="G1330"\w* \w para o outro lado|strong="G1519,G3588,G4008"\w* \w do lago|strong="G3588,G3041"\w*.” \w E|strong="G2532"\w* \w zarparam|strong="G321"\w*.\x - \xo 8:22 \xt MAT 8:23; MRK 4:35; MRK 8:13; MAT 14:22; MRK 6:45; LUK 5:1\x*
\v 23 \w Enquanto eles navegavam|strong="G4126,G846"\w* \w adormeceu|strong="G879"\w*. \w E|strong="G2532"\w* \w desceu|strong="G2597"\w* \w uma tempestade|strong="G2978"\w* \w de vento|strong="G417"\w* \w sobre o lago|strong="G1519,G3588,G3041"\w*, \w e|strong="G2532"\w* \w estavam sendo inundados|strong="G4845"\w*, \w e|strong="G2532"\w* \w corriam perigo|strong="G2793"\w*.\f + \fr 8.23: \ft Lit.: συνεπληροῦντο (passivo): “eram completamente enchidos”, isto é, “estavam sendo inundados”; o sujeito implícito são os que navegavam (ou o barco).\f*\f + \fr 8.23: \ft Lit.: λαῖλαψ, “tempestade violenta, turbilhão”; συμπληρόω, “encher completamente”.\f*\x - \xo 8:23 \xt PSA 107:29; MAT 8:23; MAT 8:24; LUK 8:22; MRK 4:37; ISA 54:11\x*
\v 24 \w E|strong="G1161"\w* \w aproximando-se|strong="G4334"\w*, \w o acordaram|strong="G1326,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Mestre|strong="G1988"\w*, \w mestre|strong="G1988"\w*, \w estamos perecendo|strong="G622"\w*!” \w Ele|strong="G3588"\w*, \w tendo acordado|strong="G1326"\w*, \w repreendeu|strong="G2008"\w* \w o vento|strong="G3588,G417"\w* \w e|strong="G2532"\w* \w a agitação|strong="G3588,G2830"\w* \w da água|strong="G3588,G5204"\w*; \w e|strong="G2532"\w* \w cessaram|strong="G3973"\w*, \w e|strong="G2532"\w* \w veio|strong="G1096"\w* \w uma calmaria|strong="G1055"\w*.\x - \xo 8:24 \xt MAT 8:26; PSA 107:29; MAT 8:23; LUK 5:5; JON 1:15; LUK 4:39\x*
\v 25 \w Disse-lhes|strong="G2036,G846"\w*, \w então|strong="G1161"\w*: “\w Onde está|strong="G4226"\w* \w a fé|strong="G3588,G4102"\w* \w de vocês|strong="G4771"\w*?” \w Amedrontados|strong="G5399"\w*, \w se admiraram|strong="G2296"\w*, \w dizendo|strong="G3004"\w* \w uns aos outros|strong="G4314,G240"\w*: “\w Quem|strong="G5101"\w* \w então|strong="G686"\w* \w é este|strong="G3778,G1510"\w*, \w que|strong="G3754"\w* \w até|strong="G2532"\w* \w aos ventos|strong="G3588,G417"\w* \w dá ordens|strong="G2004"\w* \w e|strong="G2532"\w* \w à água|strong="G3588,G5204"\w*, \w e|strong="G2532"\w* \w lhe obedecem|strong="G5219,G846"\w*?”\f + \fr 8.25: \ft Acréscimo: “Onde está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\f + \fr 8.25: \ft Tradução: φοβηθέντες (φοβέομαι, G5399) está aqui como “Amedrontados”; o termo pode ser “temer”, “ter medo” ou “reverenciar”, e o contexto decide.\f*\x - \xo 8:25 \xt MRK 4:41; MRK 4:40; PSA 107:29; MRK 4:35; MAT 8:26; MAT 8:23\x*
\p
\v 26 \w E|strong="G2532"\w* \w aportaram|strong="G2668"\w* \w na região|strong="G1519,G3588,G5561"\w* \w dos gerasenos|strong="G3588,G1086"\w*, \w que fica|strong="G3748,G1510"\w* \w do outro lado|strong="G495"\w* \w da Galileia|strong="G3588,G1056"\w*.\f + \fr 8.26: \ft Lit.: ἀντιπέρα, “do lado oposto, em frente”.\f*\f + \fr 8.26: \ft Variante: O RP lê Γαδαρηνῶν (“gadarenos”) em lugar de Γερασηνῶν (“gerasenos”).\f*\x - \xo 8:26 \xt MRK 5:1; MAT 8:28\x*
\v 27 \w Quando ele saiu|strong="G1831,G846"\w* \w para a terra|strong="G1909,G3588,G1093"\w* \w veio ao seu encontro|strong="G5221"\w* \w um certo|strong="G5100"\w* \w homem|strong="G435"\w* \w da cidade|strong="G1537,G3588,G4172"\w*, \w que tinha|strong="G2192"\w* \w demônios|strong="G1140"\w*; \w e|strong="G2532"\w* \w havia muito tempo|strong="G5550,G2425"\w* \w não vestia|strong="G3756,G1746"\w* \w roupa|strong="G2440"\w*, \w e|strong="G2532"\w* \w não ficava|strong="G3756,G3306"\w* \w em casa|strong="G1722,G3614"\w*, \w mas|strong="G235"\w* \w nos sepulcros|strong="G1722,G3588,G3418"\w*.\x - \xo 8:27 \xt MAT 8:28; MRK 5:1; LUK 13:11; MRK 5:15; LUK 8:35; LUK 8:43\x*
\v 28 \w Vendo|strong="G1492"\w* \w a Jesus|strong="G3588,G2424"\w* \w gritou|strong="G349"\w*, \w caiu diante dele|strong="G4363,G846"\w* \w e|strong="G2532"\w*, \w em alta voz|strong="G5456,G3173"\w*, \w disse|strong="G2036"\w*: “\w Que há entre mim e você|strong="G5101,G1473,G2532,G4771"\w*, \w Jesus|strong="G2424"\w*, \w Filho|strong="G5207"\w* \w do Deus|strong="G3588,G2316"\w* \w Altíssimo|strong="G3588,G5310"\w*? \w Suplico a você|strong="G1189,G4771"\w*: \w não me atormente|strong="G3361,G3165,G928"\w*.”\f + \fr 8.28: \ft Acréscimo: “Que há entre mim e você”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 8:28 \xt MRK 5:7; MAT 8:28; MRK 5:1; MAT 12:43; MAT 8:29; MRK 3:11\x*
\v 29 \w pois|strong="G1063"\w* \w ordenava|strong="G3853"\w* \w ao espírito|strong="G3588,G4151"\w* \w impuro|strong="G3588,G169"\w* \w que saísse|strong="G1831"\w* \w do homem|strong="G575,G3588,G444"\w*. \w Pois|strong="G1063"\w* \w por muito tempo|strong="G4183,G5550"\w* \w o tinha arrebatado|strong="G4884,G846"\w*; \w e|strong="G2532"\w* \w era amarrado|strong="G1195"\w* \w com correntes|strong="G254"\w* \w e|strong="G2532"\w* \w grilhões|strong="G3976"\w*, \w sob guarda|strong="G5442"\w*, \w e|strong="G2532"\w*, \w rompendo|strong="G1284"\w* \w as amarras|strong="G3588,G1199"\w*, \w era levado|strong="G1643"\w* \w pelo demônio|strong="G5259,G3588,G1140"\w* \w para lugares desertos|strong="G1519,G3588,G2048"\w*.\f + \fr 8.29: \ft Lit.: συναρπάζω, “arrebatar, apoderar-se com violência”; πέδη, “grilhão (para os pés)”.\f*\x - \xo 8:29 \xt MAT 8:28; MRK 5:1; MAT 12:43; ACT 19:15; MRK 5:3; MRK 9:20\x*
\v 30 \w Jesus|strong="G3588,G2424"\w* \w lhe perguntou|strong="G1905,G846"\w*: “\w Qual é|strong="G5101,G1510"\w* \w o seu nome|strong="G4771,G3686"\w*?” \w Ele|strong="G3588,G1161"\w* \w disse|strong="G2036"\w*: “\w Legião|strong="G3003"\w*”, \w porque|strong="G3754"\w* \w tinham entrado|strong="G1525"\w* \w muitos demônios|strong="G1140,G4183"\w* \w nele|strong="G1519,G846"\w*.\f + \fr 8.30: \ft Lit.: λεγιών, “legião”: unidade do exército romano, de milhares de soldados; aqui indica grande número.\f*\x - \xo 8:30 \xt MRK 5:9; MAT 8:28; MRK 5:1; MAT 12:43; MAT 26:53; LUK 8:2\x*
\v 31 \w E|strong="G2532"\w* \w lhe suplicavam|strong="G3870,G846"\w* \w que não lhes ordenasse|strong="G2443,G3361,G2004,G846"\w* \w ir embora|strong="G565"\w* \w para o abismo|strong="G1519,G3588,G12"\w*.\f + \fr 8.31: \ft Lit.: ἄβυσσος, “abismo, profundeza sem fundo”: lugar dos poderes das trevas (cf. Ap 9:1-2; 20:1-3).\f*\x - \xo 8:31 \xt REV 9:1; REV 20:1; MAT 8:28; MRK 5:1; MAT 12:43; 2PE 2:4\x*
\v 32 \w Havia|strong="G1510"\w* \w ali|strong="G1563"\w* \w uma manada|strong="G34"\w* \w de muitos porcos|strong="G5519,G2425"\w* \w pastando|strong="G1006"\w* \w no monte|strong="G1722,G3588,G3735"\w*; \w e|strong="G2532"\w* \w lhe suplicaram|strong="G3870,G846"\w* \w que lhes permitisse|strong="G2443,G2010,G846"\w* \w entrar neles|strong="G1519,G1565,G1525"\w*; \w e|strong="G2532"\w* \w ele lhes permitiu|strong="G2010,G846"\w*.\x - \xo 8:32 \xt MRK 5:11; MAT 8:30; MAT 8:31; MAT 8:28; MRK 5:1; MAT 12:43\x*
\v 33 \w Os demônios|strong="G3588,G1140"\w*, \w tendo saído|strong="G1831"\w* \w do homem|strong="G575,G3588,G444"\w*, \w entraram|strong="G1525"\w* \w nos porcos|strong="G1519,G3588,G5519"\w*; \w e|strong="G2532"\w* \w a manada|strong="G3588,G34"\w* \w se precipitou|strong="G3729"\w* \w pelo barranco|strong="G2596,G3588,G2911"\w* \w no lago|strong="G1519,G3588,G3041"\w* \w e|strong="G2532"\w* \w se afogou|strong="G638"\w*.\x - \xo 8:33 \xt MAT 8:32; MRK 5:13; MAT 8:31; MAT 8:28; MRK 5:1; JOB 38:11\x*
\v 34 \w Vendo|strong="G1492"\w* \w o que tinha acontecido|strong="G3588,G1096"\w* \w os que os pastoreavam|strong="G3588,G1006"\w* \w fugiram|strong="G5343"\w* \w e|strong="G2532"\w* \w deram a notícia|strong="G518"\w* \w na cidade|strong="G1519,G3588,G4172"\w* \w e|strong="G2532"\w* \w nos campos|strong="G1519,G3588,G68"\w*.\f + \fr 8.34: \ft Variante: O RP lê γεγενημένον (outra forma de “o que tinha acontecido”); o TR acrescenta “tendo ido embora” (ἀπελθόντες).\f*\x - \xo 8:34 \xt MRK 5:14; MAT 8:33; MAT 8:28; MRK 5:1; ACT 19:16-17; MAT 28:11\x*
\v 35 \w Saíram|strong="G1831"\w*, \w então|strong="G1161"\w*, \w para ver|strong="G1492"\w* \w o que tinha acontecido|strong="G3588,G1096"\w*, \w e|strong="G2532"\w* \w chegaram|strong="G2064"\w* \w a Jesus|strong="G4314,G3588,G2424"\w*, \w e|strong="G2532"\w* \w encontraram|strong="G2147"\w* \w o homem|strong="G3588,G444"\w* \w de quem|strong="G575,G3739"\w* \w tinham saído|strong="G1831"\w* \w os demônios|strong="G3588,G1140"\w* \w sentado|strong="G2521"\w*, \w vestido|strong="G2439"\w* \w e|strong="G2532"\w* \w em perfeito juízo|strong="G4993"\w*, \w aos pés|strong="G3844,G3588,G4228"\w* \w de Jesus|strong="G3588,G2424"\w*; \w e|strong="G2532"\w* \w ficaram com medo|strong="G5399"\w*.\f + \fr 8.35: \ft Lit.: σωφρονέω, “estar em juízo são, ser sensato”.\f*\x - \xo 8:35 \xt MRK 5:15; 2TI 1:7; MAT 8:28; MRK 5:1; LUK 10:39; LUK 15:17\x*
\v 36 \w Os que tinham visto|strong="G3588,G1492"\w* \w lhes contaram|strong="G518,G846"\w* \w como foi salvo|strong="G4459,G4982"\w* \w o endemoninhado|strong="G3588,G1139"\w*.\f + \fr 8.36: \ft Lit.: σῴζω, “salvar, curar, libertar”; δαιμονίζομαι, “estar sob o poder de demônios”.\f*\x - \xo 8:36 \xt MAT 8:33; MAT 8:28; MRK 5:1; MRK 5:15; MAT 4:24\x*
\v 37 \w E|strong="G2532"\w* \w toda a multidão|strong="G537,G3588,G4128"\w* \w da região ao redor|strong="G3588,G4066"\w* \w dos gerasenos|strong="G3588,G1086"\w* \w lhe pediu|strong="G2065,G846"\w* \w que se afastasse|strong="G565"\w* \w deles|strong="G575,G846"\w*, \w porque|strong="G3754"\w* \w estavam tomados|strong="G4912"\w* \w de grande medo|strong="G5401,G3173"\w*; \w ele|strong="G846"\w*, \w porém|strong="G1161"\w*, \w embarcando|strong="G1684"\w* \w num barco|strong="G1519,G4143"\w*, \w voltou|strong="G5290"\w*.\f + \fr 8.37: \ft Variante: O RP lê ἠρώτησαν (plural, “pediram”) em lugar de ἠρώτησεν, Γαδαρηνῶν (“gadarenos”) em lugar de Γερασηνῶν, e traz o artigo em εἰς τὸ πλοῖον.\f*\x - \xo 8:37 \xt MAT 8:28; MRK 5:1; ACT 2:43; MAT 8:34; MRK 5:17; MRK 8:13\x*
\v 38 \w Suplicava-lhe|strong="G1189,G846"\w* \w o homem|strong="G3588,G435"\w* \w de quem|strong="G575,G3739"\w* \w tinham saído|strong="G1831"\w* \w os demônios|strong="G3588,G1140"\w* \w para estar|strong="G1511"\w* \w com ele|strong="G4862,G846"\w*; \w mas|strong="G1161"\w* \add ele\add* \w o despediu|strong="G630,G846"\w*, \w dizendo|strong="G3004"\w*:\f + \fr 8.38: \ft Variante: O RP acrescenta “Jesus” (ὁ Ἰησοῦς) depois de “o”: “Jesus o despediu”.\f*\f + \fr 8.38: \ft Acréscimo: “ele” (em “ele mas ele o despediu”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 8:38 \xt MAT 8:28; MRK 5:1; MRK 5:18; MAT 8:34; JHN 1:38; JHN 17:15\x*
\v 39 “\w Volte|strong="G5290"\w* \w para a sua casa|strong="G1519,G3588,G3624,G4771"\w* \w e|strong="G2532"\w* \w conte|strong="G1334"\w* \w quanto|strong="G3745"\w* \w Deus|strong="G3588,G2316"\w* \w fez|strong="G4160"\w* \w por você|strong="G4771"\w*.” \w E|strong="G2532"\w* \w ele foi embora|strong="G565"\w*, \w proclamando|strong="G2784"\w* \w por toda|strong="G2596,G3650"\w* \w a cidade|strong="G3588,G4172"\w* \w quanto|strong="G3745"\w* \w Jesus|strong="G3588,G2424"\w* \w fez|strong="G4160"\w* \w por ele|strong="G846"\w*.\f + \fr 8.39: \ft Variante: O RP traz ἐποίησεν σοι em ordem diferente (“fez por você”); o TR traz “Aconteceu” (Ἐγένετο) no começo do versículo seguinte (v. 40).\f*\x - \xo 8:39 \xt MAT 8:28; MRK 5:1; MRK 5:18; 1TI 5:8; LUK 2:17; JHN 4:29\x*
\p
\v 40 \w Quando|strong="G1722,G3588"\w* \w voltou|strong="G5290"\w* \w Jesus|strong="G3588,G2424"\w* \w a multidão|strong="G3588,G3793"\w* \w o recebeu|strong="G588,G846"\w*, \w pois|strong="G1063"\w* \w todos|strong="G3956"\w* \w o esperavam|strong="G1510,G4328,G846"\w*.\x - \xo 8:40 \xt MRK 5:21; MAT 9:1; JHN 6:24; MRK 6:20\x*
\v 41 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w veio|strong="G2064"\w* \w um homem|strong="G435"\w* \w cujo nome|strong="G3739,G3686"\w* \add era\add* \w Jairo|strong="G2383"\w*, \w e|strong="G2532"\w* \w este|strong="G3778"\w* \w era chefe|strong="G758,G5225"\w* \w da sinagoga|strong="G3588,G4864"\w*; \w e|strong="G2532"\w*, \w caindo|strong="G4098"\w* \w aos pés|strong="G3844,G3588,G4228"\w* \w de Jesus|strong="G3588,G2424"\w*, \w lhe suplicava|strong="G3870,G846"\w* \w que entrasse|strong="G1525"\w* \w na sua casa|strong="G1519,G3588,G3624,G846"\w*,\f + \fr 8.41: \ft Acréscimo: “era” (em “cujo nome era Jairo e”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 8:41 \xt MRK 5:22; MAT 9:18; JHN 11:32; LUK 8:49; ACT 13:15; ACT 18:8\x*
\v 42 \w porque|strong="G3754"\w* \w ele tinha|strong="G1510,G846"\w* \w uma filha única|strong="G2364,G3439"\w* \w de cerca de|strong="G5613"\w* \w doze anos|strong="G2094,G1427"\w*, \w e|strong="G2532"\w* \w ela|strong="G846"\w* \w estava morrendo|strong="G599"\w*. \w Enquanto ele ia|strong="G1722,G3588,G5217,G846"\w* \w as multidões|strong="G3588,G3793"\w* \w o apertavam|strong="G4846,G846"\w*.\x - \xo 8:42 \xt LUK 7:50; MAT 9:18; LUK 7:12; LUK 8:45; MRK 5:22; MRK 5:24\x*
\v 43 \w E|strong="G2532"\w* \w uma mulher|strong="G1135"\w* \w que estava|strong="G1510"\w* \w com um fluxo|strong="G1722,G4511"\w* \w de sangue|strong="G129"\w* \w havia doze anos|strong="G575,G2094,G1427"\w*, \w a qual|strong="G3748"\w*, \w tendo gasto|strong="G4321"\w* \w com médicos|strong="G2395"\w* \w todo o seu sustento|strong="G3650,G3588,G979"\w*, \w não pôde|strong="G3756,G2480"\w* \w ser curada|strong="G2323"\w* \w por ninguém|strong="G575,G3762"\w*,\f + \fr 8.43: \ft Lit.: βίος, “vida, meios de vida, sustento”.\f*\x - \xo 8:43 \xt MRK 5:25; MAT 9:12; MAT 9:20; JHN 5:5; MAT 9:18; LEV 15:25\x*
\v 44 \w aproximando-se|strong="G4334"\w* \w por trás|strong="G3693"\w*, \w tocou|strong="G681"\w* \w a franja|strong="G3588,G2899"\w* \w do manto|strong="G3588,G2440"\w* \w dele|strong="G846"\w*; \w e|strong="G2532"\w* \w imediatamente|strong="G3916"\w* \w parou|strong="G2476"\w* \w o fluxo|strong="G3588,G4511"\w* \w de sangue|strong="G3588,G129"\w* \w dela|strong="G846"\w*.\f + \fr 8.44: \ft Lit.: κράσπεδον, “franja, orla, borla do manto” (as franjas prescritas em Nm 15:38-39).\f*\x - \xo 8:44 \xt NUM 15:38; MAT 9:20; MRK 5:27; MRK 5:25; MRK 6:56; MAT 9:18\x*
\v 45 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Quem|strong="G5101"\w* \w me tocou|strong="G3588,G681,G3165"\w*?” \w Como todos negavam|strong="G720,G3956"\w* \w Pedro|strong="G3588,G4074"\w* \w disse|strong="G2036"\w*: “\w Mestre|strong="G1988"\w*, \w as multidões|strong="G3588,G3793"\w* \w o comprimem|strong="G4912,G4771"\w* \w e|strong="G2532"\w* \w o apertam|strong="G598"\w*.”\f + \fr 8.45: \ft Variante: Treg e RP acrescentam “e os que estavam com ele” (καὶ οἱ σὺν αὐτῷ em Treg; καὶ οἱ μετʼ αὐτοῦ no RP) depois de “Pedro” e, no fim, “e você pergunta: Quem foi que me tocou?” (καὶ λέγεις Τίς ὁ ἁψάμενός μου).\f*\x - \xo 8:45 \xt MAT 9:20; MAT 9:18; MAT 9:21; LUK 6:19; LUK 8:42; LUK 9:13\x*
\v 46 \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Alguém|strong="G5100"\w* \w me tocou|strong="G681,G3165"\w*; \w pois|strong="G1063"\w* \w eu|strong="G1473"\w* \w percebi|strong="G1097"\w* \w que um poder|strong="G1411"\w* \w saiu|strong="G1831"\w* \w de mim|strong="G575,G1473"\w*.”\x - \xo 8:46 \xt LUK 6:19; MRK 5:30; MAT 9:20; MAT 9:18; MAT 9:21; LUK 5:17\x*
\v 47 \w A mulher|strong="G3588,G1135"\w*, \w vendo|strong="G1492"\w* \w que|strong="G3754"\w* \w não passara despercebida|strong="G3756,G2990"\w*, \w tremendo|strong="G5141"\w*, \w veio|strong="G2064"\w* \w e|strong="G2532"\w*, \w caindo diante dele|strong="G4363,G846"\w*, \w declarou|strong="G518"\w* \w diante de todo|strong="G1799,G3956,G3588"\w* \w o povo|strong="G2992"\w* \w por qual motivo|strong="G1223,G3739,G156"\w* \w o tocou|strong="G681,G846"\w* \w e|strong="G2532"\w* \w como|strong="G5613"\w* \w foi curada|strong="G2390"\w* \w imediatamente|strong="G3916"\w*.\x - \xo 8:47 \xt MRK 5:33; MAT 9:20; MAT 9:18; MAT 9:21; 1CO 2:3; LUK 17:15-16\x*
\v 48 \w Ele|strong="G3588"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Filha|strong="G2364"\w*, \w a sua fé|strong="G3588,G4102,G4771"\w* \w salvou|strong="G4982"\w* \w você|strong="G4771"\w*; \w vá|strong="G4198"\w* \w em paz|strong="G1519,G1515"\w*.”\f + \fr 8.48: \ft Variante: O RP lê “Tenha coragem, filha” (Θάρσει θύγατερ) em lugar de “Filha” (Θυγάτηρ).\f*\x - \xo 8:48 \xt LUK 7:50; MRK 5:34; LUK 17:19; MAT 9:22; LUK 18:42; ACT 14:9\x*
\v 49 \w Enquanto ele ainda falava|strong="G2089,G846,G2980"\w*, \w veio|strong="G2064"\w* \w alguém|strong="G5100"\w* \w da parte|strong="G3844,G3588"\w* \w do chefe da sinagoga|strong="G752"\w*, \w dizendo|strong="G3004"\w*: “\w A sua filha|strong="G3588,G2364,G4771"\w* \w morreu|strong="G2348"\w*; \w não incomode mais|strong="G3371,G4660"\w* \w o mestre|strong="G3588,G1320"\w*.”\f + \fr 8.49: \ft Variante: Treg e RP acrescentam “lhe” (αὐτῷ) depois de “dizendo”; o RP lê μή em lugar de μηκέτι (“não” em vez de “não mais”).\f*\x - \xo 8:49 \xt MRK 5:35; MAT 9:20; MAT 9:18; JHN 11:21; LUK 8:41; ISA 7:12\x*
\v 50 \w Jesus|strong="G3588,G2424"\w*, \w ouvindo isso|strong="G191"\w*, \w lhe respondeu|strong="G611,G846"\w*: “\w Não tenha medo|strong="G3361,G5399"\w*; \w somente|strong="G3441"\w* \w creia|strong="G4100"\w*, \w e|strong="G2532"\w* \w ela será salva|strong="G4982"\w*.”\x - \xo 8:50 \xt MRK 5:36; JHN 9:36; ACT 16:31; MAT 9:20; GEN 18:14; MAT 9:18\x*
\v 51 \w Chegando|strong="G2064"\w* \w à casa|strong="G1519,G3588,G3614"\w* \w não permitiu|strong="G3756,G863"\w* \w que ninguém|strong="G5100"\w* \w entrasse|strong="G1525"\w* \w com ele|strong="G4862,G846"\w*, \w a não ser|strong="G1487,G3361"\w* \w Pedro|strong="G4074"\w* \w e|strong="G2532"\w* \w João|strong="G2491"\w* \w e|strong="G2532"\w* \w Tiago|strong="G2385"\w*, \w e|strong="G2532"\w* \w o pai|strong="G3588,G3962"\w* \w da menina|strong="G3588,G3816"\w* \w e|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w*.\f + \fr 8.51: \ft Lit.: παῖς, “menino, menina, criança”: aqui, a filha de Jairo.\f*\f + \fr 8.51: \ft Variante: O RP lê οὐδένα (“ninguém”) em lugar de τινα σὺν αὐτῷ (“alguém com ele”).\f*\f + \fr 8.51: \ft Tradução: ἀφῆκεν (ἀφίημι, G863) está aqui como “não permitiu”; o termo pode ser “deixar”, “perdoar”, “permitir”, “abandonar” ou “mandar embora”, e o contexto decide.\f*\x - \xo 8:51 \xt MAT 9:20; MAT 9:18; JHN 11:21; 1KI 17:19-23; 2KI 4:33; 2KI 4:4-6\x*
\v 52 \w Todos|strong="G3956"\w* \w choravam|strong="G2799"\w* \w e|strong="G2532"\w* \w lamentavam batendo no peito|strong="G2875"\w* \w por ela|strong="G846"\w*; \w ele|strong="G3588"\w* \w disse|strong="G2036"\w*: “\w Não chorem|strong="G3361,G2799"\w*; \w pois|strong="G1063"\w* \w não morreu|strong="G3756,G599"\w*, \w mas|strong="G235"\w* \w dorme|strong="G2518"\w*.”\f + \fr 8.52: \ft Lit.: κόπτομαι, “bater no peito (em sinal de luto)”.\f*\x - \xo 8:52 \xt MRK 5:39; MAT 9:20; MAT 9:18; LUK 7:13; LUK 23:27; JHN 11:21\x*
\v 53 \w E|strong="G2532"\w* \w riam dele|strong="G2606,G846"\w*, \w sabendo|strong="G6063"\w* \w que|strong="G3754"\w* \w ela tinha morrido|strong="G599"\w*.\x - \xo 8:53 \xt MAT 9:24; MAT 9:20; MAT 9:18; ISA 53:3; JHN 11:21; LUK 16:14\x*
\v 54 \w Ele|strong="G846"\w*, \w porém|strong="G1161"\w*, \w segurando|strong="G2902"\w* \w a mão|strong="G3588,G5495"\w* \w dela|strong="G846"\w*, \w chamou|strong="G5455"\w*, \w dizendo|strong="G3004"\w*: “\w Menina|strong="G3588,G3816"\w*, \w levante-se|strong="G1453"\w*.”\f + \fr 8.54: \ft Variante: O RP acrescenta “tendo feito sair todos e” (ἐκβαλὼν ἔξω πάντας καὶ) depois de “Ele” e lê ἔγειρου (outra forma de “levante-se”).\f*\x - \xo 8:54 \xt MRK 9:27; MRK 5:41; MAT 9:25; MRK 1:31; MAT 9:20; MAT 9:18\x*
\v 55 \w E|strong="G2532"\w* \w voltou|strong="G1994"\w* \w o espírito|strong="G3588,G4151"\w* \w dela|strong="G846"\w*, \w e|strong="G2532"\w* \w ela se levantou|strong="G450"\w* \w imediatamente|strong="G3916"\w*, \w e|strong="G2532"\w* \w ele mandou|strong="G1299"\w* \w que lhe dessem|strong="G846,G1325"\w* \w de comer|strong="G5315"\w*.\f + \fr 8.55: \ft Lit.: πνεῦμα, “espírito, sopro de vida”.\f*\x - \xo 8:55 \xt MAT 9:20; MAT 9:18; JHN 5:21; MRK 5:41; JHN 11:44; 1KI 17:21-23\x*
\v 56 \w E|strong="G2532"\w* \w ficaram atônitos|strong="G1839"\w* \w os pais|strong="G3588,G1118"\w* \w dela|strong="G846"\w*; \w ele|strong="G3588"\w*, \w ordenou-lhes|strong="G3853,G846"\w* \w que a ninguém|strong="G3367"\w* \w dissessem|strong="G2036"\w* \w o que tinha acontecido|strong="G3588,G1096"\w*.\x - \xo 8:56 \xt LUK 9:21; MAT 9:20; MAT 9:18; MAT 8:4; MAT 9:30; MRK 1:43\x*
\c 9
\p
\v 1 \w Reunindo|strong="G4779"\w* \w os doze|strong="G3588,G1427"\w*, \w então|strong="G1161"\w*, \w deu-lhes|strong="G1325,G846"\w* \w poder|strong="G1411"\w* \w e|strong="G2532"\w* \w autoridade|strong="G1849"\w* \w sobre todos|strong="G1909,G3956"\w* \w os demônios|strong="G3588,G1140"\w* \w e|strong="G2532"\w* \w para curar|strong="G2323"\w* \w doenças|strong="G3554"\w*,\f + \fr 9.1: \ft Variante: O TR traz “os doze discípulos dele” (μαθητὰς αὑτοῦ) em lugar de “os doze”.\f*\x - \xo 9:1 \xt MAT 10:1; JHN 14:12; LUK 10:19; MAT 16:19; ACT 4:30; MRK 16:17-18\x*
\v 2 \w e|strong="G2532"\w* \w os enviou|strong="G649,G846"\w* \w para proclamar|strong="G2784"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w curar|strong="G2390"\w* \w os doentes|strong="G3588,G772"\w*,\x - \xo 9:2 \xt LUK 10:9; MRK 3:14; MAT 10:7; MAT 4:17; MAT 10:1; LUK 9:11\x*
\v 3 \w e|strong="G2532"\w* \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Nada|strong="G3367"\w* \w levem|strong="G142"\w* \w para o caminho|strong="G1519,G3588,G3598"\w*: \w nem|strong="G3383"\w* \w bordão|strong="G4464"\w*, \w nem|strong="G3383"\w* \w alforje|strong="G4082"\w*, \w nem|strong="G3383"\w* \w pão|strong="G740"\w*, \w nem|strong="G3383"\w* \w dinheiro|strong="G694"\w*, \w nem|strong="G3383"\w* \w tenham|strong="G2192"\w* \w duas túnicas cada um|strong="G303,G1417,G5509"\w*.\f + \fr 9.3: \ft Lit.: ἀργύριον, “prata, dinheiro”; πήρα, “alforje, sacola de viagem”.\f*\f + \fr 9.3: \ft Variante: O RP lê ῥάβδους (“bordões”, plural) em lugar de ῥάβδον; WH omite ἀνά (“cada um”).\f*\x - \xo 9:3 \xt MRK 6:8; LUK 10:4; MAT 10:10; MAT 10:1; LUK 22:35; PSA 37:3\x*
