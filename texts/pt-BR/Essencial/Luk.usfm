\v 12 \w Disse|strong="G2036"\w*, \w então|strong="G3767"\w*: “\w Um certo|strong="G5100"\w* \w homem|strong="G444"\w* \w de nobre família|strong="G2104"\w* \w foi|strong="G4198"\w* \w para uma terra|strong="G1519,G5561"\w* \w distante|strong="G3117"\w* \w receber para si|strong="G2983,G1438"\w* \w um reino|strong="G932"\w* \w e|strong="G2532"\w* \w voltar|strong="G5290"\w*.\x - \xo 19:12 \xt MAT 25:14; DAN 7:14; HEB 9:28; 1PE 3:22; LUK 19:12; LUK 20:9\x*
\v 13 \w Chamando|strong="G2564"\w* \w dez escravos seus|strong="G1176,G1401,G1438"\w* \w lhes deu|strong="G1325,G846"\w* \w dez|strong="G1176"\w* \w minas|strong="G3414"\w* \w e|strong="G2532"\w* \w lhes disse|strong="G2036,G4314,G846"\w*: ‘\w Negociem|strong="G4231"\w* \w enquanto|strong="G1722,G3739"\w* \w volto|strong="G2064"\w*.’\f + \fr 19.13: \ft Lit.: μνᾶ, “mina”, moeda de prata, equivalente a cerca de cem denários.\f*\f + \fr 19.13: \ft Variante: WH lê πραγματεύσασθαι (infinitivo) em vez de Πραγματεύσασθε; WH, Treg e NA28 trazem ἐν ᾧ, e RP lê ἕως (“até que”).\f*\x - \xo 19:13 \xt LUK 19:25; LUK 19:16; LUK 19:24; MAT 25:14; JHN 12:26; 1CO 12:7-11\x*
\v 14 \w Os cidadãos|strong="G3588,G4177"\w* \w dele|strong="G846"\w* \w o odiavam|strong="G3404,G846"\w* \w e|strong="G2532"\w* \w enviaram|strong="G649"\w* \w uma delegação|strong="G4242"\w* \w atrás dele|strong="G3694,G846"\w*, \w dizendo|strong="G3004"\w*: ‘\w Não queremos|strong="G3756,G2309"\w* \w que este|strong="G3778"\w* \w reine|strong="G936"\w* \w sobre nós|strong="G1909,G3165"\w*.’\x - \xo 19:14 \xt JHN 1:11; MAT 25:14; 1SA 8:7; LUK 19:27; MAT 23:37; PSA 2:3\x*
\v 15 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w quando voltou|strong="G1722,G3588,G1880,G846"\w*, \w depois de receber|strong="G2983"\w* \w o reino|strong="G3588,G932"\w*, \w mandou|strong="G2036"\w* \w chamar|strong="G5455"\w* \w diante dele|strong="G846"\w* \w aqueles escravos|strong="G3588,G1401,G3778"\w* \w aos quais|strong="G3739"\w* \w tinha dado|strong="G1325"\w* \w o dinheiro|strong="G3588,G694"\w*, \w para saber|strong="G2443,G1097"\w* \w o que|strong="G5101"\w* \w tinham ganho negociando|strong="G1281"\w*.\f + \fr 19.15: \ft Acréscimo: “que” (em “E aconteceu que quando voltou”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 19:15 \xt MAT 25:14; MAT 23:37; LUK 12:42; LUK 16:12; LUK 19:12; 1CO 4:1-5\x*
\v 16 \w Chegou|strong="G3854"\w* \w o primeiro|strong="G3588,G4413"\w*, \w dizendo|strong="G3004"\w*: ‘\w Senhor|strong="G2962"\w*, \w a sua mina|strong="G3588,G3414,G4771"\w* \w rendeu|strong="G4333"\w* \w dez|strong="G1176"\w* \w minas|strong="G3414"\w*.’\x - \xo 19:16 \xt LUK 19:25; LUK 19:13; LUK 19:24; MAT 25:14; 2CO 9:6; MAT 23:37\x*
