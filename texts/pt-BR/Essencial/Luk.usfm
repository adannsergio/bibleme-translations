\v 54 \w Dizia|strong="G3004"\w*, \w então|strong="G1161"\w*, \w também|strong="G2532"\w* \w às multidões|strong="G3588,G3793"\w*: “\w Quando|strong="G3752"\w* \w virem|strong="G1492"\w* \w uma nuvem|strong="G3507"\w* \w subindo|strong="G393"\w* \w no ocidente|strong="G1909,G1424"\w*, \w imediatamente|strong="G2112"\w* \w dizem|strong="G3004"\w*: ‘\w Vem|strong="G2064"\w* \w chuva|strong="G3655"\w*’, \w e|strong="G2532"\w* \w assim acontece|strong="G1096,G3779"\w*;\x - \xo 12:54 \xt 1KI 18:44; MRK 8:11; MAT 16:2; MAT 16:1\x*
\v 55 \w e|strong="G2532"\w* \w quando|strong="G3752"\w* \add sentirem\add* \w o vento sul|strong="G3558"\w* \w soprar|strong="G4154"\w*, \w dizem|strong="G3004"\w*: ‘\w Haverá|strong="G1510"\w* \w calor abrasador|strong="G2742"\w*’, \w e|strong="G2532"\w* \w acontece|strong="G1096"\w*;\f + \fr 12.55: \ft Lit.: νότος, “sul” (aqui, o vento do sul); καύσων, “calor ardente, vento quente”.\f*\f + \fr 12.55: \ft Acréscimo: “sentirem” (em “e quando sentirem o vento”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 12:55 \xt MRK 8:11; MAT 16:1; MAT 16:2; MAT 20:12\x*
\v 56 \w Hipócritas|strong="G5273"\w*, \w o aspecto|strong="G3588,G4383"\w* \w da terra|strong="G3588,G1093"\w* \w e|strong="G2532"\w* \w do céu|strong="G3588,G3772"\w* \w sabem|strong="G6063"\w* \w interpretar|strong="G1381"\w*; \w este tempo|strong="G3588,G2540,G3778"\w* \w por que|strong="G4459"\w* \w não sabem|strong="G3756,G6063"\w* \w interpretar|strong="G1381"\w*?\x - \xo 12:56 \xt 1CH 12:32; MAT 16:3; MAT 24:32-33; MAT 11:25; LUK 19:42-44; MRK 8:11\x*
\v 57 \w Por que|strong="G5101"\w* \w também|strong="G2532"\w* \w por si mesmos|strong="G575,G1438"\w* \w não julgam|strong="G3756,G2919"\w* \w o que é justo|strong="G3588,G1342"\w*?\f + \fr 12.57: \ft Acréscimo: verbo ser/estar suprido em “o que é justo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:57 \xt JHN 7:24; ACT 4:19; REV 16:5; 1JN 4:1; 1TH 5:21; 1CH 12:32\x*
\v 58 \w Pois|strong="G1063"\w*, \w quando|strong="G5613"\w* \w você vai|strong="G5217"\w* \w com o seu adversário|strong="G3326,G3588,G476,G4771"\w* \w a um magistrado|strong="G1909,G758"\w*, \w no caminho|strong="G1722,G3588,G3598"\w* \w faça esforço|strong="G1325,G2039"\w* \w para se livrar|strong="G525"\w* \w dele|strong="G575,G846"\w*, \w para que não|strong="G4218,G3361"\w* \w ele o arraste|strong="G2694,G4771"\w* \w ao juiz|strong="G4314,G3588,G2923"\w*, \w e|strong="G2532"\w* \w o juiz|strong="G3588,G2923"\w* \w o entregará|strong="G4771,G3860"\w* \w ao oficial de justiça|strong="G3588,G4233"\w*, \w e|strong="G2532"\w* \w o oficial|strong="G3588,G4233"\w* \w o lançará|strong="G4771,G906"\w* \w na prisão|strong="G1519,G5438"\w*.\x - \xo 12:58 \xt MAT 5:25; MAT 18:34; MAT 5:23-26; ISA 55:6; JOB 23:7; JDG 20:3\x*
\v 59 \w Digo|strong="G3004"\w* \w a você|strong="G4771"\w*: \w de modo nenhum|strong="G3756,G3361"\w* \w sairá|strong="G1831"\w* \w dali|strong="G1564"\w* \w até que|strong="G2193"\w* \w tenha pago|strong="G591"\w* \w também|strong="G2532"\w* \w o último|strong="G3588,G2078"\w* \w lepto|strong="G3016"\w*.”\f + \fr 12.59: \ft Lit.: λεπτόν, a menor moeda de cobre em circulação na Judeia (cf. Lc 21:2).\f*\x - \xo 12:59 \xt LUK 21:2; MAT 5:26; MAT 5:25; MRK 12:42; MAT 18:34; JDG 20:3\x*
\c 13
\p
\v 1 \w Estavam presentes|strong="G3918"\w*, \w naquele mesmo momento|strong="G1722,G846,G3588,G2540"\w* \w alguns|strong="G5100"\w* \w que lhe contavam|strong="G518,G846"\w* \w a respeito dos galileus|strong="G4012,G3588,G1057"\w*, \w cujo sangue|strong="G3739,G3588,G129"\w* \w Pilatos|strong="G4091"\w* \w misturou|strong="G3396"\w* \w com os sacrifícios|strong="G3326,G3588,G2378"\w* \w deles|strong="G846"\w*.\x - \xo 13:1 \xt 1PE 4:17-18; ACT 5:37; LAM 2:20; MAT 14:3; MAT 27:2; PSA 74:4\x*
\v 2 \w E|strong="G2532"\w*, \w respondendo|strong="G611"\w*, \w lhes disse|strong="G2036,G846"\w*: “\w Vocês pensam|strong="G1380"\w* \w que|strong="G3754"\w* \w estes galileus|strong="G3588,G1057,G3778"\w* \w foram|strong="G1096"\w* \w pecadores|strong="G268"\w* \w mais do que|strong="G3844"\w* \w todos os galileus|strong="G3956,G3588,G1057"\w*, \w porque|strong="G3754"\w* \w sofreram|strong="G3958"\w* \w estas coisas|strong="G3778"\w*?\x - \xo 13:2 \xt JHN 9:2; ACT 28:4; JOB 22:5-16; LUK 13:4\x*
\v 3 \w Não|strong="G3780"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*; \w mas|strong="G235"\w* \w se não|strong="G1437,G3361"\w* \w se arrependerem|strong="G3340"\w*, \w todos|strong="G3956"\w* \w do mesmo modo|strong="G3668"\w* \w perecerão|strong="G622"\w*.\x - \xo 13:3 \xt LUK 13:5; LUK 16:30; ACT 3:19; MAT 3:2; EZK 3:18; EZK 18:30\x*
\v 4 \w Ou|strong="G2228"\w* \w aqueles|strong="G1565,G3588"\w* \w dezoito|strong="G3638,G1176"\w*, \w sobre os quais|strong="G1909,G3739"\w* \w caiu|strong="G4098"\w* \w a torre|strong="G3588,G4444"\w* \w em Siloé|strong="G1722,G3588,G4611"\w* \w e|strong="G2532"\w* \w os matou|strong="G615,G846"\w*: \w vocês pensam|strong="G1380"\w* \w que|strong="G3754"\w* \w eles|strong="G846"\w* \w foram|strong="G1096"\w* \w devedores|strong="G3781"\w* \w mais do que|strong="G3844"\w* \w todas as pessoas|strong="G3956,G3588,G444"\w* \w que moram|strong="G3588,G2730"\w* \w em Jerusalém|strong="G2419"\w*?\f + \fr 13.4: \ft Lit.: ὀφειλέτης, “devedor, culpado”.\f*\x - \xo 13:4 \xt ACT 28:4; NEH 3:15; 1KI 20:30; JER 18:8; JHN 9:7; LUK 13:2\x*
\v 5 \w Não|strong="G3780"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*; \w mas|strong="G235"\w* \w se não|strong="G1437,G3361"\w* \w se arrependerem|strong="G3340"\w*, \w todos|strong="G3956"\w* \w da mesma forma|strong="G5615"\w* \w perecerão|strong="G622"\w*.”\x - \xo 13:5 \xt LUK 13:3; LUK 16:30; EZK 3:18; LUK 15:10; ACT 17:30; EZK 18:30\x*
\v 6 \w Dizia|strong="G3004"\w*, \w então|strong="G1161"\w*, \w esta parábola|strong="G3778,G3588,G3850"\w*: “\w Um certo homem|strong="G5100"\w* \w tinha|strong="G2192"\w* \w uma figueira|strong="G4808"\w* \w plantada|strong="G5452"\w* \w na sua vinha|strong="G1722,G3588,G290,G846"\w*; \w e|strong="G2532"\w* \w veio|strong="G2064"\w* \w procurar|strong="G2212"\w* \w fruto|strong="G2590"\w* \w nela|strong="G1722,G846"\w* \w e|strong="G2532"\w* \w não achou|strong="G3756,G2147"\w*.\x - \xo 13:6 \xt MAT 21:19; JHN 15:5; JHN 15:16; JHN 15:1; GAL 5:22; ISA 5:1-4\x*
\v 7 \w Disse|strong="G2036"\w*, \w então|strong="G1161"\w*, \w ao vinhateiro|strong="G4314,G3588,G289"\w*: ‘\w Olhe|strong="G2400"\w*, \w há três anos|strong="G5140,G2094,G575,G3739"\w* \w venho|strong="G2064"\w* \w procurar|strong="G2212"\w* \w fruto|strong="G2590"\w* \w nesta figueira|strong="G1722,G3588,G4808,G3778"\w* \w e|strong="G2532"\w* \w não acho|strong="G3756,G2147"\w*; \w corte-a|strong="G1581,G846"\w*. \w Por que|strong="G2444"\w* \w também|strong="G2532"\w* \w ela inutiliza|strong="G2673"\w* \w a terra|strong="G3588,G1093"\w*?’\f + \fr 13.7: \ft Variante: O RP omite ἀφʼ οὗ (“desde que”); NA28 acrescenta οὖν (“então”) depois de “corte-a”.\f*\f + \fr 13.7: \ft Acréscimo: verbo ser/estar suprido em “há três anos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:7 \xt MAT 7:19; JHN 15:5; JHN 15:2; MAT 3:10; MAT 21:19; MAT 7:17\x*
\v 8 \w Ele|strong="G3588"\w*, \w respondendo|strong="G611"\w*, \w lhe disse|strong="G3004,G846"\w*: ‘\w Senhor|strong="G2962"\w*, \w deixe-a|strong="G863,G846"\w* \w também|strong="G2532"\w* \w este ano|strong="G3778,G3588,G2094"\w*, \w até que|strong="G2193,G3748"\w* \w cave|strong="G4626"\w* \w ao redor dela|strong="G4012,G846"\w* \w e|strong="G2532"\w* \w ponha|strong="G906"\w* \w esterco|strong="G2874"\w*;\x - \xo 13:8 \xt JHN 15:5; JHN 15:2; MAT 3:10; MAT 21:19; MAT 7:17; MAT 7:19\x*
\v 9 \w e se|strong="G1437,G2532,G3303"\w* \w der|strong="G4160"\w* \w fruto|strong="G2590"\w* \w no futuro|strong="G1519,G3588,G3195"\w* —; \w caso contrário|strong="G1487,G1161,G3361,G1065"\w*, \w você a cortará|strong="G1581,G846"\w*.’”\f + \fr 13.9: \ft Lit.: a frase é interrompida (anacoluto): “se der fruto no futuro… (e então, tudo bem); se não, você a cortará”.\f*\x - \xo 13:9 \xt MAT 7:19; MAT 3:10; LUK 3:9; JHN 15:5; JHN 15:2; GAL 5:22\x*
\p
\v 10 \w Ele estava ensinando|strong="G1510,G1321"\w* \w numa|strong="G1722,G1520"\w* \w das sinagogas|strong="G3588,G4864"\w* \w no sábado|strong="G1722,G3588,G4521"\w*.\x - \xo 13:10 \xt MRK 1:21; LUK 4:15; LUK 6:6; JHN 6:59; MRK 6:2; MAT 4:23\x*
\v 11 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w uma mulher|strong="G1135"\w* \w que tinha|strong="G2192"\w* \w um espírito|strong="G4151"\w* \w de enfermidade|strong="G769"\w* \w havia dezoito anos|strong="G2094,G3638,G1176"\w*, \w e|strong="G2532"\w* \w estava curvada|strong="G1510,G4794"\w* \w e|strong="G2532"\w* \w não podia|strong="G3361,G1410"\w* \w se endireitar|strong="G352"\w* \w de modo algum|strong="G1519,G3588,G3838"\w*.\f + \fr 13.11: \ft Lit.: εἰς τὸ παντελές, “completamente, de modo algum”.\f*\x - \xo 13:11 \xt JHN 5:5; LUK 13:16; PSA 145:14; LUK 8:2; LUK 8:27; MRK 5:25\x*
\v 12 \w Vendo-a|strong="G1492,G846"\w* \w Jesus|strong="G3588,G2424"\w* \w a chamou|strong="G4377"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Mulher|strong="G1135"\w*, \w você foi libertada|strong="G630"\w* \w da sua enfermidade|strong="G3588,G769,G4771"\w*.”\x - \xo 13:12 \xt LUK 23:20; PSA 145:14; PSA 107:20; MAT 8:16; ISA 65:1; JOL 3:10\x*
\v 13 \w E|strong="G2532"\w* \w pôs|strong="G2007"\w* \w as mãos|strong="G3588,G5495"\w* \w sobre ela|strong="G846"\w*; \w e|strong="G2532"\w* \w imediatamente|strong="G3916"\w* \w ela se endireitou|strong="G461"\w*, \w e|strong="G2532"\w* \w glorificava|strong="G1392"\w* \w a Deus|strong="G3588,G2316"\w*.\x - \xo 13:13 \xt LUK 18:43; PSA 145:14; MRK 5:23; PSA 107:20-22; ACT 3:7; PSA 146:8\x*
\v 14 \w Respondendo|strong="G611"\w* \w o chefe da sinagoga|strong="G3588,G752"\w*, \w indignado|strong="G23"\w* \w porque|strong="G3754"\w* \w Jesus|strong="G3588,G2424"\w* \w curou|strong="G2323"\w* \w no sábado|strong="G3588,G4521"\w*, \w dizia|strong="G3004"\w* \w à multidão|strong="G3588,G3793"\w*: “\w Há seis dias|strong="G1803,G2250,G1510"\w* \w em que|strong="G1722,G3739"\w* \w é preciso|strong="G1163"\w* \w trabalhar|strong="G2038"\w*; \w venham|strong="G2064"\w*, \w então|strong="G3767"\w*, \w nesses dias|strong="G1722,G846"\w* \w e sejam curados|strong="G2323"\w*, \w e|strong="G2532"\w* \w não no dia|strong="G3361,G3588,G2250"\w* \w de sábado|strong="G3588,G4521"\w*.”\x - \xo 13:14 \xt LUK 14:3; EXO 20:9; MAT 12:10; EXO 35:2; MRK 5:22; EXO 23:12\x*
\v 15 \w Respondeu-lhe|strong="G611,G846"\w* \w o Senhor|strong="G3588,G2962"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Hipócritas|strong="G5273"\w*, \w cada um|strong="G1538"\w* \w de vocês|strong="G4771"\w* \w no sábado|strong="G3588,G4521"\w* \w não solta|strong="G3756,G3089"\w* \w o seu boi|strong="G3588,G1016,G846"\w* \w ou|strong="G2228"\w* \w o jumento|strong="G3588,G3688"\w* \w da manjedoura|strong="G575,G3588,G5336"\w*, \w e|strong="G2532"\w*, \w levando-o|strong="G520"\w*, \w dá de beber|strong="G4222"\w*?\x - \xo 13:15 \xt LUK 14:5; LUK 15:4; EXO 35:2; MAT 7:5; MAT 12:11; JHN 5:9\x*
\v 16 \w E esta|strong="G3778,G1161"\w*, \w sendo|strong="G1510"\w* \w filha|strong="G2364"\w* \w de Abraão|strong="G11"\w*, \w a quem|strong="G3739"\w* \w Satanás|strong="G3588,G4567"\w* \w prendeu|strong="G1210"\w*, \w olhem|strong="G2400"\w*, \w há dezoito anos|strong="G1176,G2532,G3638,G2094"\w*, \w não era preciso|strong="G3756,G1163"\w* \w que fosse libertada|strong="G3089"\w* \w deste laço|strong="G575,G3588,G1199,G3778"\w* \w no dia|strong="G3588,G2250"\w* \w de sábado|strong="G3588,G4521"\w*?”\f + \fr 13.16: \ft Lit.: θυγάτηρ Ἀβραάμ, “filha de Abraão”: mulher judia; δεσμός, “laço, amarra”.\f*\f + \fr 13.16: \ft Acréscimo: verbo ser/estar suprido em “há dezoito anos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:16 \xt LUK 13:11; LUK 19:9; JHN 5:5; LUK 13:12; LUK 8:43; MRK 2:27\x*
\v 17 \w E|strong="G2532"\w* \w enquanto ele dizia|strong="G3004,G846"\w* \w estas coisas|strong="G3778"\w*, \w ficavam envergonhados|strong="G2617"\w* \w todos os que|strong="G3956,G3588"\w* \w se opunham|strong="G480"\w* \w a ele|strong="G846"\w*, \w e|strong="G2532"\w* \w toda a multidão|strong="G3956,G3588,G3793"\w* \w se alegrava|strong="G5463"\w* \w com todas|strong="G1909,G3956"\w* \w as coisas gloriosas|strong="G3588,G1741"\w* \w que eram feitas|strong="G3588,G1096"\w* \w por ele|strong="G5259,G846"\w*.\x - \xo 13:17 \xt MAT 12:11; 1PE 3:16; ISA 45:24; MRK 3:4; ACT 3:9; ISA 66:5\x*
\p
\v 18 \w Dizia|strong="G3004"\w*, \w então|strong="G3767"\w*: “\w A quem|strong="G5101"\w* \w é semelhante|strong="G3664,G1510"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*, \w e|strong="G2532"\w* \w a quem|strong="G5101"\w* \w o compararei|strong="G3666,G846"\w*?\x - \xo 13:18 \xt LUK 7:31; LUK 13:20; MRK 4:30; MAT 11:16; MAT 13:24; MAT 22:2\x*
\v 19 \w É semelhante|strong="G3664,G1510"\w* \w a um grão|strong="G2848"\w* \w de mostarda|strong="G4615"\w*, \w que|strong="G3739"\w*, \w tomando-o|strong="G2983"\w*, \w um homem|strong="G444"\w* \w lançou|strong="G906"\w* \w no seu próprio jardim|strong="G1519,G2779,G1438"\w*; \w e|strong="G2532"\w* \w cresceu|strong="G837"\w* \w e|strong="G2532"\w* \w se tornou|strong="G1096"\w* \w uma árvore|strong="G1519,G1186"\w*, \w e|strong="G2532"\w* \w as aves|strong="G3588,G4071"\w* \w do céu|strong="G3588,G3772"\w* \w se abrigaram|strong="G2681"\w* \w nos seus ramos|strong="G1722,G3588,G2798,G846"\w*.”\f + \fr 13.19: \ft Variante: Treg e RP acrescentam “grande” (μέγα) depois de “árvore”.\f*\x - \xo 13:19 \xt MAT 13:31; MRK 4:31; MAT 13:32; LUK 17:6; DAN 4:12; DAN 2:44-45\x*
\v 20 \w E|strong="G2532"\w* \w de novo|strong="G3825"\w* \w disse|strong="G2036"\w*: “\w A quem|strong="G5101"\w* \w compararei|strong="G3666"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*?\x - \xo 13:20 \xt LUK 13:18; MRK 4:30; MAT 13:24; MAT 22:2; MAT 18:23\x*
\v 21 \w É semelhante|strong="G3664,G1510"\w* \w a fermento|strong="G2219"\w*, \w que|strong="G3739"\w*, \w tomando-o|strong="G2983"\w*, \w uma mulher|strong="G1135"\w* \w escondeu|strong="G2928"\w* \w em três medidas|strong="G1519,G4568,G5140"\w* \w de farinha|strong="G224"\w*, \w até que|strong="G2193,G3739"\w* \w tudo|strong="G3650"\w* \w ficou fermentado|strong="G2220"\w*.”\f + \fr 13.21: \ft Lit.: σάτον, “medida de grãos ou de farinha”: uma quantidade grande, como mostra o total de três.\f*\f + \fr 13.21: \ft Variante: NA28 e RP lêem ἐνέκρυψεν em lugar de ἔκρυψεν (ambos significam “escondeu”).\f*\x - \xo 13:21 \xt MAT 13:33; GAL 5:9; 1CO 5:6; MRK 4:30; 1TH 5:23-24; JAS 1:21\x*
\p
\v 22 \w E|strong="G2532"\w* \w passava|strong="G1279"\w* \w por cidades|strong="G2596,G4172"\w* \w e|strong="G2532"\w* \w povoados|strong="G2968"\w*, \w ensinando|strong="G1321"\w* \w e|strong="G2532"\w* \w seguindo caminho|strong="G4197,G4160"\w* \w para Jerusalém|strong="G1519,G2414"\w*.\x - \xo 13:22 \xt LUK 9:51; MAT 9:35; MRK 10:32-34; MRK 6:6; LUK 4:43-44; ACT 10:38\x*
\v 23 \w Alguém|strong="G5100"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Senhor|strong="G2962"\w*, \w será que|strong="G1487"\w* \w são poucos|strong="G3641"\w* \w os que se salvam|strong="G3588,G4982"\w*?” \w Ele|strong="G3588"\w* \w lhes disse|strong="G2036,G4314,G846"\w*:\f + \fr 13.23: \ft Acréscimo: verbo ser/estar suprido em “será que”, “são poucos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:23 \xt MAT 7:14; PHP 2:12; MAT 22:14; JHN 21:21; LUK 12:13-15; MAT 20:16\x*
\v 24 “\w Lutem|strong="G75"\w* \w para entrar|strong="G1525"\w* \w pela porta estreita|strong="G1223,G3588,G4728,G2374"\w*, \w porque|strong="G3754"\w* \w muitos|strong="G4183"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*, \w procurarão|strong="G2212"\w* \w entrar|strong="G1525"\w* \w e|strong="G2532"\w* \w não conseguirão|strong="G3756,G2480"\w*.\f + \fr 13.24: \ft Lit.: ἀγωνίζομαι, “lutar, esforçar-se (como num combate ou numa corrida)”.\f*\f + \fr 13.24: \ft Variante: O RP lê πύλης (“portão”) em lugar de θύρας (“porta”).\f*\x - \xo 13:24 \xt MAT 7:13; MAT 7:14; PHP 2:12; MAT 11:12; LUK 11:9; MAT 22:14\x*
\v 25 \w A partir do momento em que|strong="G575,G3739,G302"\w* \w o dono da casa|strong="G3588,G3617"\w* \w se levantar|strong="G1453"\w* \w e|strong="G2532"\w* \w fechar|strong="G608"\w* \w a porta|strong="G3588,G2374"\w*, \w e|strong="G2532"\w* \w vocês começarem|strong="G757"\w* \w a ficar|strong="G2476"\w* \w do lado de fora|strong="G1854"\w* \w e|strong="G2532"\w* \w a bater|strong="G2925"\w* \w na porta|strong="G3588,G2374"\w*, \w dizendo|strong="G3004"\w*: ‘\w Senhor|strong="G2962"\w*, \w abra|strong="G455"\w* \w para nós|strong="G3165"\w*’; \w e|strong="G2532"\w*, \w respondendo|strong="G611"\w*, \w ele dirá|strong="G4483"\w* \w a vocês|strong="G4771"\w*: ‘\w Não sei|strong="G3756,G6063"\w* \w de onde|strong="G4159"\w* \w vocês|strong="G4771"\w* \w são|strong="G1510"\w*’.\f + \fr 13.25: \ft Variante: O RP repete o vocativo: “Senhor, Senhor” (κύριε κύριε).\f*\x - \xo 13:25 \xt LUK 11:9; MAT 7:13; MAT 7:7; MAT 7:14; MAT 7:22; ISA 55:6\x*
\v 26 \w Então|strong="G5119"\w* \w vocês começarão|strong="G757"\w* \w a dizer|strong="G3004"\w*: ‘\w Comemos|strong="G5315"\w* \w na sua presença|strong="G1799,G4771"\w* \w e|strong="G2532"\w* \w bebemos|strong="G4095"\w*, \w e|strong="G2532"\w* \w nas nossas ruas|strong="G1722,G3588,G4116,G3165"\w* \w você ensinou|strong="G1321"\w*.’\x - \xo 13:26 \xt MAT 7:14; MAT 7:22; LUK 6:46; PRO 28:9; 1CO 9:27; LUK 9:26\x*
\v 27 \w E|strong="G2532"\w* \w dirá|strong="G4483,G3004"\w* \w a vocês|strong="G4771"\w*: ‘\w Não sei|strong="G3756,G6063"\w* \w de onde|strong="G4159"\w* \w vocês são|strong="G1510"\w*; \w afastem-se|strong="G868"\w* \w de mim|strong="G575,G1473"\w*, \w todos|strong="G3956"\w* \w os operários|strong="G2040"\w* \w da injustiça|strong="G93"\w*.’\f + \fr 13.27: \ft Nota cultural: ecoa Sl 6:8 (“afastem-se de mim, todos os que praticam a iniquidade”).\f*\x - \xo 13:27 \xt PSA 6:8; 2TI 2:19; MAT 7:14; ROM 9:14; MAT 7:22; MAT 7:23\x*
\v 28 \w Ali|strong="G1563"\w* \w haverá|strong="G1510"\w* \w choro|strong="G3588,G2805"\w* \w e|strong="G2532"\w* \w ranger|strong="G3588,G1030"\w* \w de dentes|strong="G3588,G3599"\w*, \w quando virem|strong="G3752,G3700"\w* \w Abraão|strong="G11"\w* \w e|strong="G2532"\w* \w Isaque|strong="G2464"\w* \w e|strong="G2532"\w* \w Jacó|strong="G2384"\w* \w e|strong="G2532"\w* \w todos os profetas|strong="G3956,G3588,G4396"\w* \w no reino|strong="G1722,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*, \w mas vocês|strong="G4771,G1161"\w* \w lançados|strong="G1544"\w* \w para fora|strong="G1854"\w*.\x - \xo 13:28 \xt MAT 8:12; MAT 13:50; MAT 13:42; MAT 25:30; MAT 22:13; MAT 8:11\x*
\v 29 \w E|strong="G2532"\w* \w virão|strong="G2240"\w* \w do oriente|strong="G575,G395"\w* \w e|strong="G2532"\w* \w do ocidente|strong="G1424"\w*, \w e|strong="G2532"\w* \w do norte|strong="G575,G1005"\w* \w e|strong="G2532"\w* \w do sul|strong="G3558"\w*, \w e|strong="G2532"\w* \w se reclinarão à mesa|strong="G347"\w* \w no reino|strong="G1722,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 13:29 \xt MAT 8:11; REV 21:13; MAT 7:14; ISA 43:5; MAT 20:16; LUK 14:15\x*
\v 30 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w há|strong="G1510"\w* \w últimos|strong="G2078"\w* \w que serão|strong="G3739,G1510"\w* \w primeiros|strong="G4413"\w*, \w e|strong="G2532"\w* \w há|strong="G1510"\w* \w primeiros|strong="G4413"\w* \w que serão|strong="G3739,G1510"\w* \w últimos|strong="G2078"\w*.”\x - \xo 13:30 \xt MAT 19:30; MRK 10:31; MAT 20:16; MAT 7:14; MAT 21:28-31; LUK 19:9\x*
\p
\v 31 \w Naquela mesma hora|strong="G1722,G846,G3588,G5610"\w* \w se aproximaram|strong="G4334"\w* \w alguns|strong="G5100"\w* \w fariseus|strong="G5330"\w*, \w dizendo-lhe|strong="G3004,G846"\w*: “\w Saia|strong="G1831"\w* \w e|strong="G2532"\w* \w vá embora|strong="G4198"\w* \w daqui|strong="G1782"\w*, \w porque|strong="G3754"\w* \w Herodes|strong="G2264"\w* \w quer|strong="G2309"\w* \w matar você|strong="G4771,G615"\w*.”\f + \fr 13.31: \ft Variante: Treg e RP lêem ἡμέρᾳ (“dia”) em lugar de ὥρᾳ (“hora”): “naquele mesmo dia”.\f*\x - \xo 13:31 \xt JHN 7:1; PSA 11:1; ACT 13:1; LUK 12:49; LUK 23:7; LUK 3:20\x*
\v 32 \w E|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Vão|strong="G4198"\w* \add e\add* \w digam|strong="G2036"\w* \w a esta raposa|strong="G3588,G258,G3778"\w*: ‘\w Olhe|strong="G2400"\w*, \w expulso|strong="G1544"\w* \w demônios|strong="G1140"\w* \w e|strong="G2532"\w* \w realizo|strong="G658"\w* \w curas|strong="G2392"\w* \w hoje|strong="G4594"\w* \w e|strong="G2532"\w* \w amanhã|strong="G839"\w*, \w e|strong="G2532"\w* \w no terceiro dia|strong="G3588,G5154"\w* \w concluirei a obra|strong="G5048"\w*\f + \fr 13.32: \ft Lit.: τελειόω, “completar, levar à plenitude”: aqui, concluir a sua obra.\f*.’\f + \fr 13.32: \ft Acréscimo: “e” (em “disse Vão e digam a”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 13:32 \xt SNG 2:15; JHN 9:4; HEB 2:10; HEB 5:9; JHN 17:4-5; JHN 11:8-10\x*
\v 33 \w No entanto|strong="G4133"\w*, \w é preciso|strong="G1163"\w* \w que eu|strong="G3165"\w* \w siga o meu caminho|strong="G4198"\w* \w hoje|strong="G4594"\w* \w e|strong="G2532"\w* \w amanhã|strong="G839"\w* \w e|strong="G2532"\w* \w no dia seguinte|strong="G3588,G2192"\w*, \w porque|strong="G3754"\w* \w não é possível|strong="G3756,G1735"\w* \w que um profeta|strong="G4396"\w* \w morra|strong="G622"\w* \w fora de|strong="G1854"\w* \w Jerusalém|strong="G2419"\w*.\f + \fr 13.33: \ft Tradução: ἀπολέσθαι (ἀπόλλυμι, G622) está aqui como “morra”; o termo pode ser “perder”, “perecer”, “destruir” ou “morrer”, e o contexto decide.\f*\x - \xo 13:33 \xt JHN 9:4; LUK 9:53; 1TH 2:15; MAT 21:11; JHN 4:34; JHN 7:1\x*
\v 34 \w Jerusalém|strong="G2419"\w*, \w Jerusalém|strong="G2419"\w*, \w que mata|strong="G3588,G615"\w* \w os profetas|strong="G3588,G4396"\w* \w e|strong="G2532"\w* \w apedreja|strong="G3036"\w* \w os enviados|strong="G3588,G649"\w* \w a ela|strong="G4314,G846"\w* — \w quantas vezes|strong="G4212"\w* \w quis|strong="G2309"\w* \w reunir|strong="G1996"\w* \w os seus filhos|strong="G3588,G5043,G4771"\w*, \w do modo como|strong="G3739,G5158"\w* \w uma galinha|strong="G3733"\w* \w a sua própria ninhada|strong="G3588,G1438,G3555"\w* \w debaixo das asas|strong="G5259,G3588,G4420"\w*, \w e|strong="G2532"\w* \w vocês não quiseram|strong="G3756,G2309"\w*!\x - \xo 13:34 \xt MAT 23:37; PSA 46:1; ISA 30:15; PSA 17:8; DEU 32:11-12; ACT 7:52\x*
\v 35 \w Olhem|strong="G2400"\w*, \w é deixada|strong="G863"\w* \w a vocês|strong="G4771"\w* \w a casa|strong="G3588,G3624"\w* \w de vocês|strong="G4771"\w*. \w Digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w de modo nenhum|strong="G3756,G3361"\w* \w me verão|strong="G1492,G3165"\w* \w até que|strong="G2193"\w* \w chegue|strong="G2240"\w* \w o tempo em que|strong="G3753"\w* \w digam|strong="G2036"\w*: ‘\w Bendito seja|strong="G2127"\w* \w o que vem|strong="G3588,G2064"\w* \w em nome|strong="G1722,G3686"\w* \w do Senhor|strong="G2962"\w*.’”\f + \fr 13.35: \ft Nota cultural: cita Sl 118:26.\f*\f + \fr 13.35: \ft Variante: NIV e RP acrescentam “deserta” (ἔρημος) depois de “a casa de vocês”; o RP acrescenta ὅτι (“que”) depois de “a vocês” e traz με ἴδητε (“me verão”) em ordem inversa; a expressão ἥξει ὅτε (“chegue o tempo em que”) falta em WH e NIV, e o RP traz ἄν ἥξει ὅτε.\f*\x - \xo 13:35 \xt PSA 118:26; MAT 23:38; LUK 19:38; MAT 23:37; LUK 19:41; LUK 19:44\x*
\c 14
\p
\v 1 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w quando ele foi|strong="G1722,G3588,G2064,G846"\w* \w à casa de um|strong="G1519,G3624,G5100"\w* \w dos chefes|strong="G3588,G758"\w* \w dos fariseus|strong="G3588,G5330"\w*, \w num sábado|strong="G4521"\w*, \w para comer|strong="G5315"\w* \w pão|strong="G740"\w*, \w eles|strong="G846"\w* \w o estavam observando|strong="G1510,G3906,G846"\w*.\f + \fr 14.1: \ft Lit.: φαγεῖν ἄρτον, “comer pão”: “fazer uma refeição”.\f*\f + \fr 14.1: \ft Acréscimo: “que” (em “E aconteceu que quando ele”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 14:1 \xt LUK 6:7; MRK 3:2; LUK 7:36; MRK 3:4; HEB 12:3; MAT 11:19\x*
\v 2 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w um certo|strong="G5100"\w* \w homem|strong="G444"\w*, \w diante dele|strong="G1715,G846"\w*, \w estava|strong="G1510"\w* \w hidrópico|strong="G5203"\w*.\f + \fr 14.2: \ft Lit.: ὑδρωπικός, “que sofre de hidropisia (acúmulo de líquido no corpo)”.\f*\x - \xo 14:2 \xt MRK 3:4; LUK 7:27; MAT 11:10\x*
\v 3 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w* \w aos especialistas na Lei|strong="G4314,G3588,G3544"\w* \w e|strong="G2532"\w* \w fariseus|strong="G5330"\w*, \w dizendo|strong="G3004"\w*: “\w É permitido|strong="G1832"\w* \w no sábado|strong="G3588,G4521"\w* \w curar|strong="G2323"\w*, \w ou|strong="G2228"\w* \w não|strong="G3756"\w*?”\f + \fr 14.3: \ft Variante: O RP traz Εἰ ἔξεστιν (“se é permitido”) em lugar de Ἔξεστιν e θεραπεύειν (“curar”) em lugar de θεραπεῦσαι ἢ οὔ (“curar, ou não”).\f*\x - \xo 14:3 \xt MAT 12:2; LUK 6:2; MAT 12:10; MRK 2:24; JHN 5:10; LUK 13:14\x*
\v 4 \w Eles|strong="G3588"\w* \w ficaram calados|strong="G2270"\w*. \w E|strong="G2532"\w*, \w tomando-o|strong="G1949"\w*, \w o curou|strong="G2390,G846"\w* \w e|strong="G2532"\w* \w o despediu|strong="G630"\w*.\x - \xo 14:4 \xt MRK 3:4; MAT 21:25-27; MAT 22:46; MAT 12:10; LUK 13:14\x*
\v 5 \w E|strong="G2532"\w* \w lhes disse|strong="G4314,G846,G2036"\w*: “\w De quem|strong="G5101"\w* \w dentre vocês|strong="G4771"\w* \w um filho|strong="G5207"\w* \w ou|strong="G2228"\w* \w um boi|strong="G1016"\w* \w cair|strong="G4098"\w* \w num poço|strong="G1519,G5421"\w*, \w e|strong="G2532"\w* \w não o tirará|strong="G3756,G385,G846"\w* \w imediatamente|strong="G2112"\w* \w no dia|strong="G1722,G2250"\w* \w de sábado|strong="G3588,G4521"\w*?”\f + \fr 14.5: \ft Variante: O RP acrescenta “respondendo” (ἀποκριθείς) depois de “E” e lê ἐμπεσεῖται (“cair dentro”) em lugar de πεσεῖται; o RP traz ἐν τῇ ἡμέρᾳ e Treg τῇ ἡμέρᾳ (“no dia”, com artigo) em lugar de ἐν ἡμέρᾳ.\f*\f + \fr 14.5: \ft Variante: o TR e o RP trazem ὄνος (“jumento”) em lugar de υἱός (“filho”).\f*\x - \xo 14:5 \xt LUK 13:15; EXO 23:4-5; MRK 3:4; MAT 12:11; MAT 12:10; LUK 13:14\x*
\v 6 \w E|strong="G2532"\w* \w não conseguiram|strong="G3756,G2480"\w* \w responder|strong="G470"\w* \w a isto|strong="G4314,G3778"\w*.\x - \xo 14:6 \xt MAT 12:10; MAT 22:46; LUK 13:14; LUK 20:40\x*
\p
\v 7 \w Dizia|strong="G3004"\w* \w aos convidados|strong="G4314,G3588,G2564"\w* \w uma parábola|strong="G3850"\w*, \w observando|strong="G1907"\w* \w como|strong="G4459"\w* \w escolhiam|strong="G1586"\w* \w os primeiros lugares|strong="G3588,G4411"\w*, \w dizendo|strong="G3004"\w* \w a eles|strong="G4314,G846"\w*:\x - \xo 14:7 \xt PHP 2:3; PRO 25:7; MAT 20:26; LUK 11:43; LUK 20:46; MAT 23:6\x*
\v 8 “\w Quando|strong="G3752"\w* \w for convidado|strong="G2564"\w* \w por alguém|strong="G5259,G5100"\w* \w para um casamento|strong="G1519,G1062"\w*, \w não se recline|strong="G3361,G2625"\w* \w no primeiro lugar|strong="G1519,G3588,G4411"\w*, \w para que não|strong="G4218,G3361"\w* \w tenha sido convidado|strong="G1510,G2564"\w* \w por ele|strong="G5259,G846"\w* \w alguém mais honrado|strong="G1784"\w* \w do que você|strong="G4771"\w*,\x - \xo 14:8 \xt PHP 2:3; PRO 25:6-7; PRO 25:7; MAT 20:26; PRO 11:2; ACT 8:19\x*
\v 9 \w e|strong="G2532"\w*, \w vindo|strong="G2064"\w* \w aquele que|strong="G3588"\w* \w convidou|strong="G2564"\w* \w vocês dois|strong="G4771,G2532,G846"\w*, \w lhe dirá|strong="G4483,G4771"\w*: ‘\w Dê|strong="G1325"\w* \w a este|strong="G3778"\w* \w o lugar|strong="G5117"\w*’, \w e|strong="G2532"\w* \w então|strong="G5119"\w* \w você começará|strong="G757"\w* \w com vergonha|strong="G3326,G152"\w* \add a\add* \w ocupar|strong="G2722"\w* \w o último|strong="G3588,G2078"\w* \w lugar|strong="G5117"\w*.\f + \fr 14.9: \ft Acréscimo: “a” (em “com vergonha a ocupar o”): preposição ou artigo que a regência do português exige.\f*\x - \xo 14:9 \xt PHP 2:3; PRO 25:7; MAT 20:26; PRO 11:2; PRO 16:18; ACT 8:19\x*
\v 10 \w Mas|strong="G235"\w*, \w quando|strong="G3752"\w* \w for convidado|strong="G2564"\w*, \w indo|strong="G4198"\w*, \w ponha-se à mesa|strong="G377"\w* \w no último lugar|strong="G1519,G3588,G2078,G5117"\w*, \w para que|strong="G2443"\w*, \w quando|strong="G3752"\w* \w vier|strong="G2064"\w* \w aquele que o convidou|strong="G3588,G2564,G4771"\w*, \w lhe diga|strong="G4483,G4771"\w*: ‘\w Amigo|strong="G5384"\w*, \w passe|strong="G4320"\w* \w para um lugar mais honroso|strong="G511"\w*’\f + \fr 14.10: \ft Lit.: προσανάβηθι ἀνώτερον, literalmente “suba mais para cima”; na ordem dos lugares à mesa, “passe para um lugar mais honroso”.\f*; \w então|strong="G5119"\w* \w haverá|strong="G1510"\w* \w para você|strong="G4771"\w* \w honra|strong="G1391"\w* \w diante de|strong="G1799"\w* \w todos|strong="G3956"\w* \w os que estão à mesa|strong="G3588,G4873"\w* \w com você|strong="G4771"\w*.\f + \fr 14.10: \ft Variante: O RP lê εἴπῃ (subjuntivo) em lugar de ἐρεῖ (“dirá”) e omite “todos” (πάντων).\f*\f + \fr 14.10: \ft Tradução: δόξα (δόξα, G1391) está aqui como “honra”; o termo pode ser “glória”, “honra”, “esplendor” ou “reputação”, e o contexto decide.\f*\x - \xo 14:10 \xt PHP 2:3; PRO 25:7; MRK 9:35; MAT 20:26; ROM 12:10; PRO 25:6-7\x*
\v 11 \w Porque|strong="G3754"\w* \w todo aquele|strong="G3956,G3588"\w* \w que se exalta|strong="G5312,G1438"\w* \w será humilhado|strong="G5013"\w*, \w e|strong="G2532"\w* \w o que se humilha|strong="G3588,G5013,G1438"\w* \w será exaltado|strong="G5312"\w*.”\x - \xo 14:11 \xt 1PE 5:6; MAT 23:12; JAS 4:10; LUK 18:14; PRO 29:23; 2CO 11:7\x*
\v 12 \w Dizia|strong="G3004"\w* \w também|strong="G2532"\w* \w àquele que o havia convidado|strong="G3588,G2564,G846"\w*: “\w Quando|strong="G3752"\w* \w você der|strong="G4160"\w* \w almoço|strong="G712"\w* \w ou|strong="G2228"\w* \w jantar|strong="G1173"\w*, \w não chame|strong="G3361,G5455"\w* \w os seus amigos|strong="G3588,G5384,G4771"\w* \w nem|strong="G3366"\w* \w os seus irmãos|strong="G3588,G80,G4771"\w* \w nem|strong="G3366"\w* \w os seus parentes|strong="G3588,G4773,G4771"\w* \w nem|strong="G3366"\w* \w vizinhos|strong="G1069"\w* \w ricos|strong="G4145"\w*, \w para que não|strong="G4218,G3361"\w* \w também|strong="G2532"\w* \w eles|strong="G846"\w* \w o convidem de volta|strong="G479,G4771"\w* \w e|strong="G2532"\w* \w lhe venha|strong="G1096"\w* \w uma retribuição|strong="G468,G4771"\w*.\x - \xo 14:12 \xt ACT 20:35; JAS 2:1-6; LUK 6:34; MAT 5:46; LUK 6:32-36; PRO 22:16\x*
\v 13 \w Mas|strong="G235"\w*, \w quando|strong="G3752"\w* \w fizer|strong="G4160"\w* \w banquete|strong="G1403"\w*, \w convide|strong="G2564"\w* \w pobres|strong="G4434"\w*, \w aleijados|strong="G376"\w*, \w coxos|strong="G5560"\w*, \w cegos|strong="G5185"\w*;\x - \xo 14:13 \xt LUK 14:21; ACT 20:35; PRO 3:9; LUK 6:34; ISA 58:10; ISA 58:7\x*
\v 14 \w e|strong="G2532"\w* \w feliz|strong="G3107"\w* \w você será|strong="G1510"\w*, \w porque|strong="G3754"\w* \w eles não têm|strong="G3756,G2192"\w* \w como retribuir|strong="G467"\w* \w a você|strong="G4771"\w*; \w pois|strong="G1063"\w* \w será retribuído|strong="G467"\w* \w a você|strong="G4771"\w* \w na ressurreição|strong="G1722,G3588,G386"\w* \w dos justos|strong="G3588,G1342"\w*.”\x - \xo 14:14 \xt ACT 24:15; ACT 20:35; HEB 10:35; PRO 19:17; COL 3:24; MAT 6:4\x*
\p
\v 15 \w Ouvindo|strong="G191"\w* \w estas coisas|strong="G3778"\w* \w um|strong="G5100"\w* \w dos que estavam à mesa|strong="G3588,G4873"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Feliz|strong="G3107"\w* \w quem|strong="G3748"\w* \w comer|strong="G5315"\w* \w pão|strong="G740"\w* \w no reino|strong="G1722,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*!”\x - \xo 14:15 \xt LUK 22:16; REV 19:9; LUK 13:29; LUK 22:30; REV 20:6; ROM 14:17\x*
\v 16 \w Ele|strong="G3588"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Um certo|strong="G5100"\w* \w homem|strong="G444"\w* \w preparava|strong="G4160"\w* \w um grande|strong="G3173"\w* \w jantar|strong="G1173"\w* \w e|strong="G2532"\w* \w convidou|strong="G2564"\w* \w muitos|strong="G4183"\w*,\x - \xo 14:16 \xt REV 19:9; LUK 14:24; MAT 22:2; MAT 13:22; REV 22:17; ISA 55:1-7\x*
\v 17 \w e|strong="G2532"\w* \w enviou|strong="G649"\w* \w o seu escravo|strong="G3588,G1401,G846"\w* \w na hora|strong="G3588,G5610"\w* \w do jantar|strong="G3588,G1173"\w* \w para dizer|strong="G2036"\w* \w aos convidados|strong="G3588,G2564"\w*: ‘\w Venham|strong="G2064"\w*, \w porque|strong="G3754"\w* \w já|strong="G2235"\w* \w está pronto|strong="G2092,G1510"\w*.’\f + \fr 14.17: \ft Variante: Treg e RP acrescentam “tudo” (πάντα) no fim: “está tudo pronto”.\f*\x - \xo 14:17 \xt MAT 22:3; MAT 23:37; MAT 13:22; PRO 9:2; LUK 14:16; PRO 9:1-5\x*
\v 18 \w E|strong="G2532"\w* \w todos|strong="G3956"\w* \w começaram|strong="G757"\w* \w a pedir dispensa|strong="G3868"\w* \w de comum acordo|strong="G575,G1520"\w*. \w O primeiro|strong="G3588,G4413"\w* \w lhe disse|strong="G2036,G846"\w*: ‘\w Comprei|strong="G59"\w* \w um campo|strong="G68"\w*, \w e|strong="G2532"\w* \w preciso|strong="G2192,G318"\w* \w sair|strong="G1831"\w* \w para vê-lo|strong="G1492,G846"\w*; \w peço-lhe|strong="G2065,G4771"\w*: \w considere-me|strong="G2192,G3165"\w* \w dispensado|strong="G3868"\w*.’\f + \fr 14.18: \ft Lit.: ἀπὸ μιᾶς, expressão de sentido obscuro: “de comum acordo, a uma só voz”; παραιτέομαι, “pedir dispensa, desculpar-se”.\f*\x - \xo 14:18 \xt LUK 9:61; MAT 23:37; MAT 24:38; MRK 4:15; MRK 4:19; MAT 13:22\x*
