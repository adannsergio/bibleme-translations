\v 39 \w E|strong="G2532"\w* \w os que iam à frente|strong="G3588,G4254"\w* \w o repreendiam|strong="G2008,G846"\w* \w para que se calasse|strong="G2443,G4601"\w*; \w ele|strong="G846"\w*, \w porém|strong="G1161"\w*, \w muito mais|strong="G4183,G3123"\w* \w gritava|strong="G2896"\w*: “\w Filho|strong="G5207"\w* \w de Davi|strong="G1138"\w*, \w tenha misericórdia de mim|strong="G1653,G3165"\w*!”\x - \xo 18:39 \xt MRK 10:48; MAT 20:31; MAT 9:27; MAT 15:22; LUK 18:5; MAT 20:29\x*
\v 40 \w Parando|strong="G2476"\w* \w Jesus|strong="G3588,G2424"\w* \w mandou|strong="G2753"\w* \w que ele fosse trazido|strong="G846,G71"\w* \w até si|strong="G4314,G846"\w*; \w quando ele se aproximou|strong="G1448,G846"\w* \w lhe perguntou|strong="G1905,G846"\w*:\x - \xo 18:40 \xt ACT 5:27; MAT 20:29; ROM 12:12; MRK 10:49; JHN 1:38; PRO 19:7\x*
\v 41 “\w O que|strong="G5101"\w* \w você quer|strong="G2309"\w* \w que eu faça|strong="G4160"\w* \w por você|strong="G4771"\w*?” \w Ele|strong="G3588"\w* \w disse|strong="G2036"\w*: “\w Senhor|strong="G2962"\w*, \w que eu volte a ver|strong="G2443,G308"\w*.”\x - \xo 18:41 \xt MRK 10:51; JHN 5:6; MAT 20:29; ROM 12:12; 1KI 3:5-15; MAT 20:21\x*
