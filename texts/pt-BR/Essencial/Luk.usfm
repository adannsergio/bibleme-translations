\v 24 \w E|strong="G2532"\w* \w ele|strong="G846"\w*, \w chamando em voz alta|strong="G5455"\w*, \w disse|strong="G2036"\w*: ‘\w Pai|strong="G3962"\w* \w Abraão|strong="G11"\w*, \w tenha misericórdia de mim|strong="G1653,G3165"\w* \w e|strong="G2532"\w* \w envie|strong="G3992"\w* \w Lázaro|strong="G2976"\w*, \w para que|strong="G2443"\w* \w molhe|strong="G911"\w* \w a ponta|strong="G3588,G206"\w* \w do seu dedo|strong="G3588,G1147,G846"\w* \w em água|strong="G5204"\w* \w e|strong="G2532"\w* \w refresque|strong="G2711"\w* \w a minha língua|strong="G3588,G1100,G3165"\w*, \w porque|strong="G3754"\w* \w sofro|strong="G3600"\w* \w nesta chama|strong="G1722,G3588,G5395,G3778"\w*.’\x - \xo 16:24 \xt REV 22:1; JHN 4:10; MAT 10:28; COL 3:2; JAS 3:6; JHN 4:14\x*
\v 25 \w Disse|strong="G2036"\w* \w Abraão|strong="G11"\w*: ‘\w Filho|strong="G5043"\w*, \w lembre-se|strong="G3403"\w* \w de que|strong="G3754"\w* \w recebeu|strong="G618"\w* \w os seus bens|strong="G3588,G18,G4771"\w* \w na sua vida|strong="G1722,G3588,G2222,G4771"\w*, \w e|strong="G2532"\w* \w Lázaro|strong="G2976"\w* \w da mesma forma|strong="G3668"\w* \w os males|strong="G3588,G2556"\w*; \w mas agora|strong="G3568,G1161"\w* \w aqui|strong="G5602"\w* \w ele é consolado|strong="G3870"\w*, \w e você|strong="G4771,G1161"\w* \w sofre|strong="G3600"\w*\f + \fr 16.25: \ft Lit.: παρακαλέω, “consolar” (também “exortar, pedir”): aqui, passivo, “ser consolado”.\f*.\x - \xo 16:25 \xt GAL 6:7; MAT 16:26; MAT 5:4; LUK 6:24; 1JN 2:15; MAT 10:28\x*
\v 26 \w E|strong="G2532"\w* \w além de tudo isso|strong="G1722,G3956,G3778"\w*, \w entre nós|strong="G3342,G3165"\w* \w e|strong="G2532"\w* \w vocês|strong="G4771"\w* \w foi fixado|strong="G4741"\w* \w um grande|strong="G3173"\w* \w abismo|strong="G5490"\w*, \w para que|strong="G3704"\w* \w os que querem|strong="G3588,G2309"\w* \w passar|strong="G1224"\w* \w daqui|strong="G6033"\w* \w até vocês|strong="G4314,G4771"\w* \w não possam|strong="G3361,G1410"\w*, \w nem|strong="G3366"\w* \w de lá|strong="G1564"\w* \w até nós|strong="G4314,G3165"\w* \w atravessem|strong="G1276"\w*.’\x - \xo 16:26 \xt 1CO 10:13; MAT 10:28; 1SA 28:15; ECC 9:4; JHN 3:36; ECC 11:3\x*
\v 27 \w Disse|strong="G2036"\w*: ‘\w Peço-lhe|strong="G2065,G4771"\w*, \w então|strong="G3767"\w*, \w pai|strong="G3962"\w*, \w que o envie|strong="G2443,G3992,G846"\w* \w à casa|strong="G1519,G3588,G3624"\w* \w do meu pai|strong="G3588,G3962,G3165"\w*,\x - \xo 16:27 \xt JHN 16:5; ECC 9:4; JOB 42:10; PSA 37:10; PSA 17:14; ECC 2:18\x*
\v 28 \w pois|strong="G1063"\w* \w tenho|strong="G2192"\w* \w cinco irmãos|strong="G4002,G80"\w*, \w para que|strong="G3704"\w* \w lhes dê testemunho solene|strong="G1263,G846"\w*, \w a fim de que|strong="G2443,G3361"\w* \w também|strong="G2532"\w* \w eles|strong="G846"\w* \w não venham|strong="G2064"\w* \w a este lugar|strong="G1519,G3588,G5117,G3778"\w* \w de tormento|strong="G3588,G931"\w*.’\x - \xo 16:28 \xt HEB 12:1; ECC 9:4; LUK 16:23; PSA 37:10; PSA 17:14; ECC 2:18\x*
\v 29 \w Disse|strong="G3004"\w* \w Abraão|strong="G11"\w*: ‘\w Eles têm|strong="G2192"\w* \w Moisés|strong="G3475"\w* \w e|strong="G2532"\w* \w os profetas|strong="G3588,G4396"\w*; \w que os escutem|strong="G191,G846"\w*.’\x - \xo 16:29 \xt LUK 24:27; ACT 7:37; JHN 8:53; JER 6:16; ROM 10:17; JHN 5:39\x*
\v 30 \w Ele|strong="G3588"\w* \w disse|strong="G2036"\w*: ‘\w Não|strong="G3780"\w*, \w pai|strong="G3962"\w* \w Abraão|strong="G11"\w*; \w mas|strong="G235"\w* \w se alguém|strong="G1437,G5100"\w* \w dentre os mortos|strong="G575,G3498"\w* \w for|strong="G4198"\w* \w até eles|strong="G4314,G846"\w*, \w se arrependerão|strong="G3340"\w*.’\x - \xo 16:30 \xt LUK 13:3; LUK 13:5; ROM 10:17; ECC 12:12; ISA 8:20; LUK 16:24\x*
