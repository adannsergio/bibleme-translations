\c 1
\p
\v 1 \w Visto que|strong="G1895"\w* \w muitos|strong="G4183"\w* \w tentaram|strong="G2021"\w* \w pôr em ordem|strong="G392"\w* \w uma narrativa|strong="G1335"\w* \w a respeito dos|strong="G4012,G3588"\w* \w fatos|strong="G4229"\w* \w que se cumpriram|strong="G4135"\w* \w entre nós|strong="G1722,G3165"\w*,\f + \fr 1.1: \ft Lit.: πεπληροφορημένων, “plenamente realizados” ou “plenamente aceitos e cridos”; πράγματα, “fatos, acontecimentos”.\f*\x - \xo 1:1 \xt ACT 1:1-3; 2PE 1:16-19; JHN 20:31; 1TI 3:16; 2TI 4:17; LUK 1:3\x*
\v 2 \w conforme|strong="G2531"\w* \w nos transmitiram|strong="G3860,G3165"\w* \w aqueles que|strong="G3588"\w* \w desde o princípio|strong="G575,G746"\w* \w foram|strong="G1096"\w* \w testemunhas oculares|strong="G845"\w* \w e|strong="G2532"\w* \w servidores|strong="G5257"\w* \w da palavra|strong="G3588,G3056"\w*,\f + \fr 1.2: \ft Lit.: ὑπηρέτης, “servidor, auxiliar”; λόγος, “palavra, mensagem”.\f*\x - \xo 1:2 \xt JHN 6:64; JHN 15:27; ACT 26:16; HEB 2:3; 2PE 1:16; 1JN 1:1\x*
\v 3 \w pareceu bem|strong="G1380"\w* \w também a mim|strong="G2532,G1473"\w*, \w tendo acompanhado de perto|strong="G3877"\w* \w desde o início|strong="G509"\w* \w todas as coisas|strong="G3956"\w*, \w escrever|strong="G1125"\w* \w para você|strong="G4771"\w* \w com exatidão|strong="G199"\w* \w em ordem|strong="G2517"\w*, \w excelentíssimo|strong="G2903"\w* \w Teófilo|strong="G2321"\w*,\f + \fr 1.3: \ft Lit.: ἄνωθεν, “desde o início” ou “desde o alto”; καθεξῆς, “em ordem, em sequência”; κράτιστος, título de respeito (“excelentíssimo”; também em At 23:26; 24:3; 26:25).\f*\x - \xo 1:3 \xt ACT 26:25; ACT 23:26; ACT 24:3; ACT 1:1; ECC 12:9; MRK 1:1\x*
\v 4 \w para que|strong="G2443"\w* \w reconheça|strong="G1921"\w* \w a certeza|strong="G3588,G803"\w* \w das palavras|strong="G4012,G3739,G3056"\w* \w em que foi instruído|strong="G2727"\w*.\f + \fr 1.4: \ft Lit.: κατηχέω, “instruir de viva voz” (origem de “catequese”); ἀσφάλεια, “firmeza, segurança, certeza”.\f*\x - \xo 1:4 \xt JHN 20:31; ACT 18:25; JHN 20:30; PRO 22:21; 1CO 14:19; GAL 6:6\x*
\p
\v 5 \w Houve|strong="G1096"\w* \w nos dias|strong="G1722,G3588,G2250"\w* \w de Herodes|strong="G2264"\w*, \w rei|strong="G935"\w* \w da Judeia|strong="G3588,G2449"\w*, \w um certo|strong="G5100"\w* \w sacerdote|strong="G2409"\w* \w chamado|strong="G3686"\w* \w Zacarias|strong="G2197"\w*, \w da turma de serviço|strong="G1537,G2183"\w* \w de Abias|strong="G7"\w*; \w e|strong="G2532"\w* \w a mulher dele|strong="G1135,G846"\w* \add era\add* \w das filhas|strong="G1537,G3588,G2364"\w* \w de Arão|strong="G2"\w*, \w e|strong="G2532"\w* \w o nome dela|strong="G3588,G3686,G846"\w* \add era\add* \w Elisabete|strong="G1665"\w*.\f + \fr 1.5: \ft Nota cultural: o serviço no templo era dividido em 24 turmas de sacerdotes, que se revezavam; 1Cr 24:10 cita a de Abias como a oitava.\f*\f + \fr 1.5: \ft Acréscimo: “era” (em “mulher dele era das filhas”), “era” (em “nome dela era Elisabete”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\f + \fr 1.5: \ft Tradução: ὀνόματι (ὄνομα, G3686) está aqui como “chamado”; o termo pode ser “nome”, “reputação”, “pessoa” ou “autoridade”, e o contexto decide.\f*\x - \xo 1:5 \xt 1CH 24:10; MAT 2:1; 1CH 24:19; LUK 1:8; NEH 12:17; NEH 12:4\x*
\v 6 \w E|strong="G1161"\w* \w ambos|strong="G297"\w* \w eram|strong="G1510"\w* \w justos|strong="G1342"\w* \w diante de|strong="G1726"\w* \w Deus|strong="G3588,G2316"\w*, \w andando|strong="G4198"\w* \w em todos|strong="G1722,G3956"\w* \w os mandamentos|strong="G3588,G1785"\w* \w e|strong="G2532"\w* \w as normas|strong="G1345"\w* \w do Senhor|strong="G3588,G2962"\w*, \w sem culpa|strong="G273"\w*.\x - \xo 1:6 \xt MAT 6:33; PSA 119:1; GEN 17:1; DEU 28:1; JAS 1:27; GEN 6:9\x*
\v 7 \w E|strong="G2532"\w* \w não tinham|strong="G3756,G1510,G846"\w* \w filho|strong="G5043"\w*, \w porque|strong="G2530"\w* \w Elisabete|strong="G3588,G1665"\w* \w era|strong="G1510"\w* \w estéril|strong="G4723"\w*, \w e|strong="G2532"\w* \w ambos|strong="G297"\w* \w já estavam|strong="G1510"\w* \w avançados|strong="G4260"\w* \w em idade|strong="G1722,G3588,G2250,G846"\w*.\f + \fr 1.7: \ft Lit.: ἐν ταῖς ἡμέραις αὐτῶν, literalmente “em seus dias”: expressão idiomática para “em idade”.\f*\x - \xo 1:7 \xt GEN 25:21; HEB 11:11; 2KI 4:14; JDG 13:2; 1SA 1:2; GEN 18:11\x*
\p
\v 8 \w Aconteceu|strong="G1096,G1161"\w* \add que,\add* \w enquanto|strong="G1722,G3588"\w* \w ele|strong="G846"\w* \w exercia o sacerdócio|strong="G2407"\w* \w na ordem|strong="G1722,G3588,G5010"\w* \w de sua turma|strong="G3588,G2183,G846"\w* \w diante de|strong="G1725"\w* \w Deus|strong="G3588,G2316"\w*,\f + \fr 1.8: \ft Acréscimo: “que” (em “Aconteceu que enquanto ele”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 1:8 \xt 1CH 24:19; 2CH 8:14; 2CH 31:2; LUK 1:5; EXO 29:1; EXO 29:9\x*
\v 9 \w segundo o costume|strong="G2596,G3588,G1485"\w* \w do sacerdócio|strong="G3588,G2405"\w*, \w coube-lhe por sorteio|strong="G2975"\w* \w oferecer incenso|strong="G3588,G2370"\w*, \w entrando|strong="G1525"\w* \w no santuário|strong="G1519,G3588,G3485"\w* \w do Senhor|strong="G3588,G2962"\w*;\f + \fr 1.9: \ft Nota cultural: o sorteio escolhia o sacerdote que oferecia o incenso diante do santuário, honra que a maioria dos sacerdotes recebia no máximo uma vez na vida.\f*\x - \xo 1:9 \xt 2CH 29:11; PSA 141:2; 1CH 23:13; EXO 30:7; NUM 16:40; 1SA 2:28\x*
\v 10 \w e|strong="G2532"\w* \w toda a multidão|strong="G3956,G3588,G4128"\w* \w do povo|strong="G3588,G2992"\w* \w estava|strong="G1510"\w* \w orando|strong="G4336"\w* \w do lado de fora|strong="G1854"\w* \w na hora|strong="G3588,G5610"\w* \w do incenso|strong="G3588,G2368"\w*.\x - \xo 1:10 \xt PSA 141:2; REV 8:3; ACT 3:1; LEV 16:17; MAT 1:20; REV 8:4\x*
\v 11 \w E|strong="G1161"\w* \w apareceu-lhe|strong="G3700,G846"\w* \w um anjo|strong="G32"\w* \w do Senhor|strong="G2962"\w*, \w em pé|strong="G2476"\w* \w à direita|strong="G1537,G1188"\w* \w do altar|strong="G3588,G2379"\w* \w do incenso|strong="G3588,G2368"\w*.\x - \xo 1:11 \xt REV 8:3; JDG 13:3; NUM 12:6; JDG 6:12; MAT 1:20; MAT 14:26\x*
\v 12 \w E|strong="G2532"\w* \w ficou perturbado|strong="G5015"\w* \w Zacarias|strong="G2197"\w* \w ao ver|strong="G1492"\w*, \w e|strong="G2532"\w* \w o medo|strong="G5401"\w* \w caiu|strong="G1968"\w* \w sobre ele|strong="G1909,G846"\w*.\x - \xo 1:12 \xt MAT 14:26; ACT 10:4; LUK 24:5; MAT 1:20; JDG 13:22; JDG 6:22\x*
\v 13 \w Então|strong="G1161"\w* \w o anjo|strong="G3588,G32"\w* \w lhe disse|strong="G2036,G4314,G846"\w*: “\w Não tenha medo|strong="G3361,G5399"\w*, \w Zacarias|strong="G2197"\w*, \w porque|strong="G1360"\w* \w foi ouvida|strong="G1522"\w* \w a sua oração|strong="G3588,G1162,G4771"\w*, \w e|strong="G2532"\w* \w a sua mulher|strong="G3588,G1135,G4771"\w* \w Elisabete|strong="G1665"\w* \w lhe dará à luz|strong="G1080,G4771"\w* \w um filho|strong="G5207"\w*, \w e|strong="G2532"\w* \w você lhe dará|strong="G2564,G846"\w* \w o nome|strong="G3588,G3686"\w* \w de João|strong="G2491"\w*.\f + \fr 1.13: \ft Lit.: καλέσεις τὸ ὄνομα αὐτοῦ, literalmente “chamará o nome dele”: expressão hebraica para dar nome.\f*\x - \xo 1:13 \xt ISA 41:10; 1SA 2:21; ACT 10:31; GEN 15:1; PSA 113:9; GEN 25:21\x*
\v 14 \w E|strong="G2532"\w* \w você terá|strong="G1510,G4771"\w* \w alegria|strong="G5479"\w* \w e|strong="G2532"\w* \w júbilo|strong="G20"\w*, \w e|strong="G2532"\w* \w muitos|strong="G4183"\w* \w se alegrarão|strong="G5463"\w* \w com o nascimento|strong="G1909,G3588,G1078"\w* \w dele|strong="G846"\w*.\x - \xo 1:14 \xt PSA 113:9; GEN 21:6; LUK 1:58; ECC 3:4; GEN 17:19; MAT 3:1\x*
\v 15 \w Pois|strong="G1063"\w* \w ele será|strong="G1510"\w* \w grande|strong="G3173"\w* \w diante do|strong="G1799,G3588"\w* \w Senhor|strong="G2962"\w*, \w e|strong="G2532"\w* \w vinho|strong="G3631"\w* \w e|strong="G2532"\w* \w bebida fermentada|strong="G4608"\w* \w de modo nenhum|strong="G3756,G3361"\w* \w beberá|strong="G4095"\w*, \w e|strong="G2532"\w* \w será cheio|strong="G4130"\w* \w do Espírito Santo|strong="G4151,G40"\w* \w já|strong="G2089"\w* \w desde o ventre|strong="G1537,G2836"\w* \w de sua mãe|strong="G3384,G846"\w*.\f + \fr 1.15: \ft Lit.: σίκερα, palavra de origem semítica: “bebida forte”, fermentada, que não é vinho de uva; aparece junto com “vinho” na regra do nazireu (Nm 6:3).\f*\x - \xo 1:15 \xt NUM 6:3; LUK 1:41; EPH 5:18; JER 1:5; PSA 113:9; NUM 6:2\x*
\v 16 \w E|strong="G2532"\w* \w fará voltar|strong="G1994"\w* \w muitos|strong="G4183"\w* \w dos filhos|strong="G3588,G5207"\w* \w de Israel|strong="G2474"\w* \w ao Senhor|strong="G1909,G2962"\w*, \w o Deus|strong="G3588,G2316"\w* \w deles|strong="G846"\w*.\x - \xo 1:16 \xt ISA 40:3; MAL 4:6; JHN 1:23; DAN 12:3; JHN 1:6; MRK 9:12\x*
\v 17 \w E|strong="G2532"\w* \w ele|strong="G846"\w* \w irá adiante|strong="G4281"\w* \w diante dele|strong="G1799,G846"\w* \w no espírito|strong="G1722,G4151"\w* \w e|strong="G2532"\w* \w no poder|strong="G1411"\w* \w de Elias|strong="G2243"\w*, \w para fazer voltar|strong="G1994"\w* \w os corações|strong="G2588"\w* \w dos pais|strong="G3962"\w* \w para os filhos|strong="G1909,G5043"\w* \w e|strong="G2532"\w* \w os desobedientes|strong="G545"\w* \w ao discernimento|strong="G1722,G5428"\w* \w dos justos|strong="G1342"\w*, \w para preparar|strong="G2090"\w* \w para o Senhor|strong="G2962"\w* \w um povo|strong="G2992"\w* \w pronto|strong="G2680"\w*.”\f + \fr 1.17: \ft Nota cultural: a primeira parte ecoa Ml 3:1 e 4:5-6 (Elias que volta antes do “dia do Senhor”).\f*\f + \fr 1.17: \ft Lit.: κατασκευάζω, “preparar, aprontar, equipar”.\f*\x - \xo 1:17 \xt MAL 4:5; MAL 3:1; ISA 40:3; MAL 4:6; MAT 11:14; JHN 1:23\x*
\v 18 \w E|strong="G2532"\w* \w Zacarias|strong="G2197"\w* \w disse|strong="G2036"\w* \w ao anjo|strong="G4314,G3588,G32"\w*: “\w Como|strong="G2596,G5101"\w* \w saberei|strong="G1097"\w* \w isto|strong="G3778"\w*? \w Pois|strong="G1063"\w* \w eu|strong="G1473"\w* \w sou|strong="G1510"\w* \w velho|strong="G4246"\w* \w e|strong="G2532"\w* \w a minha mulher|strong="G3588,G1135,G3165"\w* \w está avançada|strong="G4260"\w* \w em idade|strong="G1722,G3588,G2250,G846"\w*.”\f + \fr 1.18: \ft Tradução: ἡμέραις (ἡμέρα, G2250) está aqui como “em idade”; o termo pode ser “dia”, “tempo”, “período” ou “o Dia (do julgamento)”, e o contexto decide.\f*\x - \xo 1:18 \xt GEN 15:8; GEN 18:14; 2KI 4:16; GEN 17:19; GEN 18:12; GEN 17:17\x*
\v 19 \w E|strong="G2532"\w* \w o anjo|strong="G3588,G32"\w* \w respondeu|strong="G611"\w* \w e lhe disse|strong="G2036,G846"\w*: “\w Eu|strong="G1473"\w* \w sou|strong="G1510"\w* \w Gabriel|strong="G1043"\w*, \w aquele que está|strong="G3588,G3936"\w* \w diante de|strong="G1799"\w* \w Deus|strong="G3588,G2316"\w*, \w e|strong="G2532"\w* \w fui enviado|strong="G649"\w* \w para falar|strong="G2980"\w* \w com você|strong="G4314,G4771"\w* \w e|strong="G2532"\w* \w anunciar-lhe a boa notícia|strong="G2097,G4771"\w* \w destas coisas|strong="G3778"\w*.\f + \fr 1.19: \ft Lit.: εὐαγγελίζομαι, “anunciar a boa notícia”.\f*\x - \xo 1:19 \xt LUK 1:26; HEB 1:14; PSA 103:20; LUK 2:10; MAT 1:20; MAT 18:10\x*
\v 20 \w E|strong="G2532"\w* \w olhe|strong="G2400"\w*, \w você ficará|strong="G1510"\w* \w em silêncio|strong="G4623"\w* \w e|strong="G2532"\w* \w sem poder|strong="G3361,G1410"\w* \w falar|strong="G2980"\w* \w até o dia em que|strong="G891,G3739,G2250"\w* \w aconteçam|strong="G1096"\w* \w estas coisas|strong="G3778"\w*, \w porque|strong="G473,G3739"\w* \w não acreditou|strong="G3756,G4100"\w* \w nas minhas palavras|strong="G3588,G3056,G3165"\w*, \w as quais|strong="G3748"\w* \w se cumprirão|strong="G4137"\w* \w no devido tempo|strong="G1519,G3588,G2540,G846"\w*.”\x - \xo 1:20 \xt LUK 1:45; EZK 3:26; LUK 1:64; 2KI 4:16; EZK 24:27; GEN 17:19\x*
\v 21 \w E|strong="G2532"\w* \w o povo|strong="G3588,G2992"\w* \w estava esperando|strong="G1510,G4328"\w* \w Zacarias|strong="G3588,G2197"\w*, \w e|strong="G2532"\w* \w se admiravam|strong="G2296"\w* \w de ele demorar|strong="G1722,G3588,G5549,G846"\w* \w no santuário|strong="G1722,G3588,G3485"\w*.\x - \xo 1:21 \xt EZK 3:26; GEN 30:23; LEV 9:23\x*
\v 22 \w Ao sair|strong="G1831"\w* \w não podia|strong="G3756,G1410"\w* \w falar|strong="G2980"\w* \w com eles|strong="G846"\w*, \w e|strong="G2532"\w* \w perceberam|strong="G1921"\w* \w que|strong="G3754"\w* \w tivera|strong="G3708"\w* \w uma visão|strong="G3701"\w* \w no santuário|strong="G1722,G3588,G3485"\w*; \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w lhes fazia sinais|strong="G1510,G1269,G846"\w* \w e|strong="G2532"\w* \w permanecia|strong="G1265"\w* \w mudo|strong="G2974"\w*.\f + \fr 1.22: \ft Lit.: κωφός, “mudo” ou “surdo”: em 1:62 fazem-lhe sinais, o que sugere também surdez.\f*\x - \xo 1:22 \xt NUM 12:6; LUK 1:20; ACT 12:17; EZK 3:26; JHN 13:24; LEV 9:23\x*
\v 23 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w quando|strong="G5613"\w* \w se completaram|strong="G4130"\w* \w os dias|strong="G3588,G2250"\w* \w do seu serviço|strong="G3588,G3009,G846"\w*, \w ele foi embora|strong="G565"\w* \w para a sua casa|strong="G1519,G3588,G3624,G846"\w*.\f + \fr 1.23: \ft Lit.: λειτουργία, “serviço público, ministério sacerdotal”.\f*\f + \fr 1.23: \ft Acréscimo: “que” (em “E aconteceu que quando se”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 1:23 \xt 1CH 9:25; 2KI 11:5-7; MAT 9:7\x*
\v 24 \w E|strong="G1161"\w* \w depois|strong="G3326"\w* \w destes dias|strong="G3778,G3588,G2250"\w*, \w concebeu|strong="G4815"\w* \w Elisabete|strong="G1665"\w*, \w a mulher dele|strong="G3588,G1135,G846"\w*; \w e|strong="G2532"\w* \w se manteve escondida|strong="G4032,G1438"\w* \w por cinco meses|strong="G3376,G4002"\w*, \w dizendo|strong="G3004"\w*:\x - \xo 1:24 \xt LUK 1:36; GEN 21:2; 2KI 4:17\x*
\v 25 “\w Assim|strong="G3779"\w* \w fez por mim|strong="G3165,G4160"\w* \w o Senhor|strong="G2962"\w* \w nos dias|strong="G1722,G2250"\w* \w em que|strong="G3739"\w* \w olhou com favor|strong="G1896"\w* \w para tirar|strong="G851"\w* \w a minha vergonha|strong="G3681,G3165"\w* \w entre as pessoas|strong="G1722,G444"\w*.”\f + \fr 1.25: \ft Nota cultural: no mundo bíblico a falta de filhos era sentida como desonra (cf. Gn 30:23).\f*\x - \xo 1:25 \xt GEN 30:23; GEN 30:22-23; ISA 4:1; ISA 54:1-4; GEN 21:1-2; 1SA 1:6\x*
\p
\v 26 \w E|strong="G1161"\w* \w no sexto mês|strong="G1722,G3588,G3376,G1623"\w* \w foi enviado|strong="G649"\w* \w o anjo|strong="G3588,G32"\w* \w Gabriel|strong="G1043"\w* \w da parte de|strong="G575"\w* \w Deus|strong="G3588,G2316"\w* \w a uma cidade|strong="G1519,G4172"\w* \w da Galileia|strong="G3588,G1056"\w*, \w cujo nome|strong="G3739,G3686"\w* \add era\add* \w Nazaré|strong="G3478"\w*,\f + \fr 1.26: \ft Acréscimo: “era” (em “cujo nome era Nazaré”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 1:26 \xt LUK 1:19; MAT 2:23; JHN 7:41; LUK 2:4; DAN 8:16; JHN 1:45-46\x*
\v 27 \w a uma virgem|strong="G4314,G3933"\w* \w prometida em casamento|strong="G3423"\w* \w a um homem|strong="G435"\w* \w cujo nome|strong="G3739,G3686"\w* \add era\add* \w José|strong="G2501"\w*, \w da casa|strong="G1537,G3624"\w* \w de Davi|strong="G1138"\w*; \w e|strong="G2532"\w* \w o nome|strong="G3588,G3686"\w* \w da virgem|strong="G3588,G3933"\w* \add era\add* \w Maria|strong="G3137"\w*.\f + \fr 1.27: \ft Lit.: παρθένος, “virgem, moça solteira”; μνηστεύω, “prometer em casamento, noivar”.\f*\f + \fr 1.27: \ft Acréscimo: “era” (em “cujo nome era José da”), “era” (em “da virgem era Maria”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 1:27 \xt MAT 1:18; MAT 1:16; ISA 7:14; LUK 1:35; LUK 2:4; GEN 30:23\x*
\v 28 \w E|strong="G2532"\w* \w ao entrar|strong="G1525"\w* \w onde ela estava|strong="G4314,G846"\w*, \w disse|strong="G2036"\w*: “\w Alegre-se|strong="G5463"\w*, \w agraciada|strong="G5487"\w*! \w O Senhor|strong="G3588,G2962"\w* \w está com você|strong="G3326,G4771"\w*.”\f + \fr 1.28: \ft Lit.: κεχαριτωμένη, particípio de χαριτόω: “agraciada, favorecida, objeto da graça” (a tradição em português traz também “cheia de graça”); χαῖρε, saudação comum: “alegre-se, salve”.\f*\f + \fr 1.28: \ft Variante: Treg, NIV e RP acrescentam “o anjo” (ὁ ἄγγελος) depois de “entrando” e, no fim da saudação, “bendita é você entre as mulheres” (εὐλογημένη σὺ ἐν γυναιξίν), como em 1:42.\f*\f + \fr 1.28: \ft Acréscimo: verbo ser/estar suprido em “onde ela estava”, “está com você”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:28 \xt JDG 6:12; DAN 10:19; LUK 1:30; EPH 1:6; DAN 9:21-23; ACT 18:10\x*
\v 29 \w Ela|strong="G3588"\w* \w ficou muito perturbada|strong="G1298"\w* \w com a palavra|strong="G1909,G3588,G3056"\w* \w e|strong="G2532"\w* \w refletia|strong="G1260"\w* \w que tipo de|strong="G4217"\w* \w saudação|strong="G3588,G783"\w* \w seria|strong="G1510"\w* \w esta|strong="G3778"\w*.\f + \fr 1.29: \ft Variante: O RP traz “ao vê-lo” (ἰδοῦσα) antes de “ficou muito perturbada” e “com a palavra dele” (λόγῳ αὐτοῦ) no lugar de “com a palavra”.\f*\x - \xo 1:29 \xt MAT 1:18; 2SA 9:7; ACT 10:4; ACT 10:17; JDG 13:3; MAT 1:20\x*
\v 30 \w E|strong="G2532"\w* \w o anjo|strong="G3588,G32"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Não tenha medo|strong="G3361,G5399"\w*, \w Maria|strong="G3137"\w*, \w pois|strong="G1063"\w* \w você encontrou|strong="G2147"\w* \w graça|strong="G5485"\w* \w diante de|strong="G3844"\w* \w Deus|strong="G3588,G2316"\w*;\x - \xo 1:30 \xt ISA 41:10; MAT 28:5; MAT 1:20; LUK 1:28; GEN 15:1; LUK 1:13\x*
\v 31 \w e|strong="G2532"\w* \w olhe|strong="G2400"\w*, \w você conceberá|strong="G4815"\w* \w no ventre|strong="G1722,G1064"\w* \w e|strong="G2532"\w* \w dará à luz|strong="G5088"\w* \w um filho|strong="G5207"\w*, \w e|strong="G2532"\w* \w lhe dará|strong="G2564,G846"\w* \w o nome|strong="G3588,G3686"\w* \w de Jesus|strong="G2424"\w*.\f + \fr 1.31: \ft Tradução: καλέσεις (καλέω, G2564) está aqui como “lhe dará”; o termo pode ser “chamar”, “convidar”, “dar nome” ou “convocar”, e o contexto decide.\f*\x - \xo 1:31 \xt MAT 1:23; MAT 1:25; MAT 1:21; LUK 2:21; ISA 7:14; JHN 1:14\x*
\v 32 \w Este|strong="G3778"\w* \w será|strong="G1510"\w* \w grande|strong="G3173"\w* \w e|strong="G2532"\w* \w será chamado|strong="G2564"\w* \w Filho|strong="G5207"\w* \w do Altíssimo|strong="G5310"\w*, \w e|strong="G2532"\w* \w o Senhor Deus|strong="G2962,G3588,G2316"\w* \w lhe dará|strong="G1325,G846"\w* \w o trono|strong="G3588,G2362"\w* \w de Davi|strong="G1138"\w*, \w seu pai|strong="G3588,G3962,G846"\w*,\f + \fr 1.32: \ft Lit.: υἱὸς Ὑψίστου, “Filho do Altíssimo”: sem artigo no grego; “Altíssimo” é título de Deus.\f*\x - \xo 1:32 \xt LUK 20:44; MRK 11:10; LUK 1:35; MRK 5:7; LUK 1:76; ISA 9:7\x*
\v 33 \w e|strong="G2532"\w* \w reinará|strong="G936"\w* \w sobre a casa|strong="G1909,G3588,G3624"\w* \w de Jacó|strong="G2384"\w* \w para sempre|strong="G1519,G3588,G165"\w*, \w e|strong="G2532"\w* \w o reino dele|strong="G3588,G932,G846"\w* \w não terá|strong="G3756,G1510"\w* \w fim|strong="G5056"\w*.”\x - \xo 1:33 \xt REV 11:15; ISA 9:7; DAN 2:44; HEB 1:8; JER 23:5; JHN 1:14\x*
\v 34 \w Maria|strong="G3137"\w* \w disse|strong="G2036"\w* \w então|strong="G1161"\w* \w ao anjo|strong="G4314,G3588,G32"\w*: “\w Como|strong="G4459"\w* \w será|strong="G1510"\w* \w isto|strong="G3778"\w*, \w já que|strong="G1893"\w* \w não conheço|strong="G3756,G1097"\w* \w homem|strong="G435"\w*?”\f + \fr 1.34: \ft Lit.: γινώσκω, “conhecer”: eufemismo bíblico para relação sexual (cf. Gn 4:1).\f*\x - \xo 1:34 \xt GEN 4:1; MAT 1:16; ROM 3:6; JHN 1:14; GEN 3:15; MAT 1:18\x*
\v 35 \w E|strong="G2532"\w* \w o anjo|strong="G3588,G32"\w* \w respondeu|strong="G611"\w* \w e lhe disse|strong="G2036,G846"\w*: “\w O Espírito Santo|strong="G4151,G40"\w* \w virá|strong="G1904"\w* \w sobre você|strong="G1909,G4771"\w*, \w e|strong="G2532"\w* \w o poder|strong="G1411"\w* \w do Altíssimo|strong="G5310"\w* \w a cobrirá com a sua sombra|strong="G1982,G4771"\w*; \w por isso|strong="G1352"\w* \w também|strong="G2532"\w* \w o que vai nascer|strong="G3588,G1080"\w* \w será chamado|strong="G2564"\w* \w santo|strong="G40"\w*, \w Filho|strong="G5207"\w* \w de Deus|strong="G2316"\w*.\f + \fr 1.35: \ft Lit.: ἐπισκιάζω, “cobrir com sombra”, imagem da presença de Deus (cf. Êx 40:35, a nuvem sobre a tenda); o grego também pode ser lido “o santo que vai nascer será chamado Filho de Deus”.\f*\x - \xo 1:35 \xt EXO 40:35; LUK 1:32; ACT 1:8; ISA 7:14; JHN 1:14; ISA 9:6\x*
\v 36 \w E|strong="G2532"\w* \w olhe|strong="G2400"\w*, \w Elisabete|strong="G1665"\w*, \w sua parenta|strong="G3588,G6080,G4771"\w*, \w também|strong="G2532"\w* \w ela|strong="G846"\w* \w concebeu|strong="G4815"\w* \w um filho|strong="G5207"\w* \w na velhice|strong="G1722,G1094"\w* \w dela|strong="G846"\w*, \w e|strong="G2532"\w* \w este|strong="G3778"\w* \w é o sexto|strong="G1623,G1510"\w* \w mês|strong="G3376"\w* \w para ela|strong="G846"\w*, \w a que era chamada|strong="G3588,G2564"\w* \w estéril|strong="G4723"\w*;\f + \fr 1.36: \ft Lit.: συγγενίς, “parenta, familiar” (mulher da mesma família ou clã).\f*\x - \xo 1:36 \xt LUK 1:24; MAT 1:21; HEB 11:11; MAT 1:18; GEN 21:2; 2KI 4:17\x*
\v 37 \w porque|strong="G3754"\w* \w nenhuma palavra|strong="G3756,G3956,G4487"\w* \w será impossível|strong="G101"\w* \w para Deus|strong="G3844,G3588,G2316"\w*.”\f + \fr 1.37: \ft Lit.: ῥῆμα, “palavra” ou “coisa, fato”.\f*\f + \fr 1.37: \ft Nota cultural: ecoa Gn 18:14 (“há algo impossível para o Senhor?”), dito a Sara.\f*\x - \xo 1:37 \xt GEN 18:14; JER 32:17; JER 32:27; LUK 18:27; MRK 10:27; MAT 19:26\x*
\v 38 \w Então|strong="G1161"\w* \w Maria|strong="G3137"\w* \w disse|strong="G2036"\w*: “\w Aqui está|strong="G2400"\w* \w a serva|strong="G3588,G1401"\w* \w do Senhor|strong="G2962"\w*; \w que aconteça|strong="G1096"\w* \w comigo|strong="G3165"\w* \w conforme|strong="G2596"\w* \w a sua palavra|strong="G3588,G4487,G4771"\w*.” \w E|strong="G2532"\w* \w o anjo|strong="G3588,G32"\w* \w foi embora|strong="G565"\w* \w de junto dela|strong="G575,G846"\w*.\f + \fr 1.38: \ft Lit.: δούλη, feminino de δοῦλος: “escrava, serva”; Ἰδού, “olhe, eis”.\f*\f + \fr 1.38: \ft Lit.: δοῦλος aqui como autodesignação devocional, “servo de Deus/Cristo” (eco do hebraico עבד יהוה, “servo do SENHOR”, título de Moisés e dos profetas); onde a mesma palavra descreve a condição social, fica “escravo” (ver convencoes.md).\f*\f + \fr 1.38: \ft Acréscimo: verbo ser/estar suprido em “Aqui está”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:38 \xt ROM 4:20-21; MAT 1:18; PSA 119:38; PSA 116:16; 2SA 7:25-29; PRO 31:26\x*
\p
\v 39 \w Naqueles dias|strong="G1722,G3588,G2250,G3778"\w*, \w Maria|strong="G3137"\w* \w se levantou|strong="G450"\w* \w e|strong="G1161"\w* \w foi|strong="G4198"\w* \w com pressa|strong="G3326,G4710"\w* \w à região montanhosa|strong="G1519,G3588,G3714"\w*, \w a uma cidade|strong="G1519,G4172"\w* \w de Judá|strong="G2448"\w*,\f + \fr 1.39: \ft Lit.: ὀρεινή, “região montanhosa”; o texto não nomeia a cidade de Judá.\f*\x - \xo 1:39 \xt JOS 20:7; LUK 1:65; JOS 21:11; LUK 2:16\x*
\v 40 \w e|strong="G2532"\w* \w entrou|strong="G1525"\w* \w na casa|strong="G1519,G3588,G3624"\w* \w de Zacarias|strong="G2197"\w* \w e|strong="G2532"\w* \w saudou|strong="G782"\w* \w Elisabete|strong="G3588,G1665"\w*.\x - \xo 1:40 \xt MAT 10:12; LUK 1:13; LUK 1:5\x*
\v 41 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w quando|strong="G5613"\w* \w Elisabete|strong="G3588,G1665"\w* \w ouviu|strong="G191"\w* \w a saudação|strong="G3588,G783"\w* \w de Maria|strong="G3588,G3137"\w*, \w o bebê|strong="G3588,G1025"\w* \w saltou|strong="G4640"\w* \w no ventre|strong="G1722,G3588,G2836"\w* \w dela|strong="G846"\w*, \w e|strong="G2532"\w* \w Elisabete|strong="G3588,G1665"\w* \w ficou cheia|strong="G4130"\w* \w do Espírito Santo|strong="G4151,G40"\w*.\f + \fr 1.41: \ft Lit.: βρέφος, “bebê, criança ainda no ventre ou recém-nascida”; σκιρτάω, “saltar, dar pulos”.\f*\f + \fr 1.41: \ft Acréscimo: “que” (em “E aconteceu que quando Elisabete”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 1:41 \xt LUK 1:44; LUK 1:15; JER 1:5; JHN 14:26; LUK 1:67; ACT 4:8\x*
\v 42 \w E|strong="G2532"\w* \w exclamou|strong="G400"\w* \w com um grande grito|strong="G2906,G3173"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Bendita|strong="G2127"\w* \w é você|strong="G4771"\w* \w entre as mulheres|strong="G1722,G1135"\w*, \w e|strong="G2532"\w* \w bendito|strong="G2127"\w* \w o fruto|strong="G3588,G2590"\w* \w do seu ventre|strong="G3588,G2836,G4771"\w*!\f + \fr 1.42: \ft Acréscimo: verbo ser/estar suprido em “é você”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:42 \xt LUK 1:28; JDG 5:24; GEN 22:18; LUK 1:48; LUK 19:38; PRO 31:26\x*
\v 43 \w E|strong="G2532"\w* \w de onde|strong="G4159"\w* \w me vem|strong="G3165"\w* \w isto|strong="G3778"\w*, \w que|strong="G2443"\w* \w venha|strong="G2064"\w* \w a mãe|strong="G3588,G3384"\w* \w do meu Senhor|strong="G3588,G2962,G3165"\w* \w até mim|strong="G4314,G1473"\w*?\x - \xo 1:43 \xt LUK 2:11; PRO 31:26; JHN 20:28; RUT 2:10; JHN 13:13; 1SA 25:41\x*
\v 44 \w Pois|strong="G1063"\w* \w olhe|strong="G2400"\w*, \w assim que|strong="G5613"\w* \w chegou|strong="G1096"\w* \w a voz|strong="G3588,G5456"\w* \w da sua saudação|strong="G3588,G783,G4771"\w* \w aos meus ouvidos|strong="G1519,G3588,G3775,G3165"\w*, \w o bebê|strong="G3588,G1025"\w* \w saltou|strong="G4640"\w* \w de alegria|strong="G1722,G20"\w* \w no meu ventre|strong="G1722,G3588,G2836,G3165"\w*.\x - \xo 1:44 \xt LUK 1:41; PRO 31:26; LUK 6:23\x*
\v 45 \w E|strong="G2532"\w* \w feliz|strong="G3107"\w* \w a que creu|strong="G3588,G4100"\w* \w que|strong="G3754"\w* \w haverá|strong="G1510"\w* \w cumprimento|strong="G5050"\w* \w para o que|strong="G3588"\w* \w lhe foi dito|strong="G2980,G846"\w* \w da parte do|strong="G3844"\w* \w Senhor|strong="G2962"\w*!”\x - \xo 1:45 \xt JHN 20:29; JHN 11:40; LUK 11:27-28; LUK 1:20; 2CH 20:20; ROM 4:21\x*
\q1
\v 46 \w E|strong="G2532"\w* \w Maria|strong="G3137"\w* \w disse|strong="G2036"\w*: “\w Engrandece|strong="G3170"\w* \w a minha alma|strong="G3588,G5590,G3165"\w* \w o Senhor|strong="G3588,G2962"\w*,\x - \xo 1:46 \xt PSA 34:3; 1SA 2:1; PSA 34:2-3; PSA 35:9; PSA 103:1; HAB 3:18\x*
\q1
\v 47 \w e|strong="G2532"\w* \w exulta|strong="G21"\w* \w o meu espírito|strong="G3588,G4151,G3165"\w* \w em Deus|strong="G1909,G3588,G2316"\w*, \w meu Salvador|strong="G3588,G4990,G3165"\w*,\f + \fr 1.47: \ft Lit.: ἠγαλλίασεν, aoristo: “exultou” ou “exulta” (o aoristo pode indicar o momento do canto).\f*\x - \xo 1:47 \xt PSA 51:12; PSA 103:1; 1SA 2:1; HAB 3:18; PRO 31:30; PSA 104:34\x*
\q1
\v 48 \w porque|strong="G3754"\w* \w olhou|strong="G1914"\w* \w para a humilde condição|strong="G1909,G3588,G5014"\w* \w da sua serva|strong="G3588,G1401,G846"\w*; \w pois|strong="G1063"\w* \w olhem|strong="G2400"\w*, \w de agora em diante|strong="G575,G3588,G3568"\w* \w me chamarão feliz|strong="G3106,G3165"\w* \w todas as gerações|strong="G3956,G3588,G1074"\w*;\f + \fr 1.48: \ft Tradução: δούλης (δοῦλος, G1401) está aqui como “da sua serva”; o termo pode ser “escravo” (condição social), “servo” ou “servidor”, e o contexto decide.\f*\x - \xo 1:48 \xt 1SA 2:1; PRO 10:7; PRO 31:30; PSA 138:6; EST 2:17; 1CO 1:26-28\x*
\q1
\v 49 \w porque|strong="G3754"\w* \w fez por mim|strong="G4160,G3165"\w* \w grandes coisas|strong="G3173"\w* \w o Poderoso|strong="G3588,G1415"\w*, \w e|strong="G2532"\w* \w santo|strong="G40"\w* \add é\add* \w o nome|strong="G3588,G3686"\w* \w dele|strong="G846"\w*;\f + \fr 1.49: \ft Acréscimo: “é” (em “e santo é o nome”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 1:49 \xt EPH 3:20; PSA 126:2-3; PSA 111:9; PSA 126:3; PSA 99:3; JER 10:6\x*
\q1
\v 50 \w e|strong="G2532"\w* \w a sua misericórdia|strong="G3588,G1656,G846"\w* \add é\add* \w de geração|strong="G1519,G1074"\w* \w em geração|strong="G2532,G1074"\w* \w para os que o temem|strong="G3588,G5399,G846"\w*.\f + \fr 1.50: \ft Acréscimo: “é” (em “sua misericórdia é de geração”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 1:50 \xt LAM 3:22; ECC 12:13; PSA 103:17-18; EXO 20:6; PSA 128:1; PSA 112:1\x*
\q1
\v 51 \w Agiu com poder|strong="G4160,G2904"\w* \w com o seu braço|strong="G1722,G1023,G846"\w*, \w dispersou|strong="G1287"\w* \w os orgulhosos|strong="G5244"\w* \w nos pensamentos|strong="G1271"\w* \w do coração deles|strong="G2588,G846"\w*;\x - \xo 1:51 \xt PSA 34:10; 2CO 10:5; DAN 2:21; 1SA 2:1; GEN 11:8; MAT 23:12\x*
\q1
\v 52 \w derrubou|strong="G2507"\w* \w os poderosos|strong="G1413"\w* \w de seus tronos|strong="G575,G2362"\w* \w e|strong="G2532"\w* \w elevou|strong="G5312"\w* \w os humildes|strong="G5011"\w*;\x - \xo 1:52 \xt 1PE 5:6; JAS 4:10; PSA 34:10; PSA 113:7; PSA 75:7; EZK 17:24\x*
\q1
\v 53 \w os famintos|strong="G3983"\w* \w encheu|strong="G1705"\w* \w de coisas boas|strong="G18"\w*, \w e|strong="G2532"\w* \w os ricos|strong="G4147"\w* \w mandou embora|strong="G1821"\w* \w vazios|strong="G2756"\w*.\x - \xo 1:53 \xt MAT 5:6; JER 31:25; PSA 34:10; PSA 107:9; PSA 113:7; 1SA 2:1\x*
\q1
\v 54 \w Socorreu|strong="G482"\w* \w Israel|strong="G2474"\w*, \w seu servo|strong="G3816,G846"\w*, \w lembrando-se|strong="G3403"\w* \w da misericórdia|strong="G1656"\w*,\f + \fr 1.54: \ft Lit.: παῖς, “servo; criança”; aqui Israel como “servo” de Deus (cf. Is 41:8).\f*\x - \xo 1:54 \xt ISA 41:8; LUK 1:72; 1SA 2:1; PSA 37:25; PSA 98:3; GEN 21:6\x*
\q1
\v 55 \w como|strong="G2531"\w* \w falou|strong="G2980"\w* \w aos nossos|strong="G4314,G3588,G3165"\w* \w pais|strong="G3962"\w*, \w a Abraão|strong="G3588,G11"\w* \w e|strong="G2532"\w* \w à sua descendência|strong="G3588,G4690,G846"\w* \w para sempre|strong="G1519,G3588,G165"\w*.”\f + \fr 1.55: \ft Lit.: σπέρμα, “semente” e, em sentido coletivo, “descendência”.\f*\x - \xo 1:55 \xt GAL 3:16; HEB 2:16; 1SA 2:1; PSA 37:25; HEB 1:1; GEN 21:6\x*
\p
\v 56 \w E|strong="G1161"\w* \w Maria|strong="G3137"\w* \w ficou|strong="G3306"\w* \w com ela|strong="G4862,G846"\w* \w cerca de|strong="G5613"\w* \w três meses|strong="G3376,G5140"\w*, \w e|strong="G2532"\w* \w voltou|strong="G5290"\w* \w para a sua casa|strong="G1519,G3588,G3624,G846"\w*.\x - \xo 1:56 \xt 1SA 2:1; PRO 31:26; ROM 15:8\x*
