\c 19
\p
\v 1 \w E|strong="G2532"\w*, \w tendo entrado|strong="G1525"\w*, \w atravessava|strong="G1330"\w* \w Jericó|strong="G3588,G2410"\w*.\x - \xo 19:1 \xt JOS 6:1-27; LUK 18:35; 1KI 16:34; 2KI 2:18-22; JOS 2:1\x*
\v 2 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w um homem|strong="G435"\w* \w chamado|strong="G3686,G2564"\w* \w Zaqueu|strong="G2195"\w*, \w e|strong="G2532"\w* \w este|strong="G846"\w* \w era|strong="G1510"\w* \w chefe dos cobradores de impostos|strong="G754"\w* \w e|strong="G2532"\w* \w ele mesmo|strong="G846"\w* \w era rico|strong="G4145"\w*.\f + \fr 19.2: \ft Acréscimo: verbo ser/estar suprido em “era rico”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 19:2 \xt LUK 18:24-27; MAT 9:9; JHN 12:21; 1TI 6:17; MAT 5:46\x*
\v 3 \w E|strong="G2532"\w* \w procurava|strong="G2212"\w* \w ver|strong="G1492"\w* \w quem era|strong="G5101,G1510"\w* \w Jesus|strong="G3588,G2424"\w*, \w e|strong="G2532"\w* \w não conseguia|strong="G3756,G1410"\w* \w por causa da multidão|strong="G575,G3588,G3793"\w*, \w porque|strong="G3754"\w* \w era pequeno|strong="G3398,G1510"\w* \w de estatura|strong="G3588,G2244"\w*.\x - \xo 19:3 \xt MAT 9:9; JHN 12:21; LUK 23:8\x*
\v 4 \w E|strong="G2532"\w*, \w correndo na frente|strong="G4390,G1519,G3588,G1715"\w*, \w subiu|strong="G305"\w* \w num sicômoro|strong="G1909,G4809"\w*, \w para vê-lo|strong="G2443,G1492,G846"\w*, \w porque|strong="G3754"\w* \w por ali|strong="G1565"\w* \w estava para passar|strong="G3195,G1330"\w*.\x - \xo 19:4 \xt ISA 9:10; LUK 5:19; MAT 9:9; 1CO 13:7; JHN 12:21; 1CH 27:28\x*
\v 5 \w E|strong="G2532"\w* \w quando|strong="G5613"\w* \w chegou|strong="G2064"\w* \w ao lugar|strong="G1909,G3588,G5117"\w*, \w olhando para cima|strong="G308"\w*, \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G2036,G4314,G846"\w*: “\w Zaqueu|strong="G2195"\w*, \w desça depressa|strong="G4692,G2597"\w*; \w pois|strong="G1063"\w* \w hoje|strong="G4594"\w* \w é preciso|strong="G1163"\w* \w que eu fique|strong="G3165,G3306"\w* \w na sua casa|strong="G1722,G3588,G3624,G4771"\w*.”\f + \fr 19.5: \ft Variante: RP (e TR) acrescentam “viu-o e” (εἶδεν αὐτόν καὶ) antes de “disse-lhe”; WH, Treg e NA28 não trazem.\f*\x - \xo 19:5 \xt REV 3:20; JHN 14:23; MAT 9:9; 1CO 13:7; EZK 16:6; HEB 13:2\x*
\v 6 \w E|strong="G2532"\w* \w desceu depressa|strong="G4692,G2597"\w* \w e|strong="G2532"\w* \w o recebeu|strong="G5264,G846"\w*, \w alegre|strong="G5463"\w*.\x - \xo 19:6 \xt MAT 13:44; MAT 9:9; 1CO 13:7; ACT 16:34; LUK 5:29; ACT 16:15\x*
\v 7 \w E|strong="G2532"\w*, \w vendo isso|strong="G1492"\w*, \w todos|strong="G3956"\w* \w murmuravam|strong="G1234"\w*, \w dizendo|strong="G3004"\w*: “\w Foi hospedar-se|strong="G1525,G2647"\w* \w na casa|strong="G3844"\w* \w de um homem pecador|strong="G268,G435"\w*.”\x - \xo 19:7 \xt LUK 15:2; LUK 7:34; LUK 7:39; MAT 13:44; MAT 9:11; MAT 11:19\x*
\v 8 \w Em pé|strong="G2476"\w* \w Zaqueu|strong="G2195"\w* \w disse|strong="G2036"\w* \w ao Senhor|strong="G4314,G3588,G2962"\w*: “\w Olhe|strong="G2400"\w*, \w a metade|strong="G3588,G2255"\w* \w dos meus bens|strong="G3165,G3588,G5225"\w*, \w Senhor|strong="G2962"\w*, \w dou|strong="G1325"\w* \w aos pobres|strong="G3588,G4434"\w*; \w e|strong="G2532"\w* \w se|strong="G1487"\w* \w de alguém|strong="G5100"\w* \w algo|strong="G5100"\w* \w acusei falsamente|strong="G4811"\w*, \w devolvo|strong="G591"\w* \w o quádruplo|strong="G5073"\w*.”\f + \fr 19.8: \ft Lit.: συκοφαντέω, “acusar falsamente; extorquir mediante denúncia”; os verbos “dou” e “devolvo” estão no presente (promessa ou prática).\f*\x - \xo 19:8 \xt 2SA 12:6; NUM 5:7; LUK 18:22-23; PRO 6:31; MAT 13:44; EXO 22:1\x*
