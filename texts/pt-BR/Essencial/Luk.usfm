\v 29 \w E|strong="G2532"\w*, \w enquanto ele orava|strong="G1722,G3588,G4336,G846"\w*, \w a aparência|strong="G3588,G1491"\w* \w do seu rosto|strong="G3588,G4383,G846"\w* \w se tornou|strong="G1096"\w* \w diferente|strong="G2087"\w*, \w e|strong="G2532"\w* \w a sua roupa|strong="G3588,G2441,G846"\w* \w ficou branca|strong="G3022"\w* \w e fulgurante|strong="G1823"\w*.\f + \fr 9.29: \ft Lit.: ἐξαστράπτω, “brilhar como relâmpago”.\f*\x - \xo 9:29 \xt MRK 9:2; MAT 17:1; EXO 34:29; 2PE 1:16; MAT 17:2; JDG 13:6\x*
\v 30 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w dois homens|strong="G435,G1417"\w* \w conversavam|strong="G4814"\w* \w com ele|strong="G846"\w*, \w os quais eram|strong="G3748,G1510"\w* \w Moisés|strong="G3475"\w* \w e|strong="G2532"\w* \w Elias|strong="G2243"\w*,\x - \xo 9:30 \xt MAT 17:3; MRK 9:4; MRK 9:2; MAT 17:1; 2PE 1:16; MAL 4:5\x*
\v 31 \w os quais|strong="G3739"\w*, \w aparecendo|strong="G3700"\w* \w em glória|strong="G1722,G1391"\w*, \w falavam|strong="G3004"\w* \w da partida|strong="G3588,G1841"\w* \w dele|strong="G846"\w*, \w que|strong="G3739"\w* \w estava para cumprir|strong="G3195,G4137"\w* \w em Jerusalém|strong="G1722,G2419"\w*.\f + \fr 9.31: \ft Lit.: ἔξοδος, “saída, partida” (a mesma palavra de “Êxodo”): aqui, a sua partida deste mundo, em Jerusalém.\f*\x - \xo 9:31 \xt MRK 9:2; MAT 17:1; 2PE 1:16; JHN 19:28; MRK 9:4; ACT 3:22\x*
\v 32 \w Pedro|strong="G3588,G4074"\w* \w e|strong="G2532"\w* \w os que estavam com ele|strong="G3588,G4862,G846"\w* \w estavam|strong="G1510"\w* \w pesados|strong="G916"\w* \w de sono|strong="G5258"\w*; \w mas|strong="G1161"\w* \w tendo despertado completamente|strong="G1235"\w*, \w viram|strong="G1492"\w* \w a glória|strong="G3588,G1391"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w os dois homens|strong="G3588,G1417,G435"\w* \w que estavam em pé|strong="G3588,G4921"\w* \w com ele|strong="G846"\w*.\f + \fr 9.32: \ft Lit.: διαγρηγορέω, “ficar bem acordado, despertar completamente” (ou “permanecer acordado”).\f*\f + \fr 9.32: \ft Acréscimo: “os que estavam com ele”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 9:32 \xt JHN 1:14; MRK 9:2; MAT 17:1; 2PE 1:16; ACT 3:22; DAN 8:18\x*
\v 33 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w quando|strong="G1722,G3588"\w* \w eles se separavam|strong="G1316,G846"\w* \w dele|strong="G575,G846"\w*, \w Pedro|strong="G3588,G4074"\w* \w disse|strong="G2036"\w* \w a Jesus|strong="G4314,G3588,G2424"\w*: “\w Mestre|strong="G1988"\w*, \w é bom|strong="G2570,G1510"\w* \w que estejamos|strong="G3165,G1511"\w* \w aqui|strong="G5602"\w*; \w e|strong="G2532"\w* \w façamos|strong="G4160"\w* \w três tendas|strong="G4633,G5140"\w*: \w uma|strong="G1520"\w* \w para você|strong="G4771"\w*, \w e|strong="G2532"\w* \w uma|strong="G1520"\w* \w para Moisés|strong="G3475"\w*, \w e|strong="G2532"\w* \w uma|strong="G1520"\w* \w para Elias|strong="G2243"\w*”, \w sem saber|strong="G3361,G6063"\w* \w o que|strong="G3739"\w* \w dizia|strong="G3004"\w*.\f + \fr 9.33: \ft Lit.: σκηνή, “tenda, cabana”.\f*\f + \fr 9.33: \ft Acréscimo: “que” (em “E aconteceu que quando eles”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 9:33 \xt MAT 17:4; MRK 9:5; MRK 9:2; MAT 17:1; MAT 7:13; ACT 3:22\x*
\v 34 \w Enquanto ele dizia|strong="G846,G3004"\w* \w estas coisas|strong="G3778"\w* \w veio|strong="G1096"\w* \w uma nuvem|strong="G3507"\w* \w e|strong="G2532"\w* \w os cobriu com a sua sombra|strong="G1982,G846"\w*; \w ficaram com medo|strong="G5399"\w*, \w quando|strong="G1722,G3588"\w* \w eles entraram|strong="G1525,G846"\w* \w na nuvem|strong="G1519,G3588,G3507"\w*.\x - \xo 9:34 \xt MRK 9:7; MAT 17:5; 2PE 1:17; LUK 3:22; MRK 9:2; MAT 17:1\x*
\v 35 \w E|strong="G2532"\w* \w veio|strong="G1096"\w* \w uma voz|strong="G5456"\w* \w da nuvem|strong="G1537,G3588,G3507"\w*, \w dizendo|strong="G3004"\w*: “\w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w o meu Filho|strong="G3588,G5207,G3165"\w*, \w o escolhido|strong="G3588,G1586"\w*; \w a ele|strong="G846"\w* \w ouçam|strong="G191"\w*.”\f + \fr 9.35: \ft Variante: O RP lê ἀγαπητός (“amado”) em lugar de ἐκλελεγμένος (“escolhido”).\f*\x - \xo 9:35 \xt MRK 9:7; MAT 17:5; 2PE 1:17; LUK 3:22; MAT 3:17; MRK 9:2\x*
\v 36 \w E|strong="G2532"\w*, \w quando|strong="G1722,G3588"\w* \w veio|strong="G1096"\w* \w a voz|strong="G3588,G5456"\w*, \w Jesus foi encontrado|strong="G2147,G2424"\w* \w sozinho|strong="G3441"\w*. \w E|strong="G2532"\w* \w eles|strong="G846"\w* \w se calaram|strong="G4601"\w* \w e|strong="G2532"\w* \w a ninguém|strong="G3762"\w* \w contaram|strong="G518"\w* \w naqueles dias|strong="G1722,G1565,G3588,G2250"\w* \w nada|strong="G3762"\w* \w do que|strong="G3739"\w* \w tinham visto|strong="G3708"\w*.\x - \xo 9:36 \xt MRK 9:2; MAT 17:1; MRK 9:7; MAT 17:8; MAT 17:9; MRK 9:9-10\x*
\p
\v 37 \w Aconteceu|strong="G1096,G1161"\w*, \w no dia seguinte|strong="G3588,G1836,G2250"\w*, \add que,\add* \w tendo eles descido|strong="G2718,G846"\w* \w do monte|strong="G575,G3588,G3735"\w*, \w veio ao encontro|strong="G4876"\w* \w dele|strong="G846"\w* \w uma grande multidão|strong="G3793,G4183"\w*.\f + \fr 9.37: \ft Acréscimo: “que” (em “dia seguinte que tendo eles”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 9:37 \xt MRK 9:14; MAT 17:14; LUK 7:11\x*
\v 38 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w um homem|strong="G435"\w* \w da multidão|strong="G575,G3588,G3793"\w* \w gritou|strong="G994"\w*, \w dizendo|strong="G3004"\w*: “\w Mestre|strong="G1320"\w*, \w suplico a você|strong="G1189,G4771"\w*: \w olhe|strong="G1914"\w* \w para o meu filho|strong="G1909,G3588,G5207,G3165"\w*, \w porque|strong="G3754"\w* \w ele é|strong="G1510"\w* \w o meu único filho|strong="G3439,G3165"\w*,\x - \xo 9:38 \xt MRK 9:14; JHN 4:47; LUK 7:3; MRK 9:17; MAT 17:14; ZEC 12:10\x*
\v 39 \w e|strong="G2532"\w* \w olhe|strong="G2400"\w*, \w um espírito|strong="G4151"\w* \w o toma|strong="G2983,G846"\w*, \w e|strong="G2532"\w* \w de repente|strong="G1810"\w* \w grita|strong="G2896"\w*, \w e|strong="G2532"\w* \w o convulsiona|strong="G4682,G846"\w* \w com espuma|strong="G3326,G876"\w*, \w e|strong="G2532"\w* \w a custo|strong="G3425"\w* \w se afasta|strong="G672"\w* \w dele|strong="G575,G846"\w*, \w esmagando-o|strong="G4937,G846"\w*;\x - \xo 9:39 \xt MRK 9:14; MRK 9:18; MAT 17:14\x*
\v 40 \w e|strong="G2532"\w* \w supliquei|strong="G1189"\w* \w aos seus discípulos|strong="G3588,G3101,G4771"\w* \w que o expulsassem|strong="G2443,G1544,G846"\w*, \w e|strong="G2532"\w* \w não conseguiram|strong="G3756,G1410"\w*.”\x - \xo 9:40 \xt MAT 9:38; MRK 9:14; LUK 9:1; MRK 9:18; ACT 19:13-16; MAT 17:14\x*
\v 41 \w Respondendo|strong="G611"\w* \w Jesus|strong="G3588,G2424"\w*, \w disse|strong="G2036"\w*: “\w Ó|strong="G5599"\w* \w geração|strong="G1074"\w* \w sem fé|strong="G571"\w* \w e|strong="G2532"\w* \w pervertida|strong="G1294"\w*, \w até quando|strong="G2193,G4219"\w* \w estarei|strong="G1510"\w* \w com vocês|strong="G4314,G4771"\w* \w e|strong="G2532"\w* \w os suportarei|strong="G430,G4771"\w*? \w Traga|strong="G4317"\w* \w aqui|strong="G5602"\w* \w o seu filho|strong="G3588,G5207,G4771"\w*.”\x - \xo 9:41 \xt MAT 17:17; MRK 9:19; MRK 9:14; DEU 32:5; JHN 20:27; JHN 14:9\x*
\v 42 \w Enquanto ele ainda se aproximava|strong="G2089,G4334,G846"\w* \w o demônio|strong="G3588,G1140"\w* \w o derrubou|strong="G4486,G846"\w* \w e|strong="G2532"\w* \w o convulsionou|strong="G4952"\w*; \w Jesus|strong="G3588,G2424"\w* \w repreendeu|strong="G2008"\w* \w o espírito impuro|strong="G3588,G4151,G169"\w*, \w e|strong="G2532"\w* \w curou|strong="G2390"\w* \w o menino|strong="G3588,G3816"\w* \w e|strong="G2532"\w* \w o devolveu|strong="G591,G846"\w* \w ao pai|strong="G3588,G3962"\w* \w dele|strong="G846"\w*.\x - \xo 9:42 \xt MRK 9:14; ACT 10:38; MRK 9:20; MRK 5:2; MRK 9:25; MAT 17:14\x*
\v 43 \w Todos|strong="G3956"\w* \w ficaram atônitos|strong="G1605"\w* \w com a grandeza|strong="G1909,G3588,G3168"\w* \w de Deus|strong="G3588,G2316"\w*. \w Enquanto todos|strong="G3956,G1161"\w* \w se admiravam|strong="G2296"\w* \w com tudo|strong="G1909,G3956"\w* \w o que|strong="G3739"\w* \w fazia|strong="G4160"\w*, \w ele disse|strong="G2036"\w* \w aos seus discípulos|strong="G4314,G3588,G3101,G846"\w*:\f + \fr 9.43: \ft Variante: O RP lê ἐποίησεν ὁ Ἰησοῦς (“Jesus fez”) em lugar de ἐποίει (“fazia”).\f*\x - \xo 9:43 \xt LUK 5:26; LUK 9:43; MRK 9:30; ACT 3:10; LUK 2:19; LUK 4:36\x*
\v 44 “\w Ponham|strong="G5087"\w* \w vocês|strong="G4771"\w* \w nos ouvidos|strong="G1519,G3588,G3775"\w* \w de vocês|strong="G4771"\w* \w estas palavras|strong="G3588,G3056,G3778"\w*: \w pois|strong="G1063"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w* \w está para ser entregue|strong="G3195,G3860"\w* \w nas mãos|strong="G1519,G5495"\w* \w de pessoas|strong="G444"\w*.”\f + \fr 9.44: \ft Lit.: Θέσθε εἰς τὰ ὦτα, literalmente “ponham nos ouvidos”: “gravem bem na memória”.\f*\x - \xo 9:44 \xt MAT 17:22; MRK 9:31; LUK 24:6; LUK 9:22; LUK 24:44; ACT 2:23\x*
\v 45 \w Eles|strong="G3588"\w* \w não entendiam|strong="G50"\w* \w esta palavra|strong="G3588,G4487,G3778"\w*, \w e|strong="G2532"\w* \w estava velada|strong="G1510,G3871"\w* \w para eles|strong="G575,G846"\w*, \w para que não|strong="G2443,G3361"\w* \w a percebessem|strong="G143,G846"\w*; \w e|strong="G2532"\w* \w tinham medo|strong="G5399"\w* \w de lhe perguntar|strong="G2065,G846"\w* \w sobre esta palavra|strong="G4012,G3588,G4487,G3778"\w*.\x - \xo 9:45 \xt MRK 9:32; MAT 17:22; LUK 18:34; LUK 2:50; LUK 9:43; MRK 9:30\x*
\p
\v 46 \w Surgiu|strong="G1525"\w* \w entre eles|strong="G1722,G846"\w* \w uma discussão|strong="G1261"\w*: \w qual deles|strong="G3588,G5101,G846"\w* \w seria|strong="G302,G1510"\w* \w o maior|strong="G3173"\w*.\x - \xo 9:46 \xt MAT 18:1; LUK 22:24; MAT 9:4; MRK 9:33; MAT 20:20-22; 3JN 1:9\x*
\v 47 \w Jesus|strong="G3588,G2424"\w*, \w conhecendo|strong="G6063"\w* \w o raciocínio|strong="G3588,G1261"\w* \w do coração|strong="G3588,G2588"\w* \w deles|strong="G846"\w*, \w tomando|strong="G1949"\w* \w uma criança|strong="G3813"\w*, \w a pôs|strong="G2476,G846"\w* \w junto a si|strong="G3844,G1438"\w*,\x - \xo 9:47 \xt LUK 5:22; MAT 18:1; PSA 139:2; MAT 9:4; MRK 9:33; JHN 16:30\x*
\v 48 \w e|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Quem|strong="G3739,G302"\w* \w receber|strong="G1209"\w* \w esta criança|strong="G3778,G3588,G3813"\w* \w em meu nome|strong="G1909,G3588,G3686,G3165"\w*, \w me recebe|strong="G1473,G1209"\w*; \w e|strong="G2532"\w* \w quem|strong="G3739,G302"\w* \w me receber|strong="G1473,G1209"\w*, \w recebe|strong="G1209"\w* \w aquele que me enviou|strong="G3588,G649,G3165"\w*; \w pois|strong="G1063"\w* \w aquele que é|strong="G3588,G5225"\w* \w o menor|strong="G3398"\w* \w entre todos|strong="G1722,G3956"\w* \w vocês|strong="G4771"\w*, \w este|strong="G3778"\w* \w é|strong="G1510"\w* \w grande|strong="G3173"\w*.”\f + \fr 9.48: \ft Variante: Nas duas ocorrências de “quem” (ἂν), Treg e RP trazem ἐάν (NA28, só na primeira); a diferença é de forma e não muda o sentido; o RP lê ἔσται (“será”) em lugar de ἐστιν (“é”).\f*\x - \xo 9:48 \xt MRK 9:37; MAT 10:40; MAT 18:5; LUK 18:17; MRK 10:15; DEU 28:1\x*
\v 49 \w Respondendo|strong="G611"\w* \w João|strong="G2491"\w* \w disse|strong="G2036"\w*: “\w Mestre|strong="G1988"\w*, \w vimos|strong="G1492"\w* \w alguém|strong="G5100"\w* \w em seu nome|strong="G1722,G3588,G3686,G4771"\w* \w expulsando|strong="G1544"\w* \w demônios|strong="G1140"\w*, \w e|strong="G2532"\w* \w o impedíamos|strong="G2967,G846"\w*, \w porque|strong="G3754"\w* \w não segue|strong="G3756,G190"\w* \w conosco|strong="G3326,G3165"\w*.”\x - \xo 9:49 \xt MRK 9:38; NUM 11:27-29; NUM 11:28; LUK 11:19; ACT 19:13; MAT 12:27\x*
\v 50 \w Disse-lhe|strong="G2036,G4314,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Não o impeçam|strong="G3361,G2967"\w*; \w pois|strong="G1063"\w* \w quem|strong="G3739"\w* \w não está|strong="G3756,G1510"\w* \w contra vocês|strong="G2596,G4771"\w* \w está|strong="G1510"\w* \w a favor de vocês|strong="G5228,G4771"\w*.”\f + \fr 9.50: \ft Variante: O RP traz “E disse” (Καὶ εἶπεν) em lugar de εἶπεν δέ; WH omite o artigo antes de “Jesus”; o RP lê ἡμῶν… ἡμῶν (“contra nós… a favor de nós”) em lugar de ὑμῶν… ὑμῶν (“contra vocês… a favor de vocês”).\f*\x - \xo 9:50 \xt MRK 9:38; PHP 1:18; MAT 12:30; LUK 11:23; PHP 1:15-18; 1CO 12:3\x*
\p
\v 51 \w Aconteceu|strong="G1096,G1161"\w*, \w quando se completavam|strong="G1722,G3588,G4845"\w* \w os dias|strong="G3588,G2250"\w* \w da sua elevação|strong="G3588,G354,G846"\w*, \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w firmou o rosto|strong="G3588,G4383,G4741"\w* \w para ir|strong="G3588,G4198"\w* \w a Jerusalém|strong="G1519,G2419"\w*,\f + \fr 9.51: \ft Lit.: ἀνάλημψις, “elevação, assunção” (a sua partida deste mundo rumo ao céu); στηρίζω τὸ πρόσωπον, “firmar o rosto”: decidir-se com firmeza.\f*\x - \xo 9:51 \xt LUK 9:53; ISA 50:7; LUK 17:11; LUK 13:22; LUK 18:31; LUK 19:28\x*
\v 52 \w e|strong="G2532"\w* \w enviou|strong="G649"\w* \w mensageiros|strong="G32"\w* \w à sua frente|strong="G4253,G4383,G846"\w*; \w e|strong="G2532"\w*, \w indo|strong="G4198"\w*, \w entraram|strong="G1525"\w* \w num povoado|strong="G1519,G2968"\w* \w de samaritanos|strong="G4541"\w*, \w para fazer preparativos|strong="G5613,G2090"\w* \w para ele|strong="G846"\w*;\f + \fr 9.52: \ft Tradução: ἀγγέλους (ἄγγελος, G32) está aqui como “mensageiros”; o termo pode ser “anjo” (mensageiro celeste) ou “mensageiro” (humano), e o contexto decide.\f*\x - \xo 9:52 \xt LUK 17:16; MAT 10:5; LUK 10:1; LUK 17:11; 2KI 17:24-33; GEN 31:21\x*
\v 53 \w e|strong="G2532"\w* \w não o receberam|strong="G3756,G1209,G846"\w*, \w porque|strong="G3754"\w* \w o rosto|strong="G3588,G4383"\w* \w dele|strong="G846"\w* \w estava voltado|strong="G1510,G4198"\w* \w para Jerusalém|strong="G1519,G2419"\w*.\x - \xo 9:53 \xt LUK 9:51; LUK 13:33; LUK 9:5; JHN 4:9; LUK 17:16; GEN 31:21\x*
\v 54 \w Vendo|strong="G1492"\w* \add isso\add* \w os discípulos|strong="G3588,G3101"\w* \w Tiago|strong="G2385"\w* \w e|strong="G2532"\w* \w João|strong="G2491"\w* \w disseram|strong="G2036"\w*: “\w Senhor|strong="G2962"\w*, \w quer que|strong="G2309"\w* \w digamos|strong="G2036"\w* \w que desça|strong="G2597"\w* \w fogo|strong="G4442"\w* \w do céu|strong="G575,G3588,G3772"\w* \w e|strong="G2532"\w* \w os consuma|strong="G355,G846"\w*?”\f + \fr 9.54: \ft Variante: Treg e RP acrescentam “dele” (αὐτοῦ) depois de “discípulos”; o RP acrescenta “como também Elias fez” (ὡς καὶ Ἠλίας ἐποίησεν) depois de “os consuma”.\f*\f + \fr 9.54: \ft Acréscimo: “isso” (em “Vendo isso os discípulos”): demonstrativo acrescentado para retomar o que foi dito.\f*\x - \xo 9:54 \xt 2KI 1:10; MRK 10:14; JAS 1:19-20; LUK 9:5; JAS 3:14-18; LUK 17:16\x*
\v 55 \w Voltando-se|strong="G4762"\w* \w os repreendeu|strong="G2008,G846"\w*.\f + \fr 9.55: \ft Variante: O RP acrescenta “e disse: Vocês não sabem de que espírito são” (καὶ εἶπεν, Οὐκ οἴδατε οἵου πνεύματός ἐστε ὑμεῖς); o TR traz ainda, no versículo seguinte (v. 56), “Pois o Filho do Homem não veio para destruir vidas de pessoas, mas para salvar” (ὁ γὰρ υἱὸς τοῦ ἀνθρώπου οὐκ ἦλθεν ψυχὰς ἀνθρώπων ἀπολέσαι, ἀλλὰ σῶσαι).\f*\x - \xo 9:55 \xt MRK 10:14; LUK 9:5; 1PE 3:9; JOB 2:10; JOB 26:4; LUK 17:16\x*
\v 56 \w E|strong="G2532"\w* \w foram|strong="G4198"\w* \w para outro|strong="G1519,G2087"\w* \w povoado|strong="G2968"\w*.\x - \xo 9:56 \xt MAT 20:28; JHN 3:17; ROM 12:21; JHN 10:10; LUK 19:10; 1PE 2:21-23\x*
\p
\v 57 \w E|strong="G2532"\w*, \w enquanto eles iam|strong="G4198,G846"\w* \w pelo caminho|strong="G1722,G3588,G3598"\w*, \w alguém|strong="G5100"\w* \w lhe disse|strong="G2036,G4314,G846"\w*: “\w Eu o seguirei|strong="G190,G4771"\w* \w aonde quer que|strong="G3699,G1437"\w* \w você vá|strong="G565"\w*.”\f + \fr 9.57: \ft Variante: O RP traz “Aconteceu, porém,” (Ἐγένετο δέ) em lugar de Καί, ἄν em lugar de ἐάν (mesmo sentido) e acrescenta “Senhor” (κύριε) no fim.\f*\x - \xo 9:57 \xt MAT 8:19; JHN 14:4; JHN 13:37; LUK 9:57; EXO 19:8; JAS 2:5\x*
\v 58 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G2036,G846"\w*: “\w As raposas|strong="G3588,G258"\w* \w têm|strong="G2192"\w* \w tocas|strong="G5454"\w*, \w e|strong="G2532"\w* \w as aves|strong="G3588,G4071"\w* \w do céu|strong="G3588,G3772"\w* \w ninhos|strong="G2682"\w*; \w o Filho do Homem|strong="G3588,G5207,G444"\w* \w não tem|strong="G3756,G2192"\w* \w onde|strong="G4226"\w* \w reclinar|strong="G2827"\w* \w a cabeça|strong="G3588,G2776"\w*.”\f + \fr 9.58: \ft Lit.: κατασκήνωσις, “lugar onde se arma tenda, abrigo, ninho”.\f*\x - \xo 9:58 \xt MAT 8:20; LUK 9:57; LUK 14:26-33; 2CO 8:9; PSA 119:141; ISA 53:2\x*
\v 59 \w Disse|strong="G2036"\w*, \w então|strong="G1161"\w*, \w a outro|strong="G4314,G2087"\w*: “\w Siga-me|strong="G190,G3165"\w*.” \w Ele|strong="G3588"\w* \w disse|strong="G2036"\w*: “\w Senhor|strong="G2962"\w*, \w permita-me|strong="G2010,G3165"\w* \w primeiro|strong="G4413"\w* \w ir|strong="G565"\w* \w sepultar|strong="G2290"\w* \w o meu pai|strong="G3588,G3962,G3165"\w*.”\x - \xo 9:59 \xt MAT 8:21; LUK 9:61; LUK 9:57; MAT 8:22; HEB 12:1; MAT 4:19\x*
\v 60 \w Disse-lhe|strong="G2036,G846"\w*, \w então|strong="G1161"\w*: “\w Deixe|strong="G863"\w* \w que os mortos|strong="G3588,G3498"\w* \w sepultem|strong="G2290"\w* \w os seus próprios|strong="G3588,G1438"\w* \w mortos|strong="G3498"\w*; \w você|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w indo|strong="G565"\w*, \w anuncie por toda parte|strong="G1229"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.”\f + \fr 9.60: \ft Variante: O RP acrescenta “Jesus” (ὁ Ἰησοῦς) depois de “lhe”: “Jesus lhe disse”.\f*\x - \xo 9:60 \xt MAT 8:21; MAT 8:22; HEB 12:1; 2TI 2:4; MAT 10:7; LUK 9:57\x*
\v 61 \w E|strong="G1161"\w* \w disse|strong="G2036"\w* \w também|strong="G2532"\w* \w outro|strong="G2087"\w*: “\w Eu o seguirei|strong="G190,G4771"\w*, \w Senhor|strong="G2962"\w*; \w primeiro|strong="G4413"\w*, \w permita-me|strong="G2010,G3165"\w* \w despedir-me|strong="G657"\w* \w dos que estão em minha casa|strong="G3588,G1519,G3624,G3165"\w*.”\f + \fr 9.61: \ft Acréscimo: verbo ser/estar suprido em “dos que estão em minha casa”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:61 \xt MAT 8:21; LUK 9:59; HEB 12:1; 2TI 2:4; LUK 14:26; 1KI 19:20\x*
\v 62 \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Ninguém|strong="G3762"\w*, \w pondo|strong="G1911"\w* \w a mão|strong="G3588,G5495"\w* \w no arado|strong="G1909,G723"\w* \w e|strong="G2532"\w* \w olhando|strong="G991"\w* \w para trás|strong="G1519,G3588,G3694"\w*, \w é|strong="G1510"\w* \w apto|strong="G2111"\w* \w para o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.”\x - \xo 9:62 \xt PHP 3:13; HEB 10:38; 2PE 2:20-22; LUK 17:31-32; JAS 1:6-8; PSA 78:8-9\x*
\c 10
\p
\v 1 \w Depois|strong="G3326"\w* \w destas coisas|strong="G3778"\w* \w o Senhor|strong="G3588,G2962"\w* \w designou|strong="G322"\w* \w também|strong="G2532"\w* \w outros|strong="G2087"\w* \w setenta e dois|strong="G1440,G1417"\w*, \w e|strong="G2532"\w* \w os enviou|strong="G649,G846"\w* \w dois a dois|strong="G303,G1417"\w* \w à sua frente|strong="G4253,G4383,G846"\w* \w a toda|strong="G1519,G3956"\w* \w cidade|strong="G4172"\w* \w e|strong="G2532"\w* \w lugar|strong="G5117"\w* \w aonde|strong="G3757"\w* \w ele mesmo|strong="G846"\w* \w estava para ir|strong="G3195,G2064"\w*.\f + \fr 10.1: \ft Lit.: ὁ κύριος, “o Senhor”: título que Lucas usa na narração para Jesus.\f*\f + \fr 10.1: \ft Variante: WH e NA28 omitem “também” (καί) antes de “outros”; Treg e RP omitem “dois” (δύο), de modo que se lê “setenta”.\f*\x - \xo 10:1 \xt MAT 9:38; LUK 9:52; MRK 6:7; 1TI 5:17; LUK 10:17; MAT 10:1-4\x*
\v 2 \w Dizia-lhes|strong="G3004,G4314,G846"\w*, \w então|strong="G1161"\w*: “\w A colheita|strong="G3588,G2326"\w*, \w de fato|strong="G3303"\w*, \w é grande|strong="G4183"\w*, \w mas os trabalhadores|strong="G3588,G1161,G2040"\w* \w são poucos|strong="G3641"\w*; \w peçam|strong="G1189"\w*, \w então|strong="G3767"\w*, \w ao Senhor|strong="G3588,G2962"\w* \w da colheita|strong="G3588,G2326"\w* \w que envie|strong="G3704,G1544"\w* \w trabalhadores|strong="G2040"\w* \w para a sua colheita|strong="G1519,G3588,G2326,G846"\w*.\f + \fr 10.2: \ft Lit.: ἐκβάλλω, “lançar para fora, enviar com urgência”.\f*\f + \fr 10.2: \ft Variante: O RP traz οὖν (“então”) em lugar de δέ e inverte a ordem de “trabalhadores” e “envie”.\f*\f + \fr 10.2: \ft Acréscimo: verbo ser/estar suprido em “é grande”, “são poucos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:2 \xt MAT 9:37; MAT 9:38; MAT 9:36-38; JHN 4:35; 1CO 3:6-9; MRK 16:15\x*
\v 3 \w Vão|strong="G5217"\w*; \w olhem|strong="G2400"\w*, \w envio|strong="G649"\w* \w vocês|strong="G4771"\w* \w como cordeiros|strong="G5613,G704"\w* \w no meio|strong="G1722,G3319"\w* \w de lobos|strong="G3074"\w*.\x - \xo 10:3 \xt MAT 10:16; JHN 4:35; ACT 20:29; EZK 2:3-6; JHN 15:20; JHN 10:12\x*
\v 4 \w Não levem|strong="G3361,G941"\w* \w bolsa|strong="G905"\w*, \w nem alforje|strong="G3361,G4082"\w*, \w nem sandálias|strong="G3361,G5266"\w*; \w e|strong="G2532"\w* \w a ninguém|strong="G3367"\w* \w pelo caminho|strong="G2596,G3588,G3598"\w* \w saúdem|strong="G782"\w*.\x - \xo 10:4 \xt LUK 22:35; MRK 6:8; LUK 9:3; 2KI 4:29; LUK 10:4; 1SA 21:8\x*
\v 5 \w E|strong="G1161"\w*, \w em qualquer casa|strong="G1519,G3739,G302,G3614"\w* \w em que entrarem|strong="G1525"\w*, \w primeiro|strong="G4413"\w* \w digam|strong="G3004"\w*: ‘\w Paz|strong="G1515"\w* \w a esta casa|strong="G3588,G3624,G3778"\w*.’\x - \xo 10:5 \xt MAT 10:12; LUK 9:4; 1SA 25:6; JHN 14:27; ROM 5:1; ISA 57:19\x*
\v 6 \w E|strong="G2532"\w* \w se|strong="G1437"\w* \w houver|strong="G1510"\w* \w ali|strong="G1563"\w* \w um filho|strong="G5207"\w* \w de paz|strong="G1515"\w*, \w repousará|strong="G1879"\w* \w sobre ele|strong="G1909,G846"\w* \w a paz|strong="G3588,G1515"\w* \w de vocês|strong="G4771"\w*; \w caso contrário|strong="G1487,G1161,G3361,G1065"\w*, \w voltará|strong="G344"\w* \w para vocês|strong="G1909,G4771"\w*.\f + \fr 10.6: \ft Lit.: υἱὸς εἰρήνης, literalmente “filho de paz”: pessoa que acolhe a paz, aberta a ela.\f*\x - \xo 10:6 \xt ROM 5:1; LUK 9:3; ISA 57:19; LUK 10:4; MAT 10:12; MAT 10:13\x*
\v 7 \w Naquela mesma casa|strong="G1722,G846,G3588,G3614"\w*, \w porém|strong="G1161"\w*, \w permaneçam|strong="G3306"\w*, \w comendo|strong="G2068"\w* \w e|strong="G2532"\w* \w bebendo|strong="G4095"\w* \w o que eles têm|strong="G3588,G3844,G846"\w*; \w pois|strong="G1063"\w* \w digno|strong="G514"\w* \w é o trabalhador|strong="G3588,G2040"\w* \w do seu salário|strong="G3588,G3408,G846"\w*. \w Não passem|strong="G3361,G3327"\w* \w de casa|strong="G1537,G3614"\w* \w em casa|strong="G1519,G3614"\w*.\f + \fr 10.7: \ft Acréscimo: verbo ser/estar suprido em “é o trabalhador”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:7 \xt 1TI 5:18; 1TI 5:17; 1CO 9:14; MAT 10:10; 1CO 10:27; 1CO 9:4\x*
\v 8 \w E|strong="G2532"\w* \w em qualquer cidade|strong="G1519,G3739,G302,G4172"\w* \w em que entrarem|strong="G1525"\w* \w e|strong="G2532"\w* \w os receberem|strong="G1209,G4771"\w*, \w comam|strong="G2068"\w* \w o que for posto|strong="G3588,G3908"\w* \w diante de vocês|strong="G4771"\w*,\x - \xo 10:8 \xt LUK 10:10; 1CO 10:27; LUK 9:3; MAT 10:10; LUK 10:4; LUK 12:29\x*
\v 9 \w e|strong="G2532"\w* \w curem|strong="G2323"\w* \w os doentes que nela estão|strong="G3588,G1722,G846,G772"\w*, \w e|strong="G2532"\w* \w digam-lhes|strong="G3004,G846"\w*: ‘\w O reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w se aproximou|strong="G1448"\w* \w de vocês|strong="G1909,G4771"\w*.’\f + \fr 10.9: \ft Lit.: ἐγγίζω, “aproximar-se, chegar perto”.\f*\f + \fr 10.9: \ft Acréscimo: verbo ser/estar suprido em “os doentes que nela estão”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:9 \xt MAT 3:2; MAT 10:7; LUK 9:2; MRK 1:15; MAT 10:8; LUK 17:21\x*
\v 10 \w E|strong="G1161"\w*, \w em qualquer cidade|strong="G1519,G3739,G302,G4172"\w* \w em que entrarem|strong="G1525"\w* \w e|strong="G2532"\w* \w não os receberem|strong="G3361,G1209,G4771"\w*, \w saindo|strong="G1831"\w* \w para as ruas|strong="G1519,G3588,G4113"\w* \w dela|strong="G846"\w*, \w digam|strong="G2036"\w*:\f + \fr 10.10: \ft Lit.: πλατεῖα, “rua larga, praça”.\f*\x - \xo 10:10 \xt LUK 10:8; MAT 10:14; LUK 9:5; LUK 17:21; MAT 3:2; MAT 10:7\x*
\v 11 ‘\w Até a poeira|strong="G2532,G3588,G2868"\w* \w da cidade|strong="G1537,G3588,G4172"\w* \w de vocês|strong="G4771"\w* \w que se grudou|strong="G3588,G2853"\w* \w em nossos pés|strong="G3165,G1519,G3588,G4228"\w*, \w a limpamos|strong="G631"\w* \w contra vocês|strong="G4771"\w*; \w no entanto|strong="G4133"\w*, \w saibam|strong="G1097"\w* \w isto|strong="G3778"\w*: \w que|strong="G3754"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w se aproximou|strong="G1448"\w*\f + \fr 10.11: \ft Variante: O RP omite “em nossos pés” (εἰς τοὺς πόδας) e acrescenta ἐφʼ ὑμᾶς (“de vocês”) depois de “se aproximou”.\f*.’\x - \xo 10:11 \xt MAT 10:14; LUK 9:5; MAT 3:2; ACT 13:51; MAT 10:7; LUK 17:21\x*
\v 12 \w Digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w para Sodoma|strong="G4670"\w*, \w naquele dia|strong="G1722,G3588,G2250,G1565"\w*, \w será mais suportável|strong="G414,G1510"\w* \w do que|strong="G2228"\w* \w para aquela cidade|strong="G3588,G4172,G1565"\w*.\x - \xo 10:12 \xt MAT 10:15; MAT 11:24; MAT 4:17; 1PE 4:17; LUK 9:3; LUK 9:5\x*
\v 13 \w Ai|strong="G3759"\w* \w de você|strong="G4771"\w*, \w Corazim|strong="G5523"\w*! \w Ai|strong="G3759"\w* \w de você|strong="G4771"\w*, \w Betsaida|strong="G966"\w*! \w Pois|strong="G3754"\w* \w se|strong="G1487"\w* \w em Tiro|strong="G1722,G5184"\w* \w e|strong="G2532"\w* \w Sidom|strong="G4605"\w* \w tivessem sido feitos|strong="G1096"\w* \w os milagres|strong="G3588,G1411"\w* \w que foram feitos|strong="G3588,G1096"\w* \w em vocês|strong="G1722,G4771"\w*, \w há muito|strong="G3819"\w* \w teriam|strong="G302"\w* \w se arrependido|strong="G3340"\w*, \w sentados|strong="G2521"\w* \w em pano de saco|strong="G1722,G4526"\w* \w e|strong="G2532"\w* \w cinza|strong="G4700"\w*.\f + \fr 10.13: \ft Acréscimo: verbo ser/estar suprido em “há muito”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\f + \fr 10.13: \ft Tradução: δυνάμεις (δύναμις, G1411) está aqui como “os milagres”; o termo pode ser “poder”, “força”, “capacidade” ou “milagre”, e o contexto decide.\f*\x - \xo 10:13 \xt MAT 11:21; MAT 11:20; MAT 4:17; MRK 8:22; 1PE 4:17; ISA 23:1-18\x*
\v 14 \w Mas|strong="G4133"\w* \w para Tiro|strong="G5184"\w* \w e|strong="G2532"\w* \w Sidom|strong="G4605"\w* \w será mais suportável|strong="G414,G1510"\w* \w no juízo|strong="G1722,G3588,G2920"\w* \w do que|strong="G2228"\w* \w para vocês|strong="G4771"\w*.\x - \xo 10:14 \xt MAT 11:22; MAT 11:24; MAT 11:20; MAT 4:17; 1PE 4:17; MRK 6:11\x*
\v 15 \w E|strong="G2532"\w* \w você|strong="G4771"\w*, \w Cafarnaum|strong="G2584"\w*, \w acaso|strong="G3361"\w* \w será exaltada|strong="G5312"\w* \w até o céu|strong="G2193,G3772"\w*? \w Até o Hades|strong="G2193,G3588,G86"\w* \w será rebaixada|strong="G2601"\w*.\f + \fr 10.15: \ft Variante: O RP lê ἡ ἕως τοῦ οὐρανοῦ ὑψωθεῖσα (“você que foi exaltada até o céu”), em lugar da pergunta, e omite τοῦ antes de “Hades”; WH e NA28 lêem καταβήσῃ (“descerá”) em lugar de καταβιβασθήσῃ (“será rebaixada”).\f*\x - \xo 10:15 \xt MAT 11:23; ISA 14:13-15; MAT 11:20; MRK 6:11; 2PE 2:4; MAT 4:13\x*
\v 16 \w Quem ouve|strong="G3588,G191"\w* \w vocês|strong="G4771"\w*, \w me ouve|strong="G1473,G191"\w*; \w e|strong="G2532"\w* \w quem rejeita|strong="G3588,G114"\w* \w vocês|strong="G4771"\w*, \w me rejeita|strong="G1473,G114"\w*; \w mas quem|strong="G3588,G1161"\w* \w me rejeita|strong="G1473,G114"\w*, \w rejeita|strong="G114"\w* \w aquele que me enviou|strong="G3588,G649,G3165"\w*.”\x - \xo 10:16 \xt JHN 5:23; JHN 12:48; JHN 13:20; 1TH 4:8; 2CO 5:20; 1SA 8:7\x*
\p
\v 17 \w Voltaram|strong="G5290"\w* \w os setenta e dois|strong="G3588,G1440,G1417"\w* \w com alegria|strong="G3326,G5479"\w*, \w dizendo|strong="G3004"\w*: “\w Senhor|strong="G2962"\w*, \w até|strong="G2532"\w* \w os demônios|strong="G3588,G1140"\w* \w se submetem|strong="G5293"\w* \w a nós|strong="G3165"\w* \w em seu nome|strong="G1722,G3588,G3686,G4771"\w*.”\f + \fr 10.17: \ft Variante: Treg e RP omitem “dois” (δύο): “os setenta”.\f*\x - \xo 10:17 \xt JHN 14:12; MRK 16:17; LUK 9:1; ROM 16:20; ACT 16:18; LUK 10:1\x*
\v 18 \w Disse-lhes|strong="G2036,G846"\w*, \w então|strong="G1161"\w*: “\w Eu observava|strong="G2334"\w* \w Satanás|strong="G3588,G4567"\w* \w cair|strong="G4098"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w como relâmpago|strong="G5613,G796"\w*.\x - \xo 10:18 \xt JHN 14:12; REV 12:7-9; ISA 14:12; NUM 23:23; JHN 12:31; JHN 16:11\x*
\v 19 \w Olhem|strong="G2400"\w*, \w eu dei|strong="G1325"\w* \w a vocês|strong="G4771"\w* \w a autoridade|strong="G3588,G1849"\w* \w de pisar|strong="G3588,G3961"\w* \w sobre serpentes|strong="G1883,G3789"\w* \w e|strong="G2532"\w* \w escorpiões|strong="G4651"\w*, \w e|strong="G2532"\w* \w sobre todo|strong="G1909,G3956"\w* \w o poder|strong="G3588,G1411"\w* \w do inimigo|strong="G3588,G2190"\w*; \w e|strong="G2532"\w* \w nada|strong="G3762"\w* \w de modo nenhum|strong="G3756,G3361"\w* \w fará mal|strong="G91"\w* \w a vocês|strong="G4771"\w*.\x - \xo 10:19 \xt 2TI 1:7; ACT 28:5; LUK 21:17-18; MRK 16:18; PSA 91:13; REV 11:5\x*
\v 20 \w Contudo|strong="G4133"\w*, \w não se alegrem|strong="G3361,G5463"\w* \w nisto|strong="G1722,G3778"\w*: \w de que|strong="G3754"\w* \w os espíritos|strong="G3588,G4151"\w* \w se submetem|strong="G5293"\w* \w a vocês|strong="G4771"\w*; \w alegrem-se|strong="G5463"\w*, \w porém|strong="G1161"\w*, \w de que|strong="G3754"\w* \w os nomes|strong="G3588,G3686"\w* \w de vocês|strong="G4771"\w* \w estão inscritos|strong="G1449"\w* \w nos céus|strong="G1722,G3588,G3772"\w*\f + \fr 10.20: \ft Variante: O RP lê ἐγράφη (aoristo, “foram escritos”) em lugar de ἐγγέγραπται (perfeito, “estão inscritos”); o TR acrescenta μᾶλλον (“antes”) depois de “alegrem-se, porém”.\f*.”\x - \xo 10:20 \xt REV 13:8; 1TH 5:16; REV 20:15; MAT 7:22-23; REV 20:12; HEB 12:23\x*
\p
\v 21 \w Naquela mesma hora|strong="G1722,G846,G3588,G5610"\w* \w exultou|strong="G21"\w* \w no Espírito Santo|strong="G3588,G4151,G40"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Eu louvo|strong="G1843"\w* \w você|strong="G4771"\w*, \w Pai|strong="G3962"\w*, \w Senhor|strong="G2962"\w* \w do céu|strong="G3588,G3772"\w* \w e|strong="G2532"\w* \w da terra|strong="G3588,G1093"\w*, \w porque|strong="G3754"\w* \w escondeu|strong="G613"\w* \w estas coisas|strong="G3778"\w* \w dos sábios|strong="G575,G4680"\w* \w e|strong="G2532"\w* \w entendidos|strong="G4908"\w* \w e|strong="G2532"\w* \w as revelou|strong="G601,G846"\w* \w aos pequeninos|strong="G3516"\w*; \w sim|strong="G3483"\w*, \w Pai|strong="G3588,G3962"\w*, \w porque|strong="G3754"\w* \w assim|strong="G3779"\w* \w foi do seu agrado|strong="G2107,G1096,G1715,G4771"\w*.\f + \fr 10.21: \ft Lit.: ἐξομολογέομαι, “louvar, reconhecer publicamente, dar graças”; νήπιοι, “crianças pequenas, pequeninos”.\f*\f + \fr 10.21: \ft Variante: NA28 traz ἐν τῷ πνεύματι (“no Espírito”), enquanto WH, Treg e RP trazem τῷ πνεύματι; o RP traz “Jesus” (ὁ Ἰησοῦς) em lugar de “Santo” (τῷ ἁγίῳ) e inverte a ordem de “foi do seu agrado”; o TR e o RP acrescentam, no começo do v. 22, “E, voltando-se para os discípulos, disse” (καὶ στραφεὶς πρὸς τοὺς μαθητὰς εἶπεν).\f*\x - \xo 10:21 \xt MAT 11:25; MAT 11:26; LUK 12:32; 1CO 2:10; PSA 8:2; 1CO 1:21\x*
\v 22 \w Todas as coisas|strong="G3956"\w* \w me foram entregues|strong="G3165,G3860"\w* \w pelo meu Pai|strong="G5259,G3588,G3962,G3165"\w*, \w e|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w conhece|strong="G1097"\w* \w quem é|strong="G5101,G1510"\w* \w o Filho|strong="G3588,G5207"\w* \w senão|strong="G1487,G3361"\w* \w o Pai|strong="G3588,G3962"\w*, \w e|strong="G2532"\w* \w quem é|strong="G5101,G1510"\w* \w o Pai|strong="G3588,G3962"\w* \w senão|strong="G1487,G3361"\w* \w o Filho|strong="G3588,G5207"\w* \w e|strong="G2532"\w* \w aquele a quem|strong="G3739,G1437"\w* \w o Filho|strong="G3588,G5207"\w* \w quiser|strong="G1014"\w* \w revelar|strong="G601"\w*.”\x - \xo 10:22 \xt MAT 11:27; LUK 12:2; JHN 1:18; 2PE 1:17; MAT 28:18; MAT 11:25\x*
\v 23 \w E|strong="G2532"\w*, \w voltando-se|strong="G4762"\w* \w para os discípulos|strong="G4314,G3588,G3101"\w*, \w à parte|strong="G2596,G2398"\w*, \w disse|strong="G2036"\w*: “\w Felizes|strong="G3107"\w* \w os olhos|strong="G3588,G3788"\w* \w que veem|strong="G3588,G991"\w* \w o que|strong="G3739"\w* \w vocês veem|strong="G991"\w*.\x - \xo 10:23 \xt MAT 13:16; MAT 11:25; HEB 11:39; MAT 16:17; LUK 4:21; LUK 7:28\x*
\v 24 \w Pois|strong="G1063"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w muitos profetas|strong="G4183,G4396"\w* \w e|strong="G2532"\w* \w reis|strong="G935"\w* \w quiseram|strong="G2309"\w* \w ver|strong="G1492"\w* \w o que|strong="G3739"\w* \w vocês|strong="G4771"\w* \w veem|strong="G991"\w* \w e|strong="G2532"\w* \w não viram|strong="G3756,G1492"\w*, \w e|strong="G2532"\w* \w ouvir|strong="G191"\w* \w o que|strong="G3739"\w* \w vocês ouvem|strong="G191"\w* \w e|strong="G2532"\w* \w não ouviram|strong="G3756,G191"\w*.”\x - \xo 10:24 \xt MAT 13:17; 1PE 1:10; MAT 11:25; MAT 13:16; HEB 11:39; MAT 16:17\x*
\p
\v 25 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w um certo|strong="G5100"\w* \w especialista na Lei|strong="G3544"\w* \w se levantou|strong="G450"\w*, \w pondo-o à prova|strong="G1598,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Mestre|strong="G1320"\w*, \w o que|strong="G5101"\w* \w devo fazer|strong="G4160"\w* \w para herdar|strong="G2816"\w* \w a vida eterna|strong="G2222,G166"\w*?”\f + \fr 10.25: \ft Lit.: νομικός, “especialista na Lei”, isto é, conhecedor e intérprete da Lei de Moisés.\f*\x - \xo 10:25 \xt LUK 18:18; MAT 19:16; MRK 10:17; MAT 22:34-39; JHN 5:39; MRK 12:28\x*
\v 26 \w Ele|strong="G3588"\w* \w lhe disse|strong="G2036,G4314,G846"\w*: “\w Na Lei|strong="G1722,G3588,G3551"\w* \w o que|strong="G5101"\w* \w está escrito|strong="G1125"\w*? \w Como|strong="G4459"\w* \w você lê|strong="G314"\w*?”\x - \xo 10:26 \xt ROM 10:5; JHN 10:34; MAT 19:4; MAT 9:13; JHN 5:39; MRK 12:28\x*
\v 27 \w Ele|strong="G3588"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: “\w Você amará|strong="G25"\w* \w o Senhor|strong="G2962"\w*, \w seu Deus|strong="G3588,G2316,G4771"\w*, \w de todo|strong="G1537,G3650,G3588"\w* \w o seu coração|strong="G2588,G4771"\w* \w e|strong="G2532"\w* \w de toda|strong="G1722,G3650,G3588"\w* \w a sua alma|strong="G5590,G4771"\w* \w e|strong="G2532"\w* \w de toda|strong="G1722,G3650,G3588"\w* \w a sua força|strong="G2479,G4771"\w* \w e|strong="G2532"\w* \w de toda|strong="G1722,G3650,G3588"\w* \w a sua mente|strong="G1271,G4771"\w*, \w e|strong="G2532"\w* \w o seu próximo|strong="G3588,G4139,G4771"\w* \w como a si mesmo|strong="G5613,G4771"\w*\f + \fr 10.27: \ft Nota cultural: cita Dt 6:5 (com “força”) e Lv 19:18; cf. Mt 22:37-39 e Mc 12:29-31.\f*.”\x - \xo 10:27 \xt MAT 22:37; DEU 6:5; LEV 19:18; MRK 12:29; MRK 12:30; MAT 22:39\x*
\v 28 \w Disse-lhe|strong="G2036,G846"\w*, \w então|strong="G1161"\w*: “\w Você respondeu|strong="G611"\w* \w corretamente|strong="G3723"\w*; \w faça|strong="G4160"\w* \w isto|strong="G3778"\w* \w e|strong="G2532"\w* \w viverá|strong="G2198"\w*.”\x - \xo 10:28 \xt LUK 7:43; MAT 22:39; LEV 19:18; GAL 5:14; EZK 20:11; PRO 19:16\x*
\v 29 \w Ele|strong="G3588"\w*, \w querendo declarar-se justo|strong="G2309,G1344,G1438"\w*, \w disse|strong="G2036"\w* \w a Jesus|strong="G4314,G3588,G2424"\w*: “\w E|strong="G2532"\w* \w quem|strong="G5101"\w* \w é|strong="G1510"\w* \w o meu próximo|strong="G3165,G4139"\w*\f + \fr 10.29: \ft Lit.: δικαιόω, “declarar justo”: aqui, “mostrar-se justo, justificar-se”; πλησίον, “o que está perto, o próximo, o vizinho”.\f*?”\x - \xo 10:29 \xt MAT 22:39; LEV 19:18; GAL 5:14; LUK 16:15; JHN 5:39; LUK 18:9\x*
\v 30 \w Respondendo|strong="G5274"\w* \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Um certo|strong="G5100"\w* \w homem|strong="G444"\w* \w descia|strong="G2597"\w* \w de Jerusalém|strong="G575,G2419"\w* \w para Jericó|strong="G1519,G2410"\w* \w e|strong="G2532"\w* \w caiu entre bandidos|strong="G3027,G4045"\w*, \w os quais|strong="G3739"\w*, \w também|strong="G2532"\w* \w o despojaram|strong="G1562,G846"\w* \w e|strong="G2532"\w* \w lhe deram|strong="G2007"\w* \w golpes|strong="G4127"\w*, \w foram embora|strong="G565"\w*, \w deixando-o|strong="G863"\w* \w meio morto|strong="G2253"\w*.\x - \xo 10:30 \xt MAT 22:39; LEV 19:18; GAL 5:14; JAS 2:8; PRO 27:10; MAT 22:35\x*
\v 31 \w Por coincidência|strong="G2596,G4795"\w* \w um certo|strong="G5100"\w* \w sacerdote|strong="G2409"\w* \w descia|strong="G2597"\w* \w por aquele caminho|strong="G1722,G3588,G3598,G1565"\w*, \w e|strong="G2532"\w*, \w vendo-o|strong="G1492,G846"\w*, \w passou pelo outro lado|strong="G492"\w*.\f + \fr 10.31: \ft Lit.: συγκυρία, “coincidência, acaso”; ἀντιπαρέρχομαι, “passar pelo lado oposto”.\f*\x - \xo 10:31 \xt MAT 22:39; LEV 19:18; GAL 5:14; JAS 2:8; PRO 24:11; PRO 27:10\x*
\v 32 \w Do mesmo modo|strong="G3668"\w* \w também|strong="G2532"\w* \w um levita|strong="G3019"\w*, \w chegando|strong="G2064"\w* \w àquele lugar|strong="G2596,G3588,G5117"\w* \w e|strong="G2532"\w* \w vendo|strong="G1492"\w*, \w passou pelo outro lado|strong="G492"\w*.\x - \xo 10:32 \xt MAT 22:39; LEV 19:18; GAL 5:14; JAS 2:8; PRO 24:11; PRO 27:10\x*
\v 33 \w Um certo|strong="G5100"\w* \w samaritano|strong="G4541"\w* \w em viagem|strong="G3593"\w*, \w chegou|strong="G2064"\w* \w perto dele|strong="G2596,G846"\w* \w e|strong="G2532"\w*, \w vendo|strong="G1492"\w*, \w compadeceu-se|strong="G4697"\w*.\x - \xo 10:33 \xt MAT 22:39; LEV 19:18; GAL 5:14; 1KI 8:50; LUK 7:13; JER 38:7\x*
\v 34 \w E|strong="G2532"\w*, \w aproximando-se|strong="G4334"\w*, \w enfaixou|strong="G2611"\w* \w as feridas|strong="G3588,G5134"\w* \w dele|strong="G846"\w*, \w derramando|strong="G2022"\w* \w óleo|strong="G1637"\w* \w e|strong="G2532"\w* \w vinho|strong="G3631"\w*; \w colocando-o|strong="G1913,G846"\w* \w sobre o seu próprio|strong="G1909,G3588,G2398"\w* \w animal|strong="G2934"\w*, \w levou-o|strong="G71,G846"\w* \w a uma estalagem|strong="G1519,G3829"\w* \w e|strong="G2532"\w* \w cuidou|strong="G1959"\w* \w dele|strong="G846"\w*.\f + \fr 10.34: \ft Lit.: πανδοχεῖον, “estalagem, pousada (que recebe todos)”.\f*\x - \xo 10:34 \xt MAT 22:39; LEV 19:18; GAL 5:14; PRO 25:21; ROM 12:20; PSA 147:3\x*
\v 35 \w E|strong="G2532"\w*, \w no dia seguinte|strong="G1909,G3588,G839"\w*, \w tirando|strong="G1544"\w* \w dois denários|strong="G1417,G1220"\w*, \w os deu|strong="G1325"\w* \w ao estalajadeiro|strong="G3588,G3830"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: ‘\w Cuide|strong="G1959"\w* \w dele|strong="G846"\w*; \w e|strong="G2532"\w* \w o que|strong="G3739,G5100,G302"\w* \w você gastar a mais|strong="G4325"\w*, \w eu|strong="G1473"\w*, \w quando voltar|strong="G1722,G3588,G1880,G3165"\w*, \w lhe pagarei|strong="G591,G4771"\w*.’\f + \fr 10.35: \ft Variante: O RP acrescenta “saindo” (ἐξελθών) depois de “no dia seguinte” e “lhe” (αὐτῷ) depois de “disse”; NA28 traz ἔδωκεν δύο δηνάρια em ordem inversa.\f*\x - \xo 10:35 \xt MAT 22:39; LEV 19:18; GAL 5:14; PRO 25:21; JAS 2:8; PRO 19:17\x*
\v 36 \w Quem|strong="G5101"\w* \w destes|strong="G3778,G3588"\w* \w três|strong="G5140"\w* \w lhe parece|strong="G1380,G4771"\w* \w ter sido o próximo|strong="G4139,G1096"\w* \w daquele que caiu|strong="G3588,G1706"\w* \w entre os bandidos|strong="G1519,G3588,G3027"\w*?”\f + \fr 10.36: \ft Variante: Treg e RP acrescentam οὖν (“então”) no começo: “Qual destes três, então, lhe parece…”.\f*\x - \xo 10:36 \xt MAT 22:39; LEV 19:18; GAL 5:14; MRK 12:31; PRO 25:21; JAS 2:8\x*
\v 37 \w Ele|strong="G3588"\w* \w disse|strong="G2036"\w*: “\w O que|strong="G3588"\w* \w agiu com|strong="G4160"\w* \w misericórdia|strong="G3588,G1656"\w* \w para com ele|strong="G3326,G846"\w*.” \w Disse-lhe|strong="G2036,G846"\w*, \w então|strong="G1161"\w*, \w Jesus|strong="G3588,G2424"\w*: “\w Vá|strong="G4198"\w* \w e|strong="G2532"\w* \w você também|strong="G4771"\w* \w faça|strong="G4160"\w* \w do mesmo modo|strong="G3668"\w*.”\f + \fr 10.37: \ft Variante: O RP traz οὖν (“então”) em lugar de δέ; o TR traz “Aconteceu” (Ἐγένετο) no começo do v. 38.\f*\x - \xo 10:37 \xt MAT 22:39; LEV 19:18; 1JN 4:11; 1JN 3:16-18; GAL 5:14; MIC 6:8\x*
\p
\v 38 \w Enquanto eles iam|strong="G1722,G3588,G4198,G846"\w* \w ele mesmo|strong="G846"\w* \w entrou|strong="G1525"\w* \w num certo povoado|strong="G1519,G2968,G5100"\w*; \w uma certa|strong="G5100"\w* \w mulher|strong="G1135"\w* \w chamada|strong="G3686"\w* \w Marta|strong="G3136"\w*, \w o recebeu|strong="G5264,G846"\w*.\f + \fr 10.38: \ft Variante: O RP traz “Aconteceu, porém, que, enquanto” (Ἐγένετο δὲ ἐν) em lugar de Ἐν δέ; Treg e RP acrescentam καί (“e”) depois de “eles”; NA28 termina em “o recebeu”, WH acrescenta “em casa” (εἰς τὴν οἰκίαν) e Treg e RP “na casa dela” (εἰς τὸν οἶκον αὐτῆς).\f*\f + \fr 10.38: \ft Tradução: ὀνόματι (ὄνομα, G3686) está aqui como “chamada”; o termo pode ser “nome”, “reputação”, “pessoa” ou “autoridade”, e o contexto decide.\f*\x - \xo 10:38 \xt JHN 11:1; JHN 11:19-20; JHN 12:3; JHN 12:1-3; LUK 8:2-3; ACT 16:15\x*
\v 39 \w E|strong="G2532"\w* \w esta|strong="G3592"\w* \w tinha|strong="G1510"\w* \w uma irmã|strong="G79"\w* \w chamada|strong="G2564"\w* \w Maria|strong="G3137"\w*, \w a qual|strong="G3739"\w* \w também|strong="G2532"\w*, \w sentando-se|strong="G3869"\w* \w aos pés|strong="G4314,G3588,G4228"\w* \w de Jesus|strong="G3588,G2424"\w*, \w escutava|strong="G191"\w* \w a sua palavra|strong="G3588,G3056,G846"\w*.\f + \fr 10.39: \ft Variante: O SBLGNT traz “Jesus” (Ἰησοῦ), com o RP; WH, Treg e NA28 trazem “do Senhor” (κυρίου); WH e NA28 trazem Μαριάμ, e Treg e RP, Μαρία (outra forma do nome); o RP lê παρακαθίσασα παρά em lugar de παρακαθεσθεῖσα πρός.\f*\x - \xo 10:39 \xt JHN 11:1; PRO 8:34; MAT 11:29; JHN 12:3; LUK 8:35; DEU 33:3\x*
\v 40 \w Marta|strong="G3588,G3136"\w* \w estava sobrecarregada|strong="G4049"\w* \w com muito|strong="G4012,G4183"\w* \w serviço|strong="G1248"\w*; \w aproximando-se|strong="G2186"\w*, \w então|strong="G1161"\w*, \w disse|strong="G2036"\w*: “\w Senhor|strong="G2962"\w*, \w não lhe importa|strong="G3756,G3199,G4771"\w* \w que|strong="G3754"\w* \w a minha irmã|strong="G3588,G79,G3165"\w* \w me deixe|strong="G3165,G2641"\w* \w sozinha|strong="G3441"\w* \w para servir|strong="G1247"\w*? \w Diga-lhe|strong="G2036,G846"\w*, \w então|strong="G3767"\w*, \w que|strong="G2443"\w* \w me ajude|strong="G3165,G4878"\w*.”\f + \fr 10.40: \ft Lit.: περισπάω, “distrair, sobrecarregar”; διακονέω, “servir” (também “servir à mesa”).\f*\f + \fr 10.40: \ft Variante: NA28 traz κατέλιπεν (aoristo, “deixou”) em lugar de κατέλειπεν (imperfeito, “deixa”); WH traz εἰπόν em lugar de εἰπέ (ambos “diga”).\f*\x - \xo 10:40 \xt JHN 6:27; MAT 6:25; MAT 11:29; LUK 12:29; JHN 11:1; 1CO 7:34\x*
\v 41 \w Respondendo|strong="G611"\w* \w o Senhor|strong="G3588,G2962"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Marta|strong="G3136"\w*, \w Marta|strong="G3136"\w*, \w você se preocupa|strong="G3309"\w* \w e|strong="G2532"\w* \w se agita|strong="G2350"\w* \w com muitas coisas|strong="G4012,G4183"\w*,\f + \fr 10.41: \ft Variante: Treg e RP trazem “Jesus” (Ἰησοῦς) em lugar de “o Senhor”; o RP lê τυρβάζῃ (“perturba-se”) em lugar de θορυβάζῃ (“agita-se”).\f*\x - \xo 10:41 \xt PHP 4:6; MRK 4:19; LUK 21:34; MAT 6:25; LUK 8:14; LUK 12:22\x*
\v 42 \w mas de poucas coisas|strong="G3641,G1161"\w* \w há necessidade|strong="G1510,G5532"\w*, \w ou|strong="G2228"\w* \w de uma só|strong="G1520"\w*; \w pois|strong="G1063"\w* \w Maria|strong="G3137"\w* \w escolheu|strong="G1586"\w* \w a boa parte|strong="G3588,G18,G3310"\w*, \w a qual não|strong="G3748,G3756"\w* \w lhe será tirada|strong="G851,G846"\w*.”\f + \fr 10.42: \ft Variante: WH lê ὀλίγων δέ ἐστιν χρεία ἢ ἑνός (“de poucas coisas há necessidade, ou de uma só”), como o texto; Treg, RP e NA28 lêem ἑνὸς δέ ἐστιν χρεία (“de uma só coisa há necessidade”); Treg e RP trazem Μαρία δέ (“Maria, porém”) em lugar de Μαριὰμ γάρ (“pois Maria”) e ἀπʼ αὐτῆς (“dela”) em lugar de αὐτῆς.\f*\x - \xo 10:42 \xt PSA 27:4; PSA 16:5-6; JHN 10:27-28; JHN 4:14; PSA 73:25; JHN 5:24\x*
\c 11
\p
\v 1 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w estando ele|strong="G1722,G3588,G1511,G846"\w* \w em um certo|strong="G1722,G5100"\w* \w lugar|strong="G5117"\w*, \w orando|strong="G4336"\w*, \w quando parou|strong="G5613,G3973"\w*, \w um|strong="G5100"\w* \w dos seus discípulos|strong="G3588,G3101,G846"\w* \w lhe disse|strong="G2036,G4314,G846"\w*: “\w Senhor|strong="G2962"\w*, \w ensine-nos|strong="G1321,G3165"\w* \w a orar|strong="G4336"\w*, \w assim como|strong="G2531"\w* \w também|strong="G2532"\w* \w João|strong="G2491"\w* \w ensinou|strong="G1321"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w*.”\f + \fr 11.1: \ft Acréscimo: “que” (em “E aconteceu que estando ele”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 11:1 \xt MAT 6:9; PSA 19:14; ROM 8:26; JUD 1:20; LUK 22:39-45; LUK 6:12\x*
\p
\v 2 \w Disse-lhes|strong="G2036,G846"\w*, \w então|strong="G1161"\w*: “\w Quando|strong="G3752"\w* \w vocês orarem|strong="G4336"\w*, \w digam|strong="G3004"\w*: ‘\w Pai|strong="G3962"\w*, \w seja santificado|strong="G37"\w* \w o seu nome|strong="G3588,G3686,G4771"\w*; \w venha|strong="G2064"\w* \w o seu reino|strong="G3588,G932,G4771"\w*;\f + \fr 11.2: \ft Nota cultural: o Pai-Nosso aparece também em Mt 6:9-13, em forma mais longa.\f*\f + \fr 11.2: \ft Variante: O RP acrescenta “nosso, que está nos céus” (ἡμῶν ὁ ἐν τοῖς οὐρανοῖς) depois de “Pai” e, depois de “o seu nome”, “seja feita a sua vontade, assim no céu como na terra” (γενηθήτω τὸ θέλημά σου ὡς ἐν οὐρανῷ καὶ ἐπὶ τῆς γῆς), como em Mt 6:9-10.\f*\x - \xo 11:2 \xt MAT 6:9; MAT 6:6-15; MAT 5:16; ECC 5:2; ROM 8:15; ROM 8:26\x*
\q1
\v 3 \w o pão|strong="G3588,G740"\w* \w nosso|strong="G3165"\w* \w de cada dia|strong="G3588,G1967"\w* \w dê-nos|strong="G1325,G3165"\w* \w a cada dia|strong="G3588,G2596,G2250"\w*;\f + \fr 11.3: \ft Lit.: ἐπιούσιος, palavra rara: “do dia, para o dia que vem, necessário”; δίδου, presente: “vá dando”.\f*\x - \xo 11:3 \xt MAT 6:11; MAT 6:9; MAT 6:34; PRO 30:8; 2CO 4:16; ROM 8:26\x*
\q1
\v 4 \w e|strong="G2532"\w* \w perdoe-nos|strong="G863,G3165"\w* \w os nossos pecados|strong="G3588,G266,G3165"\w*, \w pois também|strong="G2532,G1063"\w* \w nós mesmos|strong="G846"\w* \w perdoamos|strong="G863"\w* \w a todo|strong="G3956"\w* \w aquele que nos deve|strong="G3784,G3165"\w*; \w e|strong="G2532"\w* \w não nos leve|strong="G3361,G1533,G3165"\w* \w à provação|strong="G1519,G3986"\w*\f + \fr 11.4: \ft Variante: O RP acrescenta “mas livre-nos do Maligno” (ἀλλὰ ῥῦσαι ἡμᾶς ἀπὸ τοῦ πονηροῦ), como em Mt 6:13.\f*.’”\x - \xo 11:4 \xt MAT 6:13; MAT 6:9; COL 3:13; MAT 6:12; 1CO 10:13; EPH 4:32\x*
\p
\v 5 \w E|strong="G2532"\w* \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Quem|strong="G5101"\w* \w dentre vocês|strong="G1537,G4771"\w* \w terá|strong="G2192"\w* \w um amigo|strong="G5384"\w* \w e|strong="G2532"\w* \w irá|strong="G4198"\w* \w até ele|strong="G4314,G846"\w* \w à meia-noite|strong="G3317"\w* \w e|strong="G2532"\w* \w lhe dirá|strong="G2036,G846"\w*: ‘\w Amigo|strong="G5384"\w*, \w empreste-me|strong="G5531,G3165"\w* \w três pães|strong="G5140,G740"\w*,\x - \xo 11:5 \xt LUK 18:1; EPH 6:18; ROM 8:26; ROM 12:12; ISA 62:6; MRK 10:48\x*
\v 6 \w porque|strong="G1894"\w* \w um amigo meu|strong="G5384,G3165"\w* \w chegou|strong="G3854"\w* \w de viagem|strong="G1537,G3598"\w* \w até mim|strong="G4314,G3165"\w*, \w e|strong="G2532"\w* \w não tenho|strong="G3756,G2192"\w* \w o que|strong="G3739"\w* \w pôr diante|strong="G3908"\w* \w dele|strong="G846"\w*.’\f + \fr 11.6: \ft Tradução: ὁδοῦ (ὁδός, G3598) está aqui como “de viagem”; o termo pode ser “caminho”, “estrada”, “viagem” ou “modo de vida”, e o contexto decide.\f*\x - \xo 11:6 \xt LUK 18:1; EPH 6:18; ROM 8:26; ROM 12:12; ISA 62:6; MRK 10:48\x*
\v 7 \w E aquele|strong="G1565,G2532"\w*, \w de dentro|strong="G2081"\w*, \w respondendo|strong="G611"\w*, \w dirá|strong="G2036"\w*: ‘\w Não me incomode|strong="G3361,G3165,G2873,G3930"\w*; \w a porta|strong="G3588,G2374"\w* \w já|strong="G2235"\w* \w está fechada|strong="G2808"\w*, \w e|strong="G2532"\w* \w os meus filhos|strong="G3588,G3813,G3165"\w* \w estão comigo|strong="G3326,G1473"\w* \w na cama|strong="G1519,G3588,G2845,G1510"\w*; \w não posso|strong="G3756,G1410"\w*, \w levantando-me|strong="G450"\w*, \w dar|strong="G1325"\w* \w a você|strong="G4771"\w*\f + \fr 11.7: \ft Lit.: κόπους παρέχω, literalmente “oferecer trabalhos”: “dar incômodo, importunar”.\f*’,\f + \fr 11.7: \ft Acréscimo: verbo ser/estar suprido em “estão comigo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:7 \xt LUK 18:1; EPH 6:18; ROM 8:26; ROM 12:12; ISA 62:6; SNG 5:3\x*
\v 8 \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w ainda que|strong="G1487,G2532"\w* \w não lhe dê|strong="G3756,G1325,G846"\w*, \w levantando-se|strong="G450"\w*, \w por ser amigo|strong="G1223,G3588,G1511,G5384"\w* \w dele|strong="G846"\w*, \w mesmo assim|strong="G1065"\w*, \w por causa da insistência|strong="G1223,G3588,G335"\w* \w dele|strong="G846"\w*, \w levantando-se|strong="G1453"\w*, \w lhe dará|strong="G1325,G846"\w* \w tudo o que|strong="G3745"\w* \w precisa|strong="G5535"\w*.\f + \fr 11.8: \ft Lit.: ἀναίδεια, “falta de vergonha, insistência descarada, persistência atrevida”.\f*\f + \fr 11.8: \ft Lit.: ἀναίδεια, “falta de vergonha”: pode ser a insistência sem pudor de quem pede ou, segundo outra leitura, o cuidado do amigo em não passar vergonha ao negar.\f*\x - \xo 11:8 \xt MAT 21:22; LUK 18:1; EPH 6:18; GEN 32:26; LUK 18:5; ROM 8:26\x*
\v 9 \w Também eu|strong="G2532_A,G1473"\w* \w digo a vocês|strong="G4771,G3004"\w*: \w peçam|strong="G154"\w*, \w e|strong="G2532"\w* \w será dado|strong="G1325"\w* \w a vocês|strong="G4771"\w*; \w busquem|strong="G2212"\w*, \w e|strong="G2532"\w* \w encontrarão|strong="G2147"\w*; \w batam|strong="G2925"\w*, \w e|strong="G2532"\w* \w será aberto|strong="G455"\w* \w a vocês|strong="G4771"\w*;\x - \xo 11:9 \xt MAT 7:7; MAT 7:8; 1JN 3:22; 1JN 5:14-15; HEB 11:6; JAS 1:5\x*
\v 10 \w pois|strong="G1063"\w* \w todo aquele|strong="G3956,G3588"\w* \w que pede|strong="G154"\w* \w recebe|strong="G2983"\w*, \w e|strong="G2532"\w* \w o que busca|strong="G3588,G2212"\w* \w encontra|strong="G2147"\w*, \w e|strong="G2532"\w* \w ao que bate|strong="G3588,G2925"\w* \w será aberto|strong="G455"\w*.\x - \xo 11:10 \xt MAT 7:7; MAT 7:8; JER 33:3; MRK 11:24; MRK 1:37; JER 29:13\x*
\v 11 \w Qual|strong="G5101"\w* \w pai|strong="G3588,G3962"\w* \w dentre vocês|strong="G1537,G4771"\w*, \w se o filho|strong="G3588,G5207"\w* \w lhe pedir|strong="G154"\w* \w peixe|strong="G2486"\w*, \w lhe dará|strong="G846,G1929"\w* \w uma serpente|strong="G3789"\w* \w em lugar do peixe|strong="G2532,G473,G2486"\w*?\f + \fr 11.11: \ft Variante: Treg e RP acrescentam, depois de “o filho”, “pão, acaso lhe dará uma pedra? Ou também” (ἄρτον μὴ λίθον ἐπιδώσει αὐτῷ ἢ καί); WH, Treg e RP trazem μή em lugar de καί antes de “em lugar de peixe”; o RP omite ἐξ (“dentre”) e traz “dará a ele” (ἐπιδώσει αὐτῷ) em ordem inversa.\f*\x - \xo 11:11 \xt MAT 7:10; MAT 7:9; MRK 11:24; MAT 7:7; LUK 24:42; MAT 7:11\x*
\v 12 \w Ou|strong="G2228"\w*, \w se também|strong="G2532"\w* \w pedir|strong="G154"\w* \w um ovo|strong="G5609"\w*, \w lhe dará|strong="G1929,G846"\w* \w um escorpião|strong="G4651"\w*?\f + \fr 11.12: \ft Variante: O RP traz “se pedir” (ἐὰν αἰτήσῃ) em lugar de αἰτήσει, e Treg e RP acrescentam μή antes de “lhe dará”.\f*\x - \xo 11:12 \xt MAT 7:9; MRK 11:24; MAT 7:7; MAT 7:10; MAT 7:11; JAS 5:16\x*
\v 13 \w Se|strong="G1487"\w*, \w então|strong="G3767"\w*, \w vocês|strong="G4771"\w*, \w sendo|strong="G5225"\w* \w maus|strong="G4190"\w*, \w sabem|strong="G6063"\w* \w dar|strong="G1325"\w* \w boas|strong="G18"\w* \w dádivas|strong="G1390"\w* \w aos filhos|strong="G3588,G5043"\w* \w de vocês|strong="G4771"\w*, \w quanto mais|strong="G4214,G3123"\w* \w o Pai|strong="G3588,G3962"\w* \w do céu|strong="G3588,G1537,G3772"\w* \w dará|strong="G1325"\w* \w o Espírito Santo|strong="G4151,G40"\w* \w aos que lhe pedem|strong="G3588,G154,G846"\w*!”\x - \xo 11:13 \xt MAT 7:11; MRK 11:24; MAT 7:7; ISA 44:3-4; JAS 1:17; ROM 8:32\x*
\p
\v 14 \w E|strong="G2532"\w* \w ele estava expulsando|strong="G1510,G1544"\w* \w um demônio|strong="G1140"\w* \w mudo|strong="G2974"\w*; \w aconteceu|strong="G1096,G1161"\w* \add que,\add* \w tendo saído|strong="G1831"\w* \w o demônio|strong="G3588,G1140"\w*, \w falou|strong="G2980"\w* \w o mudo|strong="G3588,G2974"\w*, \w e|strong="G2532"\w* \w se admiraram|strong="G2296"\w* \w as multidões|strong="G3588,G3793"\w*.\f + \fr 11.14: \ft Lit.: κωφός, “mudo” ou “surdo”: aqui, a pessoa não falava até o demônio sair.\f*\f + \fr 11.14: \ft Acréscimo: “que” (em “mudo aconteceu que tendo saído”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 11:14 \xt MAT 9:33; MAT 9:32; MRK 9:25; MRK 7:32; ISA 35:6; MAT 12:22\x*
\v 15 \w Alguns|strong="G5100"\w* \w deles|strong="G1537,G846"\w* \w disseram|strong="G2036"\w*: “\w Por Belzebu|strong="G1722,G954"\w*, \w o chefe|strong="G3588,G758"\w* \w dos demônios|strong="G3588,G1140"\w*, \w ele expulsa|strong="G1544"\w* \w os demônios|strong="G3588,G1140"\w*.”\x - \xo 11:15 \xt MAT 12:24; MRK 3:22; MAT 9:34; LUK 11:18; LUK 11:19; MAT 12:27\x*
\v 16 \w Outros|strong="G2087"\w*, \w pondo-o à prova|strong="G3985"\w*, \w pediam|strong="G2212"\w* \w dele|strong="G3844,G846"\w* \w um sinal|strong="G4592"\w* \w do céu|strong="G1537,G3772"\w*.\f + \fr 11.16: \ft Tradução: ἐζήτουν (ζητέω, G2212) está aqui como “pediam”; o termo pode ser “procurar”, “buscar”, “tentar” ou “exigir”, e o contexto decide.\f*\x - \xo 11:16 \xt MRK 8:11; MAT 16:1; 1CO 1:22; MAT 12:38; LUK 11:29; JHN 6:30\x*
\v 17 \w Ele|strong="G846"\w*, \w porém|strong="G1161"\w*, \w conhecendo|strong="G6063"\w* \w os pensamentos|strong="G3588,G1270"\w* \w deles|strong="G846"\w*, \w lhes disse|strong="G2036,G846"\w*: “\w Todo reino|strong="G3956,G932"\w* \w dividido|strong="G1266"\w* \w contra si mesmo|strong="G1909,G1438"\w* \w é devastado|strong="G2049"\w*, \w e|strong="G2532"\w* \w casa|strong="G3624"\w* \w contra casa|strong="G1909,G3624"\w* \w cai|strong="G4098"\w*.\f + \fr 11.17: \ft Lit.: οἶκος ἐπὶ οἶκον πίπτει, literalmente “casa contra casa cai”: pode significar que as casas desabam uma sobre a outra, ou que uma família dividida cai.\f*\x - \xo 11:17 \xt MAT 12:25; MRK 3:23; ISA 19:2-3; ISA 9:20-21; JHN 2:25; MAT 9:4\x*
\v 18 \w Se também|strong="G1487,G1161,G2532"\w* \w Satanás|strong="G3588,G4567"\w* \w se dividiu|strong="G1266"\w* \w contra si mesmo|strong="G1909,G1438"\w*, \w como|strong="G4459"\w* \w subsistirá|strong="G2476"\w* \w o reino|strong="G3588,G932"\w* \w dele|strong="G846"\w*? \w Porque|strong="G3754"\w* \w vocês dizem|strong="G3004"\w* \w que por Belzebu|strong="G1722,G954"\w* \w eu expulso|strong="G1544,G3165"\w* \w os demônios|strong="G3588,G1140"\w*.\x - \xo 11:18 \xt MAT 12:26; LUK 11:15; MRK 3:23; MAT 12:27; MAT 12:24; MAT 12:25\x*
\v 19 \w E se|strong="G1487,G1161"\w* \w eu|strong="G1473"\w* \w expulso|strong="G1544"\w* \w os demônios|strong="G3588,G1140"\w* \w por Belzebu|strong="G1722,G954"\w*, \w por quem|strong="G1722,G5101"\w* \w os expulsam|strong="G1544"\w* \w os filhos|strong="G3588,G5207"\w* \w de vocês|strong="G4771"\w*? \w Por isso|strong="G1223,G3778"\w*, \w eles|strong="G846"\w* \w serão|strong="G1510"\w* \w juízes|strong="G2923"\w* \w de vocês|strong="G4771"\w*.\x - \xo 11:19 \xt MAT 12:27; LUK 11:15; MAT 12:24; MRK 3:22; MRK 9:38; MAT 12:25\x*
\v 20 \w Mas se|strong="G1487,G1161"\w* \w pelo dedo|strong="G1722,G1147"\w* \w de Deus|strong="G2316"\w* \w eu expulso|strong="G1544"\w* \w os demônios|strong="G3588,G1140"\w*, \w então|strong="G686"\w* \w chegou|strong="G5348"\w* \w até vocês|strong="G1909,G4771"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 11.20: \ft Nota cultural: “dedo de Deus” lembra Êx 8:19; o paralelo de Mt 12:28 diz “Espírito de Deus”.\f*\x - \xo 11:20 \xt MAT 12:28; EXO 8:19; PSA 8:3; MAT 12:25; MAT 3:2; ACT 2:22\x*
\v 21 \w Quando|strong="G3752"\w* \w o forte|strong="G3588,G2478"\w*, \w armado|strong="G2528"\w*, \w guarda|strong="G5442"\w* \w a sua própria|strong="G3588,G1438"\w* \w casa|strong="G833"\w*, \w em paz|strong="G1722,G1515"\w* \w estão|strong="G1510"\w* \w os bens|strong="G3588,G5225"\w* \w dele|strong="G846"\w*;\f + \fr 11.21: \ft Lit.: αὐλή, “pátio, residência fortificada, palácio”.\f*\x - \xo 11:21 \xt MRK 3:27; ISA 49:24; MAT 12:29; MAT 12:25; EPH 2:2; ACT 26:18\x*
\v 22 \w mas quando|strong="G1875,G1161"\w* \w um mais forte|strong="G2478"\w* \w do que ele|strong="G846"\w*, \w chegando|strong="G1904"\w*, \w o vencer|strong="G3528,G846"\w*, \w tira|strong="G142"\w* \w a armadura completa|strong="G3588,G3833"\w* \w dele|strong="G846"\w*, \w na qual|strong="G1909,G3739"\w* \w confiava|strong="G3982"\w*, \w e|strong="G2532"\w* \w reparte|strong="G1239"\w* \w os despojos|strong="G3588,G4661"\w* \w dele|strong="G846"\w*.\x - \xo 11:22 \xt ISA 49:24; MRK 3:27; MAT 12:29; COL 2:15; MAT 12:25; ISA 53:12\x*
\v 23 \w Quem não está|strong="G3588,G3361,G1510"\w* \w comigo|strong="G3326,G1473"\w* \w está contra mim|strong="G2596,G1473,G1510"\w*, \w e|strong="G2532"\w* \w quem não|strong="G3588,G3361"\w* \w ajunta|strong="G4863"\w* \w comigo|strong="G3326,G1473"\w* \w espalha|strong="G4650"\w*.\x - \xo 11:23 \xt MAT 12:30; MRK 3:27; LUK 9:50; MRK 9:40; REV 3:15-16; EPH 2:2\x*
\p
\v 24 \w Quando|strong="G3752"\w* \w o espírito|strong="G3588,G4151"\w* \w impuro|strong="G169"\w* \w sai|strong="G1831"\w* \w do ser humano|strong="G575,G3588,G444"\w*, \w passa|strong="G1330"\w* \w por lugares áridos|strong="G1223,G504,G5117"\w*, \w buscando|strong="G2212"\w* \w descanso|strong="G372"\w*, \w e|strong="G2532"\w* \w não o encontrando|strong="G3361,G2147"\w*, \w diz|strong="G3004"\w*: ‘\w Voltarei|strong="G5290"\w* \w para a minha casa|strong="G1519,G3588,G3624,G3165"\w*, \w de onde|strong="G3606"\w* \w saí|strong="G1831"\w*’;\f + \fr 11.24: \ft Variante: WH e NA28 acrescentam “então” (τότε) depois de “não o encontrando”.\f*\x - \xo 11:24 \xt MAT 12:43; 2PE 2:20; HEB 6:4; 1PE 5:8; JOB 2:2; PSA 63:1\x*
\v 25 \w e|strong="G2532"\w*, \w chegando|strong="G2064"\w*, \w a encontra|strong="G2147"\w* \w varrida|strong="G4563"\w* \w e|strong="G2532"\w* \w arrumada|strong="G2885"\w*.\f + \fr 11.25: \ft Variante: WH acrescenta “desocupada” (σχολάζοντα) depois de “encontra”.\f*\x - \xo 11:25 \xt MAT 12:44; 2PE 2:20; MAT 12:43; HEB 6:4; 2PE 2:10-19; 2TH 2:9-12\x*
\v 26 \w Então|strong="G5119"\w* \w vai|strong="G4198"\w* \w e|strong="G2532"\w* \w toma consigo|strong="G3880"\w* \w outros|strong="G2087"\w* \w sete|strong="G2033"\w* \w espíritos|strong="G4151"\w* \w piores|strong="G4190"\w* \w do que ele|strong="G1438"\w*, \w e|strong="G2532"\w*, \w entrando|strong="G1525"\w*, \w habita|strong="G2730"\w* \w ali|strong="G1563"\w*; \w e|strong="G2532"\w* \w torna-se|strong="G1096"\w* \w o estado final|strong="G3588,G2078"\w* \w daquele|strong="G1565"\w* \w ser humano|strong="G3588,G444"\w* \w pior|strong="G5501"\w* \w do que o primeiro|strong="G3588,G4413"\w*.”\x - \xo 11:26 \xt MAT 12:45; 2PE 2:20; MAT 12:43; HEB 6:4; MRK 9:29; JHN 5:14\x*
\p
\v 27 \w Aconteceu|strong="G1096,G1161"\w* \add que,\add* \w enquanto ele dizia|strong="G1722,G3588,G3004,G846"\w* \w estas coisas|strong="G3778"\w*, \w uma certa|strong="G5100"\w* \w mulher|strong="G1135"\w* \w da multidão|strong="G1537,G3588,G3793"\w*, \w levantando a voz|strong="G1869,G5456"\w*, \w lhe disse|strong="G2036,G846"\w*: “\w Feliz|strong="G3107"\w* \w o ventre|strong="G3588,G2836"\w* \w que o carregou|strong="G3588,G941,G4771"\w* \w e|strong="G2532"\w* \w os seios|strong="G3149"\w* \w que você mamou|strong="G3739,G2337"\w*!”\f + \fr 11.27: \ft Acréscimo: “que” (em “Aconteceu que enquanto ele”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 11:27 \xt LUK 23:29; LUK 1:45; LUK 1:28; LUK 8:21; MAT 12:50; LUK 1:48\x*
\v 28 \w Ele|strong="G846"\w*, \w porém|strong="G1161"\w*, \w disse|strong="G2036"\w*: “\w Pelo contrário|strong="G3304"\w*, \w felizes|strong="G3107"\w* \w os que ouvem|strong="G3588,G191"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w a guardam|strong="G5442"\w*!”\x - \xo 11:28 \xt JOS 1:8; PSA 1:1; MAT 7:21; LUK 6:47; DEU 11:27; MAT 7:24\x*
\p
\v 29 \w Enquanto as multidões|strong="G3588,G3793"\w* \w se aglomeravam|strong="G1865"\w* \w começou|strong="G757"\w* \w a dizer|strong="G3004"\w*: “\w Esta geração|strong="G3588,G1074,G3778"\w* \w é uma geração|strong="G1074,G1510"\w* \w má|strong="G4190"\w*; \w procura|strong="G2212"\w* \w um sinal|strong="G4592"\w*, \w e|strong="G2532"\w* \w sinal|strong="G4592"\w* \w não lhe será dado|strong="G3756,G1325,G846"\w* \w a não ser|strong="G1487,G3361"\w* \w o sinal|strong="G3588,G4592"\w* \w de Jonas|strong="G2495"\w*.\f + \fr 11.29: \ft Variante: O RP omite “geração” (γενεά) depois de “é uma”, traz ἐπιζητεῖ (“procura insistentemente”) em lugar de ζητεῖ e acrescenta “o profeta” (τοῦ προφήτου) depois de “Jonas”.\f*\x - \xo 11:29 \xt MAT 16:4; MAT 12:39; MRK 8:12; MRK 8:11; JON 1:1; MAT 12:38\x*
\v 30 \w Pois|strong="G1063"\w* \w assim como|strong="G2531"\w* \w Jonas|strong="G2495"\w* \w se tornou|strong="G1096"\w* \w um sinal|strong="G4592"\w* \w para os ninivitas|strong="G3588,G3536"\w*, \w assim|strong="G3779"\w* \w será|strong="G1510"\w* \w também|strong="G2532"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w* \w para esta geração|strong="G3588,G1074,G3778"\w*.\x - \xo 11:30 \xt MAT 16:4; MAT 12:39; MRK 8:12; LUK 11:32; MAT 12:41; MAT 12:40\x*
\v 31 \w A rainha|strong="G938"\w* \w do sul|strong="G3558"\w* \w será levantada|strong="G1453"\w* \w no juízo|strong="G1722,G3588,G2920"\w* \w com os homens|strong="G3326,G3588,G435"\w* \w desta geração|strong="G3588,G1074,G3778"\w* \w e|strong="G2532"\w* \w os condenará|strong="G2632,G846"\w*; \w porque|strong="G3754"\w* \w veio|strong="G2064"\w* \w dos confins|strong="G1537,G3588,G4009"\w* \w da terra|strong="G3588,G1093"\w* \w para ouvir|strong="G191"\w* \w a sabedoria|strong="G3588,G4678"\w* \w de Salomão|strong="G4672"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w algo maior|strong="G4119"\w* \w que Salomão|strong="G4672"\w* \w está aqui|strong="G5602"\w*.\f + \fr 11.31: \ft Nota cultural: refere-se à rainha de Sabá (1Rs 10:1-13); “do sul” indica a sua terra.\f*\f + \fr 11.31: \ft Acréscimo: verbo ser/estar suprido em “está aqui”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:31 \xt 1KI 10:1; MAT 12:42; 2CH 9:1; MAT 12:39; HEB 11:7; 1KI 10:8\x*
\v 32 \w Homens|strong="G435"\w* \w ninivitas|strong="G3536"\w* \w se levantarão|strong="G450"\w* \w no juízo|strong="G1722,G3588,G2920"\w* \w com esta geração|strong="G3326,G3588,G1074,G3778"\w* \w e|strong="G2532"\w* \w a condenarão|strong="G2632,G846"\w*; \w porque|strong="G3754"\w* \w se arrependeram|strong="G3340"\w* \w por causa da proclamação|strong="G1519,G3588,G2782"\w* \w de Jonas|strong="G2495"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w algo maior|strong="G4119"\w* \w que Jonas|strong="G2495"\w* \w está aqui|strong="G5602"\w*.\f + \fr 11.32: \ft Acréscimo: verbo ser/estar suprido em “está aqui”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:32 \xt MAT 12:41; MAT 12:42; LUK 11:30; JON 1:1; JON 3:5; JON 3:10\x*
\p
\v 33 \w Ninguém|strong="G3762"\w*, \w tendo acendido|strong="G681"\w* \w uma lamparina|strong="G3088"\w*, \w a põe|strong="G5087"\w* \w em lugar escondido|strong="G1519,G2926"\w* \w nem|strong="G3761"\w* \w debaixo do alqueire|strong="G5259,G3588,G3426"\w*, \w mas|strong="G235"\w* \w sobre o candeeiro|strong="G1909,G3588,G3087"\w*, \w para que os que entram|strong="G2443,G3588,G1531"\w* \w vejam|strong="G991"\w* \w a claridade|strong="G3588,G5338"\w*.\f + \fr 11.33: \ft Lit.: μόδιος, “alqueire” (medida de grãos, recipiente); φέγγος, “claridade, luz”.\f*\f + \fr 11.33: \ft Variante: O RP acrescenta δέ (“porém”) depois de “Ninguém”; o SBLGNT lê φέγγος, com o RP, e WH, Treg e NA28 lêem φῶς (“luz”).\f*\x - \xo 11:33 \xt MAT 5:15; MRK 4:21; LUK 8:16; JHN 12:46; 1TI 5:25; PHP 2:15-16\x*
\v 34 \w A lamparina|strong="G3588,G3088"\w* \w do corpo|strong="G3588,G4983"\w* \w é|strong="G1510"\w* \w o seu olho|strong="G3588,G3788,G4771"\w*. \w Quando|strong="G3752"\w* \w o seu olho|strong="G3588,G3788,G4771"\w* \w for são|strong="G573,G1510"\w*, \w também|strong="G2532"\w* \w todo o seu corpo|strong="G3650,G3588,G4983,G4771"\w* \w é luminoso|strong="G5460,G1510"\w*; \w mas quando|strong="G1875,G1161"\w* \w for mau|strong="G4190,G1510"\w*, \w também|strong="G2532"\w* \w o seu corpo|strong="G3588,G4983,G4771"\w* \w é escuro|strong="G4652"\w*.\f + \fr 11.34: \ft Lit.: ἁπλοῦς, “simples, singelo”, também “saudável, generoso”; πονηρός, “mau, doente”.\f*\f + \fr 11.34: \ft Variante: O RP omite “seu” (σου) em “o seu olho” (primeira ocorrência) e acrescenta οὖν (“então”) depois de “Quando”.\f*\f + \fr 11.34: \ft Acréscimo: verbo ser/estar suprido em “é escuro”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:34 \xt MAT 6:22; LUK 11:36; ISA 5:20; ACT 26:18; 2CO 4:4; JER 5:21\x*
\v 35 \w Cuide|strong="G4648"\w*, \w então|strong="G3767"\w*, \w para que não seja|strong="G3361,G1510"\w* \w escuridão|strong="G4655"\w* \w a luz|strong="G3588,G5457"\w* \w que há|strong="G3588,G1722"\w* \w em você|strong="G4771"\w*.\f + \fr 11.35: \ft Acréscimo: “que há”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 11:35 \xt MAT 6:22; ROM 2:19; 1TH 5:5; ISA 5:20; PRO 16:25; 2PE 1:9\x*
\v 36 \w Se|strong="G1487"\w*, \w então|strong="G3767"\w*, \w todo o seu corpo|strong="G3588,G4983,G4771,G3650"\w* \w é luminoso|strong="G5460"\w*, \w sem ter|strong="G3361,G2192"\w* \w nenhuma parte|strong="G3313,G5100"\w* \w escura|strong="G4652"\w*, \w será|strong="G1510"\w* \w todo|strong="G3650"\w* \w luminoso|strong="G5460"\w*, \w como quando|strong="G5613,G3752"\w* \w a lamparina|strong="G3588,G3088"\w* \w com o seu fulgor|strong="G3588,G796"\w* \w ilumina|strong="G5461"\w* \w você|strong="G4771"\w*.”\f + \fr 11.36: \ft Acréscimo: verbo ser/estar suprido em “é luminoso”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:36 \xt MAT 6:22; LUK 11:34; PRO 20:27; PRO 4:18-19; PRO 6:23; 2CO 4:6\x*
\p
\v 37 \w Enquanto ele falava|strong="G1722,G3588,G2980"\w* \w um fariseu|strong="G5330"\w* \w lhe pedia|strong="G2065,G846"\w* \w que almoçasse|strong="G3704,G709"\w* \w com ele|strong="G3844,G846"\w*; \w entrando|strong="G1525"\w*, \w então|strong="G1161"\w*, \w reclinou-se à mesa|strong="G377"\w*.\x - \xo 11:37 \xt LUK 7:36; PRO 23:7; 1CO 9:19-23; LUK 14:1; MAL 3:2\x*
\v 38 \w O fariseu|strong="G3588,G5330"\w*, \w vendo|strong="G1492"\w*, \w se admirou|strong="G2296"\w* \w de que|strong="G3754"\w* \w não se tivesse lavado|strong="G3756,G907"\w* \w primeiro|strong="G4413"\w* \w antes do almoço|strong="G4253,G3588,G712"\w*.\f + \fr 11.38: \ft Lit.: βαπτίζω, “imergir, lavar-se por imersão”: aqui, a purificação ritual antes da refeição.\f*\x - \xo 11:38 \xt PRO 23:7; MAT 15:11; MAT 15:2; MRK 7:4; JHN 3:25; MRK 7:2-5\x*
\v 39 \w Disse|strong="G2036"\w* \w o Senhor|strong="G3588,G2962"\w* \w a ele|strong="G4314,G846"\w*: “\w Agora|strong="G3568"\w* \w vocês|strong="G4771"\w*, \w os fariseus|strong="G3588,G5330"\w*, \w limpam|strong="G2511"\w* \w o exterior|strong="G3588,G1855"\w* \w do copo|strong="G3588,G4221"\w* \w e|strong="G2532"\w* \w do prato|strong="G3588,G4094"\w*; \w mas o interior|strong="G3588,G1161,G2081"\w* \w de vocês|strong="G4771"\w* \w está cheio|strong="G1073"\w* \w de rapina|strong="G724"\w* \w e|strong="G2532"\w* \w maldade|strong="G4189"\w*.\x - \xo 11:39 \xt MAT 23:25; MRK 7:6; PRO 23:7; ISA 55:7; MAT 15:11; LUK 16:15\x*
\v 40 \w Insensatos|strong="G878"\w*! \w Aquele que fez|strong="G3588,G4160"\w* \w o exterior|strong="G3588,G1855"\w* \w não fez|strong="G3756,G4160"\w* \w também|strong="G2532"\w* \w o interior|strong="G3588,G2081"\w*?\x - \xo 11:40 \xt MAT 23:25; MRK 7:6; PRO 23:7; ISA 55:7; 1PE 3:4; MAT 15:11\x*
\v 41 \w Mas|strong="G4133"\w* \w o que está dentro|strong="G3588,G1751"\w* \w deem|strong="G1325"\w* \w como esmola|strong="G1654"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w tudo|strong="G3956"\w* \w é puro|strong="G2513,G1510"\w* \w para vocês|strong="G4771"\w*.\f + \fr 11.41: \ft Lit.: τὰ ἐνόντα, “o que está dentro” ou “o que há (no copo e no prato)”; ἐλεημοσύνη, “esmola, ato de misericórdia”.\f*\x - \xo 11:41 \xt MRK 7:6; PRO 23:7; NEH 8:10; 1CO 10:31; MAT 15:11; ISA 58:7\x*
\v 42 \w Mas|strong="G235"\w* \w ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w fariseus|strong="G3588,G5330"\w*, \w porque|strong="G3754"\w* \w dão o dízimo|strong="G586"\w* \w da hortelã|strong="G3588,G2238"\w* \w e|strong="G2532"\w* \w da arruda|strong="G3588,G4076"\w* \w e|strong="G2532"\w* \w de toda|strong="G3956"\w* \w hortaliça|strong="G3001"\w*, \w e|strong="G2532"\w* \w deixam de lado|strong="G3928"\w* \w a justiça|strong="G3588,G2920"\w* \w e|strong="G2532"\w* \w o amor|strong="G3588,G26"\w* \w de Deus|strong="G3588,G2316"\w*; \w mas estas coisas|strong="G3778,G1161"\w* \w era preciso|strong="G1163"\w* \w fazer|strong="G4160"\w*, \w sem deixar de lado|strong="G3361,G3918"\w* \w aquelas|strong="G1565,G2532"\w*.\f + \fr 11.42: \ft Lit.: κρίσις, “julgamento, justiça”; ἡ ἀγάπη τοῦ θεοῦ, “o amor de Deus”: pode ser o amor a Deus ou o amor que vem de Deus.\f*\f + \fr 11.42: \ft Variante: O RP omite δέ (“mas”) depois de “estas coisas” e lê ἀφιέναι (“deixar”) em lugar de παρεῖναι (“omitir”).\f*\x - \xo 11:42 \xt MAT 23:23; MRK 7:6; MIC 6:8; PRO 23:7; JER 23:1; LUK 18:12\x*
\v 43 \w Ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w fariseus|strong="G3588,G5330"\w*, \w porque|strong="G3754"\w* \w amam|strong="G25"\w* \w o primeiro assento|strong="G3588,G4410"\w* \w nas sinagogas|strong="G1722,G3588,G4864"\w* \w e|strong="G2532"\w* \w as saudações|strong="G3588,G783"\w* \w nas praças|strong="G1722,G3588,G58"\w*.\x - \xo 11:43 \xt LUK 20:46; MRK 12:38; MAT 23:6; MRK 7:6; PRO 23:7; JER 23:1\x*
\v 44 \w Ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w porque|strong="G3754"\w* \w são|strong="G1510"\w* \w como os sepulcros|strong="G5613,G3588,G3419"\w* \w que não se veem|strong="G3588,G82"\w*, \w e|strong="G2532"\w* \w as pessoas|strong="G3588,G444"\w* \w que andam|strong="G3588,G4043"\w* \w por cima|strong="G1883"\w* \w não o sabem|strong="G3756,G6063"\w*.”\f + \fr 11.44: \ft Nota cultural: tocar num sepulcro tornava a pessoa impura (Nm 19:16); sepulcros não sinalizados contaminavam sem que se percebesse.\f*\f + \fr 11.44: \ft Variante: O RP acrescenta “escribas e fariseus hipócritas” (γραμματεῖς καὶ Φαρισαῖοι ὑποκριταί) depois de “Ai de vocês” e omite o artigo οἱ antes de “que andam”.\f*\x - \xo 11:44 \xt NUM 19:16; MRK 7:6; PRO 23:7; JER 23:1; MAT 23:27; JHN 1:24\x*
\v 45 \w Respondendo|strong="G611"\w* \w um|strong="G5100"\w* \w dos especialistas na Lei|strong="G3588,G3544"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Mestre|strong="G1320"\w*, \w ao dizer|strong="G3004"\w* \w estas coisas|strong="G3778"\w*, \w também|strong="G2532"\w* \w a nós|strong="G3165"\w* \w insulta|strong="G5195"\w*.”\f + \fr 11.45: \ft Lit.: ὑβρίζω, “insultar, tratar com desprezo”.\f*\x - \xo 11:45 \xt PRO 23:7; JER 23:1; LUK 11:52; JER 6:10; LUK 11:46; MAT 21:45\x*
\v 46 \w Ele|strong="G3588"\w* \w disse|strong="G2036"\w*: “\w Também|strong="G2532"\w* \w a vocês|strong="G4771"\w*, \w especialistas na Lei|strong="G3588,G3544"\w*, \w ai|strong="G3759"\w*! \w Porque|strong="G3754"\w* \w carregam|strong="G5412"\w* \w as pessoas|strong="G3588,G444"\w* \w com cargas|strong="G5413"\w* \w difíceis de carregar|strong="G1419"\w*, \w e|strong="G2532"\w* \w vocês mesmos|strong="G846"\w* \w com um só|strong="G1520"\w* \w dos seus dedos|strong="G3588,G1147,G4771"\w* \w não tocam|strong="G3756,G4379"\w* \w as cargas|strong="G3588,G5413"\w*.\x - \xo 11:46 \xt MAT 23:4; LUK 11:52; PRO 23:7; GAL 6:2; JER 23:1; MAT 23:2-4\x*
\v 47 \w Ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w porque|strong="G3754"\w* \w constroem|strong="G3618"\w* \w os sepulcros|strong="G3588,G3419"\w* \w dos profetas|strong="G3588,G4396"\w*, \w mas os pais|strong="G3588,G1161,G3962"\w* \w de vocês|strong="G4771"\w* \w os mataram|strong="G615,G846"\w*.\x - \xo 11:47 \xt MAT 23:29; 1TH 2:15; PRO 23:7; JER 23:1; ACT 7:51; ACT 7:52\x*
\v 48 \w Assim|strong="G686"\w* \w são testemunhas|strong="G3144,G1510"\w* \w e|strong="G2532"\w* \w aprovam|strong="G4909"\w* \w as obras|strong="G3588,G2041"\w* \w dos pais|strong="G3588,G3962"\w* \w de vocês|strong="G4771"\w*, \w porque|strong="G3754"\w* \w eles mesmos|strong="G846"\w*, \w de fato|strong="G3303"\w*, \w os mataram|strong="G615,G846"\w*; \w vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w constroem|strong="G3618"\w*\f + \fr 11.48: \ft Variante: O RP lê μαρτυρεῖτε (“dão testemunho”) em lugar de μάρτυρές ἐστε (“são testemunhas”) e acrescenta “os sepulcros deles” (αὐτῶν τὰ μνημεῖα) no fim.\f* \add os sepulcros.\add*\f + \fr 11.48: \ft Acréscimo: “os” (em “porém constroem os sepulcros”): preposição ou artigo que a regência do português exige; “sepulcros” (em “constroem os sepulcros”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 11:48 \xt PRO 23:7; JER 23:1; ROM 1:32; 1TH 2:15; ACT 7:52; MAL 3:7\x*
\v 49 \w Por isso|strong="G1223,G3778"\w* \w também|strong="G2532"\w* \w a sabedoria|strong="G3588,G4678"\w* \w de Deus|strong="G3588,G2316"\w* \w disse|strong="G2036"\w*: ‘\w Enviarei|strong="G649"\w* \w a eles|strong="G1519,G846"\w* \w profetas|strong="G4396"\w* \w e|strong="G2532"\w* \w apóstolos|strong="G652"\w*, \w e|strong="G2532"\w* \w a alguns deles|strong="G1537,G846"\w* \w matarão|strong="G615"\w* \w e|strong="G2532"\w* \w perseguirão|strong="G1377"\w*,\x - \xo 11:49 \xt MAT 23:34; ACT 7:52; 1TH 2:15; PRO 23:7; JER 23:1; MAT 24:9\x*
\v 50 \w para que|strong="G2443"\w* \w seja cobrado|strong="G1567"\w* \w o sangue|strong="G3588,G129"\w* \w de todos|strong="G3956"\w* \w os profetas|strong="G3588,G4396"\w*, \w que foi derramado|strong="G3588,G1632"\w* \w desde a fundação|strong="G575,G2602"\w* \w do mundo|strong="G2889"\w*, \w desta geração|strong="G575,G3588,G1074,G3778"\w*,\x - \xo 11:50 \xt REV 16:6; PRO 23:7; JER 23:1; EZK 3:18; 1TH 2:15; MAT 24:34\x*
\v 51 \w desde o sangue|strong="G575,G129"\w* \w de Abel|strong="G6"\w* \w até o sangue|strong="G2193,G129"\w* \w de Zacarias|strong="G2197"\w*, \w que morreu|strong="G3588,G622"\w* \w entre|strong="G3342"\w* \w o altar|strong="G3588,G2379"\w* \w e|strong="G2532"\w* \w a casa|strong="G3588,G3624"\w*; \w sim|strong="G3483"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w será cobrado|strong="G1567"\w* \w desta geração|strong="G575,G3588,G1074,G3778"\w*.’\f + \fr 11.51: \ft Lit.: οἶκος, “casa”: aqui, o santuário (o edifício do templo), em contraste com o altar.\f*\f + \fr 11.51: \ft Nota cultural: Abel (Gn 4) e Zacarias (provavelmente o de 2Cr 24:20-22) marcam os extremos da lista de justos mortos na Bíblia hebraica.\f*\f + \fr 11.51: \ft Tradução: ἀπολομένου (ἀπόλλυμι, G622) está aqui como “que morreu”; o termo pode ser “perder”, “perecer”, “destruir” ou “morrer”, e o contexto decide.\f*\x - \xo 11:51 \xt 2CH 24:20-22; MAT 23:35; PRO 23:7; JER 23:1; EZK 3:18; HEB 11:4\x*
\v 52 \w Ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w especialistas na Lei|strong="G3588,G3544"\w*, \w porque|strong="G3754"\w* \w tiraram|strong="G142"\w* \w a chave|strong="G3588,G2807"\w* \w do conhecimento|strong="G3588,G1108"\w*; \w vocês mesmos|strong="G846"\w* \w não entraram|strong="G3756,G1525"\w*, \w e|strong="G2532"\w* \w aos que entravam|strong="G3588,G1525"\w* \w impediram|strong="G2967"\w*.”\x - \xo 11:52 \xt LUK 11:46; PRO 23:7; MAT 23:13; JER 23:1; REV 22:19; ISA 10:1\x*
\p
\v 53 \w Saindo ele|strong="G1831,G846"\w* \w dali|strong="G1564,G2532"\w*, \w os escribas|strong="G3588,G1122"\w* \w e|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w* \w começaram|strong="G757"\w* \w a ser terrivelmente hostis|strong="G1171,G1758"\w* \w e|strong="G2532"\w* \w a bombardeá-lo com perguntas|strong="G653,G846"\w* \w sobre muitos assuntos|strong="G4012,G4119"\w*,\f + \fr 11.53: \ft Lit.: ἐνέχω, “ter ressentimento, ser hostil”; ἀποστοματίζω, “interrogar, fazer perguntas insidiosas”.\f*\x - \xo 11:53 \xt PRO 23:7; 1TH 2:15; JHN 1:24; PSA 41:6; 1CH 21:1; MAL 3:2\x*
\v 54 \w armando-lhe emboscada|strong="G1748,G846"\w*, \w para apanhar|strong="G2340"\w* \w algo|strong="G5100"\w* \w da sua boca|strong="G1537,G3588,G4750,G846"\w*.\f + \fr 11.54: \ft Lit.: θηρεύω, “caçar, apanhar (como uma caça)”.\f*\f + \fr 11.54: \ft Variante: Treg e RP acrescentam “procurando” (ζητοῦντες) depois de “emboscada” e, no fim, “para acusá-lo” (ἵνα κατηγορήσωσιν αὐτοῦ).\f*\x - \xo 11:54 \xt PRO 23:7; MRK 12:13; PSA 56:5; LUK 20:20; MAT 22:15; MAT 22:35\x*
\c 12
\p
\v 1 \w Nesse meio tempo|strong="G1722,G3739"\w*, \w tendo-se reunido|strong="G1996"\w* \w milhares e milhares|strong="G3588,G3461"\w* \w da multidão|strong="G3588,G3793"\w*, \w a ponto de|strong="G5620"\w* \w pisarem uns nos outros|strong="G2662,G240"\w*, \w começou|strong="G757"\w* \w a dizer|strong="G3004"\w* \w aos seus discípulos|strong="G4314,G3588,G3101,G846"\w*, \w primeiro|strong="G4413"\w*: “\w Cuidem-se|strong="G4337,G1438"\w* \w do fermento|strong="G575,G3588,G2219"\w* \w dos fariseus|strong="G3588,G5330"\w*, \w que é|strong="G3748,G1510"\w* \w hipocrisia|strong="G5272"\w*.\f + \fr 12.1: \ft Lit.: μυριάς, “miríade, dez mil”: aqui, uma quantidade enorme; ζύμη, “fermento” (imagem de influência que se espalha).\f*\x - \xo 12:1 \xt MAT 16:6; ECC 12:14; 1PE 2:1; 1CO 5:7-8; GAL 5:9; ISA 29:15\x*
\v 2 \w Ora|strong="G1161"\w*, \w não há|strong="G1510"\w* \w nada|strong="G3762"\w* \w encoberto|strong="G4780"\w* \w que não|strong="G3739,G3756"\w* \w venha a ser revelado|strong="G601"\w*, \w nem|strong="G2532"\w* \w oculto|strong="G2927"\w* \w que não|strong="G3739,G3756"\w* \w venha a ser conhecido|strong="G1097"\w*.\x - \xo 12:2 \xt MAT 10:26; LUK 8:17; LUK 10:22; MRK 4:22; 2CO 5:10; ECC 12:14\x*
\v 3 \w Por isso|strong="G473,G3739"\w*, \w tudo o que|strong="G3745"\w* \w vocês disseram|strong="G2036"\w* \w na escuridão|strong="G1722,G3588,G4653"\w* \w será ouvido|strong="G191"\w* \w à luz|strong="G1722,G3588,G5457"\w*, \w e|strong="G2532"\w* \w o que|strong="G3739"\w* \w falaram|strong="G2980"\w* \w ao ouvido|strong="G4314,G3588,G3775"\w* \w nos quartos interiores|strong="G1722,G3588,G5009"\w* \w será proclamado|strong="G2784"\w* \w sobre os terraços|strong="G1909,G3588,G1430"\w*.\f + \fr 12.3: \ft Lit.: ταμεῖον, “quarto interior, despensa, aposento reservado”; δῶμα, “terraço, teto plano”.\f*\x - \xo 12:3 \xt MAT 10:27; LUK 8:17; ECC 10:20; MAT 10:26; MAT 12:36; DAN 2:22\x*
\v 4 \w Digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*, \w meus amigos|strong="G3588,G5384,G3165"\w*: \w não tenham medo|strong="G3361,G5399"\w* \w dos que matam|strong="G575,G3588,G615"\w* \w o corpo|strong="G3588,G4983"\w* \w e|strong="G2532"\w*, \w depois disso|strong="G3326,G3778"\w*, \w não têm|strong="G3361,G2192"\w* \w nada mais|strong="G4055,G5100"\w* \w que possam fazer|strong="G4160"\w*.\x - \xo 12:4 \xt MAT 10:28; HEB 13:6; PRO 29:25; JER 1:8; PSA 56:4; MAT 6:25\x*
\v 5 \w Mostrarei|strong="G5263"\w* \w a vocês|strong="G4771"\w* \w a quem|strong="G5101"\w* \w temer|strong="G5399"\w*: \w temam|strong="G5399"\w* \w aquele que|strong="G3588"\w*, \w depois de matar|strong="G3326,G3588,G615"\w*, \w tem|strong="G2192"\w* \w autoridade|strong="G1849"\w* \w de lançar|strong="G1685"\w* \w na geena|strong="G1519,G3588,G1067"\w*; \w sim|strong="G3483"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w a este|strong="G3778"\w* \w temam|strong="G5399"\w*.\f + \fr 12.5: \ft Lit.: γέεννα, “geena”: de Ge-Hinnom, o vale de Hinom, imagem do lugar de juízo (cf. Mt 5:22).\f*\x - \xo 12:5 \xt MAT 5:22; MAT 10:28; HEB 13:6; 2PE 2:4; HEB 10:31; EXO 15:11\x*
\v 6 \w Não se vendem|strong="G3780,G4453"\w* \w cinco pardais|strong="G4002,G4765"\w* \w por dois asses|strong="G787,G1417"\w*? \w E|strong="G2532"\w* \w um só|strong="G1520"\w* \w deles|strong="G1537,G846"\w* \w não está|strong="G3756,G1510"\w* \w esquecido|strong="G1950"\w* \w diante de|strong="G1799"\w* \w Deus|strong="G3588,G2316"\w*.\f + \fr 12.6: \ft Lit.: ἀσσάριον, “asse”, pequena moeda romana de cobre.\f*\x - \xo 12:6 \xt MAT 10:29; MAT 6:26; REV 21:8; MAT 10:26; LUK 12:24; DAN 3:18\x*
\v 7 \w Até mesmo|strong="G235,G2532"\w* \w os cabelos|strong="G3588,G2359"\w* \w da cabeça|strong="G3588,G2776"\w* \w de vocês|strong="G4771"\w* \w todos|strong="G3956"\w* \w estão contados|strong="G705"\w*; \w não tenham medo|strong="G3361,G5399"\w*: \w valem mais|strong="G1308"\w* \w do que muitos|strong="G4183"\w* \w pardais|strong="G4765"\w*.\f + \fr 12.7: \ft Variante: O RP acrescenta οὖν (“então”) depois de “não tenham medo”.\f*\x - \xo 12:7 \xt MAT 10:30; MAT 10:31; LUK 21:18; MAT 6:26; MAT 10:29; REV 21:8\x*
\v 8 \w Digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w todo aquele|strong="G3956,G3739,G302"\w* \w que me reconhecer|strong="G3670,G1722,G1473"\w* \w diante das pessoas|strong="G1715,G3588,G444"\w*, \w também|strong="G2532"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w* \w o reconhecerá|strong="G3670,G1722,G846"\w* \w diante dos anjos|strong="G1715,G3588,G32"\w* \w de Deus|strong="G3588,G2316"\w*;\f + \fr 12.8: \ft Lit.: ὁμολογέω ἐν, “reconhecer, declarar publicamente (a favor de alguém)”.\f*\x - \xo 12:8 \xt MAT 10:32; ROM 10:9; LUK 9:26; REV 3:5; 1JN 2:23; MRK 8:38\x*
\v 9 \w mas quem|strong="G3588,G1161"\w* \w me negar|strong="G720,G3165"\w* \w diante das pessoas|strong="G1799,G3588,G444"\w* \w será negado|strong="G533"\w* \w diante dos anjos|strong="G1799,G3588,G32"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 12:9 \xt LUK 9:26; MAT 10:32; REV 3:8; MRK 8:38; MAT 10:33; MAT 6:25\x*
\v 10 \w E|strong="G2532"\w* \w todo aquele|strong="G3956,G3739"\w* \w que disser|strong="G4483"\w* \w palavra|strong="G3056"\w* \w contra o Filho do Homem|strong="G1519,G3588,G5207,G444"\w*, \w lhe será perdoado|strong="G863,G846"\w*; \w mas ao que|strong="G3588,G1161"\w* \w blasfemar|strong="G987"\w* \w contra o Espírito Santo|strong="G1519,G3588,G40,G4151"\w* \w não será perdoado|strong="G3756,G863"\w*.\x - \xo 12:10 \xt MRK 3:28; MRK 2:7; MAT 12:32; MAT 12:31; 1JN 5:16; 1TI 1:13\x*
\v 11 \w Quando|strong="G3752,G1161"\w* \w os levarem|strong="G1533,G4771"\w* \w às sinagogas|strong="G1909,G3588,G4864"\w* \w e|strong="G2532"\w* \w aos governantes|strong="G3588,G746"\w* \w e|strong="G2532"\w* \w às autoridades|strong="G3588,G1849"\w*, \w não se preocupem|strong="G3361,G3309"\w* \w como|strong="G4459"\w* \w ou|strong="G2228"\w* \w com o que|strong="G5101"\w* \w se defenderão|strong="G626"\w*, \w ou|strong="G2228"\w* \w com o que|strong="G5101"\w* \w dirão|strong="G2036"\w*;\f + \fr 12.11: \ft Tradução: ἀρχὰς (ἀρχή, G746) está aqui como “aos governantes”; o termo pode ser “princípio”, “começo”, “governo”, “governante” ou “domínio”, e o contexto decide.\f*\x - \xo 12:11 \xt 1PE 5:7; MAT 10:19; EXO 4:12; MAT 6:25; MRK 13:11; PRO 16:1\x*
\v 12 \w pois|strong="G1063"\w* \w o Espírito Santo|strong="G3588,G40,G4151"\w* \w ensinará|strong="G1321"\w* \w vocês|strong="G4771"\w* \w naquela mesma hora|strong="G1722,G846,G3588,G5610"\w* \w o que|strong="G3739"\w* \w é preciso|strong="G1163"\w* \w dizer|strong="G2036"\w*.”\x - \xo 12:12 \xt 1PE 5:7; MRK 13:11; JER 1:9; LUK 21:15; EXO 4:12; MAT 10:20\x*
\p
\v 13 \w Alguém|strong="G5100"\w* \w da multidão|strong="G1537,G3588,G3793"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Mestre|strong="G1320"\w*, \w diga|strong="G2036"\w* \w ao meu irmão|strong="G3588,G80,G3165"\w* \w que reparta|strong="G3307"\w* \w comigo|strong="G3326,G1473"\w* \w a herança|strong="G3588,G2817"\w*.”\x - \xo 12:13 \xt 1TI 6:5; LUK 6:45; EZK 33:31; JHN 8:11; LUK 13:23; PRO 26:5\x*
\v 14 \w Ele|strong="G3588"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Homem|strong="G444"\w*, \w quem|strong="G5101"\w* \w me constituiu|strong="G3165,G2525"\w* \w juiz|strong="G2923"\w* \w ou|strong="G2228"\w* \w repartidor|strong="G3312"\w* \w sobre vocês|strong="G1909,G4771"\w*?”\f + \fr 12.14: \ft Lit.: μεριστής, “repartidor, divisor (de herança)”.\f*\x - \xo 12:14 \xt EXO 2:14; JHN 8:11; ROM 2:3; ROM 9:20; PRO 26:17; JHN 6:15\x*
\v 15 \w Disse-lhes|strong="G2036,G4314,G846"\w*, \w então|strong="G1161"\w*: “\w Vejam|strong="G3708"\w* \w e|strong="G2532"\w* \w guardem-se|strong="G5442"\w* \w de toda|strong="G575,G3956"\w* \w ganância|strong="G4124"\w*; \w porque|strong="G3754"\w* \w a vida|strong="G3588,G2222"\w* \w de alguém|strong="G5100,G846"\w* \w não consiste|strong="G3756,G1510"\w* \w na abundância|strong="G1722,G3588,G4052"\w* \w dos bens|strong="G1537,G3588,G5225"\w* \w que possui|strong="G846"\w*.”\f + \fr 12.15: \ft Lit.: πλεονεξία, “desejo de ter mais, ganância”; ζωή, “vida”.\f*\x - \xo 12:15 \xt HEB 13:5; 1TI 6:6-10; PSA 119:36; COL 3:2; PRO 15:16; PRO 16:16\x*
\v 16 \w Disse|strong="G2036"\w*, \w então|strong="G1161"\w*, \w uma parábola|strong="G3850"\w* \w a eles|strong="G4314,G846"\w*, \w dizendo|strong="G3004"\w*: “\w A terra|strong="G3588,G5561"\w* \w de um certo|strong="G5100"\w* \w homem|strong="G444"\w* \w rico|strong="G4145"\w* \w deu boa colheita|strong="G2164"\w*.\x - \xo 12:16 \xt MAL 3:10; HEB 13:5; JAS 5:1; PSA 62:10; GEN 26:12-14; EZK 16:49\x*
\v 17 \w E|strong="G2532"\w* \w refletia|strong="G1260"\w* \w consigo mesmo|strong="G1722,G1438"\w*, \w dizendo|strong="G3004"\w*: ‘\w O que|strong="G5101"\w* \w farei|strong="G4160"\w*, \w já que|strong="G3754"\w* \w não tenho|strong="G3756,G2192"\w* \w onde|strong="G4226"\w* \w recolher|strong="G4863"\w* \w as minhas colheitas|strong="G3588,G2590,G3165"\w*?’\x - \xo 12:17 \xt MAL 3:10; HEB 13:5; JAS 4:13; JAS 5:1; AMO 6:1; PSA 62:10\x*
\v 18 \w E|strong="G2532"\w* \w disse|strong="G2036"\w*: ‘\w Isto|strong="G3778"\w* \w farei|strong="G4160"\w*: \w derrubarei|strong="G2507"\w* \w os meus celeiros|strong="G3165,G3588,G596"\w* \w e|strong="G2532"\w* \w maiores|strong="G3173"\w* \w construirei|strong="G3618"\w*, \w e|strong="G2532"\w* \w recolherei|strong="G4863"\w* \w ali|strong="G1563"\w* \w todo o meu|strong="G3956,G3588"\w* \w trigo|strong="G4621"\w* \w e|strong="G2532"\w* \w os meus bens|strong="G3588,G18,G3165"\w*,\x - \xo 12:18 \xt HEB 13:5; JAS 4:13; DEU 28:8; JAS 5:1; AMO 6:1; JAS 3:15\x*
\v 19 \w e|strong="G2532"\w* \w direi|strong="G4483"\w* \w à minha alma|strong="G3588,G5590,G3165"\w*: “\w Alma|strong="G5590"\w*, \w você tem|strong="G2192"\w* \w muitos bens|strong="G4183,G18"\w* \w guardados|strong="G2749"\w* \w para muitos|strong="G1519,G4183"\w* \w anos|strong="G2094"\w*; \w descanse|strong="G373"\w*, \w coma|strong="G5315"\w*, \w beba|strong="G4095"\w*, \w alegre-se|strong="G2165"\w*.”’\f + \fr 12.19: \ft Lit.: ψυχή, “alma, vida”: aqui o homem fala consigo mesmo (“alma,…”).\f*\x - \xo 12:19 \xt MRK 8:36; HEB 13:5; JAS 4:13; PRO 27:1; LUK 9:25; 1CO 15:32\x*
\v 20 \w Disse-lhe|strong="G2036,G846"\w* \w Deus|strong="G3588,G2316"\w*: ‘\w Insensato|strong="G878"\w*, \w nesta noite|strong="G3778,G3588,G3571"\w* \w a sua vida|strong="G3588,G5590,G4771"\w* \w exigem de volta|strong="G523"\w* \w de você|strong="G575,G4771"\w*; \w e o que|strong="G3739,G1161"\w* \w preparou|strong="G2090"\w*, \w para quem|strong="G5101"\w* \w será|strong="G1510"\w*?’\f + \fr 12.20: \ft Lit.: ψυχή, “alma, vida”: aqui “vida”; ἀπαιτοῦσιν, plural impessoal: “exigem de volta” (sem sujeito expresso).\f*\x - \xo 12:20 \xt MAT 16:26; MRK 8:36; HEB 13:5; JAS 4:13; 1TI 6:7; PRO 27:1\x*
\v 21 \w Assim|strong="G3779"\w* \w é quem|strong="G3588"\w* \w junta tesouro|strong="G2343"\w* \w para si mesmo|strong="G1438"\w* \w e|strong="G2532"\w* \w não é rico|strong="G3361,G4147"\w* \w para com Deus|strong="G1519,G2316"\w*.”\f + \fr 12.21: \ft Acréscimo: verbo ser/estar suprido em “é quem”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:21 \xt MAT 6:19; HEB 13:5; 1TI 6:7; LUK 9:25; JAS 2:5; JAS 5:1\x*
\p
\v 22 \w Disse|strong="G2036"\w*, \w então|strong="G1161"\w*, \w aos seus discípulos|strong="G4314,G3588,G3101,G846"\w*: “\w Por isso|strong="G1223,G3778"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w não se preocupem|strong="G3361,G3309"\w* \w com a vida|strong="G3588,G5590"\w*, \w com o que|strong="G5101"\w* \w comerão|strong="G5315"\w*, \w nem|strong="G3366"\w* \w com o corpo|strong="G3588,G4983"\w*, \w com o que|strong="G5101"\w* \w vestirão|strong="G1746"\w*.\x - \xo 12:22 \xt MAT 6:25; 1PE 5:7; PRO 16:3; PHP 4:6; PSA 37:5; PSA 55:22\x*
\v 23 \w Pois|strong="G1063"\w* \w a vida|strong="G3588,G5590"\w* \w é mais|strong="G4119,G1510"\w* \w do que o alimento|strong="G3588,G5160"\w*, \w e|strong="G2532"\w* \w o corpo|strong="G3588,G4983"\w* \w do que a roupa|strong="G3588,G1742"\w*.\x - \xo 12:23 \xt MAT 6:25; JOB 2:6; PRO 13:8; PHP 4:5; JOB 2:4; ACT 27:18-19\x*
\v 24 \w Observem bem|strong="G2657"\w* \w os corvos|strong="G3588,G2876"\w*: \w pois|strong="G3754"\w* \w não semeiam|strong="G3756,G4687"\w* \w nem|strong="G3761"\w* \w colhem|strong="G2325"\w*, \w os quais|strong="G3739"\w* \w não têm|strong="G3756,G1510"\w* \w despensa|strong="G5009"\w* \w nem|strong="G3761"\w* \w celeiro|strong="G596"\w*, \w e|strong="G2532"\w* \w Deus|strong="G3588,G2316"\w* \w os alimenta|strong="G5142,G846"\w*; \w quanto mais|strong="G4214,G3123"\w* \w vocês|strong="G4771"\w* \w valem|strong="G1308"\w* \w do que as aves|strong="G3588,G4071"\w*!\x - \xo 12:24 \xt MAT 6:26; MAT 6:25; JOB 38:41; LUK 12:7; LUK 12:6; MAT 10:31\x*
\v 25 \w Quem|strong="G5101"\w* \w dentre vocês|strong="G1537,G4771"\w*, \w preocupando-se|strong="G3309"\w*, \w pode|strong="G1410"\w* \w acrescentar|strong="G4369"\w* \w um côvado|strong="G4083"\w* \w à sua estatura|strong="G1909,G3588,G2244,G846"\w*?\f + \fr 12.25: \ft Lit.: ἡλικία, “estatura” ou “duração da vida”; πῆχυς, “côvado”: medida de comprimento (do cotovelo à ponta dos dedos).\f*\x - \xo 12:25 \xt MAT 6:27; MAT 6:25; MAT 6:26; MAT 5:36; PSA 104:27; DEU 28:8\x*
\v 26 \w Se|strong="G1487"\w*, \w então|strong="G3767"\w*, \w nem mesmo|strong="G3761"\w* \w o mínimo|strong="G1646"\w* \w podem|strong="G1410"\w*, \w por que|strong="G5101"\w* \w se preocupam|strong="G3309"\w* \w com o restante|strong="G4012,G3588,G3062"\w*?\x - \xo 12:26 \xt MAT 6:27; MAT 6:25; MAT 6:26; 1PE 5:7; PSA 104:27; PHP 4:5\x*
\v 27 \w Observem bem|strong="G2657"\w* \w os lírios|strong="G3588,G2918"\w*, \w como|strong="G4459"\w* \w crescem|strong="G837"\w*: \w não trabalham|strong="G3756,G2872"\w* \w nem|strong="G3761"\w* \w fiam|strong="G3514"\w*; \w digo|strong="G3004"\w*, \w porém|strong="G1161"\w*, \w a vocês|strong="G4771"\w*: \w nem mesmo|strong="G3761"\w* \w Salomão|strong="G4672"\w*, \w em toda|strong="G1722,G3956"\w* \w a sua glória|strong="G3588,G1391,G846"\w*, \w se vestiu|strong="G4016"\w* \w como um|strong="G5613,G1520"\w* \w destes|strong="G3778"\w*.\x - \xo 12:27 \xt MAT 6:28; MAT 6:29; MAT 6:25; MAT 6:26; LUK 12:24; PSA 104:27\x*
\v 28 \w Se|strong="G1487"\w* \w a erva|strong="G3588,G5528"\w* \w que está|strong="G1510"\w* \w no campo|strong="G1722,G68"\w* \w hoje|strong="G4594"\w* \w e|strong="G2532"\w* \w amanhã|strong="G839"\w* \w é lançada|strong="G906"\w* \w no forno|strong="G1519,G2823"\w*, \w Deus|strong="G3588,G2316"\w* \w assim|strong="G3779"\w* \w a veste|strong="G6005"\w*, \w quanto mais|strong="G4214,G3123"\w* \w a vocês|strong="G4771"\w*, \w gente de pouca fé|strong="G3640"\w*!\x - \xo 12:28 \xt MAT 6:30; MAT 6:25; MAT 6:26; ISA 40:6; PSA 104:27; LUK 8:25\x*
\v 29 \w E|strong="G2532"\w* \w vocês|strong="G4771"\w*, \w não procurem|strong="G3361,G2212"\w* \w o que|strong="G5101"\w* \w comerão|strong="G5315"\w* \w e|strong="G2532"\w* \w o que|strong="G5101"\w* \w beberão|strong="G4095"\w*, \w e|strong="G2532"\w* \w não vivam ansiosos|strong="G3361,G3349"\w*,\f + \fr 12.29: \ft Lit.: μετεωρίζομαι, “ficar no ar, em suspenso”: “viver inquieto, ansioso”.\f*\x - \xo 12:29 \xt MAT 6:31; 1CO 9:4; ACT 9:9; JHN 6:53; PHP 4:6; MAT 6:25\x*
\v 30 \w pois|strong="G1063"\w* \w todas estas coisas|strong="G3778,G3956"\w* \w as nações|strong="G3588,G1484"\w* \w do mundo|strong="G3588,G2889"\w* \w procuram|strong="G1934"\w*; \w o Pai|strong="G3588,G3962"\w* \w de vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w sabe|strong="G6063"\w* \w que|strong="G3754"\w* \w precisam|strong="G5535"\w* \w delas|strong="G3778"\w*.\x - \xo 12:30 \xt MAT 6:32; 1PE 5:7; PSA 23:1; PHP 4:19; MAT 6:25; PSA 37:5\x*
\v 31 \w Mas|strong="G4133"\w* \w procurem|strong="G2212"\w* \w o reino|strong="G3588,G932"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w estas coisas|strong="G3778"\w* \w serão acrescentadas|strong="G4369"\w* \w a vocês|strong="G4771"\w*.\f + \fr 12.31: \ft Variante: O RP lê “o reino de Deus” (τοῦ θεοῦ) em lugar de “o reino dele” (αὐτοῦ) e acrescenta “todas” (πάντα) antes de “estas coisas”.\f*\x - \xo 12:31 \xt MAT 6:33; 1PE 5:7; PSA 23:1; HEB 11:6; PHP 4:19; MAT 6:25\x*
\v 32 \w Não tenha medo|strong="G3361,G5399"\w*, \w pequeno rebanho|strong="G3588,G3398,G4168"\w*, \w porque|strong="G3754"\w* \w foi do agrado|strong="G2106"\w* \w do Pai|strong="G3588,G3962"\w* \w de vocês|strong="G4771"\w* \w dar|strong="G1325"\w* \w a vocês|strong="G4771"\w* \w o reino|strong="G3588,G932"\w*.\x - \xo 12:32 \xt 1PE 5:7; PSA 23:1; PHP 4:19; DEU 31:6; HEB 12:28; ISA 44:2\x*
\v 33 \w Vendam|strong="G4453"\w* \w os bens|strong="G3588,G5225"\w* \w de vocês|strong="G4771"\w* \w e|strong="G2532"\w* \w deem|strong="G1325"\w* \w esmolas|strong="G1654"\w*; \w façam para vocês|strong="G4160,G1438"\w* \w bolsas|strong="G905"\w* \w que não envelheçam|strong="G3361,G3822"\w*, \w um tesouro|strong="G2344"\w* \w inesgotável|strong="G413"\w* \w nos céus|strong="G1722,G3588,G3772"\w*, \w onde|strong="G3699"\w* \w nenhum ladrão|strong="G2812,G3756"\w* \w se aproxima|strong="G1448"\w* \w nem|strong="G3761"\w* \w traça|strong="G4597"\w* \w destrói|strong="G1311"\w*;\x - \xo 12:33 \xt MAT 6:20; MAT 6:19; PHP 4:19; COL 3:1; MAT 19:21; ACT 2:45\x*
\v 34 \w pois|strong="G1063"\w*, \w onde|strong="G3699"\w* \w está|strong="G1510"\w* \w o tesouro|strong="G3588,G2344"\w* \w de vocês|strong="G4771"\w*, \w ali|strong="G1563"\w* \w também|strong="G2532"\w* \w estará|strong="G1510"\w* \w o coração|strong="G3588,G2588"\w* \w de vocês|strong="G4771"\w*.\x - \xo 12:34 \xt MAT 6:21; COL 3:1-3; PHP 3:20; ACT 2:45\x*
\p
\v 35 \w Estejam|strong="G1510"\w* \w cingidos|strong="G4024"\w* \w os lombos|strong="G3588,G3751"\w* \w de vocês|strong="G4771"\w* \w e|strong="G2532"\w* \w acesas|strong="G2545"\w* \w as lamparinas|strong="G3588,G3088"\w*,\f + \fr 12.35: \ft Lit.: περιζώννυμι τὰς ὀσφύας, “cingir os lombos”: prender a roupa ao cinto, para estar pronto para agir.\f*\x - \xo 12:35 \xt EPH 6:14; MAT 25:1; 1PE 1:13; 1CO 16:13; PSA 90:12; MAT 25:4-10\x*
\v 36 \w e|strong="G2532"\w* \add sejam\add* \w vocês|strong="G4771"\w* \w semelhantes|strong="G3664"\w* \w a pessoas|strong="G444"\w* \w que esperam|strong="G4327"\w* \w o seu senhor|strong="G3588,G2962,G1438"\w* \w quando voltar|strong="G4219,G360"\w* \w das bodas|strong="G1537,G3588,G1062"\w*, \w para que|strong="G2443"\w*, \w quando chegar|strong="G2064"\w* \w e|strong="G2532"\w* \w bater|strong="G2925"\w*, \w imediatamente|strong="G2112"\w* \w lhe abram|strong="G455,G846"\w*.\f + \fr 12.36: \ft Acréscimo: “sejam” (em “e sejam vocês semelhantes”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 12:36 \xt REV 3:20; MAT 25:1; 1CO 16:13; PSA 90:12; MAT 24:42; JUD 1:20-21\x*
\v 37 \w Felizes|strong="G3107"\w* \w aqueles|strong="G3588,G1565"\w* \w escravos|strong="G1401"\w*, \w a quem|strong="G3739"\w* \w o senhor|strong="G3588,G2962"\w*, \w quando chegar|strong="G2064"\w*, \w encontrar|strong="G2147"\w* \w vigiando|strong="G1127"\w*; \w em verdade|strong="G281"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w ele se cingirá|strong="G4024"\w*, \w e|strong="G2532"\w* \w os fará reclinar-se|strong="G347,G846"\w*, \w e|strong="G2532"\w*, \w passando|strong="G3928"\w*, \w os servirá|strong="G1247,G846"\w*.\x - \xo 12:37 \xt REV 3:20; LUK 12:43; MAT 24:46; 1CO 16:13; LUK 21:36; PSA 90:12\x*
\v 38 \w Mesmo que|strong="G1437_A,G2532"\w* \w na segunda|strong="G1722,G3588,G1208"\w* \w ou mesmo que|strong="G1437_B,G2532"\w* \w na terceira|strong="G1722,G3588,G5154"\w* \w vigília|strong="G5438"\w* \w ele venha|strong="G2064"\w* \w e|strong="G2532"\w* \w os encontre|strong="G2147"\w* \w assim|strong="G3779"\w*, \w felizes|strong="G3107,G1510"\w* \w são eles|strong="G1565"\w*.\f + \fr 12.38: \ft Lit.: φυλακή, “vigília” (cada uma das divisões da noite).\f*\f + \fr 12.38: \ft Variante: O RP traz “E se ele vier na segunda vigília e na terceira” (Καὶ ἐὰν ἔλθῃ ἐν τῇ δευτέρᾳ φυλακῇ καί…) em lugar de κἂν… κἂν…; Treg e RP acrescentam “escravos” (οἱ δοῦλοι) depois de “são”.\f*\f + \fr 12.38: \ft Acréscimo: verbo ser/estar suprido em “são eles”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:38 \xt 1CO 16:13; LUK 21:36; PSA 90:12; REV 16:15; MAT 24:42; REV 22:14\x*
\v 39 \w Saibam|strong="G1097"\w* \w isto|strong="G3778"\w*: \w que|strong="G3754"\w*, \w se|strong="G1487"\w* \w soubesse|strong="G1492"\w* \w o dono da casa|strong="G3588,G3617"\w* \w a que hora|strong="G4169,G5610"\w* \w o ladrão|strong="G3588,G2812"\w* \w vem|strong="G2064"\w*, \w não teria deixado|strong="G3756,G302,G863"\w* \w que fosse arrombada|strong="G1358"\w* \w a sua casa|strong="G3588,G3624,G846"\w*.\f + \fr 12.39: \ft Variante: WH e Treg trazem “teria vigiado e não” (ἐγρηγόρησεν ἂν καὶ οὐκ) e o RP “teria vigiado e não teria” (ἐγρηγόρησεν ἂν καὶ οὐκ ἂν) em lugar de οὐκ ἄν; Treg e RP lêem διορυγῆναι (outra forma de “ser arrombada”).\f*\x - \xo 12:39 \xt MAT 24:43; REV 3:3; 1CO 16:13; LUK 21:36; PSA 90:12; 1TH 5:2\x*
\v 40 \w Também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w estejam|strong="G1096"\w* \w prontos|strong="G2092"\w*, \w porque|strong="G3754"\w* \w numa hora|strong="G3739,G5610"\w* \w em que não pensam|strong="G3756,G1380"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w* \w vem|strong="G2064"\w*.”\f + \fr 12.40: \ft Variante: O RP acrescenta οὖν (“então”) depois de “vocês”.\f*\x - \xo 12:40 \xt MAT 24:44; 1CO 16:13; 1TH 5:6; LUK 21:36; PSA 90:12; MAT 25:13\x*
\v 41 \w Disse|strong="G2036"\w*, \w então|strong="G1161"\w*, \w Pedro|strong="G3588,G4074"\w*: “\w Senhor|strong="G2962"\w*, \w é para nós|strong="G4314,G3165"\w* \w que você diz|strong="G3004"\w* \w esta parábola|strong="G3588,G3850,G3778"\w*, \w ou|strong="G2228"\w* \w também|strong="G2532"\w* \w para todos|strong="G4314,G3956"\w*?”\f + \fr 12.41: \ft Acréscimo: verbo ser/estar suprido em “é para nós”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:41 \xt MAT 15:15; REV 16:15; MAT 24:45; MRK 13:37; 1PE 4:7; MAT 13:3\x*
\v 42 \w E|strong="G2532"\w* \w o Senhor|strong="G3588,G2962"\w* \w disse|strong="G2036"\w*: “\w Quem|strong="G5101"\w* \w então|strong="G686"\w* \w é|strong="G1510"\w* \w o administrador|strong="G3588,G3623"\w* \w fiel|strong="G4103"\w* \w e prudente|strong="G3588,G5429"\w*, \w a quem|strong="G3739"\w* \w o seu senhor|strong="G3588,G2962"\w* \w encarregará|strong="G2525"\w* \w da criadagem|strong="G1909,G3588,G2322"\w* \w dele|strong="G846"\w*, \w para dar|strong="G3588,G1325"\w* \w na hora certa|strong="G1722,G2540"\w* \w a ração de alimento|strong="G3588,G4620"\w*?\f + \fr 12.42: \ft Lit.: οἰκονόμος, “administrador, mordomo”; θεραπεία, “criadagem, grupo de servos”; σιτομέτριον, “ração de grãos, porção de alimento”.\f*\x - \xo 12:42 \xt MAT 24:45; 1CO 4:2; 2TI 2:15; REV 16:15; JER 3:15; 1PE 4:10\x*
\v 43 \w Feliz|strong="G3107"\w* \w aquele|strong="G3588,G1565"\w* \w escravo|strong="G1401"\w*, \w a quem|strong="G3739"\w* \w o seu senhor|strong="G3588,G2962,G846"\w*, \w quando chegar|strong="G2064"\w*, \w encontrar|strong="G2147"\w* \w fazendo|strong="G4160"\w* \w assim|strong="G3779"\w*.\x - \xo 12:43 \xt MAT 24:46; LUK 12:37; REV 16:15; PSA 101:6; MAT 24:45; MRK 13:37\x*
\v 44 \w De verdade|strong="G230"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w o encarregará|strong="G2525,G846"\w* \w de todos|strong="G1909,G3956"\w* \w os bens|strong="G3588,G5225"\w* \w dele|strong="G846"\w*.\x - \xo 12:44 \xt MAT 24:47; PSA 101:6; MAT 25:21; MRK 13:37; EZK 34:2; LUK 22:29-30\x*
\v 45 \w Mas se|strong="G1437,G1161"\w* \w aquele escravo|strong="G3588,G1401,G1565"\w* \w disser|strong="G2036"\w* \w no seu coração|strong="G1722,G3588,G2588,G846"\w*: ‘\w Meu senhor|strong="G3588,G2962,G3165"\w* \w demora|strong="G5549"\w* \w a vir|strong="G2064"\w*’, \w e|strong="G2532"\w* \w começar|strong="G757"\w* \w a bater|strong="G5180"\w* \w nos servos|strong="G3588,G3816"\w* \w e|strong="G2532"\w* \w nas servas|strong="G3588,G3814"\w*, \w a comer|strong="G2068"\w*, \w e também|strong="G5037,G2532"\w* \w beber|strong="G4095"\w* \w e|strong="G2532"\w* \w embriagar-se|strong="G3182"\w*,\x - \xo 12:45 \xt MAT 24:48; LUK 21:34; 1CO 9:27; 1PE 5:8; 2PE 3:4; MRK 13:37\x*
\v 46 \w virá|strong="G2240"\w* \w o senhor|strong="G3588,G2962"\w* \w daquele escravo|strong="G3588,G1401,G1565"\w* \w num dia|strong="G1722,G2250"\w* \w em que|strong="G3739"\w* \w não espera|strong="G3756,G4328"\w* \w e|strong="G2532"\w* \w numa hora|strong="G1722,G5610"\w* \w que|strong="G3739"\w* \w não conhece|strong="G3756,G1097"\w*, \w e|strong="G2532"\w* \w o partirá ao meio|strong="G1371,G846"\w*, \w e|strong="G2532"\w* \w porá|strong="G5087"\w* \w a parte|strong="G3588,G3313"\w* \w dele|strong="G846"\w* \w com os infiéis|strong="G3326,G3588,G571"\w*.\f + \fr 12.46: \ft Lit.: διχοτομέω, “cortar ao meio”, ou, em sentido figurado, “castigar com severidade”; ἄπιστοι, “sem fé, infiéis, não dignos de confiança”.\f*\x - \xo 12:46 \xt MAT 24:50; MAT 24:51; LUK 21:34; 1CO 9:27; 1PE 5:8; MRK 13:37\x*
\v 47 \w Aquele|strong="G1565"\w* \w escravo|strong="G3588,G1401"\w* \w que conheceu|strong="G3588,G1097"\w* \w a vontade|strong="G3588,G2307"\w* \w do seu senhor|strong="G3588,G2962,G846"\w* \w e|strong="G2532"\w* \w não se preparou|strong="G3361,G2090"\w* \w nem fez|strong="G2228,G4160"\w* \w conforme a vontade|strong="G4314,G3588,G2307"\w* \w dele|strong="G846"\w*, \w será açoitado|strong="G1194"\w* \w com muitos golpes|strong="G4183"\w*;\x - \xo 12:47 \xt JAS 4:17; JAS 3:1; HEB 10:26; JAS 1:22; 2PE 2:21; JHN 9:41\x*
\v 48 \w mas o que|strong="G3588,G1161"\w* \w não conheceu|strong="G3361,G1097"\w* \w e|strong="G1161"\w* \w fez|strong="G4160"\w* \w coisas dignas|strong="G514"\w* \w de golpes|strong="G4127"\w*, \w será açoitado|strong="G1194"\w* \w com poucos|strong="G3641"\w*. \w Mas a todo|strong="G3956,G1161"\w* \w aquele a quem|strong="G3739"\w* \w foi dado|strong="G1325"\w* \w muito|strong="G4183"\w*, \w muito|strong="G4183"\w* \w será exigido|strong="G2212"\w* \w dele|strong="G3844,G846"\w*; \w e|strong="G2532"\w* \w a quem|strong="G3739"\w* \w confiaram|strong="G3908"\w* \w muito|strong="G4183"\w*, \w mais|strong="G4055"\w* \w lhe pedirão|strong="G154,G846"\w*.\f + \fr 12.48: \ft Tradução: ζητηθήσεται (ζητέω, G2212) está aqui como “será exigido”; o termo pode ser “procurar”, “buscar”, “tentar” ou “exigir”, e o contexto decide.\f*\x - \xo 12:48 \xt JAS 4:17; JAS 3:1; LEV 5:17; LUK 16:10-12; JAS 1:22; MAT 25:14-29\x*
\p
\v 49 \w Fogo|strong="G4442"\w* \w vim|strong="G2064"\w* \w lançar|strong="G906"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*, \w e|strong="G2532"\w* \w como|strong="G5101"\w* \w eu queria|strong="G2309"\w* \w que|strong="G1487"\w* \w já|strong="G2235"\w* \w estivesse aceso|strong="G381"\w*!\f + \fr 12.49: \ft Lit.: τί θέλω εἰ ἤδη ἀνήφθη, “o que quero, se já foi aceso?”: pode ser lido “como queria que já estivesse aceso!”.\f*\x - \xo 12:49 \xt MAT 10:34; MAL 4:1; MAL 3:2-3; MAT 3:10-12; LUK 12:51; ISA 11:4\x*
\v 50 \w Mas|strong="G1161"\w* \w tenho|strong="G2192"\w* \w um batismo|strong="G908"\w* \w a receber|strong="G907"\w*, \w e|strong="G2532"\w* \w como|strong="G4459"\w* \w estou angustiado|strong="G4912"\w* \w até que|strong="G2193,G3748"\w* \w se cumpra|strong="G5055"\w*!\f + \fr 12.50: \ft Lit.: βάπτισμα, “imersão, batismo”: aqui, imagem de grande sofrimento (cf. Mc 10:38); συνέχομαι, “estar premido, angustiado”.\f*\f + \fr 12.50: \ft Tradução: βαπτισθῆναι (βαπτίζω, G907) está aqui como “a receber”; o termo pode ser “batizar”, “mergulhar” ou “lavar”, e o contexto decide.\f*\x - \xo 12:50 \xt MRK 10:38; MAT 10:34; JHN 14:31; LUK 22:15; JHN 12:27; JHN 19:28\x*
\v 51 \w Vocês pensam|strong="G1380"\w* \w que|strong="G3754"\w* \w vim|strong="G3854"\w* \w dar|strong="G1325"\w* \w paz|strong="G1515"\w* \w à terra|strong="G1722,G3588,G1093"\w*? \w Não|strong="G3780"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*, \w mas antes|strong="G235,G2228"\w* \w divisão|strong="G1267"\w*.\x - \xo 12:51 \xt MAT 10:34; LUK 12:49; MAT 10:21; SNG 1:6; MAT 24:7-10; ZEC 11:10-11\x*
\v 52 \w Pois|strong="G1063"\w* \w de agora em diante|strong="G575,G3588,G3568"\w* \w estarão|strong="G1510"\w* \w cinco|strong="G4002"\w* \w em uma só casa|strong="G1722,G1520,G3624"\w* \w divididos|strong="G1266"\w*: \w três|strong="G5140"\w* \w contra dois|strong="G1909,G1417"\w* \w e|strong="G2532"\w* \w dois|strong="G1417"\w* \w contra três|strong="G1909,G5140"\w*;\x - \xo 12:52 \xt MAT 10:34; LUK 12:49; MAT 10:21; ACT 14:1-4; JHN 15:18-21; MIC 7:5-6\x*
\v 53 \w serão divididos|strong="G1266"\w*: \w pai|strong="G3962"\w* \w contra filho|strong="G1909,G5207"\w* \w e|strong="G2532"\w* \w filho|strong="G5207"\w* \w contra pai|strong="G1909,G3962"\w*, \w mãe|strong="G3384"\w* \w contra filha|strong="G1909,G2364"\w* \w e|strong="G2532"\w* \w filha|strong="G2364"\w* \w contra a mãe|strong="G1909,G3588,G3384"\w*, \w sogra|strong="G3994"\w* \w contra a nora|strong="G1909,G3588,G3565"\w* \w dela|strong="G846"\w* \w e|strong="G2532"\w* \w nora|strong="G3565"\w* \w contra a sogra|strong="G1909,G3588,G3994"\w*.”\x - \xo 12:53 \xt MAT 10:35; MAT 10:34; MIC 7:6; MAT 10:21; LUK 21:16; MAT 24:10\x*
