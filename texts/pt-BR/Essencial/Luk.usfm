\p
\v 1 \w Disse|strong="G2036"\w* \w aos seus discípulos|strong="G4314,G3588,G3101,G846"\w*: “\w É impossível|strong="G418,G1510"\w* \w que os tropeços|strong="G3588,G4625"\w* \w não venham|strong="G3361,G2064"\w*; \w mas|strong="G4133"\w* \w ai|strong="G3759"\w* \w daquele por quem|strong="G1223,G3739"\w* \w vêm|strong="G2064"\w*\f + \fr 17.1: \ft Lit.: σκάνδαλον, “armadilha, pedra de tropeço, ocasião de cair”.\f*!\x - \xo 17:1 \xt MAT 18:7; MAT 18:6; ROM 14:13; 1CO 11:19; 1CO 8:13; ROM 16:17\x*
\v 2 \w É melhor|strong="G3081"\w* \w para ele|strong="G846"\w* \w se|strong="G1487"\w* \w uma pedra de moinho|strong="G3037,G3457"\w* \w é posta|strong="G4029"\w* \w ao redor|strong="G4012"\w* \w do seu pescoço|strong="G3588,G5137,G846"\w* \w e|strong="G2532"\w* \w ele é lançado|strong="G4496"\w* \w ao mar|strong="G1519,G3588,G2281"\w*, \w do que|strong="G2228"\w* \w fazer tropeçar|strong="G2443,G4624"\w* \w um|strong="G1520"\w* \w destes pequeninos|strong="G3588,G3398,G3778"\w*.\x - \xo 17:2 \xt MRK 9:42; MAT 18:6; MAT 18:14; ROM 14:13; MAT 18:3-6; MAT 18:10\x*
\v 3 \w Cuidem-se|strong="G4337,G1438"\w*. \w Se|strong="G1437"\w* \w o seu irmão|strong="G3588,G80,G4771"\w* \w pecar|strong="G264"\w*, \w repreenda-o|strong="G2008,G846"\w*; \w e|strong="G2532"\w* \w se|strong="G1437"\w* \w se arrepender|strong="G3340"\w*, \w perdoe-lhe|strong="G863,G846"\w*;\f + \fr 17.3: \ft Variante: O RP acrescenta δέ (“porém”) e εἰς σέ (“contra você”) depois de ἁμάρτῃ.\f*\x - \xo 17:3 \xt COL 3:13; MAT 18:15; MAT 18:21; MAT 6:12; LEV 19:17; PRO 9:8\x*
\v 4 \w e|strong="G2532"\w* \w se|strong="G1437"\w* \w sete vezes|strong="G2034"\w* \w por dia|strong="G3588,G2250"\w* \w pecar|strong="G264"\w* \w contra você|strong="G1519,G4771"\w* \w e|strong="G2532"\w* \w sete vezes|strong="G2034"\w* \w voltar|strong="G1994"\w* \w a você|strong="G4314,G4771"\w*, \w dizendo|strong="G3004"\w*: ‘\w Arrependo-me|strong="G3340"\w*’, \w você lhe perdoará|strong="G863,G846"\w*.”\x - \xo 17:4 \xt MAT 18:21; COL 3:13; EPH 4:32; MAT 18:15; MAT 6:12; COL 3:12-13\x*
\p
\v 5 \w E|strong="G2532"\w* \w os apóstolos|strong="G3588,G652"\w* \w disseram|strong="G2036"\w* \w ao Senhor|strong="G3588,G2962"\w*: “\w Acrescente|strong="G4369"\w* \w a nós|strong="G3165"\w* \w fé|strong="G4102"\w*.”\x - \xo 17:5 \xt MRK 9:24; MAT 6:12; HEB 12:2; PHP 4:13; 2CO 12:8-10; ACT 3:16\x*
\v 6 \w Disse|strong="G2036"\w* \w o Senhor|strong="G3588,G2962"\w*: “\w Se|strong="G1487"\w* \w tivessem|strong="G2192"\w* \w fé|strong="G4102"\w* \w como um grão|strong="G5613,G2848"\w* \w de mostarda|strong="G4615"\w*, \w diriam|strong="G3004,G302"\w* \w a esta amoreira|strong="G3588,G4807,G3778"\w*: ‘\w Seja arrancada|strong="G1610"\w* \w e|strong="G2532"\w* \w plantada|strong="G5452"\w* \w no mar|strong="G1722,G3588,G2281"\w*’, \w e|strong="G2532"\w* \w ela obedeceria|strong="G5219,G302"\w* \w a vocês|strong="G4771"\w*.”\x - \xo 17:6 \xt MAT 17:20; MAT 13:31; MRK 11:23; MRK 9:23; MAT 21:21; ACT 3:16\x*
\p
\v 7 \w Quem|strong="G5101"\w* \w dentre vocês|strong="G1537,G4771"\w*, \w tendo|strong="G2192"\w* \w um escravo|strong="G1401"\w* \w que lavra|strong="G722"\w* \w ou|strong="G2228"\w* \w pastoreia|strong="G4165"\w*, \w lhe dirá|strong="G3739,G4483,G846"\w*, \add quando ele\add* \w entrar|strong="G1525"\w* \w do campo|strong="G1537,G3588,G68"\w*: ‘\w Venha logo|strong="G2112,G3928"\w* \add e\add* \w ponha-se à mesa|strong="G377"\w*’?\f + \fr 17.7: \ft Acréscimo: “quando” (em “lhe dirá quando ele entrar”), “e” (em “Venha logo e ponha se”): conectivo acrescentado para ligar as orações em português; “ele” (em “dirá quando ele entrar do”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 17:7 \xt MAT 21:21; LUK 22:27; JHN 13:4\x*
\v 8 \w Mas|strong="G235"\w* \w não lhe dirá|strong="G3780,G4483,G846"\w*: ‘\w Prepare|strong="G2090"\w* \w o que|strong="G5101"\w* \w eu jante|strong="G1172"\w*, \w e|strong="G2532"\w*, \w cingindo-se|strong="G4024"\w*, \w sirva-me|strong="G1247,G3165"\w* \w até que|strong="G2193"\w* \w coma|strong="G5315"\w* \w e|strong="G2532"\w* \w beba|strong="G4095"\w*; \w e|strong="G2532"\w* \w depois|strong="G3326,G3778"\w* \w comerá|strong="G5315"\w* \w e|strong="G2532"\w* \w beberá|strong="G4095"\w* \w você mesmo|strong="G4771"\w*’?\x - \xo 17:8 \xt REV 3:20; LUK 12:37; GEN 43:16; LUK 22:27\x*
\v 9 \w Acaso|strong="G3361"\w* \w ele agradece|strong="G2192,G5485"\w* \w ao escravo|strong="G3588,G1401"\w* \w porque|strong="G3754"\w* \w fez|strong="G4160"\w* \w o que foi ordenado|strong="G3588,G1299"\w*?\f + \fr 17.9: \ft Variante: O RP traz χάριν ἔχει em ordem inversa, acrescenta ἐκείνῳ (“àquele”) depois de “escravo” e, no fim, “penso que não” (οὐ δοκῶ).\f*\x - \xo 17:9 \xt LUK 22:27\x*
\v 10 \w Assim|strong="G3779"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w*, \w quando|strong="G3752"\w* \w fizerem|strong="G4160"\w* \w tudo|strong="G3956"\w* \w o que foi ordenado|strong="G3588,G1299"\w* \w a vocês|strong="G4771"\w*, \w digam|strong="G3004"\w*: ‘\w Somos|strong="G1510"\w* \w escravos|strong="G1401"\w* \w inúteis|strong="G888"\w*; \w o que|strong="G3739"\w* \w devíamos|strong="G3784"\w* \w fazer|strong="G4160"\w*, \w fizemos|strong="G4160"\w*.’”\f + \fr 17.10: \ft Lit.: ἀχρεῖος, “inútil, sem proveito”: aqui, escravos sem direito a recompensa especial por fazerem o que lhes cabia.\f*\x - \xo 17:10 \xt MAT 25:30; 1CO 9:16-17; 1PE 5:5-6; JOB 22:2; 1CO 15:9-10; JOB 35:6-7\x*
\p
\v 11 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w enquanto ia|strong="G1722,G3588,G4198"\w* \w para Jerusalém|strong="G1519,G2419"\w*, \w também|strong="G2532"\w* \w ele|strong="G846"\w* \w passava|strong="G1330"\w* \w pelo meio|strong="G1223,G3319"\w* \w da Samaria|strong="G4540"\w* \w e|strong="G2532"\w* \w da Galileia|strong="G1056"\w*.\f + \fr 17.11: \ft Acréscimo: “que” (em “E aconteceu que enquanto ia”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 17:11 \xt JHN 4:4; LUK 4:30; LUK 9:51; JHN 4:3-4\x*
\v 12 \w E|strong="G2532"\w*, \w ao entrar ele|strong="G1525,G846"\w* \w num certo povoado|strong="G1519,G5100,G2968"\w*, \w vieram-lhe ao encontro|strong="G528"\w* \w dez|strong="G1176"\w* \w homens leprosos|strong="G3015,G435"\w*, \w que pararam|strong="G3739,G2476"\w* \w à distância|strong="G4207"\w*,\f + \fr 17.12: \ft Variante: Treg, NA28 e RP acrescentam “a ele” (αὐτῷ) depois de “vieram ao encontro”; WH lê ἀνέστησαν (“se levantaram”) em lugar de ἔστησαν (“pararam”).\f*\x - \xo 17:12 \xt LEV 13:45; LUK 5:12; 2KI 7:3; MAT 8:2; LUK 18:13; 2CH 26:20-21\x*
\v 13 \w e|strong="G2532"\w* \w eles|strong="G846"\w* \w levantaram a voz|strong="G142,G5456"\w*, \w dizendo|strong="G3004"\w*: “\w Jesus|strong="G2424"\w*, \w Mestre|strong="G1988"\w*, \w tenha misericórdia de nós|strong="G1653,G3165"\w*.”\x - \xo 17:13 \xt MAT 8:2; LUK 5:12; MAT 15:22; MAT 9:27; LUK 5:5; MAT 20:30-31\x*
\v 14 \w E|strong="G2532"\w*, \w vendo|strong="G1492"\w*, \w lhes disse|strong="G2036,G846"\w*: “\w Vão|strong="G4198"\w* \add e\add* \w mostrem-se|strong="G1925,G1438"\w* \w aos sacerdotes|strong="G3588,G2409"\w*.” \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w enquanto iam|strong="G1722,G3588,G5217,G846"\w*, \w foram purificados|strong="G2511"\w*.\f + \fr 17.14: \ft Nota cultural: a Lei previa que o sacerdote examinasse e declarasse a pessoa curada (Lv 13-14).\f*\f + \fr 17.14: \ft Acréscimo: “e” (em “disse Vão e mostrem se”): conectivo acrescentado para ligar as orações em português; “que” (em “E aconteceu que enquanto iam”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 17:14 \xt LEV 13:1-46; MRK 1:44; MAT 8:4; LEV 14:2; LUK 5:14; MAT 8:2\x*
\v 15 \w Um|strong="G1520"\w* \w deles|strong="G1537,G846"\w*, \w vendo|strong="G1492"\w* \w que|strong="G3754"\w* \w foi curado|strong="G2390"\w*, \w voltou|strong="G5290"\w*, \w glorificando|strong="G1392"\w* \w a Deus|strong="G3588,G2316"\w* \w em alta voz|strong="G3326,G5456,G3173"\w*,\x - \xo 17:15 \xt PSA 103:2; PSA 50:15; PSA 30:11-12; PSA 103:1-4; ISA 38:19-22; LUK 17:17-18\x*
\v 16 \w e|strong="G2532"\w* \w caiu|strong="G4098"\w* \w de rosto no chão|strong="G1909,G4383"\w* \w aos pés|strong="G3844,G3588,G4228"\w* \w dele|strong="G846"\w*, \w agradecendo-lhe|strong="G2168,G846"\w*; \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w era|strong="G1510"\w* \w samaritano|strong="G4541"\w*.\x - \xo 17:16 \xt JHN 4:9; LUK 9:52; PSA 103:2; PSA 50:15; ACT 8:5-25; COL 3:15\x*
\v 17 \w Respondendo|strong="G611"\w* \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Não foram purificados|strong="G3780,G2511"\w* \w os dez|strong="G3588,G1176"\w*? \w Os nove|strong="G3588,G1767"\w* \w onde estão|strong="G4226"\w*?\f + \fr 17.17: \ft Acréscimo: “onde estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 17:17 \xt PSA 103:2; PSA 50:15; ROM 1:21; PSA 106:13; COL 3:15; LUK 17:15\x*
\v 18 \w Não se achou|strong="G3756,G2147"\w* \w quem voltasse|strong="G5290"\w* \w para dar|strong="G1325"\w* \w glória|strong="G1391"\w* \w a Deus|strong="G3588,G2316"\w*, \w a não ser|strong="G1487,G3361"\w* \w este estrangeiro|strong="G3588,G241,G3778"\w*?”\f + \fr 17.18: \ft Lit.: ἀλλογενής, “de outra raça, estrangeiro”: aqui, o samaritano.\f*\x - \xo 17:18 \xt LUK 2:45; PSA 103:2; PSA 50:15; PSA 50:23; MAL 2:2; COL 3:15\x*
\v 19 \w E|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Levante-se|strong="G450"\w* \add e\add* \w vá|strong="G4198"\w*; \w a sua fé|strong="G3588,G4102,G4771"\w* \w salvou você|strong="G4982,G4771"\w*.”\f + \fr 17.19: \ft Acréscimo: “e” (em “Levante se e vá a”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 17:19 \xt LUK 7:50; LUK 8:48; LUK 18:42; MRK 10:52; MRK 5:34; MAT 8:2\x*
\p
\v 20 \w Interrogado|strong="G1905"\w* \w pelos fariseus|strong="G5259,G3588,G5330"\w* \w sobre quando|strong="G4219"\w* \w vem|strong="G2064"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*, \w lhes respondeu|strong="G611,G846"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w O reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w não vem|strong="G3756,G2064"\w* \w de modo observável|strong="G3326,G3907"\w*,\f + \fr 17.20: \ft Lit.: παρατήρησις, “observação atenta”: com sinais que se possam ver e calcular.\f*\x - \xo 17:20 \xt ROM 14:17; JHN 18:36; ACT 1:6; LUK 16:16; LUK 19:11; DAN 2:44\x*
\v 21 \w nem|strong="G3761"\w* \w dirão|strong="G4483"\w*: ‘\w Olhem|strong="G2400"\w* \w aqui|strong="G5602"\w*’ \w ou|strong="G2228"\w* ‘\w Ali|strong="G1563"\w*’; \w pois|strong="G1063"\w* \w olhem|strong="G2400"\w*, \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w está|strong="G1510"\w* \w no meio de vocês|strong="G1787,G4771"\w*.”\f + \fr 17.21: \ft Lit.: ἐντὸς ὑμῶν, “entre vocês” ou “dentro de vocês”: o sentido é discutido.\f*\x - \xo 17:21 \xt LUK 17:23; MRK 13:21; MAT 24:23; MAT 12:28; ROM 14:17; JHN 18:36\x*
\p
\v 22 \w Disse|strong="G2036"\w* \w aos discípulos|strong="G4314,G3588,G3101"\w*: “\w Virão|strong="G2064"\w* \w dias|strong="G2250"\w* \w em que|strong="G3753"\w* \w desejarão|strong="G1937"\w* \w ver|strong="G1492"\w* \w um|strong="G1520"\w* \w dos dias|strong="G3588,G2250"\w* \w do Filho do Homem|strong="G3588,G5207,G444"\w* \w e|strong="G2532"\w* \w não verão|strong="G3756,G3700"\w*.\x - \xo 17:22 \xt LUK 5:35; MAT 9:15; LUK 17:26; MRK 2:20; JHN 13:33; JHN 16:16-22\x*
\v 23 \w E|strong="G2532"\w* \w dirão|strong="G4483"\w* \w a vocês|strong="G4771"\w*: ‘\w Olhem|strong="G2400"\w* \w ali|strong="G1563"\w*’, ‘\w Olhem|strong="G2400"\w* \w aqui|strong="G5602"\w*’; \w não vão|strong="G3361,G565"\w*, \w nem|strong="G3366"\w* \w sigam|strong="G1377"\w*.\x - \xo 17:23 \xt LUK 17:21; MAT 24:23; MRK 13:21; LUK 21:8; LUK 17:20\x*
\v 24 \w Pois|strong="G1063"\w*, \w assim como|strong="G5618"\w* \w o relâmpago|strong="G3588,G796"\w*, \w relampejando|strong="G797"\w*, \w de uma parte|strong="G1537,G3588"\w* \w debaixo do céu|strong="G5259,G3588,G3772"\w* \w até a outra|strong="G1519,G3588"\w* \w debaixo do céu|strong="G5259,G3772"\w* \w brilha|strong="G2989"\w*, \w assim|strong="G3779"\w* \w será|strong="G1510"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w* \w no seu dia|strong="G1722,G3588,G2250,G846"\w*.\x - \xo 17:24 \xt MAT 24:27; MAT 24:23; LUK 17:26; REV 18:1; LUK 17:20; MAL 4:1-2\x*
\v 25 \w Antes|strong="G4413"\w* \w é preciso|strong="G1163"\w* \w que ele|strong="G846"\w* \w sofra|strong="G3958"\w* \w muito|strong="G4183"\w* \w e|strong="G2532"\w* \w seja rejeitado|strong="G593"\w* \w por esta geração|strong="G575,G3588,G1074,G3778"\w*.\x - \xo 17:25 \xt LUK 9:22; MRK 8:31; MAT 24:27; MAT 16:21; JHN 12:48; JHN 1:11\x*
\v 26 \w E|strong="G2532"\w*, \w como|strong="G2531"\w* \w foi|strong="G1096"\w* \w nos dias|strong="G1722,G3588,G2250"\w* \w de Noé|strong="G3575"\w*, \w assim|strong="G3779"\w* \w será|strong="G1510"\w* \w também|strong="G2532"\w* \w nos dias|strong="G1722,G3588,G2250"\w* \w do Filho do Homem|strong="G3588,G5207,G444"\w*:\x - \xo 17:26 \xt MAT 24:37; 1TH 5:3; MAT 24:38; HEB 11:7; LUK 18:8; MAT 24:27\x*
\v 27 \w comiam|strong="G2068"\w*, \w bebiam|strong="G4095"\w*, \w casavam-se|strong="G1060"\w*, \w eram dados em casamento|strong="G1061"\w*, \w até o dia em que|strong="G891,G3739,G2250"\w* \w entrou|strong="G1525"\w* \w Noé|strong="G3575"\w* \w na arca|strong="G1519,G3588,G2787"\w*, \w e|strong="G2532"\w* \w veio|strong="G2064"\w* \w o dilúvio|strong="G3588,G2627"\w* \w e|strong="G2532"\w* \w destruiu|strong="G622"\w* \w todos|strong="G3956"\w*.\x - \xo 17:27 \xt MAT 24:38; LUK 20:34; 1TH 5:3; MAT 24:37; LUK 18:8; MAT 24:27\x*
\v 28 \w Do mesmo modo|strong="G3668"\w*, \w como|strong="G2531"\w* \w foi|strong="G1096"\w* \w nos dias|strong="G1722,G3588,G2250"\w* \w de Ló|strong="G3091"\w*: \w comiam|strong="G2068"\w*, \w bebiam|strong="G4095"\w*, \w compravam|strong="G59"\w*, \w vendiam|strong="G4453"\w*, \w plantavam|strong="G5452"\w*, \w construíam|strong="G3618"\w*;\x - \xo 17:28 \xt 1TH 5:3; 2PE 2:6; MAT 24:38; LUK 18:8; MAT 24:27; 1PE 3:20\x*
\v 29 \w mas no dia em que|strong="G3739,G1161,G2250"\w* \w Ló|strong="G3091"\w* \w saiu|strong="G1831"\w* \w de Sodoma|strong="G575,G4670"\w*, \w choveu|strong="G1026"\w* \w fogo|strong="G4442"\w* \w e|strong="G2532"\w* \w enxofre|strong="G2303"\w* \w do céu|strong="G575,G3772"\w* \w e|strong="G2532"\w* \w destruiu|strong="G622"\w* \w todos|strong="G3956"\w*.\x - \xo 17:29 \xt 1TH 5:3; 2PE 2:6; LUK 18:8; MAT 24:27; JUD 1:7; PSA 11:6\x*
\v 30 \w Da mesma forma|strong="G2596,G3588,G846"\w* \w será|strong="G1510"\w* \w no dia em que|strong="G3739,G2250"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w* \w for revelado|strong="G601"\w*.\x - \xo 17:30 \xt 1TH 5:3; 1PE 1:13; 2PE 2:6; LUK 18:8; MAT 24:27; 2TH 1:7\x*
\v 31 \w Naquele dia|strong="G1722,G1565,G3588,G2250"\w*, \w quem|strong="G3739"\w* \w estiver|strong="G1510"\w* \w no terraço|strong="G1909,G3588,G1430"\w* \w e|strong="G2532"\w* \w tiver os seus objetos|strong="G3588,G4632,G846"\w* \w na casa|strong="G1722,G3588,G3614"\w*, \w que não desça|strong="G3361,G2597"\w* \w para pegá-los|strong="G142,G846"\w*; \w e|strong="G2532"\w* \w quem|strong="G3588"\w* \w estiver no campo|strong="G1722,G68"\w*, \w igualmente|strong="G3668"\w*, \w que não volte|strong="G3361,G1994"\w* \w para trás|strong="G1519,G3588,G3694"\w*.\x - \xo 17:31 \xt MAT 24:17; MRK 13:15; MRK 13:16; MAT 24:18; LUK 9:62; GEN 19:17\x*
\v 32 \w Lembrem-se|strong="G3421"\w* \w da mulher|strong="G3588,G1135"\w* \w de Ló|strong="G3091"\w*.\x - \xo 17:32 \xt LUK 9:62; GEN 19:26; HEB 10:38-39; GEN 19:17; MAT 24:27; MAT 24:17\x*
\v 33 \w Quem|strong="G3739,G1437"\w* \w procurar|strong="G2212"\w* \w preservar|strong="G4046"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w a perderá|strong="G622,G846"\w*; \w mas quem|strong="G3739,G1161,G302"\w* \w perder a sua vida|strong="G622"\w* \w a manterá viva|strong="G2225,G846"\w*.\f + \fr 17.33: \ft Lit.: ψυχή, “alma, vida”: aqui “a própria vida”; ζῳογονέω, “dar vida, preservar viva”.\f*\f + \fr 17.33: \ft Variante: O RP lê σῶσαι (“salvar”) em lugar de περιποιήσασθαι (“preservar”), καὶ ὃς ἐάν em lugar de ὃς δʼ ἄν e acrescenta αὐτήν depois de ἀπολέσῃ; WH lê ἀπολέσει (futuro) em lugar de ἀπολέσῃ.\f*\x - \xo 17:33 \xt MAT 10:39; LUK 9:24; MAT 16:25; MRK 8:35; JHN 12:25; MAT 24:27\x*
\v 34 \w Digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w nesta noite|strong="G3778,G3588,G3571"\w* \w estarão|strong="G1510"\w* \w dois|strong="G1417"\w* \w numa só cama|strong="G1909,G2825,G1520"\w*; \w um|strong="G3588,G1520"\w* \w será levado|strong="G3880"\w* \w e|strong="G2532"\w* \w o outro|strong="G3588,G2087"\w* \w será deixado|strong="G863"\w*;\x - \xo 17:34 \xt MAT 24:40; LUK 17:36; 2PE 2:9; MAT 24:27; MAL 3:16-18; 1TH 4:16-17\x*
\v 35 \w estarão|strong="G1510"\w* \w duas|strong="G1417"\w* \w moendo|strong="G229"\w* \w juntas|strong="G1909,G3588,G846"\w*; \w uma|strong="G3588,G1520"\w* \w será levada|strong="G3880"\w*, \w mas a outra|strong="G3588,G1161,G2087"\w* \w será deixada|strong="G863"\w*.”\f + \fr 17.35: \ft Variante: O RP lê Δύο ἔσονται (ordem inversa), omite o artigo ἡ antes de “uma” e traz καὶ ἡ em lugar de ἡ δέ; o TR acrescenta, como v. 36, “Dois estarão no campo: um será levado e o outro deixado” (δύο ἐν ἀγρῷ· εἷς παραλημφθήσεται καὶ ὁ ἕτερος ἀφεθήσεται).\f*\x - \xo 17:35 \xt MAT 24:41; MAT 24:40; MAT 24:27; EXO 11:5; ISA 47:2; LUK 23:39\x*
\v 37 \w E|strong="G2532"\w*, \w respondendo|strong="G611"\w*, \w lhe perguntaram|strong="G3004,G846"\w*: “\w Onde|strong="G4226"\w*, \w Senhor|strong="G2962"\w*?” \w Ele|strong="G3588,G1161"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Onde|strong="G3699"\w* \w estiver o cadáver|strong="G3588,G4983"\w*, \w ali|strong="G1563"\w* \w também|strong="G2532"\w* \w se reunirão|strong="G1996"\w* \w as águias|strong="G3588,G105"\w*.”\f + \fr 17.37: \ft Lit.: σῶμα, “corpo”: aqui, o cadáver; ἀετός, “águia” (também “abutre”).\f*\x - \xo 17:37 \xt MAT 24:28; MAT 24:40; MAT 24:27; JOB 39:29-30; JOB 39:30; ZEC 13:8-9\x*
\c 18
\p
\v 1 \w Dizia-lhes|strong="G3004,G846"\w* \w uma parábola|strong="G3850"\w* \w para mostrar|strong="G4314"\w* \w que é preciso|strong="G3588,G1163"\w* \w que eles|strong="G846"\w* \w orem|strong="G4336"\w* \w sempre|strong="G3842"\w* \w e|strong="G2532"\w* \w não desanimem|strong="G3361,G1573"\w*,\x - \xo 18:1 \xt 1TH 5:17; COL 4:2; ISA 40:31; PHP 4:6; GAL 6:9; ROM 12:12\x*
\v 2 \w dizendo|strong="G3004"\w*: “\w Havia|strong="G1510"\w* \w numa certa|strong="G1722,G5100"\w* \w cidade|strong="G4172"\w* \w um certo|strong="G5100"\w* \w juiz|strong="G2923"\w* \w que não temia|strong="G3361,G5399"\w* \w a Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w não respeitava|strong="G3361,G1788"\w* \w pessoa alguma|strong="G444"\w*.\x - \xo 18:2 \xt LUK 18:4; MRK 11:24; EPH 6:18; JAS 5:16; LUK 11:5; PSA 68:5\x*
\v 3 \w Havia|strong="G1510"\w* \w uma viúva|strong="G5503"\w* \w naquela cidade|strong="G1722,G3588,G4172,G1565"\w*, \w e|strong="G2532"\w* \w ela vinha|strong="G2064"\w* \w a ele|strong="G4314,G846"\w*, \w dizendo|strong="G3004"\w*: ‘\w Faça-me justiça|strong="G1556,G3165"\w* \w contra o meu adversário|strong="G575,G3588,G476,G3165"\w*.’\x - \xo 18:3 \xt MRK 11:24; EPH 6:18; JAS 5:16; LUK 11:5; PSA 68:5; ISA 62:7\x*
\v 4 \w E|strong="G2532"\w* \w não quis|strong="G3756,G2309"\w* \w por algum tempo|strong="G1909,G5550"\w*; \w depois disso|strong="G3326,G3778"\w*, \w porém|strong="G1161"\w*, \w disse|strong="G2036"\w* \w consigo mesmo|strong="G1722,G1438"\w*: ‘\w Embora|strong="G1487,G2532"\w* \w eu não tema|strong="G3756,G5399"\w* \w a Deus|strong="G3588,G2316"\w* \w nem|strong="G3761"\w* \w respeite|strong="G1788"\w* \w pessoa alguma|strong="G444"\w*,\x - \xo 18:4 \xt LUK 18:2; MRK 11:24; EPH 6:18; JAS 5:16; LUK 11:5; PSA 68:5\x*
\v 5 \w ao menos por|strong="G1223,G1065,G3588"\w* \w me dar trabalho|strong="G3930,G3165,G2873"\w* \w esta viúva|strong="G3588,G5503,G3778"\w*, \w lhe farei justiça|strong="G1556,G846"\w*, \w para que não|strong="G2443,G3361"\w*, \w vindo|strong="G2064"\w* \w até o fim|strong="G1519,G5056"\w*, \w me esgote|strong="G5299,G3165"\w*.’”\f + \fr 18.5: \ft Lit.: ὑπωπιάζω, literalmente “dar um soco no olho”: “esbofetear” ou, em sentido figurado, “esgotar, desgastar”.\f*\x - \xo 18:5 \xt MRK 11:24; EPH 6:18; JAS 5:16; LUK 11:5; LUK 11:8; PSA 68:5\x*
\v 6 \w Disse|strong="G2036"\w* \w o Senhor|strong="G3588,G2962"\w*: “\w Ouçam|strong="G191"\w* \w o que|strong="G5101"\w* \w diz|strong="G3004"\w* \w o juiz|strong="G3588,G2923"\w* \w injusto|strong="G3588,G93"\w*.\f + \fr 18.6: \ft Lit.: ὁ κριτὴς τῆς ἀδικίας, literalmente “o juiz da injustiça”: o juiz injusto.\f*\x - \xo 18:6 \xt MRK 11:24; EPH 6:18; JAS 5:16; LUK 11:5; PSA 68:5; ISA 62:7\x*
\v 7 \w E Deus|strong="G3588,G1161,G2316"\w* \w não|strong="G3756,G3361"\w* \w fará|strong="G4160"\w* \w justiça|strong="G3588,G1557"\w* \w aos seus escolhidos|strong="G3588,G1588,G846"\w*, \w que clamam|strong="G3588,G994"\w* \w a ele|strong="G846"\w* \w dia|strong="G2250"\w* \w e|strong="G2532"\w* \w noite|strong="G3571"\w*, \w e|strong="G2532"\w* \w demora para agir|strong="G3114"\w* \w com eles|strong="G1909,G846"\w*?\f + \fr 18.7: \ft Lit.: οὐ μὴ ποιήσῃ...: pergunta retórica; a dupla negação οὐ μή reforça a expectativa de resposta positiva (“certamente fará justiça”).\f*\f + \fr 18.7: \ft Lit.: μακροθυμέω, “ter paciência, ser longânime”, também “demorar”; ἐκδίκησις, “vindicação, justiça (restabelecimento do direito)”.\f*\x - \xo 18:7 \xt MRK 11:24; PHP 4:6; 2PE 3:9; EPH 6:18; HAB 2:3; ISA 60:22\x*
\v 8 \w Digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w fará justiça|strong="G4160,G3588,G1557"\w* \w a eles|strong="G846"\w* \w em breve|strong="G1722,G5034"\w*. \w Contudo|strong="G4133"\w*, \w o Filho do Homem|strong="G3588,G5207,G444"\w*, \w quando vier|strong="G2064"\w*, \w acaso|strong="G687"\w* \w encontrará|strong="G2147"\w* \w a fé|strong="G3588,G4102"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*?”\x - \xo 18:8 \xt MRK 11:24; 2PE 3:9; EPH 6:18; HAB 2:3; JAS 5:16; HEB 10:23-26\x*
\p
\v 9 \w Disse|strong="G2036"\w* \w também|strong="G2532"\w* \w esta parábola|strong="G3588,G3850,G3778"\w* \w a alguns|strong="G4314,G5100"\w* \w que confiavam|strong="G3588,G3982"\w* \w em si mesmos|strong="G1909,G1438"\w* \w de que|strong="G3754"\w* \w eram|strong="G1510"\w* \w justos|strong="G1342"\w* \w e|strong="G2532"\w* \w desprezavam|strong="G1848"\w* \w os demais|strong="G3588,G3062"\w*:\x - \xo 18:9 \xt LUK 16:15; LUK 15:7; PRO 30:12; ISA 65:5; ROM 10:3; PRO 16:2\x*
\v 10 “\w Dois|strong="G1417"\w* \w homens|strong="G444"\w* \w subiram|strong="G305"\w* \w ao templo|strong="G1519,G3588,G2411"\w* \w para orar|strong="G4336"\w*: \w um|strong="G3588,G1520"\w* \w fariseu|strong="G5330"\w* \w e|strong="G2532"\w* \w o outro|strong="G3588,G2087"\w* \w cobrador de impostos|strong="G5057"\w*.\x - \xo 18:10 \xt MAT 6:5; LUK 15:7; ISA 65:5; PRO 16:2; ROM 10:3; GAL 3:10\x*
\v 11 \w O fariseu|strong="G3588,G5330"\w*, \w em pé|strong="G2476"\w*, \w orava|strong="G4336"\w* \w estas coisas|strong="G3778"\w* \w consigo mesmo|strong="G4314,G1438"\w*: ‘\w Ó Deus|strong="G3588,G2316"\w*, \w agradeço-lhe|strong="G2168,G4771"\w* \w porque|strong="G3754"\w* \w não sou|strong="G3756,G1510"\w* \w como as demais|strong="G5618,G3588,G3062"\w* \w pessoas|strong="G3588,G444"\w*: \w extorsionários|strong="G727"\w*, \w injustos|strong="G94"\w*, \w adúlteros|strong="G3432"\w*, \w ou também|strong="G2228,G2532"\w* \w como este|strong="G5613,G3778"\w* \w cobrador de impostos|strong="G3588,G5057"\w*;\f + \fr 18.11: \ft Lit.: πρὸς ἑαυτόν pode ligar-se a σταθείς (“em pé, à parte”) ou a προσηύχετο (“orava consigo mesmo”).\f*\x - \xo 18:11 \xt MAT 6:5; LUK 15:7; PRO 21:2; PRO 30:12; 2CO 10:12; MAT 7:3\x*
\v 12 \w jejuo|strong="G3522"\w* \w duas vezes|strong="G1364"\w* \w por semana|strong="G3588,G4521"\w*, \w dou o dízimo|strong="G586"\w* \w de tudo o que|strong="G3956,G3745"\w* \w adquiro|strong="G2932"\w*.’\f + \fr 18.12: \ft Lit.: τοῦ σαββάτου, “do sábado”: “por semana”.\f*\x - \xo 18:12 \xt PRO 21:2; LUK 11:42; MAT 6:16; PRO 13:7; ISA 65:5; ROM 10:3\x*
\v 13 \w O cobrador de impostos|strong="G3588,G5057"\w* \w em pé|strong="G2476"\w* \w de longe|strong="G3113"\w*, \w não queria|strong="G3756,G2309"\w* \w nem sequer|strong="G3761"\w* \w levantar|strong="G1869"\w* \w os olhos|strong="G3588,G3788"\w* \w para o céu|strong="G1519,G3588,G3772"\w*, \w mas|strong="G235"\w* \w batia|strong="G5180"\w* \w no peito|strong="G3588,G4738"\w* \w dele|strong="G846"\w*, \w dizendo|strong="G3004"\w*: ‘\w Ó Deus|strong="G3588,G2316"\w*, \w seja propício|strong="G2433"\w* \w a mim|strong="G3165"\w*, \w o pecador|strong="G3588,G268"\w*.’\f + \fr 18.13: \ft Lit.: ἱλάσκομαι, “ser propício, aplacar, fazer expiação”; τῷ ἁμαρτωλῷ, “o pecador” (com artigo).\f*\x - \xo 18:13 \xt LUK 23:48; MIC 6:8; MAT 6:5; ISA 66:2; 2CO 7:10; 1JN 1:8-10\x*
\v 14 \w Digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w este|strong="G3778"\w* \w desceu|strong="G2597"\w* \w para a sua casa|strong="G1519,G3588,G3624,G846"\w* \w declarado justo|strong="G1344"\w* \w em vez daquele|strong="G3844,G1565"\w*; \w porque|strong="G3754"\w* \w todo aquele|strong="G3956,G3588"\w* \w que se exalta|strong="G5312,G1438"\w* \w será humilhado|strong="G5013"\w*, \w e|strong="G1161"\w* \w o que se humilha|strong="G3588,G5013,G1438"\w* \w será exaltado|strong="G5312"\w*\f + \fr 18.14: \ft Lit.: δεδικαιωμένος, “declarado justo”; παρʼ ἐκεῖνον, “em lugar daquele” ou “mais do que aquele”.\f*.”\x - \xo 18:14 \xt LUK 14:11; 1PE 5:6; MAT 23:12; JAS 4:10; MAT 5:3; PRO 29:23\x*
\p
\v 15 \w Traziam-lhe|strong="G4374,G846"\w* \w também|strong="G2532"\w* \w os bebês|strong="G3588,G1025"\w* \w para que os tocasse|strong="G2443,G846,G681"\w*; \w vendo isso|strong="G1492"\w* \w os discípulos|strong="G3588,G3101"\w* \w os repreendiam|strong="G2008,G846"\w*.\x - \xo 18:15 \xt MRK 10:13; MAT 19:13; MIC 6:8; MRK 10:14; ROM 12:12; 1SA 1:24\x*
\v 16 \w Jesus|strong="G3588,G2424"\w* \w os chamou|strong="G4341,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Deixem|strong="G863"\w* \w as crianças|strong="G3588,G3813"\w* \w virem|strong="G2064"\w* \w a mim|strong="G4314,G3165"\w* \w e|strong="G2532"\w* \w não as impeçam|strong="G3361,G2967,G846"\w*; \w pois|strong="G1063"\w* \w de tais como elas|strong="G3588,G5108"\w* \w é|strong="G1510"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 18:16 \xt MAT 19:14; MRK 10:14; MAT 18:3; MIC 6:8; ECC 12:1; MRK 10:13\x*
\v 17 \w Em verdade|strong="G281"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w quem|strong="G3739,G302"\w* \w não receber|strong="G3361,G1209"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w como uma criança|strong="G5613,G3813"\w*, \w de modo nenhum|strong="G3756,G3361"\w* \w entrará|strong="G1525"\w* \w nele|strong="G1519,G846"\w*.”\x - \xo 18:17 \xt MRK 10:15; MAT 18:3; MAT 19:14; MRK 9:37; MAT 18:5; LUK 9:48\x*
\p
\v 18 \w E|strong="G2532"\w* \w um certo|strong="G5100"\w* \w chefe|strong="G758"\w* \w lhe perguntou|strong="G1905,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Bom|strong="G18"\w* \w Mestre|strong="G1320"\w*, \w o que|strong="G5101"\w* \w devo fazer|strong="G4160"\w* \w para herdar|strong="G2816"\w* \w a vida eterna|strong="G2222,G166"\w*?”\x - \xo 18:18 \xt MRK 10:17; MAT 19:16; LUK 10:25; ACT 16:30; ROM 12:12; ACT 2:37\x*
\v 19 \w Disse-lhe|strong="G2036,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Por que|strong="G5101"\w* \w me chama|strong="G3165,G3004"\w* \w bom|strong="G18"\w*? \w Ninguém|strong="G3762"\w* \w é bom|strong="G18"\w*, \w a não ser|strong="G1487,G3361"\w* \w um só|strong="G1520"\w*, \w Deus|strong="G3588,G2316"\w*.\f + \fr 18.19: \ft Acréscimo: verbo ser/estar suprido em “é bom”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 18:19 \xt MRK 10:18; MRK 10:17; MAT 19:16; ROM 12:12; JAS 1:17; JOB 15:14-16\x*
\v 20 \w Você conhece|strong="G6063"\w* \w os mandamentos|strong="G3588,G1785"\w*: ‘\w Não cometa adultério|strong="G3361,G3431"\w*, \w não mate|strong="G3361,G5407"\w*, \w não roube|strong="G3361,G2813"\w*, \w não dê falso testemunho|strong="G3361,G5576"\w*, \w honre|strong="G5091"\w* \w o seu pai|strong="G3588,G3962,G4771"\w* \w e|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w*.’”\f + \fr 18.20: \ft Nota cultural: cita os mandamentos do Decálogo (Êx 20:12-16; Dt 5:16-20).\f*\x - \xo 18:20 \xt EXO 20:12; DEU 5:16; MRK 10:19; MAT 19:18; ROM 13:9; JAS 2:11\x*
\v 21 \w Ele|strong="G3588"\w* \w disse|strong="G2036"\w*: “\w Tudo isso|strong="G3778,G3956"\w* \w guardei|strong="G5442"\w* \w desde a minha juventude|strong="G1537,G3503,G3165"\w*.”\x - \xo 18:21 \xt MRK 10:20; MRK 10:17; MAT 19:16; ROM 12:12; LUK 16:15; PHP 3:6\x*
\v 22 \w Ouvindo isso|strong="G191"\w* \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Ainda|strong="G2089"\w* \w uma coisa|strong="G1520"\w* \w lhe falta|strong="G4771,G3007"\w*: \w venda|strong="G4453"\w* \w tudo o que|strong="G3956,G3745"\w* \w você tem|strong="G2192"\w* \w e|strong="G2532"\w* \w distribua|strong="G1239"\w* \w aos pobres|strong="G4434"\w*, \w e|strong="G2532"\w* \w terá|strong="G2192"\w* \w um tesouro|strong="G2344"\w* \w nos céus|strong="G1722,G3772"\w*; \w e|strong="G2532"\w* \w venha|strong="G1204"\w*, \w siga-me|strong="G190,G3165"\w*.”\x - \xo 18:22 \xt MAT 19:21; MRK 10:21; MAT 6:19; HEB 12:1; MRK 10:17; MAT 6:20\x*
\v 23 \w Ele|strong="G3588"\w*, \w ouvindo|strong="G191"\w* \w isso|strong="G3778"\w*, \w ficou muito triste|strong="G4036,G1096"\w*, \w pois|strong="G1063"\w* \w era|strong="G1510"\w* \w rico|strong="G4145"\w* \w em extremo|strong="G4970"\w*.\x - \xo 18:23 \xt HEB 12:1; MRK 10:17; MAT 13:44; LUK 14:33; LUK 19:8; MAT 19:16\x*
\v 24 \w Vendo-o|strong="G1492,G846"\w* \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Com que dificuldade|strong="G4459,G1423"\w* \w os que têm|strong="G3588,G2192"\w* \w riquezas|strong="G3588,G5536"\w* \w entram|strong="G1531"\w* \w no reino|strong="G1519,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*!\x - \xo 18:24 \xt MRK 10:23; MAT 19:23; HEB 12:1; MAT 6:19; MRK 10:17; MAT 13:44\x*
\v 25 \w Pois|strong="G1063"\w* \w é mais fácil|strong="G2123,G1510"\w* \w um camelo|strong="G2574"\w* \w entrar|strong="G1525"\w* \w pelo buraco|strong="G1223,G6085"\w* \w de uma agulha|strong="G6011"\w* \w do que|strong="G2228"\w* \w um rico|strong="G4145"\w* \w entrar|strong="G1525"\w* \w no reino|strong="G1519,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.”\x - \xo 18:25 \xt MAT 19:24; MRK 10:25; MAT 7:21; HEB 12:1; MRK 10:17; MAT 19:16\x*
\v 26 \w Disseram|strong="G2036"\w* \w os que ouviram|strong="G3588,G191"\w*: “\w E|strong="G2532"\w* \w quem|strong="G5101"\w* \w pode|strong="G1410"\w* \w ser salvo|strong="G4982"\w*?”\x - \xo 18:26 \xt MRK 10:26; JAS 2:14; MRK 10:17; MAT 19:16; ROM 12:12; LUK 19:2\x*
\v 27 \w Ele|strong="G3588"\w* \w disse|strong="G2036"\w*: “\w O que é impossível|strong="G3588,G102"\w* \w para as pessoas|strong="G3844,G444"\w* \w é possível|strong="G1415,G1510"\w* \w para Deus|strong="G3844,G3588,G2316"\w*.”\f + \fr 18.27: \ft Acréscimo: verbo ser/estar suprido em “O que é impossível”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 18:27 \xt MAT 19:26; MRK 10:27; LUK 1:37; ROM 15:1; MAT 17:20; JER 32:17\x*
\p
\v 28 \w Disse|strong="G2036"\w* \w Pedro|strong="G3588,G4074"\w*: “\w Olhe|strong="G2400"\w*, \w nós|strong="G3165"\w*, \w tendo deixado|strong="G863"\w* \w o que era nosso|strong="G3588,G2398"\w*, \w seguimos você|strong="G190,G4771"\w*.”\f + \fr 18.28: \ft Acréscimo: verbo ser/estar suprido em “o que era nosso”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 18:28 \xt MRK 10:28; MAT 19:27; MAT 4:20; MRK 1:18; LUK 5:11; MRK 10:17\x*
\v 29 \w Ele|strong="G3588"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Em verdade|strong="G281"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w não há|strong="G1510"\w* \w ninguém|strong="G3762"\w* \w que tenha deixado|strong="G3739,G863"\w* \w casa|strong="G3614"\w* \w ou|strong="G2228"\w* \w mulher|strong="G1135"\w* \w ou|strong="G2228"\w* \w irmãos|strong="G80"\w* \w ou|strong="G2228"\w* \w pais|strong="G1118"\w* \w ou|strong="G2228"\w* \w filhos|strong="G5043"\w* \w por causa|strong="G1752"\w* \w do reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*,\x - \xo 18:29 \xt MAT 19:29; MRK 10:29; MAT 6:33; MRK 10:17; LUK 14:33; MAT 10:37-39\x*
\v 30 \w que de modo nenhum|strong="G3739,G3780,G3361"\w* \w deixe de receber|strong="G618"\w* \w muitas vezes mais|strong="G4179"\w* \w neste tempo|strong="G1722,G3588,G2540,G3778"\w* \w e|strong="G2532"\w* \w na era|strong="G1722,G3588,G165"\w* \w que vem|strong="G3588,G2064"\w*, \w a vida eterna|strong="G2222,G166"\w*.”\x - \xo 18:30 \xt MAT 19:29; MAT 6:33; MRK 10:30; 1JN 2:25; MRK 10:17; LUK 14:33\x*
\p
\v 31 \w Levando consigo|strong="G3880"\w* \w os doze|strong="G3588,G1427"\w*, \w disse-lhes|strong="G2036,G4314,G846"\w*: “\w Olhem|strong="G2400"\w*, \w subimos|strong="G305"\w* \w a Jerusalém|strong="G1519,G2419"\w*, \w e|strong="G2532"\w* \w se cumprirá|strong="G5055"\w* \w tudo o que|strong="G3956,G3588"\w* \w foi escrito|strong="G1125"\w* \w pelos profetas|strong="G1223,G3588,G4396"\w* \w a respeito do Filho do Homem|strong="G3588,G5207,G444"\w*.\x - \xo 18:31 \xt MAT 20:17; JHN 6:45; JHN 19:28; ISA 53:1-12; JHN 3:14; MAT 17:22\x*
\v 32 \w Pois|strong="G1063"\w* \w será entregue|strong="G3860"\w* \w aos gentios|strong="G3588,G1484"\w*, \w e|strong="G2532"\w* \w será escarnecido|strong="G1702"\w* \w e|strong="G2532"\w* \w ultrajado|strong="G5195"\w* \w e|strong="G2532"\w* \w cuspido|strong="G1716"\w*,\x - \xo 18:32 \xt JHN 3:14; MAT 17:22; ISA 53:3; LUK 9:22; ROM 12:12; LUK 23:11\x*
\v 33 \w e|strong="G2532"\w*, \w depois de açoitá-lo|strong="G3146"\w*, \w o matarão|strong="G615,G846"\w*, \w e|strong="G2532"\w* \w no terceiro dia|strong="G3588,G2250,G5154"\w* \w se levantará|strong="G450"\w*.”\x - \xo 18:33 \xt MRK 10:34; LUK 24:7; LUK 9:22; MAT 20:19; JHN 3:14; MAT 17:22\x*
\v 34 \w E|strong="G2532"\w* \w eles|strong="G846"\w* \w nada|strong="G3762"\w* \w disto|strong="G3778"\w* \w entenderam|strong="G4920"\w*, \w e|strong="G2532"\w* \w esta palavra|strong="G3588,G4487,G3778"\w* \w estava encoberta|strong="G1510,G2928"\w* \w para eles|strong="G575,G846"\w*, \w e|strong="G2532"\w* \w não compreendiam|strong="G3756,G1097"\w* \w o que era dito|strong="G3588,G3004"\w*.\x - \xo 18:34 \xt LUK 2:50; MAT 17:22; LUK 9:22; MAT 26:32; ROM 12:12; LUK 9:45\x*
\p
\v 35 \w Aconteceu|strong="G1096,G1161"\w* \add que,\add* \w quando ele se aproximava|strong="G1722,G3588,G1448,G846"\w* \w de Jericó|strong="G1519,G2410"\w*, \w um certo|strong="G5100"\w* \w cego|strong="G5185"\w* \w estava sentado|strong="G2521"\w* \w à beira do caminho|strong="G3844,G3588,G3598"\w*, \w mendigando|strong="G1871"\w*.\f + \fr 18.35: \ft Acréscimo: “que” (em “Aconteceu que quando ele”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 18:35 \xt MRK 10:46; MAT 20:29; ROM 12:12; LUK 19:1; ACT 3:2; JHN 9:8\x*
\v 36 \w Ouvindo|strong="G191"\w* \w uma multidão|strong="G3793"\w* \w passar|strong="G1279"\w*, \w perguntou|strong="G4441"\w* \w o que|strong="G5101"\w* \w seria|strong="G1510"\w* \w isso|strong="G3778"\w*.\x - \xo 18:36 \xt MAT 20:29; ROM 12:12; MRK 10:47; ACT 2:12\x*
\v 37 \w Avisaram-no|strong="G518,G846"\w*: “\w Jesus|strong="G2424"\w*, \w o nazareno|strong="G3588,G3480"\w*, \w está passando|strong="G3928"\w*.”\x - \xo 18:37 \xt MAT 20:29; ROM 12:12; MRK 10:47; MAT 2:23; JHN 1:45; JHN 19:19\x*
