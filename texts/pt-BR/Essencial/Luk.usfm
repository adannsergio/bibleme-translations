\v 18 \w E|strong="G2532"\w* \w veio|strong="G2064"\w* \w o segundo|strong="G3588,G1208"\w*, \w dizendo|strong="G3004"\w*: ‘\w A sua mina|strong="G3588,G3414,G4771"\w*, \w Senhor|strong="G2962"\w*, \w produziu|strong="G4160"\w* \w cinco|strong="G4002"\w* \w minas|strong="G3414"\w*.’\x - \xo 19:18 \xt MAT 25:14; 2CO 9:6; MAT 23:37; LUK 12:44; LUK 12:42; LUK 16:12\x*
\v 19 \w Disse|strong="G2036"\w* \w também|strong="G2532"\w* \w a este|strong="G3778"\w*: ‘\w Também|strong="G2532"\w* \w você|strong="G4771"\w* \w fique acima de|strong="G1883,G1096"\w* \w cinco|strong="G4002"\w* \w cidades|strong="G4172"\w*.’\x - \xo 19:19 \xt MAT 25:14; 2CO 9:6; MAT 23:37; LUK 12:44; LUK 12:42; LUK 16:12\x*
\v 20 \w E|strong="G2532"\w* \w o outro|strong="G3588,G2087"\w* \w veio|strong="G2064"\w*, \w dizendo|strong="G3004"\w*: ‘\w Senhor|strong="G2962"\w*, \w olhe|strong="G2400"\w*, \w a sua mina|strong="G3588,G3414,G4771"\w*, \w que|strong="G3739"\w* \w eu tinha|strong="G2192"\w* \w guardada|strong="G606"\w* \w num lenço|strong="G1722,G4676"\w*;\x - \xo 19:20 \xt MAT 25:14; 2CO 9:6; MAT 23:37; MAT 25:24; LUK 16:1; LUK 16:12\x*
\v 21 \w pois|strong="G1063"\w* \w tinha medo|strong="G5399"\w* \w de você|strong="G4771"\w*, \w porque|strong="G3754"\w* \w é um homem|strong="G444,G1510"\w* \w severo|strong="G840"\w*: \w pega|strong="G142"\w* \w o que|strong="G3739"\w* \w não depositou|strong="G3756,G5087"\w* \w e|strong="G2532"\w* \w colhe|strong="G2325"\w* \w o que|strong="G3739"\w* \w não semeou|strong="G3756,G4687"\w*.’\x - \xo 19:21 \xt 2CO 9:6; MAT 25:14; MAT 23:37; MAT 25:24; LUK 16:12; LUK 19:12\x*
\v 22 \w Disse-lhe|strong="G3004,G846"\w*: ‘\w Pela sua boca|strong="G1537,G3588,G4750,G4771"\w* \w julgo|strong="G2919"\w* \w você|strong="G4771"\w*, \w mau|strong="G4190"\w* \w escravo|strong="G1401"\w*. \w Você sabia|strong="G1492"\w* \w que|strong="G3754"\w* \w eu|strong="G1473"\w* \w sou um homem|strong="G444,G1510"\w* \w severo|strong="G840"\w*, \w que pega|strong="G142"\w* \w o que|strong="G3739"\w* \w não depositei|strong="G3756,G5087"\w* \w e|strong="G2532"\w* \w colhe|strong="G2325"\w* \w o que|strong="G3739"\w* \w não semeei|strong="G3756,G4687"\w*?\x - \xo 19:22 \xt 2CO 9:6; MAT 25:14; JOB 15:6; MAT 23:37; MAT 25:24; ROM 2:1\x*
\v 23 \w E|strong="G2532"\w* \w por que|strong="G1223,G5101"\w* \w não entregou|strong="G3756,G1325"\w* \w o meu dinheiro|strong="G3165,G3588,G694"\w* \w ao banco|strong="G1909,G5132"\w*? \w E eu|strong="G2532_B,G1473"\w*, \w ao chegar|strong="G2064"\w*, \w com juros|strong="G4862,G5110"\w* \w o teria cobrado|strong="G302,G846,G4238"\w*.’\f + \fr 19.23: \ft Lit.: τράπεζα, “mesa” (de cambista), “banco”; τόκος, “juro”.\f*\x - \xo 19:23 \xt MAT 25:27; MAT 25:14; 2CO 9:6; MAT 23:37; LUK 16:12; LUK 19:12\x*
\v 24 \w E|strong="G2532"\w* \w aos que estavam presentes|strong="G3588,G3936"\w* \w disse|strong="G2036"\w*: ‘\w Tirem|strong="G142"\w* \w dele|strong="G575,G846"\w* \w a mina|strong="G3588,G3414"\w* \w e|strong="G2532"\w* \w deem|strong="G1325"\w* \w ao que tem|strong="G3588,G2192"\w* \w as dez|strong="G3588,G1176"\w* \w minas|strong="G3414"\w*.’—\x - \xo 19:24 \xt LUK 19:13; MAT 25:28; LUK 19:16; MAT 25:14; MAT 13:12; 2CO 9:6\x*
\v 25 —\w e|strong="G2532"\w* \w lhe disseram|strong="G2036,G846"\w*: ‘\w Senhor|strong="G2962"\w*, \w ele tem|strong="G2192"\w* \w dez|strong="G1176"\w* \w minas|strong="G3414"\w*!’—\x - \xo 19:25 \xt LUK 19:13; LUK 19:16; MAT 25:14; MAT 25:29; MAT 13:12; 2CO 9:6\x*
\v 26 ‘\w Digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w a todo aquele|strong="G3956,G3588"\w* \w que tem|strong="G2192"\w* \w será dado|strong="G1325"\w*; \w mas|strong="G1161"\w* \w daquele que não tem|strong="G575,G3588,G3361,G2192"\w*, \w até o que|strong="G2532,G3739"\w* \w tem|strong="G2192"\w* \w será tirado|strong="G142"\w*.\x - \xo 19:26 \xt MAT 25:14; LUK 8:18; MAT 25:29; MAT 13:12; 2CO 9:6; 2JN 1:8\x*
\v 27 \w Mas|strong="G4133"\w* \w estes meus inimigos|strong="G3588,G2190,G3165,G3778"\w*, \w os que não quiseram|strong="G3588,G3361,G2309"\w* \w que eu reinasse|strong="G3165,G936"\w* \w sobre eles|strong="G1909,G846"\w*, \w tragam-nos|strong="G71"\w* \w para cá|strong="G5602"\w* \w e|strong="G2532"\w* \w matem-nos|strong="G2695,G846"\w* \w diante de mim|strong="G1715,G3165"\w*.’”\f + \fr 19.27: \ft Lit.: κατασφάζω, “degolar, matar com violência”.\f*\x - \xo 19:27 \xt MAT 25:14; LUK 19:14; PSA 21:8; HEB 10:13; LUK 21:22; MAT 22:7\x*
\p
\v 28 \w E|strong="G2532"\w*, \w tendo dito|strong="G2036"\w* \w estas coisas|strong="G3778"\w*, \w seguia|strong="G4198"\w* \w à frente|strong="G1715"\w*, \w subindo|strong="G305"\w* \w a Jerusalém|strong="G1519,G2414"\w*.\x - \xo 19:28 \xt ACT 21:15; JHN 5:1; MAT 23:37; LUK 9:51; MAT 21:1; 1PE 4:1\x*
\v 29 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w quando|strong="G5613"\w* \w se aproximou|strong="G1448"\w* \w de Betfagé|strong="G1519,G967"\w* \w e|strong="G2532"\w* \w de Betânia|strong="G963"\w*, \w junto ao monte|strong="G4314,G3588,G3735"\w* \w chamado|strong="G3588,G2564"\w* \w das Oliveiras|strong="G1638"\w*, \w enviou|strong="G649"\w* \w dois|strong="G1417"\w* \w dos discípulos|strong="G3588,G3101"\w*\f + \fr 19.29: \ft Acréscimo: “que” (em “E aconteceu que quando se”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 19:29 \xt MRK 11:1; MAT 21:1; ACT 1:12; MAT 23:37; JHN 12:14; MAT 21:17\x*
\v 30 \w dizendo|strong="G3004"\w*: “\w Vão|strong="G5217"\w* \w ao povoado|strong="G1519,G3588,G2968"\w* \w que está em frente|strong="G2713"\w*, \w no qual|strong="G1722,G3739"\w*, \w ao entrar|strong="G1531"\w*, \w encontrarão|strong="G2147"\w* \w um jumentinho|strong="G4454"\w* \w amarrado|strong="G1210"\w*, \w no qual|strong="G1909,G3739"\w* \w nenhum|strong="G3762"\w* \w ser humano|strong="G444"\w* \w jamais|strong="G4455"\w* \w se sentou|strong="G2523"\w*; \w e|strong="G2532"\w*, \w desamarrando-o|strong="G3089,G846"\w*, \w tragam-no|strong="G71"\w*.\f + \fr 19.30: \ft Acréscimo: “que está em frente”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 19:30 \xt MRK 11:2; MAT 21:2; MAT 23:37; ZEC 9:9; JHN 12:14; MRK 11:1\x*
\v 31 \w E|strong="G2532"\w* \w se|strong="G1437"\w* \w alguém|strong="G5100"\w* \w lhes perguntar|strong="G4771,G2065"\w*: ‘\w Por que|strong="G1223,G5101"\w* \w o desamarram|strong="G3089"\w*?’, \w assim|strong="G3779"\w* \w dirão|strong="G4483"\w*: ‘\w O Senhor|strong="G3588,G2962"\w* \w precisa|strong="G5532,G2192"\w* \w dele|strong="G846"\w*.’”\x - \xo 19:31 \xt MAT 21:3; MRK 11:2; MAT 21:2; MAT 23:37; ZEC 9:9; JHN 12:14\x*
\v 32 \w Indo|strong="G565"\w* \w os enviados|strong="G3588,G649"\w*, \w encontraram|strong="G2147"\w* \w como|strong="G2531"\w* \w ele lhes disse|strong="G2036,G846"\w*.\x - \xo 19:32 \xt LUK 22:13; JHN 12:14; JHN 17:18; LUK 24:24; MRK 11:4; LUK 2:16\x*
\v 33 \w Enquanto desamarravam|strong="G3089,G846"\w* \w o jumentinho|strong="G3588,G4454"\w* \w os donos|strong="G3588,G2962"\w* \w dele|strong="G846"\w* \w lhes disseram|strong="G2036,G4314,G846"\w*: “\w Por que|strong="G5101"\w* \w desamarram|strong="G3089"\w* \w o jumentinho|strong="G3588,G4454"\w*?”\f + \fr 19.33: \ft Tradução: κύριοι (κύριος, G2962) está aqui como “os donos”; o termo pode ser “Senhor” (Deus ou Jesus), “senhor” (título de respeito), “dono” ou “patrão”, e o contexto decide.\f*\x - \xo 19:33 \xt MRK 11:4; MRK 11:5; MAT 23:37; ZEC 9:9; JHN 12:14; MRK 11:1\x*
\v 34 \w Eles|strong="G3588"\w* \w disseram|strong="G2036"\w*: “\w O Senhor|strong="G3588,G2962"\w* \w precisa|strong="G5532,G2192"\w* \w dele|strong="G846"\w*.”\x - \xo 19:34 \xt MAT 23:37; ZEC 9:9; JHN 12:14; MRK 11:1; MAT 21:1; MRK 11:4\x*
\v 35 \w E|strong="G2532"\w* \w o levaram|strong="G71,G846"\w* \w a Jesus|strong="G4314,G3588,G2424"\w*, \w e|strong="G2532"\w*, \w lançando|strong="G1977"\w* \w os seus mantos|strong="G846,G3588,G2440"\w* \w sobre o jumentinho|strong="G1909,G3588,G4454"\w*, \w fizeram montar|strong="G1913"\w* \w Jesus|strong="G3588,G2424"\w*.\x - \xo 19:35 \xt MAT 21:7; MRK 11:7; JHN 12:13; MAT 23:37; ZEC 9:9; JHN 12:14\x*
\v 36 \w Enquanto ele ia|strong="G4198,G846"\w* \w estendiam|strong="G5291"\w* \w os seus mantos|strong="G3588,G2440,G1438"\w* \w no caminho|strong="G1722,G3588,G3598"\w*.\f + \fr 19.36: \ft Variante: WH e Treg leem ἑαυτῶν; NA28 e RP leem αὐτῶν (“os mantos deles”).\f*\x - \xo 19:36 \xt MAT 21:8; JHN 12:13; MAT 23:37; MRK 11:1; MRK 11:7; MAT 21:1\x*
\v 37 \w Quando ele já se aproximava|strong="G1448,G846,G2235"\w* \w da descida|strong="G4314,G3588,G2600"\w* \w do Monte|strong="G3588,G3735"\w* \w das Oliveiras|strong="G3588,G1636"\w*, \w toda a multidão|strong="G537,G3588,G4128"\w* \w dos discípulos|strong="G3588,G3101"\w* \w começou|strong="G757"\w*, \w alegrando-se|strong="G5463"\w*, \w a louvar|strong="G134"\w* \w a Deus|strong="G3588,G2316"\w* \w em alta voz|strong="G5456,G3173"\w* \w por todos|strong="G4012,G3956"\w* \w os milagres|strong="G1411"\w* \w que tinham visto|strong="G3739,G1492"\w*,\f + \fr 19.37: \ft Tradução: δυνάμεων (δύναμις, G1411) está aqui como “os milagres”; o termo pode ser “poder”, “força”, “capacidade” ou “milagre”, e o contexto decide.\f*\x - \xo 19:37 \xt MAT 21:1; MRK 11:1; PSA 100:1; ZEC 9:9; JHN 12:13; MAT 21:9\x*
\v 38 \w dizendo|strong="G3004"\w*: “\w Bendito seja|strong="G2127"\w* \w o rei|strong="G935"\w* \w que vem|strong="G3588,G2064"\w* \w em nome|strong="G1722,G3686"\w* \w do Senhor|strong="G2962"\w*! \w No céu|strong="G1722,G3772"\w* \w paz|strong="G1515"\w* \w e|strong="G2532"\w* \w glória|strong="G1391"\w* \w nas alturas|strong="G1722,G5310"\w*!”\f + \fr 19.38: \ft Nota cultural: cita Sl 118:26 (com o acréscimo “o rei”); cf. Lc 2:14.\f*\x - \xo 19:38 \xt LUK 2:14; PSA 118:26; MAT 21:9; MRK 11:10; ZEC 9:9; JHN 16:33\x*
\v 39 \w E|strong="G2532"\w* \w alguns|strong="G5100"\w* \w dos fariseus|strong="G3588,G5330"\w* \w que estavam na multidão|strong="G575,G3588,G3793"\w* \w lhe disseram|strong="G2036,G4314,G846"\w*: “\w Mestre|strong="G1320"\w*, \w repreenda|strong="G2008"\w* \w os seus discípulos|strong="G3588,G3101,G4771"\w*.”\f + \fr 19.39: \ft Acréscimo: “que estavam na multidão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 19:39 \xt MAT 23:37; MRK 11:1; MAT 21:16; ACT 4:1-2; MRK 11:10; PSA 47:1\x*
\v 40 \w E|strong="G2532"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: “\w Digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w se|strong="G3754,G1437"\w* \w estes|strong="G3778"\w* \w se calarem|strong="G4623"\w*, \w as pedras|strong="G3588,G3037"\w* \w gritarão|strong="G2896"\w*.”\x - \xo 19:40 \xt MRK 10:48; MIC 6:1; HAB 2:11; ISA 55:12; MAT 3:9; PSA 96:11\x*
\p
\v 41 \w E|strong="G2532"\w* \w quando|strong="G5613"\w* \w se aproximou|strong="G1448"\w*, \w vendo|strong="G1492"\w* \w a cidade|strong="G3588,G4172"\w*, \w chorou|strong="G2799"\w* \w por ela|strong="G1909,G846"\w*,\f + \fr 19.41: \ft Tradução: κλαίω, “chorar” (em voz alta); a cena continua no v. 42, que fica incompleto (aposiopese).\f*\x - \xo 19:41 \xt JHN 11:35; 1CO 13:6; LUK 13:34; ISA 48:18; MAT 23:37; DEU 32:29\x*
\v 42 \w dizendo|strong="G3004"\w*: “\w Se ao menos|strong="G1487"\w* \w você tivesse reconhecido|strong="G1097"\w*, \w neste dia|strong="G1722,G3588,G2250,G3778"\w*, \w também|strong="G2532"\w* \w você|strong="G4771"\w*, \w o que leva|strong="G3588,G4314"\w* \w à paz|strong="G1515"\w*…! \w Mas agora|strong="G3568,G1161"\w* \w está oculto|strong="G2928"\w* \w aos seus olhos|strong="G575,G3788,G4771"\w*.\f + \fr 19.42: \ft Lit.: a frase fica incompleta (aposiopese): “se você tivesse reconhecido… o que traz a paz!”.\f*\x - \xo 19:42 \xt 1CO 13:6; 2CO 6:2; DEU 32:29; ROM 5:1; DEU 5:29; LUK 13:34\x*
\v 43 \w Porque|strong="G3754"\w* \w virão|strong="G2240"\w* \w dias|strong="G2250"\w* \w sobre você|strong="G1909,G4771"\w*, \w e|strong="G2532"\w* \w os seus inimigos|strong="G3588,G2190,G4771"\w* \w levantarão|strong="G6070"\w* \w uma paliçada|strong="G5482"\w* \w contra você|strong="G4771"\w* \w e|strong="G2532"\w* \w a cercarão|strong="G4033,G4771"\w*, \w e|strong="G2532"\w* \w a apertarão|strong="G4912,G4771"\w* \w por todos os lados|strong="G3840"\w*,\f + \fr 19.43: \ft Lit.: χάραξ, “paliçada, estacada” (obra de cerco).\f*\x - \xo 19:43 \xt LUK 21:20; MAT 24:15; 2CO 6:2; MAT 23:37; ISA 29:1-4; LUK 12:56\x*
\v 44 \w e|strong="G2532"\w* \w a arrasarão|strong="G1474,G4771"\w* \w e|strong="G2532"\w* \w os seus filhos|strong="G3588,G5043,G4771"\w* \w dentro de você|strong="G1722,G4771"\w*, \w e|strong="G2532"\w* \w não deixarão|strong="G3756,G863"\w* \w pedra sobre pedra|strong="G3037,G1909"\w* \w em você|strong="G1722,G4771"\w*, \w porque|strong="G473,G3739"\w* \w não reconheceu|strong="G3756,G1097"\w* \w o tempo|strong="G3588,G2540"\w* \w da sua visita|strong="G3588,G1984,G4771"\w*.”\f + \fr 19.44: \ft Lit.: ἐπισκοπή, “visita, inspeção” (de Deus); ἐδαφίζω, “derrubar ao chão, arrasar”.\f*\x - \xo 19:44 \xt MAT 24:2; 2CO 6:2; GEN 21:1; LUK 13:34; LUK 21:6; 1PE 2:12\x*
\p
\v 45 \w E|strong="G2532"\w*, \w tendo entrado|strong="G1525"\w* \w no templo|strong="G1519,G3588,G2411"\w*, \w começou|strong="G757"\w* \w a expulsar|strong="G1544"\w* \w os que vendiam|strong="G3588,G4453"\w*,\f + \fr 19.45: \ft Variante: RP (e TR) acrescentam ἐν αὐτῷ καὶ ἀγοράζοντας (“nele, e os que compravam”); WH, Treg e NA28 não trazem.\f*\x - \xo 19:45 \xt MRK 11:15; MAT 21:12; JHN 2:14; JER 7:11; JHN 2:13-17; JHN 18:20\x*
\v 46 \w dizendo-lhes|strong="G3004,G846"\w*: “\w Está escrito|strong="G1125"\w*: ‘\w E|strong="G2532"\w* \w será|strong="G1510"\w* \w a minha casa|strong="G3588,G3624,G3165"\w* \w casa|strong="G3624"\w* \w de oração|strong="G4335"\w*’; \w vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w a fizeram|strong="G846,G4160"\w* \w um covil|strong="G4693"\w* \w de bandidos|strong="G3027"\w*.”\f + \fr 19.46: \ft Nota cultural: cita Is 56:7 e Jr 7:11.\f*\x - \xo 19:46 \xt ISA 56:7; JER 7:11; MAT 21:13; MRK 11:17; MAT 21:12; JHN 2:14\x*
\v 47 \w E|strong="G2532"\w* \w ele ensinava|strong="G1510,G1321"\w* \w todos os dias|strong="G3588,G2596,G2250"\w* \w no templo|strong="G1722,G3588,G2411"\w*; \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os escribas|strong="G3588,G1122"\w* \w procuravam|strong="G2212"\w* \w destruí-lo|strong="G846,G622"\w*, \w e|strong="G2532"\w* \w os principais|strong="G3588,G4413"\w* \w do povo|strong="G3588,G2992"\w*,\x - \xo 19:47 \xt LUK 20:1; LUK 22:2; MAT 21:23; MRK 11:18; MRK 11:27; LUK 20:19\x*
\v 48 \w e|strong="G2532"\w* \w não achavam|strong="G3756,G2147"\w* \w o que|strong="G3588,G5101"\w* \w fazer|strong="G4160"\w*, \w pois|strong="G1063"\w* \w todo o povo|strong="G3588,G2992,G537"\w* \w ficava pendente|strong="G1582"\w* \w dele|strong="G846"\w*, \w ouvindo|strong="G191"\w*.\f + \fr 19.48: \ft Lit.: ἐκκρέμαμαι, “estar pendurado”: “prender-se às palavras de alguém”.\f*\x - \xo 19:48 \xt LUK 3:21; LUK 20:6; JAS 1:19; ACT 2:47; LUK 4:20; LUK 20:19\x*
\c 20
\p
\v 1 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w num dia|strong="G1722,G1520,G3588,G2250"\w* \w enquanto ele ensinava|strong="G1321,G846"\w* \w o povo|strong="G3588,G2992"\w* \w no templo|strong="G1722,G3588,G2411"\w* \w e|strong="G2532"\w* \w anunciava a boa notícia|strong="G2097"\w*, \w se apresentaram|strong="G2186"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os escribas|strong="G3588,G1122"\w* \w com os anciãos|strong="G4862,G3588,G4245"\w*,\f + \fr 20.1: \ft Acréscimo: “que” (em “E aconteceu que num dia”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 20:1 \xt LUK 19:47; MRK 11:27; MAT 21:23; JHN 18:20; JHN 2:18; LUK 8:1\x*
\v 2 \w e|strong="G2532"\w* \w lhe disseram|strong="G2036,G4314,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Diga-nos|strong="G2036,G3165"\w*: \w com que autoridade|strong="G1722,G4169,G1849"\w* \w você faz|strong="G4160"\w* \w estas coisas|strong="G3778"\w*, \w ou|strong="G2228"\w* \w quem|strong="G5101"\w* \w é|strong="G1510"\w* \w aquele que|strong="G3588"\w* \w lhe deu|strong="G1325,G4771"\w* \w esta autoridade|strong="G3588,G1849,G3778"\w*?”\x - \xo 20:2 \xt MRK 11:28; LUK 20:8; MRK 11:33; MAT 21:23; MAT 21:27; MRK 11:29\x*
\v 3 \w Respondendo|strong="G611"\w*, \w disse-lhes|strong="G2036,G4314,G846"\w*: “\w Também eu|strong="G2532_A,G1473"\w* \w perguntarei|strong="G2065"\w* \w a vocês|strong="G4771"\w* \w uma coisa|strong="G3056"\w*; \w e|strong="G2532"\w* \w digam-me|strong="G2036,G3165"\w*:\f + \fr 20.3: \ft Lit.: λόγον, literalmente “uma palavra”: aqui, “uma pergunta, um assunto”.\f*\x - \xo 20:3 \xt LUK 22:68; MAT 21:24; JHN 14:16; MRK 11:27; COL 4:6; MRK 11:29\x*
\v 4 \w O batismo|strong="G3588,G908"\w* \w de João|strong="G2491"\w* \w era|strong="G1510"\w* \w do céu|strong="G1537,G3772"\w* \w ou|strong="G2228"\w* \w dos seres humanos|strong="G1537,G444"\w*?”\x - \xo 20:4 \xt MRK 11:30; ACT 19:3; MAT 21:25; ACT 19:4; LUK 7:29; ACT 10:37\x*
\v 5 \w Eles|strong="G3588"\w* \w discutiram|strong="G4817"\w* \w entre si|strong="G4314,G1438"\w*, \w dizendo|strong="G3004"\w*: “\w Se|strong="G1437"\w* \w dissermos|strong="G2036"\w*: ‘\w Do céu|strong="G1537,G3772"\w*’, \w ele dirá|strong="G4483"\w*: ‘\w Por que|strong="G1223,G5101"\w* \w não creram|strong="G3756,G4100"\w* \w nele|strong="G846"\w*?’\f + \fr 20.5: \ft Variante: o TR acrescenta οὖν (“então”) na pergunta “Por que não creram nele?”; as demais edições não trazem.\f*\x - \xo 20:5 \xt MRK 11:31; MAT 21:25; MRK 11:27; MRK 11:29; MRK 8:16; ACT 13:25\x*
\v 6 \w Mas|strong="G1161"\w* \w se|strong="G1437"\w* \w dissermos|strong="G2036"\w*: ‘\w Dos seres humanos|strong="G1537,G444"\w*’, \w todo o povo|strong="G3588,G2992,G537"\w* \w nos apedrejará|strong="G2642,G3165"\w*, \w pois|strong="G1063"\w* \w está convencido|strong="G3982,G1510"\w* \w de que João|strong="G2491"\w* \w era profeta|strong="G4396,G1511"\w*.”\x - \xo 20:6 \xt MRK 11:32; MAT 21:26; LUK 19:48; MRK 11:27; ACT 4:21; MRK 11:29\x*
\v 7 \w E|strong="G2532"\w* \w responderam|strong="G611"\w* \w que não sabiam|strong="G3361,G6063"\w* \w de onde|strong="G4159"\w*.\x - \xo 20:7 \xt JHN 9:30; JHN 8:14; REV 7:13; MRK 11:27; ISA 41:28; MRK 11:29\x*
\v 8 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Nem|strong="G3761"\w* \w eu|strong="G1473"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w com que autoridade|strong="G1722,G4169,G1849"\w* \w faço|strong="G4160"\w* \w estas coisas|strong="G3778"\w*.”\x - \xo 20:8 \xt MRK 11:33; MAT 21:27; LUK 20:2; MRK 11:28; MRK 11:29; MRK 11:27\x*
\p
\v 9 \w Começou|strong="G757"\w* \w a dizer|strong="G3004"\w* \w ao povo|strong="G4314,G3588,G2992"\w* \w esta parábola|strong="G3588,G3850,G3778"\w*: “\w Um homem|strong="G444"\w* \w plantou|strong="G5452"\w* \w uma vinha|strong="G290"\w*, \w e|strong="G2532"\w* \w a arrendou|strong="G1554,G846"\w* \w a lavradores|strong="G1092"\w*, \w e|strong="G2532"\w* \w viajou|strong="G589"\w* \w por bastante tempo|strong="G5550,G2425"\w*.\x - \xo 20:9 \xt MRK 12:1; MAT 21:33; ISA 5:1; JER 2:21; MAT 25:14; LUK 19:12\x*
\v 10 \w E|strong="G2532"\w* \w no tempo certo|strong="G2540"\w* \w enviou|strong="G649"\w* \w aos lavradores|strong="G4314,G3588,G1092"\w* \w um escravo|strong="G1401"\w*, \w para que|strong="G2443"\w* \w lhe dessem|strong="G1325,G846"\w* \w do fruto|strong="G575,G3588,G2590"\w* \w da vinha|strong="G3588,G290"\w*; \w os lavradores|strong="G3588,G1092"\w*, \w depois de espancá-lo|strong="G1194"\w*, \w o mandaram embora|strong="G1821,G846"\w* \w de mãos vazias|strong="G2756"\w*.\x - \xo 20:10 \xt MRK 12:2; MRK 12:3; MAT 21:34; MAT 21:33; 2CH 36:15-16; DAN 9:6\x*
\v 11 \w E|strong="G2532"\w* \w enviou ainda|strong="G4369,G3992"\w* \w outro|strong="G2087"\w* \w escravo|strong="G1401"\w*; \w eles|strong="G3588"\w* \w também a esse|strong="G1565,G2532"\w*, \w depois de espancá-lo|strong="G1194"\w* \w e|strong="G2532"\w* \w desonrá-lo|strong="G818"\w*, \w o mandaram embora|strong="G1821"\w* \w de mãos vazias|strong="G2756"\w*.\x - \xo 20:11 \xt MAT 21:33; DAN 9:6; ISA 5:2; JER 11:19; LUK 13:6; MAT 21:34\x*
\v 12 \w E|strong="G2532"\w* \w enviou ainda|strong="G4369,G3992"\w* \w um terceiro|strong="G5154"\w*; \w eles|strong="G3588"\w* \w também a este|strong="G2532,G3778"\w*, \w depois de feri-lo|strong="G5135"\w*, \w o expulsaram|strong="G1544"\w*.\x - \xo 20:12 \xt MAT 21:33; DAN 9:6; ISA 5:2; JER 11:19; LUK 13:6; MAT 21:34\x*
\v 13 \w Disse|strong="G2036"\w* \w o dono|strong="G3588,G2962"\w* \w da vinha|strong="G3588,G290"\w*: ‘\w O que|strong="G5101"\w* \w farei|strong="G4160"\w*? \w Enviarei|strong="G3992"\w* \w o meu filho|strong="G3588,G5207,G3165"\w* \w amado|strong="G3588,G27"\w*; \w talvez|strong="G2481"\w* \w a este|strong="G3778"\w* \w respeitem|strong="G1788"\w*.’\f + \fr 20.13: \ft Lit.: κύριος, literalmente “senhor”: o proprietário da vinha.\f*\f + \fr 20.13: \ft Variante: RP (e TR) acrescentam ἰδόντες (“ao vê-lo”) depois de “a este”; WH, Treg e NA28 não trazem.\f*\x - \xo 20:13 \xt MRK 12:6; 1CO 4:14; JHN 1:11; MAT 21:33; MAT 3:17; ISA 5:2\x*
\v 14 \w Vendo-o|strong="G1492,G846"\w* \w os lavradores|strong="G3588,G1092"\w* \w discutiam|strong="G1260"\w* \w entre si|strong="G4314,G240"\w*, \w dizendo|strong="G3004"\w*: ‘\w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w o herdeiro|strong="G3588,G2818"\w*; \w matemo-lo|strong="G615,G846"\w*, \w para que|strong="G2443"\w* \w a herança|strong="G3588,G2817"\w* \w seja nossa|strong="G3165,G1096"\w*.’\f + \fr 20.14: \ft Variante: RP lê ἑαυτούς em vez de ἀλλήλους (“entre si”) e, com o TR, acrescenta δεῦτε (“venham”) antes de “matemo-lo”; WH, Treg e NA28 não trazem esse acréscimo.\f*\x - \xo 20:14 \xt MAT 21:38; MRK 12:7; JHN 1:11; MAT 21:33; ISA 5:2; JER 11:19\x*
\v 15 \w E|strong="G2532"\w*, \w tendo-o lançado|strong="G1544,G846"\w* \w para fora|strong="G1854"\w* \w da vinha|strong="G3588,G290"\w*, \w o mataram|strong="G615"\w*. \w O que|strong="G5101"\w*, \w então|strong="G3767"\w*, \w lhes fará|strong="G4160,G846"\w* \w o dono|strong="G3588,G2962"\w* \w da vinha|strong="G3588,G290"\w*?\f + \fr 20.15: \ft Tradução: κύριος (κύριος, G2962) está aqui como “o dono”; o termo pode ser “Senhor” (Deus ou Jesus), “senhor” (título de respeito), “dono” ou “patrão”, e o contexto decide.\f*\x - \xo 20:15 \xt MRK 12:8; MAT 21:39; JHN 9:35; JHN 6:37; JHN 1:11; MAT 21:33\x*
\v 16 \w Virá|strong="G2064"\w* \w e|strong="G2532"\w* \w destruirá|strong="G622"\w* \w estes lavradores|strong="G3588,G1092,G3778"\w* \w e|strong="G2532"\w* \w dará|strong="G1325"\w* \w a vinha|strong="G3588,G290"\w* \w a outros|strong="G243"\w*.” \w Ouvindo isso|strong="G191"\w*, \w disseram|strong="G2036"\w*: “\w Que isso nunca aconteça|strong="G3361,G1096"\w*!”\x - \xo 20:16 \xt MRK 12:9; MAT 21:40; MAT 21:41; MAT 21:33; MRK 12:2; MRK 12:1\x*
\v 17 \w Ele|strong="G3588"\w*, \w olhando para eles|strong="G1689,G846"\w*, \w disse|strong="G2036"\w*: “\w Que é|strong="G5101,G1510"\w*, \w então|strong="G3767"\w*, \w isto que está escrito|strong="G3588,G1125,G3778"\w*: ‘\w A pedra|strong="G3037"\w* \w que rejeitaram|strong="G3739,G593"\w* \w os construtores|strong="G3588,G3618"\w*, \w esta|strong="G3778"\w* \w se tornou|strong="G1096"\w* \w pedra angular|strong="G1519,G2776,G1137"\w*’?”\f + \fr 20.17: \ft Nota cultural: cita Sl 118:22.\f*\f + \fr 20.17: \ft Lit.: κεφαλὴ γωνίας, literalmente “cabeça de ângulo”: a pedra angular ou a pedra do vértice.\f*\x - \xo 20:17 \xt PSA 118:22; MRK 12:10; 1PE 2:7; MAT 21:42; ACT 4:11; ISA 28:16\x*
\v 18 \w Todo|strong="G3956"\w* \w aquele que cair|strong="G3588,G4098"\w* \w sobre aquela pedra|strong="G1909,G1565,G3588,G3037"\w* \w será despedaçado|strong="G4917"\w*; \w aquele sobre quem|strong="G1909,G3739"\w* \w ela cair|strong="G302,G4098"\w*, \w o esmagará|strong="G3039,G846"\w*.”\f + \fr 20.18: \ft Lit.: λικμάω, “joeirar, espalhar como pó”: esmagar, reduzir a pó.\f*\x - \xo 20:18 \xt MAT 21:44; ISA 28:16; MRK 12:10; MAT 21:42; HOS 4:6; ISA 8:14-15\x*
\v 19 \w E|strong="G2532"\w* \w os escribas|strong="G3588,G1122"\w* \w e|strong="G2532"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w procuraram|strong="G2212"\w* \w lançar|strong="G1911"\w* \w as mãos|strong="G3588,G5495"\w* \w sobre ele|strong="G1909,G846"\w* \w naquela mesma hora|strong="G1722,G846,G3588,G5610"\w*, \w e|strong="G2532"\w* \w temeram|strong="G5399"\w* \w o povo|strong="G3588,G2992"\w*; \w pois|strong="G1063"\w* \w perceberam|strong="G1097"\w* \w que|strong="G3754"\w* \w contra eles|strong="G4314,G846"\w* \w ele disse|strong="G2036"\w* \w esta parábola|strong="G3588,G3850,G3778"\w*.\x - \xo 20:19 \xt LUK 22:2; MAT 21:45; MRK 12:12; LUK 19:47; MAT 21:33; 2TI 4:3\x*
\p
\v 20 \w E|strong="G2532"\w*, \w ficando à espreita|strong="G3906"\w*, \w enviaram|strong="G649"\w* \w espiões|strong="G1455"\w* \w que se fingiam|strong="G5271,G1438"\w* \w de justos|strong="G1342,G1511"\w*, \w para que|strong="G2443"\w* \w o surpreendessem|strong="G1949,G846"\w* \w em alguma palavra|strong="G3056"\w*, \w de modo a|strong="G5620"\w* \w entregá-lo|strong="G3860,G846"\w* \w ao governo|strong="G3588,G746"\w* \w e|strong="G2532"\w* \w à autoridade|strong="G3588,G1849"\w* \w do governador|strong="G3588,G2232"\w*.\f + \fr 20.20: \ft Lit.: ἐγκάθετος, “alguém posto de emboscada”: espião, informante infiltrado.\f*\f + \fr 20.20: \ft Tradução: ἀρχῇ (ἀρχή, G746) está aqui como “ao governo”; o termo pode ser “princípio”, “começo”, “governo”, “governante” ou “domínio”, e o contexto decide.\f*\x - \xo 20:20 \xt DAN 6:4; MAT 22:15; PSA 141:9; LUK 11:54; MRK 12:13; MRK 3:2\x*
\v 21 \w E|strong="G2532"\w* \w lhe perguntaram|strong="G1905,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Mestre|strong="G1320"\w*, \w sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w você fala|strong="G3004"\w* \w e|strong="G2532"\w* \w ensina|strong="G1321"\w* \w corretamente|strong="G3723"\w*, \w e|strong="G2532"\w* \w não faz acepção|strong="G3756,G2983"\w* \w de pessoas|strong="G4383"\w*, \w mas|strong="G235"\w* \w ensina|strong="G1321"\w* \w o caminho|strong="G3588,G3598"\w* \w de Deus|strong="G3588,G2316"\w* \w conforme a verdade|strong="G1909,G225"\w*.\f + \fr 20.21: \ft Lit.: λαμβάνω πρόσωπον, literalmente “receber o rosto”: favorecer alguém pela aparência ou posição.\f*\x - \xo 20:21 \xt MAT 22:16; ACT 10:34; ROM 2:11; MAT 22:15; ROM 13:6; MRK 12:13\x*
\v 22 \w É permitido|strong="G1832"\w* \w que nós|strong="G3165"\w* \w paguemos|strong="G1325"\w* \w imposto|strong="G5411"\w* \w a César|strong="G2541"\w*, \w ou|strong="G2228"\w* \w não|strong="G3756"\w*?”\f + \fr 20.22: \ft Lit.: φόρος, “tributo” devido a uma potência dominante.\f*\x - \xo 20:22 \xt LUK 23:2; MRK 12:14; MAT 22:15; ROM 13:6; MRK 12:13; COL 4:6\x*
\v 23 \w Percebendo|strong="G2657"\w* \w a astúcia|strong="G3588,G3834"\w* \w deles|strong="G846"\w*, \w disse-lhes|strong="G2036,G4314,G846"\w*:\f + \fr 20.23: \ft Variante: RP (e TR) acrescentam Τί με πειράζετε (“Por que vocês me põem à prova?”) depois de “disse-lhes”; WH, Treg e NA28 não trazem.\f*\x - \xo 20:23 \xt MAT 22:15; ROM 13:6; MRK 12:13; 1CO 3:19; COL 4:6; MRK 12:15\x*
\v 24 “\w Mostrem-me|strong="G1166,G3165"\w* \w um denário|strong="G1220"\w*: \w de quem|strong="G5101"\w* \w ele tem|strong="G2192"\w* \w a imagem|strong="G1504"\w* \w e|strong="G2532"\w* \w a inscrição|strong="G1923"\w*?” \w Respondendo|strong="G611"\w* \w disseram|strong="G2036"\w*: “\w De César|strong="G2541"\w*.”\f + \fr 20.24: \ft Variante: WH e NA28 leem οἱ (“eles”) em vez de ἀποκριθέντες (“respondendo”), que está em Treg e RP; RP lê Ἐπιδείξατέ em vez de Δείξατέ.\f*\x - \xo 20:24 \xt MRK 12:16; MAT 22:20; MAT 22:15; ROM 13:6; MRK 12:13; COL 4:6\x*
\v 25 \w Ele|strong="G3588"\w* \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Então|strong="G5106"\w* \w devolvam|strong="G591"\w* \w o que é de César|strong="G3588,G2541"\w* \w a César|strong="G2541"\w* \w e|strong="G2532"\w* \w o que é de Deus|strong="G3588,G2316"\w* \w a Deus|strong="G3588,G2316"\w*.”\f + \fr 20.25: \ft Acréscimo: verbo ser/estar suprido em “o que é de César”, “o que é de Deus”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 20:25 \xt MRK 12:17; MAT 22:21; 1PE 2:13; ROM 13:7; MAT 22:15; MAL 3:8\x*
\v 26 \w E|strong="G2532"\w* \w não conseguiram|strong="G3756,G2480"\w* \w apanhá-lo|strong="G1949"\w* \w numa palavra|strong="G3588,G4487"\w* \w diante do povo|strong="G1726,G3588,G2992"\w*, \w e|strong="G2532"\w*, \w admirados|strong="G2296"\w* \w com a resposta|strong="G1909,G3588,G612"\w* \w dele|strong="G846"\w*, \w calaram-se|strong="G4601"\w*.\f + \fr 20.26: \ft Variante: WH lê τοῦ ῥήματος (“a palavra”); Treg, NA28 e RP leem αὐτοῦ ῥήματος (“palavra dele”).\f*\x - \xo 20:26 \xt MAT 22:15; ROM 13:6; MRK 12:13; COL 4:6; JHN 18:30; LUK 20:20\x*
\p
\v 27 \w Aproximando-se|strong="G4334"\w* \w alguns|strong="G5100"\w* \w dos saduceus|strong="G3588,G4523"\w*, \w os que negam|strong="G3588,G483"\w* \w que haja|strong="G3361,G1511"\w* \w ressurreição|strong="G386"\w*, \w lhe perguntaram|strong="G1905,G846"\w*,\x - \xo 20:27 \xt MAT 22:23; MRK 12:18; MAT 16:1; ACT 23:8; ACT 4:1-2; 1CO 15:12\x*
\v 28 \w dizendo|strong="G3004"\w*: “\w Mestre|strong="G1320"\w*, \w Moisés|strong="G3475"\w* \w nos escreveu|strong="G1125,G3165"\w*: ‘\w Se|strong="G1437"\w* \w o irmão|strong="G80"\w* \w de alguém|strong="G5100"\w* \w morrer|strong="G599"\w* \w tendo|strong="G2192"\w* \w esposa|strong="G1135"\w*, \w e|strong="G2532"\w* \w este|strong="G3778"\w* \w for sem filhos|strong="G815,G1510"\w*, \w o irmão dele|strong="G3588,G80,G846"\w* \w deve tomar|strong="G2443,G2983"\w* \w a esposa|strong="G3588,G1135"\w* \w e|strong="G2532"\w* \w suscitar|strong="G1817"\w* \w descendência|strong="G4690"\w* \w para o seu irmão|strong="G3588,G80,G846"\w*.’\f + \fr 20.28: \ft Nota cultural: cita a lei do levirato (Dt 25:5).\f*\f + \fr 20.28: \ft Variante: RP lê ἀποθάνῃ (“morrer”) em lugar de ᾖ (“for”) depois de “sem filhos”.\f*\x - \xo 20:28 \xt DEU 25:5; MAT 22:24; MRK 12:19; COL 4:6; GEN 38:8; MAT 22:23\x*
\v 29 \w Havia|strong="G1510"\w*, \w então|strong="G3767"\w*, \w sete|strong="G2033"\w* \w irmãos|strong="G80"\w*; \w e|strong="G2532"\w* \w o primeiro|strong="G3588,G4413"\w*, \w tendo tomado|strong="G2983"\w* \w esposa|strong="G1135"\w*, \w morreu|strong="G599"\w* \w sem filhos|strong="G815"\w*;\x - \xo 20:29 \xt MRK 12:20; MAT 22:25; COL 4:6; LEV 20:20; MAT 22:23; JER 22:30\x*
\v 30 \w e|strong="G2532"\w* \w o segundo|strong="G3588,G1208"\w*,\f + \fr 20.30: \ft Variante: RP (e TR) trazem ἔλαβεν ὁ δεύτερος τὴν γυναῖκα καὶ οὗτος ἀπέθανεν ἄτεκνος (“o segundo tomou a mulher, e este morreu sem filhos”); WH, Treg e NA28 trazem só ὁ δεύτερος, como aqui.\f*\x - \xo 20:30 \xt COL 4:6; MAT 22:23; MAT 22:25\x*
\v 31 \w e|strong="G2532"\w* \w o terceiro|strong="G3588,G5154"\w* \w a tomou|strong="G2983,G846"\w*, \w do mesmo modo|strong="G5615"\w* \w também|strong="G2532"\w* \w os sete|strong="G3588,G2033"\w* \w não deixaram|strong="G3756,G2641"\w* \w filhos|strong="G5043"\w* \w e|strong="G2532"\w* \w morreram|strong="G599"\w*;\x - \xo 20:31 \xt MRK 12:21; COL 4:6; MAT 22:23; MAT 22:25\x*
\v 32 \w por fim|strong="G5306"\w*, \w também|strong="G2532"\w* \w a mulher|strong="G3588,G1135"\w* \w morreu|strong="G599"\w*.\f + \fr 20.32: \ft Variante: RP (e TR) leem δὲ πάντων ἀπέθανεν καὶ ἡ γυνή (“por último de todos morreu também a mulher”); WH, Treg e NA28 leem como aqui.\f*\x - \xo 20:32 \xt MAT 22:27; COL 4:6; ECC 9:5; MAT 22:23; ECC 1:4; MAT 22:25\x*
\v 33 \w A mulher|strong="G3588,G1135"\w*, \w então|strong="G3767"\w*, \w na ressurreição|strong="G1722,G3588,G386"\w*, \w de qual|strong="G5101"\w* \w deles|strong="G846"\w* \w passa a ser|strong="G1096"\w* \w esposa|strong="G1135"\w*? \w Pois|strong="G1063"\w* \w os sete|strong="G3588,G2033"\w* \w a tiveram|strong="G2192,G846"\w* \w como esposa|strong="G1135"\w*.”\x - \xo 20:33 \xt MAT 22:28; MRK 12:23; MAT 22:25; COL 4:6; MAT 22:23; MAT 22:24-28\x*
\v 34 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Os filhos|strong="G3588,G5207"\w* \w desta era|strong="G3588,G165,G3778"\w* \w casam-se|strong="G1060"\w* \w e|strong="G2532"\w* \w são dados em casamento|strong="G1061"\w*,\x - \xo 20:34 \xt MAT 22:30; LUK 17:27; MRK 12:25; LUK 16:8; 1CO 7:2-16; COL 4:6\x*
\v 35 \w mas|strong="G1161"\w* \w os que|strong="G3588"\w* \w foram considerados dignos|strong="G2661"\w* \w de alcançar|strong="G5177"\w* \w aquela era|strong="G3588,G165,G1565"\w* \w e|strong="G2532"\w* \w a ressurreição|strong="G3588,G386"\w* \w dentre os mortos|strong="G3588,G1537,G3498"\w*, \w nem casam|strong="G3777,G1060"\w* \w nem são dados em casamento|strong="G3777,G1061"\w*;\x - \xo 20:35 \xt MAT 22:30; MRK 12:25; HEB 11:35; 2TH 1:5; PHP 3:11; JHN 5:29\x*
\v 36 \w porque|strong="G1063"\w* \w nem|strong="G3761"\w* \w podem mais|strong="G2089,G1410"\w* \w morrer|strong="G599"\w*, \w pois|strong="G1063"\w* \w são iguais aos anjos|strong="G2465,G1510"\w* \w e|strong="G2532"\w* \w são filhos|strong="G5207,G1510"\w* \w de Deus|strong="G2316"\w*, \w sendo filhos|strong="G5207,G1510"\w* \w da ressurreição|strong="G3588,G386"\w*.\f + \fr 20.36: \ft Lit.: ἰσάγγελοι, “iguais aos anjos” (palavra rara).\f*\x - \xo 20:36 \xt 1CO 15:13; JHN 11:25; MAT 22:30; MRK 12:25; ROM 8:23; PHP 3:11\x*
\v 37 \w Mas|strong="G1161"\w* \w que os mortos|strong="G3754,G3588,G3498"\w* \w são ressuscitados|strong="G1453"\w*, \w também|strong="G2532"\w* \w Moisés|strong="G3475"\w* \w o mostrou|strong="G3377"\w* \w no trecho da sarça|strong="G1909,G3588,G942"\w*, \w quando|strong="G5613"\w* \w chama|strong="G3004"\w* \w o Senhor|strong="G2962"\w* \add como\add* ‘\w o Deus|strong="G3588,G2316"\w* \w de Abraão|strong="G11"\w*, \w e|strong="G2532"\w* \w Deus|strong="G2316"\w* \w de Isaque|strong="G2464"\w*, \w e|strong="G2532"\w* \w Deus|strong="G2316"\w* \w de Jacó|strong="G2384"\w*’.\f + \fr 20.37: \ft Nota cultural: cita Êxodo 3:6.\f*\f + \fr 20.37: \ft Acréscimo: “como” (em “o Senhor como o Deus”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 20:37 \xt EXO 3:6; MRK 12:26; MAT 22:32; LUK 3:34; EXO 3:2; ACT 7:30\x*
\v 38 \w Deus|strong="G2316"\w* \w não é|strong="G3756,G1510"\w* \w de mortos|strong="G3498"\w* \w mas|strong="G235"\w* \w de vivos|strong="G2198"\w*, \w pois|strong="G1063"\w* \w todos|strong="G3956"\w* \w vivem|strong="G2198"\w* \w para ele|strong="G846"\w*.”\f + \fr 20.38: \ft Lit.: ζῶσιν αὐτῷ, “vivem para ele” ou “vivem por ele”.\f*\x - \xo 20:38 \xt MAT 22:32; MRK 12:27; ROM 14:9; 1PE 4:6; JHN 5:25; ROM 6:11\x*
\v 39 \w Respondendo|strong="G611"\w* \w alguns|strong="G5100"\w* \w dos escribas|strong="G3588,G1122"\w* \w disseram|strong="G2036"\w*: “\w Mestre|strong="G1320"\w*, \w você falou|strong="G2036"\w* \w bem|strong="G2573"\w*.”\x - \xo 20:39 \xt MRK 12:32; JHN 13:13; MAT 12:38; JHN 4:17; COL 4:6; MAT 22:23\x*
\v 40 \w Pois|strong="G1063"\w* \w já não|strong="G2089,G3756"\w* \w ousavam|strong="G5111"\w* \w lhe perguntar|strong="G1905,G846"\w* \w nada|strong="G3762"\w*.\x - \xo 20:40 \xt MAT 22:46; MRK 12:34; COL 4:6; MAT 22:23; LUK 14:6; TIT 1:11\x*
\p
\v 41 \w Disse|strong="G2036"\w* \w a eles|strong="G4314,G846"\w*: “\w Como|strong="G4459"\w* \w dizem|strong="G3004"\w* \w que o Cristo|strong="G3588,G5547"\w* \w é filho|strong="G1511,G5207"\w* \w de Davi|strong="G1138"\w*?\x - \xo 20:41 \xt MRK 12:35; LUK 20:44; MAT 22:43; MAT 22:45; LUK 2:11; JER 23:5-6\x*
\v 42 \w Pois|strong="G1063"\w* \w o próprio|strong="G846"\w* \w Davi|strong="G1138"\w* \w diz|strong="G3004"\w* \w no livro|strong="G1722,G976"\w* \w dos Salmos|strong="G5568"\w*: ‘\w Disse|strong="G2036"\w* \w o Senhor|strong="G2962"\w* \w ao meu Senhor|strong="G3588,G2962,G3165"\w*: “\w Sente-se|strong="G2521"\w* \w à minha direita|strong="G1537,G1188,G3165"\w*,\f + \fr 20.42: \ft Nota cultural: cita Sl 110:1.\f*\x - \xo 20:42 \xt PSA 110:1; ACT 2:34; MRK 12:36; COL 3:1; LUK 2:11; HEB 1:13\x*
\v 43 \w até que|strong="G2193,G302"\w* \w eu ponha|strong="G5087"\w* \w os seus inimigos|strong="G3588,G2190,G4771"\w* \w como estrado|strong="G5286"\w* \w dos seus pés|strong="G3588,G4228,G4771"\w*.”’\x - \xo 20:43 \xt ACT 2:35; HEB 10:13; HEB 1:13; 1CO 15:25; MAT 22:44; MRK 12:36\x*
\v 44 \w Davi|strong="G1138"\w*, \w então|strong="G3767"\w*, \w o chama|strong="G846,G2564"\w* \w de Senhor|strong="G2962"\w*, \w e|strong="G2532"\w* \w como|strong="G4459"\w* \w é|strong="G1510"\w* \w filho dele|strong="G846,G5207"\w*?”\x - \xo 20:44 \xt MAT 22:43; MAT 22:45; LUK 20:41; MRK 12:35; LUK 2:11; PHP 3:8\x*
\p
\v 45 \w Enquanto todo o povo|strong="G3956,G3588,G2992"\w* \w ouvia|strong="G191"\w*, \w disse|strong="G2036"\w* \w aos discípulos|strong="G3588,G3101"\w*:\x - \xo 20:45 \xt MRK 12:38; MAT 15:10; MAT 23:1; MRK 8:34\x*
\v 46 “\w Tenham cuidado|strong="G4337"\w* \w com os escribas|strong="G575,G3588,G1122"\w* \w que gostam de|strong="G3588,G2309"\w* \w andar|strong="G4043"\w* \w com vestes compridas|strong="G1722,G4749"\w* \w e|strong="G2532"\w* \w amam|strong="G5368"\w* \w saudações|strong="G783"\w* \w nas praças|strong="G1722,G3588,G58"\w*, \w e|strong="G2532"\w* \w os primeiros assentos|strong="G4410"\w* \w nas sinagogas|strong="G1722,G3588,G4864"\w* \w e|strong="G2532"\w* \w os primeiros lugares|strong="G4411"\w* \w nos banquetes|strong="G1722,G3588,G1173"\w*,\f + \fr 20.46: \ft Tradução: θελόντων (θέλω, G2309) está aqui como “que gostam de”; o termo pode ser “querer”, “desejar”, “ter prazer” ou “pretender”, e o contexto decide.\f*\x - \xo 20:46 \xt MAT 23:6; MRK 12:38; LUK 11:43; MRK 12:39; EZK 34:2; MAT 23:2\x*
\v 47 \w os que devoram|strong="G3739,G2719"\w* \w as casas|strong="G3588,G3614"\w* \w das viúvas|strong="G3588,G5503"\w* \w e|strong="G2532"\w*, \w por pretexto|strong="G4392"\w*, \w fazem longas orações|strong="G3117,G4336"\w*; \w estes|strong="G3778"\w* \w receberão|strong="G2983"\w* \w julgamento|strong="G2917"\w* \w maior|strong="G4055"\w*.”\x - \xo 20:47 \xt MRK 12:40; MAT 23:14; EZK 34:2; MAT 6:5; MRK 12:38; ROM 13:2\x*
\c 21
\p
\v 1 \w Olhando para cima|strong="G308"\w* \w viu|strong="G1492"\w* \w os ricos|strong="G4145"\w* \w que lançavam|strong="G3588,G906"\w* \w as suas ofertas|strong="G3588,G1435,G846"\w* \w no cofre das ofertas|strong="G1519,G3588,G1049"\w*.\f + \fr 21.1: \ft Lit.: γαζοφυλάκιον, “tesouraria, cofre das ofertas”.\f*\x - \xo 21:1 \xt MRK 12:41; 2CO 8:12; EPH 4:28; JHN 8:20; 2CH 36:18; 2CO 8:2\x*
\v 2 \w Viu|strong="G1492"\w* \w uma certa|strong="G5100"\w* \w viúva|strong="G5503"\w* \w pobre|strong="G3998"\w* \w lançando|strong="G906"\w* \w ali|strong="G1563"\w* \w dois|strong="G1417"\w* \w leptos|strong="G3016"\w*.\f + \fr 21.2: \ft Lit.: λεπτόν, a menor moeda de cobre da Judeia; πενιχρός, “pobre, necessitado”, é outra palavra que πτωχός do v. 3.\f*\x - \xo 21:2 \xt MRK 12:42; MRK 12:41; 2CO 8:12; EPH 4:28; MRK 12:44; 2CO 8:2\x*
\v 3 \w E|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Verdadeiramente|strong="G230"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w esta viúva pobre|strong="G3588,G5503,G4434,G3778"\w* \w lançou|strong="G906"\w* \w mais|strong="G4119"\w* \w do que todos|strong="G3956"\w*;\x - \xo 21:3 \xt MRK 12:43; MRK 12:41; 2CO 8:12; EPH 4:28; MRK 12:44; AMO 4:12\x*
\v 4 \w pois|strong="G1063"\w* \w todos estes|strong="G3956,G3778"\w* \w lançaram|strong="G906"\w* \w do que|strong="G1537,G3588"\w* \w lhes sobrava|strong="G4052,G846"\w* \w nas ofertas|strong="G1519,G3588,G1435"\w*, \w mas|strong="G1161"\w* \w ela|strong="G3778"\w*, \w da sua penúria|strong="G1537,G3588,G5303,G846"\w*, \w lançou|strong="G906"\w* \w todo o sustento|strong="G3956,G3588,G979"\w* \w que|strong="G3739"\w* \w tinha|strong="G2192"\w*.”\f + \fr 21.4: \ft Lit.: βίος, “vida, meio de vida”: aquilo de que ela vivia.\f*\f + \fr 21.4: \ft Variante: WH e NA28 leem πάντες; Treg e RP leem ἅπαντες. Treg e RP acrescentam τοῦ θεοῦ (“de Deus”) depois de “ofertas”, e RP lê ἅπαντα em lugar de πάντα.\f*\x - \xo 21:4 \xt MRK 12:44; MRK 12:41; 2CO 8:12; ACT 2:44-45; EPH 4:28; AMO 4:12\x*
\p
\v 5 \w E|strong="G2532"\w*, \w enquanto alguns|strong="G5100"\w* \w falavam|strong="G3004"\w* \w do templo|strong="G4012,G3588,G2411"\w*, \w que|strong="G3754"\w* \w estava adornado|strong="G2885"\w* \w com belas pedras|strong="G3037,G2570"\w* \w e|strong="G2532"\w* \w ofertas votivas|strong="G334"\w*, \w ele disse|strong="G2036"\w*:\f + \fr 21.5: \ft Lit.: ἀνάθημα, “oferta dedicada (votiva)”, colocada no templo.\f*\x - \xo 21:5 \xt MAT 24:1; AMO 4:12; ZEC 11:10; HAG 2:3; JHN 2:20; LUK 13:35\x*
\v 6 “\w Quanto a estas coisas|strong="G3778"\w* \w que vocês estão contemplando|strong="G3739,G2334"\w*, \w virão|strong="G2064"\w* \w dias|strong="G2250"\w* \w em que|strong="G1722,G3739"\w* \w não será deixada|strong="G3756,G863"\w* \w pedra|strong="G3037"\w* \w sobre pedra|strong="G1909,G3037"\w* \w que não seja derrubada|strong="G3739,G3756,G2647"\w*.”\f + \fr 21.6: \ft Variante: WH acrescenta ὧδε (“aqui”) depois de “pedra sobre pedra”; Treg, NA28 e RP não trazem.\f*\x - \xo 21:6 \xt MAT 24:2; MRK 13:2; MAT 24:1; LUK 19:44; AMO 4:12; PSA 137:3\x*
\v 7 \w Perguntaram-lhe|strong="G1905,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Mestre|strong="G1320"\w*, \w quando|strong="G4219"\w*, \w então|strong="G3767"\w*, \w serão|strong="G1510"\w* \w estas coisas|strong="G3778"\w*, \w e|strong="G2532"\w* \w qual é|strong="G5101"\w* \w o sinal|strong="G3588,G4592"\w* \w de quando|strong="G3752"\w* \w estas coisas|strong="G3778"\w* \w estiverem para|strong="G3195"\w* \w acontecer|strong="G1096"\w*?”\f + \fr 21.7: \ft Acréscimo: verbo ser/estar suprido em “qual é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 21:7 \xt MRK 13:4; MAT 24:1; MAT 24:3; AMO 4:12; ACT 1:6-7; MRK 13:14\x*
\v 8 \w Ele|strong="G3588"\w* \w disse|strong="G2036"\w*: “\w Cuidado|strong="G991"\w* \w para que não sejam enganados|strong="G3361,G4105"\w*; \w pois|strong="G1063"\w* \w muitos|strong="G4183"\w* \w virão|strong="G2064"\w* \w em meu nome|strong="G1909,G3588,G3686,G3165"\w*, \w dizendo|strong="G3004"\w*: ‘\w Eu sou|strong="G1473,G1510"\w*’ \w e|strong="G2532"\w*: ‘\w O tempo|strong="G3588,G2540"\w* \w está próximo|strong="G1448"\w*.’ \w Não vão|strong="G3361,G4198"\w* \w atrás deles|strong="G3694,G846"\w*\f + \fr 21.8: \ft Variante: Treg e RP acrescentam ὅτι (introdutor da fala) depois de “dizendo”; RP (e TR) acrescentam οὖν (“então”) depois de “não”.\f*.\x - \xo 21:8 \xt MAT 24:4; MRK 13:5; MRK 13:6; MAT 24:5; 1JN 4:1; GAL 6:7\x*
\v 9 \w Quando|strong="G3752"\w* \w ouvirem falar|strong="G191"\w* \w de guerras|strong="G4171"\w* \w e|strong="G2532"\w* \w de desordens|strong="G181"\w*, \w não se aterrorizem|strong="G3361,G4422"\w*; \w pois|strong="G1063"\w* \w é necessário|strong="G1163"\w* \w que estas coisas|strong="G3778"\w* \w aconteçam|strong="G1096"\w* \w primeiro|strong="G4413"\w*, \w mas|strong="G235"\w* \w o fim|strong="G3588,G5056"\w* \w não será|strong="G3756"\w* \w imediato|strong="G2112"\w*.”\f + \fr 21.9: \ft Acréscimo: verbo ser/estar suprido em “não será”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 21:9 \xt MAT 24:6; MRK 13:7; MAT 24:1; PSA 46:2; LUK 21:28; PRO 1:33\x*
\v 10 \w Então|strong="G5119"\w* \w lhes dizia|strong="G3004,G846"\w*: “\w Se levantará|strong="G1453"\w* \w nação|strong="G1484"\w* \w contra nação|strong="G1909,G1484"\w* \w e|strong="G2532"\w* \w reino|strong="G932"\w* \w contra reino|strong="G1909,G932"\w*,\x - \xo 21:10 \xt MRK 13:8; MAT 24:1; PSA 46:2; MRK 13:7; ACT 2:19-20; AMO 4:12\x*
\v 11 \w e|strong="G5037"\w* \w haverá|strong="G1510"\w* \w grandes|strong="G3173"\w* \w terremotos|strong="G4578"\w*, \w e|strong="G2532"\w* \w em vários lugares|strong="G2596,G5117"\w* \w fomes|strong="G3042"\w* \w e|strong="G2532"\w* \w pestes|strong="G3061"\w*; \w haverá|strong="G1510"\w* \w coisas aterradoras|strong="G5400"\w* \w e também|strong="G5037,G2532"\w* \w grandes|strong="G3173"\w* \w sinais|strong="G4592"\w* \w vindos do céu|strong="G575,G3772"\w*.\f + \fr 21.11: \ft Lit.: φόβητρον, “coisa que causa terror” (palavra rara).\f*\x - \xo 21:11 \xt MAT 24:7; MAT 24:1; PSA 46:2; JOL 2:30; REV 12:1; MRK 13:7\x*
\v 12 \w Antes|strong="G4253"\w* \w de tudo isso|strong="G3778,G3956"\w* \w lançarão|strong="G1911"\w* \w as suas mãos|strong="G3588,G5495,G846"\w* \w sobre vocês|strong="G1909,G4771"\w* \w e|strong="G2532"\w* \w os perseguirão|strong="G1377"\w*, \w entregando-os|strong="G3860"\w* \w às sinagogas|strong="G1519,G3588,G4864"\w* \w e|strong="G2532"\w* \w prisões|strong="G5438"\w*, \w levando-os|strong="G520"\w* \w diante de|strong="G1909"\w* \w reis|strong="G935"\w* \w e|strong="G2532"\w* \w governadores|strong="G2232"\w* \w por causa|strong="G1752"\w* \w do meu nome|strong="G3588,G3686,G3165"\w*;\x - \xo 21:12 \xt MAT 5:10; MAT 5:11; ISA 43:2; MAT 24:9; MAT 24:1; ROM 8:35\x*
\v 13 \w isso resultará|strong="G576"\w* \w para vocês|strong="G4771"\w* \w em testemunho|strong="G1519,G3142"\w*.\x - \xo 21:13 \xt ISA 43:2; MAT 24:1; ROM 8:35; MAT 10:19; AMO 4:12; LUK 12:11\x*
\v 14 \w Decidam|strong="G5087"\w*, \w então|strong="G3767"\w*, \w em seus corações|strong="G1722,G3588,G2588,G4771"\w* \w não ensaiar de antemão|strong="G3361,G4304"\w* \w a defesa|strong="G626"\w*,\f + \fr 21.14: \ft Lit.: θέτε ἐν ταῖς καρδίαις, literalmente “ponham nos corações”.\f*\x - \xo 21:14 \xt 1PE 3:15; PRO 16:1; ISA 43:2; MRK 13:11; EXO 4:12; MAT 24:1\x*
\v 15 \w pois|strong="G1063"\w* \w eu|strong="G1473"\w* \w lhes darei|strong="G1325,G4771"\w* \w capacidade de falar|strong="G4750"\w* \w e|strong="G2532"\w* \w sabedoria|strong="G4678"\w* \w à qual|strong="G3739"\w* \w não poderão|strong="G3756,G1410"\w* \w resistir|strong="G436"\w* \w nem|strong="G2228"\w* \w contradizer|strong="G471"\w* \w todos|strong="G537"\w* \w os que se opõem|strong="G3588,G480"\w* \w a vocês|strong="G4771"\w*.\f + \fr 21.15: \ft Lit.: στόμα, literalmente “boca”: capacidade de falar, palavras.\f*\x - \xo 21:15 \xt ACT 6:10; JER 1:9; ISA 50:4; 1PE 3:15; 2CO 12:9; EPH 6:19\x*
\v 16 \w Serão entregues|strong="G3860"\w* \w também|strong="G2532"\w* \w por pais|strong="G5259,G1118"\w* \w e|strong="G2532"\w* \w irmãos|strong="G80"\w* \w e|strong="G2532"\w* \w parentes|strong="G4773"\w* \w e|strong="G2532"\w* \w amigos|strong="G5384"\w*, \w e|strong="G2532"\w* \w matarão|strong="G2289"\w* \w alguns de vocês|strong="G1537,G4771"\w*,\x - \xo 21:16 \xt MAT 10:21; MRK 13:12; REV 2:10; MAT 24:9; ISA 43:2; MAT 10:35\x*
\v 17 \w e|strong="G2532"\w* \w serão odiados|strong="G1510,G3404"\w* \w por todos|strong="G5259,G3956"\w* \w por causa|strong="G1223"\w* \w do meu nome|strong="G3588,G3686,G3165"\w*.\x - \xo 21:17 \xt MAT 24:9; MRK 13:13; LUK 10:19; MAT 10:22; LUK 6:22; MAT 5:11\x*
\v 18 \w E|strong="G2532"\w* \w um fio de cabelo|strong="G2359"\w* \w da cabeça de vocês|strong="G1537,G3588,G2776,G4771"\w* \w de modo nenhum|strong="G3756,G3361"\w* \w se perderá|strong="G622"\w*.\x - \xo 21:18 \xt MAT 10:30; LUK 10:19; ACT 27:34; LUK 12:7; REV 2:10; ISA 43:2\x*
\v 19 \w Na perseverança|strong="G1722,G3588,G5281"\w* \w de vocês|strong="G4771"\w* \w ganhem|strong="G2932"\w* \w as suas vidas|strong="G3588,G5590,G4771"\w*.\x - \xo 21:19 \xt JAS 1:4; REV 2:10; HEB 10:36; JAS 1:3; MAT 10:22; 2PE 1:6\x*
\v 20 \w Quando|strong="G3752"\w* \w virem|strong="G1492"\w* \w Jerusalém|strong="G2419"\w* \w cercada|strong="G2944"\w* \w por exércitos|strong="G5259,G4760"\w*, \w então|strong="G5119"\w* \w saibam|strong="G1097"\w* \w que|strong="G3754"\w* \w a sua desolação|strong="G3588,G2050,G846"\w* \w está próxima|strong="G1448"\w*.\x - \xo 21:20 \xt MAT 24:15; MRK 13:14; LUK 19:43; MAT 24:1; DAN 9:27; ZEC 14:2\x*
\v 21 \w Então|strong="G5119"\w* \w os que estão|strong="G3588,G1722"\w* \w na Judeia|strong="G3588,G2449"\w* \w fujam|strong="G5343"\w* \w para os montes|strong="G1519,G3588,G3735"\w*, \w e|strong="G2532"\w* \w os que estão|strong="G3588,G1722"\w* \w no meio|strong="G3319"\w* \w dela|strong="G846"\w* \w saiam|strong="G1633"\w*, \w e|strong="G2532"\w* \w os que estão|strong="G3588,G1722"\w* \w nos campos|strong="G3588,G5561"\w* \w não entrem|strong="G3361,G1525"\w* \w nela|strong="G1519,G846"\w*,\f + \fr 21.21: \ft Acréscimo: “os que estão”, “os que estão”, “os que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 21:21 \xt MAT 24:16; MRK 13:14; MAT 24:1; ZEC 14:2; LUK 19:43; AMO 4:12\x*
\v 22 \w porque|strong="G3754"\w* \w estes|strong="G3778"\w* \w são|strong="G1510"\w* \w dias|strong="G2250"\w* \w de retribuição|strong="G1557"\w*, \w para que se cumpra|strong="G3588,G4130"\w* \w tudo o que|strong="G3956,G3588"\w* \w está escrito|strong="G1125"\w*.\f + \fr 21.22: \ft Lit.: ἐκδίκησις, “vingança, retribuição, justiça que restabelece o direito”.\f*\x - \xo 21:22 \xt MAT 24:1; ZEC 14:2; HOS 9:7; ISA 4:1; LUK 19:27; LUK 19:43\x*
\v 23 \w Ai|strong="G3759"\w* \w das que|strong="G3588"\w* \w estiverem grávidas|strong="G1722,G1064,G2192"\w* \w e|strong="G2532"\w* \w das que|strong="G3588"\w* \w estiverem amamentando|strong="G2337"\w* \w naqueles dias|strong="G1722,G1565,G3588,G2250"\w*! \w Pois|strong="G1063"\w* \w haverá|strong="G1510"\w* \w grande|strong="G3173"\w* \w angústia|strong="G318"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w e|strong="G2532"\w* \w ira|strong="G3709"\w* \w contra este povo|strong="G3588,G2992,G3778"\w*,\x - \xo 21:23 \xt MAT 24:19; MRK 13:17; MAT 24:1; DAN 12:1; ZEC 14:2; LUK 19:43\x*
\v 24 \w e|strong="G2532"\w* \w cairão|strong="G4098"\w* \w a fio|strong="G4750"\w* \w de espada|strong="G3162"\w*, \w e|strong="G2532"\w* \w serão levados cativos|strong="G163"\w* \w para todas as nações|strong="G1519,G3588,G1484,G3956"\w*, \w e|strong="G2532"\w* \w Jerusalém|strong="G2419"\w* \w será pisada|strong="G1510,G3961"\w* \w por gentios|strong="G5259,G1484"\w*, \w até que|strong="G891,G3739"\w* \w se cumpram|strong="G4137"\w* \w os tempos|strong="G2540"\w* \w dos gentios|strong="G1484"\w*.\f + \fr 21.24: \ft Lit.: ἔθνη, “nações” ou “gentios” (não judeus), conforme o contexto.\f*\f + \fr 21.24: \ft Variante: RP inverte a ordem (πάντα τὰ ἔθνη) e omite οὗ depois de ἄχρι; WH acrescenta καὶ ἔσονται (“e serão”) depois de “se cumpram”.\f*\x - \xo 21:24 \xt ROM 11:25; REV 11:2; ISA 63:18; DAN 12:7; MAT 24:1; DAN 12:1\x*
\v 25 \w E|strong="G2532"\w* \w haverá|strong="G1510"\w* \w sinais|strong="G4592"\w* \w no sol|strong="G1722,G2246"\w* \w e|strong="G2532"\w* \w na lua|strong="G4582"\w* \w e|strong="G2532"\w* \w nas estrelas|strong="G798"\w*, \w e|strong="G2532"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w angústia|strong="G4928"\w* \w das nações|strong="G1484"\w* \w em perplexidade|strong="G1722,G640"\w* \w diante do estrondo|strong="G2279"\w* \w do mar|strong="G2281"\w* \w e|strong="G2532"\w* \w das ondas|strong="G4535"\w*,\f + \fr 21.25: \ft Lit.: σάλος, “agitação, balanço” (do mar).\f*\x - \xo 21:25 \xt ISA 13:10; JER 4:23; JOL 2:30; REV 12:1; REV 6:12-14; DAN 12:1\x*
\v 26 \w com pessoas|strong="G444"\w* \w desfalecendo|strong="G674"\w* \w de medo|strong="G575,G5401"\w* \w e|strong="G2532"\w* \w de expectativa|strong="G4329"\w* \w do que está vindo|strong="G3588,G1904"\w* \w sobre o mundo habitado|strong="G3588,G3625"\w*; \w pois|strong="G1063"\w* \w os poderes|strong="G3588,G1411"\w* \w dos céus|strong="G3588,G3772"\w* \w serão abalados|strong="G4531"\w*.\x - \xo 21:26 \xt MRK 13:25; JER 4:23; MAT 24:1; GEN 1:14; JER 10:2; MAT 24:29\x*
\v 27 \w E|strong="G2532"\w* \w então|strong="G5119"\w* \w verão|strong="G3700"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w* \w vindo|strong="G2064"\w* \w numa nuvem|strong="G1722,G3507"\w* \w com poder|strong="G3326,G1411"\w* \w e|strong="G2532"\w* \w muita|strong="G4183"\w* \w glória|strong="G1391"\w*.\f + \fr 21.27: \ft Nota cultural: imagem que lembra Daniel 7:13.\f*\x - \xo 21:27 \xt DAN 7:13; MRK 13:26; MAT 24:30; MAT 26:64; REV 1:7; MRK 14:62\x*
\v 28 \w Ao começarem|strong="G757"\w* \w estas coisas|strong="G3778"\w* \w a acontecer|strong="G1096"\w*, \w levantem-se|strong="G352"\w* \w e|strong="G2532"\w* \w ergam|strong="G1869"\w* \w as suas cabeças|strong="G3588,G2776,G4771"\w*, \w porque|strong="G1360"\w* \w a sua redenção|strong="G3588,G629,G4771"\w* \w se aproxima|strong="G1448"\w*.”\x - \xo 21:28 \xt ROM 13:11; MAT 24:1; LUK 21:9; JER 10:2; MAT 16:28; ROM 8:23\x*
\p
\v 29 \w E|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w* \w uma parábola|strong="G3850"\w*: “\w Vejam|strong="G1492"\w* \w a figueira|strong="G3588,G4808"\w* \w e|strong="G2532"\w* \w todas as árvores|strong="G3956,G3588,G1186"\w*:\x - \xo 21:29 \xt MAT 24:1; MAT 24:32; MRK 13:28; AMO 4:12\x*
\v 30 \w quando|strong="G3752"\w* \w já brotarem|strong="G4261,G2235"\w*, \w vendo isso|strong="G991"\w*, \w vocês sabem|strong="G1097"\w* \w por si mesmos|strong="G575,G1438"\w* \w que|strong="G3754"\w* \w o verão|strong="G3588,G2330"\w* \w já|strong="G2235"\w* \w está perto|strong="G1451,G1510"\w*.\x - \xo 21:30 \xt MAT 24:32; MRK 13:28; MAT 24:1; AMO 4:12; LUK 12:57\x*
\v 31 \w Assim|strong="G3779"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w*, \w quando virem|strong="G3752,G1492"\w* \w estas coisas|strong="G3778"\w* \w acontecendo|strong="G1096"\w*, \w vocês sabem|strong="G1097"\w* \w que|strong="G3754"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w está perto|strong="G1451,G1510"\w*.\f + \fr 21.31: \ft Lit.: γινώσκετε, “vocês sabem” (indicativo) ou “saibam” (imperativo): a mesma forma nos vv. 30 e 31.\f*\x - \xo 21:31 \xt MRK 13:29; MAT 24:33; JAS 5:9; MAT 24:1; HEB 10:37; MRK 13:28\x*
\v 32 \w Em verdade|strong="G281"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w de modo nenhum|strong="G3756,G3361"\w* \w passará|strong="G3928"\w* \w esta geração|strong="G3588,G1074,G3778"\w* \w até que|strong="G2193,G302"\w* \w tudo|strong="G3956"\w* \w aconteça|strong="G1096"\w*.\f + \fr 21.32: \ft Lit.: γενεά, “geração”; também “raça, linhagem”.\f*\x - \xo 21:32 \xt MAT 24:34; MRK 13:30; MAT 5:18; MAT 23:36; MAT 16:28; MAT 24:1\x*
\v 33 \w O céu|strong="G3588,G3772"\w* \w e|strong="G2532"\w* \w a terra|strong="G3588,G1093"\w* \w passarão|strong="G3928"\w*, \w mas|strong="G1161"\w* \w as minhas palavras|strong="G3588,G3056,G3165"\w* \w de modo nenhum|strong="G3756,G3361"\w* \w passarão|strong="G3928"\w*.\x - \xo 21:33 \xt MRK 13:31; MAT 24:35; MAT 5:18; LUK 16:17; NUM 23:19; ISA 40:8\x*
\p
\v 34 \w Cuidem de vocês mesmos|strong="G4337,G1438"\w* \w para que nunca|strong="G4218,G3361"\w* \w se tornem pesados|strong="G916"\w* \w os corações de vocês|strong="G4771,G3588,G2588"\w* \w com dissipação|strong="G1722,G2897"\w* \w e|strong="G2532"\w* \w embriaguez|strong="G3178"\w* \w e|strong="G2532"\w* \w preocupações|strong="G3308"\w* \w da vida|strong="G982"\w*, \w e|strong="G2532"\w* \w venha|strong="G2186"\w* \w sobre vocês|strong="G1909,G4771"\w* \w de repente|strong="G160"\w* \w aquele dia|strong="G3588,G2250,G1565"\w*\f + \fr 21.34: \ft Lit.: κραιπάλη, “náusea ou excesso por bebida”: dissipação, libertinagem.\f*\x - \xo 21:34 \xt HEB 12:1; 1PE 5:8; 1TH 5:3; 1PE 4:7; MRK 4:19; 1PE 1:13\x*
\v 35 \w como|strong="G5613"\w* \w uma armadilha|strong="G3803"\w*. \w Pois|strong="G1063"\w* \w virá|strong="G6036"\w* \w sobre|strong="G1909"\w* \w todos|strong="G3956"\w* \w os que habitam|strong="G3588,G2521"\w* \w sobre a face|strong="G1909,G4383"\w* \w de toda a terra|strong="G3956,G3588,G1093"\w*.\x - \xo 21:35 \xt 1TH 5:3; 1PE 1:13; LUK 12:40; MAT 24:1; ECC 9:12; LUK 22:46\x*
\v 36 \w Vigiem|strong="G69"\w* \w em todo tempo|strong="G1722,G3956,G2540"\w*, \w suplicando|strong="G1189"\w* \w para que tenham força|strong="G2443,G2729"\w* \w de escapar|strong="G1628"\w* \w de todas estas coisas|strong="G3778,G3956"\w* \w que estão para|strong="G3588,G3195"\w* \w acontecer|strong="G1096"\w*, \w e|strong="G2532"\w* \w de ficar em pé|strong="G2476"\w* \w diante do Filho do Homem|strong="G1715,G3588,G5207,G444"\w*.”\f + \fr 21.36: \ft Variante: RP lê οὖν em lugar de δὲ, καταξιωθῆτε (“sejam considerados dignos”) em lugar de κατισχύσητε (“tenham força”) e omite ταῦτα.\f*\x - \xo 21:36 \xt EPH 6:18; MRK 13:33; 1TH 5:17; 1PE 5:8; 1JN 2:28; LUK 18:1\x*
\p
\v 37 \w Estava|strong="G1510"\w* \w durante os dias|strong="G3588,G2250"\w* \w no templo|strong="G1722,G3588,G2411"\w* \w ensinando|strong="G1321"\w*, \w nas noites|strong="G3588,G3571"\w*, \w saindo|strong="G1831"\w*, \w pernoitava|strong="G835"\w* \w no monte|strong="G1519,G3588,G3735"\w* \w chamado|strong="G3588,G2564"\w* \w das Oliveiras|strong="G1638"\w*.\x - \xo 21:37 \xt ACT 1:12; MAT 21:17; ACT 5:42; JHN 18:20; LUK 22:39; MRK 11:19\x*
\v 38 \w E|strong="G2532"\w* \w todo o povo|strong="G3956,G3588,G2992"\w* \w vinha cedo|strong="G3719"\w* \w a ele|strong="G4314,G846"\w* \w no templo|strong="G1722,G3588,G2411"\w* \w para ouvi-lo|strong="G191,G846"\w*.\x - \xo 21:38 \xt LUK 19:47; ACT 5:20; JHN 8:1-2; MRK 11:11\x*
\c 22
\p
\v 1 \w Aproximava-se|strong="G1448,G1161"\w* \w a festa|strong="G3588,G1859"\w* \w dos Pães sem Fermento|strong="G3588,G106"\w*, \w chamada|strong="G3588,G3004"\w* \w Páscoa|strong="G3957"\w*.\x - \xo 22:1 \xt LUK 22:7; MRK 14:1; JHN 6:4; EXO 12:6-23; LEV 23:5-6; MAT 26:2\x*
\v 2 \w E|strong="G2532"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os escribas|strong="G3588,G1122"\w* \w procuravam|strong="G2212"\w* \w um modo de|strong="G3588,G4459"\w* \w matá-lo|strong="G337,G846"\w*, \w pois|strong="G1063"\w* \w temiam|strong="G5399"\w* \w o povo|strong="G3588,G2992"\w*.\x - \xo 22:2 \xt LUK 20:19; LUK 19:47; MRK 14:1; MRK 11:18; MIC 2:1; EPH 2:2\x*
\p
\v 3 \w Então|strong="G1161"\w* \w Satanás|strong="G4567"\w* \w entrou|strong="G1525"\w* \w em Judas|strong="G1519,G2455"\w*, \w o chamado|strong="G3588,G2564"\w* \w Iscariotes|strong="G2469"\w*, \w que era|strong="G1510"\w* \w do grupo|strong="G1537,G3588,G706"\w* \w dos doze|strong="G3588,G1427"\w*.\x - \xo 22:3 \xt MAT 26:14; MRK 14:10; JHN 13:2; LUK 6:16; JHN 13:26; MAT 10:4\x*
\v 4 \w E|strong="G2532"\w*, \w depois de sair|strong="G565"\w*, \w ele conversou|strong="G4814"\w* \w com os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os comandantes da guarda|strong="G4755"\w* \add sobre\add* \w como o entregaria|strong="G3588,G4459,G3860,G846"\w* \w a eles|strong="G846"\w*.\f + \fr 22.4: \ft Acréscimo: “sobre” (em “da guarda sobre como o”): preposição ou artigo que a regência do português exige.\f*\x - \xo 22:4 \xt ACT 5:24; MRK 14:10; MAT 26:14; ACT 4:1; MIC 2:1; ZEC 11:12\x*
\v 5 \w E|strong="G2532"\w* \add eles\add* \w se alegraram|strong="G5463"\w* \w e|strong="G2532"\w* \w concordaram|strong="G4934"\w* \w em lhe dar|strong="G846,G1325"\w* \w dinheiro|strong="G694"\w*.\f + \fr 22.5: \ft Acréscimo: “eles” (em “E eles se alegraram”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 22:5 \xt MAT 26:14; 1CO 13:6; MRK 14:10; MIC 2:1; ZEC 11:12; PSA 56:5\x*
\v 6 \w Ele concordou|strong="G2532,G1843"\w* \w e|strong="G2532"\w* \w buscava|strong="G2212"\w* \w uma oportunidade|strong="G2120"\w* \w para entregá-lo|strong="G3588,G3860,G846"\w* \w a eles|strong="G846"\w* \w sem a presença da multidão|strong="G817,G3793"\w*.\x - \xo 22:6 \xt MAT 26:16; MAT 26:14; MRK 14:10; MIC 2:1; ZEC 11:12; PSA 56:5\x*
\p
\v 7 \w Chegou|strong="G2064,G1161"\w* \w o dia|strong="G3588,G2250"\w* \w dos Pães sem Fermento|strong="G3588,G106"\w*, \w no qual|strong="G3739"\w* \w era necessário|strong="G1163"\w* \w sacrificar|strong="G2380"\w* \w o cordeiro da Páscoa|strong="G3588,G3957"\w*.\x - \xo 22:7 \xt MRK 14:12; LUK 22:1; 1CO 5:7; MAT 26:17; EXO 12:18; EXO 23:15\x*
\v 8 \w E|strong="G2532"\w* \add Jesus\add* \w enviou|strong="G649"\w* \w Pedro|strong="G4074"\w* \w e|strong="G2532"\w* \w João|strong="G2491"\w*, \w dizendo|strong="G2036"\w*: “\w Vão|strong="G4198"\w* \add e\add* \w preparem|strong="G2090"\w* \w para nós|strong="G3165"\w* \w a Páscoa|strong="G3588,G3957"\w*, \w para que|strong="G2443"\w* \w comamos|strong="G5315"\w*.”\f + \fr 22.8: \ft Acréscimo: “Jesus” (em “E Jesus enviou Pedro”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; “e” (em “dizendo Vão e preparem para”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 22:8 \xt MAT 26:17; ACT 3:1; LUK 19:30; MRK 14:13-16; DEU 16:2\x*
\v 9 \w Eles|strong="G3588,G1161"\w* \w lhe disseram|strong="G2036,G846"\w*: “\w Onde|strong="G4226"\w* \w você quer|strong="G2309"\w* \add que\add* \w preparemos|strong="G2090"\w*?”\f + \fr 22.9: \ft Acréscimo: “que” (em “você quer que preparemos”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 22:9 \xt MAT 26:17; MRK 14:12; LUK 19:30\x*
\v 10 \w Ele|strong="G3588,G1161"\w* \w lhes respondeu|strong="G2036,G846"\w*: “\w Olhem|strong="G2400"\w*, \w quando vocês entrarem|strong="G1525,G4771"\w* \w na cidade|strong="G1519,G3588,G4172"\w*, \w um homem|strong="G444"\w* \w carregando|strong="G941"\w* \w um jarro|strong="G2765"\w* \w de água|strong="G5204"\w* \w se encontrará|strong="G4876"\w* \w com vocês|strong="G4771"\w*. \w Sigam-no|strong="G190,G846"\w* \w até a casa|strong="G1519,G3588,G3614"\w* \w em que|strong="G1519,G3739"\w* \w ele entrar|strong="G1531"\w*.\x - \xo 22:10 \xt MRK 14:13; MAT 26:17; ACT 8:26-29; JHN 16:4; MAT 26:18; 1SA 10:2-7\x*
\v 11 \w E|strong="G2532"\w* \w digam|strong="G4483"\w* \w ao dono|strong="G3588,G3617"\w* \w da casa|strong="G3588,G3614"\w*: ‘\w O Mestre|strong="G3588,G1320"\w* \w lhe diz|strong="G3004,G4771"\w*: \w Onde|strong="G4226"\w* \w está|strong="G1510"\w* \w o aposento|strong="G3588,G2646"\w* \w em que|strong="G3699"\w* \w comerei|strong="G5315"\w* \w a Páscoa|strong="G3588,G3957"\w* \w com os meus discípulos|strong="G3326,G3588,G3101,G3165"\w*?’\x - \xo 22:11 \xt MRK 14:14; MAT 26:17; MAT 26:18; LUK 19:30; JHN 11:28; MRK 14:13\x*
\v 12 \add E\add* \w ele|strong="G1565,G2532"\w* \w lhes mostrará|strong="G4771,G1166"\w* \w uma sala no andar superior|strong="G508"\w*, \w grande|strong="G3173"\w* \add e\add* \w mobiliada|strong="G4766"\w*; \w preparem|strong="G2090"\w* \w ali|strong="G1563"\w*.”\f + \fr 22.12: \ft Acréscimo: “E” (em “E ele lhes”), “e” (em “superior grande e mobiliada preparem”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 22:12 \xt MRK 14:15; ACT 1:13; MAT 26:17; MAT 26:18; ACT 20:8; LUK 19:30\x*
\v 13 \w Então|strong="G1161"\w* \w eles foram|strong="G565"\w* \add e\add* \w encontraram|strong="G2147"\w* \add tudo\add* \w conforme|strong="G2531"\w* \w ele lhes havia dito|strong="G2036,G846"\w*; \w e|strong="G2532"\w* \w prepararam|strong="G2090"\w* \w a Páscoa|strong="G3588,G3957"\w*.\f + \fr 22.13: \ft Acréscimo: “e” (em “eles foram e encontraram tudo”): conectivo acrescentado para ligar as orações em português; “tudo” (em “e encontraram tudo conforme ele”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 22:13 \xt MRK 14:16; LUK 19:32; MAT 26:17; MAT 26:19; MAT 26:18; LUK 19:30\x*
\p
\v 14 \w E|strong="G2532"\w*, \w quando|strong="G3753"\w* \w chegou|strong="G1096"\w* \w a hora|strong="G3588,G5610"\w*, \add Jesus\add* \w se reclinou à mesa|strong="G377"\w*, \w e|strong="G2532"\w* \w os apóstolos|strong="G3588,G652"\w* \w com ele|strong="G4862,G846"\w*.\f + \fr 22.14: \ft Variante: O RP explicita “os doze apóstolos”; o texto-base traz apenas “os apóstolos”.\f*\f + \fr 22.14: \ft Acréscimo: “Jesus” (em “a hora Jesus se reclinou”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 22:14 \xt MAT 26:20; MRK 14:17; DEU 16:6-7\x*
\v 15 \w E|strong="G2532"\w* \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Desejei intensamente|strong="G1939,G1937"\w* \w comer|strong="G5315"\w* \w esta Páscoa|strong="G3778,G3588,G3957"\w* \w com vocês|strong="G3326,G4771"\w* \w antes|strong="G4253"\w* \w de eu sofrer|strong="G3588,G3165,G3958"\w*.\x - \xo 22:15 \xt LUK 12:50; MAT 26:29; JHN 4:34; 1TH 2:17; DEU 16:2; JHN 13:1\x*
\v 16 \w Pois|strong="G1063"\w* \w digo a vocês|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w de modo nenhum|strong="G3756,G3361"\w* \w a comerei|strong="G5315,G846"\w* \w até|strong="G2193,G3748"\w* \w que se cumpra|strong="G4137"\w* \w no reino|strong="G1722,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.”\f + \fr 22.16: \ft Variante: Treg e RP acrescentam “não mais” e leem “dela” em vez de “a”.\f*\x - \xo 22:16 \xt LUK 14:15; MAT 26:29; LUK 22:18; REV 19:9; LUK 22:30; 1CO 5:7-8\x*
\v 17 \w E|strong="G2532"\w*, \w recebendo um cálice|strong="G1209,G4221"\w* \add e dando\add* \w graças|strong="G2168"\w*, \w disse|strong="G2036"\w*: “\w Peguem|strong="G2983"\w* \w isto|strong="G3778"\w* \w e|strong="G2532"\w* \w repartam entre vocês|strong="G1266,G1519,G1438"\w*.\f + \fr 22.17: \ft Acréscimo: “e” (em “um cálice e dando graças”): conectivo acrescentado para ligar as orações em português; “dando” (em “cálice e dando graças disse”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 22:17 \xt MRK 14:23; MAT 26:27; LUK 22:42; MAT 26:29; LUK 22:19; PSA 116:13\x*
\v 18 \w Pois|strong="G1063"\w* \w digo a vocês|strong="G3004,G4771"\w*: \w de modo nenhum|strong="G3756,G3361"\w* \w beberei|strong="G4095"\w*, \w de agora em diante|strong="G575,G3588,G3568"\w*, \w do fruto|strong="G575,G3588,G6013"\w* \w da videira|strong="G3588,G288"\w* \w até|strong="G2193,G3739"\w* \w que venha|strong="G2064"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*\f + \fr 22.18: \ft Variante: O RP introduz a declaração com “que”, omite “de agora em diante” e traz uma forma equivalente de “até que”.\f*.”\x - \xo 22:18 \xt MAT 26:29; MRK 14:25; MAT 26:26; LUK 22:42; MRK 9:1; ISA 55:1\x*
\v 19 \w E|strong="G2532"\w*, \w tomando|strong="G2983"\w* \w pão|strong="G740"\w*, \w deu graças|strong="G2168"\w*, \w partiu-o|strong="G2806"\w* \w e|strong="G2532"\w* \w o deu|strong="G1325"\w* \w a eles|strong="G846"\w*, \w dizendo|strong="G3004"\w*: “\w Isto|strong="G3778"\w* \w é|strong="G1510"\w* \w o meu corpo|strong="G3588,G4983,G3165"\w*, \w que é dado|strong="G3588,G1325"\w* \w em favor de vocês|strong="G5228,G4771"\w*. \w Façam|strong="G4160"\w* \w isto|strong="G3778"\w* \w em minha memória|strong="G1519,G3588,G1473,G364"\w*.”\f + \fr 22.19: \ft Variante: A sequência de 22:19b–20 está entre colchetes no texto-base; WH a omite, enquanto Treg, NA28 e RP a trazem.\f*\f + \fr 22.19: \ft Lit.: ἐστιν, “é”: o sentido do “é” (identidade, representação, presença) é discutido entre as tradições.\f*\x - \xo 22:19 \xt 1CO 11:24; MRK 14:22; MAT 26:26; MAT 15:36; 1CO 10:16; LUK 24:30\x*
\v 20 \w E|strong="G2532"\w*, \w do mesmo modo|strong="G5615"\w*, \w depois da ceia|strong="G3326,G3588,G1172"\w*, \add tomou\add* \w o cálice|strong="G3588,G4221"\w*, \w dizendo|strong="G3004"\w*: “\w Este|strong="G3778"\w* \w cálice|strong="G3588,G4221"\w* \add é\add* \w a nova aliança|strong="G3588,G2537,G1242"\w* \w no meu sangue|strong="G1722,G3588,G129,G3165"\w*, \w derramado|strong="G3588,G1632"\w* \w em favor de vocês|strong="G5228,G4771"\w*.\f + \fr 22.20: \ft Acréscimo: “tomou” (em “da ceia tomou o cálice”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; “é” (em “Este cálice é a nova”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 22:20 \xt 1CO 11:25; MAT 26:28; MRK 14:24; JER 31:31; MAT 26:26; 1CO 11:23\x*
\v 21 \w Mas|strong="G4133"\w* \w olhem|strong="G2400"\w*: \w a mão|strong="G3588,G5495"\w* \w daquele que me entrega|strong="G3588,G3860,G3165"\w* \add está\add* \w comigo à mesa|strong="G3326,G1473,G1909,G3588,G5132"\w*.\f + \fr 22.21: \ft Acréscimo: “está” (em “me entrega está comigo à”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 22:21 \xt PSA 41:9; JHN 13:26; LUK 22:3; JHN 13:18-19; JHN 13:21; MRK 14:17\x*
\v 22 \w Pois|strong="G3754"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w*, \add de\add* \w fato|strong="G3303"\w*, \w vai|strong="G4198"\w* \w conforme o que foi determinado|strong="G2596,G3588,G3724"\w*; \w mas|strong="G4133"\w* \w ai|strong="G3759"\w* \w daquele homem|strong="G3588,G444,G1565"\w* \w por meio de quem|strong="G1223,G3739"\w* \w ele é entregue|strong="G3860"\w*!”\f + \fr 22.22: \ft Acréscimo: “de” (em “do Homem de fato vai”): preposição ou artigo que a regência do português exige.\f*\x - \xo 22:22 \xt MAT 26:24; ACT 2:23; PSA 2:1; JHN 13:21; LUK 22:37; LUK 24:25-27\x*
\v 23 \w E|strong="G2532"\w* \w eles|strong="G846"\w* \w começaram|strong="G757"\w* \w a discutir|strong="G4802"\w* \w entre si|strong="G4314,G1438"\w* \w qual deles|strong="G3588,G5101,G686,G1537,G846"\w* \w seria|strong="G1510"\w* \w aquele que|strong="G3588"\w* \w estava para|strong="G3195"\w* \w fazer|strong="G4238"\w* \w isso|strong="G3778"\w*.\x - \xo 22:23 \xt PSA 2:1; JHN 13:22; MRK 14:17; MAT 26:22\x*
\p
\v 24 \w Surgiu|strong="G1096,G1161"\w* \w também|strong="G2532"\w* \w uma disputa|strong="G5379"\w* \w entre eles|strong="G1722,G846"\w* \add sobre\add* \w qual deles|strong="G3588,G5101,G846"\w* \w era considerado|strong="G1380,G1511"\w* \w o maior|strong="G3173"\w*.\f + \fr 22.24: \ft Acréscimo: “sobre” (em “entre eles sobre qual deles”): preposição ou artigo que a regência do português exige.\f*\x - \xo 22:24 \xt GAL 6:3; MAT 18:1; 3JN 1:9; LUK 9:46; ROM 12:16; 1PE 5:3\x*
\v 25 \w Então|strong="G1161"\w* \w ele lhes disse|strong="G3588,G2036,G846"\w*: “\w Os reis|strong="G3588,G935"\w* \w das nações|strong="G3588,G1484"\w* \w dominam|strong="G2961"\w* \w sobre elas|strong="G846"\w*, \w e|strong="G2532"\w* \w os que exercem autoridade|strong="G3588,G1850"\w* \w sobre elas|strong="G846"\w* \w são chamados|strong="G2564"\w* \w benfeitores|strong="G2110"\w*.\x - \xo 22:25 \xt MAT 20:25; MAT 18:1; MRK 10:42; 3JN 1:9; ROM 12:16; 1PE 5:3\x*
\v 26 \w Vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w não ajam|strong="G3756"\w* \w assim|strong="G3779"\w*. \w Pelo contrário|strong="G235"\w*, \w o maior|strong="G3588,G3173"\w* \w entre vocês|strong="G1722,G4771"\w* \w se torne|strong="G1096"\w* \w como|strong="G5613"\w* \w o mais jovem|strong="G3588,G3501"\w*, \w e|strong="G2532"\w* \w aquele que lidera|strong="G3588,G2233"\w* \w como|strong="G5613"\w* \w o que serve|strong="G3588,G1247"\w*.\x - \xo 22:26 \xt MAT 20:25; MRK 10:45; MRK 9:35; MAT 23:11; JHN 13:14; MAT 18:1\x*
\v 27 \w Pois|strong="G1063"\w* \w quem|strong="G5101"\w* \add é\add* \w o maior|strong="G3173"\w*: \w o que está à mesa|strong="G3588,G345"\w* \w ou|strong="G2228"\w* \w o que serve|strong="G3588,G1247"\w*? \w Não é|strong="G3780"\w* \w o que está à mesa|strong="G3588,G345"\w*? \w Eu|strong="G1473"\w*, \w porém|strong="G1161"\w*, \w estou|strong="G1510"\w* \w entre vocês|strong="G1722,G3319,G4771"\w* \w como|strong="G5613"\w* \w aquele que serve|strong="G3588,G1247"\w*.\f + \fr 22.27: \ft Acréscimo: “é” (em “Pois quem é o maior”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige; verbo ser/estar suprido em “Não é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:27 \xt JHN 12:2; MAT 20:28; PHP 2:5; MAT 20:25; PHP 2:7; MRK 10:45\x*
\v 28 \add E\add* \w vocês|strong="G4771,G1161"\w* \w são|strong="G1510"\w* \w os que permaneceram|strong="G3588,G1265"\w* \w comigo|strong="G3326,G1473"\w* \w nas minhas provações|strong="G1722,G3588,G3986,G3165"\w*.\f + \fr 22.28: \ft Acréscimo: “E” (em “E vocês são”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 22:28 \xt JAS 1:12; MAT 19:28; JHN 17:24; MAT 25:21; ACT 14:22; HEB 4:15\x*
\v 29 \add E\add* \w eu|strong="G2532,G1473"\w* \w concedo a vocês|strong="G1303,G4771"\w* \w um reino|strong="G932"\w*, \add assim\add* \w como|strong="G2531"\w* \w meu Pai|strong="G3588,G3962,G3165"\w* \w o concedeu a mim|strong="G1303,G3165"\w*,\f + \fr 22.29: \ft Lit.: διατίθεμαι e διέθετο podem significar “dispor por aliança” ou “conceder”.\f*\f + \fr 22.29: \ft Acréscimo: “E” (em “E eu concedo”), “assim” (em “um reino assim como meu”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 22:29 \xt JAS 1:12; MAT 19:28; 2TI 2:12; MAT 25:34; JHN 17:24; MAT 25:21\x*
\v 30 \w para que|strong="G2443"\w* \w comam|strong="G2068"\w* \w e|strong="G2532"\w* \w bebam|strong="G4095"\w* \w à minha mesa|strong="G1909,G3588,G5132,G3165"\w* \w no meu reino|strong="G1722,G3588,G932,G3165"\w* \w e|strong="G2532"\w* \w se sentem|strong="G2521"\w* \w em tronos|strong="G1909,G2362"\w*, \w julgando|strong="G2919"\w* \w as doze tribos|strong="G3588,G1427,G5443"\w* \w de Israel|strong="G3588,G2474"\w*.\f + \fr 22.30: \ft Variante: O RP omite “no meu reino”; outras diferenças do aparato alteram a forma verbal e a ordem, sem mudar o núcleo da afirmação.\f*\x - \xo 22:30 \xt MAT 19:28; 1CO 6:2; JAS 1:12; REV 3:21; JHN 17:24; MAT 25:21\x*
\p
\v 31 \w Simão|strong="G4613"\w*, \w Simão|strong="G4613"\w*, \w olhe|strong="G2400"\w*: \w Satanás|strong="G3588,G4567"\w* \w exigiu|strong="G1809"\w* \w ter vocês|strong="G4771"\w* \w para peneirá-los|strong="G3588,G4617"\w* \w como|strong="G5613"\w* \w o trigo|strong="G3588,G4621"\w*.\f + \fr 22.31: \ft Lit.: O pronome “vocês” é plural; a fala passa ao singular no verso seguinte.\f*\x - \xo 22:31 \xt 1PE 5:8; ZEC 3:1; 1CO 10:13; 2CO 2:11; JOB 1:6-12; PSA 31:24\x*
\v 32 \w Eu|strong="G1473"\w*, \w porém|strong="G1161"\w*, \w roguei|strong="G1189"\w* \w por você|strong="G4012,G4771"\w*, \w para que|strong="G2443"\w* \w a sua fé|strong="G3588,G4102,G4771"\w* \w não desfaleça|strong="G3361,G1587"\w*; \w e|strong="G2532"\w* \w você|strong="G4771"\w*, \w quando|strong="G4218"\w* \w tiver voltado|strong="G1994"\w*, \w fortaleça|strong="G4741"\w* \w os seus irmãos|strong="G3588,G80,G4771"\w*.”\f + \fr 22.32: \ft Tradução: ἐπιστρέψας, “tendo voltado”: pode ser “quando se voltar” ou “depois de se recuperar”; στήριξον, “fortaleça”: o interlocutor passa de “vocês” (v. 31) para “você” (singular); ver a nota de 22:31.\f*\x - \xo 22:32 \xt 1SA 23:16; 1PE 5:10; 1CO 10:13; JHN 21:15; 1PE 5:8-10; JHN 17:9\x*
\v 33 \w Ele|strong="G3588,G1161"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Senhor|strong="G2962"\w*, \w estou pronto|strong="G2092,G1510"\w* \w para ir|strong="G4198"\w* \w com você|strong="G3326,G4771"\w* \w tanto|strong="G2532"\w* \w para a prisão|strong="G1519,G5438"\w* \w como|strong="G2532"\w* \w para a morte|strong="G1519,G2288"\w*.”\x - \xo 22:33 \xt 1PE 3:19; MRK 14:31; MAT 26:33; ACT 12:4; MAT 8:19; JHN 13:36-37\x*
\v 34 \add Mas\add* \w ele|strong="G3588,G1161"\w* \w disse|strong="G2036"\w*: “\w Eu lhe digo|strong="G3004,G4771"\w*, \w Pedro|strong="G4074"\w*: \w o galo|strong="G220"\w* \w não cantará|strong="G3756,G5455"\w* \w hoje|strong="G4594"\w* \add até\add* \w que|strong="G2193"\w* \w três vezes|strong="G5151"\w* \w você negue|strong="G533"\w* \w que me conhece|strong="G3165,G6063"\w*.”\f + \fr 22.34: \ft Acréscimo: “Mas” (em “Mas ele disse”): conectivo acrescentado para ligar as orações em português; “até” (em “cantará hoje até que três”): preposição ou artigo que a regência do português exige.\f*\x - \xo 22:34 \xt LUK 22:61; MRK 14:30; MAT 26:34; JHN 13:38; MAT 26:75; LUK 22:60\x*
\p
\v 35 \w E|strong="G2532"\w* \w disse a eles|strong="G2036,G846"\w*: “\w Quando|strong="G3753"\w* \w enviei vocês|strong="G649,G4771"\w* \w sem|strong="G817"\w* \w bolsa|strong="G905"\w*, \w nem|strong="G2532"\w* \w sacola|strong="G4082"\w*, \w nem|strong="G2532"\w* \w sandálias|strong="G5266"\w*, \w faltou-lhes|strong="G5302"\w* \add alguma\add* \w coisa|strong="G3361,G5100"\w*?” \w Eles|strong="G3588,G1161"\w* \w responderam|strong="G2036"\w*: “\w Nada|strong="G3762"\w*.”\f + \fr 22.35: \ft Acréscimo: “alguma” (em “faltou lhes alguma coisa Eles”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 22:35 \xt LUK 10:4; PSA 37:3; 2CO 8:15; DEU 2:7; LUK 9:3; LUK 12:29\x*
\v 36 \w Então|strong="G1161"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Mas|strong="G235"\w* \w agora|strong="G3568"\w*, \w quem tem|strong="G3588,G2192"\w* \w bolsa|strong="G905"\w*, \w leve-a|strong="G142"\w*; \w do mesmo modo|strong="G3668"\w*, \w também|strong="G2532"\w* \w sacola|strong="G4082"\w*; \w e|strong="G2532"\w* \w quem não tem|strong="G3588,G3361,G2192"\w*, \w venda|strong="G4453"\w* \w a sua capa|strong="G3588,G2440,G846"\w* \w e|strong="G2532"\w* \w compre|strong="G59"\w* \w uma espada|strong="G3162"\w*.\x - \xo 22:36 \xt MAT 6:28; MAT 6:13; JOL 3:10; MAT 26:51\x*
\v 37 \w Pois|strong="G1063"\w* \w digo a vocês|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w é necessário|strong="G1163"\w* \w cumprir-se|strong="G5055"\w* \w em mim|strong="G1722,G1473"\w* \w isto que está escrito|strong="G3778,G3588,G1125"\w*, \w a saber|strong="G3588"\w*: ‘\w E|strong="G2532"\w* \w foi contado|strong="G3049"\w* \w entre os sem-lei|strong="G3326,G459"\w*’. \w Porque|strong="G2532,G1063"\w* \w aquilo que se refere a mim|strong="G3588,G4012,G1473"\w* \w chega ao cumprimento|strong="G5056,G2192"\w*.”\f + \fr 22.37: \ft Variante: O RP acrescenta “ainda” depois de “que” e emprega o plural “as coisas que se referem a mim”.\f*\f + \fr 22.37: \ft Tradução: ἐλογίσθη (λογίζομαι, G3049) está aqui como “foi contado”; o termo pode ser “considerar”, “contar”, “atribuir”, “calcular” ou “raciocinar”, e o contexto decide.\f*\x - \xo 22:37 \xt MRK 15:28; ISA 53:12; JHN 19:28; 2CO 5:21; LUK 23:32; GAL 3:13\x*
\v 38 \w Eles|strong="G3588,G1161"\w* \w disseram|strong="G2036"\w*: “\w Senhor|strong="G2962"\w*, \w olhe|strong="G2400"\w*: \w há aqui|strong="G5602"\w* \w duas espadas|strong="G3162,G1417"\w*.” \add E\add* \w ele|strong="G3588,G1161"\w* \w lhes respondeu|strong="G2036,G846"\w*: “\w É|strong="G1510"\w* \w suficiente|strong="G2425"\w*.”\f + \fr 22.38: \ft Tradução: ἱκανόν ἐστιν, “é suficiente”: pode ser “basta!”, encerrando a conversa, ou “duas espadas bastam”.\f*\f + \fr 22.38: \ft Acréscimo: “E” (em “duas espadas E ele lhes”): conectivo acrescentado para ligar as orações em português; verbo ser/estar suprido em “há aqui”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:38 \xt 2CO 10:3-4; EPH 6:10-18; LUK 22:49; MAT 26:52-54; MAT 6:13; 1TH 5:8\x*
\p
\v 39 \w E|strong="G2532"\w*, \w saindo|strong="G1831"\w*, \w foi|strong="G4198"\w*, \w como de costume|strong="G2596,G3588,G1485"\w*, \w para o monte|strong="G1519,G3588,G3735"\w* \w das Oliveiras|strong="G3588,G1636"\w*; \w e|strong="G1161"\w* \w os discípulos|strong="G3588,G3101"\w* \w também|strong="G2532"\w* \w o seguiram|strong="G190,G846"\w*.\x - \xo 22:39 \xt MRK 14:26; MAT 26:30; JHN 8:1; MAT 21:1; MRK 1:35; LUK 11:1\x*
\v 40 \w Ao chegar|strong="G1096,G1161"\w* \w ao lugar|strong="G1909,G3588,G5117"\w*, \w disse a eles|strong="G2036,G846"\w*: “\w Orem|strong="G4336"\w* \w para não|strong="G3361"\w* \w entrarem|strong="G1525"\w* \w em provação|strong="G1519,G3986"\w*.”\x - \xo 22:40 \xt LUK 22:46; MAT 26:41; MRK 14:38; LUK 11:1; MRK 1:35; MAT 6:13\x*
\v 41 \w E|strong="G2532"\w* \w ele|strong="G846"\w* \w se afastou|strong="G645"\w* \w deles|strong="G575,G846"\w* \w cerca de|strong="G5616"\w* \w um arremesso|strong="G1000"\w* \w de pedra|strong="G3037"\w*; \w e|strong="G2532"\w*, \w pondo-se de joelhos|strong="G5087,G3588,G1119"\w*, \w orava|strong="G4336"\w*,\x - \xo 22:41 \xt ACT 20:36; ACT 7:60; MRK 1:35; HEB 5:7; MAT 26:39; PSA 95:6\x*
\v 42 \w dizendo|strong="G3004"\w*: “\w Pai|strong="G3962"\w*, \w se|strong="G1487"\w* \w quer|strong="G1014"\w*, \w afaste|strong="G3911"\w* \w de mim|strong="G575,G1473"\w* \w este cálice|strong="G3778,G3588,G4221"\w*. \w Contudo|strong="G4133"\w*, \w não se faça|strong="G3361,G1096"\w* \w a minha vontade|strong="G3588,G2307,G3165"\w*, \w mas|strong="G235"\w* \w a sua|strong="G3588,G4771"\w*.”\x - \xo 22:42 \xt MRK 14:36; JHN 12:27-28; MAT 26:39; MAT 26:42; MRK 1:35; HEB 5:7\x*
\v 43 \w Então|strong="G1161"\w* \w um anjo|strong="G32"\w* \w do céu|strong="G575,G3772"\w* \w lhe apareceu|strong="G3700,G846"\w*, \w fortalecendo-o|strong="G1765,G846"\w*.\f + \fr 22.43: \ft Variante: Os versos 43–44 estão no texto-base e em Treg, NA28 e RP; WH os põe entre colchetes duplos.\f*\x - \xo 22:43 \xt JHN 1:51; 1SA 23:16; MRK 1:35; HEB 5:7; MAT 4:11; 1TI 3:16\x*
\v 44 \w E|strong="G2532"\w*, \w estando em agonia|strong="G1096,G1722,G74"\w*, \w orava|strong="G4336"\w* \w mais intensamente|strong="G1617"\w*; \w e|strong="G2532"\w* \w o suor dele|strong="G3588,G2402,G846"\w* \w se tornou|strong="G1096"\w* \w como|strong="G5616"\w* \w coágulos de sangue|strong="G2361,G129"\w*, \w caindo|strong="G2597"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*.\x - \xo 22:44 \xt MRK 1:35; HEB 5:7; PSA 50:15; ROM 8:26; LAM 1:12; 1SA 1:10\x*
\v 45 \w E|strong="G2532"\w*, \w levantando-se|strong="G450"\w* \w da oração|strong="G575,G3588,G4335"\w*, \w foi|strong="G2064"\w* \w até os discípulos|strong="G4314,G3588,G3101"\w* \add e\add* \w os encontrou|strong="G2147,G846"\w* \w dormindo|strong="G2837"\w* \w por causa da tristeza|strong="G575,G3588,G3077"\w*.\f + \fr 22.45: \ft Acréscimo: “e” (em “os discípulos e os encontrou”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 22:45 \xt MRK 1:35; LUK 11:1; MAT 26:40; MRK 14:40-41; MAT 26:36; PSA 22:2\x*
\v 46 \w E|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: \add “Por\add* \w que|strong="G5101"\w* \w estão dormindo|strong="G2518"\w*? \w Levantem-se|strong="G450"\w* \add e\add* \w orem|strong="G4336"\w*, \w para que|strong="G2443"\w* \w não entrem|strong="G3361,G1525"\w* \w em provação|strong="G1519,G3986"\w*.”\f + \fr 22.46: \ft Acréscimo: “Por” (em “lhes disse Por que estão”): preposição ou artigo que a regência do português exige; “e” (em “Levantem se e orem para”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 22:46 \xt MAT 26:41; LUK 22:40; MRK 14:38; 1CO 10:13; MRK 1:35; EPH 6:18\x*
\p
\v 47 \w Enquanto ele ainda falava|strong="G2089,G846,G2980"\w*, \w olhe|strong="G2400"\w*, \w uma multidão|strong="G3793"\w* \add chegou;\add* \w e|strong="G2532"\w* \w o chamado Judas|strong="G3588,G3004,G2455"\w*, \w um dos doze|strong="G1520,G3588,G1427"\w*, \w vinha à frente|strong="G4281"\w* \w deles|strong="G846"\w*. \w E|strong="G2532"\w* \w se aproximou|strong="G1448"\w* \w de Jesus|strong="G3588,G2424"\w* \w para beijá-lo|strong="G5368,G846"\w*.\f + \fr 22.47: \ft Acréscimo: “chegou” (em “uma multidão chegou e o”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 22:47 \xt MAT 26:47; MRK 14:43; PRO 26:23; JHN 18:3; PSA 55:13; 2SA 20:9\x*
\v 48 \w Jesus|strong="G2424"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Judas|strong="G2455"\w*, \w é com um beijo|strong="G5370"\w* \add que\add* \w você entrega|strong="G3860"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w*?”\f + \fr 22.48: \ft Acréscimo: “que” (em “um beijo que você entrega”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição; verbo ser/estar suprido em “é com um beijo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:48 \xt MRK 3:19; 2SA 20:9; PRO 26:23; MRK 14:44-46; PRO 27:6; MRK 14:43\x*
\v 49 \w Os que estavam ao redor dele|strong="G1161,G3588,G4012,G846"\w*, \w vendo|strong="G1492"\w* \w o que ia acontecer|strong="G3588,G1510"\w*, \w disseram|strong="G2036"\w*: “\w Senhor|strong="G2962"\w*, \w devemos golpear|strong="G1487,G3960"\w* \w com a espada|strong="G1722,G3162"\w*?”\f + \fr 22.49: \ft Acréscimo: “Os que estavam ao redor dele”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 22:49 \xt MAT 26:51; JHN 18:10; LUK 22:38; MRK 14:43; JHN 18:3; MRK 14:47\x*
\v 50 \w E|strong="G2532"\w* \w um deles|strong="G1520,G5100,G1537,G846"\w* \w golpeou|strong="G3960"\w* \w o escravo|strong="G3588,G1401"\w* \w do sumo sacerdote|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w cortou|strong="G851"\w* \w a orelha direita|strong="G3588,G3775,G1188"\w* \w dele|strong="G846"\w*.\x - \xo 22:50 \xt MAT 26:51; MRK 14:47; JHN 18:10; MRK 14:43; 2CO 10:4; JHN 18:3\x*
\v 51 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w* \w respondeu e disse|strong="G611,G2036"\w*: “\w Deixem|strong="G1439"\w*; \w basta|strong="G2193,G3778"\w*!” \w E|strong="G2532"\w*, \w tocando|strong="G681"\w* \w a orelha|strong="G3588,G5621"\w*, \w curou-o|strong="G2390,G846"\w*.\f + \fr 22.51: \ft Lit.: ἐᾶτε ἕως τούτου, literalmente “deixem até isto”: pode ser “basta disso!”, dito aos discípulos, ou “permitam isto”, dito aos que prendiam Jesus, para que ele toque a orelha.\f*\x - \xo 22:51 \xt JHN 18:10; LUK 9:56; MAT 20:34; MRK 14:43; 2CO 10:1; JAS 5:6\x*
\v 52 \w Então|strong="G1161"\w* \w Jesus|strong="G2424"\w*, \w dirigindo-se|strong="G4314"\w* \w aos chefes dos sacerdotes|strong="G3588,G749"\w*, \w aos comandantes|strong="G2532,G4755"\w* \w do templo|strong="G3588,G2411"\w* \w e|strong="G2532"\w* \w aos anciãos|strong="G4245"\w* \w que tinham vindo|strong="G3854"\w* \w contra ele|strong="G1909,G846"\w*, \w disse|strong="G2036"\w*: “\w Vocês vieram|strong="G1831"\w* \w como|strong="G5613"\w* \w contra um bandido|strong="G1909,G3027"\w*, \w com|strong="G3326"\w* \w espadas|strong="G3162"\w* \w e|strong="G2532"\w* \w porretes|strong="G3586"\w*?\x - \xo 22:52 \xt MRK 14:48; MRK 14:43; MAT 26:55; MAT 26:47; LUK 22:4; JAS 5:6\x*
\v 53 \w Dia após dia|strong="G2596,G2250"\w*, \w quando eu estava|strong="G1510,G3165"\w* \w com vocês|strong="G3326,G4771"\w* \w no templo|strong="G1722,G3588,G2411"\w*, \w vocês não estenderam|strong="G3756,G1614"\w* \w as mãos|strong="G3588,G5495"\w* \w contra mim|strong="G1909,G1473"\w*. \w Mas|strong="G235"\w* \w esta|strong="G3778"\w* \w é|strong="G1510"\w* \w a hora de vocês|strong="G4771,G3588,G5610"\w* \w e|strong="G2532"\w* \w a autoridade|strong="G3588,G1849"\w* \w das trevas|strong="G3588,G4655"\w*.”\x - \xo 22:53 \xt COL 1:13; EPH 6:12; JHN 14:30; ACT 12:1; GEN 3:15; HEB 2:18\x*
\p
\v 54 \w Então|strong="G1161"\w*, \w prendendo-o|strong="G4815,G846"\w*, \w levaram-no|strong="G71"\w* \w e|strong="G2532"\w* \w o introduziram|strong="G1521"\w* \w na casa|strong="G1519,G3588,G3614"\w* \w do sumo sacerdote|strong="G3588,G749"\w*. \w Pedro|strong="G3588,G1161,G4074"\w*, \add porém,\add* \w seguia|strong="G190"\w* \w de longe|strong="G3113"\w*.\f + \fr 22.54: \ft Acréscimo: “porém” (em “sacerdote Pedro porém seguia de”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 22:54 \xt JHN 18:15; MRK 14:53; MAT 14:30; MAT 26:57; JHN 18:12; 2CH 32:31\x*
\v 55 \w Depois que acenderam|strong="G6072,G1161"\w* \w um fogo|strong="G4442"\w* \w no meio|strong="G1722,G3319"\w* \w do pátio|strong="G3588,G833"\w* \w e|strong="G2532"\w* \w se sentaram juntos|strong="G4776"\w*, \w Pedro|strong="G3588,G4074"\w* \w estava sentado|strong="G2521"\w* \w no meio deles|strong="G3319,G846"\w*.\x - \xo 22:55 \xt MAT 26:69; MRK 14:66; MAT 14:30; PSA 26:4-5; 2CO 6:15-17; JHN 18:18\x*
\v 56 \w Uma criada|strong="G3814,G5100"\w*, \w ao vê-lo|strong="G1492,G846"\w* \w sentado|strong="G2521"\w* \w junto à luz|strong="G4314,G3588,G5457"\w*, \w olhou fixamente|strong="G2532,G816"\w* \w para ele|strong="G846"\w* \add e\add* \w disse|strong="G2036"\w*: “\w Também|strong="G2532"\w* \w este homem|strong="G3778"\w* \w estava|strong="G1510"\w* \w com ele|strong="G4862,G846"\w*.”\f + \fr 22.56: \ft Acréscimo: “e” (em “para ele e disse Também”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 22:56 \xt MAT 14:30; JHN 18:18; GAL 5:17; JHN 18:16; JHN 18:17; MRK 14:53\x*
\v 57 \w Ele|strong="G3588,G1161"\w*, \add porém,\add* \w negou|strong="G720"\w*, \w dizendo|strong="G3004"\w*: “\w Mulher|strong="G1135"\w*, \w não o conheço|strong="G3756,G6063,G846"\w*.”\f + \fr 22.57: \ft Variante: O RP acrescenta um pronome depois de “negou” e muda a ordem da fala, sem alterar seu conteúdo.\f*\f + \fr 22.57: \ft Acréscimo: “porém” (em “Ele porém negou dizendo”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 22:57 \xt MAT 14:30; 1JN 1:9; 2TI 2:10-12; GAL 5:17; JHN 18:16; JHN 18:17\x*
\v 58 \w E|strong="G2532"\w*, \w pouco depois|strong="G3326,G1024"\w*, \w outro|strong="G2087"\w*, \w ao vê-lo|strong="G1492,G846"\w*, \w afirmou|strong="G5346"\w*: “\w Você|strong="G4771"\w* \w também|strong="G2532"\w* \w é|strong="G1510"\w* \w um deles|strong="G1537,G846"\w*.” \add Mas\add* \w Pedro|strong="G3588,G1161,G4074"\w* \w disse|strong="G5346"\w*: “\w Homem|strong="G444"\w*, \w não sou|strong="G3756,G1510"\w*.”\f + \fr 22.58: \ft Acréscimo: “Mas” (em “um deles Mas Pedro disse”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 22:58 \xt MAT 14:30; GAL 5:17; JHN 18:25; MRK 14:53; ROM 2:3\x*
\v 59 \w E|strong="G2532"\w*, \w tendo passado|strong="G1339"\w* \w cerca de|strong="G5616"\w* \w uma hora|strong="G5610,G1520"\w*, \w outro homem|strong="G243,G5100"\w* \w insistia|strong="G1340"\w*, \w dizendo|strong="G3004"\w*: “\w Verdadeiramente|strong="G1909,G225"\w*, \w também|strong="G2532"\w* \w este|strong="G3778"\w* \w estava|strong="G1510"\w* \w com ele|strong="G3326,G846"\w*, \w pois|strong="G2532,G1063"\w* \w é|strong="G1510"\w* \w galileu|strong="G1057"\w*.”\x - \xo 22:59 \xt MAT 14:30; GAL 5:17; JHN 18:25; JHN 18:26; MRK 14:53; MRK 14:70\x*
\v 60 \w Pedro|strong="G3588,G4074"\w* \w disse|strong="G2036"\w*: “\w Homem|strong="G444"\w*, \w não sei|strong="G3756,G6063"\w* \w o que|strong="G3739"\w* \w você está dizendo|strong="G3004"\w*.” \w E|strong="G2532"\w*, \w imediatamente|strong="G3916"\w*, \w enquanto ele ainda falava|strong="G2089,G2980,G846"\w*, \w um galo|strong="G220"\w* \w cantou|strong="G5455"\w*.\x - \xo 22:60 \xt JHN 18:27; LUK 22:34; MAT 26:74; MAT 14:30; PSA 37:24; GAL 5:17\x*
\v 61 \w E|strong="G2532"\w* \w o Senhor|strong="G3588,G2962"\w*, \w voltando-se|strong="G4762"\w*, \w olhou para|strong="G1689"\w* \w Pedro|strong="G3588,G4074"\w*; \w então|strong="G2532"\w* \w Pedro|strong="G3588,G4074"\w* \w se lembrou|strong="G5279"\w* \w da palavra|strong="G3588,G3056"\w* \w do Senhor|strong="G3588,G2962"\w*, \w como|strong="G5613"\w* \w ele lhe havia dito|strong="G2036,G846"\w*: “\w Antes|strong="G4250"\w* \w que o galo|strong="G220"\w* \w cante|strong="G5455"\w* \w hoje|strong="G4594"\w*, \w você me negará|strong="G533,G3165"\w* \w três vezes|strong="G5151"\w*.”\f + \fr 22.61: \ft Variante: WH e NA28 trazem ῥήματος, “declaração, palavra dita”, em vez de λόγου, “palavra”; o RP omite “hoje”.\f*\x - \xo 22:61 \xt LUK 22:34; MRK 14:30; MAT 26:34; MAT 26:75; JHN 18:27; MRK 14:72\x*
\v 62 \w E|strong="G2532"\w*, \w saindo para fora|strong="G1831,G1854"\w*, \w chorou|strong="G2799"\w* \w amargamente|strong="G4090"\w*.\x - \xo 22:62 \xt MAT 26:75; LUK 22:32; PSA 37:24; 1CO 10:12; JHN 16:20; JHN 18:27\x*
\p
\v 63 \w E|strong="G2532"\w* \w os homens|strong="G3588,G435"\w* \w que mantinham Jesus preso|strong="G3588,G4912,G846"\w* \w zombavam|strong="G1702"\w* \w dele|strong="G846"\w*, \w espancando-o|strong="G1194"\w*.\f + \fr 22.63: \ft Variante: O RP explicita “Jesus” onde o texto-base traz “ele”.\f*\x - \xo 22:63 \xt ISA 50:6; MRK 10:34; MAT 26:68; 2CH 36:16; MRK 14:65; PSA 22:16\x*
\v 64 \w E|strong="G2532"\w*, \w depois de cobri-lo|strong="G4028,G846"\w*, \w interrogavam-no|strong="G1905"\w*, \w dizendo|strong="G3004"\w*: “\w Profetize|strong="G4395"\w*: \w quem|strong="G5101"\w* \w é|strong="G1510"\w* \w aquele que|strong="G3588"\w* \w bateu em você|strong="G3817,G4771"\w*?”\f + \fr 22.64: \ft Variante: O RP acrescenta que batiam no rosto dele e repete o pronome depois de “interrogavam”.\f*\x - \xo 22:64 \xt MAT 26:68; MRK 14:65; ISA 50:6; MRK 10:34; 1PE 2:23; 2CH 36:16\x*
\v 65 \w E|strong="G2532"\w* \w diziam|strong="G3004"\w* \w muitas outras coisas|strong="G2087,G4183"\w* \w contra ele|strong="G1519,G846"\w*, \w insultando|strong="G987"\w*.\x - \xo 22:65 \xt MRK 10:34; MAT 26:68; 1PE 2:23; PSA 22:16; ACT 18:6; REV 2:9\x*
\p
\v 66 \w E|strong="G2532"\w*, \w quando|strong="G5613"\w* \w amanheceu|strong="G1096,G2250"\w*, \w reuniu-se|strong="G4863"\w* \w o conselho de anciãos|strong="G3588,G4244"\w* \w do povo|strong="G3588,G2992"\w*, \add tanto\add* \w chefes dos sacerdotes|strong="G749"\w* \w como|strong="G5037,G2532"\w* \w escribas|strong="G1122"\w*; \w e|strong="G2532"\w* \w o levaram|strong="G520,G846"\w* \w ao Sinédrio|strong="G1519,G3588,G4892"\w* \w deles|strong="G846"\w*,\f + \fr 22.66: \ft Acréscimo: “tanto” (em “do povo tanto chefes dos”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 22:66 \xt MRK 15:1; MAT 27:1; PSA 22:16; ACT 22:5; ACT 4:25-28; JHN 18:19\x*
\v 67 \w dizendo|strong="G3004"\w*: “\w Se|strong="G1487"\w* \w você|strong="G4771"\w* \w é|strong="G1510"\w* \w o Cristo|strong="G3588,G5547"\w*, \w diga-nos|strong="G2036,G3165"\w*.” \add Ele\add* \w lhes respondeu|strong="G2036,G846"\w*: “\w Se|strong="G1437"\w* \w eu lhes disser|strong="G4771,G2036"\w*, \w de modo nenhum|strong="G3756,G3361"\w* \w acreditarão|strong="G4100"\w*;\f + \fr 22.67: \ft Acréscimo: “Ele” (em “diga nos Ele lhes respondeu”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 22:67 \xt LUK 9:20; MRK 8:12; PSA 22:16; JER 38:15; JHN 10:24; JHN 18:21\x*
\v 68 \w e|strong="G1161"\w*, \w se|strong="G1437"\w* \w eu perguntar|strong="G2065"\w*, \w de modo nenhum|strong="G3756,G3361"\w* \w responderão|strong="G611"\w*.\f + \fr 22.68: \ft Variante: Treg e RP acrescentam “a mim, nem me soltarão”.\f*\x - \xo 22:68 \xt LUK 20:3; JHN 1:21; LUK 23:3; MRK 8:12; PSA 22:16; JER 38:15\x*
\v 69 \w Mas|strong="G1161"\w*, \w de agora em diante|strong="G575,G3588,G3568"\w*, \w o Filho do Homem|strong="G3588,G5207,G444"\w* \w estará|strong="G1510"\w* \w sentado|strong="G2521"\w* \w à direita|strong="G1537,G1188"\w* \w do poder|strong="G3588,G1411"\w* \w de Deus|strong="G3588,G2316"\w*.”\x - \xo 22:69 \xt MRK 14:62; ACT 2:34; MAT 26:64; COL 3:1; 1PE 3:22; REV 5:7\x*
\v 70 \w Então|strong="G1161"\w* \w todos|strong="G3956"\w* \w disseram|strong="G2036"\w*: “\w Logo|strong="G3767"\w*, \w você|strong="G4771"\w* \w é|strong="G1510"\w* \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w*?” \w Ele|strong="G3588,G1161"\w* \w lhes respondeu|strong="G4314,G846,G5346"\w*: “\w Vocês|strong="G4771"\w* \w dizem|strong="G3004"\w* \w que|strong="G3754"\w* \w eu|strong="G1473"\w* \w sou|strong="G1510"\w*.”\x - \xo 22:70 \xt LUK 23:3; MRK 8:12; PSA 22:16; JHN 10:24; LUK 23:2; JHN 18:19\x*
\v 71 \w Eles|strong="G3588,G1161"\w* \w disseram|strong="G2036"\w*: “\w Que|strong="G5101"\w* \w necessidade|strong="G5532"\w* \w ainda|strong="G2089"\w* \w temos|strong="G2192"\w* \w de testemunho|strong="G3141"\w*? \w Pois|strong="G1063"\w* \add nós\add* \w mesmos|strong="G846"\w* \w ouvimos|strong="G191"\w* \w da boca|strong="G575,G3588,G4750"\w* \w dele|strong="G846"\w*.”\f + \fr 22.71: \ft Acréscimo: “nós” (em “testemunho Pois nós mesmos ouvimos”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 22:71 \xt MRK 14:63; PSA 22:16; JHN 18:19; MRK 14:61; MAT 26:65-66\x*
\c 23
\p
\v 1 \w E|strong="G2532"\w*, \w levantando-se|strong="G450"\w*, \w toda a multidão|strong="G537,G3588,G4128"\w* \w deles|strong="G846"\w* \w o levou|strong="G71,G846"\w* \w a Pilatos|strong="G1909,G3588,G4091"\w*.\x - \xo 23:1 \xt MAT 27:1; JHN 18:28; LUK 3:1; MRK 15:1; EXO 12:6; JER 26:11\x*
\v 2 \w E|strong="G1161"\w* \w começaram|strong="G757"\w* \w a acusá-lo|strong="G2723,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Encontramos|strong="G2147"\w* \w este homem|strong="G3778"\w* \w pervertendo|strong="G1294"\w* \w a nossa nação|strong="G3588,G1484,G3165"\w*, \w e|strong="G2532"\w* \w proibindo|strong="G2967"\w* \w pagar impostos|strong="G5411,G1325"\w* \w a César|strong="G2541"\w*, \w e|strong="G2532"\w* \w dizendo|strong="G3004"\w* \w ser ele mesmo|strong="G1438,G1511"\w* \w Cristo|strong="G5547"\w*, \w rei|strong="G935"\w*.”\f + \fr 23.2: \ft Variante: O RP omite “nossa” e o segundo “e”; outras testemunhas usam ἑαυτόν, forma reflexiva equivalente a αὑτόν neste contexto.\f*\x - \xo 23:2 \xt ACT 17:6-7; MAT 27:11; ROM 13:6; ACT 17:7; JHN 19:12; LUK 23:14\x*
\v 3 \w Pilatos|strong="G3588,G1161,G4091"\w* \w o interrogou|strong="G2065,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Você|strong="G4771"\w* \w é|strong="G1510"\w* \w o rei|strong="G3588,G935"\w* \w dos judeus|strong="G3588,G2453"\w*?” \w Ele|strong="G3588,G1161"\w* \w lhe respondeu|strong="G611,G846,G5346"\w*: “\w Você|strong="G4771"\w* \add o\add* \w diz|strong="G3004"\w*.”\f + \fr 23.3: \ft Acréscimo: “o” (em “respondeu Você o diz”): preposição ou artigo que a regência do português exige.\f*\x - \xo 23:3 \xt MRK 15:2; MRK 15:12; JHN 18:37; MAT 27:11; MRK 15:9; JHN 18:33\x*
\v 4 \w Pilatos|strong="G3588,G1161,G4091"\w*, \add porém,\add* \w disse|strong="G2036"\w* \w aos chefes dos sacerdotes|strong="G4314,G3588,G749"\w* \w e|strong="G2532"\w* \w às multidões|strong="G3588,G3793"\w*: “\w Não encontro|strong="G3762,G2147"\w* \w culpa alguma|strong="G159"\w* \w neste homem|strong="G1722,G3588,G444,G3778"\w*.”\f + \fr 23.4: \ft Acréscimo: “porém” (em “Pilatos porém disse aos”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:4 \xt LUK 23:22; LUK 23:14; JHN 18:38; JHN 19:4; PSA 22:16; JHN 18:33\x*
\v 5 \w Eles|strong="G3588,G1161"\w*, \add porém,\add* \w insistiam|strong="G2001"\w*, \w dizendo|strong="G3004"\w*: “\w Ele agita|strong="G383"\w* \w o povo|strong="G3588,G2992"\w*, \w ensinando|strong="G1321"\w* \w por toda|strong="G2596,G3650"\w* \w a Judeia|strong="G3588,G2449"\w*; \w e|strong="G2532"\w*, \w começando|strong="G757"\w* \w pela Galileia|strong="G575,G3588,G1056"\w*, \add chegou\add* \w até aqui|strong="G2193,G5602"\w*.”\f + \fr 23.5: \ft Acréscimo: “porém” (em “Eles porém insistiam dizendo”): conectivo acrescentado para ligar as orações em português; “chegou” (em “pela Galileia chegou até aqui”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 23:5 \xt ACT 10:37; PSA 22:16; ACT 17:6; JHN 1:43; JHN 2:11; MRK 1:14\x*
\v 6 \w Pilatos|strong="G4091,G1161"\w*, \w ouvindo|strong="G191"\w* \add isso,\add* \w perguntou|strong="G1905"\w* \w se|strong="G1487"\w* \w o homem|strong="G3588,G444"\w* \w era|strong="G1510"\w* \w galileu|strong="G1057"\w*.\f + \fr 23.6: \ft Variante: Treg e RP acrescentam “Galileia” como objeto de “ouvindo”.\f*\f + \fr 23.6: \ft Acréscimo: “isso” (em “Pilatos ouvindo isso perguntou se”): demonstrativo acrescentado para retomar o que foi dito.\f*\x - \xo 23:6 \xt MRK 15:2; LUK 3:1; LUK 13:1\x*
\v 7 \w E|strong="G2532"\w*, \add ao\add* \w saber|strong="G1921"\w* \w que|strong="G3754"\w* \w ele era|strong="G1510"\w* \w da jurisdição|strong="G1537,G3588,G1849"\w* \w de Herodes|strong="G2264"\w*, \w enviou-o|strong="G375,G846"\w* \w a Herodes|strong="G4314,G2264"\w*, \w que também|strong="G1510,G2532,G846"\w* \add estava\add* \w em Jerusalém|strong="G1722,G2414"\w* \w naqueles dias|strong="G1722,G3778,G3588,G2250"\w*.\f + \fr 23.7: \ft Acréscimo: “ao” (em “E ao saber que”): preposição ou artigo que a regência do português exige; “estava” (em “que também estava em Jerusalém”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\f + \fr 23.7: \ft Tradução: ἐξουσίας (ἐξουσία, G1849) está aqui como “da jurisdição”; o termo pode ser “autoridade”, “poder”, “direito” ou “liberdade de agir”, e o contexto decide.\f*\x - \xo 23:7 \xt LUK 3:1; ACT 13:1; LUK 13:31; MRK 6:14; MAT 14:1\x*
\v 8 \w Herodes|strong="G3588,G1161,G2264"\w*, \add porém,\add* \w ao ver|strong="G1492"\w* \w Jesus|strong="G3588,G2424"\w*, \w ficou muito contente|strong="G5463,G3029"\w*, \w pois|strong="G1063"\w* \w havia muito tempo|strong="G1537,G2425,G5550"\w* \w queria|strong="G1510,G2309"\w* \w vê-lo|strong="G1492,G846"\w*, \w por ter ouvido|strong="G1223,G3588,G191"\w* \w a respeito dele|strong="G4012,G846"\w*; \w e|strong="G2532"\w* \w esperava|strong="G1679"\w* \w ver|strong="G1492"\w* \w algum sinal|strong="G5100,G4592"\w* \w feito|strong="G1096"\w* \w por ele|strong="G5259,G846"\w*.\f + \fr 23.8: \ft Variante: O RP traz construção equivalente para “havia muito tempo” e acrescenta que Herodes ouvira “muitas coisas”.\f*\f + \fr 23.8: \ft Acréscimo: “porém” (em “Herodes porém ao ver”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:8 \xt LUK 19:3; LUK 3:1; LUK 9:9; ACT 13:1; LUK 13:32; LUK 9:7-9\x*
\v 9 \w Então|strong="G1161"\w* \w lhe fazia perguntas|strong="G1905,G846"\w* \w com muitas palavras|strong="G1722,G3056,G2425"\w*, \add mas\add* \w ele|strong="G846,G1161"\w* \w nada lhe respondeu|strong="G3762,G611,G846"\w*.\f + \fr 23.9: \ft Acréscimo: “mas” (em “muitas palavras mas ele nada”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:9 \xt MRK 8:29; ISA 53:7; LUK 3:1; 1PE 2:23; MAT 27:14; ACT 13:1\x*
\v 10 \w Os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os escribas|strong="G3588,G1122"\w* \w estavam de pé|strong="G2476,G1161"\w*, \w acusando-o|strong="G2723,G846"\w* \w vigorosamente|strong="G2159"\w*.\x - \xo 23:10 \xt MRK 15:3; PSA 22:16; LUK 3:1; ACT 13:1; ACT 25:7; LUK 13:32\x*
\v 11 \w Então|strong="G1161"\w* \w Herodes|strong="G3588,G2264"\w*, \w junto com|strong="G4862"\w* \w seus soldados|strong="G3588,G4753,G846"\w*, \w o tratou com desprezo|strong="G1848,G846"\w* \w e|strong="G2532"\w* \w zombou|strong="G2532,G1702"\w* \add dele; depois,\add* \w vestindo-o|strong="G4016"\w* \w com uma roupa|strong="G2066"\w* \w esplêndida|strong="G2986"\w*, \w enviou-o de volta|strong="G375,G846"\w* \w a Pilatos|strong="G3588,G4091"\w*.\f + \fr 23.11: \ft Acréscimo: “dele” (em “e zombou dele depois vestindo”), “depois” (em “zombou dele depois vestindo o”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 23:11 \xt HEB 12:2; PSA 2:2; LUK 18:32; MRK 9:12; PSA 22:16; LUK 3:1\x*
\v 12 \w Naquele mesmo dia|strong="G1722,G846,G3588,G2250"\w*, \w tanto|strong="G3588,G5037"\w* \w Herodes|strong="G2264"\w* \w como|strong="G2532"\w* \w Pilatos|strong="G3588,G4091"\w* \w tornaram-se|strong="G1096,G1161"\w* \w amigos|strong="G5384"\w* \w um do outro|strong="G3326,G240"\w*; \w pois|strong="G1063"\w* \w antes|strong="G4391"\w* \w viviam|strong="G1510"\w* \w em inimizade|strong="G1722,G2189"\w* \w entre si|strong="G4314,G1438"\w*.\x - \xo 23:12 \xt PSA 2:2; ACT 4:27; REV 17:13-14; MRK 6:14; MAT 14:1\x*
\p
\v 13 \w Pilatos|strong="G4091,G1161"\w*, \add então,\add* \w convocando|strong="G4779"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w*, \w e|strong="G2532"\w* \w os governantes|strong="G3588,G758"\w*, \w e|strong="G2532"\w* \w o povo|strong="G3588,G2992"\w*,\f + \fr 23.13: \ft Acréscimo: “então” (em “Pilatos então convocando os”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:13 \xt ACT 4:8; JHN 3:1; LUK 24:20\x*
\v 14 \w disse a eles|strong="G2036,G4314,G846"\w*: \add “Vocês\add* \w me trouxeram|strong="G4374,G3165"\w* \w este homem|strong="G3588,G444,G3778"\w* \w como|strong="G5613"\w* \w alguém que desvia|strong="G654"\w* \w o povo|strong="G3588,G2992"\w*. \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*: \w eu|strong="G1473"\w*, \w tendo-o interrogado|strong="G350"\w* \w diante de vocês|strong="G1799,G4771"\w*, \w não encontrei|strong="G3762,G2147"\w* \w neste homem|strong="G1722,G3588,G444,G3778"\w* \w culpa alguma|strong="G159"\w* \w das coisas de que|strong="G3739"\w* \add vocês\add* \w o acusam|strong="G2723,G2596,G846"\w*.\f + \fr 23.14: \ft Acréscimo: “Vocês” (em “a eles Vocês me trouxeram”), “vocês” (em “de que vocês o acusam”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 23:14 \xt LUK 23:4; LUK 23:22; DAN 6:4; HEB 7:26; LUK 23:2; ACT 13:28\x*
\v 15 \w Nem|strong="G235,G3761"\w* \w Herodes|strong="G2264"\w*, \w pois|strong="G1063"\w* \w o enviou de volta|strong="G375,G846"\w* \w a nós|strong="G4314,G3165"\w*. \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*: \w nada|strong="G3762"\w* \w que mereça|strong="G514"\w* \w morte|strong="G2288"\w* \w foi|strong="G1510"\w* \w feito|strong="G4238"\w* \w por ele|strong="G846"\w*.\f + \fr 23.15: \ft Variante: Treg e RP trazem “pois enviei vocês a ele”, em vez de “pois ele o enviou de volta a nós”.\f*\x - \xo 23:15 \xt DAN 6:4; MAT 14:1; ACT 13:28; JER 26:16; LUK 23:4\x*
\v 16 \w Portanto|strong="G3767"\w*, \w depois de castigá-lo|strong="G3811,G846"\w*, \w eu o soltarei|strong="G630"\w*.”\f + \fr 23.16: \ft Variante: O RP acrescenta o versículo 17: “Ele tinha necessidade de lhes soltar um por ocasião da festa”. O texto-base não o inclui na numeração.\f*\x - \xo 23:16 \xt LUK 23:22; MAT 27:26; JHN 19:1; MRK 15:15; ACT 13:28; ACT 16:37\x*
\v 18 \w Mas|strong="G1161"\w* \add todos\add* \w juntos|strong="G3826"\w* \w gritaram|strong="G349"\w*, \w dizendo|strong="G3004"\w*: “\w Elimine|strong="G142"\w* \w este|strong="G3778"\w* \w e|strong="G1161"\w* \w solte Barrabás para nós|strong="G630,G3165,G3588,G912"\w*!”\f + \fr 23.18: \ft Acréscimo: “todos” (em “Mas todos juntos gritaram”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 23:18 \xt MAT 27:17; ACT 21:36; JHN 19:15; ACT 3:14; ISA 53:3; MRK 15:7\x*
\v 19 \w Barrabás|strong="G3748"\w* \add havia\add* \w sido|strong="G1510"\w* \w lançado na prisão|strong="G906,G1722,G3588,G5438"\w* \w por causa de|strong="G1223"\w* \w uma revolta|strong="G4714,G5100"\w* \w ocorrida|strong="G1096"\w* \w na cidade|strong="G1722,G3588,G4172"\w* \w e|strong="G2532"\w* \w por homicídio|strong="G5408"\w*.\f + \fr 23.19: \ft Acréscimo: “havia” (em “Barrabás havia sido lançado”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 23:19 \xt MRK 15:7; LUK 23:25; ACT 3:14; ISA 53:3; ACT 3:13; JHN 18:39\x*
\v 20 \w Pilatos|strong="G3588,G4091"\w* \w falou|strong="G4377"\w* \w novamente|strong="G3825"\w*, \w querendo|strong="G2309"\w* \w soltar|strong="G630"\w* \w Jesus|strong="G3588,G2424"\w*.\x - \xo 23:20 \xt LUK 13:12; MRK 15:9; ISA 53:3; ACT 3:13; JHN 18:39; MRK 15:15\x*
\v 21 \w Eles|strong="G3588,G1161"\w*, \add porém,\add* \w gritavam|strong="G2019"\w*, \w dizendo|strong="G3004"\w*: “\w Crucifique|strong="G4717"\w*, \w crucifique-o|strong="G4717,G846"\w*!”\f + \fr 23.21: \ft Acréscimo: “porém” (em “Eles porém gritavam dizendo”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:21 \xt PSA 35:12; ISA 53:3; ACT 13:28; ACT 3:13; JHN 18:39; MRK 10:33\x*
\v 22 \w Ele|strong="G3588,G1161"\w*, \add porém,\add* \w lhes disse|strong="G2036,G4314,G846"\w* \w pela terceira vez|strong="G5154"\w*: “\w Pois|strong="G1063"\w* \w que mal|strong="G5101,G2556"\w* \w este|strong="G3778"\w* \w fez|strong="G4160"\w*? \w Não encontrei|strong="G3762,G2147"\w* \w nele|strong="G1722,G846"\w* \w culpa alguma|strong="G159"\w* \w que mereça a morte|strong="G2288"\w*. \w Portanto|strong="G3767"\w*, \w depois de castigá-lo|strong="G3811,G846"\w*, \w eu o soltarei|strong="G630"\w*.”\f + \fr 23.22: \ft Acréscimo: “porém” (em “Ele porém lhes disse”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:22 \xt LUK 23:16; LUK 23:4; LUK 23:14; PSA 35:12; HEB 7:26; ISA 53:3\x*
\v 23 \add Mas\add* \w eles|strong="G3588,G1161"\w* \w insistiam|strong="G1945"\w*, \w com grandes gritos|strong="G5456,G3173"\w*, \w pedindo|strong="G154"\w* \w que ele fosse crucificado|strong="G846,G4717"\w*; \w e|strong="G2532"\w* \w os gritos|strong="G3588,G5456"\w* \w deles|strong="G846"\w* \w prevaleciam|strong="G2729"\w*.\f + \fr 23.23: \ft Variante: Treg e RP acrescentam “e dos chefes dos sacerdotes” depois de “os gritos deles”.\f*\f + \fr 23.23: \ft Acréscimo: “Mas” (em “Mas eles insistiam”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:23 \xt EXO 23:2; PSA 22:16; PSA 35:12; ISA 53:3; ZEC 11:8; ACT 13:28\x*
\v 24 \w E|strong="G2532"\w* \w Pilatos|strong="G4091"\w* \w decidiu|strong="G1948"\w* \w que fosse atendido|strong="G1096"\w* \w o pedido|strong="G3588,G155"\w* \w deles|strong="G846"\w*.\x - \xo 23:24 \xt MAT 27:26; EXO 23:2; PRO 17:15; LUK 3:1; MRK 15:15; ISA 53:3\x*
\v 25 \w Então|strong="G1161"\w* \w soltou|strong="G630"\w* \w aquele que|strong="G3588,G3739"\w* \w havia sido lançado|strong="G906"\w* \w na prisão|strong="G1519,G5438"\w* \w por revolta|strong="G1223,G4714"\w* \w e|strong="G2532"\w* \w homicídio|strong="G5408"\w*, \w a quem pediam|strong="G154"\w*; \w a Jesus|strong="G3588,G1161,G2424"\w*, \add porém,\add* \w entregou|strong="G3860"\w* \w à vontade|strong="G3588,G2307"\w* \w deles|strong="G846"\w*.\f + \fr 23.25: \ft Acréscimo: “porém” (em “a Jesus porém entregou à”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:25 \xt LUK 23:19; MRK 15:7; ACT 3:14; EST 3:11; ISA 53:12; ISA 53:3\x*
\p
\v 26 \w E|strong="G2532"\w*, \w enquanto|strong="G5613"\w* \w o levavam|strong="G520,G846"\w*, \w agarraram|strong="G1949"\w* \w um certo Simão|strong="G4613,G5100"\w*, \w cireneu|strong="G2956"\w*, \w que vinha|strong="G2064"\w* \w do campo|strong="G575,G68"\w*, \add e\add* \w puseram sobre ele|strong="G2007,G846"\w* \w a cruz|strong="G3588,G4716"\w*, \w para carregá-la|strong="G5342"\w* \w atrás|strong="G3693"\w* \w de Jesus|strong="G3588,G2424"\w*.\f + \fr 23.26: \ft Acréscimo: “e” (em “do campo e puseram sobre”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:26 \xt MAT 27:32; MRK 15:21; MAT 16:24; ACT 13:1; ACT 2:10; ACT 6:6\x*
\v 27 \w E|strong="G1161"\w* \w uma grande multidão|strong="G4183,G4128"\w* \w do povo|strong="G3588,G2992"\w* \w o seguia|strong="G190,G846"\w*, \add assim\add* \w como|strong="G2532"\w* \w mulheres|strong="G1135"\w* \w que batiam no peito|strong="G3739,G2875"\w* \w e|strong="G2532"\w* \w lamentavam|strong="G2354"\w* \w por ele|strong="G846"\w*.\f + \fr 23.27: \ft Acréscimo: “assim” (em “o seguia assim como mulheres”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:27 \xt MAT 11:17; JER 9:20; LUK 8:52; PSA 22:17; JHN 16:20; LUK 8:2\x*
\v 28 \w Jesus|strong="G3588,G2424"\w*, \w voltando-se|strong="G4762"\w* \w para elas|strong="G4314,G846"\w*, \w disse|strong="G2036"\w*: “\w Filhas|strong="G2364"\w* \w de Jerusalém|strong="G2419"\w*, \w não chorem|strong="G3361,G2799"\w* \w por mim|strong="G1909,G1473"\w*; \w pelo contrário|strong="G4133"\w*, \w chorem|strong="G2799"\w* \w por vocês mesmas|strong="G1909,G1438"\w* \w e|strong="G2532"\w* \w por seus filhos|strong="G1909,G3588,G5043,G4771"\w*.\x - \xo 23:28 \xt JER 9:20; REV 1:7; LUK 13:3; ISA 3:16; LUK 13:34; ZEC 13:8\x*
\v 29 \w Pois|strong="G3754"\w* \w olhem|strong="G2400"\w*, \w virão dias|strong="G2064,G2250"\w* \w em que|strong="G1722,G3739"\w* \w dirão|strong="G4483"\w*: ‘\w Felizes|strong="G3107"\w* \w as estéreis|strong="G3588,G4723"\w*, \w e|strong="G2532"\w* \w os ventres|strong="G3588,G2836"\w* \w que não deram à luz|strong="G3739,G3756,G1080"\w*, \w e|strong="G2532"\w* \w os seios|strong="G3149"\w* \w que não amamentaram|strong="G3739,G3756,G5142"\w*!’\x - \xo 23:29 \xt LUK 11:27; MAT 24:19; JER 9:20; REV 1:7; LUK 21:23; LUK 13:3\x*
\v 30 \w Então|strong="G5119"\w* \w começarão|strong="G757"\w* \w a dizer|strong="G3004"\w* \w aos montes|strong="G3588,G3735"\w*: ‘\w Caiam|strong="G4098"\w* \w sobre nós|strong="G1909,G3165"\w*!’; \w e|strong="G2532"\w* \w às colinas|strong="G3588,G1015"\w*: ‘\w Cubram-nos|strong="G2572,G3165"\w*!’\x - \xo 23:30 \xt REV 6:16; HOS 10:8; ISA 2:19; REV 9:6; MAT 24:19; JER 9:20\x*
\v 31 \w Porque|strong="G3754"\w*, \w se|strong="G1487"\w* \w fazem|strong="G4160"\w* \w estas coisas|strong="G3778"\w* \w com a madeira verde|strong="G1722,G3588,G5200,G3586"\w*, \add o\add* \w que|strong="G5101"\w* \w acontecerá|strong="G1096"\w* \w com a|strong="G1722,G3588"\w* \add madeira\add* \w seca|strong="G3584"\w*?”\f + \fr 23.31: \ft Acréscimo: “o” (em “madeira verde o que acontecerá”): preposição ou artigo que a regência do português exige; “madeira” (em “com a madeira seca”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 23:31 \xt 1PE 4:18; 1PE 4:17; JHN 15:6; PRO 11:31; EZK 20:47; LAM 1:12\x*
\v 32 \w Eram levados|strong="G71"\w* \w também|strong="G1161,G2532"\w* \w outros dois|strong="G2087,G1417"\w*, \w criminosos|strong="G2557"\w*, \w com ele|strong="G4862,G846"\w*, \w para serem mortos|strong="G337"\w*.\x - \xo 23:32 \xt ISA 53:12; LUK 22:37; MRK 15:27; MAT 27:38; JHN 19:18; MRK 15:22\x*
\v 33 \w E|strong="G2532"\w*, \w quando|strong="G3753"\w* \w chegaram|strong="G2064"\w* \w ao lugar|strong="G1909,G3588,G5117"\w* \w chamado|strong="G3588,G2564"\w* \w Caveira|strong="G2898"\w*, \w ali|strong="G1563"\w* \w crucificaram|strong="G4717"\w* \w Jesus|strong="G846"\w* \w e|strong="G2532"\w* \w os criminosos|strong="G3588,G2557"\w*, \w um deles|strong="G3739,G3303"\w* \w à direita|strong="G1537,G1188"\w* \add e\add* \w o outro|strong="G3739,G1161"\w* \w à esquerda|strong="G1537,G710"\w*.\f + \fr 23.33: \ft Acréscimo: “e” (em “à direita e o outro”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:33 \xt MAT 27:33; MRK 15:22; JHN 19:17; ISA 53:12; PSA 22:16; MAT 27:38\x*
\v 34 \w Jesus|strong="G3588,G1161,G2424"\w*, \add porém,\add* \w dizia|strong="G3004"\w*: “\w Pai|strong="G3962"\w*, \w perdoe-lhes|strong="G863,G846"\w*, \w pois|strong="G1063"\w* \w não sabem|strong="G3756,G6063"\w* \w o que|strong="G5101"\w* \w fazem|strong="G4160"\w*.” \w E|strong="G1161"\w*, \w repartindo|strong="G1266"\w* \w as roupas|strong="G3588,G2440"\w* \w dele|strong="G846"\w*, \w lançaram|strong="G906"\w* \w sortes|strong="G2819"\w*.\f + \fr 23.34: \ft Variante: A fala de Jesus está no texto-base e em Treg, NA28 e RP; WH a põe entre colchetes duplos.\f*\f + \fr 23.34: \ft Acréscimo: “porém” (em “Jesus porém dizia Pai”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:34 \xt MAT 27:35; MRK 15:24; MAT 5:44; ACT 7:60; 1PE 3:9; JHN 19:24\x*
\v 35 \w E|strong="G2532"\w* \w o povo|strong="G3588,G2992"\w* \w estava de pé|strong="G2476"\w*, \w observando|strong="G2334"\w*. \w Também|strong="G2532"\w* \w os governantes|strong="G3588,G758"\w* \w zombavam|strong="G1592,G1161"\w*, \w dizendo|strong="G3004"\w*: “\w Salvou|strong="G4982"\w* \w outros|strong="G243"\w*; \w que salve|strong="G4982"\w* \w a si mesmo|strong="G1438"\w*, \w se|strong="G1487"\w* \w este|strong="G3778"\w* \w é|strong="G1510"\w* \w o Cristo|strong="G3588,G5547"\w* \w de Deus|strong="G3588,G2316"\w*, \w o Escolhido|strong="G3588,G1588"\w*!”\x - \xo 23:35 \xt HEB 12:2; PSA 22:17; ISA 42:1; 1PE 2:4; 1PE 2:6; LUK 16:14\x*
\v 36 \w Também|strong="G2532"\w* \w os soldados|strong="G3588,G4757"\w* \w zombaram|strong="G1702,G1161"\w* \w dele|strong="G846"\w*; \w aproximando-se|strong="G4334"\w*, \w ofereciam-lhe|strong="G4374,G846"\w* \w vinagre|strong="G3690"\w*\x - \xo 23:36 \xt JHN 19:29; PSA 69:21; HEB 12:2; MRK 10:34; 1PE 2:23; MAT 27:48\x*
\v 37 \w e|strong="G2532"\w* \w diziam|strong="G3004"\w*: “\w Se|strong="G1487"\w* \w você|strong="G4771"\w* \w é|strong="G1510"\w* \w o rei|strong="G3588,G935"\w* \w dos judeus|strong="G3588,G2453"\w*, \w salve|strong="G4982"\w* \w a si mesmo|strong="G4771"\w*!”\x - \xo 23:37 \xt MRK 15:26; HEB 12:2; MRK 10:34; 1PE 2:23; LUK 23:39; MRK 15:22\x*
\v 38 \w Havia|strong="G1510,G1161"\w* \w também|strong="G2532"\w* \w uma inscrição|strong="G1923"\w* \w sobre ele|strong="G1909,G846"\w*: “\w Este|strong="G3778"\w* \add é\add* \w o rei|strong="G3588,G935"\w* \w dos judeus|strong="G3588,G2453"\w*”.\f + \fr 23.38: \ft Variante: Treg explicita que a inscrição estava escrita; o RP acrescenta “em letras gregas, romanas e hebraicas” e ordena a frase como “Este é o rei dos judeus”.\f*\f + \fr 23.38: \ft Acréscimo: “é” (em “ele Este é o rei”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 23:38 \xt MRK 15:26; LUK 23:3; HEB 12:2; JHN 19:19; MRK 10:34; MAT 27:37\x*
\v 39 \w Um dos criminosos|strong="G1520,G1161,G3588,G2910,G2557"\w* \add pendurados\add* \w o insultava|strong="G987,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Você não|strong="G3780,G4771"\w* \w é|strong="G1510"\w* \w o Cristo|strong="G3588,G5547"\w*? \w Salve|strong="G4982"\w* \w a si mesmo|strong="G4771"\w* \w e|strong="G2532"\w* \w a nós|strong="G3165"\w*!”\f + \fr 23.39: \ft Variante: WH omite “dizendo”; o RP traz a pergunta condicional “Se você é o Cristo” em vez de “Você não é o Cristo?”.\f*\f + \fr 23.39: \ft Acréscimo: “pendurados” (em “dos criminosos pendurados o insultava”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 23:39 \xt HEB 12:2; MAT 27:44; MRK 15:32; JUD 1:9; MAT 27:38; MRK 10:34\x*
\v 40 \w Mas|strong="G1161"\w* \w o outro|strong="G3588,G2087"\w*, \w respondendo|strong="G611"\w*, \w o repreendeu|strong="G2008,G846"\w*, \w dizendo|strong="G5346"\w*: “\w Você|strong="G4771"\w* \w nem sequer|strong="G3761"\w* \w teme|strong="G5399"\w* \w a Deus|strong="G3588,G2316"\w*, \add já\add* \w que|strong="G3754"\w* \w está|strong="G1510"\w* \w sob a mesma|strong="G1722,G3588,G846"\w* \w condenação|strong="G2917"\w*?\f + \fr 23.40: \ft Acréscimo: “já” (em “a Deus já que está”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 23:40 \xt JUD 1:9; MAT 27:38; LUK 18:13; MRK 15:32; JHN 6:37; JOB 1:8\x*
\v 41 \w E|strong="G2532"\w* \w nós|strong="G3165"\w*, \add de\add* \w fato|strong="G3303"\w*, \w com justiça|strong="G1346"\w*, \w pois|strong="G1063"\w* \w recebemos|strong="G618"\w* \w o que merecem|strong="G514"\w* \w as coisas que|strong="G3739"\w* \w fizemos|strong="G4238"\w*; \w este|strong="G3778"\w*, \w porém|strong="G1161"\w*, \w nada impróprio|strong="G3762,G824"\w* \w fez|strong="G4238"\w*.”\f + \fr 23.41: \ft Acréscimo: “de” (em “E nós de fato com”): preposição ou artigo que a regência do português exige.\f*\x - \xo 23:41 \xt MAT 27:38; 1PE 2:22; HEB 7:26; LUK 18:13; MRK 15:32; JHN 6:37\x*
\v 42 \w E|strong="G2532"\w* \w dizia|strong="G3004"\w*: “\w Jesus|strong="G2424"\w*, \w lembre-se de mim|strong="G3403,G3165"\w* \w quando|strong="G3752"\w* \w você vier|strong="G2064"\w* \w em seu reino|strong="G1722,G3588,G932,G4771"\w*.”\f + \fr 23.42: \ft Variante: WH e NA28 leem “entrar em seu reino”; o RP acrescenta “Senhor” depois de “lembre-se de mim”.\f*\x - \xo 23:42 \xt ACT 16:31; ROM 10:9-14; MAT 7:8; PSA 106:4; 1JN 5:11-13; 1CO 6:10-11\x*
\v 43 \w E|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: \add “Em\add* \w verdade|strong="G281"\w* \w lhe digo|strong="G4771,G3004"\w*: \w hoje|strong="G4594"\w* \w você estará|strong="G1510"\w* \w comigo|strong="G3326,G1473"\w* \w no paraíso|strong="G1722,G3588,G3857"\w*.”\f + \fr 23.43: \ft Tradução: σήμερον, “hoje”, pode ligar-se a “lhe digo” ou a “estará comigo”; παράδεισος, “paraíso” (jardim, palavra de origem persa); o texto grego não traz pontuação.\f*\f + \fr 23.43: \ft Acréscimo: “Em” (em “lhe disse Em verdade lhe”): preposição ou artigo que a regência do português exige.\f*\x - \xo 23:43 \xt REV 2:7; PSA 50:15; 1TI 1:15-16; LUK 19:10; PSA 32:5; JHN 14:3\x*
\p
\v 44 \w E|strong="G2532"\w* \w já|strong="G2235"\w* \w era|strong="G1510"\w* \w cerca da|strong="G5616"\w* \w sexta hora|strong="G5610,G1623"\w*, \w e|strong="G2532"\w* \w houve|strong="G1096"\w* \w escuridão|strong="G4655"\w* \w sobre toda|strong="G1909,G3650"\w* \w a terra|strong="G3588,G1093"\w* \w até|strong="G2193"\w* \w a nona hora|strong="G5610,G1766"\w*,\x - \xo 23:44 \xt MRK 15:33; MAT 27:45; MAT 20:5; ACT 3:1; AMO 8:9; ACT 2:20\x*
\v 45 \w pois o sol deixou de brilhar|strong="G3588,G2246,G1587"\w*; \w e|strong="G1161"\w* \w a cortina|strong="G3588,G2665"\w* \w do santuário|strong="G3588,G3485"\w* \w se rasgou|strong="G4977"\w* \w pelo meio|strong="G3319"\w*.\x - \xo 23:45 \xt MRK 15:38; MAT 27:51; HEB 10:19-22; MRK 15:33; MAT 27:45; HEB 9:3-8\x*
\v 46 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w clamando|strong="G5455"\w* \w com voz forte|strong="G5456,G3173"\w*, \w disse|strong="G2036"\w*: “\w Pai|strong="G3962"\w*, \w em suas mãos|strong="G1519,G5495,G4771"\w* \w entrego|strong="G3908"\w* \w o meu espírito|strong="G3588,G4151,G3165"\w*.” \w E|strong="G1161"\w*, \w depois de dizer|strong="G2036"\w* \w isso|strong="G3778"\w*, \w deu o último suspiro|strong="G1606"\w*.\x - \xo 23:46 \xt MRK 15:37; PSA 31:5; ACT 7:59; JHN 19:30; 1PE 2:23; MRK 15:34\x*
\v 47 \w O centurião|strong="G3588,G1543"\w*, \w vendo|strong="G1492"\w* \w o que havia acontecido|strong="G3588,G1096"\w*, \w glorificava|strong="G1392"\w* \w a Deus|strong="G3588,G2316"\w*, \w dizendo|strong="G3004"\w*: “\w De fato|strong="G3689"\w*, \w este homem|strong="G3588,G444,G3778"\w* \w era|strong="G1510"\w* \w justo|strong="G1342"\w*.”\x - \xo 23:47 \xt MRK 15:39; MAT 27:54; HEB 7:26; LUK 23:34; MAT 9:8; 1PE 2:22\x*
\v 48 \w E|strong="G2532"\w* \w todas|strong="G3956"\w* \w as multidões que haviam se reunido|strong="G3588,G4836,G3793"\w* \w para aquele espetáculo|strong="G1909,G3588,G2335,G3778"\w*, \w vendo|strong="G2334"\w* \w o que tinha acontecido|strong="G3588,G1096"\w*, \w voltavam|strong="G5290"\w*, \w batendo|strong="G5180"\w* \w no peito|strong="G3588,G4738"\w*.\x - \xo 23:48 \xt LUK 18:13; MRK 15:39; LUK 23:34; MAT 27:54; ACT 2:37; JER 31:19\x*
\v 49 \w Mas|strong="G1161"\w* \w todos|strong="G3956"\w* \w os conhecidos dele|strong="G3588,G1110,G846"\w* \w estavam de pé|strong="G2476"\w*, \w de longe|strong="G3113"\w*, \w e|strong="G2532"\w* \add também\add* \w mulheres|strong="G1135"\w* \w que o haviam acompanhado|strong="G3588,G4870,G846"\w* \w desde a Galileia|strong="G575,G3588,G1056"\w*, \w observando|strong="G3708"\w* \w estas coisas|strong="G3778"\w*.\f + \fr 23.49: \ft Acréscimo: “também” (em “longe e também mulheres que”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:49 \xt MAT 27:55; JHN 19:25; LUK 8:2; PSA 38:11; LUK 23:55; MRK 15:40\x*
\p
\v 50 \w E|strong="G2532"\w* \w olhe|strong="G2400"\w*: \add havia\add* \w um homem|strong="G435"\w*, \w chamado|strong="G3686"\w* \w José|strong="G2501"\w*, \w que era membro do conselho|strong="G1010,G5225"\w*, \w homem bom|strong="G435,G18"\w* \w e|strong="G2532"\w* \w justo|strong="G1342"\w*.\f + \fr 23.50: \ft Acréscimo: “havia” (em “E olhe havia um homem”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\f + \fr 23.50: \ft Tradução: ὀνόματι (ὄνομα, G3686) está aqui como “chamado”; o termo pode ser “nome”, “reputação”, “pessoa” ou “autoridade”, e o contexto decide.\f*\x - \xo 23:50 \xt PHP 4:8; ISA 53:9; JHN 19:38; ACT 10:22; ACT 11:24; 1CO 15:4\x*
\v 51 \w Ele|strong="G3778"\w* \w não tinha|strong="G3756,G1510"\w* \w concordado|strong="G4784"\w* \w com o plano|strong="G3588,G1012"\w* \w nem|strong="G2532"\w* \w com a ação|strong="G3588,G4234"\w* \w deles|strong="G846"\w*. \add Era\add* \w de Arimateia|strong="G575,G707"\w*, \w cidade|strong="G4172"\w* \w dos judeus|strong="G3588,G2453"\w*, \add e era alguém\add* \w que|strong="G3739"\w* \w esperava|strong="G4327"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 23.51: \ft Acréscimo: “Era” (em “ação deles Era de Arimateia”), “era” (em “judeus e era alguém que”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige; “e” (em “dos judeus e era alguém”): conectivo acrescentado para ligar as orações em português; “alguém” (em “e era alguém que esperava”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 23:51 \xt MRK 15:43; PSA 1:1; ISA 53:9; LUK 2:25; 1CO 15:4; EXO 23:2\x*
\v 52 \w Ele|strong="G3778"\w*, \w aproximando-se|strong="G4334"\w* \w de Pilatos|strong="G3588,G4091"\w*, \w pediu|strong="G154"\w* \w o corpo|strong="G3588,G4983"\w* \w de Jesus|strong="G3588,G2424"\w*.\x - \xo 23:52 \xt MAT 27:58; ISA 53:9; 1CO 15:4; JHN 19:38; MRK 15:42\x*
\v 53 \w E|strong="G2532"\w*, \w depois de baixá-lo|strong="G2507"\w*, \w envolveu-o|strong="G1794,G846"\w* \w em um lençol de linho|strong="G4616"\w* \w e|strong="G2532"\w* \w o colocou|strong="G5087,G846"\w* \w num túmulo|strong="G1722,G3418"\w* \w escavado|strong="G2991"\w*, \w no qual não havia|strong="G3757,G3756,G1510"\w* \w ninguém|strong="G3762"\w* \w ainda|strong="G3768"\w* \w sepultado|strong="G2749"\w*.\x - \xo 23:53 \xt MAT 27:59; MRK 15:46; ACT 13:29; ISA 53:9; JHN 19:41; 1CO 15:4\x*
\v 54 \w Era|strong="G1510"\w* \w o dia|strong="G2250"\w* \w da Preparação|strong="G3904"\w*, \w e|strong="G2532"\w* \w o sábado|strong="G4521"\w* \add começava a\add* \w despontar|strong="G2020"\w*.\f + \fr 23.54: \ft Acréscimo: “começava” (em “o sábado começava a despontar”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; “a” (em “sábado começava a despontar”): preposição ou artigo que a regência do português exige.\f*\x - \xo 23:54 \xt JHN 19:31; MAT 27:62; MRK 15:42; MRK 16:1\x*
\v 55 \w As mulheres|strong="G3588,G1135"\w* \w que tinham vindo|strong="G3748,G1510,G4905"\w* \w com ele|strong="G846"\w* \w da Galileia|strong="G1537,G3588,G1056"\w* \w seguiram|strong="G2628,G1161"\w* \add e\add* \w viram|strong="G2300"\w* \w o túmulo|strong="G3588,G3419"\w* \w e|strong="G2532"\w* \w como|strong="G5613"\w* \w o corpo dele|strong="G3588,G4983,G846"\w* \w fora colocado|strong="G5087"\w*.\f + \fr 23.55: \ft Acréscimo: “e” (em “Galileia seguiram e viram o”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 23:55 \xt LUK 23:49; LUK 24:1; ACT 1:14; LUK 23:27; LUK 8:2; MRK 15:42\x*
\v 56 \w Então|strong="G1161"\w*, \w retornando|strong="G5290"\w*, \w prepararam|strong="G2090"\w* \w aromas|strong="G759"\w* \w e|strong="G2532"\w* \w perfumes|strong="G3464"\w*. \w E|strong="G2532"\w*, \w no sábado|strong="G3588,G3303,G4521"\w*, \w descansaram|strong="G2270"\w* \w conforme|strong="G2596"\w* \w o mandamento|strong="G3588,G1785"\w*.\x - \xo 23:56 \xt LUK 24:1; GEN 2:3; MRK 16:1; MAT 28:1; EXO 20:10; EXO 31:15\x*
\c 24
\p
\v 1 \w Mas|strong="G1161"\w*, \w no primeiro dia|strong="G3588,G1520"\w* \w da semana|strong="G3588,G4521"\w*, \w bem cedo|strong="G3722,G901"\w*, \w foram|strong="G2064"\w* \w ao túmulo|strong="G1909,G3588,G3418"\w*, \w levando|strong="G5342"\w* \w os aromas|strong="G759"\w* \w que haviam preparado|strong="G3739,G2090"\w*.\f + \fr 24.1: \ft Variante: O RP acrescenta “e algumas outras com elas”.\f*\x - \xo 24:1 \xt LUK 23:56; JHN 20:1; ACT 2:24; MRK 16:1-8; MAT 28:1-8; LUK 24:10\x*
\v 2 \w E|strong="G1161"\w* \w encontraram|strong="G2147"\w* \w a pedra|strong="G3588,G3037"\w* \w rolada|strong="G617"\w* \w para longe do túmulo|strong="G575,G3588,G3419"\w*.\x - \xo 24:2 \xt MRK 16:3; MRK 16:4; MAT 28:2; JHN 11:38; ACT 2:24; JHN 20:1\x*
