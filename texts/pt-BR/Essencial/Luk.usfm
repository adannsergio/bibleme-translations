\v 10 \w pois|strong="G1063"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w* \w veio|strong="G2064"\w* \w procurar|strong="G2212"\w* \w e|strong="G2532"\w* \w salvar|strong="G4982"\w* \w o que estava perdido|strong="G3588,G622"\w*.”\x - \xo 19:10 \xt EZK 34:16; JHN 10:10; MAT 9:13; MAT 18:11; MAT 1:21; 1TI 1:13-16\x*
