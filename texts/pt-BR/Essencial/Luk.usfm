\v 7 \w e|strong="G2532"\w* \w deu à luz|strong="G5088"\w* \w o seu filho|strong="G3588,G5207,G846"\w* \w primogênito|strong="G3588,G4416"\w*, \w e|strong="G2532"\w* \w o enrolou em faixas|strong="G4683,G846"\w* \w e|strong="G2532"\w* \w o deitou|strong="G347,G846"\w* \w numa manjedoura|strong="G1722,G5336"\w*, \w porque|strong="G1360"\w* \w não havia|strong="G3756,G1510"\w* \w lugar para eles|strong="G846,G5117"\w* \w no alojamento|strong="G1722,G3588,G2646"\w*.\f + \fr 2.7: \ft Lit.: φάτνη, “manjedoura, cocho de animais”; κατάλυμα, “alojamento, hospedaria, sala de hóspedes” (a mesma palavra em 22:11); σπαργανόω, “enrolar em faixas” (como se fazia com recém-nascidos).\f*\x - \xo 2:7 \xt MAT 2:1; GAL 4:4; 2CO 8:9; ISA 53:2; JHN 1:14; MAT 8:20\x*
\p
\v 8 \w E|strong="G2532"\w* \w havia|strong="G1510"\w* \w pastores|strong="G4166"\w* \w nessa mesma|strong="G1722,G3588,G846"\w* \w região|strong="G5561"\w*, \w vivendo ao ar livre|strong="G63"\w* \w e|strong="G2532"\w* \w vigiando|strong="G5442,G5438"\w* \w durante a noite|strong="G3588,G3571"\w* \w o seu rebanho|strong="G1909,G3588,G4167,G846"\w*.\x - \xo 2:8 \xt GEN 31:39; MAT 1:20; PSA 78:70-71; 1SA 17:34-35; EXO 3:1; GEN 31:40\x*
\v 9 \w E|strong="G2532"\w* \w um anjo|strong="G32"\w* \w do Senhor|strong="G2962"\w* \w apareceu|strong="G2186"\w* \w diante deles|strong="G846"\w*, \w e|strong="G2532"\w* \w a glória|strong="G1391"\w* \w do Senhor|strong="G2962"\w* \w resplandeceu ao redor|strong="G4034"\w* \w deles|strong="G846"\w*, \w e|strong="G2532"\w* \w ficaram com muito medo|strong="G5399,G5401,G3173"\w*.\f + \fr 2.9: \ft Variante: Treg e RP acrescentam “olhem” (ἰδού) depois de “e”: “e olhem, um anjo do Senhor…”.\f*\x - \xo 2:9 \xt ISA 60:1; HEB 1:14; JHN 1:51; 2CO 3:18; 1KI 8:11; ACT 27:23\x*
\v 10 \w E|strong="G2532"\w* \w o anjo|strong="G3588,G32"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Não tenham medo|strong="G3361,G5399"\w*; \w pois|strong="G1063"\w* \w olhem|strong="G2400"\w*, \w anuncio-lhes a boa notícia|strong="G2097,G4771"\w* \w de uma grande|strong="G3173"\w* \w alegria|strong="G5479"\w*, \w que será|strong="G3748,G1510"\w* \w para todo o povo|strong="G3956,G3588,G2992"\w*,\x - \xo 2:10 \xt ISA 41:10; ISA 40:9; ISA 61:1; ISA 52:7; MRK 16:15; GEN 12:3\x*
\v 11 \w pois|strong="G3754"\w* \w nasceu|strong="G5088"\w* \w para vocês|strong="G4771"\w* \w hoje|strong="G4594"\w* \w na cidade|strong="G1722,G4172"\w* \w de Davi|strong="G1138"\w* \w um Salvador|strong="G4990"\w*, \w que é|strong="G3739,G1510"\w* \w o Cristo|strong="G5547"\w*, \w o Senhor|strong="G2962"\w*.\f + \fr 2.11: \ft Lit.: χριστὸς κύριος, sem artigos: “Cristo, Senhor” ou “o Messias, o Senhor”; χριστός, “ungido, Messias”.\f*\x - \xo 2:11 \xt ISA 41:10; ISA 9:6; MAT 1:21; TIT 3:4-7; ACT 2:36; MAT 16:16\x*
\v 12 \w E|strong="G2532"\w* \w isto|strong="G3778"\w* \w será o sinal|strong="G3588,G4592"\w* \w para vocês|strong="G4771"\w*: \w encontrarão|strong="G2147"\w* \w um bebê|strong="G1025"\w* \w enrolado em faixas|strong="G4683"\w* \w e|strong="G2532"\w* \w deitado|strong="G2749"\w* \w numa manjedoura|strong="G1722,G5336"\w*.”\f + \fr 2.12: \ft Acréscimo: verbo ser/estar suprido em “será o sinal”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:12 \xt LUK 2:16; LUK 2:7; ISA 7:14; LUK 19:38; PRO 15:30; JHN 3:29\x*
\v 13 \w E|strong="G2532"\w* \w de repente|strong="G1810"\w* \w apareceu|strong="G1096"\w* \w com o anjo|strong="G4862,G3588,G32"\w* \w uma multidão|strong="G4128"\w* \w do exército celeste|strong="G4756,G3770"\w*, \w louvando|strong="G134"\w* \w a Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w dizendo|strong="G3004"\w*:\f + \fr 2.13: \ft Lit.: στρατιά, “exército, tropa”.\f*\x - \xo 2:13 \xt JHN 1:51; REV 5:11; HEB 1:14; PSA 103:20; PSA 148:2; 1KI 22:19\x*
\q1
\v 14 “\w Glória|strong="G1391"\w* \w a Deus|strong="G2316"\w* \w nas alturas|strong="G1722,G5310"\w*, \w e|strong="G2532"\w* \w na terra|strong="G1909,G1093"\w* \w paz|strong="G1515"\w* \w entre as pessoas|strong="G1722,G444"\w* \w que ele favorece|strong="G2107"\w*!”\f + \fr 2.14: \ft Lit.: εὐδοκίας, genitivo: “do favor, da boa vontade” (de Deus): “as pessoas a quem Deus favorece”; muitas leituras a entendem como “pessoas de boa vontade”.\f*\f + \fr 2.14: \ft Variante: o TR e o RP trazem εὐδοκία (nominativo) em lugar de εὐδοκίας: “na terra paz, entre as pessoas boa vontade”.\f*\x - \xo 2:14 \xt LUK 19:38; JHN 3:16; ROM 5:1; PHP 4:7; LUK 1:79; COL 1:20\x*
\p
\v 15 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w quando|strong="G5613"\w* \w os anjos|strong="G3588,G32"\w* \w se afastaram|strong="G565"\w* \w deles|strong="G575,G846"\w* \w para o céu|strong="G1519,G3588,G3772"\w*, \w os pastores|strong="G3588,G4166"\w* \w falavam|strong="G2980"\w* \w uns com os outros|strong="G4314,G240"\w*: “\w Vamos|strong="G1330"\w*, \w então|strong="G1211"\w*, \w até|strong="G2193"\w* \w Belém|strong="G965"\w* \w e|strong="G2532"\w* \w vejamos|strong="G1492"\w* \w este acontecimento|strong="G3588,G4487,G3778,G1096"\w* \w que|strong="G3739"\w* \w o Senhor|strong="G3588,G2962"\w* \w nos deu a conhecer|strong="G1107,G3165"\w*.”\f + \fr 2.15: \ft Acréscimo: “que” (em “E aconteceu que quando os”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 2:15 \xt MAT 2:1; PRO 15:30; 1PE 3:22; EXO 3:3; LUK 24:51; MAT 2:9-11\x*
\v 16 \w E|strong="G2532"\w* \w foram|strong="G2064"\w* \w às pressas|strong="G4692"\w* \w e|strong="G2532"\w* \w encontraram|strong="G429"\w* \w Maria|strong="G3588,G5037,G3137"\w* \w e|strong="G2532"\w* \w José|strong="G3588,G2501"\w* \w e|strong="G2532"\w* \w o bebê|strong="G3588,G1025"\w* \w deitado|strong="G2749"\w* \w na manjedoura|strong="G1722,G3588,G5336"\w*.\x - \xo 2:16 \xt LUK 2:12; MAT 2:11; LUK 19:32; PRO 15:30; LUK 2:7; LUK 22:13\x*
\v 17 \w Ao verem|strong="G1492"\w* \w deram a conhecer|strong="G1107"\w* \w a palavra|strong="G4012,G3588,G4487"\w* \w que lhes foi dita|strong="G3588,G2980,G846"\w* \w a respeito deste menino|strong="G4012,G3588,G3813,G3778"\w*.\x - \xo 2:17 \xt PRO 15:30; LUK 8:39; PSA 66:16; JHN 1:41; LUK 2:38; PSA 71:17-18\x*
\v 18 \w E|strong="G2532"\w* \w todos os que ouviram|strong="G3956,G3588,G191"\w* \w se admiraram|strong="G2296"\w* \w do que lhes foi dito|strong="G4012,G3588,G2980,G4314,G846"\w* \w pelos pastores|strong="G5259,G3588,G4166"\w*.\x - \xo 2:18 \xt PRO 15:30; LUK 1:65-66; LUK 4:36; ISA 8:18; LUK 2:33; LUK 2:47\x*
\v 19 \w Maria|strong="G3588,G3137"\w* \w guardava|strong="G4933"\w* \w todas estas coisas|strong="G3956,G3588,G4487,G3778"\w*, \w refletindo sobre elas|strong="G4820"\w* \w no seu coração|strong="G1722,G3588,G2588,G846"\w*.\f + \fr 2.19: \ft Lit.: ῥῆμα, “palavra” e também “coisa, acontecimento”; συμβάλλω, “juntar, ponderar, comparar”.\f*\x - \xo 2:19 \xt PSA 119:11; LUK 2:51; LUK 1:66; PRO 15:30; GEN 37:11; PRO 4:4\x*
\v 20 \w E|strong="G2532"\w* \w os pastores|strong="G3588,G4166"\w* \w voltaram|strong="G5290"\w*, \w glorificando|strong="G1392"\w* \w e|strong="G2532"\w* \w louvando|strong="G134"\w* \w a Deus|strong="G3588,G2316"\w* \w por tudo|strong="G1909,G3956"\w* \w o que|strong="G3739"\w* \w ouviram|strong="G191"\w* \w e|strong="G2532"\w* \w viram|strong="G1492"\w*, \w como lhes foi dito|strong="G2531,G2980,G4314,G846"\w*.\x - \xo 2:20 \xt MAT 2:10; PSA 13:5; PSA 106:48; ACT 11:18; 1CH 29:10-12; ISA 29:19\x*
\p
\v 21 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w se completaram|strong="G4130"\w* \w oito dias|strong="G2250,G3638"\w* \w para circuncidá-lo|strong="G3588,G4059,G846"\w*, \w foi-lhe dado|strong="G2564,G846"\w* \w o nome|strong="G3588,G3686"\w* \w de Jesus|strong="G2424"\w*, \w o nome que|strong="G3588"\w* \w foi dito|strong="G2564"\w* \w pelo anjo|strong="G5259,G3588,G32"\w* \w antes de|strong="G4253,G3588"\w* \w ele ser concebido|strong="G4815,G846"\w* \w no ventre|strong="G1722,G3588,G2836"\w*.\f + \fr 2.21: \ft Variante: O TR traz também “o menino” (τὸ παιδίον) depois de “circuncidar”.\f*\f + \fr 2.21: \ft Tradução: ἐκλήθη (καλέω, G2564) está aqui como “foi-lhe dado”; o termo pode ser “chamar”, “convidar”, “dar nome” ou “convocar”, e o contexto decide.\f*\x - \xo 2:21 \xt LUK 1:31; MAT 1:21; LUK 1:13; LEV 12:3; GEN 17:12; LUK 1:59\x*
\v 22 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w se completaram|strong="G4130"\w* \w os dias|strong="G3588,G2250"\w* \w da purificação|strong="G3588,G2512"\w* \w deles|strong="G846"\w* \w conforme a Lei|strong="G2596,G3588,G3551"\w* \w de Moisés|strong="G3475"\w*, \w o levaram|strong="G321,G846"\w* \w a Jerusalém|strong="G1519,G2414"\w* \w para apresentá-lo|strong="G3936"\w* \w ao Senhor|strong="G3588,G2962"\w*,\f + \fr 2.22: \ft Lit.: αὐτῶν, “deles”, no plural; a purificação de Lv 12:2-8 diz respeito à mãe.\f*\x - \xo 2:22 \xt LEV 12:2; LEV 12:1-8; 1SA 1:22; LEV 12:6; LUK 2:27; 1SA 1:25\x*
\v 23 \w conforme está escrito|strong="G2531,G1125"\w* \w na Lei|strong="G1722,G3551"\w* \w do Senhor|strong="G2962"\w*: “\w Todo macho|strong="G3956,G730"\w* \w que abrir|strong="G1272"\w* \w o útero|strong="G3388"\w* \w será chamado|strong="G2564"\w* \w santo|strong="G40"\w* \w para o Senhor|strong="G3588,G2962"\w*”,\f + \fr 2.23: \ft Nota cultural: citação de Êx 13:2 e 13:12 (a consagração do primogênito).\f*\x - \xo 2:23 \xt EXO 13:2; EXO 13:12; EXO 22:29; NUM 3:13; EXO 34:19; NUM 18:15\x*
\v 24 \w e|strong="G2532"\w* \w para oferecer|strong="G3588,G1325"\w* \w sacrifício|strong="G2378"\w* \w conforme o que foi dito|strong="G2596,G3588,G2046"\w* \w na Lei|strong="G1722,G3588,G3551"\w* \w do Senhor|strong="G2962"\w*: \w um par|strong="G2201"\w* \w de rolas|strong="G5167"\w* \w ou|strong="G2228"\w* \w dois filhotes|strong="G1417,G3502"\w* \w de pombas|strong="G4058"\w*.\f + \fr 2.24: \ft Nota cultural: a oferta de rolas ou pombas era a prevista para quem não podia oferecer um cordeiro (Lv 12:8).\f*\x - \xo 2:24 \xt LEV 12:8; LEV 12:6-8; MAT 21:12; LEV 12:2; ISA 11:1; LEV 1:14\x*
\p
\v 25 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w havia|strong="G1510"\w* \w um homem|strong="G444"\w* \w em Jerusalém|strong="G1722,G2419"\w*, \w cujo nome|strong="G3739,G3686"\w* \add era\add* \w Simeão|strong="G4826"\w*; \w e|strong="G2532"\w* \w este homem|strong="G3588,G444,G3778"\w* \w era justo|strong="G1342"\w* \w e|strong="G2532"\w* \w piedoso|strong="G2126"\w*, \w esperando|strong="G4327"\w* \w a consolação|strong="G3874"\w* \w de Israel|strong="G3588,G2474"\w*, \w e|strong="G2532"\w* \w o Espírito Santo|strong="G4151,G40"\w* \w estava|strong="G1510"\w* \w sobre ele|strong="G1909,G846"\w*.\f + \fr 2.25: \ft Lit.: εὐλαβής, “piedoso, que teme a Deus com reverência”; παράκλησις, “consolação, encorajamento”: “a consolação de Israel” é a esperança da restauração do povo.\f*\f + \fr 2.25: \ft Acréscimo: “era” (em “cujo nome era Simeão e”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige; verbo ser/estar suprido em “era justo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:25 \xt ACT 2:5; PSA 27:14; HAB 2:3; ISA 25:9; PHP 4:8; LUK 1:6\x*
\v 26 \w E|strong="G2532"\w* \w lhe havia sido revelado|strong="G1510,G846,G5537"\w* \w pelo Espírito Santo|strong="G5259,G3588,G4151,G40"\w* \w que não veria|strong="G3361,G1492"\w* \w a morte|strong="G2288"\w* \w antes de|strong="G4250,G2228,G302"\w* \w ver|strong="G1492"\w* \w o Cristo|strong="G3588,G5547"\w* \w do Senhor|strong="G2962"\w*.\f + \fr 2.26: \ft Lit.: χρηματίζω, “advertir ou revelar por ordem divina”; ὁ χριστὸς κυρίου, “o Ungido do Senhor”.\f*\x - \xo 2:26 \xt JHN 8:51; 1CO 2:10; HEB 11:5; LUK 2:11; LUK 9:27; MRK 9:1\x*
\v 27 \w E|strong="G2532"\w* \w veio|strong="G2064"\w* \w no Espírito|strong="G1722,G3588,G4151"\w* \w ao templo|strong="G1519,G3588,G2411"\w*; \w e|strong="G2532"\w*, \w quando|strong="G1722,G3588"\w* \w os pais|strong="G3588,G1118"\w* \w trouxeram|strong="G1521"\w* \w o menino|strong="G3588,G3813"\w* \w Jesus|strong="G2424"\w*, \w para fazerem|strong="G3588,G4160,G846"\w* \w por ele|strong="G4012,G846"\w* \w segundo o costume|strong="G2596,G3588,G1480"\w* \w da Lei|strong="G3588,G3551"\w*,\x - \xo 2:27 \xt MAT 2:11; MIC 7:7; LUK 4:1; ISA 11:1; HAG 2:7; LUK 2:22\x*
\v 28 \w ele mesmo|strong="G2532,G846"\w* \w o recebeu|strong="G1209,G846"\w* \w nos braços|strong="G1519,G3588,G43"\w*, \w e|strong="G2532"\w* \w bendisse|strong="G2127"\w* \w a Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*:\x - \xo 2:28 \xt MAT 2:11; MIC 7:7; ISA 25:9; PSA 119:41; EPH 1:3; ISA 11:1\x*
\q1
\v 29 “\w Agora|strong="G3568"\w* \w deixa partir|strong="G630"\w* \w o seu servo|strong="G3588,G1401,G4771"\w*, \w Soberano|strong="G1203"\w*, \w conforme|strong="G2596"\w* \w a sua palavra|strong="G3588,G4487,G4771"\w*, \w em paz|strong="G1722,G1515"\w*;\f + \fr 2.29: \ft Lit.: ἀπολύω, “soltar, deixar ir, dispensar”; δέσποτα, “senhor, soberano” (senhor de escravos).\f*\f + \fr 2.29: \ft Tradução: δοῦλόν (δοῦλος, G1401) está aqui como “o seu servo”; o termo pode ser “escravo” (condição social), “servo” ou “servidor”, e o contexto decide.\f*\x - \xo 2:29 \xt GEN 46:30; ISA 57:2; REV 14:13; MAT 13:16; MAT 2:11; MIC 7:7\x*
\q1
\v 30 \w porque|strong="G3754"\w* \w viram|strong="G1492"\w* \w os meus olhos|strong="G3588,G3788,G3165"\w* \w a sua salvação|strong="G3588,G4992,G4771"\w*,\f + \fr 2.30: \ft Lit.: σωτήριον, neutro: “salvação, meio de salvação”.\f*\x - \xo 2:30 \xt PSA 27:1; ISA 12:2; PSA 91:16; ACT 28:28; HAB 3:18; ISA 49:6\x*
\q1
\v 31 \w a qual|strong="G3739"\w* \w preparou|strong="G2090"\w* \w diante de|strong="G2596,G4383"\w* \w todos os povos|strong="G3956,G3588,G2992"\w*,\x - \xo 2:31 \xt MRK 16:15; ISA 12:2; ACT 28:28; PSA 62:1; ISA 62:1; LUK 2:10\x*
\q1
\v 32 \w luz|strong="G5457"\w* \w para a revelação|strong="G1519,G602"\w* \w dos gentios|strong="G1484"\w* \w e|strong="G2532"\w* \w glória|strong="G1391"\w* \w do seu povo|strong="G2992,G4771"\w* \w Israel|strong="G2474"\w*.”\f + \fr 2.32: \ft Lit.: ἔθνη, “nações, povos não judeus” (“gentios”); a frase ecoa Is 42:6 e 49:6.\f*\x - \xo 2:32 \xt ISA 49:6; ISA 42:6; ACT 26:23; ISA 60:1; PSA 3:3; JHN 8:12\x*
\v 33 \w E|strong="G2532"\w* \w o pai|strong="G3588,G3962"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w* \w estavam admirados|strong="G1510,G2296"\w* \w com o que|strong="G1909,G3588"\w* \w se dizia|strong="G2980"\w* \w a respeito dele|strong="G4012,G846"\w*.\f + \fr 2.33: \ft Variante: O RP lê “José” (Ἰωσήφ) em lugar de “o pai dele” (ὁ πατὴρ αὐτοῦ) e acrescenta “dele” (αὐτοῦ) depois de “a mãe”.\f*\x - \xo 2:33 \xt PRO 16:31; MAT 12:46; LUK 2:18; MRK 10:16\x*
\v 34 \w E|strong="G2532"\w* \w Simeão|strong="G4826"\w* \w os abençoou|strong="G2127,G846"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w* \w a Maria|strong="G4314,G3137"\w*, \w a mãe dele|strong="G3588,G3384,G846"\w*: “\w Olhe|strong="G2400"\w*, \w este|strong="G3778"\w* \w está destinado|strong="G2749"\w* \w à queda|strong="G1519,G4431"\w* \w e|strong="G2532"\w* \w ao levantar-se|strong="G386"\w* \w de muitos|strong="G4183"\w* \w em Israel|strong="G1722,G3588,G2474"\w* \w e|strong="G2532"\w* \w a ser um sinal|strong="G1519,G4592"\w* \w contestado|strong="G483"\w*,\f + \fr 2.34: \ft Lit.: κεῖται, “está posto, está destinado”; ἀνάστασις, “levantar-se, ressurreição”; ἀντιλέγω, “contradizer, contestar”.\f*\f + \fr 2.34: \ft Acréscimo: verbo ser/estar suprido em “a ser um sinal”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:34 \xt 1CO 1:23; 1PE 2:7-8; ISA 8:14; ISA 8:18; PSA 37:24; MAT 21:44\x*
\v 35 \w e|strong="G2532"\w* \w a você mesma|strong="G4771,G846"\w* \w também|strong="G1161"\w* \w uma espada|strong="G4501"\w* \w atravessará|strong="G1330"\w* \w a alma|strong="G3588,G5590"\w*, \w para que sejam revelados|strong="G3704,G302,G601"\w* \w os pensamentos|strong="G1261"\w* \w de muitos corações|strong="G1537,G4183,G2588"\w*.”\f + \fr 2.35: \ft Lit.: ῥομφαία, “espada larga”, imagem de dor; ψυχή, “alma, vida”; διαλογισμός, “pensamento, raciocínio, dúvida”.\f*\x - \xo 2:35 \xt 1CO 3:13; JHN 19:25; PRO 16:31; 1CO 11:19; DEU 8:2; MAT 13:57\x*
\v 36 \w E|strong="G2532"\w* \w havia|strong="G1510"\w* \w Ana|strong="G451"\w*, \w profetisa|strong="G4398"\w*, \w filha|strong="G2364"\w* \w de Fanuel|strong="G5323"\w*, \w da tribo|strong="G1537,G5443"\w* \w de Aser|strong="G768"\w* (\w ela|strong="G3778"\w* \w estava bem avançada|strong="G4260"\w* \w em idade|strong="G1722,G2250,G4183"\w*, \w tendo vivido|strong="G2198"\w* \w com um marido|strong="G3326,G435"\w* \w sete anos|strong="G2094,G2033"\w* \w desde a sua virgindade|strong="G575,G3588,G3932,G846"\w*,\f + \fr 2.36: \ft Lit.: παρθενία, “virgindade, tempo de moça solteira”.\f*\x - \xo 2:36 \xt REV 7:6; 1CO 11:5; EXO 15:20; PRO 16:31; PSA 92:14; 1CO 7:34\x*
\v 37 \w e|strong="G2532"\w* \w ela|strong="G846"\w* \w era viúva|strong="G5503"\w* \w até os oitenta e quatro anos|strong="G2193,G2094,G3589,G5064"\w*), \w ela que|strong="G3739"\w* \w não se afastava|strong="G3756,G868"\w* \w do templo|strong="G3588,G2411"\w*, \w servindo a Deus|strong="G3000"\w* \w com jejuns|strong="G3521"\w* \w e|strong="G2532"\w* \w orações|strong="G1162"\w* \w noite|strong="G3571"\w* \w e|strong="G2532"\w* \w dia|strong="G2250"\w*.\f + \fr 2.37: \ft Lit.: ἕως ἐτῶν ὀγδοήκοντα τεσσάρων, “até oitenta e quatro anos”: pode indicar a idade dela ou o tempo de viuvez; λατρεύω, “servir, prestar culto”.\f*\f + \fr 2.37: \ft Acréscimo: verbo ser/estar suprido em “era viúva”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:37 \xt 1TI 5:5; PSA 27:4; LUK 18:7; PSA 23:6; ACT 14:23; PSA 1:2\x*
\v 38 \w E|strong="G2532"\w*, \w naquela mesma hora|strong="G846,G3588,G5610"\w*, \w aproximando-se|strong="G2186"\w*, \w dava graças|strong="G437"\w* \w a Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w falava|strong="G2980"\w* \w a respeito dele|strong="G4012,G846"\w* \w a todos|strong="G3956,G3588"\w* \w os que esperavam|strong="G4327"\w* \w a redenção|strong="G3085"\w* \w de Jerusalém|strong="G2419"\w*.\f + \fr 2.38: \ft Lit.: ἀνθομολογέομαι, “reconhecer publicamente, dar graças em resposta”; λύτρωσις, “resgate, redenção”.\f*\f + \fr 2.38: \ft Variante: O RP acrescenta “ela” (αὕτη) depois de “e”, lê “Senhor” (κυρίῳ) em lugar de “Deus” (θεῷ) e acrescenta “em” (ἐν) antes de “Jerusalém”: “os que esperavam redenção em Jerusalém”.\f*\x - \xo 2:38 \xt PSA 27:14; PSA 130:5; ISA 8:17; LUK 2:25; MAT 2:11; MRK 15:43\x*
\v 39 \w E|strong="G2532"\w* \w quando|strong="G5613"\w* \w cumpriram|strong="G5055"\w* \w tudo|strong="G3956,G3588"\w* \w segundo|strong="G2596"\w* \w a Lei|strong="G3588,G3551"\w* \w do Senhor|strong="G2962"\w*, \w voltaram|strong="G1994"\w* \w para a Galileia|strong="G1519,G3588,G1056"\w*, \w para a sua cidade|strong="G1519,G4172,G1438"\w*, \w Nazaré|strong="G3478"\w*.\x - \xo 2:39 \xt LUK 2:4; MAT 21:11; JHN 1:31; MAT 2:22; DEU 12:32; GAL 4:4-5\x*
\p
\v 40 \w O menino|strong="G3588,G3813"\w* \w crescia|strong="G837"\w* \w e|strong="G2532"\w* \w se fortalecia|strong="G2901"\w*, \w cheio|strong="G4137"\w* \w de sabedoria|strong="G4678"\w*, \w e|strong="G2532"\w* \w a graça|strong="G5485"\w* \w de Deus|strong="G2316"\w* \w estava|strong="G1510"\w* \w sobre ele|strong="G1909,G846"\w*.\f + \fr 2.40: \ft Variante: O RP lê πνεύματι πληρούμενον σοφίας: acrescenta “em espírito” e põe “sabedoria” no genitivo (“cheio de sabedoria”).\f*\x - \xo 2:40 \xt LUK 1:80; LUK 2:52; ECC 12:1; ISA 11:1-5; 1SA 2:26; JHN 1:14\x*
\p
\v 41 \w E|strong="G2532"\w* \w os pais|strong="G3588,G1118"\w* \w dele|strong="G846"\w* \w iam|strong="G4198"\w* \w todos os anos|strong="G2596,G2094"\w* \w a Jerusalém|strong="G1519,G2419"\w* \w para a festa|strong="G3588,G1859"\w* \w da Páscoa|strong="G3588,G3957"\w*.\x - \xo 2:41 \xt ECC 12:1; JHN 2:13; 1SA 1:3; JHN 1:31; 1SA 1:22; DEU 12:18\x*
\v 42 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w ele fez|strong="G1096"\w* \w doze anos|strong="G2094,G1427"\w*, \w subindo eles|strong="G305,G846"\w* \w segundo o costume|strong="G2596,G3588,G1485"\w* \w da festa|strong="G3588,G1859"\w*\f + \fr 2.42: \ft Variante: Treg e RP acrescentam “a Jerusalém” (εἰς Ἱεροσόλυμα) depois de “eles”; o RP lê ἀναβάντων (“tendo subido”) em lugar de ἀναβαινόντων (“subindo”).\f*,\x - \xo 2:42 \xt ECC 12:1; JHN 1:31; 1SA 1:22\x*
\v 43 \w e|strong="G2532"\w*, \w terminados|strong="G5048"\w* \w os dias|strong="G3588,G2250"\w*, \w quando|strong="G1722,G3588"\w* \w eles voltavam|strong="G5290,G846"\w*, \w ficou|strong="G5278"\w* \w o menino|strong="G3588,G3816"\w* \w Jesus|strong="G2424"\w* \w em Jerusalém|strong="G1722,G2419"\w*, \w e|strong="G2532"\w* \w os pais|strong="G3588,G1118"\w* \w dele|strong="G846"\w* \w não perceberam|strong="G3756,G1097"\w*.\f + \fr 2.43: \ft Variante: O RP lê “José e a mãe dele não perceberam” (ἔγνω Ἰωσὴφ καὶ ἡ μήτηρ αὐτοῦ) em lugar de “os pais dele não perceberam” (ἔγνωσαν οἱ γονεῖς αὐτοῦ).\f*\x - \xo 2:43 \xt ECC 12:1; LUK 24:52; JHN 17:23\x*
\v 44 \w Supondo|strong="G3543"\w* \w que ele estava|strong="G846,G1511"\w* \w na caravana|strong="G1722,G3588,G4923"\w*, \w andaram|strong="G2064"\w* \w um dia|strong="G2250"\w* \w de caminho|strong="G3598"\w* \w e|strong="G2532"\w* \w o procuravam|strong="G327,G846"\w* \w entre os parentes|strong="G1722,G3588,G4773"\w* \w e|strong="G2532"\w* \w os conhecidos|strong="G3588,G1110"\w*,\f + \fr 2.44: \ft Lit.: συνοδία, “caravana, grupo de viajantes”; ἡμέρας ὁδόν, “caminho de um dia” (uma jornada diária).\f*\x - \xo 2:44 \xt ECC 12:1; ISA 2:3; PSA 122:1-4\x*
\v 45 \w e|strong="G2532"\w* \w como não o encontraram|strong="G3361,G2147"\w*, \w voltaram|strong="G5290"\w* \w a Jerusalém|strong="G1519,G2419"\w* \w à procura dele|strong="G327,G846"\w*.\x - \xo 2:45 \xt LUK 17:18; ECC 12:1; LUK 24:33\x*
\v 46 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w depois de|strong="G3326"\w* \w três dias|strong="G2250,G5140"\w*, \w o encontraram|strong="G2147,G846"\w* \w no templo|strong="G1722,G3588,G2411"\w*, \w sentado|strong="G2516"\w* \w no meio|strong="G1722,G3319"\w* \w dos mestres|strong="G3588,G1320"\w*, \w ouvindo-os|strong="G2532,G191,G846"\w* \w e|strong="G2532"\w* \w fazendo-lhes perguntas|strong="G1905,G846"\w*.\f + \fr 2.46: \ft Acréscimo: “que” (em “E aconteceu que depois de”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 2:46 \xt ECC 12:1; PSA 84:10; ACT 5:34; ISA 49:1-2; LUK 5:17; ISA 50:4\x*
\v 47 \w Ficavam atônitos|strong="G1839"\w* \w todos os que o ouviam|strong="G3956,G3588,G191,G846"\w* \w por causa da inteligência|strong="G1909,G3588,G4907"\w* \w e|strong="G2532"\w* \w das respostas|strong="G3588,G612"\w* \w dele|strong="G846"\w*.\x - \xo 2:47 \xt ECC 12:1; LUK 2:40; MAT 7:28; LUK 4:32; PRO 20:11; PSA 119:99\x*
\v 48 \w E|strong="G2532"\w* \w ao verem-no|strong="G1492,G846"\w* \w ficaram assombrados|strong="G1605"\w*, \w e|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w* \w dele|strong="G846"\w* \w lhe disse|strong="G2036,G4314,G846"\w*: “\w Filho|strong="G5043"\w*, \w por que|strong="G5101"\w* \w você fez|strong="G4160"\w* \w assim conosco|strong="G3165,G3779"\w*? \w Olhe|strong="G2400"\w*, \w o seu pai|strong="G3588,G3962,G4771"\w* \w e|strong="G2532"\w* \w eu|strong="G1473"\w* \w angustiados|strong="G3600"\w* \w procurávamos|strong="G2212"\w* \w você|strong="G4771"\w*.”\x - \xo 2:48 \xt MAT 12:46; LUK 2:49; ECC 12:1; LUK 2:27; MAT 1:16\x*
\v 49 \w E|strong="G2532"\w* \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Por que|strong="G5101,G3754"\w* \w me procuravam|strong="G2212,G3165"\w*? \w Não sabiam|strong="G3756,G1492"\w* \w que|strong="G3754"\w* \w é preciso|strong="G1163"\w* \w que eu esteja|strong="G1511,G3165"\w* \w nas coisas|strong="G1722,G3588"\w* \w do meu Pai|strong="G3588,G3962,G3165"\w*?”\f + \fr 2.49: \ft Lit.: ἐν τοῖς τοῦ πατρός μου, literalmente “nas (coisas) do meu Pai”: pode significar “na casa do meu Pai” ou “nos assuntos do meu Pai”; δεῖ, “é preciso, é necessário”.\f*\x - \xo 2:49 \xt JHN 6:38; JHN 8:29; MAL 3:1; PSA 40:8; JHN 4:34; LUK 2:48\x*
\v 50 \w E|strong="G2532"\w* \w eles|strong="G846"\w* \w não entenderam|strong="G3756,G4920"\w* \w a palavra|strong="G3588,G4487"\w* \w que|strong="G3739"\w* \w lhes disse|strong="G2980,G846"\w*.\x - \xo 2:50 \xt LUK 18:34; ECC 12:1; MRK 9:32; LUK 9:45\x*
\v 51 \w E|strong="G2532"\w* \w desceu|strong="G2597"\w* \w com eles|strong="G3326,G846"\w* \w e|strong="G2532"\w* \w foi|strong="G2064"\w* \w a Nazaré|strong="G1519,G3478"\w*, \w e|strong="G2532"\w* \w vivia|strong="G1510"\w* \w sujeito a eles|strong="G5293,G846"\w*. \w E|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w* \w dele|strong="G846"\w* \w guardava|strong="G1301"\w* \w todas estas coisas|strong="G3956,G3588,G4487,G3778"\w* \w no coração|strong="G1722,G3588,G2588"\w* \w dela|strong="G846"\w*.\x - \xo 2:51 \xt PSA 119:11; LUK 2:19; ECC 12:1; EPH 6:1; COL 3:16; DEU 6:6\x*
\v 52 \w E|strong="G2532"\w* \w Jesus|strong="G2424"\w* \w progredia|strong="G4298"\w* \w em sabedoria|strong="G4678"\w* \w e|strong="G2532"\w* \w em estatura|strong="G2244"\w* \w e|strong="G2532"\w* \w em graça|strong="G5485"\w* \w diante de|strong="G3844"\w* \w Deus|strong="G2316"\w* \w e|strong="G2532"\w* \w das pessoas|strong="G444"\w*.\f + \fr 2.52: \ft Lit.: ἡλικία, “estatura” ou “idade”; προκόπτω, “avançar, progredir”.\f*\x - \xo 2:52 \xt LUK 2:40; PRO 3:3-4; 1SA 2:26; PRO 3:4; ROM 14:18; LUK 1:80\x*
\c 3
\p
\v 1 \w Ora|strong="G1161"\w*, \w no|strong="G1722"\w* \w décimo quinto|strong="G4003"\w* \w ano|strong="G2094"\w* \w do governo|strong="G3588,G2231"\w* \w de Tibério|strong="G5086"\w* \w César|strong="G2541"\w*, \w sendo governador|strong="G2230"\w* \w Pôncio Pilatos|strong="G4194,G4091"\w* \w da Judeia|strong="G3588,G2449"\w*, \w e|strong="G2532"\w* \w Herodes|strong="G2264"\w* \w tetrarca|strong="G5075"\w* \w da Galileia|strong="G3588,G1056"\w*, \w e Filipe|strong="G5376,G1161"\w*, \w seu irmão|strong="G3588,G80,G846"\w*, \w tetrarca|strong="G5075"\w* \w da região|strong="G5561"\w* \w da Itureia|strong="G3588,G2484"\w* \w e|strong="G2532"\w* \w da Traconites|strong="G5139"\w*, \w e|strong="G2532"\w* \w Lisânias|strong="G3078"\w* \w tetrarca|strong="G5075"\w* \w de Abilene|strong="G3588,G9"\w*,\f + \fr 3.1: \ft Nota cultural: o décimo quinto ano de Tibério costuma ser situado por volta de 28-29 d.C.; “tetrarca” designa o governante de uma parte (originalmente um quarto) de um território dividido.\f*\x - \xo 3:1 \xt ACT 4:27; LUK 2:1; GEN 49:10; LUK 23:6-11; MAT 3:1; ACT 13:1\x*
\v 2 \w no tempo do sumo sacerdote|strong="G1909,G749"\w* \w Anás|strong="G452"\w* \w e|strong="G2532"\w* \w Caifás|strong="G2533"\w*, \w veio|strong="G1096"\w* \w a palavra|strong="G4487"\w* \w de Deus|strong="G2316"\w* \w a João|strong="G1909,G2491"\w*, \w filho|strong="G3588,G5207"\w* \w de Zacarias|strong="G2197"\w*, \w no deserto|strong="G1722,G3588,G2048"\w*.\f + \fr 3.2: \ft Lit.: ἀρχιερέως, singular, seguido de dois nomes: Anás e Caifás.\f*\x - \xo 3:2 \xt JHN 18:24; ACT 4:6; JHN 18:13; JHN 11:49; MAT 26:3; ISA 40:3\x*
\v 3 \w E|strong="G2532"\w* \w ele foi|strong="G2064"\w* \w a toda|strong="G1519,G3956"\w* \w a região ao redor|strong="G4066"\w* \w do Jordão|strong="G3588,G2446"\w*, \w proclamando|strong="G2784"\w* \w um batismo|strong="G908"\w* \w de arrependimento|strong="G3341"\w* \w para o perdão|strong="G1519,G859"\w* \w de pecados|strong="G266"\w*,\f + \fr 3.3: \ft Lit.: περίχωρος, “região ao redor, vizinhança”; μετάνοια, “mudança de mente, arrependimento”.\f*\x - \xo 3:3 \xt MRK 1:4; MAT 3:5; ACT 19:4; LUK 24:47; LUK 1:77; ACT 13:24\x*
\v 4 \w como está escrito|strong="G5613,G1125"\w* \w no livro|strong="G1722,G976"\w* \w das palavras|strong="G3056"\w* \w de Isaías|strong="G2268"\w*, \w o profeta|strong="G3588,G4396"\w*: “\w Voz|strong="G5456"\w* \w de alguém que clama|strong="G994"\w* \w no deserto|strong="G1722,G3588,G2048"\w*: ‘\w Preparem|strong="G2090"\w* \w o caminho|strong="G3588,G3598"\w* \w do Senhor|strong="G2962"\w*, \w façam|strong="G4160"\w* \w retas|strong="G2117"\w* \w as veredas|strong="G3588,G5147"\w* \w dele|strong="G846"\w*.\f + \fr 3.4: \ft Nota cultural: cita Is 40:3-5, na forma da LXX.\f*\x - \xo 3:4 \xt ISA 40:3; MAT 3:3; MRK 1:3; JHN 1:23; ISA 43:19; JHN 1:6\x*
\v 5 \w Todo vale|strong="G3956,G5327"\w* \w será preenchido|strong="G4137"\w*, \w e|strong="G2532"\w* \w todo monte|strong="G3956,G3735"\w* \w e|strong="G2532"\w* \w colina|strong="G1015"\w* \w será rebaixado|strong="G5013"\w*, \w e|strong="G2532"\w* \w o que é torto|strong="G3588,G4646"\w* \w será|strong="G1510"\w* \w reto|strong="G1519,G2117"\w*, \w e|strong="G2532"\w* \w os lugares ásperos|strong="G3588,G5138"\w* \w serão caminhos planos|strong="G1519,G3598,G3006"\w*;\f + \fr 3.5: \ft Acréscimo: verbo ser/estar suprido em “o que é torto”, “serão caminhos planos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:5 \xt ISA 43:19; ISA 45:2; ISA 40:3; ISA 40:4; ISA 42:16; JHN 1:23\x*
\v 6 \w e|strong="G2532"\w* \w verá|strong="G3700"\w* \w toda carne|strong="G3956,G4561"\w* \w a salvação|strong="G3588,G4992"\w* \w de Deus|strong="G3588,G2316"\w*.’”\f + \fr 3.6: \ft Lit.: σάρξ, “carne”: aqui “toda a humanidade”; τὸ σωτήριον, “a salvação”; o texto cita Is 40:3-5.\f*\x - \xo 3:6 \xt ISA 40:3; JOL 2:28; JER 32:27; PSA 27:1; JHN 1:23; ISA 52:10\x*
\p
\v 7 \w Dizia|strong="G3004"\w*, \w então|strong="G3767"\w*, \w às multidões|strong="G3588,G3793"\w* \w que saíam|strong="G1607"\w* \w para serem batizadas|strong="G907"\w* \w por ele|strong="G5259,G846"\w*: “\w Raça|strong="G1081"\w* \w de víboras|strong="G2191"\w*, \w quem|strong="G5101"\w* \w lhes mostrou|strong="G5263,G4771"\w* \w como fugir|strong="G5343"\w* \w da ira|strong="G575,G3588,G3709"\w* \w que está para vir|strong="G3195"\w*?\f + \fr 3.7: \ft Lit.: γεννήματα ἐχιδνῶν, “raça (filhotes) de víboras”.\f*\x - \xo 3:7 \xt MAT 3:7; MAT 23:33; MAT 12:34; JHN 1:6; 1TH 1:10; ISA 56:1\x*
\v 8 \w Produzam|strong="G4160"\w*, \w então|strong="G3767"\w*, \w frutos|strong="G2590"\w* \w dignos|strong="G514"\w* \w do arrependimento|strong="G3588,G3341"\w*; \w e|strong="G2532"\w* \w não comecem|strong="G3361,G757"\w* \w a dizer|strong="G3004"\w* \w entre si|strong="G1722,G1438"\w*: ‘\w Temos|strong="G2192"\w* \w Abraão|strong="G3588,G11"\w* \w como pai|strong="G3962"\w*.’ \w Pois|strong="G1063"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w Deus|strong="G3588,G2316"\w* \w pode|strong="G1410"\w* \w destas pedras|strong="G1537,G3588,G3037,G3778"\w* \w fazer surgir|strong="G1453"\w* \w filhos|strong="G5043"\w* \w para Abraão|strong="G3588,G11"\w*.\x - \xo 3:8 \xt MAT 3:8; MAT 3:9; EZK 18:27-31; ACT 26:20; LUK 19:9; ISA 1:16-18\x*
\v 9 \w E|strong="G1161"\w* \w já também|strong="G2235,G2532"\w* \w o machado|strong="G3588,G513"\w* \w está posto|strong="G2749"\w* \w junto à raiz|strong="G4314,G3588,G4491"\w* \w das árvores|strong="G3588,G1186"\w*; \w toda árvore|strong="G3956,G1186"\w*, \w então|strong="G3767"\w*, \w que não produz|strong="G3361,G4160"\w* \w fruto bom|strong="G2590,G2570"\w* \w é cortada|strong="G1581"\w* \w e|strong="G2532"\w* \w lançada|strong="G906"\w* \w no fogo|strong="G1519,G4442"\w*.”\x - \xo 3:9 \xt MAT 3:10; MAT 7:19; MAT 12:33; LUK 13:9; MAT 21:19; JHN 1:6\x*
\v 10 \w E|strong="G2532"\w* \w as multidões|strong="G3588,G3793"\w* \w lhe perguntavam|strong="G1905,G846"\w*, \w dizendo|strong="G3004"\w*: “\w O que|strong="G5101"\w* \w devemos fazer|strong="G4160"\w*, \w então|strong="G3767"\w*?”\x - \xo 3:10 \xt MRK 7:17; ACT 2:37; JHN 1:6; LUK 3:14; ACT 16:30; LUK 1:17\x*
\v 11 \w Respondendo|strong="G611"\w*, \w lhes dizia|strong="G3004,G846"\w*: “\w Quem tem|strong="G3588,G2192"\w* \w duas túnicas|strong="G1417,G5509"\w* \w reparta|strong="G3330"\w* \w com quem não tem|strong="G3588,G3361,G2192"\w*, \w e|strong="G2532"\w* \w quem tem|strong="G3588,G2192"\w* \w comida|strong="G1033"\w* \w faça o mesmo|strong="G3668,G4160"\w*\f + \fr 3.11: \ft Lit.: χιτών, “túnica, veste usada junto ao corpo”; βρώματα, “alimentos, comida”.\f*.”\x - \xo 3:11 \xt 1JN 3:17; ISA 58:7; JAS 2:15; 1TI 6:18; JHN 1:6; LUK 18:22\x*
\v 12 \w E|strong="G1161"\w* \w vieram|strong="G2064"\w* \w também|strong="G2532"\w* \w cobradores de impostos|strong="G5057"\w* \w para serem batizados|strong="G907"\w* \w e|strong="G2532"\w* \w lhe disseram|strong="G2036,G4314,G846"\w*: “\w Mestre|strong="G1320"\w*, \w o que|strong="G5101"\w* \w devemos fazer|strong="G4160"\w*?”\f + \fr 3.12: \ft Nota cultural: τελώνης, “cobrador de impostos” a serviço do sistema romano, visto com desconfiança por muitos (cf. Mt 9:10-11).\f*\x - \xo 3:12 \xt MAT 9:10-11; LUK 7:29; MAT 9:11; JHN 1:6; LUK 1:17; EPH 4:28\x*
\v 13 \w Ele|strong="G3588"\w* \w lhes disse|strong="G2036,G4314,G846"\w*: “\w Não cobrem nada|strong="G3367,G4238"\w* \w a mais|strong="G4119"\w* \w do que|strong="G3844,G3588"\w* \w foi determinado|strong="G1299"\w* \w a vocês|strong="G4771"\w*\f + \fr 3.13: \ft Lit.: πράσσω, “fazer, praticar”; no contexto fiscal, “cobrar”.\f*.”\x - \xo 3:13 \xt JHN 1:6; LUK 1:17; LUK 19:8; EPH 4:28; MAT 3:1; 1CO 6:10\x*
\v 14 \w E|strong="G1161"\w* \w lhe perguntavam|strong="G1905,G846"\w* \w também|strong="G2532"\w* \w soldados|strong="G4754"\w*, \w dizendo|strong="G3004"\w*: “\w O que|strong="G5101"\w* \w devemos fazer|strong="G4160"\w* \w nós também|strong="G2532,G3165"\w*?” \w E|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: “\w A ninguém|strong="G3367"\w* \w extorquam|strong="G1286"\w*, \w nem|strong="G3366"\w* \w acusem falsamente|strong="G4811"\w*, \w e|strong="G2532"\w* \w contentem-se|strong="G714"\w* \w com o soldo|strong="G3588,G3800"\w* \w de vocês|strong="G4771"\w*.”\f + \fr 3.14: \ft Lit.: διασείω, “sacudir, intimidar para tirar dinheiro”; συκοφαντέω, “acusar falsamente, extorquir mediante denúncia”; ὀψώνιον, “soldo, ração de soldado”.\f*\x - \xo 3:14 \xt HEB 13:5; 1TI 6:6; EXO 20:16; JHN 1:6; PHP 4:11; 1TI 6:8-10\x*
\v 15 \w Como|strong="G1161"\w* \w o povo|strong="G3588,G2992"\w* \w estava em expectativa|strong="G4328"\w* \w e|strong="G2532"\w* \w todos|strong="G3956"\w* \w se perguntavam|strong="G1260"\w* \w em seus corações|strong="G1722,G3588,G2588,G846"\w* \w a respeito de|strong="G4012"\w* \w João|strong="G3588,G2491"\w*, \w se acaso|strong="G4218,G3361"\w* \w ele|strong="G846"\w* \w seria|strong="G1510"\w* \w o Cristo|strong="G3588,G5547"\w*,\f + \fr 3.15: \ft Lit.: ὁ χριστός, “o Ungido, o Messias”.\f*\x - \xo 3:15 \xt MAT 21:25; JHN 1:6; JHN 1:20; JHN 1:19; JHN 10:24; MAT 3:1\x*
\v 16 \w respondeu|strong="G611"\w* \w a todos|strong="G3956"\w* \w João|strong="G3588,G2491"\w*, \w dizendo|strong="G3004"\w*: “\w Eu|strong="G1473"\w*, \w de fato|strong="G3303"\w*, \w batizo|strong="G907"\w* \w vocês|strong="G4771"\w* \w com água|strong="G5204"\w*; \w mas|strong="G1161"\w* \w vem|strong="G2064"\w* \w aquele que é mais forte|strong="G3588,G2478"\w* \w do que eu|strong="G3165"\w*, \w de quem|strong="G3739"\w* \w não sou|strong="G3756,G1510"\w* \w digno|strong="G2425"\w* \w de desatar|strong="G3089"\w* \w a correia|strong="G3588,G2438"\w* \w das sandálias|strong="G3588,G5266"\w* \w dele|strong="G846"\w*; \w ele mesmo|strong="G846"\w* \w batizará|strong="G907"\w* \w vocês|strong="G4771"\w* \w com o Espírito Santo|strong="G1722,G4151,G40"\w* \w e|strong="G2532"\w* \w com fogo|strong="G4442"\w*.\f + \fr 3.16: \ft Nota cultural: desatar a correia das sandálias era serviço de escravo.\f*\f + \fr 3.16: \ft Acréscimo: verbo ser/estar suprido em “aquele que é mais forte”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:16 \xt MAT 3:11; ACT 1:5; MRK 1:7; JHN 1:27; JHN 1:26; ACT 11:16\x*
\v 17 \w Cuja pá de joeirar|strong="G3739,G3588,G4425"\w* \w está na mão|strong="G1722,G3588,G5495"\w* \w dele|strong="G846"\w*, \w para limpar|strong="G6016"\w* \w a sua eira|strong="G3588,G257,G846"\w* \w e|strong="G2532"\w* \w recolher|strong="G4863"\w* \w o trigo|strong="G3588,G4621"\w* \w no seu celeiro|strong="G1519,G3588,G596,G846"\w*; \w a palha|strong="G3588,G892"\w* \w queimará|strong="G2618"\w* \w com fogo|strong="G4442"\w* \w que não se apaga|strong="G762"\w*.”\f + \fr 3.17: \ft Lit.: πτύον, “pá de joeirar” (instrumento para lançar o grão ao vento); ἀσβέστῳ, “inextinguível, que não se apaga”.\f*\f + \fr 3.17: \ft Acréscimo: verbo ser/estar suprido em “está na mão”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:17 \xt MAT 3:12; MAT 13:30; JER 15:7; JHN 1:6; MIC 4:12; JHN 1:20\x*
\v 18 \w Assim|strong="G3303,G3767"\w*, \w exortando|strong="G3870"\w* \w com muitas outras|strong="G4183,G2532,G2087"\w* \add coisas,\add* \w anunciava a boa notícia|strong="G2097"\w* \w ao povo|strong="G3588,G2992"\w*\f + \fr 3.18: \ft Lit.: παρακαλέω, “exortar, encorajar, pedir”; εὐαγγελίζομαι, “anunciar a boa notícia”.\f*;\f + \fr 3.18: \ft Acréscimo: “coisas” (em “muitas outras coisas anunciava a”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 3:18 \xt JHN 1:6; JHN 1:19; MAT 3:1; ACT 19:4; ACT 2:40; JHN 1:29\x*
\v 19 \w Herodes|strong="G3588,G2264"\w*, \w o tetrarca|strong="G3588,G5076"\w* \w repreendido|strong="G1651"\w* \w por ele|strong="G5259,G846"\w* \w por causa de|strong="G4012"\w* \w Herodíades|strong="G2266"\w*, \w a mulher|strong="G3588,G1135"\w* \w do irmão dele|strong="G3588,G80,G846"\w*, \w e|strong="G2532"\w* \w por causa de|strong="G4012"\w* \w todas as coisas|strong="G3956"\w* \w más|strong="G4190"\w* \w que|strong="G3739"\w* \w fez|strong="G4160"\w* \w Herodes|strong="G3588,G2264"\w*,\f + \fr 3.19: \ft Lit.: ἐλέγχω, “repreender, expor, convencer de culpa”.\f*\f + \fr 3.19: \ft Variante: O TR acrescenta “Filipe” (Φιλίππου) antes de “do irmão dele”: “a mulher de Filipe, seu irmão”.\f*\x - \xo 3:19 \xt MRK 6:17; MAT 14:3; EPH 5:11; JHN 1:6; MAT 3:1; ACT 13:1\x*
\v 20 \w acrescentou|strong="G4369"\w* \w também|strong="G2532"\w* \w isto|strong="G3778"\w* \w a tudo|strong="G1909,G3956"\w*: \w e|strong="G2532"\w* \w prendeu|strong="G2623"\w* \w João|strong="G3588,G2491"\w* \w na prisão|strong="G1722,G5438"\w*.\x - \xo 3:20 \xt JHN 3:24; JHN 1:6; MAT 4:12; MRK 6:17; MAT 3:1; MAT 14:3\x*
\p
\v 21 \w Aconteceu|strong="G1096,G1161"\w* \add que,\add* \w quando|strong="G1722,G3588"\w* \w todo o povo|strong="G537,G3588,G2992"\w* \w foi batizado|strong="G907"\w* \w e|strong="G2532"\w* \w Jesus|strong="G2424"\w*, \w depois de batizado|strong="G907"\w* \w e|strong="G2532"\w* \w enquanto orava|strong="G4336"\w*, \w o céu se abriu|strong="G455,G3588,G3772"\w*\f + \fr 3.21: \ft Acréscimo: “que” (em “Aconteceu que quando todo”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 3:21 \xt LUK 19:48; MAT 3:16; JHN 1:32-34; EZK 1:1; JHN 1:51; LUK 4:1\x*
\v 22 \w e|strong="G2532"\w* \w o Espírito Santo|strong="G3588,G4151,G40"\w* \w desceu|strong="G2597"\w* \w em forma corporal|strong="G4984,G1491"\w* \w como uma pomba|strong="G5613,G4058"\w* \w sobre ele|strong="G1909,G846"\w*, \w e|strong="G2532"\w* \w veio|strong="G1096"\w* \w uma voz|strong="G5456"\w* \w do céu|strong="G1537,G3772"\w*: “\w Você|strong="G4771"\w* \w é|strong="G1510"\w* \w o meu Filho|strong="G3588,G5207,G3165"\w*, \w o amado|strong="G3588,G27"\w*; \w em você|strong="G1722,G4771"\w* \w me agrado|strong="G2106"\w*.”\f + \fr 3.22: \ft Lit.: ἀγαπητός, “amado, querido” (também “único”); εὐδόκησα, aoristo: “agradei-me, tive prazer” (aqui com sentido de presente); cf. Sl 2:7 e Is 42:1.\f*\x - \xo 3:22 \xt ISA 42:1; PSA 2:7; 2PE 1:17; MAT 3:17; JHN 1:32; MRK 1:11\x*
\p
\v 23 \w E|strong="G2532"\w* \w o próprio|strong="G846"\w* \w Jesus|strong="G2424"\w* \w estava começando|strong="G1510,G757"\w* \w com cerca de|strong="G5616"\w* \w trinta anos|strong="G2094,G5144"\w*, \w sendo filho|strong="G1510,G5207"\w*, \w como se pensava|strong="G5613,G3543"\w*, \w de José|strong="G2501"\w*, \w filho de|strong="G3588"\w* \w Eli|strong="G2242"\w*,\f + \fr 3.23: \ft Lit.: ἀρχόμενος, “começando”: o texto não diz o quê (subentende-se o ministério); ὡς ἐνομίζετο, “como se pensava”; a lista seguinte vai de Jesus até Adão e Deus (3:23-38), em ordem ascendente.\f*\x - \xo 3:23 \xt JHN 1:45; LUK 4:22; MAT 13:55; ACT 1:1; JHN 6:42; NUM 4:3\x*
