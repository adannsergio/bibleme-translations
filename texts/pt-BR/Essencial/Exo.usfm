\v 12 \add Por\add* \w que|strong="H4100"\w* \w dirão|strong="H0559"\w* \w os egípcios|strong="H4713"\w*: \add 'Foi por\add* \w mal|strong="H0559,H7451"\w* que \w os|strong="H3318"\w* tirou, \w para os matar|strong="H2026,H0853"\w* \w nos montes|strong="H2022"\w* \w e os consumir|strong="H3615"\w* \w da face|strong="H5921,H6440"\w* \w da terra|strong="H0127"\w*'? \w Volta-te|strong="H7725"\w* \w do ardor|strong="H2740"\w* \w da tua ira|strong="H0639"\w* \w e arrepende-te|strong="H5162"\w* \w d|strong="H5921"\w* \add o\add* \w mal|strong="H7451"\w* \w contra o teu povo|strong="H5971"\w*.\x - \xo 32:12 \xt JON 3:9; EXO 32:14; PSA 85:3; JER 18:8; EZK 22:30; JER 15:1\x*
