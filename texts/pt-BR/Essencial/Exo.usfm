\v 7 \w E disse|strong="H0559"\w* \w o SENHOR|strong="H3068"\w*: \add "Com\add* \w certeza|strong="H7200"\w* \w vi|strong="H7200"\w* \w a aflição|strong="H6040"\w* \w do meu povo|strong="H5971"\w* \w que|strong="H0834"\w* \w está no Egito|strong="H4714"\w*, \w e|strong="H0853"\w* \w ouvi|strong="H8085"\w* \w o seu clamor|strong="H6818"\w* \w por causa|strong="H6440"\w* \w de seus capatazes|strong="H5065"\w*, \w pois|strong="H3588"\w* \w conheço|strong="H3045"\w* \w as suas dores|strong="H4341"\w*.\x - \xo 3:7 \xt PSA 145:19; PSA 106:44; EXO 2:23; PSA 12:5; PSA 34:6; EXO 22:23\x*
