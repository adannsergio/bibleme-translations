\v 32 \w Ao entardecer|strong="G3798,G1096"\w*, \w quando|strong="G3753"\w* \w o sol|strong="G3588,G2246"\w* \w se pôs|strong="G1416"\w*, \w traziam|strong="G5342"\w* \w a ele|strong="G4314,G846"\w* \w todos os|strong="G3956,G3588"\w* \w que estavam doentes|strong="G2560,G2192"\w* \w e|strong="G2532"\w* \w os endemoninhados|strong="G3588,G1139"\w*;\x - \xo 1:32 \xt MAT 8:16; LUK 4:40; MAT 8:14; MAT 4:23; MAT 9:35; MRK 3:2\x*
