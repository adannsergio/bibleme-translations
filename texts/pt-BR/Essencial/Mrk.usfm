\p
\v 26 \w E|strong="G2532"\w* \w dizia|strong="G3004"\w*: “\w Assim é|strong="G3779,G1510"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*: \w como um homem|strong="G5613,G444"\w* \w que lança|strong="G906"\w* \w a semente|strong="G3588,G4703"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*,\x - \xo 4:26 \xt ECC 11:6; JHN 3:8; MAT 13:24; ISA 61:11; 1CO 3:6-9; 1PE 1:23-25\x*
\v 27 \w e|strong="G2532"\w* \w dorme|strong="G2518"\w* \w e|strong="G2532"\w* \w acorda|strong="G1453"\w*, \w de noite|strong="G3571"\w* \w e|strong="G2532"\w* \w de dia|strong="G2250"\w*, \w e|strong="G2532"\w* \w a semente|strong="G3588,G4703"\w* \w brota|strong="G985"\w* \w e|strong="G2532"\w* \w cresce|strong="G3373"\w*, \w sem que ele saiba como|strong="G5613,G3756,G6063,G846"\w*.\f + \fr 4.27: \ft Tradução: ἐγείρηται (ἐγείρω, G1453) está aqui como “acorda”; o termo pode ser “levantar”, “ressuscitar”, “despertar” ou “erguer”, e o contexto decide.\f*\x - \xo 4:27 \xt ECC 11:6; JHN 3:8; ISA 61:11; MAT 13:24; ECC 11:5; 1CO 3:9\x*
\v 28 \w Por si mesma|strong="G844"\w*, \w a terra|strong="G3588,G1093"\w* \w produz fruto|strong="G2592"\w*: \w primeiro|strong="G4413"\w* \w a erva|strong="G5528"\w*, \w depois|strong="G1534"\w* \w a espiga|strong="G4719"\w*, \w depois|strong="G1534"\w* \w o grão cheio|strong="G4134,G4621"\w* \w na espiga|strong="G1722,G3588,G4719"\w*.\x - \xo 4:28 \xt ECC 11:6; JHN 3:8; GEN 1:12; ISA 61:11; MAT 13:24; GEN 1:11\x*
\v 29 \w Mas|strong="G1161"\w*, \w quando|strong="G3752"\w* \w o fruto|strong="G3588,G2590"\w* \w está maduro|strong="G3860"\w*\f + \fr 4.29: \ft Lit.: παραδοῖ, literalmente "entrega, permite"\f*, \w logo|strong="G2112"\w* \w ele manda|strong="G649"\w* \w a foice|strong="G3588,G1407"\w*, \w porque|strong="G3754"\w* \w chegou|strong="G3936"\w* \w a colheita|strong="G3588,G2326"\w*.”\x - \xo 4:29 \xt ECC 11:6; REV 14:15; JHN 3:8; ISA 61:11; JOL 3:13; MAT 13:24\x*
\v 30 \w E|strong="G2532"\w* \w dizia|strong="G3004"\w*: “\w Como|strong="G4459"\w* \w compararemos|strong="G3666"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*, \w ou|strong="G2228"\w* \w em que parábola|strong="G1722,G5101,G3850"\w* \w o colocaremos|strong="G846,G5087"\w*?\x - \xo 4:30 \xt LUK 13:18; MAT 13:24; LUK 13:20; MRK 4:13; MAT 13:31; ISA 61:11\x*
\v 31 \w É como|strong="G5613"\w* \w um grão|strong="G2848"\w* \w de mostarda|strong="G4615"\w*, \w o qual|strong="G3739"\w*, \w quando|strong="G3752"\w* \w é semeado|strong="G4687"\w* \w na terra|strong="G1909,G3588,G1093"\w*, \w é menor|strong="G3398,G1510"\w* \w do que todas as sementes|strong="G3956,G3588,G4690"\w* \w que há na terra|strong="G3588,G1909,G1093"\w*;\f + \fr 4.31: \ft Lit.: no grego a oração relativa do v. 31 fica sem verbo principal e é retomada no v. 32 ("e, quando é semeado…"); o particípio ὄν ("sendo", neutro) foi traduzido por verbo finito para tornar a frase legível\f*\f + \fr 4.31: \ft Acréscimo: verbo ser/estar suprido em “É como”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula; “que há na terra”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 4:31 \xt MAT 13:31; MAT 17:20; LUK 13:19; ISA 61:11; LUK 13:18; MRK 4:28\x*
\v 32 \w e|strong="G2532"\w*, \w quando|strong="G3752"\w* \w é semeado|strong="G4687"\w*, \w sobe|strong="G305"\w* \w e|strong="G2532"\w* \w se torna|strong="G1096"\w* \w maior|strong="G3173"\w* \w do que todas|strong="G3956,G3588"\w* \w as hortaliças|strong="G3001"\w* \w e|strong="G2532"\w* \w produz|strong="G4160"\w* \w ramos grandes|strong="G2798,G3173"\w*, \w de modo que|strong="G5620"\w* \w as aves|strong="G3588,G4071"\w* \w do céu|strong="G3588,G3772"\w* \w podem|strong="G1410"\w* \w se abrigar|strong="G2681"\w* \w à sombra|strong="G5259,G3588,G4639"\w* \w dele|strong="G846"\w*.”\x - \xo 4:32 \xt MAT 13:32; LUK 13:19; DAN 4:20-22; MAT 13:31; DAN 4:10-14; ISA 61:11\x*
\v 33 \w E|strong="G2532"\w* \w com muitas parábolas como essas|strong="G5108,G3850,G4183"\w* \w lhes falava|strong="G2980,G846"\w* \w a palavra|strong="G3588,G3056"\w*, \w conforme|strong="G2531"\w* \w podiam ouvir|strong="G1410,G191"\w*;\x - \xo 4:33 \xt JHN 16:12; 2TI 2:15; LUK 13:18; MAT 13:10; MAT 13:34; MRK 12:1\x*
\v 34 \w mas|strong="G1161"\w* \w sem parábola|strong="G5565,G3850"\w* \w não lhes falava|strong="G3756,G2980,G846"\w*; \w em particular|strong="G2596,G2398"\w*, \w porém|strong="G1161"\w*, \w explicava|strong="G1956"\w* \w tudo|strong="G3956"\w* \w aos seus próprios discípulos|strong="G3588,G2398,G3101"\w*.\x - \xo 4:34 \xt MAT 13:34; PSA 78:2; JHN 16:25; LUK 13:18; MAT 13:10; PRO 1:6\x*
\p
\v 35 \w E|strong="G2532"\w* \w naquele dia|strong="G1722,G1565,G3588,G2250"\w*, \w ao entardecer|strong="G3798,G1096"\w*, \w disse|strong="G3004"\w* \w a eles|strong="G846"\w*: “\w Passemos|strong="G1330"\w* \w para a outra margem|strong="G1519,G3588,G4008"\w*.”\x - \xo 4:35 \xt LUK 8:22; MAT 8:18; LUK 8:25; MAT 8:23-27; MRK 5:1; MAT 14:22\x*
\v 36 \w E|strong="G2532"\w*, \w deixando|strong="G863"\w* \w a multidão|strong="G3588,G3793"\w*, \w levaram-no|strong="G3880,G846"\w* \w como estava|strong="G5613,G1510"\w*, \w no barco|strong="G1722,G3588,G4143"\w*; \w e|strong="G2532"\w* \w havia|strong="G1510"\w* \w outros barcos|strong="G243,G4143"\w* \w com ele|strong="G3326,G846"\w*.\x - \xo 4:36 \xt LUK 8:22; MAT 8:23; MRK 3:9; MRK 4:1; MRK 5:2; MRK 6:32\x*
\v 37 \w E|strong="G2532"\w* \w se levantou|strong="G1096"\w* \w uma grande tempestade|strong="G2978,G3173"\w* \w de vento|strong="G417"\w*, \w e|strong="G2532"\w* \w as ondas|strong="G3588,G2949"\w* \w se lançavam|strong="G1911"\w* \w sobre o barco|strong="G1519,G3588,G4143"\w*, \w de modo que|strong="G5620"\w* \w o barco|strong="G3588,G4143"\w* \w já|strong="G2235"\w* \w se enchia|strong="G1072"\w*.\x - \xo 4:37 \xt MAT 8:24; LUK 8:22; MAT 8:23; JON 1:6; ACT 27:14; JOB 1:19\x*
\v 38 \w E|strong="G2532"\w* \w ele|strong="G846"\w* \w estava|strong="G1510"\w* \w na popa|strong="G1722,G3588,G4403"\w*, \w dormindo|strong="G2518"\w* \w sobre o travesseiro|strong="G1909,G3588,G4344"\w*; \w e|strong="G2532"\w* \w o acordaram|strong="G1453,G846"\w* \w e|strong="G2532"\w* \w lhe disseram|strong="G3004,G846"\w*: “\w Mestre|strong="G1320"\w*, \w não se importa|strong="G3756,G3199,G4771"\w* \w que estejamos morrendo|strong="G3754,G622"\w*?”\f + \fr 4.38: \ft Tradução: ἐγείρουσιν (ἐγείρω, G1453) está aqui como “o acordaram”; o termo pode ser “levantar”, “ressuscitar”, “despertar” ou “erguer”, e o contexto decide.\f*\x - \xo 4:38 \xt 1PE 5:7; LUK 8:22; HEB 4:15; MAT 8:23; JON 1:6; ISA 54:6-8\x*
\v 39 \w E|strong="G2532"\w*, \w acordando|strong="G1326"\w*, \w repreendeu|strong="G2008"\w* \w o vento|strong="G3588,G417"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w* \w ao mar|strong="G3588,G2281"\w*: “\w Silêncio|strong="G4623"\w*! \w Cale-se|strong="G5392"\w*!” \w E|strong="G2532"\w* \w o vento|strong="G3588,G417"\w* \w cessou|strong="G2869"\w*, \w e|strong="G2532"\w* \w houve|strong="G1096"\w* \w uma grande calmaria|strong="G1055,G3173"\w*.\x - \xo 4:39 \xt MAT 8:26; PSA 107:29; PSA 89:9; JER 5:22; LUK 8:22; MAT 8:23\x*
\v 40 \w E|strong="G2532"\w* \w disse a eles|strong="G2036,G846"\w*: “\w Por que|strong="G5101"\w* \w são medrosos|strong="G1169,G1510"\w*? \w Ainda não|strong="G3768"\w* \w têm|strong="G2192"\w* \w fé|strong="G4102"\w*?”\f + \fr 4.40: \ft Variante: TR e Byz trazem "Como não têm fé?" (πῶς οὐκ) em lugar de "Ainda não têm fé?"\f*\x - \xo 4:40 \xt LUK 8:25; MAT 14:31; MAT 8:26; PSA 107:29; ISA 43:2; LUK 8:22\x*
\v 41 \w E|strong="G2532"\w* \w sentiram um grande temor|strong="G5399,G5401,G3173"\w*, \w e|strong="G2532"\w* \w diziam|strong="G3004"\w* \w uns aos outros|strong="G4314,G240"\w*: “\w Quem|strong="G5101"\w* \w é este|strong="G3778,G1510"\w*, \w então|strong="G686"\w*, \w que|strong="G3754"\w* \w até|strong="G2532"\w* \w o vento|strong="G3588,G417"\w* \w e|strong="G2532"\w* \w o mar|strong="G3588,G2281"\w* \w lhe obedecem|strong="G5219,G846"\w*?”\x - \xo 4:41 \xt LUK 8:25; MAT 8:27; PSA 89:9; PSA 107:29; LUK 8:22; MAT 8:23\x*
\c 5
\p
\v 1 \w E|strong="G2532"\w* \w chegaram|strong="G2064"\w* \w à outra margem|strong="G1519,G3588,G4008"\w* \w do mar|strong="G3588,G2281"\w*, \w à região|strong="G1519,G3588,G5561"\w* \w dos gerasenos|strong="G3588,G1086"\w*.\f + \fr 5.1: \ft Variante: a edição bizantina (RP) traz "gadarenos" (Γαδαρηνῶν) em lugar de "gerasenos"\f*\x - \xo 5:1 \xt LUK 8:26; MAT 8:28; MRK 4:35\x*
\v 2 \w E|strong="G2532"\w*, \w ao sair ele|strong="G1831,G846"\w* \w do barco|strong="G1537,G3588,G4143"\w*, \w logo|strong="G2112"\w* \w veio ao encontro|strong="G5221"\w* \w dele|strong="G846"\w*, \w saindo dos túmulos|strong="G1537,G3588,G3419"\w*, \w um homem|strong="G444"\w* \w com um espírito impuro|strong="G1722,G4151,G169"\w*,\x - \xo 5:2 \xt MRK 5:8; MAT 8:28; MRK 1:23; LUK 8:26; ISA 65:4; LUK 9:42\x*
\v 3 \w que|strong="G3739"\w* \w tinha|strong="G2192"\w* \w a sua morada|strong="G3588,G2731"\w* \w nos túmulos|strong="G1722,G3588,G3418"\w*; \w e|strong="G2532"\w* \w nem com correntes|strong="G3761,G254"\w* \w ninguém mais|strong="G2089,G3756,G3762"\w* \w conseguia|strong="G1410"\w* \w prendê-lo|strong="G846,G1210"\w*,\f + \fr 5.3: \ft Variante: RP traz "nem com correntes", no plural (οὔτε ἁλύσεσιν), e omite "mais" (οὐκέτι), de modo que se lê "ninguém conseguia prendê-lo nem com correntes"\f*\x - \xo 5:3 \xt MAT 8:28; LUK 8:26; ISA 65:4; LUK 8:29; MRK 9:20; ACT 19:16\x*
\v 4 \w porque|strong="G1223"\w* \w muitas vezes|strong="G4178"\w* \w tinha sido preso|strong="G3588,G846,G1210"\w* \w com grilhões|strong="G3976"\w* \w e|strong="G2532"\w* \w correntes|strong="G254"\w*, \w e|strong="G2532"\w* \w as correntes|strong="G3588,G254"\w* \w tinham sido arrebentadas|strong="G1288"\w* \w por ele|strong="G5259,G846"\w* \w e|strong="G2532"\w* \w os grilhões|strong="G3588,G3976"\w* \w quebrados|strong="G4937"\w*; \w e|strong="G2532"\w* \w ninguém tinha força|strong="G3762,G2480"\w* \w para dominá-lo|strong="G846,G1150"\w*.\x - \xo 5:4 \xt MAT 8:28; LUK 8:26; MRK 9:20; ACT 19:16; LUK 8:27; MRK 5:15\x*
\v 5 \w E|strong="G2532"\w* \w o tempo todo|strong="G1223,G3956"\w*, \w de noite|strong="G3571"\w* \w e|strong="G2532"\w* \w de dia|strong="G2250"\w*, \w estava|strong="G1510"\w* \w gritando|strong="G2896"\w* \w entre os túmulos|strong="G1722,G3588,G3418"\w* \w e|strong="G2532"\w* \w pelos montes|strong="G1722,G3588,G3735"\w*, \w e|strong="G2532"\w* \w ferindo-se|strong="G2629,G1438"\w* \w com pedras|strong="G3037"\w*.\x - \xo 5:5 \xt MAT 8:28; LEV 19:28; LUK 8:26; 1KI 18:28; JOB 2:7-8; JHN 8:44\x*
\v 6 \w E|strong="G2532"\w*, \w vendo|strong="G1492"\w* \w Jesus|strong="G3588,G2424"\w* \w de longe|strong="G575,G3113"\w*, \w correu|strong="G5143"\w* \w e|strong="G2532"\w* \w prostrou-se|strong="G4352"\w*\f + \fr 5.6: \ft Lit.: προσκυνέω significa "prostrar-se" e também "adorar"\f* \w diante dele|strong="G846"\w*,\x - \xo 5:6 \xt MAT 8:28; JAS 2:19; LUK 8:26; PSA 66:3; LUK 4:41; MAT 8:2\x*
\v 7 \w e|strong="G2532"\w*, \w gritando|strong="G2896"\w* \w em alta voz|strong="G5456,G3173"\w*, \w disse|strong="G3004"\w*: “\w Que há entre mim e você|strong="G5101,G1473,G2532,G4771"\w*, \w Jesus|strong="G2424"\w*, \w Filho|strong="G5207"\w* \w do Deus Altíssimo|strong="G3588,G2316,G5310"\w*? \w Eu o conjuro|strong="G3726,G4771"\w* \w por Deus|strong="G3588,G2316"\w*: \w não me atormente|strong="G3361,G3165,G928"\w*.”\f + \fr 5.7: \ft Acréscimo: “Que há entre mim e você”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 5:7 \xt LUK 8:28; MAT 8:29; LUK 1:32; MAT 8:28; JAS 2:19; LUK 8:26\x*
\v 8 \w Pois|strong="G1063"\w* \w ele lhe dizia|strong="G3004,G846"\w*: “\w Saia|strong="G1831"\w* \w deste homem|strong="G1537,G3588,G444"\w*, \w espírito impuro|strong="G3588,G4151,G169"\w*.”\x - \xo 5:8 \xt MRK 5:2; MAT 12:43; MRK 9:25; MRK 1:26; MAT 8:28; LUK 8:26\x*
\v 9 \w E|strong="G2532"\w* \w lhe perguntou|strong="G1905,G846"\w*: “\w Qual é|strong="G5101"\w* \w o seu nome|strong="G3686,G4771"\w*?” \w E|strong="G2532"\w* \w ele lhe disse|strong="G3004,G846"\w*: “\w Meu nome|strong="G3686,G3165"\w* \w é Legião|strong="G3003"\w*\f + \fr 5.9: \ft Nota cultural: uma legião romana tinha milhares de soldados\f*, \w porque|strong="G3754"\w* \w somos muitos|strong="G4183,G1510"\w*.”\f + \fr 5.9: \ft Acréscimo: verbo ser/estar suprido em “Qual é”, “é Legião”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:9 \xt LUK 8:30; MAT 8:28; LUK 8:26; ACT 19:15; MRK 5:15; MAT 12:45\x*
\v 10 \w E|strong="G2532"\w* \w suplicava-lhe|strong="G3870,G846"\w* \w muito|strong="G4183"\w* \w que não|strong="G2443,G3361"\w* \w os mandasse|strong="G846,G649"\w* \w para fora|strong="G1854"\w* \w da região|strong="G3588,G5561"\w*.\x - \xo 5:10 \xt MAT 8:28; LUK 8:26; ACT 19:15; LUK 11:24; MAT 12:43; MRK 3:22\x*
\v 11 \w Havia|strong="G1510"\w* \w ali|strong="G1563"\w*, \w junto ao monte|strong="G4314,G3588,G3735"\w*, \w uma grande manada|strong="G34,G3173"\w* \w de porcos|strong="G5519"\w* \w pastando|strong="G1006"\w*;\x - \xo 5:11 \xt LUK 8:32; MAT 8:30; MAT 8:31; MAT 8:28; LUK 8:26; ACT 19:15\x*
\v 12 \w e|strong="G2532"\w* \w lhe suplicaram|strong="G3870,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Mande-nos|strong="G3992,G3165"\w* \w para os porcos|strong="G1519,G3588,G5519"\w*, \w para que|strong="G2443"\w* \w entremos neles|strong="G1519,G846,G1525"\w*.”\f + \fr 5.12: \ft Variante: TR e Byz acrescentam "todos os demônios" (πάντες οἱ δαίμονες) como sujeito de "suplicaram"\f*\x - \xo 5:12 \xt MAT 8:31; MAT 8:28; LUK 8:26; ACT 19:15; MAT 12:43; 1PE 5:8\x*
\v 13 \w E|strong="G2532"\w* \w ele lhes permitiu|strong="G2010,G846"\w*\f + \fr 5.13: \ft Variante: TR e Byz acrescentam "logo Jesus" (εὐθέως ὁ Ἰησοῦς) depois de "permitiu"\f*. \w E|strong="G2532"\w* \w os espíritos impuros|strong="G3588,G4151,G169"\w*, \w saindo|strong="G1831"\w*, \w entraram|strong="G1525"\w* \w nos porcos|strong="G1519,G3588,G5519"\w*, \w e|strong="G2532"\w* \w a manada|strong="G3588,G34"\w* \w se precipitou|strong="G3729"\w* \w pelo penhasco|strong="G2596,G3588,G2911"\w* \w para dentro do mar|strong="G1519,G3588,G2281"\w*, \w cerca de|strong="G5613"\w* \w dois mil|strong="G1367"\w*, \w e|strong="G2532"\w* \w se afogaram|strong="G4155"\w* \w no mar|strong="G1722,G3588,G2281"\w*.\x - \xo 5:13 \xt MAT 8:32; LUK 8:33; MAT 8:28; LUK 8:26; ACT 19:15; ACT 10:38\x*
\v 14 \w E|strong="G2532"\w* \w os que|strong="G3588"\w* \w os pastoreavam|strong="G1006,G846"\w* \w fugiram|strong="G5343"\w* \w e|strong="G2532"\w* \w deram a notícia|strong="G518"\w* \w na cidade|strong="G1519,G3588,G4172"\w* \w e|strong="G2532"\w* \w nos campos|strong="G1519,G3588,G68"\w*; \w e|strong="G2532"\w* \w vieram|strong="G2064"\w* \w ver|strong="G1492"\w* \w o que|strong="G5101"\w* \w tinha acontecido|strong="G1510,G3588,G1096"\w*.\x - \xo 5:14 \xt LUK 8:34; MAT 8:33; MAT 8:28; LUK 8:26; ACT 10:38\x*
\v 15 \w E|strong="G2532"\w* \w chegaram|strong="G2064"\w* \w junto a Jesus|strong="G4314,G3588,G2424"\w*, \w e|strong="G2532"\w* \w viram|strong="G2334"\w* \w o endemoninhado|strong="G3588,G1139"\w* \w sentado|strong="G2521"\w*, \w vestido|strong="G2439"\w* \w e|strong="G2532"\w* \w em perfeito juízo|strong="G4993"\w*, \w o mesmo que tivera|strong="G3588,G2192"\w* \w a legião|strong="G3588,G3003"\w*; \w e|strong="G2532"\w* \w ficaram com medo|strong="G5399"\w*.\x - \xo 5:15 \xt LUK 8:35; MAT 8:28; COL 1:13; 2TI 1:7; LUK 8:26; MRK 5:9\x*
\v 16 \w E|strong="G2532"\w* \w os que|strong="G3588"\w* \w tinham visto|strong="G1492"\w* \w contaram a eles|strong="G1334,G846"\w* \w como|strong="G4459"\w* \w aconteceu|strong="G1096"\w* \w ao endemoninhado|strong="G3588,G1139"\w*, \w e|strong="G2532"\w* \w também sobre os porcos|strong="G4012,G3588,G5519"\w*.\x - \xo 5:16 \xt MAT 8:28; LUK 8:26; MRK 5:15; MAT 8:33\x*
\v 17 \w E|strong="G2532"\w* \w começaram a|strong="G757"\w* \w pedir-lhe|strong="G3870,G846"\w* \w que se retirasse|strong="G565"\w* \w do território|strong="G575,G3588,G3725"\w* \w deles|strong="G846"\w*.\x - \xo 5:17 \xt MAT 8:34; ACT 16:39; MAT 8:28; LUK 8:26; MRK 1:24; LUK 8:37\x*
\v 18 \w E|strong="G2532"\w*, \w ao entrar ele|strong="G1684,G846"\w* \w no barco|strong="G1519,G3588,G4143"\w*, \w o que fora endemoninhado|strong="G3588,G1139"\w* \w pedia-lhe|strong="G3870,G846"\w* \w para ficar|strong="G2443,G1510"\w* \w com ele|strong="G3326,G846"\w*.\x - \xo 5:18 \xt MAT 8:23; MRK 8:10; MAT 8:28; LUK 8:26; LUK 8:38; MAT 8:34\x*
\v 19 \w E|strong="G2532"\w* \w não o deixou|strong="G3756,G863,G846"\w*, \w mas|strong="G235"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Vá|strong="G5217"\w* \w para a sua casa|strong="G1519,G3588,G3624,G4771"\w*, \w para os seus|strong="G4314,G3588,G4771"\w*, \w e|strong="G2532"\w* \w anuncie|strong="G518"\w* \w a eles|strong="G846"\w* \w tudo o que|strong="G3745"\w* \w o Senhor|strong="G3588,G2962"\w* \w fez por você|strong="G4771,G4160"\w* \w e|strong="G2532"\w* \w como teve misericórdia|strong="G1653"\w* \w de você|strong="G4771"\w*.”\x - \xo 5:19 \xt MAT 8:28; PSA 66:16; LUK 8:26; JHN 4:29; MRK 8:2; DAN 4:1-3\x*
\v 20 \w E|strong="G2532"\w* \w ele foi embora|strong="G565"\w* \w e|strong="G2532"\w* \w começou a|strong="G757"\w* \w proclamar|strong="G2784"\w* \w na Decápolis|strong="G1722,G3588,G1179"\w*\f + \fr 5.20: \ft Nota cultural: Decápolis, "Dez Cidades", região de cidades de cultura grega, na maior parte a leste do Jordão\f* \w tudo o que|strong="G3745"\w* \w Jesus|strong="G3588,G2424"\w* \w fez por ele|strong="G4160,G846"\w*, \w e|strong="G2532"\w* \w todos|strong="G3956"\w* \w se admiravam|strong="G2296"\w*.\x - \xo 5:20 \xt MAT 8:28; LUK 8:26; MRK 7:31; MAT 4:25; LUK 8:38\x*
\p
\v 21 \w E|strong="G2532"\w*, \w tendo atravessado|strong="G1276"\w* \w Jesus|strong="G3588,G2424"\w* \w no barco|strong="G1722,G3588,G4143"\w* \w de novo|strong="G3825"\w* \w para a outra margem|strong="G1519,G3588,G4008"\w*, \w reuniu-se|strong="G4863"\w* \w uma grande multidão|strong="G3793,G4183"\w* \w junto a ele|strong="G1909,G846"\w*; \w e|strong="G2532"\w* \w ele estava|strong="G1510"\w* \w à beira do mar|strong="G3844,G3588,G2281"\w*.\x - \xo 5:21 \xt MRK 4:1; MAT 9:1; LUK 8:40; LUK 8:22; MRK 4:35\x*
\v 22 \w E|strong="G2532"\w* \w chegou|strong="G2064"\w* \w um dos|strong="G1520,G3588"\w* \w chefes da sinagoga|strong="G752"\w*, \w de nome|strong="G3686"\w* \w Jairo|strong="G2383"\w*, \w e|strong="G2532"\w*, \w vendo-o|strong="G1492,G846"\w*, \w caiu|strong="G4098"\w* \w a seus pés|strong="G4314,G3588,G4228,G846"\w*\x - \xo 5:22 \xt LUK 8:41; MAT 9:18; LUK 13:14; ACT 13:15; ACT 18:17; ACT 18:8\x*
\v 23 \w e|strong="G2532"\w* \w suplicava-lhe|strong="G3870,G846"\w* \w muito|strong="G4183"\w*, \w dizendo|strong="G3004"\w*: “\w A minha filhinha|strong="G3588,G2365,G3165"\w* \w está nas últimas|strong="G2079,G2192"\w*; \w venha e ponha|strong="G2443,G2064,G2007"\w* \w as mãos|strong="G3588,G5495"\w* \w sobre ela|strong="G846"\w*, \w para que|strong="G2443"\w* \w seja curada|strong="G4982"\w*\f + \fr 5.23: \ft Lit.: σῴζω significa "salvar" e também "curar"\f* \w e|strong="G2532"\w* \w viva|strong="G2198"\w*.”\x - \xo 5:23 \xt MRK 7:32; MAT 9:18; MRK 16:18; LUK 13:13; LUK 4:40; MRK 6:5\x*
\v 24 \w E|strong="G2532"\w* \w foi|strong="G565"\w* \w com ele|strong="G3326,G846"\w*. \w E|strong="G2532"\w* \w uma grande multidão|strong="G3793,G4183"\w* \w o seguia|strong="G190,G846"\w* \w e|strong="G2532"\w* \w o apertava|strong="G4918,G846"\w*.\x - \xo 5:24 \xt MRK 5:31; MAT 9:18; LUK 7:6; LUK 8:41; LUK 5:1; LUK 8:42\x*
\p
\v 25 \w E|strong="G2532"\w* \w uma mulher|strong="G1135"\w* \w que estava|strong="G1510"\w* \w com hemorragia|strong="G1722,G4511,G129"\w* \w havia doze anos|strong="G1427,G2094"\w*,\x - \xo 5:25 \xt LUK 8:43; MAT 9:20; LEV 15:25; LEV 15:19; MAT 9:18; JHN 5:5-6\x*
\v 26 \w e|strong="G2532"\w* \w tinha sofrido|strong="G3958"\w* \w muito|strong="G4183"\w* \w nas mãos de|strong="G5259"\w* \w muitos médicos|strong="G4183,G2395"\w*, \w e|strong="G2532"\w* \w gasto|strong="G1159"\w* \w tudo o que possuía|strong="G3588,G3844,G846,G3956"\w*, \w e|strong="G2532"\w* \w sem nenhum proveito|strong="G3367,G5623"\w*, \w mas antes|strong="G235,G3123"\w* \w tinha piorado|strong="G1519,G3588,G5501,G2064"\w*,\x - \xo 5:26 \xt LUK 8:43; MAT 9:21; MAT 9:18; MAT 9:20; 2CH 16:12; JER 30:12-13\x*
\v 27 \w tendo ouvido falar|strong="G191,G4012"\w* \w de Jesus|strong="G3588,G2424"\w*, \w veio|strong="G2064"\w* \w por trás|strong="G3693"\w*, \w no meio da multidão|strong="G1722,G3588,G3793"\w*, \add e\add* \w tocou|strong="G681"\w* \w o manto|strong="G3588,G2440"\w* \w dele|strong="G846"\w*;\f + \fr 5.27: \ft Acréscimo: “e” (em “da multidão e tocou o”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 5:27 \xt MAT 9:20; LUK 8:44; MAT 9:21; MAT 14:36; MAT 9:18; ACT 19:12\x*
\v 28 \w pois|strong="G1063"\w* \w dizia|strong="G3004"\w*: “\w Se eu tocar|strong="G1437,G681"\w* \w ao menos|strong="G1437_B,G2532"\w* \w nas roupas|strong="G3588,G2440"\w* \w dele|strong="G846"\w*, \w serei curada|strong="G4982"\w*.”\x - \xo 5:28 \xt MAT 9:21; MRK 6:56; MAT 9:18; MAT 9:20; LUK 8:44; LUK 8:41\x*
\v 29 \w E|strong="G2532"\w* \w logo|strong="G2112"\w* \w secou|strong="G3583"\w* \w a fonte|strong="G3588,G4077"\w* \w do seu sangue|strong="G3588,G129,G846"\w*, \w e|strong="G2532"\w* \w sentiu|strong="G1097"\w* \w no corpo|strong="G3588,G4983"\w* \w que|strong="G3754"\w* \w estava curada|strong="G2390"\w* \w da doença|strong="G575,G3588,G3148"\w*.\x - \xo 5:29 \xt MRK 5:34; MAT 9:21; MAT 9:18; MAT 9:20; MRK 3:10; PSA 103:3\x*
\v 30 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w logo|strong="G2112"\w* \w percebendo|strong="G1921"\w* \w em si mesmo|strong="G1722,G1438"\w* \w que o poder|strong="G3588,G1411"\w* \w que vinha dele|strong="G1537,G846"\w* \w tinha saído|strong="G1831"\w*, \w voltando-se|strong="G1994"\w* \w no meio da multidão|strong="G1722,G3588,G3793"\w*, \w dizia|strong="G3004"\w*: “\w Quem|strong="G5101"\w* \w tocou|strong="G681"\w* \w nas minhas roupas|strong="G3165,G3588,G2440"\w*?”\x - \xo 5:30 \xt LUK 8:46; LUK 6:19; MAT 9:21; MRK 6:54; MAT 9:18; MAT 9:20\x*
\v 31 \w E|strong="G2532"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w lhe diziam|strong="G3004,G846"\w*: “\w Você vê|strong="G991"\w* \w a multidão|strong="G3588,G3793"\w* \w apertando você|strong="G4918,G4771"\w*, \w e|strong="G2532"\w* \w diz|strong="G3004"\w*: ‘\w Quem|strong="G5101"\w* \w me tocou|strong="G3165,G681"\w*?’”\x - \xo 5:31 \xt MRK 5:24; MAT 9:21; MAT 9:18; MAT 9:20; LUK 8:41; LUK 8:45\x*
\v 32 \w E|strong="G2532"\w* \w olhava em volta|strong="G4017"\w* \w para ver|strong="G1492"\w* \w a que|strong="G3588"\w* \w tinha feito|strong="G4160"\w* \w isso|strong="G3778"\w*.\x - \xo 5:32 \xt MAT 9:21; MAT 9:18; MAT 9:20; LUK 8:41\x*
\v 33 \w Mas|strong="G1161"\w* \w a mulher|strong="G3588,G1135"\w*, \w com medo|strong="G5399"\w* \w e|strong="G2532"\w* \w tremendo|strong="G5141"\w*, \w sabendo|strong="G6063"\w* \w o que|strong="G3739"\w* \w lhe tinha acontecido|strong="G1096,G846"\w*, \w veio|strong="G2064"\w*, \w prostrou-se|strong="G2532,G4363"\w* \w diante dele|strong="G846"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w* \w toda a verdade|strong="G3956,G3588,G225"\w*.\x - \xo 5:33 \xt LUK 8:47; MRK 7:25; MAT 9:21; MAT 9:18; MAT 9:20; 2SA 9:7\x*
\v 34 \w E|strong="G1161"\w* \w ele|strong="G3588"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Filha|strong="G2364"\w*, \w a sua fé|strong="G3588,G4102,G4771"\w* \w a curou|strong="G4982,G4771"\w*; \w vá|strong="G5217"\w* \w em paz|strong="G1519,G1515"\w*, \w e|strong="G2532"\w* \w fique curada|strong="G1510,G5199"\w* \w da sua doença|strong="G575,G3588,G3148,G4771"\w*.”\f + \fr 5.34: \ft Tradução: σέσωκέν (σῴζω, G4982) está aqui como “a curou”; o termo pode ser “salvar”, “livrar”, “curar” ou “preservar”, e o contexto decide.\f*\x - \xo 5:34 \xt LUK 7:50; LUK 8:48; MAT 9:22; MRK 10:52; LUK 18:42; MRK 5:29\x*
\v 35 \w Enquanto ele ainda falava|strong="G2089,G846,G2980"\w*, \w vieram|strong="G2064"\w* \w da casa do chefe da sinagoga|strong="G575,G3588,G752"\w*, \w dizendo|strong="G3004"\w*: “\w A sua filha|strong="G3588,G2364,G4771"\w* \w morreu|strong="G599"\w*; \w por que|strong="G5101"\w* \add você\add* \w ainda|strong="G2089"\w* \w incomoda|strong="G4660"\w* \w o Mestre|strong="G3588,G1320"\w*?”\f + \fr 5.35: \ft Acréscimo: “você” (em “por que você ainda incomoda”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 5:35 \xt LUK 8:49; MAT 9:18; MAT 9:20; ROM 4:18; MRK 5:22; LUK 8:41\x*
\v 36 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w*, \w ouvindo de passagem|strong="G3878"\w*\f + \fr 5.36: \ft Lit.: παρακούω significa "ouvir de passagem" e também "não dar atenção"\f*\f + \fr 5.36: \ft Variante: TR e Byz trazem "logo, ao ouvir" (εὐθέως ἀκούσας) em lugar de "ouvindo de passagem"\f* \w a palavra|strong="G3588,G3056"\w* \w que era dita|strong="G2980"\w*, \w disse|strong="G3004"\w* \w ao chefe da sinagoga|strong="G3588,G752"\w*: “\w Não tenha medo|strong="G3361,G5399"\w*; \w apenas|strong="G3441"\w* \w creia|strong="G4100"\w*.”\x - \xo 5:36 \xt LUK 8:50; MAT 9:28-29; JHN 11:40; MRK 9:23; ROM 4:18; MRK 5:34\x*
\v 37 \w E|strong="G2532"\w* \w não permitiu|strong="G3756,G863"\w* \w que ninguém|strong="G3762"\w* \w o acompanhasse|strong="G3326,G846,G4870"\w*, \w a não ser|strong="G1487,G3361"\w* \w Pedro|strong="G3588,G4074"\w*, \w Tiago|strong="G2385"\w* \w e|strong="G2532"\w* \w João|strong="G2491"\w*, \w irmão|strong="G3588,G80"\w* \w de Tiago|strong="G2385"\w*.\f + \fr 5.37: \ft Tradução: ἀφῆκεν (ἀφίημι, G863) está aqui como “não permitiu”; o termo pode ser “deixar”, “perdoar”, “permitir”, “abandonar” ou “mandar embora”, e o contexto decide.\f*\x - \xo 5:37 \xt MRK 14:33; MAT 17:1; MRK 10:35; MAT 9:18; MAT 9:20; MRK 9:2\x*
\v 38 \w E|strong="G2532"\w* \w chegaram|strong="G2064"\w* \w à casa|strong="G1519,G3588,G3624"\w* \w do chefe da sinagoga|strong="G3588,G752"\w*, \w e|strong="G2532"\w* \w viu|strong="G2334"\w* \w um tumulto|strong="G2351"\w*, \w e|strong="G2532"\w* \w gente chorando|strong="G2799"\w* \w e|strong="G2532"\w* \w lamentando|strong="G214"\w* \w muito|strong="G4183"\w*,\f + \fr 5.38: \ft Variante: RP traz o verbo no singular, "ele chegou" (ἔρχεται), em lugar de "chegaram" (ἔρχονται), e omite o "e" (καί) antes de "viu"\f*\x - \xo 5:38 \xt JER 31:16; MAT 9:18; MAT 9:20; LUK 8:41; LUK 8:49; MAT 9:23\x*
\v 39 \w E|strong="G2532"\w*, \w entrando|strong="G1525"\w*, \w disse|strong="G3004"\w* \w a eles|strong="G846"\w*: “\w Por que|strong="G5101"\w* \w fazem tumulto|strong="G2350"\w* \w e|strong="G2532"\w* \w choram|strong="G2799"\w*? \w A criança|strong="G3588,G3813"\w* \w não morreu|strong="G3756,G599"\w*, \w mas|strong="G235"\w* \w dorme|strong="G2518"\w*.”\x - \xo 5:39 \xt LUK 8:52; JER 31:16; MAT 9:18; MAT 9:20; JHN 11:4; ACT 20:10\x*
\v 40 \w E|strong="G2532"\w* \w riam|strong="G2606"\w* \w dele|strong="G846"\w*. \w Mas|strong="G1161"\w* \w ele|strong="G846"\w*, \w tendo mandado para fora|strong="G1544"\w* \w todos|strong="G3956"\w*, \w tomou consigo|strong="G3880"\w* \w o pai|strong="G3588,G3962"\w* \w da criança|strong="G3588,G3813"\w*, \w a mãe|strong="G3588,G3384"\w* \w e os que|strong="G2532,G3588"\w* \w estavam com ele|strong="G3326,G846"\w*, \w e|strong="G2532"\w* \w entrou|strong="G1531"\w* \w onde|strong="G3699"\w* \w estava|strong="G1510"\w* \w a criança|strong="G3588,G3813"\w*;\f + \fr 5.40: \ft Variante: TR e Byz (e RP) acrescentam "deitada" (ἀνακείμενον) depois de "criança"\f*\f + \fr 5.40: \ft Acréscimo: verbo ser/estar suprido em “estavam com ele”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:40 \xt MAT 9:18; MAT 9:20; JHN 11:4; ACT 9:40; MRK 7:33; LUK 8:41\x*
\v 41 \w E|strong="G2532"\w*, \w segurando|strong="G2902"\w* \w a mão|strong="G3588,G5495"\w* \w da criança|strong="G3588,G3813"\w*, \w disse-lhe|strong="G3004,G846"\w*: “\w Talita|strong="G5008"\w* \w cum|strong="G2891"\w*\f + \fr 5.41: \ft Nota cultural: palavras em aramaico, a língua falada por Jesus\f*”, \w que traduzido significa|strong="G3739,G1510,G3177"\w*: “\w Menina|strong="G3588,G2877"\w*, \w eu digo|strong="G3004"\w* \w a você|strong="G4771"\w*, \w levante-se|strong="G1453"\w*.”\x - \xo 5:41 \xt MAT 9:25; LUK 8:54; MRK 1:31; MAT 9:18; MAT 9:20; JHN 11:4\x*
\v 42 \w E|strong="G2532"\w* \w logo|strong="G2112"\w* \w a menina|strong="G3588,G2877"\w* \w se levantou|strong="G450"\w* \w e|strong="G2532"\w* \w andava|strong="G4043"\w*, \w pois|strong="G1063"\w* \w tinha|strong="G1510"\w* \w doze anos|strong="G2094,G1427"\w*. \w E|strong="G2532"\w* \w logo|strong="G2112"\w*\f + \fr 5.42: \ft Variante: a edição bizantina (RP) omite o segundo "logo" (εὐθύς)\f* \w ficaram fora de si|strong="G1839"\w*, \w com grande espanto|strong="G1611,G3173"\w*.\x - \xo 5:42 \xt MAT 9:18; MAT 9:20; JHN 11:4; MRK 7:37; ACT 9:40; JHN 5:9\x*
\v 43 \w E|strong="G2532"\w* \w ordenou-lhes|strong="G1291,G846"\w* \w insistentemente|strong="G4183"\w* \w que ninguém|strong="G2443,G3367"\w* \w soubesse|strong="G1097"\w* \w disso|strong="G3778"\w*, \w e|strong="G2532"\w* \w mandou|strong="G2036"\w* \w que lhe dessem|strong="G1325,G846"\w* \w de comer|strong="G5315"\w*.\x - \xo 5:43 \xt MAT 16:20; MRK 7:36; MRK 9:9; MAT 9:18; MAT 9:20; MAT 8:4\x*
\c 6
\p
\v 1 \w E|strong="G2532"\w* \w saiu|strong="G1831"\w* \w dali|strong="G1564"\w*, \w e|strong="G2532"\w* \w foi|strong="G2064"\w* \w para a sua terra|strong="G1519,G3588,G3968,G846"\w*, \w e|strong="G2532"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w o seguiam|strong="G190,G846"\w*.\x - \xo 6:1 \xt LUK 4:16; MAT 13:54; MAT 2:23\x*
\v 2 \w E|strong="G2532"\w*, \w chegado o sábado|strong="G1096,G4521"\w*, \w começou a|strong="G757"\w* \w ensinar|strong="G1321"\w* \w na sinagoga|strong="G1722,G3588,G4864"\w*; \w e|strong="G2532"\w* \w muitos|strong="G3588,G4183"\w*, \w ouvindo|strong="G191"\w*, \w ficavam admirados|strong="G1605"\w* \w e diziam|strong="G3004"\w*: “\w De onde|strong="G4159"\w* \w vêm a ele|strong="G3778"\w* \w estas coisas|strong="G3778"\w*, \w e|strong="G2532"\w* \w que sabedoria é esta|strong="G5101,G3588,G4678"\w* \w que lhe foi dada|strong="G3588,G1325,G3778"\w*? \w E|strong="G2532"\w* \w esses atos de poder|strong="G3588,G1411,G5108"\w* \w realizados|strong="G1096"\w* \w por suas mãos|strong="G1223,G3588,G5495,G846"\w*?”\f + \fr 6.2: \ft Acréscimo: verbo ser/estar suprido em “que sabedoria é esta”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:2 \xt MAT 13:54; MRK 1:21; LUK 13:10; LUK 4:15; ECC 9:16; MAT 7:28\x*
\v 3 “\w Não é este|strong="G3756,G3778,G1510"\w* \w o carpinteiro|strong="G3588,G5045"\w*\f + \fr 6.3: \ft Lit.: τέκτων significa "artesão, construtor", não só quem trabalha com madeira\f*, \w o filho|strong="G3588,G5207"\w* \w de Maria|strong="G3588,G3137"\w* \w e|strong="G2532"\w* \w irmão|strong="G80"\w* \w de Tiago|strong="G2385"\w*, \w de Joses|strong="G2500"\w*, \w de Judas|strong="G2455"\w* \w e|strong="G2532"\w* \w de Simão|strong="G4613"\w*? \w E|strong="G2532"\w* \w não estão aqui|strong="G3756,G1510,G5602"\w* \w conosco|strong="G4314,G3165"\w* \w as irmãs|strong="G3588,G79"\w* \w dele|strong="G846"\w*?” \w E|strong="G2532"\w* \w sentiam-se ofendidos|strong="G4624"\w* \w com ele|strong="G1722,G846"\w*.\x - \xo 6:3 \xt MAT 13:55; MRK 15:40; JHN 1:45; ISA 53:2; MAT 12:46; ECC 9:16\x*
\v 4 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes dizia|strong="G3004,G846"\w*: “\w Um profeta|strong="G4396"\w* \w não fica sem honra|strong="G3756,G1510,G820"\w*, \w a não ser|strong="G1487,G3361"\w* \w na sua terra|strong="G1722,G3588,G3968,G846"\w*, \w e|strong="G2532"\w* \w entre os seus parentes|strong="G1722,G3588,G4773,G846"\w* \w e|strong="G2532"\w* \w na sua casa|strong="G1722,G3588,G3614,G846"\w*.”\x - \xo 6:4 \xt MAT 13:57; JHN 4:44; LUK 4:24; JER 12:6; MAT 13:54; JER 11:21\x*
\v 5 \w E|strong="G2532"\w* \w não podia|strong="G3756,G1410"\w* \w fazer|strong="G4160"\w* \w ali|strong="G1563"\w* \w nenhum ato de poder|strong="G3762,G1411"\w*, \w a não ser|strong="G1487,G3361"\w* \w curar|strong="G2323"\w* \w alguns poucos doentes|strong="G3641,G732"\w*, \w impondo-lhes as mãos|strong="G2007,G3588,G5495"\w*;\x - \xo 6:5 \xt MAT 13:58; LUK 4:24; ACT 28:8; MRK 9:23; MRK 5:23; MAT 13:54\x*
\v 6 \w e|strong="G2532"\w* \w se admirava|strong="G2296"\w* \w da falta de fé|strong="G1223,G3588,G570"\w* \w deles|strong="G846"\w*. \w E|strong="G2532"\w* \w percorria|strong="G4013"\w* \w os povoados|strong="G3588,G2968"\w* \w em volta|strong="G2945"\w*, \w ensinando|strong="G1321"\w*.\x - \xo 6:6 \xt MAT 9:35; MAT 13:58; MAT 8:10; ISA 59:16; MAT 4:23; LUK 13:22\x*
\p
\v 7 \w E|strong="G2532"\w* \w chamou|strong="G4341"\w* \w os Doze|strong="G3588,G1427"\w*, \w e|strong="G2532"\w* \w começou a|strong="G757"\w* \w enviá-los|strong="G846,G649"\w* \w de dois em dois|strong="G1417"\w*, \w e|strong="G2532"\w* \w lhes dava|strong="G1325,G846"\w* \w autoridade|strong="G1849"\w* \w sobre os espíritos impuros|strong="G3588,G4151,G169"\w*,\x - \xo 6:7 \xt MAT 10:1; ECC 4:9; LUK 9:1; LUK 10:1; LUK 10:17-20; LUK 10:3-12\x*
\v 8 \w e|strong="G2532"\w* \w ordenou-lhes|strong="G3853,G846"\w* \w que não levassem|strong="G2443,G142"\w* \w nada|strong="G3367"\w* \w para o caminho|strong="G1519,G3598"\w*, \w a não ser|strong="G1487,G3361"\w* \w apenas um cajado|strong="G4464,G3441"\w*: \w nem pão|strong="G3361,G740"\w*, \w nem alforje|strong="G3361,G4082"\w*, \w nem dinheiro|strong="G3361,G5475"\w*\f + \fr 6.8: \ft Lit.: χαλκός, literalmente "bronze" ou "moeda de bronze"\f* \w no cinto|strong="G1519,G3588,G2223"\w*,\x - \xo 6:8 \xt LUK 9:3; MAT 10:9; LUK 10:4; MAT 10:1; LUK 9:1; LUK 10:1\x*
\v 9 \w mas|strong="G235"\w* \w que calçassem|strong="G5265"\w* \w sandálias|strong="G4547"\w*, \w e|strong="G2532"\w* \w não vestissem|strong="G3361,G1746"\w* \w duas túnicas|strong="G1417,G5509"\w*.\x - \xo 6:9 \xt ACT 12:8; MAT 10:1; LUK 9:1; LUK 10:1; LUK 10:4; LUK 22:35\x*
\v 10 \w E|strong="G2532"\w* \w dizia a eles|strong="G3004,G846"\w*: “\w Onde quer que|strong="G3699,G1437"\w* \w entrarem|strong="G1525"\w* \w numa casa|strong="G1519,G3614"\w*, \w fiquem|strong="G3306"\w* \w ali|strong="G1563"\w* \w até|strong="G2193,G302"\w* \w saírem|strong="G1831"\w* \w de lá|strong="G1564"\w*.\x - \xo 6:10 \xt LUK 9:4; MAT 10:11; MAT 10:1; LUK 9:1; LUK 10:1; LUK 10:4\x*
\v 11 \w E|strong="G2532"\w* \w o lugar que|strong="G3739,G302,G5117"\w* \w não receber|strong="G3361,G1209"\w* \w vocês|strong="G4771"\w* \w nem os ouvir|strong="G3366,G191,G4771"\w*, \w ao saírem de lá|strong="G1607,G1564"\w*, \w sacudam|strong="G1621"\w* \w o pó|strong="G3588,G5522"\w* \w que está debaixo|strong="G3588,G5270"\w* \w dos pés|strong="G3588,G4228"\w* \w de vocês|strong="G4771"\w*, \w como testemunho|strong="G1519,G3142"\w* \w para eles|strong="G846"\w*.”\f + \fr 6.11: \ft Variante: TR e Byz acrescentam no fim: "Em verdade digo a vocês: no dia do juízo, será mais tolerável para Sodoma e Gomorra do que para aquela cidade"; RP também começa com "todos os que não receberem" em vez de "o lugar que não receber"\f*\f + \fr 6.11: \ft Acréscimo: “que está debaixo”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 6:11 \xt MAT 10:14; LUK 9:5; MAT 10:1; LUK 9:1; LUK 10:1; ACT 18:6\x*
\v 12 \w E|strong="G2532"\w*, \w saindo|strong="G1831"\w*, \w proclamaram|strong="G2784"\w* \w que se arrependessem|strong="G2443,G3340"\w*,\x - \xo 6:12 \xt MAT 4:17; MAT 10:1; LUK 9:1; LUK 10:1; ACT 17:30; ACT 20:21\x*
\v 13 \w e|strong="G2532"\w* \w expulsavam|strong="G1544"\w* \w muitos demônios|strong="G1140,G4183"\w*, \w e|strong="G2532"\w* \w ungiam com óleo|strong="G218,G1637"\w* \w muitos doentes|strong="G4183,G732"\w* \w e|strong="G2532"\w* \w os curavam|strong="G2323"\w*.\x - \xo 6:13 \xt JAS 5:14; MAT 10:1; LUK 9:1; LUK 10:1; LUK 10:17; MRK 6:7\x*
\p
\v 14 \w E|strong="G2532"\w* \w o rei|strong="G3588,G935"\w* \w Herodes|strong="G2264"\w*\f + \fr 6.14: \ft Nota cultural: Herodes Antipas era tetrarca da Galileia; Marcos o chama de "rei"\f* \w ouviu falar|strong="G191"\w*, \w pois|strong="G1063"\w* \w o nome|strong="G3588,G3686"\w* \w dele|strong="G846"\w* \w se tornara|strong="G1096"\w* \w conhecido|strong="G5318"\w*; \w e|strong="G2532"\w* \w diziam|strong="G3004"\w*: “\w João|strong="G2491"\w*, \w o que batizava|strong="G3588,G907"\w*, \w foi ressuscitado|strong="G1453"\w* \w dentre os mortos|strong="G1537,G3498"\w*, \w e|strong="G2532"\w* \w por isso|strong="G1223,G3778"\w* \w esses poderes|strong="G3588,G1411"\w* \w agem|strong="G1754"\w* \w nele|strong="G1722,G846"\w*.”\f + \fr 6.14: \ft Variante: Tregelles e RP trazem o verbo no singular, "ele dizia" (ἔλεγεν), em lugar de "diziam" (ἔλεγον); nesse caso o sujeito pode ser Herodes; RP também traz "ressuscitou dos mortos" com outra ordem e outro tempo (ἐκ νεκρῶν ἠγέρθη)\f*\x - \xo 6:14 \xt LUK 9:7; MAT 14:2; MRK 6:14; LUK 4:37; MAT 14:1; MAT 17:12\x*
\v 15 \w Outros|strong="G243"\w* \w diziam|strong="G3004"\w*: “\w É Elias|strong="G2243,G1510"\w*.” \w E outros|strong="G243,G1161"\w* \w diziam|strong="G3004"\w*: “\w É um profeta|strong="G4396"\w*, \w como um|strong="G5613,G1520"\w* \w dos profetas|strong="G3588,G4396"\w*.”\f + \fr 6.15: \ft Acréscimo: verbo ser/estar suprido em “É um profeta”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:15 \xt MRK 8:28; JHN 1:21; LUK 9:8; LUK 9:19; MAT 16:14; JHN 1:25\x*
\v 16 \w Mas|strong="G1161"\w* \w Herodes|strong="G3588,G2264"\w*, \w ao ouvir|strong="G191"\w*, \w dizia|strong="G3004"\w*: “\w João|strong="G2491"\w*, \w a quem|strong="G3739"\w* \w eu|strong="G1473"\w* \w decapitei|strong="G607"\w*, \w este|strong="G3778"\w* \w foi ressuscitado|strong="G1453"\w*.”\f + \fr 6.16: \ft Variante: Tregelles, TR e Byz acrescentam "dos mortos" (ἐκ νεκρῶν) depois de "foi ressuscitado"; RP também traz "disse: este é João" (εἶπεν ὅτι… ἐστιν αὐτός)\f*\x - \xo 6:16 \xt LUK 9:9; MAT 14:10; LUK 9:7; MRK 6:14; MAT 14:1; MAT 17:12\x*
\v 17 \w Pois|strong="G1063"\w* \w o próprio|strong="G846"\w* \w Herodes|strong="G3588,G2264"\w* \w mandou prender|strong="G649,G2902"\w* \w João|strong="G3588,G2491"\w* \w e|strong="G2532"\w* \w o amarrou|strong="G1210,G846"\w* \w na prisão|strong="G1722,G5438"\w*, \w por causa de|strong="G1223"\w* \w Herodíades|strong="G2266"\w*, \w mulher|strong="G3588,G1135"\w* \w de Filipe|strong="G5376"\w*, \w seu irmão|strong="G3588,G80,G846"\w*, \w porque|strong="G3754"\w* \w se casara|strong="G1060"\w* \w com ela|strong="G846"\w*;\x - \xo 6:17 \xt MAT 14:3; LUK 3:19; MAT 11:2; JHN 3:24; LUK 9:7; LUK 3:1\x*
\v 18 \w pois|strong="G1063"\w* \w João|strong="G3588,G2491"\w* \w dizia|strong="G3004"\w* \w a Herodes|strong="G3588,G2264"\w*: “\w Não lhe é permitido|strong="G3756,G1832,G4771"\w* \w ter|strong="G2192"\w* \w a mulher|strong="G3588,G1135"\w* \w do seu irmão|strong="G3588,G80,G4771"\w*.”\x - \xo 6:18 \xt MAT 14:4; LUK 9:7; MRK 6:14; LEV 18:16; LEV 20:21; PRO 14:16\x*
\v 19 \w E|strong="G1161"\w* \w Herodíades|strong="G3588,G2266"\w* \w guardava rancor|strong="G1758"\w* \w contra ele|strong="G846"\w* \w e|strong="G2532"\w* \w queria matá-lo|strong="G2309,G846,G615"\w*, \w mas|strong="G2532"\w* \w não podia|strong="G3756,G1410"\w*;\x - \xo 6:19 \xt LUK 9:7; ECC 7:9; EPH 4:26-27; MRK 6:14; PRO 14:16; JAS 5:9\x*
\v 20 \w pois|strong="G1063"\w* \w Herodes|strong="G3588,G2264"\w* \w temia|strong="G5399"\w* \w João|strong="G3588,G2491"\w*, \w sabendo|strong="G6063"\w* \w que era um homem|strong="G846,G435"\w* \w justo|strong="G1342"\w* \w e|strong="G2532"\w* \w santo|strong="G40"\w*, \w e|strong="G2532"\w* \w o protegia|strong="G4933,G846"\w*; \w e|strong="G2532"\w*, \w ouvindo-o|strong="G191,G846"\w*, \w ficava muito perplexo|strong="G4183,G639"\w*\f + \fr 6.20: \ft Variante: Tregelles e RP trazem "fazia muitas coisas" (ἐποίει) em lugar de "ficava muito perplexo" (ἠπόρει)\f*, \w e|strong="G2532"\w* \w gostava de|strong="G2234"\w* \w ouvi-lo|strong="G846,G191"\w*.\f + \fr 6.20: \ft Acréscimo: verbo ser/estar suprido em “que era um homem”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:20 \xt PHP 4:8; MAT 21:26; LUK 9:7; EZK 33:32; MRK 4:16; MRK 6:14\x*
\v 21 \w E|strong="G2532"\w*, \w chegando|strong="G1096"\w* \w um dia oportuno|strong="G2250,G2121"\w*, \w quando|strong="G3753"\w* \w Herodes|strong="G2264"\w*, \w no seu aniversário|strong="G3588,G1077,G846"\w*, \w deu um banquete|strong="G1173,G4160"\w* \w aos seus altos funcionários|strong="G3588,G3175,G846"\w*, \w aos comandantes|strong="G3588,G5506"\w* \w e|strong="G2532"\w* \w aos principais|strong="G3588,G4413"\w* \w da Galileia|strong="G3588,G1056"\w*,\x - \xo 6:21 \xt EST 1:11; EST 1:3; EST 2:18; LUK 9:7; MAT 14:6; MRK 6:14\x*
\v 22 \w e|strong="G2532"\w*, \w entrando|strong="G1525"\w* \w a filha|strong="G3588,G2364"\w* \w da própria|strong="G846"\w* \w Herodíades|strong="G3588,G2266"\w*\f + \fr 6.22: \ft Variante: NA27, NA28 e WH trazem "a filha dele, Herodíades" (αὐτοῦ) em lugar de "a filha da própria Herodíades"; a forma do verbo "agradou" também varia (ἤρεσεν em WH, Tregelles e NA28)\f*, \w e|strong="G2532"\w* \w dançando|strong="G3738"\w* \w e|strong="G2532"\w* \w agradando|strong="G700"\w* \w a Herodes|strong="G3588,G2264"\w* \w e|strong="G2532"\w* \w aos que estavam à mesa|strong="G3588,G4873"\w*, \w o rei|strong="G3588,G935"\w* \w disse|strong="G2036"\w* \w à menina|strong="G3588,G2877"\w*: “\w Peça-me|strong="G154,G3165"\w* \w o que quiser|strong="G3739,G1437,G2309"\w*, \w e|strong="G2532"\w* \w eu darei a você|strong="G1325,G4771"\w*.”\x - \xo 6:22 \xt MAT 14:6; EST 1:11; LUK 9:7; EST 1:10-12; MRK 6:14; MAT 20:21\x*
\v 23 \w E|strong="G2532"\w* \w jurou a ela|strong="G3660,G846"\w*: “\w O que você me pedir|strong="G3739,G5100,G1437,G3165,G154"\w*, \w eu darei a você|strong="G1325,G4771"\w*, \w até metade|strong="G2193,G2255"\w* \w do meu reino|strong="G3588,G932,G3165"\w*.”\f + \fr 6.23: \ft Variante: NA27 e NA28 trazem "muito" ou "solenemente" (πολλά) depois de "jurou a ela"\f*\x - \xo 6:23 \xt EST 5:3; EST 7:2; 1SA 28:10; EST 5:6; LUK 9:7; MAT 14:6\x*
\v 24 \w E|strong="G2532"\w*, \w saindo|strong="G1831"\w*, \w disse|strong="G2036"\w* \w à sua mãe|strong="G3588,G3384,G846"\w*: “\w O que|strong="G5101"\w* \w devo pedir|strong="G154"\w*?” \w E|strong="G1161"\w* \w ela|strong="G3588"\w* \w respondeu|strong="G2036"\w*: “\w A cabeça|strong="G3588,G2776"\w* \w de João|strong="G2491"\w*, \w o que batiza|strong="G3588,G907"\w*.”\x - \xo 6:24 \xt MAT 14:8; LUK 9:7; MRK 6:14; ACT 23:12; ECC 7:9; MAT 14:1\x*
\v 25 \w E|strong="G2532"\w*, \w entrando|strong="G1525"\w* \w logo|strong="G2112"\w* \w apressadamente|strong="G3326,G4710"\w* \w junto ao rei|strong="G4314,G3588,G935"\w*, \w pediu|strong="G154"\w*, \w dizendo|strong="G3004"\w*: “\w Quero|strong="G2309"\w* \w que agora mesmo|strong="G2443,G1824"\w* \w você me dê|strong="G1325,G3165"\w*, \w numa bandeja|strong="G1909,G4094"\w*, \w a cabeça|strong="G3588,G2776"\w* \w de João|strong="G2491"\w*, \w o Batista|strong="G3588,G910"\w*.”\x - \xo 6:25 \xt MAT 14:8; LUK 9:7; MRK 6:14; ACT 23:12; MAT 14:1; MAT 17:12\x*
\v 26 \w E|strong="G2532"\w* \w o rei|strong="G3588,G935"\w*, \w muito entristecido|strong="G4036,G1096"\w*, \w por causa dos juramentos|strong="G1223,G3588,G3727"\w* \w e|strong="G2532"\w* \w dos que estavam à mesa|strong="G3588,G345"\w*, \w não quis|strong="G3756,G2309"\w* \w recusar-lhe|strong="G114,G846"\w*;\x - \xo 6:26 \xt DAN 6:14; LUK 9:7; MRK 6:14; ACT 23:12; MAT 14:1; MAT 17:12\x*
\v 27 \w e|strong="G2532"\w* \w logo|strong="G2112"\w* \w o rei|strong="G3588,G935"\w*, \w tendo enviado|strong="G649"\w* \w um soldado da guarda|strong="G4688"\w*\f + \fr 6.27: \ft Nota cultural: σπεκουλάτωρ vem do latim speculator, soldado da guarda; aqui, encarregado da execução\f*, \w ordenou|strong="G2004"\w* \w que trouxesse|strong="G5342"\w* \w a cabeça|strong="G3588,G2776"\w* \w dele|strong="G846"\w*. \w E|strong="G2532"\w* \w ele foi|strong="G565"\w* \w e o decapitou|strong="G607,G846"\w* \w na prisão|strong="G1722,G3588,G5438"\w*\x - \xo 6:27 \xt LUK 9:7; MRK 6:14; MAT 14:1; MAT 17:12; PRO 31:4; REV 20:4\x*
