\p
\v 1 \w E|strong="G2532"\w*, \w tendo entrado|strong="G1525"\w* \w de novo|strong="G3825"\w* \w em Cafarnaum|strong="G1519,G2584"\w*, \w depois de alguns dias|strong="G1223,G2250"\w*, \w soube-se|strong="G191"\w* \w que|strong="G3754"\w* \w ele estava|strong="G1510"\w* \w em casa|strong="G1722,G3624"\w*;\f + \fr 2.1: \ft Tradução: ἠκούσθη (ἀκούω, G191) está aqui como “soube-se”; o termo pode ser “ouvir”, “escutar”, “obedecer”, “entender” ou “receber notícia”, e o contexto decide.\f*\x - \xo 2:1 \xt MAT 8:5; MAT 9:2; LUK 5:18; JHN 4:47; MRK 1:45; MRK 6:55\x*
\v 2 \w E|strong="G2532"\w*\f + \fr 2.2: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam "logo" (εὐθέως) depois do primeiro "E"\f* \w se reuniram|strong="G4863"\w* \w muitos|strong="G4183"\w*, \w de modo que|strong="G5620"\w* \w já não|strong="G3371"\w* \w havia espaço|strong="G5562"\w*, \w nem mesmo|strong="G3366"\w* \w junto à porta|strong="G3588,G4314,G2374"\w*, \w e|strong="G2532"\w* \w ele lhes falava|strong="G2980,G846"\w* \w a palavra|strong="G3588,G3056"\w*.\x - \xo 2:2 \xt MAT 9:2; JAS 1:19; MRK 2:13; MRK 1:45; MRK 4:14; 2TI 4:2\x*
