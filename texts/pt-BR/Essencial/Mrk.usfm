\p
\v 1 \w Princípio|strong="G746"\w* \w da boa notícia|strong="G3588,G2098"\w* \w de Jesus Cristo|strong="G2424,G5547"\w*\f + \fr 1.1: \ft Variante: NA27, NA28, Tyndale, Tregelles, TR e Byz acrescentam "Filho de Deus" no fim; o SBLGNT e WH terminam em "Cristo"\f*.\x - \xo 1:1 \xt JHN 1:6; 1JN 5:11-12; MAT 3:17; MAT 4:3; JHN 1:34; JHN 20:31\x*
\v 2 \w Conforme|strong="G2531"\w* \w está escrito|strong="G1125"\w* \w no profeta|strong="G1722,G3588,G4396"\w* \w Isaías|strong="G2268"\w*\f + \fr 1.2: \ft Nota cultural: a primeira citação lembra Malaquias 3:1 e Êxodo 23:20; a segunda, no versículo seguinte, é de Isaías 40:3\f*: “\w Olhe|strong="G2400"\w*, \w envio|strong="G649"\w* \w o meu mensageiro|strong="G3588,G32,G3165"\w* \w à sua frente|strong="G4253,G4383,G4771"\w*, \w que|strong="G3739"\w* \w preparará|strong="G2680"\w* \w o seu caminho|strong="G3588,G3598,G4771"\w*”\f + \fr 1.2: \ft Variante: TR e Byz trazem "nos profetas" em lugar de "no profeta Isaías", e acrescentam "eu" (ἐγώ) depois de "Olhe" e "diante de você" (ἔμπροσθέν σου) no fim da citação\f*.\f + \fr 1.2: \ft Tradução: ἄγγελόν (ἄγγελος, G32) está aqui como “o meu mensageiro”; o termo pode ser “anjo” (mensageiro celeste) ou “mensageiro” (humano), e o contexto decide.\f*\x - \xo 1:2 \xt ISA 40:3; MAL 3:1; EXO 23:20; MAT 11:10; LUK 7:27; JHN 6:45\x*
\v 3 “\w Voz|strong="G5456"\w* \w de alguém que clama|strong="G994"\w* \w no deserto|strong="G1722,G3588,G2048"\w*: ‘\w Preparem|strong="G2090"\w* \w o caminho|strong="G3588,G3598"\w* \w do Senhor|strong="G2962"\w*, \w façam|strong="G4160"\w* \w retas|strong="G2117"\w* \w as veredas|strong="G3588,G5147"\w* \w dele|strong="G846"\w*’”,\x - \xo 1:3 \xt MAT 3:3; LUK 3:4; ISA 40:3; JHN 1:23; MAL 3:1; JHN 1:6\x*
\v 4 \w apareceu|strong="G1096"\w* \w João|strong="G2491"\w*, \w o que batizava|strong="G3588,G907"\w* \w no deserto|strong="G1722,G3588,G2048"\w*, \w proclamando|strong="G2784"\w* \w um batismo|strong="G908"\w* \w de arrependimento|strong="G3341"\w* \w para o perdão|strong="G1519,G859"\w* \w dos pecados|strong="G266"\w*.\x - \xo 1:4 \xt LUK 3:3; ACT 19:4; ACT 19:3; ISA 40:3; ACT 13:24; LUK 24:47\x*
\v 5 \w E|strong="G2532"\w* \w saía|strong="G1607"\w* \w até ele|strong="G4314,G846"\w* \w toda a região|strong="G3956,G3588,G5561"\w* \w da Judeia|strong="G2449"\w*, \w e|strong="G2532"\w* \w todos os habitantes|strong="G3588,G3956"\w* \w de Jerusalém|strong="G2415"\w*, \w e|strong="G2532"\w* \w eram batizados|strong="G907"\w* \w por ele|strong="G5259,G846"\w* \w no rio|strong="G1722,G3588,G4215"\w* \w Jordão|strong="G2446"\w*, \w confessando|strong="G1843"\w* \w os seus pecados|strong="G3588,G266,G846"\w*.\x - \xo 1:5 \xt MAT 3:6; ISA 40:3; MAT 3:5; 1JN 1:9; JHN 1:6; ACT 19:18\x*
\v 6 \w E|strong="G2532"\w* \w João|strong="G3588,G2491"\w* \w estava vestido|strong="G1510,G1746"\w* \w de pelos|strong="G2359"\w* \w de camelo|strong="G2574"\w*, \w e|strong="G2532"\w* \w com um cinto|strong="G2223"\w* \w de couro|strong="G1193"\w* \w ao redor|strong="G4012"\w* \w da cintura|strong="G3588,G3751"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w comia|strong="G2068"\w* \w gafanhotos|strong="G200"\w* \w e|strong="G2532"\w* \w mel silvestre|strong="G3192,G66"\w*.\x - \xo 1:6 \xt MAT 3:4; 2KI 1:8; JHN 1:6; LEV 11:22; ZEC 13:4; MAT 21:25\x*
\v 7 \w E|strong="G2532"\w* \w proclamava|strong="G2784"\w*, \w dizendo|strong="G3004"\w*: “\w Depois de mim|strong="G3694,G3165"\w* \w vem|strong="G2064"\w* \w aquele que é mais forte|strong="G3588,G2478"\w* \w do que eu|strong="G3165"\w*, \w de quem|strong="G3739"\w* \w não sou|strong="G3756,G1510"\w* \w digno|strong="G2425"\w*\f + \fr 1.7: \ft Lit.: ἱκανός, literalmente "suficiente, capaz"\f* \w de soltar|strong="G3089"\w*, \w abaixando-me|strong="G2955"\w*, \w a correia|strong="G3588,G2438"\w* \w das sandálias|strong="G3588,G5266"\w* \w dele|strong="G846"\w*.”\f + \fr 1.7: \ft Acréscimo: verbo ser/estar suprido em “aquele que é mais forte”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:7 \xt JHN 1:27; LUK 3:16; MAT 3:11; JHN 1:6; ACT 13:25; JHN 1:20\x*
\v 8 \w Eu|strong="G1473"\w* \w batizei|strong="G907"\w* \w vocês|strong="G4771"\w* \w com água|strong="G5204"\w*, \w mas ele|strong="G846,G1161"\w* \w batizará|strong="G907"\w* \w vocês|strong="G4771"\w* \w com o Espírito Santo|strong="G1722,G4151,G40"\w*\f + \fr 1.8: \ft Lit.: πνεύματι ἁγίῳ, sem artigo no grego\f*.\x - \xo 1:8 \xt ACT 1:5; ACT 11:16; JHN 1:33; JHN 1:26; MAT 3:11; LUK 3:16\x*
\v 9 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w*, \w naqueles dias|strong="G1722,G1565,G3588,G2250"\w*, \add que\add* \w Jesus|strong="G2424"\w* \w veio|strong="G2064"\w* \w de Nazaré|strong="G575,G3478"\w* \w da Galileia|strong="G3588,G1056"\w* \w e|strong="G2532"\w* \w foi batizado|strong="G907"\w* \w no Jordão|strong="G1519,G3588,G2446"\w* \w por João|strong="G5259,G2491"\w*.\f + \fr 1.9: \ft Acréscimo: “que” (em “naqueles dias que Jesus veio”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 1:9 \xt MAT 3:13; MAT 21:11; LUK 3:21; MAT 21:25; 2KI 5:12; MAT 2:23\x*
\v 10 \w E|strong="G2532"\w* \w logo|strong="G2112"\w*, \w ao subir|strong="G305"\w* \w da água|strong="G1537,G3588,G5204"\w*, \w viu|strong="G1492"\w* \w os céus|strong="G3588,G3772"\w* \w se rasgando|strong="G4977"\w* \w e|strong="G2532"\w* \w o Espírito|strong="G3588,G4151"\w* \w descendo|strong="G2597"\w* \w sobre ele|strong="G1519,G846"\w*\f + \fr 1.10: \ft Lit.: εἰς, "para dentro de"\f* \w como uma pomba|strong="G5613,G4058"\w*;\x - \xo 1:10 \xt MAT 3:16; JHN 1:32; JHN 1:51; JHN 1:31-34; LUK 3:22; REV 4:1\x*
\v 11 \w E|strong="G2532"\w* \w veio|strong="G1096"\w* \w uma voz|strong="G5456"\w* \w dos céus|strong="G1537,G3588,G3772"\w*: “\w Você é|strong="G4771,G1510"\w* \w o meu Filho amado|strong="G3588,G5207,G3165,G27"\w*, \w em você|strong="G1722,G4771"\w* \w tenho prazer|strong="G2106"\w*\f + \fr 1.11: \ft Lit.: εὐδόκησα, aoristo; literalmente "me agradei"\f*\f + \fr 1.11: \ft Variante: a edição bizantina (RP) traz "em quem" (ᾧ) no lugar de "em você"\f*.”\x - \xo 1:11 \xt 2PE 1:17; MAT 3:17; MAT 17:5; MRK 9:7; LUK 3:22; ISA 42:1\x*
\v 12 \w E|strong="G2532"\w* \w logo|strong="G2112"\w* \w o Espírito|strong="G3588,G4151"\w* \w o lançou|strong="G846,G1544"\w*\f + \fr 1.12: \ft Lit.: presente histórico no grego, "lança"\f* \w para o deserto|strong="G1519,G3588,G2048"\w*.\x - \xo 1:12 \xt MRK 1:43; MAT 4:1; LUK 4:1; ACT 19:4\x*
\v 13 \w E|strong="G2532"\w* \w ficou|strong="G1510"\w* \w no deserto|strong="G1722,G3588,G2048"\w* \w durante quarenta dias|strong="G5062,G2250"\w*, \w tentado|strong="G3985"\w*\f + \fr 1.13: \ft Lit.: πειράζω também significa "pôr à prova"\f* \w por Satanás|strong="G5259,G3588,G4567"\w*; \w e|strong="G2532"\w* \w estava|strong="G1510"\w* \w com os animais selvagens|strong="G3326,G3588,G2342"\w*, \w e|strong="G2532"\w* \w os anjos|strong="G3588,G32"\w* \w o serviam|strong="G1247,G846"\w*.\x - \xo 1:13 \xt MAT 4:1; LUK 4:1; 1TI 3:16; HEB 2:17-18; HEB 4:15; EXO 34:28\x*
\v 14 \w E|strong="G2532"\w* \w depois que|strong="G3326,G3588"\w* \w João|strong="G3588,G2491"\w* \w foi entregue|strong="G3860"\w*\f + \fr 1.14: \ft Nota cultural: "entregue" às autoridades, isto é, preso\f*, \w Jesus|strong="G3588,G2424"\w* \w foi|strong="G2064"\w* \w para a Galileia|strong="G1519,G3588,G1056"\w*, \w proclamando|strong="G2784"\w* \w a boa notícia|strong="G3588,G2098"\w* \w de Deus|strong="G3588,G2316"\w*\f + \fr 1.14: \ft Variante: TR e Byz acrescentam "do reino" (τῆς βασιλείας) depois de "boa notícia"\f*.\x - \xo 1:14 \xt MAT 4:12; MAT 4:23; MAT 4:1; MAT 4:17; LUK 8:1; LUK 23:5\x*
\v 15 \w E|strong="G2532"\w* \w dizendo|strong="G3004"\w*: “\w O tempo|strong="G3588,G2540"\w* \w se cumpriu|strong="G4137"\w* \w e|strong="G2532"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w se aproximou|strong="G1448"\w*; \w arrependam-se|strong="G3340"\w* \w e|strong="G2532"\w* \w creiam|strong="G4100"\w* \w na boa notícia|strong="G1722,G3588,G2098"\w*.”\x - \xo 1:15 \xt MAT 3:2; MAT 4:17; MAT 10:7; LUK 10:9; MRK 16:16; MAT 4:1\x*
\v 16 \w E|strong="G2532"\w*, \w passando|strong="G3855"\w* \w ao longo|strong="G3844"\w* \w do mar|strong="G3588,G2281"\w* \w da Galileia|strong="G3588,G1056"\w*\f + \fr 1.16: \ft Nota cultural: o "mar" da Galileia é um lago de água doce\f*, \w viu|strong="G1492"\w* \w Simão|strong="G4613"\w* \w e|strong="G2532"\w* \w André|strong="G406"\w*, \w irmão|strong="G3588,G80"\w* \w de Simão|strong="G4613"\w*, \w lançando|strong="G6006"\w* \add redes\add* \w no mar|strong="G1722,G3588,G2281"\w*, \w pois|strong="G1063"\w* \w eram|strong="G1510"\w* \w pescadores|strong="G231"\w*;\f + \fr 1.16: \ft Acréscimo: “redes” (em “Simão lançando redes no mar”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 1:16 \xt MAT 4:18; JHN 1:40; JHN 6:8; LUK 5:1; MRK 10:28; LUK 6:14\x*
\v 17 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Venham|strong="G1205"\w* \w atrás de mim|strong="G3694,G3165"\w*, \w e|strong="G2532"\w* \w farei com que|strong="G4160"\w* \w vocês|strong="G4771"\w* \w se tornem|strong="G1096"\w* \w pescadores|strong="G231"\w* \w de pessoas|strong="G444"\w*.”\x - \xo 1:17 \xt MAT 4:19; LUK 5:1; MRK 10:28; JHN 1:40; MAT 4:18; MAT 19:27\x*
\v 18 \w E|strong="G2532"\w* \w logo|strong="G2112"\w*, \w deixando|strong="G863"\w* \w as redes|strong="G3588,G1350"\w*, \w o seguiram|strong="G190,G846"\w*.\x - \xo 1:18 \xt MAT 4:20; MRK 10:28; MAT 4:22; LUK 18:28; MAT 19:27; LUK 5:11\x*
\v 19 \w E|strong="G2532"\w*, \w indo um pouco mais adiante|strong="G4260,G3641"\w*, \w viu|strong="G1492"\w* \w Tiago|strong="G2385"\w*, \w filho|strong="G3588"\w* \w de Zebedeu|strong="G3588,G2199"\w*, \w e|strong="G2532"\w* \w João|strong="G2491"\w*, \w irmão dele|strong="G3588,G80,G846"\w*, \w que também|strong="G2532,G846"\w* \add estavam\add* \w no barco|strong="G1722,G3588,G4143"\w*, \w consertando|strong="G2675"\w* \w as redes|strong="G3588,G1350"\w*,\f + \fr 1.19: \ft Acréscimo: “estavam” (em “que também estavam no barco”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 1:19 \xt MAT 4:21; MRK 10:35; MRK 3:17; LUK 5:1; MRK 10:28; JHN 1:40\x*
\v 20 \w E|strong="G2532"\w* \w logo|strong="G2112"\w* \w os chamou|strong="G2564,G846"\w*. \w E|strong="G2532"\w*, \w deixando|strong="G863"\w* \w o pai|strong="G3588,G3962"\w* \w deles|strong="G846"\w*, \w Zebedeu|strong="G2199"\w*, \w no barco|strong="G1722,G3588,G4143"\w* \w com os empregados|strong="G3326,G3588,G3411"\w*, \w foram embora|strong="G565"\w* \w atrás dele|strong="G3694,G846"\w*.\x - \xo 1:20 \xt MAT 4:22; MAT 4:21; LUK 5:1; MRK 10:28; JHN 1:40; MAT 4:18\x*
\v 21 \w E|strong="G2532"\w* \w entraram|strong="G1531"\w* \w em Cafarnaum|strong="G1519,G2584"\w*. \w E|strong="G2532"\w* \w logo|strong="G2112"\w*, \w no sábado|strong="G3588,G4521"\w*, \w ele ensinava|strong="G1321"\w* \w na sinagoga|strong="G1519,G3588,G4864"\w*\f + \fr 1.21: \ft Variante: as demais edições trazem "tendo entrado" (εἰσελθών) antes de "na sinagoga"; o SBLGNT lê "ensinava na sinagoga" sem esse particípio\f*.\x - \xo 1:21 \xt LUK 13:10; JHN 6:59; LUK 4:31; MRK 6:2; MRK 3:1; MRK 1:39\x*
\v 22 \w E|strong="G2532"\w* \w ficavam admirados|strong="G1605"\w* \w com o ensino|strong="G1909,G3588,G1322"\w* \w dele|strong="G846"\w*, \w pois|strong="G1063"\w* \w os ensinava|strong="G1510,G1321,G846"\w* \w como quem|strong="G5613"\w* \w tem|strong="G2192"\w* \w autoridade|strong="G1849"\w*, \w e|strong="G2532"\w* \w não como|strong="G3756,G5613"\w* \w os escribas|strong="G3588,G1122"\w*.\x - \xo 1:22 \xt LUK 4:32; MAT 7:28; MRK 11:18; MAT 7:29; MAT 22:33; MAT 13:54\x*
\v 23 \w E|strong="G2532"\w* \w logo|strong="G2112"\w*\f + \fr 1.23: \ft Variante: Tregelles, TR e Byz omitem "logo" (εὐθύς), o que muda o ritmo da cena\f* \w havia|strong="G1510"\w* \w na sinagoga|strong="G1722,G3588,G4864"\w* \w deles|strong="G846"\w* \w um homem|strong="G444"\w* \w com um espírito impuro|strong="G1722,G4151,G169"\w*, \w e|strong="G2532"\w* \w gritou|strong="G349"\w*\x - \xo 1:23 \xt LUK 4:33; MRK 5:2; MRK 3:11; LUK 4:31; LUK 5:11; MRK 9:25\x*
\v 24 \w dizendo|strong="G3004"\w*: “\w Que há entre nós e você|strong="G5101,G3165,G2532,G4771"\w*\f + \fr 1.24: \ft Variante: TR e Byz acrescentam a interjeição "Ah!" (ἔα) antes de "Que há"\f*, \w Jesus de Nazaré|strong="G2424,G3479"\w*? \w Veio|strong="G2064"\w* \w nos destruir|strong="G622,G3165"\w*? \w Sei|strong="G6063"\w* \w quem você é|strong="G4771,G5101,G1510"\w*: \w o Santo|strong="G3588,G40"\w* \w de Deus|strong="G3588,G2316"\w*.”\f + \fr 1.24: \ft Acréscimo: “Que há entre nós e você”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 1:24 \xt LUK 4:34; JAS 2:19; MAT 8:29; 1JN 3:8; REV 3:7; ACT 3:14\x*
\v 25 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w o repreendeu|strong="G2008,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Cale-se|strong="G5392"\w* \w e|strong="G2532"\w* \w saia|strong="G1831"\w* \w dele|strong="G1537,G846"\w*.”\x - \xo 1:25 \xt LUK 4:35; LUK 4:41; MAT 8:8; MRK 1:34; MRK 3:12; LUK 4:31\x*
\v 26 \w E|strong="G2532"\w* \w o espírito impuro|strong="G3588,G4151,G169"\w*, \w tendo-o sacudido em convulsão|strong="G4682,G846"\w* \w e|strong="G2532"\w* \w gritado|strong="G5455"\w* \w em alta voz|strong="G5456,G3173"\w*, \w saiu|strong="G1831"\w* \w dele|strong="G1537,G846"\w*.\x - \xo 1:26 \xt MRK 9:26; MRK 5:8; MAT 8:8; MRK 9:20; LUK 4:31; ACT 16:18\x*
\v 27 \w E|strong="G2532"\w* \w todos|strong="G537"\w* \w ficaram pasmos|strong="G2284"\w*, \w de modo que|strong="G5620"\w* \w discutiam|strong="G4802"\w* \w entre si|strong="G4314,G1438"\w*, \w dizendo|strong="G3004"\w*: “\w O que é isto|strong="G5101,G1510,G3778"\w*? \w Um ensino novo|strong="G1322,G2537"\w*\f + \fr 1.27: \ft Variante: a edição bizantina (RP) faz do começo uma pergunta, "Que ensino novo é este, que…?"\f*\f + \fr 1.27: \ft Lit.: a pontuação do SBLGNT também permite ligar "com autoridade" ao que segue: "Um ensino novo! Com autoridade ele manda até nos espíritos impuros"\f*! \w Com autoridade|strong="G2596,G1849"\w* \w ele manda|strong="G2004"\w* \w até|strong="G2532"\w* \w aos espíritos impuros|strong="G3588,G4151,G169"\w*, \w e|strong="G2532"\w* \w eles lhe obedecem|strong="G5219,G846"\w*.”\x - \xo 1:27 \xt LUK 4:36; MAT 8:8; ACT 17:19; MAT 8:27; LUK 7:7; LUK 4:31\x*
\v 28 \w E|strong="G2532"\w* \w logo|strong="G2112"\w* \w a fama|strong="G3588,G189"\w* \w dele|strong="G846"\w* \w se espalhou|strong="G1831"\w* \w por toda parte|strong="G3837"\w*, \w por toda a região ao redor|strong="G1519,G3650,G3588,G4066"\w* \w da Galileia|strong="G3588,G1056"\w*.\x - \xo 1:28 \xt LUK 7:17; LUK 4:14; LUK 4:31; LUK 4:37; MRK 6:14; MAT 4:24\x*
