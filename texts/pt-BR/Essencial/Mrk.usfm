\v 4 \w E|strong="G2532"\w*, \w não podendo|strong="G3361,G1410"\w* \w levá-lo até ele|strong="G4374,G846"\w* \w por causa da multidão|strong="G1223,G3588,G3793"\w*, \w removeram o teto|strong="G648,G3588,G4721"\w* \w onde ele estava|strong="G3699,G1510"\w*, \w e|strong="G2532"\w*, \w fazendo uma abertura|strong="G1846"\w*, \w baixaram|strong="G5465"\w* \w a esteira|strong="G3588,G2895"\w* \w onde o paralítico|strong="G3699,G3588,G3885"\w* \w estava deitado|strong="G2621"\w*.\x - \xo 2:4 \xt MAT 9:2; LUK 5:18; LUK 5:19; DEU 22:8; MAT 8:6; ACT 5:16\x*
\v 5 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w vendo|strong="G1492"\w* \w a fé|strong="G3588,G4102"\w* \w deles|strong="G846"\w*, \w disse|strong="G3004"\w* \w ao paralítico|strong="G3588,G3885"\w*: “\w Filho|strong="G5043"\w*, \w os seus pecados|strong="G4771,G3588,G266"\w* \w estão perdoados|strong="G863"\w*.”\x - \xo 2:5 \xt MAT 9:2; LUK 5:20; LUK 7:48; MRK 2:9; MRK 2:10; JHN 20:23\x*
\v 6 \w Ora|strong="G1161"\w*, \w alguns|strong="G5100"\w* \w dos escribas|strong="G3588,G1122"\w* \w estavam|strong="G1510"\w* \w ali|strong="G1563"\w* \w sentados|strong="G2521"\w* \w e|strong="G2532"\w* \w raciocinavam|strong="G1260"\w* \w em seus corações|strong="G1722,G3588,G2588,G846"\w*:\x - \xo 2:6 \xt LUK 5:21; MRK 8:17; JAS 5:15; MAT 9:2; JHN 20:23; LUK 5:18\x*
\v 7 “\w Por que|strong="G5101"\w* \w este|strong="G3778"\w* \w fala|strong="G2980"\w* \w assim|strong="G3779"\w*? \w Blasfema|strong="G987"\w*! \w Quem|strong="G5101"\w* \w pode|strong="G1410"\w* \w perdoar|strong="G863"\w* \w pecados|strong="G266"\w*, \w a não ser|strong="G1487,G3361"\w* \w Deus|strong="G3588,G2316"\w*, \w o único|strong="G1520"\w*?”\x - \xo 2:7 \xt ISA 43:25; JHN 20:23; LUK 7:48; LUK 5:21; LUK 7:49; LUK 12:10\x*
\v 8 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w logo|strong="G2112"\w* \w percebendo|strong="G1921"\w* \w em seu espírito|strong="G3588,G4151,G846"\w* \w que|strong="G3754"\w* \w assim|strong="G3779"\w* \w raciocinavam|strong="G1260"\w* \w dentro de si|strong="G1722,G1438"\w*, \w disse|strong="G3004"\w* \w a eles|strong="G846"\w*: “\w Por que|strong="G5101"\w* \w raciocinam|strong="G1260"\w* \w essas coisas|strong="G3778"\w* \w nos corações de vocês|strong="G1722,G3588,G2588,G4771"\w*?\x - \xo 2:8 \xt LUK 5:22; MRK 8:17; JAS 5:15; MAT 9:2; JHN 20:23; LUK 5:18\x*
