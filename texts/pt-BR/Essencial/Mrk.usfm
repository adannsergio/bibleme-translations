\v 46 \w E|strong="G2532"\w*, \w depois de se despedir|strong="G657"\w* \w deles|strong="G846"\w*, \w foi|strong="G565"\w* \w ao monte|strong="G1519,G3588,G3735"\w* \w orar|strong="G4336"\w*.\x - \xo 6:46 \xt LUK 6:12; MAT 14:22; LUK 5:16; MRK 1:35; PSA 55:17; MAT 14:23\x*
\v 47 \w E|strong="G2532"\w*, \w ao anoitecer|strong="G3798,G1096"\w*, \w o barco|strong="G3588,G4143"\w* \w estava|strong="G1510"\w* \w no meio|strong="G1722,G3319"\w* \w do mar|strong="G3588,G2281"\w*, \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w sozinho|strong="G3441"\w* \w em terra|strong="G1909,G3588,G1093"\w*.\x - \xo 6:47 \xt JHN 6:16; MAT 14:23; MAT 14:22; MRK 1:35; JHN 6:19; JHN 6:15\x*
\v 48 \w E|strong="G2532"\w*, \w vendo|strong="G1492"\w* \w que eles|strong="G846"\w* \w se esforçavam com dificuldade|strong="G928"\w* \w ao remar|strong="G1722,G3588,G1643"\w*, \w pois|strong="G1063"\w* \w o vento|strong="G3588,G417"\w* \w era contrário|strong="G1510,G1727"\w* \w a eles|strong="G846"\w*, \w por volta da quarta vigília|strong="G4012,G5067,G5438"\w*\f + \fr 6.48: \ft Nota cultural: a "quarta vigília" é a última parte da noite, antes do amanhecer\f* \w da noite|strong="G3588,G3571"\w* \w foi|strong="G2064"\w* \w até eles|strong="G4314,G846"\w*, \w andando|strong="G4043"\w* \w sobre o mar|strong="G1909,G3588,G2281"\w*; \w e|strong="G2532"\w* \w queria|strong="G2309"\w* \w passar adiante|strong="G3928"\w* \w deles|strong="G846"\w*.\x - \xo 6:48 \xt MAT 14:25; MAT 14:24; MAT 14:22; MRK 1:35; JHN 6:19; JOB 9:8\x*
\v 49 \w Mas|strong="G1161"\w* \w eles|strong="G3588"\w*, \w ao vê-lo|strong="G1492,G846"\w* \w andar|strong="G4043"\w* \w sobre o mar|strong="G1909,G3588,G2281"\w*, \w pensaram|strong="G1380"\w* \w que|strong="G3754"\w* \w era um fantasma|strong="G5326,G1510"\w* \w e|strong="G2532"\w* \w gritaram|strong="G349"\w*,\x - \xo 6:49 \xt MAT 14:26; MAT 14:22; JHN 6:19; JOB 9:8; MAT 14:25-26; LUK 24:37\x*
\v 50 \w pois|strong="G1063"\w* \w todos|strong="G3956"\w* \w o viram|strong="G846,G1492"\w* \w e|strong="G2532"\w* \w ficaram perturbados|strong="G5015"\w*. \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w logo|strong="G2112"\w* \w falou|strong="G2980"\w* \w com eles|strong="G3326,G846"\w*, \w e|strong="G2532"\w* \w disse-lhes|strong="G3004,G846"\w*: “\w Coragem|strong="G2293"\w*! \w Sou eu|strong="G1473,G1510"\w*\f + \fr 6.50: \ft Lit.: ἐγώ εἰμι, literalmente "eu sou"\f*; \w não tenham medo|strong="G3361,G5399"\w*.”\x - \xo 6:50 \xt MAT 14:27; MAT 14:22; ISA 43:2; JHN 6:19-20; JHN 6:20; MAT 14:26\x*
\v 51 \w E|strong="G2532"\w* \w subiu|strong="G305"\w* \w até eles|strong="G4314,G846"\w* \w no barco|strong="G1519,G3588,G4143"\w*, \w e|strong="G2532"\w* \w o vento|strong="G3588,G417"\w* \w cessou|strong="G2869"\w*. \w E|strong="G2532"\w* \w ficaram extremamente atônitos|strong="G3029,G1537,G4053,G1839"\w* \w em si mesmos|strong="G1722,G1438"\w*,\f + \fr 6.51: \ft Variante: TR e Byz acrescentam "e se maravilhavam" (καὶ ἐθαύμαζον) no fim\f*\x - \xo 6:51 \xt MAT 14:32; MAT 14:22; MRK 7:37; JHN 6:21; MAT 8:27; MRK 4:39\x*
\v 52 \w pois|strong="G1063"\w* \w não tinham entendido|strong="G3756,G4920"\w* \w a respeito dos pães|strong="G1909,G3588,G740"\w*, \w mas|strong="G235"\w* \w o coração|strong="G3588,G2588"\w* \w deles|strong="G846"\w* \w estava endurecido|strong="G1510,G4456"\w*.\f + \fr 6.52: \ft Variante: RP traz "pois" (γάρ), depois do verbo, em lugar de "mas" (ἀλλʼ) antes dele\f*\x - \xo 6:52 \xt MRK 8:17; JHN 12:40; LUK 24:25; ISA 63:17; MRK 8:21; MRK 16:14\x*
\p
\v 53 \w E|strong="G2532"\w*, \add tendo\add* \w atravessado|strong="G1276"\w*, \w chegaram à terra|strong="G1909,G3588,G1093,G2064"\w*, \w em Genesaré|strong="G1519,G1082"\w*, \w e|strong="G2532"\w* \w atracaram|strong="G4358"\w*.\f + \fr 6.53: \ft Acréscimo: “tendo” (em “E tendo atravessado chegaram”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 6:53 \xt MAT 14:34; JHN 6:24; LUK 5:1\x*
\v 54 \w E|strong="G2532"\w*, \w quando saíram|strong="G1831,G846"\w* \w do barco|strong="G1537,G3588,G4143"\w*, \w logo|strong="G2112"\w* \w o reconheceram|strong="G1921,G846"\w*\x - \xo 6:54 \xt MAT 4:22; JHN 6:21; MRK 5:30; ACT 10:38; MAT 14:34; MRK 6:33\x*
\v 55 \w correram por|strong="G4063"\w* \w toda aquela região|strong="G3650,G3588,G5561,G1565"\w* \w e|strong="G2532"\w* \w começaram a|strong="G757"\w* \w carregar|strong="G4064"\w* \w os doentes|strong="G3588,G2560,G2192"\w* \w em esteiras|strong="G1909,G3588,G2895"\w*, \w para onde|strong="G3699"\w* \w ouviam dizer|strong="G191"\w* \w que|strong="G3754"\w* \w ele estava|strong="G1510"\w*.\x - \xo 6:55 \xt ACT 10:38; MAT 14:34; MRK 6:33; MAT 4:24; ACT 28:9; MRK 2:1-3\x*
\v 56 \w E|strong="G2532"\w* \w onde quer que|strong="G3699,G302"\w* \w ele entrasse|strong="G1531"\w*, \w em povoados|strong="G1519,G2968"\w* \w ou em cidades|strong="G2228,G1519,G4172"\w* \w ou em campos|strong="G2228,G1519,G68"\w*, \w nas praças|strong="G1722,G3588,G58"\w* \w punham|strong="G5087"\w* \w os enfermos|strong="G3588,G770"\w*, \w e|strong="G2532"\w* \w lhe pediam|strong="G3870,G846"\w* \w que ao menos|strong="G2443,G1437,G2532"\w* \w tocassem|strong="G681"\w* \w a borda|strong="G3588,G2899"\w* \w do manto|strong="G3588,G2440"\w* \w dele|strong="G846"\w*; \w e|strong="G2532"\w* \w todos os que|strong="G3745,G302"\w* \w o tocavam|strong="G681,G846"\w* \w ficavam curados|strong="G4982"\w*.\x - \xo 6:56 \xt MAT 9:20; LUK 8:44; MAT 9:35; LUK 6:19; ACT 10:38; MRK 3:10\x*
\c 7
\p
\v 1 \w E|strong="G2532"\w* \w se reuniram|strong="G4863"\w* \w junto dele|strong="G4314,G846"\w* \w os fariseus|strong="G3588,G5330"\w* \w e|strong="G2532"\w* \w alguns|strong="G5100"\w* \w dos escribas|strong="G3588,G1122"\w*, \w que tinham vindo|strong="G2064"\w* \w de Jerusalém|strong="G575,G2414"\w*.\x - \xo 7:1 \xt MAT 15:1; MAT 22:41; MRK 3:22; DEU 4:2; LUK 5:17; MRK 8:11\x*
\v 2 \w E|strong="G2532"\w* \w viram|strong="G1492"\w*\f + \fr 7.2: \ft Lit.: ἰδόντες é particípio ("vendo"); o grego só retoma o verbo principal no v. 5; aqui foi traduzido por verbo finito para tornar a frase legível\f* \w que|strong="G3754"\w* \w alguns|strong="G5100"\w* \w dos seus discípulos|strong="G3588,G3101,G846"\w* \w comiam|strong="G2068"\w* \w o pão|strong="G3588,G740"\w* \w com mãos impuras|strong="G2839,G5495"\w*\f + \fr 7.2: \ft Lit.: κοιναῖς, literalmente "comuns"; no mundo judaico, "profano" e, por isso, ritualmente impuro; o verbo κοινόω, usado nos vv. 15 a 23, tem a mesma raiz\f*, \w isto é|strong="G3778,G1510"\w*, \w não lavadas|strong="G449"\w*—\f + \fr 7.2: \ft Variante: TR e Byz acrescentam "criticaram" (ἐμέμψαντο) no fim do verso, o que completa a frase; RP também traz "comendo" (ἐσθίοντας), no particípio, em lugar de "comiam"\f*\x - \xo 7:2 \xt MAT 15:20; ISA 29:13; DEU 4:2; MAT 15:2; JHN 2:6; JHN 3:25\x*
\v 3 \w Pois|strong="G1063"\w* \w os fariseus|strong="G3588,G5330"\w* \w e|strong="G2532"\w* \w todos os judeus|strong="G3956,G3588,G2453"\w*, \w se não lavarem|strong="G1437,G3361,G3538"\w* \w as mãos|strong="G3588,G5495"\w* \w com o punho|strong="G4435"\w*\f + \fr 7.3: \ft Lit.: πυγμῇ, literalmente "com o punho"; o sentido exato do gesto é incerto\f*, \w não comem|strong="G3756,G2068"\w*, \w apegados|strong="G2902"\w* \w à tradição|strong="G3588,G3862"\w* \w dos anciãos|strong="G3588,G4245"\w*\f + \fr 7.3: \ft Lit.: πρεσβύτεροι, literalmente "mais velhos"; aqui, as autoridades das gerações anteriores\f*;\f + \fr 7.3: \ft Tradução: κρατοῦντες (κρατέω, G2902) está aqui como “apegados”; o termo pode ser “segurar”, “prender”, “agarrar”, “reter” ou “dominar”, e o contexto decide.\f*\x - \xo 7:3 \xt MAT 15:2; MRK 7:5; MRK 7:8; ISA 29:13; DEU 4:2; COL 2:8\x*
\v 4 \w e|strong="G2532"\w* \w vindos do mercado|strong="G575,G58"\w*, \w se não se lavarem|strong="G1437,G3361,G907"\w*\f + \fr 7.4: \ft Lit.: βαπτίζω significa, em geral, "mergulhar"; aqui, na voz média (βαπτίσωνται), o sentido é "lavar-se ritualmente"; é a mesma raiz de "batismo" e de "lavagens" (βαπτισμούς) mais adiante\f*\f + \fr 7.4: \ft Variante: WH traz "aspergirem" (ῥαντίσωνται) em lugar de "se lavarem" (βαπτίσωνται)\f*, \w não comem|strong="G3756,G2068"\w*; \w e|strong="G2532"\w* \w há muitas outras coisas|strong="G243,G4183,G1510"\w* \w que receberam|strong="G3739,G3880"\w* \w para observar|strong="G2902"\w*: \w lavagens|strong="G909"\w* \w de copos|strong="G4221"\w*, \w jarros|strong="G3582"\w*, \w vasos de bronze|strong="G5473"\w* \w e camas|strong="G2532,G2825"\w*—\f + \fr 7.4: \ft Variante: WH omite "e camas" (καὶ κλινῶν) no fim da lista\f*\f + \fr 7.4: \ft Tradução: κρατεῖν (κρατέω, G2902) está aqui como “para observar”; o termo pode ser “segurar”, “prender”, “agarrar”, “reter” ou “dominar”, e o contexto decide.\f*\x - \xo 7:4 \xt ISA 29:13; DEU 4:2; COL 2:8; MRK 7:8; JHN 2:6; HEB 9:10\x*
\v 5 \w E|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w* \w e|strong="G2532"\w* \w os escribas|strong="G3588,G1122"\w* \w lhe perguntaram|strong="G1905,G846"\w*: “\w Por que|strong="G1223,G5101"\w* \w os seus discípulos|strong="G3588,G3101,G4771"\w* \w não vivem|strong="G3756,G4043"\w* \w de acordo com|strong="G2596"\w* \w a tradição|strong="G3588,G3862"\w* \w dos anciãos|strong="G3588,G4245"\w*, \w mas|strong="G235"\w* \w comem|strong="G2068"\w* \w o pão|strong="G3588,G740"\w* \w com mãos impuras|strong="G2839,G5495"\w*?”\f + \fr 7.5: \ft Variante: RP traz "Depois" (Ἔπειτα) em lugar de "E" (καί) no começo e "não lavadas" (ἀνίπτοις) em lugar de "impuras" (κοιναῖς); a ordem de "os seus discípulos não vivem" também muda\f*\x - \xo 7:5 \xt MRK 7:3; MAT 15:2; MRK 2:16; ISA 29:13; DEU 4:2; COL 2:8\x*
\v 6 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Bem|strong="G2573"\w* \w profetizou|strong="G4395"\w* \w Isaías|strong="G2268"\w* \w a respeito|strong="G4012"\w* \w de vocês|strong="G4771"\w*, \w hipócritas|strong="G3588,G5273"\w*, \w como está escrito|strong="G5613,G1125"\w*: ‘\w Este povo|strong="G3778,G3588,G2992"\w* \w me honra|strong="G3165,G5091"\w* \w com os lábios|strong="G3588,G5491"\w*, \w mas|strong="G1161"\w* \w o coração|strong="G3588,G2588"\w* \w deles|strong="G846"\w* \w está longe|strong="G4206,G568"\w* \w de mim|strong="G575,G1473"\w*;\x - \xo 7:6 \xt MAT 15:7; 2TI 3:5; EZK 33:31; ISA 29:13; TIT 1:16; MAT 23:13-15\x*
\v 7 \w em vão|strong="G3155"\w* \w me adoram|strong="G4576,G3165"\w*, \w ensinando|strong="G1321"\w* \w como doutrinas|strong="G1319"\w* \w preceitos|strong="G1778"\w* \w de seres humanos|strong="G444"\w*.’\f + \fr 7.7: \ft Nota cultural: citação de Isaías 29:13, na forma da Septuaginta (a tradução grega); o texto hebraico tem uma redação um pouco diferente na segunda parte\f*\x - \xo 7:7 \xt ISA 29:13; MAT 15:9; COL 2:22; ACT 5:29; JAS 1:26; MAT 6:7\x*
\v 8 \w Abandonando|strong="G863"\w* \w o mandamento|strong="G3588,G1785"\w* \w de Deus|strong="G3588,G2316"\w*, \w vocês se apegam|strong="G2902"\w* \w à tradição|strong="G3588,G3862"\w* \w dos seres humanos|strong="G3588,G444"\w*.”\f + \fr 7.8: \ft Variante: Tregelles, TR e Byz acrescentam no fim "lavagens de jarros e de copos, e muitas outras coisas semelhantes vocês fazem" (βαπτισμοὺς ξεστῶν καὶ ποτηρίων καὶ ἄλλα παρόμοια τοιαῦτα πολλὰ ποιεῖτε); RP também começa o verso com "Pois" (γάρ)\f*\f + \fr 7.8: \ft Tradução: ἀφέντες (ἀφίημι, G863) está aqui como “Abandonando”; o termo pode ser “deixar”, “perdoar”, “permitir”, “abandonar” ou “mandar embora”, e o contexto decide; κρατεῖτε (κρατέω, G2902) está aqui como “vocês se apegam”; o termo pode ser “segurar”, “prender”, “agarrar”, “reter” ou “dominar”, e o contexto decide.\f*\x - \xo 7:8 \xt MAT 15:3; MRK 7:3; ISA 29:13; ACT 5:29; ISA 8:20; DEU 4:2\x*
\v 9 \w E|strong="G2532"\w* \w lhes dizia|strong="G3004,G846"\w*: “\w Vocês rejeitam muito bem|strong="G2573,G114"\w*\f + \fr 7.9: \ft Lit.: Καλῶς, literalmente "bem"; aqui em tom de ironia\f* \w o mandamento|strong="G3588,G1785"\w* \w de Deus|strong="G3588,G2316"\w*, \w para que|strong="G2443"\w* \w guardem|strong="G5083"\w* \w a tradição|strong="G3588,G3862"\w* \w de vocês|strong="G4771"\w*!\f + \fr 7.9: \ft Variante: NA27, NA28 e WH (na margem) trazem "estabeleçam" (στήσητε) em lugar de "guardem" (τηρήσητε)\f*\x - \xo 7:9 \xt MAT 15:3; ISA 29:13; ACT 5:29; MRK 7:13; ISA 8:20; DEU 4:2\x*
\v 10 \w Pois|strong="G1063"\w* \w Moisés|strong="G3475"\w* \w disse|strong="G2036"\w*: ‘\w Honre|strong="G5091"\w* \w o seu pai|strong="G3588,G3962,G4771"\w* \w e|strong="G2532"\w* \w a sua mãe|strong="G3588,G3384,G4771"\w*’, \w e|strong="G2532"\w*: ‘\w Quem falar mal|strong="G3588,G2551"\w* \w do pai|strong="G3962"\w* \w ou da mãe|strong="G2228,G3384"\w*, \w que certamente morra|strong="G2288,G5053"\w*.’\f + \fr 7.10: \ft Nota cultural: citações de Êxodo 20:12 e Êxodo 21:17 (também Levítico 20:9)\f*\f + \fr 7.10: \ft Lit.: θανάτῳ τελευτάτω, literalmente "que termine em morte"; repete uma construção hebraica de ênfase e não diz quem executa a pena\f*\x - \xo 7:10 \xt EXO 20:12; EXO 21:17; LEV 20:9; MAT 15:4; EPH 6:2; ISA 29:13\x*
\v 11 \w Vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w dizem|strong="G3004"\w*: \w se alguém|strong="G1437,G444"\w* \w disser|strong="G2036"\w* \w ao pai|strong="G3588,G3962"\w* \w ou à mãe|strong="G2228,G3588,G3384"\w*: \add ‘É\add* \w Corbã|strong="G2878"\w*\f + \fr 7.11: \ft Nota cultural: Corbã, do hebraico e aramaico qorban, "oferta": o que se declarava dedicado a Deus\f* (\w isto é|strong="G3739,G1510"\w*, \w Oferta|strong="G1435"\w*) \w tudo o que|strong="G3739,G1437"\w* \w de mim|strong="G1537,G1473"\w* \w você receberia como ajuda|strong="G5623"\w*’,\f + \fr 7.11: \ft Acréscimo: “É” (em “à mãe É Corbã isto”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\f + \fr 7.11: \ft Tradução: ἄνθρωπος (ἄνθρωπος, G444) está aqui como “se alguém”; o termo pode ser “ser humano”, “homem”, “pessoa”, “alguém” ou “gente”, e o contexto decide.\f*\x - \xo 7:11 \xt MAT 15:5; ISA 29:13; DEU 4:2; EPH 6:2; COL 2:8; 1TI 5:4\x*
\v 12 \add vocês\add* \w já não|strong="G2089,G3756"\w* \w o deixam|strong="G863,G846"\w* \w fazer nada|strong="G3762,G4160"\w* \w pelo pai|strong="G3588,G3962"\w* \w ou pela mãe|strong="G2228,G3588,G3384"\w*,\f + \fr 7.12: \ft Acréscimo: “vocês” (em “vocês já não”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 7:12 \xt ISA 29:13; DEU 4:2; MAT 15:5; EPH 6:2; COL 2:8; 1TI 5:4\x*
\v 13 \w anulando|strong="G208"\w* \w a palavra de Deus|strong="G3588,G3056,G2316"\w* \w com a tradição|strong="G3588,G3862"\w* \w de vocês|strong="G4771"\w*, \w a qual transmitiram|strong="G3739,G3860"\w*; \w e|strong="G2532"\w* \w vocês fazem|strong="G4160"\w* \w muitas coisas|strong="G4183"\w* \w semelhantes a essas|strong="G3946,G5108"\w*.”\x - \xo 7:13 \xt MAT 15:6; ISA 29:13; MRK 7:9; DEU 4:2; MAT 15:5; EPH 6:2\x*
\v 14 \w E|strong="G2532"\w*, \w chamando de novo|strong="G4341,G3825"\w* \w a multidão|strong="G3588,G3793"\w*, \w lhes dizia|strong="G3004,G846"\w*: “\w Ouçam-me|strong="G191,G3165"\w*, \w todos vocês|strong="G3956"\w*, \w e|strong="G2532"\w* \w entendam|strong="G4920"\w*.\f + \fr 7.14: \ft Variante: RP traz "toda" (πάντα) a multidão em lugar de "de novo" (πάλιν), e formas verbais diferentes em "ouçam" e "entendam"\f*\x - \xo 7:14 \xt MAT 15:10; MRK 8:1; MRK 8:34; 1TH 5:21; ISA 55:2; MRK 4:9\x*
\v 15 \w Nada|strong="G3762"\w* \w existe|strong="G1510"\w* \w fora|strong="G1855"\w* \w do ser humano|strong="G3588,G444"\w* \w que|strong="G3739"\w*, \w entrando|strong="G1531"\w* \w nele|strong="G1519,G846"\w*, \w possa|strong="G1410"\w* \w torná-lo impuro|strong="G2840,G846"\w*; \w mas|strong="G235"\w* \w as coisas|strong="G3588"\w* \w que saem|strong="G1607"\w* \w do ser humano|strong="G1537,G3588,G444"\w* \w são as que|strong="G1510,G3588"\w* \w tornam impuro|strong="G2840"\w* \w o ser humano|strong="G3588,G444"\w*.”\f + \fr 7.15: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam aqui o v. 16: "Se alguém tem ouvidos para ouvir, ouça" (εἴ τις ἔχει ὦτα ἀκούειν ἀκουέτω); o SBLGNT, WH e NA28 não o trazem, por isso a numeração passa do v. 15 ao v. 17\f*\x - \xo 7:15 \xt MAT 15:11; MRK 7:20; MRK 7:18; MRK 7:23; JAS 3:6; PRO 4:23\x*
\v 17 \w E|strong="G2532"\w*, \w quando entrou|strong="G3753,G1525"\w* \w em casa|strong="G1519,G3624"\w*, \w longe da multidão|strong="G575,G3588,G3793"\w*, \w os seus discípulos|strong="G3588,G3101,G846"\w* \w lhe perguntavam|strong="G1905,G846"\w* \w sobre a parábola|strong="G3588,G3850"\w*.\f + \fr 7.17: \ft Lit.: παραβολή, "parábola"; aqui, o dito do v. 15\f*\x - \xo 7:17 \xt LUK 8:9; MRK 9:28; LUK 3:10; MRK 4:10; LUK 8:4; MAT 15:15\x*
\v 18 \w E|strong="G2532"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Vocês também|strong="G2532,G4771"\w* \w são assim|strong="G3779,G1510"\w*, \w sem entendimento|strong="G801"\w*? \w Não percebem|strong="G3756,G3539"\w* \w que|strong="G3754"\w* \w tudo o que|strong="G3956,G3588"\w* \w de fora|strong="G1855"\w* \w entra|strong="G1531"\w* \w no ser humano|strong="G1519,G3588,G444"\w* \w não pode|strong="G3756,G1410"\w* \w torná-lo impuro|strong="G846,G2840"\w*,\x - \xo 7:18 \xt MRK 7:15; MAT 15:16; COL 2:22; HEB 5:11; LUK 24:25; ISA 28:9-10\x*
\v 19 \w porque não entra|strong="G3754,G3756,G1531"\w* \w no coração|strong="G1519,G3588,G2588"\w* \w dele|strong="G846"\w*, \w mas|strong="G235"\w* \w no ventre|strong="G1519,G3588,G2836"\w*, \w e|strong="G2532"\w* \w sai|strong="G1607"\w* \w para a latrina|strong="G1519,G3588,G856"\w*?” — \w declarando puros|strong="G2511"\w* \w todos os alimentos|strong="G3956,G3588,G1033"\w*.\f + \fr 7.19: \ft Lit.: καθαρίζων, literalmente "purificando, tornando limpo"; o particípio está no masculino, e a leitura que o refere a Jesus, como comentário do narrador, é uma interpretação, não algo que a forma sozinha determine\f*\f + \fr 7.19: \ft Variante: RP traz καθαρίζον, no neutro, em lugar de καθαρίζων, no masculino. A mudança altera a leitura: com o neutro, a expressão passa a descrever a eliminação dos alimentos ("limpando" ou "eliminando" todos os alimentos); com o masculino, é lida como comentário sobre Jesus ("declarando puros todos os alimentos"). O texto segue o SBLGNT\f*\x - \xo 7:19 \xt MAT 15:17; 1CO 6:13; MRK 7:15; ACT 10:15; COL 2:22; ACT 11:9\x*
\v 20 \w E|strong="G1161"\w* \w dizia|strong="G3004"\w*: “\w O que sai|strong="G3588,G1607"\w* \w do ser humano|strong="G1537,G3588,G444"\w*, \w isso|strong="G1565"\w* \w torna impuro|strong="G2840"\w* \w o ser humano|strong="G3588,G444"\w*.\x - \xo 7:20 \xt MRK 7:15; MAT 15:11; MAT 15:18; MRK 7:23; JAS 3:6; JAS 1:14-15\x*
\v 21 \w Pois|strong="G1063"\w* \w de dentro|strong="G2081"\w*, \w do coração|strong="G1537,G3588,G2588"\w* \w dos seres humanos|strong="G3588,G444"\w*, \w saem|strong="G1607"\w* \w os pensamentos|strong="G3588,G1261"\w* \w maus|strong="G3588,G2556"\w*: \w imoralidades sexuais|strong="G4202"\w*, \w furtos|strong="G2829"\w*, \w assassinatos|strong="G5408"\w*,\x - \xo 7:21 \xt MAT 15:19; JER 17:9; PRO 4:23; JAS 1:14; GEN 6:5; GAL 5:19\x*
\v 22 \w adultérios|strong="G3430"\w*, \w cobiças|strong="G4124"\w*, \w maldades|strong="G4189"\w*, \w engano|strong="G1388"\w*, \w libertinagem|strong="G766"\w*, \w olho mau|strong="G3788,G4190"\w*\f + \fr 7.22: \ft Lit.: ὀφθαλμὸς πονηρός, literalmente "olho mau"; expressão que designa inveja ou mesquinhez\f*, \w blasfêmia|strong="G988"\w*, \w arrogância|strong="G5243"\w*, \w insensatez|strong="G877"\w*.\x - \xo 7:22 \xt JER 17:9; PRO 4:23; MAT 15:19; JAS 1:14; GEN 6:5; GAL 5:19\x*
\v 23 \w Todas estas|strong="G3956,G3778"\w* \w coisas más|strong="G3588,G4190"\w* \w saem|strong="G1607"\w* \w de dentro|strong="G2081"\w* \w e|strong="G2532"\w* \w tornam impuro|strong="G2840"\w* \w o ser humano|strong="G3588,G444"\w*.”\x - \xo 7:23 \xt PRO 4:23; MRK 7:20; MRK 7:15; MAT 15:11; MAT 15:18; GEN 6:5\x*
\p
\v 24 \w E|strong="G1161"\w*, \w levantando-se|strong="G450"\w* \w dali|strong="G1564"\w*, \w foi|strong="G565"\w* \w para a região|strong="G1519,G3588,G3725"\w* \w de Tiro|strong="G5184"\w*.\f + \fr 7.24: \ft Variante: Tyndale, WH, Tregelles, TR e Byz acrescentam "e Sidom" (καὶ Σιδῶνος) depois de "Tiro"; RP também começa com "E dali" (Καὶ ἐκεῖθεν) e traz "fronteiras" (μεθόρια) em lugar de "região" (ὅρια)\f* \w E|strong="G2532"\w*, \w tendo entrado|strong="G1525"\w* \w numa casa|strong="G1519,G3614"\w*, \w queria|strong="G2309"\w* \w que ninguém|strong="G3762"\w* \w soubesse|strong="G1097"\w*, \w mas|strong="G2532"\w* \w não pôde|strong="G3756,G1410"\w* \w passar despercebido|strong="G2990"\w*.\x - \xo 7:24 \xt MAT 15:21; MAT 11:21; EZK 28:2; MRK 6:31-32; MRK 3:7-8; 1TI 5:25\x*
\v 25 \w Mas|strong="G235"\w* \w logo|strong="G2112"\w*, \w uma mulher|strong="G1135"\w*, \w cuja|strong="G3739"\w* \w filhinha|strong="G3588,G2365,G846"\w* \w tinha|strong="G2192"\w* \w um espírito impuro|strong="G4151,G169"\w*, \w ao ouvir falar|strong="G191"\w* \w dele|strong="G4012,G846"\w*, \w veio e se prostrou|strong="G2064,G4363"\w* \w aos pés|strong="G4314,G3588,G4228"\w* \w dele|strong="G846"\w*.\f + \fr 7.25: \ft Variante: RP traz "Pois" (γάρ) em lugar de "Mas logo" (ἀλλʼ εὐθύς)\f*\x - \xo 7:25 \xt MRK 5:33; MAT 15:21; MAT 15:22; ACT 10:25-26; MRK 1:40; MRK 5:22-23\x*
\v 26 \w E|strong="G1161"\w* \w a mulher|strong="G3588,G1135"\w* \w era|strong="G1510"\w* \w grega|strong="G1674"\w*\f + \fr 7.26: \ft Nota cultural: Ἑλληνίς indica pessoa de cultura e língua gregas, não judia; Συροφοινίκισσα, "siro-fenícia", é a fenícia da província da Síria, na região de Tiro\f*, \w siro-fenícia|strong="G4949"\w* \w de origem|strong="G3588,G1085"\w*; \w e|strong="G2532"\w* \w lhe pedia|strong="G2065,G846"\w* \w que expulsasse|strong="G2443,G1544"\w* \w o demônio|strong="G3588,G1140"\w* \w da filha dela|strong="G1537,G3588,G2364,G846"\w*.\x - \xo 7:26 \xt MAT 15:21; MAT 15:22; LUK 4:25; MRK 10:48; COL 3:11; GAL 3:28\x*
\v 27 \w E|strong="G2532"\w* \w lhe dizia|strong="G3004,G846"\w*: “\w Deixe primeiro|strong="G863,G4413"\w* \w que os filhos|strong="G3588,G5043"\w* \w se saciem|strong="G5526"\w*, \w pois|strong="G1063"\w* \w não é bom|strong="G3756,G2570,G1510"\w* \w tomar|strong="G2983"\w* \w o pão|strong="G3588,G740"\w* \w dos filhos|strong="G3588,G5043"\w* \w e|strong="G2532"\w* \w jogá-lo|strong="G906"\w* \w aos cachorrinhos|strong="G3588,G2952"\w*.”\f + \fr 7.27: \ft Lit.: κυνάρια, "cachorrinhos", diminutivo de κύων, "cão"; o termo designa em geral cães de casa\f*\x - \xo 7:27 \xt MAT 15:26; MAT 15:21; MAT 15:23-28; LUK 15:31; MAT 7:6; ACT 22:21\x*
\v 28 \w Mas|strong="G1161"\w* \w ela|strong="G3588"\w* \w respondeu|strong="G611"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Senhor|strong="G2962"\w*, \w também|strong="G2532"\w* \w os cachorrinhos|strong="G3588,G2952"\w*, \w debaixo da mesa|strong="G5270,G3588,G5132"\w*, \w comem|strong="G2068"\w* \w das migalhas|strong="G575,G3588,G5589"\w* \w das crianças|strong="G3588,G3813"\w*.”\f + \fr 7.28: \ft Variante: Tyndale, WH, Tregelles, TR e Byz trazem "Sim, Senhor" (ναί, κύριε) em lugar de apenas "Senhor"; RP também acrescenta "pois" (γάρ) depois de "também"\f*\x - \xo 7:28 \xt MAT 15:27; MAT 15:26; MAT 15:21; ROM 10:12; ROM 3:29; LUK 15:31\x*
\v 29 \w E|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Por causa|strong="G1223"\w* \w dessa palavra|strong="G3778,G3588,G3056"\w*, \w vá|strong="G5217"\w*; \w o demônio|strong="G3588,G1140"\w* \w saiu|strong="G1831"\w* \w da sua filha|strong="G1537,G3588,G2364,G4771"\w*.”\f + \fr 7.29: \ft Lit.: λόγος, "palavra"; aqui, o que a mulher acabou de dizer\f*\x - \xo 7:29 \xt JHN 13:3; MAT 15:21; ACT 10:38; MAT 15:28; JHN 4:50; LUK 4:25\x*
\v 30 \w E|strong="G2532"\w*, \w indo|strong="G565"\w* \w para a sua casa|strong="G1519,G3588,G3624,G846"\w*, \w encontrou|strong="G2147"\w* \w a criança|strong="G3588,G3813"\w* \w deitada|strong="G906"\w* \w na cama|strong="G1909,G3588,G2825"\w* \w e|strong="G2532"\w* \w o demônio|strong="G3588,G1140"\w* \w já saído|strong="G1831"\w*.\f + \fr 7.30: \ft Variante: RP inverte a ordem e traz "encontrou o demônio já saído e a filha (θυγατέρα) deitada na cama" em lugar de "a criança deitada na cama e o demônio já saído"\f*\x - \xo 7:30 \xt MAT 15:21; ACT 10:38; MAT 15:28; JHN 4:50\x*
\p
\v 31 \w E|strong="G2532"\w*, \w saindo de novo|strong="G3825,G1831"\w* \w da região|strong="G1537,G3588,G3725"\w* \w de Tiro|strong="G5184"\w*, \w foi|strong="G2064"\w* \w por Sidom|strong="G1223,G4605"\w* \w até o mar|strong="G1519,G3588,G2281"\w* \w da Galileia|strong="G3588,G1056"\w*, \w pelo meio|strong="G303,G3319"\w* \w do território|strong="G3588,G3725"\w* \w da Decápolis|strong="G1179"\w*.\f + \fr 7.31: \ft Nota cultural: o percurso descrito (de Tiro, por Sidom, ao mar da Galileia, pelo meio da Decápolis) é longo e indireto; o texto não o comenta\f*\f + \fr 7.31: \ft Variante: RP traz "saindo da região de Tiro e de Sidom, foi ao mar da Galileia" (καὶ Σιδῶνος ἦλθεν πρὸς), de modo que Sidom deixa de ser lugar de passagem\f*\x - \xo 7:31 \xt MAT 4:25; MRK 5:20; MAT 15:29; MRK 7:24; MAT 4:18; MAT 11:21\x*
\v 32 \w E|strong="G2532"\w* \w lhe trouxeram|strong="G5342,G846"\w* \w um surdo|strong="G2974"\w* \w e|strong="G2532"\w* \w com dificuldade de fala|strong="G3424"\w*\f + \fr 7.32: \ft Lit.: μογιλάλος aparece só aqui no Novo Testamento; significa "que fala com dificuldade" ou "mudo" (assim a Septuaginta de Isaías 35:6); o v. 35 diz que depois ele falava corretamente\f*, \w e|strong="G2532"\w* \w lhe pediram|strong="G3870,G846"\w* \w que pusesse|strong="G2443,G2007"\w* \w a mão|strong="G3588,G5495"\w* \w sobre ele|strong="G846"\w*.\x - \xo 7:32 \xt ISA 35:6; MRK 5:23; ISA 35:5; LUK 11:14; LUK 1:64; MAT 9:32-33\x*
\v 33 \w E|strong="G2532"\w*, \w tomando-o à parte|strong="G618,G846,G2596,G2398"\w*, \w longe da multidão|strong="G575,G3588,G3793"\w*, \w pôs|strong="G906"\w* \w os seus dedos|strong="G3588,G1147,G846"\w* \w nos ouvidos dele|strong="G1519,G3588,G3775,G846"\w* \w e|strong="G2532"\w*, \w cuspindo|strong="G4429"\w*, \w tocou|strong="G681"\w* \w a língua dele|strong="G3588,G1100,G846"\w*.\x - \xo 7:33 \xt ISA 35:5; MRK 8:23; JHN 9:6; MRK 5:40; MAT 20:34; 1KI 17:19-22\x*
\v 34 \w E|strong="G2532"\w*, \w olhando para o céu|strong="G308,G1519,G3588,G3772"\w*, \w suspirou|strong="G4727"\w*, \w e|strong="G2532"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Efatá|strong="G2188"\w*\f + \fr 7.34: \ft Nota cultural: Efatá é a transliteração de uma palavra aramaica, a língua falada por Jesus\f*”, \w que significa|strong="G3739,G1510"\w*: “\w Abra-se|strong="G1272"\w*”.\x - \xo 7:34 \xt ISA 35:5; JHN 11:41; MRK 6:41; MRK 8:12; MRK 5:41; ACT 9:34\x*
\v 35 \w E|strong="G2532"\w* \w foram abertos|strong="G455"\w* \w os seus ouvidos|strong="G846,G3588,G189"\w*, \w e|strong="G2532"\w* \w foi desatada|strong="G3089"\w* \w a amarra|strong="G3588,G1199"\w* \w da sua língua|strong="G3588,G1100,G846"\w*, \w e|strong="G2532"\w* \w falava|strong="G2980"\w* \w corretamente|strong="G3723"\w*.\f + \fr 7.35: \ft Variante: NA27, NA28, TR e Byz acrescentam "logo" (εὐθέως) depois de "E"; RP também traz outra forma verbal para "foram abertos" (διηνοίχθησαν)\f*\x - \xo 7:35 \xt ISA 35:5; MAT 12:22; LUK 1:64; ISA 32:3-4; ISA 42:18; MRK 2:12\x*
\v 36 \w E|strong="G2532"\w* \w lhes ordenou|strong="G1291,G846"\w* \w que a ninguém|strong="G2443,G3367"\w* \w dissessem|strong="G3004"\w*; \w mas|strong="G1161"\w* \w quanto mais|strong="G3745"\w* \w ele lhes ordenava|strong="G846,G1291"\w*, \w tanto mais|strong="G3123,G4054"\w* \w eles|strong="G846"\w* \w proclamavam|strong="G2784"\w*.\x - \xo 7:36 \xt MRK 5:43; MAT 16:20; ISA 35:5; MAT 8:4; MAT 12:22; LUK 1:64\x*
\v 37 \w E|strong="G2532"\w* \w ficavam extremamente admirados|strong="G5249,G1605"\w*, \w dizendo|strong="G3004"\w*: “\w Ele tem feito bem|strong="G2573,G4160"\w* \w todas as coisas|strong="G3956"\w*: \w até|strong="G2532"\w* \w os surdos|strong="G3588,G2974"\w* \w ele faz|strong="G4160"\w* \w ouvir|strong="G191"\w* \w e|strong="G2532"\w* \w os mudos|strong="G216"\w* \w falar|strong="G2980"\w*.”\x - \xo 7:37 \xt ECC 3:11; ISA 35:5; MRK 6:51; MAT 8:27; EXO 4:10-11; MRK 4:41\x*
\c 8
\p
\v 1 \w Naqueles dias|strong="G1722,G1565,G3588,G2250"\w*, \w de novo|strong="G3825"\w* \w havendo|strong="G1510"\w* \w uma grande multidão|strong="G4183,G3793"\w* \w e|strong="G2532"\w* \w sem ter|strong="G3361,G2192"\w* \w o que comer|strong="G5101,G5315"\w*, \w chamou|strong="G4341"\w* \w os discípulos|strong="G3588,G3101"\w* \add e\add* \w lhes disse|strong="G3004,G846"\w*:\f + \fr 8.1: \ft Variante: RP traz "muito grande" (παμπόλλου) em lugar de "de novo… grande" (πάλιν πολλοῦ), e acrescenta "Jesus" (ὁ Ἰησοῦς) depois de "chamou" e "seus" (αὐτοῦ) antes de "discípulos"\f*\f + \fr 8.1: \ft Acréscimo: “e” (em “os discípulos e lhes disse”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 8:1 \xt MRK 7:14; MAT 15:32; MAT 15:10; MRK 6:34-44; MRK 8:20; MAT 14:14\x*
\v 2 “\w Tenho compaixão|strong="G4697"\w* \w da multidão|strong="G1909,G3588,G3793"\w*, \w porque|strong="G3754"\w* \w já faz|strong="G2235"\w* \w três dias|strong="G2250,G5140"\w* \w que permanecem|strong="G4357"\w* \w comigo|strong="G3165"\w* \w e|strong="G2532"\w* \w não têm|strong="G3756,G2192"\w* \w o que comer|strong="G5101,G5315"\w*;\x - \xo 8:2 \xt MAT 15:32; MAT 14:14; MRK 6:34; MAT 9:36; MIC 7:19; PSA 103:13\x*
\v 3 \w e|strong="G2532"\w*, \w se eu os despedir|strong="G1437,G630,G846"\w* \w em jejum|strong="G3523"\w* \w para as suas casas|strong="G1519,G3624,G846"\w*, \w desfalecerão|strong="G1590"\w* \w no caminho|strong="G1722,G3588,G3598"\w*; \w e|strong="G2532"\w* \w alguns deles|strong="G5100,G846"\w* \w vieram|strong="G2240"\w* \w de longe|strong="G575,G3113"\w*.”\f + \fr 8.3: \ft Variante: RP traz "pois alguns" (τινὲς γάρ) em lugar de "e alguns" (καί τινες) e omite "de" antes de "longe"; WH traz "são" (εἰσίν) em lugar de "vieram" (ἥκασιν): "alguns deles são de longe"\f*\x - \xo 8:3 \xt MAT 15:32; ISA 40:31; JDG 8:4-6; MRK 6:37; ACT 27:34; MRK 8:20\x*
\v 4 \w E|strong="G2532"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w lhe responderam|strong="G611,G846"\w*: “\w De onde|strong="G4159"\w* \w alguém poderá|strong="G1410,G5100"\w* \w saciar de pão|strong="G5526,G740"\w* \w estas pessoas|strong="G3778"\w* \w aqui|strong="G5602"\w*, \w num lugar deserto|strong="G1909,G2047"\w*?”\x - \xo 8:4 \xt MAT 15:33; MAT 4:4; MRK 6:52; MRK 6:36-37; MRK 8:20; MAT 14:17\x*
\v 5 \w E|strong="G2532"\w* \w lhes perguntava|strong="G2065,G846"\w*: “\w Quantos|strong="G4214"\w* \w pães|strong="G740"\w* \w vocês têm|strong="G2192"\w*?” \w E|strong="G1161"\w* \w eles|strong="G3588"\w* \w disseram|strong="G2036"\w*: “\w Sete|strong="G2033"\w*.”\x - \xo 8:5 \xt MAT 15:34; MAT 16:10; MRK 6:38; MRK 8:20; MAT 4:4; MAT 14:15-17\x*
\v 6 \w E|strong="G2532"\w* \w ordenou|strong="G3853"\w* \w à multidão|strong="G3588,G3793"\w* \w que se recostasse|strong="G377"\w* \w no chão|strong="G1909,G3588,G1093"\w*; \w e|strong="G2532"\w*, \w tomando|strong="G2983"\w* \w os sete pães|strong="G3588,G2033,G740"\w*, \w depois de dar graças|strong="G2168"\w*, \w partiu|strong="G2806"\w* \w e|strong="G2532"\w* \w os dava|strong="G1325"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w* \w para que servissem|strong="G2443,G3908"\w*; \w e|strong="G2532"\w* \w serviram|strong="G3908"\w* \w à multidão|strong="G3588,G3793"\w*.\x - \xo 8:6 \xt MAT 15:35; MAT 15:36; MAT 26:26; MAT 4:4; COL 3:17; JHN 6:10\x*
\v 7 \w E|strong="G2532"\w* \w tinham|strong="G2192"\w* \w uns poucos|strong="G3641"\w* \w peixinhos|strong="G2485"\w*; \w e|strong="G2532"\w*, \w pronunciando a bênção|strong="G2127"\w* \w sobre eles|strong="G846"\w*, \w disse|strong="G2036"\w* \w que também|strong="G2532"\w* \w os servissem|strong="G3778,G3908"\w*.\x - \xo 8:7 \xt MAT 15:34; MAT 4:4; MAT 14:19; PSA 132:15; MRK 6:41; 2KI 4:4\x*
\v 8 \w E|strong="G2532"\w* \w comeram|strong="G5315"\w* \w e|strong="G2532"\w* \w ficaram saciados|strong="G5526"\w*, \w e|strong="G2532"\w* \w recolheram|strong="G142"\w* \w sete|strong="G2033"\w* \w cestas|strong="G4711"\w* \w de pedaços|strong="G2801"\w* \w que sobraram|strong="G4051"\w*.\f + \fr 8.8: \ft Lit.: σπυρίς (aqui e em 8:20) e κόφινος (6:43; 8:19) são tipos diferentes de cesto, e Marcos mantém os dois nomes separados; por isso "cestas" e "cestos"\f*\x - \xo 8:8 \xt MAT 15:37; MRK 8:20; LUK 9:17; MRK 6:42; MAT 14:20; MAT 16:10\x*
\v 9 \w Eram|strong="G1510"\w* \w cerca de|strong="G5613"\w* \w quatro mil|strong="G5070"\w*.\f + \fr 8.9: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam "os que comeram" (οἱ φαγόντες), de modo que se lê "os que comeram eram cerca de quatro mil"\f* \w E|strong="G2532"\w* \w os despediu|strong="G630,G846"\w*.\x - \xo 8:9 \xt MAT 4:4; PSA 132:15; MRK 6:42; 2KI 4:4; LUK 9:17; MRK 8:20\x*
\v 10 \w E|strong="G2532"\w* \w logo|strong="G2112"\w*, \w entrando|strong="G1684"\w* \w no barco|strong="G1519,G3588,G4143"\w* \w com os seus discípulos|strong="G3326,G3588,G3101,G846"\w*, \w foi|strong="G2064"\w* \w para a região|strong="G1519,G3588,G3313"\w* \w de Dalmanuta|strong="G1148"\w*.\f + \fr 8.10: \ft Nota cultural: lugar não identificado com segurança, junto ao mar da Galileia; a passagem paralela em Mateus 15:39 menciona Magadã\f*\x - \xo 8:10 \xt MAT 15:39; MAT 8:23; MRK 5:18; MAT 15:32\x*
\p
\v 11 \w E|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w* \w saíram|strong="G1831"\w* \w e|strong="G2532"\w* \w começaram a|strong="G757"\w* \w discutir com ele|strong="G4802,G846"\w*, \w pedindo-lhe|strong="G2212,G3844,G846"\w* \w um sinal|strong="G4592"\w* \w do céu|strong="G575,G3588,G3772"\w*, \w pondo-o à prova|strong="G3985,G846"\w*.\f + \fr 8.11: \ft Lit.: πειράζω, "tentar" ou "pôr à prova" (como em 1:13)\f*\f + \fr 8.11: \ft Tradução: ζητοῦντες (ζητέω, G2212) está aqui como “pedindo-lhe”; o termo pode ser “procurar”, “buscar”, “tentar” ou “exigir”, e o contexto decide.\f*\x - \xo 8:11 \xt LUK 11:16; MAT 16:1; LUK 11:29; MAT 12:38; 1CO 1:22; 1CO 10:9\x*
\v 12 \w E|strong="G2532"\w*, \w suspirando profundamente|strong="G389"\w* \w em seu espírito|strong="G3588,G4151,G846"\w*, \w disse|strong="G3004"\w*: “\w Por que|strong="G5101"\w* \w esta geração|strong="G3588,G1074,G3778"\w* \w procura|strong="G2212"\w* \w um sinal|strong="G4592"\w*? \w Em verdade|strong="G281"\w* \w digo a vocês|strong="G3004,G4771"\w*: \w não será dado|strong="G1487,G1325"\w* \w a esta geração|strong="G3588,G1074,G3778"\w* \w sinal algum|strong="G4592"\w*.”\f + \fr 8.12: \ft Lit.: εἰ δοθήσεται, literalmente "se for dado"; é uma fórmula de juramento de origem hebraica, que significa "certamente não será dado"\f*\x - \xo 8:12 \xt LUK 11:29; LUK 11:16; MAT 12:39; MAT 16:4; MAT 23:36; EPH 3:21\x*
\v 13 \w E|strong="G2532"\w*, \w deixando-os|strong="G863,G846"\w*, \w entrando de novo|strong="G3825,G1684"\w*, \w foi|strong="G565"\w* \w para o outro lado|strong="G1519,G3588,G4008"\w*.\f + \fr 8.13: \ft Variante: Tyndale, Tregelles, TR e Byz (e RP) acrescentam "no barco" (εἰς πλοῖον) depois de "entrando"\f*\x - \xo 8:13 \xt LUK 8:22; JHN 20:10; ACT 18:6; MRK 4:35; ACT 13:45-46; HOS 4:17\x*
\v 14 \w E|strong="G2532"\w* \w esqueceram-se|strong="G1950"\w* \w de levar|strong="G2983"\w* \w pães|strong="G740"\w*, \w e|strong="G2532"\w* \w não tinham|strong="G3756,G2192"\w* \w consigo|strong="G3326,G1438"\w* \w no barco|strong="G1722,G3588,G4143"\w* \w senão|strong="G1487,G3361"\w* \w um único pão|strong="G1520,G740"\w*.\x - \xo 8:14 \xt MAT 16:5; MAT 16:1\x*
\v 15 \w E|strong="G2532"\w* \w lhes ordenava|strong="G1291,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Vejam|strong="G3708"\w*, \w cuidado com|strong="G991,G575"\w* \w o fermento|strong="G3588,G2219"\w* \w dos fariseus|strong="G3588,G5330"\w* \w e|strong="G2532"\w* \w o fermento|strong="G3588,G2219"\w* \w de Herodes|strong="G2264"\w*.”\f + \fr 8.15: \ft Nota cultural: ζύμη, "fermento"; no uso bíblico, imagem de uma influência que se espalha, em geral negativa\f*\x - \xo 8:15 \xt MAT 16:6; MAT 16:11; 1CO 5:6-8; GAL 5:9; MAT 6:1; MRK 12:13\x*
\v 16 \w E|strong="G2532"\w* \w raciocinavam|strong="G1260"\w* \w entre si|strong="G4314,G240"\w* \w que|strong="G3754"\w* \w não tinham|strong="G3756,G2192"\w* \w pães|strong="G740"\w*.\f + \fr 8.16: \ft Variante: RP traz "dizendo" (λέγοντες) e "não temos pão" (ἔχομεν), na primeira pessoa, em lugar de "que não têm pão" (ἔχουσιν)\f*\x - \xo 8:16 \xt MAT 16:7; MAT 16:8; LUK 12:1; LUK 20:5; LUK 9:46; MAT 16:1\x*
\v 17 \w E|strong="G2532"\w*, \w percebendo isso|strong="G1097"\w*, \w lhes disse|strong="G3004,G846"\w*: “\w Por que|strong="G5101"\w* \w vocês raciocinam|strong="G1260"\w* \w que|strong="G3754"\w* \w não têm|strong="G3756,G2192"\w* \w pães|strong="G740"\w*? \w Ainda não|strong="G3768"\w* \w percebem|strong="G3539"\w* \w nem entendem|strong="G3761,G4920"\w*? \w Têm|strong="G2192"\w* \w o coração de vocês|strong="G3588,G2588,G4771"\w* \w endurecido|strong="G4456"\w*?\f + \fr 8.17: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam "Jesus" (ὁ Ἰησοῦς) depois de "percebendo"; TR e Byz também trazem "ainda" (ἔτι) antes de "endurecido"\f*\x - \xo 8:17 \xt MRK 6:52; MRK 8:21; JHN 12:40; MAT 16:7; MAT 16:8; MRK 2:8\x*
\v 18 \w Tendo olhos|strong="G3788,G2192"\w*, \w não veem|strong="G3756,G991"\w*? \w E|strong="G2532"\w*, \w tendo ouvidos|strong="G3775,G2192"\w*, \w não ouvem|strong="G3756,G191"\w*? \w E|strong="G2532"\w* \w não se lembram|strong="G3756,G3421"\w*\x - \xo 8:18 \xt ROM 11:8; ACT 28:26; EZK 12:2; ISA 42:18-20; ISA 44:18; ISA 6:9-10\x*
\v 19 \w de quando|strong="G3753"\w* \w parti|strong="G2806"\w* \w os cinco pães|strong="G3588,G4002,G740"\w* \w para os cinco mil|strong="G1519,G3588,G4000"\w*: \w quantos cestos|strong="G4214,G2894"\w* \w cheios de pedaços|strong="G4134,G2801"\w* \w vocês recolheram|strong="G142"\w*?” \w Disseram-lhe|strong="G3004,G846"\w*: “\w Doze|strong="G1427"\w*.”\x - \xo 8:19 \xt MAT 14:20; MRK 6:43; LUK 9:17; MAT 16:9; MRK 6:38; MAT 15:37\x*
\v 20 “\w E quando|strong="G3753,G2532"\w* \add parti\add* \w os sete|strong="G3588,G2033"\w* \w para os quatro mil|strong="G1519,G3588,G5070"\w*: \w quantas cestas|strong="G4214,G4711"\w* \w cheias|strong="G4138"\w* \w de pedaços|strong="G2801"\w* \w vocês recolheram|strong="G142"\w*?” \w E|strong="G2532"\w* \w lhe disseram|strong="G3004,G846"\w*: “\w Sete|strong="G2033"\w*.”\f + \fr 8.20: \ft Variante: WH e NA28 omitem o "E" depois de "quando" (καί), e Tregelles e RP trazem "Mas quando" (δέ); no fim, Tregelles e RP trazem "e eles disseram" (οἱ δὲ εἶπον) em lugar de "e lhe disseram" (καὶ λέγουσιν αὐτῷ)\f*\f + \fr 8.20: \ft Acréscimo: “parti” (em “E quando parti os sete”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 8:20 \xt MAT 16:10; MRK 8:8; MAT 15:37; MRK 6:43; MRK 6:52; MAT 15:34-38\x*
\v 21 \w E|strong="G2532"\w* \w lhes dizia|strong="G3004,G846"\w*: “\w Ainda não|strong="G3768"\w* \w entendem|strong="G4920"\w*?”\f + \fr 8.21: \ft Variante: Tyndale, Tregelles, TR e Byz trazem "Como" (πῶς) em lugar de "Ainda não" (οὔπω); RP traz "Como é que não" (πῶς οὐ)\f*\x - \xo 8:21 \xt MRK 8:17; MRK 6:52; PSA 94:8; 1CO 15:34; 1CO 6:5; HEB 5:11\x*
\p
\v 22 \w E|strong="G2532"\w* \w chegaram|strong="G2064"\w* \w a Betsaida|strong="G1519,G966"\w*. \w E|strong="G2532"\w* \w lhe trouxeram|strong="G5342,G846"\w* \w um cego|strong="G5185"\w* \w e|strong="G2532"\w* \w lhe pediram|strong="G3870,G846"\w* \w que o tocasse|strong="G2443,G846,G681"\w*.\f + \fr 8.22: \ft Variante: RP traz o verbo no singular, "ele chegou" (ἔρχεται), em lugar de "chegaram" (ἔρχονται)\f*\x - \xo 8:22 \xt ISA 35:5; MAT 11:21; LUK 10:13; MRK 6:45; MAT 9:27; LUK 15:24\x*
\v 23 \w E|strong="G2532"\w*, \w tomando a mão|strong="G1949,G3588,G5495"\w* \w do cego|strong="G3588,G5185"\w*, \w levou-o|strong="G1627,G846"\w* \w para fora|strong="G1854"\w* \w do povoado|strong="G3588,G2968"\w*; \w e|strong="G2532"\w*, \w cuspindo|strong="G4429"\w* \w nos olhos|strong="G1519,G3588,G3659"\w* \w dele|strong="G846"\w*, \w impondo-lhe|strong="G2007,G846"\w* \w as mãos|strong="G3588,G5495"\w*, \w lhe perguntava|strong="G1905,G846"\w*: “\w Você vê|strong="G991"\w* \w alguma coisa|strong="G1487,G5100"\w*?”\x - \xo 8:23 \xt ISA 35:5; MRK 7:33; JHN 9:6; MAT 9:27; ACT 9:8; MRK 5:23\x*
\v 24 \w E|strong="G2532"\w*, \w olhando para cima|strong="G308"\w*, \w dizia|strong="G3004"\w*: “\w Vejo|strong="G991"\w* \w as pessoas|strong="G3588,G444"\w*, \w pois|strong="G3754"\w* \w as vejo|strong="G3708"\w* \w como árvores|strong="G5613,G1186"\w* \w andando|strong="G4043"\w*.”\f + \fr 8.24: \ft Lit.: ὅτι, literalmente "que" ou "porque"; aqui introduz a explicação do que ele vê: pessoas que parecem árvores caminhando\f*\x - \xo 8:24 \xt ISA 35:5; ISA 29:18; 1CO 13:9-12; ISA 32:3; 2KI 6:6; JHN 3:9\x*
\v 25 \w Depois|strong="G1534"\w* \w pôs de novo|strong="G3825,G2007"\w* \w as mãos|strong="G3588,G5495"\w* \w sobre os olhos|strong="G1909,G3588,G3788"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w ele olhou fixamente|strong="G1227"\w*, \w e|strong="G2532"\w* \w foi restabelecido|strong="G600"\w*, \w e|strong="G2532"\w* \w via|strong="G1689"\w* \w tudo|strong="G537"\w* \w com clareza|strong="G5081"\w*.\f + \fr 8.25: \ft Lit.: τηλαυγῶς aparece só aqui no Novo Testamento; a palavra traz a ideia de "nítido, brilhante, mesmo de longe"\f*\f + \fr 8.25: \ft Variante: TR e Byz (e RP) trazem "fez com que ele olhasse para cima" (ἐποίησεν αὐτὸν ἀναβλέψαι) em lugar de "ele olhou fixamente" (διέβλεψεν); WH e Tregelles trazem ἔθηκεν em lugar de ἐπέθηκεν ("pôs"); RP traz "todos" (ἅπαντας) em lugar de "tudo" (ἅπαντα)\f*\x - \xo 8:25 \xt ISA 35:5; MRK 10:52; PHP 1:6; PRO 4:18; 1PE 2:9; 2PE 3:18\x*
\v 26 \w E|strong="G2532"\w* \w o enviou|strong="G649,G846"\w* \w para a sua casa|strong="G1519,G3624,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Nem sequer|strong="G3366"\w* \w entre|strong="G1525"\w* \w no povoado|strong="G1519,G3588,G2968"\w*.”\f + \fr 8.26: \ft Variante: Tyndale, Tregelles, TR e Byz (e RP) acrescentam no fim "nem diga a ninguém no povoado" (μηδὲ εἴπῃς τινὶ ἐν τῇ κώμῃ)\f*\x - \xo 8:26 \xt MAT 8:4; MRK 5:43; MRK 7:36; MRK 8:23; MAT 12:16; MAT 9:30\x*
\p
\v 27 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w saiu|strong="G1831"\w* \w com os seus discípulos|strong="G2532,G3588,G3101,G846"\w* \w para os povoados|strong="G1519,G3588,G2968"\w* \w de Cesareia|strong="G2542"\w* \w de Filipe|strong="G3588,G5376"\w*\f + \fr 8.27: \ft Nota cultural: Cesareia de Filipe era uma cidade ao norte da Galileia, junto ao monte Hermom, diferente de Cesareia Marítima\f*; \w e|strong="G2532"\w* \w no caminho|strong="G1722,G3588,G3598"\w* \w perguntava|strong="G1905"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w*, \w dizendo-lhes|strong="G3004,G846"\w*: “\w Quem|strong="G5101"\w* \w as pessoas|strong="G3588,G444"\w* \w dizem|strong="G3004"\w* \add que\add* \w eu sou|strong="G3165,G1511"\w*?”\f + \fr 8.27: \ft Acréscimo: “que” (em “pessoas dizem que eu sou”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 8:27 \xt MAT 16:13; LUK 9:18; ACT 8:40\x*
\v 28 \w E|strong="G1161"\w* \w eles|strong="G3588"\w* \w lhe disseram|strong="G2036,G846,G3004"\w*: “\w João|strong="G2491"\w*, \w o Batista|strong="G3588,G910"\w*; \w e|strong="G2532"\w* \w outros|strong="G243"\w*, \w Elias|strong="G2243"\w*; \w mas outros|strong="G243,G1161"\w*, \w um|strong="G1520"\w* \w dos profetas|strong="G3588,G4396"\w*.”\x - \xo 8:28 \xt MAT 16:14; MRK 6:15; LUK 9:19; JHN 1:21; LUK 9:8; MAT 14:2\x*
\v 29 \w E|strong="G2532"\w* \w ele|strong="G846"\w* \w lhes perguntava|strong="G1905,G846"\w*: “\w E vocês|strong="G4771,G1161"\w*, \w quem|strong="G5101"\w* \w dizem|strong="G3004"\w* \add que\add* \w eu sou|strong="G3165,G1511"\w*?” \w Respondendo|strong="G611"\w*, \w Pedro|strong="G3588,G4074"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Você é|strong="G4771,G1510"\w* \w o Cristo|strong="G3588,G5547"\w*.”\f + \fr 8.29: \ft Lit.: χριστός, "ungido"; título que em hebraico é "Messias"\f*\f + \fr 8.29: \ft Acréscimo: “que” (em “quem dizem que eu sou”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 8:29 \xt LUK 9:20; LUK 9:18; LUK 23:9; MAT 16:13; MAT 16:15; 1JN 4:15\x*
\v 30 \w E|strong="G2532"\w* \w os advertiu severamente|strong="G2008,G846"\w* \w para que|strong="G2443"\w* \w a ninguém|strong="G3367"\w* \w falassem|strong="G3004"\w* \w a respeito dele|strong="G4012,G846"\w*.\f + \fr 8.30: \ft Lit.: ἐπιτιμάω, "repreender" ou "advertir com severidade" (como em 3:12)\f*\x - \xo 8:30 \xt LUK 9:21; LUK 18:31; LUK 9:18; MAT 16:20; MAT 17:9; MRK 9:9\x*
\p
\v 31 \w E|strong="G2532"\w* \w começou a|strong="G757"\w* \w ensinar-lhes|strong="G1321,G846"\w* \w que|strong="G3754"\w* \w é necessário|strong="G1163"\w* \w que o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w sofra muito|strong="G4183,G3958"\w* \w e|strong="G2532"\w* \w seja rejeitado|strong="G593"\w* \w pelos anciãos|strong="G5259,G3588,G4245"\w*, \w pelos chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w pelos escribas|strong="G3588,G1122"\w*\f + \fr 8.31: \ft Nota cultural: anciãos, chefes dos sacerdotes e escribas aparecem juntos como grupos de liderança em Marcos 14:43, 14:53 e 15:1; em 14:55 e 15:1 fala-se também do "conselho" (συνέδριον)\f*, \w e|strong="G2532"\w* \w seja morto|strong="G615"\w*, \w e|strong="G2532"\w* \w depois de três dias|strong="G3326,G5140,G2250"\w* \w ressuscite|strong="G450"\w*.\x - \xo 8:31 \xt MRK 14:53; MRK 14:43; MRK 15:1; LUK 9:22; MAT 16:21; LUK 17:25\x*
\v 32 \w E|strong="G2532"\w* \w falava|strong="G2980"\w* \w a palavra|strong="G3588,G3056"\w* \w abertamente|strong="G3954"\w*. \w E|strong="G2532"\w* \w Pedro|strong="G3588,G4074"\w*, \w tomando-o à parte|strong="G4355,G846"\w*, \w começou a|strong="G757"\w* \w repreendê-lo|strong="G2008,G846"\w*.\x - \xo 8:32 \xt MAT 16:22; JHN 16:25; LUK 24:44; JHN 16:29; JHN 18:20; JHN 20:9\x*
\v 33 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w*, \w voltando-se|strong="G1994"\w* \w e|strong="G2532"\w* \w vendo|strong="G1492"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w*, \w repreendeu|strong="G2008"\w* \w Pedro|strong="G4074"\w* \w e|strong="G2532"\w* \w disse|strong="G3004"\w*: “\w Vá|strong="G5217"\w* \w para trás de mim|strong="G3694,G3165"\w*, \w Satanás|strong="G4567"\w*, \w porque|strong="G3754"\w* \w você não tem em mente|strong="G3756,G5426"\w* \w as coisas|strong="G3588"\w* \w de Deus|strong="G3588,G2316"\w*, \w mas|strong="G235"\w* \w as dos seres humanos|strong="G3588,G444"\w*.”\f + \fr 8.33: \ft Lit.: φρονέω, "pensar, ter em mente"; designa a disposição de quem pensa e quer algo\f*\x - \xo 8:33 \xt MAT 16:23; ROM 8:5; MAT 4:10; MRK 10:14; PHP 3:19; 1JN 2:15\x*
\p
\v 34 \w E|strong="G2532"\w*, \w chamando|strong="G4341"\w* \w a multidão|strong="G3588,G3793"\w* \w com os seus discípulos|strong="G4862,G3588,G3101,G846"\w*, \w disse-lhes|strong="G2036,G846"\w*: “\w Se alguém|strong="G1487,G5100"\w* \w quer|strong="G2309"\w* \w vir|strong="G2064"\w* \w atrás de mim|strong="G3694,G3165"\w*, \w negue|strong="G533"\w* \w a si mesmo|strong="G1438"\w*, \w e|strong="G2532"\w* \w tome|strong="G142"\w* \w a sua cruz|strong="G3588,G4716,G846"\w* \w e|strong="G2532"\w* \w me siga|strong="G190,G3165"\w*.\f + \fr 8.34: \ft Variante: NA27, NA28, Tyndale, Tregelles e Byz trazem "seguir" (ἀκολουθεῖν) em lugar de "vir" (ἐλθεῖν) depois de "atrás de mim"; RP também traz "quem quiser" (ὅστις) em lugar de "se alguém quer" (εἴ τις)\f*\x - \xo 8:34 \xt LUK 9:23; MAT 16:24; MAT 10:38; LUK 14:27; MRK 7:14; MAT 7:14\x*
\v 35 \w Pois|strong="G1063"\w* \w quem|strong="G3739"\w* \w quiser|strong="G1437,G2309"\w* \w salvar|strong="G4982"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w a perderá|strong="G622,G846"\w*\f + \fr 8.35: \ft Lit.: ψυχή, literalmente "alma, sopro vital"; aqui designa a própria vida da pessoa, e o mesmo vale nos vv. 36 e 37\f*; \w mas|strong="G1161"\w* \w quem|strong="G3739,G302"\w* \w perder|strong="G622"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w por causa de mim|strong="G1752,G1473"\w* \w e|strong="G2532"\w* \w da boa notícia|strong="G3588,G2098"\w* \w a salvará|strong="G4982,G846"\w*.\x - \xo 8:35 \xt MAT 16:25; LUK 9:24; MAT 10:39; LUK 17:33; LUK 9:23; MAT 18:11\x*
\v 36 \w Pois|strong="G1063"\w* \w de que adianta|strong="G5101,G5623"\w* \w a uma pessoa|strong="G444"\w* \w ganhar|strong="G2770"\w* \w o mundo inteiro|strong="G3588,G2889,G3650"\w* \w e|strong="G2532"\w* \w perder|strong="G2210"\w* \w a sua vida|strong="G3588,G5590,G846"\w*?\x - \xo 8:36 \xt LUK 9:25; MAT 16:26; LUK 9:23; PSA 49:17; MAT 10:39; JAS 1:9-11\x*
\v 37 \w Pois|strong="G1063"\w* \w o que|strong="G5101"\w* \w daria|strong="G1325"\w* \w uma pessoa|strong="G444"\w* \w em troca|strong="G465"\w* \w da sua vida|strong="G3588,G5590,G846"\w*?\x - \xo 8:37 \xt MAT 16:26; LUK 9:23; LUK 17:33; LUK 14:27; PSA 49:7-8; ECC 3:6\x*
\v 38 \w Pois|strong="G1063"\w* \w quem|strong="G3739"\w* \w se envergonhar|strong="G1437,G1870"\w* \w de mim|strong="G3165"\w* \w e|strong="G2532"\w* \w das minhas palavras|strong="G3588,G1473,G3056"\w* \w nesta geração|strong="G1722,G3588,G1074,G3778"\w* \w adúltera|strong="G3588,G3428"\w* \w e|strong="G2532"\w* \w pecadora|strong="G268"\w*\f + \fr 8.38: \ft Nota cultural: "adúltera" é, no uso bíblico, imagem da infidelidade do povo para com Deus\f*, \w também|strong="G2532"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w se envergonhará|strong="G1870"\w* \w dele|strong="G846"\w*, \w quando vier|strong="G3752,G2064"\w* \w na glória|strong="G1722,G3588,G1391"\w* \w do seu Pai|strong="G3588,G3962,G846"\w* \w com os santos|strong="G3326,G3588,G40"\w* \w anjos|strong="G32"\w*.”\x - \xo 8:38 \xt LUK 9:26; ROM 1:16; LUK 9:23; MAT 25:31; MAT 12:39; MAT 16:4\x*
\c 9
\p
\v 1 \w E|strong="G2532"\w* \w lhes dizia|strong="G3004,G846"\w*: “\w Em verdade|strong="G281"\w* \w digo a vocês|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w há|strong="G1510"\w* \w alguns|strong="G5100"\w* \w dos que|strong="G3588"\w* \w aqui|strong="G5602"\w* \w estão em pé|strong="G2476"\w*, \w os quais|strong="G3748"\w* \w de modo nenhum|strong="G3756,G3361"\w* \w provarão|strong="G1089"\w* \w a morte|strong="G2288"\w*\f + \fr 9.1: \ft Lit.: γεύομαι, "provar"; é uma expressão semítica para "experimentar" a morte\f* \w até que|strong="G2193,G302"\w* \w vejam|strong="G1492"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w chegado|strong="G2064"\w* \w com poder|strong="G1722,G1411"\w*.”\x - \xo 9:1 \xt MAT 16:28; LUK 9:27; HEB 2:9; MRK 13:30; 2PE 1:16; JHN 8:51-52\x*
\p
\v 2 \w E|strong="G2532"\w*, \w seis dias|strong="G2250,G1803"\w* \w depois|strong="G3326"\w*, \w Jesus|strong="G3588,G2424"\w* \w tomou consigo|strong="G3880"\w* \w Pedro|strong="G3588,G4074"\w*, \w Tiago|strong="G3588,G2385"\w* \w e|strong="G2532"\w* \w João|strong="G2491"\w*, \w e|strong="G2532"\w* \w os levou|strong="G399,G846"\w* \w a um monte|strong="G1519,G3735"\w* \w alto|strong="G5308"\w*, \w à parte|strong="G2596,G2398"\w*, \w somente eles|strong="G3441"\w*; \w e|strong="G2532"\w* \w foi transfigurado|strong="G3339"\w*\f + \fr 9.2: \ft Lit.: μεταμορφόω, "mudar de forma"\f* \w diante deles|strong="G1715,G846"\w*,\x - \xo 9:2 \xt MAT 17:1; LUK 9:28; MRK 14:33; ISA 33:17; MRK 5:37; 2PE 1:16\x*
\v 3 \w e|strong="G2532"\w* \w as suas roupas|strong="G3588,G2440,G846"\w* \w ficaram|strong="G1096"\w* \w resplandecentes|strong="G4744"\w*, \w extremamente|strong="G3029"\w* \w brancas|strong="G3022"\w*, \w como nenhum|strong="G3634,G3756"\w* \w lavandeiro|strong="G1102"\w*\f + \fr 9.3: \ft Nota cultural: γναφεύς era o profissional que limpava e alvejava tecidos\f* \w na terra|strong="G1909,G3588,G1093"\w* \w consegue|strong="G1410"\w* \w assim|strong="G3779"\w* \w branquear|strong="G3021"\w*.\f + \fr 9.3: \ft Variante: TR e Byz (e RP) acrescentam "como a neve" (ὡς χιών) depois de "extremamente"; RP também omite "assim" (οὕτως); Tregelles e RP trazem o verbo no plural (ἐγένοντο)\f*\x - \xo 9:3 \xt DAN 7:9; MAT 28:3; REV 19:8; LUK 9:29; MRK 9:15; MAT 17:1\x*
\v 4 \w E|strong="G2532"\w* \w lhes apareceu|strong="G3700,G846"\w* \w Elias|strong="G2243"\w* \w com Moisés|strong="G4862,G3475"\w*, \w e|strong="G2532"\w* \w estavam conversando|strong="G1510,G4814"\w* \w com Jesus|strong="G3588,G2424"\w*.\x - \xo 9:4 \xt MAT 17:3; LUK 9:30; ACT 3:21-24; JHN 5:39; LUK 24:44; MAT 17:1\x*
\v 5 \w E|strong="G2532"\w* \w Pedro|strong="G3588,G4074"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G3004"\w* \w a Jesus|strong="G3588,G2424"\w*: “\w Rabi|strong="G4461"\w*\f + \fr 9.5: \ft Lit.: Ῥαββί, "meu mestre"; título de respeito dado a mestres\f*, \w é bom|strong="G2570,G1510"\w* \w que estejamos|strong="G3165,G1511"\w* \w aqui|strong="G5602"\w*; \w e|strong="G2532"\w* \w façamos|strong="G4160"\w* \w três tendas|strong="G5140,G4633"\w*: \w uma para você|strong="G4771,G1520"\w*, \w uma para Moisés|strong="G3475,G1520"\w* \w e|strong="G2532"\w* \w uma para Elias|strong="G2243,G1520"\w*.”\x - \xo 9:5 \xt MAT 17:4; LUK 9:33; JHN 14:21-23; JHN 14:8-9; MAT 17:1; ACT 3:22\x*
\v 6 \w Pois|strong="G1063"\w* \w não sabia|strong="G3756,G1492"\w* \w o que responder|strong="G5101,G611"\w*, \w porque|strong="G1063"\w* \w ficaram aterrorizados|strong="G1630,G1096"\w*.\x - \xo 9:6 \xt MAT 17:4; DAN 10:15-19; MRK 16:5-8; REV 1:17; LUK 9:33; MAT 17:1\x*
\v 7 \w E|strong="G2532"\w* \w apareceu|strong="G1096"\w* \w uma nuvem|strong="G3507"\w* \w que os cobria com sua sombra|strong="G1982,G846"\w*, \w e|strong="G2532"\w* \w veio|strong="G1096"\w* \w uma voz|strong="G5456"\w* \w da nuvem|strong="G1537,G3588,G3507"\w*: “\w Este é|strong="G3778,G1510"\w* \w o meu Filho|strong="G3588,G5207,G3165"\w* \w amado|strong="G3588,G27"\w*; \w ouçam-no|strong="G191,G846"\w*.”\x - \xo 9:7 \xt MAT 17:5; LUK 9:34; 2PE 1:17; MAT 3:17; MRK 1:11; MRK 4:24\x*
\v 8 \w E|strong="G2532"\w* \w de repente|strong="G1819"\w*, \w olhando em volta|strong="G4017"\w*, \w não viram mais|strong="G2089,G3756,G1492"\w* \w ninguém|strong="G3762"\w*, \w a não ser|strong="G235"\w* \w Jesus|strong="G3588,G2424"\w* \w sozinho|strong="G3441"\w* \w com eles|strong="G3326,G1438"\w*.\x - \xo 9:8 \xt MAT 17:8; MAT 17:1; ACT 10:16; ACT 8:39-40; LUK 24:31; LUK 9:28\x*
\v 9 \w E|strong="G2532"\w*, \w enquanto desciam|strong="G2597,G846"\w* \w do monte|strong="G1537,G3588,G3735"\w*, \w lhes ordenou|strong="G1291,G846"\w* \w que a ninguém|strong="G2443,G3367"\w* \w contassem|strong="G1334"\w* \w o que viram|strong="G3739,G1492"\w*, \w a não ser|strong="G1487,G3361"\w* \w quando|strong="G3752"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w ressuscitasse|strong="G450"\w* \w dentre os mortos|strong="G1537,G3498"\w*.\x - \xo 9:9 \xt MAT 16:20; MRK 5:43; MAT 17:9; LUK 24:6; MAT 17:1; MRK 8:30\x*
\v 10 \w E|strong="G2532"\w* \w guardaram|strong="G2902"\w* \w a palavra|strong="G3588,G3056"\w* \w para si mesmos|strong="G4314,G1438"\w*\f + \fr 9.10: \ft Lit.: πρὸς ἑαυτούς pode ligar-se a "guardaram" ("guardaram consigo") ou a "discutindo" ("discutindo entre si")\f*, \w discutindo|strong="G4802"\w* \w o que significava|strong="G5101,G1510"\w* \w ressuscitar|strong="G3588,G450"\w* \w dentre os mortos|strong="G1537,G3498"\w*.\f + \fr 9.10: \ft Tradução: ἐκράτησαν (κρατέω, G2902) está aqui como “guardaram”; o termo pode ser “segurar”, “prender”, “agarrar”, “reter” ou “dominar”, e o contexto decide.\f*\x - \xo 9:10 \xt MRK 9:27; ACT 17:18; JHN 16:17; JHN 2:19-22; LUK 24:6; MAT 17:1\x*
\v 11 \w E|strong="G2532"\w* \w lhe perguntavam|strong="G1905,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Por que|strong="G3754"\w*\f + \fr 9.11: \ft Lit.: ὅτι, literalmente "que"; aqui, como em 2:16, tem o sentido de "por que"\f* \w os escribas|strong="G3588,G1122"\w* \w dizem|strong="G3004"\w* \w que|strong="G3754"\w* \w Elias|strong="G2243"\w* \w precisa|strong="G1163"\w* \w vir|strong="G2064"\w* \w primeiro|strong="G4413"\w*?”\x - \xo 9:11 \xt MAT 17:10; MAL 4:5; MAT 11:14; LUK 1:17; MAL 3:1; ACT 3:21\x*
\v 12 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w lhes disse|strong="G5346,G846"\w*: “\w Elias|strong="G2243"\w*, \w de fato|strong="G3303"\w*, \w vindo|strong="G2064"\w* \w primeiro|strong="G4413"\w*, \w restaura|strong="G600"\w* \w todas as coisas|strong="G3956"\w*; \w e|strong="G2532"\w* \w como está escrito|strong="G4459,G1125"\w* \w sobre o Filho|strong="G1909,G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w que|strong="G2443"\w* \w sofra muito|strong="G4183,G3958"\w* \w e|strong="G2532"\w* \w seja desprezado|strong="G1847"\w*?\x - \xo 9:12 \xt MAT 17:11; MAT 17:12; MAL 4:5; MAT 11:14; ISA 53:1-12; LUK 1:17\x*
\v 13 \w Mas|strong="G235"\w* \w digo a vocês|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w Elias|strong="G2243"\w* \w também|strong="G2532"\w* \w já veio|strong="G2064"\w*, \w e|strong="G2532"\w* \w fizeram com ele|strong="G4160,G846"\w* \w tudo o que|strong="G3745"\w* \w quiseram|strong="G2309"\w*, \w como está escrito|strong="G2531,G1125"\w* \w a respeito dele|strong="G1909,G846"\w*.”\f + \fr 9.13: \ft Nota cultural: Marcos não diz aqui a quem se refere; Mateus 17:13 aplica a frase a João Batista\f*\x - \xo 9:13 \xt MAT 17:13; MAT 11:14; MAT 17:12; MAL 4:5; LUK 1:17; MAT 14:3-11\x*
\p
\v 14 \w E|strong="G2532"\w*, \w ao chegarem|strong="G2064"\w* \w junto aos discípulos|strong="G4314,G3588,G3101"\w*, \w viram|strong="G1492"\w* \w uma grande multidão|strong="G3793,G4183"\w* \w ao redor deles|strong="G4012,G846"\w* \w e|strong="G2532"\w* \w escribas|strong="G1122"\w* \w discutindo com eles|strong="G4802,G4314,G846"\w*.\f + \fr 9.14: \ft Variante: RP traz o verbo no singular, "ao chegar… ele viu" (ἐλθὼν… εἶδεν), em lugar de "ao chegarem… viram", e "a eles" (αὐτοῖς) em lugar de "com eles" (πρὸς αὐτούς)\f*\x - \xo 9:14 \xt MRK 12:28; MAT 17:14; LUK 9:37; LUK 11:53-54; MRK 11:28; MRK 12:14\x*
\v 15 \w E|strong="G2532"\w* \w logo|strong="G2112"\w* \w toda a multidão|strong="G3956,G3588,G3793"\w*, \w ao vê-lo|strong="G1492,G846"\w*, \w ficou muito espantada|strong="G1568"\w*, \w e|strong="G2532"\w*, \w correndo para ele|strong="G4370"\w*, \w o saudava|strong="G782,G846"\w*.\x - \xo 9:15 \xt MAT 17:14; MRK 9:2-3; EXO 34:30; MRK 9:25; LUK 9:37\x*
\v 16 \w E|strong="G2532"\w* \w lhes perguntou|strong="G1905,G846"\w*: “\w O que|strong="G5101"\w* \w vocês discutem|strong="G4802"\w* \w entre si|strong="G4314,G846"\w*?”\f + \fr 9.16: \ft Variante: no fim do verso, o SBLGNT, seguindo Holmes, traz αὑτούς, "entre si"; WH, Tregelles, NA28 e RP trazem αὐτούς, "com eles"; TR e Byz (e RP) trazem "os escribas" (τοὺς γραμματεῖς) em lugar de "lhes" (αὐτούς) como objeto de "perguntou", de modo que a pergunta é dirigida aos escribas: “O que vocês discutem com eles?”\f*\x - \xo 9:16 \xt MRK 12:28; MAT 17:14; LUK 5:30-32; LUK 9:37\x*
\v 17 \w E|strong="G2532"\w* \w lhe respondeu|strong="G611,G846"\w* \w um|strong="G1520"\w* \w da multidão|strong="G1537,G3588,G3793"\w*: “\w Mestre|strong="G1320"\w*, \w trouxe|strong="G5342"\w* \w a você|strong="G4314,G4771"\w* \w o meu filho|strong="G3588,G5207,G3165"\w*, \w que tem|strong="G2192"\w* \w um espírito|strong="G4151"\w* \w mudo|strong="G216"\w*;\x - \xo 9:17 \xt MRK 9:25; MAT 17:14; LUK 11:14; LUK 9:37; LUK 9:38; MRK 10:13\x*
\v 18 \w e|strong="G2532"\w* \w onde quer que|strong="G3699,G1437"\w* \w o apanhe|strong="G846,G2638"\w*, \w o sacode violentamente|strong="G4486,G846"\w*, \w e|strong="G2532"\w* \w espuma|strong="G875"\w*, \w e|strong="G2532"\w* \w range|strong="G5149"\w* \w os dentes|strong="G3588,G3599"\w* \w e|strong="G2532"\w* \w fica rígido|strong="G3583"\w*\f + \fr 9.18: \ft Lit.: ξηραίνω, literalmente "secar"; aqui, "ficar rígido" ou "definhar"; mesma raiz de 3:1\f*; \w e|strong="G2532"\w* \w eu disse|strong="G2036"\w* \w aos seus discípulos|strong="G3588,G3101,G4771"\w* \w que o expulsassem|strong="G2443,G846,G1544"\w*, \w e|strong="G2532"\w* \w não conseguiram|strong="G3756,G2480"\w*.”\x - \xo 9:18 \xt MAT 17:14; MRK 11:23; LUK 9:39-40; MRK 9:20; MRK 9:28-29; MAT 17:19-20\x*
\v 19 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w*, \w respondendo-lhes|strong="G611,G846"\w*, \w disse|strong="G3004"\w*: “\w Ó|strong="G5599"\w* \w geração incrédula|strong="G1074,G571"\w*, \w até quando|strong="G2193,G4219"\w* \w estarei|strong="G1510"\w* \w com vocês|strong="G4314,G4771"\w*? \w Até quando|strong="G2193,G4219"\w* \w suportarei|strong="G430"\w* \w vocês|strong="G4771"\w*? \w Tragam-no|strong="G5342,G846"\w* \w a mim|strong="G4314,G3165"\w*.”\f + \fr 9.19: \ft Variante: RP traz "lhe" no singular (αὐτῷ), de modo que a resposta é dirigida ao pai, em lugar de "lhes" (αὐτοῖς)\f*\x - \xo 9:19 \xt MAT 17:17; LUK 9:41; ISA 40:28; MAT 17:14; EPH 4:2; NUM 14:11\x*
\v 20 \w E|strong="G2532"\w* \w o trouxeram|strong="G5342,G846"\w* \w a ele|strong="G4314,G846"\w*. \w E|strong="G2532"\w* \w o espírito|strong="G3588,G4151"\w*, \w ao vê-lo|strong="G1492,G846"\w*, \w logo|strong="G2112"\w* \w o convulsionou|strong="G4952,G846"\w*, \w e|strong="G2532"\w*, \w caindo|strong="G4098"\w* \w no chão|strong="G1909,G3588,G1093"\w*, \w rolava|strong="G2947"\w* \w espumando|strong="G875"\w*.\x - \xo 9:20 \xt MAT 17:14; MRK 1:26; LUK 4:35; 1PE 5:8; LUK 9:42; JOB 1:10-12\x*
\v 21 \w E|strong="G2532"\w* \w perguntou|strong="G1905"\w* \w ao pai|strong="G3588,G3962"\w* \w dele|strong="G846"\w*: “\w Há quanto tempo|strong="G4214,G5550,G1510,G5613"\w* \w isso acontece|strong="G3778,G1096"\w* \w com ele|strong="G846"\w*?” \w E|strong="G1161"\w* \w ele|strong="G3588"\w* \w disse|strong="G2036"\w*: “\w Desde a infância|strong="G1537,G3812"\w*.\x - \xo 9:21 \xt JHN 5:5; MAT 17:14; LUK 13:11; LUK 8:43; ACT 9:33; JHN 9:20-21\x*
\v 22 \w E|strong="G2532"\w* \w muitas vezes|strong="G4178"\w* \w o lançou|strong="G846,G906"\w* \w tanto|strong="G2532"\w* \w no fogo|strong="G1519,G4442"\w* \w como|strong="G2532"\w* \w na água|strong="G1519,G5204"\w*, \w para|strong="G2443"\w* \w destruí-lo|strong="G622,G846"\w*; \w mas|strong="G235"\w* \w se você pode|strong="G1487,G1410"\w* \w alguma coisa|strong="G5100"\w*, \w ajude-nos|strong="G997,G3165"\w*, \w tendo compaixão|strong="G4697"\w* \w de nós|strong="G1909,G3165"\w*.”\x - \xo 9:22 \xt MAT 17:14; MAT 9:27; MAT 14:14; MAT 8:2; LUK 8:43; MRK 1:40\x*
\v 23 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G2036,G846"\w*: “‘\w Se você pode|strong="G3588,G1487,G1410"\w*’\f + \fr 9.23: \ft Lit.: o artigo τό faz de "se você pode" uma citação das palavras do pai\f*! \w Tudo é possível|strong="G3956,G1415"\w* \w para quem crê|strong="G3588,G4100"\w*.”\f + \fr 9.23: \ft Variante: TR e Byz (e RP) trazem "se você pode crer" (δύνασαι πιστεῦσαι) em lugar de "se você pode"; assim a condição passa a ser a fé\f*\f + \fr 9.23: \ft Acréscimo: verbo ser/estar suprido em “Tudo é possível”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:23 \xt JHN 11:40; HEB 11:6; MAT 9:28; MAT 17:20; MRK 11:23; MAT 21:21-22\x*
\v 24 \w Logo|strong="G2112"\w* \w o pai|strong="G3588,G3962"\w* \w da criança|strong="G3588,G3813"\w*, \w gritando|strong="G2896"\w*, \w dizia|strong="G3004"\w*: “\w Creio|strong="G4100"\w*; \w ajude|strong="G997"\w* \w a minha falta de fé|strong="G3165,G3588,G570"\w*.”\f + \fr 9.24: \ft Variante: TR e Byz (e RP) acrescentam "com lágrimas" (μετὰ δακρύων) depois de "criança" e "Senhor" (κύριε) depois de "Creio"; Tregelles e RP também começam com "E logo" (καὶ εὐθύς, καὶ εὐθέως)\f*\x - \xo 9:24 \xt LUK 17:5; HEB 12:2; EPH 2:8; MAT 15:28; 2TH 1:11; MAT 17:14\x*
\v 25 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w*, \w vendo|strong="G1492"\w* \w que|strong="G3754"\w* \w uma multidão|strong="G3793"\w* \w acorria|strong="G1998"\w*, \w repreendeu|strong="G2008"\w* \w o espírito impuro|strong="G3588,G4151,G169"\w*, \w dizendo-lhe|strong="G3004,G846"\w*: “\w Espírito|strong="G3588,G4151"\w* \w mudo|strong="G216"\w* \w e|strong="G2532"\w* \w surdo|strong="G2974"\w*, \w eu|strong="G1473"\w* \w ordeno a você|strong="G2004,G4771"\w*: \w saia|strong="G1831"\w* \w dele|strong="G1537,G846"\w* \w e|strong="G2532"\w* \w nunca mais|strong="G3371"\w* \w entre|strong="G1525"\w* \w nele|strong="G1519,G846"\w*.”\x - \xo 9:25 \xt MRK 5:8; MRK 9:17; LUK 11:14; ISA 35:5; MAT 17:14; ACT 16:18\x*
\v 26 \w E|strong="G2532"\w*, \w gritando|strong="G2896"\w* \w e|strong="G2532"\w* \w convulsionando-o muito|strong="G4183,G4682"\w*, \w saiu|strong="G1831"\w*; \w e|strong="G2532"\w* \w ele ficou|strong="G1096"\w* \w como|strong="G5616"\w* \w morto|strong="G3498"\w*, \w de modo que|strong="G5620"\w* \w muitos|strong="G3588,G4183"\w* \w diziam|strong="G3004"\w*: “\w Morreu|strong="G599"\w*.”\x - \xo 9:26 \xt MRK 1:26; ISA 35:5; MAT 17:14; ACT 16:18; MRK 5:8; MRK 9:20\x*
\v 27 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w*, \w segurando|strong="G2902"\w* \w a mão|strong="G3588,G5495"\w* \w dele|strong="G846"\w*, \w o levantou|strong="G1453,G846"\w*, \w e|strong="G2532"\w* \w ele se levantou|strong="G450"\w*.\f + \fr 9.27: \ft Lit.: ἐγείρω ("levantar", "ressuscitar") e ἀνίστημι ("pôr-se de pé", "ressuscitar") são também os verbos usados para a ressurreição\f*\x - \xo 9:27 \xt LUK 8:54; MAT 9:25; MRK 1:31; ACT 10:26; MRK 14:46; MRK 9:10\x*
\v 28 \w E|strong="G2532"\w*, \w quando ele entrou|strong="G1525,G846"\w* \w em casa|strong="G1519,G3624"\w*, \w os seus discípulos|strong="G3588,G3101,G846"\w* \w lhe perguntavam|strong="G1905,G846"\w* \w à parte|strong="G2596,G2398"\w*: “\w Por que|strong="G3754"\w* \w nós|strong="G3165"\w* \w não conseguimos|strong="G3756,G1410"\w* \w expulsá-lo|strong="G1544,G846"\w*?”\x - \xo 9:28 \xt MAT 17:19; MRK 7:17; MAT 17:14; MRK 10:10; MRK 9:18; LUK 9:37\x*
\v 29 \w E|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Esta espécie|strong="G3778,G3588,G1085"\w* \w por nada|strong="G1722,G3762"\w* \w pode|strong="G1410"\w* \w sair|strong="G1831"\w*, \w a não ser|strong="G1487,G3361"\w* \w pela oração|strong="G1722,G4335"\w*.”\f + \fr 9.29: \ft Variante: Tyndale, Tregelles, TR e Byz (e RP) acrescentam "e jejum" (καὶ νηστείᾳ) depois de "oração"\f*\x - \xo 9:29 \xt MAT 17:21; JAS 5:15; DAN 9:3; MAT 17:20; EPH 6:18; MAT 17:14\x*
\p
\v 30 \w E dali|strong="G1564,G2532"\w*, \w saindo|strong="G1831"\w*, \w passavam|strong="G3899"\w* \w pela Galileia|strong="G1223,G3588,G1056"\w*, \w e|strong="G2532"\w* \w ele não queria|strong="G3756,G2309"\w* \w que alguém|strong="G2443,G5100"\w* \w soubesse|strong="G1097"\w*.\x - \xo 9:30 \xt JHN 4:43; MAT 17:22; LUK 24:6; LUK 9:43; MRK 6:31-32; MAT 27:22-23\x*
\v 31 \w Pois|strong="G1063"\w* \w ensinava|strong="G1321"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w e|strong="G2532"\w* \w lhes dizia|strong="G3004,G846"\w*: “\w O Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w é entregue|strong="G3860"\w* \w nas mãos|strong="G1519,G5495"\w* \w de seres humanos|strong="G444"\w*, \w e|strong="G2532"\w* \w o matarão|strong="G615,G846"\w*, \w e|strong="G2532"\w*, \w sendo morto|strong="G615"\w*, \w depois de três dias|strong="G3326,G5140,G2250"\w* \w ressuscitará|strong="G450"\w*.”\f + \fr 9.31: \ft Variante: RP traz "no terceiro dia" (τῇ τρίτῃ ἡμέρᾳ) em lugar de "depois de três dias" (μετὰ τρεῖς ἡμέρας)\f*\x - \xo 9:31 \xt MRK 8:31; LUK 9:44; MAT 16:21; MAT 17:22; LUK 24:6; LUK 9:22\x*
\v 32 \w Mas|strong="G1161"\w* \w eles|strong="G3588"\w* \w não entendiam|strong="G50"\w* \w a palavra|strong="G3588,G4487"\w*, \w e|strong="G2532"\w* \w tinham medo|strong="G5399"\w* \w de lhe perguntar|strong="G846,G1905"\w*.\x - \xo 9:32 \xt LUK 9:45; MAT 17:22; JHN 16:19; LUK 18:34; LUK 2:50; JHN 16:17\x*
\p
\v 33 \w E|strong="G2532"\w* \w chegaram a|strong="G2064,G1519"\w* \w Cafarnaum|strong="G2584"\w*. \w E|strong="G2532"\w*, \w estando|strong="G1096"\w* \w em casa|strong="G1722,G3588,G3614"\w*, \w lhes perguntou|strong="G1905,G846"\w*: “\w O que|strong="G5101"\w* \add vocês\add* \w discutiam|strong="G1260"\w* \w no caminho|strong="G1722,G3588,G3598"\w*\f + \fr 9.33: \ft Variante: RP traz o verbo no singular, "ele chegou" (ἦλθεν), em lugar de "chegaram"; TR e Byz (e RP) acrescentam "entre si" (πρὸς ἑαυτούς) depois de "no caminho"\f*\f + \fr 9.33: \ft Lit.: διαλογίζομαι, "raciocinar, discutir consigo ou em conjunto"; o v. 34 diz que discutiram entre si\f*?”\f + \fr 9.33: \ft Acréscimo: “vocês” (em “O que vocês discutiam no”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 9:33 \xt MRK 10:10; MAT 18:1; PHP 2:14; HEB 4:13; LUK 9:46; MAT 20:27\x*
\v 34 \w Mas|strong="G1161"\w* \w eles|strong="G3588"\w* \w ficaram calados|strong="G4623"\w*, \w pois|strong="G1063"\w* \w no caminho|strong="G1722,G3588,G3598"\w* \w tinham discutido|strong="G1256"\w* \w uns com os outros|strong="G4314,G240"\w* \add sobre\add* \w quem|strong="G5101"\w* \w era o maior|strong="G3173"\w*.\f + \fr 9.34: \ft Acréscimo: “sobre” (em “os outros sobre quem era”): preposição ou artigo que a regência do português exige; verbo ser/estar suprido em “era o maior”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:34 \xt MAT 18:1; PHP 2:14; LUK 9:46; MAT 20:27; 3JN 1:9; LUK 22:24\x*
\v 35 \w E|strong="G2532"\w*, \w sentando-se|strong="G2523"\w*, \w chamou|strong="G5455"\w* \w os Doze|strong="G3588,G1427"\w* \w e|strong="G2532"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Se alguém|strong="G1487,G5100"\w* \w quer|strong="G2309"\w* \w ser|strong="G1511"\w* \w o primeiro|strong="G4413"\w*, \w será|strong="G1510"\w* \w o último|strong="G2078"\w* \w de todos|strong="G3956"\w* \w e|strong="G2532"\w* \w servo|strong="G1249"\w* \w de todos|strong="G3956"\w*.”\x - \xo 9:35 \xt MAT 20:26; MRK 10:43; MAT 20:27; MAT 18:1; MAT 20:25-28; LUK 22:26\x*
\v 36 \w E|strong="G2532"\w*, \w tomando|strong="G2983"\w* \w uma criança|strong="G3813"\w*, \w colocou-a|strong="G2476,G846"\w* \w no meio|strong="G1722,G3319"\w* \w deles|strong="G846"\w* \w e|strong="G2532"\w*, \w abraçando-a|strong="G1723,G846"\w*, \w disse-lhes|strong="G2036,G846"\w*:\x - \xo 9:36 \xt MAT 18:2; LUK 24:36; MAT 18:1; MRK 10:16; LUK 9:46; MAT 19:14-15\x*
\v 37 “\w Quem|strong="G3739,G302"\w* \w receber|strong="G1209"\w* \w uma só|strong="G1520"\w* \w criança|strong="G3588,G3813"\w* \w como estas|strong="G5108"\w* \w em meu nome|strong="G1909,G3588,G3686,G3165"\w*, \w recebe a mim|strong="G1473,G1209"\w*; \w e|strong="G2532"\w* \w quem|strong="G3739,G302"\w* \w receber a mim|strong="G1473,G1209"\w*, \w não é a mim|strong="G3756,G1473"\w* \w que recebe|strong="G1209"\w*, \w mas|strong="G235"\w* \w àquele que me enviou|strong="G3588,G649,G3165"\w*.”\f + \fr 9.37: \ft Acréscimo: verbo ser/estar suprido em “não é a mim”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:37 \xt MAT 18:5; LUK 9:48; MAT 10:40; LUK 18:17; MRK 10:15; MAT 18:1\x*
\v 38 \w João|strong="G3588,G2491"\w* \w lhe disse|strong="G5346,G846"\w*: “\w Mestre|strong="G1320"\w*, \w vimos|strong="G1492"\w* \w alguém|strong="G5100"\w* \w expulsando|strong="G1544"\w* \w demônios|strong="G1140"\w* \w em seu nome|strong="G1722,G3588,G3686,G4771"\w*, \w e|strong="G2532"\w* \w tentamos impedi-lo|strong="G2967,G846"\w*, \w porque|strong="G3754"\w* \w não nos seguia|strong="G3756,G190,G3165"\w*.”\f + \fr 9.38: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam "que não nos segue" (ὃς οὐκ ἀκολουθεῖ ἡμῖν) depois de "demônios"; RP também traz "respondeu" (ἀπεκρίθη) em lugar de "disse" (ἔφη), omite "em" (ἐν) antes de "seu nome" e traz "tentamos impedir" no aoristo (ἐκωλύσαμεν)\f*\x - \xo 9:38 \xt LUK 9:49; MRK 16:17; LUK 11:19; MAT 12:27; PHP 1:18; NUM 11:26-29\x*
\v 39 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Não o impeçam|strong="G3361,G2967,G846"\w*, \w pois|strong="G1063"\w* \w não há ninguém|strong="G3762,G1510"\w* \w que|strong="G3739"\w* \w faça|strong="G4160"\w* \w um ato de poder|strong="G1411"\w* \w em meu nome|strong="G1909,G3588,G3686,G3165"\w* \w e|strong="G2532"\w* \w em seguida|strong="G5035"\w* \w possa|strong="G1410"\w* \w falar mal|strong="G2551"\w* \w de mim|strong="G3165"\w*;\x - \xo 9:39 \xt LUK 9:49; PHP 1:18; 1CO 12:3; 2CO 13:8; 1CO 13:1-2; MAT 12:27\x*
\v 40 \w pois|strong="G1063"\w* \w quem|strong="G3739"\w* \w não é|strong="G3756,G1510"\w* \w contra nós|strong="G2596,G3165"\w* \w é a nosso favor|strong="G5228,G3165,G1510"\w*.\f + \fr 9.40: \ft Variante: RP traz "vocês" (ὑμῶν) em lugar de "nós" (ἡμῶν) nas duas ocorrências: "quem não é contra vocês é a favor de vocês"\f*\x - \xo 9:40 \xt MAT 12:30; LUK 9:49; PHP 1:18; LUK 11:23; NUM 11:28\x*
\v 41 \w Pois|strong="G1063"\w* \w quem|strong="G3739,G302"\w* \w der de beber|strong="G4222"\w* \w a vocês|strong="G4771"\w* \w um copo|strong="G4221"\w* \w de água|strong="G5204"\w*, \w pelo fato de|strong="G1722,G3686,G3754"\w* \w vocês serem|strong="G1510"\w* \w de Cristo|strong="G5547"\w*\f + \fr 9.41: \ft Lit.: ἐν ὀνόματι ὅτι, literalmente "em nome de que"; χριστοῦ ἐστε, "são de Cristo", sem artigo no grego\f*, \w em verdade|strong="G281"\w* \w digo a vocês|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w de modo nenhum|strong="G3756,G3361"\w* \w perderá|strong="G622"\w* \w a sua recompensa|strong="G3588,G3408,G846"\w*.\f + \fr 9.41: \ft Variante: RP traz "em meu nome" (ἐν ὀνόματί μου) e omite "que" (ὅτι)\f*\x - \xo 9:41 \xt MAT 10:42; MAT 25:40; HEB 6:10; 2SA 9:1; LUK 9:50; MAT 18:5\x*
\v 42 \w E|strong="G2532"\w* \w quem|strong="G3739,G302"\w* \w fizer tropeçar|strong="G4624"\w* \w um|strong="G1520"\w* \w destes pequenos|strong="G3588,G3398,G3778"\w* \w que creem|strong="G3588,G4100"\w* \w em mim|strong="G1519,G1473"\w*\f + \fr 9.42: \ft Variante: WH omite "em mim" (εἰς ἐμέ); RP omite "destes" (τούτων) e traz "pedra de moinho" com outro termo (λίθος μυλικός)\f*, \w é melhor|strong="G2570,G1510,G3123"\w* \w para ele|strong="G846"\w* \w que|strong="G1487"\w* \w lhe seja pendurada|strong="G4029"\w* \w uma pedra de moinho|strong="G3458,G3684"\w*\f + \fr 9.42: \ft Lit.: μύλος ὀνικός, literalmente "pedra de moinho de asno": a pedra grande, movida por um animal\f* \w no pescoço|strong="G4012,G3588,G5137,G846"\w* \w e|strong="G2532"\w* \w seja lançado|strong="G906"\w* \w ao mar|strong="G1519,G3588,G2281"\w*.\x - \xo 9:42 \xt MAT 18:6; LUK 17:2; MAT 10:42; LUK 17:1-2; MAT 18:10; 2CO 6:3\x*
\v 43 \w E|strong="G2532"\w* \w se a sua mão|strong="G1437,G3588,G5495,G4771"\w* \w faz você tropeçar|strong="G4624,G4771"\w*, \w corte-a|strong="G609,G846"\w*; \w é melhor|strong="G2570,G1510"\w* \w para você|strong="G4771"\w* \w entrar|strong="G1525"\w* \w mutilado|strong="G2948"\w* \w na vida|strong="G1519,G3588,G2222"\w* \w do que|strong="G2228"\w* \w ir|strong="G565"\w* \w tendo|strong="G2192"\w* \w as duas mãos|strong="G3588,G1417,G5495"\w* \w para a Geena|strong="G1519,G3588,G1067"\w*\f + \fr 9.43: \ft Nota cultural: γέεννα vem do hebraico Ge-Hinom, "vale de Hinom", perto de Jerusalém; no uso judaico da época, lugar de castigo\f*, \w para o fogo|strong="G1519,G3588,G4442"\w* \w que não se apaga|strong="G3588,G762"\w*.\f + \fr 9.43: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam aqui o v. 44: "onde o verme deles não morre e o fogo não se apaga" (ὅπου ὁ σκώληξ αὐτῶν οὐ τελευτᾷ καὶ τὸ πῦρ οὐ σβέννυται), repetição do v. 48; o SBLGNT, WH e NA28 não o trazem\f*\x - \xo 9:43 \xt MAT 18:8; MRK 9:45; MRK 9:47; MAT 5:30; MAT 5:29; MAT 25:41\x*
\v 45 \w E|strong="G2532"\w* \w se o seu pé|strong="G1437,G3588,G4228,G4771"\w* \w faz você tropeçar|strong="G4624,G4771"\w*, \w corte-o|strong="G609,G846"\w*; \w é melhor|strong="G2570,G1510"\w* \w para você|strong="G4771"\w* \w entrar|strong="G1525"\w* \w na vida|strong="G1519,G3588,G2222"\w* \w coxo|strong="G5560"\w* \w do que|strong="G2228"\w* \w ser lançado|strong="G906"\w* \w tendo|strong="G2192"\w* \w os dois pés|strong="G3588,G1417,G4228"\w* \w na Geena|strong="G1519,G3588,G1067"\w*.\f + \fr 9.45: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam "para o fogo que não se apaga" (εἰς τὸ πῦρ τὸ ἄσβεστον) e o v. 46, igual ao v. 44 e ao v. 48\f*\x - \xo 9:45 \xt MRK 9:43; MAT 18:8; MAT 5:29; MAT 18:9; MRK 9:47; MAT 10:28\x*
\v 47 \w E|strong="G2532"\w* \w se o seu olho|strong="G1437,G3588,G3788,G4771"\w* \w faz você tropeçar|strong="G4624,G4771"\w*, \w arranque-o|strong="G1544,G846"\w*\f + \fr 9.47: \ft Lit.: ἔκβαλε, literalmente "lance fora"\f*; \w é melhor|strong="G2570,G1510"\w* \w para você|strong="G4771"\w* \w entrar|strong="G1525"\w* \w no reino|strong="G1519,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w com um só olho|strong="G3442"\w* \w do que|strong="G2228"\w* \w ser lançado|strong="G906"\w* \w tendo|strong="G2192"\w* \w dois olhos|strong="G1417,G3788"\w* \w na Geena|strong="G1519,G3588,G1067"\w*,\f + \fr 9.47: \ft Variante: TR e Byz (e RP) acrescentam "do fogo" (τοῦ πυρός) depois de "Geena"\f*\x - \xo 9:47 \xt MAT 18:9; MAT 5:29; MRK 9:43; MAT 18:8; MRK 9:45; MAT 10:28\x*
\v 48 \w onde|strong="G3699"\w* \w o verme|strong="G3588,G4663"\w* \w deles|strong="G846"\w* \w não morre|strong="G3756,G5053"\w* \w e|strong="G2532"\w* \w o fogo|strong="G3588,G4442"\w* \w não se apaga|strong="G3756,G4570"\w*.\f + \fr 9.48: \ft Nota cultural: eco de Isaías 66:24\f*\x - \xo 9:48 \xt ISA 66:24; MRK 9:44; MRK 9:46; MAT 5:29; MAT 10:28; REV 20:15\x*
\v 49 \w Pois|strong="G1063"\w* \w todos|strong="G3956"\w* \w serão salgados|strong="G233"\w* \w com fogo|strong="G4442"\w*.\f + \fr 9.49: \ft Lit.: ἁλίζω, "salgar" ou "conservar com sal"; o sentido da frase é debatido, e o texto não o explica\f*\f + \fr 9.49: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam "e todo sacrifício será salgado com sal" (καὶ πᾶσα θυσία ἁλὶ ἁλισθήσεται)\f*\x - \xo 9:49 \xt MAT 5:13; LEV 2:13; EZK 43:24; LUK 14:34; 2CH 13:5; ISA 66:24\x*
\v 50 \w Bom|strong="G2570"\w* \w é o sal|strong="G3588,G217"\w*; \w mas se|strong="G1437,G1161"\w* \w o sal|strong="G3588,G217"\w* \w perder o sabor|strong="G358,G1096"\w*, \w com o que|strong="G1722,G5101"\w* \w o temperarão|strong="G846,G741"\w*? \w Tenham|strong="G2192"\w* \w sal|strong="G251"\w* \w em vocês mesmos|strong="G1722,G1438"\w*, \w e|strong="G2532"\w* \w vivam em paz|strong="G1514"\w* \w uns com os outros|strong="G1722,G240"\w*.”\f + \fr 9.50: \ft Acréscimo: verbo ser/estar suprido em “é o sal”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:50 \xt COL 4:6; LUK 14:34; MAT 5:13; ROM 12:18; HEB 12:14; 2CO 13:11\x*
\c 10
\p
\v 1 \w E|strong="G2532"\w*, \w levantando-se|strong="G450"\w* \w dali|strong="G1564"\w*, \w foi|strong="G2064"\w* \w para a região|strong="G1519,G3588,G3725"\w* \w da Judeia|strong="G3588,G2449"\w* \w e|strong="G2532"\w* \w além do Jordão|strong="G4008,G3588,G2446"\w*; \w e|strong="G2532"\w* \w multidões|strong="G3793"\w* \w se juntaram|strong="G4848"\w* \w de novo|strong="G3825"\w* \w a ele|strong="G4314,G846"\w*, \w e|strong="G2532"\w*, \w como costumava|strong="G5613,G1486"\w*, \w de novo|strong="G3825"\w* \w os ensinava|strong="G1321,G846"\w*.\f + \fr 10.1: \ft Variante: RP traz "pelo" (διὰ τοῦ) em lugar de "e" (καί), de modo que se lê "foi para a região da Judeia pelo outro lado do Jordão"\f*\x - \xo 10:1 \xt JHN 10:40; MRK 4:2; MRK 6:34; MAT 4:23; JER 32:33; JHN 11:7\x*
\v 2 \w E|strong="G2532"\w* \w lhe perguntavam|strong="G1905,G846"\w* \w se|strong="G1487"\w* \w é permitido|strong="G1832"\w* \w a um homem|strong="G435"\w* \w despedir|strong="G630"\w* \w a esposa|strong="G1135"\w*\f + \fr 10.2: \ft Lit.: ἀπολύω, "soltar, despedir"; aqui, o ato de pôr fim ao casamento\f*, \w pondo-o à prova|strong="G3985,G846"\w*.\f + \fr 10.2: \ft Variante: NA27, NA28, Tyndale, WH, Tregelles, TR e Byz acrescentam "aproximando-se, fariseus" (προσελθόντες Φαρισαῖοι) depois de "E"; o SBLGNT, seguindo Holmes e a margem de WH, não traz essas palavras e deixa o sujeito sem nome\f*\x - \xo 10:2 \xt MAT 19:3; MAT 22:35; MAT 16:1; MAT 5:31; MAL 2:16; 1CO 7:10-11\x*
\v 3 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w*, \w respondendo|strong="G611"\w*, \w disse-lhes|strong="G2036,G846"\w*: “\w O que|strong="G5101"\w* \w Moisés|strong="G3475"\w* \w ordenou a vocês|strong="G4771,G1781"\w*?”\x - \xo 10:3 \xt JHN 8:5; MAT 19:7; MAT 5:31; MAL 2:16; GAL 4:21; ISA 8:20\x*
\v 4 \w Mas|strong="G1161"\w* \w eles|strong="G3588"\w* \w disseram|strong="G2036"\w*: “\w Moisés|strong="G3475"\w* \w permitiu|strong="G2010"\w* \w escrever|strong="G1125"\w* \w um certificado|strong="G975"\w* \w de divórcio|strong="G647"\w* \w e|strong="G2532"\w* \w despedir|strong="G630"\w*.”\f + \fr 10.4: \ft Nota cultural: cf. Deuteronômio 24:1-4\f*\x - \xo 10:4 \xt DEU 24:1; MAT 19:7; MAT 5:31; MAL 2:16; ISA 50:1; JER 3:1\x*
\v 5 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Por causa|strong="G4314"\w* \w da dureza de coração|strong="G3588,G4641"\w* \w de vocês|strong="G4771"\w* \w ele escreveu|strong="G1125"\w* \w a vocês|strong="G4771"\w* \w este mandamento|strong="G3588,G1785,G3778"\w*;\x - \xo 10:5 \xt MAT 5:32; MAT 5:31; MAL 2:16; MAT 19:5; MAT 19:8; ACT 7:51\x*
\v 6 \w mas|strong="G1161"\w* \w desde o princípio|strong="G575,G746"\w* \w da criação|strong="G2937"\w*, \w macho|strong="G730"\w* \w e|strong="G2532"\w* \w fêmea|strong="G2338"\w* \w os fez|strong="G4160,G846"\w*;\f + \fr 10.6: \ft Nota cultural: citação de Gênesis 1:27 (também 5:2)\f*\f + \fr 10.6: \ft Variante: TR e Byz (e RP) acrescentam "Deus" (ὁ θεός) como sujeito: "Deus os fez"\f*\x - \xo 10:6 \xt GEN 1:27; MAT 19:4; 2PE 3:4; MRK 13:19; GEN 2:24; GEN 5:2\x*
\v 7 \w por isso|strong="G1752,G3778"\w* \w o homem|strong="G444"\w*\f + \fr 10.7: \ft Lit.: ἄνθρωπος, "ser humano"; aqui designa o homem que se casa, como no texto de Gênesis 2:24\f* \w deixará|strong="G2641"\w* \w seu pai|strong="G3588,G3962,G846"\w* \w e|strong="G2532"\w* \w sua mãe|strong="G3588,G3384"\w* \w e|strong="G2532"\w* \w se unirá|strong="G4347"\w* \w à sua mulher|strong="G4314,G3588,G1135,G846"\w*,\f + \fr 10.7: \ft Variante: WH omite "e se unirá à sua mulher" (καὶ προσκολληθήσεται πρὸς τὴν γυναῖκα αὐτοῦ)\f*\x - \xo 10:7 \xt GEN 2:24; EPH 5:31; MAT 19:5; MAL 2:15; MAT 5:32; MAT 5:31\x*
\v 8 \w e|strong="G2532"\w* \w os dois|strong="G3588,G1417"\w* \w serão|strong="G1510"\w* \w uma só carne|strong="G1519,G4561,G1520"\w*; \w de modo que|strong="G5620"\w* \w já não|strong="G2089,G3756"\w* \w são|strong="G1510"\w* \w dois|strong="G1417"\w*, \w mas|strong="G235"\w* \w uma só|strong="G1520"\w* \w carne|strong="G4561"\w*.\f + \fr 10.8: \ft Nota cultural: cita Gn 2:24, na forma da LXX.\f*\x - \xo 10:8 \xt GEN 2:24; 2CO 5:16; MAT 19:6; 1CO 6:16; MAT 19:5; EPH 5:28\x*
\v 9 \w Portanto|strong="G3767"\w*, \w o que|strong="G3739"\w* \w Deus|strong="G3588,G2316"\w* \w uniu|strong="G4801"\w*\f + \fr 10.9: \ft Lit.: συζεύγνυμι, "unir sob o mesmo jugo"\f*, \w que o ser humano|strong="G444"\w* \w não separe|strong="G3361,G5563"\w*.”\x - \xo 10:9 \xt MAT 19:6; GEN 2:24; ROM 7:1-3; MAT 5:32; MAT 5:31; MAL 2:16\x*
\v 10 \w E|strong="G2532"\w* \w em casa|strong="G1519,G3588,G3614"\w*, \w de novo|strong="G3825"\w*, \w os discípulos|strong="G3588,G3101"\w* \w o interrogavam|strong="G1905,G846"\w* \w sobre isso|strong="G4012,G3778"\w*.\x - \xo 10:10 \xt MRK 9:33; JHN 18:7; GEN 2:24; MAT 5:32; MAL 2:16; ROM 7:3\x*
\v 11 \w E|strong="G2532"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Quem|strong="G3739,G302"\w* \w despedir|strong="G630"\w* \w a sua esposa|strong="G3588,G1135,G846"\w* \w e|strong="G2532"\w* \w se casar com outra|strong="G1060,G243"\w*, \w comete adultério|strong="G3429"\w* \w contra ela|strong="G1909,G846"\w*;\x - \xo 10:11 \xt MAT 19:9; MAT 5:32; LUK 16:18; MAT 5:31; 1CO 7:10; GEN 2:24\x*
\v 12 \w e|strong="G2532"\w*, \w se ela mesma|strong="G1437,G846"\w*, \w despedindo|strong="G630"\w* \w o seu marido|strong="G3588,G435,G846"\w*, \w se casar com outro|strong="G1060,G243"\w*, \w comete adultério|strong="G3429"\w*.”\f + \fr 10.12: \ft Variante: RP traz "se uma mulher despedir o seu marido e for dada em casamento a outro" (ἐὰν γυνὴ ἀπολύσῃ τὸν ἄνδρα αὐτῆς καὶ γαμηθῇ ἄλλῳ) em lugar de "se ela mesma, despedindo o seu marido, se casar com outro"\f*\x - \xo 10:12 \xt MAT 19:9; MAT 5:32; LUK 16:18; 1CO 7:10; GEN 2:24; MAL 2:16\x*
\p
\v 13 \w E|strong="G2532"\w* \w lhe traziam|strong="G4374,G846"\w* \w crianças|strong="G3813"\w* \w para que|strong="G2443"\w* \w as tocasse|strong="G846,G681"\w*; \w mas|strong="G1161"\w* \w os discípulos|strong="G3588,G3101"\w* \w os repreenderam|strong="G2008,G846"\w*.\f + \fr 10.13: \ft Variante: Tregelles, TR e Byz (e RP) trazem "repreendiam os que as traziam" (ἐπετίμων τοῖς προσφέρουσιν) em lugar de "os repreenderam"; o pronome αὐτοῖς do texto-base não diz se são as crianças ou quem as trazia\f*\x - \xo 10:13 \xt LUK 18:15; MAT 19:13; EZR 8:21; JHN 12:22; MRK 9:17; MRK 9:39\x*
\v 14 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w*, \w vendo|strong="G1492"\w*, \w se indignou|strong="G23"\w* \w e|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Deixem|strong="G863"\w* \w as crianças|strong="G3588,G3813"\w* \w virem|strong="G2064"\w* \w a mim|strong="G4314,G3165"\w*; \w não as impeçam|strong="G3361,G2967,G846"\w*, \w pois|strong="G1063"\w* \w dos que são como elas|strong="G3588,G5108"\w* \w é|strong="G1510"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 10.14: \ft Acréscimo: verbo ser/estar suprido em “dos que são como elas”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:14 \xt MAT 19:14; MAT 18:3; LUK 18:16; MAT 18:4; MAT 5:3; MAT 18:10\x*
\v 15 \w Em verdade|strong="G281"\w* \w digo a vocês|strong="G3004,G4771"\w*: \w quem|strong="G3739,G302"\w* \w não receber|strong="G3361,G1209"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w como uma criança|strong="G5613,G3813"\w*, \w de modo nenhum|strong="G3756,G3361"\w* \w entrará|strong="G1525"\w* \w nele|strong="G1519,G846"\w*.”\x - \xo 10:15 \xt LUK 18:17; MAT 18:3; MRK 9:37; MAT 18:5; LUK 9:48; 1PE 2:2\x*
\v 16 \w E|strong="G2532"\w*, \w abraçando-as|strong="G1723,G846"\w*, \w as abençoava|strong="G6050"\w*, \w pondo|strong="G5087"\w* \w as mãos|strong="G3588,G5495"\w* \w sobre elas|strong="G1909,G846"\w*.\x - \xo 10:16 \xt MAT 19:13; LUK 18:15; MAT 11:25; MRK 9:36; EZR 8:21; PSA 34:11\x*
\p
\v 17 \w E|strong="G2532"\w*, \w quando ele saía|strong="G1607,G846"\w* \w para o caminho|strong="G1519,G3598"\w*, \w um homem|strong="G1520"\w* \w correu até ele|strong="G4370"\w* \w e|strong="G2532"\w*, \w ajoelhando-se|strong="G1120"\w* \w diante dele|strong="G846"\w*, \w lhe perguntava|strong="G1905,G846"\w*: “\w Bom|strong="G18"\w* \w Mestre|strong="G1320"\w*, \w o que devo fazer|strong="G5101,G4160"\w* \w para herdar|strong="G2443,G2816"\w* \w a vida eterna|strong="G2222,G166"\w*?”\x - \xo 10:17 \xt LUK 18:18; MAT 19:16; LUK 10:25; ROM 2:7; JHN 6:27-28; REV 21:7\x*
\v 18 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Por que|strong="G5101"\w* \w você me chama|strong="G3165,G3004"\w* \w de bom|strong="G18"\w*? \w Ninguém|strong="G3762"\w* \w é bom|strong="G18"\w*, \w a não ser|strong="G1487,G3361"\w* \w um só|strong="G1520"\w*, \w Deus|strong="G3588,G2316"\w*.\f + \fr 10.18: \ft Acréscimo: verbo ser/estar suprido em “é bom”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:18 \xt LUK 18:19; MAT 19:16; ROM 3:10; MAT 19:17; LUK 18:18; 1JN 4:16\x*
\v 19 \w Você conhece|strong="G6063"\w* \w os mandamentos|strong="G3588,G1785"\w*: \w não mate|strong="G3361,G5407"\w*, \w não cometa adultério|strong="G3361,G3431"\w*, \w não furte|strong="G3361,G2813"\w*, \w não dê falso testemunho|strong="G3361,G5576"\w*, \w não defraude|strong="G3361,G650"\w*, \w honre|strong="G5091"\w* \w o seu pai|strong="G3588,G3962,G4771"\w* \w e|strong="G2532"\w* \w a sua mãe|strong="G3588,G3384"\w*.”\f + \fr 10.19: \ft Nota cultural: alusão aos mandamentos de Êxodo 20:12-16 e Deuteronômio 5:16-20; a ordem e o "não defraude" (ἀποστερήσῃς) não seguem exatamente a lista do decálogo\f*\x - \xo 10:19 \xt EXO 20:12; DEU 5:16; LUK 18:20; MAT 19:18; ROM 13:9; JAS 2:11\x*
\v 20 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w lhe disse|strong="G5346,G846"\w*: “\w Mestre|strong="G1320"\w*, \w todas estas coisas|strong="G3778,G3956"\w* \w eu guardei|strong="G5442"\w* \w desde a minha juventude|strong="G1537,G3503,G3165"\w*.”\x - \xo 10:20 \xt LUK 18:21; MAT 19:16; LUK 18:18; 2TI 3:5; EZK 33:31-32; PHP 3:6\x*
\v 21 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w*, \w olhando para ele|strong="G1689,G846"\w*, \w o amou|strong="G25,G846"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Uma coisa|strong="G1520"\w* \w falta a você|strong="G4771,G5302"\w*: \w vá|strong="G5217"\w*, \w venda|strong="G4453"\w* \w tudo o que|strong="G3745"\w* \w tem|strong="G2192"\w* \w e|strong="G2532"\w* \w dê|strong="G1325"\w* \w aos pobres|strong="G3588,G4434"\w*, \w e|strong="G2532"\w* \w você terá|strong="G2192"\w* \w um tesouro|strong="G2344"\w* \w no céu|strong="G1722,G3772"\w*; \w e|strong="G2532"\w* \w venha|strong="G1204"\w*, \w siga-me|strong="G190,G3165"\w*.”\f + \fr 10.21: \ft Variante: TR e Byz (e RP) acrescentam "tomando a cruz" (ἄρας τὸν σταυρόν) depois de "venha"; Tregelles e RP trazem σοι em lugar de σε ("falta a você")\f*\x - \xo 10:21 \xt MAT 19:21; LUK 18:22; MAT 13:44; MAT 16:24; MAT 19:16; LUK 18:18\x*
\v 22 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w*, \w abatido|strong="G4768"\w* \w por essa palavra|strong="G1909,G3588,G3056"\w*, \w foi embora|strong="G565"\w* \w entristecido|strong="G3076"\w*, \w pois|strong="G1063"\w* \w tinha|strong="G1510,G2192"\w* \w muitas propriedades|strong="G2933,G4183"\w*.\x - \xo 10:22 \xt MAT 19:22; MAT 19:16; LUK 18:18; 1JN 2:15-16; 1TI 6:9-10; LUK 12:15\x*
\v 23 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w olhando em volta|strong="G4017"\w*, \w disse|strong="G3004"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w*: “\w Com que dificuldade|strong="G4459,G1423"\w* \w os que têm|strong="G3588,G2192"\w* \w riquezas|strong="G3588,G5536"\w* \w entrarão|strong="G1525"\w* \w no reino|strong="G1519,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*!”\x - \xo 10:23 \xt LUK 18:24; MAT 19:23; MAT 19:16; LUK 18:18; MAT 7:21; 1CO 1:26\x*
\v 24 \w E|strong="G1161"\w* \w os discípulos|strong="G3588,G3101"\w* \w ficaram espantados|strong="G2284"\w* \w com as palavras|strong="G1909,G3588,G3056"\w* \w dele|strong="G846"\w*. \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo de novo|strong="G3825,G611"\w*, \w lhes disse|strong="G3004,G846"\w*: “\w Filhos|strong="G5043"\w*, \w como é difícil|strong="G4459,G1422,G1510"\w* \w entrar|strong="G1525"\w* \w no reino|strong="G1519,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*!\f + \fr 10.24: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam "para os que confiam nas riquezas" (τοὺς πεποιθότας ἐπὶ χρήμασιν) depois de "é difícil"\f*\x - \xo 10:24 \xt MAT 7:21; MAT 19:16; LUK 18:18; JAS 5:1-3; MAT 19:24; PRO 11:28\x*
\v 25 \w É mais fácil|strong="G2123,G1510"\w* \w um camelo|strong="G2574"\w* \w passar|strong="G1330"\w* \w pelo buraco|strong="G1223,G3588,G5168"\w* \w da agulha|strong="G3588,G4476"\w* \w do que|strong="G2228"\w* \w um rico|strong="G4145"\w* \w entrar|strong="G1525"\w* \w no reino|strong="G1519,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.”\x - \xo 10:25 \xt MAT 19:24; LUK 18:25; MAT 19:16; LUK 18:18; MAT 13:22; MAT 23:24\x*
\v 26 \w E|strong="G1161"\w* \w eles|strong="G3588"\w* \w ficaram extremamente admirados|strong="G4057,G1605"\w*, \w dizendo|strong="G3004"\w* \w entre si|strong="G4314,G1438"\w*: “\w Então|strong="G2532"\w*, \w quem|strong="G5101"\w* \w pode|strong="G1410"\w* \w ser salvo|strong="G4982"\w*?”\f + \fr 10.26: \ft Variante: WH traz "a ele" (αὐτόν) em lugar de "entre si" (ἑαυτούς), isto é, "diziam a ele"\f*\x - \xo 10:26 \xt LUK 18:26; MAT 19:25; MAT 19:16; LUK 18:18; ACT 16:31; ROM 10:9-13\x*
\v 27 \w Jesus|strong="G3588,G2424"\w*, \w olhando para eles|strong="G1689,G846"\w*, \w disse|strong="G3004"\w*: “\w Para os seres humanos|strong="G3844,G444"\w* \w é impossível|strong="G102"\w*, \w mas|strong="G235"\w* \w não para Deus|strong="G3756,G3844,G2316"\w*, \w pois|strong="G1063"\w* \w todas as coisas|strong="G3956"\w* \w são possíveis|strong="G1415"\w* \w para Deus|strong="G3844,G3588,G2316"\w*.”\f + \fr 10.27: \ft Acréscimo: verbo ser/estar suprido em “é impossível”, “são possíveis”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:27 \xt MAT 19:26; LUK 18:27; LUK 1:37; GEN 18:14; JER 32:27; JOB 42:2\x*
\v 28 \w Pedro|strong="G3588,G4074"\w* \w começou a dizer-lhe|strong="G757,G3004,G846"\w*: “\w Olhe|strong="G2400"\w*, \w nós|strong="G3165"\w* \w deixamos|strong="G863"\w* \w tudo|strong="G3956"\w* \w e|strong="G2532"\w* \w seguimos você|strong="G190,G4771"\w*.”\x - \xo 10:28 \xt LUK 18:28; MAT 19:27; MAT 4:22; MAT 4:20; MRK 1:18; MAT 19:16\x*
\v 29 \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G5346"\w*: “\w Em verdade|strong="G281"\w* \w digo a vocês|strong="G3004,G4771"\w*: \w não há ninguém|strong="G3762,G1510"\w* \w que|strong="G3739"\w* \add tenha\add* \w deixado|strong="G863"\w* \w casa|strong="G3614"\w*, \w irmãos|strong="G80"\w*, \w irmãs|strong="G79"\w*, \w mãe|strong="G3384"\w*, \w pai|strong="G3962"\w*, \w filhos|strong="G5043"\w* \w ou|strong="G2228"\w* \w campos|strong="G68"\w* \w por causa de mim|strong="G1752,G1473"\w* \w e|strong="G2532"\w* \w por causa|strong="G1752"\w* \w da boa notícia|strong="G3588,G2098"\w*,\f + \fr 10.29: \ft Variante: TR e Byz (e RP) acrescentam "ou esposa" (ἢ γυναῖκα) depois de "mãe, pai"; Tregelles e RP trazem "respondendo, Jesus disse" (ἀποκριθεὶς… εἶπεν) em lugar de "Jesus disse"\f*\f + \fr 10.29: \ft Acréscimo: “tenha” (em “ninguém que tenha deixado casa”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\f + \fr 10.29: \ft Não traduzido: ἢ (G2228) ×5: conjunção “ou / do que”; a comparação ou alternativa já está clara na frase.\f*\x - \xo 10:29 \xt MAT 19:29; LUK 18:29; MAT 6:33; MAT 19:16; 1CO 9:23; MAT 5:10-11\x*
\v 30 \w que não receba|strong="G1437,G3361,G2983"\w* \w cem vezes mais|strong="G1542"\w* \w agora|strong="G3568"\w*, \w neste tempo|strong="G1722,G3588,G2540,G3778"\w*, \w casas|strong="G3614"\w*, \w irmãos|strong="G80"\w*, \w irmãs|strong="G79"\w*, \w mães|strong="G3384"\w*, \w filhos|strong="G5043"\w* \w e|strong="G2532"\w* \w campos|strong="G68"\w*, \w com perseguições|strong="G3326,G1375"\w*; \w e|strong="G2532"\w*, \w na era|strong="G1722,G3588,G165"\w* \w que vem|strong="G3588,G2064"\w*, \w a vida eterna|strong="G2222,G166"\w*.\f + \fr 10.30: \ft Variante: Tregelles traz "mãe" no singular (μητέρα) em lugar de "mães" (μητέρας)\f*\x - \xo 10:30 \xt MAT 19:29; MAT 6:33; LUK 18:30; LUK 18:29; MAT 19:16; MAT 5:10\x*
\v 31 \w Mas|strong="G1161"\w* \w muitos|strong="G4183"\w* \w primeiros|strong="G4413"\w* \w serão|strong="G1510"\w* \w últimos|strong="G2078"\w*, \w e|strong="G2532"\w* \w os últimos|strong="G3588,G2078"\w* \w primeiros|strong="G4413"\w*.”\x - \xo 10:31 \xt MAT 19:30; MAT 20:16; LUK 13:30; LUK 18:29; LUK 18:18; MAT 4:20\x*
\p
\v 32 \w Estavam|strong="G1510"\w* \w no caminho|strong="G1722,G3588,G3598"\w*, \w subindo|strong="G305"\w* \w para Jerusalém|strong="G1519,G2414"\w*, \w e|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w ia adiante|strong="G1510,G4254"\w* \w deles|strong="G846"\w*; \w e|strong="G2532"\w* \w estavam espantados|strong="G2284"\w*, \w e|strong="G1161"\w* \w os que seguiam|strong="G3588,G190"\w* \w tinham medo|strong="G5399"\w*. \w E|strong="G2532"\w*, \w tomando de novo|strong="G3880,G3825"\w* \w os Doze|strong="G3588,G1427"\w*, \w começou a|strong="G757"\w* \w lhes dizer|strong="G846,G3004"\w* \w o que ia|strong="G3588,G3195"\w* \w acontecer-lhe|strong="G846,G4819"\w*:\f + \fr 10.32: \ft Variante: RP traz "e, seguindo, tinham medo" (καὶ ἀκολουθοῦντες ἐφοβοῦντο), o que torna a mesma gente a que se espanta e a que teme\f*\x - \xo 10:32 \xt MAT 20:17; LUK 18:31; LUK 13:22; LUK 9:51; MAT 16:21; LUK 12:50\x*
\v 33 “\w Olhem|strong="G2400"\w*, \w estamos subindo|strong="G305"\w* \w para Jerusalém|strong="G1519,G2414"\w*, \w e|strong="G2532"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w será entregue|strong="G3860"\w* \w aos chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w aos escribas|strong="G3588,G1122"\w*, \w e|strong="G2532"\w* \w o condenarão|strong="G2632,G846"\w* \w à morte|strong="G2288"\w*, \w e|strong="G2532"\w* \w o entregarão|strong="G3860,G846"\w* \w aos gentios|strong="G3588,G1484"\w*\f + \fr 10.33: \ft Lit.: ἔθνος, "nação, povo"; no plural designa os povos que não são Israel, os "gentios"; é a mesma palavra de 10:42, onde se lê "nações"\f*;\x - \xo 10:33 \xt MAT 20:18; LUK 19:28; LUK 18:31; MRK 8:31; LUK 24:6; MAT 17:22\x*
\v 34 \w e|strong="G2532"\w* \w zombarão|strong="G1702"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w cuspirão|strong="G1716"\w* \w nele|strong="G846"\w*, \w e|strong="G2532"\w* \w o açoitarão|strong="G3146,G846"\w*, \w e|strong="G2532"\w* \w o matarão|strong="G615"\w*; \w e|strong="G2532"\w*, \w depois de três dias|strong="G3326,G5140,G2250"\w*, \w ressuscitará|strong="G450"\w*.”\f + \fr 10.34: \ft Variante: RP traz "no terceiro dia" (τῇ τρίτῃ ἡμέρᾳ) em lugar de "depois de três dias" e inverte a ordem de "cuspirão" e "açoitarão"\f*\x - \xo 10:34 \xt LUK 18:33; LUK 18:31; MRK 8:31; MRK 14:65; MAT 16:21; MAT 26:67\x*
\p
\v 35 \w E|strong="G2532"\w* \w se aproximaram|strong="G4365"\w* \w dele|strong="G846"\w* \w Tiago|strong="G2385"\w* \w e|strong="G2532"\w* \w João|strong="G2491"\w*, \w os filhos|strong="G3588,G5207"\w* \w de Zebedeu|strong="G2199"\w*, \w dizendo-lhe|strong="G3004,G846"\w*: “\w Mestre|strong="G1320"\w*, \w queremos|strong="G2309"\w* \w que você faça|strong="G2443,G4160"\w* \w por nós|strong="G3165"\w* \w o que|strong="G3739,G1437"\w* \w lhe pedirmos|strong="G154,G4771"\w*.”\f + \fr 10.35: \ft Variante: WH acrescenta "dois" (δύο) antes de "filhos": "os dois filhos de Zebedeu"; RP omite "dele" (αὐτῷ) e "lhe" (σε)\f*\x - \xo 10:35 \xt MRK 3:17; MAT 20:20; MRK 1:19; ACT 12:2; MRK 5:37; MAT 18:1\x*
\v 36 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w lhes disse|strong="G2036,G846"\w*: “\w O que|strong="G5101"\w* \w vocês querem|strong="G2309"\w* \w que eu faça|strong="G4160"\w* \w por vocês|strong="G4771"\w*?”\x - \xo 10:36 \xt MRK 10:51; 1KI 3:5; MAT 20:21; MAT 18:1; 2CH 1:7; MAT 20:20\x*
\v 37 \w Mas|strong="G1161"\w* \w eles|strong="G3588"\w* \w lhe disseram|strong="G2036,G846"\w*: “\w Conceda-nos|strong="G1325,G3165"\w* \w que|strong="G2443"\w* \w um|strong="G1520"\w* \w à sua direita|strong="G4771,G1537,G1188"\w* \w e|strong="G2532"\w* \w outro|strong="G1520"\w* \w à sua esquerda|strong="G1537,G710"\w* \w nos sentemos|strong="G2523"\w* \w na sua glória|strong="G1722,G3588,G1391,G4771"\w*.”\x - \xo 10:37 \xt MRK 16:19; MAT 6:3; MAT 20:21; 2CO 6:7; MAT 18:1; 2CH 1:7\x*
\v 38 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Vocês não sabem|strong="G3756,G6063"\w* \w o que|strong="G5101"\w* \w pedem|strong="G154"\w*. \w Podem|strong="G1410"\w* \w beber|strong="G4095"\w* \w o cálice|strong="G3588,G4221"\w* \w que|strong="G3739"\w* \w eu|strong="G1473"\w* \w bebo|strong="G4095"\w*, \w ou|strong="G2228"\w* \w ser batizados|strong="G907"\w* \w com o batismo|strong="G3588,G908"\w* \w com que|strong="G3739"\w* \w eu|strong="G1473"\w* \w sou batizado|strong="G907"\w*?”\f + \fr 10.38: \ft Lit.: ποτήριον ("cálice") e βάπτισμα ("batismo", de "imergir") são imagens; o contexto (vv. 33-34) as liga ao que vai acontecer a Jesus\f*\f + \fr 10.38: \ft Variante: RP traz "e" (καί) em lugar de "ou" (ἤ) entre "cálice" e "batismo"\f*\x - \xo 10:38 \xt MAT 20:22; JHN 18:11; LUK 12:50; ACT 19:3; MAT 18:1; 1KI 3:5\x*
\v 39 \w Mas|strong="G1161"\w* \w eles|strong="G3588"\w* \w lhe disseram|strong="G2036,G846"\w*: “\w Podemos|strong="G1410"\w*.” \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w O cálice|strong="G3588,G4221"\w* \w que|strong="G3739"\w* \w eu|strong="G1473"\w* \w bebo|strong="G4095"\w* \w vocês beberão|strong="G4095"\w*, \w e|strong="G2532"\w* \w o batismo|strong="G3588,G908"\w* \w com que|strong="G3739"\w* \w eu|strong="G1473"\w* \w sou batizado|strong="G907"\w* \w vocês serão batizados|strong="G907"\w*,\x - \xo 10:39 \xt MAT 20:22; JHN 18:11; ACT 19:3; MRK 14:23; MAT 26:27; MAT 18:1\x*
\v 40 \w mas|strong="G1161"\w* \w sentar-se|strong="G3588,G2523"\w* \w à minha direita|strong="G1537,G1188,G3165"\w* \w ou|strong="G2228"\w* \w à minha esquerda|strong="G1537,G2176"\w* \w não cabe a mim|strong="G3756,G1510,G1473"\w* \w conceder|strong="G1325"\w*, \w mas|strong="G235"\w* \add é\add* \w para aqueles|strong="G3739"\w* \w a quem foi preparado|strong="G2090"\w*.”\f + \fr 10.40: \ft Acréscimo: “é” (em “conceder mas é para aqueles”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 10:40 \xt MAT 20:23; MAT 20:21; MAT 25:33; ACT 1:7; MAT 18:1; 1KI 3:5\x*
\v 41 \w E|strong="G2532"\w* \w os dez|strong="G3588,G1176"\w*, \w ao ouvirem|strong="G191"\w*, \w começaram a|strong="G757"\w* \w se indignar|strong="G23"\w* \w com Tiago|strong="G4012,G2385"\w* \w e|strong="G2532"\w* \w João|strong="G2491"\w*.\x - \xo 10:41 \xt MAT 20:24; MAT 18:1; 1KI 3:5; MAT 20:20; LUK 22:25; 3JN 1:9\x*
\v 42 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w chamando-os|strong="G4341,G846"\w*, \w lhes disse|strong="G3004,G846"\w*: “\w Vocês sabem|strong="G6063"\w* \w que|strong="G3754"\w* \w os que são considerados|strong="G3588,G1380"\w* \w governantes|strong="G757"\w* \w das nações|strong="G3588,G1484"\w* \w dominam sobre elas|strong="G2634,G846"\w*, \w e|strong="G2532"\w* \w os grandes|strong="G3588,G3173"\w* \w delas|strong="G846"\w* \w exercem autoridade|strong="G2715"\w* \w sobre elas|strong="G846"\w*.\x - \xo 10:42 \xt MAT 20:25; MRK 9:35; 1PE 5:3; LUK 22:25; MAT 18:1; 1KI 3:5\x*
\v 43 \w Mas|strong="G1161"\w* \w não é assim|strong="G3756,G3779,G1510"\w* \w entre vocês|strong="G1722,G4771"\w*; \w antes|strong="G235"\w*, \w quem|strong="G3739,G302"\w* \w quiser|strong="G2309"\w* \w tornar-se|strong="G1096"\w* \w grande|strong="G3173"\w* \w entre vocês|strong="G1722,G4771"\w* \w será|strong="G1510"\w* \w servo de vocês|strong="G4771,G1249"\w*,\f + \fr 10.43: \ft Variante: RP traz "será" (ἔσται) em lugar de "é" (ἐστιν) em "não é assim entre vocês"\f*\x - \xo 10:43 \xt MAT 20:26; MAT 23:11; MRK 9:35; JHN 2:5; MAT 23:8-12; LUK 14:11\x*
\v 44 \w e|strong="G2532"\w* \w quem|strong="G3739,G302"\w* \w quiser|strong="G2309"\w* \w ser|strong="G1511"\w* \w o primeiro|strong="G4413"\w* \w entre vocês|strong="G1722,G4771"\w* \w será|strong="G1510"\w* \w escravo|strong="G1401"\w* \w de todos|strong="G3956"\w*.\x - \xo 10:44 \xt MAT 20:27; MRK 9:35; PHP 2:7; MAT 23:11; JHN 13:14; GAL 5:13\x*
\v 45 \w Pois|strong="G1063"\w* \w até mesmo|strong="G2532"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w não veio|strong="G3756,G2064"\w* \w para ser servido|strong="G1247"\w*, \w mas|strong="G235"\w* \w para servir|strong="G1247"\w* \w e|strong="G2532"\w* \w para dar|strong="G1325"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w em resgate|strong="G3083"\w* \w por|strong="G473"\w* \w muitos|strong="G4183"\w*.”\f + \fr 10.45: \ft Lit.: ἀντί, literalmente "no lugar de"\f*\x - \xo 10:45 \xt MAT 20:28; PHP 2:5-8; 1PE 4:10; 2CO 8:9; TIT 2:14; JHN 13:14\x*
\p
\v 46 \w E|strong="G2532"\w* \w chegaram|strong="G2064"\w* \w a Jericó|strong="G1519,G2410"\w*. \w E|strong="G2532"\w*, \w quando ele saía|strong="G1607,G846"\w* \w de Jericó|strong="G575,G2410"\w* \w com os seus discípulos|strong="G2532,G3588,G3101,G846"\w* \w e|strong="G2532"\w* \w uma multidão|strong="G3793"\w* \w considerável|strong="G2425"\w*, \w o filho|strong="G3588,G5207"\w* \w de Timeu|strong="G5090"\w*, \w Bartimeu|strong="G924"\w*\f + \fr 10.46: \ft Nota cultural: Βαρτιμαῖος é "bar-Timai", "filho de Timeu" em aramaico; o texto o explica com "o filho de Timeu"\f*, \w um mendigo|strong="G6075"\w* \w cego|strong="G5185"\w*, \w estava sentado|strong="G2521"\w* \w à beira do caminho|strong="G3844,G3588,G3598"\w*.\x - \xo 10:46 \xt LUK 18:35; MAT 20:29; JHN 9:8; MAT 20:30; MAT 9:27; 1KI 3:5\x*
\v 47 \w E|strong="G2532"\w*, \w ao ouvir|strong="G191"\w* \w que|strong="G3754"\w* \w era|strong="G1510"\w* \w Jesus|strong="G2424"\w*, \w o Nazareno|strong="G3588,G3479"\w*, \w começou a|strong="G757"\w* \w gritar|strong="G2896"\w* \w e|strong="G2532"\w* \w dizer|strong="G3004"\w*: “\w Filho de Davi|strong="G5207,G1138"\w*\f + \fr 10.47: \ft Nota cultural: "Filho de Davi" é título messiânico\f*, \w Jesus|strong="G2424"\w*, \w tenha misericórdia|strong="G1653"\w* \w de mim|strong="G3165"\w*!”\x - \xo 10:47 \xt MAT 9:27; MAT 15:22; MAT 20:29; MRK 1:24; 1KI 3:5; LUK 18:5\x*
\v 48 \w E|strong="G2532"\w* \w muitos|strong="G4183"\w* \w o repreendiam|strong="G2008,G846"\w* \w para que|strong="G2443"\w* \w se calasse|strong="G4623"\w*; \w mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w gritava|strong="G2896"\w* \w muito mais|strong="G4183,G3123"\w*: “\w Filho de Davi|strong="G5207,G1138"\w*, \w tenha misericórdia|strong="G1653"\w* \w de mim|strong="G3165"\w*!”\x - \xo 10:48 \xt MAT 20:31; LUK 18:39; MAT 9:27; LUK 19:40; MAT 20:29; 1KI 3:5\x*
\v 49 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w parando|strong="G2476"\w*, \w disse|strong="G2036"\w*: “\w Chamem-no|strong="G5455,G846"\w*.” \w E|strong="G2532"\w* \w chamaram|strong="G5455"\w* \w o cego|strong="G3588,G5185"\w*, \w dizendo-lhe|strong="G3004,G846"\w*: “\w Coragem|strong="G2293"\w*! \w Levante-se|strong="G1453"\w*, \w ele está chamando|strong="G5455"\w* \w você|strong="G4771"\w*.”\x - \xo 10:49 \xt MAT 20:32; MAT 20:29; LUK 18:40; 1KI 3:5; JHN 11:28; PSA 145:8\x*
\v 50 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w*, \w jogando fora|strong="G577"\w* \w o seu manto|strong="G3588,G2440,G846"\w*, \w deu um salto e foi|strong="G6008,G2064"\w* \w até Jesus|strong="G4314,G3588,G2424"\w*.\f + \fr 10.50: \ft Variante: RP traz "levantando-se" (ἀναστάς) em lugar de "dando um salto" (ἀναπηδήσας)\f*\x - \xo 10:50 \xt MAT 20:29; PHP 3:7-9; 1KI 3:5; HEB 12:1; LUK 18:35; LUK 18:40\x*
\v 51 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo-lhe|strong="G611,G846"\w*, \w disse|strong="G2036"\w*: “\w O que|strong="G5101"\w* \w você quer|strong="G2309"\w* \w que eu faça|strong="G4160"\w* \w por você|strong="G4771"\w*?” \w E|strong="G1161"\w* \w o cego|strong="G3588,G5185"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Rabuni|strong="G4462"\w*\f + \fr 10.51: \ft Lit.: Ραββουνι, forma aramaica mais enfática de "rabi" ("meu mestre")\f*, \w que eu volte a ver|strong="G2443,G308"\w*.”\x - \xo 10:51 \xt LUK 18:41; MRK 10:36; 2CH 1:7; MAT 7:7; MAT 20:29; PHP 4:6\x*
\v 52 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Vá|strong="G5217"\w*; \w a sua fé|strong="G3588,G4102,G4771"\w* \w salvou você|strong="G4982,G4771"\w*.”\f + \fr 10.52: \ft Lit.: σώζω, "salvar"; também "curar"\f* \w E|strong="G2532"\w* \w logo|strong="G2112"\w* \w voltou a ver|strong="G308"\w*, \w e|strong="G2532"\w* \w o seguia|strong="G190,G846"\w* \w pelo caminho|strong="G1722,G3588,G3598"\w*.\x - \xo 10:52 \xt LUK 7:50; LUK 18:42; MRK 5:34; LUK 17:19; MAT 9:29; MAT 20:29\x*
\c 11
\p
\v 1 \w E|strong="G2532"\w*, \w quando se aproximavam|strong="G3753,G1448"\w* \w de Jerusalém|strong="G1519,G2414"\w*, \w de Betfagé|strong="G1519,G967"\w* \w e|strong="G2532"\w* \w Betânia|strong="G963"\w*, \w junto ao monte|strong="G4314,G3588,G3735"\w* \w das Oliveiras|strong="G3588,G1636"\w*, \w enviou|strong="G649"\w* \w dois|strong="G1417"\w* \w dos seus discípulos|strong="G3588,G3101,G846"\w*\x - \xo 11:1 \xt MAT 21:1; LUK 19:29; JHN 8:1; MAT 26:30; JHN 12:14; ACT 1:12\x*
\v 2 \w e|strong="G2532"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Vão|strong="G5217"\w* \w ao povoado|strong="G1519,G3588,G2968"\w* \w que está diante|strong="G3588,G2713"\w* \w de vocês|strong="G4771"\w*, \w e|strong="G2532"\w* \w logo|strong="G2112"\w*, \w ao entrarem|strong="G1531"\w* \w nele|strong="G1519,G846"\w*, \w encontrarão|strong="G2147"\w* \w um potro|strong="G4454"\w* \w amarrado|strong="G1210"\w*\f + \fr 11.2: \ft Lit.: πῶλος, "potro", cria de animal de montaria; o texto não diz de que animal se trata (cf. Zacarias 9:9)\f*, \w no qual|strong="G1909,G3739"\w* \w nenhum ser humano|strong="G3762,G444"\w* \w ainda|strong="G3768"\w* \w se sentou|strong="G2523"\w*; \w soltem-no|strong="G3089,G846"\w* \w e|strong="G2532"\w* \w tragam-no|strong="G5342"\w*.\f + \fr 11.2: \ft Variante: RP omite "ainda" (οὔπω) e traz "soltando-o, tragam" (λύσαντες αὐτὸν ἀγάγετε) em lugar de "soltem-no e tragam-no"; Tregelles e RP trazem "tinha-se sentado" (κεκάθικεν), no perfeito\f*\f + \fr 11.2: \ft Acréscimo: “que está diante”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 11:2 \xt ZEC 9:9; LUK 19:30; MAT 21:2; JHN 12:14; MAT 21:1; 1SA 9:15\x*
\v 3 \w E|strong="G2532"\w*, \w se alguém|strong="G1437,G5100"\w* \w disser a vocês|strong="G4771,G2036"\w*: ‘\w Por que|strong="G5101"\w* \w vocês fazem|strong="G4160"\w* \w isso|strong="G3778"\w*?’, \w digam|strong="G2036"\w*: ‘\w O Senhor|strong="G3588,G2962"\w*\f + \fr 11.3: \ft Lit.: κύριος, "senhor, dono"; pode ser o dono do animal ou o próprio Jesus\f* \w precisa|strong="G5532,G2192"\w* \w dele|strong="G846"\w*’; \w e|strong="G2532"\w* \w logo|strong="G2112"\w* \w o enviará|strong="G846,G649"\w* \w de volta|strong="G3825"\w* \w para cá|strong="G5602"\w*.”\f + \fr 11.3: \ft Variante: RP omite "de volta" (πάλιν)\f*\x - \xo 11:3 \xt MAT 21:3; JHN 12:14; MAT 21:1; MAT 21:2; 2CO 8:9; ACT 10:36\x*
\v 4 \w E|strong="G2532"\w* \w foram|strong="G565"\w* \w e|strong="G2532"\w* \w encontraram|strong="G2147"\w* \w um potro|strong="G4454"\w* \w amarrado|strong="G1210"\w* \w a uma porta|strong="G4314,G2374"\w*, \w do lado de fora|strong="G1854"\w*, \w na rua|strong="G1909,G3588,G296"\w*, \w e|strong="G2532"\w* \w o soltaram|strong="G3089,G846"\w*.\x - \xo 11:4 \xt LUK 19:33; LUK 19:32; JHN 12:14; MAT 21:1; MAT 21:5; MAT 21:7\x*
\v 5 \w E|strong="G2532"\w* \w alguns|strong="G5100"\w* \w dos que|strong="G3588"\w* \w ali|strong="G1563"\w* \w estavam em pé|strong="G2476"\w* \w lhes diziam|strong="G3004,G846"\w*: “\w O que|strong="G5101"\w* \w vocês estão fazendo|strong="G4160"\w*, \w soltando|strong="G3089"\w* \w o potro|strong="G3588,G4454"\w*?”\x - \xo 11:5 \xt LUK 19:33; JHN 12:14; MAT 21:1; MAT 21:5; MAT 21:7; JHN 2:7\x*
\v 6 \w Mas|strong="G1161"\w* \w eles|strong="G3588"\w* \w lhes disseram|strong="G2036,G846"\w* \w como Jesus|strong="G2531,G3588,G2424"\w* \w tinha dito|strong="G2036"\w*; \w e|strong="G2532"\w* \w os deixaram ir|strong="G863,G846"\w*.\x - \xo 11:6 \xt JHN 12:14; MAT 21:1; MAT 21:5; MAT 21:7; JHN 2:7; LUK 19:31\x*
\v 7 \w E|strong="G2532"\w* \w trouxeram|strong="G5342"\w* \w o potro|strong="G3588,G4454"\w* \w a Jesus|strong="G4314,G3588,G2424"\w*, \w e|strong="G2532"\w* \w puseram|strong="G1911"\w* \w sobre ele|strong="G846"\w* \w os seus mantos|strong="G3588,G2440,G846"\w*, \w e|strong="G2532"\w* \w ele se sentou|strong="G2523"\w* \w sobre ele|strong="G1909,G846"\w*.\x - \xo 11:7 \xt MAT 21:7; LUK 19:35; ZEC 9:9; JHN 12:14; MAT 21:1; JHN 12:12\x*
\v 8 \w E|strong="G2532"\w* \w muitos|strong="G4183"\w* \w estenderam|strong="G4766"\w* \w os seus mantos|strong="G3588,G2440,G846"\w* \w no caminho|strong="G1519,G3588,G3598"\w*, \w e|strong="G1161"\w* \w outros|strong="G243"\w* \add estenderam\add* \w ramos|strong="G4746"\w* \w que tinham cortado|strong="G2875"\w* \w dos campos|strong="G1537,G3588,G68"\w*.\f + \fr 11.8: \ft Variante: TR e Byz (e RP) trazem "cortavam ramos das árvores e os espalhavam no caminho" (ἔκοπτον ἐκ τῶν δένδρων καὶ ἐστρώννυον εἰς τὴν ὁδόν) em lugar de "cortando ramos dos campos"\f*\f + \fr 11.8: \ft Acréscimo: “estenderam” (em “e outros estenderam ramos que”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 11:8 \xt MAT 21:8; JHN 12:13; MAT 21:1; JHN 12:12; MAT 21:5; MAT 21:7\x*
\v 9 \w E|strong="G2532"\w* \w os que iam à frente|strong="G3588,G4254"\w* \w e|strong="G2532"\w* \w os que seguiam|strong="G3588,G190"\w* \w gritavam|strong="G2896"\w*: “\w Hosana|strong="G5614"\w*\f + \fr 11.9: \ft Nota cultural: Ὡσαννά vem de uma expressão hebraica que significa "salva, por favor"; a fala cita o Salmo 118:25-26\f*! \w Bendito|strong="G2127"\w* \w o que vem|strong="G3588,G2064"\w* \w em nome|strong="G1722,G3686"\w* \w do Senhor|strong="G2962"\w*!\x - \xo 11:9 \xt PSA 118:25-26; MAT 21:9; JHN 12:13; MAT 23:39; LUK 19:38; PSA 118:26\x*
\v 10 \w Bendito|strong="G2127"\w* \w o reino|strong="G932"\w* \w que vem|strong="G3588,G2064"\w*, \w do nosso pai|strong="G3588,G3962,G3165"\w* \w Davi|strong="G1138"\w*! \w Hosana|strong="G5614"\w* \w nas alturas|strong="G1722,G3588,G5310"\w*!”\f + \fr 11.10: \ft Variante: TR e Byz (e RP) acrescentam "em nome do Senhor" (ἐν ὀνόματι κυρίου) depois de "reino"\f*\x - \xo 11:10 \xt MAT 21:9; LUK 19:38; JHN 12:13; PSA 118:26; MAT 6:10; MAT 9:27\x*
\p
\v 11 \w E|strong="G2532"\w* \w entrou|strong="G1525"\w* \w em Jerusalém|strong="G1519,G2414"\w*, \w no templo|strong="G1519,G3588,G2411"\w*; \w e|strong="G2532"\w*, \w olhando em volta|strong="G4017"\w* \w para tudo|strong="G3956"\w*, \w como a hora|strong="G3588,G5610"\w* \w já era|strong="G2235,G1510"\w* \w tarde|strong="G3796"\w*, \w saiu|strong="G1831"\w* \w para Betânia|strong="G1519,G963"\w* \w com os Doze|strong="G3326,G3588,G1427"\w*.\f + \fr 11.11: \ft Variante: RP acrescenta "Jesus" (ὁ Ἰησοῦς) e "e" (καί) depois de "Jerusalém"; Tregelles, NA27, NA28, Tyndale, TR e Byz trazem ὀψίας ("entardecer") em lugar do advérbio ὀψέ ("tarde"), sem mudar o sentido\f*\x - \xo 11:11 \xt MAT 21:5; MRK 11:19; JHN 8:1-2; MAT 21:17; ZEP 1:12; EZK 8:9\x*
\p
\v 12 \w E|strong="G2532"\w* \w no dia seguinte|strong="G3588,G1887"\w*, \w quando saíram|strong="G1831,G846"\w* \w de Betânia|strong="G575,G963"\w*, \w ele teve fome|strong="G3983"\w*.\x - \xo 11:12 \xt LUK 13:6; MAT 21:18; MAT 4:2; MAT 26:6\x*
\v 13 \w E|strong="G2532"\w*, \w vendo|strong="G1492"\w* \w de longe|strong="G575,G3113"\w* \w uma figueira|strong="G4808"\w* \w que tinha|strong="G2192"\w* \w folhas|strong="G5444"\w*, \w foi|strong="G2064"\w* \w ver se|strong="G1487,G686"\w* \w encontraria|strong="G2147"\w* \w alguma coisa|strong="G5100"\w* \w nela|strong="G1722,G846"\w*; \w e|strong="G2532"\w*, \w chegando|strong="G2064"\w* \w a ela|strong="G1909,G846"\w*, \w nada|strong="G3762"\w* \w encontrou|strong="G2147"\w* \w além de|strong="G1487,G3361"\w* \w folhas|strong="G5444"\w*, \w pois|strong="G1063"\w* \w não era|strong="G3756,G1510"\w* \w o tempo|strong="G3588,G2540"\w* \w de figos|strong="G4810"\w*.\x - \xo 11:13 \xt MAT 21:19; LUK 13:6; JHN 14:12; ISA 5:2; ISA 5:7; MAT 21:18\x*
\v 14 \w E|strong="G2532"\w*, \w respondendo|strong="G611"\w*, \w disse a ela|strong="G2036,G846"\w*: “\w Que nunca mais|strong="G3371,G1519,G3588,G165"\w* \w ninguém|strong="G3367"\w* \w coma|strong="G5315"\w*\f + \fr 11.14: \ft Lit.: φάγοι, optativo: expressa um desejo ou uma maldição ("que ninguém coma")\f* \w fruto|strong="G2590"\w* \w de você|strong="G1537,G4771"\w*.” \w E|strong="G2532"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w ouviam|strong="G191"\w*.\f + \fr 11.14: \ft Tradução: αἰῶνα (αἰών, G165) está aqui como “Que nunca mais”; o termo pode ser “era”, “século”, “eternidade”, “para sempre” ou “mundo (esta era)”, e o contexto decide.\f*\x - \xo 11:14 \xt MAT 21:19; LUK 13:6; MAT 3:10; MAT 7:19; JHN 15:6; MRK 11:20\x*
\p
\v 15 \w E|strong="G2532"\w* \w chegaram|strong="G2064"\w* \w a Jerusalém|strong="G1519,G2414"\w*. \w E|strong="G2532"\w*, \w entrando|strong="G1525"\w* \w no templo|strong="G1519,G3588,G2411"\w*, \w começou a|strong="G757"\w* \w expulsar|strong="G1544"\w* \w os que vendiam|strong="G3588,G4453"\w* \w e|strong="G2532"\w* \w os que compravam|strong="G3588,G59"\w* \w no templo|strong="G1722,G3588,G2411"\w*, \w e|strong="G2532"\w* \w virou|strong="G2690"\w* \w as mesas|strong="G3588,G5132"\w* \w dos cambistas|strong="G3588,G2855"\w* \w e|strong="G2532"\w* \w as cadeiras|strong="G3588,G2515"\w* \w dos que vendiam|strong="G3588,G4453"\w* \w as pombas|strong="G3588,G4058"\w*,\x - \xo 11:15 \xt MAT 21:12; LUK 19:45; JHN 2:14; JHN 2:13-17; PSA 69:9; ZEC 14:21\x*
\v 16 \w e|strong="G2532"\w* \w não permitia|strong="G3756,G863"\w* \w que alguém|strong="G2443,G5100"\w* \w carregasse|strong="G1308"\w* \w algum objeto|strong="G4632"\w* \w através do templo|strong="G1223,G3588,G2411"\w*,\f + \fr 11.16: \ft Tradução: ἤφιεν (ἀφίημι, G863) está aqui como “não permitia”; o termo pode ser “deixar”, “perdoar”, “permitir”, “abandonar” ou “mandar embora”, e o contexto decide.\f*\x - \xo 11:16 \xt MAT 21:12; PSA 69:9; LUK 19:45; ZEC 14:21\x*
\v 17 \w e|strong="G2532"\w* \w ensinava|strong="G1321"\w* \w e|strong="G2532"\w* \w lhes dizia|strong="G3004,G846"\w*: “\w Não está escrito|strong="G3756,G1125"\w*: ‘\w A minha casa|strong="G3588,G3624,G3165"\w* \w será chamada|strong="G2564"\w* \w casa|strong="G3624"\w* \w de oração|strong="G4335"\w* \w para todas|strong="G3956,G3588"\w* \w as nações|strong="G1484"\w*’? \w Mas|strong="G1161"\w* \w vocês|strong="G4771"\w* \w a fizeram|strong="G4160,G846"\w* \w covil|strong="G4693"\w* \w de bandidos|strong="G3027"\w*.”\f + \fr 11.17: \ft Lit.: λῃστής, "bandido, salteador"; é diferente de κλέπτης, "ladrão"\f*\f + \fr 11.17: \ft Nota cultural: citações de Isaías 56:7 e Jeremias 7:11\f*\x - \xo 11:17 \xt ISA 56:7; JER 7:11; LUK 19:46; MAT 21:13; JHN 10:10; JHN 2:16\x*
\v 18 \w E|strong="G2532"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os escribas|strong="G3588,G1122"\w* \w ouviram|strong="G191"\w*, \w e|strong="G2532"\w* \w procuravam|strong="G2212"\w* \w como|strong="G4459"\w* \w poderiam destruí-lo|strong="G846,G622"\w*; \w pois|strong="G1063"\w* \w o temiam|strong="G5399,G846"\w*, \w porque|strong="G1063"\w* \w toda a multidão|strong="G3956,G3588,G3793"\w* \w se admirava|strong="G1605"\w* \w do ensino|strong="G1909,G3588,G1322"\w* \w dele|strong="G846"\w*.\x - \xo 11:18 \xt MRK 1:22; MAT 7:28; LUK 19:47; MAT 22:33; LUK 22:2; LUK 4:32\x*
\v 19 \w E|strong="G2532"\w*, \w quando|strong="G3752"\w* \w ficava tarde|strong="G3796,G1096"\w*, \w saíam|strong="G1607"\w* \w da cidade|strong="G1854,G3588,G4172"\w*.\f + \fr 11.19: \ft Variante: RP traz "quando" no sentido de uma única vez (ὅτε) e o verbo no singular, "ele saiu" (ἐξεπορεύετο), em lugar de "saíam"\f*\x - \xo 11:19 \xt LUK 21:37; MRK 11:11; JHN 12:36; MAT 21:17\x*
\p
\v 20 \w E|strong="G2532"\w*, \w passando|strong="G3899"\w* \w de manhã cedo|strong="G4404"\w*, \w viram|strong="G1492"\w* \w a figueira|strong="G3588,G4808"\w* \w seca|strong="G3583"\w* \w desde as raízes|strong="G1537,G4491"\w*.\x - \xo 11:20 \xt MAT 21:20; MAT 13:6; MAT 21:19; MRK 11:14; MAT 15:13; JHN 15:6\x*
\v 21 \w E|strong="G2532"\w* \w Pedro|strong="G3588,G4074"\w*, \w lembrando-se|strong="G363"\w*, \w disse-lhe|strong="G3004,G846"\w*: “\w Rabi|strong="G4461"\w*, \w veja|strong="G2396"\w*: \w a figueira|strong="G3588,G4808"\w* \w que você amaldiçoou|strong="G3739,G2672"\w* \w secou|strong="G3583"\w*.”\x - \xo 11:21 \xt MAT 21:20; MRK 11:14; MAL 4:6; 2KI 2:24; JUD 1:12; 1CO 16:22\x*
\v 22 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w lhes disse|strong="G3004,G846"\w*: “\w Tenham|strong="G2192"\w* \w fé|strong="G4102"\w* \w em Deus|strong="G2316"\w*.\f + \fr 11.22: \ft Lit.: πίστιν θεοῦ, literalmente "fé de Deus"; aqui entendido como "fé em Deus" (genitivo objetivo)\f*\x - \xo 11:22 \xt JAS 1:6; PSA 62:8; JHN 14:1; MRK 9:23; 2CH 20:20; ISA 7:9\x*
\v 23 \w Em verdade|strong="G281"\w* \w digo a vocês|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w quem|strong="G3739,G302"\w* \w disser|strong="G2036"\w* \w a este monte|strong="G3588,G3735,G3778"\w*: ‘\w Levante-se|strong="G142"\w* \w e|strong="G2532"\w* \w lance-se|strong="G906"\w* \w no mar|strong="G1519,G3588,G2281"\w*’, \w e|strong="G2532"\w* \w não duvidar|strong="G3361,G1252"\w* \w no seu coração|strong="G1722,G3588,G2588,G846"\w*, \w mas|strong="G235"\w* \w crer|strong="G4100"\w* \w que|strong="G3754"\w* \w o que|strong="G3739"\w* \w diz|strong="G2980"\w* \w acontece|strong="G1096"\w*, \w isso lhe acontecerá|strong="G1510,G846"\w*.\f + \fr 11.23: \ft Variante: Tregelles e RP acrescentam "pois" (γάρ) depois de "Em verdade" e trazem "crer" no aoristo (πιστεύσῃ); RP traz no fim "o que diz acontece, e ele terá o que disser" (ἃ λέγει γίνεται, ἔσται αὐτῷ ὃ ἐὰν εἴπῃ)\f*\x - \xo 11:23 \xt MAT 21:21; MAT 17:20; JHN 15:7; PSA 37:4; JHN 14:13; JAS 1:5-6\x*
\v 24 \w Por isso|strong="G1223,G3778"\w* \w digo a vocês|strong="G3004,G4771"\w*: \w tudo o que|strong="G3956,G3745"\w* \w vocês oram|strong="G4336"\w* \w e|strong="G2532"\w* \w pedem|strong="G154"\w*, \w creiam|strong="G4100"\w* \w que|strong="G3754"\w* \w receberam|strong="G2983"\w*, \w e|strong="G2532"\w* \w será para vocês|strong="G1510,G4771"\w*.\f + \fr 11.24: \ft Variante: RP traz "recebem" (λαμβάνετε), no presente, em lugar de "receberam" (ἐλάβετε)\f*\x - \xo 11:24 \xt MAT 21:22; 1JN 3:22; 1JN 5:14-15; JAS 1:5-6; JHN 14:13; JHN 15:7\x*
\v 25 \w E|strong="G2532"\w*, \w quando|strong="G3752"\w* \w estiverem de pé|strong="G4739"\w* \w orando|strong="G4336"\w*, \w perdoem|strong="G863"\w*\f + \fr 11.25: \ft Lit.: ἀφίημι, "deixar ir, deixar de lado"; daí "perdoar"\f* \w se têm|strong="G1487,G2192"\w* \w algo|strong="G5100"\w* \w contra alguém|strong="G2596,G5100"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w o Pai|strong="G3588,G3962"\w* \w de vocês|strong="G4771"\w* \w que está|strong="G3588"\w* \w nos céus|strong="G1722,G3588,G3772"\w* \w perdoe|strong="G863"\w* \w a vocês|strong="G4771"\w* \w as ofensas|strong="G3588,G3900"\w* \w de vocês|strong="G4771"\w*.”\f + \fr 11.25: \ft Variante: TR e Byz (e RP) acrescentam aqui o v. 26: "Mas, se vocês não perdoam, tampouco o Pai de vocês, que está nos céus, perdoará as ofensas de vocês" (εἰ δὲ ὑμεῖς οὖκ ἀφίετε…); o SBLGNT, WH e NA28 não o trazem\f*\f + \fr 11.25: \ft Acréscimo: “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 11:25 \xt MAT 6:14; COL 3:13; EPH 4:32; MAT 6:15; MAT 5:23; MAT 6:12\x*
\p
\v 27 \w E|strong="G2532"\w* \w chegaram|strong="G2064"\w* \w de novo|strong="G3825"\w* \w a Jerusalém|strong="G1519,G2414"\w*. \w E|strong="G2532"\w*, \w enquanto ele andava|strong="G4043,G846"\w* \w no templo|strong="G1722,G3588,G2411"\w*, \w vieram|strong="G2064"\w* \w a ele|strong="G4314,G846"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w*, \w os escribas|strong="G3588,G1122"\w* \w e|strong="G2532"\w* \w os anciãos|strong="G3588,G4245"\w*,\x - \xo 11:27 \xt LUK 20:1; MAT 21:23; LUK 19:47; ACT 4:27-28; PSA 2:1-5; ACT 4:5-8\x*
\v 28 \w e|strong="G2532"\w* \w lhe diziam|strong="G3004,G846"\w*: “\w Com que|strong="G1722,G4169"\w* \w autoridade|strong="G1849"\w* \w você faz|strong="G4160"\w* \w estas coisas|strong="G3778"\w*? \w Ou|strong="G2228"\w* \w quem|strong="G5101"\w* \w lhe deu|strong="G4771,G1325"\w* \w esta autoridade|strong="G3588,G1849,G3778"\w* \w para que|strong="G2443"\w* \w faça|strong="G4160"\w* \w estas coisas|strong="G3778"\w*?”\x - \xo 11:28 \xt LUK 20:2; LUK 20:8; MRK 11:33; MAT 21:23; MAT 21:27; MAT 21:24\x*
\v 29 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Perguntarei|strong="G1905"\w* \w a vocês|strong="G4771"\w* \w uma só pergunta|strong="G1520,G3056"\w*\f + \fr 11.29: \ft Lit.: λόγος, "palavra, assunto"; aqui, uma pergunta\f*; \w e|strong="G2532"\w* \w respondam-me|strong="G611,G3165"\w*, \w e|strong="G2532"\w* \w eu direi|strong="G4483"\w* \w a vocês|strong="G4771"\w* \w com que|strong="G1722,G4169"\w* \w autoridade|strong="G1849"\w* \w faço|strong="G4160"\w* \w estas coisas|strong="G3778"\w*.\f + \fr 11.29: \ft Variante: TR e Byz (e RP) trazem "também eu" (κἀγώ) no começo, "perguntarei também eu a vocês"; RP acrescenta ainda "respondendo" (ἀποκριθείς) depois de "Jesus"\f*\x - \xo 11:29 \xt LUK 20:2; MAT 21:24; MRK 11:33; MAT 21:27; LUK 20:8; MAT 21:23\x*
\v 30 \w O batismo|strong="G3588,G908"\w* \w de João|strong="G3588,G2491"\w* \w era|strong="G1510"\w* \w do céu|strong="G1537,G3772"\w* \w ou|strong="G2228"\w* \w dos seres humanos|strong="G1537,G444"\w*? \w Respondam-me|strong="G611,G3165"\w*.”\x - \xo 11:30 \xt LUK 20:4; JHN 3:27; MAT 21:25; ACT 19:3; ACT 19:4; LUK 7:29\x*
\v 31 \w E|strong="G2532"\w* \w raciocinavam|strong="G1260"\w* \w entre si|strong="G4314,G1438"\w*, \w dizendo|strong="G3004"\w*: “\w O que|strong="G5101"\w* \w diremos|strong="G2036"\w*? \w Se dissermos|strong="G1437,G2036"\w*: ‘\w Do céu|strong="G1537,G3772"\w*’, \w dirá|strong="G4483"\w*: ‘\w Por que|strong="G1223,G5101"\w* \w então|strong="G3767"\w* \w não creram|strong="G3756,G4100"\w* \w nele|strong="G846"\w*?’\f + \fr 11.31: \ft Variante: a pergunta "O que diremos?" (τί εἴπωμεν;) vem do texto de Holmes, que o SBLGNT segue; WH, Tregelles, NA28 e RP não a trazem; Tregelles omite "então" (οὖν); RP traz outra forma de "raciocinavam" (ἐλογίζοντο)\f*\x - \xo 11:31 \xt MAT 21:25; LUK 20:5; JHN 3:27; MAT 21:23; LUK 19:47; JHN 1:15\x*
\v 32 \w Mas|strong="G235"\w* \w se dissermos|strong="G2036"\w*: ‘\w Dos seres humanos|strong="G1537,G444"\w*’?” — \w eles temiam|strong="G5399"\w* \w a multidão|strong="G3588,G3793"\w*, \w pois|strong="G1063"\w* \w todos|strong="G537"\w* \w consideravam|strong="G2192"\w* \w que|strong="G3754"\w* \w João|strong="G3588,G2491"\w* \w era|strong="G1510"\w* \w realmente|strong="G3689"\w* \w profeta|strong="G4396"\w*.\x - \xo 11:32 \xt MAT 21:26; LUK 20:6; MAT 14:5; MAT 21:46; MRK 12:12; MAT 21:23\x*
\v 33 \w E|strong="G2532"\w*, \w respondendo|strong="G611"\w* \w a Jesus|strong="G3588,G2424"\w*, \w disseram|strong="G3004"\w*: “\w Não sabemos|strong="G3756,G6063"\w*.” \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Nem eu|strong="G3761,G1473"\w* \w digo a vocês|strong="G3004,G4771"\w* \w com que|strong="G1722,G4169"\w* \w autoridade|strong="G1849"\w* \w faço|strong="G4160"\w* \w estas coisas|strong="G3778"\w*.”\x - \xo 11:33 \xt LUK 20:8; MAT 21:27; LUK 20:2; MRK 11:28; MRK 11:29; MAT 21:23\x*
\c 12
\p
\v 1 \w E|strong="G2532"\w* \w começou a|strong="G757"\w* \w lhes falar|strong="G846,G2980"\w* \w em parábolas|strong="G1722,G3850"\w*: “\w Um homem|strong="G444"\w* \w plantou|strong="G5452"\w* \w uma vinha|strong="G290"\w*, \w e|strong="G2532"\w* \w pôs em volta dela|strong="G4060"\w* \w uma cerca|strong="G5418"\w*, \w e|strong="G2532"\w* \w cavou|strong="G3736"\w* \w uma cuba para o lagar|strong="G5276"\w*\f + \fr 12.1: \ft Lit.: ὑπολήνιον, a cuba escavada sob o lagar para receber o mosto\f*, \w e|strong="G2532"\w* \w construiu|strong="G3618"\w* \w uma torre|strong="G4444"\w*, \w e|strong="G2532"\w* \w a arrendou|strong="G1554,G846"\w* \w a lavradores|strong="G1092"\w*, \w e|strong="G2532"\w* \w viajou para o exterior|strong="G589"\w*.\f + \fr 12.1: \ft Nota cultural: a vinha com cerca, lagar e torre lembra Isaías 5:1-2\f*\x - \xo 12:1 \xt ISA 5:1; MAT 21:33; LUK 20:9; JHN 15:1; MRK 13:34; SNG 8:11\x*
\v 2 \w E|strong="G2532"\w* \w enviou|strong="G649"\w* \w aos lavradores|strong="G4314,G3588,G1092"\w*, \w no tempo certo|strong="G3588,G2540"\w*, \w um escravo|strong="G1401"\w*, \w para que|strong="G2443"\w* \w recebesse|strong="G2983"\w* \w dos lavradores|strong="G3844,G3588,G1092"\w* \w uma parte|strong="G575"\w* \w dos frutos|strong="G3588,G2590"\w* \w da vinha|strong="G3588,G290"\w*;\x - \xo 12:2 \xt LUK 20:10; MAT 21:34; MAT 21:40; LUK 20:16; MRK 12:9; LUK 20:9\x*
\v 3 \w e|strong="G2532"\w*, \w tomando-o|strong="G2983,G846"\w*, \w o espancaram|strong="G1194"\w* \w e|strong="G2532"\w* \w o mandaram embora|strong="G649"\w* \w de mãos vazias|strong="G2756"\w*.\x - \xo 12:3 \xt LUK 20:10; MRK 12:5; DEU 16:16; MAT 21:33; LUK 20:9; 1TH 2:15\x*
\v 4 \w E|strong="G2532"\w* \w de novo|strong="G3825"\w* \w enviou|strong="G649"\w* \w a eles|strong="G4314,G846"\w* \w outro escravo|strong="G243,G1401"\w*; \w também a esse|strong="G1565,G2532"\w* \w feriram na cabeça|strong="G2775"\w*\f + \fr 12.4: \ft Lit.: κεφαλιόω é raro; "ferir na cabeça", ou "tratar de modo ultrajante"\f* \w e|strong="G2532"\w* \w desonraram|strong="G818"\w*.\f + \fr 12.4: \ft Variante: TR e Byz (e RP) acrescentam "apedrejando-o" (λιθοβολήσαντες) e trazem "mandaram-no embora desonrado" (ἀπέστειλαν ἠτιμωμένον) em lugar de "e desonraram"; Tregelles e RP trazem ἐκεφαλαίωσαν, outra forma do verbo\f*\x - \xo 12:4 \xt MAT 21:36; MAT 21:33; LUK 20:9; MAT 23:37\x*
\v 5 \w E|strong="G2532"\w* \w enviou|strong="G649"\w* \w outro|strong="G243"\w*; \w a esse também|strong="G1565,G2532"\w* \w mataram|strong="G615"\w*; \w e|strong="G2532"\w* \w a muitos outros|strong="G4183,G243"\w*, \w uns|strong="G3739,G3303"\w* \w espancando|strong="G1194"\w*, \w outros|strong="G3739,G1161"\w* \w matando|strong="G615"\w*.\f + \fr 12.5: \ft Lit.: os particípios "espancando" e "matando" não têm sujeito expresso no grego; quem espancava e matava eram os lavradores\f*\x - \xo 12:5 \xt MAT 21:35; MRK 12:3; MAT 21:33; LUK 20:9; JER 7:25-28; LUK 6:22-23\x*
\v 6 \w Ainda|strong="G2089"\w* \w tinha|strong="G2192"\w* \w um|strong="G1520"\w*, \w um filho|strong="G5207"\w* \w amado|strong="G27"\w*; \w enviou-o|strong="G649,G846"\w* \w por último|strong="G2078"\w* \w a eles|strong="G4314,G846"\w*, \w dizendo|strong="G3004"\w*: ‘\w Respeitarão|strong="G1788"\w* \w o meu filho|strong="G3588,G5207,G3165"\w*.’\f + \fr 12.6: \ft Variante: RP traz "Ainda tendo, então, um filho amado seu, enviou também a ele" (οὖν ἕνα υἱὸν ἔχων ἀγαπητὸν αὐτοῦ, ἀπέστειλεν καὶ…) em lugar de "Ainda tinha um, um filho amado; enviou-o"; TR e Byz também trazem "então" (οὖν)\f*\x - \xo 12:6 \xt JHN 3:16; MAT 21:37; LUK 20:13; 1CO 4:14; 1JN 4:9; MAT 21:33\x*
\v 7 \w Mas|strong="G1161"\w* \w aqueles lavradores|strong="G1565,G3588,G1092"\w* \w disseram|strong="G2036"\w* \w entre si|strong="G4314,G1438"\w*: ‘\w Este é|strong="G3778,G1510"\w* \w o herdeiro|strong="G3588,G2818"\w*; \w vamos matá-lo|strong="G1205,G615,G846"\w*, \w e|strong="G2532"\w* \w a herança|strong="G3588,G2817"\w* \w será nossa|strong="G3165,G1510"\w*.’\x - \xo 12:7 \xt MAT 21:38; LUK 20:14; MAT 21:33; LUK 20:9; ACT 13:27-28; ACT 2:23\x*
\v 8 \w E|strong="G2532"\w*, \w agarrando-o|strong="G2983"\w*, \w o mataram|strong="G615,G846"\w* \w e|strong="G2532"\w* \w o lançaram|strong="G1544,G846"\w* \w para fora|strong="G1854"\w* \w da vinha|strong="G3588,G290"\w*.\x - \xo 12:8 \xt LUK 20:15; MAT 21:39; JHN 9:35; JHN 6:37; MAT 21:33; HOS 4:6\x*
\v 9 \w O que|strong="G5101"\w* \w fará|strong="G4160"\w* \w o dono|strong="G3588,G2962"\w* \w da vinha|strong="G3588,G290"\w*? \w Virá|strong="G2064"\w* \w e|strong="G2532"\w* \w destruirá|strong="G622"\w* \w os lavradores|strong="G3588,G1092"\w*, \w e|strong="G2532"\w* \w dará|strong="G1325"\w* \w a vinha|strong="G3588,G290"\w* \w a outros|strong="G243"\w*.\f + \fr 12.9: \ft Tradução: κύριος (κύριος, G2962) está aqui como “o dono”; o termo pode ser “Senhor” (Deus ou Jesus), “senhor” (título de respeito), “dono” ou “patrão”, e o contexto decide.\f*\x - \xo 12:9 \xt LUK 20:16; MAT 21:40; LUK 20:9; MAT 21:33; MAT 21:41; MRK 12:2\x*
\v 10 \w Nem sequer|strong="G3761"\w* \w esta Escritura|strong="G3588,G1124,G3778"\w* \w vocês leram|strong="G314"\w*: ‘\w A pedra|strong="G3037"\w* \w que|strong="G3739"\w* \w os construtores|strong="G3588,G3618"\w* \w rejeitaram|strong="G593"\w*, \w esta|strong="G3778"\w* \w se tornou|strong="G1096"\w* \w a pedra angular|strong="G1519,G2776,G1137"\w*\f + \fr 12.10: \ft Lit.: κεφαλὴν γωνίας, literalmente "cabeça de ângulo"; pode ser a pedra de esquina ou a pedra de fecho do edifício\f*;\x - \xo 12:10 \xt MAT 21:42; LUK 20:17; 1PE 2:7; ACT 4:11; ISA 28:16; PSA 118:22\x*
\v 11 \w isso|strong="G3778"\w* \w veio|strong="G1096"\w* \w do Senhor|strong="G3844,G2962"\w*, \w e|strong="G2532"\w* \w é admirável|strong="G1510,G2298"\w* \w aos nossos olhos|strong="G1722,G3788,G3165"\w*’?”\f + \fr 12.11: \ft Nota cultural: citação do Salmo 118:22-23\f*\x - \xo 12:11 \xt PSA 118:22; MAT 21:42; JHN 9:30; ACT 4:11; 1PE 2:7; MAT 21:33\x*
\v 12 \w E|strong="G2532"\w* \w procuravam|strong="G2212"\w* \w prendê-lo|strong="G846,G2902"\w*, \w mas|strong="G2532"\w* \w temeram|strong="G5399"\w* \w a multidão|strong="G3588,G3793"\w*, \w pois|strong="G1063"\w* \w perceberam|strong="G1097"\w* \w que|strong="G3754"\w* \add ele\add* \w dissera|strong="G2036"\w* \w a parábola|strong="G3588,G3850"\w* \w contra eles|strong="G4314,G846"\w*. \w E|strong="G2532"\w*, \w deixando-o|strong="G863,G846"\w*, \w foram embora|strong="G565"\w*.\f + \fr 12.12: \ft Acréscimo: “ele” (em “perceberam que ele dissera a”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 12:12 \xt LUK 20:19; MAT 21:46; MAT 21:45; MAT 22:22; MAT 21:26; ACT 4:11\x*
\p
\v 13 \w E|strong="G2532"\w* \w enviaram|strong="G649"\w* \w a ele|strong="G4314,G846"\w* \w alguns|strong="G5100"\w* \w dos fariseus|strong="G3588,G5330"\w* \w e|strong="G2532"\w* \w dos herodianos|strong="G3588,G2265"\w*\f + \fr 12.13: \ft Nota cultural: os herodianos eram partidários da dinastia de Herodes; aparecem em Marcos 3:6, aqui e em Mateus 22:16\f* \w para que|strong="G2443"\w* \w o apanhassem|strong="G846,G64"\w* \w numa palavra|strong="G3056"\w*.\x - \xo 12:13 \xt MRK 3:6; MAT 22:16; JHN 1:24; LUK 11:54; MRK 8:15; LUK 20:20\x*
\v 14 \w E|strong="G2532"\w*, \w chegando|strong="G2064"\w*, \w disseram-lhe|strong="G3004,G846"\w*: “\w Mestre|strong="G1320"\w*, \w sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w você é verdadeiro|strong="G227,G1510"\w* \w e|strong="G2532"\w* \w não se preocupa|strong="G3756,G3199,G4771"\w* \w com ninguém|strong="G4012,G3762"\w*, \w pois|strong="G1063"\w* \w não olha|strong="G3756,G991"\w* \w para o rosto|strong="G1519,G4383"\w* \w dos seres humanos|strong="G444"\w*\f + \fr 12.14: \ft Lit.: βλέπεις εἰς πρόσωπον, literalmente "olhar para o rosto"; expressão para tratar alguém com parcialidade, segundo a aparência\f*, \w mas|strong="G235"\w* \w ensina|strong="G1321"\w* \w o caminho|strong="G3588,G3598"\w* \w de Deus|strong="G3588,G2316"\w* \w conforme a verdade|strong="G1909,G225"\w*. \w É permitido|strong="G1832"\w* \w pagar|strong="G1325"\w* \w imposto|strong="G2778"\w*\f + \fr 12.14: \ft Nota cultural: κῆνσος vem do latim census, o imposto cobrado por pessoa\f* \w a César|strong="G2541"\w* \w ou|strong="G2228"\w* \w não|strong="G3756"\w*? \w Devemos pagar|strong="G1325"\w* \w ou|strong="G2228"\w* \w não devemos pagar|strong="G3361,G1325"\w*?”\x - \xo 12:14 \xt MAT 22:16; MAT 22:17; LUK 20:22; ROM 13:6; 1TH 2:4; 2CO 2:17\x*
\v 15 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w*, \w conhecendo|strong="G6063"\w* \w a hipocrisia|strong="G3588,G5272"\w* \w deles|strong="G846"\w*, \w disse-lhes|strong="G2036,G846"\w*: “\w Por que|strong="G5101"\w* \w me põem à prova|strong="G3165,G3985"\w*? \w Tragam-me|strong="G5342,G3165"\w* \w um denário|strong="G1220"\w* \w para que eu o veja|strong="G2443,G1492"\w*.”\x - \xo 12:15 \xt ROM 13:6; MAT 22:15; 1CO 10:9; ACT 5:9; EZK 17:2; HEB 4:13\x*
\v 16 \w Eles|strong="G3588"\w* \w o trouxeram|strong="G5342"\w*. \w E|strong="G2532"\w* \w lhes disse|strong="G3004,G846"\w*: “\w De quem é|strong="G5101"\w* \w esta imagem|strong="G3588,G1504,G3778"\w* \w e|strong="G2532"\w* \w a inscrição|strong="G3588,G1923"\w*?” \w Eles|strong="G3588"\w* \w lhe disseram|strong="G2036,G846"\w*: “\w De César|strong="G2541"\w*.”\f + \fr 12.16: \ft Acréscimo: verbo ser/estar suprido em “De quem é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:16 \xt LUK 20:24; MAT 22:20; ROM 13:6; MAT 22:15; 2TI 2:19; LUK 20:20\x*
\v 17 \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w O que é de César|strong="G3588,G2541"\w* \w devolvam|strong="G591"\w* \w a César|strong="G2541"\w*, \w e|strong="G2532"\w* \w o que é de Deus|strong="G3588,G2316"\w* \w a Deus|strong="G3588,G2316"\w*.” \w E|strong="G2532"\w* \w ficaram muito admirados|strong="G6028"\w* \w com ele|strong="G1909,G846"\w*.\f + \fr 12.17: \ft Acréscimo: verbo ser/estar suprido em “O que é de César”, “o que é de Deus”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:17 \xt MAT 22:21; LUK 20:25; ROM 13:7; MAL 3:8; 1PE 2:13; ROM 13:6\x*
\p
\v 18 \w E|strong="G2532"\w* \w vieram|strong="G2064"\w* \w a ele|strong="G4314,G846"\w* \w saduceus|strong="G4523"\w*\f + \fr 12.18: \ft Nota cultural: os saduceus eram um grupo judaico que, segundo Atos 23:8, negava a ressurreição\f*, \w os quais|strong="G3748"\w* \w dizem|strong="G3004"\w* \w que não há|strong="G3361,G1511"\w* \w ressurreição|strong="G386"\w*, \w e|strong="G2532"\w* \w o interrogavam|strong="G1905,G846"\w*, \w dizendo|strong="G3004"\w*:\x - \xo 12:18 \xt ACT 23:8; MAT 22:23; LUK 20:27; ACT 4:1-2\x*
\v 19 “\w Mestre|strong="G1320"\w*, \w Moisés|strong="G3475"\w* \w nos escreveu|strong="G1125,G3165"\w* \w que|strong="G3754"\w*, \w se o irmão|strong="G1437,G80"\w* \w de alguém|strong="G5100"\w* \w morrer|strong="G599"\w* \w e|strong="G2532"\w* \w deixar|strong="G2641"\w* \w esposa|strong="G1135"\w* \w e|strong="G2532"\w* \w não deixar|strong="G3361,G863"\w* \w filho|strong="G5043"\w*, \w o irmão|strong="G3588,G80"\w* \w dele|strong="G846"\w* \w tome|strong="G2443,G2983"\w* \w a esposa|strong="G3588,G1135"\w* \w e|strong="G2532"\w* \w suscite|strong="G1817"\w* \w descendência|strong="G4690"\w* \w para o seu irmão|strong="G3588,G80,G846"\w*.\f + \fr 12.19: \ft Nota cultural: cf. Deuteronômio 25:5-6, a chamada lei do levirato\f*\f + \fr 12.19: \ft Variante: Tregelles e RP trazem "filhos" no plural (τέκνα), antes do verbo, em lugar de "filho" (τέκνον); RP também acrescenta "dele" (αὐτοῦ) depois de "esposa"\f*\x - \xo 12:19 \xt DEU 25:5; MAT 22:24; LUK 20:28; LUK 20:27; MAT 22:23; LEV 18:16\x*
\v 20 \w Havia|strong="G1510"\w* \w sete|strong="G2033"\w* \w irmãos|strong="G80"\w*; \w e|strong="G2532"\w* \w o primeiro|strong="G3588,G4413"\w* \w tomou|strong="G2983"\w* \w esposa|strong="G1135"\w* \w e|strong="G2532"\w*, \w ao morrer|strong="G599"\w*, \w não deixou|strong="G3756,G863"\w* \w descendência|strong="G4690"\w*;\x - \xo 12:20 \xt MAT 22:25; MRK 12:22; LUK 20:29; LUK 20:27; MAT 22:23\x*
\v 21 \w e|strong="G2532"\w* \w o segundo|strong="G3588,G1208"\w* \w a tomou|strong="G2983,G846"\w* \w e|strong="G2532"\w* \w morreu|strong="G599"\w* \w sem deixar|strong="G3361,G2641"\w* \w descendência|strong="G4690"\w*; \w e|strong="G2532"\w* \w o terceiro|strong="G3588,G5154"\w* \w igualmente|strong="G5615"\w*;\x - \xo 12:21 \xt LUK 20:31; LUK 20:27; MAT 22:23; MAT 22:25\x*
\v 22 \w e|strong="G2532"\w* \w os sete|strong="G3588,G2033"\w* \w não deixaram|strong="G3756,G863"\w* \w descendência|strong="G4690"\w*;\f + \fr 12.22: \ft Variante: RP acrescenta "os sete a tomaram e" (ἔλαβον αὐτὴν οἱ ἑπτά, καί) antes de "não deixaram descendência"\f* \w por último|strong="G2078"\w* \w de todos|strong="G3956"\w*, \w também|strong="G2532"\w* \w a esposa|strong="G3588,G1135"\w* \w morreu|strong="G599"\w*.\x - \xo 12:22 \xt MRK 12:20; MAT 22:25; LUK 20:27; MAT 22:23\x*
\v 23 \w Na ressurreição|strong="G1722,G3588,G386"\w*, \w quando|strong="G3752"\w* \w ressuscitarem|strong="G450"\w*, \w de qual|strong="G5101"\w* \w deles|strong="G846"\w* \w será|strong="G1510"\w* \w esposa|strong="G1135"\w*? \w Pois|strong="G1063"\w* \w os sete|strong="G3588,G2033"\w* \w a tiveram|strong="G2192,G846"\w* \w como esposa|strong="G1135"\w*.”\f + \fr 12.23: \ft Variante: WH e Tregelles omitem "quando ressuscitarem" (ὅταν ἀναστῶσιν); TR traz "então" (οὖν) depois de "ressurreição"\f*\x - \xo 12:23 \xt LUK 20:33; MAT 22:28; LUK 20:27; PSA 31:23; MAT 22:23; MAT 22:25\x*
\v 24 \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G5346,G846"\w*: “\w Não é|strong="G3756"\w* \w por isso|strong="G1223,G3778"\w* \w que vocês estão enganados|strong="G4105"\w*, \w por não conhecerem|strong="G3361,G6063"\w* \w as Escrituras|strong="G3588,G1124"\w* \w nem o poder|strong="G3366,G3588,G1411"\w* \w de Deus|strong="G3588,G2316"\w*?\f + \fr 12.24: \ft Acréscimo: verbo ser/estar suprido em “Não é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:24 \xt MAT 22:29; 2TI 3:16; MAT 22:30; 2TI 3:15-17; JHN 20:9; EPH 1:19\x*
\v 25 \w Pois|strong="G1063"\w*, \w quando|strong="G3752"\w* \w ressuscitarem|strong="G450"\w* \w dentre os mortos|strong="G1537,G3498"\w*, \w nem se casam|strong="G3777,G1060"\w* \w nem são dados em casamento|strong="G3777,G1061"\w*, \w mas|strong="G235"\w* \w são|strong="G1510"\w* \w como anjos|strong="G5613,G32"\w* \w nos céus|strong="G1722,G3588,G3772"\w*.\x - \xo 12:25 \xt MAT 22:30; LUK 20:35; LUK 20:34; 1JN 3:2; LUK 20:27; 1CO 15:43\x*
\v 26 \w Quanto aos mortos|strong="G4012,G3588,G3498"\w* \w que são ressuscitados|strong="G3754,G1453"\w*, \w não leram|strong="G3756,G314"\w* \w no livro|strong="G1722,G3588,G976"\w* \w de Moisés|strong="G3475"\w*, \w no trecho|strong="G1909"\w* \w da sarça|strong="G3588,G942"\w*\f + \fr 12.26: \ft Lit.: ἐπὶ τοῦ βάτου, literalmente "sobre a sarça"; modo de referir o trecho de Êxodo 3\f*, \w como|strong="G4459"\w* \w Deus|strong="G3588,G2316"\w* \w lhe disse|strong="G2036,G846"\w*, \w dizendo|strong="G3004"\w*: ‘\w Eu|strong="G1473"\w* \w sou o Deus|strong="G3588,G2316"\w* \w de Abraão|strong="G11"\w*, \w e|strong="G2532"\w* \w o Deus|strong="G3588,G2316"\w* \w de Isaque|strong="G2464"\w*, \w e|strong="G2532"\w* \w o Deus|strong="G3588,G2316"\w* \w de Jacó|strong="G2384"\w*’?\f + \fr 12.26: \ft Nota cultural: citação de Êxodo 3:6\f*\f + \fr 12.26: \ft Acréscimo: verbo ser/estar suprido em “sou o Deus”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:26 \xt EXO 3:6; LUK 20:37; MAT 22:32; LUK 3:34; MAT 9:13; EXO 3:2\x*
\v 27 \w Ele não é|strong="G3756,G1510"\w* \w Deus|strong="G2316"\w* \w de mortos|strong="G3498"\w*, \w mas|strong="G235"\w* \w de vivos|strong="G2198"\w*. \w Vocês estão muito enganados|strong="G4183,G4105"\w*.”\f + \fr 12.27: \ft Variante: Tregelles, TR e Byz (e RP) trazem "Vocês, portanto" (ὑμεῖς οὖν) antes de "estão muito enganados"; RP também traz "Deus" (θεός) depois de "mas" e o artigo antes de "Deus" (ὁ θεός)\f*\x - \xo 12:27 \xt LUK 20:38; ROM 14:9; MAT 22:32; LUK 20:27; LUK 20:37; MRK 12:24\x*
\p
\v 28 \w E|strong="G2532"\w* \w um|strong="G1520"\w* \w dos escribas|strong="G3588,G1122"\w*, \w aproximando-se|strong="G4334"\w*, \w tendo-os ouvido|strong="G191,G846"\w* \w discutir|strong="G4802"\w*, \w vendo|strong="G1492"\w* \w que|strong="G3754"\w* \w lhes respondera|strong="G611,G846"\w* \w bem|strong="G2573"\w*, \w perguntou-lhe|strong="G1905,G846"\w*: “\w Qual é|strong="G4169,G1510"\w* \w o primeiro|strong="G4413"\w* \w mandamento|strong="G1785"\w* \w de todos|strong="G3956"\w*?”\f + \fr 12.28: \ft Variante: WH e RP trazem "sabendo" (εἰδώς) em lugar de "vendo" (ἰδών)\f*\x - \xo 12:28 \xt MAT 22:36; MRK 9:16; MRK 9:14; MAT 22:34; 1TI 1:5; LUK 10:25-28\x*
\v 29 \w Jesus|strong="G3588,G2424"\w* \w respondeu|strong="G611"\w*: “\w O primeiro|strong="G4413"\w* \w é|strong="G1510"\w*: ‘\w Ouça|strong="G191"\w*, \w Israel|strong="G2474"\w*: \w o Senhor|strong="G2962"\w*, \w nosso Deus|strong="G3588,G2316,G3165"\w*, \w é|strong="G1510"\w* \w o único|strong="G1520"\w* \w Senhor|strong="G2962"\w*\f + \fr 12.29: \ft Lit.: κύριος εἷς ἐστιν, literalmente "o Senhor é um"; pode ser lido "o Senhor é um só" ou "o Senhor, só ele"\f*\f + \fr 12.29: \ft Nota cultural: citação de Deuteronômio 6:4-5, o Shemá\f*;\f + \fr 12.29: \ft Variante: TR e Byz (e RP) trazem "o primeiro de todos os mandamentos" (πρώτη πάντων τῶν ἐντολῶν) em lugar de "o primeiro"; Tregelles acrescenta "a ele" (αὐτῷ) depois de "respondeu"\f*\x - \xo 12:29 \xt DEU 6:4; MAT 22:37; JHN 3:10; 1CO 13:13; MAT 7:12; LUK 10:27\x*
\v 30 \w e|strong="G2532"\w* \w você amará|strong="G25"\w* \w o Senhor|strong="G2962"\w*, \w seu Deus|strong="G3588,G2316,G4771"\w*, \w com todo|strong="G1537,G3650"\w* \w o seu coração|strong="G3588,G2588,G4771"\w*, \w e|strong="G2532"\w* \w com toda|strong="G1537,G3650"\w* \w a sua alma|strong="G3588,G5590,G4771"\w*\f + \fr 12.30: \ft Lit.: ψυχή, literalmente "alma, sopro vital"; designa a pessoa em sua vida; em 8:35-37 aparece como "vida"\f*, \w e|strong="G2532"\w* \w com toda|strong="G1537,G3650"\w* \w a sua mente|strong="G3588,G1271,G4771"\w*, \w e|strong="G2532"\w* \w com toda|strong="G1537,G3650"\w* \w a sua força|strong="G3588,G2479,G4771"\w*.’\f + \fr 12.30: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam no fim "Este é o primeiro mandamento" (αὕτη πρώτη ἐντολή)\f*\x - \xo 12:30 \xt LUK 10:27; MAT 22:37; DEU 6:5; DEU 6:4; ROM 8:28; 1CO 13:13\x*
\v 31 \w O segundo|strong="G1208"\w* \w é este|strong="G3778"\w*: ‘\w Você amará|strong="G25"\w* \w o seu próximo|strong="G3588,G4139,G4771"\w* \w como a si mesmo|strong="G5613,G4771"\w*.’\f + \fr 12.31: \ft Nota cultural: citação de Levítico 19:18\f* \w Não há|strong="G3756,G1510"\w* \w outro|strong="G243"\w* \w mandamento|strong="G1785"\w* \w maior|strong="G3173"\w* \w do que estes|strong="G3778"\w*.”\f + \fr 12.31: \ft Variante: Tyndale, Tregelles, TR e Byz acrescentam "semelhante" (ὁμοία) depois de "segundo"; RP também começa com "E" (καί)\f*\f + \fr 12.31: \ft Acréscimo: verbo ser/estar suprido em “é este”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:31 \xt LEV 19:18; MAT 22:39; LUK 10:27; ROM 13:9; 1JN 4:21; GAL 5:14\x*
\v 32 \w E|strong="G2532"\w* \w o escriba|strong="G3588,G1122"\w* \w lhe disse|strong="G2036,G846"\w*: \add “Muito\add* \w bem|strong="G2573"\w*, \w Mestre|strong="G1320"\w*, \w você disse|strong="G2036"\w* \w com verdade|strong="G1909,G225"\w* \w que|strong="G3754"\w* \w ele é|strong="G1510"\w* \w um só|strong="G1520"\w*, \w e|strong="G2532"\w* \add que\add* \w não há|strong="G3756,G1510"\w* \w outro|strong="G243"\w* \w além dele|strong="G4133,G846"\w*;\f + \fr 12.32: \ft Variante: TR acrescenta "Deus" (θεός) depois de "um só"; WH omite o "e" (καί) antes de "não há"\f*\f + \fr 12.32: \ft Acréscimo: “Muito” (em “lhe disse Muito bem Mestre”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; “que” (em “só e que não há”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 12:32 \xt LUK 20:39; DEU 6:4; MAT 8:19; LEV 19:18; MAT 7:12; MIC 6:8\x*
\v 33 \w e|strong="G2532"\w* \w amá-lo|strong="G3588,G25,G846"\w* \w com todo|strong="G1537,G3650"\w* \w o coração|strong="G3588,G2588"\w*, \w e|strong="G2532"\w* \w com toda|strong="G1537,G3650"\w* \w a compreensão|strong="G3588,G4907"\w*, \w e|strong="G2532"\w* \w com toda|strong="G1537,G3650"\w* \w a força|strong="G3588,G2479"\w*, \w e|strong="G2532"\w* \w amar|strong="G3588,G25"\w* \w o próximo|strong="G3588,G4139"\w* \w como a si mesmo|strong="G5613,G1438"\w* \w vale mais|strong="G4055,G1510"\w* \w do que todos|strong="G3956,G3588"\w* \w os holocaustos|strong="G3646"\w*\f + \fr 12.33: \ft Lit.: ὁλοκαύτωμα, "oferta queimada por inteiro"\f* \w e|strong="G2532"\w* \w os sacrifícios|strong="G2378"\w*.”\f + \fr 12.33: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam "e com toda a alma" (καὶ ἐξ ὅλης τῆς ψυχῆς) depois de "compreensão"; RP traz πλεῖον ("mais") em lugar de περισσότερον\f*\x - \xo 12:33 \xt LUK 10:27; 1SA 15:22; MAT 22:37; GAL 5:14; DEU 6:5; LEV 19:18\x*
\v 34 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w vendo|strong="G1492"\w* \w que ele|strong="G846,G3754"\w* \w respondera|strong="G611"\w* \w com sensatez|strong="G3562"\w*, \w disse-lhe|strong="G2036,G846"\w*: “\w Você não está|strong="G3756,G1510"\w* \w longe|strong="G3112"\w* \w do reino|strong="G575,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.” \w E|strong="G2532"\w* \w ninguém mais|strong="G3762,G2089,G3756"\w* \w ousava|strong="G5111"\w* \w interrogá-lo|strong="G846,G1905"\w*.\x - \xo 12:34 \xt LUK 20:40; MAT 22:46; LEV 19:18; MAT 7:12; LUK 10:27; MIC 6:8\x*
\p
\v 35 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w dizia|strong="G3004"\w*, \w ensinando|strong="G1321"\w* \w no templo|strong="G1722,G3588,G2411"\w*: “\w Como|strong="G4459"\w* \w dizem|strong="G3004"\w* \w os escribas|strong="G3588,G1122"\w* \w que|strong="G3754"\w* \w o Cristo|strong="G3588,G5547"\w* \w é|strong="G1510"\w* \w filho de Davi|strong="G5207,G1138"\w*?\x - \xo 12:35 \xt LUK 20:41; MRK 14:49; LUK 20:44; MAT 22:43; MAT 22:45; PSA 110:1\x*
\v 36 \w O próprio|strong="G846"\w* \w Davi|strong="G1138"\w* \w disse|strong="G2036"\w*, \w no Espírito|strong="G1722,G3588,G4151"\w* \w Santo|strong="G3588,G40"\w*: ‘\w Disse|strong="G2036"\w* \w o Senhor|strong="G2962"\w* \w ao meu Senhor|strong="G3588,G2962,G3165"\w*: “\w Sente-se|strong="G2521"\w* \w à minha direita|strong="G1537,G1188,G3165"\w* \w até que|strong="G2193,G302"\w* \w eu ponha|strong="G5087"\w* \w os seus inimigos|strong="G3588,G2190,G4771"\w* \w debaixo|strong="G5270"\w* \w dos seus pés|strong="G3588,G4228,G4771"\w*.”’\f + \fr 12.36: \ft Nota cultural: citação do Salmo 110:1\f*\f + \fr 12.36: \ft Variante: Tregelles e RP trazem "estrado" (ὑποπόδιον) em lugar de "debaixo" (ὑποκάτω): "até que eu ponha os seus inimigos como estrado dos seus pés"; também trazem "pois" (γάρ) depois de "O próprio Davi" e "diz" (λέγει) em lugar de "disse" (εἶπεν)\f*\x - \xo 12:36 \xt PSA 110:1; HEB 1:13; MAT 22:44; ACT 2:34; 1CO 15:25; HEB 10:13\x*
\v 37 \w O próprio|strong="G846"\w* \w Davi|strong="G1138"\w* \w o chama|strong="G3004,G846"\w* \w Senhor|strong="G2962"\w*; \w e|strong="G2532"\w* \w como|strong="G4159"\w* \w é|strong="G1510"\w* \w seu filho|strong="G846,G5207"\w*?” \w E|strong="G2532"\w* \w a grande|strong="G3588,G4183"\w* \w multidão|strong="G3793"\w* \w o ouvia|strong="G191,G846"\w* \w com prazer|strong="G2234"\w*.\f + \fr 12.37: \ft Variante: TR e Byz (e RP) acrescentam "portanto" (οὖν) depois de "O próprio" e trazem "filho" antes de "dele" (υἱὸς αὐτοῦ), em outra ordem\f*\x - \xo 12:37 \xt PSA 110:1; LUK 20:41; LUK 20:42; MAT 9:27; JAS 1:19; MAT 22:41\x*
\v 38 \w E|strong="G2532"\w*, \w no seu ensino|strong="G1722,G3588,G1322,G846"\w*, \w dizia|strong="G3004"\w*: “\w Tenham cuidado|strong="G991"\w* \w com|strong="G575"\w* \w os escribas|strong="G3588,G1122"\w* \w que gostam de|strong="G3588,G2309"\w* \w andar|strong="G4043"\w* \w com vestes compridas|strong="G1722,G4749"\w* \w e|strong="G2532"\w* \w de receber saudações|strong="G783"\w* \w nas praças|strong="G1722,G3588,G58"\w*\f + \fr 12.38: \ft Tradução: θελόντων (θέλω, G2309) está aqui como “que gostam de”; o termo pode ser “querer”, “desejar”, “ter prazer” ou “pretender”, e o contexto decide.\f*\x - \xo 12:38 \xt LUK 20:46; LUK 11:43; LUK 20:45; MAT 23:1; MAT 23:2; MAT 6:5\x*
\v 39 \w e|strong="G2532"\w* \w de ocupar os primeiros assentos|strong="G4410"\w* \w nas sinagogas|strong="G1722,G3588,G4864"\w* \w e|strong="G2532"\w* \w os primeiros lugares|strong="G4411"\w* \w nos banquetes|strong="G1722,G3588,G1173"\w*,\x - \xo 12:39 \xt MAT 23:6; LUK 20:46; LUK 11:43; MAT 7:15; LUK 14:7; JAS 2:2-3\x*
\v 40 \w os que devoram|strong="G3588,G2719"\w* \w as casas|strong="G3588,G3614"\w* \w das viúvas|strong="G3588,G5503"\w* \w e|strong="G2532"\w*, \w por pretexto|strong="G4392"\w*, \w fazem longas orações|strong="G3117,G4336"\w*; \w estes|strong="G3778"\w* \w receberão|strong="G2983"\w* \w julgamento|strong="G2917"\w* \w maior|strong="G4055"\w*.”\x - \xo 12:40 \xt LUK 20:47; MAT 23:14; ROM 13:2; MAT 7:15; MAT 23:13; MAT 23:33\x*
\p
\v 41 \w E|strong="G2532"\w*, \w sentando-se|strong="G2523"\w* \w diante|strong="G2713"\w* \w do cofre das ofertas|strong="G3588,G1049"\w*\f + \fr 12.41: \ft Lit.: γαζοφυλάκιον, "tesouraria, cofre das ofertas"; a parte do templo onde as ofertas eram depositadas\f*, \w observava|strong="G2334"\w* \w como|strong="G4459"\w* \w a multidão|strong="G3588,G3793"\w* \w lançava|strong="G906"\w* \w moedas de bronze|strong="G5475"\w* \w no cofre das ofertas|strong="G1519,G3588,G1049"\w*; \w e|strong="G2532"\w* \w muitos ricos|strong="G4183,G4145"\w* \w lançavam|strong="G906"\w* \w muito|strong="G4183"\w*;\x - \xo 12:41 \xt LUK 21:1; 2KI 12:9; MAT 25:23; DEU 16:17; JHN 8:20; PRO 19:22\x*
\v 42 \w e|strong="G2532"\w*, \w vindo|strong="G2064"\w* \w uma|strong="G1520"\w* \w viúva|strong="G5503"\w* \w pobre|strong="G4434"\w*, \w lançou|strong="G906"\w* \w duas|strong="G1417"\w* \w moedinhas|strong="G3016"\w*, \w que são|strong="G3739,G1510"\w* \w um quadrante|strong="G2835"\w*.\f + \fr 12.42: \ft Nota cultural: o texto explica que duas moedinhas valem um quadrante, uma moeda romana de pouco valor\f*\x - \xo 12:42 \xt LUK 21:2; LUK 21:1; 2CO 8:12; MAT 25:23; DEU 16:17; LUK 12:59\x*
\v 43 \w E|strong="G2532"\w*, \w chamando|strong="G4341"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w*, \w disse-lhes|strong="G2036,G846"\w*: “\w Em verdade|strong="G281"\w* \w digo a vocês|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w esta viúva|strong="G3588,G5503,G3778"\w* \w pobre|strong="G3588,G4434"\w* \w lançou|strong="G906"\w* \w mais|strong="G4119"\w* \w do que todos|strong="G3956"\w* \w os que lançam|strong="G3588,G906"\w* \w no cofre das ofertas|strong="G1519,G3588,G1049"\w*;\x - \xo 12:43 \xt LUK 21:3; LUK 21:1; 2CO 8:12; MAT 25:23; DEU 16:17; PRO 19:22\x*
\v 44 \w pois|strong="G1063"\w* \w todos|strong="G3956"\w* \w lançaram|strong="G906"\w* \w do que|strong="G1537,G3588"\w* \w lhes sobrava|strong="G4052,G846"\w*, \w mas|strong="G1161"\w* \w ela|strong="G3778"\w*, \w da sua penúria|strong="G1537,G3588,G5304,G846"\w*, \w lançou|strong="G906"\w* \w tudo o que|strong="G3956,G3745"\w* \w tinha|strong="G2192"\w*, \w todo o seu sustento|strong="G3650,G3588,G979,G846"\w*.”\f + \fr 12.44: \ft Lit.: βίος, "vida, meio de vida"; aqui, aquilo de que ela vivia\f*\x - \xo 12:44 \xt LUK 21:1; 2CO 8:12; 1JN 3:17; 2CO 8:2; EZR 2:68-69; LUK 21:2-4\x*
\c 13
\p
\v 1 \w E|strong="G2532"\w*, \w quando ele saía|strong="G1607,G846"\w* \w do templo|strong="G1537,G3588,G2411"\w*, \w um|strong="G1520"\w* \w dos seus discípulos|strong="G3588,G3101,G846"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Mestre|strong="G1320"\w*, \w veja|strong="G2396"\w*: \w que pedras|strong="G4217,G3037"\w* \w e|strong="G2532"\w* \w que construções|strong="G4217,G3619"\w*!”\x - \xo 13:1 \xt MAT 24:1; EZK 11:22-23; JER 51:61\x*
\v 2 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Você vê|strong="G991"\w* \w estas grandes|strong="G3778,G3588,G3173"\w* \w construções|strong="G3619"\w*? \w De modo nenhum|strong="G3756,G3361"\w* \w será deixada|strong="G863"\w* \w aqui|strong="G5602"\w* \w pedra|strong="G3037"\w* \w sobre pedra|strong="G1909,G3037"\w* \w que não|strong="G3739,G3756,G3361"\w* \w seja derrubada|strong="G2647"\w*.”\f + \fr 13.2: \ft Variante: RP acrescenta "respondendo" (ἀποκριθείς) depois de "Jesus", omite "aqui" (ὧδε) e traz "pedra" no dativo (λίθῳ)\f*\x - \xo 13:2 \xt MAT 24:2; LUK 21:6; MAT 24:1; DAN 9:26; LUK 19:44; 1KI 9:7-8\x*
\p
\v 3 \w E|strong="G2532"\w*, \w quando ele estava sentado|strong="G2521,G846"\w* \w no monte|strong="G1519,G3588,G3735"\w* \w das Oliveiras|strong="G3588,G1636"\w* \w diante do templo|strong="G2713,G3588,G2411"\w*, \w Pedro|strong="G4074"\w*, \w Tiago|strong="G2385"\w*, \w João|strong="G2491"\w* \w e|strong="G2532"\w* \w André|strong="G406"\w* \w lhe perguntavam|strong="G1905,G846"\w* \w à parte|strong="G2596,G2398"\w*:\x - \xo 13:3 \xt MAT 24:3; MAT 24:1; LUK 21:7; MRK 11:1; MRK 4:34; MAT 21:1\x*
\v 4 “\w Diga-nos|strong="G2036,G3165"\w*: \w quando|strong="G4219"\w* \w serão|strong="G1510"\w* \w estas coisas|strong="G3778"\w*, \w e|strong="G2532"\w* \w qual é|strong="G5101"\w* \w o sinal|strong="G3588,G4592"\w* \w quando|strong="G3752"\w* \w estiverem para|strong="G3195"\w* \w se cumprir|strong="G4931"\w* \w todas estas coisas|strong="G3778,G3956"\w*?”\f + \fr 13.4: \ft Acréscimo: verbo ser/estar suprido em “qual é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:4 \xt LUK 21:7; MAT 24:3; MAT 24:1; ACT 1:6-7; MAT 24:30; DAN 12:6\x*
\v 5 \w Jesus|strong="G3588,G2424"\w* \w começou a|strong="G757"\w* \w lhes dizer|strong="G3004,G846"\w*: “\w Tomem cuidado|strong="G991"\w* \w para que|strong="G3361"\w* \w ninguém|strong="G5100"\w* \w os engane|strong="G4771,G4105"\w*\f + \fr 13.5: \ft Variante: RP traz "respondendo-lhes, começou a dizer" (ἀποκριθεὶς αὐτοῖς ἤρξατο λέγειν) em lugar de "começou a lhes dizer"\f*.\x - \xo 13:5 \xt MAT 24:4; LUK 21:8; MAT 24:1; EPH 5:6; COL 2:8; 2JN 1:8\x*
\v 6 \w Muitos|strong="G4183"\w* \w virão|strong="G2064"\w* \w em meu nome|strong="G1909,G3588,G3686,G3165"\w*, \w dizendo|strong="G3004"\w*: ‘\w Sou eu|strong="G1473,G1510"\w*’\f + \fr 13.6: \ft Lit.: ἐγώ εἰμι, literalmente "eu sou"\f*, \w e|strong="G2532"\w* \w enganarão|strong="G4105"\w* \w a muitos|strong="G4183"\w*.\x - \xo 13:6 \xt MAT 24:5; LUK 21:8; MAT 24:1; MAT 24:4; 1JN 2:18; MRK 13:22\x*
\v 7 \w Mas|strong="G1161"\w*, \w quando|strong="G3752"\w* \w ouvirem de|strong="G191"\w* \w guerras|strong="G4171"\w* \w e|strong="G2532"\w* \w rumores|strong="G189"\w* \w de guerras|strong="G4171"\w*, \w não se alarmem|strong="G3361,G2360"\w*; \w é necessário|strong="G1163"\w* \w que aconteçam|strong="G1096"\w*, \w mas|strong="G235"\w* \w ainda não|strong="G3768"\w* \w é o fim|strong="G3588,G5056"\w*.\f + \fr 13.7: \ft Acréscimo: verbo ser/estar suprido em “é o fim”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:7 \xt MAT 24:6; LUK 21:9; MAT 24:1; 2TH 2:2; JHN 14:27; PSA 112:7\x*
\v 8 \w Pois|strong="G1063"\w* \w se levantará|strong="G1453"\w* \w nação|strong="G1484"\w* \w contra nação|strong="G1909,G1484"\w* \w e|strong="G2532"\w* \w reino|strong="G932"\w* \w contra reino|strong="G1909,G932"\w*; \w haverá|strong="G1510"\w* \w terremotos|strong="G4578"\w* \w em vários lugares|strong="G2596,G5117"\w*; \w haverá|strong="G1510"\w* \w fomes|strong="G3042"\w*. \w Isto é|strong="G3778"\w* \w o princípio|strong="G746"\w* \w das dores de parto|strong="G5604"\w*.\f + \fr 13.8: \ft Lit.: ὠδίν, "dor de parto"\f*\f + \fr 13.8: \ft Variante: TR e Byz (e RP) acrescentam "e perturbações" (καὶ ταραχαί) depois de "fomes"; RP também traz "e" (καί) antes de "haverá" e "princípios" (ἀρχαί), no plural, em lugar de "princípio"\f*\f + \fr 13.8: \ft Acréscimo: verbo ser/estar suprido em “Isto é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:8 \xt MAT 24:7; MAT 24:8; LUK 21:10; MAT 24:6; MAT 24:1; ISA 29:6\x*
\v 9 \w Mas|strong="G1161"\w* \w vocês|strong="G4771"\w*, \w cuidem|strong="G991"\w* \w de si mesmos|strong="G1438"\w*: \w entregarão vocês|strong="G3860,G4771"\w* \w a tribunais|strong="G1519,G4892"\w*\f + \fr 13.9: \ft Lit.: συνέδρια, "conselhos"; aqui, tribunais locais\f* \w e|strong="G2532"\w*, \w nas sinagogas|strong="G1519,G4864"\w*, \w serão espancados|strong="G1194"\w*; \w e|strong="G2532"\w* \w diante de governadores|strong="G1909,G2232"\w* \w e|strong="G2532"\w* \w reis|strong="G935"\w* \w comparecerão|strong="G2476"\w* \w por minha causa|strong="G1752,G1473"\w*, \w como testemunho|strong="G1519,G3142"\w* \w a eles|strong="G846"\w*.\x - \xo 13:9 \xt MAT 10:18; MAT 10:17; MAT 24:9; MAT 5:11; MAT 24:1; 1TI 4:16\x*
\v 10 \w E|strong="G2532"\w* \w é necessário que|strong="G1163"\w* \w primeiro|strong="G4413"\w* \w seja proclamada|strong="G2784"\w* \w a boa notícia|strong="G3588,G2098"\w* \w a todas|strong="G1519,G3956"\w* \w as nações|strong="G3588,G1484"\w*.\x - \xo 13:10 \xt MRK 16:15; MAT 24:14; MAT 24:9; MAT 24:1; ISA 52:7; COL 1:23\x*
\v 11 \w E|strong="G2532"\w*, \w quando|strong="G3752"\w* \w os levarem|strong="G71,G4771"\w* \w para entregá-los|strong="G3860"\w*, \w não se preocupem de antemão|strong="G3361,G4305"\w* \w com o que|strong="G5101"\w* \w vão falar|strong="G2980"\w*, \w mas|strong="G235"\w* \w o que|strong="G3739,G1437"\w* \w lhes for dado|strong="G1325,G4771"\w* \w naquela hora|strong="G1722,G1565,G3588,G5610"\w*, \w isso|strong="G3778"\w* \w falem|strong="G2980"\w*; \w pois|strong="G1063"\w* \w não são|strong="G3756,G1510"\w* \w vocês|strong="G4771"\w* \w os que falam|strong="G3588,G2980"\w*, \w mas|strong="G235"\w* \w o Espírito|strong="G3588,G4151"\w* \w Santo|strong="G3588,G40"\w*.\f + \fr 13.11: \ft Variante: TR e Byz (e RP) acrescentam "nem pensem no que dizer" (μηδὲ μελετᾶτε) depois de "vão falar"; RP também começa com "Mas quando" (Ὅταν δέ) e traz outra forma de "levarem" (ἀγάγωσιν)\f*\x - \xo 13:11 \xt MAT 10:19; MAT 24:9; LUK 21:14; MAT 24:1; LUK 12:11; MAT 6:25\x*
\v 12 \w E|strong="G2532"\w* \w o irmão|strong="G80"\w* \w entregará|strong="G3860"\w* \w o irmão|strong="G80"\w* \w à morte|strong="G1519,G2288"\w*, \w e|strong="G2532"\w* \w o pai|strong="G3962"\w*, \w o filho|strong="G5043"\w*; \w e|strong="G2532"\w* \w os filhos|strong="G5043"\w* \w se levantarão|strong="G1881"\w* \w contra os pais|strong="G1909,G1118"\w* \w e|strong="G2532"\w* \w os farão morrer|strong="G2289,G846"\w*.\x - \xo 13:12 \xt MAT 10:21; LUK 21:16; MAT 24:9; MAT 24:1; MAT 10:19; MAT 10:35\x*
\v 13 \w E|strong="G2532"\w* \w vocês serão|strong="G1510"\w* \w odiados|strong="G3404"\w* \w por todos|strong="G5259,G3956"\w* \w por causa|strong="G1223"\w* \w do meu nome|strong="G3588,G3686,G3165"\w*. \w Mas|strong="G1161"\w* \w quem|strong="G3588"\w* \w perseverar|strong="G5278"\w* \w até o fim|strong="G1519,G5056"\w*, \w esse|strong="G3778"\w* \w será salvo|strong="G4982"\w*.\x - \xo 13:13 \xt MAT 10:22; MAT 24:13; LUK 21:17; MAT 24:9; MAT 5:11; REV 2:10\x*
\p
\v 14 \w Mas|strong="G1161"\w*, \w quando|strong="G3752"\w* \w virem|strong="G1492"\w* \w a abominação|strong="G3588,G946"\w* \w da desolação|strong="G3588,G2050"\w* \w de pé|strong="G2476"\w*\f + \fr 13.14: \ft Nota cultural: expressão que vem do livro de Daniel (9:27; 11:31; 12:11)\f*\f + \fr 13.14: \ft Lit.: ἑστηκότα está no masculino, e βδέλυγμα é neutro; a construção chama a atenção e pode indicar uma pessoa, mas o texto não diz quem\f* \w onde|strong="G3699"\w* \w não deve|strong="G3756,G1163"\w* — \w quem lê|strong="G3588,G314"\w* \w entenda|strong="G3539"\w* — \w então|strong="G5119"\w* \w os que estão|strong="G3588,G1722"\w* \w na Judeia|strong="G3588,G2449"\w* \w fujam|strong="G5343"\w* \w para os montes|strong="G1519,G3588,G3735"\w*\f + \fr 13.14: \ft Variante: TR e Byz (e RP) acrescentam "de que falou o profeta Daniel" (τὸ ῥηθὲν ὑπὸ Δανιὴλ τοῦ προφήτου) depois de "desolação"\f*;\f + \fr 13.14: \ft Acréscimo: “os que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 13:14 \xt MAT 24:15; LUK 21:20; MAT 24:16; MAT 24:1; DAN 12:11; DAN 9:27\x*
\v 15 \w quem está|strong="G3588"\w* \w no terraço|strong="G1909,G3588,G1430"\w* \w não desça|strong="G3361,G2597"\w* \w nem entre|strong="G3366,G1525"\w* \w para tirar|strong="G142"\w* \w algo|strong="G5100"\w* \w da sua casa|strong="G1537,G3588,G3614,G846"\w*;\f + \fr 13.15: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam "para dentro da casa" (εἰς τὴν οἰκίαν) depois de "desça"\f*\f + \fr 13.15: \ft Acréscimo: “quem está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 13:15 \xt MAT 24:17; LUK 17:31; MAT 24:1; HEB 11:7; MAL 4:6; MRK 14:52\x*
\v 16 \w e|strong="G2532"\w* \w quem está|strong="G3588"\w* \w no campo|strong="G1519,G3588,G68"\w* \w não volte|strong="G3361,G1994"\w* \w para trás|strong="G1519,G3588,G3694"\w* \w para pegar|strong="G142"\w* \w o seu manto|strong="G3588,G2440,G846"\w*.\f + \fr 13.16: \ft Acréscimo: “quem está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 13:16 \xt MAT 24:18; LUK 17:31; MAT 24:1; MAT 24:17; MAL 4:6; MRK 14:52\x*
\v 17 \w Ai|strong="G3759"\w* \w das que|strong="G3588"\w* \w estiverem grávidas|strong="G1722,G1064,G2192"\w* \w e|strong="G2532"\w* \w das que|strong="G3588"\w* \w estiverem amamentando|strong="G2337"\w* \w naqueles dias|strong="G1722,G1565,G3588,G2250"\w*!\x - \xo 13:17 \xt MAT 24:19; LUK 21:23; MAT 24:1; LUK 23:29; MAL 4:6; LAM 4:10\x*
\v 18 \w Orem|strong="G4336"\w* \w para que|strong="G2443"\w* \w não aconteça|strong="G3361,G1096"\w* \w no inverno|strong="G5494"\w*.\f + \fr 13.18: \ft Variante: TR e Byz (e RP) acrescentam "a fuga de vocês" (ἡ φυγὴ ὑμῶν) como sujeito: "que a fuga de vocês não aconteça no inverno"\f*\x - \xo 13:18 \xt MAT 24:20; MAT 24:1; LUK 23:29; MAT 24:19; MAL 4:6\x*
\v 19 \w Pois|strong="G1063"\w* \w aqueles dias|strong="G3588,G2250,G1565"\w* \w serão|strong="G1510"\w* \w uma aflição|strong="G2347"\w* \w como não houve|strong="G3634,G3756,G1096,G5108"\w* \w desde o princípio|strong="G575,G746"\w* \w da criação|strong="G2937"\w* \w que Deus criou|strong="G3739,G2936,G3588,G2316"\w* \w até agora|strong="G2193,G3588,G3568"\w*, \w e|strong="G2532"\w* \w de modo nenhum haverá|strong="G3756,G3361,G1096"\w*.\x - \xo 13:19 \xt MAT 24:21; MRK 10:6; GEN 1:1; DAN 12:1; MAT 24:1; JER 30:7\x*
\v 20 \w E|strong="G2532"\w*, \w se|strong="G1487"\w* \w o Senhor|strong="G2962"\w* \w não tivesse encurtado|strong="G3361,G2856"\w* \w os dias|strong="G3588,G2250"\w*, \w nenhuma carne|strong="G3756,G3956,G4561"\w* \w seria salva|strong="G302,G4982"\w*\f + \fr 13.20: \ft Lit.: πᾶσα σάρξ, literalmente "toda carne"; expressão semítica para "todo ser vivo" ou "toda pessoa"\f*; \w mas|strong="G235"\w* \w por causa|strong="G1223"\w* \w dos escolhidos|strong="G3588,G1588"\w* \w que ele escolheu|strong="G3739,G1586"\w*, \w encurtou|strong="G2856"\w* \w os dias|strong="G3588,G2250"\w*.\x - \xo 13:20 \xt MAT 24:22; MAT 24:1; 1PE 1:2; ISA 65:8; MAL 4:6; ZEC 13:8\x*
\v 21 \w E|strong="G2532"\w* \w então|strong="G5119"\w*, \w se alguém|strong="G1437,G5100"\w* \w disser a vocês|strong="G4771,G2036"\w*: ‘\w Vejam|strong="G2396"\w*, \w aqui está|strong="G5602"\w* \w o Cristo|strong="G3588,G5547"\w*’; ‘\w Vejam|strong="G2396"\w*, \w ali está|strong="G1563"\w*’, \w não creiam|strong="G3361,G4100"\w*;\f + \fr 13.21: \ft Variante: RP omite o "e" (καί) do começo, traz "Eis" (ἰδού) em lugar de "Vejam" (ἴδε) nas duas ocorrências; Tregelles, TR e Byz (e RP) acrescentam "ou" (ἤ) depois de "o Cristo"\f*\f + \fr 13.21: \ft Acréscimo: verbo ser/estar suprido em “aqui está”, “ali está”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:21 \xt MAT 24:23; LUK 17:21; JHN 10:42; LUK 17:23; MAT 24:1; 1JN 4:1\x*
\v 22 \w pois|strong="G1063"\w* \w se levantarão|strong="G1453"\w* \w falsos cristos|strong="G5580"\w* \w e|strong="G2532"\w* \w falsos profetas|strong="G5578"\w* \w e|strong="G2532"\w* \w darão|strong="G1325"\w* \w sinais|strong="G4592"\w* \w e|strong="G2532"\w* \w prodígios|strong="G5059"\w* \w para enganar|strong="G4314,G3588,G635"\w*, \w se possível|strong="G1487,G1415"\w*, \w os escolhidos|strong="G3588,G1588"\w*.\x - \xo 13:22 \xt MAT 24:24; JHN 4:48; MAT 24:11; MAT 7:15; EPH 6:11; MAT 24:1\x*
\v 23 \w Mas|strong="G1161"\w* \w vocês|strong="G4771"\w*, \w tomem cuidado|strong="G991"\w*; \w eu disse de antemão|strong="G4280"\w* \w a vocês|strong="G4771"\w* \w tudo|strong="G3956"\w*.\f + \fr 13.23: \ft Variante: TR e Byz (e RP) acrescentam "Olhem" (ἰδού) antes de "eu disse de antemão"\f*\x - \xo 13:23 \xt MAT 7:15; MAT 24:1; JHN 16:4; LUK 21:8; 2JN 1:8; MRK 13:33\x*
\p
\v 24 \w Mas|strong="G235"\w*, \w naqueles dias|strong="G1722,G1565,G3588,G2250"\w*, \w depois daquela|strong="G3326,G3588,G1565"\w* \w aflição|strong="G2347"\w*, \w o sol|strong="G3588,G2246"\w* \w escurecerá|strong="G4654"\w*, \w e|strong="G2532"\w* \w a lua|strong="G3588,G4582"\w* \w não dará|strong="G3756,G1325"\w* \w o seu brilho|strong="G3588,G5338,G846"\w*,\f + \fr 13.24: \ft Nota cultural: linguagem que lembra Isaías 13:10 e 34:4\f*\x - \xo 13:24 \xt ISA 13:10; ISA 34:4; MAT 24:29; REV 8:12; ACT 2:20; JER 4:23\x*
\v 25 \w e|strong="G2532"\w* \w as estrelas|strong="G3588,G792"\w* \w estarão caindo|strong="G1510,G4098"\w* \w do céu|strong="G1537,G3588,G3772"\w*, \w e|strong="G2532"\w* \w os poderes|strong="G3588,G1411"\w* \w que estão|strong="G3588"\w* \w nos céus|strong="G1722,G3588,G3772"\w* \w serão abalados|strong="G4531"\w*.\f + \fr 13.25: \ft Acréscimo: “que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 13:25 \xt MAT 24:29; LUK 21:26; REV 6:13; JER 4:23; MAT 24:1; REV 6:12\x*
\v 26 \w E|strong="G2532"\w* \w então|strong="G5119"\w* \w verão|strong="G3700"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w vindo|strong="G2064"\w* \w nas nuvens|strong="G1722,G3507"\w* \w com muito poder|strong="G3326,G1411,G4183"\w* \w e|strong="G2532"\w* \w glória|strong="G1391"\w*;\f + \fr 13.26: \ft Nota cultural: imagem que lembra Daniel 7:13\f*\x - \xo 13:26 \xt DAN 7:13; LUK 21:27; MRK 14:62; MAT 24:30; REV 1:7; MAT 26:64\x*
\v 27 \w e|strong="G2532"\w* \w então|strong="G5119"\w* \w enviará|strong="G649"\w* \w os anjos|strong="G3588,G32"\w* \w e|strong="G2532"\w* \w reunirá|strong="G1996"\w* \w os escolhidos|strong="G3588,G1588"\w* \w dos quatro|strong="G1537,G3588,G5064"\w* \w ventos|strong="G417"\w*, \w da extremidade|strong="G575,G206"\w* \w da terra|strong="G1093"\w* \w até a extremidade|strong="G2193,G206"\w* \w do céu|strong="G3772"\w*.\f + \fr 13.27: \ft Variante: RP acrescenta "dele" (αὐτοῦ) depois de "anjos"; WH, NA28 e RP também o acrescentam depois de "escolhidos" ("os seus escolhidos"), o que Tregelles não traz\f*\x - \xo 13:27 \xt MAT 24:31; MAT 24:1; MRK 13:32; REV 7:1; COL 3:12; 2TH 2:1\x*
\p
\v 28 \w Mas|strong="G1161"\w* \w da figueira|strong="G575,G3588,G4808"\w* \w aprendam|strong="G3129"\w* \w a parábola|strong="G3588,G3850"\w*: \w quando|strong="G3752"\w* \w já|strong="G2235"\w* \w o seu ramo|strong="G3588,G2798,G846"\w* \w se torna|strong="G1096"\w* \w tenro|strong="G527"\w* \w e|strong="G2532"\w* \w brota|strong="G1631"\w* \w as folhas|strong="G3588,G5444"\w*, \w vocês sabem|strong="G1097"\w* \w que|strong="G3754"\w* \w o verão|strong="G3588,G2330"\w* \w está próximo|strong="G1451,G1510"\w*.\x - \xo 13:28 \xt MAT 24:32; MAT 24:1; LUK 21:29\x*
\v 29 \w Assim|strong="G3779"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w*, \w quando|strong="G3752"\w* \w virem|strong="G1492"\w* \w estas coisas|strong="G3778"\w* \w acontecendo|strong="G1096"\w*, \w vocês sabem|strong="G1097"\w* \w que|strong="G3754"\w* \w está próximo|strong="G1451,G1510"\w*\f + \fr 13.29: \ft Lit.: o sujeito de "está próximo" não está expresso no grego\f*, \w às portas|strong="G1909,G2374"\w*.\x - \xo 13:29 \xt MAT 24:33; LUK 21:31; MAT 24:1; MAT 24:32; HEB 10:25; JAS 5:9\x*
\v 30 \w Em verdade|strong="G281"\w* \w digo a vocês|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w esta geração|strong="G3588,G1074,G3778"\w*\f + \fr 13.30: \ft Lit.: γενεά, "geração"; também "raça, linhagem"\f* \w de modo nenhum|strong="G3756,G3361"\w* \w passará|strong="G3928"\w* \w até que|strong="G3360,G3739"\w* \w todas estas coisas|strong="G3778,G3956"\w* \w aconteçam|strong="G1096"\w*.\x - \xo 13:30 \xt MAT 24:34; LUK 21:32; MAT 23:36; MAT 5:18; MAT 24:1; HEB 10:25\x*
\v 31 \w O céu|strong="G3588,G3772"\w* \w e|strong="G2532"\w* \w a terra|strong="G3588,G1093"\w* \w passarão|strong="G3928"\w*, \w mas|strong="G1161"\w* \w as minhas palavras|strong="G3588,G3056,G3165"\w* \w de modo nenhum|strong="G3756,G3361"\w* \w passarão|strong="G3928"\w*.\x - \xo 13:31 \xt LUK 21:33; MAT 24:35; MAT 5:18; 2PE 3:10; ISA 40:8; MAT 24:34\x*
\v 32 \w Mas|strong="G1161"\w* \w a respeito|strong="G4012"\w* \w daquele dia|strong="G3588,G2250,G1565"\w* \w ou|strong="G2228"\w* \w da hora|strong="G3588,G5610"\w* \w ninguém sabe|strong="G3762,G6063"\w*, \w nem|strong="G3761"\w* \w os anjos|strong="G3588,G32"\w* \w no céu|strong="G1722,G3772"\w*, \w nem|strong="G3761"\w* \w o Filho|strong="G3588,G5207"\w*, \w a não ser|strong="G1487,G3361"\w* \w o Pai|strong="G3588,G3962"\w*.\x - \xo 13:32 \xt MAT 24:36; MAT 25:13; ACT 1:7; MAT 24:1; REV 3:3; 1TH 5:1\x*
\p
\v 33 \w Tomem cuidado|strong="G991"\w*, \w fiquem acordados|strong="G69"\w*, \w pois|strong="G1063"\w* \w não sabem|strong="G3756,G6063"\w* \w quando|strong="G4219"\w* \w é o tempo|strong="G3588,G2540,G1510"\w*.\f + \fr 13.33: \ft Variante: Tyndale, Tregelles, TR e Byz (e RP) acrescentam "e orem" (καὶ προσεύχεσθε) depois de "fiquem acordados"\f*\x - \xo 13:33 \xt EPH 6:18; LUK 21:36; 1CO 16:13; COL 4:2; MAT 24:1; LUK 12:40\x*
\v 34 \w É como|strong="G5613"\w* \w um homem|strong="G444"\w* \w que viajou para o exterior|strong="G590"\w*, \w deixando|strong="G863"\w* \w a sua casa|strong="G3588,G3614,G846"\w* \w e|strong="G2532"\w* \w dando|strong="G1325"\w* \w aos seus escravos|strong="G3588,G1401,G846"\w* \w a autoridade|strong="G3588,G1849"\w*, \w a cada um|strong="G1538"\w* \w a sua tarefa|strong="G3588,G2041,G846"\w*, \w e|strong="G2532"\w* \w ao porteiro|strong="G3588,G2377"\w* \w ordenou|strong="G1781"\w* \w que vigiasse|strong="G2443,G1127"\w*.\f + \fr 13.34: \ft Acréscimo: verbo ser/estar suprido em “É como”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\f + \fr 13.34: \ft Tradução: ἔργον (ἔργον, G2041) está aqui como “a sua tarefa”; o termo pode ser “obra”, “trabalho”, “ação”, “feito” ou “ocupação”, e o contexto decide.\f*\x - \xo 13:34 \xt 1CO 16:13; MAT 25:14; MAT 24:1; LUK 12:40; MAT 26:41; REV 16:15\x*
\v 35 \w Vigiem|strong="G1127"\w*, \w portanto|strong="G3767"\w*, \w pois|strong="G1063"\w* \w não sabem|strong="G3756,G6063"\w* \w quando|strong="G4219"\w* \w vem|strong="G2064"\w* \w o dono|strong="G3588,G2962"\w* \w da casa|strong="G3588,G3614"\w*: \w se|strong="G2228"\w* \w ao anoitecer|strong="G3796"\w*, \w ou|strong="G2228"\w* \w à meia-noite|strong="G3317"\w*, \w ou|strong="G2228"\w* \w ao cantar do galo|strong="G219"\w*, \w ou|strong="G2228"\w* \w de manhã cedo|strong="G4404"\w*;\f + \fr 13.35: \ft Tradução: κύριος (κύριος, G2962) está aqui como “o dono”; o termo pode ser “Senhor” (Deus ou Jesus), “senhor” (título de respeito), “dono” ou “patrão”, e o contexto decide.\f*\x - \xo 13:35 \xt 1CO 16:13; ROM 13:11; MAT 24:1; LUK 12:40; MAT 26:41; REV 16:15\x*
\v 36 \w para que não|strong="G3361"\w*, \w vindo|strong="G2064"\w* \w de repente|strong="G1810"\w*, \w os encontre|strong="G2147,G4771"\w* \w dormindo|strong="G2518"\w*.\x - \xo 13:36 \xt MRK 14:40; MRK 14:37; 1CO 16:13; ROM 13:11; MAT 24:1; LUK 12:40\x*
\v 37 \w E|strong="G1161"\w* \w o que|strong="G3739"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*, \w digo|strong="G3004"\w* \w a todos|strong="G3956"\w*: \w vigiem|strong="G1127"\w*.”\x - \xo 13:37 \xt LUK 11:9; 1CO 16:13; ROM 13:11; LUK 21:36; MAT 24:1; MAT 26:41\x*
\c 14
\p
\v 1 \w Faltavam|strong="G1510"\w* \w dois dias|strong="G3326,G1417,G2250"\w*\f + \fr 14.1: \ft Lit.: μετὰ δύο ἡμέρας, literalmente "depois de dois dias"; indica que faltavam dois dias\f* \w para a Páscoa|strong="G3588,G3957"\w* \w e|strong="G2532"\w* \w os Pães sem Fermento|strong="G3588,G106"\w*\f + \fr 14.1: \ft Nota cultural: a Páscoa e a festa dos Pães sem Fermento eram festas judaicas ligadas e celebradas em seguida; Marcos as une em 14:12\f*. \w E|strong="G2532"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os escribas|strong="G3588,G1122"\w* \w procuravam|strong="G2212"\w* \w como|strong="G4459"\w*, \w prendendo-o|strong="G846,G2902"\w* \w com engano|strong="G1722,G1388"\w*, \w poderiam matá-lo|strong="G615"\w*;\x - \xo 14:1 \xt LUK 22:1; MRK 11:18; MAT 26:2; EXO 12:6-20; JHN 13:1; DEU 16:1-8\x*
\v 2 \w pois|strong="G1063"\w* \w diziam|strong="G3004"\w*: “\w Não|strong="G3361"\w* \w durante a festa|strong="G1722,G3588,G1859"\w*, \w para que não|strong="G4218,G3361"\w* \w haja|strong="G1510"\w* \w tumulto|strong="G2351"\w* \w do povo|strong="G3588,G2992"\w*.”\x - \xo 14:2 \xt MAT 26:5; MAT 26:2; JHN 12:19; JHN 7:40; LAM 3:27; LUK 20:6\x*
\p
\v 3 \w E|strong="G2532"\w*, \w estando ele|strong="G1510,G846"\w* \w em Betânia|strong="G1722,G963"\w*, \w na casa|strong="G1722,G3588,G3614"\w* \w de Simão|strong="G4613"\w*, \w o leproso|strong="G3588,G3015"\w*, \w enquanto estava reclinado à mesa|strong="G2621,G846"\w*, \w veio|strong="G2064"\w* \w uma mulher|strong="G1135"\w* \w com um frasco de alabastro|strong="G2192,G211"\w* \w de perfume|strong="G3464"\w* \w de nardo|strong="G3487"\w* \w puro|strong="G4101"\w*\f + \fr 14.3: \ft Lit.: πιστικῆς, de sentido incerto: "puro, genuíno" ou "líquido"\f* \w muito caro|strong="G4185"\w*; \w quebrando|strong="G4937"\w* \w o frasco|strong="G3588,G211"\w*, \w derramou-o|strong="G2708"\w* \w sobre a cabeça|strong="G3588,G2776"\w* \w dele|strong="G846"\w*.\x - \xo 14:3 \xt MAT 26:6; LUK 7:37; JHN 12:3; MAT 26:7; LUK 7:36; JHN 12:1\x*
\v 4 \w Mas|strong="G1161"\w* \w alguns estavam|strong="G1510,G5100"\w* \w indignados|strong="G23"\w* \w entre si|strong="G4314,G1438"\w*: “\w Para que|strong="G1519,G5101"\w* \w foi feito|strong="G1096"\w* \w esse desperdício|strong="G3588,G684,G3778"\w* \w do perfume|strong="G3588,G3464"\w*?\x - \xo 14:4 \xt MAT 26:8; JHN 12:3; LUK 7:36; MAT 26:6; LUK 7:37; JHN 12:1\x*
\v 5 \w Pois|strong="G1063"\w* \w esse perfume|strong="G3778,G3588,G3464"\w* \w poderia|strong="G1410"\w* \w ser vendido|strong="G4097"\w* \w por mais de|strong="G1883"\w* \w trezentos|strong="G5145"\w* \w denários|strong="G1220"\w* \w e|strong="G2532"\w* \w ser dado|strong="G1325"\w* \w aos pobres|strong="G3588,G4434"\w*.” \w E|strong="G2532"\w* \w a repreendiam com dureza|strong="G1690,G846"\w*.\x - \xo 14:5 \xt JHN 12:5; MAT 26:9; JHN 12:3; LUK 7:36; MAT 26:6; LUK 7:37\x*
\v 6 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Deixem-na|strong="G863,G846"\w*. \w Por que|strong="G5101"\w* \w a incomodam|strong="G846,G2873,G3930"\w*? \w Ela fez|strong="G2038"\w* \w uma boa|strong="G2570"\w* \w obra|strong="G2041"\w* \w comigo|strong="G1722,G1473"\w*.\x - \xo 14:6 \xt MAT 26:10; TIT 2:7; JHN 6:28; JHN 12:3; LUK 7:36; MAT 26:6\x*
\v 7 \w Pois|strong="G1063"\w* \w os pobres|strong="G3588,G4434"\w* \w vocês sempre têm|strong="G3842,G2192"\w* \w consigo|strong="G3326,G1438"\w*, \w e|strong="G2532"\w* \w quando|strong="G3752"\w* \w quiserem|strong="G2309"\w* \w podem fazer bem|strong="G1410,G2095,G4160"\w* \w a eles|strong="G846"\w*, \w mas|strong="G1161"\w* \w a mim|strong="G1473"\w* \w nem sempre|strong="G3756,G3842"\w* \w vocês têm|strong="G2192"\w*.\f + \fr 14.7: \ft Variante: WH acrescenta "sempre" (πάντοτε) depois de "a eles"; RP traz o acusativo (αὐτούς) em lugar do dativo (αὐτοῖς)\f*\x - \xo 14:7 \xt JHN 12:8; MAT 26:11; JHN 12:3; PRO 3:9; LUK 7:36; MAT 26:6\x*
\v 8 \w Ela fez|strong="G4160"\w* \w o que|strong="G3739"\w* \w pôde|strong="G2192"\w*; \w antecipou-se|strong="G4301"\w* \w a ungir com perfume|strong="G3462"\w* \w o meu corpo|strong="G3588,G4983,G3165"\w* \w para o sepultamento|strong="G1519,G3588,G1780"\w*.\x - \xo 14:8 \xt JHN 12:3; PRO 3:9; LUK 7:36; MAT 26:6; LUK 7:37; 2CO 8:12\x*
\v 9 \w E|strong="G1161"\w* \w em verdade|strong="G281"\w* \w digo a vocês|strong="G3004,G4771"\w*: \w onde quer que|strong="G3699,G1437"\w* \w seja proclamada|strong="G2784"\w* \w a boa notícia|strong="G3588,G2098"\w* \w no mundo inteiro|strong="G1519,G3650,G3588,G2889"\w*, \w e|strong="G2532"\w* \w o que|strong="G3739"\w* \w ela|strong="G3778"\w* \w fez|strong="G4160"\w* \w será contado|strong="G2980"\w* \w em memória|strong="G1519,G3422"\w* \w dela|strong="G846"\w*.”\f + \fr 14.9: \ft Variante: RP acrescenta "esta" (τοῦτο) depois de "boa notícia" e omite "E" (δέ)\f*\x - \xo 14:9 \xt MAT 26:13; MRK 16:15; MAT 24:14; JHN 12:3; LUK 7:36; MAT 26:6\x*
\v 10 \w E|strong="G2532"\w* \w Judas|strong="G2455"\w* \w Iscariotes|strong="G2469"\w*, \w um|strong="G3588,G1520"\w* \w dos Doze|strong="G3588,G1427"\w*, \w foi|strong="G565"\w* \w aos chefes dos sacerdotes|strong="G4314,G3588,G749"\w* \w para|strong="G2443"\w* \w entregá-lo|strong="G846,G3860"\w* \w a eles|strong="G846"\w*.\x - \xo 14:10 \xt MAT 26:14; MRK 3:19; LUK 22:3; JHN 6:71; MAT 10:4; JHN 12:4\x*
\v 11 \w Mas|strong="G1161"\w* \w eles|strong="G3588"\w*, \w ao ouvirem|strong="G191"\w*, \w se alegraram|strong="G5463"\w* \w e|strong="G2532"\w* \w prometeram|strong="G1861"\w* \w dar-lhe|strong="G846,G1325"\w* \w prata|strong="G694"\w*\f + \fr 14.11: \ft Lit.: ἀργύριον, "prata"; também "dinheiro"\f*. \w E|strong="G2532"\w* \w procurava|strong="G2212"\w* \w como|strong="G4459"\w* \w o entregaria|strong="G846,G3860"\w* \w no momento oportuno|strong="G2122"\w*.\x - \xo 14:11 \xt LUK 22:3; MAT 26:14; ROM 1:32; ZEC 11:12; PRO 3:9; 1TI 6:10\x*
\p
\v 12 \w E|strong="G2532"\w* \w no primeiro dia|strong="G3588,G4413,G2250"\w* \w dos Pães sem Fermento|strong="G3588,G106"\w*, \w quando|strong="G3753"\w* \w sacrificavam|strong="G2380"\w* \w a Páscoa|strong="G3588,G3957"\w*\f + \fr 14.12: \ft Lit.: πάσχα, "Páscoa"; aqui, o cordeiro pascal, que era sacrificado; mais adiante, a refeição pascal\f*, \w os seus discípulos|strong="G3588,G3101,G846"\w* \w lhe disseram|strong="G3004,G846"\w*: “\w Onde|strong="G4226"\w* \w você quer|strong="G2309"\w* \w que, indo|strong="G565"\w*, \w preparemos|strong="G2090"\w*, \w para que|strong="G2443"\w* \w você coma|strong="G5315"\w* \w a Páscoa|strong="G3588,G3957"\w*?”\x - \xo 14:12 \xt MAT 26:17; LUK 22:7; 1CO 5:7; LUK 22:9; EXO 12:21; EXO 12:6\x*
\v 13 \w E|strong="G2532"\w* \w enviou|strong="G649"\w* \w dois|strong="G1417"\w* \w dos seus discípulos|strong="G3588,G3101,G846"\w* \w e|strong="G2532"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Vão|strong="G5217"\w* \w à cidade|strong="G1519,G3588,G4172"\w*, \w e|strong="G2532"\w* \w virá ao encontro|strong="G528"\w* \w de vocês|strong="G4771"\w* \w um homem|strong="G444"\w* \w carregando|strong="G941"\w* \w um jarro|strong="G2765"\w* \w de água|strong="G5204"\w*; \w sigam-no|strong="G190,G846"\w*,\x - \xo 14:13 \xt LUK 22:10; MAT 26:18; 1SA 9:15; EXO 12:21; JHN 2:7; LUK 22:7\x*
\v 14 \w e|strong="G2532"\w* \w onde quer que|strong="G3699,G1437"\w* \w entrar|strong="G1525"\w*, \w digam|strong="G2036"\w* \w ao dono da casa|strong="G3588,G3617"\w*: ‘\w O Mestre|strong="G3588,G1320"\w* \w diz|strong="G3004"\w*: \w Onde|strong="G4226"\w* \w está|strong="G1510"\w* \w o meu aposento|strong="G3588,G2646,G3165"\w*\f + \fr 14.14: \ft Lit.: κατάλυμα, "lugar para pousar, sala de hóspedes"\f*, \w onde|strong="G3699"\w* \w eu comerei|strong="G5315"\w* \w a Páscoa|strong="G3588,G3957"\w* \w com os meus discípulos|strong="G3326,G3588,G3101,G3165"\w*?’\x - \xo 14:14 \xt LUK 22:11; MAT 26:17; MAT 26:18; 1SA 9:15; EXO 12:21; JHN 2:7\x*
\v 15 \w E|strong="G2532"\w* \w ele|strong="G846"\w* \w mostrará a vocês|strong="G4771,G1166"\w* \w uma grande sala no andar de cima|strong="G508,G3173"\w*, \w arrumada|strong="G4766"\w*\f + \fr 14.15: \ft Lit.: ἐστρωμένον, literalmente "estendido, forrado"\f* \add e\add* \w pronta|strong="G2092"\w*; \w e|strong="G2532"\w* \w ali|strong="G1563"\w* \w preparem|strong="G2090"\w* \w para nós|strong="G3165"\w*.”\f + \fr 14.15: \ft Acréscimo: “e” (em “cima arrumada e pronta e”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 14:15 \xt LUK 22:12; MAT 26:18; 1SA 9:15; ACT 1:13; MRK 11:3; EXO 12:21\x*
\v 16 \w E|strong="G2532"\w* \w os discípulos|strong="G3588,G3101"\w* \w saíram|strong="G1831"\w*, \w e|strong="G2532"\w* \w foram|strong="G2064"\w* \w à cidade|strong="G1519,G3588,G4172"\w*, \w e|strong="G2532"\w* \w encontraram|strong="G2147"\w* \w como|strong="G2531"\w* \w ele lhes disse|strong="G2036,G846"\w*, \w e|strong="G2532"\w* \w prepararam|strong="G2090"\w* \w a Páscoa|strong="G3588,G3957"\w*.\x - \xo 14:16 \xt LUK 22:13; LUK 22:8; MAT 26:18; MAT 26:17; MAT 26:19; 1SA 9:15\x*
\p
\v 17 \w E|strong="G2532"\w*, \w ao anoitecer|strong="G3798,G1096"\w*, \w veio|strong="G2064"\w* \w com os Doze|strong="G3326,G3588,G1427"\w*.\x - \xo 14:17 \xt MAT 26:20; LUK 22:14; JHN 2:7; PRO 3:9; JHN 13:21-26; LUK 22:21-23\x*
\v 18 \w E|strong="G2532"\w*, \w enquanto estavam reclinados à mesa|strong="G345,G846"\w* \w e|strong="G2532"\w* \w comiam|strong="G2068"\w*, \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Em verdade|strong="G281"\w* \w digo a vocês|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w um|strong="G1520"\w* \w de vocês|strong="G1537,G4771"\w* \w me entregará|strong="G3860,G3165"\w*, \w o que come|strong="G3588,G2068"\w* \w comigo|strong="G3326,G1473"\w*.”\x - \xo 14:18 \xt MAT 26:21; JHN 13:21; PSA 41:9; MAT 26:20; LUK 22:3; PRO 3:9\x*
\v 19 \w Começaram a|strong="G757"\w* \w se entristecer|strong="G3076"\w* \w e|strong="G2532"\w* \w dizer-lhe|strong="G3004,G846"\w*, \w um por um|strong="G1520,G2596"\w*: “\w Acaso sou eu|strong="G3385,G1473"\w*?”\f + \fr 14.19: \ft Variante: TR e Byz (e RP) acrescentam "E outro: Acaso sou eu?" (καὶ ἄλλος· μήτι ἐγώ;) no fim; Tregelles e RP começam com "E eles" (οἱ δέ)\f*\f + \fr 14.19: \ft Acréscimo: verbo ser/estar suprido em “Acaso sou eu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 14:19 \xt MAT 26:22; MAT 26:20; JHN 13:26; LUK 22:3; PRO 3:9; JHN 13:22\x*
\v 20 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Um|strong="G1520"\w* \w dos Doze|strong="G3588,G1427"\w*, \w o que mergulha|strong="G3588,G1686"\w* \w comigo|strong="G3326,G1473"\w* \w no prato|strong="G1519,G3588,G5165"\w*.\f + \fr 14.20: \ft Variante: WH acrescenta "único" (ἕν) antes de "prato", "no mesmo prato"; Tregelles, TR e Byz (e RP) trazem "um dentre os Doze" (εἷς ἐκ τῶν δώδεκα); RP acrescenta "respondendo" (ἀποκριθείς)\f*\x - \xo 14:20 \xt MAT 26:23; JHN 13:18; MAT 26:20; JHN 13:26; LUK 22:3; PRO 3:9\x*
\v 21 \w Pois|strong="G3754"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w de fato|strong="G3303"\w* \w vai|strong="G5217"\w*, \w como está escrito|strong="G2531,G1125"\w* \w a respeito dele|strong="G4012,G846"\w*; \w mas|strong="G1161"\w* \w ai|strong="G3759"\w* \w daquele homem|strong="G3588,G444,G1565"\w*\f + \fr 14.21: \ft Lit.: o mesmo termo, ἄνθρωπος, aparece em "Filho do Homem" e em "aquele homem"\f* \w por meio de quem|strong="G1223,G3739"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w é entregue|strong="G3860"\w*! \w Melhor seria|strong="G2570"\w* \w para ele|strong="G846"\w* \w se não tivesse nascido|strong="G1487,G3756,G1080"\w* \w aquele homem|strong="G3588,G444,G1565"\w*.”\f + \fr 14.21: \ft Acréscimo: verbo ser/estar suprido em “Melhor seria”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\f + \fr 14.21: \ft Tradução: καλὸν (καλός, G2570) está aqui como “Melhor seria”; o termo pode ser “bom”, “belo”, “nobre”, “útil” ou “adequado”, e o contexto decide.\f*\x - \xo 14:21 \xt MAT 26:24; ISA 53:1-12; MAT 26:20; MAT 18:6-7; PRO 3:9; ACT 4:27\x*
\p
\v 22 \w E|strong="G2532"\w*, \w enquanto comiam|strong="G2068,G846"\w*, \w tomando|strong="G2983"\w* \w pão|strong="G740"\w*, \w pronunciando a bênção|strong="G2127"\w*, \w o partiu|strong="G2806"\w*, \w e|strong="G2532"\w* \w o deu|strong="G1325"\w* \w a eles|strong="G846"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Tomem|strong="G2983"\w*; \w isto é|strong="G3778,G1510"\w* \w o meu corpo|strong="G3588,G4983,G3165"\w*.”\f + \fr 14.22: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam "Jesus" (ὁ Ἰησοῦς) depois de "tomando"; TR e Byz (e RP) acrescentam "comam" (φάγετε) depois de "Tomem"\f*\f + \fr 14.22: \ft Lit.: ἐστιν, “é”: o sentido do “é” (identidade, representação, presença) é discutido entre as tradições.\f*\x - \xo 14:22 \xt MAT 26:26; LUK 22:19; 1CO 10:16; LUK 24:30; MAT 14:19; ACT 27:35\x*
\v 23 \w E|strong="G2532"\w*, \w tomando|strong="G2983"\w* \w um cálice|strong="G4221"\w*, \w dando graças|strong="G2168"\w*, \w o deu|strong="G1325"\w* \w a eles|strong="G846"\w*, \w e|strong="G2532"\w* \w todos beberam|strong="G4095,G3956"\w* \w dele|strong="G1537,G846"\w*.\x - \xo 14:23 \xt MAT 26:27; LUK 22:17; JHN 18:11; MAT 20:22; MRK 10:39; LUK 22:19\x*
\v 24 \w E|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Isto é|strong="G3778,G1510"\w* \w o meu sangue|strong="G3588,G129,G3165"\w* \w da aliança|strong="G3588,G1242"\w*, \w que é derramado|strong="G3588,G1632"\w* \w em favor de|strong="G5228"\w* \w muitos|strong="G4183"\w*.\f + \fr 14.24: \ft Variante: TR e Byz (e RP) trazem "da nova aliança" (καινῆς διαθήκης); Tregelles e RP acrescentam "o" (τό) antes de "da aliança"; RP traz "por muitos" com περί e outra ordem (περὶ πολλῶν ἐκχυνόμενον)\f*\x - \xo 14:24 \xt MAT 26:28; LUK 22:20; HEB 13:20; HEB 9:20; LEV 17:11; JER 31:31\x*
\v 25 \w Em verdade|strong="G281"\w* \w digo a vocês|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w de modo nenhum|strong="G3756,G3361"\w* \w beberei|strong="G4095"\w* \w mais|strong="G2089,G3756"\w* \w do fruto|strong="G1537,G3588,G6013"\w* \w da videira|strong="G3588,G288"\w*, \w até aquele dia|strong="G2193,G3588,G2250,G1565"\w* \w em que|strong="G3752"\w* \add eu\add* \w o|strong="G846"\w* \w beber|strong="G4095"\w* \w novo|strong="G2537"\w* \w no reino|strong="G1722,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.”\f + \fr 14.25: \ft Acréscimo: “eu” (em “em que eu o beber”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 14:25 \xt MAT 26:29; LUK 22:18; MAT 26:26; 1CO 10:16; EXO 39:7; LUK 9:27\x*
\p
\v 26 \w E|strong="G2532"\w*, \w depois de cantarem um hino|strong="G5214"\w*, \w saíram|strong="G1831"\w* \w para o monte|strong="G1519,G3588,G3735"\w* \w das Oliveiras|strong="G3588,G1636"\w*.\x - \xo 14:26 \xt MAT 26:30; LUK 22:39; JHN 8:1; MAT 21:1; PSA 81:2\x*
\v 27 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Todos vocês|strong="G3956"\w* \w tropeçarão|strong="G4624"\w*, \w porque|strong="G3754"\w* \w está escrito|strong="G1125"\w*: ‘\w Ferirei|strong="G3960"\w* \w o pastor|strong="G3588,G4166"\w*, \w e|strong="G2532"\w* \w as ovelhas|strong="G3588,G4263"\w* \w serão dispersas|strong="G1287"\w*.’\f + \fr 14.27: \ft Nota cultural: citação de Zacarias 13:7\f*\f + \fr 14.27: \ft Variante: TR e Byz (e RP) acrescentam "em mim, nesta noite" (ἐν ἐμοὶ ἐν τῇ νυκτὶ ταύτῃ) depois de "tropeçarão"; RP também traz outra ordem em "as ovelhas serão dispersas"\f*\x - \xo 14:27 \xt ZEC 13:7; MAT 26:31; JHN 16:32; MRK 14:50; PRO 28:26; JHN 16:1\x*
\v 28 \w Mas|strong="G235"\w*, \w depois de|strong="G3326,G3588"\w* \w eu|strong="G3165"\w* \w ser ressuscitado|strong="G1453"\w*, \w irei adiante|strong="G4254"\w* \w de vocês|strong="G4771"\w* \w para a Galileia|strong="G1519,G3588,G1056"\w*.”\x - \xo 14:28 \xt MAT 26:32; MRK 16:7; MAT 28:7; MAT 26:31; MAT 28:16; MAT 28:10\x*
\v 29 \w Mas|strong="G1161"\w* \w Pedro|strong="G3588,G4074"\w* \w lhe disse|strong="G5346,G846"\w*: “\w Ainda que|strong="G1487,G2532"\w* \w todos|strong="G3956"\w* \w tropecem|strong="G4624"\w*, \w eu não|strong="G235,G3756,G1473"\w*.”\x - \xo 14:29 \xt MAT 26:33; LUK 22:33; PRO 28:26; MRK 14:68; JHN 13:36-38; JHN 13:37\x*
\v 30 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Em verdade|strong="G281"\w* \w digo a você|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w hoje|strong="G4594"\w*, \w nesta noite|strong="G3778,G3588,G3571"\w*, \w antes que|strong="G4250,G2228"\w* \w o galo|strong="G220"\w* \w cante|strong="G5455"\w* \w duas vezes|strong="G1364"\w*, \w você|strong="G4771"\w* \w me negará|strong="G3165,G533"\w* \w três vezes|strong="G5151"\w*.”\x - \xo 14:30 \xt MAT 26:34; LUK 22:34; MRK 14:72; JHN 13:38; LUK 22:61; MAT 26:75\x*
\v 31 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w falava|strong="G2980"\w* \w com muita insistência|strong="G4057,G1537"\w*: “\w Se for preciso|strong="G1437,G1163"\w* \w que eu morra|strong="G3165,G4880"\w* \w com você|strong="G4771"\w*, \w de modo nenhum|strong="G3756,G3361"\w* \w o negarei|strong="G4771,G533"\w*.” \w E|strong="G1161"\w* \w da mesma forma|strong="G5615"\w* \w também|strong="G2532"\w* \w todos|strong="G3956"\w* \w diziam|strong="G3004"\w*.\f + \fr 14.31: \ft Variante: TR e Byz (e RP) trazem "dizia ainda mais veementemente" (ἐκπερισσοῦ… μᾶλλον) em lugar de "falava com muita insistência"; RP traz "negarei" no subjuntivo (ἀπαρνήσωμαι)\f*\x - \xo 14:31 \xt PSA 118:5; LUK 22:33; PRO 28:26; EXO 19:8; JER 17:9; JHN 13:37\x*
\p
\v 32 \w E|strong="G2532"\w* \w chegaram|strong="G2064"\w* \w a um lugar|strong="G1519,G5564"\w* \w cujo nome|strong="G3739,G3588,G3686"\w* \w é Getsêmani|strong="G1068"\w*, \w e|strong="G2532"\w* \w disse|strong="G3004"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w*: “\w Sentem-se|strong="G2523"\w* \w aqui|strong="G5602"\w* \w enquanto eu oro|strong="G2193,G4336"\w*.”\f + \fr 14.32: \ft Acréscimo: verbo ser/estar suprido em “é Getsêmani”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 14:32 \xt MAT 26:36; HEB 5:7; PSA 118:5; JHN 18:1; LUK 22:40; MRK 14:36\x*
\v 33 \w E|strong="G2532"\w* \w tomou consigo|strong="G3880,G3326,G846"\w* \w Pedro|strong="G3588,G4074"\w*, \w Tiago|strong="G2385"\w* \w e|strong="G2532"\w* \w João|strong="G2491"\w*, \w e|strong="G2532"\w* \w começou a|strong="G757"\w* \w ficar atônito|strong="G1568"\w* \w e|strong="G2532"\w* \w angustiado|strong="G85"\w*,\x - \xo 14:33 \xt MAT 26:37; LUK 9:28; MRK 5:37; MRK 9:2; HEB 5:7; PSA 118:5\x*
\v 34 \w e|strong="G2532"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Profundamente triste|strong="G4036"\w* \w está|strong="G1510"\w* \w a minha alma|strong="G3588,G5590,G3165"\w*\f + \fr 14.34: \ft Lit.: ψυχή, "alma, vida, a pessoa por inteiro"; ver 8:35\f* \w até a morte|strong="G2193,G2288"\w*; \w fiquem|strong="G3306"\w* \w aqui|strong="G5602"\w* \w e|strong="G2532"\w* \w vigiem|strong="G1127"\w*.”\x - \xo 14:34 \xt MAT 26:38; HEB 5:7; ISA 53:3; LUK 6:12; PSA 118:5; JHN 12:27\x*
\v 35 \w E|strong="G2532"\w*, \w indo um pouco mais adiante|strong="G4281,G3398"\w*, \w caía|strong="G4098"\w* \w por terra|strong="G1909,G3588,G1093"\w*, \w e|strong="G2532"\w* \w orava|strong="G4336"\w* \w para que|strong="G2443"\w*, \w se era possível|strong="G1487,G1415,G1510"\w*, \w passasse|strong="G3928"\w* \w dele|strong="G575,G846"\w* \w a hora|strong="G3588,G5610"\w*,\x - \xo 14:35 \xt MAT 26:39; HEB 5:7; LUK 6:12; PSA 118:5; PSA 95:6; MAT 26:36\x*
\v 36 \w e|strong="G2532"\w* \w dizia|strong="G3004"\w*: “\w Abá|strong="G5"\w*\f + \fr 14.36: \ft Lit.: Ἀββά é uma palavra aramaica que significa "pai"; o texto grego a traduz em seguida por ὁ πατήρ.\f*, \w Pai|strong="G3588,G3962"\w*, \w todas as coisas|strong="G3956"\w* \w são possíveis|strong="G1415"\w* \w para você|strong="G4771"\w*; \w afaste|strong="G3911"\w* \w de mim|strong="G575,G1473"\w* \w este cálice|strong="G3588,G4221,G3778"\w*; \w mas|strong="G235"\w* \w não o que|strong="G3756,G5101"\w* \w eu|strong="G1473"\w* \w quero|strong="G2309"\w*, \w mas sim o que|strong="G235,G5101"\w* \w você quer|strong="G4771"\w*.”\f + \fr 14.36: \ft Acréscimo: verbo ser/estar suprido em “são possíveis”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 14:36 \xt LUK 22:42; MAT 26:39; HEB 12:2; HEB 5:7; ROM 8:15; GAL 4:6\x*
\v 37 \w E|strong="G2532"\w* \w veio|strong="G2064"\w* \w e|strong="G2532"\w* \w os encontrou|strong="G2147,G846"\w* \w dormindo|strong="G2518"\w*, \w e|strong="G2532"\w* \w disse|strong="G3004"\w* \w a Pedro|strong="G3588,G4074"\w*: “\w Simão|strong="G4613"\w*, \w você dorme|strong="G2518"\w*? \w Não teve forças|strong="G3756,G2480"\w* \w para vigiar|strong="G1127"\w* \w uma hora|strong="G1520,G5610"\w*?\x - \xo 14:37 \xt MAT 26:40; 1TH 5:6; MRK 14:40; MRK 13:36; 1CO 16:13; HEB 5:7\x*
\v 38 \w Vigiem|strong="G1127"\w* \w e|strong="G2532"\w* \w orem|strong="G4336"\w* \w para que|strong="G2443"\w* \w não entrem|strong="G3361,G2064"\w* \w em tentação|strong="G1519,G3986"\w*\f + \fr 14.38: \ft Lit.: πειρασμός, "tentação" ou "prova"\f*; \w o espírito|strong="G3588,G4151"\w* \w de fato|strong="G3303"\w* \w está disposto|strong="G4289"\w*, \w mas|strong="G1161"\w* \w a carne|strong="G3588,G4561"\w* \w é fraca|strong="G772"\w*.”\f + \fr 14.38: \ft Acréscimo: verbo ser/estar suprido em “está disposto”, “é fraca”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 14:38 \xt MAT 26:41; PRO 4:23; LUK 22:40; LUK 22:46; EPH 6:18; 1CO 16:13\x*
\v 39 \w E|strong="G2532"\w*, \w afastando-se|strong="G565"\w* \w de novo|strong="G3825"\w*, \w orou|strong="G4336"\w*, \w dizendo|strong="G2036"\w* \w as mesmas palavras|strong="G3588,G846,G3056"\w*.\x - \xo 14:39 \xt MAT 26:42; JHN 20:10; MAT 26:44; MAT 26:36; HEB 5:7; EXO 17:12\x*
\v 40 \w E|strong="G2532"\w*, \w voltando|strong="G2064"\w* \w de novo|strong="G3825"\w*, \w os encontrou|strong="G2147,G846"\w* \w dormindo|strong="G2518"\w*, \w pois|strong="G1063"\w* \w os olhos|strong="G3588,G3788"\w* \w deles|strong="G846"\w* \w estavam pesados|strong="G1510,G6046"\w*, \w e|strong="G2532"\w* \w não sabiam|strong="G3756,G1492"\w* \w o que|strong="G5101"\w* \w lhe responder|strong="G611,G846"\w*.\x - \xo 14:40 \xt MAT 26:43; MRK 13:36; MRK 14:37; EXO 17:12; MAT 26:36; LUK 22:40\x*
\v 41 \w E|strong="G2532"\w* \w veio|strong="G2064"\w* \w pela terceira vez|strong="G3588,G5154"\w* \w e|strong="G2532"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Continuam dormindo|strong="G2518,G3588,G3063"\w* \w e|strong="G2532"\w* \w descansando|strong="G373"\w*\f + \fr 14.41: \ft Lit.: Καθεύδετε… ἀναπαύεσθε pode ser imperativo ("durmam e descansem"), indicativo ou pergunta; ἀπέχει é de sentido debatido ("basta", "está pago", "está longe")\f*? \w Basta|strong="G568"\w*! \w Chegou|strong="G2064"\w* \w a hora|strong="G3588,G5610"\w*; \w olhem|strong="G2400"\w*, \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w é entregue|strong="G3860"\w* \w nas mãos|strong="G1519,G3588,G5495"\w* \w dos pecadores|strong="G3588,G268"\w*.\x - \xo 14:41 \xt MAT 26:45; MAT 26:36; LUK 22:40; LUK 22:45; JHN 12:23; MRK 14:35\x*
\v 42 \w Levantem-se|strong="G1453"\w*, \w vamos|strong="G71"\w*; \w olhem|strong="G2400"\w*, \w chegou perto|strong="G1448"\w* \w o que me entrega|strong="G3588,G3860,G3165"\w*.”\x - \xo 14:42 \xt MAT 26:46; MAT 26:45; MAT 26:36; LUK 22:40; LUK 22:47; PSA 69:14\x*
\p
\v 43 \w E|strong="G2532"\w* \w logo|strong="G2112"\w*, \w enquanto ele|strong="G846"\w* \w ainda|strong="G2089"\w* \w falava|strong="G2980"\w*, \w chegou|strong="G3854"\w* \w Judas|strong="G2455"\w*, \w um|strong="G1520"\w* \w dos Doze|strong="G3588,G1427"\w*, \w e|strong="G2532"\w* \w com ele|strong="G3326,G846"\w* \w uma multidão|strong="G3793"\w* \w com espadas|strong="G3326,G3162"\w* \w e|strong="G2532"\w* \w porretes|strong="G3586"\w* \w da parte|strong="G3844"\w* \w dos chefes dos sacerdotes|strong="G3588,G749"\w*, \w dos escribas|strong="G3588,G1122"\w* \w e|strong="G2532"\w* \w dos anciãos|strong="G3588,G4245"\w*.\f + \fr 14.43: \ft Variante: Tregelles traz "Judas, o Iscariotes" (ὁ Ἰούδας ὁ Ἰσκαριώτης) e WH traz "o Judas" (ὁ Ἰούδας); TR e Byz (e RP) acrescentam "grande" (πολύς) antes de "multidão" e "sendo" (ὤν) depois de "um"\f*\x - \xo 14:43 \xt MAT 26:47; LUK 22:47; LUK 22:52; ACT 1:16; JHN 18:3; MAT 10:4\x*
\v 44 \w Ora|strong="G1161"\w*, \w o que o entregava|strong="G3588,G3860,G846"\w* \w lhes tinha dado|strong="G1325,G846"\w* \w um sinal combinado|strong="G4953"\w*, \w dizendo|strong="G3004"\w*: “\w Aquele a quem|strong="G3739,G302"\w* \w eu beijar|strong="G5368"\w*, \w esse|strong="G846"\w* \w é|strong="G1510"\w*; \w prendam-no|strong="G2902,G846"\w* \w e|strong="G2532"\w* \w levem-no|strong="G520"\w* \w com segurança|strong="G806"\w*.”\f + \fr 14.44: \ft Tradução: φιλήσω (φιλέω, G5368) está aqui como “eu beijar”; o termo pode ser “amar (com afeição)”, “gostar de”, “beijar” ou “ter apreço”, e o contexto decide.\f*\x - \xo 14:44 \xt MAT 26:48; LUK 22:48; PSA 55:13; JHN 19:11; JOS 2:12; LUK 22:47\x*
\v 45 \w E|strong="G2532"\w*, \w chegando|strong="G2064"\w*, \w logo|strong="G2112"\w* \w se aproximou|strong="G4334"\w* \w dele|strong="G846"\w* \add e\add* \w disse|strong="G3004"\w*: “\w Rabi|strong="G4461"\w*!” \w E|strong="G2532"\w* \w o beijou|strong="G2705,G846"\w*.\f + \fr 14.45: \ft Variante: TR e Byz (e RP) trazem "Rabi, Rabi!" (ῥαββί ῥαββί), com "a ele" (αὐτῷ) antes\f*\f + \fr 14.45: \ft Acréscimo: “e” (em “aproximou dele e disse Rabi”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 14:45 \xt MAT 26:49; LUK 22:48; PSA 55:13; MRK 12:14; LUK 22:47; MAT 26:47\x*
\v 46 \w Eles|strong="G3588"\w* \w lançaram as mãos|strong="G1911,G3588,G5495"\w* \w sobre ele|strong="G846"\w* \w e|strong="G2532"\w* \w o prenderam|strong="G2902,G846"\w*.\x - \xo 14:46 \xt MAT 26:50; JHN 7:44; MRK 9:27; LUK 22:48; LUK 22:47; MAT 21:39\x*
\v 47 \w Mas|strong="G1161"\w* \w um certo|strong="G1520,G5100"\w* \w dos presentes|strong="G3588,G3936"\w*, \w puxando|strong="G4685"\w* \w a espada|strong="G3588,G3162"\w*, \w feriu|strong="G3817"\w* \w o escravo|strong="G3588,G1401"\w* \w do sumo sacerdote|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w lhe cortou|strong="G851,G846"\w* \w a orelha|strong="G3588,G6090"\w*.\x - \xo 14:47 \xt JHN 18:10; LUK 22:50; MAT 26:51; LUK 22:47; LUK 22:49-51; MAT 21:39\x*
\v 48 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w disse-lhes|strong="G2036,G846"\w*: “\w Vocês saíram|strong="G1831"\w*, \w como contra|strong="G5613,G1909"\w* \w um bandido|strong="G3027"\w*\f + \fr 14.48: \ft Lit.: λῃστής, "bandido, salteador"; é diferente de κλέπτης, "ladrão"\f*, \w com espadas|strong="G3326,G3162"\w* \w e|strong="G2532"\w* \w porretes|strong="G3586"\w* \w para me prender|strong="G4815,G3165"\w*?\x - \xo 14:48 \xt MAT 26:55; LUK 22:52; MAT 26:47; 1SA 26:18; LUK 22:47; MAT 21:39\x*
\v 49 \w Todos os dias|strong="G2596,G2250"\w* \w eu estava|strong="G1510"\w* \w com vocês|strong="G4314,G4771"\w* \w no templo|strong="G1722,G3588,G2411"\w* \w ensinando|strong="G1321"\w*, \w e|strong="G2532"\w* \w vocês não|strong="G3756"\w* \w me prenderam|strong="G2902,G3165"\w*; \w mas|strong="G235"\w* \w isso acontece para que|strong="G2443"\w* \w se cumpram|strong="G4137"\w* \w as Escrituras|strong="G3588,G1124"\w*.”\f + \fr 14.49: \ft Lit.: o grego não tem verbo principal em "mas para que se cumpram as Escrituras"; "isso acontece" foi acrescentado\f*\x - \xo 14:49 \xt MAT 26:54; MRK 12:35; MAT 26:56; JHN 18:20; JHN 8:2; DAN 9:24-26\x*
\v 50 \w E|strong="G2532"\w* \w todos|strong="G3956"\w*, \w deixando-o|strong="G863,G846"\w*, \w fugiram|strong="G5343"\w*.\x - \xo 14:50 \xt MAT 26:56; ZEC 13:7; MRK 14:27; JHN 16:32; PSA 69:20; 2TI 4:16\x*
\v 51 \w E|strong="G2532"\w* \w um certo|strong="G5100"\w* \w jovem|strong="G3495"\w* \w o seguia|strong="G4870,G846"\w*, \w envolvido|strong="G4016"\w* \w num lençol|strong="G4616"\w* \w sobre o corpo nu|strong="G1909,G1131"\w*; \w e|strong="G2532"\w* \w o prenderam|strong="G2902,G846"\w*,\f + \fr 14.51: \ft Variante: RP traz "um certo jovem" com outra ordem (εἷς τις νεανίσκος), "seguiu" (ἠκολούθησεν) em lugar de "seguia" e acrescenta "os jovens" (οἱ νεανίσκοι) como sujeito de "prenderam"\f*\x - \xo 14:51 \xt MAT 26:56; GEN 39:12; MAT 21:39\x*
\v 52 \w mas|strong="G1161"\w* \w ele|strong="G3588"\w*, \w largando|strong="G2641"\w* \w o lençol|strong="G3588,G4616"\w*, \w fugiu|strong="G5343"\w* \w nu|strong="G1131"\w*.\x - \xo 14:52 \xt MAT 26:56; AMO 2:16; GEN 39:12; MRK 13:14-16; MAT 21:39\x*
\p
\v 53 \w E|strong="G2532"\w* \w levaram|strong="G520"\w* \w Jesus|strong="G3588,G2424"\w* \w ao sumo sacerdote|strong="G4314,G3588,G749"\w*, \w e|strong="G2532"\w* \w se reuniram|strong="G4905"\w* \w todos os chefes dos sacerdotes|strong="G3956,G3588,G749"\w*, \w os anciãos|strong="G3588,G4245"\w* \w e|strong="G2532"\w* \w os escribas|strong="G3588,G1122"\w*.\x - \xo 14:53 \xt MAT 26:57; LUK 22:54; JHN 18:12; MAT 21:39\x*
\v 54 \w E|strong="G2532"\w* \w Pedro|strong="G3588,G4074"\w* \w o seguiu|strong="G190,G846"\w* \w de longe|strong="G575,G3113"\w* \w até o interior|strong="G2193,G2080"\w* \w do pátio|strong="G1519,G3588,G833"\w* \w do sumo sacerdote|strong="G3588,G749"\w*, \w e|strong="G2532"\w* \w estava sentado junto|strong="G1510,G4775"\w* \w com os guardas|strong="G3326,G3588,G5257"\w*\f + \fr 14.54: \ft Lit.: ὑπηρέτης, "servidor, auxiliar"; aqui, os que serviam ao sumo sacerdote como guardas\f* \w e|strong="G2532"\w* \w se aquecendo|strong="G2328"\w* \w junto à luz|strong="G4314,G3588,G5457"\w*.\x - \xo 14:54 \xt MAT 26:58; LUK 22:54; JHN 18:18; JHN 18:15; MRK 14:66; JHN 18:25\x*
\v 55 \w Mas|strong="G1161"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w todo o conselho|strong="G3650,G3588,G4892"\w* \w procuravam|strong="G2212"\w* \w um testemunho|strong="G3141"\w* \w contra Jesus|strong="G2596,G3588,G2424"\w* \w para fazê-lo morrer|strong="G1519,G3588,G2289,G846"\w*, \w e|strong="G2532"\w* \w não achavam|strong="G3756,G2147"\w*;\x - \xo 14:55 \xt MAT 26:59; JAS 3:6; MAT 5:22; 1PE 3:16-18; ACT 24:1-13; JHN 18:19\x*
\v 56 \w pois|strong="G1063"\w* \w muitos|strong="G4183"\w* \w davam falso testemunho|strong="G5576"\w* \w contra ele|strong="G2596,G846"\w*, \w e|strong="G2532"\w* \w os testemunhos|strong="G3588,G3141"\w* \w não coincidiam|strong="G2470,G3756,G1510"\w*.\x - \xo 14:56 \xt MRK 14:59; JAS 3:6; 1JN 5:8; JHN 18:19; JHN 18:21; LUK 23:2\x*
\v 57 \w E|strong="G2532"\w* \w alguns|strong="G5100"\w*, \w levantando-se|strong="G450"\w*, \w davam falso testemunho|strong="G5576"\w* \w contra ele|strong="G2596,G846"\w*, \w dizendo|strong="G3004"\w*:\x - \xo 14:57 \xt JAS 3:6; ACT 6:13-14; MAT 26:60; JHN 18:19; JHN 18:21\x*
\v 58 “\w Nós|strong="G3165"\w* \w o ouvimos|strong="G191,G846"\w* \w dizer|strong="G3004"\w*: ‘\w Eu|strong="G1473"\w* \w destruirei|strong="G2647"\w* \w este santuário|strong="G3588,G3485,G3778"\w* \w feito por mãos|strong="G3588,G5499"\w* \w e|strong="G2532"\w*, \w em três dias|strong="G1223,G5140,G2250"\w*, \w construirei|strong="G3618"\w* \w outro|strong="G243"\w* \w não feito por mãos|strong="G886"\w*.’”\x - \xo 14:58 \xt JHN 2:19; MRK 15:29; MAT 26:61; 2CO 5:1; MAT 27:40; HEB 9:11\x*
\v 59 \w E|strong="G2532"\w* \w nem mesmo assim|strong="G3761,G3779"\w* \w o testemunho|strong="G3588,G3141"\w* \w deles|strong="G846"\w* \w coincidia|strong="G2470,G1510"\w*.\x - \xo 14:59 \xt MRK 14:56; JHN 18:19; JHN 18:21; MAT 26:60\x*
\v 60 \w E|strong="G2532"\w* \w o sumo sacerdote|strong="G3588,G749"\w*, \w levantando-se|strong="G450"\w* \w no meio|strong="G1519,G3319"\w*, \w perguntou|strong="G1905"\w* \w a Jesus|strong="G3588,G2424"\w*, \w dizendo|strong="G3004"\w*: “\w Você não responde|strong="G3756,G611"\w* \w nada|strong="G3762"\w*? \w O que|strong="G5101"\w* \w estes|strong="G3778"\w* \w testemunham contra você|strong="G4771,G2649"\w*?”\x - \xo 14:60 \xt MAT 26:62; 1PE 2:23; JHN 18:19\x*
\v 61 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w ficou calado|strong="G4623"\w* \w e|strong="G2532"\w* \w não respondeu|strong="G3756,G611"\w* \w nada|strong="G3762"\w*. \w De novo|strong="G3825"\w* \w o sumo sacerdote|strong="G3588,G749"\w* \w o interrogava|strong="G1905,G846"\w*, \w e|strong="G2532"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Você é|strong="G4771,G1510"\w* \w o Cristo|strong="G3588,G5547"\w*, \w o Filho|strong="G3588,G5207"\w* \w do Bendito|strong="G3588,G2128"\w*?”\f + \fr 14.61: \ft Nota cultural: "o Bendito" é um modo judaico de se referir a Deus sem pronunciar o nome\f*\x - \xo 14:61 \xt MAT 26:63; DAN 7:13; MAT 16:16; ISA 53:7; JHN 4:26; MRK 15:2\x*
\v 62 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Eu sou|strong="G1473,G1510"\w*\f + \fr 14.62: \ft Lit.: ἐγώ εἰμι, literalmente "eu sou"\f*; \w e|strong="G2532"\w* \w vocês verão|strong="G3700"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w sentado|strong="G2521"\w* \w à direita|strong="G1537,G1188"\w* \w do Poder|strong="G3588,G1411"\w*\f + \fr 14.62: \ft Nota cultural: "o Poder" é um modo de se referir a Deus; as imagens lembram o Salmo 110:1 e Daniel 7:13\f* \w e|strong="G2532"\w* \w vindo|strong="G2064"\w* \w com as nuvens|strong="G3326,G3588,G3507"\w* \w do céu|strong="G3588,G3772"\w*.”\x - \xo 14:62 \xt DAN 7:13; PSA 110:1; MAT 26:64; MRK 13:26; LUK 22:69; REV 1:7\x*
\v 63 \w Mas|strong="G1161"\w* \w o sumo sacerdote|strong="G3588,G749"\w*, \w rasgando|strong="G1284"\w* \w as suas túnicas|strong="G3588,G5509,G846"\w*, \w disse|strong="G3004"\w*: “\w Que necessidade|strong="G5101,G5532"\w* \w ainda|strong="G2089"\w* \w temos|strong="G2192"\w* \w de testemunhas|strong="G3144"\w*?\x - \xo 14:63 \xt MAT 26:65; LUK 22:71; MAT 24:30; JHN 19:7; PSA 12:8; MRK 10:34\x*
\v 64 \w Vocês ouviram|strong="G191"\w* \w a blasfêmia|strong="G3588,G988"\w*. \w O que|strong="G5101"\w* \w lhes parece|strong="G4771,G5316"\w*?” \w E|strong="G1161"\w* \w todos|strong="G3588,G3956"\w* \w o condenaram|strong="G2632,G846"\w* \w como merecedor|strong="G1777,G1511"\w* \w de morte|strong="G2288"\w*.\x - \xo 14:64 \xt MAT 24:30; JHN 19:7; LEV 24:16; PSA 12:8; JHN 10:31-33; JHN 18:19\x*
\v 65 \w E|strong="G2532"\w* \w alguns|strong="G5100"\w* \w começaram a|strong="G757"\w* \w cuspir|strong="G1716"\w* \w nele|strong="G846"\w*, \w e|strong="G2532"\w* \w cobrir|strong="G4028"\w* \w o rosto|strong="G3588,G4383"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w golpeá-lo com os punhos|strong="G2852,G846"\w*, \w e|strong="G2532"\w* \w dizer-lhe|strong="G3004,G846"\w*: “\w Profetize|strong="G4395"\w*!” \w E|strong="G2532"\w* \w os guardas|strong="G3588,G5257"\w* \w o receberam|strong="G846,G2983"\w* \w com bofetadas|strong="G4475"\w*.\f + \fr 14.65: \ft Variante: RP traz ἔβαλλον ("lançaram") em lugar de ἔλαβον ("receberam"), e outra ordem em "o rosto dele"\f*\x - \xo 14:65 \xt MAT 26:67; JHN 18:22; ISA 50:6; MRK 10:34; ACT 23:2; 2CH 18:23\x*
\p
\v 66 \w E|strong="G2532"\w*, \w estando|strong="G1510"\w* \w Pedro|strong="G3588,G4074"\w* \w embaixo|strong="G2736"\w* \w no pátio|strong="G1722,G3588,G833"\w*, \w veio|strong="G2064"\w* \w uma|strong="G1520"\w* \w das criadas|strong="G3588,G3814"\w* \w do sumo sacerdote|strong="G3588,G749"\w*\x - \xo 14:66 \xt MAT 26:69; JHN 18:17; JHN 18:15; MAT 26:58; MRK 14:54; LUK 22:55\x*
\v 67 \w e|strong="G2532"\w*, \w vendo|strong="G1492"\w* \w Pedro|strong="G3588,G4074"\w* \w se aquecendo|strong="G2328"\w*, \w olhando para ele|strong="G1689,G846"\w*, \w disse|strong="G3004"\w*: “\w Também|strong="G2532"\w* \w você|strong="G4771"\w* \w estava com|strong="G1510,G3326"\w* \w Jesus|strong="G3588,G2424"\w*, \w o Nazareno|strong="G3588,G3479"\w*.”\x - \xo 14:67 \xt JHN 18:25; JHN 18:18; JHN 1:45; MAT 14:30; JHN 18:16; JHN 18:17\x*
\v 68 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w negou|strong="G720"\w*, \w dizendo|strong="G3004"\w*: “\w Nem|strong="G3777"\w* \w sei|strong="G6063"\w* \w nem|strong="G3777"\w* \w entendo|strong="G1987"\w* \w o que|strong="G5101"\w* \w você|strong="G4771"\w* \w diz|strong="G3004"\w*.” \w E|strong="G2532"\w* \w saiu|strong="G1831"\w* \w para fora|strong="G1854"\w*, \w para o pórtico|strong="G1519,G3588,G4259"\w*, \w e|strong="G2532"\w* \w o galo|strong="G220"\w* \w cantou|strong="G5455"\w*.\f + \fr 14.68: \ft Variante: WH omite "e o galo cantou" (καὶ ἀλέκτωρ ἐφώνησεν); RP traz "Não sei nem entendo" (Οὐκ οἶδα οὐδὲ ἐπίσταμαι) e outra ordem em "o que você diz"\f*\x - \xo 14:68 \xt JHN 18:27; MRK 14:72; MAT 14:30; JHN 18:25; MRK 14:29-31; 2TI 2:12-13\x*
\v 69 \w E|strong="G2532"\w* \w a criada|strong="G3588,G3814"\w*, \w vendo-o|strong="G1492,G846"\w*, \w começou a|strong="G757"\w* \w de novo|strong="G3825"\w* \w dizer|strong="G3004"\w* \w aos presentes|strong="G3588,G3936"\w*: “\w Este é|strong="G3778,G1510"\w* \w um deles|strong="G1537,G846"\w*.”\x - \xo 14:69 \xt MAT 14:30; JHN 18:25; LUK 22:55; MRK 14:30\x*
\v 70 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w de novo|strong="G3825"\w* \w negava|strong="G720"\w*. \w E|strong="G2532"\w* \w pouco depois|strong="G3326,G3398"\w*, \w de novo|strong="G3825"\w* \w os presentes|strong="G3588,G3936"\w* \w diziam|strong="G3004"\w* \w a Pedro|strong="G3588,G4074"\w*: “\w Realmente|strong="G230"\w* \w você é|strong="G1510"\w* \w um deles|strong="G1537,G846"\w*, \w pois também|strong="G2532,G1063"\w* \w você é|strong="G1510"\w* \w galileu|strong="G1057"\w*; \w e|strong="G2532"\w* \w o seu modo de falar|strong="G3588,G2981,G4771"\w* \w é parecido|strong="G3662"\w*.”\f + \fr 14.70: \ft Variante: WH, Tregelles e NA28 omitem "e o seu modo de falar é parecido" (καὶ ἡ λαλιά σου ὁμοιάζει), que consta no SBLGNT e em RP\f*\x - \xo 14:70 \xt MAT 26:73; MAT 14:30; JHN 18:25; ACT 2:7; JHN 18:26; LUK 22:55\x*
\v 71 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w começou a|strong="G757"\w* \w lançar maldições|strong="G332"\w*\f + \fr 14.71: \ft Lit.: ἀναθεματίζω, "lançar uma maldição"; o texto não diz sobre quem ou o quê\f* \w e|strong="G2532"\w* \w jurar|strong="G3660"\w*: “\w Não conheço|strong="G3756,G6063"\w* \w esse homem|strong="G3588,G444,G3778"\w* \w de quem|strong="G3739"\w* \w vocês falam|strong="G3004"\w*.”\x - \xo 14:71 \xt MAT 26:74; GAL 1:8; MAT 14:30; JHN 18:25; JHN 18:27; LUK 22:34\x*
\v 72 \w E|strong="G2532"\w* \w logo|strong="G2112"\w* \w pela segunda vez|strong="G1537,G1208"\w* \w o galo|strong="G220"\w* \w cantou|strong="G5455"\w*; \w e|strong="G2532"\w* \w Pedro|strong="G3588,G4074"\w* \w se lembrou|strong="G363"\w* \w da palavra|strong="G3588,G4487"\w* \w como|strong="G5613"\w* \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Antes|strong="G4250"\w* \w que o galo|strong="G220"\w* \w cante|strong="G5455"\w* \w duas vezes|strong="G1364"\w*, \w você me negará|strong="G3165,G533"\w* \w três vezes|strong="G5151"\w*.” \w E|strong="G2532"\w* \w desabou em pranto|strong="G1911,G2799"\w*.\f + \fr 14.72: \ft Lit.: ἐπιβαλών é de sentido incerto: "lançando-se", "cobrindo a cabeça" ou "pondo-se a" (chorar)\f*\f + \fr 14.72: \ft Variante: RP omite "logo" (εὐθύς) e traz "o que" (ὅ) em lugar de "como" (ὡς)\f*\x - \xo 14:72 \xt MRK 14:30; MAT 26:34; LUK 22:34; JHN 18:27; MAT 26:75; LUK 22:60\x*
\c 15
\p
\v 1 \w E|strong="G2532"\w* \w logo|strong="G2112"\w* \w de manhã cedo|strong="G4404"\w*, \w tendo deliberado|strong="G4824,G4160"\w*\f + \fr 15.1: \ft Lit.: συμβούλιον ποιέω, "fazer um conselho, deliberar em conjunto"\f* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w com os anciãos|strong="G3326,G3588,G4245"\w*, \w os escribas|strong="G1122"\w* \w e|strong="G2532"\w* \w todo o conselho|strong="G3650,G3588,G4892"\w*, \w amarraram|strong="G1210"\w* \w Jesus|strong="G3588,G2424"\w*, \w o levaram|strong="G667"\w* \w e|strong="G2532"\w* \w o entregaram|strong="G3860"\w* \w a Pilatos|strong="G4091"\w*.\x - \xo 15:1 \xt MAT 27:1; JHN 18:28; LUK 22:66; ACT 3:13; LUK 23:1; DAN 6:7\x*
\v 2 \w E|strong="G2532"\w* \w Pilatos|strong="G3588,G4091"\w* \w lhe perguntou|strong="G1905,G846"\w*: “\w Você é|strong="G4771,G1510"\w* \w o rei|strong="G3588,G935"\w* \w dos judeus|strong="G3588,G2453"\w*?” \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w*, \w respondendo-lhe|strong="G611,G846"\w*, \w disse|strong="G3004"\w*: “\w Você o diz|strong="G4771,G3004"\w*.”\f + \fr 15.2: \ft Lit.: Σὺ λέγεις, literalmente "você diz"; pode ser lido como afirmação com reserva ou como devolução da pergunta\f*\x - \xo 15:2 \xt MRK 15:12; MRK 15:9; LUK 23:3; JHN 18:37; MAT 27:11; JHN 18:33\x*
\v 3 \w E|strong="G2532"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w o acusavam|strong="G2723,G846"\w* \w de muitas coisas|strong="G4183"\w*.\x - \xo 15:3 \xt MAT 27:12; LUK 23:10; MAT 27:11; JHN 18:29; JHN 18:28; LUK 23:2\x*
\v 4 \w Pilatos|strong="G3588,G4091"\w* \w de novo|strong="G3825"\w* \w o interrogava|strong="G1905,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Você não responde|strong="G3756,G611"\w* \w nada|strong="G3762"\w*? \w Veja|strong="G2396"\w* \w de quantas coisas|strong="G4214"\w* \w eles o acusam|strong="G4771,G2723"\w*\f + \fr 15.4: \ft Variante: RP traz "perguntou" (ἐπηρώτησεν), no aoristo, e "testemunham contra" (καταμαρτυροῦσιν) em lugar de "acusam" (κατηγοροῦσιν)\f*.”\x - \xo 15:4 \xt MAT 27:11; JHN 18:29; JHN 18:28; LUK 23:2; PSA 38:14; JHN 19:10\x*
\v 5 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w* \w não respondeu|strong="G2089,G3756,G611"\w* \w mais nada|strong="G3762"\w*, \w de modo que|strong="G5620"\w* \w Pilatos|strong="G3588,G4091"\w* \w se admirava|strong="G2296"\w*.\x - \xo 15:5 \xt MAT 27:14; JHN 7:21; ISA 53:7; MAT 27:11; JHN 18:29; JHN 18:28\x*
\v 6 \w Ora|strong="G1161"\w*, \w a cada festa|strong="G2596,G1859"\w* \w ele costumava soltar|strong="G630"\w* \w para eles|strong="G846"\w* \w um prisioneiro|strong="G1520,G1198"\w*, \w aquele que|strong="G3739"\w* \w pedissem|strong="G3868"\w*.\x - \xo 15:6 \xt MAT 27:15; LUK 23:17; JHN 18:39; LUK 23:25; ACT 24:27; ACT 25:9\x*
