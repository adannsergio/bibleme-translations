\v 10 “\w Mas|strong="G1161"\w*, \w para que vocês saibam|strong="G2443,G6063"\w* \w que|strong="G3754"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w*\f + \fr 2.10: \ft Lit.: ὁ υἱὸς τοῦ ἀνθρώπου, literalmente "o filho do ser humano"\f* \w tem|strong="G2192"\w* \w autoridade|strong="G1849"\w* \w na terra|strong="G1909,G3588,G1093"\w* \w para perdoar|strong="G863"\w* \w pecados|strong="G266"\w*…” — \w disse|strong="G3004"\w* \w ao paralítico|strong="G3588,G3885"\w*:\x - \xo 2:10 \xt MRK 2:5; MAT 9:6; MAT 9:2; JHN 20:23; LUK 7:48; MAT 9:5\x*
\v 11 “\w Eu digo|strong="G3004"\w* \w a você|strong="G4771"\w*: \w levante-se|strong="G1453"\w*, \w pegue|strong="G142"\w* \w a sua esteira|strong="G3588,G2895,G4771"\w* \w e|strong="G2532"\w* \w vá|strong="G5217"\w* \w para a sua casa|strong="G1519,G3588,G3624,G4771"\w*.”\x - \xo 2:11 \xt JHN 5:8; JHN 5:11; MAT 9:5; PSA 103:3; JAS 5:15; MAT 9:2\x*
\v 12 \w E|strong="G2532"\w* \w ele se levantou|strong="G1453"\w* \w e|strong="G2532"\w* \w logo|strong="G2112"\w*, \w pegando|strong="G142"\w* \w a esteira|strong="G3588,G2895"\w*, \w saiu|strong="G1831"\w* \w diante de todos|strong="G1715,G3956"\w*, \w de modo que|strong="G5620"\w* \w todos|strong="G3956"\w* \w ficaram atônitos|strong="G1839"\w* \w e|strong="G2532"\w* \w glorificavam|strong="G1392"\w* \w a Deus|strong="G3588,G2316"\w*, \w dizendo|strong="G3004"\w*: “\w Nunca|strong="G3763"\w* \w vimos|strong="G1492"\w* \w algo assim|strong="G3779"\w*.”\x - \xo 2:12 \xt MAT 9:5; MAT 9:2; LUK 5:18; MRK 7:37; MAT 9:33; MAT 9:8\x*
\p
\v 13 \w E|strong="G2532"\w* \w saiu|strong="G1831"\w* \w de novo|strong="G3825"\w* \w para a beira|strong="G3844"\w* \w do mar|strong="G3588,G2281"\w*; \w e|strong="G2532"\w* \w toda a multidão|strong="G3956,G3588,G3793"\w* \w vinha|strong="G2064"\w* \w a ele|strong="G4314,G846"\w*, \w e|strong="G2532"\w* \w ele os ensinava|strong="G1321,G846"\w*.\x - \xo 2:13 \xt MRK 4:1; MAT 13:1; LUK 5:27; MRK 1:45; MRK 2:2; MRK 10:1\x*
\v 14 \w E|strong="G2532"\w*, \w passando|strong="G3855"\w*, \w viu|strong="G1492"\w* \w Levi|strong="G3017"\w*, \w filho|strong="G3588"\w* \w de Alfeu|strong="G3588,G256"\w*, \w sentado|strong="G2521"\w* \w no posto de cobrança de impostos|strong="G1909,G3588,G5058"\w*, \w e|strong="G2532"\w* \w disse|strong="G3004"\w* \w a ele|strong="G846"\w*: “\w Siga-me|strong="G190,G3165"\w*.” \w E|strong="G2532"\w*, \w levantando-se|strong="G450"\w*, \w o seguiu|strong="G190,G846"\w*.\x - \xo 2:14 \xt MAT 9:9; LUK 5:27; MAT 4:19; MAT 19:27; ACT 1:13; MRK 3:18\x*
\v 15 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w estando ele à mesa|strong="G2621,G846"\w* \w na casa|strong="G1722,G3588,G3614"\w* \w dele|strong="G846"\w*, \w muitos|strong="G4183"\w* \w cobradores de impostos|strong="G5057"\w* \w e|strong="G2532"\w* \w pecadores|strong="G268"\w* \w estavam à mesa|strong="G4873"\w* \w com Jesus|strong="G3588,G2424"\w* \w e|strong="G2532"\w* \w com os seus discípulos|strong="G3588,G3101,G846"\w*; \w pois|strong="G1063"\w* \w eram|strong="G1510"\w* \w muitos|strong="G4183"\w*, \w e|strong="G2532"\w* \w o seguiam|strong="G190,G846"\w*.\f + \fr 2.15: \ft Acréscimo: “que” (em “E aconteceu que estando ele”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 2:15 \xt MAT 9:10; LUK 5:29; LUK 15:1; LUK 5:27; MAT 9:9\x*
\v 16 \w E|strong="G2532"\w* \w os escribas|strong="G3588,G1122"\w* \w dos fariseus|strong="G3588,G5330"\w*\f + \fr 2.16: \ft Variante: RP traz "e os fariseus" (καὶ οἱ Φαρισαῖοι) em lugar de "dos fariseus", o que faz de escribas e fariseus dois grupos\f*, \w vendo|strong="G1492"\w* \w que|strong="G3754"\w* \w ele comia|strong="G2068"\w* \w com os|strong="G3326,G3588"\w* \w pecadores|strong="G268"\w* \w e|strong="G2532"\w* \w cobradores de impostos|strong="G5057"\w*, \w diziam|strong="G3004"\w* \w aos discípulos|strong="G3588,G3101"\w* \w dele|strong="G846"\w*: “\w Por que|strong="G3754"\w*\f + \fr 2.16: \ft Lit.: ὅτι, literalmente "que"; aqui o sentido é o de "por que"\f* \w ele come|strong="G2068"\w* \w com os|strong="G3326,G3588"\w* \w cobradores de impostos|strong="G5057"\w* \w e|strong="G2532"\w* \w pecadores|strong="G268"\w*\f + \fr 2.16: \ft Variante: Tregelles, TR e Byz acrescentam "e bebe" (καὶ πίνει) no fim da pergunta\f*?”\x - \xo 2:16 \xt MAT 9:11; LUK 5:30; MAT 9:10; LUK 15:1; MRK 7:5; LUK 5:27\x*
\v 17 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w ouvindo isso|strong="G191"\w*, \w disse|strong="G3004"\w* \w a eles|strong="G846"\w*: “\w Não precisam|strong="G3756,G5532,G2192"\w* \w de médico|strong="G2395"\w* \w os saudáveis|strong="G3588,G2480"\w*, \w mas|strong="G235"\w* \w os doentes|strong="G3588,G2560,G2192"\w*; \w não vim|strong="G3756,G2064"\w* \w chamar|strong="G2564"\w* \w justos|strong="G1342"\w*, \w mas|strong="G235"\w* \w pecadores|strong="G268"\w*.”\f + \fr 2.17: \ft Variante: TR e Byz acrescentam "ao arrependimento" (εἰς μετάνοιαν) no fim\f*\x - \xo 2:17 \xt MAT 9:13; MAT 9:12; LUK 5:31; 1TI 1:15; LUK 15:7; LUK 19:10\x*
\p
\v 18 \w Ora|strong="G2532"\w*, \w os discípulos|strong="G3588,G3101"\w* \w de João|strong="G2491"\w* \w e|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w* \w estavam jejuando|strong="G1510,G3522"\w*. \w E|strong="G2532"\w* \w vieram|strong="G2064"\w* \w e|strong="G2532"\w* \w lhe disseram|strong="G3004,G846"\w*: “\w Por que|strong="G1223,G5101"\w* \w os discípulos|strong="G3588,G3101"\w* \w de João|strong="G2491"\w* \w e|strong="G2532"\w* \w os discípulos|strong="G3588,G3101"\w* \w dos fariseus|strong="G3588,G5330"\w*\f + \fr 2.18: \ft Variante: TR e Byz trazem "os dos fariseus" (οἱ τῶν Φαρισαίων) em lugar de "os fariseus" na primeira frase do verso; RP também omite "discípulos" (μαθηταί) antes de "dos fariseus" na pergunta\f* \w jejuam|strong="G3522"\w*, \w mas os seus discípulos|strong="G3588,G1161,G4771,G3101"\w* \w não jejuam|strong="G3756,G3522"\w*?”\x - \xo 2:18 \xt MAT 9:14; LUK 5:33; LUK 5:27; MAT 9:9; MAT 6:16; LUK 18:12\x*
\v 19 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Por acaso|strong="G3361"\w* \w podem|strong="G1410"\w* \w os convidados do casamento|strong="G3588,G5207,G3567"\w*\f + \fr 2.19: \ft Lit.: υἱοὶ τοῦ νυμφῶνος, literalmente "os filhos da câmara nupcial"\f* \w jejuar|strong="G3522"\w* \w enquanto o noivo|strong="G1722,G3739,G3588,G3566"\w* \w está com eles|strong="G3326,G846,G1510"\w*? \w Enquanto|strong="G3745,G5550"\w* \w têm o noivo|strong="G2192,G3588,G3566"\w* \w com eles|strong="G3326,G846"\w*, \w não podem|strong="G3756,G1410"\w* \w jejuar|strong="G3522"\w*;\x - \xo 2:19 \xt LUK 5:34; MAT 9:15; LUK 5:27; MAT 9:9; MAT 25:1; MAT 9:14\x*
\v 20 \w mas|strong="G1161"\w* \w virão|strong="G2064"\w* \w dias|strong="G2250"\w* \w em que|strong="G3752"\w* \w o noivo|strong="G3588,G3566"\w* \w será tirado|strong="G522"\w* \w deles|strong="G575,G846"\w*, \w e|strong="G2532"\w* \w então|strong="G5119"\w* \w jejuarão|strong="G3522"\w* \w naquele dia|strong="G1722,G1565,G3588,G2250"\w*.”\f + \fr 2.20: \ft Variante: a edição bizantina (RP) traz "naqueles dias" (plural) em lugar de "naquele dia"\f*\x - \xo 2:20 \xt LUK 5:35; MAT 9:15; MAT 9:14; LUK 5:27; MAT 9:9; MAT 25:1\x*
\v 21 “\w Ninguém|strong="G3762"\w* \w costura|strong="G1976"\w* \w um remendo|strong="G1915"\w* \w de pano|strong="G4470"\w* \w ainda não tratado|strong="G46"\w* \w sobre uma roupa|strong="G1909,G2440"\w* \w velha|strong="G3820"\w*; \w caso contrário|strong="G1487,G1161,G3361"\w*, \w o remendo novo|strong="G3588,G4138,G2537"\w* \w repuxa|strong="G142"\w* \w a roupa velha|strong="G575,G846,G3588,G3820"\w*, \w e|strong="G2532"\w* \w o rasgo|strong="G4978"\w* \w fica pior|strong="G5501,G1096"\w*.\x - \xo 2:21 \xt MAT 9:16; LUK 5:36; LUK 5:27; MAT 9:9; MAT 9:14; 1CO 1:10\x*
\v 22 \w E|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w põe|strong="G906"\w* \w vinho novo|strong="G3631,G3501"\w* \w em odres velhos|strong="G1519,G779,G3820"\w*; \w caso contrário|strong="G1487,G1161,G3361"\w*, \w o vinho|strong="G3588,G3631"\w* \w romperá|strong="G4486"\w* \w os odres|strong="G3588,G779"\w*, \w e|strong="G2532"\w* \w se perdem|strong="G622"\w* \w o vinho|strong="G3588,G3631"\w* \w e|strong="G2532"\w* \w os odres|strong="G3588,G779"\w*. \w Mas|strong="G235"\w* \w vinho novo|strong="G3631,G3501"\w*, \w em odres novos|strong="G1519,G779,G2537"\w*.”\f + \fr 2.22: \ft Variante: Tregelles e RP acrescentam "deve-se pôr" (βλητέον) no fim; RP também traz "o vinho novo rompe" (ῥήσσει ὁ οἶνος ὁ νέος) e "o vinho é derramado, e os odres se perderão" (ἐκχεῖται καὶ οἱ ἀσκοὶ ἀπολοῦνται) em lugar de "o vinho se perde, e os odres"\f*\x - \xo 2:22 \xt LUK 5:37; MAT 9:17; LUK 5:38; LUK 5:27; MAT 9:9; LUK 5:36\x*
\p
\v 23 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w no sábado|strong="G1722,G3588,G4521"\w*, \w ele|strong="G846"\w* \w passava|strong="G3899"\w* \w pelas plantações|strong="G1223,G3588,G4702"\w*, \w e|strong="G2532"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w começaram a|strong="G757"\w* \w andar|strong="G3598,G4160"\w*\f + \fr 2.23: \ft Lit.: ὁδὸν ποιεῖν, literalmente "fazer caminho"\f*, \w arrancando|strong="G5089"\w* \w as espigas|strong="G3588,G4719"\w*.\f + \fr 2.23: \ft Acréscimo: “que” (em “E aconteceu que no sábado”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 2:23 \xt MAT 12:1; LUK 6:1; DEU 23:24-25; DEU 23:25\x*
\v 24 \w E|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w* \w lhe diziam|strong="G3004,G846"\w*: “\w Olhe|strong="G2396"\w*, \w por que|strong="G5101"\w* \w eles fazem|strong="G4160"\w* \w no sábado|strong="G3588,G4521"\w* \w o que|strong="G3739"\w* \w não é permitido|strong="G3756,G1832"\w*?”\x - \xo 2:24 \xt LUK 6:2; MAT 12:2; JHN 5:10; LUK 14:3; MAT 12:1; LUK 6:1\x*
\v 25 \w E|strong="G2532"\w* \w ele lhes disse|strong="G3004,G846"\w*: “\w Vocês nunca leram|strong="G3763,G314"\w* \w o que|strong="G5101"\w* \w Davi|strong="G1138"\w* \w fez|strong="G4160"\w* \w quando|strong="G3753"\w* \w teve necessidade|strong="G5532,G2192"\w* \w e|strong="G2532"\w* \w passou fome|strong="G3983"\w*, \w ele|strong="G846"\w* \w e|strong="G2532"\w* \w os que estavam com ele|strong="G3588,G3326,G846"\w*?\f + \fr 2.25: \ft Acréscimo: “os que estavam com ele”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 2:25 \xt MAT 12:3; LUK 6:3; 1SA 21:3-6; MAT 12:1; LUK 6:1; 1SA 21:6\x*
\v 26 \w Como|strong="G4459"\w* \w entrou|strong="G1525"\w* \w na casa|strong="G1519,G3588,G3624"\w* \w de Deus|strong="G3588,G2316"\w*, \w no tempo do|strong="G1909"\w* \w sumo sacerdote|strong="G749"\w* \w Abiatar|strong="G8"\w*\f + \fr 2.26: \ft Nota cultural: em 1 Samuel 21:1-6 (21:2-7 na numeração hebraica) o sacerdote que entrega os pães é Aimeleque, pai de Abiatar (1 Samuel 22:20); o texto de Marcos diz "no tempo do sumo sacerdote Abiatar" e não harmoniza os dois relatos\f*, \w e|strong="G2532"\w* \w comeu|strong="G5315"\w* \w os pães|strong="G3588,G740"\w* \w da apresentação|strong="G3588,G4286"\w*, \w que não é permitido|strong="G3739,G3756,G1832"\w* \w comer|strong="G5315"\w* \w a não ser|strong="G1487,G3361"\w* \w aos sacerdotes|strong="G3588,G2409"\w*, \w e deu também|strong="G2532,G1325"\w* \w aos que|strong="G3588"\w* \w estavam com ele|strong="G4862,G846,G1510"\w*?”\x - \xo 2:26 \xt 1SA 21:1; 1SA 22:20; MAT 12:4; LUK 6:4; MAT 12:1; MAT 12:3\x*
\v 27 \w E|strong="G2532"\w* \w dizia|strong="G3004"\w* \w a eles|strong="G846"\w*: “\w O sábado|strong="G3588,G4521"\w* \w foi feito|strong="G1096"\w* \w por causa do|strong="G1223,G3588"\w* \w ser humano|strong="G444"\w*, \w e|strong="G2532"\w* \w não o|strong="G3756,G3588"\w* \w ser humano|strong="G444"\w* \w por causa do|strong="G1223,G3588"\w* \w sábado|strong="G4521"\w*;\x - \xo 2:27 \xt GEN 2:3; COL 2:16; LUK 6:9; DEU 5:14; MAT 12:1; EZK 20:12\x*
\v 28 \w portanto|strong="G5620"\w* \w o Filho do Homem|strong="G3588,G5207,G444"\w* \w é senhor|strong="G2962,G1510"\w* \w também|strong="G2532"\w* \w do sábado|strong="G3588,G4521"\w*.”\x - \xo 2:28 \xt MAT 12:1; EXO 20:11; LUK 6:1; MAT 12:8; COL 2:16; JHN 9:14\x*
\c 3
\p
\v 1 \w E|strong="G2532"\w* \w entrou|strong="G1525"\w* \w de novo|strong="G3825"\w* \w numa sinagoga|strong="G1519,G4864"\w*, \w e|strong="G2532"\w* \w havia|strong="G1510"\w* \w ali|strong="G1563"\w* \w um homem|strong="G444"\w* \w que tinha|strong="G2192"\w* \w a mão|strong="G3588,G5495"\w* \w atrofiada|strong="G3583"\w*\f + \fr 3.1: \ft Lit.: ἐξηραμμένην, literalmente "secada, ressecada"; é da mesma família de ξηράν, "seca", do v. 3; o texto não indica a causa\f*.\x - \xo 3:1 \xt LUK 6:6; MAT 12:9; MRK 1:21; JHN 5:3\x*
\v 2 \w E|strong="G2532"\w* \w o observavam|strong="G3906,G846"\w* \w para ver se|strong="G1487"\w* \w o curaria|strong="G2323,G846"\w* \w no sábado|strong="G3588,G4521"\w*, \w a fim de|strong="G2443"\w* \w acusá-lo|strong="G2723,G846"\w*.\x - \xo 3:2 \xt LUK 6:7; MAT 12:10; LUK 14:1; PSA 37:32; JHN 5:3; MAT 12:9\x*
\v 3 \w E|strong="G2532"\w* \w disse|strong="G3004"\w* \w ao homem|strong="G3588,G444"\w* \w que tinha|strong="G3588,G2192"\w* \w a mão|strong="G3588,G5495"\w* \w seca|strong="G3584"\w*: “\w Levante-se|strong="G1453"\w* \w e venha para o meio|strong="G1519,G3588,G3319"\w*.”\x - \xo 3:3 \xt LUK 6:8; LUK 6:6; JHN 5:3; MAT 12:9; JHN 5:9; MAT 12:2\x*
\v 4 \w E|strong="G2532"\w* \w disse|strong="G3004"\w* \w a eles|strong="G846"\w*: “\w É permitido|strong="G1832"\w* \w no sábado|strong="G3588,G4521"\w* \w fazer o bem|strong="G15"\w* \w ou|strong="G2228"\w* \w fazer o mal|strong="G2554"\w*, \w salvar|strong="G4982"\w* \w uma vida|strong="G5590"\w* \w ou|strong="G2228"\w* \w matar|strong="G615"\w*?” \w Mas eles|strong="G3588,G1161"\w* \w ficaram calados|strong="G4623"\w*.\x - \xo 3:4 \xt LUK 6:9; MAT 12:2; GAL 6:10; JHN 5:3; MAT 12:9; LUK 14:1-5\x*
\v 5 \w E|strong="G2532"\w*, \w olhando em volta|strong="G4017"\w* \w para eles|strong="G846"\w* \w com ira|strong="G3326,G3709"\w*, \w profundamente triste|strong="G4818"\w* \w pela dureza|strong="G1909,G3588,G4457"\w* \w do coração|strong="G3588,G2588"\w* \w deles|strong="G846"\w*, \w disse|strong="G3004"\w* \w ao homem|strong="G3588,G444"\w*: “\w Estenda|strong="G1614"\w* \w a mão|strong="G3588,G5495"\w*.” \w E|strong="G2532"\w* \w ele a estendeu|strong="G1614"\w*, \w e|strong="G2532"\w* \w a mão|strong="G3588,G5495"\w* \w dele|strong="G846"\w* \w foi restaurada|strong="G600"\w*.\f + \fr 3.5: \ft Variante: várias edições (Tyndale, WH, Tregelles, TR e Byz) trazem "sua mão" (σου) em "Estenda a mão"; TR e Byz acrescentam "sadia como a outra" (ὑγιὴς ὡς ἡ ἄλλη) no fim\f*\x - \xo 3:5 \xt LUK 6:10; MAT 12:13; EPH 4:26; EPH 4:30; MAT 12:9; MRK 10:14\x*
\v 6 \w E|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w*, \w saindo|strong="G1831"\w*, \w logo|strong="G2112"\w* \w com os herodianos|strong="G3326,G3588,G2265"\w* \w conspiraram|strong="G4824,G1325"\w* \w contra ele|strong="G2596,G846"\w*, \w para destruí-lo|strong="G3704,G846,G622"\w*.\x - \xo 3:6 \xt MAT 12:14; MRK 12:13; MAT 22:15; MAT 12:9; LUK 6:6; MAT 22:16\x*
\p
\v 7 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w com os seus discípulos|strong="G3326,G3588,G3101,G846"\w*, \w retirou-se|strong="G402"\w* \w para o mar|strong="G4314,G3588,G2281"\w*; \w e|strong="G2532"\w* \w uma grande multidão|strong="G4183,G4128"\w* \w da Galileia|strong="G575,G3588,G1056"\w* \w o seguiu|strong="G190"\w*, \w e|strong="G2532"\w* \w da Judeia|strong="G575,G3588,G2449"\w*,\x - \xo 3:7 \xt MAT 12:15; MAT 4:25; MAT 4:12; MRK 6:31; MRK 7:24; LUK 6:17\x*
\v 8 \w e|strong="G2532"\w* \w de Jerusalém|strong="G575,G2414"\w*, \w e|strong="G2532"\w* \w da Idumeia|strong="G575,G3588,G2401"\w*, \w e|strong="G2532"\w* \w do outro lado|strong="G4008"\w* \w do Jordão|strong="G3588,G2446"\w*, \w e|strong="G2532"\w* \w dos arredores de Tiro e Sidom|strong="G4012,G5184,G2532,G4605"\w*, \w uma grande multidão|strong="G4128,G4183"\w*, \w ao ouvir|strong="G191"\w* \w tudo o que|strong="G3745"\w* \w ele fazia|strong="G4160"\w*, \w veio|strong="G2064"\w* \w a ele|strong="G4314,G846"\w*.\x - \xo 3:8 \xt LUK 6:17; MAT 4:25; MRK 7:24; MAT 12:15; ACT 10:38; EZK 35:15\x*
\v 9 \w E|strong="G2532"\w* \w disse|strong="G2036"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w* \w que|strong="G2443"\w* \w um barquinho|strong="G4142"\w* \w ficasse à disposição|strong="G4342"\w* \w dele|strong="G846"\w*, \w por causa da multidão|strong="G1223,G3588,G3793"\w*, \w para que não|strong="G2443,G3361"\w* \w o apertassem|strong="G2346,G846"\w*;\x - \xo 3:9 \xt LUK 5:1; MAT 12:15; ACT 10:38; MRK 4:36; LUK 6:17; MRK 6:55\x*
\v 10 \w pois|strong="G1063"\w* \w curou|strong="G2323"\w* \w muitos|strong="G4183"\w*, \w de modo que|strong="G5620"\w* \w todos os que|strong="G3745"\w* \w tinham|strong="G2192"\w* \w doenças|strong="G3148"\w*\f + \fr 3.10: \ft Lit.: μάστιγας, literalmente "açoites"\f* \w se lançavam|strong="G1968"\w* \w sobre ele|strong="G846"\w* \w para tocá-lo|strong="G2443,G846,G681"\w*.\x - \xo 3:10 \xt LUK 7:21; LUK 6:19; MRK 5:29; MRK 6:56; MAT 12:15; MAT 4:23\x*
\v 11 \w E|strong="G2532"\w* \w os espíritos impuros|strong="G3588,G4151,G169"\w*, \w sempre que|strong="G3752"\w* \w o viam|strong="G846,G2334"\w*, \w caíam diante dele|strong="G4363,G846"\w* \w e|strong="G2532"\w* \w gritavam|strong="G2896"\w*, \w dizendo|strong="G3004"\w*: “\w Você é|strong="G4771,G1510"\w* \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w*.”\x - \xo 3:11 \xt LUK 4:41; LUK 8:28; MRK 1:23-24; JAS 2:19; MAT 12:15; MAT 4:3\x*
\v 12 \w E|strong="G2532"\w* \w ele os advertia|strong="G2008,G846"\w* \w muito|strong="G4183"\w* \w para que não|strong="G2443,G3361"\w* \w o tornassem conhecido|strong="G846,G5318,G4160"\w*.\x - \xo 3:12 \xt MAT 12:16; MRK 1:34; MRK 1:25; MAT 12:15; MRK 7:36; MAT 8:4\x*
\p
\v 13 \w E|strong="G2532"\w* \w subiu|strong="G305"\w* \w ao monte|strong="G1519,G3588,G3735"\w* \w e|strong="G2532"\w* \w chamou|strong="G4341"\w* \w os que|strong="G3739"\w* \w ele mesmo|strong="G846"\w* \w queria|strong="G2309"\w*, \w e|strong="G2532"\w* \w eles foram|strong="G565"\w* \w até ele|strong="G4314,G846"\w*.\x - \xo 3:13 \xt MAT 5:1; MAT 10:1; LUK 9:1; LUK 6:12-16; LUK 6:13; MRK 6:7\x*
\v 14 \w E|strong="G2532"\w* \w designou|strong="G4160"\w* \w doze|strong="G1427"\w*\f + \fr 3.14: \ft Variante: NA28 e WH acrescentam "aos quais chamou também de apóstolos" (οὓς καὶ ἀποστόλους ὠνόμασεν) depois de "doze"\f*, \w para que|strong="G2443"\w* \w estivessem|strong="G1510"\w* \w com ele|strong="G3326,G846"\w* \w e|strong="G2532"\w* \w para enviá-los|strong="G2443,G649,G846"\w* \w a proclamar|strong="G2784"\w*\x - \xo 3:14 \xt MRK 6:7; MAT 10:1; LUK 9:1; LUK 6:13; ACT 1:8; JHN 15:16\x*
\v 15 \w e|strong="G2532"\w* \w para terem|strong="G2192"\w* \w autoridade|strong="G1849"\w* \w de expulsar|strong="G1544"\w* \w os demônios|strong="G3588,G1140"\w*;\f + \fr 3.15: \ft Variante: TR e Byz acrescentam "curar doenças e" (θεραπεύειν τὰς νόσους καὶ) antes de "expulsar"\f*\x - \xo 3:15 \xt MAT 10:1; LUK 9:1; MAT 9:34; LUK 11:15; LUK 6:13; ACT 1:2\x*
\v 16 \w e|strong="G2532"\w* \w designou|strong="G4160"\w* \w os Doze|strong="G3588,G1427"\w*\f + \fr 3.16: \ft Variante: Tregelles e RP omitem "e designou os Doze,"\f*, \w e|strong="G2532"\w* \w deu o nome|strong="G2007,G3686"\w* \w de Pedro|strong="G4074"\w* \w a Simão|strong="G3588,G4613"\w*,\x - \xo 3:16 \xt LUK 9:1; LUK 6:13; JHN 1:42; LUK 8:1; ACT 1:13; ACT 1:2\x*
\v 17 \w e|strong="G2532"\w* \w Tiago|strong="G2385"\w*, \w filho|strong="G3588"\w* \w de Zebedeu|strong="G3588,G2199"\w*, \w e|strong="G2532"\w* \w João|strong="G2491"\w*, \w irmão|strong="G3588,G80"\w* \w de Tiago|strong="G3588,G2385"\w* (\w e|strong="G2532"\w* \w deu a eles|strong="G2007,G846"\w* \w o nome de|strong="G3686"\w* \w Boanerges|strong="G993"\w*, \w que significa|strong="G3739,G1510"\w* \w Filhos do Trovão|strong="G5207,G1027"\w*),\x - \xo 3:17 \xt MRK 10:35; MAT 10:2; MRK 1:19; MAT 4:21; LUK 9:1; LUK 6:13\x*
\v 18 \w e|strong="G2532"\w* \w André|strong="G406"\w*, \w e|strong="G2532"\w* \w Filipe|strong="G5376"\w*, \w e|strong="G2532"\w* \w Bartolomeu|strong="G918"\w*, \w e|strong="G2532"\w* \w Mateus|strong="G3156"\w*, \w e|strong="G2532"\w* \w Tomé|strong="G2381"\w*, \w e|strong="G2532"\w* \w Tiago|strong="G2385"\w*, \w filho|strong="G3588"\w* \w de Alfeu|strong="G3588,G256"\w*, \w e|strong="G2532"\w* \w Tadeu|strong="G2280"\w*, \w e|strong="G2532"\w* \w Simão|strong="G4613"\w*, \w o cananeu|strong="G3588,G2581"\w*\f + \fr 3.18: \ft Lit.: Καναναῖον é entendido como derivado de uma palavra aramaica ligada a "zelo" (qan'ana, "zeloso"); Lucas 6:15 e Atos 1:13 chamam o mesmo Simão de ζηλωτής, "zelote". O termo não indica origem em Canaã, e o texto não diz que pertencesse a algum partido\f*,\x - \xo 3:18 \xt ACT 1:13; LUK 6:15; MAT 10:3; LUK 6:14; MAT 10:4; LUK 9:1\x*
\v 19 \w e|strong="G2532"\w* \w Judas|strong="G2455"\w* \w Iscariotes|strong="G2469"\w*, \w que também|strong="G3739,G2532"\w* \w o entregou|strong="G3860,G846"\w*.\x - \xo 3:19 \xt JHN 12:4; MRK 14:10; JHN 6:71; MAT 10:4; MAT 26:14; JHN 13:2\x*
\p
\v 20 \w E|strong="G2532"\w* \w foi|strong="G2064"\w* \w para casa|strong="G1519,G3624"\w*; \w e|strong="G2532"\w* \w a multidão|strong="G3588,G3793"\w* \w se reuniu|strong="G4905"\w* \w de novo|strong="G3825"\w*, \w de modo que|strong="G5620"\w* \w eles|strong="G846"\w* \w não podiam|strong="G3361,G1410"\w* \w sequer|strong="G3366"\w* \w comer|strong="G5315"\w* \w pão|strong="G740"\w*.\f + \fr 3.20: \ft Variante: Tregelles traz o verbo no plural, "foram para casa" (ἔρχονται), em lugar de "foi para casa" (ἔρχεται); RP também omite o artigo antes de "multidão" e traz "nem" (μήτε) em lugar de "sequer" (μηδέ)\f*\x - \xo 3:20 \xt MAT 5:1; MRK 6:31; JHN 4:31-34\x*
\v 21 \w E|strong="G2532"\w* \w os que eram dele|strong="G3588,G3844,G846"\w*\f + \fr 3.21: \ft Nota cultural: οἱ παρʼ αὐτοῦ pode indicar familiares ou pessoas próximas (veja o v. 31)\f*, \w ao ouvirem isso|strong="G191"\w*, \w saíram|strong="G1831"\w* \w para detê-lo|strong="G2902,G846"\w*, \w pois|strong="G1063"\w* \w diziam|strong="G3004"\w*: “\w Ele está fora de si|strong="G1839"\w*.”\f + \fr 3.21: \ft Acréscimo: verbo ser/estar suprido em “os que eram dele”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:21 \xt JHN 7:5; ACT 26:24; JHN 10:20; JHN 7:3-10; MRK 3:31; 1SA 17:28\x*
\v 22 \w E|strong="G2532"\w* \w os escribas|strong="G3588,G1122"\w* \w que desceram|strong="G3588,G2597"\w* \w de Jerusalém|strong="G575,G2414"\w* \w diziam|strong="G3004"\w*: “\w Ele tem|strong="G2192"\w* \w Belzebu|strong="G954"\w*”, \w e|strong="G2532"\w* “\w é pelo chefe|strong="G1722,G3588,G758"\w* \w dos demônios|strong="G3588,G1140"\w* \w que ele expulsa|strong="G1544"\w* \w os demônios|strong="G3588,G1140"\w*.”\f + \fr 3.22: \ft Acréscimo: verbo ser/estar suprido em “é pelo chefe”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:22 \xt LUK 11:15; MAT 12:24; MAT 9:34; LUK 11:19; MAT 12:27; MAT 15:1\x*
\v 23 \w E|strong="G2532"\w*, \w chamando-os|strong="G4341,G846"\w*, \w dizia-lhes|strong="G3004,G846"\w* \w em parábolas|strong="G1722,G3850"\w*: “\w Como|strong="G4459"\w* \w pode|strong="G1410"\w* \w Satanás|strong="G4567"\w* \w expulsar|strong="G1544"\w* \w Satanás|strong="G4567"\w*?\x - \xo 3:23 \xt MRK 4:13; MAT 12:26; LUK 11:17; MAT 12:25; MRK 4:2; LUK 11:15\x*
\v 24 \w E|strong="G2532"\w* \w se um reino|strong="G1437,G932"\w* \w se dividir|strong="G3307"\w* \w contra si mesmo|strong="G1909,G1438"\w*, \w esse reino|strong="G3588,G932,G1565"\w* \w não pode|strong="G3756,G1410"\w* \w subsistir|strong="G2476"\w*;\x - \xo 3:24 \xt MAT 12:25; MAT 12:26; MRK 3:26; LUK 11:17; ZEC 11:14; 1CO 1:10-13\x*
\v 25 \w e|strong="G2532"\w* \w se uma casa|strong="G1437,G3614"\w* \w se dividir|strong="G3307"\w* \w contra si mesma|strong="G1909,G1438"\w*, \w essa casa|strong="G3588,G3614,G1565"\w* \w não poderá|strong="G3756,G1410"\w* \w subsistir|strong="G2476"\w*;\x - \xo 3:25 \xt MAT 12:25; MAT 12:26; JAS 3:16; LUK 11:17; GAL 5:15; PSA 133:1\x*
\v 26 \w e|strong="G2532"\w* \w se Satanás|strong="G1487,G3588,G4567"\w* \w se levantou|strong="G450"\w* \w contra si mesmo|strong="G1909,G1438"\w* \w e|strong="G2532"\w* \w se dividiu|strong="G3307"\w*, \w não pode|strong="G3756,G1410"\w* \w subsistir|strong="G2476"\w*, \w mas|strong="G235"\w* \w tem fim|strong="G5056,G2192"\w*.\x - \xo 3:26 \xt MRK 3:24; MAT 12:26; MAT 12:25; LUK 11:17; LUK 11:15\x*
\v 27 \w Mas|strong="G235"\w* \w ninguém|strong="G3762"\w* \w pode|strong="G1410"\w* \w entrar|strong="G1525"\w* \w na casa|strong="G1519,G3588,G3614"\w* \w do forte|strong="G3588,G2478"\w* \w e saquear|strong="G1283"\w* \w os bens|strong="G3588,G4632"\w* \w dele|strong="G846"\w*, \w se não|strong="G1437,G3361"\w* \w primeiro|strong="G4413"\w* \w amarrar|strong="G1210"\w* \w o forte|strong="G3588,G2478"\w*; \w e|strong="G2532"\w* \w então|strong="G5119"\w* \w saqueará|strong="G1283"\w* \w a casa|strong="G3588,G3614"\w* \w dele|strong="G846"\w*.\x - \xo 3:27 \xt MAT 12:29; ISA 49:24-26; LUK 11:21; EPH 6:10-13; LUK 11:17; REV 20:1-3\x*
\v 28 \w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w tudo|strong="G3956"\w* \w será perdoado|strong="G863"\w* \w aos seres humanos|strong="G3588,G5207,G444"\w*\f + \fr 3.28: \ft Lit.: literalmente "aos filhos dos seres humanos"\f*: \w os pecados|strong="G3588,G265"\w* \w e|strong="G2532"\w* \w as blasfêmias|strong="G3588,G988"\w* \w que proferirem|strong="G3745,G1437,G987"\w*;\x - \xo 3:28 \xt MAT 12:31; LUK 12:10; 1JN 5:16; MRK 3:28; HEB 6:4-8; LEV 24:16\x*
\v 29 \w mas quem|strong="G3739,G1161,G302"\w* \w blasfemar contra|strong="G987,G1519"\w* \w o Espírito Santo|strong="G3588,G4151,G40"\w*, \w não tem|strong="G3756,G2192"\w* \w perdão|strong="G859"\w* \w para sempre|strong="G1519,G3588,G165"\w*, \w e sim|strong="G235"\w* \w é réu|strong="G1777,G1510"\w* \w de um pecado eterno|strong="G166,G265"\w*.”\f + \fr 3.29: \ft Variante: a edição bizantina (RP) traz "juízo eterno" (κρίσεως) em lugar de "pecado eterno"\f*\x - \xo 3:29 \xt 1JN 5:16; MAT 12:31; LUK 12:10; MAT 12:32; MRK 3:28; HEB 9:12\x*
\v 30 \w porque|strong="G3754"\w* \w diziam|strong="G3004"\w*: “\w Ele tem|strong="G2192"\w* \w um espírito impuro|strong="G4151,G169"\w*.”\x - \xo 3:30 \xt 1JN 5:16; MAT 12:31; LUK 12:10; MRK 3:28; JHN 10:20; JHN 7:20\x*
\p
\v 31 \w E|strong="G2532"\w* \w chegaram|strong="G2064"\w* \w a mãe|strong="G3588,G3384"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w os irmãos|strong="G3588,G80"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w*, \w ficando do lado de fora|strong="G1854,G4739"\w*, \w mandaram chamá-lo|strong="G649,G4314,G846,G2564"\w*.\f + \fr 3.31: \ft Variante: NA27, NA28 e Tyndale trazem o verbo no singular, "chegou" (ἔρχεται); o texto segue o SBLGNT, com o plural\f*\x - \xo 3:31 \xt MAT 12:46; LUK 8:19; MRK 3:21; ACT 1:14\x*
\v 32 \w E|strong="G2532"\w* \w uma multidão|strong="G3793"\w* \w estava sentada|strong="G2521"\w* \w ao redor dele|strong="G4012,G846"\w*, \w e|strong="G2532"\w* \w lhe disseram|strong="G3004,G846"\w*: “\w Olhe|strong="G2400"\w*, \w a sua mãe|strong="G3588,G3384,G4771"\w* \w e|strong="G2532"\w* \w os seus irmãos|strong="G3588,G80,G4771"\w* \w estão lá fora|strong="G1854"\w* \w procurando você|strong="G2212,G4771"\w*.”\f + \fr 3.32: \ft Variante: NA27 e a edição bizantina (RP) acrescentam "e as suas irmãs" (καὶ αἱ ἀδελφαί σου)\f*\f + \fr 3.32: \ft Acréscimo: verbo ser/estar suprido em “estão lá fora”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:32 \xt MAT 12:46; MAT 12:47; LUK 8:19; MAT 12:48; ACT 1:14\x*
\v 33 \w E|strong="G2532"\w* \w ele, respondendo|strong="G611"\w* \w a eles|strong="G846"\w*, \w disse|strong="G3004"\w*: “\w Quem|strong="G5101"\w* \w é|strong="G1510"\w* \w a minha mãe|strong="G3588,G3384,G3165"\w*, \w ou|strong="G2228"\w* \w os meus irmãos|strong="G3588,G80,G3165"\w*?”\x - \xo 3:33 \xt MAT 12:48; LUK 8:21; LUK 1:60; MAT 12:46; DEU 33:9; MRK 3:21\x*
\v 34 \w E|strong="G2532"\w*, \w olhando em volta|strong="G4017"\w* \w para os que|strong="G3588"\w* \w estavam sentados|strong="G2521"\w* \w ao redor dele|strong="G4012,G846,G2945"\w*, \w disse|strong="G3004"\w*: “\w Olhem|strong="G2396"\w*, \w a minha mãe|strong="G3588,G3384,G3165"\w* \w e|strong="G2532"\w* \w os meus irmãos|strong="G3588,G80,G3165"\w*!\x - \xo 3:34 \xt MAT 12:46; MAT 25:40; MAT 12:49; LUK 11:27-28; LUK 8:19; ROM 8:29\x*
\v 35 \w Pois|strong="G1063"\w* \w quem|strong="G3739,G302"\w* \w fizer|strong="G4160"\w* \w a vontade|strong="G3588,G2307"\w* \w de Deus|strong="G3588,G2316"\w*, \w este é|strong="G3778,G1510"\w* \w meu irmão|strong="G80,G3165"\w*, \w minha irmã|strong="G79"\w* \w e minha mãe|strong="G2532,G3384"\w*.”\x - \xo 3:35 \xt MAT 12:50; MAT 7:21; 1JN 2:17; MAT 6:10; 1TH 4:3; MAT 12:46\x*
\c 4
\p
\v 1 \w E de novo|strong="G2532,G3825"\w* \w começou a|strong="G757"\w* \w ensinar|strong="G1321"\w* \w junto ao mar|strong="G3844,G3588,G2281"\w*. \w E|strong="G2532"\w* \w reuniu-se|strong="G4863"\w* \w em torno dele|strong="G4314,G846"\w* \w uma multidão|strong="G3793"\w* \w enorme|strong="G4118"\w*, \w de modo que|strong="G5620"\w* \w ele|strong="G846"\w*, \w entrando|strong="G1684"\w* \w num barco|strong="G1519,G4143"\w*, \w ficou sentado|strong="G2521"\w* \w no mar|strong="G1722,G3588,G2281"\w*, \w e|strong="G2532"\w* \w toda a multidão|strong="G3956,G3588,G3793"\w* \w estava|strong="G1510"\w* \w à beira do mar|strong="G4314,G3588,G2281"\w*, \w em terra|strong="G1909,G3588,G1093"\w*.\x - \xo 4:1 \xt MAT 13:2; MRK 2:13; MRK 5:21; LUK 5:3; MAT 13:1; MAT 5:1\x*
\v 2 \w E|strong="G2532"\w* \w ensinava-lhes|strong="G1321,G846"\w* \w muitas coisas|strong="G4183"\w* \w em parábolas|strong="G1722,G3850"\w*, \w e|strong="G2532"\w* \w dizia-lhes|strong="G3004,G846"\w* \w em seu ensino|strong="G1722,G3588,G1322,G846"\w*:\x - \xo 4:2 \xt MRK 1:22; MAT 13:3; MRK 12:1; LUK 8:4; MRK 3:23; MRK 4:11\x*
\v 3 “\w Ouçam|strong="G191"\w*. \w Olhem|strong="G2400"\w*: \w o semeador|strong="G3588,G4687"\w* \w saiu|strong="G1831"\w* \w para semear|strong="G4687"\w*.\x - \xo 4:3 \xt MAT 13:3; LUK 8:5; 1CO 3:6-9; LUK 8:4; JHN 4:35-38; MRK 4:14\x*
\v 4 \w E|strong="G2532"\w* \w aconteceu|strong="G1096"\w* \add que,\add* \w ao semear|strong="G1722,G3588,G4687"\w*, \w uma parte|strong="G3739,G3303"\w* \w caiu|strong="G4098"\w* \w à beira do caminho|strong="G3844,G3588,G3598"\w*, \w e|strong="G2532"\w* \w vieram|strong="G2064"\w* \w as aves|strong="G3588,G4071"\w* \w e|strong="G2532"\w* \w a comeram|strong="G2719,G846"\w*.\f + \fr 4.4: \ft Variante: TR acrescenta "do céu" (τοῦ οὐρανοῦ) depois de "as aves"\f*\f + \fr 4.4: \ft Acréscimo: “que” (em “E aconteceu que ao semear”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 4:4 \xt MAT 13:4; LUK 8:5; MAT 13:19; MRK 4:15; MAT 13:3; LUK 8:4\x*
\v 5 \w E|strong="G2532"\w* \w outra parte|strong="G243"\w* \w caiu|strong="G4098"\w* \w no terreno pedregoso|strong="G1909,G3588,G4075"\w*, \w onde|strong="G3699"\w* \w não havia|strong="G3756,G2192"\w* \w muita terra|strong="G1093,G4183"\w*, \w e|strong="G2532"\w* \w logo|strong="G2112"\w* \w brotou|strong="G1816"\w*, \w por não ter|strong="G1223,G3588,G3361,G2192"\w* \w profundidade|strong="G899"\w* \w de terra|strong="G1093"\w*;\x - \xo 4:5 \xt MAT 13:5; MAT 13:3; 1JN 2:19; LUK 8:4; EZK 36:26; LUK 8:6\x*
\v 6 \w e|strong="G2532"\w*, \w quando|strong="G3753"\w* \w o sol|strong="G3588,G2246"\w* \w nasceu|strong="G393"\w*, \w foi queimada|strong="G2739"\w*, \w e|strong="G2532"\w*, \w por não ter|strong="G1223,G3588,G3361,G2192"\w* \w raiz|strong="G4491"\w*, \w secou|strong="G3583"\w*.\x - \xo 4:6 \xt MAT 13:6; JAS 1:11; MAT 13:3; 1JN 2:19; LUK 8:4; JER 17:5-8\x*
\v 7 \w E|strong="G2532"\w* \w outra parte|strong="G243"\w* \w caiu|strong="G4098"\w* \w entre os espinhos|strong="G1519,G3588,G173"\w*, \w e|strong="G2532"\w* \w os espinhos|strong="G3588,G173"\w* \w cresceram|strong="G305"\w* \w e|strong="G2532"\w* \w a sufocaram|strong="G4846,G846"\w*, \w e|strong="G2532"\w* \w ela não deu|strong="G3756,G1325"\w* \w fruto|strong="G2590"\w*.\x - \xo 4:7 \xt MAT 13:7; LUK 8:14; MRK 4:18; MAT 13:22; LUK 8:7; MAT 13:3\x*
\v 8 \w E|strong="G2532"\w* \w outras|strong="G243"\w* \w caíram|strong="G4098"\w* \w na terra boa|strong="G1519,G3588,G1093,G2570"\w*, \w e|strong="G2532"\w* \w davam|strong="G1325"\w* \w fruto|strong="G2590"\w* \w que subia|strong="G305"\w* \w e|strong="G2532"\w* \w crescia|strong="G837"\w*\f + \fr 4.8: \ft Lit.: o segundo particípio, αὐξανόμενα ("crescendo"), está no plural e não concorda em número com "fruto", que é singular; por isso o que "crescia" pode ser a plantação e não só o fruto\f*, \w e|strong="G2532"\w* \w produziam|strong="G5342"\w*: \w trinta por um|strong="G1520,G5144"\w*\f + \fr 4.8: \ft Lit.: ἓν τριάκοντα, literalmente "um trinta"; indica o rendimento de cada semente (trinta por um), e o mesmo vale para "sessenta" e "cem"\f*, \w sessenta por um|strong="G1520,G1835"\w* \w e cem por um|strong="G2532,G1520,G1540"\w*.”\x - \xo 4:8 \xt MAT 13:8; MRK 4:20; MAT 13:23; GEN 26:12; MAT 13:3; JHN 15:5\x*
\v 9 \w E|strong="G2532"\w* \w dizia|strong="G3004"\w*: “\w Quem|strong="G3739"\w* \w tem|strong="G2192"\w* \w ouvidos|strong="G3775"\w* \w para ouvir|strong="G191"\w*, \w ouça|strong="G191"\w*.”\x - \xo 4:9 \xt MAT 11:15; MRK 4:23; MAT 13:3; REV 3:13; REV 3:22; REV 3:6\x*
\p
\v 10 \w E|strong="G2532"\w*, \w quando|strong="G3753"\w* \w ficou|strong="G1096"\w* \w a sós|strong="G2596,G3441"\w*, \w os que estavam|strong="G3588"\w* \w ao redor dele|strong="G4012,G846"\w*, \w com os Doze|strong="G4862,G3588,G1427"\w*, \w lhe perguntavam|strong="G2065,G846"\w* \w sobre as parábolas|strong="G3588,G3850"\w*.\f + \fr 4.10: \ft Variante: RP traz "Mas quando" (Ὅτε δὲ) em lugar de "E quando", o verbo no aoristo, "perguntaram" (ἠρώτησαν), e "a parábola", no singular (τὴν παραβολήν), em lugar de "as parábolas"\f*\f + \fr 4.10: \ft Acréscimo: “os que estavam”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 4:10 \xt MRK 7:17; JHN 17:20; MAT 13:10; PRO 28:5; MRK 10:10; MRK 4:34\x*
\v 11 \w E|strong="G2532"\w* \w dizia a eles|strong="G3004,G846"\w*: “\w A vocês|strong="G4771"\w* \w foi dado|strong="G1325"\w* \w o mistério|strong="G3588,G3466"\w* \w do reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*\f + \fr 4.11: \ft Variante: RP traz "foi dado conhecer o mistério" (δέδοται γνῶναι τὸ μυστήριον), com "conhecer" a mais e outra ordem\f*; \w mas para aqueles|strong="G1565,G1161,G3588"\w* \w de fora|strong="G1854"\w* \w tudo|strong="G3588,G3956"\w* \w acontece|strong="G1096"\w* \w em parábolas|strong="G1722,G3850"\w*,\x - \xo 4:11 \xt LUK 8:10; MAT 13:11; ROM 11:8; PRO 1:6; MAT 11:25; COL 1:26\x*
\v 12 \w para que|strong="G2443"\w*, \w olhando|strong="G991"\w*, \w olhem|strong="G991"\w* \w e|strong="G2532"\w* \w não vejam|strong="G3361,G1492"\w*, \w e|strong="G2532"\w*, \w ouvindo|strong="G191"\w*, \w ouçam|strong="G191"\w* \w e|strong="G2532"\w* \w não entendam|strong="G3361,G4920"\w*, \w para que não|strong="G4218,G3361"\w* \w se voltem|strong="G1994"\w* \w e|strong="G2532"\w* \w lhes seja perdoado|strong="G863,G846"\w*.”\f + \fr 4.12: \ft Nota cultural: citação de Isaías 6:9-10\f*\f + \fr 4.12: \ft Variante: RP acrescenta "os pecados" (τὰ ἁμαρτήματα) depois de "lhes", de modo que se lê "lhes sejam perdoados os pecados"\f*\x - \xo 4:12 \xt ISA 6:9; MRK 8:18; MAT 13:14; MAT 13:15; ACT 28:26; LUK 8:10\x*
\v 13 \w E|strong="G2532"\w* \w disse a eles|strong="G3004,G846"\w*: “\w Vocês não entendem|strong="G3756,G6063"\w* \w esta parábola|strong="G3588,G3850,G3778"\w*? \w Então|strong="G2532"\w* \w como|strong="G4459"\w* \w entenderão|strong="G1097"\w* \w todas as parábolas|strong="G3956,G3588,G3850"\w*?\x - \xo 4:13 \xt MAT 21:45; MRK 4:30; MRK 3:23; MAT 13:3; PRO 28:5; JHN 16:25\x*
\v 14 \w O semeador|strong="G3588,G4687"\w* \w semeia|strong="G4687"\w* \w a palavra|strong="G3588,G3056"\w*.\x - \xo 4:14 \xt LUK 8:11; ACT 8:4; MAT 13:19; 1PE 1:23-25; MAT 13:37; MRK 2:2\x*
\v 15 \w Estes|strong="G3778"\w* \w são|strong="G1510"\w* \w os que estão|strong="G3588"\w* \w à beira do caminho|strong="G3844,G3588,G3598"\w*, \w onde|strong="G3699"\w* \w a palavra|strong="G3588,G3056"\w* \w é semeada|strong="G4687"\w*; \w e|strong="G2532"\w* \w quando|strong="G3752"\w* \w ouvem|strong="G191"\w*, \w logo|strong="G2112"\w* \w vem|strong="G2064"\w* \w Satanás|strong="G3588,G4567"\w* \w e|strong="G2532"\w* \w tira|strong="G142"\w* \w a palavra|strong="G3588,G3056"\w* \w que foi semeada|strong="G3588,G4687"\w* \w neles|strong="G1519,G846"\w*.\f + \fr 4.15: \ft Variante: TR e Byz trazem "em seus corações" (ἐν ταῖς καρδίαις αὐτῶν) em lugar de "neles"\f*\f + \fr 4.15: \ft Acréscimo: “os que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 4:15 \xt MRK 4:4; MAT 13:19; LUK 8:12; 1PE 5:8; LUK 8:11; LUK 8:5\x*
\v 16 \w E|strong="G2532"\w* \w estes são|strong="G3778,G1510"\w* \w igualmente|strong="G3668"\w* \w os que foram semeados|strong="G3588,G4687"\w* \w em terreno pedregoso|strong="G1909,G3588,G4075"\w*, \w os quais|strong="G3739"\w* \w quando|strong="G3752"\w* \w ouvem|strong="G191"\w* \w a palavra|strong="G3588,G3056"\w*, \w logo|strong="G2112"\w* \w a recebem|strong="G2983,G846"\w* \w com alegria|strong="G3326,G5479"\w*,\x - \xo 4:16 \xt MAT 13:20; EZK 36:26; LUK 8:11; ACT 2:42; LUK 8:13; MRK 6:20\x*
\v 17 \w e|strong="G2532"\w* \w não têm|strong="G3756,G2192"\w* \w raiz|strong="G4491"\w* \w em si mesmos|strong="G1722,G1438"\w*, \w mas|strong="G235"\w* \w duram pouco|strong="G4340,G1510"\w*; \w depois|strong="G1534"\w*, \w quando surge|strong="G1096"\w* \w aflição|strong="G2347"\w* \w ou|strong="G2228"\w* \w perseguição|strong="G1375"\w* \w por causa da palavra|strong="G1223,G3588,G3056"\w*, \w logo|strong="G2112"\w* \w tropeçam|strong="G4624"\w*.\x - \xo 4:17 \xt MAT 13:21; EZK 36:26; MAT 5:11; LUK 8:11; MAT 24:10; ACT 2:42\x*
\v 18 \w E|strong="G2532"\w* \w há outros|strong="G243,G1510"\w* \w que foram semeados|strong="G3588,G4687"\w* \w entre os espinhos|strong="G1519,G3588,G173"\w*; \w estes são|strong="G3778,G1510"\w* \w os que ouviram|strong="G3588,G191"\w* \w a palavra|strong="G3588,G3056"\w*,\x - \xo 4:18 \xt MAT 13:7; MAT 13:22; MRK 4:7; LUK 8:11; JER 4:3; 1CO 15:1\x*
\v 19 \w e|strong="G2532"\w* \w as preocupações|strong="G3588,G3308"\w* \w da era|strong="G3588,G165"\w*\f + \fr 4.19: \ft Lit.: αἰών significa "era, época" e também "o mundo presente"\f*\f + \fr 4.19: \ft Variante: a edição bizantina (RP) acrescenta "deste" (τούτου) depois de "era"\f*, \w o engano|strong="G3588,G539"\w* \w da riqueza|strong="G3588,G4149"\w*, \w e|strong="G2532"\w* \w os desejos|strong="G3588,G1939"\w* \w pelas demais coisas|strong="G4012,G3588,G3062"\w*, \w entrando|strong="G1531"\w*, \w sufocam|strong="G4846"\w* \w a palavra|strong="G3588,G3056"\w*, \w e|strong="G2532"\w* \w ela fica|strong="G1096"\w* \w sem fruto|strong="G175"\w*.\x - \xo 4:19 \xt MAT 13:22; LUK 8:14; MAT 6:25; LUK 21:34; LUK 10:41; 1JN 2:15-17\x*
\v 20 \w E|strong="G2532"\w* \w aqueles são|strong="G1565,G1510"\w* \w os que foram semeados|strong="G3588,G4687"\w* \w na terra boa|strong="G1909,G3588,G1093,G2570"\w*: \w os que|strong="G3748"\w* \w ouvem|strong="G191"\w* \w a palavra|strong="G3588,G3056"\w*, \w a acolhem|strong="G3858"\w* \w e|strong="G2532"\w* \w dão fruto|strong="G2592"\w*: \w trinta por um|strong="G1520,G5144"\w*, \w sessenta por um|strong="G1520,G1835"\w* \w e cem por um|strong="G2532,G1520,G1540"\w*.”\x - \xo 4:20 \xt MAT 13:23; MRK 4:8; LUK 8:15; MAT 13:8; COL 1:10; JHN 15:4-5\x*
\p
\v 21 \w E|strong="G2532"\w* \w dizia a eles|strong="G3004,G846"\w*: “\w Por acaso|strong="G3385"\w* \w a lâmpada|strong="G3588,G3088"\w* \w vem|strong="G2064"\w* \w para ser posta|strong="G2443,G5087"\w* \w debaixo do módio|strong="G5259,G3588,G3426"\w*\f + \fr 4.21: \ft Lit.: μόδιον, vasilha que servia de medida de cereais\f* \w ou|strong="G2228"\w* \w debaixo da cama|strong="G5259,G3588,G2825"\w*, \w e não|strong="G3756"\w* \w para ser posta|strong="G2443,G5087"\w* \w sobre o candeeiro|strong="G1909,G3588,G3087"\w*?\x - \xo 4:21 \xt MAT 5:15; LUK 11:33; LUK 8:16; ISA 60:1-3; EPH 5:3-15; 1CO 12:7\x*
\v 22 \w Pois|strong="G1063"\w* \w nada está|strong="G3756,G1510"\w* \w oculto|strong="G2927"\w* \w a não ser|strong="G1437,G3361"\w* \w para ser manifestado|strong="G2443,G5319"\w*, \w nem|strong="G3761"\w* \w se tornou|strong="G1096"\w* \w secreto|strong="G614"\w* \w a não ser|strong="G235"\w* \w para vir|strong="G2443,G2064"\w* \w à luz|strong="G1519,G5318"\w*.\x - \xo 4:22 \xt LUK 8:17; LUK 12:2; MAT 10:26; ECC 12:14; LUK 11:33; LUK 8:16\x*
