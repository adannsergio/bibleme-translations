\v 14 \w Mas|strong="G1161"\w* \w Pilatos|strong="G3588,G4091"\w* \w lhes dizia|strong="G3004,G846"\w*: “\w Pois|strong="G1063"\w* \w que mal|strong="G5101,G2556"\w* \w ele fez|strong="G4160"\w*?” \w Mas|strong="G1161"\w* \w eles|strong="G3588"\w* \w gritaram ainda mais|strong="G4057,G2896"\w*: “\w Crucifique-o|strong="G4717,G846"\w*!”\x - \xo 15:14 \xt MAT 27:23; MAT 27:22; DAN 6:16; JHN 18:39; LUK 23:4; LUK 23:41\x*
\v 15 \w Mas|strong="G1161"\w* \w Pilatos|strong="G3588,G4091"\w*, \w querendo|strong="G1014"\w* \w contentar|strong="G3588,G2425,G4160"\w*\f + \fr 15.15: \ft Lit.: τὸ ἱκανὸν ποιῆσαι é um latinismo (satisfacere), "dar satisfação"\f* \w a multidão|strong="G3588,G3793"\w*, \w soltou-lhes|strong="G630,G846"\w* \w Barrabás|strong="G3588,G912"\w*, \w e|strong="G2532"\w* \w entregou|strong="G3860"\w* \w Jesus|strong="G3588,G2424"\w*, \w depois de açoitá-lo|strong="G5417"\w*\f + \fr 15.15: \ft Lit.: φραγελλόω vem do latim flagellare, "açoitar com chicote"\f*, \w para que fosse crucificado|strong="G2443,G4717"\w*.\x - \xo 15:15 \xt MAT 27:26; ISA 50:6; JHN 19:1; ACT 24:27; LUK 23:24; EXO 23:2\x*
\v 16 \w Os soldados|strong="G3588,G4757"\w* \w o levaram|strong="G520,G846"\w* \w para dentro|strong="G2080"\w* \w do pátio|strong="G3588,G833"\w*, \w que é|strong="G3739,G1510"\w* \w o pretório|strong="G4232"\w*, \w e|strong="G2532"\w* \w reuniram|strong="G4779"\w* \w toda a coorte|strong="G3650,G3588,G4686"\w*\f + \fr 15.16: \ft Nota cultural: σπεῖρα é a "coorte", unidade do exército romano\f*.\x - \xo 15:16 \xt MAT 27:27; PSA 22:16; JHN 19:2; JHN 19:9; LUK 23:11; MAT 20:19\x*
\v 17 \w E|strong="G2532"\w* \w o vestiram|strong="G1737,G846"\w* \w de púrpura|strong="G4209"\w*, \w e|strong="G2532"\w*, \w trançando|strong="G4120"\w* \w uma coroa|strong="G4735"\w* \w de espinhos|strong="G174"\w*, \w a puseram|strong="G4060"\w* \w nele|strong="G846"\w*;\x - \xo 15:17 \xt PSA 22:16; JHN 19:2; MRK 10:34; MAT 27:28; LUK 23:11; MAT 20:19\x*
\v 18 \w e|strong="G2532"\w* \w começaram a|strong="G757"\w* \w saudá-lo|strong="G782,G846"\w*: “\w Salve|strong="G5463"\w*, \w rei|strong="G935"\w* \w dos judeus|strong="G3588,G2453"\w*!”\f + \fr 15.18: \ft Tradução: Χαῖρε (χαίρω, G5463) está aqui como “Salve”; o termo pode ser “alegrar-se”, “regozijar-se” ou “saudar” (χαῖρε como saudação), e o contexto decide.\f*\x - \xo 15:18 \xt MRK 15:2; JHN 19:3; PSA 22:16; JHN 19:2; MRK 10:34; LUK 23:11\x*
\v 19 \w E|strong="G2532"\w* \w batiam|strong="G5180"\w* \w na cabeça|strong="G3588,G2776"\w* \w dele|strong="G846"\w* \w com uma cana|strong="G2563"\w*, \w e|strong="G2532"\w* \w cuspiam|strong="G1716"\w* \w nele|strong="G846"\w*, \w e|strong="G2532"\w*, \w dobrando os joelhos|strong="G5087,G3588,G1119"\w*, \w se prostravam|strong="G4352"\w*\f + \fr 15.19: \ft Lit.: προσκυνέω, "prostrar-se, render homenagem"; também "adorar"\f* \w diante dele|strong="G846"\w*.\x - \xo 15:19 \xt MAT 27:30; ISA 50:6; PSA 22:16; ISA 53:3; JHN 19:2; MRK 10:34\x*
\v 20 \w E|strong="G2532"\w*, \w depois|strong="G3753"\w* \w de zombarem|strong="G1702"\w* \w dele|strong="G846"\w*, \w tiraram|strong="G1562"\w* \w dele|strong="G846"\w* \w a púrpura|strong="G3588,G4209"\w* \w e|strong="G2532"\w* \w o vestiram|strong="G1746,G846"\w* \w com as suas próprias roupas|strong="G3588,G2440,G2398"\w*. \w E|strong="G2532"\w* \w o levaram para fora|strong="G1806,G846"\w* \w para que|strong="G2443"\w* \w o crucificassem|strong="G4717,G846"\w*.\f + \fr 15.20: \ft Variante: WH e NA28 trazem "as suas roupas" (αὐτοῦ) em lugar de "as próprias roupas" (τὰ ἴδια); Tregelles traz σταυρώσουσιν, no futuro\f*\x - \xo 15:20 \xt MAT 27:31; PSA 22:16; HEB 13:12; JHN 19:2; MRK 10:34; LUK 23:11\x*
\v 21 \w E|strong="G2532"\w* \w obrigaram|strong="G29"\w*\f + \fr 15.21: \ft Lit.: ἀγγαρεύω, "requisitar à força, obrigar a prestar serviço"\f* \w um certo|strong="G5100"\w* \w Simão|strong="G4613"\w*, \w cireneu|strong="G2956"\w*, \w que passava|strong="G3855"\w* \w vindo|strong="G2064"\w* \w do campo|strong="G575,G68"\w*, \w o pai|strong="G3588,G3962"\w* \w de Alexandre|strong="G223"\w* \w e|strong="G2532"\w* \w de Rufo|strong="G4504"\w*, \w a carregar|strong="G2443,G142"\w* \w a cruz|strong="G3588,G4716"\w* \w dele|strong="G846"\w*.\x - \xo 15:21 \xt MAT 27:32; LUK 23:26; MAT 16:24; HEB 13:12; ROM 16:13; LUK 14:27\x*
\v 22 \w E|strong="G2532"\w* \w o levaram|strong="G5342,G846"\w* \w ao lugar|strong="G1909,G3588,G5117"\w* \w Gólgota|strong="G1115"\w*, \w que|strong="G3739"\w* \w traduzido significa|strong="G1510,G3177"\w*: \w Lugar|strong="G5117"\w* \w da Caveira|strong="G2898"\w*.\x - \xo 15:22 \xt MAT 27:33; JHN 19:17; LUK 23:33; HEB 13:12; LUK 23:26; LUK 23:27-38\x*
\v 23 \w E|strong="G2532"\w* \w lhe ofereciam|strong="G1325,G846"\w* \w vinho|strong="G3631"\w* \w misturado com mirra|strong="G4669"\w*, \w mas|strong="G1161"\w* \w ele|strong="G3739"\w* \w não o tomou|strong="G3756,G2983"\w*.\f + \fr 15.23: \ft Variante: TR e Byz (e RP) acrescentam "para beber" (πιεῖν) depois de "ofereciam"; RP traz o artigo ὁ em lugar de ὅς antes de "não o tomou"\f*\x - \xo 15:23 \xt PSA 69:21; MAT 27:34; HEB 13:12; LUK 23:33; LUK 23:26; MRK 15:36\x*
\v 24 \w E|strong="G2532"\w* \w o crucificaram|strong="G4717,G846"\w* \w e|strong="G2532"\w* \w repartiram|strong="G1266"\w* \w as roupas|strong="G3588,G2440"\w* \w dele|strong="G846"\w*, \w lançando|strong="G906"\w* \w sorte|strong="G2819"\w* \w sobre elas|strong="G1909,G846"\w* \add para ver\add* \w quem|strong="G5101"\w* \w levaria|strong="G142"\w* \w o quê|strong="G5101"\w*.\f + \fr 15.24: \ft Variante: RP traz "crucificando-o" (σταυρώσαντες αὐτόν) em lugar de "o crucificaram e"\f*\f + \fr 15.24: \ft Acréscimo: “para” (em “sobre elas para ver quem”): preposição ou artigo que a regência do português exige; “ver” (em “elas para ver quem levaria”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 15:24 \xt MAT 27:35; LUK 23:34; PSA 22:18; PSA 22:16; JHN 19:23; HEB 13:12\x*
\v 25 \w Era|strong="G1510"\w* \w a terceira hora|strong="G5610,G5154"\w*, \w e|strong="G2532"\w* \w o crucificaram|strong="G4717,G846"\w*.\x - \xo 15:25 \xt ACT 2:15; LUK 24:7; MRK 15:33; MAT 27:35; LUK 23:26; JHN 19:14\x*
\v 26 \w E|strong="G2532"\w* \w a inscrição|strong="G3588,G1923"\w* \w da acusação|strong="G3588,G156"\w* \w dele|strong="G846"\w* \w estava escrita|strong="G1510,G1924"\w*: “\w O rei|strong="G3588,G935"\w* \w dos judeus|strong="G3588,G2453"\w*.”\x - \xo 15:26 \xt LUK 23:38; MAT 27:37; LUK 23:37; MAT 27:35; JHN 19:19; LUK 23:26\x*
\v 27 \w E|strong="G2532"\w* \w com ele|strong="G4862,G846"\w* \w crucificaram|strong="G4717"\w* \w dois bandidos|strong="G1417,G3027"\w*, \w um|strong="G1520"\w* \w à direita|strong="G1537,G1188"\w* \w e|strong="G2532"\w* \w outro|strong="G1520"\w* \w à esquerda|strong="G1537,G2176"\w* \w dele|strong="G846"\w*.\f + \fr 15.27: \ft Variante: Tregelles e RP acrescentam aqui o v. 28: "E cumpriu-se a Escritura que diz: ‘Foi contado entre os sem-lei’" (καὶ ἐπληρώθη ἡ γραφὴ ἡ λέγουσα· καὶ μετὰ ἀνόμων ἐλογίσθη); o SBLGNT, WH e NA28 não o trazem\f*\x - \xo 15:27 \xt MAT 27:38; MAT 20:21; ISA 53:12; LUK 23:32; MAT 27:35; LUK 23:26\x*
\p
\v 29 \w E|strong="G2532"\w* \w os que passavam|strong="G3588,G3899"\w* \w o insultavam|strong="G987,G846"\w*\f + \fr 15.29: \ft Lit.: βλασφημέω, "falar mal, insultar"; também "blasfemar"\f*, \w balançando|strong="G2795"\w* \w a cabeça|strong="G3588,G2776"\w* \w deles|strong="G846"\w* \w e|strong="G2532"\w* \w dizendo|strong="G3004"\w*: “\w Ah|strong="G3758"\w*! \w Você que|strong="G3588"\w* \w destrói|strong="G2647"\w* \w o santuário|strong="G3588,G3485"\w* \w e|strong="G2532"\w* \w o reconstrói|strong="G3618"\w* \w em três dias|strong="G1722,G5140,G2250"\w*,\x - \xo 15:29 \xt MAT 27:39; MAT 26:61; MRK 14:58; JHN 2:19; MAT 27:40; PSA 22:7\x*
\v 30 \w salve|strong="G4982"\w* \w a si mesmo|strong="G4771"\w*, \w descendo|strong="G2597"\w* \w da cruz|strong="G575,G3588,G4716"\w*!”\x - \xo 15:30 \xt MAT 27:42; MAT 27:40; PSA 22:8; MAT 27:35; LUK 23:26; MRK 10:34\x*
\v 31 \w Do mesmo modo|strong="G3668"\w*, \w também|strong="G2532"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w*, \w zombando|strong="G1702"\w* \w entre si|strong="G4314,G240"\w* \w com os escribas|strong="G3326,G3588,G1122"\w*, \w diziam|strong="G3004"\w*: “\w Outros|strong="G243"\w* \w salvou|strong="G4982"\w*; \w a si mesmo|strong="G1438"\w* \w não pode|strong="G3756,G1410"\w* \w salvar|strong="G4982"\w*;\x - \xo 15:31 \xt MAT 27:41; PSA 22:8; MAT 27:35; LUK 23:26; MRK 10:34; PSA 69:26\x*
\v 32 \w o Cristo|strong="G3588,G5547"\w*, \w o rei|strong="G3588,G935"\w* \w de Israel|strong="G2474"\w*, \w desça|strong="G2597"\w* \w agora|strong="G3568"\w* \w da cruz|strong="G575,G3588,G4716"\w*, \w para que|strong="G2443"\w* \w vejamos|strong="G1492"\w* \w e|strong="G2532"\w* \w creiamos|strong="G4100"\w*.” \w E|strong="G2532"\w* \w os que estavam crucificados|strong="G3588,G4957"\w* \w com ele|strong="G4862,G846"\w* \w o injuriavam|strong="G3679,G846"\w*.\f + \fr 15.32: \ft Variante: RP acrescenta "nele" (αὐτῷ) depois de "creiamos" e o artigo τοῦ antes de "Israel"\f*\x - \xo 15:32 \xt MAT 27:44; MAT 27:42; PSA 22:8; LUK 23:39; MAT 27:35; LUK 23:26\x*
\p
