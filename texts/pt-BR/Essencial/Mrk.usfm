\v 30 \w E|strong="G2532"\w* \w os apóstolos|strong="G3588,G652"\w* \w se reuniram|strong="G4863"\w* \w junto a Jesus|strong="G4314,G3588,G2424"\w*, \w e|strong="G2532"\w* \w lhe contaram|strong="G518,G846"\w* \w tudo o que|strong="G3956,G3745"\w* \w tinham feito|strong="G4160"\w* \w e|strong="G2532"\w* \w o que|strong="G3745"\w* \w tinham ensinado|strong="G1321"\w*.\x - \xo 6:30 \xt LUK 9:10; LUK 17:5; LUK 10:17; MAT 14:13; ACT 1:2; LUK 6:13\x*
\v 31 \w E|strong="G2532"\w* \w disse-lhes|strong="G3004,G846"\w*: “\w Venham|strong="G1205"\w* \w vocês mesmos|strong="G4771,G846"\w*, \w à parte|strong="G2596,G2398"\w*, \w a um lugar deserto|strong="G1519,G2048,G5117"\w*, \w e|strong="G2532"\w* \w descansem|strong="G373"\w* \w um pouco|strong="G3641"\w*.” \w Pois|strong="G1063"\w* \w eram muitos|strong="G1510,G4183"\w* \w os que chegavam|strong="G3588,G2064"\w* \w e|strong="G2532"\w* \w os que partiam|strong="G3588,G5217"\w*, \w e|strong="G2532"\w* \w nem tinham tempo|strong="G3761,G2119"\w* \w de comer|strong="G5315"\w*.\x - \xo 6:31 \xt JHN 6:1; MRK 3:20; MRK 7:24; MRK 3:7; MRK 1:45; MAT 14:13\x*
