\v 34 \w E|strong="G2532"\w*, \w na nona hora|strong="G3588,G1766,G5610"\w*, \w Jesus|strong="G3588,G2424"\w* \w clamou|strong="G994"\w* \w em voz alta|strong="G5456,G3173"\w*: “\w Eloí|strong="G1682"\w*, \w Eloí|strong="G1682"\w*, \w lemá|strong="G2982"\w* \w sabactâni|strong="G4518"\w*?”\f + \fr 15.34: \ft Nota cultural: palavras em aramaico, que citam o Salmo 22:2\f*, \w que|strong="G3739"\w* \w traduzido significa|strong="G1510,G3177"\w*: “\w Meu Deus|strong="G3588,G2316,G3165"\w*, \w meu Deus|strong="G3588,G2316,G3165"\w*, \w por que|strong="G1519,G5101"\w* \w me abandonou|strong="G1459,G3165"\w*?”\x - \xo 15:34 \xt PSA 22:2; MAT 27:46; PSA 22:1; LUK 23:46; HEB 5:7; PSA 27:9\x*
\v 35 \w E|strong="G2532"\w* \w alguns|strong="G5100"\w* \w dos presentes|strong="G3588,G3936"\w*, \w ao ouvirem|strong="G191"\w*, \w diziam|strong="G3004"\w*: “\w Vejam|strong="G2396"\w*, \w ele chama|strong="G5455"\w* \w Elias|strong="G2243"\w*.”\x - \xo 15:35 \xt MAT 27:47; JHN 19:26; LUK 23:46\x*
\v 36 \w Mas|strong="G1161"\w* \w alguém|strong="G5100"\w*, \w correndo|strong="G5143"\w* \w e|strong="G2532"\w* \w enchendo de vinagre|strong="G1072,G3690"\w* \w uma esponja|strong="G4699"\w*, \w pondo-a|strong="G4060"\w* \w numa cana|strong="G2563"\w*, \w lhe dava de beber|strong="G4222,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Deixem|strong="G863"\w*, \w vejamos|strong="G1492"\w* \w se|strong="G1487"\w* \w Elias vem|strong="G2064,G2243"\w* \w descê-lo|strong="G2507,G846"\w*.”\x - \xo 15:36 \xt MAT 27:48; JHN 19:29; LUK 23:46; PSA 69:21; MRK 15:23; JHN 19:28-30\x*
\v 37 \w Mas|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w*, \w dando|strong="G863"\w* \w um grande grito|strong="G5456,G3173"\w*, \w expirou|strong="G1606"\w*.\f + \fr 15.37: \ft Tradução: ἀφεὶς (ἀφίημι, G863) está aqui como “dando”; o termo pode ser “deixar”, “perdoar”, “permitir”, “abandonar” ou “mandar embora”, e o contexto decide.\f*\x - \xo 15:37 \xt LUK 23:46; MAT 27:50; JHN 19:30; HEB 5:7\x*
\v 38 \w E|strong="G2532"\w* \w o véu|strong="G3588,G2665"\w* \w do santuário|strong="G3588,G3485"\w* \w foi rasgado|strong="G4977"\w* \w em dois|strong="G1519,G1417"\w*, \w de cima|strong="G575,G509"\w* \w até embaixo|strong="G2193,G2736"\w*.\x - \xo 15:38 \xt MAT 27:51; LUK 23:45; LUK 23:46; HEB 10:19-23; HEB 9:3-12; LEV 16:2-19\x*
\v 39 \w Mas|strong="G1161"\w* \w o centurião|strong="G3588,G2760"\w* \w que estava|strong="G3588,G3936"\w* \w diante dele|strong="G1537,G1727,G846"\w*, \w vendo|strong="G1492"\w* \w que|strong="G3754"\w* \w assim|strong="G3779"\w* \w expirou|strong="G1606"\w*, \w disse|strong="G2036"\w*: “\w Realmente|strong="G230"\w* \w este homem|strong="G3778,G3588,G444"\w* \w era|strong="G1510"\w* \w filho de Deus|strong="G5207,G2316"\w*.”\f + \fr 15.39: \ft Lit.: υἱὸς θεοῦ, sem artigo no grego; pode ser lido "filho de Deus" ou "um filho de Deus"\f*\f + \fr 15.39: \ft Variante: Tregelles, TR e Byz (e RP) acrescentam "gritando" (κράξας) depois de "assim"; RP traz outra ordem em "este homem" e em "era filho de Deus"\f*\x - \xo 15:39 \xt LUK 23:46; LUK 23:47; MAT 27:54; JHN 19:7; MAT 27:43; MAT 8:5\x*
\p
\v 40 \w E|strong="G1161"\w* \w havia|strong="G1510"\w* \w também|strong="G2532"\w* \w mulheres|strong="G1135"\w* \w olhando|strong="G2334"\w* \w de longe|strong="G575,G3113"\w*, \w entre as quais|strong="G1722,G3739"\w* \w também|strong="G2532"\w* \w Maria|strong="G3137"\w* \w Madalena|strong="G3588,G3094"\w*, \w e|strong="G2532"\w* \w Maria|strong="G3137"\w*, \w mãe|strong="G3384"\w* \w de Tiago|strong="G3588,G2385"\w* \w o menor|strong="G3588,G3398"\w*\f + \fr 15.40: \ft Lit.: μικρός, "pequeno"; pode indicar baixa estatura ou ser "o mais novo"\f* \w e|strong="G2532"\w* \w de Joses|strong="G2500"\w*, \w e|strong="G2532"\w* \w Salomé|strong="G4539"\w*,\x - \xo 15:40 \xt MRK 15:47; MRK 16:1; JHN 19:25; MRK 6:3; LUK 24:10; MAT 27:55\x*
\v 41 \w as quais|strong="G3739"\w*, \w quando|strong="G3753"\w* \w ele estava|strong="G1510"\w* \w na Galileia|strong="G1722,G3588,G1056"\w*, \w o seguiam|strong="G190,G846"\w* \w e|strong="G2532"\w* \w o serviam|strong="G1247,G846"\w*; \w e|strong="G2532"\w* \w muitas outras|strong="G243,G4183"\w* \w que tinham subido|strong="G3588,G4872"\w* \w com ele|strong="G846"\w* \w a Jerusalém|strong="G1519,G2414"\w*.\x - \xo 15:41 \xt LUK 23:46; JHN 19:25; LUK 8:2; LUK 23:49; LUK 24:10\x*
\p
\v 42 \w E|strong="G2532"\w*, \w já|strong="G2235"\w* \w tendo chegado|strong="G1096"\w* \w a tarde|strong="G3798"\w*, \w como|strong="G1893"\w* \w era|strong="G1510"\w* \w a Preparação|strong="G3904"\w*\f + \fr 15.42: \ft Nota cultural: παρασκευή, "preparação": o dia anterior ao sábado, a sexta-feira\f*, \w isto é|strong="G3739,G1510"\w*, \w a véspera do sábado|strong="G4315"\w*,\x - \xo 15:42 \xt JHN 19:31; MAT 27:62; LUK 23:50; MRK 14:8; JHN 19:38; LUK 23:54\x*
\v 43 \w veio|strong="G2064"\w* \w José|strong="G2501"\w* \w de Arimateia|strong="G3588,G575,G707"\w*, \w membro respeitável|strong="G2158"\w* \w do conselho|strong="G1010"\w*\f + \fr 15.43: \ft Lit.: βουλευτής, "conselheiro", membro de um conselho (βουλή); o texto não diz de qual\f*, \w que também|strong="G3739,G2532,G846"\w* \w esperava|strong="G1510,G4327"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*, \w tendo ousado|strong="G5111"\w*, \w foi|strong="G1525"\w* \w a Pilatos|strong="G4314,G3588,G4091"\w* \w e|strong="G2532"\w* \w pediu|strong="G154"\w* \w o corpo|strong="G3588,G4983"\w* \w de Jesus|strong="G3588,G2424"\w*.\x - \xo 15:43 \xt JHN 19:38; LUK 23:51; LUK 23:50; MAT 27:57; ISA 53:9; LUK 2:25\x*
\v 44 \w Mas|strong="G1161"\w* \w Pilatos|strong="G3588,G4091"\w* \w se admirou|strong="G2296"\w* \w de que|strong="G1487"\w* \w já|strong="G2235"\w* \w tivesse morrido|strong="G2348"\w*, \w e|strong="G2532"\w*, \w chamando|strong="G4341"\w* \w o centurião|strong="G3588,G2760"\w*, \w lhe perguntou|strong="G1905,G846"\w* \w se|strong="G1487"\w* \w fazia muito tempo|strong="G3819"\w* \add que\add* \w morrera|strong="G599"\w*;\f + \fr 15.44: \ft Variante: WH e Tregelles trazem "já" (ἤδη) em lugar de "há muito" (πάλαι)\f*\f + \fr 15.44: \ft Acréscimo: “que” (em “muito tempo que morrera”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 15:44 \xt ISA 53:9; LUK 23:50; 1CO 15:4; JHN 19:38; LUK 8:53; MRK 15:39\x*
\v 45 \w e|strong="G2532"\w*, \w sabendo|strong="G1097"\w* \w pelo centurião|strong="G575,G3588,G2760"\w*, \w concedeu|strong="G1433"\w* \w o cadáver|strong="G3588,G4430"\w* \w a José|strong="G3588,G2501"\w*.\f + \fr 15.45: \ft Variante: RP traz "corpo" (σῶμα) em lugar de "cadáver" (πτῶμα)\f*\x - \xo 15:45 \xt ISA 53:9; LUK 23:50; 1CO 15:4; ACT 13:29; JHN 19:38; LUK 8:53\x*
\v 46 \w E|strong="G2532"\w*, \w comprando|strong="G59"\w* \w um lençol|strong="G4616"\w*, \w o desceu|strong="G2507,G846"\w*, \w o envolveu|strong="G1750"\w* \w no lençol|strong="G3588,G4616"\w*, \w e|strong="G2532"\w* \w o colocou|strong="G5087,G846"\w* \w num túmulo|strong="G1722,G3419"\w* \w que tinha sido escavado|strong="G3739,G1510,G2998"\w* \w na rocha|strong="G1537,G4073"\w*, \w e|strong="G2532"\w* \w rolou|strong="G4351"\w* \w uma pedra|strong="G3037"\w* \w até a entrada|strong="G1909,G3588,G2374"\w* \w do túmulo|strong="G3588,G3419"\w*.\f + \fr 15.46: \ft Variante: RP acrescenta "e" (καί) depois de "lençol" e traz κατέθηκεν ("depositou") em lugar de ἔθηκεν; WH traz μνήματι em lugar de μνημείῳ, outra palavra para "túmulo"\f*\x - \xo 15:46 \xt MAT 27:60; MRK 16:3; ACT 13:29; LUK 23:53; ISA 53:9; JHN 20:1\x*
\v 47 \w E|strong="G1161"\w* \w Maria|strong="G3588,G3137"\w* \w Madalena|strong="G3588,G3094"\w* \w e|strong="G2532"\w* \w Maria|strong="G3137"\w*, \w a de|strong="G3588"\w* \w Joses|strong="G2500"\w*, \w observavam|strong="G2334"\w* \w onde|strong="G4226"\w* \w ele foi colocado|strong="G5087"\w*.\x - \xo 15:47 \xt MRK 15:40; MAT 27:56; JHN 20:18; MRK 16:3; LUK 23:50; MRK 16:1\x*
\c 16
\p
\v 1 \w E|strong="G2532"\w*, \w passado|strong="G1230"\w* \w o sábado|strong="G3588,G4521"\w*, \w Maria|strong="G3137,G3588"\w* \w Madalena|strong="G3094"\w*, \w e|strong="G2532"\w* \w Maria|strong="G3137"\w*, \w a de|strong="G3588"\w* \w Tiago|strong="G2385"\w*, \w e|strong="G2532"\w* \w Salomé|strong="G4539"\w* \w compraram|strong="G59"\w* \w aromas|strong="G759"\w* \w para que, indo|strong="G2443,G2064"\w*, \w o ungissem|strong="G218,G846"\w*.\x - \xo 16:1 \xt MRK 15:40; MAT 28:1; LUK 23:56; JHN 20:1; LUK 24:1; 2CH 16:14\x*
\v 2 \w E|strong="G2532"\w* \w bem cedo|strong="G3029,G4404"\w*, \w no primeiro dia|strong="G3588,G1520"\w* \w da semana|strong="G3588,G4521"\w*\f + \fr 16.2: \ft Lit.: μία τῶν σαββάτων, literalmente "um dos sábados"; o primeiro dia da semana\f*, \w foram|strong="G2064"\w* \w ao túmulo|strong="G1909,G3588,G3419"\w*, \w ao nascer|strong="G393"\w* \w do sol|strong="G3588,G2246"\w*.\x - \xo 16:2 \xt JHN 20:1; MAT 28:1; LUK 24:1; 1CO 15:4\x*
\v 3 \w E|strong="G2532"\w* \w diziam|strong="G3004"\w* \w entre si|strong="G4314,G1438"\w*: “\w Quem|strong="G5101"\w* \w rolará para longe|strong="G617"\w* \w para nós|strong="G3165"\w* \w a pedra|strong="G3588,G3037"\w* \w da entrada|strong="G1537,G3588,G2374"\w* \w do túmulo|strong="G3588,G3419"\w*?”\x - \xo 16:3 \xt LUK 24:2; MAT 28:2; MAT 27:60; MRK 15:46; MAT 28:1; LUK 24:1\x*
\v 4 \w E|strong="G2532"\w*, \w olhando para cima|strong="G308"\w*, \w viram|strong="G2334"\w* \w que|strong="G3754"\w* \w a pedra|strong="G3588,G3037"\w* \w tinha sido rolada para longe|strong="G617"\w*, \w pois|strong="G1063"\w* \w era|strong="G1510"\w* \w muito grande|strong="G3173,G4970"\w*.\x - \xo 16:4 \xt LUK 24:2; MAT 28:2; MAT 28:1; LUK 24:1; 1CO 15:4; JHN 20:1\x*
\v 5 \w E|strong="G2532"\w*, \w entrando|strong="G1525"\w* \w no túmulo|strong="G1519,G3588,G3419"\w*, \w viram|strong="G1492"\w* \w um jovem|strong="G3495"\w* \w sentado|strong="G2521"\w* \w à direita|strong="G1722,G3588,G1188"\w*, \w vestido|strong="G4016"\w* \w com uma veste|strong="G4749"\w* \w branca|strong="G3022"\w*, \w e|strong="G2532"\w* \w ficaram atônitas|strong="G1568"\w*.\x - \xo 16:5 \xt MAT 28:1; JHN 20:11-12; LUK 24:5; 1TI 3:16; ACT 1:10; JHN 20:8\x*
\v 6 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Não fiquem atônitas|strong="G3361,G1568"\w*; \w vocês procuram|strong="G2212"\w* \w Jesus|strong="G2424"\w*, \w o Nazareno|strong="G3588,G3479"\w*, \w o que foi crucificado|strong="G3588,G4717"\w*; \w foi ressuscitado|strong="G1453"\w*, \w não está|strong="G3756,G1510"\w* \w aqui|strong="G5602"\w*; \w vejam|strong="G2396"\w* \w o lugar|strong="G3588,G5117"\w* \w onde|strong="G3699"\w* \w o puseram|strong="G5087,G846"\w*.\x - \xo 16:6 \xt MAT 28:6; 2KI 6:16; MAT 28:1; LUK 1:13; LUK 24:5; REV 1:17\x*
\v 7 \w Mas|strong="G235"\w* \w vão|strong="G5217"\w*, \w digam|strong="G2036"\w* \w aos discípulos|strong="G3588,G3101"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w a Pedro|strong="G3588,G4074"\w*: ‘\w Ele vai adiante|strong="G4254"\w* \w de vocês|strong="G4771"\w* \w para a Galileia|strong="G1519,G3588,G1056"\w*; \w ali|strong="G1563"\w* \w vocês o verão|strong="G846,G3700"\w*, \w como|strong="G2531"\w* \w ele lhes disse|strong="G2036,G4771"\w*.’”\x - \xo 16:7 \xt MRK 14:28; MAT 26:32; MAT 28:7; MAT 28:10; MAT 28:1; 1CO 15:6\x*
\v 8 \w E|strong="G2532"\w*, \w saindo|strong="G1831"\w*, \w fugiram|strong="G5343"\w* \w do túmulo|strong="G575,G3588,G3419"\w*, \w pois|strong="G1063"\w* \w as dominava|strong="G2192,G846"\w* \w tremor|strong="G5156"\w* \w e|strong="G2532"\w* \w espanto|strong="G1611"\w*; \w e|strong="G2532"\w* \w a ninguém|strong="G3762"\w* \w nada|strong="G3762"\w* \w disseram|strong="G2036"\w*, \w pois|strong="G1063"\w* \w tinham medo|strong="G5399"\w*.\f + \fr 16.8: \ft Variante: WH e NA28 terminam o texto aqui, em "pois tinham medo" (ἐφοβοῦντο γάρ); Tregelles e RP continuam com os vv. 9-20; o SBLGNT imprime entre colchetes duplos tanto a conclusão breve que vem a seguir ("Mas tudo o que lhes fora ordenado…") quanto os vv. 9-20; RP também traz "mas" (δέ) em lugar de "pois" (γάρ) em "pois as dominava"\f* ⟦\w Mas|strong="G1161"\w* \w tudo o que|strong="G3956,G3588"\w* \w tinha sido ordenado|strong="G3853"\w* \w aos que estavam com Pedro|strong="G3588,G4012,G4074"\w* \w anunciaram|strong="G1804"\w* \w brevemente|strong="G4935"\w*. \w E|strong="G1161"\w* \w depois disso|strong="G3326,G3778"\w*, \w também|strong="G2532"\w* \w o próprio Jesus|strong="G846,G3588,G2424"\w* \w enviou|strong="G1821"\w* \w por meio deles|strong="G1223,G846"\w*, \w do oriente|strong="G575,G395"\w* \w até o ocidente|strong="G2532,G891,G6091"\w*, \w a sagrada|strong="G3588,G2411"\w* \w e|strong="G2532"\w* \w incorruptível|strong="G862"\w* \w proclamação|strong="G2782"\w* \w da salvação eterna|strong="G3588,G166,G4991"\w*. \w Amém|strong="G281"\w*.⟧\f + \fr 16.8: \ft Acréscimo: verbo ser/estar suprido em “aos que estavam com Pedro”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 16:8 \xt MAT 28:1; MAT 28:8; LUK 24:1; MRK 9:6; MAT 28:7; DAN 10:11\x*
\p
\v 9 ⟦\w Mas|strong="G1161"\w*, \w tendo ressuscitado|strong="G450"\w*, \w de manhã cedo|strong="G4404"\w*, \w no primeiro dia|strong="G4413"\w* \w da semana|strong="G4521"\w*, \w apareceu|strong="G5316"\w* \w primeiro|strong="G4413"\w* \w a Maria|strong="G3137"\w* \w Madalena|strong="G3588,G3094"\w*, \w da qual|strong="G3844,G3739"\w* \w tinha expulsado|strong="G1544"\w* \w sete demônios|strong="G2033,G1140"\w*.\f + \fr 16.9: \ft Variante: RP traz ἀφ’ ἧς em lugar de παρ’ ἧς ("da qual"), sem mudar o sentido\f*\x - \xo 16:9 \xt JHN 20:1; LUK 8:2; JHN 19:25; JHN 20:14; JHN 20:12; LUK 8:30\x*
\v 10 \w Ela|strong="G1565"\w*, \w tendo ido|strong="G4198"\w*, \w anunciou|strong="G518"\w* \w aos que tinham estado|strong="G3588,G1096"\w* \w com ele|strong="G3326,G846"\w*, \w que estavam de luto|strong="G3996"\w* \w e|strong="G2532"\w* \w choravam|strong="G2799"\w*.\x - \xo 16:10 \xt JAS 4:9; JHN 16:20; JHN 20:18; ACT 1:3; JHN 16:6; LUK 24:10\x*
\v 11 \w E eles|strong="G1565,G2532"\w*, \w ao ouvirem|strong="G191"\w* \w que|strong="G3754"\w* \w ele vive|strong="G2198"\w* \w e|strong="G2532"\w* \w foi visto|strong="G2300"\w* \w por ela|strong="G5259,G846"\w*, \w não creram|strong="G569"\w*.\x - \xo 16:11 \xt LUK 24:11; JHN 20:25; MRK 16:13-14; MRK 16:14; JHN 20:18; LUK 24:23-35\x*
\v 12 \w Mas|strong="G1161"\w* \w depois disso|strong="G3326,G3778"\w* \w se manifestou|strong="G5319"\w* \w em outra forma|strong="G1722,G2087,G3444"\w* \w a dois|strong="G1417"\w* \w deles|strong="G1537,G846"\w* \w que andavam|strong="G4043"\w* \w indo|strong="G4198"\w* \w para o campo|strong="G1519,G68"\w*;\x - \xo 16:12 \xt LUK 24:13; MRK 16:14; LUK 24:16; LUK 24:35; JHN 20:18; JHN 21:4\x*
\v 13 \w E eles|strong="G1565_a,G2532"\w*, \w tendo ido|strong="G565"\w*, \w anunciaram|strong="G518"\w* \w aos demais|strong="G3588,G3062"\w*; \w nem a eles|strong="G3761,G1565"\w* \w creram|strong="G4100"\w*.\x - \xo 16:13 \xt JHN 7:5; MRK 16:11; MRK 16:14; JHN 20:25; LUK 24:35; JHN 20:18\x*
\v 14 \w Por último|strong="G5305"\w*, \w se manifestou|strong="G5319"\w* \w aos próprios Onze|strong="G846,G3588,G1733"\w* \w quando estavam reclinados à mesa|strong="G345"\w*, \w e|strong="G2532"\w* \w censurou|strong="G3679"\w* \w a incredulidade|strong="G3588,G570"\w* \w deles|strong="G846"\w* \w e|strong="G2532"\w* \w a dureza de coração|strong="G4641"\w*, \w porque|strong="G3754"\w* \w não creram|strong="G3756,G4100"\w* \w nos que o tinham visto|strong="G3588,G2300,G846"\w* \w ressuscitado|strong="G1453"\w*.\f + \fr 16.14: \ft Variante: WH, entre colchetes duplos, acrescenta "dentre os mortos" (ἐκ νεκρῶν) depois de "ressuscitado"; RP omite "porém" (δέ)\f*\x - \xo 16:14 \xt JAS 1:5; 1CO 15:5; ISA 40:28; LUK 24:36; MAT 17:17; HEB 3:7-8\x*
\v 15 \w E|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Vão|strong="G4198"\w* \w a todo|strong="G1519,G537"\w* \w o mundo|strong="G3588,G2889"\w* \add e\add* \w proclamem|strong="G2784"\w* \w a boa notícia|strong="G3588,G2098"\w* \w a toda a criação|strong="G3956,G3588,G2937"\w*.\f + \fr 16.15: \ft Acréscimo: “e” (em “o mundo e proclamem a”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 16:15 \xt MRK 13:10; ACT 1:8; MAT 28:19; COL 1:23; MRK 14:9; ACT 4:12\x*
\v 16 \w Quem|strong="G3588"\w* \w crer|strong="G4100"\w* \w e|strong="G2532"\w* \w for batizado|strong="G907"\w* \w será salvo|strong="G4982"\w*, \w mas|strong="G1161"\w* \w quem|strong="G3588"\w* \w não crer|strong="G569"\w* \w será condenado|strong="G2632"\w*.\x - \xo 16:16 \xt ACT 2:38; JHN 11:25-26; JHN 3:15; JHN 3:18; JHN 3:36; JHN 5:24\x*
\v 17 \w E|strong="G1161"\w* \w estes sinais|strong="G4592,G3778"\w* \w acompanharão|strong="G3877"\w* \w os que creram|strong="G3588,G4100"\w*: \w em meu nome|strong="G1722,G3588,G3686,G3165"\w* \w expulsarão|strong="G1544"\w* \w demônios|strong="G1140"\w*, \w falarão|strong="G2980"\w* \w em línguas|strong="G1100"\w* \w novas|strong="G2537"\w*,\f + \fr 16.17: \ft Variante: WH e Tregelles trazem "seguirão estes" (ἀκολουθήσει ταῦτα) em lugar de "acompanharão estes" (ταῦτα παρακολουθήσει) e omitem "novas" (καιναῖς) depois de "línguas"\f*\x - \xo 16:17 \xt MRK 9:38; 1CO 14:22; JHN 14:12; ACT 5:16; 1CO 12:28; ACT 8:7\x*
\v 18 \w pegarão|strong="G142"\w* \w serpentes|strong="G3789"\w*; \w mesmo que bebam|strong="G1437,G2532,G4095"\w* \w algo mortal|strong="G2286,G5100"\w*, \w de modo nenhum|strong="G3756,G3361"\w* \w lhes fará mal|strong="G846,G984"\w*; \w imporão|strong="G2007"\w* \w as mãos|strong="G5495"\w* \w sobre os doentes|strong="G1909,G732"\w*, \w e|strong="G2532"\w* \w ficarão bem|strong="G2573,G2192"\w*.”\f + \fr 16.18: \ft Variante: WH, Tregelles e NA28 acrescentam "e com as mãos" (καὶ ἐν ταῖς χερσίν) antes de "serpentes"; TR traz βλάψει, no futuro, em lugar de βλάψῃ, no subjuntivo\f*\x - \xo 16:18 \xt LUK 10:19; JAS 5:14; ACT 19:12; ACT 28:3-6; ACT 4:30; PSA 91:13\x*
\v 19 \w Então|strong="G3303,G3767"\w* \w o Senhor|strong="G3588,G2962"\w* \w Jesus|strong="G2424"\w*, \w depois de|strong="G3326,G3588"\w* \w lhes falar|strong="G2980,G846"\w*, \w foi elevado|strong="G353"\w* \w ao céu|strong="G1519,G3588,G3772"\w* \w e|strong="G2532"\w* \w se sentou|strong="G2523"\w* \w à direita|strong="G1537,G1188"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 16.19: \ft Variante: RP omite "Jesus" (Ἰησοῦς); WH, Tregelles e NA28 trazem ἀνελήφθη em lugar de ἀνελήμφθη, outra grafia do mesmo verbo\f*\x - \xo 16:19 \xt MRK 10:37; EPH 1:20; HEB 10:12; HEB 8:1; MAT 25:33; 1TI 3:16\x*
\v 20 \w Mas|strong="G1161"\w* \w eles|strong="G1565"\w*, \w saindo|strong="G1831"\w*, \w proclamaram|strong="G2784"\w* \w por toda parte|strong="G3837"\w*, \w enquanto o Senhor|strong="G3588,G2962"\w* \w agia junto|strong="G4903"\w* \w e|strong="G2532"\w* \w confirmava|strong="G950"\w* \w a palavra|strong="G3588,G3056"\w* \w por meio dos sinais|strong="G1223,G3588,G4592"\w* \w que acompanhavam|strong="G1872"\w*.⟧\f + \fr 16.20: \ft Variante: RP, Tyndale, TR e Byz acrescentam "Amém" (ἀμήν) no fim\f*\x - \xo 16:20 \xt 1CO 2:4-5; ACT 14:3; MAT 28:20; ACT 19:11; ACT 8:4-6; HEB 2:4\x*
