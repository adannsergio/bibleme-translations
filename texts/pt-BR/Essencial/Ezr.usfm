\p
\v 1 \w Quando|strong="H5060"\w* \w chegou|strong="H5060"\w* \w o sétimo mês|strong="H2320,H7637"\w*, \w e os filhos|strong="H1121"\w* \w de Israel|strong="H3478"\w* \w estavam nas cidades|strong="H5892"\w*, \w o povo se reuniu|strong="H0622,H5971"\w* \w como um só homem|strong="H0376,H0259"\w* \w em Jerusalém|strong="H0413,H3389"\w*.\x - \xo 3:1 \xt NEH 7:73; EZR 7:8; ACT 4:32; 1CO 1:10; LEV 23:24; LEV 16:29\x*
\v 2 \w Então|strong="H6965"\w* \add se\add* \w levantou|strong="H6965"\w* \w Jesua|strong="H3442"\w*, \w filho|strong="H1121"\w* \w de Jozadaque|strong="H3136"\w*, \w com os seus irmãos|strong="H0251"\w*, \w os sacerdotes|strong="H3548"\w*, \w e Zorobabel|strong="H2216"\w*, \w filho|strong="H1121"\w* \w de Sealtiel|strong="H7597"\w*, \w e seus irmãos|strong="H0251"\w*, \w e construíram|strong="H1129"\w* \w o altar|strong="H4196"\w* \w do Deus|strong="H0430"\w* \w de Israel|strong="H3478"\w*, \w para oferecer|strong="H5927"\w* \add sobre\add* \w ele|strong="H5921"\w* \w holocaustos|strong="H5930"\w*, \w conforme|strong="H3789"\w* \add está\add* \w escrito|strong="H3789"\w* \w na lei|strong="H8451"\w* \w de Moisés|strong="H4872"\w*, \w o homem|strong="H0376"\w* \w de Deus|strong="H0430"\w*.\x - \xo 3:2 \xt EZR 10:18; EZR 3:8; EZR 5:2; HAG 1:1; LUK 3:27; 1CH 3:17\x*
\v 3 \w Estabeleceram|strong="H3559"\w* \w o altar|strong="H4196"\w* \w sobre as suas bases|strong="H5921,H4350"\w*, \w porque|strong="H3588"\w* \w havia temor|strong="H0367"\w* \add sobre\add* \w eles|strong="H5921"\w* \w por causa dos povos|strong="H5971"\w* \w das terras|strong="H0776"\w*, \w e ofereceram|strong="H5927"\w*\f + \fr 3.3: \ft Variante: a Ketiv tem a 3ª pessoa do singular "e ele ofereceu" (וַיַּעַל); a Qere, que seguimos, a 3ª pessoa do plural "e eles ofereceram" (וַיַּעֲלוּ)\f* \add sobre\add* \w ele|strong="H5921"\w* \w holocaustos|strong="H5930"\w* \w ao SENHOR|strong="H3068"\w*, \w holocaustos|strong="H5930"\w* \w da manhã|strong="H1242"\w* \w e da tarde|strong="H6153"\w*.\x - \xo 3:3 \xt EZR 4:4; EXO 29:38; NEH 8:1; NUM 28:2-8\x*
\v 4 \w E celebraram|strong="H6213"\w* \w a festa|strong="H2282"\w* \w das cabanas|strong="H5521"\w*, \w conforme|strong="H3789"\w* \add está\add* \w escrito|strong="H3789"\w*, \w com o holocausto|strong="H5930"\w* \w de cada dia|strong="H3117"\w*, \w na quantidade devida|strong="H4557"\w*, \w conforme|strong="H4941"\w* \w a ordenança|strong="H4941"\w* \w de cada dia|strong="H1697,H3117"\w*.\x - \xo 3:4 \xt NEH 8:14; LEV 23:34; ZEC 14:16; EXO 23:16; NUM 29:12-38; 1CH 16:37\x*
\v 5 \w E depois disso|strong="H3651"\w*, \w o holocausto|strong="H5930"\w* \w contínuo|strong="H8548"\w*, \w e para as festas da lua nova|strong="H2320"\w*, \w e para todas|strong="H3605"\w* \w as festas|strong="H4150"\w* \w do SENHOR|strong="H3068"\w* \w consagradas|strong="H6942"\w*, \w e para todo|strong="H3605"\w* \w o que oferecesse|strong="H5068"\w* \w uma oferta voluntária|strong="H5071"\w* \w ao SENHOR|strong="H3068"\w*.\x - \xo 3:5 \xt NUM 29:39; EXO 35:29; EXO 25:2; NEH 8:1; NUM 28:11\x*
\v 6 \w Desde o primeiro dia|strong="H3117,H0259"\w* \w do sétimo mês|strong="H2320,H7637"\w*, \w começaram|strong="H2490"\w* \w a oferecer|strong="H5927"\w* \w holocaustos|strong="H5930"\w* \w ao SENHOR|strong="H3068"\w*, \w mas o templo|strong="H1964,H3068"\w* \w do SENHOR|strong="H3068"\w* \add ainda\add* \w não|strong="H3808"\w* \add tinha sido\add* \w fundado|strong="H3245"\w*.\x - \xo 3:6 \xt 2CH 31:7; LEV 23:24; NEH 8:1; NUM 29:1\x*
\v 7 \w E deram dinheiro|strong="H5414,H3701"\w* \w aos pedreiros|strong="H2672"\w* \w e aos carpinteiros|strong="H2796"\w*, \w e comida|strong="H3978"\w*, \w bebida|strong="H4960"\w* \w e óleo|strong="H8081"\w* \w aos sidônios|strong="H6722"\w* \w e aos tírios|strong="H6876"\w*, \w para trazer|strong="H0935"\w* \w madeiras de cedro|strong="H6086,H0730"\w* \w do Líbano|strong="H4480,H3844"\w* \w até o mar|strong="H0413,H3220"\w* \w de Jope|strong="H3305"\w*, \w conforme|strong="H7558"\w* \w a permissão|strong="H7558"\w* \w que Ciro|strong="H3566"\w*, \w rei da Pérsia|strong="H4428,H6539"\w*, \w lhes tinha dado|strong="H5921"\w*.\x - \xo 3:7 \xt 1KI 5:6; 1KI 5:9; ACT 9:36; ACT 12:20; 1CH 14:1; HAG 1:8\x*
\p
\v 8 \w E no segundo ano|strong="H8141,H8145"\w* \w de sua chegada|strong="H0935"\w* \w à casa|strong="H0413,H1004"\w* \w de Deus|strong="H0430"\w* \w em Jerusalém|strong="H3389"\w*, \w no segundo mês|strong="H2320,H8145"\w*, \w começaram|strong="H2490"\w* \w Zorobabel|strong="H2216"\w*, \w filho|strong="H1121"\w* \w de Sealtiel|strong="H7597"\w*, \w e Jesua|strong="H3442"\w*, \w filho|strong="H1121"\w* \w de Jozadaque|strong="H3136"\w*, \w e o restante|strong="H7605"\w* \w de seus irmãos|strong="H0251"\w*, \w os sacerdotes|strong="H3548"\w* \w e os levitas|strong="H3881"\w*, \w e todos|strong="H3605"\w* \w os que tinham vindo|strong="H0935"\w* \w do cativeiro|strong="H7628"\w* \w para Jerusalém|strong="H3389"\w*; \w e nomearam|strong="H5975"\w* \w os levitas|strong="H3881"\w*, \w de vinte|strong="H1121,H6242"\w* \w anos|strong="H8141"\w* \w para cima|strong="H4605"\w*, \w para supervisionar|strong="H5329"\w* \w a obra|strong="H5921,H4399"\w* \w da casa|strong="H1004"\w* \w do SENHOR|strong="H3068"\w*.\x - \xo 3:8 \xt EZR 3:2; EZR 4:3; HAG 1:1; EZR 5:16; 1CH 23:24; 1CH 23:4\x*
\v 9 \w Ficaram encarregados|strong="H5975"\w* \w Jesua|strong="H3442"\w*, \w os seus filhos|strong="H1121"\w* \w e os seus irmãos|strong="H0251"\w*, \w Cadmiel|strong="H6934"\w* \w e os seus filhos|strong="H1121"\w*, \w filhos|strong="H1121"\w* \w de Judá|strong="H3063"\w*, \w como um só|strong="H0259"\w*, \w de supervisionar|strong="H5329,H5921"\w* \w os que faziam|strong="H6213"\w* \w a obra|strong="H4399"\w* \w na casa|strong="H1004"\w* \w de Deus|strong="H0430"\w* — \w os filhos|strong="H1121"\w* \w de Henadade|strong="H2582"\w*, \w os seus filhos|strong="H1121"\w* \w e os seus irmãos|strong="H0251"\w*, \w os levitas|strong="H3881"\w*.\x - \xo 3:9 \xt NEH 7:43; NEH 10:9; EZR 2:40; 1KI 6:38; NEH 8:1; ZEC 4:9\x*
\v 10 \w E lançaram as fundações|strong="H3245"\w* \w os construtores|strong="H1129"\w* \w do templo|strong="H0853,H1964"\w* \w do SENHOR|strong="H3068"\w*, \w e colocaram|strong="H5975"\w* \w os sacerdotes|strong="H3548"\w*, \w vestidos|strong="H3847"\w* \w com as trombetas|strong="H2689"\w*, \w e os levitas|strong="H3881"\w*, \w filhos|strong="H1121"\w* \w de Asafe|strong="H0623"\w*, \w com os címbalos|strong="H4700"\w*, \w para louvar|strong="H1984"\w* \w o SENHOR|strong="H3068"\w*, \w conforme|strong="H5921"\w* \w as instruções|strong="H3027"\w* \w de Davi|strong="H1732"\w*, \w rei|strong="H4428"\w* \w de Israel|strong="H3478"\w*.\x - \xo 3:10 \xt 2CH 5:12; 2CH 20:21; EZR 5:16; HAG 2:15; LUK 19:37; NUM 10:10\x*
\v 11 \w E cantaram|strong="H6030"\w*, \w louvando|strong="H1984"\w* \w e dando graças|strong="H3034"\w* \w ao SENHOR|strong="H3068"\w*, \w porque|strong="H3588"\w* \add ele\add* \w é|strong="H2896"\w* \w bom|strong="H2896"\w*, \w porque|strong="H3588"\w* \w para sempre|strong="H5769"\w* \w é a sua bondade|strong="H2617"\w* \w para com Israel|strong="H5921,H3478"\w*; \w e todo|strong="H3605"\w* \w o povo|strong="H5971"\w* \w gritou|strong="H7321"\w* \w com um grande grito de alegria|strong="H8643,H1419"\w*, \w louvando|strong="H1984"\w* \w o SENHOR|strong="H3068"\w*, \w porque|strong="H5921"\w* \w a casa|strong="H1004"\w* \w do SENHOR|strong="H3068"\w* \add tinha sido\add* \w fundada|strong="H3245"\w*.\x - \xo 3:11 \xt 1CH 16:34; PSA 136:1; PSA 107:1; PSA 106:1; PSA 118:1; PSA 118:29\x*
\v 12 \w E muitos|strong="H7227"\w* \w dos sacerdotes|strong="H3548"\w* \w e dos levitas|strong="H3881"\w* \w e dos chefes|strong="H7218"\w* \w das famílias|strong="H0001"\w*, \w os anciãos|strong="H2205"\w* \w que|strong="H0834"\w* \add tinham\add* \w visto|strong="H7200"\w* \w a primeira casa|strong="H1004,H7223"\w*, \w quando esta casa|strong="H3245,H2088,H1004"\w* \w foi fundada|strong="H3245"\w*, \w diante dos seus olhos|strong="H5869"\w*, \w choravam|strong="H1058"\w* \w em alta voz|strong="H6963,H1419"\w*; \w e muitos|strong="H7227"\w* \w gritavam de alegria|strong="H8643,H8057"\w*, \w levantando a voz|strong="H7311,H6963"\w*.\x - \xo 3:12 \xt PSA 95:1; ACT 16:25; HAG 2:3; JOB 38:7; PSA 27:6; PSA 47:1\x*
\v 13 \w E o povo|strong="H0369,H5971"\w* \w não|strong="H0369"\w* \add conseguia\add* \w distinguir|strong="H5234"\w* \w o som|strong="H6963"\w* \w do grito|strong="H8643"\w* \w de alegria|strong="H8057"\w* \w do som|strong="H6963"\w* \w do choro|strong="H1065"\w* \w do povo|strong="H5971"\w*, \w porque|strong="H3588"\w* \w o povo|strong="H5971"\w* \w gritava|strong="H7321"\w* \w com um grande grito|strong="H8643,H1419"\w*, \w e o som|strong="H6963"\w* \w se ouvia|strong="H8085"\w* \w até|strong="H5704"\w* \w de longe|strong="H7350"\w*.\x - \xo 3:13 \xt 1SA 4:5; NEH 12:43; PSA 95:1; ACT 16:25; PSA 27:6; PSA 47:1\x*
\c 4
\p
\v 1 \w E ouviram|strong="H8085"\w* \w os adversários|strong="H6862"\w* \w de Judá|strong="H3063"\w* \w e Benjamim|strong="H1144"\w* \w que|strong="H3588"\w* \w os filhos|strong="H1121"\w* \w do exílio|strong="H1473"\w* \w construíam|strong="H1129"\w* \w um templo|strong="H1964"\w* \w ao SENHOR|strong="H3068"\w*, \w Deus|strong="H0430"\w* \w de Israel|strong="H3478"\w*.\x - \xo 4:1 \xt 1CH 22:9-10; 2KI 17:41; DAN 5:13; EZR 1:11; EZR 4:10; NEH 6:9\x*
\v 2 \w Então se aproximaram|strong="H5066"\w* \w de Zorobabel|strong="H0413,H2216"\w* \w e dos chefes|strong="H0413,H7218"\w* \w das famílias|strong="H0001"\w* \w e disseram|strong="H0559"\w* \w a eles|strong="H9038"\w*: \add "Vamos\add* \w construir|strong="H1129"\w* \w com vocês|strong="H5973"\w*, \w porque|strong="H3588"\w*, \w como vocês|strong="H9036"\w*, \w buscamos|strong="H1875"\w* \w ao seu Deus|strong="H0430"\w*; \w e é a ele|strong="H9005"\w*\f + \fr 4.2: \ft Variante: a Ketiv tem "e não" (וְלֹא); a Qere, que seguimos, "e a ele" (וְלוֹ) — diferença de sentido relevante: a Qere afirma que também adoravam o mesmo Deus, a Ketiv negaria isso\f* \w que nós|strong="H0587"\w* \add oferecemos\add* \w sacrifícios|strong="H2076"\w*, \w desde|strong="H3117"\w* \w os dias|strong="H3117"\w* \w de Esar-Hadom|strong="H0634"\w*, \w rei|strong="H4428"\w* \w da Assíria|strong="H0804"\w*, \w que|strong="H5927"\w* \w nos trouxe|strong="H0853"\w* \w aqui|strong="H6311"\w*."\x - \xo 4:2 \xt JHN 4:22; 2KI 17:24; 2KI 19:37; GAL 2:4; ISA 37:38; 2KI 17:27-33\x*
\v 3 \w Mas disseram|strong="H0559"\w* \w a eles|strong="H9038"\w* \w Zorobabel|strong="H2216"\w*, \w e Jesua|strong="H3442"\w* \w e o restante|strong="H7605"\w* \w dos chefes|strong="H7218"\w* \w das famílias|strong="H0001"\w* \w de Israel|strong="H3478"\w*: "\w Não|strong="H3808"\w* \w cabe a vocês|strong="H9036"\w* \w e a nós|strong="H9035"\w* \w construir|strong="H1129"\w* \w uma casa|strong="H1004"\w* \w ao nosso Deus|strong="H0430"\w*; \w porque|strong="H3588"\w* \w nós|strong="H0587"\w* \w juntos|strong="H3162"\w* \add a\add* \w construiremos|strong="H1129"\w* \w ao SENHOR|strong="H3068"\w*, \w Deus|strong="H0430"\w* \w de Israel|strong="H3478"\w*, \w conforme|strong="H0834"\w* \add nos\add* \w ordenou|strong="H6680"\w* \add o\add* \w rei|strong="H4428"\w* \w Ciro|strong="H3566"\w*, \w rei|strong="H4428"\w* \w da Pérsia|strong="H6539"\w*."\x - \xo 4:3 \xt EZR 3:8; NEH 2:20; 2KI 17:41; ACT 8:21; DAN 10:1; EPH 2:12\x*
\v 4 \w E o povo|strong="H1961,H5971"\w* \w da terra|strong="H0776"\w* \w desanimava|strong="H7503"\w* \w as mãos|strong="H3027"\w* \w do povo|strong="H5971"\w* \w de Judá|strong="H3063"\w*, \w e os aterrorizava|strong="H0926,H0853"\w*\f + \fr 4.4: \ft Variante: a Ketiv tem "e perturbando" (וּמְבַלַהִים); a Qere, que seguimos, "e aterrorizando" (וּמְבַהֲלִים) — verbos de sentido próximo, mas distintos\f* \w para que não construíssem|strong="H1129"\w*.\x - \xo 4:4 \xt 2SA 4:1; DAN 10:13; EZR 3:3; JER 38:4; ISA 35:3-4; NEH 4:11\x*
\v 5 \w E contratavam|strong="H7936"\w* \add contra\add* \w eles|strong="H5921"\w* \w conselheiros|strong="H3289"\w* \w para frustrar|strong="H6565"\w* \w o seu propósito|strong="H6098"\w*, \w por todos|strong="H3605"\w* \w os dias|strong="H3117"\w* \w de Ciro|strong="H3566"\w*, \w rei|strong="H4428"\w* \w da Pérsia|strong="H6539"\w*, \w e até|strong="H5704"\w* \w o reinado|strong="H4438"\w* \w de Dario|strong="H1867"\w*, \w rei|strong="H4428"\w* \w da Pérsia|strong="H6539"\w*.\x - \xo 4:5 \xt DAN 10:13; DAN 11:2; NAM 1:11; ACT 24:1-27; DAN 10:1; EZR 5:5-6:18\x*
\v 6 \w E no reinado|strong="H4438"\w* \w de Assuero|strong="H0325"\w*, \w no começo|strong="H8462"\w* \w do seu reinado|strong="H4438"\w*, \w escreveram|strong="H3789"\w* \w uma acusação|strong="H7855"\w* \w contra|strong="H5921"\w* \w os habitantes|strong="H3427"\w* \w de Judá|strong="H3063"\w* \w e Jerusalém|strong="H3389"\w*.\x - \xo 4:6 \xt DAN 9:1; DAN 10:13; EST 1:1; DAN 11:2; NEH 6:9\x*
\v 7 \w E nos dias|strong="H3117"\w* \w de Artaxerxes|strong="H0783"\w*, \w escreveu|strong="H3789"\w* \w Bislão|strong="H1312"\w*, \w Mitredate|strong="H4990"\w*, \w Tabeel|strong="H2870"\w* \w e o restante|strong="H7605"\w* \w dos seus colegas|strong="H3674"\w*\f + \fr 4.7: \ft Variante: a Ketiv apresenta a forma no singular ("seu colega"); a Qere, que seguimos, no plural ("seus colegas") — sem efeito relevante no sentido\f* \w a Artaxerxes|strong="H5921,H0783"\w*, \w rei|strong="H4428"\w* \w da Pérsia|strong="H6539"\w*; \w e a carta|strong="H3791"\w*, \w o documento|strong="H5406"\w*, \add foi\add* \w escrita|strong="H3789"\w* \w em aramaico|strong="H0762"\w* \w e traduzida|strong="H8638"\w* \w em aramaico|strong="H0762"\w*.\x - \xo 4:7 \xt 2KI 18:26; DAN 2:4; ISA 36:11; EZR 4:17; EZR 4:9; EZR 5:6\x*
\p
\v 8 \w Reum|strong="H7348"\w*, \w o comandante|strong="H1169,H2942"\w*, \w e Sinsai|strong="H8124"\w*, \w o escrivão|strong="H5613"\w*, \w escreveram|strong="H3790"\w* \w uma carta|strong="H0104,H2298"\w* \w sobre|strong="H5922"\w* \w Jerusalém|strong="H3390"\w* \w ao rei|strong="H4430"\w* \w Artaxerxes|strong="H0783"\w*, \w assim|strong="H3660"\w*:\x - \xo 4:8 \xt EZR 4:9; NEH 6:9; EZR 4:23\x*
\v 9 \w Então|strong="H0116"\w* \w Reum|strong="H7348"\w*, \w o comandante|strong="H1169,H2942"\w*, \w e Sinsai|strong="H8124"\w*, \w o escrivão|strong="H5613"\w*, \w e o restante|strong="H7606"\w* \w dos seus colegas|strong="H3675"\w* — \add os\add* \w juízes|strong="H1784"\w*, \w os oficiais|strong="H0671"\w*, \w os tarpelitas|strong="H2967"\w*, \w os persas|strong="H0670"\w*, \w os arquivitas|strong="H0756"\w*\f + \fr 4.9: \ft Variante: a Ketiv tem a forma singular "o arquivita"; a Qere, que seguimos, a forma plural "os arquivitas" — sem efeito relevante no sentido\f*, \w os babilônios|strong="H0896"\w*, \w os susanquitas|strong="H7801"\w*, \w os devitas|strong="H1723"\w*\f + \fr 4.9: \ft Variante: a Ketiv tem "que ele é" (דִּי הוּא); a Qere, que seguimos, lê o mesmo trecho como o nome de um povo, "devitas" (דֶּהָיֵא) — identificação de povo incerta no texto aramaico\f* \w e os elamitas|strong="H5962"\w*—\x - \xo 4:9 \xt EZR 4:17; EZR 5:6; EZR 6:6; 2KI 17:24; NEH 4:2; 2KI 17:30-31\x*
\v 10 \w e o restante|strong="H7606"\w* \w das nações|strong="H0524"\w* \w que|strong="H1768"\w* \w exilou|strong="H1541"\w* \w o grande e honrado|strong="H7229,H3358"\w* \w Osnapar|strong="H0620"\w* \w e fez|strong="H3488"\w* \w habitar|strong="H3488"\w* \w elas|strong="H1994"\w* \w na cidade|strong="H7149,H1768"\w* \w de Samaria|strong="H8115"\w*, \w e o restante|strong="H7606"\w* \w da região além do Rio|strong="H5675,H5103"\w* — \w e agora|strong="H3706"\w*:\x - \xo 4:10 \xt EZR 4:17; NEH 4:2; EZR 4:11; EZR 7:12; 2KI 17:24; EZR 4:1\x*
\v 11 \w Esta|strong="H1836"\w* \w é a cópia|strong="H6573"\w* \w da carta|strong="H0104"\w* \w que|strong="H1768"\w* \w enviaram|strong="H7972"\w* \add a\add* \w ele|strong="H5922"\w*, \w ao rei|strong="H5922,H0783,H4430"\w* \w Artaxerxes|strong="H0783"\w*: \add "Os seus\add* \w servos|strong="H5649"\w*\f + \fr 4.11: \ft Variante: a Ketiv tem o singular "teu servo"; a Qere, que seguimos, o plural "teus servos" — sem efeito relevante no sentido\f*, \w os homens|strong="H0606"\w* \w da região além do Rio|strong="H5675,H5103"\w* — \w e agora|strong="H3706"\w*:\x - \xo 4:11 \xt EZR 5:6; EZR 4:10; NEH 6:9\x*
\v 12 \w Saiba-se|strong="H3046,H1934"\w* \w ao rei|strong="H4430"\w* \w que|strong="H1768"\w* \add os\add* \w judeus|strong="H3062"\w* \w que|strong="H1768"\w* \w subiram|strong="H5559"\w* \w de junto de ti|strong="H4481,H3890"\w* \w vieram|strong="H0858"\w* \w a nós|strong="H5922"\w*, \w para Jerusalém|strong="H3390"\w*: \add estão\add* \w construindo|strong="H1124"\w* \w a cidade|strong="H7149"\w* \w rebelde|strong="H4779"\w* \w e má|strong="H0873"\w*, \w e já terminaram|strong="H7792,H3635"\w*\f + \fr 4.12: \ft Variante: a Ketiv tem pequenas diferenças de grafia nestes dois pontos — "as muralhas" e o verbo "foram terminadas" (passivo); a Qere, que seguimos, tem a grafia plena e o verbo "terminaram" (ativo) — sem mudança relevante de sentido\f* \w as muralhas|strong="H7792"\w* \w e estão reparando|strong="H2338"\w* \w os alicerces|strong="H0787"\w*.\x - \xo 4:12 \xt EZR 4:15; EST 3:8; DAN 3:8; 2CH 36:13; EZR 5:3; EZR 5:9\x*
\v 13 \w Agora|strong="H3705"\w*, \w saiba-se|strong="H3046,H1934"\w* \w ao rei|strong="H4430"\w* \w que|strong="H1768"\w*, \w se|strong="H2006"\w* \w esta cidade|strong="H7149,H1791"\w* \add for\add* \w reconstruída|strong="H1124"\w* \w e as muralhas|strong="H7792"\w* \add forem\add* \w terminadas|strong="H3635"\w*, \w tributo|strong="H4061"\w*, \w imposto|strong="H1093"\w* \w e pedágio|strong="H1983"\w* \w não|strong="H3809"\w* \w se pagarão mais|strong="H5415"\w*, \w e a receita|strong="H0674"\w* \w dos reis|strong="H4430"\w* \add sofrerá\add* \w dano|strong="H5142"\w*.\x - \xo 4:13 \xt EZR 7:24; EZR 4:16; EST 3:8; NEH 5:4; DAN 3:8; ROM 13:6\x*
\v 14 \w Agora|strong="H3705"\w*, \w porquanto|strong="H9005,H6903,H1768"\w* \w comemos|strong="H4415"\w* \w o sal|strong="H4416"\w* \w do palácio|strong="H1965"\w*, \w e não|strong="H3809"\w* \w nos|strong="H9035"\w* \add é\add* \w próprio|strong="H0749"\w* \w ver|strong="H2370"\w* \w a desonra|strong="H6173"\w* \w do rei|strong="H4430"\w*, \w por isso|strong="H5922,H1836"\w* \w enviamos|strong="H7972"\w* \w esta mensagem, informando-a|strong="H3046"\w* \w ao rei|strong="H4430"\w*:\x - \xo 4:14 \xt EST 3:8; DAN 3:8; NEH 6:9\x*
\v 15 \w Para que|strong="H1768"\w* \w pesquise|strong="H1240"\w* \w no livro|strong="H5609"\w* \w dos registros|strong="H1799"\w* \w de seus pais|strong="H1768,H0002"\w*, \w e encontrará|strong="H7912"\w* \w no livro|strong="H5609"\w* \w dos registros|strong="H1799"\w* \w e saberá|strong="H3046"\w* \w que|strong="H1768"\w* \w esta cidade|strong="H7149,H1791"\w* \w é|strong="H7149"\w* \w uma cidade|strong="H7149"\w* \w rebelde|strong="H4779"\w*, \w prejudicial|strong="H5142"\w* \w a reis|strong="H4430"\w* \w e províncias|strong="H4083"\w*, \w e que ali|strong="H1459"\w* \w fazem|strong="H5648"\w* \w revolta|strong="H0849"\w* \w desde|strong="H4481"\w* \w os dias|strong="H3118"\w* \w da antiguidade|strong="H5957"\w*; \w por isso|strong="H5922,H1836"\w* \w esta cidade|strong="H7149,H1791"\w* \add foi\add* \w destruída|strong="H2718"\w*."\x - \xo 4:15 \xt EZR 4:19; EZR 4:12; EST 3:8; PRO 25:2; DAN 3:8; EZR 5:17\x*
\v 16 \w Informamos|strong="H3046,H0586"\w* \w ao rei|strong="H4430"\w* \w que|strong="H1768"\w*, \w se|strong="H2006"\w* \w esta cidade|strong="H7149,H1791"\w* \add for\add* \w reconstruída|strong="H1124"\w* \w e as muralhas|strong="H7792"\w* \add forem\add* \w terminadas|strong="H3635"\w*, \w por causa disso|strong="H6903,H1836"\w*, \w nenhuma possessão|strong="H2508,H3809"\w* \w na região além do Rio|strong="H5675,H5103"\w* \w restará|strong="H0383"\w* \add para\add* \w você|strong="H9031"\w*.\x - \xo 4:16 \xt EZR 4:13; DAN 3:8; EZR 7:21; NEH 6:9\x*
