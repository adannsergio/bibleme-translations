\v 1 \w Havia|strong="H1961"\w* \w um homem|strong="H0376"\w* \w na terra|strong="H0776"\w* \w de Uz|strong="H5780"\w*, \w e seu nome|strong="H8034"\w* \w era Jó|strong="H0347"\w*; \w e era|strong="H1961"\w* \add esse\add* \w homem|strong="H0376,H1931"\w* \w íntegro|strong="H8535"\w* \w e correto|strong="H3477"\w*, \w e temente|strong="H3373"\w* \add a\add* \w Deus|strong="H0430"\w*, \w e se desviava|strong="H5493"\w* \add do\add* \w mal|strong="H7451"\w*.\x - \xo 1:1 \xt JOB 1:8; JOB 2:3; PSA 37:37; JAS 5:11; EZK 14:14; EZK 14:20\x*
