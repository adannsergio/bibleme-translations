\v 9 \w Respondeu então|strong="H6030"\w* \w Satanás|strong="H7854"\w* \add ao\add* \w SENHOR|strong="H3068"\w* \w e disse|strong="H0559"\w*: \add "Será que é à\add* \w toa|strong="H2600"\w* \add que\add* \w Jó|strong="H0347"\w* \w teme|strong="H3372"\w* \add a\add* \w Deus|strong="H0430"\w*?\x - \xo 1:9 \xt JOB 12:1; JOB 16:1; JOB 19:1; JOB 21:1; JOB 23:1; JOB 26:1\x*
\v 10 \w Não|strong="H3808"\w* \add foi\add* \w você|strong="H0859"\w*\f + \fr 1.10: \ft Variante: a Ketiv tem a forma feminina "at" (אַתְּ); a Qere, que seguimos, "atah" (אַתָּה), masculina — sem efeito no sentido, ambas significam "você"\f* \add que\add* \w cercou|strong="H7753"\w* \add a\add* \w ele|strong="H1157"\w* \w e a sua casa|strong="H1157,H1004"\w* \w e a tudo|strong="H1157,H3605,H0834"\w* \w o que ele tem|strong="H9033"\w*, \w por todos os lados|strong="H5439"\w*? \w A obra|strong="H4639"\w* \w das suas mãos|strong="H3027"\w* \add você\add* \w bendisse|strong="H1288"\w*, \w e o seu rebanho|strong="H4735"\w* \add se\add* \w multiplicou|strong="H6555"\w* \add pela\add* \w terra|strong="H0776"\w*.\x - \xo 1:10 \xt PSA 34:7; ZEC 2:5; LUK 22:31; 1PE 1:5; DEU 28:2-6; PRO 10:22\x*
\v 11 \w Mas|strong="H0199"\w*, \w estenda|strong="H7971,H4994"\w* \w a sua mão|strong="H3027"\w* \w e toque|strong="H5060"\w* \w em tudo|strong="H3605,H0834"\w* \w o que ele tem|strong="H9033"\w*, \w e veja se|strong="H0518"\w* \w não|strong="H3808"\w* \w te maldizerá|strong="H1288"\w*\f + \fr 1.11: \ft Lit.: hebraico "bendizer" (bērak), eufemismo para "maldizer"\f* \w na sua própria face|strong="H5921,H6440"\w*."\x - \xo 1:11 \xt JOB 2:5; JOB 17:10; LUK 22:31; JOB 23:10; JOB 19:21; REV 12:10\x*
