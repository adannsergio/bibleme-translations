\v 4 \w E iam|strong="H1980"\w* \w seus filhos|strong="H1121"\w* \w e faziam|strong="H6213"\w* \w banquete|strong="H4960"\w* \w na casa|strong="H1004"\w* \w de cada um|strong="H0376"\w* \w em seu dia|strong="H3117"\w*, \w e mandavam chamar|strong="H7971,H7121"\w* \w as suas três|strong="H7969,H0269"\w* \w irmãs|strong="H0269"\w* \w para comerem|strong="H0398"\w* \w e beberem|strong="H8354"\w* \add com\add* \w eles|strong="H5973"\w*.\x - \xo 1:4 \xt GEN 26:30; JER 16:8; PRO 16:6; HEB 13:1; JOB 1:18; ROM 12:10\x*
\v 5 \w E sucedia|strong="H1961,H3588"\w* \add que,\add* \w terminado o ciclo|strong="H5362"\w* \w dos dias|strong="H3117"\w* \w do banquete|strong="H4960"\w*, \w Jó|strong="H0347"\w* \w mandava|strong="H7971"\w* \w chamá-los|strong="H6942"\w* \w e os consagrava|strong="H6942"\w*, \w e se levantava|strong="H7925"\w* \add de\add* \w madrugada|strong="H1242"\w* \w e oferecia|strong="H5927"\w* \w holocaustos|strong="H5930"\w* \w conforme|strong="H4557"\w* \w o número|strong="H4557"\w* \add de\add* \w todos|strong="H3605"\w* \add eles,\add* \w pois|strong="H3588"\w* \w dizia|strong="H0559"\w* \w Jó|strong="H0347"\w*: "\w Talvez|strong="H0194"\w* \w tenham pecado|strong="H2398"\w* \w meus filhos|strong="H1121"\w* \w e blasfemado|strong="H1288"\w*\f + \fr 1.5: \ft Lit.: hebraico "bendizer" (bērak), eufemismo tradicional para "maldizer/blasfemar contra"\f* \w contra Deus|strong="H0430"\w* \w em seu coração|strong="H3824"\w*."\w Assim|strong="H3602"\w* \w fazia|strong="H6213"\w* \w Jó|strong="H0347"\w* \w todos|strong="H3605"\w* \add os\add* \w dias|strong="H3117"\w*.\x - \xo 1:5 \xt PSA 119:9; JOB 3:25; JOB 42:8; GEN 18:19; GEN 8:20; 1SA 16:5\x*
