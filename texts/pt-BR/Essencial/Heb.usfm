\v 25 \w preferindo antes|strong="G3123,G138"\w* \w ser maltratado junto|strong="G4778"\w* \w com o povo|strong="G3588,G2992"\w* \w de Deus|strong="G3588,G2316"\w* \w a ter|strong="G2228,G2192"\w* \w um gozo passageiro|strong="G4340,G619"\w* \w do pecado|strong="G266"\w*,\x - \xo 11:25 \xt 2CO 5:7; JHN 16:33; MAT 16:24; ROM 8:18; MAT 13:44; 2CO 4:18\x*
\v 26 \w tendo considerado|strong="G2233"\w* \w riqueza maior|strong="G3173,G4149"\w* \w do que os tesouros|strong="G3588,G2344"\w* \w do Egito|strong="G125"\w* \w a humilhação|strong="G3588,G3680"\w* \w do Cristo|strong="G3588,G5547"\w*; \w pois|strong="G1063"\w* \w olhava|strong="G578"\w* \w para a recompensa|strong="G1519,G3588,G3405"\w*.\f + \fr 11.26: \ft Lit.: ὁ Χριστός, “o Ungido”: o texto liga a humilhação sofrida por Moisés à do Messias.\f*\x - \xo 11:26 \xt 2CO 5:7; HEB 10:35; MAT 16:24; ROM 8:18; MAT 13:44; HEB 11:6\x*
\v 27 \w Pela fé|strong="G4102"\w* \w deixou|strong="G2641"\w* \add o\add* \w Egito|strong="G125"\w*, \w sem temer|strong="G3361,G5399"\w* \w o furor|strong="G3588,G2372"\w* \w do rei|strong="G3588,G935"\w*; \w pois|strong="G1063"\w* \w perseverou|strong="G2594"\w*, \w como vendo|strong="G5613,G3708"\w* \w o invisível|strong="G3588,G517"\w*.\f + \fr 11.27: \ft Acréscimo: “o” (em “fé deixou o Egito sem”): preposição ou artigo que a regência do português exige.\f*\x - \xo 11:27 \xt 2CO 5:7; HEB 11:1; 1TI 1:17; JHN 20:29; 2CO 4:18; HEB 12:1\x*
\v 28 \w Pela fé|strong="G4102"\w* \w celebrou|strong="G4160"\w* \w a Páscoa|strong="G3588,G3957"\w* \w e|strong="G2532"\w* \w a aspersão|strong="G3588,G4378"\w* \w do sangue|strong="G3588,G129"\w*, \w para que não|strong="G2443,G3361"\w* \w os tocasse|strong="G2345,G846"\w* \w o destruidor|strong="G3588,G3645"\w* \w dos primogênitos|strong="G3588,G4416"\w*.\f + \fr 11.28: \ft Nota cultural: cf. Êx 12.\f*\x - \xo 11:28 \xt EXO 12:13; HEB 12:24; HEB 12:1; 2CO 4:13; EPH 6:16; EXO 12:23\x*
\v 29 \w Pela fé|strong="G4102"\w* \w atravessaram|strong="G1224"\w* \w o Mar Vermelho|strong="G3588,G2063,G2281"\w*, \w como por|strong="G5613,G1223"\w* \w terra seca|strong="G3584,G1093"\w*; \add e\add* \w os egípcios|strong="G3588,G124"\w*, \w tentando o mesmo|strong="G3739,G3984,G2983"\w*, \w foram engolidos|strong="G2666"\w*\f + \fr 11.29: \ft Nota cultural: cf. Êx 14.\f*.\f + \fr 11.29: \ft Acréscimo: “e” (em “terra seca e os egípcios”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 11:29 \xt ISA 43:2; HEB 12:1; 2CO 4:13; EXO 14:22; EPH 6:16; EXO 14:13-15:21\x*
