\v 1 \w Pois|strong="G1063"\w* \w a Lei|strong="G3588,G3551"\w*, \w tendo|strong="G2192"\w* \w sombra|strong="G4639"\w* \w dos bens|strong="G3588,G18"\w* \w que haviam de vir|strong="G3195"\w*, \w e não|strong="G3756"\w* \w a própria|strong="G846"\w* \w imagem|strong="G3588,G1504"\w* \w das realidades|strong="G3588,G4229"\w*, \w nunca|strong="G3763"\w* \w pode|strong="G1410"\w*, \w com os mesmos|strong="G3588,G846"\w* \w sacrifícios|strong="G2378"\w* \w que oferecem|strong="G3739,G4374"\w* \w cada ano|strong="G2596,G1763"\w* \w continuamente|strong="G1519,G3588,G1336"\w*, \w aperfeiçoar|strong="G5048"\w* \w os que se aproximam|strong="G3588,G4334"\w*;\x - \xo 10:1 \xt COL 2:17; HEB 10:14; HEB 8:5; LUK 24:44; ROM 8:3; GAL 3:24\x*
\v 2 \w pois|strong="G1893"\w* \w não teriam deixado|strong="G3756,G302,G3973"\w* \w de ser oferecidos|strong="G4374"\w*, \w por não ter|strong="G1223,G3588,G3367,G2192"\w* \w mais|strong="G2089"\w* \w consciência|strong="G4893"\w* \w de pecados|strong="G266"\w* \w os que prestam culto|strong="G3588,G3000"\w*, \w uma vez|strong="G530"\w* \w purificados|strong="G2511"\w*?\f + \fr 10.2: \ft Variante: o RP traz κεκαθαρμένους em lugar de κεκαθαρισμένους (“purificados”).\f*\x - \xo 10:2 \xt HEB 9:14; PSA 103:12; ISA 43:25; ROM 8:3; MIC 7:19; GAL 3:24\x*
\v 3 \w Mas|strong="G235"\w* \w neles|strong="G1722,G846"\w* \w há uma lembrança|strong="G364"\w* \w de pecados|strong="G266"\w* \w a cada ano|strong="G2596,G1763"\w*.\f + \fr 10.3: \ft Acréscimo: verbo ser/estar suprido em “há uma lembrança”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:3 \xt MAT 5:17; ROM 8:3; GAL 3:24; HEB 9:7; ROM 3:21; EPH 2:15\x*
\v 4 \w Pois|strong="G1063"\w* \w é impossível|strong="G102"\w* \w que sangue|strong="G129"\w* \w de touros|strong="G5022"\w* \w e|strong="G2532"\w* \w de bodes|strong="G5131"\w* \w tire|strong="G851"\w* \w pecados|strong="G266"\w*.\f + \fr 10.4: \ft Acréscimo: verbo ser/estar suprido em “é impossível”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:4 \xt 1SA 15:22; ROM 11:27; MAT 26:28; HEB 9:12; GAL 3:13; EPH 1:7\x*
\v 5 \w Por isso|strong="G1352"\w*, \w ao entrar|strong="G1525"\w* \w no mundo|strong="G1519,G3588,G2889"\w*, \w diz|strong="G3004"\w*: “\w Sacrifício|strong="G2378"\w* \w e|strong="G2532"\w* \w oferta|strong="G4376"\w* \w não|strong="G3756"\w* \w quis|strong="G2309"\w*, \w mas um corpo|strong="G4983,G1161"\w* \w você me preparou|strong="G2675,G3165"\w*;\f + \fr 10.5: \ft Nota cultural: cita Sl 40:6-8 (40:7-9 no hebraico; 39:7-9 na LXX); a forma grega traz σῶμα (“corpo”), onde o hebraico lê, ao pé da letra, “ouvidos”.\f*\x - \xo 10:5 \xt PSA 40:6; 1SA 15:22; HEB 10:10; HEB 10:8; ISA 1:11; MAT 26:28\x*
\v 6 \w de holocaustos|strong="G3646"\w* \w e|strong="G2532"\w* \w de sacrifícios pelo pecado|strong="G4012,G266"\w* \w você não se agradou|strong="G3756,G2106"\w*.\x - \xo 10:6 \xt 1SA 15:22; HEB 10:8; MAT 26:28; GAL 3:13; PSA 40:6; EPH 1:7\x*
\v 7 \w Então|strong="G5119"\w* \w disse|strong="G2036"\w*: ‘\w Olhe|strong="G2400"\w*, \w venho|strong="G2240"\w* — \w no rolo|strong="G1722,G2777"\w* \w do livro|strong="G975"\w* \w está escrito|strong="G1125"\w* \w a meu respeito|strong="G4012,G1473"\w* — \w para fazer|strong="G3588,G4160"\w*, \w ó Deus|strong="G3588,G2316"\w*, \w a sua vontade|strong="G3588,G2307,G4771"\w*.’”\x - \xo 10:7 \xt HEB 10:9; 1SA 15:22; PSA 40:7; MAT 26:28; GAL 3:13; JHN 4:34\x*
\v 8 \w Dizendo|strong="G3004"\w* \w antes|strong="G511"\w*: “\w Sacrifícios|strong="G2378"\w* \w e|strong="G2532"\w* \w ofertas|strong="G4376"\w* \w e|strong="G2532"\w* \w holocaustos|strong="G3646"\w* \w e|strong="G2532"\w* \w sacrifícios pelo pecado|strong="G4012,G266"\w* \w você não|strong="G3756"\w* \w quis|strong="G2309"\w* \w nem deles se agradou|strong="G3761,G2106"\w*” — \w coisas|strong="G3748"\w* \w que são oferecidas|strong="G4374"\w* \w segundo a Lei|strong="G2596,G3551"\w*\f + \fr 10.8: \ft Variante: o RP traz Θυσίαν καὶ προσφορὰν (singular) e τὸν νόμον.\f* —,\x - \xo 10:8 \xt 1SA 15:22; HEB 10:6; HEB 10:5; MAT 26:28; PSA 40:7; GAL 3:13\x*
\v 9 \w depois|strong="G5119"\w* \w disse|strong="G2046"\w*: “\w Olhe|strong="G2400"\w*, \w venho|strong="G2240"\w* \w para fazer|strong="G3588,G4160"\w* \w a sua vontade|strong="G3588,G2307,G4771"\w*.” \w Remove|strong="G337"\w* \w o primeiro|strong="G3588,G4413"\w* \w para estabelecer|strong="G2443,G2476"\w* \w o segundo|strong="G3588,G1208"\w*\f + \fr 10.9: \ft Variante: o RP e o TR acrescentam ὁ θεός (“ó Deus”) depois de “fazer”.\f*.\x - \xo 10:9 \xt HEB 10:7; 1SA 15:22; MAT 26:28; PSA 40:7; GAL 3:13; PSA 40:6\x*
\v 10 \w Nessa vontade|strong="G1722,G3739,G2307"\w* \w fomos santificados|strong="G37,G1510"\w* \w por meio da oferta|strong="G1223,G3588,G4376"\w* \w do corpo|strong="G3588,G4983"\w* \w de Jesus Cristo|strong="G2424,G5547"\w*, \w uma vez por todas|strong="G2178"\w*.\x - \xo 10:10 \xt 1SA 15:22; HEB 10:14; HEB 10:5; ISA 53:5; MAT 26:28; GAL 3:13\x*
\v 11 \w E|strong="G2532"\w* \w todo sacerdote|strong="G3956,G2409"\w*, \w de fato|strong="G3303"\w*, \w está de pé|strong="G2476"\w* \w cada dia|strong="G2596,G2250"\w*, \w ministrando|strong="G3008"\w* \w e|strong="G2532"\w* \w oferecendo|strong="G4374"\w* \w muitas vezes|strong="G4178"\w* \w os mesmos|strong="G3588,G846"\w* \w sacrifícios|strong="G2378"\w*, \w que|strong="G3748"\w* \w nunca|strong="G3763"\w* \w podem|strong="G1410"\w* \w remover|strong="G4014"\w* \w pecados|strong="G266"\w*.\x - \xo 10:11 \xt MAT 26:28; PSA 40:6; EPH 1:7; HEB 10:4; MAT 5:17; HEB 12:2\x*
\v 12 \w Mas este|strong="G3778,G1161"\w*, \w tendo oferecido|strong="G4374"\w* \w um|strong="G1520"\w* \w sacrifício|strong="G2378"\w* \w pelos pecados|strong="G5228,G266"\w* \w para sempre|strong="G1519,G3588,G1336"\w*, \w sentou-se|strong="G2523"\w* \w à direita|strong="G1722,G1188"\w* \w de Deus|strong="G3588,G2316"\w*,\x - \xo 10:12 \xt PSA 110:1; MRK 16:19; MAT 26:28; PSA 40:6; EPH 1:7; MAT 5:17\x*
\v 13 \w esperando|strong="G1551"\w* \w daí em diante|strong="G3588,G3063"\w* \w até que sejam postos|strong="G2193,G5087"\w* \w os seus inimigos|strong="G3588,G2190,G846"\w* \w como estrado|strong="G5286"\w* \w dos seus pés|strong="G3588,G4228,G846"\w*.\f + \fr 10.13: \ft Nota cultural: ecoa Sl 110:1.\f*\x - \xo 10:13 \xt PSA 110:1; LUK 20:43; ACT 2:35; HEB 1:13; MAT 22:44; MRK 12:36\x*
\v 14 \w Pois|strong="G1063"\w* \w com uma única|strong="G1520"\w* \w oferta|strong="G4376"\w* \w aperfeiçoou|strong="G5048"\w* \w para sempre|strong="G1519,G3588,G1336"\w* \w os que são santificados|strong="G3588,G37"\w*.\x - \xo 10:14 \xt HEB 10:10; ROM 15:16; HEB 10:1; ISA 53:5; MAT 26:28; ROM 8:3\x*
\v 15 \w E também nos testemunha|strong="G3140,G1161,G3165,G2532"\w* \w o Espírito|strong="G3588,G4151"\w* \w Santo|strong="G3588,G40"\w*; \w pois depois|strong="G3326,G1063"\w* \w de ter dito|strong="G3588,G2046"\w*:\f + \fr 10.15: \ft Variante: o RP traz προειρηκέναι (“de ter dito antes”) em lugar de εἰρηκέναι.\f*\x - \xo 10:15 \xt 2PE 1:21; JHN 14:26; GAL 3:25; HEB 3:7; HEB 7:26; REV 2:11\x*
