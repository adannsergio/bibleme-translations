\v 32 \w E|strong="G2532"\w* \w que mais|strong="G5101,G2089"\w* \w digo|strong="G3004"\w*? \w Pois|strong="G1063"\w* \w me faltará|strong="G1952,G3165"\w* \w o tempo|strong="G3588,G5550"\w* \w se eu narrar|strong="G1334"\w* \w a respeito de|strong="G4012"\w* \w Gideão|strong="G1066"\w*, \w Baraque|strong="G913"\w*, \w Sansão|strong="G4546"\w*, \w Jefté|strong="G2422"\w*, \w Davi|strong="G1138"\w* \w e também|strong="G5037,G2532"\w* \w Samuel|strong="G4545"\w* \w e|strong="G2532"\w* \w dos profetas|strong="G3588,G4396"\w*,\x - \xo 11:32 \xt ACT 3:24; ACT 13:20; 1CO 16:13; HEB 12:1; 2CO 10:4; 2CO 4:13\x*
\v 33 \w os quais|strong="G3739"\w*, \w por meio da fé|strong="G1223,G4102"\w*, \w venceram|strong="G2610"\w* \w reinos|strong="G932"\w*, \w praticaram|strong="G2038"\w* \w justiça|strong="G1343"\w*, \w alcançaram|strong="G2013"\w* \w promessas|strong="G1860"\w*, \w fecharam|strong="G5420"\w* \w bocas|strong="G4750"\w* \w de leões|strong="G3023"\w*,\x - \xo 11:33 \xt 1CO 16:13; PSA 34:19; DAN 6:22; ISA 43:2; HEB 12:1; 2CO 10:4\x*
\v 34 \w apagaram|strong="G4570"\w* \w o poder|strong="G1411"\w* \w do fogo|strong="G4442"\w*, \w escaparam|strong="G5343"\w* \w do fio|strong="G4750"\w* \w da espada|strong="G3162"\w*, \w foram fortalecidos|strong="G1412"\w* \w a partir da fraqueza|strong="G575,G769"\w*, \w tornaram-se|strong="G1096"\w* \w fortes|strong="G2478"\w* \w na guerra|strong="G1722,G4171"\w*, \w puseram em fuga|strong="G2827"\w* \w exércitos|strong="G3925"\w* \w estrangeiros|strong="G245"\w*;\f + \fr 11.34: \ft Lit.: στόματα μαχαίρης, literalmente “boca da espada”, isto é, o gume.\f*\x - \xo 11:34 \xt 1CO 16:13; 2CO 12:9; PSA 34:19; ISA 40:29; ISA 43:2; HEB 12:1\x*
\v 35 \w Mulheres|strong="G1135"\w* \w receberam|strong="G2983"\w* \w os seus mortos|strong="G3588,G3498,G846"\w* \w por ressurreição|strong="G1537,G386"\w*; \w mas outros|strong="G243,G1161"\w* \w foram torturados|strong="G5178"\w*, \w não aceitando|strong="G3756,G4327"\w* \w o resgate|strong="G3588,G629"\w*, \w para que alcançassem|strong="G2443,G5177"\w* \w uma melhor|strong="G2908"\w* \w ressurreição|strong="G386"\w*;\f + \fr 11.35: \ft Lit.: τυμπανίζω, “torturar (esticando o corpo como um tambor)”; cf. 1Rs 17:17-24 e 2Rs 4:25-37.\f*\x - \xo 11:35 \xt 1KI 17:17-24; 2KI 4:25-37; ACT 24:15; LUK 20:35; PSA 34:19; 1CO 10:13\x*
\v 36 \w e outros|strong="G2087,G1161"\w* \w passaram pela experiência|strong="G3984,G2983"\w* \w de zombarias|strong="G1701"\w* \w e|strong="G2532"\w* \w açoites|strong="G3148"\w*, \w e ainda|strong="G2089,G1161"\w* \w de correntes|strong="G1199"\w* \w e|strong="G2532"\w* \w prisão|strong="G5438"\w*;\x - \xo 11:36 \xt PSA 34:19; JAS 1:2; 1CO 10:13; ISA 43:2; HEB 12:1; 2CO 4:13\x*
\v 37 \w foram apedrejados|strong="G3034"\w*, \w foram serrados|strong="G4249"\w*, \w morreram|strong="G599"\w* \w ao fio|strong="G1722,G5408"\w* \w da espada|strong="G3162"\w*, \w andaram|strong="G4022"\w* \w em peles de ovelhas|strong="G1722,G3374"\w*, \w em peles|strong="G1722,G1192"\w* \w de cabras|strong="G122"\w*, \w passando necessidade|strong="G5302"\w*, \w aflitos|strong="G2346"\w*, \w maltratados|strong="G2558"\w*;\f + \fr 11.37: \ft Variante: WH acrescenta ἐπειράσθησαν (“foram postos à prova”) antes de ἐπρίσθησαν, e o RP e o TR o trazem depois; Treg e NA28 não o trazem; o RP traz μαχαίρας em lugar de μαχαίρης.\f*\x - \xo 11:37 \xt PSA 34:19; JAS 1:2; 1CO 10:13; ISA 43:2; HEB 12:1; 2CO 4:13\x*
\v 38 \w dos quais|strong="G3739"\w* \w não|strong="G3756"\w* \w era digno|strong="G1510,G514"\w* \w o mundo|strong="G3588,G2889"\w*; \w vagando|strong="G4105"\w* \w por desertos|strong="G1909,G2047"\w* \w e|strong="G2532"\w* \w montes|strong="G3735"\w* \w e|strong="G2532"\w* \w cavernas|strong="G4693"\w* \w e|strong="G2532"\w* \w nas covas|strong="G3588,G3692"\w* \w da terra|strong="G3588,G1093"\w*.\x - \xo 11:38 \xt PSA 34:19; JAS 1:2; 1CO 10:13; ISA 43:2; HEB 12:1; 2CO 4:13\x*
\v 39 \w E|strong="G2532"\w* \w todos estes|strong="G3956"\w*, \w tendo recebido testemunho|strong="G3140"\w* \w por meio da fé|strong="G1223,G3588,G4102"\w*, \w não|strong="G3756"\w* \w obtiveram|strong="G2865"\w* \w a promessa|strong="G3588,G1860"\w*,\x - \xo 11:39 \xt HEB 10:36; LUK 10:23-24; 2CO 4:13; HEB 11:13; JHN 20:29; HEB 11:2\x*
\v 40 \w tendo Deus|strong="G3588,G2316"\w* \w previsto|strong="G4265"\w* \w algo melhor|strong="G2908,G5100"\w* \w a nosso respeito|strong="G4012,G3165"\w*, \w para que não|strong="G2443,G3361"\w* \w fossem aperfeiçoados|strong="G5048"\w* \w sem nós|strong="G5565,G3165"\w*.\x - \xo 11:40 \xt HEB 7:19; 2CO 4:13; REV 6:11; 1PE 1:12; ISA 60:17; ROM 3:25\x*
\c 12
\p
\v 1 \w Portanto|strong="G5105"\w*, \w também|strong="G2532"\w* \w nós|strong="G3165"\w*, \w tendo|strong="G2192"\w* \w ao redor de nós|strong="G4029,G3165"\w* \w tamanha|strong="G5118"\w* \w nuvem|strong="G3509"\w* \w de testemunhas|strong="G3144"\w*, \w deixando de lado|strong="G659"\w* \w todo peso|strong="G3591,G3956"\w* \w e|strong="G2532"\w* \w o pecado|strong="G3588,G266"\w* \w que facilmente nos envolve|strong="G2139"\w*, \w corramos|strong="G5143"\w* \w com perseverança|strong="G1223,G5281"\w* \w a corrida|strong="G73"\w* \w que nos está proposta|strong="G3588,G4295,G3165"\w*.\f + \fr 12.1: \ft Lit.: ὄγκος, “peso, carga”; εὐπερίστατος, “que facilmente envolve ou cerca”; ἀγών, “competição, corrida, combate”.\f*\x - \xo 12:1 \xt 1CO 9:24; 2TI 4:7; ISA 40:31; PHP 2:16; LUK 21:34; HEB 10:35-39\x*
\v 2 \w Olhando firmemente|strong="G872"\w* \w para o autor|strong="G1519,G3588,G747"\w* \w e|strong="G2532"\w* \w aperfeiçoador|strong="G5051"\w* \w da fé|strong="G3588,G4102"\w*, \w Jesus|strong="G2424"\w*, \w o qual|strong="G3739"\w*, \w em lugar da|strong="G473,G3588"\w* \w alegria|strong="G5479"\w* \w que lhe estava proposta|strong="G4295,G846"\w*, \w suportou|strong="G5278"\w* \w a cruz|strong="G4716"\w*, \w desprezando|strong="G2706"\w* \w a vergonha|strong="G152"\w*, \w e|strong="G5037"\w* \w está sentado|strong="G2523"\w* \w à direita|strong="G1722,G1188"\w* \w do trono|strong="G3588,G2362"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 12.2: \ft Lit.: ἀντί pode significar “em lugar de” (renunciando à alegria) ou “em vista de” (pela alegria posta diante dele).\f*\x - \xo 12:2 \xt MIC 7:7; 1PE 3:18; PHP 3:13; 1PE 2:23-24; PHP 1:6; JAS 5:7\x*
\v 3 \w Considerem|strong="G357"\w*, \w pois|strong="G1063"\w*, \w aquele que suportou|strong="G3588,G5278"\w* \w tal|strong="G5108"\w* \w oposição|strong="G485"\w* \w por parte dos pecadores|strong="G5259,G3588,G268"\w* \w contra si mesmos|strong="G1519,G1438"\w*, \w para que não|strong="G2443,G3361"\w* \w se cansem|strong="G2577"\w*, \w desfalecendo|strong="G1590"\w* \w nas suas almas|strong="G3588,G5590,G4771"\w*.\f + \fr 12.3: \ft Variante: WH lê εἰς ἑαυτούς (“contra si mesmos”), como o SBLGNT; NA28 e Treg trazem ἑαυτόν, e o RP traz αὐτόν (“contra ele”).\f*\x - \xo 12:3 \xt GAL 6:9; ISA 40:31; JAS 5:7; 2TI 2:3; 2CO 4:16; 2CO 4:18\x*
\v 4 \w Ainda não|strong="G3768"\w* \w até o sangue|strong="G3360,G129"\w* \w resistiram|strong="G478"\w*, \w lutando contra|strong="G4314,G464"\w* \w o pecado|strong="G3588,G266"\w*;\x - \xo 12:4 \xt 1CO 10:13; EPH 6:12; PRO 24:10; LUK 18:1; JER 12:5; ROM 8:35\x*
\v 5 \w e|strong="G2532"\w* \w esqueceram|strong="G1585"\w* \w a exortação|strong="G3588,G3874"\w* \w que|strong="G3748"\w* \w lhes fala|strong="G4771,G1256"\w* \w como a filhos|strong="G5613,G5207"\w*: “\w Meu filho|strong="G5207,G3165"\w*, \w não despreze|strong="G3361,G3643"\w* \w a disciplina|strong="G3809"\w* \w do Senhor|strong="G2962"\w*, \w nem|strong="G3366"\w* \w desanime|strong="G1590"\w* \w quando repreendido|strong="G1651"\w* \w por ele|strong="G5259,G846"\w*;\f + \fr 12.5: \ft Nota cultural: cita Pv 3:11-12 (LXX); παιδεία, “educação, disciplina”.\f*\x - \xo 12:5 \xt PRO 3:11; GAL 6:9; JOB 5:17; HEB 12:11; REV 3:19; PSA 103:13\x*
\v 6 \w pois|strong="G1063"\w* \w a quem|strong="G3739"\w* \w ama|strong="G25"\w* \w o Senhor|strong="G2962"\w* \w disciplina|strong="G3811"\w*, \w e|strong="G1161"\w* \w açoita|strong="G3146"\w* \w todo filho|strong="G3956,G5207"\w* \w a quem|strong="G3739"\w* \w acolhe|strong="G3858"\w*.”\x - \xo 12:6 \xt ROM 8:28; REV 3:19; HEB 12:11; PRO 3:12; PSA 103:13; PRO 3:11\x*
\v 7 \w É para disciplina|strong="G1519,G3809"\w* \w que vocês suportam|strong="G5278"\w*; \w como a filhos|strong="G5613,G5207"\w* \w Deus|strong="G3588,G2316"\w* \w se comporta|strong="G4374"\w* \w com vocês|strong="G4771"\w*. \w Pois|strong="G1063"\w* \w que filho|strong="G5101,G5207"\w* \w há a quem|strong="G3739"\w* \w não|strong="G3756"\w* \w discipline|strong="G3811"\w* \w o pai|strong="G3962"\w*?\f + \fr 12.7: \ft Lit.: ὑπομένετε pode ser indicativo (“é para disciplina que vocês suportam”) ou imperativo (“suportem isto como disciplina”).\f*\f + \fr 12.7: \ft Acréscimo: verbo ser/estar suprido em “É para disciplina”, “há a quem”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:7 \xt ROM 8:28; PSA 103:13; PRO 3:11; REV 3:19; PRO 13:24; JOB 5:17\x*
\v 8 \w Mas se|strong="G1487,G1161"\w* \w estão sem|strong="G5565,G1510"\w* \w disciplina|strong="G3809"\w*, \w da qual|strong="G3739"\w* \w se tornaram participantes|strong="G3353,G1096"\w* \w todos|strong="G3956"\w*, \w então|strong="G686"\w* \w são|strong="G1510"\w* \w bastardos|strong="G3541"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w filhos|strong="G5207"\w*\f + \fr 12.8: \ft Lit.: νόθος, “filho ilegítimo”.\f*.\x - \xo 12:8 \xt ROM 8:28; PSA 103:13; PRO 3:11; REV 3:19; PRO 13:24; JOB 5:17\x*
\v 9 \w Além disso|strong="G1534"\w*, \w os pais|strong="G3588,G3962"\w* \w da nossa carne|strong="G3588,G4561,G3165"\w* \w tínhamos|strong="G2192"\w* \w como disciplinadores|strong="G3810"\w*, \w de fato|strong="G3303"\w*, \w e|strong="G2532"\w* \w os respeitávamos|strong="G1788"\w*; \w não muito mais|strong="G3756,G4183,G3123"\w* \w nos submeteremos|strong="G5293"\w* \w ao Pai|strong="G3588,G3962"\w* \w dos espíritos|strong="G3588,G4151"\w* \w e|strong="G2532"\w* \w viveremos|strong="G2198"\w*?\x - \xo 12:9 \xt ROM 8:28; PSA 103:13; JAS 4:7; NUM 16:22; PRO 3:11; NUM 27:16\x*
\v 10 \w Pois|strong="G1063"\w* \w aqueles|strong="G3588"\w*, \w de fato|strong="G3303"\w*, \w disciplinavam|strong="G3811"\w* \w por poucos|strong="G4314,G3641"\w* \w dias|strong="G2250"\w* \w conforme|strong="G2596"\w* \w o que lhes parecia|strong="G3588,G1380,G846"\w*; \w mas ele|strong="G3588,G1161"\w* \add nos disciplina\add* \w para o que é proveitoso|strong="G1909,G3588,G4851"\w*, \w a fim de participarmos|strong="G1519,G3588,G3335"\w* \w da santidade|strong="G3588,G41"\w* \w dele|strong="G846"\w*.\f + \fr 12.10: \ft Acréscimo: “nos” (em “mas ele nos disciplina para”): preposição ou artigo que a regência do português exige; “disciplina” (em “ele nos disciplina para o”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 12:10 \xt ROM 8:28; JHN 15:2; PSA 119:71; PSA 103:13; 2CO 4:17; 2PE 1:4\x*
\v 11 \w Toda|strong="G3956"\w* \w disciplina|strong="G3809"\w*, \w no momento presente|strong="G4314,G3303,G3588,G3918"\w*, \w não|strong="G3756"\w* \w parece|strong="G1380"\w* \w ser de alegria|strong="G5479,G1511"\w*, \w mas|strong="G235"\w* \w de tristeza|strong="G3077"\w*; \w mas depois|strong="G5305,G1161"\w* \w produz|strong="G591"\w* \w fruto|strong="G2590"\w* \w pacífico|strong="G1516"\w* \w de justiça|strong="G1343"\w* \w aos que por meio dela|strong="G3588,G1223,G846"\w* \w foram treinados|strong="G1128"\w*.\x - \xo 12:11 \xt ROM 8:28; JHN 15:2; ROM 5:3; PSA 119:71; 2CO 4:17; HEB 12:5-6\x*
\p
\v 12 \w Por isso|strong="G1352"\w*, \w levantem de novo|strong="G461"\w* \w as mãos|strong="G3588,G5495"\w* \w caídas|strong="G3935"\w* \w e|strong="G2532"\w* \w os joelhos|strong="G3588,G1119"\w* \w enfraquecidos|strong="G3886"\w*,\f + \fr 12.12: \ft Nota cultural: ecoa Is 35:3.\f*\x - \xo 12:12 \xt ISA 35:3; 1SA 23:16; ROM 8:28; PSA 31:24; JHN 14:1; PRO 3:11\x*
\v 13 \w e|strong="G2532"\w* \w façam|strong="G4160"\w* \w veredas|strong="G5163"\w* \w retas|strong="G3717"\w* \w para os seus pés|strong="G3588,G4228,G4771"\w*, \w para que|strong="G2443"\w* \w o que é manco|strong="G3588,G5560"\w* \w não|strong="G3361"\w* \w se desvie|strong="G1624"\w*, \w mas antes|strong="G1161,G3123"\w* \w seja curado|strong="G2390"\w*.\f + \fr 12.13: \ft Nota cultural: ecoa Pv 4:26 (LXX).\f*\f + \fr 12.13: \ft Acréscimo: verbo ser/estar suprido em “o que é manco”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:13 \xt PRO 4:26; 1SA 23:16; ZEP 3:19; PSA 31:24; JAS 5:16; JHN 14:1\x*
\v 14 \w Busquem|strong="G1377"\w* \w paz|strong="G1515"\w* \w com todos|strong="G3326,G3956"\w*, \w e|strong="G2532"\w* \w a santificação|strong="G3588,G38"\w*, \w sem a qual|strong="G3739,G5565"\w* \w ninguém|strong="G3762"\w* \w verá|strong="G3700"\w* \w o Senhor|strong="G3588,G2962"\w*;\x - \xo 12:14 \xt MAT 5:9; ROM 14:19; MAT 5:8; 2CO 7:1; PSA 34:14; 1PE 1:15\x*
\v 15 \w vigiando|strong="G1983"\w* \w para que ninguém|strong="G3361,G5100"\w* \w fique aquém|strong="G5302"\w* \w da graça|strong="G575,G3588,G5485"\w* \w de Deus|strong="G3588,G2316"\w*, \w para que nenhuma|strong="G3361,G5100"\w* \w raiz|strong="G4491"\w* \w de amargura|strong="G4088"\w*, \w brotando|strong="G507,G5453"\w*, \w cause dano|strong="G1776"\w*, \w e|strong="G2532"\w* \w por meio dela|strong="G1223,G846"\w* \w muitos|strong="G4183"\w* \w sejam contaminados|strong="G3392"\w*,\f + \fr 12.15: \ft Nota cultural: ecoa Dt 29:17 (LXX).\f*\x - \xo 12:15 \xt DEU 29:17; PRO 4:23; 2CO 13:5; 1CO 15:33; HEB 3:12; 1CO 6:12\x*
\v 16 \w para que ninguém|strong="G3361,G5100"\w* \w seja imoral|strong="G4205"\w* \w ou|strong="G2228"\w* \w profano|strong="G952"\w*, \w como|strong="G5613"\w* \w Esaú|strong="G2269"\w*, \w que|strong="G3739"\w*, \w por uma só|strong="G473,G1520"\w* \w refeição|strong="G1035"\w*, \w vendeu|strong="G591"\w* \w os seus direitos de primogênito|strong="G3588,G4415,G1438"\w*.\f + \fr 12.16: \ft Nota cultural: cf. Gn 25:29-34.\f*\f + \fr 12.16: \ft Acréscimo: verbo ser/estar suprido em “seja imoral”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:16 \xt GEN 25:29-34; 1CO 6:12; 1CO 6:9; GEN 25:31-34; HEB 6:4; PSA 139:24\x*
\v 17 \w Pois|strong="G1063"\w* \w sabem|strong="G6063"\w* \w que|strong="G3754"\w* \w também|strong="G2532"\w*, \w depois|strong="G3347"\w*, \w querendo|strong="G2309"\w* \w herdar|strong="G2816"\w* \w a bênção|strong="G3588,G2129"\w*, \w foi rejeitado|strong="G593"\w*; \w pois|strong="G1063"\w* \w lugar|strong="G5117"\w* \w de arrependimento|strong="G3341"\w* \w não|strong="G3756"\w* \w achou|strong="G2147"\w*, \w embora|strong="G2539"\w* \w a tivesse procurado|strong="G1567,G846"\w* \w com lágrimas|strong="G3326,G1144"\w*.\x - \xo 12:17 \xt HEB 6:4; 2CO 7:10; PRO 1:24-31; GEN 25:34; MAT 25:11; GEN 27:34\x*
\p
\v 18 \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w se aproximaram|strong="G4334"\w* \w de algo palpável|strong="G5584"\w*, \w e|strong="G2532"\w* \w de fogo|strong="G4442"\w* \w ardente|strong="G2545"\w*, \w e|strong="G2532"\w* \w de nuvem escura|strong="G1105"\w*, \w e|strong="G2532"\w* \w escuridão|strong="G2217"\w*, \w e|strong="G2532"\w* \w tempestade|strong="G2366"\w*,\f + \fr 12.18: \ft Nota cultural: refere-se à teofania do Sinai (Êx 19:16-19; Dt 4:11-12).\f*\f + \fr 12.18: \ft Variante: o RP e o TR acrescentam ὄρει (“monte”) depois de “palpável”, e o RP traz σκότῳ (“trevas”) em lugar de ζόφῳ.\f*\x - \xo 12:18 \xt DEU 4:11; EXO 19:16; EXO 24:17; DEU 5:22-26; 1KI 19:11; 1KI 8:12\x*
\v 19 \w e|strong="G2532"\w* \w de som|strong="G2279"\w* \w de trombeta|strong="G4536"\w* \w e|strong="G2532"\w* \w de voz|strong="G5456"\w* \w de palavras|strong="G4487"\w*, \w a qual|strong="G3739"\w* \w os que ouviram|strong="G3588,G191"\w* \w pediram|strong="G3868"\w* \w que não lhes fosse acrescentada|strong="G3361,G4369,G846"\w* \w palavra|strong="G3056"\w*;\x - \xo 12:19 \xt EXO 19:16; 1KI 19:11; 2CO 3:9; DEU 18:16; 1CO 15:52; DEU 4:10\x*
\v 20 \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w suportavam|strong="G5342"\w* \w o que era ordenado|strong="G3588,G1291"\w*: “\w Até uma fera|strong="G1437,G2532,G2342"\w*, \w se tocar|strong="G2345"\w* \w o monte|strong="G3588,G3735"\w*, \w será apedrejada|strong="G3036"\w*.”\f + \fr 12.20: \ft Nota cultural: cita Êx 19:12-13.\f*\f + \fr 12.20: \ft Variante: o TR acrescenta ἢ βολίδι κατατοξευθήσεται (“ou será atravessado por uma flecha”) no fim da citação.\f*\x - \xo 12:20 \xt EXO 19:12; EXO 3:5; NEH 4:14; 1KI 19:11; 2CO 3:9; REV 4:5\x*
\v 21 \w E|strong="G2532"\w*, \w tão terrível|strong="G3779,G5398"\w* \w era|strong="G1510"\w* \w o espetáculo|strong="G3588,G5324"\w*, \w Moisés|strong="G3475"\w* \w disse|strong="G2036"\w*: “\w Estou aterrorizado|strong="G1630,G1510"\w* \w e|strong="G2532"\w* \w tremendo|strong="G1790"\w*.”\f + \fr 12.21: \ft Nota cultural: cf. Dt 9:19.\f*\x - \xo 12:21 \xt DEU 9:19; EXO 19:16; PSA 119:120; ISA 6:3-5; NEH 4:14; 1KI 19:11\x*
\v 22 \w Mas vocês se aproximaram|strong="G235,G4334"\w* \w do monte|strong="G3735"\w* \w Sião|strong="G4622"\w*, \w e|strong="G2532"\w* \w da cidade|strong="G4172"\w* \w do Deus|strong="G2316"\w* \w vivo|strong="G2198"\w*, \w a Jerusalém|strong="G2419"\w* \w celestial|strong="G2032"\w*, \w e|strong="G2532"\w* \w de miríades|strong="G3461"\w* \w de anjos|strong="G32"\w*, \w em festa solene|strong="G3831"\w*,\x - \xo 12:22 \xt PHP 3:20; GAL 4:26; HEB 11:10; MAT 16:16; HEB 13:14; ISA 60:14\x*
\v 23 \w e|strong="G2532"\w* \w à comunidade|strong="G1577"\w* \w dos primogênitos|strong="G4416"\w* \w inscritos|strong="G583"\w* \w nos céus|strong="G1722,G3772"\w*, \w e|strong="G2532"\w* \w a Deus|strong="G2316"\w*, \w juiz|strong="G2923"\w* \w de todos|strong="G3956"\w*, \w e|strong="G2532"\w* \w aos espíritos|strong="G4151"\w* \w dos justos|strong="G1342"\w* \w aperfeiçoados|strong="G5048"\w*,\f + \fr 12.23: \ft Lit.: ἐκκλησία, “assembleia, comunidade”.\f*\x - \xo 12:23 \xt LUK 10:20; JAS 1:18; PSA 24:3; REV 14:1; EPH 2:19; HEB 11:40\x*
\v 24 \w e|strong="G2532"\w* \w a Jesus|strong="G2424"\w*, \w mediador|strong="G3316"\w* \w de uma nova|strong="G3501"\w* \w aliança|strong="G1242"\w*, \w e|strong="G2532"\w* \w ao sangue|strong="G129"\w* \w de aspersão|strong="G4473"\w* \w que fala|strong="G2980"\w* \w melhor|strong="G2908"\w* \w do que Abel|strong="G3844,G3588,G6"\w*.\f + \fr 12.24: \ft Nota cultural: cf. Gn 4:10.\f*\f + \fr 12.24: \ft Variante: o TR traz κρείττονα (“coisas melhores”) em lugar de κρεῖττον.\f*\x - \xo 12:24 \xt GEN 4:10; HEB 8:6; HEB 7:22; JER 31:31; HEB 9:15; 1TI 2:5\x*
\p
\v 25 \w Cuidem|strong="G991"\w* \w para não recusarem|strong="G3361,G3868"\w* \w aquele que fala|strong="G3588,G2980"\w*; \w pois|strong="G1063"\w* \w se|strong="G1487"\w* \w aqueles|strong="G1565"\w* \w não|strong="G3756"\w* \w escaparam|strong="G1628"\w*, \w recusando|strong="G3868"\w* \w aquele que advertia|strong="G3588,G5537"\w* \w sobre a terra|strong="G1909,G1093"\w*, \w muito mais|strong="G4183,G3123"\w* \w nós|strong="G3165"\w*, \w que nos afastamos|strong="G3588,G654"\w* \w daquele|strong="G3588"\w* \w que fala dos céus|strong="G575,G3772"\w*, \add não escaparemos.\add*\f + \fr 12.25: \ft Acréscimo: “não” (em “dos céus não escaparemos”), “escaparemos” (em “céus não escaparemos”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 12:25 \xt ACT 4:12; HEB 3:12; PSA 2:11; JHN 8:24; 2CH 15:2; HEB 2:3\x*
\v 26 \w Cuja voz|strong="G3739,G3588,G5456"\w* \w abalou|strong="G4531"\w* \w a terra|strong="G3588,G1093"\w* \w então|strong="G5119"\w*, \w mas agora|strong="G3568,G1161"\w* \w prometeu|strong="G1861"\w*, \w dizendo|strong="G3004"\w*: “\w Ainda uma vez|strong="G2089,G530"\w* \w eu|strong="G1473"\w* \w abalarei|strong="G4579"\w* \w não somente|strong="G3756,G3441"\w* \w a terra|strong="G3588,G1093"\w*, \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w o céu|strong="G3588,G3772"\w*.”\f + \fr 12.26: \ft Nota cultural: cita Ag 2:6 (LXX).\f*\x - \xo 12:26 \xt HAG 2:6; ISA 13:13; EXO 19:18; JOL 3:16; ISA 2:19; 1KI 19:11\x*
\v 27 \w E o “ainda uma vez|strong="G3588,G1161,G2089,G530"\w*” \w indica|strong="G1213"\w* \w a remoção|strong="G3331"\w* \w das coisas abaladas|strong="G3588,G4531"\w*, \w como coisas feitas|strong="G5613,G4160"\w*, \w para que permaneçam|strong="G2443,G3306"\w* \w as que não são abaladas|strong="G3588,G3361,G4531"\w*.\x - \xo 12:27 \xt HAG 2:6; ISA 13:13; HEB 10:9; MAT 24:7; PSA 130:4; ACT 6:14\x*
\v 28 \w Por isso|strong="G1352"\w*, \w recebendo|strong="G3880"\w* \w um reino|strong="G932"\w* \w inabalável|strong="G761"\w*, \w tenhamos|strong="G2192"\w* \w graça|strong="G5485"\w*, \w por meio da qual|strong="G1223,G3739"\w* \add prestemos\add* \w culto|strong="G3000"\w* \w de modo agradável|strong="G2102"\w* \w a Deus|strong="G3588,G2316"\w* \w com reverência|strong="G3326,G2124"\w* \w e|strong="G2532"\w* \w temor|strong="G6015"\w*,\f + \fr 12.28: \ft Lit.: ἔχωμεν χάριν, “tenhamos graça”; a expressão ἔχειν χάριν também significa “ter gratidão”, ou seja, “sejamos agradecidos”.\f*\f + \fr 12.28: \ft Acréscimo: “prestemos” (em “da qual prestemos culto de”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 12:28 \xt LUK 12:32; 1JN 4:18; MAT 16:18; ROM 12:1-2; EXO 15:11; PSA 2:11\x*
\v 29 \w pois também|strong="G2532,G1063"\w* \w o nosso Deus|strong="G3588,G2316,G3165"\w* \w é fogo|strong="G4442"\w* \w consumidor|strong="G2654"\w*.\f + \fr 12.29: \ft Nota cultural: cita Dt 4:24.\f*\f + \fr 12.29: \ft Acréscimo: verbo ser/estar suprido em “é fogo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:29 \xt DEU 4:24; EXO 15:11; DEU 9:3; MAT 10:28; HEB 10:31; 2TH 1:8\x*
\c 13
\p
\v 1 \w O amor fraterno|strong="G3588,G5360"\w* \w permaneça|strong="G3306"\w*.\f + \fr 13.1: \ft Lit.: φιλαδελφία, “amor de irmãos”.\f*\x - \xo 13:1 \xt PSA 133:1; HEB 10:24; ROM 12:10; HEB 13:16; 1PE 1:22; JHN 13:34\x*
\v 2 \w Não se esqueçam|strong="G3361,G1950"\w* \w da hospitalidade|strong="G3588,G5381"\w*; \w pois|strong="G1063"\w* \w por meio dela|strong="G1223,G3778"\w* \w alguns|strong="G5100"\w* \w sem perceber|strong="G2990"\w* \w hospedaram|strong="G3579"\w* \w anjos|strong="G32"\w*.\f + \fr 13.2: \ft Nota cultural: alude a Gn 18:1-8 e 19:1-3; φιλοξενία, “amor ao estrangeiro, hospitalidade”.\f*\x - \xo 13:2 \xt GEN 19:1; GEN 18:1-8; MAT 25:35; HEB 13:16; GEN 18:1-19:3; 1PE 4:9\x*
\v 3 \w Lembrem-se|strong="G3403"\w* \w dos presos|strong="G3588,G1198"\w*, \w como|strong="G5613"\w* \w presos com eles|strong="G4887"\w*, \w dos que são maltratados|strong="G3588,G2558"\w*, \w como|strong="G5613"\w* \w também|strong="G2532"\w* \w vocês mesmos|strong="G846"\w* \w estando|strong="G1510"\w* \w num corpo|strong="G1722,G4983"\w*.\x - \xo 13:3 \xt ROM 12:15; MAT 25:36; HEB 10:34; MAT 25:35; ACT 20:35; HEB 10:24\x*
\v 4 \w Honrado seja|strong="G5093"\w* \w o casamento|strong="G3588,G1062"\w* \w entre todos|strong="G1722,G3956"\w*, \w e|strong="G2532"\w* \w o leito|strong="G3588,G2845"\w* \w sem mancha|strong="G283"\w*; \w pois|strong="G1063"\w* \w os imorais|strong="G4205"\w* \w e|strong="G2532"\w* \w adúlteros|strong="G3432"\w* \w julgará|strong="G2919"\w* \w Deus|strong="G3588,G2316"\w*.\f + \fr 13.4: \ft Lit.: ἐν πᾶσιν pode ser masculino (“entre todos”) ou neutro (“em todos os aspectos”); sem verbo no grego, “Honrado seja” também pode ser lido como indicativo (“o casamento é honroso”).\f*\f + \fr 13.4: \ft Acréscimo: verbo ser/estar suprido em “Honrado seja”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:4 \xt GEN 2:24; EXO 20:14; PRO 5:15; 1CO 7:2-16; 1TH 4:3; GAL 5:19\x*
\v 5 \w Sem amor ao dinheiro|strong="G866"\w* \w seja o modo de vida|strong="G3588,G5158"\w*, \w contentando-se|strong="G714"\w* \w com o que têm|strong="G3588,G3918"\w*; \w pois|strong="G1063"\w* \w ele mesmo|strong="G846"\w* \w disse|strong="G2046"\w*: “\w De modo algum|strong="G3756,G3361"\w* \w o deixarei|strong="G4771,G447"\w*, \w nem|strong="G3761"\w* \w de modo algum|strong="G3756,G3361"\w* \w o abandonarei|strong="G4771,G1459"\w*.”\f + \fr 13.5: \ft Nota cultural: cita Dt 31:6 e 8, na forma grega (cf. Js 1:5).\f*\f + \fr 13.5: \ft Acréscimo: verbo ser/estar suprido em “seja o modo de vida”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:5 \xt DEU 31:6; JOS 1:5; 1PE 5:7; DEU 31:8; PSA 23:1; 1SA 12:22\x*
\v 6 \w de modo que|strong="G5620"\w* \w nós, tendo ânimo|strong="G2292,G3165"\w*, \w dizemos|strong="G3004"\w*: “\w O Senhor|strong="G2962"\w* \w é para mim|strong="G1473"\w* \w auxiliador|strong="G998"\w*; \w não|strong="G3756"\w* \w temerei|strong="G5399"\w*; \w o que|strong="G5101"\w* \w me fará|strong="G4160,G3165"\w* \w um ser humano|strong="G444"\w*?”\f + \fr 13.6: \ft Nota cultural: cita Sl 118:6 (117:6 na LXX).\f*\f + \fr 13.6: \ft Acréscimo: verbo ser/estar suprido em “é para mim”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:6 \xt PSA 118:6; 1PE 5:7; DAN 3:16-18; GEN 15:1; HEB 4:16; ISA 41:10\x*
\p
\v 7 \w Lembrem-se|strong="G3421"\w* \w dos seus líderes|strong="G3588,G2233,G4771"\w*, \w que lhes falaram|strong="G3748,G2980,G4771"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w*; \w considerando|strong="G333"\w* \w o resultado|strong="G3588,G1545"\w* \w da conduta|strong="G3588,G391"\w* \w deles|strong="G3739"\w*, \w imitem|strong="G3401"\w* \w a fé|strong="G3588,G4102"\w*.\x - \xo 13:7 \xt HEB 13:17; 1TH 5:12; HEB 4:12; PHP 3:17; HEB 6:12; 1TI 5:17\x*
\v 8 \w Jesus Cristo|strong="G2424,G5547"\w* \w é o mesmo|strong="G3588,G846"\w* \w ontem|strong="G5504"\w* \w e|strong="G2532"\w* \w hoje|strong="G4594"\w* \w e|strong="G2532"\w* \w para sempre|strong="G1519,G3588,G165"\w*.\f + \fr 13.8: \ft Acréscimo: verbo ser/estar suprido em “é o mesmo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:8 \xt JAS 1:17; MAL 3:6; REV 1:8; JHN 1:1; ISA 44:6; HEB 1:12\x*
\v 9 \w Não se deixem levar|strong="G3361,G3911"\w* \w por ensinos|strong="G1322"\w* \w variados|strong="G4164"\w* \w e|strong="G2532"\w* \w estranhos|strong="G3581"\w*; \w pois|strong="G1063"\w* \w é bom|strong="G2570"\w* \w que o coração|strong="G3588,G2588"\w* \w seja firmado|strong="G950"\w* \w pela graça|strong="G5485"\w*, \w não|strong="G3756"\w* \w por alimentos|strong="G1033"\w*, \w dos quais|strong="G1722,G3739"\w* \w não|strong="G3756"\w* \w tiraram proveito|strong="G5623"\w* \w os que andavam neles|strong="G3588,G4043"\w*.\f + \fr 13.9: \ft Acréscimo: verbo ser/estar suprido em “é bom”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:9 \xt EPH 4:14; 2CO 11:3; COL 2:8; 1TI 6:3-5; EPH 5:6; 1JN 4:1\x*
\v 10 \w Temos|strong="G2192"\w* \w um altar|strong="G2379"\w*, \w do qual|strong="G1537,G3739"\w* \w não|strong="G3756"\w* \w têm|strong="G2192"\w* \w direito|strong="G1849"\w* \w de comer|strong="G5315"\w* \w os que prestam culto|strong="G3588,G3000"\w* \w na tenda|strong="G3588,G4633"\w*.\f + \fr 13.10: \ft Tradução: ἐξουσίαν (ἐξουσία, G1849) está aqui como “direito”; o termo pode ser “autoridade”, “poder”, “direito” ou “liberdade de agir”, e o contexto decide.\f*\x - \xo 13:10 \xt ISA 53:10; 1CO 10:20; 1CO 5:7-8; EXO 38:1; GEN 8:20; ISA 6:6\x*
\v 11 \w Pois|strong="G1063"\w* \add daqueles\add* \w animais|strong="G2226"\w* \w cujo sangue|strong="G3739,G3588,G129"\w* \w é levado|strong="G1533"\w* \w pelo pecado|strong="G4012,G266"\w* \w ao santuário|strong="G1519,G3588,G39"\w* \w pelo sumo sacerdote|strong="G1223,G3588,G749"\w*, \w os corpos|strong="G3588,G4983"\w* \w destes|strong="G3778"\w* \w são queimados|strong="G2618"\w* \w fora|strong="G1854"\w* \w do acampamento|strong="G3588,G3925"\w*\f + \fr 13.11: \ft Nota cultural: refere-se ao rito do Dia da Expiação (Lv 16:27).\f*;\f + \fr 13.11: \ft Acréscimo: “daqueles” (em “Pois daqueles animais cujo”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 13:11 \xt LEV 16:27; ISA 53:10; LEV 4:12; EXO 29:14; REV 14:20; LEV 9:11\x*
\v 12 \w por isso|strong="G1352"\w* \w também|strong="G2532"\w* \w Jesus|strong="G2424"\w*, \w para santificar|strong="G2443,G37"\w* \w o povo|strong="G3588,G2992"\w* \w por meio do seu próprio|strong="G1223,G3588,G2398"\w* \w sangue|strong="G129"\w*, \w sofreu|strong="G3958"\w* \w fora|strong="G1854"\w* \w do portão|strong="G3588,G4439"\w*.\x - \xo 13:12 \xt REV 7:14; LEV 17:11; HEB 9:12-14; HEB 10:10; HEB 2:11; JHN 19:17\x*
\v 13 \w Saiamos|strong="G1831"\w*, \w pois|strong="G5106"\w*, \w até ele|strong="G4314,G846"\w*, \w fora|strong="G1854"\w* \w do acampamento|strong="G3588,G3925"\w*, \w carregando|strong="G5342"\w* \w a humilhação|strong="G3588,G3680"\w* \w dele|strong="G846"\w*.\x - \xo 13:13 \xt HEB 12:2; HEB 11:26; 1PE 4:14-16; LUK 9:26; ACT 5:41; LUK 6:22\x*
\v 14 \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w temos|strong="G2192"\w* \w aqui|strong="G5602"\w* \w cidade permanente|strong="G3306,G4172"\w*, \w mas|strong="G235"\w* \w procuramos|strong="G1934"\w* \w a que há de vir|strong="G3588,G3195"\w*.\x - \xo 13:14 \xt JHN 14:2; PHP 3:20; HEB 11:10; HEB 11:16; COL 3:1-3; REV 21:2\x*
\v 15 \w Por meio dele|strong="G1223,G846"\w*, \w pois|strong="G3767"\w*, \w ofereçamos|strong="G399"\w* \w sacrifício|strong="G2378"\w* \w de louvor|strong="G133"\w* \w continuamente|strong="G1223,G3956"\w* \w a Deus|strong="G3588,G2316"\w*, \w isto é|strong="G3778,G1510"\w*, \w fruto|strong="G2590"\w* \w de lábios|strong="G5491"\w* \w que confessam|strong="G3670"\w* \w o nome|strong="G3588,G3686"\w* \w dele|strong="G846"\w*.\f + \fr 13.15: \ft Nota cultural: ecoa Os 14:3 (LXX) e Sl 50:14, 23.\f*\x - \xo 13:15 \xt PSA 50:14; HOS 14:3; ROM 12:1; 1CO 15:58; 1TH 5:18; PSA 100:4\x*
\v 16 \w E não se esqueçam|strong="G1161,G3361,G1950"\w* \w de fazer o bem|strong="G3588,G2140"\w* \w e|strong="G2532"\w* \w partilhar|strong="G2842"\w*; \w pois|strong="G1063"\w* \w com tais|strong="G5108"\w* \w sacrifícios|strong="G2378"\w* \w se agrada|strong="G2100"\w* \w Deus|strong="G3588,G2316"\w*.\x - \xo 13:16 \xt ROM 12:1; 1CO 15:58; ACT 20:35; GAL 6:10; 1JN 3:17; 2TH 3:13\x*
\v 17 \w Obedeçam|strong="G3982"\w* \w aos seus líderes|strong="G3588,G2233,G4771"\w* \w e|strong="G2532"\w* \w submetam-se|strong="G5226"\w*; \w pois|strong="G1063"\w* \w eles|strong="G846"\w* \w vigiam|strong="G69"\w* \w pelas almas|strong="G5228,G3588,G5590"\w* \w de vocês|strong="G4771"\w*, \w como quem|strong="G5613"\w* \w vai prestar contas|strong="G3056,G591"\w*, \w para que|strong="G2443"\w* \w façam isto|strong="G3778,G4160"\w* \w com alegria|strong="G3326,G5479"\w* \w e|strong="G2532"\w* \w não gemendo|strong="G3361,G4727"\w*; \w pois|strong="G1063"\w* \w isto|strong="G3778"\w* \w não seria proveitoso|strong="G255"\w* \w para vocês|strong="G4771"\w*.\f + \fr 13.17: \ft Acréscimo: verbo ser/estar suprido em “não seria proveitoso”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:17 \xt 1TH 5:12; 1TI 5:17; HEB 13:7; 1PE 5:5; ACT 20:28; 1PE 5:2-3\x*
\v 18 \w Orem|strong="G4336"\w* \w por nós|strong="G4012,G3165"\w*; \w pois|strong="G1063"\w* \w estamos convencidos|strong="G3982"\w* \w de que|strong="G3754"\w* \w temos|strong="G2192"\w* \w boa|strong="G2570"\w* \w consciência|strong="G4893"\w*, \w querendo|strong="G2309"\w* \w em tudo|strong="G1722,G3956"\w* \w comportar-nos bem|strong="G2573,G390"\w*.\x - \xo 13:18 \xt PHP 4:8; JAS 5:16; 1PE 3:16; EPH 6:19; 1PE 2:12; 1TH 5:25\x*
\v 19 \w E peço|strong="G1161,G3870"\w* \w com mais insistência|strong="G4056"\w* \w que façam|strong="G3778,G4160"\w* \add isto\add* \w para que|strong="G2443"\w* \w mais depressa|strong="G5032"\w* \w eu seja devolvido|strong="G600"\w* \w a vocês|strong="G4771"\w*.\f + \fr 13.19: \ft Acréscimo: “isto” (em “que façam isto para que”): demonstrativo acrescentado para retomar o que foi dito.\f*\x - \xo 13:19 \xt 1TH 5:25; PHM 1:22; 2TH 3:1; COL 4:3; 2JN 1:12; ROM 1:10\x*
\p
\v 20 \w E o Deus|strong="G3588,G1161,G2316"\w* \w da paz|strong="G3588,G1515"\w*, \w que trouxe de volta|strong="G3588,G321"\w* \w dentre os mortos|strong="G1537,G3498"\w* \w o grande|strong="G3588,G3173"\w* \w pastor|strong="G3588,G4166"\w* \w das ovelhas|strong="G3588,G4263"\w*, \w no sangue|strong="G1722,G129"\w* \w de uma aliança|strong="G1242"\w* \w eterna|strong="G166"\w*, \w nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus|strong="G2424"\w*,\f + \fr 13.20: \ft Nota cultural: ecoa Is 63:11 e Zc 9:11.\f*\x - \xo 13:20 \xt ZEC 9:11; ISA 63:11; PHP 1:6; JHN 10:11; PSA 23:1; 1PE 2:25\x*
\v 21 \w os capacite|strong="G2675,G4771"\w* \w em todo bem|strong="G1722,G3956,G18"\w* \w para fazerem|strong="G1519,G3588,G4160"\w* \w a vontade|strong="G3588,G2307"\w* \w dele|strong="G846"\w*, \w realizando|strong="G4160"\w* \w em nós|strong="G1722,G3165"\w* \w o que lhe é agradável|strong="G3588,G2101"\w* \w diante dele|strong="G1799,G846"\w* \w por meio de Jesus|strong="G1223,G2424"\w* \w Cristo|strong="G5547"\w*, \w a quem|strong="G3739"\w* \w seja a glória|strong="G3588,G1391"\w* \w para sempre|strong="G1519,G3588,G165"\w*. \w Amém|strong="G281"\w*.\f + \fr 13.21: \ft Variante: WH e NA28 omitem ἔργῳ (“em toda obra boa”), que Treg e o RP trazem; Treg e o RP trazem ὑμῖν (“em vocês”) em lugar de ἡμῖν; o SBLGNT traz εἰς τοὺς αἰῶνας, seguindo Holmes, e WH, Treg, NA28 e o RP acrescentam τῶν αἰώνων (“para sempre, pelos séculos dos séculos”).\f*\f + \fr 13.21: \ft Acréscimo: verbo ser/estar suprido em “o que lhe é agradável”, “seja a glória”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:21 \xt EPH 2:10; PHP 1:6; PHP 2:13; GAL 1:5; ROM 11:36; EPH 3:21\x*
\v 22 \w Peço-lhes|strong="G3870,G4771"\w*, \w irmãos e irmãs|strong="G80"\w*, \w que suportem|strong="G430"\w* \w a palavra|strong="G3588,G3056"\w* \w de exortação|strong="G3588,G3874"\w*, \w pois|strong="G2532,G1063"\w* \w de modo breve|strong="G1223,G1024"\w* \w lhes escrevi|strong="G1989,G4771"\w*.\x - \xo 13:22 \xt ROM 12:1; 1PE 5:12; JUD 1:3; 1TH 2:11; ACT 13:15; 2CO 8:17\x*
\v 23 \w Saibam|strong="G1097"\w* \w que o nosso irmão|strong="G3588,G80,G3165"\w* \w Timóteo|strong="G5095"\w* \w foi libertado|strong="G630"\w*; \w com ele|strong="G3326,G3739"\w*, \w se|strong="G1437"\w* \w vier|strong="G2064"\w* \w logo|strong="G5032"\w*, \w verei|strong="G3708"\w* \w vocês|strong="G4771"\w*.\x - \xo 13:23 \xt 1TI 6:12; ACT 16:1; 1TH 3:2; PHP 1:1; PHM 1:1\x*
\v 24 \w Saúdem|strong="G782"\w* \w todos os seus líderes|strong="G3956,G3588,G2233,G4771"\w* \w e|strong="G2532"\w* \w todos os santos|strong="G3956,G3588,G40"\w*. \w Os da Itália|strong="G3588,G575,G2482"\w* \w os saúdam|strong="G782,G4771"\w*.\f + \fr 13.24: \ft Lit.: οἱ ἀπὸ τῆς Ἰταλίας, “os da Itália”, que pode significar “os que vivem na Itália” ou “os que vieram da Itália”.\f*\x - \xo 13:24 \xt 1CO 16:20; HEB 13:17; HEB 13:7; 1CO 12:28; 1TI 5:17; ACT 21:7\x*
\v 25 \w A graça|strong="G3588,G5485"\w* \w esteja com|strong="G3326"\w* \w todos|strong="G3956"\w* \w vocês|strong="G4771"\w*.\f + \fr 13.25: \ft Variante: Treg e o RP acrescentam ἀμήν (“amém”), e o TR acrescenta ainda a nota final “Escrita aos hebreus desde a Itália, por meio de Timóteo”.\f*\f + \fr 13.25: \ft Acréscimo: verbo ser/estar suprido em “esteja com”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:25 \xt COL 4:18; 2TI 4:22; 2TI 4:4; EPH 6:24; REV 22:21; ROM 16:20\x*
