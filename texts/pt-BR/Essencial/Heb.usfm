\v 25 \w nem para|strong="G3761,G2443"\w* \w se oferecer|strong="G4374,G1438"\w* \w muitas vezes|strong="G4178"\w*, \w como|strong="G5618"\w* \w o sumo sacerdote|strong="G3588,G749"\w* \w entra|strong="G1525"\w* \w no santuário|strong="G1519,G3588,G39"\w* \w a cada ano|strong="G2596,G1763"\w* \w com sangue|strong="G1722,G129"\w* \w alheio|strong="G245"\w*,\x - \xo 9:25 \xt HEB 9:7; HEB 10:19; HEB 9:12; HEB 9:14; ZEC 9:11; ROM 3:25\x*
