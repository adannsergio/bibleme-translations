\v 22 \w aproximemo-nos|strong="G4334"\w* \w com um coração|strong="G3326,G2588"\w* \w sincero|strong="G228"\w*, \w em plena certeza|strong="G1722,G4136"\w* \w de fé|strong="G4102"\w*, \w tendo o coração|strong="G3588,G2588"\w* \w aspergido|strong="G4472"\w* \add para purificação\add* \w de uma consciência|strong="G575,G4893"\w* \w má|strong="G4190"\w* \w e|strong="G2532"\w* \w tendo o corpo|strong="G3588,G4983"\w* \w lavado|strong="G3068"\w* \w com água|strong="G5204"\w* \w pura|strong="G2513"\w*;\f + \fr 10.22: \ft Acréscimo: “para” (em “coração aspergido para purificação de”): preposição ou artigo que a regência do português exige; “purificação” (em “aspergido para purificação de uma”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 10:22 \xt HEB 11:1; JAS 4:8; EZK 36:25; HEB 4:16; MAT 5:8; JHN 14:6\x*
\v 23 \w mantenhamos firme|strong="G2722"\w* \w a confissão|strong="G3588,G3671"\w* \w da esperança|strong="G3588,G1680"\w* \w sem vacilar|strong="G186"\w*, \w pois|strong="G1063"\w* \w fiel|strong="G4103"\w* \w é aquele que prometeu|strong="G3588,G1861"\w*;\x - \xo 10:23 \xt TIT 1:2; HEB 3:6; HEB 4:16; 1TH 5:24; LAM 3:23; 1CO 1:9\x*
\v 24 \w e|strong="G2532"\w* \w consideremos|strong="G2657"\w* \w uns aos outros|strong="G240"\w* \w para estímulo|strong="G1519,G3948"\w* \w de amor|strong="G26"\w* \w e|strong="G2532"\w* \w de boas|strong="G2570"\w* \w obras|strong="G2041"\w*,\x - \xo 10:24 \xt PRO 27:17; 1TH 5:11; HEB 10:25; EPH 2:10; 1JN 3:18; HEB 13:1\x*
\v 25 \w não abandonando|strong="G3361,G1459"\w* \w a nossa reunião|strong="G3588,G1997,G1438"\w*, \w como|strong="G2531"\w* \w é costume|strong="G1485"\w* \w de alguns|strong="G5100"\w*, \w mas|strong="G235"\w* \w exortando-nos|strong="G3870"\w*, \w e|strong="G2532"\w* \w tanto mais|strong="G5118,G3123"\w* \w quanto|strong="G3745"\w* \w veem|strong="G991"\w* \w aproximar-se|strong="G1448"\w* \w o dia|strong="G3588,G2250"\w*.\f + \fr 10.25: \ft Acréscimo: verbo ser/estar suprido em “é costume”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:25 \xt ACT 2:42; 1TH 5:11; MAT 18:20; HEB 3:13; HEB 10:24; 1CO 5:4\x*
\v 26 \w Pois|strong="G1063"\w*, \w pecando nós|strong="G264,G3165"\w* \w voluntariamente|strong="G1596"\w* \w depois de|strong="G3326"\w* \w receber|strong="G3588,G2983"\w* \w o conhecimento|strong="G3588,G1922"\w* \w da verdade|strong="G3588,G225"\w*, \w já não|strong="G2089,G3756"\w* \w resta|strong="G620"\w* \w sacrifício|strong="G2378"\w* \w pelos pecados|strong="G4012,G266"\w*,\x - \xo 10:26 \xt 1TI 2:4; HEB 6:4; 2PE 2:20; JHN 9:41; 1JN 5:16; LUK 12:47\x*
\v 27 \w mas uma certa|strong="G1161,G5100"\w* \w terrível|strong="G5398"\w* \w expectativa|strong="G1561"\w* \w de juízo|strong="G2920"\w*, \w e|strong="G2532"\w* \w um zelo|strong="G2205"\w* \w de fogo|strong="G4442"\w* \w que está para|strong="G3195"\w* \w devorar|strong="G2068"\w* \w os adversários|strong="G3588,G5227"\w*.\f + \fr 10.27: \ft Nota cultural: ecoa Is 26:11 (LXX).\f*\x - \xo 10:27 \xt ISA 26:11; HEB 6:4; 2PE 2:20; 1JN 5:16; HEB 12:29; JHN 8:24\x*
\v 28 \w Quem|strong="G5100"\w* \w rejeitou|strong="G114"\w* \w a Lei|strong="G3551"\w* \w de Moisés|strong="G3475"\w* \w morre|strong="G599"\w* \w sem compaixão|strong="G5565,G3628"\w* \w com base em dois|strong="G1909,G1417"\w* \w ou|strong="G2228"\w* \w três|strong="G5140"\w* \w testemunhas|strong="G3144"\w*.\f + \fr 10.28: \ft Nota cultural: refere-se a Dt 17:2-6.\f*\x - \xo 10:28 \xt DEU 17:2-6; MAT 18:16; 2CO 13:1; HEB 6:4; 1JN 5:16; HEB 2:3\x*
\v 29 \w De quanto pior|strong="G4214,G5501"\w* \w castigo|strong="G5098"\w*, \w pensam|strong="G1380"\w*, \w será considerado digno|strong="G515"\w* \w aquele que|strong="G3588"\w* \w pisou|strong="G2662"\w* \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w*, \w e|strong="G2532"\w* \w considerou comum|strong="G2839,G2233"\w* \w o sangue|strong="G3588,G129"\w* \w da aliança|strong="G3588,G1242"\w* \w no qual|strong="G1722,G3739"\w* \w foi santificado|strong="G37"\w*, \w e|strong="G2532"\w* \w insultou|strong="G1796"\w* \w o Espírito|strong="G3588,G4151"\w* \w da graça|strong="G3588,G5485"\w*?\x - \xo 10:29 \xt HEB 6:4; MAT 7:6; 1JN 5:16; HEB 6:6; HEB 2:3; 1CO 11:27\x*
\v 30 \w Pois|strong="G1063"\w* \w conhecemos|strong="G6063"\w* \w aquele que disse|strong="G3588,G2036"\w*: “\w A mim|strong="G1473"\w* \w pertence a vingança|strong="G1557"\w*; \w eu|strong="G1473"\w* \w retribuirei|strong="G467"\w*.” \w E|strong="G2532"\w* \w de novo|strong="G3825"\w*: “\w O Senhor|strong="G2962"\w* \w julgará|strong="G2919"\w* \w o seu povo|strong="G3588,G2992,G846"\w*.”\f + \fr 10.30: \ft Nota cultural: citam Dt 32:35-36.\f*\f + \fr 10.30: \ft Variante: o RP e o TR acrescentam λέγει κύριος (“diz o Senhor”) depois de “retribuirei”; o RP traz a ordem κύριος κρινεῖ.\f*\x - \xo 10:30 \xt DEU 32:35; ROM 12:19; 1JN 5:16; NAM 1:2; PSA 50:4; 2CO 5:10\x*
\v 31 \w Terrível é|strong="G5398"\w* \w cair|strong="G3588,G1706"\w* \w nas mãos|strong="G1519,G5495"\w* \w do Deus|strong="G2316"\w* \w vivo|strong="G2198"\w*.\f + \fr 10.31: \ft Acréscimo: verbo ser/estar suprido em “Terrível é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:31 \xt MAT 10:28; LUK 12:5; MAT 16:16; 1JN 5:16; HEB 12:29; ISA 33:14\x*
\p
\v 32 \w Lembrem-se|strong="G363,G1161"\w* \w dos dias|strong="G3588,G2250"\w* \w anteriores|strong="G4386"\w*, \w nos quais|strong="G1722,G3739"\w*, \w tendo sido iluminados|strong="G5461"\w*, \w suportaram|strong="G5278"\w* \w uma grande|strong="G4183"\w* \w luta|strong="G119"\w* \w de sofrimentos|strong="G3804"\w*:\f + \fr 10.32: \ft Lit.: ἄθλησις, “combate, luta” (termo do vocabulário atlético).\f*\x - \xo 10:32 \xt JAS 1:12; EPH 1:18; 2TI 2:3; ROM 12:12; JAS 5:8; HEB 12:4\x*
\v 33 \w por um lado|strong="G3778,G3303"\w*, \w sendo expostos em espetáculo|strong="G2301"\w* \w a insultos|strong="G3680"\w* \w e também|strong="G5037,G2532"\w* \w a tribulações|strong="G2347"\w*; \w por outro|strong="G3778,G1161"\w*, \w tendo se tornado|strong="G1096"\w* \w companheiros|strong="G2844"\w* \w dos que viviam|strong="G3588,G390"\w* \w assim|strong="G3779"\w*.\x - \xo 10:33 \xt HEB 12:2; JAS 5:8; 1CO 4:9; 1TH 2:14; HEB 12:4; DAN 11:32\x*
\v 34 \w Pois|strong="G2532,G1063"\w* \w se compadeceram|strong="G4834"\w* \w dos presos|strong="G3588,G1198"\w*, \w e|strong="G2532"\w* \w aceitaram|strong="G4327"\w* \w com alegria|strong="G3326,G5479"\w* \w o confisco|strong="G3588,G724"\w* \w dos seus bens|strong="G3588,G5225,G4771"\w*, \w sabendo|strong="G1097"\w* \w que têm|strong="G2192"\w* \w para si mesmos|strong="G1438"\w* \w uma melhor|strong="G2908"\w* \w posse|strong="G5223"\w* \w e|strong="G2532"\w* \w duradoura|strong="G3306"\w*.\f + \fr 10.34: \ft Variante: o RP traz δεσμοῖς μου (“das minhas cadeias”) em lugar de “dos presos” e ἑαυτοῖς em lugar de ἑαυτούς; o RP e o TR acrescentam ἐν οὐρανοῖς (“nos céus”) depois de “posse”.\f*\f + \fr 10.34: \ft Tradução: μένουσαν (μένω, G3306) está aqui como “duradoura”; o termo pode ser “permanecer”, “ficar”, “morar”, “continuar” ou “esperar”, e o contexto decide.\f*\x - \xo 10:34 \xt PSA 31:19; JAS 1:2; HEB 13:3; PHP 4:11; PHP 3:20; MAT 6:20\x*
\v 35 \w Não percam|strong="G3361,G577"\w*, \w pois|strong="G3767"\w*, \w a sua ousadia|strong="G3588,G3954,G4771"\w*, \w que tem|strong="G3748,G2192"\w* \w grande|strong="G3173"\w* \w retribuição|strong="G3405"\w*.\x - \xo 10:35 \xt GAL 6:9; PHP 1:6; HEB 12:1; HEB 11:26; 1CO 15:58; 2CH 15:7\x*
\v 36 \w Pois|strong="G1063"\w* \w têm necessidade|strong="G2192,G5532"\w* \w de perseverança|strong="G5281"\w*, \w para que|strong="G2443"\w*, \w tendo feito|strong="G4160"\w* \w a vontade|strong="G3588,G2307"\w* \w de Deus|strong="G3588,G2316"\w*, \w recebam|strong="G2865"\w* \w a promessa|strong="G3588,G1860"\w*.\x - \xo 10:36 \xt GAL 6:9; HEB 12:1; HEB 11:39; ROM 12:12; HAB 2:3; MAT 6:10\x*
\v 37 \w Pois|strong="G1063"\w* \w ainda|strong="G2089"\w*, \w muito pouco|strong="G3398,G3745"\w*, \w o que vem|strong="G3588,G2064"\w* \w virá|strong="G2240"\w*, \w e não|strong="G2532,G3756"\w* \w demorará|strong="G5549"\w*.\f + \fr 10.37: \ft Nota cultural: cita, na forma grega, Hc 2:3-4.\f*\x - \xo 10:37 \xt HAB 2:3; GAL 6:9; HEB 12:1; ISA 8:17; PSA 37:7; JAS 5:7-9\x*
\v 38 \w Mas o meu justo|strong="G3588,G1161,G1342,G3165"\w* \w viverá|strong="G2198"\w* \w pela fé|strong="G1537,G4102"\w*; \w e|strong="G2532"\w* \w se recuar|strong="G1437,G5288"\w*, \w não se agrada|strong="G3756,G2106"\w* \w a minha alma|strong="G3588,G5590,G3165"\w* \w nele|strong="G1722,G846"\w*.\f + \fr 10.38: \ft Variante: o RP omite μου (“meu”) depois de “justo”.\f*\x - \xo 10:38 \xt ROM 1:17; GAL 6:9; HEB 12:1; LUK 9:62; 1CH 28:9; HAB 2:4\x*
\v 39 \w Mas nós|strong="G3165,G1161"\w* \w não|strong="G3756"\w* \w somos|strong="G1510"\w* \w dos que recuam|strong="G5289"\w* \w para a perdição|strong="G1519,G684"\w*, \w mas|strong="G235"\w* \w da fé|strong="G4102"\w* \w para a preservação|strong="G1519,G4047"\w* \w da vida|strong="G5590"\w*.\x - \xo 10:39 \xt GAL 6:9; HEB 12:1; HEB 11:1; 1CH 28:9; ISA 8:17; MRK 16:16\x*
\c 11
\p
\v 1 \w A fé|strong="G4102"\w* \w é|strong="G1510"\w* \w a garantia|strong="G5287"\w* \w das coisas esperadas|strong="G1679"\w*, \w a prova|strong="G1650"\w* \w das realidades|strong="G4229"\w* \w que não se veem|strong="G3756,G991"\w*\f + \fr 11.1: \ft Lit.: ὑπόστασις, “substância, garantia, base firme”; ἔλεγχος, “prova, convicção, demonstração”.\f*.\x - \xo 11:1 \xt ROM 8:24; 2CO 4:18; 2CO 5:7; HEB 10:22; HEB 11:7; 1PE 1:7-8\x*
\v 2 \w Pois|strong="G1063"\w* \w por ela|strong="G1722,G3778"\w* \w receberam testemunho|strong="G3140"\w* \w os antigos|strong="G3588,G4245"\w*.\f + \fr 11.2: \ft Lit.: πρεσβύτεροι, “mais velhos, antigos”, isto é, as gerações antepassadas de Israel.\f*\x - \xo 11:2 \xt 2CO 5:7; JER 6:16; HEB 12:1; 2CO 4:13; HEB 11:39; PHP 4:8\x*
\v 3 \w Pela fé|strong="G4102"\w* \w entendemos|strong="G3539"\w* \w que as eras|strong="G3588,G165"\w* \w foram formadas|strong="G2675"\w* \w pela palavra|strong="G4487"\w* \w de Deus|strong="G2316"\w*, \w de modo que|strong="G1519,G3588"\w* \w o que se vê|strong="G3588,G991"\w* \w não foi feito|strong="G3361,G1096"\w* \w do que aparece|strong="G1537,G5316"\w*.\x - \xo 11:3 \xt 2CO 5:7; GEN 1:1; PSA 33:6; 2PE 3:5; JHN 1:3; ROM 4:17\x*
\p
\v 4 \w Pela fé|strong="G4102"\w* \w Abel|strong="G6"\w* \w ofereceu|strong="G4374"\w* \w a Deus|strong="G3588,G2316"\w* \w um sacrifício maior|strong="G4119,G2378"\w* \w do que Caim|strong="G3844,G2535"\w*, \w pelo qual|strong="G1223,G3739"\w* \w recebeu testemunho|strong="G3140"\w* \w de que era|strong="G1511"\w* \w justo|strong="G1342"\w*, \w dando Deus testemunho|strong="G3140,G3588,G2316"\w* \w sobre os dons|strong="G1909,G3588,G1435"\w* \w dele|strong="G846"\w*; \w e|strong="G2532"\w* \w por meio dela|strong="G1223,G846"\w*, \w tendo morrido|strong="G599"\w*, \w ainda|strong="G2089"\w* \w fala|strong="G2980"\w*.\f + \fr 11.4: \ft Nota cultural: refere-se a Gn 4:3-10.\f*\x - \xo 11:4 \xt GEN 4:3-10; 2CO 5:7; HEB 5:1; GEN 4:4; GEN 4:7; JAS 5:16\x*
\v 5 \w Pela fé|strong="G4102"\w* \w Enoque|strong="G1802"\w* \w foi transferido|strong="G3346"\w*, \w para não ver|strong="G3588,G3361,G1492"\w* \w morte|strong="G2288"\w*, \w e|strong="G2532"\w* \w não foi encontrado|strong="G3756,G2147"\w*, \w porque|strong="G1360"\w* \w o transferiu|strong="G3346,G846"\w* \w Deus|strong="G3588,G2316"\w*; \w pois|strong="G1063"\w*, \w antes|strong="G4253"\w* \w da transferência|strong="G3588,G3331"\w*, \w recebeu testemunho|strong="G3140"\w* \w de ter agradado|strong="G2100"\w* \w a Deus|strong="G3588,G2316"\w*.\f + \fr 11.5: \ft Nota cultural: cita Gn 5:24 na forma da LXX (“não foi encontrado, porque Deus o transferiu”).\f*\x - \xo 11:5 \xt GEN 5:24; 2CO 5:7; GEN 5:21-24; ROM 8:8; HEB 12:1; JUD 1:14\x*
\v 6 \w Sem|strong="G5565"\w* \w fé|strong="G4102"\w* \w é impossível|strong="G102"\w* \w agradar|strong="G2100"\w*; \w pois|strong="G1063"\w* \w é necessário|strong="G1163"\w* \w que o que se aproxima|strong="G3588,G4334"\w* \w de Deus|strong="G3588,G2316"\w* \w creia|strong="G4100"\w* \w que|strong="G3754"\w* \w ele existe|strong="G1510"\w* \w e|strong="G2532"\w* \w que se torna|strong="G1096"\w* \w recompensador|strong="G3406"\w* \w dos que o procuram|strong="G3588,G1567,G846"\w*.\f + \fr 11.6: \ft Acréscimo: verbo ser/estar suprido em “é impossível”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:6 \xt 2CO 5:7; JER 29:13-14; LUK 11:9; MAT 6:33; PRO 8:17; PSA 105:3-4\x*
\v 7 \w Pela fé|strong="G4102"\w* \w Noé|strong="G3575"\w*, \w advertido por Deus|strong="G5537"\w* \w a respeito das coisas|strong="G4012,G3588"\w* \w ainda não vistas|strong="G3369,G991"\w*, \w tomado de temor reverente|strong="G2125"\w*, \w construiu|strong="G2680"\w* \w uma arca|strong="G2787"\w* \w para a salvação|strong="G1519,G4991"\w* \w da sua casa|strong="G3588,G3624,G846"\w*; \w por meio dela|strong="G1223,G3739"\w* \w condenou|strong="G2632"\w* \w o mundo|strong="G3588,G2889"\w* \w e|strong="G2532"\w* \w se tornou|strong="G1096"\w* \w herdeiro|strong="G2818"\w* \w da justiça|strong="G3588,G1343"\w* \w segundo a fé|strong="G2596,G4102"\w*.\x - \xo 11:7 \xt 2CO 5:7; HEB 11:1; 1PE 3:20; ROM 4:13; ROM 1:17; JAS 5:16\x*
\p
\v 8 \w Pela fé|strong="G4102"\w* \w Abraão|strong="G11"\w*, \w quando chamado|strong="G2564"\w*, \w obedeceu|strong="G5219"\w*, \w saindo|strong="G1831"\w* \w para um lugar|strong="G1519,G5117"\w* \w que ia|strong="G3739,G3195"\w* \w receber|strong="G2983"\w* \w como herança|strong="G1519,G2817"\w*; \w e|strong="G2532"\w* \w saiu|strong="G1831"\w*, \w sem saber|strong="G3361,G1987"\w* \w para onde|strong="G4226"\w* \w ia|strong="G2064"\w*.\f + \fr 11.8: \ft Nota cultural: refere-se a Gn 12:1-4.\f*\x - \xo 11:8 \xt GEN 12:1; 2CO 5:7; GEN 15:6; JHN 2:5; ACT 7:2-4; GEN 12:4\x*
\v 9 \w Pela fé|strong="G4102"\w* \w viveu como forasteiro|strong="G3939"\w* \w na terra|strong="G1519,G1093"\w* \w da promessa|strong="G3588,G1860"\w*, \w como em terra alheia|strong="G5613,G245"\w*, \w habitando|strong="G2730"\w* \w em tendas|strong="G1722,G4633"\w* \w com Isaque|strong="G3326,G2464"\w* \w e|strong="G2532"\w* \w Jacó|strong="G2384"\w*, \w co-herdeiros|strong="G3588,G4789"\w* \w da mesma|strong="G3588,G846"\w* \w promessa|strong="G3588,G1860"\w*.\x - \xo 11:9 \xt 2CO 5:7; HEB 12:1; 2CO 4:13; GEN 12:8; GEN 13:18; GEN 26:3\x*
\v 10 \w Pois|strong="G1063"\w* \w esperava|strong="G1551"\w* \w a cidade|strong="G3588,G4172"\w* \w que tem|strong="G2192"\w* \w alicerces|strong="G3588,G2310"\w*, \w cujo|strong="G3739"\w* \w arquiteto|strong="G5079"\w* \w e|strong="G2532"\w* \w construtor|strong="G1217"\w* \w é Deus|strong="G3588,G2316"\w*.\f + \fr 11.10: \ft Acréscimo: verbo ser/estar suprido em “é Deus”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:10 \xt 2CO 5:7; REV 21:14; REV 21:2; HEB 13:14; JHN 14:2; PHP 3:20\x*
\v 11 \w Pela fé|strong="G4102"\w* \w também|strong="G2532"\w* \w a própria|strong="G846"\w* \w Sara|strong="G4564"\w* \w recebeu poder|strong="G1411,G2983"\w* \w para conceber|strong="G1519,G2602,G4690"\w*, \w mesmo|strong="G2532"\w* \w fora da idade própria|strong="G3844,G2540,G2244"\w*, \w porque|strong="G1893"\w* \w considerou fiel|strong="G4103,G2233"\w* \w aquele que prometera|strong="G3588,G1861"\w*.\f + \fr 11.11: \ft Lit.: καταβολὴ σπέρματος, “lançamento de semente”, isto é, concepção.\f*\f + \fr 11.11: \ft Variante: o SBLGNT traz αὐτῇ Σάρρᾳ (dativo, “também à própria Sara”), seguindo Holmes e WH à margem; WH, Treg e o RP trazem αὐτὴ Σάρρα (nominativo), e NA28 acrescenta στεῖρα (“sendo estéril”); o RP e o TR acrescentam ἔτεκεν (“deu à luz”) depois de “idade”.\f*\f + \fr 11.11: \ft Lit.: Com “Sara” no dativo (αὐτῇ Σάρρᾳ), a frase pode ser lida como “a própria Sara recebeu poder” ou como “junto com a própria Sara, Abraão (subentendido) recebeu poder”.\f*\x - \xo 11:11 \xt 2CO 5:7; ROM 9:9; 1CO 10:13; HEB 10:23; ROM 4:20-21; GEN 18:11\x*
\v 12 \w Por isso|strong="G1352"\w* \w também|strong="G2532"\w* \w de um só|strong="G575,G1520"\w* \w nasceram|strong="G1080"\w*, \w e|strong="G2532"\w* \w isso|strong="G3778"\w* \w de um já sem vida|strong="G3499"\w*, \w como as estrelas|strong="G2531,G3588,G798"\w* \w do céu|strong="G3588,G3772"\w* \w em multidão|strong="G3588,G4128"\w* \w e|strong="G2532"\w* \w como a areia|strong="G5613,G3588,G285"\w* \w que está|strong="G3588"\w* \w à beira|strong="G3844,G3588,G5491"\w* \w do mar|strong="G3588,G2281"\w*, \w inumerável|strong="G3588,G382"\w*.\f + \fr 11.12: \ft Nota cultural: ecoa Gn 22:17; νεκρόω, “tornar morto”, aqui a perda da capacidade de gerar.\f*\f + \fr 11.12: \ft Acréscimo: “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 11:12 \xt GEN 22:17; 2CO 5:7; GEN 15:5; ISA 54:1; HEB 12:1; 2CO 4:13\x*
\v 13 \w Na fé|strong="G2596,G4102"\w* \w morreram|strong="G599"\w* \w todos estes|strong="G3778,G3956"\w*, \w sem terem recebido|strong="G3361,G2983"\w* \w as promessas|strong="G3588,G1860"\w*, \w mas|strong="G235"\w* \w tendo-as visto|strong="G846,G1492"\w* \w de longe|strong="G4207"\w* \w e|strong="G2532"\w* \w saudado|strong="G782"\w*, \w e|strong="G2532"\w* \w tendo confessado|strong="G3670"\w* \w que|strong="G3754"\w* \w eram estrangeiros|strong="G3581"\w* \w e|strong="G2532"\w* \w peregrinos|strong="G3927,G1510"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*.\f + \fr 11.13: \ft Nota cultural: cf. Gn 23:4 e 47:9.\f*\f + \fr 11.13: \ft Variante: WH e Treg trazem κομισάμενοι (“tendo recebido”) em lugar de λαβόντες; o TR acrescenta πεισθέντες καί (“persuadidos e”) depois de “de longe”.\f*\f + \fr 11.13: \ft Acréscimo: verbo ser/estar suprido em “eram estrangeiros”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:13 \xt GEN 23:4; GEN 47:9; 2CO 5:7; HEB 11:1; 2CO 4:18; 1PE 2:11\x*
\v 14 \w Pois|strong="G1063"\w* \w os que|strong="G3588"\w* \w dizem|strong="G3004"\w* \w tais coisas|strong="G5108"\w* \w deixam claro|strong="G1718"\w* \w que|strong="G3754"\w* \w procuram|strong="G1934"\w* \w uma pátria|strong="G3968"\w*.\x - \xo 11:14 \xt 2CO 5:7; JHN 14:2; HEB 12:1; 2CO 4:13; JHN 11:25; COL 3:1\x*
\v 15 \w E|strong="G2532"\w* \w se|strong="G1487"\w*, \w de fato|strong="G3303"\w*, \w se lembrassem|strong="G3421"\w* \w daquela|strong="G1565"\w* \w da qual|strong="G575,G3739"\w* \w saíram|strong="G6092"\w*, \w teriam tido|strong="G2192,G302"\w* \w oportunidade|strong="G2540"\w* \w de voltar|strong="G344"\w*;\f + \fr 11.15: \ft Variante: WH, NA28 e o RP trazem o imperfeito ἐμνημόνευον (“se lembravam”) em lugar de μνημονεύουσιν (lido por Treg e pelo SBLGNT); o RP traz ἐξῆλθον em lugar de ἐξέβησαν.\f*\f + \fr 11.15: \ft Tradução: καιρὸν (καιρός, G2540) está aqui como “oportunidade”; o termo pode ser “tempo”, “ocasião”, “momento certo” ou “oportunidade”, e o contexto decide.\f*\x - \xo 11:15 \xt 2CO 5:7; JHN 14:2; HEB 12:1; 2CO 4:13; JHN 11:25; COL 3:1\x*
\v 16 \w mas agora|strong="G3568,G1161"\w* \w anseiam|strong="G3713"\w* \w por uma melhor|strong="G2908"\w*, \w isto é|strong="G3778,G1510"\w*, \w celestial|strong="G2032"\w*; \w por isso|strong="G1352"\w* \w não|strong="G3756"\w* \w se envergonha|strong="G1870"\w* \w deles|strong="G846"\w* \w Deus|strong="G3588,G2316"\w*, \w de ser chamado|strong="G1941"\w* \w Deus|strong="G2316"\w* \w deles|strong="G846"\w*, \w pois|strong="G1063"\w* \w preparou|strong="G2090"\w* \w para eles|strong="G846"\w* \w uma cidade|strong="G4172"\w*.\x - \xo 11:16 \xt 2CO 5:7; 1CO 2:9; HEB 8:10; PSA 91:2; JHN 14:2; REV 21:3\x*
\v 17 \w Pela fé|strong="G4102"\w* \w Abraão|strong="G11"\w*, \w ao ser provado|strong="G3985"\w*, \w ofereceu|strong="G4374"\w* \w Isaque|strong="G3588,G2464"\w*, \w e|strong="G2532"\w* \w aquele que|strong="G3588"\w* \w tinha recebido|strong="G324"\w* \w as promessas|strong="G3588,G1860"\w* \w oferecia|strong="G4374"\w* \w o seu único filho|strong="G3588,G3439"\w*,\f + \fr 11.17: \ft Lit.: μονογενής, “único (de sua espécie), unigênito”; cf. Gn 22:1-14.\f*\x - \xo 11:17 \xt GEN 22:1; 2CO 5:7; MAT 1:2; MRK 11:23; JOB 23:10; JAS 1:12\x*
\v 18 \w a quem|strong="G4314,G3739"\w* \w foi dito|strong="G2980,G3754"\w*: “\w Em Isaque|strong="G1722,G2464"\w* \w será chamada|strong="G2564"\w* \w para você|strong="G4771"\w* \w descendência|strong="G4690"\w*”;\f + \fr 11.18: \ft Nota cultural: cita Gn 21:12.\f*\x - \xo 11:18 \xt GEN 21:12; ROM 9:7; 2CO 5:7; MRK 11:23; HEB 12:1; 2CO 4:13\x*
\v 19 \w tendo raciocinado|strong="G3049"\w* \w que|strong="G3754"\w* \w Deus|strong="G3588,G2316"\w* \w é capaz|strong="G1415"\w* \w de ressuscitar|strong="G1453"\w* \w até dentre os mortos|strong="G2532,G1537,G3498"\w*; \w de onde|strong="G3606"\w* \w também o recuperou|strong="G846,G2532,G2865"\w* \w em figura|strong="G1722,G3850"\w*.\f + \fr 11.19: \ft Lit.: ἐν παραβολῇ, “em figura, em sentido simbólico”.\f*\f + \fr 11.19: \ft Acréscimo: verbo ser/estar suprido em “é capaz”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:19 \xt 2CO 5:7; MRK 11:23; EPH 3:20; ROM 4:21; HEB 12:1; 2CO 4:13\x*
\v 20 \w Pela fé|strong="G4102"\w* \w também|strong="G2532"\w* \w Isaque|strong="G2464"\w* \w abençoou|strong="G2127"\w* \w Jacó|strong="G3588,G2384"\w* \w e|strong="G2532"\w* \w Esaú|strong="G3588,G2269"\w* \w a respeito de coisas|strong="G4012"\w* \w futuras|strong="G3195"\w*.\x - \xo 11:20 \xt 2CO 5:7; LUK 3:34; ROM 9:13; HEB 12:1; 2CO 4:13; GEN 27:4\x*
\v 21 \w Pela fé|strong="G4102"\w* \w Jacó|strong="G2384"\w*, \w ao morrer|strong="G599"\w*, \w abençoou|strong="G2127"\w* \w cada um|strong="G1538"\w* \w dos filhos|strong="G3588,G5207"\w* \w de José|strong="G2501"\w*, \w e|strong="G2532"\w* \w se prostrou|strong="G4352"\w*, \w apoiado|strong="G1909"\w* \w na ponta|strong="G3588,G206"\w* \w do seu cajado|strong="G3588,G4464,G846"\w*.\f + \fr 11.21: \ft Nota cultural: refere-se a Gn 47:31 e 48:1-20 (LXX).\f*\f + \fr 11.21: \ft Tradução: προσεκύνησεν (προσκυνέω, G4352) está aqui como “se prostrou”; o termo pode ser “adorar”, “prostrar-se” ou “prestar homenagem”, e o contexto decide.\f*\x - \xo 11:21 \xt GEN 47:31; GEN 48:1-20; 2CO 5:7; HEB 12:1; 2CO 4:13; GEN 22:18\x*
\v 22 \w Pela fé|strong="G4102"\w* \w José|strong="G2501"\w*, \w ao morrer|strong="G5053"\w*, \w falou|strong="G3421"\w* \w do êxodo|strong="G4012,G3588,G1841"\w* \w dos filhos|strong="G3588,G5207"\w* \w de Israel|strong="G2474"\w* \w e|strong="G2532"\w* \w deu ordens|strong="G1781"\w* \w a respeito|strong="G4012"\w* \w dos seus ossos|strong="G3588,G3747,G846"\w*.\f + \fr 11.22: \ft Nota cultural: cf. Gn 50:24-25.\f*\x - \xo 11:22 \xt GEN 50:24; 2CO 5:7; EXO 13:19; HEB 12:1; 2CO 4:13; JOS 24:32\x*
\v 23 \w Pela fé|strong="G4102"\w* \w Moisés|strong="G3475"\w*, \w ao nascer|strong="G1080"\w*, \w foi escondido|strong="G2928"\w* \w por três meses|strong="G5150"\w* \w pelos seus pais|strong="G5259,G3588,G3962,G846"\w*, \w porque|strong="G1360"\w* \w viram|strong="G1492"\w* \w que a criança|strong="G3588,G3813"\w* \w era bela|strong="G791"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w temeram|strong="G5399"\w* \w o decreto|strong="G3588,G1297"\w* \w do rei|strong="G3588,G935"\w*.\f + \fr 11.23: \ft Nota cultural: cf. Êx 1:22 e 2:2.\f*\f + \fr 11.23: \ft Acréscimo: verbo ser/estar suprido em “era bela”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:23 \xt EXO 2:2; EXO 1:22; 2CO 5:7; ACT 7:20; HEB 12:1; 2CO 4:13\x*
