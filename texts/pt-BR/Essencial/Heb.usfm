\v 26 \w Pois|strong="G1063"\w* \w um sumo sacerdote|strong="G749"\w* \w assim|strong="G5108"\w* \w também|strong="G2532"\w* \w nos convinha|strong="G3165,G4241"\w*: \w santo|strong="G3741"\w*, \w sem maldade|strong="G172"\w*, \w sem mancha|strong="G283"\w*, \w separado|strong="G5563"\w* \w dos pecadores|strong="G575,G3588,G268"\w*, \w e|strong="G2532"\w* \w feito mais alto|strong="G5308,G1096"\w* \w do que os céus|strong="G3588,G3772"\w*;\f + \fr 7.26: \ft Lit.: ὅσιος, “santo, piedoso (fiel a Deus)”; ἄκακος, “sem mal”; ἀμίαντος, “sem mancha, não contaminado”.\f*\x - \xo 7:26 \xt 1JN 2:1; 2CO 5:21; HEB 4:15; HEB 2:18; LEV 1:3; HEB 3:1\x*
\v 27 \w o qual|strong="G3739"\w* \w não|strong="G3756"\w* \w tem|strong="G2192"\w* \w necessidade|strong="G318"\w* \w cada dia|strong="G2596,G2250"\w*, \w como|strong="G5618"\w* \w os sumos sacerdotes|strong="G3588,G749"\w*, \w de oferecer|strong="G399"\w* \w primeiro|strong="G4386"\w* \w sacrifícios|strong="G2378"\w* \w pelos próprios|strong="G5228,G3588,G2398"\w* \w pecados|strong="G266"\w*, \w depois|strong="G1899"\w* \w pelos do povo|strong="G3588,G2992"\w* — \w pois|strong="G1063"\w* \w isto|strong="G3778"\w* \w fez|strong="G4160"\w* \w uma vez por todas|strong="G2178"\w*, \w oferecendo|strong="G399"\w* \w a si mesmo|strong="G1438"\w* —;\x - \xo 7:27 \xt ROM 6:10; HEB 5:1; HEB 10:10; HEB 9:12; HEB 9:14; HEB 9:28\x*
\v 28 \w pois|strong="G1063"\w* \w a Lei|strong="G3588,G3551"\w* \w constitui|strong="G2525"\w* \w seres humanos|strong="G444"\w* \w sumos sacerdotes|strong="G749"\w* \w que têm|strong="G2192"\w* \w fraqueza|strong="G769"\w*; \w mas a palavra|strong="G3588,G3056,G1161"\w* \w do juramento|strong="G3588,G3728"\w* \w posterior à Lei|strong="G3588,G3326,G3551"\w* \add constitui\add* \w um Filho|strong="G5207"\w* \w aperfeiçoado|strong="G5048"\w* \w para sempre|strong="G1519,G3588,G165"\w*.\f + \fr 7.28: \ft Acréscimo: “constitui” (em “à Lei constitui um Filho”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 7:28 \xt HEB 7:21; PSA 110:4; HEB 2:10; HEB 1:2; HEB 5:1-2; HEB 5:2\x*
