\v 9 \w não|strong="G3756"\w* \w como a aliança|strong="G2596,G3588,G1242"\w* \w que fiz|strong="G3739,G4160"\w* \w com os pais|strong="G3588,G3962"\w* \w deles|strong="G846"\w* \w no dia|strong="G1722,G2250"\w* \w em que os tomei|strong="G1949,G3165"\w* \w pela mão|strong="G3588,G5495"\w* \w deles|strong="G846"\w* \w para tirá-los|strong="G1806,G846"\w* \w da terra|strong="G1537,G1093"\w* \w do Egito|strong="G125"\w*; \w porque|strong="G3754"\w* \w eles|strong="G846"\w* \w não|strong="G3756"\w* \w permaneceram|strong="G1696"\w* \w na minha aliança|strong="G1722,G3588,G1242,G3165"\w*, \w e|strong="G2532,G1473"\w* \w não me importei com eles|strong="G272,G846"\w*, \w diz|strong="G3004"\w* \w o Senhor|strong="G2962"\w*.\x - \xo 8:9 \xt ISA 59:21; HEB 10:16; 2CO 5:17; JER 31:31; 2CO 3:6; ISA 43:1\x*
\q1
\v 10 \w Porque|strong="G3754"\w* \w esta é|strong="G3778"\w* \w a aliança|strong="G3588,G1242"\w* \w que farei|strong="G3739,G1303"\w* \w com a casa|strong="G3588,G3624"\w* \w de Israel|strong="G2474"\w* \w depois daqueles|strong="G3326,G1565"\w* \w dias|strong="G3588,G2250"\w*, \w diz|strong="G3004"\w* \w o Senhor|strong="G2962"\w*: \w dando|strong="G1325"\w* \w as minhas leis|strong="G3551,G3165"\w* \w à mente|strong="G1519,G3588,G1271"\w* \w deles|strong="G846"\w*, \w e|strong="G2532"\w* \w sobre os corações|strong="G1909,G2588"\w* \w deles|strong="G846"\w* \w as escreverei|strong="G1924,G846"\w*; \w e|strong="G2532"\w* \w serei|strong="G1510"\w* \w para eles|strong="G846"\w* \w Deus|strong="G1519,G2316"\w*, \w e|strong="G2532"\w* \w eles|strong="G846"\w* \w serão|strong="G1510"\w* \w para mim|strong="G3165"\w* \w povo|strong="G1519,G2992"\w*.\f + \fr 8.10: \ft Acréscimo: verbo ser/estar suprido em “esta é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 8:10 \xt HEB 10:16; 1PE 2:9; 2CO 3:3; 2CO 6:16; DEU 30:6; EZK 11:19-20\x*
\q1
\v 11 \w E|strong="G2532"\w* \w de modo algum|strong="G3756,G3361"\w* \w ensinarão|strong="G1321"\w* \w cada um|strong="G1538"\w* \w ao seu concidadão|strong="G3588,G4177,G846"\w* \w e|strong="G2532"\w* \w cada um|strong="G1538"\w* \w ao seu irmão|strong="G3588,G80,G846"\w*, \w dizendo|strong="G3004"\w*: ‘\w Conheça|strong="G1097"\w* \w o Senhor|strong="G3588,G2962"\w*’; \w porque|strong="G3754"\w* \w todos|strong="G3956"\w* \w me conhecerão|strong="G1492,G3165"\w*, \w do menor|strong="G575,G3398"\w* \w até o maior|strong="G2193,G3173"\w* \w deles|strong="G846"\w*.\x - \xo 8:11 \xt ISA 59:21; ACT 8:10; JHN 6:45; HEB 10:16; 2CO 5:17; JHN 17:3\x*
\q1
\v 12 \w Porque|strong="G3754"\w* \w serei misericordioso|strong="G2436,G1510"\w* \w com as injustiças|strong="G3588,G93"\w* \w deles|strong="G846"\w*, \w e|strong="G2532"\w* \w dos pecados|strong="G3588,G266"\w* \w deles|strong="G846"\w* \w de modo algum|strong="G3756,G3361"\w* \w me lembrarei|strong="G3403"\w* \w mais|strong="G2089"\w*.”\f + \fr 8.12: \ft Variante: o RP e o TR acrescentam καὶ τῶν ἀνομιῶν αὐτῶν (“e das iniquidades deles”) depois de “injustiças deles”.\f*\x - \xo 8:12 \xt HEB 10:17; ISA 43:25; ISA 59:21; HEB 10:16; 2CO 5:17; JHN 17:3\x*
\v 13 \w Ao dizer|strong="G1722,G3588,G3004"\w* “\w Nova|strong="G2537"\w*”, \add tornou\add* \w antiga|strong="G3822"\w* \w a primeira|strong="G3588,G4413"\w*; \w e o que se torna antigo|strong="G3588,G1161,G3822"\w* \w e|strong="G2532"\w* \w envelhece|strong="G1095"\w* \w está perto|strong="G1451"\w* \w do desaparecimento|strong="G854"\w*.\f + \fr 8.13: \ft Acréscimo: “tornou” (em “dizer Nova tornou antiga a”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; verbo ser/estar suprido em “está perto”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 8:13 \xt ISA 59:21; 2CO 5:17; COL 2:14; JER 31:31; HEB 7:18; ISA 54:10\x*
\c 9
\p
\v 1 \w Tinha|strong="G2192"\w*, \w de fato|strong="G3303"\w*, \w pois|strong="G3767"\w*, \w a primeira|strong="G3588,G4413"\w* \add aliança\add* \w ordenanças|strong="G1345"\w* \w de culto|strong="G2999"\w* \w e|strong="G5037"\w* \w o santuário|strong="G3588,G39"\w* \w terreno|strong="G2886"\w*.\f + \fr 9.1: \ft Lit.: δικαίωμα, “ordenança, prescrição”.\f*\f + \fr 9.1: \ft Variante: o SBLGNT lê μὲν οὖν sem καί, seguindo Holmes e WH à margem; WH, Treg, NA28 e o RP acrescentam καί (“também”); o TR acrescenta σκηνή (“tenda”) depois de “primeira”.\f*\f + \fr 9.1: \ft Acréscimo: “aliança” (em “a primeira aliança ordenanças de”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 9:1 \xt EXO 25:8; HEB 9:10; ROM 9:4; HEB 8:2; ISA 24:5; JHN 3:31\x*
\v 2 \w Pois|strong="G1063"\w* \w foi preparada|strong="G2680"\w* \w uma tenda|strong="G4633"\w*, \w a primeira|strong="G3588,G4413"\w*, \w na qual|strong="G1722,G3739"\w* \w o candelabro|strong="G3588,G3087"\w* \w e|strong="G5037,G2532"\w* \w a mesa|strong="G3588,G5132"\w* \w e|strong="G2532"\w* \w a oferta|strong="G3588,G4286"\w* \w dos pães|strong="G3588,G740"\w*, \w que|strong="G3748"\w* \w se chama|strong="G3004"\w* \w Santo|strong="G39"\w*.\f + \fr 9.2: \ft Lit.: πρόθεσις τῶν ἄρτων, “a exposição dos pães” (os pães da presença, Êx 25:30); Ἅγια, “o Santo”, o compartimento anterior ao Santo dos Santos.\f*\x - \xo 9:2 \xt EXO 25:30; EXO 25:8; EXO 40:4; LEV 24:5-8; EXO 25:23; EXO 25:31\x*
\v 3 \w E depois|strong="G3326,G1161"\w* \w do segundo|strong="G3588,G1208"\w* \w véu|strong="G2665"\w*, \w uma tenda|strong="G4633"\w* \w chamada|strong="G3588,G3004"\w* \w Santo|strong="G39"\w* \w dos Santos|strong="G39"\w*,\x - \xo 9:3 \xt HEB 9:8; HEB 6:19; MRK 15:38; HEB 10:20; EXO 26:31; HEB 10:19\x*
\v 4 \w que tinha|strong="G2192"\w* \w um altar de incenso|strong="G2369"\w* \add de\add* \w ouro|strong="G5552"\w*, \w e|strong="G2532"\w* \w a arca|strong="G3588,G2787"\w* \w da aliança|strong="G3588,G1242"\w*, \w coberta|strong="G4028"\w* \w por todos os lados|strong="G3840"\w* \w de ouro|strong="G5553"\w*, \w na qual|strong="G1722,G3739"\w* \w havia uma urna|strong="G4713"\w* \add de\add* \w ouro|strong="G5552"\w* \w que continha|strong="G2192"\w* \w o maná|strong="G3588,G3131"\w*, \w e|strong="G2532"\w* \w a vara|strong="G3588,G4464"\w* \w de Arão|strong="G2"\w* \w que floresceu|strong="G3588,G985"\w*, \w e|strong="G2532"\w* \w as tábuas|strong="G3588,G4109"\w* \w da aliança|strong="G3588,G1242"\w*\f + \fr 9.4: \ft Lit.: θυμιατήριον pode designar o altar de incenso ou o incensário; o texto não precisa onde ficava.\f*;\f + \fr 9.4: \ft Acréscimo: “de” (em “de incenso de ouro e”), “de” (em “uma urna de ouro que”): preposição ou artigo que a regência do português exige.\f*\x - \xo 9:4 \xt NUM 17:10; 1KI 8:9; MRK 15:38; 2CH 5:10; EXO 16:33; EXO 26:33\x*
\v 5 \w e acima|strong="G5231,G1161"\w* \w dela|strong="G846"\w* \w querubins|strong="G5502"\w* \w da glória|strong="G1391"\w* \w cobrindo com sombra|strong="G2683"\w* \w o propiciatório|strong="G3588,G2435"\w*; \w sobre estas coisas|strong="G4012,G3739"\w* \w não|strong="G3756"\w* \w é agora|strong="G1510,G3568"\w* \w o momento de falar|strong="G3004"\w* \w em detalhe|strong="G2596,G3313"\w*.\f + \fr 9.5: \ft Lit.: ἱλαστήριον, “propiciatório”, a tampa da arca, lugar da expiação (Lv 16:14-15).\f*\x - \xo 9:5 \xt LEV 16:14-15; HEB 4:16; MRK 15:38; LEV 16:2; NUM 7:89; ROM 3:25\x*
\v 6 \w E estando estas coisas|strong="G3778,G1161"\w* \w assim|strong="G3779"\w* \w preparadas|strong="G2680"\w*, \w na primeira|strong="G1519,G3588,G4413"\w* \w tenda|strong="G4633"\w*, \w de fato|strong="G3303"\w*, \w entram|strong="G1524"\w* \w continuamente|strong="G1223,G3956"\w* \w os sacerdotes|strong="G3588,G2409"\w*, \w cumprindo|strong="G2005"\w* \w os serviços de culto|strong="G3588,G2999"\w*;\f + \fr 9.6: \ft Acréscimo: verbo ser/estar suprido em “E estando estas coisas”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:6 \xt MRK 15:38; NUM 28:3; LUK 1:9; LUK 23:45; EZK 41:4; EXO 27:21\x*
\v 7 \w mas na segunda|strong="G1519,G1161,G3588,G1208"\w*, \w uma vez|strong="G530"\w* \w por ano|strong="G3588,G1763"\w*, \w somente|strong="G3441"\w* \w o sumo sacerdote|strong="G3588,G749"\w*, \w não sem|strong="G3756,G5565"\w* \w sangue|strong="G129"\w*, \w que oferece|strong="G3739,G4374"\w* \w por si mesmo|strong="G5228,G1438"\w* \w e|strong="G2532"\w* \w pelos pecados de ignorância|strong="G3588,G51"\w* \w do povo|strong="G3588,G2992"\w*;\f + \fr 9.7: \ft Nota cultural: refere-se ao Dia da Expiação (Lv 16); ἀγνόημα, “pecado cometido por ignorância”.\f*\x - \xo 9:7 \xt HEB 9:25; HEB 6:19; LEV 16:15; LEV 16:34; HEB 10:3; MRK 15:38\x*
\v 8 \w com isto|strong="G3778"\w*, \w indicando|strong="G1213"\w* \w o Espírito|strong="G3588,G4151"\w* \w Santo|strong="G3588,G40"\w* \add que ainda\add* \w não|strong="G3380"\w* \w foi manifestado|strong="G5319"\w* \w o caminho|strong="G3588,G3598"\w* \w do santuário|strong="G3588,G39"\w*, \w enquanto|strong="G2089"\w* \w a primeira|strong="G3588,G4413"\w* \w tenda|strong="G4633"\w* \w permanece em pé|strong="G2192,G4714"\w*,\f + \fr 9.8: \ft Acréscimo: “que” (em “Espírito Santo que ainda não”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição; “ainda” (em “Santo que ainda não foi”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 9:8 \xt HEB 9:3; JHN 14:6; HEB 3:7; JHN 14:26; GAL 5:1; LUK 24:44\x*
\v 9 \w a qual|strong="G3748"\w* \w é uma parábola|strong="G3850"\w* \w para o tempo|strong="G1519,G3588,G2540"\w* \w presente|strong="G3588,G1764"\w*, \w segundo o qual|strong="G2596,G3739"\w* \w são oferecidos|strong="G4374"\w* \w dons|strong="G1435"\w* \w e também|strong="G5037,G2532"\w* \w sacrifícios|strong="G2378"\w* \w que não podem|strong="G3361,G1410"\w* \w aperfeiçoar|strong="G5048"\w* \w segundo a consciência|strong="G2596,G4893"\w* \w o que presta culto|strong="G3588,G3000"\w*;\f + \fr 9.9: \ft Lit.: παραβολή, “parábola, símbolo, figura”.\f*\f + \fr 9.9: \ft Acréscimo: verbo ser/estar suprido em “é uma parábola”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:9 \xt HEB 5:1; HEB 9:23; COL 2:17; COL 2:14; GAL 5:1; HEB 13:9\x*
\v 10 \w que tratam somente|strong="G3441"\w* \w de alimentos|strong="G1909,G1033"\w* \w e|strong="G2532"\w* \w bebidas|strong="G4188"\w* \w e|strong="G2532"\w* \w diversas|strong="G1313"\w* \w abluções|strong="G909"\w*, \w ordenanças|strong="G1345"\w* \w da carne|strong="G4561"\w*, \w impostas|strong="G1945"\w* \w até o tempo|strong="G3360,G2540"\w* \w da correção|strong="G1357"\w*.\f + \fr 9.10: \ft Lit.: βαπτισμός, “lavagem, ablução”; διόρθωσις, “correção, reforma”.\f*\x - \xo 9:10 \xt HEB 9:23; COL 2:14; GAL 5:1; JHN 2:6; COL 2:16; HEB 13:9\x*
\p
\v 11 \w Mas Cristo|strong="G5547,G1161"\w*, \w tendo aparecido|strong="G3854"\w* \w como sumo sacerdote|strong="G749"\w* \w dos bens|strong="G3588,G18"\w* \w que vieram a ser|strong="G1096"\w*, \w por meio da maior|strong="G1223,G3588,G3173"\w* \w e|strong="G2532"\w* \w mais perfeita|strong="G5046"\w* \w tenda|strong="G4633"\w*, \w não feita por mãos|strong="G3756,G5499"\w*, \w isto é|strong="G3778,G1510"\w*, \w não|strong="G3756"\w* \w desta|strong="G3778,G3588"\w* \w criação|strong="G2937"\w*,\x - \xo 9:11 \xt JHN 19:30; HEB 9:24; DAN 9:24; HEB 9:23; GAL 5:1; 2CO 5:1\x*
\v 12 \w nem por meio de|strong="G3761,G1223"\w* \w sangue|strong="G129"\w* \w de bodes|strong="G5131"\w* \w e|strong="G2532"\w* \w bezerros|strong="G3448"\w*, \w mas por meio|strong="G1223,G1161"\w* \w do seu próprio|strong="G3588,G2398"\w* \w sangue|strong="G129"\w*, \w entrou|strong="G1525"\w* \w uma vez por todas|strong="G2178"\w* \w no santuário|strong="G1519,G3588,G39"\w*, \w tendo obtido|strong="G2147"\w* \w eterna|strong="G166"\w* \w redenção|strong="G3085"\w*.\x - \xo 9:12 \xt ISA 53:5; GAL 3:13; EPH 1:7; HEB 10:4; HEB 9:14; COL 1:14\x*
\v 13 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w* \w o sangue|strong="G3588,G129"\w* \w de bodes|strong="G5131"\w* \w e|strong="G2532"\w* \w de touros|strong="G5022"\w* \w e|strong="G2532"\w* \w a cinza|strong="G4700"\w* \w de uma novilha|strong="G1151"\w*, \w aspergindo|strong="G4472"\w* \w os contaminados|strong="G3588,G2840"\w*, \w santifica|strong="G37"\w* \w para a pureza|strong="G4314,G3588,G2514"\w* \w da carne|strong="G3588,G4561"\w*,\f + \fr 9.13: \ft Nota cultural: alude ao rito da novilha vermelha de Nm 19.\f*\x - \xo 9:13 \xt HEB 10:4; ISA 53:5; EPH 1:7; JHN 19:30; 1PE 1:19; NUM 19:21\x*
\v 14 \w quanto mais|strong="G4214,G3123"\w* \w o sangue|strong="G3588,G129"\w* \w do Cristo|strong="G3588,G5547"\w*, \w que|strong="G3739"\w*, \w por meio do Espírito|strong="G1223,G4151"\w* \w eterno|strong="G166"\w*, \w se ofereceu|strong="G1438,G4374"\w* \w sem mancha|strong="G299"\w* \w a Deus|strong="G3588,G2316"\w*, \w purificará|strong="G2511"\w* \w a nossa consciência|strong="G3588,G4893,G3165"\w* \w das obras mortas|strong="G575,G3498,G2041"\w* \w para prestar culto|strong="G1519,G3588,G3000"\w* \w ao Deus|strong="G2316"\w* \w vivo|strong="G2198"\w*\f + \fr 9.14: \ft Variante: Treg e o RP trazem ὑμῶν (“a consciência de vocês”) em lugar de ἡμῶν (“a nossa consciência”).\f*\f + \fr 9.14: \ft Lit.: διὰ πνεύματος αἰωνίου, “por meio de um Espírito/espírito eterno”; o grego admite referência ao Espírito Santo ou ao próprio espírito de Cristo.\f*?\x - \xo 9:14 \xt HEB 10:2; ISA 53:5; HEB 10:22; TIT 2:14; REV 1:5; EPH 1:7\x*
\v 15 \w E|strong="G2532"\w* \w por isso|strong="G1223,G3778"\w* \w é mediador|strong="G3316,G1510"\w* \w de uma nova|strong="G2537"\w* \w aliança|strong="G1242"\w*, \w para que|strong="G3704"\w*, \w tendo ocorrido|strong="G1096"\w* \w morte|strong="G2288"\w* \w para redenção|strong="G1519,G629"\w* \w das transgressões|strong="G3588,G3847"\w* \w cometidas sob|strong="G1909,G3588"\w* \w a primeira|strong="G4413"\w* \w aliança|strong="G1242"\w*, \w recebam|strong="G2983"\w* \w a promessa|strong="G3588,G1860"\w* \w os que foram chamados|strong="G3588,G2564"\w* \w da herança|strong="G3588,G2817"\w* \w eterna|strong="G166"\w*.\x - \xo 9:15 \xt ISA 53:5; GAL 3:13; EPH 1:7; MAT 26:28; ROM 3:24; 1TI 2:5\x*
\v 16 \w Pois|strong="G1063"\w* \w onde há|strong="G3699"\w* \w testamento|strong="G1242"\w*, \w é necessário|strong="G318"\w* \w que seja comprovada|strong="G5342"\w* \w a morte|strong="G2288"\w* \w daquele que o fez|strong="G3588,G1303"\w*.\f + \fr 9.16: \ft Lit.: διαθήκη significa “aliança” e também “testamento”; o autor joga com os dois sentidos nos vv. 16-17.\f*\f + \fr 9.16: \ft Acréscimo: verbo ser/estar suprido em “é necessário”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula; “onde há”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 9:16 \xt MAT 26:28; 1CO 11:25; ROM 3:25; MRK 14:24; PSA 50:5; ZEC 9:11\x*
\v 17 \w Pois|strong="G1063"\w* \w um testamento|strong="G1242"\w* \w só tem validade|strong="G949"\w* \w após a morte|strong="G1909,G3498"\w*, \w visto que|strong="G1893"\w* \w de modo algum|strong="G4218,G3361"\w* \w tem vigor|strong="G2480"\w* \w enquanto vive|strong="G3753,G2198"\w* \w o que o fez|strong="G3588,G1303"\w*.\x - \xo 9:17 \xt MAT 26:28; 1CO 11:25; ROM 3:25; GAL 3:15; MRK 14:24; PSA 50:5\x*
\v 18 \w Por isso|strong="G3606"\w* \w nem|strong="G3761"\w* \w a primeira|strong="G3588,G4413"\w* \w foi inaugurada|strong="G1457"\w* \w sem sangue|strong="G5565,G129"\w*.\x - \xo 9:18 \xt MAT 26:28; 1CO 11:25; ROM 3:25; MRK 14:24; PSA 50:5; ZEC 9:11\x*
\v 19 \w Pois|strong="G1063"\w*, \w tendo sido dito|strong="G2980"\w* \w todo mandamento|strong="G3956,G1785"\w* \w segundo a Lei|strong="G2596,G3588,G3551"\w* \w por Moisés|strong="G5259,G3475"\w* \w a todo o povo|strong="G3956,G3588,G2992"\w*, \w tendo tomado|strong="G2983"\w* \w o sangue|strong="G3588,G129"\w* \w dos bezerros|strong="G3588,G3448"\w* \w com água|strong="G3326,G5204"\w* \w e|strong="G2532"\w* \w lã|strong="G2053"\w* \w escarlate|strong="G2847"\w* \w e|strong="G2532"\w* \w hissopo|strong="G5301"\w*, \w aspergiu|strong="G4472"\w* \w tanto|strong="G5037"\w* \w o próprio livro|strong="G846,G3588,G975"\w* \w quanto|strong="G2532"\w* \w todo o povo|strong="G3956,G3588,G2992"\w*,\f + \fr 9.19: \ft Nota cultural: alude à cerimônia de Êx 24:3-8.\f*\x - \xo 9:19 \xt EXO 24:3-8; MAT 26:28; EZK 36:25; PSA 51:7; 1CO 11:25; ROM 3:25\x*
\v 20 \w dizendo|strong="G3004"\w*: “\w Este|strong="G3778"\w* \w é o sangue|strong="G3588,G129"\w* \w da aliança|strong="G3588,G1242"\w* \w que ordenou|strong="G3739,G1781"\w* \w a vocês|strong="G4314,G4771"\w* \w Deus|strong="G3588,G2316"\w*.”\f + \fr 9.20: \ft Nota cultural: cita Êx 24:8.\f*\f + \fr 9.20: \ft Acréscimo: verbo ser/estar suprido em “é o sangue”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:20 \xt EXO 24:8; MAT 26:28; MRK 14:24; HEB 13:20; 1CO 11:25; ROM 3:25\x*
