\p
\v 1 \w E o ponto principal|strong="G2774,G1161"\w* \w do que foi dito|strong="G1909,G3588,G3004"\w*: \w temos|strong="G2192"\w* \w um tal|strong="G5108"\w* \w sumo sacerdote|strong="G749"\w*, \w que se sentou|strong="G3739,G2523"\w* \w à direita|strong="G1722,G1188"\w* \w do trono|strong="G3588,G2362"\w* \w da Majestade|strong="G3588,G3172"\w* \w nos céus|strong="G1722,G3588,G3772"\w*,\x - \xo 8:1 \xt HEB 1:3; REV 3:21; MRK 16:19; PSA 110:1; HEB 12:2; COL 3:1\x*
\v 2 \w ministro|strong="G3011"\w* \w do santuário|strong="G3588,G39"\w* \w e|strong="G2532"\w* \w da tenda|strong="G3588,G4633"\w* \w verdadeira|strong="G3588,G228"\w*, \w que|strong="G3739"\w* \w armou|strong="G4078"\w* \w o Senhor|strong="G3588,G2962"\w*, \w não|strong="G3756"\w* \w um ser humano|strong="G444"\w*.\f + \fr 8.2: \ft Lit.: τὰ ἅγια, “o santuário, o lugar santo”; λειτουργός, “ministro, servidor do culto”.\f*\x - \xo 8:2 \xt HEB 9:24; ROM 8:34; HEB 9:11; EXO 33:7; JHN 2:21; 2CO 5:1\x*
\v 3 \w Pois|strong="G1063"\w* \w todo sumo sacerdote|strong="G3956,G749"\w* \w é constituído|strong="G2525"\w* \w para oferecer|strong="G1519,G3588,G4374"\w* \w dons|strong="G1435"\w* \w e também|strong="G5037,G2532"\w* \w sacrifícios|strong="G2378"\w*; \w por isso|strong="G3606"\w* \w é necessário|strong="G316"\w* \w que também este|strong="G2532,G3778"\w* \w tenha|strong="G2192"\w* \w algo|strong="G5100"\w* \w que ofereça|strong="G3739,G4374"\w*.\f + \fr 8.3: \ft Acréscimo: verbo ser/estar suprido em “é necessário”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 8:3 \xt HEB 5:1; HEB 10:5; EPH 5:2; HEB 2:9; GAL 3:25; HEB 9:14\x*
\v 4 \w Se|strong="G1487"\w* \w de fato|strong="G3303"\w* \w então|strong="G3767"\w* \w estivesse|strong="G1510"\w* \w sobre a terra|strong="G1909,G1093"\w*, \w nem|strong="G3761"\w* \w seria|strong="G302,G1510"\w* \w sacerdote|strong="G2409"\w*, \w havendo|strong="G1510"\w* \w os que oferecem|strong="G3588,G4374"\w* \w conforme a Lei|strong="G2596,G3551"\w* \w os dons|strong="G3588,G1435"\w*,\f + \fr 8.4: \ft Variante: o RP traz γάρ em lugar de οὖν, acrescenta τῶν ἱερέων (“os sacerdotes”) depois de ὄντων e traz τὸν νόμον.\f*\x - \xo 8:4 \xt HEB 5:1; HEB 7:11-15; GAL 3:25; 2CH 26:18-19; EXO 40:15; NUM 16:40\x*
\v 5 — \w os quais|strong="G3748"\w* \w prestam culto|strong="G3000"\w* \w a uma cópia|strong="G5262"\w* \w e|strong="G2532"\w* \w sombra|strong="G4639"\w* \w das coisas celestiais|strong="G3588,G2032"\w*, \w como foi advertido|strong="G2531,G5537"\w* \w Moisés|strong="G3475"\w*, \w quando estava para|strong="G3195"\w* \w construir|strong="G2005"\w* \w a tenda|strong="G3588,G4633"\w*: ‘\w Veja|strong="G3708"\w*’, \w pois|strong="G1063"\w*, \w diz ele|strong="G5346"\w*, ‘\w você fará|strong="G4160"\w* \w todas as coisas|strong="G3956"\w* \w conforme o modelo|strong="G2596,G3588,G5179"\w* \w mostrado|strong="G3588,G1166"\w* \w a você|strong="G4771"\w* \w no monte|strong="G1722,G3588,G3735"\w*’—\f + \fr 8.5: \ft Nota cultural: cita Êx 25:40; χρηματίζω, “ser divinamente avisado”.\f*\x - \xo 8:5 \xt EXO 25:40; COL 2:17; ACT 7:44; HEB 10:1; HEB 9:23; EXO 26:30\x*
\v 6 \w Mas agora|strong="G3570,G1161"\w* \w alcançou|strong="G5177"\w* \w um ministério|strong="G3009"\w* \w mais excelente|strong="G1313"\w*, \w na medida em que|strong="G3745"\w* \w também|strong="G2532"\w* \w é|strong="G1510"\w* \w mediador|strong="G3316"\w* \w de uma melhor|strong="G2908"\w* \w aliança|strong="G1242"\w*, \w que foi estabelecida|strong="G3748,G3549"\w* \w sobre melhores|strong="G1909,G2908"\w* \w promessas|strong="G1860"\w*.\x - \xo 8:6 \xt ISA 59:21; HEB 7:22; HEB 12:24; JER 31:31; 2CO 3:6; GAL 3:16-21\x*
\v 7 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w* \w aquela primeira|strong="G3588,G4413,G1565"\w* \w fosse|strong="G1510"\w* \w irrepreensível|strong="G273"\w*, \w não|strong="G3756"\w* \w se buscaria|strong="G302,G2212"\w* \w lugar|strong="G5117"\w* \w para uma segunda|strong="G1208"\w*.\x - \xo 8:7 \xt ISA 59:21; JER 31:31; 2CO 3:6; HEB 7:11; ISA 54:10; 2PE 1:4\x*
\v 8 \w Pois|strong="G1063"\w*, \w repreendendo-os|strong="G3201,G846"\w*, \w diz|strong="G3004"\w*: “\w Olhem|strong="G2400"\w*, \w vêm|strong="G2064"\w* \w dias|strong="G2250"\w*, \w diz|strong="G3004"\w* \w o Senhor|strong="G2962"\w*, \w e|strong="G2532"\w* \w estabelecerei|strong="G4931"\w* \w sobre a casa|strong="G1909,G3588,G3624"\w* \w de Israel|strong="G2474"\w* \w e|strong="G2532"\w* \w sobre a casa|strong="G1909,G3588,G3624"\w* \w de Judá|strong="G2455"\w* \w uma aliança|strong="G1242"\w* \w nova|strong="G2537"\w*,\f + \fr 8.8: \ft Nota cultural: cita Jr 31:31-34 (38:31-34 na LXX), o oráculo da nova aliança, que continua até 8:12.\f*\x - \xo 8:8 \xt JER 31:31; ISA 59:21; HEB 10:16; 2CO 3:6; ISA 43:1; ISA 54:10\x*
