\v 1 \w Pedro|strong="G4074"\w*, \w apóstolo|strong="G652"\w* \w de Jesus Cristo|strong="G2424,G5547"\w*, \w aos escolhidos|strong="G1588"\w* \w forasteiros|strong="G3927"\w* \w da dispersão|strong="G1290"\w* \w do Ponto|strong="G4195"\w*, \w da Galácia|strong="G1053"\w*, \w da Capadócia|strong="G2587"\w*, \w da Ásia|strong="G773"\w* \w e|strong="G2532"\w* \w da Bitínia|strong="G978"\w*,\f + \fr 1.1: \ft Lit.: Ἀπόστολος, “enviado, apóstolo”; παρεπίδημος, “forasteiro, residente temporário” (cf. πάροικος, 2:11); διασπορά, “dispersão, diáspora” (cf. Tg 1:1).\f*\x - \xo 1:1 \xt JAS 1:1; ACT 2:9; ACT 2:5-11; EPH 2:19; HEB 11:13; 1PE 2:11\x*
\v 2 \w segundo a presciência|strong="G2596,G4268"\w* \w de Deus|strong="G2316"\w* \w Pai|strong="G3962"\w*, \w em santificação|strong="G1722,G38"\w* \w do Espírito|strong="G4151"\w*, \w para obediência|strong="G1519,G5218"\w* \w e|strong="G2532"\w* \w aspersão|strong="G4473"\w* \w do sangue|strong="G129"\w* \w de Jesus Cristo|strong="G2424,G5547"\w*: \w graça|strong="G5485"\w* \w a vocês|strong="G4771"\w* \w e|strong="G2532"\w* \w paz|strong="G1515"\w* \w sejam multiplicadas|strong="G4129"\w*.\f + \fr 1.2: \ft Nota cultural: a “aspersão do sangue” evoca a aliança do Sinai (Êx 24:3-8).\f*\x - \xo 1:2 \xt EXO 24:3-8; ROM 8:29; 2PE 1:2; JUD 1:2; PHP 1:2; 1CO 1:3\x*
\v 3 \w Bendito|strong="G2128"\w* \w o Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w Pai|strong="G3962"\w* \w do nosso|strong="G3588,G3165"\w* \w Senhor|strong="G2962"\w* \w Jesus Cristo|strong="G2424,G5547"\w*, \w aquele que|strong="G3588"\w* \w segundo|strong="G2596,G3588"\w* \w a sua|strong="G846"\w* \w grande|strong="G4183"\w* \w misericórdia|strong="G1656"\w* \w nos fez nascer de novo|strong="G313,G3165"\w* \w para uma esperança|strong="G1519,G1680"\w* \w viva|strong="G2198"\w* \w por meio da ressurreição|strong="G1223,G386"\w* \w de Jesus Cristo|strong="G2424,G5547"\w* \w dentre os mortos|strong="G1537,G3498"\w*,\x - \xo 1:3 \xt 1PE 1:23; EPH 1:3; 1CO 15:13; 1JN 5:4; EPH 2:4; ROM 15:13\x*
\v 4 \w para uma herança|strong="G1519,G2817"\w* \w incorruptível|strong="G862"\w* \w e|strong="G2532"\w* \w imaculada|strong="G283"\w* \w e|strong="G2532"\w* \w que não murcha|strong="G263"\w*, \w guardada|strong="G5083"\w* \w nos céus|strong="G1722,G3772"\w* \w para vocês|strong="G1519,G4771"\w*,\f + \fr 1.4: \ft Variante: parte da tradição traz ἡμᾶς (“para nós”) em lugar de ὑμᾶς (“para vocês”).\f*\x - \xo 1:4 \xt PSA 31:19; LUK 12:32; PHP 3:14; COL 1:5; REV 21:27; HEB 9:15\x*
\v 5 \w os que|strong="G3588"\w* \w pelo poder|strong="G1722,G1411"\w* \w de Deus|strong="G2316"\w* \w são guardados|strong="G5432"\w* \w por meio da fé|strong="G1223,G4102"\w* \w para uma salvação|strong="G1519,G4991"\w* \w pronta|strong="G2092"\w* \w para ser revelada|strong="G601"\w* \w no último tempo|strong="G1722,G2540,G2078"\w*;\x - \xo 1:5 \xt PSA 31:19; ROM 8:18; LUK 12:32; PSA 55:22; PHP 1:6; EPH 2:8\x*
\v 6 \w nisto|strong="G1722,G3739"\w* \w exultam|strong="G21"\w*, \w agora|strong="G737"\w*, \w por pouco tempo|strong="G3641"\w*, \w se for necessário|strong="G1487,G1163"\w*, \w entristecidos|strong="G3076"\w* \w em diversas|strong="G1722,G4164"\w* \w provações|strong="G3986"\w*\f + \fr 1.6: \ft Variante: NA28 e o RP acrescentam “é” (ἐστίν) depois de “necessário”; NA28 traz λυπηθέντας (acusativo) em lugar de λυπηθέντες.\f*\f + \fr 1.6: \ft Lit.: Ἀγαλλιᾶσθε: indicativo (“vocês exultam”) ou imperativo (“exultem”).\f*,\x - \xo 1:6 \xt JAS 1:2; JAS 1:12; 1PE 5:10; 1PE 1:8; ROM 8:18; ZEC 13:9\x*
\v 7 \w para que|strong="G2443"\w* \w a comprovação|strong="G3588,G1383"\w* \w da fé|strong="G3588,G4102"\w* \w de vocês|strong="G4771"\w*, \w mais valiosa|strong="G4186"\w* \w do que o ouro|strong="G5553"\w* \w que perece|strong="G3588,G622"\w* \w mas|strong="G1161"\w* \w provado|strong="G1381"\w* \w por meio do fogo|strong="G1223,G4442"\w*, \w seja achada|strong="G2147"\w* \w para louvor|strong="G1519,G1868"\w* \w e|strong="G2532"\w* \w glória|strong="G1391"\w* \w e|strong="G2532"\w* \w honra|strong="G5092"\w* \w na revelação|strong="G1722,G602"\w* \w de Jesus Cristo|strong="G2424,G5547"\w*;\f + \fr 1.7: \ft Lit.: Δοκίμιον, “comprovação, prova” (cf. Tg 1:3).\f*\f + \fr 1.7: \ft Variante: o RP traz πολὺ τιμιώτερον (“muito mais precioso”) em lugar de πολυτιμότερον e “honra e para glória” (τιμὴν καὶ εἰς δόξαν) em lugar de “glória e honra”.\f*\x - \xo 1:7 \xt JAS 1:3; JAS 1:2; ROM 8:28; JAS 1:12; HEB 11:1; 1PE 5:10\x*
\v 8 \w a quem|strong="G3739"\w*, \w não|strong="G3756"\w* \w tendo visto|strong="G1492"\w*, \w amam|strong="G25"\w*; \w em quem|strong="G1519,G3739"\w*, \w agora|strong="G737"\w* \w não|strong="G3361"\w* \w vendo|strong="G3708"\w*, \w mas|strong="G1161"\w* \w crendo|strong="G4100"\w*, \w exultam|strong="G21"\w* \w com alegria|strong="G5479"\w* \w indizível|strong="G412"\w* \w e|strong="G2532"\w* \w glorificada|strong="G1392"\w*\f + \fr 1.8: \ft Variante: o RP traz εἰδότες (“sabendo”) em lugar de ἰδόντες (“tendo visto”); WH traz ἀγαλλιᾶτε (forma diferente de ἀγαλλιᾶσθε, “exultam”).\f*,\x - \xo 1:8 \xt JHN 20:29; JAS 1:2; JHN 14:15; PSA 37:4; ROM 8:28; JAS 1:12\x*
\v 9 \w alcançando|strong="G2865"\w* \w o fim|strong="G3588,G5056"\w* \w da fé|strong="G3588,G4102"\w* \w de vocês|strong="G4771"\w*, \w a salvação|strong="G4991"\w* \w das almas|strong="G5590"\w*.\f + \fr 1.9: \ft Variante: WH omite “de vocês” (ὑμῶν).\f*\x - \xo 1:9 \xt ROM 6:22; JAS 1:21; 1PE 1:13; GAL 2:16; HEB 10:36; ROM 5:2\x*
\v 10 \w A respeito da qual|strong="G4012,G3739"\w* \w salvação|strong="G4991"\w* \w investigaram|strong="G1567"\w* \w e|strong="G2532"\w* \w examinaram com cuidado|strong="G1830"\w* \w os profetas|strong="G4396"\w* \w que|strong="G3588"\w* \w sobre a graça|strong="G4012,G3588,G5485"\w* \w para vocês|strong="G1519,G4771"\w* \w profetizaram|strong="G4395"\w*,\x - \xo 1:10 \xt MAT 13:17; LUK 10:24; HEB 1:1; JHN 5:39; ACT 17:11; LUK 24:25-27\x*
\v 11 \w investigando|strong="G2045"\w* \w a qual|strong="G1519,G5101"\w* \w ou|strong="G2228"\w* \w que tipo de|strong="G4169"\w* \w tempo|strong="G2540"\w* \w indicava|strong="G1213"\w* \w o Espírito|strong="G3588,G4151"\w* \w de Cristo|strong="G5547"\w* \w que estava neles|strong="G1722,G846"\w*, \w testemunhando de antemão|strong="G4303"\w* \w os sofrimentos|strong="G3588,G3804"\w* \w de Cristo|strong="G1519,G5547"\w* \w e|strong="G2532"\w* \w as glórias|strong="G3588,G1391"\w* \w depois destes|strong="G3326,G3778"\w*\f + \fr 1.11: \ft Lit.: Τὸ πνεῦμα Χριστοῦ, “o Espírito de Cristo”: o Espírito que atuava nos profetas; τὰ εἰς Χριστὸν παθήματα, “os sofrimentos destinados a/para Cristo”; εἰς τίνα ἢ ποῖον καιρόν, “que ou qual tempo” ou “quem ou que tempo”.\f*;\f + \fr 1.11: \ft Acréscimo: “que estava neles”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 1:11 \xt 2PE 1:21; HEB 1:1; JHN 5:39; ACT 17:11; COL 3:16; HEB 12:2\x*
\v 12 \w aos quais|strong="G3739"\w* \w foi revelado|strong="G601"\w* \w que|strong="G3754"\w* \w não|strong="G3756"\w* \w para si mesmos|strong="G1438"\w*, \w para vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w serviam|strong="G1247"\w* \w estas coisas|strong="G846"\w*, \w as quais|strong="G3739"\w* \w agora|strong="G3568"\w* \w foram anunciadas|strong="G312"\w* \w a vocês|strong="G4771"\w* \w por meio|strong="G1223"\w* \w dos que|strong="G3588"\w* \w lhes|strong="G4771"\w* \w anunciaram a boa notícia|strong="G2097"\w* \w com o Espírito|strong="G4151"\w* \w Santo|strong="G40"\w* \w enviado|strong="G649"\w* \w do céu|strong="G575,G3772"\w*, \w para as quais|strong="G1519,G3739"\w* \w desejam|strong="G1937"\w* \w anjos|strong="G32"\w* \w olhar atentamente|strong="G3879"\w*\f + \fr 1.12: \ft Variante: NA28 e o RP acrescentam “em” (ἐν) antes de “Espírito Santo” (“no Espírito Santo”).\f*.\x - \xo 1:12 \xt 1CO 2:9; ZEC 4:6; JHN 14:26; HEB 1:1; ACT 17:11; EPH 3:10\x*
\v 13 \w Por isso|strong="G1352"\w*, \w tendo cingido|strong="G328"\w* \w os lombos|strong="G3588,G3751"\w* \w da mente|strong="G3588,G1271"\w* \w de vocês|strong="G4771"\w*, \w sóbrios|strong="G3525"\w*, \w esperem plenamente|strong="G5049,G1679"\w* \w na graça|strong="G1909,G3588,G5485"\w* \w que lhes é trazida|strong="G5342,G4771"\w* \w na revelação|strong="G1722,G602"\w* \w de Jesus Cristo|strong="G2424,G5547"\w*.\f + \fr 1.13: \ft Lit.: Ἀναζωσάμενοι τὰς ὀσφύας τῆς διανοίας, “tendo cingido os lombos da mente”: imagem de prontidão (arregaçar a túnica); τελείως pode ligar-se a “sóbrios” ou a “esperem”.\f*\x - \xo 1:13 \xt 1PE 5:8; LUK 12:35; 1PE 4:7; EPH 4:23; ROM 8:18; HEB 9:28\x*
\v 14 \w Como filhos|strong="G5613,G5043"\w* \w de obediência|strong="G5218"\w*, \w não se conformando|strong="G3361,G4964"\w* \w aos desejos|strong="G3588,G1939"\w* \w de antes|strong="G4386"\w* \w em sua ignorância|strong="G1722,G3588,G52,G4771"\w*,\x - \xo 1:14 \xt ROM 12:2; 2CO 10:5; 2CO 5:15; JHN 15:16; GAL 5:16; 2TI 2:19\x*
\v 15 \w mas|strong="G235"\w* \w segundo o|strong="G2596,G3588"\w* \w Santo|strong="G40"\w* \w que chamou|strong="G2564"\w* \w vocês|strong="G4771"\w*, \w também|strong="G2532"\w* \w vocês mesmos|strong="G846"\w* \w se tornem|strong="G1096"\w* \w santos|strong="G40"\w* \w em toda|strong="G1722,G3956"\w* \w conduta|strong="G391"\w*;\x - \xo 1:15 \xt 2CO 10:5; 2PE 3:11; MAT 5:48; EPH 5:1; HEB 12:14; 2CO 5:15\x*
\v 16 \w porque|strong="G1360"\w* \w está escrito|strong="G1125"\w*: “\w Serão|strong="G1510"\w* \w santos|strong="G40"\w*, \w porque|strong="G3754"\w* \w eu|strong="G1473"\w* \add sou\add* \w santo|strong="G40"\w*\f + \fr 1.16: \ft Variante: o SBLGNT e WH trazem o segundo “porque” (ὅτι); Treg, NA28 e o RP o omitem; NA27 e o RP acrescentam “sou” (εἰμι) depois de “santo”; o RP traz γίνεσθε (“sejam”) em lugar de ἔσεσθε (“serão”).\f*\f + \fr 1.16: \ft Nota cultural: citação de Lv 19:2 (cf. 11:44-45; 20:7).\f*.”\f + \fr 1.16: \ft Acréscimo: “sou” (em “porque eu sou santo”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 1:16 \xt LEV 11:44; LEV 19:2; LEV 20:7; MAT 5:48; EPH 5:1; HEB 12:14\x*
\v 17 \w E|strong="G2532"\w* \w se|strong="G1487"\w* \w invocam|strong="G1941"\w* \w como Pai|strong="G3962"\w* \w aquele que|strong="G3588"\w*, \w sem acepção de pessoas|strong="G678"\w*, \w julga|strong="G2919"\w* \w segundo|strong="G2596"\w* \w a obra|strong="G3588,G2041"\w* \w de cada um|strong="G1538"\w*, \w vivam|strong="G390"\w* \w com temor|strong="G1722,G5401"\w* \w o tempo|strong="G3588,G5550"\w* \w da estada|strong="G3588,G3940"\w* \w de vocês|strong="G4771"\w*;\x - \xo 1:17 \xt JHN 15:16; 2TI 2:19; ACT 10:34; MAL 1:6; 2CH 19:7; MAT 6:9\x*
\v 18 \w sabendo|strong="G6063"\w* \w que|strong="G3754"\w* \w não|strong="G3756"\w* \w com coisas perecíveis|strong="G5349"\w*, \w prata|strong="G694"\w* \w ou|strong="G2228"\w* \w ouro|strong="G5553"\w*, \w foram resgatados|strong="G3084"\w* \w da vã|strong="G1537,G3588,G3152"\w* \w conduta|strong="G391"\w* \w de vocês|strong="G4771"\w*, \w herdada dos pais|strong="G3970"\w*,\f + \fr 1.18: \ft Lit.: Λυτρόω, “resgatar, libertar mediante resgate” (cf. Mc 10:45; Tt 2:14).\f*\x - \xo 1:18 \xt TIT 2:14; MRK 10:45; ROM 12:2; EPH 1:7; REV 5:9; GAL 3:13\x*
\v 19 \w mas|strong="G235"\w* \w com precioso|strong="G5093"\w* \w sangue|strong="G129"\w* \w como de um cordeiro|strong="G5613,G286"\w* \w sem defeito|strong="G299"\w* \w e|strong="G2532"\w* \w sem mancha|strong="G784"\w*, \w de Cristo|strong="G5547"\w*,\f + \fr 1.19: \ft Nota cultural: a imagem do cordeiro sem defeito ecoa o cordeiro pascal (Êx 12:5) e a oferta sacrificial; cf. Jo 1:29.\f*\x - \xo 1:19 \xt JHN 1:29; EXO 12:5; REV 13:8; EPH 1:7; REV 5:9; 1JN 1:7\x*
\v 20 \w conhecido de antemão|strong="G4267"\w* \w de fato|strong="G3303"\w* \w antes|strong="G4253"\w* \w da fundação|strong="G2602"\w* \w do mundo|strong="G2889"\w*, \w mas manifestado|strong="G5319,G1161"\w* \w no último|strong="G1909,G2078"\w* \w dos tempos|strong="G3588,G5550"\w* \w por causa de vocês|strong="G1223,G4771"\w*,\f + \fr 1.20: \ft Variante: o RP traz o plural ἐσχάτων (“nos últimos”) em lugar de ἐσχάτου (“no último”).\f*\x - \xo 1:20 \xt REV 13:8; ROM 8:29; EPH 1:4; GAL 3:13; ROM 3:25; COL 1:14\x*
\v 21 \w os que por meio dele|strong="G3588,G1223,G846"\w* \w creem|strong="G4103"\w* \w em Deus|strong="G1519,G2316"\w*, \w aquele que|strong="G3588"\w* \w o ressuscitou|strong="G1453,G846"\w* \w dentre os mortos|strong="G1537,G3498"\w* \w e|strong="G2532"\w* \w glória|strong="G1391"\w* \w lhe|strong="G846"\w* \w deu|strong="G1325"\w*, \w de modo que|strong="G5620"\w* \w a fé|strong="G3588,G4102"\w* \w de vocês|strong="G4771"\w* \w e|strong="G2532"\w* \w esperança|strong="G1680"\w* \w sejam|strong="G1511"\w* \w em Deus|strong="G1519,G2316"\w*.\f + \fr 1.21: \ft Variante: o RP traz πιστεύοντας (“que creem”) em lugar de πιστούς (“fiéis, crentes”).\f*\x - \xo 1:21 \xt EPH 1:12; MRK 16:16; JHN 14:6; ROM 10:9; GAL 3:13; JHN 15:16\x*
\v 22 \w Tendo purificado|strong="G48"\w* \w as almas|strong="G3588,G5590"\w* \w de vocês|strong="G4771"\w* \w na obediência|strong="G1722,G3588,G5218"\w* \w à verdade|strong="G3588,G225"\w* \w para um amor fraterno|strong="G1519,G5360"\w* \add sem\add* \w hipocrisia|strong="G505"\w*, \w do coração|strong="G1537,G2588"\w* \w uns aos outros|strong="G240"\w* \w amem|strong="G25"\w* \w intensamente|strong="G1619"\w*\f + \fr 1.22: \ft Variante: o RP acrescenta “por meio do Espírito” (διὰ πνεύματος) depois de “verdade” e, com NA28, “puro” (καθαρᾶς) depois de “do”.\f*,\f + \fr 1.22: \ft Acréscimo: “sem” (em “amor fraterno sem hipocrisia do”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 1:22 \xt ROM 12:10; PSA 51:10; 2TI 1:7; JHN 13:34; MAT 5:8; GAL 5:22\x*
\v 23 \w tendo sido gerados de novo|strong="G313"\w*, \w não|strong="G3756"\w* \w de semente|strong="G1537,G4701"\w* \w corruptível|strong="G5349"\w* \w mas|strong="G235"\w* \w incorruptível|strong="G862"\w*, \w por meio da palavra|strong="G1223,G3056"\w* \w de Deus|strong="G2316"\w* \w viva|strong="G2198"\w* \w e|strong="G2532"\w* \w permanente|strong="G3306"\w*;\f + \fr 1.23: \ft Lit.: Λόγου ζῶντος θεοῦ καὶ μένοντος: “palavra do Deus vivo e permanente” ou “palavra viva e permanente de Deus”.\f*\f + \fr 1.23: \ft Variante: o RP acrescenta “para sempre” (εἰς τὸν αἰῶνα) depois de “permanente”.\f*\x - \xo 1:23 \xt 1PE 1:3; HEB 4:12; HEB 8:10; JHN 3:3; JHN 6:63; JHN 17:17\x*
\v 24 \w porque|strong="G1360"\w* “\w toda|strong="G3956"\w* \w carne|strong="G4561"\w* \w é como|strong="G5613"\w* \w erva|strong="G5528"\w*, \w e|strong="G2532"\w* \w toda|strong="G3956"\w* \w a sua|strong="G846"\w* \w glória|strong="G1391"\w* \w como|strong="G5613"\w* \w flor|strong="G438"\w* \w de erva|strong="G5528"\w*; \w secou|strong="G3583"\w* \w a erva|strong="G3588,G5528"\w*, \w e|strong="G2532"\w* \w a flor|strong="G3588,G438"\w* \w caiu|strong="G1601"\w*;\f + \fr 1.24: \ft Nota cultural: citação de Is 40:6-8 (LXX).\f*\f + \fr 1.24: \ft Variante: o RP traz “do ser humano” (ἀνθρώπου) em lugar de “dela” (αὐτῆς) e acrescenta “dela” (αὐτοῦ) depois de “flor”.\f*\f + \fr 1.24: \ft Acréscimo: verbo ser/estar suprido em “é como”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:24 \xt ISA 40:6; JAS 1:10; JHN 3:3; JAS 1:11; JOB 14:2; JAS 4:14\x*
\v 25 \w mas|strong="G1161"\w* \w a palavra|strong="G3588,G4487"\w* \w do Senhor|strong="G2962"\w* \w permanece|strong="G3306"\w* \w para sempre|strong="G1519,G3588,G165"\w*.” \w Esta|strong="G3778"\w* \w é|strong="G1510"\w* \w a palavra|strong="G3588,G4487"\w* \w que foi anunciada como boa notícia|strong="G3588,G2097"\w* \w a vocês|strong="G1519,G4771"\w*.\x - \xo 1:25 \xt MAT 24:35; 2JN 1:2; 1JN 2:17; JHN 3:3; JHN 14:10; JHN 15:7\x*
\c 2
\p
\v 1 \w Tendo deixado de lado|strong="G659"\w* \w então|strong="G3767"\w* \w toda|strong="G3956"\w* \w maldade|strong="G2549"\w* \w e|strong="G2532"\w* \w todo|strong="G3956"\w* \w engano|strong="G1388"\w* \w e|strong="G2532"\w* \w hipocrisias|strong="G5272"\w* \w e|strong="G2532"\w* \w invejas|strong="G5355"\w* \w e|strong="G2532"\w* \w todas|strong="G3956"\w* \w maledicências|strong="G2636"\w*\f + \fr 2.1: \ft Variante: WH traz o singular ὑπόκρισιν (“hipocrisia”).\f*,\x - \xo 2:1 \xt JAS 1:21; ROM 1:29; COL 3:8; HEB 12:1; EPH 4:22; EPH 4:31\x*
\v 2 \w como recém-nascidos|strong="G5613,G738,G1025"\w*, \w o leite|strong="G3588,G1051"\w* \w racional|strong="G3050"\w* \w sem engano|strong="G97"\w* \w desejem|strong="G1971"\w*, \w para que|strong="G2443"\w* \w nele|strong="G1722,G846"\w* \w cresçam|strong="G837"\w* \w para salvação|strong="G1519,G4991"\w*,\f + \fr 2.2: \ft Lit.: Λογικός, “racional, ligado à palavra/razão”, muitas vezes traduzido por “espiritual”; ἄδολος, “sem engano, puro” (do mesmo radical de δόλος, v. 1).\f*\f + \fr 2.2: \ft Variante: o RP omite “para salvação” (εἰς σωτηρίαν).\f*\x - \xo 2:2 \xt PSA 34:8; MAT 18:3; HEB 5:12; EPH 4:15; 2PE 3:18; 1CO 3:1-2\x*
\v 3 \w se|strong="G1487"\w* \w provaram|strong="G1089"\w* \w que|strong="G3754"\w* \w o Senhor|strong="G3588,G2962"\w* \add é\add* \w bom|strong="G5543"\w*.\f + \fr 2.3: \ft Nota cultural: ecoa Sl 34:8 (33:9 na LXX), “provem e vejam que o Senhor é bom”.\f*\f + \fr 2.3: \ft Variante: o RP traz εἴπερ (“se de fato”) em lugar de εἰ (“se”).\f*\f + \fr 2.3: \ft Acréscimo: “é” (em “o Senhor é bom”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 2:3 \xt PSA 34:8; ROM 12:2; HEB 6:5; PSA 63:5; JHN 3:12; PSA 24:8\x*
\v 4 \w Aproximando-se|strong="G4334"\w* \w dele|strong="G4314,G3739"\w*, \w pedra|strong="G3037"\w* \w viva|strong="G2198"\w*, \w de fato|strong="G3303"\w* \w rejeitada|strong="G593"\w* \w pelos seres humanos|strong="G5259,G444"\w*, \w mas|strong="G1161"\w* \w escolhida|strong="G1588"\w*, \w preciosa|strong="G1784"\w*, \w diante de|strong="G3844"\w* \w Deus|strong="G2316"\w*,\x - \xo 2:4 \xt 1PE 2:6; LUK 20:17; JHN 14:6; PSA 118:22; HEB 4:12; JHN 15:5\x*
\v 5 \w também|strong="G2532"\w* \w vocês mesmos|strong="G846"\w*, \w como pedras|strong="G5613,G3037"\w* \w vivas|strong="G2198"\w*, \w são edificados|strong="G3618"\w* \w como casa|strong="G3624"\w* \w espiritual|strong="G4152"\w* \w para um sacerdócio|strong="G1519,G2406"\w* \w santo|strong="G40"\w*, \w para oferecer|strong="G399"\w* \w sacrifícios|strong="G2378"\w* \w espirituais|strong="G4152"\w* \w agradáveis|strong="G2144"\w* \w a Deus|strong="G2316"\w* \w por meio de|strong="G1223"\w* \w Jesus Cristo|strong="G2424,G5547"\w*;\f + \fr 2.5: \ft Lit.: Οἰκοδομεῖσθε: indicativo (“vocês são edificados”) ou imperativo (“sejam edificados”); ἱεράτευμα, “sacerdócio” (o corpo sacerdotal; também em 2:9); εὐπροσδέκτους, “bem aceitáveis, agradáveis”.\f*\f + \fr 2.5: \ft Variante: o RP omite εἰς (“para”) antes de “sacerdócio”; NA27 e o RP acrescentam o artigo τῷ antes de “Deus”.\f*\x - \xo 2:5 \xt ROM 12:1; 1CO 6:19; 2CO 6:16; 1CO 3:16; PSA 118:22; EPH 2:20\x*
\v 6 \w porque|strong="G1360"\w* \w está contido|strong="G4023"\w* \w na Escritura|strong="G1722,G1124"\w*: “\w Olhem|strong="G2400"\w*, \w ponho|strong="G5087"\w* \w em Sião|strong="G1722,G4622"\w* \w uma pedra|strong="G3037"\w* \w angular|strong="G204"\w* \w escolhida|strong="G1588"\w*, \w preciosa|strong="G1784"\w*, \w e|strong="G2532"\w* \w aquele que crê|strong="G3588,G4100"\w* \w nela|strong="G1909,G846"\w* \w de modo algum|strong="G3756,G3361"\w* \w será envergonhado|strong="G2617"\w*.”\f + \fr 2.6: \ft Lit.: Περιέχει ἐν γραφῇ, “está contido na Escritura” (também “a Escritura contém”).\f*\f + \fr 2.6: \ft Nota cultural: citação de Is 28:16 (LXX).\f*\f + \fr 2.6: \ft Variante: o RP acrescenta o artigo τῇ antes de “Escritura” e, com WH, inverte “escolhida” e “angular”.\f*\x - \xo 2:6 \xt ISA 28:16; ROM 10:11; ISA 45:17; ROM 9:33; 1PE 2:4; PSA 118:22\x*
\v 7 \w Para vocês|strong="G4771"\w* \w que creem|strong="G3588,G4100"\w*, \w então|strong="G3767"\w*, \add é\add* \w a honra|strong="G3588,G5092"\w*; \w para os que não creem|strong="G569"\w*, \w porém|strong="G1161"\w*: “\w a pedra|strong="G3037"\w* \w que|strong="G3739"\w* \w os construtores|strong="G3588,G3618"\w* \w rejeitaram|strong="G593"\w*, \w esta|strong="G3778"\w* \w se tornou|strong="G1096"\w* \w cabeça|strong="G1519,G2776"\w* \w de ângulo|strong="G1137"\w*\f + \fr 2.7: \ft Variante: o RP traz ἀπειθοῦσιν (“aos desobedientes”) em lugar de ἀπιστοῦσιν (“aos que não creem”) e Λίθον (acusativo) em lugar de λίθος.\f*\f + \fr 2.7: \ft Nota cultural: citação de Sl 118:22 (117:22 na LXX).\f*\f + \fr 2.7: \ft Lit.: Ἡ τιμή, “a honra” ou “o valor, o que é precioso”; ἀπιστοῦσιν, “aos que não creem” (o RP traz ἀπειθοῦσιν, “aos que desobedecem”).\f*”,\f + \fr 2.7: \ft Acréscimo: “é” (em “creem então é a honra”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 2:7 \xt PSA 118:22; MRK 12:10; MAT 21:42; LUK 20:17; ACT 4:11; ISA 28:16\x*
\v 8 \w e|strong="G2532"\w* \w pedra|strong="G3037"\w* \w de tropeço|strong="G4348"\w* \w e|strong="G2532"\w* \w rocha|strong="G4073"\w* \w de escândalo|strong="G4625"\w*; \w os quais|strong="G3739"\w* \w tropeçam|strong="G4350"\w* \w na palavra|strong="G3588,G3056"\w* \w desobedecendo|strong="G544"\w*; \w para o que|strong="G1519,G3739"\w* \w também|strong="G2532"\w* \w foram postos|strong="G5087"\w*.\f + \fr 2.8: \ft Lit.: Προσκόπτουσιν τῷ λόγῳ ἀπειθοῦντες: “tropeçam, desobedecendo à palavra” ou “tropeçam na palavra, desobedecendo”.\f*\f + \fr 2.8: \ft Nota cultural: ecoa Is 8:14 (pedra de tropeço, rocha de escândalo).\f*\x - \xo 2:8 \xt ISA 8:14; ROM 9:33; ROM 9:32; ISA 28:16; PSA 118:22; PRO 19:21\x*
\v 9 \w Vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \add são\add* \w raça|strong="G1085"\w* \w escolhida|strong="G1588"\w*, \w sacerdócio|strong="G2406"\w* \w real|strong="G934"\w*, \w nação|strong="G1484"\w* \w santa|strong="G40"\w*, \w povo|strong="G2992"\w* \w para ser propriedade|strong="G1519,G4047"\w* \add de Deus,\add* \w para que|strong="G3704"\w* \w proclamem|strong="G1804"\w* \w as excelências|strong="G3588,G703"\w* \w daquele que|strong="G3588"\w* \w chamou|strong="G2564"\w* \w vocês|strong="G4771"\w* \w das trevas|strong="G1537,G4655"\w* \w para a sua|strong="G1519,G3588,G846"\w* \w maravilhosa|strong="G2298"\w* \w luz|strong="G5457"\w*\f + \fr 2.9: \ft Lit.: Λαὸς εἰς περιποίησιν, “povo para posse”: povo que Deus adquiriu para si, propriedade exclusiva.\f*\f + \fr 2.9: \ft Nota cultural: ecoa Êx 19:5-6 e Is 43:20-21 (povo escolhido, reino de sacerdotes, nação santa).\f*;\f + \fr 2.9: \ft Acréscimo: “são” (em “Vocês porém são raça escolhida”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige; “de” (em “ser propriedade de Deus para”): preposição ou artigo que a regência do português exige; “Deus” (em “propriedade de Deus para que”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; verbo ser/estar suprido em “para ser propriedade”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:9 \xt EXO 19:5-6; ISA 43:20; DEU 7:6; HEB 8:10; ISA 61:6; REV 1:6\x*
\v 10 \w vocês que|strong="G3739"\w* \w outrora|strong="G4218"\w* \w não|strong="G3756"\w* \add eram\add* \w povo|strong="G2992"\w*, \w agora|strong="G3568"\w*, \w porém|strong="G1161"\w*, \add são\add* \w povo|strong="G2992"\w* \w de Deus|strong="G2316"\w*, \w os que não|strong="G3588,G3756"\w* \w tinham recebido misericórdia|strong="G1653"\w*, \w agora|strong="G3568"\w*, \w porém|strong="G1161"\w*, \w receberam misericórdia|strong="G1653"\w*\f + \fr 2.10: \ft Nota cultural: ecoa Os 1:6, 9 e 2:23 (“não-povo” e “sem misericórdia”, restaurados).\f*.\f + \fr 2.10: \ft Acréscimo: “eram” (em “outrora não eram povo agora”), “são” (em “agora porém são povo de”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 2:10 \xt HOS 1:6; ROM 12:1; ROM 11:30; EPH 5:8; HOS 2:23; 2CO 6:14\x*
\v 11 \w Amados|strong="G27"\w*, \w exorto|strong="G3870"\w* \add vocês,\add* \w como estrangeiros residentes|strong="G5613,G3941"\w* \w e forasteiros|strong="G2532,G3927"\w*: \w abstenham-se|strong="G568"\w* \w dos desejos|strong="G3588,G1939"\w* \w carnais|strong="G4559"\w*, \w os quais|strong="G3748"\w* \w guerreiam|strong="G4754"\w* \w contra a alma|strong="G2596,G3588,G5590"\w*;\f + \fr 2.11: \ft Acréscimo: “vocês” (em “Amados exorto vocês como estrangeiros”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 2:11 \xt ROM 12:1; 2TI 2:22; 2CO 7:1; GAL 5:16; PHP 2:12; 1JN 2:15-17\x*
\v 12 \w mantendo|strong="G2192"\w* \w boa|strong="G2570"\w* \w a conduta|strong="G3588,G391"\w* \w de vocês|strong="G4771"\w* \w entre os gentios|strong="G1722,G3588,G1484"\w*, \w para que|strong="G2443"\w*, \w naquilo em que|strong="G1722,G3739"\w* \w falam mal|strong="G2635"\w* \w de vocês|strong="G4771"\w* \w como de malfeitores|strong="G5613,G2555"\w*, \w por causa das boas|strong="G1537,G3588,G2570"\w* \w obras|strong="G2041"\w* \w que observam|strong="G2029"\w*, \w glorifiquem|strong="G1392"\w* \w a Deus|strong="G3588,G2316"\w* \w no dia|strong="G1722,G2250"\w* \w da visitação|strong="G1984"\w*.\f + \fr 2.12: \ft Lit.: Ἡμέρα ἐπισκοπῆς, “dia da visita/inspeção”: o dia em que Deus intervém (para salvar ou julgar); ἐποπτεύω, “observar de perto”.\f*\f + \fr 2.12: \ft Variante: o RP traz “mantendo boa a conduta entre os gentios” em outra ordem e ἐποπτεύσαντες (“tendo observado”) em lugar de ἐποπτεύοντες (“observando”).\f*\x - \xo 2:12 \xt MAT 5:16; ROM 12:1; 1PE 3:2; PHP 4:8; 1PE 3:16; EPH 2:10\x*
\v 13 \w Submetam-se|strong="G5293"\w* \w a toda|strong="G3956"\w* \w criação|strong="G2937"\w* \w humana|strong="G442"\w* \w por causa do|strong="G1223,G3588"\w* \w Senhor|strong="G2962"\w*: \w seja|strong="G1535"\w* \w ao rei|strong="G935"\w* \w como|strong="G5613"\w* \w soberano|strong="G5242"\w*,\f + \fr 2.13: \ft Lit.: Ἀνθρωπίνη κτίσις, “criação humana”: instituição ou autoridade estabelecida por seres humanos (ou, em outra leitura, “criatura humana”).\f*\f + \fr 2.13: \ft Variante: o RP acrescenta “então” (οὖν) depois de “Submetam-se”.\f*\f + \fr 2.13: \ft Acréscimo: verbo ser/estar suprido em “seja”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:13 \xt ROM 13:1; COL 3:23; TIT 3:1; 1TI 2:1-2; ROM 13:2; LUK 20:25\x*
\v 14 \w seja|strong="G1535"\w* \w a governadores|strong="G2232"\w* \w como|strong="G5613"\w* \w por ele|strong="G1223,G846"\w* \w enviados|strong="G3992"\w* \w para castigo|strong="G1519,G1557"\w* \w de malfeitores|strong="G2555"\w* \w e louvor|strong="G1868"\w* \w de quem faz o bem|strong="G17"\w*;\f + \fr 2.14: \ft Acréscimo: verbo ser/estar suprido em “seja”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:14 \xt ROM 13:1; ROM 13:3; TIT 3:1; JER 29:7; MAT 28:20; MAT 22:21\x*
\v 15 (\w porque|strong="G3754"\w* \w assim|strong="G3779"\w* \w é|strong="G1510"\w* \w a vontade|strong="G3588,G2307"\w* \w de Deus|strong="G3588,G2316"\w*, \w que, fazendo o bem|strong="G15"\w*, \w silenciem|strong="G5392"\w* \w a ignorância|strong="G3588,G56"\w* \w dos seres humanos|strong="G3588,G444"\w* \w insensatos|strong="G878"\w*);\x - \xo 2:15 \xt GAL 6:9; COL 3:23; 1PE 3:17; ROM 13:1; 1TH 5:18; MAT 6:10\x*
\v 16 \w como livres|strong="G5613,G1658"\w*, \w e|strong="G2532"\w* \w não|strong="G3361"\w* \w usando|strong="G2192"\w* \w a liberdade|strong="G3588,G1657"\w* \w como cobertura|strong="G5613,G1942"\w* \w da maldade|strong="G3588,G2549"\w*, \w mas|strong="G235"\w* \w como|strong="G5613"\w* \w servos|strong="G1401"\w* \w de Deus|strong="G2316"\w*.\f + \fr 2.16: \ft Tradução: δοῦλοι (δοῦλος, G1401) está aqui como “servos”; o termo pode ser “escravo” (condição social), “servo” ou “servidor”, e o contexto decide.\f*\x - \xo 2:16 \xt GAL 5:1; GAL 5:13; 1CO 7:22; ROM 13:1; 2PE 2:19; JHN 8:32\x*
\v 17 \w A todos|strong="G3956"\w* \w honrem|strong="G5091"\w*, \w a irmandade|strong="G3588,G81"\w* \w amem|strong="G25"\w*, \w a Deus|strong="G3588,G2316"\w* \w temam|strong="G5399"\w*, \w ao rei|strong="G3588,G935"\w* \w honrem|strong="G5091"\w*.\f + \fr 2.17: \ft Variante: o RP traz o aoristo ἀγαπήσατε (“amem”) em lugar do presente ἀγαπᾶτε.\f*\x - \xo 2:17 \xt ROM 13:1; MAL 1:6; ECC 12:13; ROM 12:10; PRO 24:21; ROM 13:7\x*
\v 18 \w Os escravos domésticos|strong="G3588,G3610"\w*, \w submetendo-se|strong="G5293"\w* \w em todo|strong="G1722,G3956"\w* \w temor|strong="G5401"\w* \w aos senhores|strong="G3588,G1203"\w*, \w não|strong="G3756"\w* \w somente|strong="G3441"\w* \w aos bons|strong="G3588,G18"\w* \w e|strong="G2532"\w* \w amáveis|strong="G1933"\w* \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w aos duros|strong="G3588,G4646"\w*.\f + \fr 2.18: \ft Lit.: Οἰκέτης, “escravo doméstico”; δεσπότης, “senhor, dono”; σκολιός, “torto, retorcido”, isto é, duro, injusto.\f*\x - \xo 2:18 \xt MAL 1:6; EPH 6:5; ROM 13:7; TIT 2:9; 1TI 6:1; COL 3:22\x*
\v 19 \w Pois|strong="G1063"\w* \w isto|strong="G3778"\w* \w é graça|strong="G5485"\w*, \w se|strong="G1487"\w* \w alguém|strong="G5100"\w*, \w por causa da consciência|strong="G1223,G4893"\w* \w de Deus|strong="G2316"\w*, \w suporta|strong="G5297"\w* \w dores|strong="G3077"\w*, \w sofrendo|strong="G3958"\w* \w injustamente|strong="G95"\w*\f + \fr 2.19: \ft Lit.: Χάρις, “graça, mérito, o que é agradável (a Deus)”; συνείδησις θεοῦ, “consciência de Deus”: a consciência que se tem diante de Deus, ou o saber-se diante de Deus.\f*;\f + \fr 2.19: \ft Acréscimo: verbo ser/estar suprido em “é graça”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:19 \xt MAL 1:6; ROM 12:12; 1PE 3:14; EPH 6:5; 1CO 6:7; 1PE 2:20\x*
\v 20 \w pois|strong="G1063"\w* \w que glória|strong="G4169,G2811"\w* \add há,\add* \w se|strong="G1487"\w*, \w pecando|strong="G264"\w* \w e|strong="G2532"\w* \w sendo esbofeteados|strong="G2852"\w*, \add vocês\add* \w suportarem|strong="G5278"\w*? \w Mas|strong="G235"\w* \w se|strong="G1487"\w*, \w fazendo o bem|strong="G15"\w* \w e|strong="G2532"\w* \w sofrendo|strong="G3958"\w*, \add vocês\add* \w suportarem|strong="G5278"\w*, \w isto|strong="G3778"\w* \w é graça|strong="G5485"\w* \w diante de|strong="G3844"\w* \w Deus|strong="G2316"\w*.\f + \fr 2.20: \ft Acréscimo: “há” (em “que glória há se pecando”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige; “vocês” (em “sendo esbofeteados vocês suportarem Mas”), “vocês” (em “e sofrendo vocês suportarem isto”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo; verbo ser/estar suprido em “é graça”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:20 \xt 1PE 3:17; LUK 6:32; LUK 6:33; LUK 23:34; ROM 12:1; ROM 12:12\x*
\v 21 \w Pois|strong="G1063"\w* \w para isto|strong="G1519,G3778"\w* \w foram chamados|strong="G2564"\w*, \w porque|strong="G3754"\w* \w também|strong="G2532"\w* \w Cristo|strong="G5547"\w* \w sofreu|strong="G3958"\w* \w em favor|strong="G5228"\w* \w de vocês|strong="G4771"\w*, \w deixando|strong="G5277"\w* \w a vocês|strong="G4771"\w* \w um modelo|strong="G5261"\w*, \w para que|strong="G2443"\w* \w sigam|strong="G1872"\w* \w as pegadas|strong="G3588,G2487"\w* \w dele|strong="G846"\w*;\f + \fr 2.21: \ft Lit.: Ὑπογραμμός, “modelo para copiar” (o traçado que o aluno reescreve); ἴχνος, “pegada, rastro”.\f*\f + \fr 2.21: \ft Variante: o RP traz “por nós” (ἡμῶν) em lugar de “por vocês” (ὑμῶν).\f*\x - \xo 2:21 \xt PHP 2:5; LUK 23:34; 1JN 2:6; ACT 8:32; 2PE 1:3; COL 3:13\x*
\v 22 \w o qual|strong="G3739"\w* \w não|strong="G3756"\w* \w cometeu|strong="G4160"\w* \w pecado|strong="G266"\w*, \w nem|strong="G3761"\w* \w foi achado|strong="G2147"\w* \w engano|strong="G1388"\w* \w na boca|strong="G1722,G3588,G4750"\w* \w dele|strong="G846"\w*\f + \fr 2.22: \ft Nota cultural: ecoa Is 53:9 (LXX).\f*;\x - \xo 2:22 \xt ISA 53:9; 2CO 5:21; REV 14:5; LUK 23:34; ACT 8:32; 1PE 1:19\x*
\v 23 \w o qual|strong="G3739"\w*, \w sendo insultado|strong="G3058"\w*, \w não|strong="G3756"\w* \w respondia com insulto|strong="G486"\w*, \w sofrendo|strong="G3958"\w* \w não|strong="G3756"\w* \w ameaçava|strong="G546"\w*, \w entregava|strong="G3860"\w*, \w porém|strong="G1161"\w*, \w àquele que julga|strong="G3588,G2919"\w* \w justamente|strong="G1346"\w*;\x - \xo 2:23 \xt 2CO 5:21; PRO 20:22; HEB 12:2; LUK 23:34; ACT 8:32; MAT 5:44\x*
\v 24 \w o qual|strong="G3739"\w* \w ele mesmo|strong="G846"\w* \w carregou|strong="G399"\w* \w os nossos|strong="G3588,G3165"\w* \w pecados|strong="G266"\w* \w no corpo|strong="G1722,G3588,G4983"\w* \w dele|strong="G846"\w* \w sobre o madeiro|strong="G1909,G3588,G3586"\w*, \w para que|strong="G2443"\w*, \w tendo morrido|strong="G581"\w* \w para os pecados|strong="G3588,G266"\w*, \w vivamos|strong="G2198"\w* \w para a justiça|strong="G3588,G1343"\w*; \w por cujo|strong="G3739"\w* \w ferimento|strong="G3588,G3468"\w* \w foram curados|strong="G2390"\w*\f + \fr 2.24: \ft Variante: o RP acrescenta “dele” (αὐτοῦ) depois de “ferimento”.\f*\f + \fr 2.24: \ft Nota cultural: ecoa Is 53:4-5, 12 (LXX).\f*\f + \fr 2.24: \ft Lit.: Ξύλον, “madeiro, árvore”: a cruz (cf. At 5:30; Gl 3:13); μώλωψ, “ferida, vergão”.\f*.\x - \xo 2:24 \xt ISA 53:4; GAL 3:13; ACT 5:30; 2CO 5:21; ISA 53:5; MAT 8:17\x*
\v 25 \w Pois|strong="G1063"\w* \w eram|strong="G1510"\w* \w como ovelhas|strong="G5613,G4263"\w* \w desgarradas|strong="G4105"\w*, \w mas|strong="G235"\w* \w voltaram|strong="G1994"\w* \w agora|strong="G3568"\w* \w ao pastor|strong="G1909,G3588,G4166"\w* \w e|strong="G2532"\w* \w supervisor|strong="G1985"\w* \w das almas|strong="G3588,G5590"\w* \w de vocês|strong="G4771"\w*.\f + \fr 2.25: \ft Lit.: Ἐπίσκοπος, “supervisor, guardião” (cf. 1Tm 3:1); ποιμήν, “pastor”.\f*\f + \fr 2.25: \ft Variante: o RP traz πλανώμενα (neutro, “desgarradas”) em lugar de πλανώμενοι.\f*\x - \xo 2:25 \xt 1TI 3:1; JHN 10:11; ISA 53:5; ISA 53:6; PSA 23:1; HEB 13:20\x*
\c 3
\p
\v 1 \w Da mesma forma|strong="G3668"\w*, \w esposas|strong="G1135"\w*, \w submetendo-se|strong="G5293"\w* \w aos próprios|strong="G3588,G2398"\w* \w maridos|strong="G435"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w se alguns|strong="G1487,G5100"\w* \w desobedecem|strong="G544"\w* \w à palavra|strong="G3588,G3056"\w*, \w pela conduta|strong="G1223,G3588,G391"\w* \w das esposas|strong="G3588,G1135"\w* \w sem palavra|strong="G427,G3056"\w* \w sejam ganhos|strong="G2770"\w*,\f + \fr 3.1: \ft Lit.: Γυναῖκες, “mulheres, esposas” (aqui, as casadas); ἄνδρες, “homens, maridos” (v. 7); ἀπειθέω, “desobedecer, não crer”.\f*\f + \fr 3.1: \ft Variante: NA28 e o RP acrescentam o artigo αἱ diante de “esposas”; WH omite “também” (καί).\f*\x - \xo 3:1 \xt EPH 5:22; COL 3:18; PRO 31:11; GEN 2:24; EPH 5:33; 1CO 11:3\x*
\v 2 \w tendo observado|strong="G2029"\w* \w a conduta|strong="G3588,G391"\w* \w pura|strong="G53"\w* \w de vocês|strong="G4771"\w* \w em temor|strong="G1722,G5401"\w*.\x - \xo 3:2 \xt 1PE 2:12; PRO 31:11; 1PE 3:15; EPH 5:22; GEN 2:24; 1CO 14:34\x*
\v 3 \w Que o adorno|strong="G3588,G2889"\w* \w de vocês|strong="G3739"\w* \w não|strong="G3756"\w* \w seja|strong="G1510"\w* \w o exterior|strong="G1855"\w*: \w trançados|strong="G1708"\w* \w de cabelos|strong="G2359"\w* \w e|strong="G2532"\w* \w colocação|strong="G4025"\w* \w de joias de ouro|strong="G5553"\w* \w ou|strong="G2228"\w* \w vestimenta|strong="G1745"\w* \w de roupas|strong="G2440"\w*,\f + \fr 3.3: \ft Lit.: Κόσμος, “adorno, ornamento” (e também “mundo”).\f*\x - \xo 3:3 \xt PRO 31:11; 1TI 2:9; EPH 5:22; GEN 2:24; 1PE 5:5; ROM 12:2\x*
\v 4 \w mas|strong="G235"\w* \w o ser humano|strong="G3588,G444"\w* \w escondido|strong="G2927"\w* \w do coração|strong="G3588,G2588"\w*, \w no incorruptível|strong="G1722,G3588,G862"\w* \w de um espírito|strong="G3588,G4151"\w* \w manso|strong="G4235"\w* \w e|strong="G2532"\w* \w tranquilo|strong="G2272"\w*, \w que é|strong="G3739,G1510"\w* \w diante de|strong="G1799"\w* \w Deus|strong="G3588,G2316"\w* \w muito precioso|strong="G4185"\w*.\f + \fr 3.4: \ft Lit.: Ὁ κρυπτὸς τῆς καρδίας ἄνθρωπος, “o ser humano oculto do coração”: o eu interior; ἀφθάρτῳ, “no incorruptível”, isto é, na qualidade imperecível de um espírito manso e tranquilo.\f*\x - \xo 3:4 \xt 1SA 16:7; PRO 31:30; PRO 31:11; COL 3:12; EPH 5:22; GEN 2:24\x*
\v 5 \w Pois|strong="G1063"\w* \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w outrora|strong="G4218"\w* \w as santas|strong="G3588,G40"\w* \w mulheres|strong="G1135"\w*, \w as que esperavam|strong="G3588,G1679"\w* \w em Deus|strong="G1519,G2316"\w*, \w se enfeitavam|strong="G2885,G1438"\w*, \w submetendo-se|strong="G5293"\w* \w aos próprios|strong="G3588,G2398"\w* \w maridos|strong="G435"\w*,\f + \fr 3.5: \ft Variante: o RP traz ἐπί (“em”) em lugar de εἰς (“em”) antes de “Deus”.\f*\x - \xo 3:5 \xt EPH 5:22; COL 3:18; EPH 5:24; PRO 31:30; PRO 31:11; GEN 2:24\x*
\v 6 \w como|strong="G5613"\w* \w Sara|strong="G4564"\w* \w obedeceu|strong="G5219"\w* \w a Abraão|strong="G3588,G11"\w*, \w chamando-o|strong="G846,G2564"\w* \w de senhor|strong="G2962"\w*; \w de quem|strong="G3739"\w* \w se tornaram|strong="G1096"\w* \w filhas|strong="G5043"\w* \w fazendo o bem|strong="G15"\w* \w e|strong="G2532"\w* \w não|strong="G3361"\w* \w temendo|strong="G5399"\w* \w nenhum|strong="G3367"\w* \w terror|strong="G4423"\w*.\f + \fr 3.6: \ft Nota cultural: cf. Gn 18:12 (Sara chama Abraão de “meu senhor”).\f*\x - \xo 3:6 \xt GEN 18:12; ROM 9:7; PRO 31:11; EPH 5:22; GEN 2:24; 1CO 14:34\x*
\v 7 \w Os|strong="G3588"\w* \w maridos|strong="G435"\w*, \w da mesma forma|strong="G3668"\w*, \w convivam|strong="G4924"\w* \w com entendimento|strong="G2596,G1108"\w*, \w atribuindo|strong="G632"\w* \w honra|strong="G5092"\w* \w à mulher|strong="G3588,G1134"\w* \w como a um vaso|strong="G5613,G4632"\w* \w mais fraco|strong="G772"\w* \w e|strong="G2532"\w* \w como|strong="G5613"\w* \w co-herdeira|strong="G4789"\w* \w da graça|strong="G5485"\w* \w da vida|strong="G2222"\w*, \w para que não|strong="G1519,G3588,G3361"\w* \w sejam impedidas|strong="G1465"\w* \w as orações|strong="G3588,G4335"\w* \w de vocês|strong="G4771"\w*.\f + \fr 3.7: \ft Lit.: Σκεῦος, “vaso, utensílio” (também “corpo” ou “pessoa”); ἀσθενέστερος, “mais fraco”; συνοικέω κατὰ γνῶσιν, “conviver com entendimento”; ἐγκόπτω, “impedir, atrapalhar”; συγκληρονόμοις, dativo plural (“co-herdeiros”, forma masculina genérica), aqui continua o objeto da honra: a mulher.\f*\f + \fr 3.7: \ft Variante: o RP traz συγκληρονόμοι (nominativo, “co-herdeiros”) em lugar de συγκληρονόμοις (dativo).\f*\x - \xo 3:7 \xt COL 3:19; EPH 5:25; GEN 2:23-24; PRO 31:11; MAT 19:3-9; 1CO 7:3\x*
\v 8 \w Finalmente|strong="G3588,G1161,G5056"\w*, \add sejam\add* \w todos|strong="G3956"\w* \w de um só pensamento|strong="G3675"\w*, \w compassivos|strong="G4835"\w*, \w amorosos como irmãos|strong="G5361"\w*, \w de bom coração|strong="G2155"\w*, \w humildes|strong="G9402"\w*\f + \fr 3.8: \ft Variante: o RP traz φιλόφρονες (“amáveis”) em lugar de ταπεινόφρονες (“humildes”).\f*,\f + \fr 3.8: \ft Acréscimo: “sejam” (em “Finalmente sejam todos de”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\f + \fr 3.8: \ft Tradução: τέλος (τέλος, G5056) está aqui como “Finalmente”; o termo pode ser “fim”, “término”, “objetivo”, “resultado” ou “imposto”, e o contexto decide.\f*\x - \xo 3:8 \xt PSA 133:1; MIC 6:8; EPH 4:32; ROM 12:10; PHP 2:2; EPH 4:31-5:2\x*
\v 9 \w não|strong="G3361"\w* \w retribuindo|strong="G591"\w* \w mal|strong="G2556"\w* \w por|strong="G473"\w* \w mal|strong="G2556"\w* \w ou|strong="G2228"\w* \w insulto|strong="G3059"\w* \w por|strong="G473"\w* \w insulto|strong="G3059"\w*, \w ao contrário|strong="G5121"\w* \w abençoando|strong="G2127"\w*, \w porque|strong="G3754"\w* \w para isto|strong="G1519,G3778"\w* \w foram chamados|strong="G2564"\w* \w para que|strong="G2443"\w* \w herdem|strong="G2816"\w*\f + \fr 3.9: \ft Variante: o RP acrescenta “sabendo” (εἰδότες) depois de “abençoando”.\f* \w bênção|strong="G2129"\w*.\x - \xo 3:9 \xt ROM 12:17; PRO 20:22; 1TH 5:15; MAT 5:44; ROM 12:21; LUK 23:34\x*
\v 10 “\w pois|strong="G1063"\w* \w aquele que|strong="G3588"\w* \w quer|strong="G2309"\w* \w amar|strong="G25"\w* \w vida|strong="G2222"\w* \w e|strong="G2532"\w* \w ver|strong="G1492"\w* \w dias|strong="G2250"\w* \w bons|strong="G18"\w*, \w refreie|strong="G3973"\w* \w a língua|strong="G3588,G1100"\w* \w do mal|strong="G575,G2556"\w* \w e|strong="G2532"\w* \w os lábios|strong="G5491"\w* \w para não|strong="G3588,G3361"\w* \w falar|strong="G2980"\w* \w engano|strong="G1388"\w*,\f + \fr 3.10: \ft Nota cultural: citação de Sl 34:12-16 (33:13-17 na LXX), em 3:10-12.\f*\f + \fr 3.10: \ft Variante: o RP acrescenta “dele” (αὐτοῦ) depois de “língua” e depois de “lábios”.\f*\x - \xo 3:10 \xt PSA 34:12; JAS 3:2; JAS 1:26; COL 3:12; MAT 15:8; ROM 12:9\x*
\v 11 \w desvie-se|strong="G1578"\w* \w do mal|strong="G575,G2556"\w* \w e|strong="G2532"\w* \w faça|strong="G4160"\w* \w o bem|strong="G18"\w*, \w busque|strong="G2212"\w* \w paz|strong="G1515"\w* \w e|strong="G2532"\w* \w a persiga|strong="G1377,G846"\w*;\x - \xo 3:11 \xt 1TH 5:15; ROM 14:19; ROM 7:19; PSA 34:14; 2TI 2:22; HEB 12:14\x*
\v 12 \w porque|strong="G3754"\w* \w os olhos|strong="G3788"\w* \w do Senhor|strong="G2962"\w* \w sobre os justos|strong="G1909,G1342"\w* \w e|strong="G2532"\w* \w os ouvidos|strong="G3775"\w* \w dele|strong="G846"\w* \w para a súplica|strong="G1519,G1162"\w* \w deles|strong="G846"\w*, \w o rosto|strong="G4383"\w* \w do Senhor|strong="G2962"\w* \w contra os que fazem|strong="G1909,G4160"\w* \w mal|strong="G2556"\w*.”\x - \xo 3:12 \xt 2CH 16:9; EZR 8:22; PSA 34:15; JHN 9:31; PRO 15:29; PRO 15:3\x*
\v 13 \w E|strong="G2532"\w* \w quem|strong="G5101"\w* \w será o que|strong="G3588"\w* \w fará mal|strong="G2559"\w* \w a vocês|strong="G4771"\w*, \w se|strong="G1437"\w* \w vocês se tornarem|strong="G1096"\w*\f + \fr 3.13: \ft Variante: o RP traz “imitadores” (μιμηταί) em lugar de “zelosos” (ζηλωταί).\f* \w zelosos|strong="G2207"\w* \w do bem|strong="G3588,G18"\w*?\f + \fr 3.13: \ft Acréscimo: verbo ser/estar suprido em “será o que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:13 \xt MAT 5:10; PRO 16:7; PHP 3:12; ROM 8:28; 1TH 5:15; 3JN 1:11\x*
\v 14 \w Mas|strong="G235"\w* \w ainda que|strong="G1487,G2532"\w* \w venham a sofrer|strong="G3958"\w* \w por causa da justiça|strong="G1223,G1343"\w*, \w felizes|strong="G3107"\w*. \w Não|strong="G3361"\w* \w temam|strong="G5399"\w* \w o temor|strong="G3588,G5401"\w* \w deles|strong="G846"\w*, \w nem|strong="G3366"\w* \w se perturbem|strong="G5015"\w*\f + \fr 3.14: \ft Nota cultural: eco de Is 8:12-13 (LXX): “não temam o temor deles, nem se perturbem”.\f*,\x - \xo 3:14 \xt ISA 8:12; MAT 5:10; JHN 14:27; ROM 5:3; JAS 1:12; 2TI 3:12\x*
\v 15 \w Santifiquem|strong="G37"\w*, \w porém|strong="G1161"\w*, \w a Cristo|strong="G3588,G5547"\w* \add como\add* \w Senhor|strong="G2962"\w* \w nos corações|strong="G1722,G3588,G2588"\w* \w de vocês|strong="G4771"\w*, \w prontos|strong="G2092"\w* \w sempre|strong="G104"\w* \w para uma defesa|strong="G4314,G627"\w* \w a todo aquele que|strong="G3956,G3588"\w* \w pede|strong="G154"\w* \w a vocês|strong="G4771"\w* \w uma razão|strong="G3056"\w* \w a respeito da|strong="G4012,G3588"\w* \w esperança|strong="G1680"\w* \w que há em vocês|strong="G1722,G4771"\w*\f + \fr 3.15: \ft Variante: o RP traz “Deus” (θεόν) em lugar de “Cristo” (Χριστόν) e acrescenta “porém” (δέ) depois de “prontos”.\f*\f + \fr 3.15: \ft Nota cultural: ecoa Is 8:13 (LXX): “santifiquem o Senhor”.\f*,\f + \fr 3.15: \ft Acréscimo: “como” (em “a Cristo como Senhor nos”): conectivo acrescentado para ligar as orações em português; “que há em vocês”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 3:15 \xt ISA 8:13; COL 4:6; 2TI 2:25; LUK 21:14-15; 1PE 3:2; 1PE 1:13\x*
\v 16 \w mas|strong="G235"\w* \w com mansidão|strong="G3326,G4236"\w* \w e|strong="G2532"\w* \w temor|strong="G5401"\w*, \w tendo|strong="G2192"\w* \w boa|strong="G18"\w* \w consciência|strong="G4893"\w*, \w para que|strong="G2443"\w* \w naquilo em que|strong="G1722,G3739"\w* \w são difamados|strong="G2635"\w* \w sejam envergonhados|strong="G2617"\w* \w os que caluniam|strong="G3588,G1908"\w* \w a boa conduta|strong="G3588,G18,G391"\w* \w de vocês|strong="G4771"\w* \w em Cristo|strong="G1722,G5547"\w*.\f + \fr 3.16: \ft Variante: o RP omite “mas” (ἀλλά) e, com Treg, traz “falam mal de vocês como de malfeitores” (καταλαλοῦσιν ὑμῶν ὡς κακοποιῶν) em lugar de “são difamados” (καταλαλεῖσθε).\f*\x - \xo 3:16 \xt JAS 3:13; MAT 5:16; 1PE 2:12; 1PE 2:15; 1PE 4:4; HEB 13:18\x*
\v 17 \w Pois|strong="G1063"\w* \w é melhor|strong="G2908"\w* \w sofrer|strong="G3958"\w* \w fazendo o bem|strong="G15"\w*, \w se|strong="G1487"\w* \w for da vontade|strong="G2309,G3588,G2307"\w* \w de Deus|strong="G3588,G2316"\w*, \w do que|strong="G2228"\w* \w fazendo o mal|strong="G2554"\w*.\f + \fr 3.17: \ft Acréscimo: verbo ser/estar suprido em “é melhor”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:17 \xt GAL 6:9; 1PE 2:15; 1PE 2:20; 1PE 4:16; 1PE 4:19; 1PE 3:14\x*
\v 18 \w Porque|strong="G3754"\w* \w também|strong="G2532"\w* \w Cristo|strong="G5547"\w* \w uma vez|strong="G530"\w* \w por pecados|strong="G4012,G266"\w* \w sofreu|strong="G3958"\w*, \w o justo|strong="G1342"\w* \w pelos injustos|strong="G5228,G94"\w*, \w para|strong="G2443"\w* \w conduzir|strong="G4317"\w* \w vocês|strong="G4771"\w* \w a Deus|strong="G3588,G2316"\w*, \w tendo sido morto|strong="G2289"\w* \w de fato|strong="G3303"\w* \w na carne|strong="G4561"\w* \w mas vivificado|strong="G2227,G1161"\w* \w no espírito|strong="G4151"\w*\f + \fr 3.18: \ft Variante: WH, Treg e a NIV trazem ἀπέθανεν (“morreu”) em lugar de ἔπαθεν (“sofreu”); Treg traz ἡμᾶς (“nós”) em lugar de ὑμᾶς (“vocês”).\f*\f + \fr 3.18: \ft Lit.: Σαρκί e πνεύματι (dativos): “na carne” e “no espírito”, ou “pela carne” e “pelo Espírito”; a oposição é discutida (esfera humana e esfera divina, ou o corpo e o Espírito Santo).\f*;\x - \xo 3:18 \xt 2CO 5:21; ISA 53:5; JHN 14:6; ROM 5:8; HEB 12:2; HEB 9:28\x*
\v 19 \w no qual|strong="G1722,G3739"\w* \w também|strong="G2532"\w* \w aos espíritos|strong="G3588,G4151"\w* \w em prisão|strong="G1722,G5438"\w* \w tendo ido|strong="G4198"\w* \w proclamou|strong="G2784"\w*,\f + \fr 3.19: \ft Lit.: Ἐν ᾧ… τοῖς ἐν φυλακῇ πνεύμασιν πορευθεὶς ἐκήρυξεν: “no qual (no espírito?)… tendo ido, proclamou aos espíritos em prisão”; quem são os espíritos, quando e o que foi proclamado são pontos muito discutidos (espíritos de desobedientes do tempo de Noé, anjos caídos, ou a descida de Cristo ao reino dos mortos); o texto não decide.\f*\x - \xo 3:19 \xt MAT 10:7; LUK 22:33; 1PE 4:6; ISA 61:1; ISA 42:7; GEN 6:3\x*
\v 20 \w que desobedeceram|strong="G544"\w* \w outrora|strong="G4218"\w* \w quando|strong="G3753"\w* \w a paciência|strong="G3588,G3115"\w* \w de Deus|strong="G3588,G2316"\w* \w esperava|strong="G553"\w* \w nos dias|strong="G1722,G2250"\w* \w de Noé|strong="G3575"\w*, \w a arca|strong="G2787"\w* \w sendo construída|strong="G2680"\w*, \w na qual|strong="G1519,G3739"\w* \w poucos|strong="G3641"\w*, \w isto é|strong="G3778,G1510"\w* \w oito|strong="G3638"\w* \w almas|strong="G5590"\w*, \w foram levados a salvo|strong="G1295"\w* \w por meio da água|strong="G1223,G5204"\w*\f + \fr 3.20: \ft Variante: o RP traz o feminino ὀλίγαι (“poucas”) em lugar de ὀλίγοι (“poucos”).\f*.\x - \xo 3:20 \xt HEB 11:7; 2PE 3:9; MAT 7:14; GEN 6:3; 2PE 2:5; GEN 6:5\x*
\v 21 \w Correspondendo a isso|strong="G3739,G499"\w*, \w o batismo|strong="G908"\w* \w também|strong="G2532"\w* \w agora|strong="G3568"\w* \w salva|strong="G4982"\w* \w vocês|strong="G4771"\w*: \w não|strong="G3756"\w* \w a remoção|strong="G595"\w* \w da sujeira|strong="G4509"\w* \w da carne|strong="G4561"\w*, \w mas|strong="G235"\w* \w o pedido|strong="G1906"\w* \w de uma boa|strong="G18"\w* \w consciência|strong="G4893"\w* \w a Deus|strong="G1519,G2316"\w*, \w por meio da ressurreição|strong="G1223,G386"\w* \w de Jesus Cristo|strong="G2424,G5547"\w*,\f + \fr 3.21: \ft Lit.: Ἀντίτυπον, “correspondente, figura que corresponde (ao modelo)”; ἐπερώτημα, “pedido, apelo, pergunta” (também “compromisso, resposta”, ligado a uma promessa solene); σαρκὸς ἀπόθεσις ῥύπου, “remoção da sujeira da carne”.\f*\f + \fr 3.21: \ft Variante: o RP coloca “correspondente agora” antes de “também a nós” (ἀντίτυπον νῦν καὶ ἡμᾶς), isto é, traz “nós” em lugar de “vocês”.\f*\x - \xo 3:21 \xt ACT 2:38; MRK 16:16; JHN 3:5; MAT 28:19; TIT 3:5; ROM 6:4\x*
\v 22 \w que|strong="G3739"\w* \w está|strong="G1510"\w* \w à direita|strong="G1722,G1188"\w* \w de Deus|strong="G2316"\w*, \w tendo ido|strong="G4198"\w* \w ao céu|strong="G1519,G3772"\w*, \w estando submetidos|strong="G5293"\w* \w a ele|strong="G846"\w* \w anjos|strong="G32"\w* \w e|strong="G2532"\w* \w autoridades|strong="G1849"\w* \w e|strong="G2532"\w* \w poderes|strong="G1411"\w*.\f + \fr 3.22: \ft Variante: NA28 e o RP acrescentam o artigo τοῦ diante de “Deus”.\f*\x - \xo 3:22 \xt LUK 22:69; MAT 28:18; EPH 6:12; PHP 2:9; PSA 110:1; MAT 11:27\x*
\c 4
\p
\v 1 \w Tendo sofrido|strong="G3958"\w* \w então|strong="G3767"\w* \w Cristo|strong="G5547"\w* \w na carne|strong="G4561"\w*, \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w se armem|strong="G3695"\w* \w com o mesmo|strong="G3588,G846"\w* \w pensamento|strong="G1771"\w*, \w porque|strong="G3754"\w* \w aquele que sofreu|strong="G3588,G3958"\w* \w na carne|strong="G4561"\w* \w cessou|strong="G3973"\w* \w de pecar|strong="G266"\w*\f + \fr 4.1: \ft Variante: o RP acrescenta “por nós” (ὑπὲρ ἡμῶν) depois de “sofrido” e “em” (ἐν) antes de “carne” na segunda ocorrência; WH traz o plural ἁμαρτίαις (“pecados”).\f*,\x - \xo 4:1 \xt MAT 16:24; PHP 2:5; GAL 2:20; GAL 5:24; PHP 3:10; 1PE 3:18\x*
\v 2 \w para viver|strong="G1519,G3588,G980"\w* \w o tempo restante|strong="G3588,G1954,G5550"\w* \w na carne|strong="G1722,G4561"\w* \w já não|strong="G3371"\w* \w segundo os desejos|strong="G1939"\w* \w dos seres humanos|strong="G444"\w*, \w mas|strong="G235"\w* \w segundo a vontade|strong="G2307"\w* \w de Deus|strong="G2316"\w*.\x - \xo 4:2 \xt GAL 5:16; ROM 12:2; 1JN 2:17; MAT 16:24; EPH 2:3; 2CO 5:15\x*
\v 3 \w Pois|strong="G1063"\w* \w basta|strong="G713"\w* \w o tempo|strong="G3588,G5550"\w* \w passado|strong="G3928"\w* \w para vocês terem realizado|strong="G2716"\w* \w a vontade|strong="G3588,G1013"\w* \w dos gentios|strong="G3588,G1484"\w*, \w tendo andado|strong="G4198"\w* \w em libertinagens|strong="G1722,G766"\w*, \w desejos|strong="G1939"\w*, \w bebedeiras|strong="G3632"\w*, \w orgias|strong="G2970"\w*, \w banquetes de bebida|strong="G4224"\w*, \w e|strong="G2532"\w* \w idolatrias|strong="G1495"\w*\f + \fr 4.3: \ft Variante: o RP acrescenta “para nós” (ἡμῖν) depois de “pois” e “da vida” (τοῦ βίου) depois de “tempo”.\f* \w ilícitas|strong="G111"\w*.\x - \xo 4:3 \xt 2CO 5:15; GAL 5:19; PSA 1:1; GAL 5:16; EPH 4:17; 1PE 1:14\x*
\v 4 \w Nisto|strong="G1722,G3739"\w* \add eles\add* \w estranham|strong="G3579"\w* \w que vocês|strong="G4771"\w* \w não|strong="G3361"\w* \w corram juntos|strong="G4936"\w* \w para a mesma|strong="G1519,G3588,G846"\w* \w torrente|strong="G401"\w* \w de devassidão|strong="G3588,G810"\w*, \w difamando|strong="G987"\w*\f + \fr 4.4: \ft Lit.: Ἀνάχυσις, “derramamento, torrente” (só aqui no Novo Testamento); ἀσωτία, “devassidão, vida desregrada”.\f*;\f + \fr 4.4: \ft Acréscimo: “eles” (em “Nisto eles estranham que”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 4:4 \xt 2CO 5:15; GAL 5:19; GAL 5:16; EPH 4:17; LUK 21:34; 1PE 3:16\x*
\v 5 \w os quais|strong="G3739"\w* \w prestarão|strong="G591"\w* \w contas|strong="G3056"\w* \w àquele que está pronto|strong="G3588,G2093,G2192"\w* \w para julgar|strong="G2919"\w* \w vivos|strong="G2198"\w* \w e|strong="G2532"\w* \w mortos|strong="G3498"\w*;\x - \xo 4:5 \xt 2TI 4:1; ROM 14:12; 2CO 5:10; 1PE 5:5; LUK 21:34; JAS 5:9\x*
\v 6 \w Pois|strong="G1063"\w* \w para isto|strong="G1519,G3778"\w* \w a boa notícia foi anunciada|strong="G2097"\w* \w também|strong="G2532"\w* \w aos mortos|strong="G3498"\w*, \w para que|strong="G2443"\w* \w sejam julgados|strong="G2919"\w*, \w de fato|strong="G3303"\w*, \w segundo os seres humanos|strong="G2596,G444"\w* \w na carne|strong="G4561"\w*, \w vivam|strong="G2198"\w*, \w porém|strong="G1161"\w*, \w segundo Deus|strong="G2596,G2316"\w* \w no espírito|strong="G4151"\w*\f + \fr 4.6: \ft Lit.: Νεκροῖς εὐηγγελίσθη: “aos mortos foi anunciada a boa notícia”: se “mortos” são os já falecidos que ouviram em vida ou os que ouviram depois de mortos é discutido; σαρκί e πνεύματι: “na carne” e “no espírito”.\f*.\x - \xo 4:6 \xt LUK 20:38; 1PE 3:19; GAL 5:25; 1PE 3:18; GAL 5:16; LUK 21:34\x*
\v 7 \w De todas as coisas|strong="G3956"\w* \w o fim|strong="G3588,G5056"\w* \w se aproximou|strong="G1448"\w*. \w Sejam sensatos|strong="G4993"\w* \w então|strong="G3767"\w* \w e|strong="G2532"\w* \w estejam sóbrios|strong="G3525"\w* \w para as orações|strong="G1519,G4335"\w*;\f + \fr 4.7: \ft Variante: o RP acrescenta o artigo τάς antes de “orações”.\f*\x - \xo 4:7 \xt 1PE 5:8; 1TH 5:17; 1CO 16:13; PHP 4:6; JAS 5:8; ROM 13:11\x*
\v 8 \w antes de tudo|strong="G4253,G3956"\w* \w mantenham|strong="G2192"\w* \w intenso|strong="G1618"\w* \w o amor|strong="G3588,G26"\w* \w entre vocês|strong="G1519,G1438"\w*, \w porque|strong="G3754"\w* \w amor|strong="G26"\w* \w cobre|strong="G2572"\w* \w uma multidão|strong="G4128"\w* \w de pecados|strong="G266"\w*;\f + \fr 4.8: \ft Nota cultural: ecoa Pv 10:12 (cf. Tg 5:20).\f*\f + \fr 4.8: \ft Variante: o RP acrescenta “porém” (δέ) depois de “tudo” e traz o futuro καλύψει (“cobrirá”).\f*\x - \xo 4:8 \xt JAS 5:20; PRO 10:12; 1CO 13:4; COL 3:14; PRO 17:9; 1CO 13:1\x*
\v 9 \w hospitaleiros|strong="G5382"\w* \w uns com os outros|strong="G1519,G240"\w* \w sem murmuração|strong="G427,G1112"\w*;\f + \fr 4.9: \ft Variante: o RP acrescenta uma segunda palavra (γογγυσμῶν) depois de γογγυσμοῦ.\f*\x - \xo 4:9 \xt PHP 2:14; HEB 13:2; 2CO 9:7; MAT 25:14; ROM 12:13; LUK 19:13\x*
\v 10 \w cada um|strong="G1538"\w* \w conforme|strong="G2531"\w* \w recebeu|strong="G2983"\w* \w um dom|strong="G5486"\w*, \w servindo|strong="G1247"\w* \w uns aos outros|strong="G1519,G1438"\w* \w com ele|strong="G846"\w*, \w como bons|strong="G5613,G2570"\w* \w administradores|strong="G3623"\w* \w da variada|strong="G4164"\w* \w graça|strong="G5485"\w* \w de Deus|strong="G2316"\w*;\x - \xo 4:10 \xt ROM 12:6; 1CO 12:4; 2TI 1:6; 1CO 4:1; MRK 10:45; 1CO 4:7\x*
\v 11 \w se|strong="G1487"\w* \w alguém|strong="G5100"\w* \w fala|strong="G2980"\w*, \w como|strong="G5613"\w* \w oráculos|strong="G3051"\w* \w de Deus|strong="G2316"\w*; \w se|strong="G1487"\w* \w alguém|strong="G5100"\w* \w serve|strong="G1247"\w*, \w como|strong="G5613"\w* \w da força|strong="G1537,G2479"\w* \w que|strong="G3739"\w* \w Deus|strong="G3588,G2316"\w* \w fornece|strong="G5524"\w*; \w para que|strong="G2443"\w* \w em tudo|strong="G1722,G3956"\w* \w seja glorificado|strong="G1392"\w* \w Deus|strong="G3588,G2316"\w* \w por meio de|strong="G1223"\w* \w Jesus Cristo|strong="G2424,G5547"\w*, \w a quem|strong="G3739"\w* \w pertence|strong="G1510"\w* \w a|strong="G3588"\w* \w glória|strong="G1391"\w* \w e|strong="G2532"\w* \w o|strong="G3588"\w* \w domínio|strong="G2904"\w* \w para os séculos|strong="G1519,G3588,G165"\w* \w dos séculos|strong="G3588,G165"\w*: \w amém|strong="G281"\w*.\f + \fr 4.11: \ft Lit.: Λόγια θεοῦ, “oráculos de Deus”: palavras de Deus (cf. Rm 3:2; Hb 5:12); κράτος, “poder, domínio”.\f*\f + \fr 4.11: \ft Variante: o RP traz ὡς (“como”) em lugar de ἧς (“que”).\f*\x - \xo 4:11 \xt ROM 3:2; HEB 5:12; 1PE 5:11; REV 1:6; EPH 6:10; ROM 11:36\x*
\v 12 \w Amados|strong="G27"\w*, \w não|strong="G3361"\w* \w estranhem|strong="G3579"\w* \w o fogo|strong="G3588,G4451"\w* \w que surge|strong="G1096"\w* \w entre vocês|strong="G1722,G4771"\w* \w para prová-los|strong="G4314,G3986,G4771"\w*, \w como se algo estranho|strong="G5613,G3581"\w* \w acontecesse a vocês|strong="G4771,G4819"\w*\f + \fr 4.12: \ft Lit.: Πύρωσις, “fogo, incêndio; prova de fogo” (cf. 1:7, a prova do ouro pelo fogo).\f*,\x - \xo 4:12 \xt ISA 43:2; PSA 34:19; 2TI 3:12; 1PE 1:6; ZEC 13:9; 1PE 5:9\x*
\v 13 \w mas|strong="G235"\w* \w na medida em que|strong="G2526"\w* \w participam|strong="G2841"\w* \w nos sofrimentos|strong="G3588,G3804"\w* \w de Cristo|strong="G3588,G5547"\w*, \w alegrem-se|strong="G5463"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w na revelação|strong="G1722,G3588,G602"\w* \w da glória|strong="G3588,G1391"\w* \w dele|strong="G846"\w* \w se alegrem|strong="G5463"\w* \w exultando|strong="G21"\w*.\x - \xo 4:13 \xt ROM 8:18; ISA 43:2; PSA 34:19; 2CO 12:9; 2CO 4:8; ROM 12:12\x*
\v 14 \w Se|strong="G1487"\w* \w são insultados|strong="G3679"\w* \w em nome|strong="G1722,G3686"\w* \w de Cristo|strong="G5547"\w*, \w felizes|strong="G3107"\w*, \w porque|strong="G3754"\w* \w o Espírito|strong="G3588,G4151"\w* \w da glória|strong="G3588,G1391"\w* \w e|strong="G2532"\w* \w de Deus|strong="G3588,G2316"\w* \w sobre vocês|strong="G1909,G4771"\w* \w repousa|strong="G373"\w*.\f + \fr 4.14: \ft Nota cultural: ecoa Is 11:2 (o Espírito que repousa sobre o Messias).\f*\f + \fr 4.14: \ft Variante: o RP acrescenta, no fim, “da parte deles é blasfemado, da parte de vocês é glorificado” (κατὰ μὲν αὐτοὺς βλασφημεῖται κατὰ δὲ ὑμᾶς δοξάζεται).\f*\x - \xo 4:14 \xt ISA 11:2; MAT 5:11; LUK 6:22; 2CO 12:9; MAT 5:16; 2CO 4:8\x*
\v 15 \w Que|strong="G3361"\w* \w nenhum|strong="G5100"\w* \w pois|strong="G1063"\w* \w de vocês|strong="G4771"\w* \w sofra|strong="G3958"\w* \w como assassino|strong="G5613,G5406"\w* \w ou|strong="G2228"\w* \w ladrão|strong="G2812"\w* \w ou|strong="G2228"\w* \w malfeitor|strong="G2555"\w* \w ou|strong="G2228"\w* \w como|strong="G5613"\w* \w intrometido|strong="G244"\w*;\f + \fr 4.15: \ft Lit.: Ἀλλοτριεπίσκοπος, literalmente “supervisor do que é alheio”: quem se intromete em assuntos alheios (só aqui no Novo Testamento).\f*\x - \xo 4:15 \xt JAS 1:2; 2TI 3:12; HEB 12:2; MAT 5:10; ACT 5:41; LUK 6:22\x*
\v 16 \w se|strong="G1487"\w* \add sofre\add* \w como cristão|strong="G5613,G5546"\w*, \w não|strong="G3361"\w* \w se envergonhe|strong="G153"\w*, \w glorifique|strong="G1392"\w*, \w porém|strong="G1161"\w*, \w a Deus|strong="G3588,G2316"\w* \w neste nome|strong="G1722,G3588,G3686,G3778"\w*\f + \fr 4.16: \ft Variante: NA28 e o RP trazem μέρει (“nesta parte”, isto é, “neste caso”) em lugar de ὀνόματι (“neste nome”).\f*\f + \fr 4.16: \ft Lit.: Χριστιανός, “cristão” (“partidário de Cristo”): nome que aparece só três vezes no Novo Testamento (At 11:26; 26:28; aqui).\f*.\f + \fr 4.16: \ft Acréscimo: “sofre” (em “se sofre como cristão”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 4:16 \xt ACT 11:26; ACT 26:28; ROM 1:16; JAS 1:2; 2TI 3:12; HEB 12:2\x*
\v 17 \w Porque|strong="G3754"\w* \w é o tempo|strong="G3588,G2540"\w* \w de começar|strong="G3588,G757"\w* \w o julgamento|strong="G3588,G2917"\w* \w pela casa|strong="G575,G3588,G3624"\w* \w de Deus|strong="G3588,G2316"\w*; \w se|strong="G1487"\w* \add começa\add* \w primeiro|strong="G4413"\w* \w por nós|strong="G575,G3165"\w*, \w qual é o fim|strong="G5101,G3588,G5056"\w* \w dos que desobedecem|strong="G3588,G544"\w* \w à boa notícia|strong="G3588,G2098"\w* \w de Deus|strong="G3588,G2316"\w*\f + \fr 4.17: \ft Nota cultural: cf. Ez 9:6 e Jr 25:29 (o juízo começa pela casa de Deus).\f*?\f + \fr 4.17: \ft Acréscimo: “começa” (em “Deus se começa primeiro por”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; verbo ser/estar suprido em “é o tempo”, “qual é o fim”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:17 \xt JER 25:29; EZK 9:6; 1TI 5:12; MAT 7:13; 2TH 1:8; ROM 2:9\x*
\v 18 \w E|strong="G2532"\w* \w se|strong="G1487"\w* \w o justo|strong="G3588,G1342"\w* \w com dificuldade|strong="G3433"\w* \w é salvo|strong="G4982"\w*, \w o ímpio|strong="G3588,G765"\w* \w e|strong="G2532"\w* \w pecador|strong="G268"\w* \w onde|strong="G4226"\w* \w aparecerá|strong="G5316"\w*?\f + \fr 4.18: \ft Nota cultural: citação de Pv 11:31 (LXX).\f*\f + \fr 4.18: \ft Variante: WH acrescenta “porém” (δέ) depois de “o” antes de “ímpio”.\f*\x - \xo 4:18 \xt PRO 11:31; 1TI 1:9; JUD 1:15; EZK 18:24; LUK 23:31; MAT 7:13\x*
\v 19 \w Portanto|strong="G5620"\w* \w também|strong="G2532"\w* \w os que sofrem|strong="G3588,G3958"\w* \w segundo|strong="G2596"\w* \w a vontade|strong="G3588,G2307"\w* \w de Deus|strong="G3588,G2316"\w* \w entreguem|strong="G3908"\w* \w as suas almas|strong="G3588,G5590,G846"\w* \w a um fiel Criador|strong="G4103,G2939"\w*, \w fazendo o bem|strong="G1722,G16"\w*\f + \fr 4.19: \ft Variante: o RP acrescenta “como” (ὡς) depois de “Deus”; WH omite “deles” (αὐτῶν).\f*.\x - \xo 4:19 \xt GAL 6:9; PRO 20:22; 1CO 10:13; PSA 37:5; 2TI 1:12; PSA 138:8\x*
\c 5
\p
\v 1 \w Aos presbíteros|strong="G4245"\w* \w entre vocês|strong="G1722,G4771"\w*, \w então|strong="G3767"\w*, \w exorto|strong="G3870"\w*, \add eu,\add* \w o co-presbítero|strong="G3588,G4850"\w* \w e|strong="G2532"\w* \w testemunha|strong="G3144"\w* \w dos sofrimentos|strong="G3588,G3804"\w* \w de Cristo|strong="G5547"\w*, \w e também|strong="G3588,G2532"\w* \w participante|strong="G2844"\w*\f + \fr 5.1: \ft Variante: NA28 e o RP trazem “os” (τούς) em lugar de “então” (οὖν): “Aos presbíteros que estão entre vocês exorto…”.\f*\f + \fr 5.1: \ft Lit.: Πρεσβύτερος, “mais velho, ancião, presbítero”; συμπρεσβύτερος, “co-presbítero, presbítero junto com eles”.\f* \w da glória|strong="G3588,G1391"\w* \w que está para|strong="G3195"\w* \w ser revelada|strong="G601"\w*,\f + \fr 5.1: \ft Acréscimo: “eu” (em “então exorto eu o co”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 5:1 \xt ROM 8:18; 1TI 5:1; PHP 4:19; EPH 4:11; JHN 21:15; JER 3:15\x*
\v 2 \w pastoreiem|strong="G4165"\w* \w o rebanho|strong="G3588,G4168"\w* \w de Deus|strong="G3588,G2316"\w* \w que há|strong="G1722"\w* \w entre vocês|strong="G4771"\w*, \w supervisionando|strong="G1983"\w* \w não|strong="G3361"\w* \w por obrigação|strong="G317"\w* \w mas|strong="G235"\w* \w de boa vontade|strong="G1596"\w* \w segundo Deus|strong="G2596,G2316"\w*, \w nem|strong="G3366"\w* \w por lucro vergonhoso|strong="G147"\w* \w mas|strong="G235"\w* \w com disposição|strong="G4290"\w*,\f + \fr 5.2: \ft Variante: WH omite “supervisionando” (ἐπισκοποῦντες); WH e o RP omitem “segundo Deus” (κατὰ θεόν).\f*\f + \fr 5.2: \ft Acréscimo: “que há”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 5:2 \xt ACT 20:28; HEB 13:17; PRO 27:23; EPH 4:11; TIT 1:7; JHN 21:15\x*
\v 3 \w nem|strong="G3366"\w* \w como dominando|strong="G5613,G2634"\w* \w os que foram confiados|strong="G3588,G2819"\w*, \w mas|strong="G235"\w* \w tornando-se|strong="G1096"\w* \w modelos|strong="G5179"\w* \w para o rebanho|strong="G3588,G4168"\w*\f + \fr 5.3: \ft Lit.: Κλῆρος, “sorte, porção atribuída”: as comunidades ou pessoas confiadas a cada pastor; τύπος, “modelo, exemplo”.\f*;\f + \fr 5.3: \ft Acréscimo: verbo ser/estar suprido em “os que foram confiados”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:3 \xt 1TI 4:12; ACT 20:28; HEB 13:17; MAT 20:26; REV 3:11; TIT 2:7\x*
\v 4 \w e|strong="G2532"\w* \add quando\add* \w o Pastor-chefe|strong="G3588,G750"\w* \w for manifestado|strong="G5319"\w*, \w receberão|strong="G2865"\w* \w a coroa|strong="G3588,G4735"\w* \w da glória|strong="G3588,G1391"\w*\f + \fr 5.4: \ft Lit.: Ἀρχιποίμην, “pastor-chefe” (só aqui no Novo Testamento).\f*, \w que não murcha|strong="G262"\w*.\f + \fr 5.4: \ft Acréscimo: “quando” (em “e quando o Pastor”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 5:4 \xt PSA 23:1; COL 3:4; JAS 1:12; 1PE 2:25; REV 2:10; 2TI 4:8\x*
\v 5 \w Da mesma forma|strong="G3668"\w*, \w jovens|strong="G3501"\w*, \w submetam-se|strong="G5293"\w* \w aos presbíteros|strong="G4245"\w*. \w Todos|strong="G3956"\w*, \w vistam-se|strong="G1463"\w* \w de humildade|strong="G3588,G5012"\w* \w uns para com os outros|strong="G240"\w*, \w porque|strong="G3754"\w* “\w Deus|strong="G3588,G2316"\w* \w resiste|strong="G498"\w* \w aos soberbos|strong="G5244"\w*, \w mas|strong="G1161"\w* \w dá|strong="G1325"\w* \w graça|strong="G5485"\w*\f + \fr 5.5: \ft Variante: o RP acrescenta “submetendo-se” (ὑποτασσόμενοι) depois de “uns aos outros”.\f*\f + \fr 5.5: \ft Nota cultural: citação de Pv 3:34 (LXX); também em Tg 4:6.\f*\f + \fr 5.5: \ft Lit.: Ἐγκομβόομαι, “vestir-se, amarrar sobre si” (de κόμβος, laço ou avental), talvez evocando o gesto de pôr a veste de servo (cf. Jo 13:4-5).\f* \w aos humildes|strong="G5011"\w*.”\x - \xo 5:5 \xt JAS 4:6; PRO 3:34; JHN 13:4-5; EPH 5:21; PRO 29:23; 1TI 5:1\x*
\v 6 \w Humilhem-se|strong="G5013"\w* \w então|strong="G3767"\w* \w sob a poderosa|strong="G5259,G3588,G2900"\w* \w mão|strong="G5495"\w* \w de Deus|strong="G3588,G2316"\w*, \w para que|strong="G2443"\w* \add ele\add* \w os exalte|strong="G4771,G5312"\w* \w no devido tempo|strong="G1722,G2540"\w*,\f + \fr 5.6: \ft Acréscimo: “ele” (em “para que ele os exalte”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 5:6 \xt JAS 4:10; LUK 14:11; MAT 23:12; LUK 18:14; JAS 4:7; MIC 6:8\x*
\v 7 \w lançando|strong="G1977"\w* \w toda|strong="G3956"\w* \w a ansiedade|strong="G3588,G3308"\w* \w de vocês|strong="G4771"\w* \w sobre ele|strong="G1909,G846"\w*, \w porque|strong="G3754"\w* \w ele|strong="G846"\w* \w cuida|strong="G3199"\w* \w de vocês|strong="G4012,G4771"\w*\f + \fr 5.7: \ft Nota cultural: ecoa Sl 55:22 (54:23 na LXX).\f*.\x - \xo 5:7 \xt PSA 55:22; 1SA 30:6; HEB 13:5-6; LUK 12:22; LUK 12:30-32; MAT 6:25\x*
\v 8 \w Sejam sóbrios|strong="G3525"\w*, \w vigiem|strong="G1127"\w*. \w O adversário|strong="G3588,G476"\w* \w de vocês|strong="G4771"\w*, \w o diabo|strong="G1228"\w*, \w como leão|strong="G5613,G3023"\w* \w rugindo|strong="G5612"\w* \w anda|strong="G4043"\w* \w procurando|strong="G2212"\w* \w alguém|strong="G5100"\w* \w devorar|strong="G2666"\w*;\f + \fr 5.8: \ft Lit.: Ἀντίδικος, “adversário” (originalmente, a parte contrária num processo judicial).\f*\f + \fr 5.8: \ft Variante: WH e Treg omitem a palavra τινα (“alguém”); o RP traz τίνα (“a quem”).\f*\x - \xo 5:8 \xt 1TH 5:6; 1CO 10:13; EPH 4:27; EPH 6:11; JAS 4:7; JOB 2:2\x*
\v 9 \w ao qual|strong="G3739"\w* \w resistam|strong="G436"\w* \w firmes|strong="G4731"\w* \w na fé|strong="G3588,G4102"\w*, \w sabendo|strong="G6063"\w* \w que os mesmos|strong="G3588,G846"\w* \w sofrimentos|strong="G3588,G3804"\w* \w estão se cumprindo|strong="G2005"\w* \w na irmandade|strong="G3588,G81"\w* \w de vocês|strong="G4771"\w* \w no mundo|strong="G1722,G3588,G2889"\w*\f + \fr 5.9: \ft Variante: NA28 e o RP omitem o artigo τῷ diante de “mundo”.\f*;\x - \xo 5:9 \xt 1CO 10:13; JAS 4:7; JHN 16:33; EPH 6:16; 1PE 4:12; 2CO 5:7\x*
\v 10 \w O|strong="G3588"\w* \w Deus|strong="G2316"\w* \w de toda|strong="G3956"\w* \w graça|strong="G5485"\w*, \w aquele que|strong="G3588"\w* \w chamou|strong="G2564"\w* \w vocês|strong="G4771"\w* \w para a sua|strong="G1519,G3588,G846"\w* \w eterna|strong="G166"\w* \w glória|strong="G1391"\w* \w em Cristo|strong="G1722,G5547"\w*, \w depois de vocês terem sofrido|strong="G3958"\w* \w um pouco|strong="G3641"\w*, \w ele mesmo|strong="G846"\w* \w restaurará|strong="G2675"\w*, \w firmará|strong="G4741"\w*, \w fortalecerá|strong="G4599"\w*, \w fundamentará|strong="G2311"\w*\f + \fr 5.10: \ft Variante: Treg, NA27 e o RP acrescentam “Jesus” depois de “Cristo”; o RP traz “restaure vocês” (καταρτίσαι ὑμᾶς) em lugar de “restaurará”; WH e Treg omitem “fundamentará” (θεμελιώσει).\f*.\x - \xo 5:10 \xt 2CO 4:17; 2TH 3:3; JAS 1:12; PHP 1:6; PHP 4:19; ROM 8:28\x*
\v 11 \w A ele|strong="G846"\w* \w o domínio|strong="G3588,G2904"\w* \w para os séculos|strong="G1519,G3588,G165"\w* \w dos séculos|strong="G3588,G165"\w*: \w amém|strong="G281"\w*.\f + \fr 5.11: \ft Variante: o RP acrescenta “a glória e” (ἡ δόξα καί) antes de “o domínio”; WH e NA28 omitem “dos séculos” (τῶν αἰώνων).\f*\x - \xo 5:11 \xt REV 1:6; JUD 1:25; ROM 11:36; EPH 3:21; GAL 1:5; 1PE 4:11\x*
\v 12 \w Por meio de|strong="G1223"\w* \w Silvano|strong="G4610"\w*, \w o fiel|strong="G3588,G4103"\w* \w irmão|strong="G80"\w* \w para vocês|strong="G4771"\w*, \w como|strong="G5613"\w* \add o\add* \w considero|strong="G3049"\w*, \w escrevi|strong="G1125"\w* \w em poucas palavras|strong="G1223,G3641"\w*, \w exortando|strong="G3870"\w* \w e|strong="G2532"\w* \w testemunhando|strong="G1957"\w* \w que esta|strong="G3778"\w* \w é|strong="G1511"\w* \w a verdadeira|strong="G227"\w* \w graça|strong="G5485"\w* \w de Deus|strong="G3588,G2316"\w*; \w na qual|strong="G1519,G3739"\w* \add fiquem\add* \w firmes|strong="G2476"\w*\f + \fr 5.12: \ft Variante: o RP traz ἑστήκατε (“estão firmes”, indicativo) em lugar de στῆτε (“fiquem firmes”).\f*\f + \fr 5.12: \ft Nota cultural: Silvano é provavelmente o Silas de Atos (At 15:22, 40; 2Co 1:19); aqui é o portador ou redator da carta.\f*.\f + \fr 5.12: \ft Acréscimo: “o” (em “vocês como o considero escrevi”): preposição ou artigo que a regência do português exige; “fiquem” (em “na qual fiquem firmes”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 5:12 \xt 2CO 1:19; ACT 15:22; 1TH 1:1; HEB 12:1; GAL 5:22; ACT 20:24\x*
\v 13 \w A co-eleita|strong="G3588,G4899"\w* \add que está\add* \w em Babilônia|strong="G1722,G897"\w* \w e|strong="G2532"\w* \w Marcos|strong="G3138"\w*, \w meu filho|strong="G3588,G5207,G3165"\w*\f + \fr 5.13: \ft Nota cultural: “Babilônia” é provavelmente designação simbólica de Roma (cf. Ap 14:8; 17:5); “a co-eleita” seria a igreja local; Marcos provavelmente é João Marcos (At 12:12, 25).\f*, \w saúdam|strong="G782"\w* \w vocês|strong="G4771"\w*.\f + \fr 5.13: \ft Acréscimo: “que” (em “co eleita que está em”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição; “está” (em “eleita que está em Babilônia”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 5:13 \xt ACT 12:12; REV 17:5; REV 14:8; 2JN 1:13; ACT 12:25; 2TI 4:11\x*
\v 14 \w Saúdem|strong="G782"\w* \w uns aos outros|strong="G240"\w* \w com beijo|strong="G1722,G5370"\w* \w de amor|strong="G26"\w*. \w Paz|strong="G1515"\w* \w a vocês|strong="G4771"\w* \w todos|strong="G3956"\w* \w os que estão|strong="G3588,G1722"\w* \w em Cristo|strong="G5547"\w*.\f + \fr 5.14: \ft Variante: o RP acrescenta “Jesus. Amém.” (Ἰησοῦ ἀμήν) depois de “Cristo”.\f*\f + \fr 5.14: \ft Acréscimo: “os que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 5:14 \xt 2CO 13:12; 1CO 16:20; ROM 16:16; 1TH 5:26; EPH 6:23; ROM 8:1\x*
