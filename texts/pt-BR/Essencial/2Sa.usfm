\v 1 \w E houve|strong="H1961"\w* \w uma fome|strong="H7458"\w* \w nos dias|strong="H3117"\w* \w de David|strong="H1732"\w*, \w três anos|strong="H7969,H8141"\w*, \w ano após ano|strong="H8141,H0310"\w*; \w e buscou|strong="H1245"\w* \w David|strong="H1732"\w* \w a face|strong="H6440"\w* \w do SENHOR|strong="H3068"\w*. \w E disse|strong="H0559"\w* \w o SENHOR|strong="H3068"\w*: \add "É por\add* \w causa|strong="H0413"\w* \w de Saul|strong="H7586"\w*, \w e por causa|strong="H0413"\w* \w da casa|strong="H1004"\w* \w sanguinária|strong="H1818"\w*, \w por|strong="H5921"\w* \w aquilo que|strong="H0834"\w* \w matou|strong="H4191"\w* \w os gibeonitas|strong="H1393"\w*."\x - \xo 21:1 \xt HAG 1:6; JOS 7:11-12; EXO 20:5; 2TI 3:3; DEU 19:13; 2SA 21:5\x*
\v 2 \w E chamou|strong="H7121"\w* \w o rei|strong="H4428"\w* \w os gibeonitas|strong="H1393"\w*, \w e lhes falou|strong="H0559,H0413"\w*. \w E os gibeonitas|strong="H1393"\w* \w não|strong="H3808"\w* \w eram dos filhos|strong="H1121,H3478,H1992"\w* \w de Israel|strong="H3478"\w*, \w senão|strong="H3588,H0518"\w* \w do resto|strong="H3499"\w* \w dos amorreus|strong="H0567"\w*; \w e os filhos|strong="H1121"\w* \w de Israel|strong="H3478"\w* \add lhes tinham\add* \w jurado|strong="H7650,H9038"\w*; \w e tinha procurado|strong="H1245"\w* \w Saul|strong="H7586"\w* \w matá-los|strong="H5221"\w*, \w no seu zelo|strong="H7065"\w* \w pelos filhos|strong="H1121"\w* \w de Israel|strong="H3478"\w* \w e de Judá|strong="H3063"\w*.\x - \xo 21:2 \xt JOS 9:15; 2TI 3:3; ACT 22:3; EXO 20:7; EXO 23:32; JER 32:18\x*
\v 3 \w E disse|strong="H0559"\w* \w David|strong="H1732"\w* \w a|strong="H0413"\w* \w os gibeonitas|strong="H1393"\w*: "\w Que|strong="H4100"\w* \w farei|strong="H6213"\w* \w por vós|strong="H9036"\w*? \w E com que|strong="H4100"\w* \add me\add* \w reconciliarei|strong="H3722"\w*, \w para que bendigais|strong="H1288"\w* \w a herança|strong="H5159"\w* \w do SENHOR|strong="H3068"\w*?"\x - \xo 21:3 \xt GAL 3:13; HEB 9:22; 2SA 20:19; 2TI 3:3; 1SA 26:19; JER 32:18\x*
\v 4 \w E disseram-lhe|strong="H0559,H9033"\w* \w os gibeonitas|strong="H1393"\w*: "\w Não|strong="H0369"\w* \w temos|strong="H9035"\w*\f + \fr 21.4: \ft Variante: a Ketiv tem "a mim" (1ª singular, לִי); o texto principal traz "a nós" (1ª plural, לָנוּ); sentido ajustado ao contexto\f* \w pretensão a prata|strong="H3701"\w* \w nem a ouro|strong="H2091"\w* \w de Saul|strong="H5973,H7586"\w*, \w nem da sua casa|strong="H5973,H1004"\w*; \w e não|strong="H0369"\w* \w temos direito|strong="H9035,H0376"\w* \w de matar|strong="H4191"\w* \w alguém|strong="H3478"\w* \w em Israel|strong="H3478"\w*."\w E disse|strong="H0559"\w*: "\w Que|strong="H4100"\w* \w vós|strong="H0859"\w* \w dizeis|strong="H0559"\w*, \w que eu faça|strong="H6213"\w* \w por vós|strong="H9036"\w*?"\x - \xo 21:4 \xt EXO 20:23; GEN 30:31; JER 32:18; JON 1:11; PRO 17:13\x*
\v 5 \w E disseram|strong="H0559"\w* \w a|strong="H0413"\w* \w o rei|strong="H4428"\w*: "\w O homem|strong="H0376"\w* \w que|strong="H0834"\w* \add nos\add* \w consumiu|strong="H3615"\w*, \w e que|strong="H0834"\w* \w planejou|strong="H1819"\w* \w contra nós|strong="H9035"\w* \add para que fôssemos\add* \w destruídos|strong="H8045"\w* \w sem subsistir|strong="H3320"\w* \w em todo|strong="H3605"\w* \w o território|strong="H1366"\w* \w de Israel|strong="H3478"\w*—\x - \xo 21:5 \xt 2SA 21:1; GEN 30:31; JER 32:18; JON 1:11; PRO 17:13\x*
\v 6 — \w dê-se-nos|strong="H5414,H9035"\w*\f + \fr 21.6: \ft Variante: a Ketiv tem a forma passiva com nun (יְנָתָן); o texto principal traz a forma passiva "יֻתַּן", sem alteração de sentido\f* \w sete|strong="H7651"\w* \w homens|strong="H0582"\w* \w dos seus filhos|strong="H1121"\w*, \w e os enforcaremos|strong="H3363"\w* \w ao SENHOR|strong="H3068"\w* \w em Gibeá|strong="H1390"\w* \w de Saul|strong="H7586"\w*, \w o escolhido|strong="H0972"\w* \w do SENHOR|strong="H3068"\w*."\w E disse|strong="H0559"\w* \w o rei|strong="H4428"\w*: "\w Eu|strong="H0589"\w* \add os\add* \w darei|strong="H5414"\w*."\x - \xo 21:6 \xt 1SA 10:26; 1SA 10:24; EXO 20:5; 1SA 24:21; 1SA 11:4; GEN 30:31\x*
\v 7 \w Mas teve compaixão|strong="H2550"\w* \w o rei|strong="H4428"\w* \w de|strong="H5921"\w* \w Mefibosete|strong="H4648"\w*, \w filho|strong="H1121"\w* \w de Jônatas|strong="H3083"\w*, \w filho|strong="H1121"\w* \w de Saul|strong="H7586"\w*, \w por causa|strong="H5921"\w* \w do juramento|strong="H7621"\w* \w do SENHOR|strong="H3068"\w* \w que|strong="H0834"\w* \add havia entre\add* \w eles|strong="H0996"\w*, \w entre|strong="H0996"\w* \w David|strong="H1732"\w* \w e entre|strong="H0996"\w* \w Jônatas|strong="H3083"\w*, \w filho|strong="H1121"\w* \w de Saul|strong="H7586"\w*.\x - \xo 21:7 \xt 2SA 9:6; 2SA 4:4; PRO 18:24; 1SA 18:3; 1SA 20:15; 1SA 23:18\x*
\v 8 \w E tomou|strong="H3947"\w* \w o rei|strong="H4428"\w* \w os dois|strong="H8147"\w* \w filhos|strong="H1121"\w* \w de Rispa|strong="H7532"\w*, \w filha|strong="H1323"\w* \w de Aiá|strong="H0345"\w*, \w que|strong="H0834"\w* \add tinha dado à\add* \w luz|strong="H3205"\w* \w a Saul|strong="H7586"\w*: \w Armoni|strong="H0764"\w* \w e|strong="H0853"\w* \w Mefibosete|strong="H4648"\w*; \w e|strong="H0853"\w* \w os cinco|strong="H2568"\w* \w filhos|strong="H1121"\w* \w de Mical|strong="H4324"\w*\f + \fr 21.8: \ft Lit.: o texto hebraico traz "Mical", mas, como Mical era estéril (cf. 2Sa 6.23), muitos entendem tratar-se de "Merabe", irmã de Mical e esposa de Adriel (cf. 1Sa 18.19); mantemos aqui a leitura do texto hebraico, "Mical"\f*, \w filha|strong="H1323"\w* \w de Saul|strong="H7586"\w*, \w que|strong="H0834"\w* \add tinha dado à\add* \w luz|strong="H3205"\w* \w a Adriel|strong="H5741"\w*, \w filho|strong="H1121"\w* \w de Barzilai|strong="H1271"\w*, \w o meolatita|strong="H4259"\w*.\x - \xo 21:8 \xt 1SA 18:19; 2SA 3:7; 1SA 24:21; JER 32:18; PRO 17:13; PSA 109:14\x*
\v 9 \w E os entregou|strong="H5414"\w* \w na mão|strong="H3027"\w* \w dos gibeonitas|strong="H1393"\w*, \w e os enforcaram|strong="H3363"\w* \w no monte|strong="H2022"\w* \w diante|strong="H6440"\w* \w do SENHOR|strong="H3068"\w*; \w e caíram|strong="H5307"\w* \w os sete|strong="H7651"\w*\f + \fr 21.9: \ft Variante: a Ketiv tem "sete vezes" (שִׁבְעָתַיִם); o texto principal traz "os sete deles" (שְׁבַעְתָּם); sentido ajustado ao contexto\f* \w juntos|strong="H3162"\w*; \w e eles|strong="H1992"\w* \add foram\add* \w mortos|strong="H4191"\w* \w nos dias|strong="H3117"\w* \w da sega|strong="H7105"\w* \w primeiros|strong="H7223"\w*, \w no começo|strong="H8462"\w*\f + \fr 21.9: \ft Variante: a Ketiv apresenta a mesma forma com grafia ligeiramente diferente; sem alteração de sentido\f* \w da sega|strong="H7105"\w* \w da cevada|strong="H8184"\w*.\x - \xo 21:9 \xt RUT 1:22; 2SA 3:7; GAL 3:13; JER 32:18; PRO 17:13; PSA 109:14\x*
