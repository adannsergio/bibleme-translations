\v 5 \w E contaram|strong="H5046"\w* \w a David|strong="H1732"\w*; \w e enviou|strong="H7971"\w* \w ao seu encontro|strong="H7122"\w*, \w pois|strong="H3588"\w* \w estavam|strong="H1961"\w* \w os homens|strong="H0582"\w* \w muitíssimo humilhados|strong="H3637,H3966"\w*. \w E disse|strong="H0559"\w* \w o rei|strong="H4428"\w*: "\w Ficai|strong="H3427"\w* \w em Jericó|strong="H3405"\w* \w até|strong="H5704"\w* \w que cresça|strong="H6779"\w* \w a vossa barba|strong="H2206"\w*, \w e voltareis|strong="H7725"\w*."\x - \xo 10:5 \xt 1CH 19:5; 1CH 19:4; JER 40:14; 1CH 19:1; EPH 6:20; GEN 22:17\x*
