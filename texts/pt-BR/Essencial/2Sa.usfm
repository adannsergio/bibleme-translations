\v 12 \w E Amasa|strong="H6021"\w* \w estava|strong="H1556"\w* \w se revolvendo|strong="H1556"\w* \w no sangue|strong="H1818"\w*, \w no meio|strong="H8432"\w* \w do caminho|strong="H4546"\w*. \w E viu|strong="H7200"\w* \w aquele homem|strong="H0376"\w* \w que|strong="H3588"\w* \w se detinha|strong="H5975"\w* \w todo|strong="H3605"\w* \w o povo|strong="H5971"\w*, \w e desviou|strong="H5437"\w* \w a Amasa|strong="H6021"\w* \w do caminho|strong="H4480,H4546"\w* \w para o campo|strong="H7704"\w*, \w e lançou|strong="H7993"\w* \w sobre ele|strong="H5921"\w* \w uma capa|strong="H0899"\w*, \w assim como|strong="H0834"\w* \w viu|strong="H7200"\w* \add que\add* \w todo|strong="H3605"\w* \w o que chegava|strong="H0935"\w* \w sobre ele|strong="H5921"\w* \w se detinha|strong="H5975"\w*.\x - \xo 20:12 \xt 2SA 17:25; PRO 24:21-22; PSA 9:16\x*
\v 13 \w Assim que|strong="H0834"\w* \w tinha sido removido|strong="H3014"\w* \w do caminho|strong="H4480,H4546"\w*, \w passava|strong="H5674"\w* \w todo|strong="H3605"\w* \w homem|strong="H0376"\w* \w após Joabe|strong="H0310,H3097"\w*, \w para perseguir|strong="H7291,H0310"\w* \w Seba|strong="H7652"\w*, \w filho|strong="H1121"\w* \w de Bicri|strong="H1075"\w*.\x - \xo 20:13 \xt 2SA 20:7; 2SA 20:2; 2SA 20:21; 2SA 20:10; 2SA 20:11\x*
\v 14 \w E ele passou|strong="H5674"\w* \w por todas|strong="H3605"\w* \w as tribos|strong="H7626"\w* \w de Israel|strong="H3478"\w*, \w até Abel|strong="H0062"\w*-\w Bete|strong="H0062"\w*-\w Maaca|strong="H0062"\w*, \w e todos|strong="H3605"\w* \w os beritas|strong="H1276"\w*; \w e se reuniram|strong="H6950"\w*\f + \fr 20.14: \ft Variante: a Ketiv tem "e foram pouco estimados" (וַיִּקָּלְהוּ); o texto principal traz "e se reuniram" (וַיִּקָּהֲלוּ); sentido ajustado ao contexto\f*, \w e foram|strong="H0935"\w* \w também|strong="H0637"\w* \w após ele|strong="H0310"\w*.\x - \xo 20:14 \xt 1KI 15:20; 2KI 15:29; EZK 20:37\x*
\v 15 \w E vieram|strong="H0935"\w*, \w e a sitiaram|strong="H6696,H5921"\w* \w em Abel|strong="H0062"\w*-\w Bete|strong="H0062"\w*-\w Maaca|strong="H0062"\w*, \w e levantaram|strong="H8210"\w* \w um aterro|strong="H5550"\w* \w contra a cidade|strong="H0413,H5892"\w*, \w e este se apoiou|strong="H5975"\w* \w junto ao baluarte|strong="H2426"\w*; \w e todo|strong="H3605"\w* \w o povo|strong="H5971"\w* \w que|strong="H0834"\w* \w estava com|strong="H0854"\w* \w Joabe|strong="H3097"\w* \w procurava|strong="H7843"\w* \w derrubar|strong="H5307"\w* \w o muro|strong="H2346"\w*.\x - \xo 20:15 \xt 2KI 19:32; 1KI 15:20; 2KI 15:29; ECC 9:14; JER 32:24\x*
\v 16 \w E gritou|strong="H7121"\w* \w uma mulher|strong="H0802"\w* \w sábia|strong="H2450"\w* \w de dentro|strong="H4480"\w* \w da cidade|strong="H5892"\w*: "\w Ouvi|strong="H8085"\w*, \w ouvi|strong="H8085"\w*! \w Dizei|strong="H0559"\w*, \w por favor|strong="H4994"\w*, \w a|strong="H0413"\w* \w Joabe|strong="H3097"\w*: '\w Chega-te|strong="H7126"\w* \w até|strong="H5704"\w* \w aqui|strong="H2008"\w*, \w e falarei|strong="H1696"\w* \w contigo|strong="H0413"\w*.'"\x - \xo 20:16 \xt 2SA 14:2; PRO 31:26; ECC 9:14; 1SA 25:3; 1SA 25:32-33\x*
\v 17 \w E se aproximou|strong="H7126"\w* \w dela|strong="H0413"\w*; \w e disse|strong="H0559"\w* \w a mulher|strong="H0802"\w*: \add "¿És\add* \w tu|strong="H0859"\w* \w Joabe|strong="H3097"\w*?"\w E disse|strong="H0559"\w*: "\w Eu|strong="H0589"\w*."\w E disse|strong="H0559"\w* \w a ele|strong="H9033"\w*: "\w Ouve|strong="H8085"\w* \w as palavras|strong="H1697"\w* \w da tua serva|strong="H0519"\w*."\w E disse|strong="H0559"\w*: "\w Estou ouvindo|strong="H8085,H0595"\w*."\x - \xo 20:17 \xt PRO 31:26; ECC 9:14; GEN 30:3\x*
\v 18 \w E disse|strong="H0559"\w*, \w dizendo|strong="H0559"\w*: "\w Costumavam dizer|strong="H1696,H7223"\w* \w antigamente|strong="H7223"\w*: '\w Pergunte-se|strong="H0559,H7592"\w* \w em Abel|strong="H0059"\w*'; \w e assim|strong="H3651"\w* \w se resolvia|strong="H8552"\w*."\x - \xo 20:18 \xt PRO 31:26; ECC 9:14; ECC 7:10\x*
\v 19 "\w Eu|strong="H0595"\w* \w sou pacífica|strong="H7999"\w* \w e fiel|strong="H0529"\w* \w em Israel|strong="H3478"\w*; \w tu|strong="H0859"\w* \w procuras|strong="H1245"\w* \w matar|strong="H4191"\w* \w uma cidade|strong="H5892"\w* \w e mãe|strong="H0517"\w* \w em Israel|strong="H3478"\w*; \w por que|strong="H4100"\w* \w tragarias|strong="H1104"\w* \w a herança|strong="H5159"\w* \w do SENHOR|strong="H3068"\w*?"\x - \xo 20:19 \xt PRO 31:26; 1SA 26:19; ROM 12:18; 1TI 2:2; 2SA 21:3; 2CO 2:7\x*
\v 20 \w E respondeu|strong="H6030"\w* \w Joabe|strong="H3097"\w*, \w e disse|strong="H0559"\w*: "\w Nunca|strong="H2486"\w*, \w nunca|strong="H2486"\w* \w me aconteça|strong="H9030"\w*, \w que|strong="H0518"\w* \w destrua|strong="H1104"\w*, \w nem que|strong="H0518"\w* \w arruíne|strong="H7843"\w*."\x - \xo 20:20 \xt PRO 31:26; LUK 6:41; 2CO 2:7; ECC 9:14\x*
\v 21 \w Não|strong="H3808"\w* \add é\add* \w assim|strong="H3651"\w* \w o assunto|strong="H1697"\w*; \w mas|strong="H3588"\w* \w um homem|strong="H0376"\w* \w do monte|strong="H2022"\w* \w de Efraim|strong="H0669"\w*, \w de nome|strong="H8034"\w* \w Seba|strong="H7652"\w*, \w filho|strong="H1121"\w* \w de Bicri|strong="H1075"\w*, \w levantou|strong="H5375"\w* \w a sua mão|strong="H3027"\w* \w contra o rei|strong="H4428"\w*, \w contra David|strong="H1732"\w*; \w dai-me|strong="H5414,H0853"\w* \w a ele|strong="H0905"\w*, \w e me retirarei|strong="H1980"\w* \w da cidade|strong="H5921,H5892"\w*. \w E disse|strong="H0559"\w* \w a mulher|strong="H0802"\w* \w a|strong="H0413"\w* \w Joabe|strong="H3097"\w*: "\w Eis|strong="H2009"\w* \add que\add* \w a sua cabeça|strong="H7218"\w* \w te será lançada|strong="H7993,H0413"\w* \w por detrás|strong="H1157"\w* \w do muro|strong="H2346"\w*."\x - \xo 20:21 \xt 2SA 20:13; PRO 31:26; JDG 4:9; LUK 6:41; 1KI 11:26; ECC 9:14\x*
\v 22 \w E foi|strong="H0935"\w* \w a mulher|strong="H0802"\w* \w a|strong="H0413"\w* \w todo|strong="H3605"\w* \w o povo|strong="H5971"\w* \w com a sua sabedoria|strong="H2451"\w*, \w e cortaram|strong="H3772"\w* \w a cabeça|strong="H7218"\w* \w de Seba|strong="H7652"\w*, \w filho|strong="H1121"\w* \w de Bicri|strong="H1075"\w*, \w e a lançaram|strong="H7993"\w* \w a|strong="H0413"\w* \w Joabe|strong="H3097"\w*. \w E tocou|strong="H8628"\w* \w a trombeta|strong="H7782"\w*, \w e se espalharam|strong="H6327"\w* \w de sobre|strong="H5921"\w* \w a cidade|strong="H5892"\w*, \add cada\add* \w um|strong="H0376"\w* \w para a sua tenda|strong="H0168"\w*; \w e Joabe|strong="H3097"\w* \w voltou|strong="H7725"\w* \w a Jerusalém|strong="H3389"\w*, \w a|strong="H0413"\w* \w o rei|strong="H4428"\w*.\x - \xo 20:22 \xt 2SA 20:1; 2SA 18:16; PRO 31:26; JDG 4:9; ECC 7:19; ECC 9:14\x*
\v 23 \w E Joabe|strong="H3097"\w* \w estava|strong="H0413"\w* \w sobre|strong="H0413"\w* \w todo|strong="H3605"\w* \w o exército|strong="H6635"\w* \w de Israel|strong="H3478"\w*; \w e Benaia|strong="H1141"\w*, \w filho|strong="H1121"\w* \w de Joiada|strong="H3077"\w*, \w estava|strong="H5921"\w* \w sobre|strong="H5921"\w* \w os queretes|strong="H3774"\w*\f + \fr 20.23: \ft Variante: a Ketiv tem "os caritas" (הַכָּרִי, povo distinto); a Qere, que seguimos, "os queretes" (הַכְּרֵתִי); ver nota em 2Sa.8.18\f* \w e sobre|strong="H5921"\w* \w os peletes|strong="H6432"\w*.\x - \xo 20:23 \xt 2SA 8:18; 1CH 18:17; 1KI 1:38; 2SA 20:7; 2SA 15:18; 1KI 1:44\x*
\v 24 \w E Adorão|strong="H0151"\w* \w estava|strong="H5921"\w* \w sobre|strong="H5921"\w* \w o trabalho forçado|strong="H4522"\w*; \w e Josafá|strong="H3092"\w*, \w filho|strong="H1121"\w* \w de Ailude|strong="H0286"\w*, \w era cronista|strong="H2142"\w*.\x - \xo 20:24 \xt 1KI 4:3; 2SA 8:16; 1KI 12:18; 1CH 18:15; 1KI 4:6\x*
\v 25 \w E Seva|strong="H7724"\w*\f + \fr 20.25: \ft Variante: a Ketiv tem "Seia" (שֵׁיָא); a Qere, que seguimos, "Seva" (שְׁוָא)\f* \w era secretário|strong="H5608"\w*; \w e Zadoque|strong="H6659"\w* \w e Abiatar|strong="H0054"\w* \w eram sacerdotes|strong="H3548"\w*.\x - \xo 20:25 \xt 1CH 18:16; 2SA 8:17; 1KI 4:4; 2SA 15:35; 2SA 15:24; 2SA 15:29\x*
\v 26 \w E também|strong="H1571"\w* \w Ira|strong="H5896"\w*, \w o jairita|strong="H2972"\w*, \w era|strong="H1961"\w* \w sacerdote|strong="H3548"\w* \w de David|strong="H1732"\w*.\x - \xo 20:26 \xt 2SA 23:38; EXO 2:14; ISA 66:21\x*
