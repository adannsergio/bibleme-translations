\v 8 \w Estes|strong="H0428"\w* \w são os nomes|strong="H8034"\w* \w dos valentes|strong="H1368"\w* \w que|strong="H0834"\w* \w tinha David|strong="H1732"\w*: \w Jose|strong="H3429"\w*-\w Besebe|strong="H3429"\w*, \w o taquemonita|strong="H8461"\w*, \w chefe|strong="H7218"\w* \w dos três|strong="H7991"\w*; \w ele|strong="H1931"\w* \w era Adino|strong="H5722"\w*, \w o eznita|strong="H6112"\w*\f + \fr 23.8: \ft Variante: a Ketiv tem "a sua lança" (הָעֶצְנוֹ); o texto principal traz o gentílico "o eznita" (הָעֶצְנִי); sentido ajustado ao contexto\f*, \w que matou|strong="H5921"\w* \w oitocentos|strong="H8083,H3967"\w* \w homens|strong="H2491"\w* \w de uma só vez|strong="H6471,H0259"\w*\f + \fr 23.8: \ft Variante: a Ketiv apresenta a mesma forma com grafia ligeiramente diferente; sem alteração de sentido\f*.\x - \xo 23:8 \xt JOS 23:10; 1CH 11:11; 1CH 11:10; 1CH 27:2; 1KI 1:8; 1CH 27:32\x*
\v 9 \w E depois dele|strong="H0310"\w* \w estava Eleazar|strong="H0499"\w*, \w filho|strong="H1121"\w* \w de Dodô|strong="H1734"\w*\f + \fr 23.9: \ft Variante: a Ketiv tem "Dodi" (דֹּדִי); a Qere, que seguimos, "Dodô" (דּוֹדוֹ)\f*, \w filho|strong="H1121"\w* \w de Aoí|strong="H0266"\w*, \w um dos três|strong="H7969"\w* \w valentes|strong="H1368"\w*\f + \fr 23.9: \ft Variante: a Ketiv apresenta a mesma forma consonantal, sem alteração de sentido\f*, \w que estavam com|strong="H5973,H1732"\w* \w David|strong="H1732"\w*, \w quando desafiaram|strong="H2778"\w* \w os filisteus|strong="H6430"\w* \w que|strong="H0622"\w* \w se tinham reunido|strong="H0622"\w* \w ali|strong="H8033"\w* \w para a batalha|strong="H4421"\w*, \w e subiram|strong="H5927"\w* \w os homens|strong="H0376"\w* \w de Israel|strong="H3478"\w*.\x - \xo 23:9 \xt 1CH 11:12; 1CH 27:4; 1KI 1:8; 1CH 11:10; 1SA 17:26; NUM 23:7\x*
\v 10 \w Ele|strong="H1931"\w* \add se\add* \w levantou|strong="H6965"\w*, \w e feriu|strong="H5221"\w* \w entre os filisteus|strong="H6430"\w*, \w até|strong="H5704"\w* \w que|strong="H3588"\w* \w se cansou|strong="H3021"\w* \w a sua mão|strong="H3027"\w*, \w e se apegou|strong="H1692"\w* \w a sua mão|strong="H3027"\w* \w a|strong="H0413"\w* \w a espada|strong="H2719"\w*; \w e deu|strong="H6213"\w* \w o SENHOR|strong="H3068"\w* \w uma vitória|strong="H8668"\w* \w grande|strong="H1419"\w* \w naquele dia|strong="H3117,H1931"\w*; \w e o povo|strong="H5971"\w* \w voltou|strong="H7725"\w* \w após ele|strong="H0310"\w*, \w só|strong="H0389"\w* \w para despojar|strong="H6584"\w* \add os mortos\add*.\x - \xo 23:10 \xt 2SA 23:12; 1SA 19:5; 1KI 1:8; 1CH 11:10; 1SA 11:13\x*
