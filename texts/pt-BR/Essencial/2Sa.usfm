\v 32 \w E disse|strong="H0559"\w* \w Absalão|strong="H0053"\w* \w a|strong="H0413"\w* \w Joabe|strong="H3097"\w*: "\w Eis|strong="H2009"\w* \add que\add* \w te enviei|strong="H7971,H0413"\w*, \w dizendo|strong="H0559"\w*: '\w Vem|strong="H0935"\w* \w aqui|strong="H2008"\w*, \w para que eu te envie|strong="H7971,H0853"\w* \w a|strong="H0413"\w* \w o rei|strong="H4428"\w*, \w dizendo|strong="H0559"\w*: \add Por\add* \w que|strong="H4100"\w* \w vim|strong="H0935"\w* \w de Gesur|strong="H1650"\w*? \w Melhor seria|strong="H2896,H9030"\w* \w que eu|strong="H5750,H0589"\w* \w ainda estivesse|strong="H5750"\w* \w ali|strong="H8033"\w*.' \w E agora|strong="H6258"\w*, \w deixa-me ver|strong="H7200"\w* \w a face|strong="H6440"\w* \w do rei|strong="H4428"\w*; \w e se|strong="H0518"\w* \w há|strong="H3426"\w* \add em\add* \w mim|strong="H9030"\w* \w iniquidade|strong="H5771"\w*, \w que ele me mate|strong="H4191"\w*."\x - \xo 14:32 \xt 2SA 14:23; 1SA 20:8; 2SA 13:37; EXO 14:12; PRO 28:13\x*
\v 33 \w E veio|strong="H0935"\w* \w Joabe|strong="H3097"\w* \w a|strong="H0413"\w* \w o rei|strong="H4428"\w*, \w e lhe contou|strong="H5046,H9033"\w*. \w E chamou|strong="H7121"\w* \w a|strong="H0413"\w* \w Absalão|strong="H0053"\w*, \w e veio|strong="H0935"\w* \w a|strong="H0413"\w* \w o rei|strong="H4428"\w*, \w e se prostrou|strong="H7812,H9033"\w* \w com o rosto|strong="H5921,H0639"\w* \w em terra|strong="H0776"\w* \w diante|strong="H6440"\w* \w do rei|strong="H4428"\w*; \w e beijou|strong="H5401"\w* \w o rei|strong="H4428"\w* \w a Absalão|strong="H0053"\w*.\x - \xo 14:33 \xt 2SA 15:5; LUK 15:20; GEN 33:4\x*
