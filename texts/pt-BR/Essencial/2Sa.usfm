\v 1 \w E aconteceu|strong="H1961"\w* \w depois disso|strong="H0310,H3651"\w*, \w que fez|strong="H6213"\w* \w para si|strong="H9033"\w* \w Absalão|strong="H0053"\w* \w um carro|strong="H4818"\w* \w e cavalos|strong="H5483"\w*, \w e cinquenta|strong="H2572"\w* \w homens|strong="H0376"\w* \w que corriam|strong="H7323"\w* \w adiante dele|strong="H6440"\w*.\x - \xo 15:1 \xt 1SA 8:11; 1KI 1:5; PSA 3:1; 2SA 12:11; PRO 17:19; PSA 20:7\x*
\v 2 \w E se levantava de madrugada|strong="H7925"\w* \w Absalão|strong="H0053"\w*, \w e ficava|strong="H5975"\w* \w junto|strong="H5921,H3027,H1870"\w* \w ao caminho|strong="H1870"\w* \w da porta|strong="H8179"\w*; \w e acontecia|strong="H1961"\w* \add que\add* \w todo|strong="H3605"\w* \w o homem|strong="H0376"\w* \w que|strong="H0834"\w* \w tinha|strong="H1961,H9033"\w* \w uma demanda|strong="H7379"\w* \w para vir|strong="H0935"\w* \w a|strong="H0413"\w* \w o rei|strong="H4428"\w* \w a juízo|strong="H4941"\w*, \w e o chamava|strong="H7121,H0053,H0413"\w*, \w e dizia|strong="H0559"\w*: "\w De que|strong="H0335,H2088"\w* \w cidade|strong="H5892"\w* \add és\add* \w tu|strong="H0859"\w*?"\w E dizia|strong="H0559"\w*: \add "De\add* \w uma|strong="H0259"\w* \w das tribos|strong="H7626"\w* \w de Israel|strong="H3478"\w* \w é o teu servo|strong="H5650"\w*."\x - \xo 15:2 \xt JAS 3:6; PSA 3:1; 1KI 13:12\x*
\v 3 \w E lhe dizia|strong="H0559,H0413"\w* \w Absalão|strong="H0053"\w*: "\w Vê|strong="H7200"\w*, \w a tua causa|strong="H1697"\w* \w é boa|strong="H2896"\w* \w e justa|strong="H5228"\w*; \w mas não|strong="H0369"\w* \w tens quem te ouça|strong="H8085,H9031"\w* \w da parte|strong="H0854"\w* \w do rei|strong="H4428"\w*."\x - \xo 15:3 \xt JAS 3:6; PSA 3:1; EXO 18:16; PSA 109:2\x*
\v 4 \w E dizia|strong="H0559"\w* \w Absalão|strong="H0053"\w*: "\w Quem|strong="H4310"\w* \w me fizesse|strong="H7760"\w* \w juiz|strong="H8199"\w* \w na terra|strong="H0776"\w*? \w E a mim|strong="H5921"\w* \w viria|strong="H0935"\w* \w todo|strong="H3605"\w* \w homem|strong="H0376"\w* \w que|strong="H0834"\w* \w tivesse|strong="H1961,H9033"\w* \w demanda|strong="H7379"\w* \w e questão|strong="H4941"\w*, \w e eu lhe faria justiça|strong="H6663"\w*."\x - \xo 15:4 \xt DEU 25:1; JDG 9:29; 1SA 8:3; JAS 3:6; PSA 3:1; 2PE 2:19\x*
