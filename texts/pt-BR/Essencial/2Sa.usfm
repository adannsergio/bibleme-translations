\c 11
\p
\v 1 \w E aconteceu|strong="H1961"\w*, \w no retorno|strong="H8666"\w* \w do ano|strong="H8141"\w*, \w ao tempo|strong="H6256"\w* \w da saída|strong="H3318"\w* \w dos mensageiros|strong="H4397"\w*\f + \fr 11.1: \ft Variante: a forma registrada traz "mensageiros" (מַלְאָכִים); outra leitura, seguida por muitos manuscritos, pela LXX, pela Vulgata e por 1Cr 20.1, traz "reis" (מְלָכִים) — troca de uma letra —, no sentido de "ao tempo em que os reis saem à guerra"; mantemos aqui "mensageiros"\f*, \w que enviou|strong="H7971"\w* \w David|strong="H1732"\w* \w Joabe|strong="H3097"\w*, \w e|strong="H0853"\w* \w os seus servos|strong="H5650"\w* \w com ele|strong="H5973"\w*, \w e|strong="H0853"\w* \w todo|strong="H3605"\w* \w o Israel|strong="H3478"\w*; \w e destruíram|strong="H7843"\w* \w os filhos|strong="H1121"\w* \w de Amom|strong="H5983"\w*, \w e sitiaram|strong="H6696,H5921"\w* \w Rabá|strong="H7237"\w*. \w E David|strong="H1732"\w* \w ficava|strong="H3427"\w* \w em Jerusalém|strong="H3389"\w*.\x - \xo 11:1 \xt 1CH 20:1; EZK 21:20; 1KI 20:22; 2CH 36:10; 1KI 20:26; 1SA 18:30\x*
\v 2 \w E aconteceu|strong="H1961"\w*, \w ao tempo|strong="H6256"\w* \w da tarde|strong="H6153"\w*, \w que se levantou|strong="H6965"\w* \w David|strong="H1732"\w* \w da sua cama|strong="H5921,H4904"\w*, \w e andava|strong="H1980"\w* \w pelo terraço|strong="H5921,H1406"\w* \w da casa|strong="H1004"\w* \w do rei|strong="H4428"\w*; \w e viu|strong="H7200"\w* \w uma mulher|strong="H0802"\w* \w que se banhava|strong="H7364"\w* \w sobre o terraço|strong="H5921,H1406"\w*; \w e a mulher|strong="H0802"\w* \w era|strong="H2896"\w* \w de aparência|strong="H4758"\w* \w muito bela|strong="H3966"\w*.\x - \xo 11:2 \xt JOB 31:1; PSA 51:1; MAT 5:28; PSA 101:3; GEN 3:6; PSA 119:37\x*
\v 3 \w E enviou|strong="H7971"\w* \w David|strong="H1732"\w*, \w e indagou|strong="H1875"\w* \w sobre a mulher|strong="H0802"\w*, \w e disse|strong="H0559"\w*: "¿\w Não|strong="H3808"\w* \add é\add* \w esta|strong="H2063"\w* \w Bate|strong="H1339"\w*-\w Seba|strong="H1339"\w*, \w filha|strong="H1323"\w* \w de Eliã|strong="H0463"\w*, \w mulher|strong="H0802"\w* \w de Urias|strong="H0223"\w*, \w o hitita|strong="H2850"\w*?"\x - \xo 11:3 \xt 2SA 23:39; 1KI 15:5; JOB 31:1; PSA 101:3; 1CH 3:5; 2PE 2:14\x*
\v 4 \w E enviou|strong="H7971"\w* \w David|strong="H1732"\w* \w mensageiros|strong="H4397"\w*, \w e a tomou|strong="H3947"\w*; \w e ela veio|strong="H0935"\w* \add a\add* \w ele|strong="H0413"\w*, \w e se deitou|strong="H7901"\w* \w com ela|strong="H5973"\w* — \w e ela|strong="H1931"\w* \w se estava purificando|strong="H6942"\w* \w da sua impureza|strong="H2932"\w* —; \w e ela voltou|strong="H7725"\w* \w para|strong="H0413"\w* \w a sua casa|strong="H1004"\w*.\x - \xo 11:4 \xt JOB 31:1; JAS 1:14-15; LEV 18:19; 2PE 2:14; PSA 119:67; PSA 51:1-19\x*
\v 5 \w E concebeu|strong="H2029"\w* \w a mulher|strong="H0802"\w*, \w e enviou|strong="H7971"\w* \w e contou|strong="H5046"\w* \w a David|strong="H1732"\w*, \w e disse|strong="H0559"\w*: "\w Grávida|strong="H2030"\w* \add estou\add* \w eu|strong="H0595"\w*."\x - \xo 11:5 \xt DEU 22:22; PSA 119:67; 2SA 12:12; PRO 6:25; PRO 6:34\x*
\v 6 \w E enviou|strong="H7971"\w* \w David|strong="H1732"\w* \w a|strong="H0413"\w* \w Joabe|strong="H3097"\w*: "\w Envia-me|strong="H7971,H0413"\w* \w Urias|strong="H0223"\w*, \w o hitita|strong="H2850"\w*."\w E enviou|strong="H7971"\w* \w Joabe|strong="H3097"\w* \w Urias|strong="H0223"\w* \w a|strong="H0413"\w* \w David|strong="H1732"\w*.\x - \xo 11:6 \xt 2SA 23:39; 2SA 11:17; 1CH 11:41; 2SA 11:24; 1KI 15:5; 2SA 11:14\x*
\v 7 \w E veio|strong="H0935"\w* \w Urias|strong="H0223"\w* \add a\add* \w ele|strong="H0413"\w*; \w e perguntou|strong="H7592"\w* \w David|strong="H1732"\w* \w pela saúde|strong="H7965"\w* \w de Joabe|strong="H3097"\w*, \w e pela saúde|strong="H7965"\w* \w do povo|strong="H5971"\w*, \w e pela saúde|strong="H7965"\w* \w da guerra|strong="H4421"\w*.\x - \xo 11:7 \xt 2SA 11:14; 2SA 11:16; PSA 119:67; 1CH 11:41; 1SA 17:22; 2SA 12:12\x*
\v 8 \w E disse|strong="H0559"\w* \w David|strong="H1732"\w* \w a Urias|strong="H0223"\w*: "\w Desce|strong="H3381"\w* \w à tua casa|strong="H1004"\w*, \w e lava|strong="H7364"\w* \w os teus pés|strong="H7272"\w*."\w E saiu|strong="H3318"\w* \w Urias|strong="H0223"\w* \w da casa|strong="H1004"\w* \w do rei|strong="H4428"\w*; \w e saiu|strong="H3318"\w* \w após ele|strong="H0310"\w* \w um presente|strong="H4864"\w* \w do rei|strong="H4428"\w*.\x - \xo 11:8 \xt PSA 119:67; GEN 18:4; 1CH 11:41; 2SA 12:12; GEN 43:34\x*
\v 9 \w E se deitou|strong="H7901"\w* \w Urias|strong="H0223"\w* \w à entrada|strong="H6607"\w* \w da casa|strong="H1004"\w* \w do rei|strong="H4428"\w*, \w com todos|strong="H0854,H3605"\w* \w os servos|strong="H5650"\w* \w do seu senhor|strong="H0113"\w*; \w e não|strong="H3808"\w* \w desceu|strong="H3381"\w* \w a|strong="H0413"\w* \w sua casa|strong="H1004"\w*.\x - \xo 11:9 \xt PSA 119:67; 1CH 11:41; 2SA 12:12; JOB 5:12-14; PRO 21:30\x*
\v 10 \w E contaram|strong="H5046"\w* \w a David|strong="H1732"\w*, \w dizendo|strong="H0559"\w*: "\w Não|strong="H3808"\w* \w desceu|strong="H3381"\w* \w Urias|strong="H0223"\w* \w a|strong="H0413"\w* \w sua casa|strong="H1004"\w*."\w E disse|strong="H0559"\w* \w David|strong="H1732"\w* \w a Urias|strong="H0413,H0223"\w*: "¿\w Não vens tu de uma viagem|strong="H3808,H1870,H0859,H0935"\w*? \w Por que|strong="H4069"\w* \w não|strong="H3808"\w* \w desceste|strong="H3381"\w* \w a|strong="H0413"\w* \w tua casa|strong="H1004"\w*?"\x - \xo 11:10 \xt PSA 119:67; 1CH 11:41; 2SA 12:12\x*
\v 11 \w E disse|strong="H0559"\w* \w Urias|strong="H0223"\w* \w a|strong="H0413"\w* \w David|strong="H1732"\w*: "\w A arca|strong="H0727"\w*, \w e Israel|strong="H3478"\w*, \w e Judá|strong="H3063"\w*, \w habitam|strong="H3427"\w* \w em tendas|strong="H5521"\w*; \w e o meu senhor|strong="H0113"\w* \w Joabe|strong="H3097"\w*, \w e os servos|strong="H5650"\w* \w do meu senhor|strong="H0113"\w*, \w estão acampados|strong="H2583"\w* \w sobre a face|strong="H5921,H6440"\w* \w do campo|strong="H7704"\w*; \w e eu|strong="H0589"\w*, \w iria|strong="H0935"\w* \add eu\add* \w à minha casa|strong="H0413,H1004"\w* \w para comer|strong="H0398"\w*, \w e beber|strong="H8354"\w*, \w e me deitar|strong="H7901"\w* \w com a minha mulher|strong="H5973,H0802"\w*? \w Pela tua vida|strong="H2416"\w* \w e pela vida|strong="H2416"\w* \w da tua alma|strong="H5315"\w*, \w não farei|strong="H0518,H6213"\w*\f + \fr 11.11: \ft Lit.: lit. "se eu fizer esta coisa" — fórmula idiomática de juramento negativo, em que o "se" implica a maldição que recairia sobre quem jura\f* \w esta coisa|strong="H1697,H2088"\w*."\x - \xo 11:11 \xt 2SA 7:2; PSA 119:67; 2SA 20:6; 2SA 7:6; 1CH 11:41; 1SA 1:26\x*
\v 12 \w E disse|strong="H0559"\w* \w David|strong="H1732"\w* \w a Urias|strong="H0413,H0223"\w*: "\w Fica|strong="H3427"\w* \w aqui|strong="H2088"\w* \w também|strong="H1571"\w* \w hoje|strong="H3117"\w*, \w e amanhã|strong="H4279"\w* \add te deixarei\add* \w ir|strong="H7971"\w*."\w E ficou|strong="H3427"\w* \w Urias|strong="H0223"\w* \w em Jerusalém|strong="H3389"\w* \w naquele dia|strong="H3117,H1931"\w*, \w e no dia seguinte|strong="H4283"\w*.\x - \xo 11:12 \xt PSA 119:67; 1CH 11:41; 2SA 12:12\x*
\v 13 \w E o convidou|strong="H7121,H9033"\w* \w David|strong="H1732"\w*, \w e comeu|strong="H0398"\w* \w diante dele|strong="H6440"\w*, \w e bebeu|strong="H8354"\w*, \w e o embriagou|strong="H7937"\w*; \w e saiu|strong="H3318"\w* \w à tarde|strong="H6153"\w* \w para se deitar|strong="H7901"\w* \w na sua cama|strong="H4904"\w* \w com os servos|strong="H5973,H5650"\w* \w do seu senhor|strong="H0113"\w*; \w e para|strong="H0413"\w* \w a sua casa|strong="H1004"\w* \w não|strong="H3808"\w* \w desceu|strong="H3381"\w*.\x - \xo 11:13 \xt PRO 20:1; PSA 119:67; HAB 2:15; 1CH 11:41; 2SA 12:12; 2SA 13:26\x*
\v 14 \w E aconteceu|strong="H1961"\w*, \w pela manhã|strong="H1242"\w*, \w que escreveu|strong="H3789"\w* \w David|strong="H1732"\w* \w uma carta|strong="H5612"\w* \w a|strong="H0413"\w* \w Joabe|strong="H3097"\w*, \w e a enviou|strong="H7971"\w* \w pela mão|strong="H3027"\w* \w de Urias|strong="H0223"\w*.\x - \xo 11:14 \xt 2SA 11:6; 2SA 11:16; 2SA 11:7; PSA 119:67; 1CH 11:41; 1KI 21:8\x*
\v 15 \w E escreveu|strong="H3789"\w* \w na carta|strong="H5612"\w*, \w dizendo|strong="H0559"\w*: "\w Ponde|strong="H3051"\w* \w Urias|strong="H0223"\w* \w à frente|strong="H0413,H4136,H6440"\w* \w da batalha|strong="H4421"\w* \w mais violenta|strong="H2389"\w*, \w e retirai-vos|strong="H7725"\w* \w de após ele|strong="H0310"\w*, \w para que ele seja ferido|strong="H5221"\w* \w e morra|strong="H4191"\w*."\x - \xo 11:15 \xt 1KI 15:5; 2SA 12:9; PSA 119:67; 1CH 11:41; 2SA 12:12; 2SA 13:26\x*
\v 16 \w E aconteceu|strong="H1961"\w* \add que,\add* \w quando vigiava|strong="H8104"\w* \w Joabe|strong="H3097"\w* \w contra a cidade|strong="H0413,H5892"\w*, \w e pôs|strong="H5414"\w* \w Urias|strong="H0223"\w* \w no lugar|strong="H0413,H4725"\w* \w onde|strong="H0834"\w* \w sabia|strong="H3045"\w* \w que|strong="H3588"\w* \w homens|strong="H0582"\w* \w de força|strong="H2428"\w* \w estavam ali|strong="H8033"\w*.\x - \xo 11:16 \xt 2SA 11:6; 2SA 11:14; 2SA 11:7; 1KI 15:5; PSA 119:67; 1CH 11:41\x*
\v 17 \w E saíram|strong="H3318"\w* \w os homens|strong="H0582"\w* \w da cidade|strong="H5892"\w*, \w e lutaram|strong="H3898"\w* \w com Joabe|strong="H0854,H3097"\w*; \w e caiu|strong="H5307"\w* \w alguém|strong="H4480,H5971"\w* \w dos servos|strong="H5650"\w* \w de David|strong="H1732"\w*; \w e morreu|strong="H4191"\w* \w também|strong="H1571"\w* \w Urias|strong="H0223"\w*, \w o hitita|strong="H2850"\w*.\x - \xo 11:17 \xt 2SA 11:6; 2SA 23:39; 1KI 15:5; 1CH 11:41; 2SA 11:24; PSA 119:67\x*
\v 18 \w E enviou|strong="H7971"\w* \w Joabe|strong="H3097"\w*, \w e contou|strong="H5046"\w* \w a David|strong="H1732"\w* \w todos|strong="H3605"\w* \w os acontecimentos|strong="H1697"\w* \w da guerra|strong="H4421"\w*.\x - \xo 11:18 \xt 2SA 11:22; 1CH 19:14; 2SA 10:13; PSA 119:67; 1CH 11:41\x*
\v 19 \w E ordenou|strong="H6680"\w* \w ao mensageiro|strong="H4397"\w*, \w dizendo|strong="H0559"\w*: "\w Quando terminares|strong="H3615"\w* \w de contar|strong="H1696"\w* \w todos|strong="H3605"\w* \w os acontecimentos|strong="H1697"\w* \w da guerra|strong="H4421"\w* \w ao rei|strong="H0413,H4428"\w*..."\x - \xo 11:19 \xt PSA 119:67; 1CH 11:41; PSA 91:11\x*
\v 20 \w e se|strong="H1961,H0518"\w* \w se levantar|strong="H5927"\w* \w a ira|strong="H2534"\w* \w do rei|strong="H4428"\w*, \w e disser|strong="H0559"\w* \w a ti|strong="H9031"\w*: "\w Por que|strong="H4069"\w* \add vos\add* \w aproximastes|strong="H5066"\w* \w da cidade|strong="H0413,H5892"\w* \w para combater|strong="H3898"\w*? ¿\w Não|strong="H3808"\w* \w sabíeis|strong="H3045"\w* \w que atirariam|strong="H0834,H3384"\w* \w desde o muro|strong="H5921,H2346"\w*?"\x - \xo 11:20 \xt PSA 119:67; 1CH 11:41; 2SA 11:24\x*
\v 21 "¿\w Quem|strong="H4310"\w* \w feriu|strong="H5221"\w* \w Abimeleque|strong="H0040"\w* \w filho|strong="H1121"\w* \w de Jerubesete|strong="H3380"\w*? ¿\w Não|strong="H3808"\w* \w lançou|strong="H7993"\w* \w uma mulher|strong="H0802"\w* \w sobre ele|strong="H5921"\w* \w uma pedra de moinho|strong="H6400,H7393"\w* \w desde o muro|strong="H5921,H2346"\w*, \w e ele morreu|strong="H4191"\w* \w em Tebez|strong="H8405"\w*? \w Por que|strong="H4100"\w* \add vos\add* \w aproximastes|strong="H5066"\w* \w do muro|strong="H0413,H2346"\w*?'-- \w então dirás|strong="H0559"\w*: '\w Também|strong="H1571"\w* \w o teu servo|strong="H5650"\w* \w Urias|strong="H0223"\w*, \w o hitita|strong="H2850"\w*, \w morreu|strong="H4191"\w*.'"\x - \xo 11:21 \xt JDG 9:53; JDG 9:50; PSA 119:67; JDG 6:32; JDG 7:1; 1CH 11:41\x*
\v 22 \w E foi|strong="H1980"\w* \w o mensageiro|strong="H4397"\w*, \w e veio|strong="H0935"\w*, \w e contou|strong="H5046"\w* \w a David|strong="H1732"\w* \w tudo|strong="H3605"\w* \w aquilo para que|strong="H0834"\w* \w o tinha enviado|strong="H7971"\w* \w Joabe|strong="H3097"\w*.\x - \xo 11:22 \xt 2SA 11:18; 2SA 3:26; PSA 119:67; 1CH 11:41\x*
\v 23 \w E disse|strong="H0559"\w* \w o mensageiro|strong="H4397"\w* \w a|strong="H0413"\w* \w David|strong="H1732"\w*: "\w Porque|strong="H3588"\w* \w prevaleceram|strong="H1396"\w* \w sobre nós|strong="H5921"\w* \w os homens|strong="H0582"\w*, \w e saíram|strong="H3318"\w* \w contra nós|strong="H0413"\w* \w ao campo|strong="H7704"\w*; \w e nós estávamos|strong="H1961"\w* \w sobre eles|strong="H5921"\w* \w até|strong="H5704"\w* \w a entrada|strong="H6607"\w* \w da porta|strong="H8179"\w*."\x - \xo 11:23 \xt PSA 119:67; 1CH 11:41; 2KI 10:8\x*
\v 24 \w E atiraram|strong="H3384"\w*\f + \fr 11.24: \ft Variante: a Ketiv tem "e temeram" (וַיִּרְאוּ, de יָרֵא, temer); a Qere, que seguimos, "e atiraram" (וַיֹּרוּ, de יָרָה, atirar)\f* \w os flecheiros|strong="H3384"\w* \w contra os teus servos|strong="H0413,H5650"\w* \w desde o muro|strong="H5921,H2346"\w*, \w e morreram|strong="H4191"\w* \w alguns dos servos|strong="H5650"\w* \w do rei|strong="H4428"\w*, \w e também|strong="H1571"\w* \w o teu servo|strong="H5650"\w* \w Urias|strong="H0223"\w*, \w o hitita|strong="H2850"\w*, \w morreu|strong="H4191"\w*.\x - \xo 11:24 \xt 2SA 23:39; 2SA 11:6; 1CH 11:41; 2SA 11:17; PSA 119:67\x*
\v 25 \w E disse|strong="H0559"\w* \w David|strong="H1732"\w* \w ao mensageiro|strong="H0413,H4397"\w*: "\w Assim|strong="H3541"\w* \w dirás|strong="H0559"\w* \w a|strong="H0413"\w* \w Joabe|strong="H3097"\w*: '\w Não|strong="H0408"\w* \w te seja|strong="H7489"\w* \w penoso|strong="H5869"\w* \w esta coisa|strong="H1697,H2088"\w*, \w pois|strong="H3588"\w* \w assim|strong="H2090"\w* \w e assim|strong="H2088"\w* \w devora|strong="H0398"\w* \w a espada|strong="H2719"\w*; \w reforça|strong="H2388"\w* \w a tua luta|strong="H4421"\w* \w contra a cidade|strong="H0413,H5892"\w*, \w e a derruba|strong="H2040"\w*.' \w E anima-o|strong="H2388"\w*."\x - \xo 11:25 \xt 2SA 14:14; PSA 119:67; 1CH 11:41\x*
\v 26 \w E ouviu|strong="H8085"\w* \w a mulher|strong="H0802"\w* \w de Urias|strong="H0223"\w* \w que|strong="H3588"\w* \add tinha\add* \w morrido|strong="H4191"\w* \w Urias|strong="H0223"\w* \w seu marido|strong="H0376"\w*, \w e lamentou|strong="H5594"\w* \w pelo seu marido|strong="H5921,H1167"\w*.\x - \xo 11:26 \xt PSA 119:67; 1CH 11:41; MAT 1:6\x*
\v 27 \w E passado|strong="H5674"\w* \w o luto|strong="H0060"\w*, \w enviou|strong="H7971"\w* \w David|strong="H1732"\w*, \w e a recolheu|strong="H0622"\w* \w para|strong="H0413"\w* \w a sua casa|strong="H1004"\w*, \w e ela foi|strong="H1961,H9033"\w* \w sua mulher|strong="H0802"\w*, \w e lhe deu à luz|strong="H3205,H9033"\w* \w um filho|strong="H1121"\w*. \w E foi mal|strong="H7489"\w* \w a coisa|strong="H1697"\w* \w que|strong="H0834"\w* \w tinha feito|strong="H6213"\w* \w David|strong="H1732"\w* \w aos olhos|strong="H5869"\w* \w do SENHOR|strong="H3068"\w*.\x - \xo 11:27 \xt 2SA 12:9; EXO 20:14; PSA 119:67; PSA 51:4-5; 1CH 21:7; HEB 13:4\x*
