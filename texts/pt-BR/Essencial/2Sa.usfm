\v 16 \w E irromperam|strong="H1234"\w* \w os três|strong="H7969"\w* \w valentes|strong="H1368"\w* \w pelo acampamento|strong="H4264"\w* \w dos filisteus|strong="H6430"\w*, \w e tiraram|strong="H7579"\w* \w água|strong="H4325"\w* \w do poço|strong="H0877"\w* \w de Belém|strong="H1035"\w*, \w que|strong="H0834"\w* \w está junto à porta|strong="H8179"\w*; \w e a levaram|strong="H5375"\w*, \w e a trouxeram|strong="H0935"\w* \w a|strong="H0413"\w* \w David|strong="H1732"\w*; \w mas não|strong="H3808"\w* \w quis|strong="H0014"\w* \w bebê-la|strong="H8354"\w*, \w e a derramou|strong="H5258,H0853"\w* \w ao SENHOR|strong="H3068"\w*.\x - \xo 23:16 \xt 1CH 11:18; GEN 35:14; 2CO 5:14; 1CH 11:17; 1KI 1:8; 1CH 11:10\x*
\v 17 \w E disse|strong="H0559"\w*: "\w Longe|strong="H2486"\w* \w de mim|strong="H9030"\w*, \w ó SENHOR|strong="H3068"\w*, \w esteja fazer eu|strong="H6213"\w* \w isto|strong="H2063"\w*! \add ¿Não é o\add* \w sangue|strong="H1818"\w* \w dos homens|strong="H0582"\w* \w que arriscaram|strong="H1980"\w* \w a sua vida|strong="H5315"\w*?"\w E não|strong="H3808"\w* \w quis|strong="H0014"\w* \w bebê-la|strong="H8354"\w*. \w Estas coisas|strong="H0428"\w* \w fizeram|strong="H6213"\w* \w os três|strong="H7969"\w* \w valentes|strong="H1368"\w*.\x - \xo 23:17 \xt 1CH 11:19; LEV 17:10; 1KI 1:8; 1CH 11:10\x*
\v 18 \w E Abisai|strong="H0052"\w*, \w irmão|strong="H0251"\w* \w de Joabe|strong="H3097"\w*, \w filho|strong="H1121"\w* \w de Zeruia|strong="H6870"\w*, \w ele|strong="H1931"\w* \w era chefe|strong="H7218"\w* \w dos três|strong="H7969"\w*\f + \fr 23.18: \ft Variante: a Ketiv tem "o terceiro" (הַשְּׁלִשִׁי); o texto principal traz "dos três" (הַשְּׁלֹשָׁה); sentido ajustado ao contexto\f*; \w e ele|strong="H1931"\w* \w brandiu|strong="H5782"\w* \w a sua lança|strong="H2595"\w* \w contra trezentos|strong="H5921,H7969,H3967"\w*, \w e os feriu de morte|strong="H2491"\w*; \w e tinha|strong="H9033"\w* \w um nome|strong="H8034"\w* \w entre os três|strong="H7969"\w*.\x - \xo 23:18 \xt 1CH 11:20; 2SA 18:2; 2SA 10:14; 1KI 1:8; 2SA 10:10; 1CH 11:10\x*
