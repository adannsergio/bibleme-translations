\v 7 \w E ouviu|strong="H8085"\w* \w David|strong="H1732"\w*, \w e enviou|strong="H7971"\w* \w Joabe|strong="H3097"\w*, \w e|strong="H0853"\w* \w todo|strong="H3605"\w* \w o exército|strong="H6635"\w* \w dos valentes|strong="H1368"\w*.\x - \xo 10:7 \xt 1CH 19:8; ECC 3:8; 1CH 19:1; GEN 22:17; GEN 27:29; PSA 48:4\x*
