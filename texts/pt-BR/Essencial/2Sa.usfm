\v 15 \w E viu|strong="H7200"\w* \w Arã|strong="H0758"\w* \w que|strong="H3588"\w* \w tinha sido derrotado|strong="H5062"\w* \w diante de|strong="H6440"\w* \w Israel|strong="H3478"\w*, \w e se reuniram|strong="H0622"\w* \w juntos|strong="H3162"\w*.\x - \xo 10:15 \xt ECC 3:8; 1CH 19:1; GEN 22:17; GEN 27:29; HEB 11:34; PSA 48:4\x*
\v 16 \w E enviou|strong="H7971"\w* \w Hadadezer|strong="H1928"\w*, \w e trouxe|strong="H3318"\w* \w a Arã|strong="H0758"\w* \w que|strong="H0834"\w* \w estava do outro lado|strong="H5676"\w* \w do rio|strong="H5104"\w*; \w e vieram|strong="H0935"\w* \w a Helã|strong="H2431"\w*; \w e Sobaque|strong="H7731"\w*, \w comandante|strong="H8269"\w* \w do exército|strong="H6635"\w* \w de Hadadezer|strong="H1928"\w*, \w ia adiante deles|strong="H6440"\w*.\x - \xo 10:16 \xt 1CH 19:16; ECC 3:8; 2SA 8:3; 1CH 19:1; GEN 22:17; GEN 27:29\x*
\v 17 \w E foi dito|strong="H5046"\w* \w a David|strong="H1732"\w*; \w e reuniu|strong="H0622"\w* \w todo|strong="H3605"\w* \w o Israel|strong="H3478"\w*, \w e passou|strong="H5674"\w* \w o Jordão|strong="H3383"\w*, \w e veio|strong="H0935"\w* \w a Helã|strong="H2431"\w*. \w E se pôs em ordem|strong="H6186"\w* \w Arã|strong="H0758"\w* \w contra David|strong="H7122,H1732"\w*, \w e combateram|strong="H3898"\w* \w com ele|strong="H5973"\w*.\x - \xo 10:17 \xt 1CH 19:17; ECC 3:8; 1CH 19:1; GEN 22:17; GEN 27:29; HEB 11:34\x*
\v 18 \w E fugiu|strong="H5127"\w* \w Arã|strong="H0758"\w* \w diante de|strong="H6440"\w* \w Israel|strong="H3478"\w*; \w e matou|strong="H2026"\w* \w David|strong="H1732"\w* \w de Arã|strong="H0758"\w* \w setecentos|strong="H7651,H3967"\w* \w carros|strong="H7393"\w*, \w e quarenta|strong="H0705"\w* \w mil|strong="H0505"\w* \w cavaleiros|strong="H6571"\w*; \w e|strong="H0853"\w* \w a Sobaque|strong="H7731"\w*, \w comandante|strong="H8269"\w* \w do seu exército|strong="H6635"\w*, \w feriu|strong="H5221"\w*, \w e morreu|strong="H4191"\w* \w ali|strong="H8033"\w*.\x - \xo 10:18 \xt 1CH 19:18; ECC 3:8; PSA 20:7; 1CH 19:1; 1KI 11:24; GEN 22:17\x*
