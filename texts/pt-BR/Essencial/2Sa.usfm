\v 1 \w E tornou a acender-se|strong="H3254"\w* \w a ira|strong="H0639"\w* \w do SENHOR|strong="H3068,H2734"\w* \w contra Israel|strong="H3478"\w*; \w e incitou|strong="H5496"\w* \w David|strong="H1732"\w* \w contra eles|strong="H9038"\w*, \w dizendo|strong="H0559"\w*: "\w Vai|strong="H1980"\w*, \w conta|strong="H4487"\w* \w Israel|strong="H3478"\w* \w e|strong="H0853"\w* \w Judá|strong="H3063"\w*."\x - \xo 24:1 \xt 1CH 21:1; NUM 12:9; 1CH 27:23-24; JAS 1:13-14; 1CH 5:26; 2CH 32:25\x*
