\v 2 \w E disse|strong="H0559"\w* \w David|strong="H1732"\w*: "\w Usarei|strong="H6213"\w* \w de benevolência|strong="H2617"\w* \w com Hanum|strong="H5973,H2586"\w* \w filho|strong="H1121"\w* \w de Naás|strong="H5176"\w*, \w assim como|strong="H0834"\w* \w fez|strong="H6213"\w* \w o seu pai|strong="H0001"\w* \w comigo|strong="H5978"\w* \w de benevolência|strong="H2617"\w*."\w E enviou|strong="H7971"\w* \w David|strong="H1732"\w* \w para o consolar|strong="H5162"\w* \w por meio|strong="H3027"\w* \w dos seus servos|strong="H5650"\w* \w acerca|strong="H0413"\w* \w de seu pai|strong="H0001"\w*; \w e vieram|strong="H0935"\w* \w os servos|strong="H5650"\w* \w de David|strong="H1732"\w* \w à terra|strong="H0776"\w* \w dos filhos|strong="H1121"\w* \w de Amom|strong="H5983"\w*.\x - \xo 10:2 \xt 1CH 19:2; 1CH 19:1; 1SA 12:12; 1SA 11:1; 2SA 17:27; 2SA 2:6\x*
\v 3 \w E disseram|strong="H0559"\w* \w os príncipes|strong="H8269"\w* \w dos filhos|strong="H1121"\w* \w de Amom|strong="H5983"\w* \w a|strong="H0413"\w* \w Hanum|strong="H2586"\w* \w seu senhor|strong="H0113"\w*: "¿\w Honra|strong="H3513"\w* \w David|strong="H1732"\w* \w a teu pai|strong="H0001"\w* \w diante de ti|strong="H5869"\w*, \w porque|strong="H3588"\w* \add te\add* \w enviou|strong="H7971,H9031"\w* \w consoladores|strong="H5162"\w*? ¿\w Não|strong="H3808"\w* \w é por causa|strong="H5668"\w* \w de explorar|strong="H2713"\w* \w a cidade|strong="H5892"\w*, \w e espiá-la|strong="H7270"\w*, \w e destruí-la|strong="H2015"\w*, \w que enviou|strong="H7971"\w* \w David|strong="H1732"\w* \w os seus servos|strong="H5650"\w* \w a ti|strong="H0413"\w*?"\x - \xo 10:3 \xt 1CH 19:3; JER 40:14; 1CH 19:1; EPH 6:20; GEN 22:17; GEN 27:29\x*
