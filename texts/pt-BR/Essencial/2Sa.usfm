\v 1 \w E disse|strong="H0559"\w* \w David|strong="H1732"\w*: "¿\w |strong="H3588"\w* \w Há|strong="H3426"\w* \w ainda|strong="H5750"\w* \w alguém que|strong="H0834"\w* \w restou|strong="H3498"\w* \w da casa|strong="H1004"\w* \w de Saul|strong="H7586"\w*, \w para que eu use|strong="H6213"\w* \w com ele|strong="H5973"\w* \w de benevolência|strong="H2617"\w* \w por amor|strong="H5668"\w* \w a Jônatas|strong="H3083"\w*?"\x - \xo 9:1 \xt 2SA 9:7; 1SA 23:16; 1SA 18:1; 1SA 20:42; MRK 9:41; MAT 25:40\x*
\v 2 \w E a casa|strong="H1004"\w* \w de Saul|strong="H7586"\w* \w tinha um servo|strong="H5650"\w*, \w e o seu nome|strong="H8034"\w* \w era Ziba|strong="H6717"\w*; \w e o chamaram|strong="H7121,H9033"\w* \w a|strong="H0413"\w* \w David|strong="H1732"\w*. \w E disse|strong="H0559"\w* \w o rei|strong="H4428"\w* \add a\add* \w ele|strong="H0413"\w*: "\w Tu és|strong="H0859"\w* \w Ziba|strong="H6717"\w*?"\w E disse|strong="H0559"\w*: "\w Teu servo|strong="H5650"\w*."\x - \xo 9:2 \xt 2SA 9:9; 2SA 19:17; PRO 18:24; PRO 17:17; 2SA 16:1; 1SA 18:3\x*
\v 3 \w E disse|strong="H0559"\w* \w o rei|strong="H4428"\w*: \add "¿Não\add* \w há|strong="H0657"\w* \w ainda|strong="H5750"\w* \w alguém|strong="H0376"\w* \w da casa|strong="H1004"\w* \w de Saul|strong="H7586"\w*, \w para que eu use|strong="H6213"\w* \w com ele|strong="H5973"\w* \w da benevolência|strong="H2617"\w* \w de Deus|strong="H0430"\w*?"\w E disse|strong="H0559"\w* \w Ziba|strong="H6717"\w* \w ao|strong="H0413"\w* \w rei|strong="H4428"\w*: "\w Ainda|strong="H5750"\w* \w há um filho|strong="H1121"\w* \w de Jônatas|strong="H3083"\w*, \w aleijado|strong="H5223"\w* \w de ambos os pés|strong="H7272"\w*."\x - \xo 9:3 \xt 2SA 4:4; PRO 18:24; 2SA 9:7; PRO 17:17; 1SA 20:14; 2SA 2:6\x*
\v 4 \w E disse-lhe|strong="H0559,H9033"\w* \w o rei|strong="H4428"\w*: "\w Onde|strong="H0375"\w* \add está\add* \w ele|strong="H1931"\w*?"\w E disse|strong="H0559"\w* \w Ziba|strong="H6717"\w* \w ao|strong="H0413"\w* \w rei|strong="H4428"\w*: "\w Eis|strong="H2009"\w* \add que\add* \w ele|strong="H1931"\w* \w está na casa|strong="H1004"\w* \w de Maquir|strong="H4353"\w* \w filho|strong="H1121"\w* \w de Amiel|strong="H5988"\w*, \w em Lo|strong="H3810"\w*-\w Debar|strong="H3810"\w*."\x - \xo 9:4 \xt 2SA 17:27; PRO 18:24; PRO 17:17; PHM 1:10; 2SA 16:1\x*
