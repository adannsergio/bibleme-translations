\v 6 \w E veio|strong="H0935"\w* \w Mefibosete|strong="H4648"\w* \w filho|strong="H1121"\w* \w de Jônatas|strong="H3083"\w* \w filho|strong="H1121"\w* \w de Saul|strong="H7586"\w* \w a|strong="H0413"\w* \w David|strong="H1732"\w*, \w e caiu|strong="H5307"\w* \w sobre|strong="H5921"\w* \w o seu rosto|strong="H6440"\w*, \w e se prostrou|strong="H7812"\w*. \w E disse|strong="H0559"\w* \w David|strong="H1732"\w*: "\w Mefibosete|strong="H4648"\w*!"\w E disse|strong="H0559"\w*: "\w Eis|strong="H2009"\w* \w o teu servo|strong="H5650"\w*."\x - \xo 9:6 \xt 2SA 16:4; 2SA 4:4; 2SA 21:7; 2SA 19:24; PRO 18:24; PRO 17:17\x*
\v 7 \w E disse-lhe|strong="H0559,H9033"\w* \w David|strong="H1732"\w*: "\w Não temas|strong="H0408,H3372"\w*, \w pois|strong="H3588"\w* \w certamente|strong="H6213"\w* \w usarei|strong="H6213"\w* \w contigo|strong="H5973"\w* \w de benevolência|strong="H2617"\w* \w por amor|strong="H5668"\w* \w a Jônatas|strong="H3083"\w* \w teu pai|strong="H0001"\w*; \w e te restituirei|strong="H7725,H9031"\w* \w toda|strong="H3605"\w* \w a terra|strong="H7704"\w* \w de Saul|strong="H7586"\w* \w teu pai|strong="H0001"\w*; \w e tu|strong="H0859"\w* \w comerás|strong="H0398"\w* \w pão|strong="H3899"\w* \w à minha mesa|strong="H5921,H7979"\w* \w continuamente|strong="H8548"\w*."\x - \xo 9:7 \xt 2SA 9:1; EXO 25:30; 2KI 25:29; PRO 18:24; 2KI 8:6; MAT 25:40\x*
\v 8 \w E se prostrou|strong="H7812"\w*, \w e disse|strong="H0559"\w*: "\w Que|strong="H4100"\w* \add é\add* \w teu servo|strong="H5650"\w*, \w que|strong="H3588"\w* \add te\add* \w voltasses|strong="H6437"\w* \w para|strong="H0413"\w* \w o cão|strong="H3611"\w* \w morto|strong="H4191"\w* \w que|strong="H0834"\w* \w é como eu|strong="H3644"\w*?"\x - \xo 9:8 \xt 2KI 8:13; PRO 18:24; PRO 17:17; 2SA 16:9; 1SA 17:43; MAT 15:26-27\x*
\v 9 \w E chamou|strong="H7121"\w* \w o rei|strong="H4428"\w* \w a|strong="H0413"\w* \w Ziba|strong="H6717"\w* \w servo|strong="H5288"\w* \w de Saul|strong="H7586"\w*, \w e disse-lhe|strong="H0559,H0413"\w*: "\w Tudo|strong="H3605"\w* \w quanto|strong="H0834"\w* \w pertencia|strong="H1961"\w* \w a Saul|strong="H7586"\w* \w e a toda|strong="H3605"\w* \w a sua casa|strong="H1004"\w*, \add eu\add* \w dei|strong="H5414"\w* \w ao filho|strong="H1121"\w* \w do teu senhor|strong="H0113"\w*."\x - \xo 9:9 \xt 2SA 9:2; 2SA 16:3; 2SA 16:4; 2SA 19:17; 2SA 9:11; PRO 18:24\x*
