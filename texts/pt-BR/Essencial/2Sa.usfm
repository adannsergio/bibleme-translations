\v 1 \w E enviou|strong="H7971"\w* \w o SENHOR|strong="H3068"\w* \w Natã|strong="H5416"\w* \w a|strong="H0413"\w* \w David|strong="H1732"\w*. \w E veio|strong="H0935"\w* \add a\add* \w ele|strong="H0413"\w*, \w e lhe disse|strong="H0559,H9033"\w*: "\w Dois|strong="H8147"\w* \w homens|strong="H0582"\w* \w havia|strong="H1961"\w* \w em uma cidade|strong="H5892,H0259"\w*; \w um|strong="H0259"\w* \add era\add* \w rico|strong="H6223"\w*, \w e outro|strong="H0259"\w* \w pobre|strong="H7326"\w*.\x - \xo 12:1 \xt PRO 22:2; PRO 22:7; PRO 14:20; PRO 18:23; MAT 13:3; 1KI 20:35-41\x*
\v 2 \w Ao rico|strong="H6223"\w* \w pertenciam|strong="H1961"\w* \w rebanhos|strong="H6629"\w* \w e bois|strong="H1241"\w*, \w muitíssimos|strong="H7235,H3966"\w*.\x - \xo 12:2 \xt DEU 8:13; MAT 13:3; 1CH 29:29\x*
\v 3 \w E ao pobre|strong="H7326"\w* \w não|strong="H0369"\w* \w tinha coisa alguma|strong="H3605"\w*, \w exceto|strong="H3588,H0518"\w* \w uma ovelha|strong="H3535"\w* \w pequena|strong="H0259,H6996"\w* \w que|strong="H0834"\w* \add tinha\add* \w comprado|strong="H7069"\w*; \w e a alimentava|strong="H2421"\w*, \w e ela crescia|strong="H1431"\w* \w com ele|strong="H5973"\w* \w e com|strong="H5973"\w* \w os seus filhos|strong="H1121"\w* \w juntamente|strong="H3162"\w*; \w do seu bocado|strong="H6595"\w* \w comia|strong="H0398"\w*, \w e do seu copo|strong="H3563"\w* \w bebia|strong="H8354"\w*, \w e no seu colo|strong="H2436"\w* \w dormia|strong="H7901"\w*; \w e era|strong="H1961"\w* \w para ele|strong="H9033"\w* \w como uma filha|strong="H1323"\w*.\x - \xo 12:3 \xt 1KI 1:2; MAT 13:3; JHN 13:23; 1CH 29:29; 2SA 11:3; MIC 7:5\x*
\v 4 \w E veio|strong="H0935"\w* \w um viajante|strong="H1982"\w* \w ao homem|strong="H0376"\w* \w rico|strong="H6223"\w*, \w e teve pena|strong="H2550"\w* \w de tomar|strong="H3947"\w* \w das suas ovelhas|strong="H6629"\w* \w e dos seus bois|strong="H1241"\w*, \w para preparar|strong="H6213"\w* \w para o viajante|strong="H0732"\w* \w que tinha vindo|strong="H0935"\w* \add a\add* \w ele|strong="H9033"\w*; \w e tomou|strong="H3947"\w* \w a ovelha|strong="H3535"\w* \w do homem|strong="H0376"\w* \w pobre|strong="H7326"\w*, \w e a preparou|strong="H6213"\w* \w para o homem|strong="H0376"\w* \w que tinha vindo|strong="H0935"\w* \add a\add* \w ele|strong="H0413"\w*.\x - \xo 12:4 \xt MAT 13:3; 1CH 29:29; JAS 1:14\x*
\v 5 \w E se acendeu|strong="H2734"\w* \w a ira|strong="H0639"\w* \w de David|strong="H1732"\w* \w contra o homem|strong="H0376"\w* \w muitíssimo|strong="H3966"\w*, \w e disse|strong="H0559"\w* \w a|strong="H0413"\w* \w Natã|strong="H5416"\w*: "\w Pela vida|strong="H2416"\w* \w do SENHOR|strong="H3068"\w*, \w que|strong="H3588"\w* \w é digno de morte|strong="H1121,H4194"\w* \w o homem|strong="H0376"\w* \w que fez|strong="H6213"\w* \w isto|strong="H2063"\w*."\x - \xo 12:5 \xt 2SA 13:21; NUM 12:9; MAT 7:3; ROM 2:1; LUK 6:41; 1SA 26:16\x*
\v 6 \w E|strong="H0853"\w* \w a ovelha|strong="H3535"\w* \w restituirá|strong="H7999"\w* \w quatro vezes|strong="H0706"\w*, \w por causa|strong="H6118"\w* \w de que|strong="H0834"\w* \w fez|strong="H6213"\w* \w esta coisa|strong="H1697,H2088"\w*, \w e porque|strong="H5921,H0834"\w* \w não|strong="H3808"\w* \add teve\add* \w compaixão|strong="H2550"\w*.\x - \xo 12:6 \xt LUK 19:8; MAT 7:3; ROM 2:1; PRO 19:17; EXO 22:1; PRO 6:31\x*
\v 7 \w E disse|strong="H0559"\w* \w Natã|strong="H5416"\w* \w a|strong="H0413"\w* \w David|strong="H1732"\w*: "\w Tu|strong="H0859"\w* \w és o homem|strong="H0376"\w*! \w Assim|strong="H3541"\w* \w diz|strong="H0559"\w* \w o SENHOR|strong="H3068"\w* \w Deus|strong="H0430"\w* \w de Israel|strong="H3478"\w*: '\w Eu|strong="H0595"\w* \add te\add* \w ungi|strong="H4886"\w* \w por rei|strong="H4428"\w* \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w e eu|strong="H0595"\w* \add te\add* \w livrei|strong="H5337"\w* \w da mão|strong="H3027"\w* \w de Saul|strong="H7586"\w*.'\x - \xo 12:7 \xt ROM 2:1; 2CH 16:9; LUK 6:41; 2SA 7:8; PRO 27:6; 1SA 16:13\x*
\v 8 \w E te dei|strong="H5414,H9031"\w* \w a casa|strong="H1004"\w* \w do teu senhor|strong="H0113"\w*, \w e|strong="H0853"\w* \w as mulheres|strong="H0802"\w* \w do teu senhor|strong="H0113"\w* \w em teu colo|strong="H2436"\w*; \w e te dei|strong="H5414,H9031"\w* \w a casa|strong="H1004"\w* \w de Israel|strong="H3478"\w* \w e de Judá|strong="H3063"\w*; \w e se|strong="H0518"\w* \w pouco|strong="H4592"\w* \w fosse isso|strong="H4592"\w*, \w acrescentaria|strong="H3254"\w* \add a\add* \w ti|strong="H9031"\w* \w outro tanto e mais|strong="H9039"\w*.\x - \xo 12:8 \xt 2CH 16:9; PRO 27:6; PSA 84:11; 2SA 9:7; PSA 141:5; 1KI 14:7\x*
\v 9 \w Por que|strong="H4069"\w* \w desprezaste|strong="H0959"\w* \w a palavra|strong="H1697"\w* \w do SENHOR|strong="H3068"\w*, \w fazendo|strong="H6213"\w* \w o mal|strong="H7451"\w* \w aos meus olhos|strong="H5869"\w*\f + \fr 12.9: \ft Variante: a Ketiv tem "aos olhos dele" (בְּעֵינוֹ); a Qere, que seguimos, "aos meus olhos" (בְּעֵינַי)\f*? \w Urias|strong="H0223"\w*, \w o hitita|strong="H2850"\w*, \w feriste|strong="H5221"\w* \w com a espada|strong="H2719"\w*; \w e|strong="H0853"\w* \w a sua mulher|strong="H0802"\w* \w tomaste|strong="H3947"\w* \w para ti|strong="H9031"\w* \w por mulher|strong="H0802"\w*; \w e a ele|strong="H0853"\w* \w mataste|strong="H2026"\w* \w com a espada|strong="H2719"\w* \w dos filhos|strong="H1121"\w* \w de Amom|strong="H5983"\w*.\x - \xo 12:9 \xt 2SA 23:39; 1KI 15:5; NUM 15:31; PSA 32:5; 2CH 16:9; 1SA 2:30\x*
\v 10 \w E agora|strong="H6258"\w*, \w não|strong="H3808"\w* \w se apartará|strong="H5493"\w* \w a espada|strong="H2719"\w* \w da tua casa|strong="H1004"\w* \w até|strong="H5704"\w* \w sempre|strong="H5769"\w*, \w porque|strong="H6118,H3588"\w* \add me\add* \w desprezaste|strong="H0959"\w*, \w e tomaste|strong="H3947"\w* \w a mulher|strong="H0802"\w* \w de Urias|strong="H0223"\w*, \w o hitita|strong="H2850"\w*, \w para que fosse|strong="H1961,H9031"\w* \w tua mulher|strong="H0802"\w*.\x - \xo 12:10 \xt 1KI 15:5; 1SA 2:30; 2CH 16:9; PRO 17:13; PRO 27:6; PSA 141:5\x*
\v 11 '\w Assim|strong="H3541"\w* \w diz|strong="H0559"\w* \w o SENHOR|strong="H3068"\w*: \add Eis\add* \w que|strong="H2005"\w* \w levantarei|strong="H6965"\w* \w sobre ti|strong="H5921"\w* \w calamidade|strong="H7451"\w* \w da tua própria casa|strong="H1004"\w*; \w e tomarei|strong="H3947"\w* \w as tuas mulheres|strong="H0802"\w* \w diante dos teus olhos|strong="H5869"\w*, \w e as darei|strong="H5414"\w* \w ao teu próximo|strong="H7453"\w*, \w e ele se deitará|strong="H7901"\w* \w com as tuas mulheres|strong="H5973,H0802"\w* \w à vista|strong="H5869"\w* \w deste sol|strong="H8121,H2063"\w*.\x - \xo 12:11 \xt 2SA 16:21; 2CH 16:9; DEU 28:30; PRO 27:6; 2SA 16:22; PSA 141:5\x*
\v 12 \w Porque|strong="H3588"\w* \w tu|strong="H0859"\w* \w agiste|strong="H6213"\w* \w em segredo|strong="H5643"\w*; \w mas eu|strong="H0589"\w* \w farei|strong="H6213"\w* \w esta coisa|strong="H1697,H2088"\w* \w diante|strong="H5048"\w* \w de todo|strong="H3605"\w* \w o Israel|strong="H3478"\w*, \w e diante|strong="H5048"\w* \w do sol|strong="H8121"\w*.'\x - \xo 12:12 \xt PSA 89:36; 2CH 16:9; EPH 5:12; PRO 27:6; 1CO 4:5; 2SA 16:22\x*
\v 13 \w E disse|strong="H0559"\w* \w David|strong="H1732"\w* \w a|strong="H0413"\w* \w Natã|strong="H5416"\w*: "\w Pequei|strong="H2398"\w* \w contra o SENHOR|strong="H3068"\w*."\w E disse|strong="H0559"\w* \w Natã|strong="H5416"\w* \w a|strong="H0413"\w* \w David|strong="H1732"\w*: "\w Também|strong="H1571"\w* \w o SENHOR|strong="H3068"\w* \w tirou|strong="H5674"\w* \w o teu pecado|strong="H2403"\w*; \w não|strong="H3808"\w* \w morrerás|strong="H4191"\w*."\x - \xo 12:13 \xt 1SA 15:24; NUM 32:23; 2CO 7:10; PSA 32:5; PSA 103:12; PRO 28:13\x*
\v 14 \w Mas|strong="H0657"\w*, \w porque|strong="H3588,H5006"\w* \w com isto|strong="H1697,H2088"\w* \w desprezaste|strong="H5006"\w* \w os inimigos|strong="H0341"\w* \w do SENHOR|strong="H3068"\w*\f + \fr 12.14: \ft Lit.: fórmula eufemística dos escribas (tiqqun sopherim): o texto diz literalmente "desprezaste os inimigos do SENHOR", mas o sentido original, suavizado por reverência, é "desprezaste ao SENHOR"\f*, \w também|strong="H1571"\w* \w o filho|strong="H1121"\w* \w que te nasceu|strong="H3209,H9031"\w* \w certamente|strong="H4191"\w* \w morrerá|strong="H4191"\w*.\x - \xo 12:14 \xt PSA 51:4; ROM 2:24; ISA 52:5; PRO 27:6; PSA 89:31-33; 2SA 18:33\x*
\v 15 \w E foi|strong="H1980"\w* \w Natã|strong="H5416"\w* \w para|strong="H0413"\w* \w a sua casa|strong="H1004"\w*. \w E feriu|strong="H5062"\w* \w o SENHOR|strong="H3068"\w* \w o filho|strong="H3206"\w* \w que|strong="H0834"\w* \add tinha dado à\add* \w luz|strong="H3205"\w* \w a mulher|strong="H0802"\w* \w de Urias|strong="H0223"\w* \w a David|strong="H1732"\w*, \w e ficou gravemente doente|strong="H0605"\w*.\x - \xo 12:15 \xt PRO 27:6; 1SA 25:38; 2SA 18:33; MRK 12:12; 1CO 11:30; MRK 5:23\x*
\v 16 \w E buscou|strong="H1245"\w* \w David|strong="H1732"\w* \w a Deus|strong="H0430"\w* \w por|strong="H1157"\w* \w o menino|strong="H5288"\w*, \w e jejuou|strong="H6684"\w* \w David|strong="H1732"\w* \w um jejum|strong="H6685"\w*, \w e entrou|strong="H0935"\w*, \w e passou a noite|strong="H3885"\w*, \w e se deitou|strong="H7901"\w* \w em saco|strong="H8242"\w*, \w por terra|strong="H0776"\w*.\x - \xo 12:16 \xt 1KI 21:27; MAT 6:16; 2SA 13:31; JOB 1:20; 2CO 12:8; 2SA 12:22\x*
\v 17 \w E se levantaram|strong="H6965"\w* \w os anciãos|strong="H2205"\w* \w da sua casa|strong="H1004"\w* \w com ele|strong="H5921"\w*, \w para o levantar|strong="H6965"\w* \w da terra|strong="H4480,H0776"\w*; \w e não|strong="H3808"\w* \w quis|strong="H0014"\w*, \w e não|strong="H3808"\w* \w comeu|strong="H1254"\w* \w com eles|strong="H0854"\w* \w pão|strong="H3899"\w*.\x - \xo 12:17 \xt 1KI 20:8; JOB 1:20; 2CO 12:8; 2SA 3:35; 1KI 21:27; 2SA 18:33\x*
\v 18 \w E aconteceu|strong="H1961"\w*, \w no dia|strong="H3117"\w* \w sétimo|strong="H7637"\w*, \w que morreu|strong="H4191"\w* \w o menino|strong="H3206"\w*; \w e temiam|strong="H3372"\w* \w os servos|strong="H5650"\w* \w de David|strong="H1732"\w* \w contar-lhe|strong="H5046,H9033"\w* \w que|strong="H3588"\w* \add tinha\add* \w morrido|strong="H4191"\w* \w o menino|strong="H3206"\w*; \w porque|strong="H3588"\w* \w diziam|strong="H0559"\w*: '\w Eis|strong="H2009"\w* \add que,\add* \w quando|strong="H1961"\w* \w estava|strong="H3206"\w* \w o menino|strong="H3206"\w* \w vivo|strong="H2416"\w*, \w lhe falávamos|strong="H1696,H0413"\w*, \w e não|strong="H3808"\w* \w ouvia|strong="H8085"\w* \w a nossa voz|strong="H6963"\w*; \w e como|strong="H0349"\w* \w diremos|strong="H0559"\w* \add a\add* \w ele|strong="H0413"\w*: \w Morreu|strong="H4191"\w* \w o menino|strong="H3206"\w*? \w E fará|strong="H6213"\w* \w mal|strong="H7451"\w*.'\x - \xo 12:18 \xt JOB 1:20; 2CO 12:8; 2SA 18:33; 1CO 11:30; 1CO 2:15; JHN 11:31\x*
\v 19 \w E viu|strong="H7200"\w* \w David|strong="H1732"\w* \w que|strong="H3588"\w* \w os seus servos|strong="H5650"\w* \w sussurravam|strong="H3907"\w*, \w e entendeu|strong="H0995"\w* \w David|strong="H1732"\w* \w que|strong="H3588"\w* \add tinha\add* \w morrido|strong="H4191"\w* \w o menino|strong="H3206"\w*. \w E disse|strong="H0559"\w* \w David|strong="H1732"\w* \w aos seus servos|strong="H0413,H5650"\w*: "¿\w Morreu|strong="H4191"\w* \w o menino|strong="H3206"\w*?"\w E disseram|strong="H0559"\w*: "\w Morreu|strong="H4191"\w*."\x - \xo 12:19 \xt JOB 1:20; 2SA 18:33; 1CO 2:15; 1TH 4:13\x*
\v 20 \w E se levantou|strong="H6965"\w* \w David|strong="H1732"\w* \w da terra|strong="H0776"\w*, \w e se lavou|strong="H7364"\w*, \w e se ungiu|strong="H5480"\w*, \w e mudou|strong="H2498"\w* \w as suas roupas|strong="H8071"\w*\f + \fr 12.20: \ft Variante: a Ketiv tem "a sua roupa" (singular, שִׂמְלָתוֹ); a Qere, que seguimos, "as suas roupas" (plural, שִׂמְלֹתָיו)\f*; \w e foi|strong="H0935"\w* \w à casa|strong="H1004"\w* \w do SENHOR|strong="H3068"\w*, \w e se prostrou|strong="H7812"\w*; \w e foi|strong="H0935"\w* \w para|strong="H0413"\w* \w a sua casa|strong="H1004"\w*, \w e pediu|strong="H7592"\w*, \w e lhe puseram|strong="H7760,H9033"\w* \w pão|strong="H3899"\w*, \w e comeu|strong="H0398"\w*.\x - \xo 12:20 \xt RUT 3:3; JOB 1:20; MAT 6:17; 2SA 18:33; LAM 3:39-41; 1CO 2:15\x*
\v 21 \w E disseram-lhe|strong="H0559,H5650,H0413"\w*: "\w Que|strong="H4100"\w* \w é esta coisa|strong="H1697,H2088"\w* \w que|strong="H0834"\w* \w fizeste|strong="H6213"\w*? \w Por causa|strong="H5668"\w* \w do menino|strong="H3206"\w*, \w enquanto vivo|strong="H2416"\w*, \w jejuaste|strong="H6684"\w* \w e choraste|strong="H1058"\w*; \w e quando|strong="H0834"\w* \w morreu|strong="H4191"\w* \w o menino|strong="H3206"\w*, \add te\add* \w levantaste|strong="H6965"\w* \w e comeste|strong="H0398"\w* \w pão|strong="H3899"\w*."\x - \xo 12:21 \xt MAT 6:16; 2SA 18:33; 1CO 2:15; 2KI 20:3\x*
\v 22 \w E disse|strong="H0559"\w*: "\w Enquanto ainda|strong="H5750"\w* \w vivo|strong="H2416"\w* \w o menino|strong="H3206"\w*, \w jejuei|strong="H6684"\w* \w e chorei|strong="H1058"\w*, \w porque|strong="H3588"\w* \w dizia|strong="H0559"\w*:' \w Quem sabe|strong="H4310,H3045"\w*? \w Terá misericórdia|strong="H2603"\w*\f + \fr 12.22: \ft Variante: a Ketiv tem a forma יְחָנֵּנִי ("ele mostrará favor a mim"); a Qere, que seguimos, tem וְחַנַּנִי ("e ele mostrará favor a mim"), sentido equivalente\f* \w de mim|strong="H2603"\w* \w o SENHOR|strong="H3068"\w*, \w e viverá|strong="H2421"\w* \w o menino|strong="H3206"\w*.'"\x - \xo 12:22 \xt JON 3:9; JON 1:6; ISA 38:1-3; ISA 38:5; 2SA 12:16; 2SA 18:33\x*
