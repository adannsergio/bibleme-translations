\v 11 \w E disse|strong="H0559"\w* \w Ziba|strong="H6717"\w* \w ao|strong="H0413"\w* \w rei|strong="H4428"\w*: "\w Conforme tudo|strong="H3605,H0834"\w* \w que o rei, meu senhor, mandar|strong="H6680,H0113,H4428"\w* \w ao seu servo|strong="H5650"\w*, \w assim|strong="H3651"\w* \w fará|strong="H6213"\w* \w o teu servo|strong="H5650"\w*."\w E Mefibosete|strong="H4648"\w* \w come|strong="H0398"\w* \w à minha mesa|strong="H5921,H7979"\w* \w como um|strong="H0259"\w* \w dos filhos|strong="H1121"\w* \w do rei|strong="H4428"\w*.\x - \xo 9:11 \xt 2SA 16:4; 2SA 9:13; 2SA 16:1; 2SA 19:30; 2SA 9:9; PRO 18:24\x*
