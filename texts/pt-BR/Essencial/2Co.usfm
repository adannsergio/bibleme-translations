\v 1 \w E como colaboradores|strong="G4903,G1161"\w*, \w também|strong="G2532"\w* \w exortamos|strong="G3870"\w* \w que vocês|strong="G4771"\w* \w não|strong="G3361"\w* \w em vão|strong="G1519,G2756"\w* \w recebam|strong="G1209"\w* \w a graça|strong="G3588,G5485"\w* \w de Deus|strong="G3588,G2316"\w*,\x - \xo 6:1 \xt 1CO 15:10; ISA 55:6; HEB 3:7; 1CO 3:9; ROM 12:1; MAT 9:37\x*
\v 2 \w pois|strong="G1063"\w* \w diz|strong="G3004"\w*: “\w No tempo|strong="G2540"\w* \w favorável|strong="G1184"\w* \w ouvi você|strong="G1873,G4771"\w*, \w e|strong="G2532"\w* \w no dia|strong="G1722,G2250"\w* \w da salvação|strong="G4991"\w* \w socorri você|strong="G997,G4771"\w*.” \w Olhem|strong="G2400"\w*, \w agora|strong="G3568"\w* \w é o tempo|strong="G2540"\w* \w favorável|strong="G2144"\w*; \w olhem|strong="G2400"\w*, \w agora|strong="G3568"\w* \w é o dia|strong="G2250"\w* \w da salvação|strong="G4991"\w*\f + \fr 6.2: \ft Nota cultural: cita Is 49:8.\f*.\f + \fr 6.2: \ft Acréscimo: verbo ser/estar suprido em “é o tempo”, “é o dia”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:2 \xt ISA 49:8; LUK 11:9; ISA 55:6; HEB 4:7; HEB 3:7; HEB 3:13\x*
