\v 5 \w em açoites|strong="G1722,G4127"\w*, \w em prisões|strong="G1722,G5438"\w*, \w em tumultos|strong="G1722,G181"\w*, \w em trabalhos duros|strong="G1722,G2873"\w*, \w em noites sem dormir|strong="G1722,G70"\w*, \w em jejuns|strong="G1722,G3521"\w*;\x - \xo 6:5 \xt 2CO 11:27; 2CO 11:23; 1CO 9:27; 1TI 4:12; JAS 5:7; ROM 8:35\x*
\v 6 \w em pureza|strong="G1722,G54"\w*, \w em conhecimento|strong="G1722,G1108"\w*, \w em paciência|strong="G1722,G3115"\w*, \w em bondade|strong="G1722,G5544"\w*, \w no Espírito|strong="G1722,G4151"\w* \w Santo|strong="G40"\w*, \w em amor|strong="G1722,G26"\w* \w sincero|strong="G505"\w*;\x - \xo 6:6 \xt GAL 5:22; COL 3:12; ROM 12:9; COL 3:13; 1TI 4:12; EPH 4:32\x*
