\v 7 \w Cada um|strong="G1538"\w*, \w conforme|strong="G2531"\w* \w decidiu|strong="G4255"\w* \w no coração|strong="G3588,G2588"\w*, \w não com|strong="G3361,G1537"\w* \w tristeza|strong="G3077"\w* \w ou|strong="G2228"\w* \w por|strong="G1537"\w* \w obrigação|strong="G318"\w*; \w pois|strong="G1063"\w* \w Deus ama|strong="G25,G3588,G2316"\w* \w quem dá|strong="G1395"\w* \w com alegria|strong="G2431"\w*.\f + \fr 9.7: \ft Nota cultural: ecoa Pv 22:8 (LXX).\f*\x - \xo 9:7 \xt PRO 22:8; LUK 6:38; MAL 3:10; JHN 16:6; ACT 20:35; 2CO 8:12\x*
\v 8 \w E Deus|strong="G1161,G3588,G2316"\w* \w é poderoso|strong="G1414"\w* \w para fazer abundar|strong="G4052"\w* \w toda graça|strong="G3956,G5485"\w* \w para vocês|strong="G1519,G4771"\w*, \w para que|strong="G2443"\w*, \w em tudo|strong="G1722,G3956"\w* \w sempre|strong="G3842"\w*, \w tendo toda|strong="G2192,G3956"\w* \w suficiência|strong="G841"\w*, \w abundem|strong="G4052"\w* \w em toda|strong="G1519,G3956"\w* \w boa|strong="G18"\w* \w obra|strong="G2041"\w*;\x - \xo 9:8 \xt EPH 2:10; EPH 3:20; LUK 6:38; MAL 3:10; PHP 4:19; PHP 4:18-19\x*
\v 9 — \w como|strong="G2531"\w* \w está escrito|strong="G1125"\w*: “\w Espalhou|strong="G4650"\w*, \w deu|strong="G1325"\w* \w aos pobres|strong="G3588,G3993"\w*; \w a sua|strong="G846"\w* \w justiça|strong="G3588,G1343"\w* \w permanece|strong="G3306"\w* \w para sempre|strong="G1519,G3588,G165"\w*.”\f + \fr 9.9: \ft Nota cultural: cita Sl 112:9 (111:9 na LXX).\f*\x - \xo 9:9 \xt PSA 112:9; PHP 4:19; ACT 20:35; PRO 11:25; ISA 55:10; 1JN 3:17\x*
\v 10 \w e aquele que|strong="G3588,G1161"\w* \w fornece|strong="G2023"\w* \w semente|strong="G4703"\w* \w ao que semeia|strong="G3588,G4687"\w* \w e|strong="G2532"\w* \w pão|strong="G740"\w* \w para alimento|strong="G1519,G1035"\w*, \w fornecerá|strong="G5524"\w* \w e|strong="G2532"\w* \w multiplicará|strong="G4129"\w* \w a semente|strong="G3588,G4703"\w* \w de vocês|strong="G4771"\w* \w e|strong="G2532"\w* \w fará crescer|strong="G837"\w* \w os frutos|strong="G3588,G6013"\w* \w da justiça|strong="G3588,G1343"\w* \w de vocês|strong="G4771"\w*—\f + \fr 9.10: \ft Nota cultural: ecoa Is 55:10 e Os 10:12.\f*\x - \xo 9:10 \xt ISA 55:10; HOS 10:12; ECC 11:6; PHP 4:19; ACT 20:35; 2CO 9:6\x*
\v 11 \w sendo enriquecidos|strong="G4148"\w* \w em tudo|strong="G1722,G3956"\w* \w para toda|strong="G1519,G3956"\w* \w generosidade|strong="G572"\w*, \w a qual|strong="G3748"\w* \w produz|strong="G2716"\w* \w por meio de nós|strong="G1223,G3165"\w* \w ação de graças|strong="G2169"\w* \w a Deus|strong="G3588,G2316"\w*—\x - \xo 9:11 \xt ECC 11:6; PHP 4:19; ACT 20:35; 2CO 9:8; ISA 55:10; JHN 15:8\x*
\v 12 \w pois|strong="G3754"\w* \w o serviço|strong="G3588,G1248"\w* \w deste|strong="G3588,G3778"\w* \w ministério|strong="G3009"\w* \w não|strong="G3756"\w* \w somente|strong="G3441"\w* \w supre|strong="G1510,G4322"\w* \w as carências|strong="G3588,G5303"\w* \w dos santos|strong="G3588,G40"\w*, \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w transborda|strong="G4052"\w* \w em muitas|strong="G1223,G4183"\w* \w ações de graças|strong="G2169"\w* \w a Deus|strong="G3588,G2316"\w*—\f + \fr 9.12: \ft Lit.: λειτουργία, “serviço público” e, no uso religioso, “ministério, serviço cultual”.\f*\x - \xo 9:12 \xt 2CO 4:15; ACT 20:35; HEB 13:16; JHN 15:8; PSA 41:1; ROM 12:13\x*
\v 13 \w por meio da prova|strong="G1223,G3588,G1382"\w* \w deste serviço|strong="G3588,G1248,G3778"\w*, \w glorificam|strong="G1392"\w* \w a Deus|strong="G3588,G2316"\w* \w pela submissão|strong="G1909,G3588,G5292"\w* \w da confissão|strong="G3588,G3671"\w* \w de vocês|strong="G4771"\w* \w à boa notícia|strong="G1519,G3588,G2098"\w* \w de Cristo|strong="G3588,G5547"\w* \w e|strong="G2532"\w* \w pela generosidade|strong="G572"\w* \w da partilha|strong="G3588,G2842"\w* \w com eles|strong="G1519,G846"\w* \w e|strong="G2532"\w* \w com todos|strong="G1519,G3956"\w*,\x - \xo 9:13 \xt MAT 5:16; HEB 13:16; JHN 15:8; PSA 41:1; 2CO 10:5; 1CO 16:1\x*
\v 14 \w e|strong="G2532"\w* \w eles|strong="G846"\w*, \w com oração|strong="G1162"\w* \w por vocês|strong="G5228,G4771"\w*, \w sentindo saudade|strong="G1971"\w* \w de vocês|strong="G4771"\w* \w por causa da graça|strong="G1223,G3588,G5485"\w* \w extraordinária|strong="G5235"\w* \w de Deus|strong="G3588,G2316"\w* \w sobre vocês|strong="G1909,G4771"\w*.\x - \xo 9:14 \xt JHN 15:8; PSA 41:1; 1CO 16:1; HEB 6:10; MAT 6:2; MAT 10:42\x*
\v 15 \w Graças|strong="G5485"\w* \w a Deus|strong="G3588,G2316"\w* \w pelo seu|strong="G1909,G3588,G846"\w* \w dom|strong="G1431"\w* \w indescritível|strong="G411"\w*.\x - \xo 9:15 \xt ROM 5:15; EPH 4:7; EPH 3:7; 1CO 15:57; JHN 15:8; 2CO 2:14\x*
\c 10
\p
\v 1 \w E eu mesmo|strong="G846,G1161,G1473"\w*, \w Paulo|strong="G3972"\w*, \w exorto|strong="G3870"\w* \w vocês|strong="G4771"\w* \w pela mansidão|strong="G1223,G3588,G4236"\w* \w e|strong="G2532"\w* \w clemência|strong="G1932"\w* \w de Cristo|strong="G3588,G5547"\w* — \w eu que|strong="G3739"\w*, \w face a face|strong="G2596,G4383"\w*, \w de fato|strong="G3303"\w*, \w sou humilde|strong="G5011"\w* \w entre vocês|strong="G1722,G4771"\w*, \w mas ausente|strong="G548,G1161"\w* \w tenho coragem|strong="G2292"\w* \w para com vocês|strong="G1519,G4771"\w*—\f + \fr 10.1: \ft Acréscimo: verbo ser/estar suprido em “sou humilde”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:1 \xt MAT 11:29; ROM 12:1; JAS 3:13; 2CO 10:10; GAL 6:1; JHN 13:14\x*
\v 2 \w peço|strong="G1189,G1161"\w* \w que, estando presente|strong="G3588,G3918"\w*, \w não|strong="G3361"\w* \w precise ter coragem|strong="G2292"\w* \w com a confiança|strong="G3588,G4006"\w* \w com que|strong="G3739"\w* \w penso|strong="G3049"\w* \w ousar|strong="G5111"\w* \w contra alguns|strong="G1909,G5100"\w* \w que nos consideram|strong="G3588,G3049,G3165"\w* \w como se|strong="G5613"\w* \w andássemos|strong="G4043"\w* \w segundo a carne|strong="G2596,G4561"\w*.\f + \fr 10.2: \ft Tradução: λογίζομαι (λογίζομαι, G3049) está aqui como “penso”; o termo pode ser “considerar”, “contar”, “atribuir”, “calcular” ou “raciocinar”, e o contexto decide.\f*\x - \xo 10:2 \xt 2CO 13:10; 2CO 13:2; 2CO 1:17; GAL 5:16-25; 1TH 2:6; EPH 2:2-3\x*
\v 3 \w Pois|strong="G1063"\w* \w andando|strong="G4043"\w* \w na carne|strong="G1722,G4561"\w*, \w não|strong="G3756"\w* \w lutamos|strong="G4754"\w* \w segundo a carne|strong="G2596,G4561"\w*—\x - \xo 10:3 \xt REV 12:11; 2CO 10:4; 1PE 4:1-2; GAL 2:20; 1TI 6:12; ROM 8:13\x*
\v 4 \w pois|strong="G1063"\w* \w as armas|strong="G3588,G3696"\w* \w da nossa|strong="G3165"\w* \w campanha|strong="G3588,G4752"\w* \w não|strong="G3756"\w* \w são carnais|strong="G4559"\w*, \w mas|strong="G235"\w* \w poderosas|strong="G1415"\w* \w para Deus|strong="G3588,G2316"\w* \w para a destruição|strong="G4314,G2506"\w* \w de fortalezas|strong="G3794"\w*, \w derrubando|strong="G2507"\w* \w raciocínios|strong="G3053"\w*\f + \fr 10.4: \ft Lit.: Τῷ θεῷ: dativo que pode ser “para Deus”, “diante de Deus”, “por Deus” (agente) ou “divinamente” (reforço de “poderosas”).\f*\f + \fr 10.4: \ft Acréscimo: verbo ser/estar suprido em “são carnais”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:4 \xt EPH 6:11; ZEC 4:6; 2CO 6:7; EPH 6:13; JER 1:10; 1CO 2:5\x*
\v 5 \w e|strong="G2532"\w* \w toda altivez|strong="G3956,G5313"\w* \w que se levanta|strong="G1869"\w* \w contra o conhecimento|strong="G2596,G3588,G1108"\w* \w de Deus|strong="G3588,G2316"\w*, \w e|strong="G2532"\w* \w levando cativo|strong="G163"\w* \w todo pensamento|strong="G3956,G3540"\w* \w à obediência|strong="G1519,G3588,G5218"\w* \w de Cristo|strong="G3588,G5547"\w*,\x - \xo 10:5 \xt HEB 4:12; ISA 55:7; ZEC 4:6; 1PE 1:14-15; ROM 7:23; MAT 15:19\x*
\v 6 \w e|strong="G2532"\w* \w estando prontos|strong="G1722,G2092,G2192"\w* \w para punir|strong="G1556"\w* \w toda desobediência|strong="G3956,G3876"\w*, \w quando se completar|strong="G3752,G4137"\w* \w a obediência|strong="G3588,G5218"\w* \w de vocês|strong="G4771"\w*.\x - \xo 10:6 \xt 2CO 2:9; NUM 16:26-30; 1CO 5:5; 2CO 7:15; JDG 7:15; 1CO 5:3-5\x*
\v 7 \add Vocês\add* \w veem|strong="G991"\w* \w o que está diante dos olhos|strong="G3588,G2596,G4383"\w*. \w Se alguém|strong="G1487,G5100"\w* \w está convencido|strong="G3982"\w* \w de si mesmo|strong="G1438"\w* \w de ser de Cristo|strong="G5547,G1511"\w*, \w pense|strong="G3049"\w* \w isto|strong="G3778"\w* \w de novo|strong="G3825"\w* \w consigo mesmo|strong="G1909,G1438"\w*: \w que|strong="G3754"\w*, \w assim como|strong="G2531"\w* \w ele|strong="G846"\w* \w é de Cristo|strong="G5547"\w*, \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w nós|strong="G3165"\w*.\f + \fr 10.7: \ft Lit.: Βλέπετε pode ser indicativo (“vocês veem”), imperativo (“vejam o que está diante dos olhos”) ou pergunta (“vocês veem...?”).\f*\f + \fr 10.7: \ft Acréscimo: “Vocês” (em “Vocês veem o”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo; verbo ser/estar suprido em “é de Cristo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula; “o que está diante dos olhos”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\f + \fr 10.7: \ft Tradução: λογιζέσθω (λογίζομαι, G3049) está aqui como “pense”; o termo pode ser “considerar”, “contar”, “atribuir”, “calcular” ou “raciocinar”, e o contexto decide.\f*\x - \xo 10:7 \xt ROM 14:14; GAL 5:24; 1CO 14:37; JHN 7:24; 1CO 15:23; 1CO 3:23\x*
\v 8 \w Pois|strong="G1063"\w* \w mesmo que|strong="G1437,G5037"\w* \w me glorie|strong="G2744"\w* \w um pouco mais|strong="G4055,G5100"\w* \w a respeito da|strong="G4012,G3588"\w* \w autoridade|strong="G1849"\w* \w nossa|strong="G3165"\w*, \w que|strong="G3739"\w* \w deu|strong="G1325"\w* \w o Senhor|strong="G3588,G2962"\w* \w para edificação|strong="G1519,G3619"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w para destruição|strong="G1519,G2506"\w* \w de vocês|strong="G4771"\w*, \w não|strong="G3756"\w* \w me envergonharei|strong="G153"\w*,\x - \xo 10:8 \xt 2CO 13:10; PHP 1:20; 2CO 12:19; 2CO 13:2; 2CO 13:3; 2TI 1:12\x*
\v 9 \w para que não|strong="G2443,G3361"\w* \w pareça|strong="G1380"\w* \w como se|strong="G5613,G302"\w* \w quisesse amedrontar|strong="G1629"\w* \w vocês|strong="G4771"\w* \w por meio das cartas|strong="G1223,G3588,G1992"\w*.\x - \xo 10:9 \xt 2CO 13:2; 2CO 13:3; MAT 20:26; 1CO 4:19-21; 2CO 1:23; 2CO 12:6\x*
\v 10 \w Dizem|strong="G5346"\w*: “\w As cartas|strong="G3588,G1992"\w*, \w de fato|strong="G3303"\w*, \add são\add* \w pesadas|strong="G926"\w* \w e|strong="G2532"\w* \w fortes|strong="G2478"\w*; \w mas a presença|strong="G3588,G1161,G3952"\w* \w do corpo|strong="G3588,G4983"\w* \w é fraca|strong="G772"\w* \w e|strong="G2532"\w* \w a fala|strong="G3588,G3056"\w* \w desprezível|strong="G1848"\w*\f + \fr 10.10: \ft Lit.: φησίν, “diz (alguém)”, sem sujeito expresso: são as críticas feitas a Paulo em Corinto.\f*.”\f + \fr 10.10: \ft Acréscimo: “são” (em “de fato são pesadas e”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige; verbo ser/estar suprido em “é fraca”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:10 \xt 1SA 16:7; 2CO 4:7; 2CO 10:1; 1CO 1:17; 1CO 1:27; EXO 4:10\x*
\v 11 \w Que tal pessoa|strong="G3588,G5108"\w* \w pense|strong="G3049"\w* \w nisto|strong="G3778"\w*: \w que|strong="G3754"\w*, \w quais somos|strong="G3634,G1510"\w* \w em palavra|strong="G3588,G3056"\w* \w por meio de cartas|strong="G1223,G1992"\w*, \w ausentes|strong="G548"\w*, \w tais|strong="G5108"\w* \w também|strong="G2532"\w* \add seremos\add* \w presentes|strong="G3918"\w* \w em ação|strong="G3588,G2041"\w*.\f + \fr 10.11: \ft Acréscimo: “seremos” (em “tais também seremos presentes em”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\f + \fr 10.11: \ft Tradução: λογιζέσθω (λογίζομαι, G3049) está aqui como “pense”; o termo pode ser “considerar”, “contar”, “atribuir”, “calcular” ou “raciocinar”, e o contexto decide; ἔργῳ (ἔργον, G2041) está aqui como “em ação”; o termo pode ser “obra”, “trabalho”, “ação”, “feito” ou “ocupação”, e o contexto decide.\f*\x - \xo 10:11 \xt 2CO 13:10; 2CO 12:20; 2CO 13:2; 2CO 1:23; 3JN 1:10\x*
\v 12 \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w ousamos|strong="G5111"\w* \w classificar|strong="G1469"\w* \w ou|strong="G2228"\w* \w comparar|strong="G4793"\w* \w a nós mesmos|strong="G1438"\w* \w com alguns|strong="G5100"\w* \w dos que|strong="G3588"\w* \w se recomendam a si mesmos|strong="G1438,G4921"\w*; \w mas|strong="G235"\w* \w eles|strong="G846"\w*, \w medindo-se|strong="G1438,G3354"\w* \w por si mesmos|strong="G1722,G1438"\w* \w e|strong="G2532"\w* \w comparando-se|strong="G4793"\w* \w a si mesmos|strong="G1438"\w* \add consigo\add* \w mesmos|strong="G1438"\w*, \w não|strong="G3756"\w* \w entendem|strong="G4920"\w*.\f + \fr 10.12: \ft Acréscimo: “consigo” (em “si mesmos consigo mesmos não”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 10:12 \xt PRO 27:2; PRO 26:12; 2CO 10:18; LUK 18:11; 1CO 15:10; ROM 15:18\x*
\v 13 \w Mas nós|strong="G3165,G1161"\w* \w não|strong="G3756"\w* \w nos gloriaremos|strong="G2744"\w* \w além da medida|strong="G1519,G3588,G280"\w*, \w mas|strong="G235"\w* \w segundo a medida|strong="G2596,G3588,G3358"\w* \w do limite|strong="G3588,G2583"\w* \w que|strong="G3739"\w* \w repartiu|strong="G3307"\w* \w a nós|strong="G3165"\w* \w Deus|strong="G3588,G2316"\w* \w como medida|strong="G3358"\w*, \w alcançando|strong="G2185"\w* \w até mesmo|strong="G891,G2532"\w* \w vocês|strong="G4771"\w*—\f + \fr 10.13: \ft Lit.: κανών, “régua, regra”, daí “limite, âmbito de atuação”.\f*\x - \xo 10:13 \xt 2CO 10:15; 1CO 15:10; ROM 15:20; 1PE 4:10; ROM 12:6; 1CO 12:11\x*
\v 14 \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w nos estendemos além|strong="G5239,G1438"\w* \w como se|strong="G5613"\w* \w não alcançássemos|strong="G3361,G2185"\w* \w vocês|strong="G1519,G4771"\w*; \w pois|strong="G1063"\w* \w até vocês|strong="G891,G2532,G4771"\w* \w chegamos|strong="G5348"\w* \w com a boa notícia|strong="G1722,G3588,G2098"\w* \w de Cristo|strong="G3588,G5547"\w*—\x - \xo 10:14 \xt 1CO 15:10; ROM 15:20; 1CO 3:6; 2CO 10:13; EPH 4:7; COL 1:28\x*
\v 15 \w não nos gloriando|strong="G3756,G2744"\w* \w além da medida|strong="G1519,G3588,G280"\w* \w de trabalhos alheios|strong="G1722,G245,G2873"\w*, \w mas tendo|strong="G1161,G2192"\w* \w esperança|strong="G1680"\w*, \w crescendo|strong="G837"\w* \w a fé|strong="G3588,G4102"\w* \w de vocês|strong="G4771"\w*, \w de ser engrandecidos|strong="G3170"\w* \w entre vocês|strong="G1722,G4771"\w* \w conforme|strong="G2596"\w* \w o nosso|strong="G3165"\w* \w limite|strong="G3588,G2583"\w* \w em abundância|strong="G1519,G4050"\w*,\x - \xo 10:15 \xt 2CO 10:13; 1CO 15:10; ROM 15:20; 1CO 3:6; 2TH 1:3; EPH 4:7\x*
\v 16 \w para anunciar a boa notícia|strong="G2097"\w* \w nas regiões além|strong="G1519,G3588,G5238"\w* \w de vocês|strong="G4771"\w*, \w não|strong="G3756"\w* \w no limite|strong="G1722,G2583"\w* \w alheio|strong="G245"\w*, \w para nos gloriar|strong="G2744"\w* \w do que já está pronto|strong="G1519,G3588,G2092"\w*.\f + \fr 10.16: \ft Acréscimo: verbo ser/estar suprido em “do que já está pronto”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:16 \xt 1CO 15:10; ROM 15:20; JOB 38:5; PSA 19:4; ROM 1:15; ROM 15:24-28\x*
\v 17 \w Mas o que se gloria|strong="G3588,G1161,G2744"\w*, \w no Senhor|strong="G1722,G2962"\w* \w se glorie|strong="G2744"\w*.\f + \fr 10.17: \ft Nota cultural: ecoa Jr 9:23-24 (9:22-23 na LXX).\f*\x - \xo 10:17 \xt JER 9:23-24; JER 9:24; 1CO 1:31; PSA 34:2; JAS 1:9-10; ISA 65:16\x*
\v 18 \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w o que se recomenda|strong="G3588,G1438,G4921"\w* \w é aprovado|strong="G1565,G1510,G1384"\w*, \w mas|strong="G235"\w* \w aquele a quem|strong="G3739"\w* \w o Senhor|strong="G3588,G2962"\w* \w recomenda|strong="G4921"\w*.\x - \xo 10:18 \xt 2TI 2:15; PRO 27:2; 1CO 4:5; 2CO 10:12; PRO 21:2; LUK 16:15\x*
\c 11
\p
\v 1 \w Quem dera|strong="G3785"\w* \w me suportassem|strong="G430,G3165"\w* \w um pouco|strong="G3398,G5100"\w* \w de insensatez|strong="G877"\w*; \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w me suportam|strong="G430,G3165"\w*.\x - \xo 11:1 \xt 1CO 1:21; 2CO 11:4; 2CO 11:16; 2CO 11:19; 2CO 11:21; 2CO 12:11\x*
