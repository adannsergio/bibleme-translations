\v 1 \w Paulo|strong="G3972"\w*, \w apóstolo|strong="G652"\w* \w de Cristo|strong="G5547"\w* \w Jesus|strong="G2424"\w* \w pela vontade|strong="G1223,G2307"\w* \w de Deus|strong="G2316"\w*, \w e|strong="G2532"\w* \w Timóteo|strong="G5095"\w*, \w o irmão|strong="G3588,G80"\w*, \w à comunidade|strong="G3588,G1577"\w* \w de Deus|strong="G3588,G2316"\w* \w que está|strong="G3588,G1510"\w* \w em Corinto|strong="G1722,G2882"\w*, \w com todos|strong="G4862,G3956"\w* \w os santos|strong="G3588,G40"\w* \w que estão|strong="G3588,G1510"\w* \w em toda|strong="G1722,G3650"\w* \w a Acaia|strong="G3588,G882"\w*:\x - \xo 1:1 \xt COL 1:1; EPH 1:1; PHP 1:1; 2TI 1:1; 1CO 1:2; ROM 1:1\x*
\v 2 \w graça|strong="G5485"\w* \w a vocês|strong="G4771"\w* \w e|strong="G2532"\w* \w paz|strong="G1515"\w* \w da parte de Deus|strong="G575,G2316"\w*, \w nosso Pai|strong="G3962,G3165"\w*, \w e|strong="G2532"\w* \w do Senhor|strong="G2962"\w* \w Jesus Cristo|strong="G2424,G5547"\w*.\x - \xo 1:2 \xt PHP 1:2; 1CO 1:3; PHM 1:3; 2TH 1:2; EPH 1:2; GAL 1:3\x*
\v 3 \w Bendito|strong="G2128"\w* \w seja o Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w Pai|strong="G3962"\w* \w do nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus Cristo|strong="G2424,G5547"\w*, \w o Pai|strong="G3588,G3962"\w* \w das misericórdias|strong="G3588,G3628"\w* \w e|strong="G2532"\w* \w Deus|strong="G2316"\w* \w de todo consolo|strong="G3956,G3874"\w*,\f + \fr 1.3: \ft Lit.: παράκλησις e παρακαλέω formam uma família de palavras que significa “consolo, encorajamento, exortação”; nos vv. 3-7 predomina o sentido de “consolo”.\f*\f + \fr 1.3: \ft Acréscimo: verbo ser/estar suprido em “seja o Deus”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:3 \xt PHP 2:1; EPH 1:3; JHN 16:33; 1PE 1:3; 2PE 1:17; ROM 15:5\x*
\v 4 \w que nos consola|strong="G3588,G3870,G3165"\w* \w em toda|strong="G1909,G3956,G3588"\w* \w a nossa|strong="G3165"\w* \w tribulação|strong="G2347"\w*, \w para que possamos|strong="G1519,G3588,G1410,G3165"\w* \w consolar|strong="G3870"\w* \w os que estão|strong="G3588,G1722"\w* \w em qualquer|strong="G3956"\w* \w tribulação|strong="G2347"\w* \w com o consolo|strong="G1223,G3588,G3874"\w* \w com o qual|strong="G3739"\w* \add nós\add* \w mesmos|strong="G846"\w* \w somos consolados|strong="G3870"\w* \w por Deus|strong="G5259,G3588,G2316"\w*.\f + \fr 1.4: \ft Acréscimo: “nós” (em “o qual nós mesmos somos”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo; “os que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 1:4 \xt 1TH 3:7; 2CO 7:4; 2CO 7:13; 1TH 5:11; ISA 51:12; 2TH 2:16-17\x*
\v 5 \w Pois|strong="G3754"\w* \w assim como|strong="G2531"\w* \w abundam|strong="G4052"\w* \w os sofrimentos|strong="G3588,G3804"\w* \w do Cristo|strong="G3588,G5547"\w* \w em nós|strong="G1519,G3165"\w*, \w assim|strong="G3779"\w* \w por meio do Cristo|strong="G1223,G3588,G5547"\w* \w abunda|strong="G4052"\w* \w também|strong="G2532"\w* \w o nosso|strong="G3165"\w* \w consolo|strong="G3588,G3874"\w*.\x - \xo 1:5 \xt 2CO 1:7; PSA 94:19; MAT 5:4; PHP 3:10; COL 1:24; LUK 22:32\x*
\v 6 \w Mas se|strong="G1535,G1161"\w* \w somos atribulados|strong="G2346"\w*, \w é em favor|strong="G5228"\w* \w do consolo|strong="G3588,G3874"\w* \w de vocês|strong="G4771"\w* \w e|strong="G2532"\w* \w salvação|strong="G4991"\w*; \w se|strong="G1535"\w* \w somos consolados|strong="G3870"\w*, \w é em favor|strong="G5228"\w* \w do consolo|strong="G3588,G3874"\w* \w de vocês|strong="G4771"\w*, \w que se torna eficaz|strong="G3588,G1754"\w* \w na perseverança|strong="G1722,G5281"\w* \w dos mesmos|strong="G3588,G846"\w* \w sofrimentos|strong="G3804"\w* \w que também|strong="G3739,G2532"\w* \w nós|strong="G3165"\w* \w sofremos|strong="G3958"\w*,\f + \fr 1.6: \ft Variante: Treg e o RP omitem a oração “se somos consolados, é em favor do consolo de vocês” (εἴτε παρακαλούμεθα, ὑπὲρ τῆς ὑμῶν παρακλήσεως); o texto adotado segue WH e NA28.\f*\f + \fr 1.6: \ft Acréscimo: verbo ser/estar suprido em “é em favor”, “é em favor”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:6 \xt MAT 5:4; COL 1:24; LUK 22:32; 2TI 2:10; 2TI 2:3; ROM 5:4\x*
\v 7 \w e|strong="G2532"\w* \w a nossa|strong="G3165"\w* \w esperança|strong="G3588,G1680"\w* \w é firme|strong="G949"\w* \w em favor de|strong="G5228"\w* \w vocês|strong="G4771"\w*, \w sabendo|strong="G6063"\w* \w que|strong="G3754"\w*, \w assim como|strong="G5613"\w* \w são participantes|strong="G2844,G1510"\w* \w dos sofrimentos|strong="G3588,G3804"\w*, \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w do consolo|strong="G3588,G3874"\w*.\f + \fr 1.7: \ft Acréscimo: verbo ser/estar suprido em “é firme”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:7 \xt 2CO 1:5; MAT 5:4; COL 1:24; ROM 8:17; 2TH 1:4-7; 1PE 4:13\x*
\v 8 \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w queremos|strong="G2309"\w* \w que vocês ignorem|strong="G4771,G50"\w*, \w irmãos e irmãs|strong="G80"\w*, \w a respeito da|strong="G5228,G3588"\w* \w nossa|strong="G3165"\w* \w tribulação|strong="G2347"\w* \w que ocorreu|strong="G3588,G1096"\w* \w na Ásia|strong="G1722,G3588,G773"\w*, \w que|strong="G3754"\w* \w fomos esmagados|strong="G916"\w* \w excessivamente|strong="G2596,G5236"\w* \w além da nossa força|strong="G5228,G1411"\w*, \w a ponto de|strong="G5620"\w* \w desesperarmos|strong="G1820,G3165"\w* \w até|strong="G2532"\w* \w da vida|strong="G3588,G2198"\w*\f + \fr 1.8: \ft Lit.: ἐξαπορέομαι, “ficar sem saída, desesperar”; “a Ásia” é a província romana no oeste da atual Turquia.\f*;\x - \xo 1:8 \xt ISA 40:31; PSA 56:3; 2CH 20:12; COL 1:24; 2CO 4:7-12; 1SA 30:6\x*
\v 9 \w mas|strong="G235"\w* \w nós mesmos|strong="G846"\w* \w em nós mesmos|strong="G1722,G1438"\w* \w tivemos|strong="G2192"\w* \w a sentença|strong="G3588,G610"\w* \w de morte|strong="G3588,G2288"\w*, \w para que não|strong="G2443,G3361"\w* \w confiássemos|strong="G3982,G1510"\w* \w em nós mesmos|strong="G1909,G1438"\w*, \w mas|strong="G235"\w* \w em Deus|strong="G1909,G3588,G2316"\w*, \w que ressuscita|strong="G3588,G1453"\w* \w os mortos|strong="G3588,G3498"\w*;\f + \fr 1.9: \ft Lit.: ἀπόκριμα, “resposta oficial, sentença”.\f*\x - \xo 1:9 \xt ISA 40:31; ACT 13:30; 1CO 15:16; 2CO 3:5; PSA 56:3; PSA 9:10\x*
\v 10 \w o qual|strong="G3739"\w* \w de tão grande|strong="G1537,G5082"\w* \w morte|strong="G2288"\w* \w nos livrou|strong="G4506,G3165"\w* \w e|strong="G2532"\w* \w livrará|strong="G4506"\w*; \w nele|strong="G1519,G3739"\w* \w temos esperança|strong="G1679"\w* \w de que|strong="G3754"\w* \w ainda|strong="G2532,G2089"\w* \w livrará|strong="G4506"\w*,\x - \xo 1:10 \xt ISA 40:31; PSA 23:6; 1CO 10:13; 1SA 7:12; PSA 4:1; 2TI 4:18\x*
\v 11 \w cooperando também|strong="G4943,G2532"\w* \w vocês|strong="G4771"\w* \w em nosso favor|strong="G5228,G3165"\w* \w com a oração|strong="G3588,G1162"\w*, \w para que|strong="G2443"\w* \w da parte de muitos|strong="G1537,G4183,G4383"\w* \w o dom|strong="G3588,G5486"\w* \w concedido a nós|strong="G1519,G3165"\w* \w por meio de muitos|strong="G1223,G4183"\w* \w seja agradecido|strong="G2168"\w* \w em nosso favor|strong="G5228,G3165"\w*.\f + \fr 1.11: \ft Variante: o RP traz ὑμῶν (“em favor de vocês”) em lugar de ἡμῶν (“em nosso favor”) no fim do verso.\f*\x - \xo 1:11 \xt PHP 4:6; PHP 1:19; ACT 12:5; 2CO 4:15; 1CO 15:57; EXO 17:12\x*
\v 12 \w Pois|strong="G1063"\w* \w o nosso|strong="G3165"\w* \w motivo de glória|strong="G3588,G2746"\w* \w é este|strong="G3778,G1510"\w*: \w o testemunho|strong="G3588,G3142"\w* \w da nossa|strong="G3165"\w* \w consciência|strong="G3588,G4893"\w*, \w de que|strong="G3754"\w* \w em santidade|strong="G1722,G41"\w* \w e|strong="G2532"\w* \w sinceridade|strong="G1505"\w* \w de Deus|strong="G3588,G2316"\w*, \w não|strong="G3756"\w* \w em sabedoria|strong="G1722,G4678"\w* \w carnal|strong="G4559"\w*, \w mas|strong="G235"\w* \w na graça|strong="G1722,G5485"\w* \w de Deus|strong="G2316"\w*, \w nos conduzimos|strong="G390"\w* \w no mundo|strong="G1722,G3588,G2889"\w*, \w e mais ainda|strong="G4056,G1161"\w* \w para com vocês|strong="G4314,G4771"\w*.\f + \fr 1.12: \ft Variante: o SBLGNT, WH, Treg e a NIV trazem ἁγιότητι (“santidade”); NA28, o RP e o TR trazem ἁπλότητι (“simplicidade”); o RP omite τοῦ antes de “Deus”; WH e NA28 trazem καὶ οὐκ (“e não”) em lugar de οὐκ.\f*\f + \fr 1.12: \ft Lit.: καυχάομαι e família (καύχημα, καύχησις): “gloriar-se”; também “orgulhar-se”, “vangloriar-se”, “gabar-se” e “alegrar-se com confiança”. O sentido vai do positivo (confiança, motivo de alegria) ao negativo (jactância), conforme o contexto.\f*\x - \xo 1:12 \xt PRO 20:7; PSA 119:1; 1PE 2:12; JHN 4:24; ROM 8:16; 1CO 2:13\x*
\v 13 \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w lhes escrevemos|strong="G1125,G4771"\w* \w outras coisas|strong="G243"\w* \w senão|strong="G235,G2228"\w* \w o que leem|strong="G3739,G314"\w* \w ou|strong="G2228"\w* \w também|strong="G2532"\w* \w reconhecem|strong="G1921"\w*; \w e espero|strong="G1679,G1161"\w* \w que|strong="G3754"\w* \w até o fim|strong="G2193,G5056"\w* \w reconhecerão|strong="G1921"\w*,\x - \xo 1:13 \xt 2CO 4:2; PHM 1:6; 1CO 10:27; 2CO 5:11\x*
\v 14 \w como|strong="G2531"\w* \w também|strong="G2532"\w* \w nos reconheceram|strong="G1921,G3165"\w* \w em parte|strong="G575,G3313"\w*, \w que|strong="G3754"\w* \w somos motivo de glória|strong="G2745,G1510"\w* \w de vocês|strong="G4771"\w*, \w assim como|strong="G2509"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w dos nossos|strong="G3165"\w*, \w no dia|strong="G1722,G3588,G2250"\w* \w do nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus|strong="G2424"\w*.\f + \fr 1.14: \ft Variante: Treg, a NIV e o RP omitem ἡμῶν (“nosso”) depois de “Senhor”.\f*\x - \xo 1:14 \xt 1TH 2:20; 1TH 2:19; PHP 2:16; 1CO 1:8; 1TH 3:13; PHP 1:10\x*
\v 15 \w E|strong="G2532"\w* \w com esta|strong="G3778,G3588"\w* \w confiança|strong="G4006"\w* \w eu queria|strong="G1014"\w* \w primeiro|strong="G4387"\w* \w ir|strong="G2064"\w* \w até vocês|strong="G4314,G4771"\w*, \w para que|strong="G2443"\w* \w tivessem|strong="G2192"\w* \w uma segunda|strong="G1208"\w* \w graça|strong="G5485"\w*,\f + \fr 1.15: \ft Variante: o RP traz a ordem ἐλθεῖν πρὸς ὑμᾶς τὸ πρότερον (“vir a vocês primeiro”) e ἔχητε em lugar de σχῆτε; WH traz χαράν (“alegria”) em lugar de χάριν (“graça”).\f*\x - \xo 1:15 \xt PHP 1:6; ROM 1:11; ROM 15:29; 1CO 4:19; 1TH 3:10; 2CO 12:14\x*
\v 16 \w e|strong="G2532"\w* \w passar por vocês|strong="G1223,G4771,G1330"\w* \w para a Macedônia|strong="G1519,G3109"\w*, \w e|strong="G2532"\w* \w de novo|strong="G3825"\w*, \w da Macedônia|strong="G575,G3109"\w*, \w vir|strong="G2064"\w* \w até vocês|strong="G4314,G4771"\w*, \w e|strong="G2532"\w* \w por vocês|strong="G5259,G4771"\w* \w ser encaminhado|strong="G4311"\w* \w à Judeia|strong="G1519,G3588,G2449"\w*.\x - \xo 1:16 \xt 1CO 16:5; 3JN 1:6; ACT 19:21; ACT 21:5; JOB 17:11; ROM 15:24\x*
\v 17 \w Querendo|strong="G1014"\w* \w isto|strong="G3778"\w*, \w então|strong="G3767"\w*, \w será que usei|strong="G3385,G686,G5530"\w* \w de leviandade|strong="G3588,G1644"\w*? \w Ou|strong="G2228"\w* \w o que|strong="G3739"\w* \w planejo|strong="G1011"\w*, \w planejo|strong="G1011"\w* \w segundo a carne|strong="G2596,G4561"\w*, \w para que|strong="G2443"\w* \w haja|strong="G1510"\w* \w da minha parte|strong="G3844,G1473"\w* \w o “Sim, sim|strong="G3588,G3483"\w*” \w e|strong="G2532"\w* \w o “Não, não|strong="G3588,G3756"\w*”?\x - \xo 1:17 \xt MAT 5:37; JAS 5:12; 2CO 10:2-3; 2CO 1:18-20; JHN 8:15; JER 23:32\x*
\v 18 \w Mas|strong="G1161"\w* \w Deus|strong="G3588,G2316"\w* \w é fiel|strong="G4103"\w*: \w a nossa palavra|strong="G3588,G3056,G3165"\w* \w dirigida a vocês|strong="G3588,G4314,G4771"\w* \w não|strong="G3756"\w* \w é|strong="G1510"\w* “\w Sim|strong="G3483"\w*” \w e|strong="G2532"\w* “\w Não|strong="G3756"\w*”.\f + \fr 1.18: \ft Lit.: πιστὸς ὁ θεός é fórmula de juramento (“Deus é fiel/testemunha”).\f*\f + \fr 1.18: \ft Acréscimo: verbo ser/estar suprido em “é fiel”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:18 \xt DEU 7:9; MAT 5:37; 1CO 1:9; JAS 5:12; 2CO 1:17; JHN 3:33\x*
\v 19 \w Pois|strong="G1063"\w* \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w*, \w Jesus Cristo|strong="G2424,G5547"\w*, \w que entre vocês|strong="G3588,G1722,G4771"\w* \w foi proclamado|strong="G2784"\w* \w por meio de nós|strong="G1223,G3165"\w*, \w por meu intermédio|strong="G1223,G1473"\w* \w e|strong="G2532"\w* \w de Silvano|strong="G4610"\w* \w e|strong="G2532"\w* \w de Timóteo|strong="G5095"\w*, \w não|strong="G3756"\w* \w se tornou|strong="G1096"\w* “\w Sim|strong="G3483"\w*” \w e|strong="G2532"\w* “\w Não|strong="G3756"\w*”, \w mas|strong="G235"\w* \w nele|strong="G1722,G846"\w* \w se tornou|strong="G1096"\w* “\w Sim|strong="G3483"\w*”;\x - \xo 1:19 \xt 2TH 1:1; 1TH 1:1; JHN 14:6; HEB 13:8; MAT 5:37; JHN 3:3\x*
\v 20 \w pois|strong="G1063"\w* \w todas as promessas|strong="G3745,G1860"\w* \w de Deus|strong="G2316"\w* \w nele|strong="G1722,G846"\w* \w são o “Sim|strong="G3588,G3483"\w*”; \w por isso|strong="G1352"\w* \w também|strong="G2532"\w* \w por meio dele|strong="G1223,G846"\w* \w o “Amém|strong="G3588,G281"\w*” \w a Deus|strong="G3588,G2316"\w* \w para glória|strong="G4314,G1391"\w* \w por meio de nós|strong="G1223,G3165"\w*.\f + \fr 1.20: \ft Variante: o RP omite διό (“por isso”) e traz ἐν αὐτῷ (“nele”) em lugar de δι᾽ αὐτοῦ (“por meio dele”).\f*\f + \fr 1.20: \ft Acréscimo: verbo ser/estar suprido em “são o “Sim””: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:20 \xt ROM 11:36; JHN 14:6; 1JN 2:24-25; MAT 5:37; GAL 3:22; EXO 3:14\x*
\v 21 \w E aquele que|strong="G3588,G1161"\w* \w nos confirma|strong="G950,G3165"\w* \w junto com vocês|strong="G4862,G4771"\w* \w em Cristo|strong="G1519,G5547"\w* \w e|strong="G2532"\w* \w nos ungiu|strong="G5548,G3165"\w* \w é Deus|strong="G2316"\w*,\f + \fr 1.21: \ft Acréscimo: verbo ser/estar suprido em “é Deus”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:21 \xt PSA 23:5; 1JN 2:20; PSA 92:10; 1JN 2:27; 1PE 5:10; ROM 8:9\x*
\v 22 \w o qual|strong="G3588"\w* \w também|strong="G2532"\w* \w nos selou|strong="G4972,G3165"\w* \w e|strong="G2532"\w* \w nos deu|strong="G1325"\w* \w a garantia|strong="G3588,G728"\w* \w do Espírito|strong="G3588,G4151"\w* \w em nossos corações|strong="G1722,G3588,G2588,G3165"\w*.\f + \fr 1.22: \ft Lit.: ἀρραβών, “penhor, primeira prestação, garantia”.\f*\x - \xo 1:22 \xt EPH 1:13; ROM 8:16; EZK 9:4; EPH 1:14; ROM 5:5; EPH 4:30\x*
\v 23 \w E eu|strong="G1473,G1161"\w* \w invoco|strong="G1941"\w* \w como testemunha|strong="G3144"\w* \w Deus|strong="G3588,G2316"\w* \w sobre a minha|strong="G1909,G3588,G1473"\w* \w vida|strong="G5590"\w*, \w de que|strong="G3754"\w*, \w poupando|strong="G5339"\w* \w vocês|strong="G4771"\w*, \w já não|strong="G2089,G3756"\w* \w fui|strong="G2064"\w* \w a Corinto|strong="G1519,G2882"\w*.\x - \xo 1:23 \xt GAL 1:20; 1CO 4:21; 2CO 13:2; 2CO 13:10; ROM 1:9; 2CO 2:1\x*
\v 24 \w Não que|strong="G3756,G3754"\w* \w dominemos|strong="G2961"\w* \w a fé|strong="G3588,G4102"\w* \w de vocês|strong="G4771"\w*, \w mas|strong="G235"\w* \w somos colaboradores|strong="G4904,G1510"\w* \w da alegria|strong="G3588,G5479"\w* \w de vocês|strong="G4771"\w*; \w pois|strong="G1063"\w* \w pela fé|strong="G3588,G4102"\w* \w estão firmes|strong="G2476"\w*.\x - \xo 1:24 \xt 1CO 16:13; 2CO 5:7; 1PE 5:3; 2CO 4:5; JHN 15:11; ROM 11:20\x*
\c 2
\p
\v 1 \w Pois|strong="G1063"\w* \w decidi|strong="G2919"\w* \w comigo mesmo|strong="G1473"\w* \w isto|strong="G3778"\w*: \w não|strong="G3588,G3361"\w* \w de novo|strong="G3825"\w* \w ir|strong="G2064"\w* \w até vocês|strong="G4314,G4771"\w* \w com tristeza|strong="G1722,G3077"\w*.\f + \fr 2.1: \ft Tradução: ἔκρινα (κρίνω, G2919) está aqui como “decidi”; o termo pode ser “julgar”, “decidir”, “condenar” ou “considerar”, e o contexto decide.\f*\x - \xo 2:1 \xt 1CH 4:10; 2CO 1:23; 2CO 1:24; 2CO 13:10; 1CO 4:21; 2CO 12:20-21\x*
\v 2 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w* \w eu|strong="G1473"\w* \w os entristeço|strong="G3076,G4771"\w*, \w então quem|strong="G2532,G5101"\w* \w é aquele que me alegra|strong="G3588,G2165,G3165"\w*, \w a não ser|strong="G1487,G3361"\w* \w o que é entristecido|strong="G3588,G3076"\w* \w por mim|strong="G1537,G1473"\w*?\x - \xo 2:2 \xt 1CH 4:10; 2CO 7:8; MRK 12:14; 2CO 1:24\x*
\v 3 \w E|strong="G2532"\w* \w escrevi|strong="G1125"\w* \w isto mesmo|strong="G3778,G846"\w*, \w para que não|strong="G2443,G3361"\w*, \w ao chegar|strong="G2064"\w*, \w tenha|strong="G2192"\w* \w tristeza|strong="G3077"\w* \w da parte daqueles|strong="G575,G3739"\w* \add de quem\add* \w devia|strong="G1163"\w* \w me alegrar|strong="G3165,G5463"\w*, \w confiando|strong="G3982"\w* \w em todos|strong="G1909,G3956,G4771"\w* \w de que|strong="G3754"\w* \w a minha|strong="G3588,G1473"\w* \w alegria|strong="G5479"\w* \w é a de todos|strong="G3956,G1510"\w* \w vocês|strong="G4771"\w*.\f + \fr 2.3: \ft Acréscimo: “de” (em “parte daqueles de quem devia”): preposição ou artigo que a regência do português exige; “quem” (em “daqueles de quem devia me”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 2:3 \xt PHM 1:21; JHN 16:22; PHP 1:6; GAL 5:10; 1CH 4:10; ROM 12:15\x*
\v 4 \w Pois|strong="G1063"\w* \w de grande|strong="G1537,G4183"\w* \w tribulação|strong="G2347"\w* \w e|strong="G2532"\w* \w angústia|strong="G4928"\w* \w de coração|strong="G2588"\w* \w lhes escrevi|strong="G1125,G4771"\w* \w com muitas|strong="G1223,G4183"\w* \w lágrimas|strong="G1144"\w*, \w não|strong="G3756"\w* \w para que se entristeçam|strong="G2443,G3076"\w*, \w mas|strong="G235"\w* \w para que conheçam|strong="G2443,G1097"\w* \w o amor|strong="G3588,G26"\w* \w que tenho|strong="G3739,G2192"\w* \w em maior medida|strong="G4056"\w* \w por vocês|strong="G1519,G4771"\w*.\x - \xo 2:4 \xt 2CO 7:12; PRO 27:5-6; 1CH 4:10; PRO 12:25; ACT 20:19; 2CO 6:6\x*
\v 5 \w Mas se|strong="G1487,G1161"\w* \w alguém|strong="G5100"\w* \w causou tristeza|strong="G3076"\w*, \w não|strong="G3756"\w* \w a mim|strong="G1473"\w* \w causou tristeza|strong="G3076"\w*, \w mas|strong="G235"\w*, \w em parte|strong="G575,G3313"\w*, \w para que eu não|strong="G2443,G3361"\w* \w sobrecarregue|strong="G1912"\w* \w todos vocês|strong="G3956,G4771"\w*.\x - \xo 2:5 \xt 1CH 4:10; PRO 12:25; 1CO 5:12-13; GAL 4:12; 1CO 5:1-5; 2CO 1:14\x*
\v 6 \w Basta|strong="G2425"\w* \w a tal pessoa|strong="G3588,G5108"\w* \w esta punição|strong="G3588,G2009,G3778"\w* \w imposta|strong="G3588"\w* \w pela maioria|strong="G5259,G3588,G4119"\w*,\x - \xo 2:6 \xt 1CO 5:5; 1CH 4:10; JHN 20:23; PRO 12:25; 1CO 5:4-5; 1TI 5:20\x*
\v 7 \w de modo que|strong="G5620"\w* \w ao contrário|strong="G5121"\w*, \w vocês|strong="G4771"\w* \add devem\add* \w antes|strong="G3123"\w* \w perdoar|strong="G5483"\w* \w e|strong="G2532"\w* \w consolar|strong="G3870"\w*, \w para que não|strong="G3361,G4458"\w* \w seja engolido|strong="G2666"\w* \w pela tristeza|strong="G3588,G3077"\w* \w excessiva|strong="G4055"\w* \w tal pessoa|strong="G3588,G5108"\w*.\f + \fr 2.7: \ft Acréscimo: “devem” (em “contrário vocês devem antes perdoar”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 2:7 \xt GAL 6:1; EPH 4:32; PRO 17:22; JHN 14:1; 1CO 5:5; 1CH 4:10\x*
\v 8 \w Por isso|strong="G1352"\w* \w peço|strong="G3870"\w* \w a vocês|strong="G4771"\w* \w que confirmem|strong="G2964"\w* \w para com ele|strong="G1519,G846"\w* \w amor|strong="G26"\w*.\x - \xo 2:8 \xt JHN 20:23; JUD 1:22-23; 2CO 7:8; GAL 5:13; GAL 6:10\x*
\v 9 \w Pois|strong="G1063"\w* \w para isto|strong="G1519,G3778"\w* \w também|strong="G2532"\w* \w escrevi|strong="G1125"\w*, \w para que eu conheça|strong="G2443,G1097"\w* \w a prova|strong="G3588,G1382"\w* \w de vocês|strong="G4771"\w*, \w se|strong="G1487"\w* \w em tudo|strong="G1519,G3956"\w* \w são obedientes|strong="G5255,G1510"\w*.\x - \xo 2:9 \xt PHP 2:22; 2CO 10:6; JHN 20:23; 2CO 7:12; 2CO 7:15; 1CO 5:4\x*
\v 10 \w Mas a quem|strong="G3739,G1161"\w* \w perdoam|strong="G5483"\w* \w algo|strong="G5100"\w*, \w também eu|strong="G2532_A,G1473"\w*; \w pois|strong="G2532,G1063"\w* \w também eu|strong="G1473"\w*, \w o que|strong="G3739"\w* \w perdoei|strong="G5483"\w*, \w se algo|strong="G1487,G5100"\w* \w perdoei|strong="G5483"\w*, \w por causa|strong="G1223"\w* \w de vocês|strong="G4771"\w* \add o fiz\add* \w diante de Cristo|strong="G1722,G4383,G5547"\w*,\f + \fr 2.10: \ft Lit.: ἐν προσώπῳ Χριστοῦ, “na presença de Cristo” ou “na pessoa de Cristo”.\f*\f + \fr 2.10: \ft Acréscimo: “o” (em “de vocês o fiz diante”): preposição ou artigo que a regência do português exige; “fiz” (em “vocês o fiz diante de”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 2:10 \xt EPH 4:32; MAT 18:18; COL 3:13; EPH 4:27; MAT 16:19; JHN 20:23\x*
\v 11 \w para que não|strong="G2443,G3361"\w* \w sejamos enganados|strong="G4122"\w* \w por Satanás|strong="G5259,G3588,G4567"\w*; \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w ignoramos|strong="G50"\w* \w os planos|strong="G3588,G3540"\w* \w dele|strong="G846"\w*.\x - \xo 2:11 \xt EPH 6:11; 1PE 5:8; 2CO 11:3; 2CO 4:4; LUK 22:31; EPH 4:27\x*
\v 12 \w E tendo chegado|strong="G2064,G1161"\w* \w a Trôade|strong="G1519,G3588,G5174"\w* \w para a boa notícia|strong="G1519,G3588,G2098"\w* \w do Cristo|strong="G3588,G5547"\w*, \w e|strong="G2532"\w* \w estando aberta|strong="G455"\w* \w uma porta|strong="G2374"\w* \w para mim|strong="G3165"\w* \w no Senhor|strong="G1722,G2962"\w*,\x - \xo 2:12 \xt 1CO 16:9; COL 4:3; ACT 14:27; REV 3:8; ROM 1:16; ACT 16:8\x*
\v 13 \w não|strong="G3756"\w* \w tive|strong="G2192"\w* \w alívio|strong="G425"\w* \w no meu|strong="G3588,G3165"\w* \w espírito|strong="G4151"\w* \w por não ter encontrado|strong="G3588,G3361,G2147,G3165"\w* \w Tito|strong="G5103"\w*, \w meu irmão|strong="G3588,G80,G3165"\w*; \w mas|strong="G235"\w*, \w despedindo-me|strong="G657"\w* \w deles|strong="G846"\w*, \w parti|strong="G1831"\w* \w para a Macedônia|strong="G1519,G3109"\w*.\x - \xo 2:13 \xt 2CO 7:5; 2CO 12:18; 2TI 4:10; ACT 16:10; JHN 13:21; TIT 1:4\x*
\v 14 \w Mas graças|strong="G1161,G5485"\w* \w a Deus|strong="G3588,G2316"\w*, \w que sempre|strong="G3588,G3842"\w* \w nos conduz em cortejo triunfal|strong="G2358,G3165"\w* \w em Cristo|strong="G1722,G3588,G5547"\w* \w e|strong="G2532"\w* \w manifesta|strong="G5319"\w* \w por meio de nós|strong="G1223,G3165"\w* \w o aroma|strong="G3588,G3744"\w* \w do conhecimento|strong="G3588,G1108"\w* \w dele|strong="G846"\w* \w em todo lugar|strong="G1722,G3956,G5117"\w*;\f + \fr 2.14: \ft Lit.: θριαμβεύω, “conduzir em cortejo triunfal” (imagem do desfile de um general vitorioso).\f*\x - \xo 2:14 \xt 1CO 15:57; ROM 8:37; EPH 5:2; 2CO 2:15-16; 2CO 9:15; ROM 1:16\x*
\v 15 \w pois|strong="G3754"\w* \w somos|strong="G1510"\w* \w de Cristo|strong="G5547"\w* \w um bom perfume|strong="G2175"\w* \w para Deus|strong="G3588,G2316"\w* \w entre os que estão sendo salvos|strong="G1722,G3588,G4982"\w* \w e|strong="G2532"\w* \w entre os que estão perecendo|strong="G1722,G3588,G622"\w*;\x - \xo 2:15 \xt 1CO 1:18; MAT 18:11; LUK 19:10; EPH 5:2; GEN 8:21; 2CO 2:14\x*
\v 16 \w para estes|strong="G3739,G3303"\w*, \w aroma|strong="G3744"\w* \w de morte|strong="G1537,G2288"\w* \w para morte|strong="G1519,G2288"\w*; \w para aqueles|strong="G3739,G1161"\w*, \w aroma|strong="G3744"\w* \w de vida|strong="G1537,G2222"\w* \w para vida|strong="G1519,G2222"\w*. \w E|strong="G2532"\w* \w para estas coisas|strong="G4314,G3778"\w* \w quem|strong="G5101"\w* \w é capaz|strong="G2425"\w*?\f + \fr 2.16: \ft Acréscimo: verbo ser/estar suprido em “é capaz”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:16 \xt PRO 18:21; 1CO 1:18; 2CO 2:14; ROM 1:16; 2CO 4:3; 2CO 3:5\x*
\v 17 \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w somos|strong="G1510"\w* \w como|strong="G5613"\w* \w muitos|strong="G3588,G4183"\w*, \w que fazem comércio|strong="G2585"\w* \w da palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w*, \w mas|strong="G235"\w* \w com sinceridade|strong="G5613,G1537,G1505"\w*, \w e|strong="G235"\w* \w como da parte de Deus|strong="G5613,G1537,G2316"\w*, \w diante de Deus|strong="G2713,G2316"\w*, \w em Cristo|strong="G1722,G5547"\w* \w falamos|strong="G2980"\w*.\f + \fr 2.17: \ft Lit.: καπηλεύω, “negociar como vendedor de varejo”, com a ideia de adulterar a mercadoria.\f*\f + \fr 2.17: \ft Variante: o RP traz λοιποί (“os demais”) em lugar de πολλοί (“muitos”) e κατενώπιον τοῦ θεοῦ em lugar de κατέναντι θεοῦ.\f*\x - \xo 2:17 \xt HEB 4:12; 2CO 4:2; ROM 10:17; EPH 4:14; 1CO 4:2; 2CO 1:12\x*
\c 3
\p
\v 1 \w Começamos|strong="G757"\w* \w de novo|strong="G3825"\w* \w a recomendar|strong="G4921"\w* \w a nós mesmos|strong="G1438"\w*? \w Ou|strong="G2228"\w* \w será que precisamos|strong="G3361,G5535"\w*, \w como|strong="G5613"\w* \w alguns|strong="G5100"\w*, \w de cartas|strong="G1992"\w* \w de recomendação|strong="G4956"\w* \w para vocês|strong="G4314,G4771"\w* \w ou|strong="G2228"\w* \w da parte de vocês|strong="G1537,G4771"\w*?\x - \xo 3:1 \xt 2CO 10:12; 2CO 12:11; 2CO 5:12; ACT 18:27; 1CO 16:3; 1CO 10:33\x*
\v 2 \w A nossa|strong="G3165"\w* \w carta|strong="G3588,G1992"\w* \w são vocês|strong="G4771,G1510"\w*, \w escrita|strong="G1449"\w* \w nos nossos corações|strong="G1722,G3588,G2588,G3165"\w*, \w conhecida|strong="G1097"\w* \w e|strong="G2532"\w* \w lida|strong="G314"\w* \w por todos|strong="G5259,G3956"\w* \w os seres humanos|strong="G444"\w*;\x - \xo 3:2 \xt 1TH 5:27; 1CO 9:1-2; 1TH 1:8; ROM 1:8; 1CO 3:6; PHP 1:7\x*
\v 3 \w ficando manifesto|strong="G5319"\w* \w que|strong="G3754"\w* \w vocês são|strong="G1510"\w* \w uma carta|strong="G1992"\w* \w de Cristo|strong="G5547"\w*, \w servida|strong="G1247"\w* \w por nós|strong="G5259,G3165"\w*, \w escrita|strong="G1449"\w* \w não|strong="G3756"\w* \w com tinta|strong="G3188"\w*, \w mas|strong="G235"\w* \w com o Espírito|strong="G4151"\w* \w do Deus|strong="G2316"\w* \w vivo|strong="G2198"\w*, \w não|strong="G3756"\w* \w em tábuas|strong="G1722,G4109"\w* \w de pedra|strong="G3035"\w*, \w mas|strong="G235"\w* \w em tábuas|strong="G1722,G4109"\w* \w que são corações|strong="G2588"\w* \w de carne|strong="G4560"\w*\f + \fr 3.3: \ft Variante: o TR traz καρδίας (“do coração”) em lugar de καρδίαις (“corações”) no fim do verso.\f*\f + \fr 3.3: \ft Nota cultural: o contraste entre tábuas de pedra e coração de carne ecoa Êx 24:12, Jr 31:33 e Ez 36:26.\f*.\f + \fr 3.3: \ft Acréscimo: verbo ser/estar suprido em “que são corações”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:3 \xt JER 31:33; EZK 36:26; EXO 24:12; HEB 8:10; EZK 11:19; PRO 3:3\x*
\v 4 \w E tal|strong="G1161,G5108"\w* \w confiança|strong="G4006"\w* \w temos|strong="G2192"\w* \w por meio do Cristo|strong="G1223,G3588,G5547"\w* \w diante de Deus|strong="G4314,G3588,G2316"\w*.\x - \xo 3:4 \xt PHP 4:13; EPH 3:12; PHP 1:6; MAT 13:52; 1CO 3:6; 1TH 1:8\x*
\v 5 \w Não que|strong="G3756,G3754"\w* \w por nós mesmos|strong="G575,G1438"\w* \w sejamos capazes|strong="G2425,G1510"\w* \w de considerar|strong="G3049"\w* \w algo|strong="G5100"\w* \w como vindo de nós mesmos|strong="G5613,G1537,G1438"\w*, \w mas|strong="G235"\w* \w a nossa|strong="G3165"\w* \w capacidade|strong="G3588,G2426"\w* \w vem de Deus|strong="G1537,G3588,G2316"\w*,\f + \fr 3.5: \ft Variante: o RP traz a ordem ἱκανοί ἐσμεν ἀφ᾽ ἑαυτῶν; WH traz αὑτῶν, Treg traz αὐτῶν (“deles”) e NA28 e o RP trazem ἑαυτῶν (“de nós mesmos”).\f*\x - \xo 3:5 \xt PHP 2:13; PHP 4:13; 2CO 12:9; 2CO 4:7; 1CO 15:10; 1SA 17:45\x*
\v 6 \w o qual|strong="G3739"\w* \w também|strong="G2532"\w* \w nos capacitou|strong="G2427,G3165"\w* \w como servidores|strong="G1249"\w* \w de uma nova|strong="G2537"\w* \w aliança|strong="G1242"\w*, \w não|strong="G3756"\w* \w da letra|strong="G1121"\w* \w mas|strong="G235"\w* \w do Espírito|strong="G4151"\w*; \w pois|strong="G1063"\w* \w a letra|strong="G3588,G1121"\w* \w mata|strong="G615"\w*, \w mas o Espírito|strong="G3588,G1161,G4151"\w* \w dá vida|strong="G2227"\w*.\f + \fr 3.6: \ft Nota cultural: ecoa Jr 31:31-34 e Ez 36:26-27; γράμμα, “letra, escrito”.\f*\x - \xo 3:6 \xt JER 31:31; EZK 36:26-27; 2CO 12:9; 2CO 4:7; ROM 8:2; 2CO 3:17\x*
\v 7 \w Mas se|strong="G1487,G1161"\w* \w o ministério|strong="G3588,G1248"\w* \w da morte|strong="G3588,G2288"\w*, \w gravado|strong="G1795"\w* \w em letras|strong="G1722,G1121"\w* \w em pedras|strong="G3037"\w*, \w veio|strong="G1096"\w* \w com glória|strong="G1722,G1391"\w*, \w de modo que|strong="G5620"\w* \w não|strong="G3361"\w* \w podiam|strong="G1410"\w* \w fixar os olhos|strong="G816"\w* \w os filhos|strong="G3588,G5207"\w* \w de Israel|strong="G2474"\w* \w no rosto|strong="G1519,G3588,G4383"\w* \w de Moisés|strong="G3475"\w* \w por causa da glória|strong="G1223,G3588,G1391"\w* \w do seu rosto|strong="G3588,G4383,G846"\w*, \w que se desvanecia|strong="G3588,G2673"\w*,\f + \fr 3.7: \ft Nota cultural: refere-se a Êx 34:29-35; καταργέω, “anular, tornar sem efeito, desvanecer”.\f*\x - \xo 3:7 \xt EXO 34:29; HEB 8:10; 2CO 3:13; JHN 6:63; JER 31:33; JHN 1:17\x*
\v 8 \w como não|strong="G4459,G3780"\w* \w mais ainda|strong="G3123"\w* \w o ministério|strong="G3588,G1248"\w* \w do Espírito|strong="G3588,G4151"\w* \w será|strong="G1510"\w* \w com glória|strong="G1722,G1391"\w*?\x - \xo 3:8 \xt HEB 8:10; ISA 59:21; JHN 6:63; JER 31:33; JHN 1:17; ROM 6:14\x*
\v 9 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w* \w para o ministério|strong="G3588,G1248"\w* \w da condenação|strong="G3588,G2633"\w* \w há glória|strong="G1391"\w*, \w muito mais|strong="G4183,G3123"\w* \w abunda|strong="G4052"\w* \w o ministério|strong="G3588,G1248"\w* \w da justiça|strong="G3588,G1343"\w* \w em glória|strong="G1391"\w*.\f + \fr 3.9: \ft Acréscimo: verbo ser/estar suprido em “há glória”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:9 \xt JHN 1:17; ROM 6:14; 2CO 3:7; HAG 2:9; HEB 5:13; 2CO 4:4\x*
\v 10 \w Pois|strong="G1063"\w* \w de fato|strong="G2532"\w* \w não foi glorificado|strong="G3756,G1392"\w* \w o que foi glorificado|strong="G3588,G1392"\w* \w neste|strong="G1722,G3778,G3588"\w* \w aspecto|strong="G3313"\w*, \w por causa|strong="G1752"\w* \w da glória|strong="G3588,G1391"\w* \w que excede|strong="G5235"\w*.\x - \xo 3:10 \xt ISA 43:18; JHN 1:17; 2CO 3:7; HAG 2:9; HEB 8:6; JHN 3:30\x*
\v 11 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w* \w o que se desvanece|strong="G3588,G2673"\w* \w veio com glória|strong="G1223,G1391"\w*, \w muito mais|strong="G4183,G3123"\w* \w o que permanece|strong="G3588,G3306"\w* \w está em glória|strong="G1722,G1391"\w*.\f + \fr 3.11: \ft Acréscimo: verbo ser/estar suprido em “está em glória”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:11 \xt JHN 12:43; 2CO 3:7; HEB 8:13; HEB 8:6; JHN 3:30; LUK 11:13\x*
\v 12 \w Tendo|strong="G2192"\w*, \w pois|strong="G3767"\w*, \w tal|strong="G5108"\w* \w esperança|strong="G1680"\w*, \w usamos|strong="G5530"\w* \w de muita|strong="G4183"\w* \w ousadia|strong="G3954"\w*,\x - \xo 3:12 \xt 2CO 4:13; 2CO 7:4; EPH 6:19; 2CO 4:1; ACT 4:13; HAB 2:2\x*
\v 13 \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w como|strong="G2509"\w* \w Moisés|strong="G3475"\w*, \w que punha|strong="G5087"\w* \w um véu|strong="G2571"\w* \w sobre o seu rosto|strong="G1909,G3588,G4383,G846"\w*, \w para que não|strong="G4314,G3588,G3361"\w* \w fixassem os olhos|strong="G816"\w* \w os filhos|strong="G3588,G5207"\w* \w de Israel|strong="G2474"\w* \w no fim|strong="G1519,G3588,G5056"\w* \w do que se desvanecia|strong="G3588,G2673"\w*.\x - \xo 3:13 \xt 2CO 3:7; EXO 34:33; PSA 119:18; ISA 25:7; EXO 34:29; EPH 2:14-15\x*
\v 14 \w Mas|strong="G235"\w* \w foram endurecidos|strong="G4456"\w* \w os pensamentos|strong="G3588,G3540"\w* \w deles|strong="G846"\w*; \w pois|strong="G1063"\w* \w até o dia de hoje|strong="G891,G3588,G4594,G2250"\w* \w o mesmo|strong="G3588,G846"\w* \w véu|strong="G2571"\w* \w permanece|strong="G3306"\w* \w na leitura|strong="G1909,G3588,G320"\w* \w da antiga|strong="G3588,G3820"\w* \w aliança|strong="G1242"\w*, \w sem ser removido|strong="G3361,G343"\w*, \w porque|strong="G3754"\w* \w em Cristo|strong="G1722,G5547"\w* \w é abolido|strong="G2673"\w*;\f + \fr 3.14: \ft Lit.: πωρόω, “endurecer, tornar insensível”; νόημα, “pensamento, mente”.\f*\x - \xo 3:14 \xt 2CO 4:4; LUK 24:45; 2CO 4:3; MAT 13:14; 2CO 3:6; ACT 26:18\x*
\v 15 \w mas|strong="G235"\w* \w até hoje|strong="G2193,G4594"\w*, \w sempre que|strong="G2259,G302"\w* \w se lê|strong="G314"\w* \w Moisés|strong="G3475"\w*, \w um véu|strong="G2571"\w* \w está posto|strong="G2749"\w* \w sobre o coração|strong="G1909,G3588,G2588"\w* \w deles|strong="G846"\w*;\x - \xo 3:15 \xt LUK 24:45; ROM 11:8; ROM 11:25; ACT 16:14; PSA 119:18; ISA 25:7\x*
\v 16 \w mas quando|strong="G2259,G1161,G1437"\w* \w se converte|strong="G1994"\w* \w ao Senhor|strong="G4314,G2962"\w*, \w é removido|strong="G4014"\w* \w o véu|strong="G3588,G2571"\w*.\f + \fr 3.16: \ft Nota cultural: ecoa Êx 34:34.\f*\f + \fr 3.16: \ft Tradução: ἐπιστρέψῃ (ἐπιστρέφω, G1994) está aqui como “se converte”; o termo pode ser “voltar”, “retornar” ou “converter-se”, e o contexto decide.\f*\x - \xo 3:16 \xt EXO 34:34; LUK 24:45; ROM 11:25; ACT 16:14; ISA 25:7; ISA 29:18\x*
\v 17 \w Ora, o Senhor|strong="G3588,G1161,G2962"\w* \w é o Espírito|strong="G3588,G4151,G1510"\w*; \w e onde|strong="G3757,G1161"\w* \w está o Espírito|strong="G3588,G4151"\w* \w do Senhor|strong="G2962"\w*, \w há liberdade|strong="G1657"\w*.\f + \fr 3.17: \ft Lit.: κύριος pode referir-se ao “Senhor” (Javé) de Êx 34:34 ou a Cristo; o sentido da identificação “o Senhor é o Espírito” é debatido.\f*\f + \fr 3.17: \ft Acréscimo: verbo ser/estar suprido em “está o Espírito”, “há liberdade”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 3:17 \xt EXO 34:34; GAL 5:1; ISA 59:21; JHN 4:24; JHN 8:36; ROM 8:2\x*
\v 18 \w E nós|strong="G3165,G1161"\w*, \w todos|strong="G3956"\w*, \w de rosto descoberto|strong="G343,G4383"\w*, \w contemplando como num espelho|strong="G2734"\w* \w a glória|strong="G3588,G1391"\w* \w do Senhor|strong="G2962"\w*, \w somos transformados|strong="G3339"\w* \w na mesma|strong="G3588,G846"\w* \w imagem|strong="G1504"\w*, \w de glória|strong="G575,G1391"\w* \w em glória|strong="G1519,G1391"\w*, \w assim como|strong="G2509"\w* \w do Senhor|strong="G575,G2962"\w*, \w o Espírito|strong="G4151"\w*\f + \fr 3.18: \ft Lit.: κατοπτρίζομαι, “ver como num espelho” ou “refletir como um espelho”; ἀπὸ κυρίου πνεύματος admite “do Senhor, que é o Espírito” e “do Espírito do Senhor”.\f*.\x - \xo 3:18 \xt 2CO 4:6; ISA 59:21; ROM 8:29; EPH 4:22-24; ROM 12:2; 2CO 4:4\x*
\c 4
\p
\v 1 \w Por isso|strong="G1223,G3778"\w*, \w tendo|strong="G2192"\w* \w este ministério|strong="G3588,G1248,G3778"\w*, \w conforme|strong="G2531"\w* \w recebemos misericórdia|strong="G1653"\w*, \w não|strong="G3756"\w* \w desanimamos|strong="G1573"\w*,\x - \xo 4:1 \xt GAL 6:9; ISA 40:31; 2CO 4:16; ACT 20:24; LUK 18:1; ROM 12:1\x*
\v 2 \w mas|strong="G235"\w* \w renunciamos|strong="G550"\w* \w às coisas escondidas|strong="G3588,G2927"\w* \w da vergonha|strong="G3588,G152"\w*, \w não andando|strong="G3361,G4043"\w* \w com astúcia|strong="G1722,G3834"\w* \w nem|strong="G3366"\w* \w adulterando|strong="G1389"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w*, \w mas|strong="G235"\w* \w pela manifestação|strong="G3588,G5321"\w* \w da verdade|strong="G3588,G225"\w* \w recomendando-nos|strong="G4921,G1438"\w* \w a toda|strong="G4314,G3956"\w* \w consciência|strong="G4893"\w* \w dos seres humanos|strong="G444"\w* \w diante de Deus|strong="G1799,G3588,G2316"\w*.\x - \xo 4:2 \xt 2TI 2:15; HEB 4:12; 2CO 2:17; 1TH 2:3; PRO 20:27; 2CO 6:7\x*
\v 3 \w E se|strong="G1487,G1161"\w* \w também|strong="G2532"\w* \w está encoberta|strong="G1510,G2572"\w* \w a nossa|strong="G3165"\w* \w boa notícia|strong="G3588,G2098"\w*, \w está encoberta|strong="G1510,G2572"\w* \w entre os que perecem|strong="G1722,G3588,G622"\w*,\x - \xo 4:3 \xt ISA 44:18; HOS 4:6; 1CO 1:18; 2CO 3:14; 2TH 2:9-11; 2CO 2:15\x*
\v 4 \w entre os quais|strong="G1722,G3739"\w* \w o deus|strong="G3588,G2316"\w* \w desta era|strong="G3588,G165,G3778"\w* \w cegou|strong="G5186"\w* \w os pensamentos|strong="G3588,G3540"\w* \w dos descrentes|strong="G3588,G571"\w*, \w para que não|strong="G1519,G3588,G3361"\w* \w vejam resplandecer|strong="G826"\w* \w a luz|strong="G3588,G5462"\w* \w da boa notícia|strong="G3588,G2098"\w* \w da glória|strong="G3588,G1391"\w* \w do Cristo|strong="G3588,G5547"\w*, \w que|strong="G3739"\w* \w é|strong="G1510"\w* \w imagem|strong="G1504"\w* \w de Deus|strong="G3588,G2316"\w*\f + \fr 4.4: \ft Lit.: ὁ θεὸς τοῦ αἰῶνος τούτου, “o deus desta era”, expressão que a maioria dos intérpretes entende como referência a Satanás.\f*.\x - \xo 4:4 \xt EPH 6:12; ISA 44:18; JHN 12:40; ROM 12:2; 2CO 3:14; ACT 26:18\x*
\v 5 \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w a nós mesmos|strong="G1438"\w* \w proclamamos|strong="G2784"\w*, \w mas|strong="G235"\w* \w Cristo Jesus|strong="G5547,G2424"\w* \w como Senhor|strong="G2962"\w*, \w e a nós mesmos|strong="G1438,G1161"\w* \w como escravos|strong="G1401"\w* \w de vocês|strong="G4771"\w* \w por causa de Jesus|strong="G1223,G2424"\w*.\x - \xo 4:5 \xt HOS 4:6; 1CO 2:14; LUK 24:45; MAT 23:11; PSA 119:18; 1JN 2:8\x*
\v 6 \w Pois|strong="G3754"\w* \w o Deus|strong="G3588,G2316"\w* \w que disse|strong="G3588,G2036"\w*: “\w Das trevas|strong="G1537,G4655"\w* \w brilhará|strong="G2989"\w* \w luz|strong="G5457"\w*”, \w é o que|strong="G3739"\w* \w brilhou|strong="G2989"\w* \w em nossos corações|strong="G1722,G3588,G2588,G3165"\w*, \w para iluminação|strong="G4314,G5462"\w* \w do conhecimento|strong="G3588,G1108"\w* \w da glória|strong="G3588,G1391"\w* \w de Deus|strong="G3588,G2316"\w* \w no rosto|strong="G1722,G4383"\w* \w de Cristo|strong="G5547"\w*\f + \fr 4.6: \ft Nota cultural: alude a Gn 1:3.\f*.\f + \fr 4.6: \ft Acréscimo: verbo ser/estar suprido em “é o que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:6 \xt GEN 1:3; 2CO 3:18; ISA 60:2; EPH 1:18; EPH 5:14; HOS 4:6\x*
\v 7 \w Mas temos|strong="G2192,G1161"\w* \w este tesouro|strong="G3588,G2344,G3778"\w* \w em vasos|strong="G1722,G4632"\w* \w de barro|strong="G3749"\w*, \w para que|strong="G2443"\w* \w o excesso|strong="G3588,G5236"\w* \w de poder|strong="G3588,G1411"\w* \w seja|strong="G1510"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w não|strong="G3361"\w* \w nosso|strong="G1537,G3165"\w*.\x - \xo 4:7 \xt 2TI 2:20; 2CO 3:5; 2CO 5:1; PSA 34:19; EPH 2:8-9; 1CO 1:28\x*
\v 8 \w Em tudo|strong="G1722,G3956"\w* \w pressionados|strong="G2346"\w*, \w mas|strong="G235"\w* \w não|strong="G3756"\w* \w encurralados|strong="G4729"\w*; \w perplexos|strong="G639"\w*, \w mas|strong="G235"\w* \w não|strong="G3756"\w* \w desesperados|strong="G1820"\w*;\x - \xo 4:8 \xt ISA 40:31; JAS 1:2-4; ROM 8:35-37; 1PE 4:12-14; PSA 34:19; 2CO 12:10\x*
\v 9 \w perseguidos|strong="G1377"\w*, \w mas|strong="G235"\w* \w não|strong="G3756"\w* \w abandonados|strong="G1459"\w*; \w derrubados|strong="G2598"\w*, \w mas|strong="G235"\w* \w não|strong="G3756"\w* \w destruídos|strong="G622"\w*;\x - \xo 4:9 \xt ISA 40:31; PSA 34:19; PRO 24:16; PSA 27:13; MAT 5:10; PSA 73:26\x*
\v 10 \w sempre|strong="G3842"\w* \w levando em torno|strong="G4064"\w* \w no corpo|strong="G1722,G3588,G4983"\w* \w a morte|strong="G3588,G3500"\w* \w de Jesus|strong="G3588,G2424"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w a vida|strong="G3588,G2222"\w* \w de Jesus|strong="G3588,G2424"\w* \w no nosso corpo|strong="G1722,G3588,G4983,G3165"\w* \w seja manifestada|strong="G5319"\w*;\f + \fr 4.10: \ft Variante: o RP e o TR acrescentam κυρίου (“do Senhor”) antes de “Jesus”, de modo que a leitura é “a morte do Senhor Jesus”.\f*\x - \xo 4:10 \xt GAL 2:20; ISA 40:31; PSA 34:19; ROM 6:5; 2TI 2:11; PRO 24:16\x*
\v 11 \w pois|strong="G1063"\w* \w nós|strong="G3165"\w*, \w os que vivemos|strong="G3588,G2198"\w*, \w somos continuamente|strong="G104"\w* \w entregues|strong="G3860"\w* \w à morte|strong="G1519,G2288"\w* \w por causa de Jesus|strong="G1223,G2424"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w a vida|strong="G3588,G2222"\w* \w de Jesus|strong="G3588,G2424"\w* \w seja manifestada|strong="G5319"\w* \w na nossa carne mortal|strong="G1722,G3588,G2349,G4561,G3165"\w*.\f + \fr 4.11: \ft Acréscimo: verbo ser/estar suprido em “somos continuamente”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:11 \xt GAL 2:20; ROM 8:11; PSA 34:19; PRO 24:16; PSA 27:13; MAT 5:10\x*
\v 12 \w De modo que|strong="G5620"\w* \w a morte|strong="G3588,G2288"\w* \w age|strong="G1754"\w* \w em nós|strong="G1722,G3165"\w*, \w mas a vida|strong="G3588,G1161,G2222"\w* \w em vocês|strong="G1722,G4771"\w*.\x - \xo 4:12 \xt PSA 34:19; PRO 24:16; PSA 27:13; MAT 5:10; PHP 3:10; ROM 5:4\x*
\v 13 \w Mas tendo|strong="G2192,G1161"\w* \w o mesmo|strong="G3588,G846"\w* \w espírito|strong="G4151"\w* \w de fé|strong="G3588,G4102"\w*, \w conforme|strong="G2596"\w* \w o que está escrito|strong="G3588,G1125"\w*: “\w Eu cri|strong="G4100"\w*, \w por isso|strong="G1352"\w* \w falei|strong="G2980"\w*”, \w também nós|strong="G2532,G3165"\w* \w cremos|strong="G4100"\w*, \w e por isso|strong="G1352,G2532"\w* \w falamos|strong="G2980"\w*,\f + \fr 4.13: \ft Nota cultural: cita Sl 116:10 (115:1 na LXX).\f*\x - \xo 4:13 \xt PSA 116:10; PSA 27:13; PHP 3:10; 1TH 4:14; HEB 11:1-40; 2CO 3:12\x*
\v 14 \w sabendo|strong="G6063"\w* \w que|strong="G3754"\w* \w aquele que ressuscitou|strong="G3588,G1453"\w* \w Jesus|strong="G3588,G2424"\w* \w também a nós|strong="G2532,G3165"\w* \w com Jesus|strong="G4862,G2424"\w* \w ressuscitará|strong="G1453"\w* \w e|strong="G2532"\w* \w nos apresentará|strong="G3936"\w* \w junto com vocês|strong="G4862,G4771"\w*.\x - \xo 4:14 \xt ROM 8:11; PSA 27:13; JUD 1:24; 1TH 4:14; ACT 2:24; EPH 5:27\x*
\v 15 \w Pois|strong="G1063"\w* \w todas as coisas|strong="G3588,G3956"\w* \w são por causa de vocês|strong="G1223,G4771"\w*, \w para que|strong="G2443"\w* \w a graça|strong="G3588,G5485"\w*, \w tendo se multiplicado|strong="G4121"\w* \w por meio de muitos|strong="G1223,G3588,G4119"\w*, \w faça abundar|strong="G4052"\w* \w a ação de graças|strong="G3588,G2169"\w* \w para a glória|strong="G1519,G3588,G1391"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 4.15: \ft Acréscimo: verbo ser/estar suprido em “são por causa de vocês”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:15 \xt ROM 8:28; 2CO 9:11; 2CO 1:11; EPH 3:20-21; 2CO 1:6; COL 3:15\x*
\v 16 \w Por isso|strong="G1352"\w* \w não|strong="G3756"\w* \w desanimamos|strong="G1573"\w*; \w mas|strong="G235"\w* \w ainda que|strong="G1487,G2532"\w* \w o nosso|strong="G3165"\w* \w ser humano|strong="G444"\w* \w exterior|strong="G3588,G1854"\w* \w se desgaste|strong="G1311"\w*, \w o nosso|strong="G3165"\w* \w interior|strong="G3588,G2080"\w* \w é renovado|strong="G341"\w* \w dia após dia|strong="G2250,G2532"\w*.\f + \fr 4.16: \ft Não traduzido: ἀλλʼ (G235): ἀλλά (but); sem equivalente natural em português neste ponto.\f*\x - \xo 4:16 \xt GAL 6:9; ISA 40:31; ROM 8:28; ROM 12:1; COL 3:10; ISA 40:29\x*
\v 17 \w Pois|strong="G1063"\w* \w a nossa|strong="G3165"\w* \w tribulação|strong="G3588,G2347"\w* \w momentânea|strong="G3588,G3910"\w* \w e leve|strong="G1645"\w* \w produz|strong="G2716"\w* \w para nós|strong="G3165"\w*, \w de modo excessivo|strong="G2596,G5236,G1519"\w*, \w um peso|strong="G922"\w* \w eterno|strong="G166"\w* \w de glória|strong="G1391"\w*;\x - \xo 4:17 \xt ROM 5:3; 1PE 5:10; ROM 8:18; ROM 8:28; PSA 30:5; ISA 26:20\x*
\v 18 \w não olhando nós|strong="G3361,G4648,G3165"\w* \w para as coisas visíveis|strong="G3588,G991"\w*, \w mas|strong="G235"\w* \w para as invisíveis|strong="G3588,G3361,G991"\w*; \w pois|strong="G1063"\w* \w as visíveis|strong="G3588,G991"\w* \w são passageiras|strong="G4340"\w*, \w mas as invisíveis|strong="G3588,G1161,G3361,G991"\w* \w são eternas|strong="G166"\w*.\f + \fr 4.18: \ft Acréscimo: verbo ser/estar suprido em “são passageiras”, “são eternas”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:18 \xt 2CO 5:7; HEB 11:1; ROM 8:18; COL 3:1; ROM 8:24; MAT 6:21\x*
\c 5
\p
\v 1 \w Pois|strong="G1063"\w* \w sabemos|strong="G6063"\w* \w que|strong="G3754"\w*, \w se|strong="G1437"\w* \w a nossa|strong="G3165"\w* \w casa|strong="G3614"\w* \w terrena|strong="G3588,G1919"\w* \w da tenda|strong="G3588,G4636"\w* \w for desfeita|strong="G2647"\w*, \w temos|strong="G2192"\w* \w da parte de Deus|strong="G1537,G2316"\w* \w um edifício|strong="G3619"\w*, \w uma casa|strong="G3614"\w* \w não feita por mãos|strong="G886"\w*, \w eterna|strong="G166"\w*, \w nos céus|strong="G1722,G3588,G3772"\w*.\x - \xo 5:1 \xt MRK 14:58; PSA 23:6; PHP 1:21; ROM 8:28; 2CO 4:7; JHN 14:2\x*
\v 2 \w Pois|strong="G2532,G1063"\w* \w nisto|strong="G1722,G3778"\w* \w gememos|strong="G4727"\w*, \w ansiando|strong="G1971"\w* \w revestir-nos|strong="G1902"\w* \w da nossa|strong="G3165"\w* \w habitação|strong="G3588,G3613"\w* \w que vem|strong="G3588,G1537"\w* \w do céu|strong="G3772"\w*,\x - \xo 5:2 \xt 2CO 5:4; ROM 8:23; JHN 11:25; 1CO 15:53; GEN 3:21; ROM 8:26\x*
\v 3 \w se é que|strong="G1487,G1065"\w* \w tendo nos vestido|strong="G2532,G1746"\w*, \w não|strong="G3756"\w* \w seremos achados|strong="G2147"\w* \w nus|strong="G1131"\w*.\f + \fr 5.3: \ft Variante: Treg traz εἴ περ em lugar de εἴ γε; NA28 traz ἐκδυσάμενοι (“tendo sido despidos”) em lugar de ἐνδυσάμενοι (“tendo nos vestido”).\f*\f + \fr 5.3: \ft Acréscimo: verbo ser/estar suprido em “se é que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:3 \xt ROM 8:23; JHN 11:25; 1CO 15:53; GEN 3:21; REV 16:15; ROM 8:10\x*
