\v 16 \w De modo que|strong="G5620"\w* \w nós|strong="G3165"\w*, \w desde agora|strong="G575,G3588,G3568"\w*, \w ninguém|strong="G3762"\w* \w conhecemos|strong="G6063"\w* \w segundo a carne|strong="G2596,G4561"\w*; \w ainda que|strong="G1487,G2532"\w* \w tenhamos conhecido|strong="G1097"\w* \w segundo a carne|strong="G2596,G4561"\w* \w Cristo|strong="G5547"\w*, \w agora|strong="G235,G3568"\w* \w já não|strong="G2089,G3756"\w* \w o conhecemos assim|strong="G1097"\w*.\x - \xo 5:16 \xt MRK 10:8; 2CO 5:17; COL 3:11; 2CO 5:15; MAT 19:29; PHP 3:7-8\x*
\v 17 \w De modo que|strong="G5620"\w* \w se alguém|strong="G1487,G5100"\w* \w está em Cristo|strong="G1722,G5547"\w*, \w é uma nova|strong="G2537"\w* \w criação|strong="G2937"\w*: \w as coisas antigas|strong="G3588,G744"\w* \w passaram|strong="G3928"\w*; \w olhem|strong="G2400"\w*, \w vieram a ser|strong="G1096"\w* \w novas|strong="G2537"\w*.\f + \fr 5.17: \ft Nota cultural: ecoa Is 43:18-19 e 65:17.\f*\f + \fr 5.17: \ft Variante: o RP e o TR acrescentam τὰ πάντα (“todas as coisas”) depois de “novas”.\f*\f + \fr 5.17: \ft Acréscimo: verbo ser/estar suprido em “está em Cristo”, “é uma nova”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:17 \xt ISA 43:18-19; ISA 65:17; GAL 6:15; COL 3:1-10; EPH 2:10; EPH 4:22-24\x*
\v 18 \w E todas as coisas|strong="G3588,G1161,G3956"\w* \add vêm\add* \w de Deus|strong="G1537,G3588,G2316"\w*, \w que nos reconciliou|strong="G3588,G2644,G3165"\w* \w consigo|strong="G1438"\w* \w por meio de Cristo|strong="G1223,G5547"\w* \w e|strong="G2532"\w* \w nos deu|strong="G1325,G3165"\w* \w o ministério|strong="G3588,G1248"\w* \w da reconciliação|strong="G3588,G2643"\w*,\f + \fr 5.18: \ft Variante: o RP e o TR acrescentam Ἰησοῦ (“Jesus”) depois de “por meio de”.\f*\f + \fr 5.18: \ft Acréscimo: “vêm” (em “as coisas vêm de Deus”): verbo acrescentado: o grego traz a frase sem verbo (construção nominal ou elíptica) e o português exige um, tomado do contexto.\f*\x - \xo 5:18 \xt COL 1:20; ISA 45:17; ROM 5:10; JHN 3:5; 2CO 5:19-20; EPH 2:16\x*
\v 19 \w a saber|strong="G5613,G3754"\w* \add que\add* \w Deus|strong="G2316"\w* \w estava|strong="G1510"\w* \w em Cristo|strong="G1722,G5547"\w* \w reconciliando|strong="G2644"\w* \w o mundo|strong="G2889"\w* \w consigo|strong="G1438"\w*, \w não lhes atribuindo|strong="G3361,G3049,G846"\w* \w as ofensas|strong="G3588,G3900"\w* \w deles|strong="G846"\w*, \w e|strong="G2532"\w* \w pondo|strong="G5087"\w* \w em nós|strong="G1722,G3165"\w* \w a palavra|strong="G3588,G3056"\w* \w da reconciliação|strong="G3588,G2643"\w*.\f + \fr 5.19: \ft Acréscimo: “que” (em “a saber que Deus estava”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 5:19 \xt JHN 3:16; ROM 11:15; 2CO 5:17; COL 1:20; ISA 45:17; ROM 5:10\x*
\v 20 \w Em nome|strong="G5228"\w* \w de Cristo|strong="G5547"\w*, \w pois|strong="G3767"\w*, \w somos embaixadores|strong="G4243"\w*, \w como se|strong="G5613"\w* \w Deus|strong="G3588,G2316"\w* \w exortasse|strong="G3870"\w* \w por meio de nós|strong="G1223,G3165"\w*; \w pedimos|strong="G1189"\w* \w em nome|strong="G5228"\w* \w de Cristo|strong="G5547"\w*: \w deixem-se reconciliar|strong="G2644"\w* \w com Deus|strong="G3588,G2316"\w*.\x - \xo 5:20 \xt EPH 6:20; JHN 3:16; COL 1:20; ROM 12:1; ISA 45:17; LUK 14:23\x*
\v 21 \w Aquele que|strong="G3588"\w* \w não|strong="G3361"\w* \w conheceu|strong="G1097"\w* \w pecado|strong="G266"\w*, \add Deus\add* \w o fez pecado|strong="G266,G4160"\w* \w por nós|strong="G5228,G3165"\w*, \w para que|strong="G2443"\w* \w nós|strong="G3165"\w* \w nos tornássemos|strong="G1096"\w* \w justiça|strong="G1343"\w* \w de Deus|strong="G2316"\w* \w nele|strong="G1722,G846"\w*\f + \fr 5.21: \ft Lit.: ἁμαρτίαν ἐποίησεν, “fez pecado”; entende-se como identificação com o pecado ou como oferta pelo pecado (cf. Lv 4), e o sentido é debatido.\f*.\f + \fr 5.21: \ft Acréscimo: “Deus” (em “conheceu pecado Deus o fez”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 5:21 \xt 1PE 2:22; 1PE 3:18; JHN 3:16; MAT 6:33; ISA 53:5; ROM 5:19\x*
