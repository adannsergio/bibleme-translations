\v 11 \w A nossa|strong="G3165"\w* \w boca|strong="G3588,G4750"\w* \w se abriu|strong="G455"\w* \w para vocês|strong="G4314,G4771"\w*, \w coríntios|strong="G2881"\w*; \w o nosso|strong="G3165"\w* \w coração|strong="G3588,G2588"\w* \w se alargou|strong="G4115"\w*.\x - \xo 6:11 \xt 1TI 4:12; PSA 119:32; 2CO 12:15; 2CO 7:3; PHP 1:8; 2CO 2:4\x*
\v 12 \w Não|strong="G3756"\w* \w estão restringidos|strong="G4729"\w* \w em nós|strong="G1722,G3165"\w*; \w mas estão restringidos|strong="G4729,G1161"\w* \w nas suas|strong="G1722,G3588,G4771"\w* \w entranhas|strong="G4698"\w*.\f + \fr 6.12: \ft Lit.: σπλάγχνα, “entranhas”, sede dos afetos.\f*\x - \xo 6:12 \xt 1TI 4:12; 2CO 7:2; 2CO 7:3; 2CO 12:15; EXO 28:30; MIC 2:7\x*
\v 13 \w E como retribuição|strong="G3588,G1161,G489"\w* \w equivalente|strong="G846"\w* — \w falo|strong="G3004"\w* \w como a filhos|strong="G5613,G5043"\w* — \w alarguem-se|strong="G4115"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w*.\x - \xo 6:13 \xt 1TI 4:12; 1JN 3:18; 2CO 7:2; 3JN 1:4; 1CO 4:14; 1JN 2:1\x*
\v 14 \w Não se unam em jugo desigual|strong="G3361,G1096,G2086"\w* \w com os incrédulos|strong="G571"\w*; \w pois|strong="G1063"\w* \w que participação|strong="G5101,G3352"\w* \w há entre justiça|strong="G1343"\w* \w e|strong="G2532"\w* \w iniquidade|strong="G458"\w*, \w ou|strong="G2228"\w* \w que comunhão|strong="G5101,G2842"\w* \w da luz|strong="G5457"\w* \w com as trevas|strong="G4314,G4655"\w*?\f + \fr 6.14: \ft Lit.: ἑτεροζυγέω, “estar sob jugo desigual” (como animais de tipos diferentes atrelados juntos); cf. Dt 22:10.\f*\f + \fr 6.14: \ft Acréscimo: verbo ser/estar suprido em “há entre justiça”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:14 \xt DEU 22:10; 1CO 15:33; AMO 3:3; 1CO 10:21; JAS 4:4; 1JN 1:6\x*
\v 15 \w E que harmonia|strong="G5101,G1161,G4857"\w* \w de Cristo|strong="G5547"\w* \w com Belial|strong="G4314,G955"\w*? \w Ou|strong="G2228"\w* \w que parte|strong="G5101,G3310"\w* \w tem o crente|strong="G4103"\w* \w com o incrédulo|strong="G3326,G571"\w*?\f + \fr 6.15: \ft Lit.: Βελιάρ (Belial), nome hebraico que significa “sem valor” e que designa um poder do mal.\f*\x - \xo 6:15 \xt AMO 3:3; ROM 12:2; PRO 13:20; LEV 19:19; MAL 2:11; 1TI 4:12\x*
\v 16 \w E que acordo|strong="G5101,G1161,G4783"\w* \w há entre o santuário|strong="G3485"\w* \w de Deus|strong="G2316"\w* \w e|strong="G3326"\w* \w ídolos|strong="G1497"\w*? \w Pois|strong="G1063"\w* \w nós|strong="G3165"\w* \w somos|strong="G1510"\w* \w santuário|strong="G3485"\w* \w do Deus|strong="G2316"\w* \w vivo|strong="G2198"\w*, \w como|strong="G2531"\w* \w disse|strong="G2036"\w* \w Deus|strong="G3588,G2316"\w*: “\w Habitarei|strong="G1774"\w* \w entre eles|strong="G1722,G846"\w* \w e|strong="G2532"\w* \w andarei|strong="G1704"\w*, \w e|strong="G2532"\w* \w serei|strong="G1510"\w* \w o Deus|strong="G2316"\w* \w deles|strong="G846"\w*, \w e|strong="G2532"\w* \w eles|strong="G846"\w* \w serão|strong="G1510"\w* \w o meu|strong="G3165"\w* \w povo|strong="G2992"\w*\f + \fr 6.16: \ft Variante: o RP traz Ὑμεῖς γὰρ ναὸς θεοῦ ἐστε (“vocês são o santuário de Deus”) em lugar de “nós somos” e traz μοι em lugar de μου.\f*\f + \fr 6.16: \ft Nota cultural: cita Lv 26:11-12 e Ez 37:27.\f*.\f + \fr 6.16: \ft Acréscimo: verbo ser/estar suprido em “há entre o santuário”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:16 \xt EZK 37:27; LEV 26:11-12; 1CO 3:16; 1CO 6:19; 1JN 4:15; EXO 29:45\x*
\v 17 \w Por isso|strong="G1352"\w* \w saiam|strong="G1831"\w* \w do meio|strong="G1537,G3319"\w* \w deles|strong="G846"\w* \w e|strong="G2532"\w* \w separem-se|strong="G873"\w*, \w diz|strong="G3004"\w* \w o Senhor|strong="G2962"\w*, \w e|strong="G2532"\w* \w não toquem|strong="G3361,G681"\w* \w no impuro|strong="G169"\w*; \w e eu|strong="G2532_C,G1473"\w* \w acolherei vocês|strong="G1523,G4771"\w*\f + \fr 6.17: \ft Nota cultural: cita Is 52:11.\f*;\x - \xo 6:17 \xt ISA 52:11; JHN 1:12; ROM 12:2; PRO 13:20; LEV 19:19; REV 18:4\x*
\v 18 \w e|strong="G2532"\w* \w serei|strong="G1510"\w* \w para vocês|strong="G4771"\w* \w um pai|strong="G1519,G3962"\w*, \w e|strong="G2532"\w* \w vocês|strong="G4771"\w* \w serão|strong="G1510"\w* \w para mim|strong="G3165"\w* \w filhos|strong="G1519,G5207"\w* \w e|strong="G2532"\w* \w filhas|strong="G2364"\w*, \w diz|strong="G3004"\w* \w o Senhor|strong="G2962"\w* \w Todo-Poderoso|strong="G3841"\w*.”\f + \fr 6.18: \ft Nota cultural: ecoa 2Sm 7:14 e Is 43:6.\f*\x - \xo 6:18 \xt 2SA 7:14; ISA 43:6; JHN 1:12; HOS 1:10; 1JN 3:1; PRO 13:20\x*
\c 7
\p
\v 1 \w Tendo|strong="G2192"\w*, \w pois|strong="G3767"\w*, \w estas promessas|strong="G3778,G3588,G1860"\w*, \w amados|strong="G27"\w*, \w purifiquemo-nos|strong="G2511,G1438"\w* \w de toda|strong="G575,G3956"\w* \w contaminação|strong="G3436"\w* \w da carne|strong="G4561"\w* \w e|strong="G2532"\w* \w do espírito|strong="G4151"\w*, \w levando à perfeição|strong="G2005"\w* \w a santidade|strong="G42"\w* \w no temor|strong="G1722,G5401"\w* \w de Deus|strong="G2316"\w*.\x - \xo 7:1 \xt HEB 12:14; 1TH 4:7; 1CO 15:58; HEB 12:1; 1PE 2:11; GAL 5:16\x*
\v 2 \w Abram espaço para nós|strong="G5562,G3165"\w*: \w ninguém|strong="G3762"\w* \w prejudicamos|strong="G91"\w*, \w ninguém|strong="G3762"\w* \w arruinamos|strong="G5351"\w*, \w ninguém|strong="G3762"\w* \w exploramos|strong="G4122"\w*.\x - \xo 7:2 \xt 2CO 11:9; 2CO 6:12; 2CO 6:6; ACT 20:33; 1TH 2:3; 3JN 1:8\x*
\v 3 \w Não digo isto|strong="G3756,G3004"\w* \w para condenação|strong="G4314,G2633"\w*; \w pois|strong="G1063"\w* \w já disse antes|strong="G4280"\w* \w que|strong="G3754"\w* \w estão|strong="G1510"\w* \w nos nossos corações|strong="G1722,G3588,G2588,G3165"\w* \w para morrer juntos|strong="G1519,G3588,G4880"\w* \w e|strong="G2532"\w* \w viver juntos|strong="G4800"\w*.\x - \xo 7:3 \xt 2TI 2:11; PHP 1:7; 2CO 6:11; PHP 1:8-9; 3JN 1:8; 1TH 2:8\x*
\v 4 \w Grande|strong="G4183"\w* \w é a minha|strong="G3165"\w* \w ousadia|strong="G3954"\w* \w para com vocês|strong="G4314,G4771"\w*, \w grande|strong="G4183"\w* \w é o meu|strong="G3165"\w* \w motivo de glória|strong="G2746"\w* \w por vocês|strong="G5228,G4771"\w*; \w estou cheio|strong="G4137"\w* \w de consolo|strong="G3588,G3874"\w*, \w transbordo|strong="G5248"\w* \w de alegria|strong="G3588,G5479"\w* \w em toda|strong="G1909,G3956,G3588"\w* \w a nossa|strong="G3165"\w* \w tribulação|strong="G2347"\w*.\f + \fr 7.4: \ft Acréscimo: verbo ser/estar suprido em “é a minha”, “é o meu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:4 \xt 2CO 1:4; JHN 16:33; COL 1:24; ACT 20:24; 2CO 3:12; 2CO 6:11\x*
\v 5 \w Pois|strong="G2532,G1063"\w*, \w tendo nós chegado|strong="G2064,G3165"\w* \w à Macedônia|strong="G1519,G3109"\w*, \w a nossa|strong="G3165"\w* \w carne|strong="G3588,G4561"\w* \w não teve nenhum|strong="G3762,G2192"\w* \w alívio|strong="G425"\w*, \w mas|strong="G235"\w* \w em tudo|strong="G1722,G3956"\w* \w atribulados|strong="G2346"\w* — \w por fora|strong="G1855"\w* \w lutas|strong="G3163"\w*, \w por dentro|strong="G2081"\w* \w temores|strong="G5401"\w*—\x - \xo 7:5 \xt 2CO 2:13; PSA 56:3; 2CO 4:8; PSA 34:4; 1SA 30:6; ISA 51:12\x*
\v 6 \w mas|strong="G235"\w* \w Deus|strong="G3588,G2316"\w*, \w que consola|strong="G3588,G3870"\w* \w os abatidos|strong="G3588,G5011"\w*, \w nos consolou|strong="G3870,G3165"\w* \w com a chegada|strong="G1722,G3588,G3952"\w* \w de Tito|strong="G5103"\w*;\x - \xo 7:6 \xt 2CO 7:13; ISA 61:1; 2CO 1:4; PSA 56:3; PSA 34:4; JER 31:25\x*
\v 7 \w e não somente|strong="G3756,G3441,G1161"\w* \w com a sua chegada|strong="G1722,G3588,G3952,G846"\w*, \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w com o consolo|strong="G1722,G3588,G3874"\w* \w com que foi consolado|strong="G3739,G3870"\w* \w por vocês|strong="G1909,G4771"\w*, \w relatando-nos|strong="G312,G3165"\w* \w a saudade|strong="G3588,G1972"\w* \w de vocês|strong="G4771"\w*, \w o pranto|strong="G3588,G3602"\w* \w de vocês|strong="G4771"\w*, \w o zelo|strong="G3588,G2205"\w* \w de vocês|strong="G4771"\w* \w por mim|strong="G5228,G1473"\w*, \w de modo que|strong="G5620"\w* \w eu|strong="G3165"\w* \w me alegrei|strong="G5463"\w* \add ainda\add* \w mais|strong="G3123"\w*.\f + \fr 7.7: \ft Acréscimo: “ainda” (em “me alegrei ainda mais”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 7:7 \xt 2CO 1:4; PHP 4:10; 3JN 1:3; 2CO 8:7; COL 1:4; COL 4:11\x*
\v 8 \w Pois|strong="G3754"\w* \w ainda que|strong="G1487,G2532"\w* \w eu os tenha entristecido|strong="G3076,G4771"\w* \w na carta|strong="G1722,G3588,G1992"\w*, \w não|strong="G3756"\w* \w o lamento|strong="G3338"\w*; \w embora|strong="G1487,G2532"\w* \w o lamentasse|strong="G3338"\w* — \w vejo|strong="G991"\w* \w que|strong="G3754"\w* \w aquela|strong="G1565"\w* \w carta|strong="G3588,G1992"\w*, \w ainda que|strong="G1487,G2532"\w* \w por um momento|strong="G4314,G5610"\w*, \w os entristeceu|strong="G3076,G4771"\w*—\f + \fr 7.8: \ft Tradução: ὥραν (ὥρα, G5610) está aqui como “por um momento”; o termo pode ser “hora”, “momento”, “ocasião” ou “tempo marcado”, e o contexto decide.\f*\x - \xo 7:8 \xt PSA 126:5; 2CO 2:2; 1CO 5:2; JHN 16:6; REV 3:19; TIT 1:13\x*
\v 9 \w agora|strong="G3568"\w* \w me alegro|strong="G5463"\w*, \w não porque|strong="G3756,G3754"\w* \w se entristeceram|strong="G3076"\w*, \w mas|strong="G235"\w* \w porque|strong="G3754"\w* \w se entristeceram|strong="G3076"\w* \w para arrependimento|strong="G1519,G3341"\w*; \w pois|strong="G1063"\w* \w se entristeceram|strong="G3076"\w* \w segundo Deus|strong="G2596,G2316"\w*, \w para que|strong="G2443"\w* \w em nada|strong="G1722,G3367"\w* \w sofressem dano|strong="G2210"\w* \w da nossa parte|strong="G1537,G3165"\w*.\x - \xo 7:9 \xt MAT 5:4; PSA 30:5; ECC 7:3; PSA 126:5; 1CO 13:6; LUK 15:7\x*
\v 10 \w Pois|strong="G1063"\w* \w a tristeza|strong="G3588,G3077"\w* \w segundo Deus|strong="G2596,G2316"\w* \w produz|strong="G2038"\w* \w arrependimento|strong="G3341"\w* \w para salvação|strong="G1519,G4991"\w* \w que não se lamenta|strong="G278"\w*; \w mas a tristeza|strong="G3588,G1161,G3077"\w* \w do mundo|strong="G3588,G2889"\w* \w produz|strong="G2716"\w* \w morte|strong="G2288"\w*\f + \fr 7.10: \ft Lit.: ἀμεταμέλητος, “sem pesar posterior, que não se revoga”.\f*.\x - \xo 7:10 \xt MAT 5:4; PRO 17:22; ACT 3:19; ACT 11:18; 2TI 2:25-26; 2SA 12:13\x*
\v 11 \w Pois|strong="G1063"\w* \w olhem|strong="G2400"\w*, \w isto mesmo|strong="G846,G3778"\w*, \w o ter-se entristecido|strong="G3588,G3076"\w* \w segundo Deus|strong="G2596,G2316"\w*, \w quanto empenho|strong="G4214,G4710"\w* \w produziu|strong="G2716"\w* \w em vocês|strong="G4771"\w*, \w e até|strong="G235"\w* \w defesa|strong="G627"\w*, \w e até|strong="G235"\w* \w indignação|strong="G24"\w*, \w e até|strong="G235"\w* \w temor|strong="G5401"\w*, \w e até|strong="G235"\w* \w saudade|strong="G1972"\w*, \w e até|strong="G235"\w* \w zelo|strong="G2205"\w*, \w e até|strong="G235"\w* \w castigo|strong="G1557"\w*; \w em tudo|strong="G1722,G3956"\w* \w demonstraram|strong="G4921"\w* \w que vocês mesmos|strong="G1438"\w* \w estão puros|strong="G53,G1511"\w* \w no assunto|strong="G3588,G4229"\w*.\f + \fr 7.11: \ft Variante: o RP e o TR acrescentam ὑμᾶς (“vocês”) depois de “ter-se entristecido” e o RP acrescenta ἐν antes de “no assunto”.\f*\x - \xo 7:11 \xt JAS 4:9; ECC 7:3; JUD 1:23; PSA 126:5; REV 3:19; ROM 14:18\x*
\v 12 \w Portanto|strong="G686"\w*, \w embora|strong="G1487,G2532"\w* \w lhes tenha escrito|strong="G1125,G4771"\w*, \w não|strong="G3756"\w* \w por causa|strong="G1752"\w* \w do que cometeu injustiça|strong="G3588,G91"\w* \w nem|strong="G3761"\w* \w por causa|strong="G1752"\w* \w do que sofreu injustiça|strong="G3588,G91"\w*, \w mas|strong="G235"\w* \w por causa|strong="G1752"\w* \w de ser manifestado|strong="G3588,G5319"\w* \w o empenho|strong="G3588,G4710"\w* \w de vocês|strong="G4771"\w* \w por nós|strong="G3588,G5228,G3165"\w* \w para com vocês|strong="G4314,G4771"\w* \w diante de Deus|strong="G1799,G3588,G2316"\w*.\f + \fr 7.12: \ft Variante: WH traz ἀλλ᾽ οὐδέ (“mas nem”) em lugar de οὐδέ; o RP escreve εἵνεκεν em lugar de ἕνεκεν.\f*\f + \fr 7.12: \ft Variante: alguns manuscritos trazem ἡμῶν... ὑπὲρ ὑμῶν (“o nosso empenho por vocês”) em lugar de ὑμῶν... ὑπὲρ ἡμῶν (“o empenho de vocês por nós”).\f*\x - \xo 7:12 \xt JUD 1:23; 2CO 2:4; 1CO 13:6; 2CO 2:9; 1TI 3:5; 1CO 12:25\x*
\v 13 \w Por isso|strong="G1223,G3778"\w* \w fomos consolados|strong="G3870"\w*. \w E além|strong="G1909,G1161"\w* \w do nosso|strong="G3165"\w* \w consolo|strong="G3588,G3874"\w*, \w ainda mais|strong="G4056,G3123"\w* \w nos alegramos|strong="G5463"\w* \w com a alegria|strong="G1909,G3588,G5479"\w* \w de Tito|strong="G5103"\w*, \w porque|strong="G3754"\w* \w foi tranquilizado|strong="G373"\w* \w o espírito|strong="G3588,G4151"\w* \w dele|strong="G846"\w* \w por todos|strong="G575,G3956"\w* \w vocês|strong="G4771"\w*.\f + \fr 7.13: \ft Variante: o RP traz ὑμῶν (“de vocês”) em lugar de ἡμῶν (“nosso”) depois de “consolo”.\f*\x - \xo 7:13 \xt PHM 1:7; 2CO 7:6; 2CO 1:4; 1CO 13:6; 1CO 16:18; ROM 15:32\x*
\v 14 \w Porque|strong="G3754"\w*, \w se|strong="G1487"\w* \w diante dele|strong="G846"\w* \w me gloriei|strong="G2744"\w* \w de vocês|strong="G5228,G4771"\w* \w em alguma coisa|strong="G5100"\w*, \w não|strong="G3756"\w* \w fui envergonhado|strong="G2617"\w*; \w mas|strong="G235"\w*, \w assim como|strong="G5613"\w* \w em verdade|strong="G1722,G225"\w* \w dissemos|strong="G2980"\w* \w a vocês|strong="G4771"\w* \w todas as coisas|strong="G3956"\w*, \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w o nosso|strong="G3165"\w* \w motivo de glória|strong="G3588,G2746"\w* \w diante de Tito|strong="G3588,G1909,G5103"\w* \w se mostrou|strong="G1096"\w* \w verdade|strong="G225"\w*.\x - \xo 7:14 \xt EZR 8:22; 1CO 13:6; 2CO 8:24; 2TH 1:4; 2CO 4:2; 2CO 7:4\x*
\v 15 \w E|strong="G2532"\w* \w o afeto|strong="G3588,G4698"\w* \w dele|strong="G846"\w* \w é ainda maior|strong="G4056,G1510"\w* \w para com vocês|strong="G1519,G4771"\w*, \w lembrando-se|strong="G363"\w* \w da obediência|strong="G3588,G5218"\w* \w de todos vocês|strong="G3956,G4771"\w*, \w de como|strong="G5613"\w* \w com temor|strong="G3326,G5401"\w* \w e|strong="G2532"\w* \w tremor|strong="G5156"\w* \w o receberam|strong="G1209,G846"\w*.\x - \xo 7:15 \xt PHP 2:12; 1CO 13:6; 2CO 10:6; 1JN 3:17; 2CO 2:9; ISA 66:2\x*
\v 16 \w Me alegro|strong="G5463"\w* \w porque|strong="G3754"\w* \w em tudo|strong="G1722,G3956"\w* \w tenho confiança|strong="G2292"\w* \w em vocês|strong="G1722,G4771"\w*.\x - \xo 7:16 \xt PHP 1:6; 1CO 13:6; 2CO 2:3; GAL 5:10; PHM 1:21; PHM 1:8\x*
\c 8
\p
\v 1 \w Damos a conhecer a vocês|strong="G1107,G4771"\w*, \w irmãos e irmãs|strong="G80"\w*, \w a graça|strong="G3588,G5485"\w* \w de Deus|strong="G3588,G2316"\w* \w concedida|strong="G3588,G1325"\w* \w nas comunidades|strong="G1722,G3588,G1577"\w* \w da Macedônia|strong="G3588,G3109"\w*,\x - \xo 8:1 \xt 1CO 16:1; HEB 6:10; PRO 22:9; MAT 13:23; GAL 2:10; MAT 21:3\x*
\v 2 \w pois|strong="G3754"\w* \w numa grande|strong="G1722,G4183"\w* \w prova|strong="G1382"\w* \w de tribulação|strong="G2347"\w*, \w a abundância|strong="G3588,G4050"\w* \w da alegria|strong="G3588,G5479"\w* \w deles|strong="G846"\w* \w e|strong="G2532"\w* \w a sua|strong="G846"\w* \w pobreza|strong="G3588,G4432"\w* \w profunda|strong="G2596,G899"\w* \w transbordaram|strong="G4052"\w* \w em riqueza|strong="G1519,G3588,G4149"\w* \w da sua generosidade|strong="G3588,G572,G846"\w*.\f + \fr 8.2: \ft Lit.: ἁπλότης, “simplicidade, sinceridade” e, por extensão, “generosidade sem reservas”.\f*\x - \xo 8:2 \xt 2CO 9:8; NEH 8:10; PRO 3:9; JAS 2:5; 1CO 16:1; HEB 6:10\x*
\v 3 \w Pois|strong="G3754"\w* \w segundo a capacidade|strong="G2596,G1411"\w*, \w testemunho|strong="G3140"\w*, \w e|strong="G2532"\w* \w além da capacidade|strong="G3844,G1411"\w*, \w por vontade própria|strong="G830"\w*\x - \xo 8:3 \xt PRO 3:9; 1CO 16:1; HEB 6:10; MRK 12:44; EXO 35:29; EXO 35:5\x*
\v 4 \w com muita|strong="G3326,G4183"\w* \w insistência|strong="G3874"\w*, \w pediram-nos|strong="G1189,G3165"\w* \w o favor|strong="G3588,G5485"\w* \w e|strong="G2532"\w* \w a participação|strong="G3588,G2842"\w* \w no serviço|strong="G3588,G1248"\w* \w destinado|strong="G3588,G1519"\w* \w aos santos|strong="G3588,G40"\w*—\f + \fr 8.4: \ft Variante: o TR acrescenta δέξασθαι ἡμᾶς (“que nos recebêssemos”, isto é, “que aceitássemos”) depois de “aos santos”.\f*\f + \fr 8.4: \ft Tradução: χάριν (χάρις, G5485) está aqui como “o favor”; o termo pode ser “graça”, “favor”, “gratidão” ou “mérito”, e o contexto decide.\f*\x - \xo 8:4 \xt 2CO 13:13; 2CO 9:1; 1CO 16:1; HEB 6:10; ROM 15:31; ACT 24:17\x*
