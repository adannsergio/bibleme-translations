\v 1 \w Pois|strong="G1063"\w* \w a respeito do|strong="G4012,G3303"\w* \w serviço|strong="G3588,G1248"\w* \w destinado|strong="G3588,G1519"\w* \w aos santos|strong="G3588,G40"\w*, \w é supérfluo|strong="G4053,G1510"\w* \w para mim|strong="G3165"\w* \w escrever|strong="G3588,G1125"\w* \w a vocês|strong="G4771"\w*,\x - \xo 9:1 \xt 2CO 8:4; HEB 6:10; 1PE 4:10; ROM 12:13; GAL 6:10; ROM 15:31\x*
