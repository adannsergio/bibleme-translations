\v 14 \w Pois|strong="G1063"\w* \w o amor|strong="G3588,G26"\w* \w de Cristo|strong="G3588,G5547"\w* \w nos domina|strong="G4912,G3165"\w*, \w tendo concluído|strong="G2919"\w* \w isto|strong="G3778"\w*: \w que um|strong="G3754,G1520"\w* \w morreu|strong="G599"\w* \w por todos|strong="G5228,G3956"\w*; \w logo|strong="G686"\w* \w todos|strong="G3588,G3956"\w* \w morreram|strong="G599"\w*;\x - \xo 5:14 \xt JHN 14:15; 2TI 1:7; ROM 12:1; GAL 2:20; DEU 6:5; 1JN 4:19\x*
