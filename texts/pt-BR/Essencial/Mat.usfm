\v 25 \w mas|strong="G1161"\w* \w enquanto dormiam|strong="G1722,G3588,G2518"\w* \w os homens|strong="G3588,G444"\w*, \w veio|strong="G2064"\w* \w o inimigo|strong="G3588,G2190"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w semeou|strong="G6037"\w* \w joio|strong="G2215"\w* \w no meio|strong="G303,G3319"\w* \w do trigo|strong="G3588,G4621"\w*, \w e|strong="G2532"\w* \w foi embora|strong="G565"\w*.\f + \fr 13.25: \ft Lit.: ζιζάνιον, “joio”, erva daninha parecida com o trigo enquanto cresce.\f*\x - \xo 13:25 \xt 1PE 5:8; 2PE 2:1; ACT 20:30-31; MAT 13:39; GEN 1:12; HEB 12:15\x*
\v 26 \w E quando|strong="G3753,G1161"\w* \w brotou|strong="G985"\w* \w a erva|strong="G3588,G5528"\w* \w e|strong="G2532"\w* \w produziu|strong="G4160"\w* \w fruto|strong="G2590"\w*, \w então|strong="G5119"\w* \w apareceu|strong="G5316"\w* \w também|strong="G2532"\w* \w o joio|strong="G3588,G2215"\w*.\x - \xo 13:26 \xt GEN 1:12; 1CO 3:9; MRK 4:26-29; MRK 4:28; MAT 13:47; LUK 8:5\x*
