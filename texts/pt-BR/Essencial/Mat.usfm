\p
\v 1 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w de novo|strong="G3825"\w* \w lhes falou|strong="G2036,G846"\w* \w em parábolas|strong="G1722,G3850"\w*, \w dizendo|strong="G3004"\w*:\x - \xo 22:1 \xt MAT 15:15; ISA 25:6; MAT 20:1-16; LUK 12:36; MAT 12:43-45\x*
\v 2 “\w O reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w foi comparado|strong="G3666"\w* \w a um rei|strong="G444,G935"\w*, \w que|strong="G3748"\w* \w fez|strong="G4160"\w* \w uma festa de casamento|strong="G1062"\w* \w para o seu filho|strong="G3588,G5207,G846"\w*.\f + \fr 22.2: \ft Lit.: ἀνθρώπῳ βασιλεῖ, literalmente “a um homem rei”; em português, “a um rei”.\f*\f + \fr 22.2: \ft Lit.: γάμος, “casamento, festa de casamento”.\f*\x - \xo 22:2 \xt MAT 25:1; LUK 13:20; MAT 13:24; LUK 13:18; MAT 18:23; REV 19:7\x*
\v 3 \w E|strong="G2532"\w* \w enviou|strong="G649"\w* \w os seus escravos|strong="G3588,G1401,G846"\w* \w para chamar|strong="G2564"\w* \w os convidados|strong="G3588,G2564"\w* \w para a festa de casamento|strong="G1519,G3588,G1062"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w quiseram|strong="G2309"\w* \w vir|strong="G2064"\w*.\x - \xo 22:3 \xt JHN 2:2; REV 19:9; LUK 14:17; MAT 22:8; LUK 14:16; MAT 23:37\x*
\v 4 \w De novo|strong="G3825"\w* \w enviou|strong="G649"\w* \w outros escravos|strong="G243,G1401"\w*, \w dizendo|strong="G3004"\w*: ‘\w Digam|strong="G2036"\w* \w aos convidados|strong="G3588,G2564"\w*: “\w Olhem|strong="G2400"\w*, \w o meu banquete|strong="G3588,G712,G3165"\w* \w já preparei|strong="G2090"\w*, \w os meus bois|strong="G3588,G5022,G3165"\w* \w e|strong="G2532"\w* \w os animais cevados|strong="G3588,G4619"\w* \w foram abatidos|strong="G2380"\w*, \w e|strong="G2532"\w* \w tudo|strong="G3956"\w* \w está pronto|strong="G2092"\w*; \w venham|strong="G1205"\w* \w para a festa de casamento|strong="G1519,G3588,G1062"\w*.”’\f + \fr 22.4: \ft Lit.: ἄριστον, “refeição principal do dia”, tomada pela manhã ou ao meio-dia.\f*\f + \fr 22.4: \ft Acréscimo: verbo ser/estar suprido em “está pronto”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:4 \xt LUK 14:17; LUK 14:16; REV 19:9; ISA 55:2; LUK 15:23; PRO 9:2\x*
\v 5 \w Mas eles|strong="G3588,G1161"\w*, \w sem darem importância|strong="G272"\w*, \w foram embora|strong="G565"\w*: \w um|strong="G3739,G3303"\w* \w para o seu campo|strong="G1519,G3588,G2398,G68"\w*, \w outro|strong="G3739,G1161"\w* \w para o seu negócio|strong="G1909,G3588,G1711,G846"\w*.\x - \xo 22:5 \xt LUK 14:16; MAT 7:6; LUK 15:23; PRO 9:2; MRK 4:15; PRO 1:24\x*
\v 6 \w E os demais|strong="G3588,G1161,G3062"\w*, \w agarrando|strong="G2902"\w* \w os escravos|strong="G3588,G1401"\w* \w dele|strong="G846"\w*, \w os maltrataram|strong="G5195"\w* \w e|strong="G2532"\w* \w os mataram|strong="G615"\w*.\x - \xo 22:6 \xt LUK 14:16; MAT 7:6; MAT 24:9; LUK 15:23; PRO 9:2; PRO 1:24\x*
\v 7 \w Mas o rei|strong="G3588,G1161,G935"\w* \w se irou|strong="G3710"\w*, \w e|strong="G2532"\w*, \w enviando|strong="G3992"\w* \w os seus exércitos|strong="G3588,G4753,G846"\w*, \w destruiu|strong="G622"\w* \w aqueles assassinos|strong="G3588,G5406,G1565"\w* \w e|strong="G2532"\w* \w incendiou|strong="G1714"\w* \w a cidade|strong="G3588,G4172"\w* \w deles|strong="G846"\w*.\x - \xo 22:7 \xt LUK 14:16; LUK 19:27; ISA 66:15; JER 51:20; LUK 15:23; MAL 4:6\x*
\v 8 \w Então|strong="G5119"\w* \w disse|strong="G3004"\w* \w aos seus escravos|strong="G3588,G1401,G846"\w*: ‘\w A festa de casamento|strong="G3588,G1062"\w* \w de fato|strong="G3303"\w* \w está pronta|strong="G2092,G1510"\w*, \w mas os convidados|strong="G3588,G1161,G2564"\w* \w não|strong="G3756"\w* \w eram|strong="G1510"\w* \w dignos|strong="G514"\w*;\x - \xo 22:8 \xt JHN 2:2; MAT 22:3; LUK 14:16; LUK 14:24; LUK 15:23; MAT 10:37\x*
\v 9 \w vão|strong="G4198"\w*, \w pois|strong="G3767"\w*, \w às saídas|strong="G1909,G3588,G1327"\w* \w das ruas|strong="G3588,G3598"\w*, \w e|strong="G2532"\w* \w a quantos|strong="G3745,G1437"\w* \w encontrarem|strong="G2147"\w*, \w chamem|strong="G2564"\w* \w para a festa de casamento|strong="G1519,G3588,G1062"\w*.’\f + \fr 22.9: \ft Lit.: διέξοδος, “saída”, o ponto em que as ruas se abrem para fora da cidade ou se cruzam.\f*\x - \xo 22:9 \xt JHN 2:2; LUK 14:23; LUK 14:16; ROM 10:20; ISA 62:10; MAT 13:47\x*
\v 10 \w E|strong="G2532"\w*, \w saindo|strong="G1831"\w* \w aqueles escravos|strong="G3588,G1401,G1565"\w* \w para as ruas|strong="G1519,G3588,G3598"\w*, \w reuniram|strong="G4863"\w* \w todos|strong="G3956"\w* \w os que|strong="G3739"\w* \w encontraram|strong="G2147"\w*, \w maus|strong="G4190"\w* \w e também|strong="G5037,G2532"\w* \w bons|strong="G18"\w*; \w e|strong="G2532"\w* \w a festa de casamento|strong="G3588,G1062"\w* \w se encheu|strong="G4130"\w* \w de convidados reclinados à mesa|strong="G345"\w*.\f + \fr 22.10: \ft Lit.: ἀνάκειμαι, “estar reclinado (à mesa)”, conforme o costume greco-romano das refeições.\f*\f + \fr 22.10: \ft Variante: Treg e o RP trazem ὅσους (“a quantos”) em lugar de οὓς; WH traz νυμφών (“sala de núpcias”) em lugar de γάμος (“festa de casamento”).\f*\f + \fr 22.10: \ft Tradução: ὁδοὺς (ὁδός, G3598) está aqui como “para as ruas”; o termo pode ser “caminho”, “estrada”, “viagem” ou “modo de vida”, e o contexto decide.\f*\x - \xo 22:10 \xt LUK 14:23; LUK 14:16; ROM 10:20; MAT 13:47; 1CO 6:9-11; 1JN 2:19\x*
\v 11 \w E o rei|strong="G1161,G3588,G935"\w*, \w entrando|strong="G1525"\w* \w para ver|strong="G2300"\w* \w os que estavam à mesa|strong="G3588,G345"\w*, \w viu|strong="G1492"\w* \w ali|strong="G1563"\w* \w um homem|strong="G444"\w* \w que não|strong="G3756"\w* \w vestia|strong="G1746"\w* \w roupa|strong="G1742"\w* \w de casamento|strong="G1062"\w*;\x - \xo 22:11 \xt LUK 14:16; REV 19:8; REV 3:4-5; HEB 4:12-13; ZEC 3:3; 1CO 11:27\x*
\v 12 \w e|strong="G2532"\w* \w lhe disse|strong="G3004,G846"\w*: ‘\w Amigo|strong="G2083"\w*, \w como|strong="G4459"\w* \w entrou|strong="G1525"\w* \w aqui|strong="G5602"\w* \w sem ter|strong="G3361,G2192"\w* \w roupa|strong="G1742"\w* \w de casamento|strong="G1062"\w*?’ \w Mas ele|strong="G3588,G1161"\w* \w ficou sem palavras|strong="G5392"\w*.\f + \fr 22.12: \ft Lit.: φιμόω, “amordaçar, calar”.\f*\x - \xo 22:12 \xt LUK 14:16; REV 19:8; 1SA 2:9; JOB 5:16; MAT 13:49; MAT 20:13\x*
\v 13 \w Então|strong="G5119"\w* \w o rei|strong="G3588,G935"\w* \w disse|strong="G2036"\w* \w aos servidores|strong="G3588,G1249"\w*: ‘\w Amarrem-lhe|strong="G1210,G846"\w* \w os pés|strong="G4228"\w* \w e|strong="G2532"\w* \w as mãos|strong="G5495"\w*, \w lancem-no|strong="G1544,G846"\w* \w nas trevas exteriores|strong="G1519,G3588,G4655,G1857"\w*; \w ali|strong="G1563"\w* \w haverá|strong="G1510"\w* \w o choro|strong="G3588,G2805"\w* \w e|strong="G2532"\w* \w o ranger|strong="G3588,G1030"\w* \w de dentes|strong="G3588,G3599"\w*.’\f + \fr 22.13: \ft Variante: o RP, o TR e Tyn acrescentam ἄρατε αὐτὸν καὶ (“levem-no e”) antes de “lancem-no”; o RP traz a ordem εἶπεν ὁ βασιλεύς.\f*\x - \xo 22:13 \xt MAT 8:12; MAT 25:30; MAT 13:42; MAT 13:50; LUK 13:28; MAT 24:51\x*
\v 14 \w Pois|strong="G1063"\w* \w muitos|strong="G4183"\w* \w são|strong="G1510"\w* \w chamados|strong="G2822"\w*, \w mas|strong="G1161"\w* \w poucos|strong="G3641"\w* \w escolhidos|strong="G1588"\w*.”\x - \xo 22:14 \xt REV 17:14; MAT 7:14; 2PE 1:10; LUK 13:23; MAT 7:13-14; MAT 20:16\x*
\p
\v 15 \w Então|strong="G5119"\w*, \w indo|strong="G4198"\w* \w os fariseus|strong="G3588,G5330"\w*, \w tomaram conselho|strong="G4824,G2983"\w* \w para que|strong="G3704"\w* \w o prendessem na armadilha|strong="G846,G3802"\w* \w com uma palavra|strong="G1722,G3056"\w*.\f + \fr 22.15: \ft Lit.: παγιδεύω, “apanhar em armadilha (laço)”.\f*\x - \xo 22:15 \xt MAT 12:14; MRK 3:6; PSA 56:5; LUK 20:20; LUK 11:54; MRK 12:13\x*
\v 16 \w E|strong="G2532"\w* \w enviaram-lhe|strong="G649,G846"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w com os herodianos|strong="G3326,G3588,G2265"\w*, \w dizendo|strong="G3004"\w*: “\w Mestre|strong="G1320"\w*, \w sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w é|strong="G1510"\w* \w verdadeiro|strong="G227"\w* \w e|strong="G2532"\w* \w ensina|strong="G1321"\w* \w o caminho|strong="G3588,G3598"\w* \w de Deus|strong="G3588,G2316"\w* \w com verdade|strong="G1722,G225"\w*, \w e|strong="G2532"\w* \w não se importa|strong="G3756,G3199,G4771"\w* \w com ninguém|strong="G4012,G3762"\w*; \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w olha|strong="G991"\w* \w para a face|strong="G1519,G4383"\w* \w dos seres humanos|strong="G444"\w*.\f + \fr 22.16: \ft Lit.: βλέπειν εἰς πρόσωπον, “olhar para a face”, expressão semítica para a parcialidade, isto é, avaliar alguém pela posição que ocupa.\f*\f + \fr 22.16: \ft Nota cultural: os herodianos eram partidários da dinastia de Herodes, em geral hostis aos fariseus; a aliança dos dois grupos contra Jesus também aparece em Mc 3:6.\f*\x - \xo 22:16 \xt MRK 3:6; MRK 12:14; MRK 12:13; LUK 20:21; JHN 14:6; GAL 1:10\x*
\v 17 \w Diga-nos|strong="G2036,G3165"\w*, \w então|strong="G3767"\w*: \w o que|strong="G5101"\w* \w lhe parece|strong="G4771,G1380"\w*? \w É permitido|strong="G1832"\w* \w pagar|strong="G1325"\w* \w imposto|strong="G2778"\w* \w a César|strong="G2541"\w*, \w ou|strong="G2228"\w* \w não|strong="G3756"\w*?”\x - \xo 22:17 \xt MRK 12:14; MAT 17:25; ROM 13:6; JER 12:6; JHN 8:5; LUK 20:20\x*
\v 18 \w E Jesus|strong="G1161,G3588,G2424"\w*, \w conhecendo|strong="G1097"\w* \w a maldade|strong="G3588,G4189"\w* \w deles|strong="G846"\w*, \w disse|strong="G2036"\w*: \add “Por\add* \w que|strong="G5101"\w* \w me põem à prova|strong="G3165,G3985"\w*, \w hipócritas|strong="G5273"\w*?\f + \fr 22.18: \ft Acréscimo: “Por” (em “deles disse Por que me”): preposição ou artigo que a regência do português exige.\f*\x - \xo 22:18 \xt ROM 13:6; JER 12:6; JHN 2:25; JHN 8:5; JHN 8:6; LUK 11:54\x*
\v 19 \w Mostrem-me|strong="G1925,G3165"\w* \w a moeda|strong="G3588,G3546"\w* \w do imposto|strong="G3588,G2778"\w*.” \w E eles|strong="G3588,G1161"\w* \w lhe trouxeram|strong="G4374,G846"\w* \w um denário|strong="G1220"\w*.\x - \xo 22:19 \xt ROM 13:6; LUK 20:20; MAT 17:25; LUK 20:37; MRK 12:13; MRK 12:16\x*
\v 20 \w E|strong="G2532"\w* \w lhes disse|strong="G3004,G846"\w*: \add “De\add* \w quem|strong="G5101"\w* \w é esta|strong="G3588,G3778"\w* \w imagem|strong="G1504"\w* \w e|strong="G2532"\w* \w a inscrição|strong="G3588,G1923"\w*?”\f + \fr 22.20: \ft Acréscimo: “De” (em “lhes disse De quem é”): preposição ou artigo que a regência do português exige; verbo ser/estar suprido em “é esta”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:20 \xt MRK 12:16; LUK 20:24; ROM 13:6; LUK 20:20; LUK 20:37; MRK 12:13\x*
\v 21 \w Disseram-lhe|strong="G3004,G846"\w*: “\w De César|strong="G2541"\w*.” \w Então|strong="G5119"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Devolvam|strong="G591"\w*, \w pois|strong="G3767"\w*, \w o que é de César|strong="G3588,G2541"\w* \w a César|strong="G2541"\w* \w e|strong="G2532"\w* \w o que é de Deus|strong="G3588,G2316"\w* \w a Deus|strong="G3588,G2316"\w*.”\f + \fr 22.21: \ft Acréscimo: verbo ser/estar suprido em “o que é de César”, “o que é de Deus”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:21 \xt MRK 12:17; LUK 20:25; ROM 13:7; MAL 3:8; 1PE 2:13; ROM 13:6\x*
\v 22 \w E|strong="G2532"\w*, \w ouvindo isso|strong="G191"\w*, \w ficaram admirados|strong="G2296"\w*, \w e|strong="G2532"\w*, \w deixando-o|strong="G863,G846"\w*, \w foram embora|strong="G565"\w*.\x - \xo 22:22 \xt MRK 12:12; LUK 20:20; ISA 52:14; JHN 7:15; LUK 20:37; MRK 12:13\x*
\p
\v 23 \w Naquele dia|strong="G1722,G1565,G3588,G2250"\w* \w aproximaram-se|strong="G4334"\w* \w dele|strong="G846"\w* \w saduceus|strong="G4523"\w*, \w dizendo que não|strong="G3004,G3361"\w* \w há|strong="G1511"\w* \w ressurreição|strong="G386"\w*, \w e|strong="G2532"\w* \w o interrogaram|strong="G1905,G846"\w*\x - \xo 22:23 \xt LUK 20:27; MRK 12:18; MAT 16:1; ACT 23:8; ACT 23:6; GEN 38:8\x*
\v 24 \w dizendo|strong="G3004"\w*: “\w Mestre|strong="G1320"\w*, \w Moisés|strong="G3475"\w* \w disse|strong="G2036"\w*: ‘\w Se alguém|strong="G1437,G5100"\w* \w morrer|strong="G599"\w* \w sem ter|strong="G3361,G2192"\w* \w filhos|strong="G5043"\w*, \w o seu irmão|strong="G3588,G80,G846"\w* \w se casará|strong="G1918"\w* \w com a mulher|strong="G3588,G1135"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w dará descendência|strong="G450,G4690"\w* \w ao seu irmão|strong="G3588,G80,G846"\w*.’\f + \fr 22.24: \ft Nota cultural: refere-se à lei do levirato de Dt 25:5-6.\f*\f + \fr 22.24: \ft Lit.: ἐπιγαμβρεύω, “casar-se com a viúva do irmão, como cunhado”.\f*\x - \xo 22:24 \xt DEU 25:5; MRK 12:19; LUK 20:28; GEN 38:8; LUK 20:27; MRK 12:18\x*
\v 25 \w Ora|strong="G1161"\w*, \w havia|strong="G1510"\w* \w entre nós|strong="G3844,G3165"\w* \w sete irmãos|strong="G2033,G80"\w*; \w e|strong="G2532"\w* \w o primeiro|strong="G3588,G4413"\w*, \w tendo se casado|strong="G1060"\w*, \w morreu|strong="G5053"\w*, \w e|strong="G2532"\w*, \w não tendo|strong="G3361,G2192"\w* \w descendência|strong="G4690"\w*, \w deixou|strong="G863"\w* \w a sua mulher|strong="G3588,G1135,G846"\w* \w ao seu irmão|strong="G3588,G80,G846"\w*;\x - \xo 22:25 \xt MRK 12:20; LUK 20:33; MRK 12:22; LUK 20:29; GEN 38:8; LUK 20:27\x*
\v 26 \w igualmente|strong="G3668"\w* \w também|strong="G2532"\w* \w o segundo|strong="G3588,G1208"\w* \w e|strong="G2532"\w* \w o terceiro|strong="G3588,G5154"\w*, \w até os sete|strong="G2193,G3588,G2033"\w*.\x - \xo 22:26 \xt GEN 38:8; LUK 20:27; MRK 12:18; RUT 3:13; HEB 6:2; JHN 11:24\x*
\v 27 \w E depois de todos|strong="G5306,G1161,G3956"\w* \w morreu|strong="G599"\w* \w a mulher|strong="G3588,G1135"\w*.\x - \xo 22:27 \xt LUK 20:32; GEN 38:8; LUK 20:27; MRK 12:18; RUT 3:13; HEB 6:2\x*
\v 28 \w Na ressurreição|strong="G1722,G3588,G386"\w*, \w então|strong="G3767"\w*, \w de qual|strong="G5101"\w* \w dos sete|strong="G3588,G2033"\w* \w será mulher|strong="G1510,G1135"\w*? \w Pois|strong="G1063"\w* \w todos|strong="G3956"\w* \w a tiveram|strong="G2192,G846"\w*.”\x - \xo 22:28 \xt LUK 20:33; MRK 12:23; LUK 20:27; MRK 12:18; HEB 6:2; JHN 11:24\x*
\v 29 \w E Jesus|strong="G1161,G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w lhes disse|strong="G2036,G846"\w*: “\w Vocês estão enganados|strong="G4105"\w*, \w não conhecendo|strong="G3361,G6063"\w* \w as Escrituras|strong="G3588,G1124"\w* \w nem|strong="G3366"\w* \w o poder|strong="G3588,G1411"\w* \w de Deus|strong="G3588,G2316"\w*;\x - \xo 22:29 \xt MRK 12:24; MAT 24:4; JHN 7:47; JHN 5:39; ZEC 13:9; JHN 20:9\x*
\v 30 \w pois|strong="G1063"\w* \w na ressurreição|strong="G1722,G3588,G386"\w* \w nem|strong="G3777"\w* \w se casam|strong="G1060"\w* \w nem|strong="G3777"\w* \w são dados em casamento|strong="G1061"\w*, \w mas|strong="G235"\w* \w são como|strong="G5613,G1510"\w* \w anjos|strong="G32"\w* \w de Deus|strong="G2316"\w* \w no céu|strong="G1722,G3588,G3772"\w*.\f + \fr 22.30: \ft Variante: o SBLGNT traz ἄγγελοι θεοῦ (“anjos de Deus”) seguindo Holmes; WH, Treg e NA28 omitem “de Deus”, e o RP traz τοῦ θεοῦ (“os anjos de Deus”) sem o artigo τῷ antes de “céu”; o RP também traz ἐκγαμίζονται em lugar de γαμίζονται.\f*\x - \xo 22:30 \xt LUK 20:34; MRK 12:25; LUK 20:35; MAT 24:38; MRK 12:24-25; ZEC 13:9\x*
\v 31 \w E a respeito|strong="G4012,G1161"\w* \w da ressurreição|strong="G3588,G386"\w* \w dos mortos|strong="G3588,G3498"\w*, \w não|strong="G3756"\w* \w leram|strong="G314"\w* \w o que lhes foi dito|strong="G3588,G2046,G4771"\w* \w por Deus|strong="G5259,G3588,G2316"\w*, \w que diz|strong="G3004"\w*:\x - \xo 22:31 \xt ZEC 13:9; 2TI 3:16; MAT 9:13; MAT 12:3; JOB 14:14; LUK 20:27\x*
\v 32 ‘\w Eu|strong="G1473"\w* \w sou|strong="G1510"\w* \w o Deus|strong="G3588,G2316"\w* \w de Abraão|strong="G11"\w* \w e|strong="G2532"\w* \w o Deus|strong="G3588,G2316"\w* \w de Isaque|strong="G2464"\w* \w e|strong="G2532"\w* \w o Deus|strong="G3588,G2316"\w* \w de Jacó|strong="G2384"\w*’? \add Ele\add* \w não|strong="G3756"\w* \w é|strong="G1510"\w* \w Deus|strong="G3588,G2316"\w* \w de mortos|strong="G3498"\w*, \w mas|strong="G235"\w* \w de vivos|strong="G2198"\w*.”\f + \fr 22.32: \ft Nota cultural: cita Êx 3:6.\f*\f + \fr 22.32: \ft Acréscimo: “Ele” (em “de Jacó Ele não é”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 22:32 \xt EXO 3:6; LUK 3:34; LUK 20:37; MRK 12:26; ACT 7:32; MAT 1:2\x*
\v 33 \w E|strong="G2532"\w*, \w ouvindo isso|strong="G191"\w*, \w as multidões|strong="G3588,G3793"\w* \w ficaram atônitas|strong="G1605"\w* \w com o ensino|strong="G1909,G3588,G1322"\w* \w dele|strong="G846"\w*.\x - \xo 22:33 \xt MAT 7:28; LUK 4:32; MRK 1:22; MRK 11:18; ACT 13:12; LUK 20:27\x*
\v 34 \w Mas os fariseus|strong="G3588,G1161,G5330"\w*, \w ouvindo|strong="G191"\w* \w que|strong="G3754"\w* \w havia silenciado|strong="G5392"\w* \w os saduceus|strong="G3588,G4523"\w*, \w reuniram-se|strong="G4863"\w* \w juntos|strong="G1909,G3588,G846"\w*,\x - \xo 22:34 \xt LUK 10:25; MRK 12:28; MRK 8:11\x*
\v 35 \w e|strong="G2532"\w* \w um deles|strong="G1520,G1537,G846"\w*, \w especialista na Lei|strong="G3544"\w*, \w o interrogou|strong="G1905"\w*, \w pondo-o à prova|strong="G3985,G846"\w*:\x - \xo 22:35 \xt MRK 10:2; LUK 10:25; MRK 12:28; LUK 11:54; LUK 7:30; MRK 8:11\x*
\v 36 “\w Mestre|strong="G1320"\w*, \w qual é o grande|strong="G4169,G3173"\w* \w mandamento|strong="G1785"\w* \w na Lei|strong="G1722,G3588,G3551"\w*?”\f + \fr 22.36: \ft Lit.: μεγάλη, “grande”, no sentido de “o maior, o mais importante”.\f*\f + \fr 22.36: \ft Acréscimo: verbo ser/estar suprido em “qual é o grande”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:36 \xt MRK 12:28; LUK 10:25; ROM 5:5; MAT 5:19-20; LUK 11:42; MAT 23:23-24\x*
\v 37 \w E ele|strong="G3588,G1161"\w* \w lhe disse|strong="G5346,G846"\w*: “\w Você amará|strong="G25"\w* \w o Senhor|strong="G2962"\w* \w seu Deus|strong="G3588,G2316,G4771"\w* \w de todo o seu coração|strong="G1722,G3650,G3588,G2588,G4771"\w* \w e|strong="G2532"\w* \w de toda a sua alma|strong="G1722,G3650,G3588,G5590,G4771"\w* \w e|strong="G2532"\w* \w de toda a sua mente|strong="G1722,G3650,G3588,G1271,G4771"\w*.\f + \fr 22.37: \ft Nota cultural: cita Dt 6:5.\f*\x - \xo 22:37 \xt DEU 6:5; LUK 10:27; HEB 10:16; MRK 12:29-30; MRK 12:30; DEU 10:12\x*
\v 38 \w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w o grande|strong="G3588,G3173"\w* \w e primeiro|strong="G2532,G4413"\w* \w mandamento|strong="G1785"\w*.\f + \fr 22.38: \ft Lit.: αὕτη (feminino, concordando com ἐντολή): em português o demonstrativo concorda com “mandamento” (masculino), e fica “este”.\f*\x - \xo 22:38 \xt LUK 10:27; MRK 12:28; LUK 10:25; 1JN 4:21; DEU 30:16; MAT 23:23\x*
\v 39 \w E a segunda|strong="G1208,G1161"\w* \w é semelhante|strong="G3664"\w* \w a ela|strong="G846"\w*: ‘\w Você amará|strong="G25"\w* \w o seu próximo|strong="G3588,G4139,G4771"\w* \w como a si mesmo|strong="G5613,G4771"\w*.’\f + \fr 22.39: \ft Nota cultural: cita Lv 19:18.\f*\f + \fr 22.39: \ft Acréscimo: verbo ser/estar suprido em “é semelhante”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:39 \xt LEV 19:18; MRK 12:31; LUK 10:27; GAL 5:14; MAT 19:19; MAT 5:43\x*
\v 40 \w Nestes dois mandamentos|strong="G1722,G3778,G3588,G1417,G1785"\w* \w depende|strong="G2910"\w* \w toda a Lei|strong="G3650,G3588,G3551"\w* \w e|strong="G2532"\w* \w os Profetas|strong="G3588,G4396"\w*.”\x - \xo 22:40 \xt LUK 10:27; MAT 7:12; ROM 13:10; ROM 13:8; LEV 19:18; ROM 13:9\x*
