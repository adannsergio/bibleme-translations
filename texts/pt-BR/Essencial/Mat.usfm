\v 18 \w De manhã|strong="G4404,G1161"\w*, \w voltando|strong="G1877"\w* \w para a cidade|strong="G1519,G3588,G4172"\w*, \add teve\add* \w fome|strong="G3983"\w*.\f + \fr 21.18: \ft Acréscimo: “teve” (em “a cidade teve fome”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 21:18 \xt MRK 11:12; MAT 4:2; HEB 4:15; ACT 10:10; LUK 4:2; MRK 11:20-24\x*
\v 19 \w E|strong="G2532"\w*, \w vendo|strong="G1492"\w* \w uma figueira|strong="G4808,G1520"\w* \w à beira|strong="G1909,G3588"\w* \w do caminho|strong="G3598"\w*, \w foi|strong="G2064"\w* \w até ela|strong="G1909,G846"\w*, \w e|strong="G2532"\w* \w nada|strong="G3762"\w* \w encontrou|strong="G2147"\w* \w nela|strong="G1722,G846"\w*, \w a não ser|strong="G1487,G3361"\w* \w folhas|strong="G5444"\w* \w somente|strong="G3441"\w*; \w e|strong="G2532"\w* \w lhe disse|strong="G3004,G846"\w*: \add “Nunca\add* \w mais|strong="G3371"\w* \w haja|strong="G1096"\w* \w fruto|strong="G2590"\w* \w vindo de você|strong="G1537,G4771"\w* \w para sempre|strong="G1519,G3588,G165"\w*.” \w E|strong="G2532"\w* \w a figueira|strong="G3588,G4808"\w* \w secou|strong="G3583"\w* \w imediatamente|strong="G3916"\w*.\f + \fr 21.19: \ft Acréscimo: “Nunca” (em “lhe disse Nunca mais haja”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 21:19 \xt MRK 11:14; MRK 11:13; LUK 13:6; MRK 11:20; PSA 1:3; REV 22:11\x*
\v 20 \w E|strong="G2532"\w*, \w vendo isso|strong="G1492"\w*, \w os discípulos|strong="G3588,G3101"\w* \w ficaram admirados|strong="G2296"\w*, \w dizendo|strong="G3004"\w*: “\w Como|strong="G4459"\w* \w secou|strong="G3583"\w* \w imediatamente|strong="G3916"\w* \w a figueira|strong="G3588,G4808"\w*?”\x - \xo 21:20 \xt MRK 11:20; LUK 13:6; ISA 40:6-8; MRK 11:12; JUD 1:12\x*
\v 21 \w E|strong="G1161"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w lhes disse|strong="G2036,G846"\w*: “\w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w*: \w se|strong="G1437"\w* \w tiverem|strong="G2192"\w* \w fé|strong="G4102"\w* \w e|strong="G2532"\w* \w não duvidarem|strong="G3361,G1252"\w*, \w não|strong="G3756"\w* \w somente|strong="G3441"\w* \w farão|strong="G4160"\w* \w o da figueira|strong="G3588,G4808"\w*; \w mas|strong="G235"\w* \w até se|strong="G1437_B,G2532"\w* \w disserem|strong="G2036"\w* \w a este monte|strong="G3588,G3735,G3778"\w*: ‘\w Seja removido|strong="G142"\w* \w e|strong="G2532"\w* \w lançado|strong="G906"\w* \w ao mar|strong="G1519,G3588,G2281"\w*’, \add isso\add* \w acontecerá|strong="G1096"\w*.\f + \fr 21.21: \ft Lit.: διακρίνομαι, “hesitar, duvidar” (o contrário de ter fé sem divisão).\f*\f + \fr 21.21: \ft Acréscimo: “isso” (em “ao mar isso acontecerá”): demonstrativo acrescentado para retomar o que foi dito.\f*\x - \xo 21:21 \xt MRK 11:23; JHN 14:12; JAS 1:6; MRK 9:23; MAT 17:20; EZK 37:4\x*
\v 22 \w E|strong="G2532"\w* \w tudo o que|strong="G3956,G3745,G302"\w* \w pedirem|strong="G154"\w* \w em oração|strong="G1722,G3588,G4335"\w*, \w crendo|strong="G4100"\w*, \w receberão|strong="G2983"\w*.”\x - \xo 21:22 \xt MRK 11:24; JHN 14:13; LUK 11:9; MAT 7:7; JAS 5:16; JHN 16:23\x*
