\v 1 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w saindo|strong="G1831"\w* \w do templo|strong="G575,G3588,G2411"\w*, \w ia embora|strong="G4198"\w*, \w e|strong="G2532"\w* \w aproximaram-se|strong="G4334"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w para lhe mostrar|strong="G1925,G846"\w* \w as construções|strong="G3588,G3619"\w* \w do templo|strong="G3588,G2411"\w*.\x - \xo 24:1 \xt MRK 13:1; LUK 21:5; EZK 8:6; JER 6:8; JHN 2:20; MAT 21:23\x*
\v 2 \w Mas ele|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w lhes disse|strong="G2036,G846"\w*: “\w Não|strong="G3756"\w* \w veem|strong="G991"\w* \w todas estas coisas|strong="G3778,G3956"\w*? \w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w*: \w de modo algum|strong="G3756,G3361"\w* \w será deixada|strong="G863"\w* \w aqui|strong="G5602"\w* \w pedra|strong="G3037"\w* \w sobre pedra|strong="G1909,G3037"\w* \w que não|strong="G3739,G3756"\w* \w seja derrubada|strong="G2647"\w*.”\f + \fr 24.2: \ft Variante: o RP traz Ἰησοῦς (“Jesus”) em lugar de ἀποκριθείς (“respondendo”) e a ordem πάντα ταῦτα.\f*\x - \xo 24:2 \xt MRK 13:2; LUK 21:6; LUK 19:44; ISA 66:1; JER 26:18; MRK 13:1\x*
\v 3 \w E estando ele sentado|strong="G2521,G1161,G846"\w* \w no Monte|strong="G1909,G3588,G3735"\w* \w das Oliveiras|strong="G3588,G1636"\w*, \w aproximaram-se|strong="G4334"\w* \w dele|strong="G846"\w* \w os discípulos|strong="G3588,G3101"\w* \w à parte|strong="G2596,G2398"\w*, \w dizendo|strong="G3004"\w*: “\w Diga|strong="G2036"\w*-\w nos|strong="G3165"\w*: \w quando|strong="G4219"\w* \w serão|strong="G1510"\w* \w estas coisas|strong="G3778"\w*, \w e|strong="G2532"\w* \w qual é|strong="G5101"\w* \w o sinal|strong="G3588,G4592"\w* \w da sua|strong="G3588,G4771"\w* \w vinda|strong="G3952"\w* \w e|strong="G2532"\w* \w do fim|strong="G4930"\w* \w da era|strong="G3588,G165"\w*?”\f + \fr 24.3: \ft Lit.: παρουσία, “vinda, presença” (usada para a chegada de um rei); συντέλεια, “consumação, fim”; αἰών, “era, tempo”.\f*\f + \fr 24.3: \ft Acréscimo: verbo ser/estar suprido em “qual é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 24:3 \xt MRK 13:3; ACT 1:7; 1TH 5:1; MAT 13:49; MAT 24:14; MAT 24:37\x*
\v 4 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w lhes disse|strong="G2036,G846"\w*: “\w Cuidado|strong="G991"\w* \w para que ninguém|strong="G3361,G5100"\w* \w os engane|strong="G4771,G4105"\w*.\x - \xo 24:4 \xt MRK 13:5; LUK 21:8; JHN 7:47; 1CO 15:33; MAT 22:29; 1JN 4:1\x*
