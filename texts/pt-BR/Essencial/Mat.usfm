\v 38 \w Então|strong="G5119"\w* \w lhe responderam|strong="G611,G846"\w* \w alguns|strong="G5100"\w* \w dos escribas|strong="G3588,G1122"\w* \w e|strong="G2532"\w* \w fariseus|strong="G5330"\w*, \w dizendo|strong="G3004"\w*: “\w Mestre|strong="G1320"\w*, \w queremos|strong="G2309"\w* \w ver|strong="G1492"\w* \w da sua parte|strong="G575,G4771"\w* \w um sinal|strong="G4592"\w*.”\x - \xo 12:38 \xt JHN 2:18; LUK 20:39; MAT 15:1; 1CO 1:22; MRK 8:11; LUK 11:16\x*
\v 39 \w Mas ele|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w lhes disse|strong="G2036,G846"\w*: “\w Uma geração|strong="G1074"\w* \w má|strong="G4190"\w* \w e|strong="G2532"\w* \w adúltera|strong="G3428"\w* \w procura|strong="G1934"\w* \w um sinal|strong="G4592"\w*, \w e|strong="G2532"\w* \w sinal|strong="G4592"\w* \w não|strong="G3756"\w* \w lhe será dado|strong="G1325,G846"\w*, \w a não ser|strong="G1487,G3361"\w* \w o sinal|strong="G3588,G4592"\w* \w de Jonas|strong="G2495"\w*, \w o profeta|strong="G3588,G4396"\w*.\f + \fr 12.39: \ft Nota cultural: “adúltera” indica a infidelidade de Israel a Deus, como nos profetas (Os 2; Is 57:3).\f*\x - \xo 12:39 \xt ISA 57:3; MAT 16:4; LUK 11:29; MRK 8:12; MRK 8:38; JON 1:1\x*
