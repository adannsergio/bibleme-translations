\v 14 \w E|strong="G2532"\w* \w ao desembarcar|strong="G1831"\w*, \w viu|strong="G1492"\w* \w uma grande|strong="G4183"\w* \w multidão|strong="G3793"\w*, \w e|strong="G2532"\w* \w teve compaixão|strong="G4697"\w* \w deles|strong="G1909,G846"\w*, \w e|strong="G2532"\w* \w curou|strong="G2323"\w* \w os seus|strong="G846"\w* \w enfermos|strong="G3588,G732"\w*.\x - \xo 14:14 \xt MRK 6:34; MRK 8:2; HEB 4:15; MAT 9:36; HEB 2:17; JHN 11:33-35\x*
\v 15 \w E ao entardecer|strong="G3798,G1161,G1096"\w*, \w se aproximaram|strong="G4334"\w* \w dele|strong="G846"\w* \w os discípulos|strong="G3588,G3101"\w*, \w dizendo|strong="G3004"\w*: “\w O lugar|strong="G3588,G5117"\w* \w é|strong="G1510"\w* \w deserto|strong="G2048"\w*, \w e|strong="G2532"\w* \w a hora|strong="G3588,G5610"\w* \w já|strong="G2235"\w* \w passou|strong="G3928"\w*; \w despeça|strong="G630"\w* \w as multidões|strong="G3588,G3793"\w*, \w para que|strong="G2443"\w*, \w indo|strong="G565"\w* \w às aldeias|strong="G1519,G3588,G2968"\w*, \w comprem|strong="G59"\w* \w para si|strong="G1438"\w* \w comida|strong="G1033"\w*.”\x - \xo 14:15 \xt MRK 6:35; LUK 9:12; MRK 8:5; MAT 15:23; LUK 14:13; LUK 9:10\x*
\v 16 \w Mas Jesus|strong="G3588,G1161,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Não|strong="G3756"\w* \w precisam|strong="G5532,G2192"\w* \add ir\add* \w embora|strong="G565"\w*; \w deem|strong="G1325"\w* \w a eles|strong="G846"\w* \w vocês|strong="G4771"\w* \w de comer|strong="G5315"\w*.”\f + \fr 14.16: \ft Acréscimo: “ir” (em “Não precisam ir embora deem”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 14:16 \xt MRK 6:37; MAT 4:4; 2KI 4:42; LUK 9:13; MRK 8:5; 2CO 8:2-3\x*
\v 17 \w Mas eles|strong="G3588,G1161"\w* \w lhe disseram|strong="G3004,G846"\w*: “\w Não temos|strong="G3756,G2192"\w* \w aqui|strong="G5602"\w* \w senão|strong="G1487,G3361"\w* \w cinco|strong="G4002"\w* \w pães|strong="G740"\w* \w e|strong="G2532"\w* \w dois|strong="G1417"\w* \w peixes|strong="G2486"\w*.”\x - \xo 14:17 \xt MRK 6:38; JHN 6:9; LUK 9:13; LUK 9:16; MRK 6:41; 1KI 17:14\x*
\v 18 \w E ele|strong="G3588,G1161"\w* \w disse|strong="G2036"\w*: “\w Tragam-nos a mim|strong="G5342,G3165,G846"\w* \w aqui|strong="G5602"\w*.”\x - \xo 14:18 \xt 1KI 17:14; MAT 4:4; MAT 16:9; MRK 8:6; JHN 6:10; MRK 6:38\x*
\v 19 \w E|strong="G2532"\w* \w tendo ordenado|strong="G2753"\w* \w às multidões|strong="G3588,G3793"\w* \w que se reclinassem|strong="G347"\w* \w sobre a grama|strong="G1909,G3588,G5528"\w*, \w tomou|strong="G2983"\w* \w os cinco|strong="G3588,G4002"\w* \w pães|strong="G740"\w* \w e|strong="G2532"\w* \w os dois|strong="G3588,G1417"\w* \w peixes|strong="G2486"\w*, \w olhou|strong="G308"\w* \w para o céu|strong="G1519,G3588,G3772"\w*, \w abençoou|strong="G2127"\w*, \w e|strong="G2532"\w* \w partindo|strong="G2806"\w*, \w deu|strong="G1325"\w* \w os pães|strong="G3588,G740"\w* \w aos discípulos|strong="G3588,G3101"\w*, \w e os discípulos|strong="G3588,G1161,G3101"\w* \w às multidões|strong="G3588,G3793"\w*.\x - \xo 14:19 \xt LUK 9:16; MRK 6:41; MRK 14:22; MAT 26:26; LUK 24:30; 1KI 17:14\x*
\v 20 \w E|strong="G2532"\w* \w comeram|strong="G5315"\w* \w todos|strong="G3956"\w* \w e|strong="G2532"\w* \w se saciaram|strong="G5526"\w*, \w e|strong="G2532"\w* \w levantaram|strong="G142"\w* \w o que sobrou|strong="G3588,G4052"\w* \w dos pedaços|strong="G3588,G2801"\w*: \w doze|strong="G1427"\w* \w cestos|strong="G2894"\w* \w cheios|strong="G4134"\w*.\x - \xo 14:20 \xt LUK 9:17; MAT 15:37; MRK 8:19; MRK 6:42; MRK 8:8; MRK 6:43\x*
\v 21 \w E os que comiam|strong="G3588,G1161,G2068"\w* \w eram|strong="G1510"\w* \w cerca de|strong="G5616"\w* \w cinco mil|strong="G4000"\w* \w homens|strong="G435"\w*, \w sem|strong="G5565"\w* \w mulheres|strong="G1135"\w* \w e|strong="G2532"\w* \w crianças|strong="G3813"\w*.\x - \xo 14:21 \xt MAT 15:38; MAT 4:4; MAT 16:9; 1KI 17:6; PHP 4:19; 2CO 9:8-11\x*
\p
\v 22 \w E|strong="G2532"\w* \w logo|strong="G2112"\w* \w obrigou|strong="G315"\w* \w os discípulos|strong="G3588,G3101"\w* \w a entrar|strong="G1684"\w* \w num barco|strong="G1519,G4143"\w* \w e|strong="G2532"\w* \w a ir adiante|strong="G4254"\w* \w dele|strong="G846"\w* \w para a outra margem|strong="G1519,G3588,G4008"\w*, \w enquanto|strong="G2193,G3739"\w* \w despedia|strong="G630"\w* \w as multidões|strong="G3588,G3793"\w*.\x - \xo 14:22 \xt MRK 6:45; MAT 15:39; LUK 8:22; JHN 6:15; MRK 4:35\x*
\v 23 \w E|strong="G2532"\w* \w tendo despedido|strong="G630"\w* \w as multidões|strong="G3588,G3793"\w*, \w subiu|strong="G305"\w* \w ao monte|strong="G1519,G3588,G3735"\w*, \w à parte|strong="G2596,G2398"\w*, \w para orar|strong="G4336"\w*. \w E chegada a tarde|strong="G3798,G1161,G1096"\w*, \w estava|strong="G1510"\w* \w ali|strong="G1563"\w* \w sozinho|strong="G3441"\w*.\x - \xo 14:23 \xt LUK 6:12; MRK 6:47; LUK 9:28; MAT 6:6; LUK 5:16; MRK 1:35\x*
\v 24 \w E o barco|strong="G3588,G1161,G4143"\w* \w já|strong="G2235"\w* \w estava distante|strong="G568"\w* \w muitos estádios|strong="G4712,G4183"\w* \w da terra|strong="G575,G3588,G1093"\w*, \w açoitado|strong="G928"\w* \w pelas ondas|strong="G5259,G3588,G2949"\w*, \w pois|strong="G1063"\w* \w o vento|strong="G3588,G417"\w* \w era contrário|strong="G1510,G1727"\w*.\f + \fr 14.24: \ft Variante: o RP traz “estava no meio do mar” (μέσον τῆς θαλάσσης ἦν) em lugar de “estava a muitos estádios da terra”.\f*\x - \xo 14:24 \xt MRK 6:48; MAT 8:24; LUK 6:12; MRK 6:45; JHN 6:18\x*
\v 25 \w E na quarta vigília|strong="G5067,G1161,G5438"\w* \w da noite|strong="G3588,G3571"\w*, \w veio|strong="G2064"\w* \w até eles|strong="G4314,G846"\w*, \w andando|strong="G4043"\w* \w sobre o mar|strong="G1909,G3588,G2281"\w*.\f + \fr 14.25: \ft Lit.: φυλακή, “vigília”, cada um dos quatro turnos em que a noite era dividida; a quarta vigília vai de cerca das três às seis da manhã.\f*\f + \fr 14.25: \ft Variante: NIV e o RP trazem ἀπῆλθεν (“foi”) em lugar de ἦλθεν (“veio”); o RP acrescenta “Jesus” (ὁ Ἰησοῦς) depois de “até eles” e traz o genitivo τῆς θαλάσσης (“do mar”).\f*\x - \xo 14:25 \xt MRK 6:48; LUK 6:12; MRK 6:45; JOB 9:8; JHN 6:19; LAM 2:19\x*
\v 26 \w E os discípulos|strong="G3588,G1161,G3101"\w*, \w vendo-o|strong="G1492,G846"\w* \w andar|strong="G4043"\w* \w sobre o mar|strong="G1909,G3588,G2281"\w*, \w ficaram perturbados|strong="G5015"\w*, \w dizendo|strong="G3004"\w*: “\w É|strong="G1510"\w* \w um fantasma|strong="G5326"\w*”; \w e|strong="G2532"\w* \w gritaram|strong="G2896"\w* \w de medo|strong="G575,G3588,G5401"\w*.\x - \xo 14:26 \xt MRK 6:49; MRK 6:45; JHN 6:19; REV 1:17; LUK 1:11-12; DAN 10:6-12\x*
\v 27 \w Mas logo|strong="G2112,G1161"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes falou|strong="G2980,G846"\w*, \w dizendo|strong="G3004"\w*: \add “Tenham\add* \w coragem|strong="G2293"\w*; \w sou eu|strong="G1473,G1510"\w*; \w não|strong="G3361"\w* \w temam|strong="G5399"\w*.”\f + \fr 14.27: \ft Acréscimo: “Tenham” (em “falou dizendo Tenham coragem sou”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 14:27 \xt MRK 6:50; JHN 16:33; ACT 23:11; ISA 41:10; REV 1:17-18; JHN 6:20\x*
\v 28 \w E Pedro|strong="G1161,G3588,G4074"\w*, \w respondendo|strong="G611"\w*, \w lhe disse|strong="G846,G2036"\w*: “\w Senhor|strong="G2962"\w*, \w se|strong="G1487"\w* \w é|strong="G1510"\w* \w você|strong="G4771"\w*, \w ordene-me|strong="G2753,G3165"\w* \w ir|strong="G2064"\w* \w até você|strong="G4314,G4771"\w* \w sobre as águas|strong="G1909,G3588,G5204"\w*.”\x - \xo 14:28 \xt MAT 26:33; JHN 6:20; MRK 6:45; JHN 6:68; ROM 12:3; JOB 9:8\x*
\v 29 \w E ele|strong="G3588,G1161"\w* \w disse|strong="G2036"\w*: “\w Venha|strong="G2064"\w*.” \w E|strong="G2532"\w* \w Pedro|strong="G4074"\w*, \w descendo|strong="G2597"\w* \w do barco|strong="G575,G3588,G4143"\w*, \w andou|strong="G4043"\w* \w sobre as águas|strong="G1909,G3588,G5204"\w* \w e|strong="G2532"\w* \w foi|strong="G2064"\w* \w até Jesus|strong="G4314,G3588,G2424"\w*.\x - \xo 14:29 \xt PHP 4:13; JHN 6:20; MRK 6:45; MRK 9:23; ACT 3:16; LUK 17:6\x*
\v 30 \w Mas|strong="G1161"\w*, \w vendo|strong="G991"\w* \w o vento|strong="G3588,G417"\w* \w forte|strong="G2478"\w*, \w teve medo|strong="G5399"\w*, \w e|strong="G2532"\w* \w começando|strong="G757"\w* \w a afundar|strong="G2670"\w*, \w gritou|strong="G2896"\w*, \w dizendo|strong="G3004"\w*: “\w Senhor|strong="G2962"\w*, \w salve-me|strong="G4982,G3165"\w*.”\x - \xo 14:30 \xt LAM 3:54-57; MAT 17:20; JHN 6:20; 2TI 4:16-17; MRK 6:45; MRK 14:38\x*
\v 31 \w E logo|strong="G2112,G1161"\w* \w Jesus|strong="G3588,G2424"\w*, \w estendendo|strong="G1614"\w* \w a mão|strong="G3588,G5495"\w*, \w o segurou|strong="G1949,G846"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Homem de pouca fé|strong="G3640"\w*, \w por que|strong="G1519,G5101"\w* \w duvidou|strong="G1365"\w*?”\x - \xo 14:31 \xt JAS 1:6-8; MAT 17:20; GEN 18:14; MAT 6:30; MRK 4:40; PSA 138:7\x*
\v 32 \w E tendo eles subido|strong="G2532,G305,G846"\w* \w ao barco|strong="G1519,G3588,G4143"\w*, \w o vento|strong="G3588,G417"\w* \w cessou|strong="G2869"\w*.\x - \xo 14:32 \xt MRK 6:51; MRK 6:45; PSA 89:9; PSA 107:29-30; JHN 6:21; MRK 4:41\x*
\v 33 \w E os que|strong="G3588,G1161"\w* \w estavam no barco|strong="G1722,G3588,G4143"\w* \w o adoraram|strong="G4352,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Verdadeiramente|strong="G230"\w* \w você é|strong="G1510"\w* \w Filho|strong="G5207"\w* \w de Deus|strong="G2316"\w*.”\f + \fr 14.33: \ft Acréscimo: verbo ser/estar suprido em “estavam no barco”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 14:33 \xt MAT 16:16; JHN 20:28; JHN 11:27; MRK 6:45; PSA 2:7; MAT 28:9\x*
\v 34 \w E|strong="G2532"\w* \w tendo atravessado|strong="G1276"\w*, \w chegaram|strong="G2064"\w* \w à terra|strong="G1909,G3588,G1093"\w*, \w em Genesaré|strong="G1519,G1082"\w*.\f + \fr 14.34: \ft Variante: o texto traz ἐπὶ τὴν γῆν (“sobre a terra”) com preposição que alguns manuscritos escrevem de outra forma.\f*\x - \xo 14:34 \xt MRK 6:53; LUK 5:1; NUM 34:11\x*
\v 35 \w E|strong="G2532"\w* \w tendo-o reconhecido|strong="G1921,G846"\w*, \w os homens|strong="G3588,G435"\w* \w daquele lugar|strong="G3588,G5117,G1565"\w*, \w enviaram|strong="G649"\w* \w a toda|strong="G1519,G3650"\w* \w aquela região ao redor|strong="G3588,G4066,G1565"\w*, \w e|strong="G2532"\w* \w lhe trouxeram|strong="G4374,G846"\w* \w todos os que estavam mal|strong="G3956,G3588,G2560,G2192"\w*,\x - \xo 14:35 \xt MRK 6:53; MAT 15:30; MAT 4:24-25\x*
\v 36 \w e|strong="G2532"\w* \w lhe pediam|strong="G3870,G846"\w* \w que|strong="G2443"\w* \w apenas|strong="G3441"\w* \w tocassem|strong="G681"\w* \w a borda|strong="G3588,G2899"\w* \w do seu manto|strong="G3588,G2440,G846"\w*; \w e|strong="G2532"\w* \w todos os que|strong="G3745"\w* \w tocaram|strong="G681"\w* \w foram curados|strong="G1295"\w*\f + \fr 14.36: \ft Lit.: διασῴζω, “salvar por completo, curar”.\f*.\x - \xo 14:36 \xt MAT 9:20; MRK 5:27; MAT 9:21; LUK 6:19; ACT 5:15; MRK 6:53\x*
\c 15
\p
\v 1 \w Então|strong="G5119"\w* \w se aproximaram|strong="G4334"\w* \w de Jesus|strong="G3588,G2424"\w*, \w vindos de Jerusalém|strong="G575,G2414"\w*, \w fariseus|strong="G5330"\w* \w e|strong="G2532"\w* \w escribas|strong="G1122"\w*, \w dizendo|strong="G3004"\w*:\x - \xo 15:1 \xt MRK 7:1; MAT 15:12; MRK 3:22; MAT 5:20; MAT 23:2; MAT 9:14\x*
\v 2 “\w Por que|strong="G1223,G5101"\w* \w os seus discípulos|strong="G3588,G3101,G4771"\w* \w transgridem|strong="G3845"\w* \w a tradição|strong="G3588,G3862"\w* \w dos anciãos|strong="G3588,G4245"\w*? \w Pois|strong="G1063"\w* \w não|strong="G3756"\w* \w lavam|strong="G3538"\w* \w as mãos|strong="G3588,G5495"\w* \w deles|strong="G846"\w* \w quando|strong="G3752"\w* \w comem|strong="G2068"\w* \w pão|strong="G740"\w*.”\f + \fr 15.2: \ft Lit.: πρεσβύτερος, “mais velho”: pode designar a idade ou um líder do povo ou da comunidade; as traduções usam “ancião” ou “presbítero”, e este livro usa “anciãos”.\f*\x - \xo 15:2 \xt MRK 7:3; MRK 7:5; ISA 29:13; COL 2:8; DEU 4:2; LUK 11:38\x*
\v 3 \w E ele|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w disse-lhes|strong="G2036,G846"\w*: “\w Por que|strong="G1223,G5101"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w transgridem|strong="G3845"\w* \w o mandamento|strong="G3588,G1785"\w* \w de Deus|strong="G3588,G2316"\w* \w por causa|strong="G1223"\w* \w da tradição|strong="G3588,G3862"\w* \w de vocês|strong="G4771"\w*?\x - \xo 15:3 \xt MRK 7:9; MRK 7:8; ISA 29:13; ISA 5:20; COL 2:8; DEU 4:2\x*
\v 4 \w Pois|strong="G1063"\w* \w Deus|strong="G3588,G2316"\w* \w disse|strong="G2036"\w*: ‘\w Honre|strong="G5091"\w* \w o pai|strong="G3588,G3962"\w* \w e|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w*’, \w e|strong="G2532"\w*: ‘\w Quem|strong="G3588"\w* \w maldisser|strong="G2551"\w* \w pai|strong="G3962"\w* \w ou|strong="G2228"\w* \w mãe|strong="G3384"\w*, \w certamente morra|strong="G2288,G5053"\w*.’\f + \fr 15.4: \ft Nota cultural: cita Êx 20:12 e 21:17.\f*\x - \xo 15:4 \xt EXO 20:12; EXO 21:17; MRK 7:10; EPH 6:2; MAT 19:19; ISA 29:13\x*
\v 5 \w Mas|strong="G1161"\w* \w vocês|strong="G4771"\w* \w dizem|strong="G3004"\w*: ‘\w Quem|strong="G3739,G302"\w* \w disser|strong="G2036"\w* \w ao pai|strong="G3588,G3962"\w* \w ou|strong="G2228"\w* \w à mãe|strong="G3588,G3384"\w*: \w Oferenda|strong="G1435"\w* \w é aquilo|strong="G3739"\w* \w com que|strong="G1437"\w* \w você seria ajudado|strong="G5623"\w* \w por mim|strong="G1537,G1473"\w*’,\f + \fr 15.5: \ft Lit.: δῶρον, “oferenda, dádiva consagrada”; em Mc 7:11 aparece a palavra hebraica Corbã, a oferta dedicada a Deus.\f*\f + \fr 15.5: \ft Acréscimo: verbo ser/estar suprido em “é aquilo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 15:5 \xt MRK 7:11; ISA 29:13; ISA 5:20; EPH 6:2; EXO 20:12; COL 2:8\x*
\v 6 \w de modo algum|strong="G3756,G3361"\w* \w honrará|strong="G5091"\w* \w o seu pai|strong="G3588,G3962,G846"\w*; \w e|strong="G2532"\w* \w anularam|strong="G208"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w* \w por causa|strong="G1223"\w* \w da tradição|strong="G3588,G3862"\w* \w de vocês|strong="G4771"\w*.\f + \fr 15.6: \ft Variante: Treg, o TR e o RP acrescentam “ou a sua mãe” (ἢ τὴν μητέρα αὐτοῦ) depois de “o seu pai”; o RP traz “e de modo algum” (καὶ οὐ) no começo e “o mandamento” (τὴν ἐντολήν) em lugar de “a palavra” (τὸν λόγον).\f*\x - \xo 15:6 \xt MRK 7:13; ISA 29:13; REV 22:18; ISA 5:20; EPH 6:2; EXO 20:12\x*
\v 7 \w Hipócritas|strong="G5273"\w*, \w bem|strong="G2573"\w* \w profetizou|strong="G4395"\w* \w a respeito de vocês|strong="G4012,G4771"\w* \w Isaías|strong="G2268"\w*, \w dizendo|strong="G3004"\w*:\f + \fr 15.7: \ft Variante: o TR e o RP acrescentam “Este povo se aproxima de mim” (Ἐγγίζει μοι ὁ λαὸς οὗτος) no começo da citação, no v. 8.\f*\x - \xo 15:7 \xt MRK 7:6; ACT 28:25; JHN 4:23; ISA 29:13; REV 22:18; COL 2:8\x*
