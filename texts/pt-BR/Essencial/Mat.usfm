\v 23 \w E|strong="G2532"\w*, \w tendo ele chegado|strong="G2064,G846"\w* \w ao templo|strong="G1519,G3588,G2411"\w*, \w aproximaram-se|strong="G4334"\w* \w dele|strong="G846"\w*, \w enquanto ensinava|strong="G1321"\w*, \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os anciãos|strong="G3588,G4245"\w* \w do povo|strong="G3588,G2992"\w*, \w dizendo|strong="G3004"\w*: “\w Com que|strong="G1722,G4169"\w* \w autoridade|strong="G1849"\w* \w faz|strong="G4160"\w* \w estas coisas|strong="G3778"\w*? \w E|strong="G2532"\w* \w quem|strong="G5101"\w* \w lhe deu|strong="G4771,G1325"\w* \w esta autoridade|strong="G3588,G1849,G3778"\w*?”\x - \xo 21:23 \xt LUK 20:1; LUK 20:2; LUK 19:47; MRK 11:27; MRK 11:28; MAT 11:12\x*
\v 24 \w E Jesus|strong="G1161,G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w lhes disse|strong="G2036,G846"\w*: “\w Também eu|strong="G2532_A,G1473"\w* \w lhes farei|strong="G2065,G4771"\w* \w uma só pergunta|strong="G3056,G1520"\w*; \w a qual, se|strong="G3739,G1437"\w* \w me disserem|strong="G2036,G3165"\w*, \w também eu|strong="G2532_B,G1473"\w* \w lhes direi|strong="G4771,G4483"\w* \w com que|strong="G1722,G4169"\w* \w autoridade|strong="G1849"\w* \w faço|strong="G4160"\w* \w estas coisas|strong="G3778"\w*.\f + \fr 21.24: \ft Lit.: λόγον ἕνα, literalmente “uma só palavra”, isto é, uma só pergunta.\f*\x - \xo 21:24 \xt MRK 11:29; LUK 20:2; LUK 20:3; JAS 2:18; MRK 11:28; MRK 11:33\x*
\v 25 \w O batismo|strong="G3588,G908"\w* \w de João|strong="G3588,G2491"\w*, \w de onde|strong="G4159"\w* \w era|strong="G1510"\w*? \w Do céu|strong="G1537,G3772"\w* \w ou|strong="G2228"\w* \w dos seres humanos|strong="G1537,G444"\w*?” \w E eles|strong="G3588,G1161"\w* \w raciocinavam|strong="G1260"\w* \w entre si|strong="G1722,G1438"\w*, \w dizendo|strong="G3004"\w*: “\w Se|strong="G1437"\w* \w dissermos|strong="G2036"\w*: ‘\w Do céu|strong="G1537,G3772"\w*’, \w ele nos dirá|strong="G4483,G3165"\w*: ‘\w Por que|strong="G1223,G5101"\w*, \w então|strong="G3767"\w*, \w não|strong="G3756"\w* \w creram nele|strong="G4100,G846"\w*?’\x - \xo 21:25 \xt MRK 11:31; LUK 20:4; LUK 20:5; ACT 19:4; MRK 11:30; MAT 11:12\x*
\v 26 \w Mas se|strong="G1437,G1161"\w* \w dissermos|strong="G2036"\w*: ‘\w Dos seres humanos|strong="G1537,G444"\w*’, \w temos medo|strong="G5399"\w* \w da multidão|strong="G3588,G3793"\w*, \w pois|strong="G1063"\w* \w todos|strong="G3956"\w* \w consideram|strong="G2192"\w* \w João|strong="G3588,G2491"\w* \w como profeta|strong="G5613,G4396"\w*.”\x - \xo 21:26 \xt MRK 11:32; MAT 14:5; MAT 21:46; LUK 20:6; MRK 12:12; MAT 11:12\x*
\v 27 \w E|strong="G2532"\w*, \w respondendo|strong="G611"\w* \w a Jesus|strong="G3588,G2424"\w*, \w disseram|strong="G2036"\w*: “\w Não|strong="G3756"\w* \w sabemos|strong="G6063"\w*.” \w Disse-lhes|strong="G5346,G846"\w* \w também ele|strong="G2532,G846"\w*: “\w Nem eu|strong="G3761,G1473"\w* \w lhes digo|strong="G3004,G4771"\w* \w com que|strong="G1722,G4169"\w* \w autoridade|strong="G1849"\w* \w faço|strong="G4160"\w* \w estas coisas|strong="G3778"\w*.\x - \xo 21:27 \xt MRK 11:33; LUK 20:8; LUK 20:2; MRK 11:28; MRK 11:29; MAT 11:12\x*
