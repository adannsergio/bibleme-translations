\v 36 \w Então|strong="G5119"\w*, \w deixando|strong="G863"\w* \w as multidões|strong="G3588,G3793"\w*, \w foi|strong="G2064"\w* \w para a casa|strong="G1519,G3588,G3614"\w*. \w E|strong="G2532"\w* \w se aproximaram|strong="G4334"\w* \w dele|strong="G846"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Explique|strong="G1285"\w* \w a nós|strong="G3165"\w* \w a parábola|strong="G3588,G3850"\w* \w do joio|strong="G3588,G2215"\w* \w do campo|strong="G3588,G68"\w*.”\x - \xo 13:36 \xt MRK 7:17; 1CO 3:9; MRK 4:34; MAT 15:15; MAT 9:28; ZEC 4:4\x*
\v 37 \w E ele|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: “\w O que semeia|strong="G3588,G4687"\w* \w a boa semente|strong="G3588,G2570,G4690"\w* \w é|strong="G1510"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w*;\x - \xo 13:37 \xt MAT 13:24; MAT 13:27; 1CO 3:5-7; MAT 16:13; MRK 4:14; 1CO 3:9\x*
\v 38 \w e o campo|strong="G3588,G1161,G68"\w* \w é|strong="G1510"\w* \w o mundo|strong="G3588,G2889"\w*; \w e a boa semente|strong="G3588,G1161,G2570,G4690"\w*, \w estes|strong="G3778"\w* \w são|strong="G1510"\w* \w os filhos|strong="G3588,G5207"\w* \w do reino|strong="G3588,G932"\w*; \w e o joio|strong="G3588,G1161,G2215"\w* \w são|strong="G1510"\w* \w os filhos|strong="G3588,G5207"\w* \w do Maligno|strong="G3588,G4190"\w*,\x - \xo 13:38 \xt MAT 13:27; GEN 3:15; JHN 8:44; MAT 13:19; 1JN 3:10; 1JN 3:8\x*
\v 39 \w e o inimigo|strong="G3588,G1161,G2190"\w* \w que os semeou|strong="G3588,G4687,G846"\w* \w é|strong="G1510"\w* \w o diabo|strong="G3588,G1228"\w*; \w e a colheita|strong="G3588,G1161,G2326"\w* \w é|strong="G1510"\w* \w o fim|strong="G4930"\w* \w do século|strong="G165"\w*, \w e os ceifeiros|strong="G3588,G1161,G2327"\w* \w são|strong="G1510"\w* \w anjos|strong="G32"\w*.\f + \fr 13.39: \ft Lit.: συντέλεια, “consumação, fim, conclusão”.\f*\x - \xo 13:39 \xt MAT 13:49; 1PE 5:8; REV 14:15; MAT 13:25; MAT 24:3; MAT 25:31\x*
\v 40 \w Assim como|strong="G5618,G3767"\w* \w o joio|strong="G3588,G2215"\w* \w é colhido|strong="G4816"\w* \w e|strong="G2532"\w* \w queimado|strong="G2545"\w* \w no fogo|strong="G4442"\w*, \w assim|strong="G3779"\w* \w será|strong="G1510"\w* \w no fim|strong="G1722,G3588,G4930"\w* \w do século|strong="G3588,G165"\w*;\f + \fr 13.40: \ft Variante: alguns manuscritos trazem κατακαίεται (“é queimado por completo”) em lugar de καίεται.\f*\x - \xo 13:40 \xt MAT 28:20; MAT 15:13; MAT 24:3; MAT 25:41; MAT 13:30; MAT 13:39\x*
\v 41 \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w enviará|strong="G649"\w* \w os seus anjos|strong="G3588,G32,G846"\w*, \w e|strong="G2532"\w* \w recolherão|strong="G4816"\w* \w do seu reino|strong="G1537,G3588,G932,G846"\w* \w todos os escândalos|strong="G3956,G3588,G4625"\w* \w e|strong="G2532"\w* \w os que praticam|strong="G3588,G4160"\w* \w a iniquidade|strong="G3588,G458"\w*,\f + \fr 13.41: \ft Lit.: σκάνδαλον, “causa de tropeço, escândalo”.\f*\x - \xo 13:41 \xt DAN 7:13; MAT 15:13; JHN 15:6; MAT 24:31; REV 21:27; MAT 3:12\x*
\v 42 \w e|strong="G2532"\w* \w os lançarão|strong="G906,G846"\w* \w na fornalha|strong="G1519,G3588,G2575"\w* \w de fogo|strong="G3588,G4442"\w*; \w ali|strong="G1563"\w* \w haverá|strong="G1510"\w* \w o choro|strong="G3588,G2805"\w* \w e|strong="G2532"\w* \w o ranger|strong="G3588,G1030"\w* \w de dentes|strong="G3588,G3599"\w*.\f + \fr 13.42: \ft Nota cultural: a fornalha de fogo lembra Dn 3:6.\f*\x - \xo 13:42 \xt DAN 3:6; MAT 13:50; MAT 8:12; MAT 25:30; LUK 13:28; MAT 22:13\x*
\v 43 \w Então|strong="G5119"\w* \w os justos|strong="G3588,G1342"\w* \w resplandecerão|strong="G1584"\w* \w como o sol|strong="G5613,G3588,G2246"\w* \w no reino|strong="G1722,G3588,G932"\w* \w do Pai|strong="G3588,G3962"\w* \w deles|strong="G846"\w*. \w Quem tem|strong="G3588,G2192"\w* \w ouvidos|strong="G3775"\w*, \w ouça|strong="G191"\w*.”\f + \fr 13.43: \ft Nota cultural: o resplendor dos justos ecoa Dn 12:3.\f*\x - \xo 13:43 \xt DAN 12:3; REV 2:7; ACT 6:15; PSA 37:6; 2TI 4:18; MAT 11:15\x*
\p
\v 44 “\w O reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w é semelhante|strong="G3664,G1510"\w* \w a um tesouro|strong="G2344"\w* \w escondido|strong="G2928"\w* \w no campo|strong="G1722,G3588,G68"\w*, \w que|strong="G3739"\w* \w um homem|strong="G444"\w*, \w tendo achado|strong="G2147"\w*, \w escondeu|strong="G2928"\w*; \w e|strong="G2532"\w*, \w por causa da alegria|strong="G575,G3588,G5479"\w* \w dele|strong="G846"\w*, \w vai|strong="G5217"\w*, \w e vende|strong="G2532,G4453"\w* \w tudo o que|strong="G3956,G3745"\w* \w tem|strong="G2192"\w* \w e|strong="G2532"\w* \w compra|strong="G59"\w* \w aquele campo|strong="G3588,G68,G1565"\w*.\x - \xo 13:44 \xt MAT 6:33; MAT 19:21; MRK 10:21; PRO 2:2-5; COL 2:3; PHP 3:7\x*
\v 45 \w De novo|strong="G3825"\w*, \w o reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w é semelhante|strong="G3664,G1510"\w* \w a um comerciante|strong="G444,G1713"\w* \w que procura|strong="G2212"\w* \w pérolas finas|strong="G2570,G3135"\w*;\x - \xo 13:45 \xt MAT 6:33; PHP 3:7; MAT 3:2; PHP 3:8; PRO 8:10-11; PSA 119:72\x*
\v 46 \w e tendo achado|strong="G2147,G1161"\w* \w uma|strong="G1520"\w* \w pérola|strong="G3135"\w* \w de grande valor|strong="G4186"\w*, \w foi|strong="G565"\w*, \w vendeu|strong="G4097"\w* \w tudo o que|strong="G3956,G3745"\w* \w tinha|strong="G2192"\w* \w e|strong="G2532"\w* \w a comprou|strong="G59,G846"\w*.\x - \xo 13:46 \xt MAT 6:33; PHP 3:7; PRO 23:23; LUK 18:28-30; PHP 3:8; PSA 119:72\x*
\v 47 \w De novo|strong="G3825"\w*, \w o reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w é semelhante|strong="G3664,G1510"\w* \w a uma rede|strong="G4522"\w* \w lançada|strong="G906"\w* \w ao mar|strong="G1519,G3588,G2281"\w* \w e|strong="G2532"\w* \w que reuniu|strong="G4863"\w* \w de todo tipo|strong="G1537,G3956,G1085"\w*;\f + \fr 13.47: \ft Lit.: σαγήνη, “rede de arrasto”.\f*\x - \xo 13:47 \xt JHN 15:6; MAT 13:24; LUK 5:10; MAT 4:17; 2TI 3:2-5; MAT 20:1\x*
\v 48 \w a qual|strong="G3739"\w*, \w quando|strong="G3753"\w* \w se encheu|strong="G4137"\w*, \w tendo-a puxado|strong="G307"\w* \w para a praia|strong="G1909,G3588,G123"\w* \w e|strong="G2532"\w* \w sentando-se|strong="G2523"\w*, \w juntaram|strong="G4816"\w* \w os bons|strong="G3588,G2570"\w* \w em cestos|strong="G1519,G6001"\w*, \w mas|strong="G1161"\w* \w os ruins|strong="G3588,G4550"\w* \w lançaram|strong="G906"\w* \w fora|strong="G1854"\w*.\x - \xo 13:48 \xt MAT 13:30; ACT 5:1; MAT 22:10; MAT 25:2; MAT 3:12; MAT 13:40-43\x*
\v 49 \w Assim|strong="G3779"\w* \w será|strong="G1510"\w* \w no fim|strong="G1722,G3588,G4930"\w* \w do século|strong="G3588,G165"\w*: \w sairão|strong="G1831"\w* \w os anjos|strong="G3588,G32"\w* \w e|strong="G2532"\w* \w separarão|strong="G873"\w* \w os maus|strong="G3588,G4190"\w* \w do meio|strong="G1537,G3319"\w* \w dos justos|strong="G3588,G1342"\w*,\x - \xo 13:49 \xt MAT 13:39; MAT 28:20; MAT 25:32; REV 20:12-15; MAT 24:3; MAT 24:31\x*
\v 50 \w e|strong="G2532"\w* \w os lançarão|strong="G906,G846"\w* \w na fornalha|strong="G1519,G3588,G2575"\w* \w de fogo|strong="G3588,G4442"\w*; \w ali|strong="G1563"\w* \w haverá|strong="G1510"\w* \w o choro|strong="G3588,G2805"\w* \w e|strong="G2532"\w* \w o ranger|strong="G3588,G1030"\w* \w de dentes|strong="G3588,G3599"\w*.”\x - \xo 13:50 \xt MAT 13:42; MAT 8:12; MAT 25:30; LUK 13:28; MAT 22:13; MAT 24:51\x*
\v 51 “\w Entenderam|strong="G4920"\w* \w todas estas coisas|strong="G3778,G3956"\w*?” \w Disseram-lhe|strong="G3004,G846"\w*: “\w Sim|strong="G3483"\w*.”\x - \xo 13:51 \xt PRO 1:6; MRK 4:13; MRK 4:34; ACT 8:30; EZK 40:4; MRK 13:14\x*
\v 52 \w E ele|strong="G3588,G1161"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Por isso|strong="G1223,G3778"\w* \w todo escriba|strong="G3956,G1122"\w* \w instruído|strong="G3100"\w* \w para o reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w é semelhante|strong="G3664,G1510"\w* \w a um dono de casa|strong="G444,G3617"\w* \w que|strong="G3748"\w* \w tira|strong="G1544"\w* \w do seu tesouro|strong="G1537,G3588,G2344,G846"\w* \w coisas novas|strong="G2537"\w* \w e|strong="G2532"\w* \w velhas|strong="G3820"\w*.”\f + \fr 13.52: \ft Lit.: μαθητεύω, “fazer discípulo, instruir como discípulo”.\f*\x - \xo 13:52 \xt 1JN 2:7; MAT 12:35; 2TI 3:16; 2TI 2:15; MAT 28:19; TIT 1:9\x*
\p
\v 53 \w E|strong="G2532"\w* \w aconteceu que|strong="G1096"\w*, \w quando|strong="G3753"\w* \w Jesus|strong="G3588,G2424"\w* \w terminou|strong="G5055"\w* \w estas parábolas|strong="G3588,G3850,G3778"\w*, \w partiu|strong="G3332"\w* \w dali|strong="G1564"\w*.\x - \xo 13:53 \xt MAT 26:1; MAT 19:1; MAT 7:28; MAT 13:3\x*
\v 54 \w E|strong="G2532"\w* \w tendo ido|strong="G2064"\w* \w à sua terra|strong="G1519,G3588,G3968,G846"\w*, \w ensinava-os|strong="G1321,G846"\w* \w na sinagoga|strong="G1722,G3588,G4864"\w* \w deles|strong="G846"\w*, \w de modo que|strong="G5620"\w* \w ficavam admirados|strong="G1605,G846"\w* \w e|strong="G2532"\w* \w diziam|strong="G3004"\w*: “\w De onde|strong="G4159"\w* \w lhe|strong="G3778"\w* \add vêm\add* \w esta sabedoria|strong="G3588,G4678,G3778"\w* \w e|strong="G2532"\w* \w os milagres|strong="G3588,G1411"\w*?\f + \fr 13.54: \ft Acréscimo: “vêm” (em “onde lhe vêm esta sabedoria”): verbo acrescentado: o grego traz a frase sem verbo (construção nominal ou elíptica) e o português exige um, tomado do contexto.\f*\f + \fr 13.54: \ft Tradução: δυνάμεις (δύναμις, G1411) está aqui como “os milagres”; o termo pode ser “poder”, “força”, “capacidade” ou “milagre”, e o contexto decide.\f*\x - \xo 13:54 \xt MRK 6:2; MRK 1:22; ISA 50:4; MRK 6:1; LUK 4:22; MAT 4:23\x*
\v 55 \w Não|strong="G3756"\w* \w é|strong="G1510"\w* \w este|strong="G3778"\w* \w o filho|strong="G3588,G5207"\w* \w do carpinteiro|strong="G3588,G5045"\w*? \w Não|strong="G3756"\w* \w se chama|strong="G3004"\w* \w a sua mãe|strong="G3588,G3384,G846"\w* \w Maria|strong="G3137"\w*, \w e|strong="G2532"\w* \w os seus irmãos|strong="G3588,G80,G846"\w* \w Tiago|strong="G2385"\w* \w e|strong="G2532"\w* \w José|strong="G2501"\w* \w e|strong="G2532"\w* \w Simão|strong="G4613"\w* \w e|strong="G2532"\w* \w Judas|strong="G2455"\w*?\f + \fr 13.55: \ft Lit.: τέκτων, “carpinteiro, artesão da construção”; “irmãos”: a tradição cristã discute se são filhos de José e Maria, filhos de José de outro casamento ou primos.\f*\x - \xo 13:55 \xt MRK 6:3; MAT 27:56; JHN 6:42; MRK 6:1; MAT 12:46; JHN 1:45\x*
\v 56 \w E|strong="G2532"\w* \w as suas irmãs|strong="G3588,G79,G846"\w* \w não|strong="G3780"\w* \w estão|strong="G1510"\w* \w todas|strong="G3956"\w* \w conosco|strong="G4314,G3165"\w*? \w De onde|strong="G4159"\w*, \w então|strong="G3767"\w*, \w lhe|strong="G3778"\w* \add vem\add* \w tudo isso|strong="G3778,G3956"\w*?”\f + \fr 13.56: \ft Acréscimo: “vem” (em “então lhe vem tudo isso”): verbo acrescentado: o grego traz a frase sem verbo (construção nominal ou elíptica) e o português exige um, tomado do contexto.\f*\x - \xo 13:56 \xt MRK 6:1; MRK 6:3; LUK 4:22; JHN 6:42; JHN 7:27; MAT 11:6\x*
\v 57 \w E|strong="G2532"\w* \w se escandalizavam|strong="G4624"\w* \w por causa dele|strong="G1722,G846"\w*. \w Mas Jesus|strong="G3588,G1161,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Não|strong="G3756"\w* \w é|strong="G1510"\w* \w profeta|strong="G4396"\w* \w sem honra|strong="G820"\w* \w a não ser|strong="G1487,G3361"\w* \w na sua terra|strong="G1722,G3588,G3968"\w* \w e|strong="G2532"\w* \w na sua casa|strong="G1722,G3588,G3614,G846"\w*.”\x - \xo 13:57 \xt MRK 6:4; LUK 4:24; JHN 4:44; MRK 6:1; MRK 6:3; MAT 11:6\x*
\v 58 \w E|strong="G2532"\w* \w não|strong="G3756"\w* \w fez|strong="G4160"\w* \w ali|strong="G1563"\w* \w muitos|strong="G4183"\w* \w milagres|strong="G1411"\w*, \w por causa|strong="G1223"\w* \w da incredulidade|strong="G3588,G570"\w* \w deles|strong="G846"\w*.\f + \fr 13.58: \ft Tradução: δυνάμεις (δύναμις, G1411) está aqui como “milagres”; o termo pode ser “poder”, “força”, “capacidade” ou “milagre”, e o contexto decide.\f*\x - \xo 13:58 \xt MRK 6:5; MRK 6:1; ROM 11:20; HEB 3:12-19; MAT 9:28; LUK 7:23\x*
\c 14
\p
\v 1 \w Naquele tempo|strong="G1722,G1565,G3588,G2540"\w*, \w Herodes|strong="G2264"\w*, \w o tetrarca|strong="G3588,G5076"\w*, \w ouviu|strong="G191"\w* \w a fama|strong="G3588,G189"\w* \w de Jesus|strong="G2424"\w*,\f + \fr 14.1: \ft Lit.: τετραάρχης, “tetrarca”, governante de uma quarta parte do território; aqui, Herodes Antipas, filho de Herodes, o Grande.\f*\x - \xo 14:1 \xt LUK 9:7; ACT 13:1; LUK 3:1; MAT 14:13; ACT 4:27; JOS 6:27\x*
\v 2 \w e|strong="G2532"\w* \w disse|strong="G2036"\w* \w aos seus servos|strong="G3588,G3816,G846"\w*: “\w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w João|strong="G2491"\w*, \w o Batista|strong="G3588,G910"\w*; \w ele|strong="G846"\w* \w ressuscitou|strong="G1453"\w* \w dos mortos|strong="G575,G3588,G3498"\w*, \w e|strong="G2532"\w* \w por isso|strong="G1223,G3778"\w* \w os poderes|strong="G3588,G1411"\w* \w operam|strong="G1754"\w* \w nele|strong="G1722,G846"\w*.”\x - \xo 14:2 \xt MRK 6:14; MRK 8:28; MAT 3:1; LUK 9:19; MAT 16:14; LUK 9:7\x*
\v 3 \w Pois|strong="G1063"\w* \w Herodes|strong="G3588,G2264"\w*, \w tendo prendido|strong="G2902"\w* \w João|strong="G3588,G2491"\w*, \w o amarrou|strong="G1210,G846"\w* \w e|strong="G2532"\w* \w o pôs|strong="G659"\w* \w na prisão|strong="G1722,G5438"\w*, \w por causa de|strong="G1223"\w* \w Herodias|strong="G2266"\w*, \w a mulher|strong="G3588,G1135"\w* \w de Filipe|strong="G5376"\w*, \w seu irmão|strong="G3588,G80,G846"\w*;\x - \xo 14:3 \xt MRK 6:17; LUK 3:19; MAT 11:2; JHN 3:24; MRK 9:13; LUK 9:7\x*
\v 4 \w pois|strong="G1063"\w* \w lhe dizia|strong="G3004,G846"\w* \w João|strong="G3588,G2491"\w*: “\w Não|strong="G3756"\w* \w lhe é permitido|strong="G1832,G4771"\w* \w tê-la|strong="G2192,G846"\w*.”\f + \fr 14.4: \ft Nota cultural: Lv 18:16 e 20:21 proíbem o casamento com a mulher do irmão.\f*\x - \xo 14:4 \xt LEV 20:21; LEV 18:16; MRK 6:18; PRO 28:4; MRK 9:13; LUK 9:7\x*
\v 5 \w E|strong="G2532"\w* \w querendo|strong="G2309"\w* \w matá-lo|strong="G846,G615"\w*, \w teve medo|strong="G5399"\w* \w da multidão|strong="G3588,G3793"\w*, \w porque|strong="G3754"\w* \w o tinham|strong="G846,G2192"\w* \w como profeta|strong="G5613,G4396"\w*.\x - \xo 14:5 \xt MAT 21:26; MRK 11:32; MRK 9:13; LUK 9:7; 2SA 12:13; LUK 1:76\x*
\v 6 \w Mas|strong="G1161"\w*, \w tendo chegado|strong="G1096"\w* \w o aniversário|strong="G1077"\w* \w de Herodes|strong="G3588,G2264"\w*, \w a filha|strong="G3588,G2364"\w* \w de Herodias|strong="G3588,G2266"\w* \w dançou|strong="G3738"\w* \w no meio|strong="G1722,G3588,G3319"\w* \w e|strong="G2532"\w* \w agradou|strong="G700"\w* \w a Herodes|strong="G3588,G2264"\w*,\x - \xo 14:6 \xt MRK 6:22; EST 2:4; MRK 9:13; LUK 9:7; MRK 6:21-23; GEN 40:20\x*
\v 7 \w pelo que|strong="G3606"\w*, \w com juramento|strong="G3326,G3727"\w*, \w prometeu|strong="G3670"\w* \w dar-lhe|strong="G846,G1325"\w* \w o que|strong="G3739,G1437"\w* \w pedisse|strong="G154"\w*.\x - \xo 14:7 \xt MRK 9:13; LUK 9:7; EST 5:6; MRK 6:23; ACT 13:1; EST 5:3\x*
\v 8 \w E ela|strong="G3588,G1161"\w*, \w instigada|strong="G4264"\w* \w pela mãe|strong="G5259,G3588,G3384,G846"\w*, \w disse|strong="G5346"\w*: “\w Dê|strong="G1325"\w*-\w me|strong="G3165"\w* \w aqui|strong="G5602"\w*, \w num prato|strong="G1909,G4094"\w*, \w a cabeça|strong="G3588,G2776"\w* \w de João|strong="G2491"\w*, \w o Batista|strong="G3588,G910"\w*.”\x - \xo 14:8 \xt MRK 6:24; MRK 6:25; MRK 6:28; MAT 14:11; MAT 3:1; MRK 9:13\x*
\v 9 \w E|strong="G2532"\w* \w o rei|strong="G3588,G935"\w*, \w entristecido|strong="G3076"\w*, \w por causa|strong="G1223"\w* \w dos juramentos|strong="G3588,G3727"\w* \w e|strong="G2532"\w* \w dos que estavam à mesa com ele|strong="G3588,G4873"\w*, \w ordenou|strong="G2753"\w* \w que fosse dada|strong="G1325"\w*,\x - \xo 14:9 \xt MRK 9:13; LUK 9:7; ACT 13:1; 2CH 22:3; JER 44:25; JHN 19:12-16\x*
\v 10 \w e|strong="G2532"\w* \w mandando|strong="G3992"\w*, \w decapitou|strong="G607"\w* \w João|strong="G3588,G2491"\w* \w na prisão|strong="G1722,G3588,G5438"\w*;\x - \xo 14:10 \xt LUK 9:9; MRK 6:16; MRK 9:13; LUK 9:7; 2SA 12:13; ACT 13:1\x*
