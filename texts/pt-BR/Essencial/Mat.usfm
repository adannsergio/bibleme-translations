\p
\v 1 \w Então|strong="G5119"\w* \w o reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w será comparado|strong="G3666"\w* \w a dez|strong="G1176"\w* \w virgens|strong="G3933"\w*, \w que|strong="G3748"\w*, \w tendo tomado|strong="G2983"\w* \w as suas lâmpadas|strong="G3588,G2985,G1438"\w*, \w saíram|strong="G1831"\w* \w ao encontro|strong="G1519,G5222"\w* \w do noivo|strong="G3588,G3566"\w*.\f + \fr 25.1: \ft Lit.: λαμπάς, “lâmpada, tocha” (em geral, um pavio embebido em azeite, preso a uma haste).\f*\x - \xo 25:1 \xt MAT 22:2; LUK 12:35; MAT 24:42-51; REV 19:7; PHP 2:15-16; ISA 54:5\x*
\v 2 \w E cinco|strong="G4002,G1161"\w* \w delas|strong="G1537,G846"\w* \w eram|strong="G1510"\w* \w tolas|strong="G3474"\w* \w e|strong="G2532"\w* \w cinco|strong="G4002"\w* \w prudentes|strong="G5429"\w*.\x - \xo 25:2 \xt MAT 25:8; MAT 7:14; REV 19:7; JER 24:2; 1CO 10:1-5; MAT 24:45\x*
\v 3 \w Pois as tolas|strong="G3588,G1063,G3474"\w*, \w tendo tomado|strong="G2983"\w* \w as suas lâmpadas|strong="G3588,G2985,G846"\w*, \w não|strong="G3756"\w* \w levaram|strong="G2983"\w* \w consigo|strong="G3326,G1438"\w* \w azeite|strong="G1637"\w*;\x - \xo 25:3 \xt MAT 25:8; MAT 7:14; 2TI 3:5; PRO 21:20; REV 3:15-16; REV 19:7\x*
\v 4 \w mas as prudentes|strong="G3588,G1161,G5429"\w* \w levaram|strong="G2983"\w* \w azeite|strong="G1637"\w* \w em vasilhas|strong="G1722,G3588,G30"\w* \w com as suas lâmpadas|strong="G3326,G3588,G2985,G1438"\w*.\x - \xo 25:4 \xt MAT 25:8; LUK 12:35; MAT 7:14; PRO 21:20; REV 19:7; ROM 8:9\x*
\v 5 \w E demorando|strong="G5549,G1161"\w* \w o noivo|strong="G3588,G3566"\w*, \w cochilaram|strong="G3573"\w* \w todas|strong="G3956"\w* \w e|strong="G2532"\w* \w dormiram|strong="G2518"\w*.\x - \xo 25:5 \xt LUK 12:35; ROM 13:11; MAT 7:14; REV 19:7; MAT 13:25; MAT 13:49\x*
\v 6 \w E à meia-noite|strong="G3319,G1161,G3571"\w* \w surgiu|strong="G1096"\w* \w um grito|strong="G2906"\w*: ‘\w Olhem|strong="G2400"\w*, \w o noivo|strong="G3588,G3566"\w*! \w Saiam|strong="G1831"\w* \w ao encontro|strong="G1519,G529"\w* \w dele|strong="G846"\w*!’\x - \xo 25:6 \xt LUK 12:35; ROM 13:11; MAT 7:14; MRK 13:32; 2PE 3:10; REV 19:7\x*
\v 7 \w Então|strong="G5119"\w* \w se levantaram|strong="G1453"\w* \w todas aquelas|strong="G3956,G3588,G1565"\w* \w virgens|strong="G3933"\w* \w e|strong="G2532"\w* \w prepararam|strong="G2885"\w* \w as suas lâmpadas|strong="G3588,G2985,G1438"\w*.\x - \xo 25:7 \xt LUK 12:35; ROM 13:11; MAT 7:14; REV 19:7; MAT 13:49; MAT 9:15\x*
\v 8 \w E as tolas|strong="G3588,G1161,G3474"\w* \w disseram|strong="G2036"\w* \w às prudentes|strong="G3588,G5429"\w*: ‘\w Deem|strong="G1325"\w*-\w nos|strong="G3165"\w* \w do azeite|strong="G1537,G3588,G1637"\w* \w de vocês|strong="G4771"\w*, \w porque|strong="G3754"\w* \w as nossas lâmpadas|strong="G3588,G2985,G3165"\w* \w estão se apagando|strong="G4570"\w*.’\x - \xo 25:8 \xt MAT 25:3; MAT 25:4; MAT 25:2; LUK 12:35; MAT 7:14; REV 19:7\x*
\v 9 \w E as prudentes|strong="G1161,G3588,G5429"\w* \w responderam|strong="G611"\w*, \w dizendo|strong="G3004"\w*: ‘\w Talvez não|strong="G4218,G3361,G3756,G3361"\w* \w haja o bastante|strong="G714"\w* \w para nós|strong="G3165"\w* \w e|strong="G2532"\w* \w para vocês|strong="G4771"\w*; \w vão|strong="G4198"\w* \w antes|strong="G3123"\w* \w aos que vendem|strong="G4314,G3588,G4453"\w* \w e|strong="G2532"\w* \w comprem|strong="G59"\w* \w para vocês|strong="G1438"\w*.’\f + \fr 25.9: \ft Lit.: μήποτε οὐ μὴ ἀρκέσῃ, construção elíptica: “para que de modo algum não baste”, isto é, “não vá faltar”.\f*\x - \xo 25:9 \xt LUK 12:35; MAT 7:14; PSA 49:7; REV 19:7; MAT 13:49; MAT 9:15\x*
\v 10 \w E enquanto elas saíam|strong="G565,G1161,G846"\w* \w para comprar|strong="G59"\w*, \w veio|strong="G2064"\w* \w o noivo|strong="G3588,G3566"\w*, \w e|strong="G2532"\w* \w as que estavam prontas|strong="G3588,G2092"\w* \w entraram|strong="G1525"\w* \w com ele|strong="G3326,G846"\w* \w para a festa de casamento|strong="G1519,G3588,G1062"\w*, \w e|strong="G2532"\w* \w a porta|strong="G3588,G2374"\w* \w foi fechada|strong="G2808"\w*.\f + \fr 25.10: \ft Acréscimo: “as que estavam prontas”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 25:10 \xt MAT 24:44; REV 22:11; LUK 12:35; MAT 7:14; GEN 7:16; LUK 13:25\x*
\v 11 \w Mais tarde|strong="G5306,G1161"\w* \w vieram|strong="G2064"\w* \w também|strong="G2532"\w* \w as demais|strong="G3588,G3062"\w* \w virgens|strong="G3933"\w*, \w dizendo|strong="G3004"\w*: ‘\w Senhor|strong="G2962"\w*, \w senhor|strong="G2962"\w*, \w abra|strong="G455"\w* \w para nós|strong="G3165"\w*!’\x - \xo 25:11 \xt MAT 7:21; ISA 55:6; MAT 7:14; LUK 13:25; HEB 12:17; MAT 13:49\x*
\v 12 \w Mas ele|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: ‘\w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w*: \w não|strong="G3756"\w* \w conheço|strong="G6063"\w* \w vocês|strong="G4771"\w*.’\x - \xo 25:12 \xt JHN 8:34; JHN 3:5; JHN 5:19; JHN 3:3; MAT 25:45; MAT 7:21\x*
\v 13 \w Vigiem|strong="G1127"\w*, \w pois|strong="G3767"\w*, \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w sabem|strong="G6063"\w* \w o dia|strong="G3588,G2250"\w* \w nem a hora|strong="G3761,G3588,G5610"\w*.\f + \fr 25.13: \ft Variante: o RP e o TR acrescentam ἐν ᾗ ὁ υἱὸς τοῦ ἀνθρώπου ἔρχεται (“em que o Filho do Homem vem”) no fim do verso.\f*\x - \xo 25:13 \xt MRK 13:32; MAT 24:36; REV 3:3; MAT 26:40; LUK 21:36; 1CO 16:13\x*
\v 14 \w Pois|strong="G1063"\w* \add é\add* \w como|strong="G5618"\w* \w um homem|strong="G444"\w* \add que,\add* \w ao partir em viagem|strong="G589"\w*, \w chamou|strong="G2564"\w* \w os seus próprios|strong="G3588,G2398"\w* \w escravos|strong="G1401"\w* \w e|strong="G2532"\w* \w lhes entregou|strong="G3860,G846"\w* \w os seus bens|strong="G3588,G5225,G846"\w*,\f + \fr 25.14: \ft Acréscimo: “é” (em “Pois é como um”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige; “que” (em “um homem que ao partir”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 25:14 \xt MRK 13:34; 1PE 4:9-11; LUK 12:48; LUK 19:13; ROM 12:6-8; LUK 19:12\x*
\v 15 \w e|strong="G2532"\w* \w a um|strong="G3739,G3303"\w* \w deu|strong="G1325"\w* \w cinco talentos|strong="G4002,G5007"\w*, \w a outro|strong="G3739,G1161"\w* \w dois|strong="G1417"\w*, \w e a outro|strong="G3739,G1161"\w* \w um|strong="G1520"\w*, \w a cada um|strong="G1538"\w* \w conforme|strong="G2596"\w* \w a sua própria|strong="G3588,G2398"\w* \w capacidade|strong="G1411"\w*; \w e|strong="G2532"\w* \w partiu em viagem|strong="G589"\w*. \w Imediatamente|strong="G2112"\w*,\f + \fr 25.15: \ft Tradução: δύναμιν (δύναμις, G1411) está aqui como “capacidade”; o termo pode ser “poder”, “força”, “capacidade” ou “milagre”, e o contexto decide.\f*\x - \xo 25:15 \xt 2TI 1:6; LUK 12:48; LUK 19:13; JHN 3:27; LUK 19:12; MAT 25:14\x*
\v 16 \w tendo ido|strong="G4198"\w*, \w o que recebera|strong="G3588,G2983"\w* \w os cinco talentos|strong="G3588,G4002,G5007"\w* \w negociou|strong="G2038"\w* \w com eles|strong="G1722,G846"\w* \w e|strong="G2532"\w* \w ganhou|strong="G2770"\w* \w outros cinco|strong="G243,G4002"\w*;\f + \fr 25.16: \ft Variante: Treg e o RP acrescentam δέ depois de πορευθείς; o RP traz ἐποίησεν (“fez”) em lugar de ἐκέρδησεν (“ganhou”); o TR e o RP acrescentam τάλαντα (“talentos”) depois de “outros cinco”.\f*\x - \xo 25:16 \xt MAT 25:20; MAT 25:22; 2TI 1:6; LUK 12:48; LUK 19:12; MAT 25:14\x*
\v 17 \w da mesma forma|strong="G5615"\w* \w o dos dois|strong="G3588,G1417"\w* \w ganhou|strong="G2770"\w* \w outros dois|strong="G243,G1417"\w*.\x - \xo 25:17 \xt MAT 25:22; 2TI 1:6; LUK 12:48; LUK 19:12; MAT 25:14; LUK 16:1\x*
\v 18 \w Mas o que|strong="G3588,G1161"\w* \w recebera|strong="G2983"\w* \w o um|strong="G3588,G1520"\w*, \w indo embora|strong="G565"\w*, \w cavou|strong="G3736"\w* \w a terra|strong="G1093"\w* \w e|strong="G2532"\w* \w escondeu|strong="G2928"\w* \w o dinheiro|strong="G3588,G694"\w* \w do seu senhor|strong="G3588,G2962,G846"\w*.\f + \fr 25.18: \ft Lit.: τάλαντον, “talento”, a maior unidade de peso e de valor (cerca de seis mil denários); ἀργύριον, “prata, dinheiro”.\f*\x - \xo 25:18 \xt 2TI 1:6; LUK 12:48; LUK 19:12; MAT 25:14; LUK 16:1; 2PE 1:8\x*
\v 19 \w E depois|strong="G3326,G1161"\w* \w de muito tempo|strong="G4183,G5550"\w*, \w veio|strong="G2064"\w* \w o senhor|strong="G3588,G2962"\w* \w daqueles escravos|strong="G3588,G1401,G1565"\w* \w e|strong="G2532"\w* \w acertou contas|strong="G4868,G3056"\w* \w com eles|strong="G3326,G846"\w*.\x - \xo 25:19 \xt MAT 18:23; 2TI 1:6; LUK 12:48; LUK 19:12; MAT 25:14; LUK 16:1\x*
\v 20 \w E|strong="G2532"\w*, \w aproximando-se|strong="G4334"\w* \w o que recebera|strong="G3588,G2983"\w* \w os cinco talentos|strong="G3588,G4002,G5007"\w*, \w trouxe|strong="G4374"\w* \w outros cinco|strong="G243,G4002"\w* \w talentos|strong="G5007"\w*, \w dizendo|strong="G3004"\w*: ‘\w Senhor|strong="G2962"\w*, \w cinco talentos|strong="G4002,G5007"\w* \w me entregou|strong="G3165,G3860"\w*; \w olhe|strong="G2396"\w*, \w outros cinco|strong="G243,G4002"\w* \w talentos|strong="G5007"\w* \w ganhei|strong="G2770"\w*.’\x - \xo 25:20 \xt MAT 25:22; MAT 25:16; 2TI 1:6; LUK 12:48; LUK 19:12; MAT 25:14\x*
\v 21 \w Disse-lhe|strong="G5346,G846"\w* \w o seu senhor|strong="G3588,G2962,G846"\w*: \add ‘Muito\add* \w bem|strong="G2095"\w*, \w escravo|strong="G1401"\w* \w bom|strong="G18"\w* \w e|strong="G2532"\w* \w fiel|strong="G4103"\w*! \w Sobre poucas coisas|strong="G1909,G3641"\w* \w você foi|strong="G1510"\w* \w fiel|strong="G4103"\w*, \w sobre muitas|strong="G1909,G4183"\w* \w o colocarei|strong="G4771,G2525"\w*; \w entre|strong="G1525"\w* \w na alegria|strong="G1519,G3588,G5479"\w* \w do seu senhor|strong="G3588,G2962,G4771"\w*.’\f + \fr 25.21: \ft Acréscimo: “Muito” (em “seu senhor Muito bem escravo”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 25:21 \xt MAT 25:23; REV 22:3; MAT 24:45; LUK 16:10; 1CO 4:2; JHN 12:26\x*
\v 22 \w E aproximando-se|strong="G4334,G1161"\w* \w também|strong="G2532"\w* \w o que recebera|strong="G3588"\w* \w os dois talentos|strong="G3588,G1417,G5007"\w*, \w disse|strong="G2036"\w*: ‘\w Senhor|strong="G2962"\w*, \w dois talentos|strong="G1417,G5007"\w* \w me entregou|strong="G3165,G3860"\w*; \w olhe|strong="G2396"\w*, \w outros dois|strong="G243,G1417"\w* \w talentos|strong="G5007"\w* \w ganhei|strong="G2770"\w*.’\x - \xo 25:22 \xt MAT 25:20; MAT 25:16; MAT 25:17; 2TI 1:6; LUK 12:48; LUK 19:12\x*
\v 23 \w Disse-lhe|strong="G5346,G846"\w* \w o seu senhor|strong="G3588,G2962,G846"\w*: \add ‘Muito\add* \w bem|strong="G2095"\w*, \w escravo|strong="G1401"\w* \w bom|strong="G18"\w* \w e|strong="G2532"\w* \w fiel|strong="G4103"\w*! \w Sobre poucas coisas|strong="G1909,G3641"\w* \w você foi|strong="G1510"\w* \w fiel|strong="G4103"\w*, \w sobre muitas|strong="G1909,G4183"\w* \w o colocarei|strong="G4771,G2525"\w*; \w entre|strong="G1525"\w* \w na alegria|strong="G1519,G3588,G5479"\w* \w do seu senhor|strong="G3588,G2962,G4771"\w*.’\f + \fr 25.23: \ft Acréscimo: “Muito” (em “seu senhor Muito bem escravo”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 25:23 \xt MAT 25:21; MAT 24:45; LUK 16:10; 2TI 1:6; LUK 12:48; PRO 22:29\x*
\v 24 \w E aproximando-se|strong="G4334,G1161"\w* \w também|strong="G2532"\w* \w o que recebera|strong="G3588,G2983"\w* \w o um|strong="G3588,G1520"\w* \w talento|strong="G5007"\w*, \w disse|strong="G2036"\w*: ‘\w Senhor|strong="G2962"\w*, \w eu o conhecia|strong="G1097,G4771"\w*, \w que|strong="G3754"\w* \w é|strong="G1510"\w* \w um homem|strong="G444"\w* \w duro|strong="G4642"\w*, \w que colhe|strong="G2325"\w* \w onde|strong="G3699"\w* \w não|strong="G3756"\w* \w semeou|strong="G4687"\w* \w e|strong="G2532"\w* \w recolhe|strong="G4863"\w* \w de onde|strong="G3606"\w* \w não|strong="G3756"\w* \w espalhou|strong="G1287"\w*;\x - \xo 25:24 \xt MAT 25:26; 2TI 1:6; LUK 12:48; LUK 19:12; MAT 25:14; LUK 6:46\x*
\v 25 \w e|strong="G2532"\w*, \w tendo medo|strong="G5399"\w*, \w fui embora|strong="G565"\w* \add e\add* \w escondi|strong="G2928"\w* \w o seu talento|strong="G3588,G5007,G4771"\w* \w na terra|strong="G1722,G3588,G1093"\w*; \w olhe|strong="G2396"\w*, \w você tem|strong="G2192"\w* \w o que é seu|strong="G3588,G4771"\w*.’\f + \fr 25.25: \ft Acréscimo: “e” (em “fui embora e escondi o”): conectivo acrescentado para ligar as orações em português; verbo ser/estar suprido em “o que é seu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 25:25 \xt 2TI 1:6; LUK 12:48; LUK 19:12; MAT 25:14; LUK 16:1; MAT 13:49\x*
\v 26 \w E o seu senhor|strong="G1161,G3588,G2962,G846"\w*, \w respondendo|strong="G611"\w*, \w lhe disse|strong="G2036,G846"\w*: ‘\w Escravo|strong="G1401"\w* \w mau|strong="G4190"\w* \w e|strong="G2532"\w* \w preguiçoso|strong="G3636"\w*, \w você sabia|strong="G1492"\w* \w que|strong="G3754"\w* \w colho|strong="G2325"\w* \w onde|strong="G3699"\w* \w não|strong="G3756"\w* \w semeei|strong="G4687"\w* \w e|strong="G2532"\w* \w recolho|strong="G4863"\w* \w de onde|strong="G3606"\w* \w não|strong="G3756"\w* \w espalhei|strong="G1287"\w*?\x - \xo 25:26 \xt MAT 25:24; 2TI 1:6; LUK 12:48; PRO 6:6; LUK 19:12; MAT 25:14\x*
\v 27 \w Então|strong="G3767"\w* \w era necessário|strong="G1163"\w* \w que você|strong="G4771"\w* \w depositasse|strong="G906"\w* \w o meu dinheiro|strong="G3588,G694,G3165"\w* \w com os banqueiros|strong="G3588,G5133"\w*, \w e|strong="G2532"\w*, \w vindo|strong="G2064"\w*, \w eu|strong="G1473"\w* \w teria recebido|strong="G2865,G302"\w* \w o que é meu|strong="G3588,G1473"\w* \w com juros|strong="G4862,G5110"\w*.\f + \fr 25.27: \ft Acréscimo: verbo ser/estar suprido em “o que é meu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 25:27 \xt LUK 19:23; 2TI 1:6; LUK 12:48; LUK 19:12; MAT 25:14; LUK 16:1\x*
