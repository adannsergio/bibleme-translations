\v 24 \w dizia|strong="G3004"\w*: “\w Retirem-se|strong="G402"\w*, \w pois|strong="G1063"\w* \w a menina|strong="G3588,G2877"\w* \w não|strong="G3756"\w* \w morreu|strong="G599"\w*, \w mas|strong="G235"\w* \w dorme|strong="G2518"\w*.” \w E|strong="G2532"\w* \w riam-se|strong="G2606"\w* \w dele|strong="G846"\w*.\x - \xo 9:24 \xt LUK 8:53; ACT 20:10; JHN 11:13; JHN 11:11; MRK 5:22; 1KI 17:18-24\x*
\v 25 \w Mas quando|strong="G3753,G1161"\w* \w a multidão|strong="G3588,G3793"\w* \w foi expulsa|strong="G1544"\w*, \w entrando|strong="G1525"\w*, \w segurou|strong="G2902"\w* \w a mão|strong="G3588,G5495"\w* \w dela|strong="G846"\w*, \w e|strong="G2532"\w* \w a menina|strong="G3588,G2877"\w* \w se levantou|strong="G1453"\w*.\x - \xo 9:25 \xt MRK 5:41; MRK 9:27; LUK 8:54; MRK 1:31; ACT 9:40; 2KI 4:32-36\x*
\v 26 \w E|strong="G2532"\w* \w esta notícia|strong="G3588,G5345,G3778"\w* \w se espalhou|strong="G1831"\w* \w por toda aquela terra|strong="G1519,G3650,G3588,G1093,G1565"\w*.\x - \xo 9:26 \xt LUK 4:14; MAT 9:31; LUK 4:37; MRK 5:22; MAT 4:24; LUK 5:15\x*
\p
\v 27 \w E|strong="G2532"\w* \w ao passar|strong="G3855"\w* \w Jesus|strong="G3588,G2424"\w* \w dali|strong="G1564"\w*, \w dois cegos|strong="G1417,G5185"\w* \w o seguiram|strong="G190,G846"\w*, \w gritando|strong="G2896"\w* \w e|strong="G2532"\w* \w dizendo|strong="G3004"\w*: “\w Tenha misericórdia|strong="G1653"\w* \w de nós|strong="G3165"\w*, \w Filho|strong="G5207"\w* \w de Davi|strong="G1138"\w*.”\f + \fr 9.27: \ft Nota cultural: “Filho de Davi” é título messiânico (cf. 1:1).\f*\f + \fr 9.27: \ft Variante: WH omite “a ele” (αὐτῷ) depois de “seguiram”; WH e o RP trazem υἱέ (vocativo) e Treg e NA28 trazem υἱός (nominativo usado como vocativo).\f*\x - \xo 9:27 \xt MAT 20:30; JHN 9:1; MAT 15:22; LUK 18:38; MRK 10:47; ISA 35:5\x*
\v 28 \w E tendo ele entrado|strong="G2064,G1161"\w* \w na casa|strong="G1519,G3588,G3614"\w*, \w os cegos|strong="G3588,G5185"\w* \w se aproximaram|strong="G4334"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Vocês creem|strong="G4100"\w* \w que|strong="G3754"\w* \w posso|strong="G1410"\w* \w fazer|strong="G4160"\w* \w isto|strong="G3778"\w*?” \w Disseram-lhe|strong="G3004,G846"\w*: “\w Sim|strong="G3483"\w*, \w Senhor|strong="G2962"\w*.”\x - \xo 9:28 \xt MRK 9:23; JHN 11:27; ISA 35:5; LUK 4:18; MRK 5:36; JHN 11:26\x*
\v 29 \w Então|strong="G5119"\w* \w tocou|strong="G681"\w* \w os olhos|strong="G3588,G3788"\w* \w deles|strong="G846"\w*, \w dizendo|strong="G3004"\w*: “\w Conforme|strong="G2596"\w* \w a fé|strong="G3588,G4102"\w* \w de vocês|strong="G4771"\w*, \w seja feito|strong="G1096"\w* \w a vocês|strong="G4771"\w*.”\x - \xo 9:29 \xt ISA 35:5; LUK 4:18; MRK 5:36; MAT 15:28; MRK 10:52; MAT 9:22\x*
\v 30 \w E|strong="G2532"\w* \w se abriram|strong="G455"\w* \w os olhos|strong="G3588,G3788"\w* \w deles|strong="G846"\w*. \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w os advertiu severamente|strong="G1690,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Cuidem|strong="G3708"\w* \w que ninguém|strong="G3367"\w* \w saiba|strong="G1097"\w*.”\f + \fr 9.30: \ft Lit.: ἐμβριμάομαι, “advertir com severidade, repreender, comover-se profundamente”.\f*\x - \xo 9:30 \xt MAT 20:33; ISA 35:5; LUK 4:18; MAT 8:13; MAT 6:3; PSA 146:8\x*
\v 31 \w Mas eles|strong="G3588,G1161"\w*, \w saindo|strong="G1831"\w*, \w divulgaram a fama|strong="G1310"\w* \w dele|strong="G846"\w* \w em toda aquela terra|strong="G1722,G3650,G3588,G1093,G1565"\w*.\x - \xo 9:31 \xt MAT 9:26; MRK 1:45; LUK 7:17; MRK 7:36; MAT 4:24; MRK 1:28\x*
\v 32 \w E ao saírem eles|strong="G846,G1161,G1831"\w*, \w olhem|strong="G2400"\w*, \w trouxeram-lhe|strong="G4374,G846"\w* \w um homem|strong="G444"\w* \w mudo|strong="G2974"\w* \w endemoninhado|strong="G1139"\w*;\f + \fr 9.32: \ft Lit.: κωφός, “mudo” (também “surdo”).\f*\x - \xo 9:32 \xt MAT 12:22; LUK 11:14; MAT 4:24; ISA 35:6; LUK 13:11; MRK 7:32\x*
\v 33 \w e|strong="G2532"\w* \w tendo sido expulso|strong="G1544"\w* \w o demônio|strong="G3588,G1140"\w*, \w falou|strong="G2980"\w* \w o mudo|strong="G3588,G2974"\w*. \w E|strong="G2532"\w* \w as multidões|strong="G3588,G3793"\w* \w ficaram admiradas|strong="G2296"\w*, \w dizendo|strong="G3004"\w*: “\w Jamais|strong="G3763"\w* \w apareceu|strong="G5316"\w* \w algo assim|strong="G3779"\w* \w em Israel|strong="G1722,G3588,G2474"\w*.”\x - \xo 9:33 \xt LUK 11:14; MAT 15:31; MRK 2:12; ISA 35:6; JHN 15:24; LUK 13:11\x*
\v 34 \w Mas os fariseus|strong="G3588,G1161,G5330"\w* \w diziam|strong="G3004"\w*: “\w Pelo chefe|strong="G1722,G3588,G758"\w* \w dos demônios|strong="G3588,G1140"\w* \w expulsa|strong="G1544"\w* \w os demônios|strong="G3588,G1140"\w*.”\x - \xo 9:34 \xt MAT 12:24; LUK 11:15; MRK 3:22; JHN 7:48; LUK 11:14; MRK 3:15\x*
\p
\v 35 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w percorria|strong="G4013"\w* \w todas as cidades|strong="G3588,G4172,G3956"\w* \w e|strong="G2532"\w* \w as aldeias|strong="G3588,G2968"\w*, \w ensinando|strong="G1321"\w* \w nas sinagogas|strong="G1722,G3588,G4864"\w* \w deles|strong="G846"\w*, \w e|strong="G2532"\w* \w proclamando|strong="G2784"\w* \w a boa notícia|strong="G3588,G2098"\w* \w do reino|strong="G3588,G932"\w*, \w e|strong="G2532"\w* \w curando|strong="G2323"\w* \w toda doença|strong="G3956,G3554"\w* \w e|strong="G2532"\w* \w toda enfermidade|strong="G3956,G3119"\w*.\f + \fr 9.35: \ft Variante: o TR e o RP acrescentam “entre o povo” (ἐν τῷ λαῷ) no fim.\f*\x - \xo 9:35 \xt MAT 4:23; MRK 6:6; MAT 24:14; ACT 10:38; LUK 4:43-44; MRK 6:56\x*
\v 36 \w E ao ver|strong="G1492,G1161"\w* \w as multidões|strong="G3588,G3793"\w*, \w teve compaixão|strong="G4697"\w* \w delas|strong="G4012,G846"\w*, \w porque|strong="G3754"\w* \w estavam|strong="G1510"\w* \w exaustas|strong="G4660"\w* \w e|strong="G2532"\w* \w abatidas|strong="G4496"\w* \w como ovelhas|strong="G5616,G4263"\w* \w que não têm|strong="G3361,G2192"\w* \w pastor|strong="G4166"\w*.\f + \fr 9.36: \ft Lit.: σπλαγχνίζομαι, “compadecer-se de coração” (das entranhas, splanchna).\f*\f + \fr 9.36: \ft Nota cultural: ovelhas sem pastor evocam Nm 27:17 e Ez 34:5.\f*\f + \fr 9.36: \ft Variante: Treg traz ὡς em lugar de ὡσεί (“como”).\f*\x - \xo 9:36 \xt NUM 27:17; EZK 34:5; MRK 6:34; LUK 10:2; 1PE 2:25; AMO 8:11\x*
\v 37 \w Então|strong="G5119"\w* \w disse|strong="G3004"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w*: “\w A colheita|strong="G3588,G3303,G2326"\w* \w é grande|strong="G4183"\w*, \w mas|strong="G1161"\w* \w os trabalhadores|strong="G3588,G2040"\w* \w são poucos|strong="G3641"\w*;\f + \fr 9.37: \ft Acréscimo: verbo ser/estar suprido em “é grande”, “são poucos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:37 \xt LUK 10:2; MRK 16:15; 1CO 3:9; JHN 4:35; MAT 28:19; 2CO 6:1\x*
\v 38 \w peçam|strong="G1189"\w*, \w portanto|strong="G3767"\w*, \w ao Senhor|strong="G3588,G2962"\w* \w da colheita|strong="G3588,G2326"\w* \w que envie|strong="G3704,G1544"\w* \w trabalhadores|strong="G2040"\w* \w para a sua colheita|strong="G1519,G3588,G2326,G846"\w*.”\x - \xo 9:38 \xt LUK 10:2; LUK 9:40; LUK 10:1-2; JER 3:15; 2TH 3:1; JHN 4:35\x*
\c 10
\p
\v 1 \w E|strong="G2532"\w* \w tendo chamado|strong="G4341"\w* \w os seus|strong="G846"\w* \w doze|strong="G3588,G1427"\w* \w discípulos|strong="G3101"\w*, \w deu-lhes|strong="G1325,G846"\w* \w autoridade|strong="G1849"\w* \w sobre espíritos|strong="G4151"\w* \w impuros|strong="G169"\w*, \w para|strong="G5620"\w* \w expulsá-los|strong="G1544,G846"\w* \w e|strong="G2532"\w* \w curar|strong="G2323"\w* \w toda doença|strong="G3956,G3554"\w* \w e|strong="G2532"\w* \w toda enfermidade|strong="G3956,G3119"\w*.\x - \xo 10:1 \xt LUK 9:1; MRK 6:7; MRK 3:13; MAT 10:8; LUK 10:19; MRK 16:17-18\x*
\v 2 \w E estes|strong="G1161,G3778"\w* \w são|strong="G1510"\w* \w os nomes|strong="G3588,G3686"\w* \w dos doze|strong="G3588,G1427"\w* \w apóstolos|strong="G652"\w*: \w primeiro|strong="G4413"\w*, \w Simão|strong="G4613"\w*, \w chamado|strong="G3588,G3004"\w* \w Pedro|strong="G4074"\w*, \w e|strong="G2532"\w* \w André|strong="G406"\w*, \w o irmão|strong="G3588,G80"\w* \w dele|strong="G846"\w*; \w Tiago|strong="G2385"\w*, \w o de Zebedeu|strong="G3588,G2199"\w*, \w e|strong="G2532"\w* \w João|strong="G2491"\w*, \w o irmão|strong="G3588,G80"\w* \w dele|strong="G846"\w*;\f + \fr 10.2: \ft Lit.: ἀπόστολος, “enviado, delegado”.\f*\x - \xo 10:2 \xt JHN 6:8; JHN 1:40; MRK 1:29; LUK 5:10; MAT 4:18; ACT 1:13\x*
\v 3 \w Filipe|strong="G5376"\w* \w e|strong="G2532"\w* \w Bartolomeu|strong="G918"\w*; \w Tomé|strong="G2381"\w* \w e|strong="G2532"\w* \w Mateus|strong="G3156"\w*, \w o cobrador de impostos|strong="G3588,G5057"\w*; \w Tiago|strong="G2385"\w*, \w o de Alfeu|strong="G3588,G256"\w*, \w e|strong="G2532"\w* \w Tadeu|strong="G2280"\w*;\f + \fr 10.3: \ft Variante: o RP traz “Lebeu, chamado Tadeu” (Λεββαῖος ὁ ἐπικληθεὶς Θαδδαῖος), e o TR traz “Lebeu, de sobrenome Tadeu”, em lugar de “Tadeu”.\f*\x - \xo 10:3 \xt MRK 3:18; ACT 1:13; LUK 6:15; LUK 6:14; LUK 9:1; LUK 10:1\x*
\v 4 \w Simão|strong="G4613"\w*, \w o cananeu|strong="G3588,G2581"\w*, \w e|strong="G2532"\w* \w Judas|strong="G2455"\w*, \w o Iscariotes|strong="G3588,G2469"\w*, \w o que|strong="G3588"\w* \w também|strong="G2532"\w* \w o entregou|strong="G3860,G846"\w*.\f + \fr 10.4: \ft Lit.: Καναναῖος vem do aramaico qanʾān, “zeloso”, equivalente ao grego ζηλωτής (“zelote”, Lc 6:15).\f*\x - \xo 10:4 \xt LUK 6:15; JHN 6:71; JHN 12:4; MRK 14:10; JHN 13:2; MRK 3:19\x*
\v 5 \w A estes|strong="G3778"\w* \w doze|strong="G3588,G1427"\w* \w enviou|strong="G649"\w* \w Jesus|strong="G3588,G2424"\w*, \w tendo-lhes ordenado|strong="G3853,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Não|strong="G3361"\w* \w vão|strong="G565"\w* \w pelo caminho|strong="G1519,G3598"\w* \w dos gentios|strong="G1484"\w*, \w e|strong="G2532"\w* \w não|strong="G3361"\w* \w entrem|strong="G1525"\w* \w em cidade|strong="G1519,G4172"\w* \w de samaritanos|strong="G4541"\w*;\x - \xo 10:5 \xt LUK 9:52; MAT 15:24; MRK 16:15; LUK 9:1; JHN 4:9; ACT 22:21-23\x*
\v 6 \w mas|strong="G1161"\w* \w vão|strong="G4198"\w* \w antes|strong="G3123"\w* \w às ovelhas|strong="G4314,G3588,G4263"\w* \w perdidas|strong="G3588,G622"\w* \w da casa|strong="G3624"\w* \w de Israel|strong="G2474"\w*;\f + \fr 10.6: \ft Nota cultural: “as ovelhas perdidas da casa de Israel” ecoa Jr 50:6 e Ez 34.\f*\x - \xo 10:6 \xt JER 50:6; MAT 15:24; LUK 19:10; MRK 16:15; EZK 34:6; 1PE 2:25\x*
\v 7 \w E indo|strong="G4198,G1161"\w*, \w proclamem|strong="G2784"\w*, \w dizendo|strong="G3004"\w*: ‘\w O reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w se aproximou|strong="G1448"\w*.’\x - \xo 10:7 \xt MAT 4:17; MAT 3:2; ACT 28:31; LUK 10:9; MRK 1:15; LUK 9:2\x*
\v 8 \w Curem|strong="G2323"\w* \w enfermos|strong="G770"\w*, \w ressuscitem|strong="G1453"\w* \w mortos|strong="G3498"\w*, \w purifiquem|strong="G2511"\w* \w leprosos|strong="G3015"\w*, \w expulsem|strong="G1544"\w* \w demônios|strong="G1140"\w*; \w de graça|strong="G1432"\w* \w receberam|strong="G2983"\w*, \w de graça|strong="G1432"\w* \w deem|strong="G1325"\w*.\x - \xo 10:8 \xt ACT 20:35; ACT 3:6; LUK 10:9; ACT 4:30; MAT 10:1; ACT 20:33-35\x*
\v 9 \w Não|strong="G3361"\w* \w adquiram|strong="G2932"\w* \w ouro|strong="G5557"\w*, \w nem|strong="G3366"\w* \w prata|strong="G696"\w*, \w nem|strong="G3366"\w* \w cobre|strong="G5475"\w* \w para os cintos|strong="G1519,G3588,G2223"\w* \w de vocês|strong="G4771"\w*,\x - \xo 10:9 \xt MRK 6:8; ACT 3:6; LUK 22:35; LUK 9:3; LUK 10:4; MRK 6:7\x*
\v 10 \w nem|strong="G3361"\w* \w bolsa|strong="G4082"\w* \w para o caminho|strong="G1519,G3598"\w*, \w nem|strong="G3366"\w* \w duas túnicas|strong="G1417,G5509"\w*, \w nem|strong="G3366"\w* \w sandálias|strong="G5266"\w*, \w nem|strong="G3366"\w* \w cajado|strong="G4464"\w*; \w pois|strong="G1063"\w* \w digno|strong="G514"\w* \w é o trabalhador|strong="G3588,G2040"\w* \w do seu sustento|strong="G3588,G5160,G846"\w*.\f + \fr 10.10: \ft Acréscimo: verbo ser/estar suprido em “é o trabalhador”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:10 \xt LUK 9:3; LUK 10:4; MRK 6:8; 1CO 9:14; GAL 6:6; 1TI 5:18\x*
\v 11 \w Em qualquer|strong="G1519,G3739,G1161,G302"\w* \w cidade|strong="G4172"\w* \w ou|strong="G2228"\w* \w aldeia|strong="G2968"\w* \w em que entrarem|strong="G1525"\w*, \w procurem saber|strong="G1833"\w* \w quem|strong="G5101"\w* \w nela|strong="G1722,G846"\w* \w é|strong="G1510"\w* \w digno|strong="G514"\w*; \w e ali|strong="G1563,G2532"\w* \w permaneçam|strong="G3306"\w* \w até que|strong="G2193,G302"\w* \w saiam|strong="G1831"\w*.\x - \xo 10:11 \xt LUK 9:4; MRK 6:10; LUK 10:7; LUK 9:3; 1KI 17:9-24; ACT 18:1-3\x*
\v 12 \w E ao entrarem|strong="G1525,G1161"\w* \w na casa|strong="G1519,G3588,G3614"\w*, \w saúdem-na|strong="G782,G846"\w*;\x - \xo 10:12 \xt LUK 10:5; MRK 6:10; PHP 4:22; EZK 2:5; 1SA 25:6; LUK 9:3\x*
\v 13 \w e|strong="G2532"\w* \w se|strong="G1437,G3303"\w* \w a casa|strong="G3588,G3614"\w* \w for|strong="G1510"\w* \w digna|strong="G514"\w*, \w venha|strong="G2064"\w* \w sobre ela|strong="G1909,G846"\w* \w a paz|strong="G3588,G1515"\w* \w de vocês|strong="G4771"\w*; \w mas|strong="G1161"\w* \w se|strong="G1437"\w* \w não|strong="G3361"\w* \w for|strong="G1510"\w* \w digna|strong="G514"\w*, \w a paz|strong="G3588,G1515"\w* \w de vocês|strong="G4771"\w* \w volte|strong="G1994"\w* \w para vocês|strong="G4314,G4771"\w*.\x - \xo 10:13 \xt LUK 10:5; ECC 11:1; EZK 2:5; LUK 10:6; LUK 9:3; PRO 25:22\x*
\v 14 \w E|strong="G2532"\w* \w quem|strong="G3739,G302"\w* \w não|strong="G3361"\w* \w os receber|strong="G1209,G4771"\w* \w nem|strong="G3366"\w* \w ouvir|strong="G191"\w* \w as suas palavras|strong="G3588,G3056,G4771"\w*, \w ao saírem|strong="G1831"\w* \w fora|strong="G1854"\w* \w da casa|strong="G3588,G3614"\w* \w ou|strong="G2228"\w* \w daquela cidade|strong="G3588,G4172,G1565"\w*, \w sacudam|strong="G1621"\w* \w o pó|strong="G3588,G2868"\w* \w dos seus pés|strong="G3588,G4228,G4771"\w*.\f + \fr 10.14: \ft Nota cultural: sacudir o pó dos pés é gesto de rejeição, usado para separar-se de um lugar considerado impuro.\f*\x - \xo 10:14 \xt ACT 13:51; LUK 9:5; MRK 6:11; LUK 10:10; MAT 7:6; ACT 18:6\x*
\v 15 \w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w*: \w mais suportável|strong="G414"\w* \w será|strong="G1510"\w* \w para a terra|strong="G1093"\w* \w de Sodoma|strong="G4670"\w* \w e|strong="G2532"\w* \w Gomorra|strong="G1116"\w* \w no dia|strong="G1722,G2250"\w* \w do juízo|strong="G2920"\w* \w do que|strong="G2228"\w* \w para aquela cidade|strong="G3588,G4172,G1565"\w*.\x - \xo 10:15 \xt LUK 10:12; MAT 11:24; 2PE 2:6; MAT 11:22; MAT 7:6; LUK 9:5\x*
\p
\v 16 \w Olhem|strong="G2400"\w*, \w eu|strong="G1473"\w* \w os envio|strong="G649,G4771"\w* \w como ovelhas|strong="G5613,G4263"\w* \w no meio|strong="G1722,G3319"\w* \w de lobos|strong="G3074"\w*; \w sejam|strong="G1096"\w*, \w pois|strong="G3767"\w*, \w prudentes|strong="G5429"\w* \w como as serpentes|strong="G5613,G3588,G3789"\w* \w e|strong="G2532"\w* \w simples|strong="G185"\w* \w como as pombas|strong="G5613,G3588,G4058"\w*.\f + \fr 10.16: \ft Lit.: ἀκέραιος, “sem mistura, simples, íntegro”.\f*\x - \xo 10:16 \xt LUK 10:3; PHP 2:15; 1CO 14:20; COL 4:5; EPH 5:15; ROM 16:19\x*
\v 17 \w E cuidado|strong="G4337,G1161"\w* \w com os seres humanos|strong="G575,G3588,G444"\w*; \w pois|strong="G1063"\w* \w os entregarão|strong="G3860,G4771"\w* \w a tribunais|strong="G1519,G4892"\w* \w e|strong="G2532"\w* \w nas sinagogas|strong="G1722,G3588,G4864"\w* \w deles|strong="G846"\w* \w os açoitarão|strong="G3146,G4771"\w*;\x - \xo 10:17 \xt MRK 13:9; MAT 23:34; MAT 24:9; ACT 12:1; LUK 12:11; 1TH 3:3\x*
\v 18 \w e|strong="G2532"\w* \w diante de governadores|strong="G1909,G2232"\w* \w e|strong="G1161,G2532"\w* \w reis|strong="G935"\w* \w serão levados|strong="G71"\w* \w por causa de mim|strong="G1752,G1473"\w*, \w como testemunho|strong="G1519,G3142"\w* \w a eles|strong="G846"\w* \w e|strong="G2532"\w* \w aos gentios|strong="G3588,G1484"\w*.\x - \xo 10:18 \xt MRK 13:9; MAT 27:11; 1PE 3:15; MAT 24:9; MAT 5:11; ACT 12:1\x*
\v 19 \w Mas quando|strong="G3752,G1161"\w* \w os entregarem|strong="G3860,G4771"\w*, \w não|strong="G3361"\w* \w se preocupem|strong="G3309"\w* \w como|strong="G4459"\w* \w ou|strong="G2228"\w* \w o que|strong="G5101"\w* \w falarão|strong="G2980"\w*; \w pois|strong="G1063"\w* \w será dado|strong="G1325"\w* \w a vocês|strong="G4771"\w* \w naquela hora|strong="G1722,G1565,G3588,G5610"\w* \w o que|strong="G5101"\w* \w falarão|strong="G2980"\w*;\x - \xo 10:19 \xt MRK 13:11; LUK 12:11; PHP 4:6; JER 1:9; 2CO 12:9; 1PE 3:15\x*
\v 20 \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w são|strong="G1510"\w* \w vocês|strong="G4771"\w* \w os que falam|strong="G3588,G2980"\w*, \w mas|strong="G235"\w* \w o Espírito|strong="G3588,G4151"\w* \w do Pai|strong="G3588,G3962"\w* \w de vocês|strong="G4771"\w*, \w que fala|strong="G3588,G2980"\w* \w em vocês|strong="G1722,G4771"\w*.\x - \xo 10:20 \xt ROM 8:26; 2CO 12:9; 1PE 3:15; 2SA 23:2; ACT 6:10; LUK 21:15\x*
\v 21 \w E o irmão|strong="G1161,G80"\w* \w entregará|strong="G3860"\w* \w o irmão|strong="G80"\w* \w à morte|strong="G1519,G2288"\w*, \w e|strong="G2532"\w* \w o pai|strong="G3962"\w* \w o filho|strong="G5043"\w*, \w e|strong="G2532"\w* \w os filhos|strong="G5043"\w* \w se levantarão|strong="G1881"\w* \w contra os pais|strong="G1909,G1118"\w* \w e|strong="G2532"\w* \w os matarão|strong="G2289,G846"\w*.\f + \fr 10.21: \ft Nota cultural: ecoa Mq 7:6.\f*\x - \xo 10:21 \xt MIC 7:6; MRK 13:12; LUK 21:16; MAT 24:9; MAT 10:35; MRK 13:11\x*
\v 22 \w E|strong="G2532"\w* \w serão odiados|strong="G1510,G3404"\w* \w por todos|strong="G5259,G3956"\w* \w por causa do meu nome|strong="G1223,G3588,G3686,G3165"\w*; \w mas|strong="G1161"\w* \w quem perseverar|strong="G3588,G5278"\w* \w até o fim|strong="G1519,G5056"\w*, \w este|strong="G3778"\w* \w será salvo|strong="G4982"\w*.\x - \xo 10:22 \xt MRK 13:13; MAT 24:13; LUK 21:17; MAT 24:9; GAL 6:9; JAS 5:11\x*
\v 23 \w Mas quando|strong="G3752,G1161"\w* \w os perseguirem|strong="G1377,G4771"\w* \w nesta cidade|strong="G1722,G3588,G4172,G3778"\w*, \w fujam|strong="G5343"\w* \w para a outra|strong="G1519,G3588,G2087"\w*; \w pois em verdade|strong="G281,G1063"\w* \w lhes digo|strong="G3004,G4771"\w*: \w de modo algum|strong="G3756,G3361"\w* \w terão terminado de percorrer|strong="G5055"\w* \w as cidades|strong="G3588,G4172"\w* \w de Israel|strong="G3588,G2474"\w* \w até que|strong="G2193,G302"\w* \w venha|strong="G2064"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w*.\f + \fr 10.23: \ft Nota cultural: a frase é de interpretação discutida (a vinda do Filho do Homem pode referir-se à ressurreição, à destruição de Jerusalém ou à volta final).\f*\x - \xo 10:23 \xt MAT 16:28; MAT 5:10; MAT 2:13; JHN 7:1; ACT 8:4; ACT 17:14\x*
\p
\v 24 \w Não|strong="G3756"\w* \w há|strong="G1510"\w* \w discípulo|strong="G3101"\w* \w acima|strong="G5228"\w* \w do mestre|strong="G3588,G1320"\w*, \w nem|strong="G3761"\w* \w escravo|strong="G1401"\w* \w acima|strong="G5228"\w* \w do seu senhor|strong="G3588,G2962,G846"\w*.\x - \xo 10:24 \xt LUK 6:40; JHN 13:16; JHN 15:20; HEB 12:2-4; HEB 12:3; 1SA 8:7\x*
\v 25 \w Basta|strong="G713"\w* \w ao discípulo|strong="G3588,G3101"\w* \w que seja|strong="G2443,G1096"\w* \w como|strong="G5613"\w* \w o seu mestre|strong="G3588,G1320,G846"\w*, \w e|strong="G2532"\w* \w ao escravo|strong="G3588,G1401"\w* \w como|strong="G5613"\w* \w o seu senhor|strong="G3588,G2962,G846"\w*. \w Se|strong="G1487"\w* \w ao dono da casa|strong="G3588,G3617"\w* \w chamaram|strong="G1941"\w* \w Belzebu|strong="G954"\w*, \w quanto mais|strong="G4214,G3123"\w* \w os da sua casa|strong="G3588,G3615,G846"\w*!\f + \fr 10.25: \ft Lit.: Βεελζεβούλ, nome de Satanás como chefe dos demônios (cf. 12:24); a origem do nome é discutida (Baal-zebul, “Baal príncipe”, ou Baal-zebub, “senhor das moscas”, 2Rs 1:2).\f*\x - \xo 10:25 \xt 2KI 1:2; MAT 5:11; LUK 6:40; 1PE 2:12; JHN 13:16; HEB 12:3\x*
\v 26 \w Portanto|strong="G3767"\w*, \w não|strong="G3361"\w* \w os temam|strong="G5399,G846"\w*; \w pois|strong="G1063"\w* \w nada|strong="G3762"\w* \w há|strong="G1510"\w* \w encoberto|strong="G2572"\w* \w que não|strong="G3739,G3756"\w* \w será revelado|strong="G601"\w*, \w e|strong="G2532"\w* \w oculto|strong="G2927"\w* \w que não|strong="G3739,G3756"\w* \w será conhecido|strong="G1097"\w*.\x - \xo 10:26 \xt LUK 12:2; LUK 8:17; ECC 12:14; MRK 4:22; JER 1:8; JHN 14:27\x*
\v 27 \w O que|strong="G3739"\w* \w lhes digo|strong="G3004,G4771"\w* \w na escuridão|strong="G1722,G3588,G4653"\w*, \w digam|strong="G2036"\w* \w na luz|strong="G1722,G3588,G5457"\w*; \w e|strong="G2532"\w* \w o que|strong="G3739"\w* \w ao ouvido|strong="G1519,G3588,G3775"\w* \w ouvem|strong="G191"\w*, \w proclamem|strong="G2784"\w* \w sobre os terraços|strong="G1909,G3588,G1430"\w*.\x - \xo 10:27 \xt LUK 12:3; ACT 5:20; LUK 12:2; JHN 16:13; JHN 16:1; MRK 4:22\x*
\v 28 \w E|strong="G2532"\w* \w não|strong="G3361"\w* \w temam|strong="G5399"\w* \w os que matam|strong="G575,G3588,G615"\w* \w o corpo|strong="G3588,G4983"\w*, \w mas|strong="G1161"\w* \w não podem|strong="G3361,G1410"\w* \w matar|strong="G615"\w* \w a alma|strong="G3588,G5590"\w*; \w temam|strong="G5399"\w* \w antes|strong="G1161,G3123"\w* \w aquele que pode|strong="G3588,G1410"\w* \w destruir|strong="G622"\w* \w tanto|strong="G2532"\w* \w a alma|strong="G5590"\w* \w quanto|strong="G2532"\w* \w o corpo|strong="G4983"\w* \w na geena|strong="G1722,G1067"\w*.\x - \xo 10:28 \xt LUK 12:4; LUK 12:5; HEB 13:6; MAT 5:29; ISA 8:12-13; REV 2:10\x*
\v 29 \w Não|strong="G3780"\w* \w se vendem|strong="G4453"\w* \w dois pardais|strong="G1417,G4765"\w* \w por um asse|strong="G787"\w*? \w E|strong="G2532"\w* \w nenhum|strong="G1520,G3756"\w* \w deles|strong="G1537,G846"\w* \w cairá|strong="G4098"\w* \w à terra|strong="G1909,G3588,G1093"\w* \w sem o Pai|strong="G427,G3588,G3962"\w* \w de vocês|strong="G4771"\w*.\f + \fr 10.29: \ft Lit.: ἀσσάριον, “asse”, moeda romana de cobre de pouco valor (1/16 de um denário).\f*\x - \xo 10:29 \xt LUK 12:6; MAT 6:26; PSA 104:27-30; ROM 8:35; LUK 12:2; GEN 15:1\x*
\v 30 \w E até|strong="G1161,G2532"\w* \w os cabelos|strong="G3588,G2359"\w* \w da cabeça|strong="G3588,G2776"\w* \w de vocês|strong="G4771"\w* \w estão|strong="G1510"\w* \w todos|strong="G3956"\w* \w contados|strong="G705"\w*.\x - \xo 10:30 \xt LUK 12:7; LUK 21:18; ACT 27:34; MAT 6:26; PSA 56:8; ROM 8:35\x*
\v 31 \w Portanto|strong="G3767"\w*, \w não|strong="G3361"\w* \w temam|strong="G5399"\w*; \w vocês|strong="G4771"\w* \w valem mais|strong="G1308"\w* \w do que muitos|strong="G4183"\w* \w pardais|strong="G4765"\w*.\x - \xo 10:31 \xt LUK 12:7; MAT 6:26; ROM 8:35; LUK 12:2; GEN 15:1; LUK 12:24\x*
\v 32 \w Todo aquele|strong="G3956,G3748"\w*, \w pois|strong="G3767"\w*, \w que me confessar|strong="G3670,G1722,G1473"\w* \w diante dos seres humanos|strong="G1715,G3588,G444"\w*, \w eu também|strong="G2532,G1473"\w* \w o confessarei|strong="G3670,G1722,G846"\w* \w diante do meu Pai|strong="G1715,G3588,G3962,G3165"\w*, \w que está|strong="G3588,G1722"\w* \w nos céus|strong="G3772"\w*;\f + \fr 10.32: \ft Acréscimo: “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 10:32 \xt LUK 12:8; ROM 10:9; LUK 9:26; MAT 7:21; REV 3:5; 1JN 4:15\x*
\v 33 \w mas|strong="G1161"\w* \w quem|strong="G3748,G302"\w* \w me negar|strong="G720,G3165"\w* \w diante dos seres humanos|strong="G1715,G3588,G444"\w*, \w eu também|strong="G2532,G1473"\w* \w o negarei|strong="G720,G846"\w* \w diante do meu Pai|strong="G1715,G3588,G3962,G3165"\w*, \w que está|strong="G3588,G1722"\w* \w nos céus|strong="G3772"\w*.\f + \fr 10.33: \ft Acréscimo: “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 10:33 \xt MAT 26:70; LUK 12:8; ROM 10:9; LUK 9:26; MAT 7:21; 2TI 2:12\x*
\p
\v 34 \w Não|strong="G3361"\w* \w pensem|strong="G3543"\w* \w que|strong="G3754"\w* \w vim|strong="G2064"\w* \w trazer paz|strong="G906,G1515"\w* \w à terra|strong="G1909,G3588,G1093"\w*; \w não|strong="G3756"\w* \w vim|strong="G2064"\w* \w trazer paz|strong="G906,G1515"\w*, \w mas|strong="G235"\w* \w espada|strong="G3162"\w*.\x - \xo 10:34 \xt REV 6:4; LUK 12:49-53; LUK 12:51; ACT 14:4; ACT 13:45-50; ACT 14:2\x*
\v 35 \w Pois|strong="G1063"\w* \w vim|strong="G2064"\w* \w para pôr em divisão|strong="G1369"\w* \w o ser humano|strong="G444"\w* \w contra o seu pai|strong="G2596,G3588,G3962,G846"\w*, \w e|strong="G2532"\w* \w a filha|strong="G2364"\w* \w contra a sua mãe|strong="G2596,G3588,G3384,G846"\w*, \w e|strong="G2532"\w* \w a nora|strong="G3565"\w* \w contra a sua sogra|strong="G2596,G3588,G3994,G846"\w*;\f + \fr 10.35: \ft Nota cultural: cita Mq 7:6.\f*\x - \xo 10:35 \xt MIC 7:6; LUK 12:53; MIC 7:5-6; LUK 12:51; MAT 10:21; LUK 21:16\x*
\v 36 \w e|strong="G2532"\w* \w os inimigos|strong="G2190"\w* \w do ser humano|strong="G3588,G444"\w* \add serão\add* \w os da sua casa|strong="G3588,G3615,G846"\w*.\f + \fr 10.36: \ft Acréscimo: “serão” (em “ser humano serão os da”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 10:36 \xt MIC 7:6; LUK 12:51; JER 12:6; PSA 41:9; PSA 27:10; GEN 4:8-10\x*
\v 37 \w Quem ama|strong="G3588,G5368"\w* \w pai|strong="G3962"\w* \w ou|strong="G2228"\w* \w mãe|strong="G3384"\w* \w mais do que|strong="G5228"\w* \w a mim|strong="G1473"\w* \w não é|strong="G3756,G1510"\w* \w digno|strong="G514"\w* \w de mim|strong="G3165"\w*; \w e|strong="G2532"\w* \w quem ama|strong="G3588,G5368"\w* \w filho|strong="G5207"\w* \w ou|strong="G2228"\w* \w filha|strong="G2364"\w* \w mais do que|strong="G5228"\w* \w a mim|strong="G1473"\w* \w não é|strong="G3756,G1510"\w* \w digno|strong="G514"\w* \w de mim|strong="G3165"\w*;\x - \xo 10:37 \xt LUK 14:26; JHN 14:15; MAT 19:29; DEU 6:5; HEB 12:1; MAT 22:37\x*
\v 38 \w e|strong="G2532"\w* \w quem|strong="G3739"\w* \w não toma|strong="G3756,G2983"\w* \w a sua cruz|strong="G3588,G4716,G846"\w* \w e|strong="G2532"\w* \w me segue|strong="G190,G3694,G3165"\w*, \w não é|strong="G3756,G1510"\w* \w digno|strong="G514"\w* \w de mim|strong="G3165"\w*.\f + \fr 10.38: \ft Nota cultural: “tomar a cruz” remete ao condenado que carregava o instrumento da sua execução.\f*\x - \xo 10:38 \xt LUK 9:23; MAT 16:24; MRK 8:34; LUK 14:27; MAT 19:29; HEB 12:1\x*
\v 39 \w Quem achar|strong="G3588,G2147"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w a perderá|strong="G622,G846"\w*, \w e|strong="G2532"\w* \w quem perder|strong="G3588,G622"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w por causa de mim|strong="G1752,G1473"\w* \w a achará|strong="G2147,G846"\w*.\x - \xo 10:39 \xt MAT 16:25; MRK 8:35; LUK 9:24; LUK 9:23; JHN 12:25; LUK 17:33\x*
\p
\v 40 \w Quem recebe|strong="G3588,G1209"\w* \w vocês|strong="G4771"\w*, \w recebe|strong="G1209"\w* \w a mim|strong="G1473"\w*; \w e|strong="G2532"\w* \w quem recebe|strong="G3588,G1209"\w* \w a mim|strong="G1473"\w*, \w recebe|strong="G1209"\w* \w aquele que me enviou|strong="G3588,G649,G3165"\w*.\x - \xo 10:40 \xt MRK 9:37; LUK 9:48; ACT 8:14; JHN 1:12; 1CO 15:58; MAT 25:40\x*
\v 41 \w Quem recebe|strong="G3588,G1209"\w* \w um profeta|strong="G4396"\w* \w em nome|strong="G1519,G3686"\w* \w de profeta|strong="G4396"\w* \w receberá|strong="G2983"\w* \w recompensa|strong="G3408"\w* \w de profeta|strong="G4396"\w*, \w e|strong="G2532"\w* \w quem recebe|strong="G3588,G1209"\w* \w um justo|strong="G1342"\w* \w em nome|strong="G1519,G3686"\w* \w de justo|strong="G1342"\w* \w receberá|strong="G2983"\w* \w recompensa|strong="G3408"\w* \w de justo|strong="G1342"\w*.\x - \xo 10:41 \xt MRK 9:37; MAT 18:5; MAT 5:12; 1CO 15:58; HEB 11:6; PRO 19:17\x*
\v 42 \w E|strong="G2532"\w* \w quem|strong="G3739,G302"\w* \w der de beber|strong="G4222"\w* \w a um|strong="G1520"\w* \w destes pequeninos|strong="G3588,G3398,G3778"\w*, \w um copo|strong="G4221"\w* \w de água fria|strong="G5593"\w* \w somente|strong="G3440"\w*, \w em nome|strong="G1519,G3686"\w* \w de discípulo|strong="G3101"\w*, \w em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w*: \w de modo algum|strong="G3756,G3361"\w* \w perderá|strong="G622"\w* \w a sua recompensa|strong="G3588,G3408,G846"\w*.”\x - \xo 10:42 \xt MRK 9:41; MAT 25:40; HEB 6:10; LUK 6:38; 1CO 15:58; HEB 11:6\x*
\c 11
\p
\v 1 \w E|strong="G2532"\w* \w aconteceu que|strong="G1096"\w*, \w quando|strong="G3753"\w* \w Jesus|strong="G3588,G2424"\w* \w terminou|strong="G5055"\w* \w de dar instruções|strong="G1299"\w* \w aos seus|strong="G846"\w* \w doze|strong="G3588,G1427"\w* \w discípulos|strong="G3101"\w*, \w partiu|strong="G3327"\w* \w dali|strong="G1564"\w* \w para ensinar|strong="G3588,G1321"\w* \w e|strong="G2532"\w* \w proclamar|strong="G2784"\w* \w nas cidades|strong="G1722,G3588,G4172"\w* \w deles|strong="G846"\w*.\x - \xo 11:1 \xt ISA 61:1-3; ACT 10:38; LUK 4:15-21; LUK 8:1; MAT 10:7; MAT 9:35\x*
\p
\v 2 \w E João|strong="G3588,G1161,G2491"\w*, \w ao ouvir|strong="G191"\w* \w na prisão|strong="G1722,G3588,G1201"\w* \w as obras|strong="G3588,G2041"\w* \w do Cristo|strong="G3588,G5547"\w*, \w enviando|strong="G3992"\w* \w pelos seus discípulos|strong="G1223,G3588,G3101,G846"\w*\f + \fr 11.2: \ft Variante: o RP traz “dois” (δύο) em lugar de “por meio de” (διά): “enviou dois dos seus discípulos”.\f*\x - \xo 11:2 \xt MRK 6:17; MAT 14:3; MRK 9:12; LUK 7:18; MAT 4:12; MAT 9:14\x*
\v 3 \w disse-lhe|strong="G2036,G846"\w*: “\w Você|strong="G4771"\w* \w é|strong="G1510"\w* \w o que vem|strong="G3588,G2064"\w*, \w ou|strong="G2228"\w* \w esperamos|strong="G4328"\w* \w outro|strong="G2087"\w*?”\f + \fr 11.3: \ft Nota cultural: “o que vem” é título do Messias (Sl 118:26; Hc 2:3).\f*\x - \xo 11:3 \xt PSA 118:26; HAB 2:3; ISA 35:5; HEB 10:5; JHN 6:14; MRK 9:12\x*
\v 4 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w disse-lhes|strong="G2036,G846"\w*: “\w Vão|strong="G4198"\w* \w e anunciem|strong="G518"\w* \w a João|strong="G2491"\w* \w o que|strong="G3739"\w* \w ouvem|strong="G191"\w* \w e|strong="G2532"\w* \w veem|strong="G991"\w*:\x - \xo 11:4 \xt ISA 35:5; MAT 8:3; MRK 9:12; JHN 5:36; ACT 19:4; ACT 2:22\x*
\v 5 \w cegos|strong="G5185"\w* \w recuperam a vista|strong="G308"\w* \w e|strong="G2532"\w* \w coxos|strong="G5560"\w* \w andam|strong="G4043"\w*, \w leprosos|strong="G3015"\w* \w são purificados|strong="G2511"\w* \w e|strong="G2532"\w* \w surdos|strong="G2974"\w* \w ouvem|strong="G191"\w*, \w e|strong="G2532"\w* \w mortos|strong="G3498"\w* \w são ressuscitados|strong="G1453"\w*, \w e|strong="G2532"\w* \w aos pobres|strong="G4434"\w* \w é anunciada a boa notícia|strong="G2097"\w*;\f + \fr 11.5: \ft Nota cultural: as obras do Messias cumprem Is 35:5-6 e 61:1.\f*\x - \xo 11:5 \xt ISA 61:1; ISA 35:5; LUK 7:22; LUK 4:18; ISA 35:4-6; MAT 15:30\x*
\v 6 \w e|strong="G2532"\w* \w feliz|strong="G3107"\w* \w é|strong="G1510"\w* \w quem|strong="G3739,G1437"\w* \w não|strong="G3361"\w* \w se escandalizar|strong="G4624"\w* \w por causa de mim|strong="G1722,G1473"\w*.”\f + \fr 11.6: \ft Lit.: σκανδαλίζω, “fazer tropeçar, escandalizar”; aqui, tropeçar na fé por causa de Jesus.\f*\x - \xo 11:6 \xt LUK 7:23; 1CO 2:14; ISA 8:14-15; MAT 13:21; MAT 5:3; MAT 26:31\x*
\p
\v 7 \w Enquanto eles se retiravam|strong="G3778,G1161,G4198"\w*, \w começou|strong="G757"\w* \w Jesus|strong="G3588,G2424"\w* \w a falar|strong="G3004"\w* \w às multidões|strong="G3588,G3793"\w* \w a respeito de João|strong="G4012,G2491"\w*: “\w O que|strong="G5101"\w* \w vocês saíram|strong="G1831"\w* \w ao deserto|strong="G1519,G3588,G2048"\w* \w para ver|strong="G2300"\w*? \w Um caniço|strong="G2563"\w* \w agitado|strong="G4531"\w* \w pelo vento|strong="G5259,G417"\w*?\x - \xo 11:7 \xt LUK 7:24; JAS 1:6; MRK 9:12; JHN 5:35; LUK 8:18; EPH 4:14\x*
\v 8 \w Mas|strong="G235"\w* \w o que|strong="G5101"\w* \w vocês saíram|strong="G1831"\w* \w para ver|strong="G1492"\w*? \w Um homem|strong="G444"\w* \w vestido|strong="G294"\w* \w de roupas macias|strong="G1722,G3120"\w*? \w Olhem|strong="G2400"\w*, \w os que vestem|strong="G3588,G5409"\w* \w roupas macias|strong="G3120"\w* \w estão|strong="G1510"\w* \w nas casas|strong="G1722,G3588,G3624"\w* \w dos reis|strong="G3588,G935"\w*.\x - \xo 11:8 \xt LUK 7:25; MAT 3:4; MRK 9:12; 2KI 1:8; EST 8:15; EST 5:1\x*
\v 9 \w Mas|strong="G235"\w* \w o que|strong="G5101"\w* \w vocês saíram|strong="G1831"\w*? \w Um profeta|strong="G4396"\w* \w para ver|strong="G1492"\w*? \w Sim|strong="G3483"\w*, \w lhes digo|strong="G3004,G4771"\w*, \w e|strong="G2532"\w* \w mais do que|strong="G4055"\w* \w profeta|strong="G4396"\w*.\x - \xo 11:9 \xt LUK 7:26; LUK 16:16; JHN 1:21; MRK 9:12; LUK 1:76; MAT 14:5\x*
\v 10 \w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w aquele de quem|strong="G4012,G3739"\w* \w está escrito|strong="G1125"\w*: ‘\w Olhem|strong="G2400"\w*, \w eu|strong="G1473"\w* \w envio|strong="G649"\w* \w o meu mensageiro|strong="G3588,G32,G3165"\w* \w diante da sua face|strong="G4253,G4383,G4771"\w*, \w o qual|strong="G3739"\w* \w preparará|strong="G2680"\w* \w o seu caminho|strong="G3588,G3598,G4771"\w* \w diante de você|strong="G1715,G4771"\w*.’\f + \fr 11.10: \ft Lit.: ἄγγελος, “mensageiro, anjo”.\f*\f + \fr 11.10: \ft Nota cultural: cita Ml 3:1 combinado com Êx 23:20; João é o mensageiro que prepara o caminho.\f*\x - \xo 11:10 \xt MAL 3:1; EXO 23:20; LUK 7:27; MRK 1:2; ISA 40:3; MAL 4:5\x*
\v 11 \w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w*: \w entre os nascidos|strong="G1722,G1084"\w* \w de mulheres|strong="G1135"\w* \w não|strong="G3756"\w* \w surgiu|strong="G1453"\w* \w ninguém maior|strong="G3173"\w* \w do que João|strong="G2491"\w*, \w o Batista|strong="G3588,G910"\w*; \w mas|strong="G1161"\w* \w o menor|strong="G3588,G3398"\w* \w no reino|strong="G1722,G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w é maior|strong="G3173,G1510"\w* \w do que ele|strong="G846"\w*.\f + \fr 11.11: \ft Tradução: ἐγήγερται (ἐγείρω, G1453) está aqui como “surgiu”; o termo pode ser “levantar”, “ressuscitar”, “despertar” ou “erguer”, e o contexto decide.\f*\x - \xo 11:11 \xt LUK 7:28; MAT 3:1; LUK 16:16; JOB 14:1; MAT 5:19; MAL 3:1\x*
\v 12 \w E desde|strong="G575,G1161"\w* \w os dias|strong="G3588,G2250"\w* \w de João|strong="G2491"\w*, \w o Batista|strong="G3588,G910"\w*, \w até|strong="G2193"\w* \w agora|strong="G737"\w*, \w o reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w sofre violência|strong="G971"\w*, \w e|strong="G2532"\w* \w os violentos|strong="G973"\w* \w o arrebatam|strong="G726,G846"\w*.\f + \fr 11.12: \ft Lit.: βιάζομαι pode ser voz média (“o reino avança com força”) ou passiva (“o reino sofre violência”); a frase é debatida.\f*\x - \xo 11:12 \xt LUK 16:16; LUK 13:24; EPH 6:11-13; PHP 2:12; JHN 6:27; LUK 7:29-30\x*
\v 13 \w Pois|strong="G1063"\w* \w todos|strong="G3956"\w* \w os Profetas|strong="G3588,G4396"\w* \w e|strong="G2532"\w* \w a Lei|strong="G3588,G3551"\w* \w profetizaram|strong="G4395"\w* \w até João|strong="G2193,G2491"\w*;\x - \xo 11:13 \xt LUK 16:16; MAL 4:5; MAT 5:17-18; MRK 9:12; ROM 3:21; ACT 13:27\x*
\v 14 \w e|strong="G2532"\w* \w se|strong="G1487"\w* \w quiserem|strong="G2309"\w* \w aceitar|strong="G1209"\w*, \w ele|strong="G846"\w* \w é|strong="G1510"\w* \w Elias|strong="G2243"\w*, \w o que|strong="G3588"\w* \w há de|strong="G3195"\w* \w vir|strong="G2064"\w*.\f + \fr 11.14: \ft Nota cultural: ecoa Ml 3:23 (4:5), a volta de Elias antes do dia do Senhor.\f*\x - \xo 11:14 \xt MAL 3:23; MRK 9:13; LUK 1:17; MAL 4:5; MRK 9:11; LUK 16:16\x*
\v 15 \w Quem tem|strong="G3588,G2192"\w* \w ouvidos|strong="G3775"\w*, \w ouça|strong="G191"\w*.\x - \xo 11:15 \xt REV 2:7; MAT 13:9; LUK 8:8; MRK 4:23; MAT 13:43; MRK 4:9\x*
\p
\v 16 \w A quem|strong="G5101"\w* \w compararei|strong="G3666"\w* \w esta geração|strong="G3588,G1074,G3778"\w*? \w É semelhante|strong="G3664,G1510"\w* \w a meninos|strong="G3813"\w* \w sentados|strong="G2521"\w* \w nas praças|strong="G1722,G3588,G58"\w*, \w que gritam|strong="G3739,G4377"\w* \w aos outros|strong="G3588,G2087"\w*\f + \fr 11.16: \ft Variante: o RP traz “sentados nas praças e dizendo aos companheiros” (ἐν ἀγοραῖς καθημένοις καὶ προσφωνοῦσιν τοῖς ἑταίροις) em lugar de “sentados nas praças, que gritam aos outros”.\f*\x - \xo 11:16 \xt LUK 7:31; LUK 7:32; LUK 13:18; MRK 9:12; LAM 2:13; MRK 4:30\x*
\v 17 \add e\add* \w dizem|strong="G3004"\w*: ‘\w Tocamos flauta|strong="G832"\w* \w para vocês|strong="G4771"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w dançaram|strong="G3738"\w*; \w entoamos lamento|strong="G2354"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w bateram no peito|strong="G2875"\w*.’\f + \fr 11.17: \ft Acréscimo: “e” (em “e dizem Tocamos”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 11:17 \xt LUK 7:32; LUK 23:27; ECC 3:4; ISA 28:9-13; MRK 9:12; LUK 7:31\x*
\v 18 \w Pois|strong="G1063"\w* \w veio|strong="G2064"\w* \w João|strong="G2491"\w*, \w sem|strong="G3383"\w* \w comer|strong="G2068"\w* \w nem|strong="G3383"\w* \w beber|strong="G4095"\w*, \w e|strong="G2532"\w* \w dizem|strong="G3004"\w*: ‘\w Tem|strong="G2192"\w* \w demônio|strong="G1140"\w*.’\x - \xo 11:18 \xt LUK 7:33; LUK 1:15; MAT 3:4; LUK 7:32; MRK 9:12; JHN 10:20\x*
\v 19 \w Veio|strong="G2064"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w*, \w comendo|strong="G2068"\w* \w e|strong="G2532"\w* \w bebendo|strong="G4095"\w*, \w e|strong="G2532"\w* \w dizem|strong="G3004"\w*: ‘\w Olhem|strong="G2400"\w*, \w um homem|strong="G444"\w* \w glutão|strong="G5314"\w* \w e|strong="G2532"\w* \w beberrão|strong="G3630"\w*, \w amigo|strong="G5384"\w* \w de cobradores de impostos|strong="G5057"\w* \w e|strong="G2532"\w* \w pecadores|strong="G268"\w*.’ \w E|strong="G2532"\w* \w a sabedoria|strong="G3588,G4678"\w* \w foi declarada justa|strong="G1344"\w* \w pelas suas obras|strong="G575,G3588,G2041,G846"\w*.”\f + \fr 11.19: \ft Variante: o TR e alguns manuscritos trazem “filhos” (τέκνων) em lugar de “obras” (ἔργων) no fim.\f*\x - \xo 11:19 \xt LUK 7:34; MAT 9:11; LUK 7:35; LUK 15:1; MAT 9:10-11; LUK 19:7\x*
\p
\v 20 \w Então|strong="G5119"\w* \w começou|strong="G757"\w* \w a censurar|strong="G3679"\w* \w as cidades|strong="G3588,G4172"\w* \w nas quais|strong="G1722,G3739"\w* \w se realizaram|strong="G1096"\w* \w a maior parte|strong="G3588,G4118"\w* \w dos seus|strong="G846"\w* \w milagres|strong="G1411"\w*, \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w se arrependeram|strong="G3340"\w*:\f + \fr 11.20: \ft Tradução: δυνάμεις (δύναμις, G1411) está aqui como “milagres”; o termo pode ser “poder”, “força”, “capacidade” ou “milagre”, e o contexto decide.\f*\x - \xo 11:20 \xt JAS 1:5; MAT 9:13; LUK 10:13; 1PE 4:17; 2TI 2:25-26; JER 8:6\x*
\v 21 “\w Ai|strong="G3759"\w* \w de você|strong="G4771"\w*, \w Corazim|strong="G5523"\w*! \w Ai|strong="G3759"\w* \w de você|strong="G4771"\w*, \w Betsaida|strong="G966"\w*! \w Porque|strong="G3754"\w* \w se|strong="G1487"\w* \w em Tiro|strong="G1722,G5184"\w* \w e|strong="G2532"\w* \w Sidom|strong="G4605"\w* \w tivessem sido feitos|strong="G1096"\w* \w os milagres|strong="G3588,G1411"\w* \w que foram feitos|strong="G3588,G1096"\w* \w em vocês|strong="G1722,G4771"\w*, \w há muito|strong="G3819"\w* \w teriam|strong="G302"\w* \w se arrependido|strong="G3340"\w* \w em saco|strong="G1722,G4526"\w* \w e|strong="G2532"\w* \w cinza|strong="G4700"\w*.\f + \fr 11.21: \ft Nota cultural: o saco e a cinza são sinais de luto e arrependimento (Jn 3:5-8).\f*\f + \fr 11.21: \ft Acréscimo: verbo ser/estar suprido em “há muito”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\f + \fr 11.21: \ft Tradução: δυνάμεις (δύναμις, G1411) está aqui como “os milagres”; o termo pode ser “poder”, “força”, “capacidade” ou “milagre”, e o contexto decide.\f*\x - \xo 11:21 \xt JON 3:5-8; LUK 10:13; MAT 9:13; MRK 7:24; MRK 8:22; 1PE 4:17\x*
\v 22 \w Mas|strong="G4133"\w* \w lhes digo|strong="G3004,G4771"\w*: \w para Tiro|strong="G5184"\w* \w e|strong="G2532"\w* \w Sidom|strong="G4605"\w* \w será mais suportável|strong="G414,G1510"\w* \w no dia|strong="G1722,G2250"\w* \w do juízo|strong="G2920"\w* \w do que|strong="G2228"\w* \w para vocês|strong="G4771"\w*.\x - \xo 11:22 \xt LUK 10:14; MAT 11:24; MAT 15:21; MAT 10:15; 1PE 4:17; 1JN 4:17\x*
\v 23 \w E|strong="G2532"\w* \w você|strong="G4771"\w*, \w Cafarnaum|strong="G2584"\w*, \w acaso|strong="G3361"\w* \w será exaltada|strong="G5312"\w* \w até o céu|strong="G2193,G3772"\w*? \w Até o Hades|strong="G2193,G86"\w* \w descerá|strong="G2597"\w*; \w porque|strong="G3754"\w* \w se|strong="G1487"\w* \w em Sodoma|strong="G1722,G4670"\w* \w tivessem sido feitos|strong="G1096"\w* \w os milagres|strong="G3588,G1411"\w* \w que foram feitos|strong="G3588,G1096"\w* \w em você|strong="G1722,G4771"\w*, \w teria permanecido|strong="G3306,G302"\w* \w até hoje|strong="G3360,G3588,G4594"\w*.\f + \fr 11.23: \ft Nota cultural: a exaltação até o céu e a queda até o Hades ecoam o oráculo sobre o rei de Babilônia em Is 14:13-15.\f*\f + \fr 11.23: \ft Variante: o RP traz “você, Cafarnaum, que foi exaltada até o céu” (ἡ ἕως τοῦ οὐρανοῦ ὑψωθεῖσα) e “será rebaixada” (καταβιβασθήσῃ), e as formas ἐγένοντο e ἔμειναν em lugar de ἐγενήθησαν e ἔμεινεν.\f*\f + \fr 11.23: \ft Tradução: δυνάμεις (δύναμις, G1411) está aqui como “os milagres”; o termo pode ser “poder”, “força”, “capacidade” ou “milagre”, e o contexto decide.\f*\x - \xo 11:23 \xt ISA 14:13; LUK 10:15; JHN 2:12; MAT 16:18; 1PE 4:17; ISA 14:15\x*
\v 24 \w Mas|strong="G4133"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w para a terra|strong="G1093"\w* \w de Sodoma|strong="G4670"\w* \w será mais suportável|strong="G414,G1510"\w* \w no dia|strong="G1722,G2250"\w* \w do juízo|strong="G2920"\w* \w do que|strong="G2228"\w* \w para você|strong="G4771"\w*.”\x - \xo 11:24 \xt LUK 10:12; MAT 10:15; MAT 11:22; LUK 10:14; 1PE 4:17; 1JN 4:17\x*
\p
\v 25 \w Naquele tempo|strong="G1722,G1565,G3588,G2540"\w*, \w Jesus|strong="G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: “\w Eu louvo|strong="G1843"\w* \w você|strong="G4771"\w*, \w Pai|strong="G3962"\w*, \w Senhor|strong="G2962"\w* \w do céu|strong="G3588,G3772"\w* \w e|strong="G2532"\w* \w da terra|strong="G3588,G1093"\w*, \w porque|strong="G3754"\w* \w escondeu|strong="G2928"\w* \w estas coisas|strong="G3778"\w* \w dos sábios|strong="G575,G4680"\w* \w e|strong="G2532"\w* \w entendidos|strong="G4908"\w* \w e|strong="G2532"\w* \w as revelou|strong="G601,G846"\w* \w aos pequeninos|strong="G3516"\w*;\f + \fr 11.25: \ft Lit.: ἐξομολογέομαι, “louvar, reconhecer publicamente, agradecer”; νήπιος, “criança pequena, ingênuo”.\f*\x - \xo 11:25 \xt LUK 10:21; JHN 6:44; 1CO 1:27; PSA 8:2; ACT 17:24; ACT 4:13\x*
\v 26 \w sim|strong="G3483"\w*, \w Pai|strong="G3588,G3962"\w*, \w porque|strong="G3754"\w* \w assim|strong="G3779"\w* \w foi do seu agrado|strong="G2107,G1096,G1715,G4771"\w*.\x - \xo 11:26 \xt LUK 10:21; JHN 6:44; 2PE 1:17; MAT 16:17; DAN 4:35; LUK 12:32\x*
\v 27 \w Todas as coisas|strong="G3956"\w* \w me foram entregues|strong="G3165,G3860"\w* \w pelo meu Pai|strong="G5259,G3588,G3962,G3165"\w*, \w e|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w conhece plenamente|strong="G1921"\w* \w o Filho|strong="G3588,G5207"\w* \w senão|strong="G1487,G3361"\w* \w o Pai|strong="G3588,G3962"\w*, \w nem|strong="G3761"\w* \w alguém|strong="G5100"\w* \w conhece plenamente|strong="G1921"\w* \w o Pai|strong="G3588,G3962"\w* \w senão|strong="G1487,G3361"\w* \w o Filho|strong="G3588,G5207"\w* \w e|strong="G2532"\w* \w aquele a quem|strong="G3739,G1437"\w* \w o Filho|strong="G3588,G5207"\w* \w quiser|strong="G1014"\w* \w revelar|strong="G601"\w*.\f + \fr 11.27: \ft Lit.: ἐπιγινώσκω, “conhecer plenamente, reconhecer”.\f*\x - \xo 11:27 \xt LUK 10:22; JHN 14:6; MAT 28:18; 2JN 1:9; JHN 17:25; 1JN 2:23\x*
\v 28 \w Venham|strong="G1205"\w* \w a mim|strong="G4314,G3165"\w* \w todos os que|strong="G3956,G3588"\w* \w estão cansados|strong="G2872"\w* \w e|strong="G2532"\w* \w sobrecarregados|strong="G5412"\w*, \w e eu|strong="G2532_B,G1473"\w* \w darei descanso|strong="G373"\w* \w a vocês|strong="G4771"\w*.\x - \xo 11:28 \xt GAL 5:1; ISA 55:1-3; JHN 6:37; JHN 7:37; MAT 11:29; REV 22:17\x*
\v 29 \w Tomem|strong="G142"\w* \w o meu jugo|strong="G3588,G2218,G3165"\w* \w sobre vocês|strong="G1909,G4771"\w* \w e|strong="G2532"\w* \w aprendam|strong="G3129"\w* \w de mim|strong="G575,G1473"\w*, \w porque|strong="G3754"\w* \w sou|strong="G1510"\w* \w manso|strong="G4235"\w* \w e|strong="G2532"\w* \w humilde|strong="G5011"\w* \w de coração|strong="G3588,G2588"\w*, \w e|strong="G2532"\w* \w encontrarão|strong="G2147"\w* \w descanso|strong="G372"\w* \w para as suas almas|strong="G3588,G5590,G4771"\w*;\f + \fr 11.29: \ft Nota cultural: “encontrarão descanso para as suas almas” cita Jr 6:16.\f*\x - \xo 11:29 \xt JER 6:16; MAT 11:28; PSA 32:8; PHP 2:5; MAT 5:5; 1JN 2:6\x*
\v 30 \w pois|strong="G1063"\w* \w o meu jugo|strong="G3588,G2218,G3165"\w* \w é suave|strong="G5543"\w* \w e|strong="G2532"\w* \w o meu fardo|strong="G3588,G5413,G3165"\w* \w é leve|strong="G1645,G1510"\w*.”\f + \fr 11.30: \ft Lit.: χρηστός, “bom, agradável, suave, fácil de carregar”.\f*\f + \fr 11.30: \ft Acréscimo: verbo ser/estar suprido em “é suave”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:30 \xt 1JN 5:3; JHN 16:33; PHP 4:13; 2CO 10:5; DEU 29:29; 2CO 12:9-10\x*
\c 12
\p
\v 1 \w Naquele tempo|strong="G1722,G1565,G3588,G2540"\w*, \w Jesus|strong="G3588,G2424"\w* \w passou|strong="G4198"\w* \w pelas plantações|strong="G1223,G3588,G4702"\w* \w no sábado|strong="G3588,G4521"\w*; \w e|strong="G1161"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w* \w tiveram fome|strong="G3983"\w* \w e|strong="G2532"\w* \w começaram|strong="G757"\w* \w a arrancar|strong="G5089"\w* \w espigas|strong="G4719"\w* \w e|strong="G2532"\w* \w comer|strong="G2068"\w*.\x - \xo 12:1 \xt LUK 6:1; MRK 2:23; DEU 23:25; ACT 10:10; JHN 9:14; MAT 21:18\x*
\v 2 \w E os fariseus|strong="G3588,G1161,G5330"\w*, \w vendo|strong="G1492"\w*, \w disseram-lhe|strong="G2036,G846"\w*: “\w Olhe|strong="G2400"\w*, \w os seus discípulos|strong="G3588,G3101,G4771"\w* \w fazem|strong="G4160"\w* \w o que|strong="G3739"\w* \w não é permitido|strong="G3756,G1832"\w* \w fazer|strong="G4160"\w* \w no sábado|strong="G1722,G4521"\w*.”\x - \xo 12:2 \xt LUK 6:2; MRK 2:24; LUK 14:3; MAT 12:10; JHN 5:10; LUK 6:1\x*
\v 3 \w Mas ele|strong="G3588,G1161"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Não|strong="G3756"\w* \w leram|strong="G314"\w* \w o que|strong="G5101"\w* \w fez|strong="G4160"\w* \w Davi|strong="G1138"\w*, \w quando|strong="G3753"\w* \w teve fome|strong="G3983"\w*, \w ele e|strong="G2532"\w* \w os que estavam|strong="G3588"\w* \w com ele|strong="G3326,G846"\w*?\f + \fr 12.3: \ft Acréscimo: “os que estavam”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 12:3 \xt LUK 6:3; MRK 2:25; 1SA 21:3-6; MAT 9:13; MRK 12:10; MAT 21:16\x*
