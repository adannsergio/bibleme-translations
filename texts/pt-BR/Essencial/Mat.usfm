\v 34 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Quantos pães|strong="G4214,G740"\w* \w têm|strong="G2192"\w*?” \w E eles|strong="G3588,G1161"\w* \w disseram|strong="G2036"\w*: “\w Sete|strong="G2033"\w*, \w e|strong="G2532"\w* \w uns poucos|strong="G3641"\w* \w peixinhos|strong="G2485"\w*.”\x - \xo 15:34 \xt MRK 8:5; MAT 16:10; MRK 8:7; MRK 6:38; MRK 8:1; MAT 14:14\x*
\v 35 \w E|strong="G2532"\w* \w tendo ordenado|strong="G3853"\w* \w à multidão|strong="G3588,G3793"\w* \w que se reclinasse|strong="G377"\w* \w no chão|strong="G1909,G3588,G1093"\w*\x - \xo 15:35 \xt MRK 8:6; MRK 8:1; MAT 14:14; MRK 8:20; MAT 14:19; MAT 16:10\x*
\v 36 \w tomou|strong="G2983"\w* \w os sete|strong="G3588,G2033"\w* \w pães|strong="G740"\w* \w e|strong="G2532"\w* \w os peixes|strong="G3588,G2486"\w*, \w e|strong="G2532"\w* \w tendo dado graças|strong="G2168"\w*, \w partiu|strong="G2806"\w* \w e|strong="G2532"\w* \w dava|strong="G1325"\w* \w aos discípulos|strong="G3588,G3101"\w*, \w e os discípulos|strong="G3588,G1161,G3101"\w* \w às multidões|strong="G3588,G3793"\w*.\x - \xo 15:36 \xt MRK 8:6; ACT 27:35; LUK 22:19; MAT 14:19; LUK 9:16; LUK 24:30\x*
\v 37 \w E|strong="G2532"\w* \w comeram|strong="G5315"\w* \w todos|strong="G3956"\w* \w e|strong="G2532"\w* \w se saciaram|strong="G5526"\w*, \w e|strong="G2532"\w* \w levantaram|strong="G142"\w* \w o que sobrou|strong="G3588,G4052"\w* \w dos pedaços|strong="G3588,G2801"\w*: \w sete|strong="G2033"\w* \w cestas|strong="G4711"\w* \w cheias|strong="G4134"\w*\f + \fr 15.37: \ft Lit.: σπυρίς, “cesto grande” (aqui), diferente de κόφινος (“cesto”) usado na primeira multiplicação (14:20).\f*.\x - \xo 15:37 \xt MRK 8:8; MAT 14:20; LUK 9:17; MRK 8:20; MRK 6:42; MAT 16:10\x*
\v 38 \w E os que comiam|strong="G3588,G1161,G2068"\w* \w eram|strong="G1510"\w* \w quatro mil|strong="G5070"\w* \w homens|strong="G435"\w*, \w sem|strong="G5565"\w* \w mulheres|strong="G1135"\w* \w e|strong="G2532"\w* \w crianças|strong="G3813"\w*.\x - \xo 15:38 \xt MAT 14:21; 1KI 17:14; MRK 8:1; MAT 14:14; MRK 8:20; LUK 9:17\x*
\v 39 \w E|strong="G2532"\w* \w tendo despedido|strong="G630"\w* \w as multidões|strong="G3588,G3793"\w*, \w subiu|strong="G1684"\w* \w ao barco|strong="G1519,G3588,G4143"\w*, \w e|strong="G2532"\w* \w foi|strong="G2064"\w* \w às regiões|strong="G1519,G3588,G3725"\w* \w de Magadã|strong="G3093"\w*.\x - \xo 15:39 \xt MRK 8:10; MAT 14:22; MAT 8:23; MRK 8:1; MAT 14:14\x*
\c 16
\p
\v 1 \w E|strong="G2532"\w* \w aproximando-se|strong="G4334"\w* \w os fariseus|strong="G3588,G5330"\w* \w e|strong="G2532"\w* \w saduceus|strong="G4523"\w*, \w para o pôr à prova|strong="G3985"\w*, \w pediram-lhe|strong="G1905,G846"\w* \w que mostrasse|strong="G1925"\w* \w a eles|strong="G846"\w* \w um sinal|strong="G4592"\w* \w do céu|strong="G1537,G3588,G3772"\w*.\x - \xo 16:1 \xt MAT 22:23; LUK 20:27; LUK 11:16; MRK 8:11; MAT 16:6; MRK 10:2\x*
\v 2 \w Mas ele|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w disse-lhes|strong="G2036,G846"\w*: “\w Ao entardecer|strong="G3798,G1096"\w* \w dizem|strong="G3004"\w*: \add ‘Bom\add* \w tempo|strong="G2105"\w*’, \w pois|strong="G1063"\w* \w o céu|strong="G3588,G3772"\w* \w está vermelho|strong="G4449"\w*;\f + \fr 16.2: \ft Acréscimo: “Bom” (em “entardecer dizem Bom tempo pois”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 16:2 \xt 1CO 1:22; PRO 26:5; GEN 1:14; MAT 12:38; LUK 12:54; MRK 8:11\x*
\v 3 \w e|strong="G2532"\w* \w de manhã|strong="G4404"\w*: ‘\w Hoje|strong="G4594"\w* \w haverá tempestade|strong="G5494"\w*’, \w pois|strong="G1063"\w* \w o céu|strong="G3588,G3772"\w* \w está vermelho|strong="G4449"\w* \add e\add* \w sombrio|strong="G4768"\w*. \w A aparência|strong="G3588,G3303,G4383"\w* \w do céu|strong="G3588,G3772"\w* \w sabem|strong="G1097"\w* \w discernir|strong="G1252"\w*, \w mas|strong="G1161"\w* \w os sinais|strong="G3588,G4592"\w* \w dos tempos|strong="G3588,G2540"\w* \w não|strong="G3756"\w* \w podem|strong="G1410"\w*.\f + \fr 16.3: \ft Variante: o TR e o texto bizantino (RP) trazem ὑποκριταί (“hipócritas”) no início da frase “A aparência do céu sabem discernir”; o SBLGNT não a traz.\f*\f + \fr 16.3: \ft Acréscimo: “e” (em “está vermelho e sombrio A”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 16:3 \xt ECC 3:1; LUK 12:56; ROM 13:11; 1CH 12:32; 1CO 1:22; PRO 26:5\x*
\v 4 \w Uma geração|strong="G1074"\w* \w má|strong="G4190"\w* \w e|strong="G2532"\w* \w adúltera|strong="G3428"\w* \w procura|strong="G1934"\w* \w um sinal|strong="G4592"\w*, \w e|strong="G2532"\w* \w sinal|strong="G4592"\w* \w não|strong="G3756"\w* \w lhe será dado|strong="G1325,G846"\w*, \w a não ser|strong="G1487,G3361"\w* \w o sinal|strong="G3588,G4592"\w* \w de Jonas|strong="G2495"\w*.” \w E|strong="G2532"\w*, \w deixando-os|strong="G2641,G846"\w*, \w foi embora|strong="G565"\w*.\f + \fr 16.4: \ft Variante: o RP, o TR e a tradição bizantina acrescentam τοῦ προφήτου (“o profeta”) depois de “Jonas”; WH, Treg e NA28 terminam em Ἰωνᾶ.\f*\x - \xo 16:4 \xt MAT 12:39; LUK 11:29; MRK 8:12; MRK 8:38; JON 1:1; JON 1:17\x*
\v 5 \w E|strong="G2532"\w* \w tendo chegado|strong="G2064"\w* \w os discípulos|strong="G3588,G3101"\w* \w à outra margem|strong="G1519,G3588,G4008"\w*, \w esqueceram-se|strong="G1950"\w* \w de levar|strong="G2983"\w* \w pães|strong="G740"\w*.\x - \xo 16:5 \xt MRK 8:14; MRK 8:11; MRK 8:13-14\x*
\v 6 \w E Jesus|strong="G3588,G1161,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Vejam|strong="G3708"\w* \w e|strong="G2532"\w* \w guardem-se|strong="G4337"\w* \w do fermento|strong="G575,G3588,G2219"\w* \w dos fariseus|strong="G3588,G5330"\w* \w e|strong="G2532"\w* \w saduceus|strong="G4523"\w*.”\f + \fr 16.6: \ft Nota cultural: o fermento, aqui, é imagem de ensino que se espalha e corrompe (v. 12).\f*\x - \xo 16:6 \xt MAT 16:11; MAT 16:12; MRK 8:15; LUK 12:1; MAT 16:1; MAT 6:1\x*
\v 7 \w Mas eles|strong="G3588,G1161"\w* \w discutiam|strong="G1260"\w* \w entre si|strong="G1722,G1438"\w*, \w dizendo|strong="G3004"\w*: “\w Pães|strong="G740"\w* \w não trouxemos|strong="G3756,G2983"\w*.”\x - \xo 16:7 \xt MRK 8:16; GAL 5:9; LUK 12:1; MRK 8:11; MAT 9:4\x*
\v 8 \w E Jesus|strong="G1161,G3588,G2424"\w*, \w sabendo|strong="G1097"\w*, \w disse|strong="G2036"\w*: “\w Por que|strong="G5101"\w* \w discutem|strong="G1260"\w* \w entre si|strong="G1722,G1438"\w*, \w gente de pouca fé|strong="G3640"\w*, \w porque|strong="G3754"\w* \w não trouxeram|strong="G3756,G2983"\w* \w pães|strong="G740"\w*?\f + \fr 16.8: \ft Variante: WH e NA28 trazem ἔχετε (“têm”) em lugar de ἐλάβετε (“trouxeram, tomaram”), lido pelo SBLGNT, por Treg, pelo TR e pelo RP; o RP acrescenta αὐτοῖς (“lhes”) depois de “disse”.\f*\x - \xo 16:8 \xt MRK 8:16; MRK 8:17; MRK 4:40; MAT 6:30; MAT 14:31; MAT 8:26\x*
\v 9 \add Ainda\add* \w não|strong="G3768"\w* \w entendem|strong="G3539"\w*, \w nem|strong="G3761"\w* \w se lembram|strong="G3421"\w* \w dos cinco|strong="G3588,G4002"\w* \w pães|strong="G740"\w* \w dos cinco mil|strong="G3588,G4000"\w* \w e|strong="G2532"\w* \w de quantos|strong="G4214"\w* \w cestos|strong="G2894"\w* \w recolheram|strong="G2983"\w*?\f + \fr 16.9: \ft Acréscimo: “Ainda” (em “Ainda não entendem”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 16:9 \xt MRK 8:17; MRK 6:38; MRK 8:19; MAT 14:17; JHN 6:9; HEB 2:1\x*
\v 10 \w Nem|strong="G3761"\w* \w dos sete|strong="G3588,G2033"\w* \w pães|strong="G740"\w* \w dos quatro mil|strong="G3588,G5070"\w* \w e|strong="G2532"\w* \w de quantas|strong="G4214"\w* \w cestas|strong="G4711"\w* \w recolheram|strong="G2983"\w*?\x - \xo 16:10 \xt MRK 8:5; MRK 8:20; MAT 15:34; MRK 8:8; GAL 5:9; MAT 14:20\x*
\v 11 \w Como|strong="G4459"\w* \w não|strong="G3756"\w* \w entendem|strong="G3539"\w* \w que|strong="G3754"\w* \w não|strong="G3756"\w* \w lhes falei|strong="G2036,G4771"\w* \w de pães|strong="G4012,G740"\w*? \w Mas|strong="G1161"\w* \w guardem-se|strong="G4337"\w* \w do fermento|strong="G575,G3588,G2219"\w* \w dos fariseus|strong="G3588,G5330"\w* \w e|strong="G2532"\w* \w saduceus|strong="G4523"\w*.”\x - \xo 16:11 \xt MAT 16:6; MRK 8:15; LUK 12:1; GAL 5:9; MRK 7:18; MRK 8:21\x*
\v 12 \w Então|strong="G5119"\w* \w entenderam|strong="G4920"\w* \w que|strong="G3754"\w* \w não|strong="G3756"\w* \w disse|strong="G2036"\w* \w que se guardassem|strong="G4337"\w* \w do fermento|strong="G575,G3588,G2219"\w* \w dos pães|strong="G3588,G740"\w*, \w mas|strong="G235"\w* \w do ensino|strong="G575,G3588,G1322"\w* \w dos fariseus|strong="G3588,G5330"\w* \w e|strong="G2532"\w* \w saduceus|strong="G4523"\w*.\x - \xo 16:12 \xt MAT 16:6; MRK 8:15; LUK 12:1; GAL 5:9; MAT 5:20; 1CO 5:8\x*
\p
\v 13 \w E Jesus|strong="G1161,G3588,G2424"\w*, \w tendo chegado|strong="G2064"\w* \w às regiões|strong="G1519,G3588,G3313"\w* \w de Cesareia|strong="G2542"\w* \w de Filipe|strong="G3588,G5376"\w*, \w perguntava|strong="G2065"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Quem|strong="G5101"\w* \w dizem|strong="G3004"\w* \w os seres humanos|strong="G3588,G444"\w* \w que é|strong="G1511"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w*?”\f + \fr 16.13: \ft Nota cultural: Cesareia de Filipe, ao norte da Galileia, ficava junto às fontes do Jordão, na região do monte Hermom.\f*\x - \xo 16:13 \xt MRK 8:27; LUK 9:18; DAN 7:13; JHN 5:27; MAT 9:6; HEB 2:14-18\x*
\v 14 \w E eles|strong="G3588,G1161"\w* \w disseram|strong="G2036"\w*: “\w Uns|strong="G3588,G3303"\w*, \w João|strong="G2491"\w*, \w o Batista|strong="G3588,G910"\w*; \w outros|strong="G243,G1161"\w*, \w Elias|strong="G2243"\w*; \w e outros|strong="G2087,G1161"\w*, \w Jeremias|strong="G2408"\w* \w ou|strong="G2228"\w* \w um|strong="G1520"\w* \w dos profetas|strong="G3588,G4396"\w*.”\x - \xo 16:14 \xt MRK 8:28; MRK 6:15; LUK 9:19; JHN 1:21; MAT 3:1; MRK 8:27\x*
\v 15 \w Disse-lhes|strong="G3004,G846"\w*: “\w E vocês|strong="G4771,G1161"\w*, \w quem|strong="G5101"\w* \w dizem|strong="G3004"\w* \w que eu sou|strong="G3165,G1511"\w*?”\x - \xo 16:15 \xt LUK 9:20; MRK 8:27; MRK 8:29; MAT 13:11; LUK 9:18; MAT 22:42\x*
\v 16 \w E Simão|strong="G1161,G4613"\w* \w Pedro|strong="G4074"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: “\w Você|strong="G4771"\w* \w é|strong="G1510"\w* \w o Cristo|strong="G3588,G5547"\w*, \w o Filho|strong="G3588,G5207"\w* \w do Deus|strong="G3588,G2316"\w* \w vivo|strong="G3588,G2198"\w*.”\x - \xo 16:16 \xt JHN 6:68; LUK 9:20; MRK 8:29; JHN 11:27; MAT 14:33; JHN 6:8\x*
\v 17 \w E Jesus|strong="G1161,G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w lhe disse|strong="G2036,G846"\w*: “\w Feliz|strong="G3107"\w* \w é|strong="G1510"\w* \add você,\add* \w Simão|strong="G4613"\w*, \w filho de Jonas|strong="G920"\w*, \w porque|strong="G3754"\w* \w carne|strong="G4561"\w* \w e|strong="G2532"\w* \w sangue|strong="G129"\w* \w não lhe revelaram|strong="G3756,G601,G4771"\w* \add isso,\add* \w mas|strong="G235"\w* \w o meu Pai|strong="G3588,G3962,G3165"\w*, \w que está|strong="G3588,G1722"\w* \w nos céus|strong="G3588,G3772"\w*;\f + \fr 16.17: \ft Lit.: Βαριωνᾶ, do aramaico bar-Yônâ, “filho de Jonas”; “carne e sangue” é expressão semítica para o ser humano.\f*\f + \fr 16.17: \ft Acréscimo: “você” (em “Feliz é você Simão filho”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo; “isso” (em “lhe revelaram isso mas o”): demonstrativo acrescentado para retomar o que foi dito; “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 16:17 \xt GAL 1:16; EPH 6:12; EPH 2:8; JHN 6:44; PSA 1:1; ISA 53:1\x*
\v 18 \w E eu também|strong="G2532_A,G1473,G1161"\w* \w lhe digo|strong="G4771,G3004"\w* \w que|strong="G3754"\w* \w você|strong="G4771"\w* \w é|strong="G1510"\w* \w Pedro|strong="G4074"\w*, \w e|strong="G2532"\w* \w sobre esta pedra|strong="G1909,G3778,G3588,G4073"\w* \w edificarei|strong="G3618"\w* \w a minha comunidade|strong="G3165,G3588,G1577"\w*, \w e|strong="G2532"\w* \w as portas|strong="G4439"\w* \w do Hades|strong="G86"\w* \w não prevalecerão|strong="G3756,G2729"\w* \w contra ela|strong="G846"\w*;\f + \fr 16.18: \ft Lit.: Πέτρος (“Pedro”, masculino) e πέτρα (“pedra”, feminino) formam um jogo de palavras que no aramaico seria Kēpā em ambos os termos; ἐκκλησία, “assembleia, comunidade” (o povo convocado); a tradição em português costuma traduzir por “igreja”.\f*\f + \fr 16.18: \ft Nota cultural: a interpretação de “esta pedra” (Pedro, a sua confissão ou Cristo) é debatida entre as tradições cristãs.\f*\x - \xo 16:18 \xt EPH 2:19-22; 1CO 3:9; ISA 54:17; ISA 28:16; COL 1:18; ISA 22:22\x*
\v 19 \w darei|strong="G1325"\w* \w a você|strong="G4771"\w* \w as chaves|strong="G3588,G2807"\w* \w do reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w*, \w e|strong="G2532"\w* \w o que|strong="G3739,G1437"\w* \w você ligar|strong="G1210"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w terá sido ligado|strong="G1510,G1210"\w* \w nos céus|strong="G1722,G3588,G3772"\w*, \w e|strong="G2532"\w* \w o que|strong="G3739,G1437"\w* \w você desligar|strong="G3089"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w terá sido desligado|strong="G1510,G3089"\w* \w nos céus|strong="G1722,G3588,G3772"\w*.”\f + \fr 16.19: \ft Nota cultural: as chaves do reino evocam Is 22:22; “ligar e desligar” é linguagem rabínica para proibir e permitir, ou para reter e perdoar (cf. 18:18; Jo 20:23).\f*\x - \xo 16:19 \xt ISA 22:22; JHN 20:23; MAT 18:18; REV 9:1; 1CO 7:27; REV 1:18\x*
\v 20 \w Então|strong="G5119"\w* \w advertiu|strong="G1291"\w* \w os discípulos|strong="G3588,G3101"\w* \w que a ninguém|strong="G2443,G3367"\w* \w dissessem|strong="G2036"\w* \w que|strong="G3754"\w* \w ele|strong="G846"\w* \w é|strong="G1510"\w* \w o Cristo|strong="G3588,G5547"\w*.\f + \fr 16.20: \ft Variante: WH e a NIV trazem ἐπετίμησεν (“repreendeu”) em lugar de διεστείλατο (“advertiu”); o RP acrescenta αὐτοῦ (“seus”) depois de “discípulos” e Ἰησοῦς depois de “é”.\f*\x - \xo 16:20 \xt MRK 5:43; MRK 9:9; MRK 7:36; MRK 8:27; LUK 9:21; MRK 8:30\x*
\p
\v 21 \w Desde então|strong="G575,G5119"\w* \w começou|strong="G757"\w* \w Jesus|strong="G3588,G2424"\w* \add a\add* \w mostrar|strong="G1166"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w* \w que|strong="G3754"\w* \w era necessário|strong="G1163"\w* \w que ele|strong="G846"\w* \w fosse|strong="G565"\w* \w a Jerusalém|strong="G1519,G2414"\w* \w e|strong="G2532"\w* \w sofresse|strong="G3958"\w* \w muito|strong="G4183"\w* \w da parte dos anciãos|strong="G575,G3588,G4245"\w* \w e|strong="G2532"\w* \w chefes dos sacerdotes|strong="G749"\w* \w e|strong="G2532"\w* \w escribas|strong="G1122"\w*, \w e|strong="G2532"\w* \w fosse morto|strong="G615"\w*, \w e|strong="G2532"\w* \w ao terceiro dia|strong="G3588,G5154,G2250"\w* \w fosse ressuscitado|strong="G1453"\w*\f + \fr 16.21: \ft Variante: WH traz “Jesus Cristo” (Ἰησοῦς Χριστός) em lugar de “Jesus”; o RP inverte a ordem de “a Jerusalém ir” (ἀπελθεῖν εἰς Ἱεροσόλυμα).\f*.\f + \fr 16.21: \ft Acréscimo: “a” (em “começou Jesus a mostrar aos”): preposição ou artigo que a regência do português exige.\f*\x - \xo 16:21 \xt LUK 9:22; MRK 8:31; MAT 17:23; MAT 17:22; LUK 24:7; HEB 12:2\x*
\v 22 \w E|strong="G2532"\w* \w Pedro|strong="G3588,G4074"\w*, \w tomando-o à parte|strong="G4355,G846"\w*, \w começou|strong="G757"\w* \w a repreendê-lo|strong="G2008,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Deus tenha misericórdia|strong="G2436"\w* \w de você|strong="G4771"\w*, \w Senhor|strong="G2962"\w*; \w de modo algum|strong="G3756,G3361"\w* \w lhe acontecerá|strong="G1510,G4771"\w* \w isso|strong="G3778"\w*.”\x - \xo 16:22 \xt MRK 8:32; LUK 9:23; MRK 8:31; ACT 21:12; JHN 11:8; LUK 10:40\x*
\v 23 \w Mas ele|strong="G3588,G1161"\w*, \w voltando-se|strong="G4762"\w*, \w disse|strong="G2036"\w* \w a Pedro|strong="G3588,G4074"\w*: “\w Vá para trás|strong="G5217,G3694"\w* \w de mim|strong="G3165"\w*, \w Satanás|strong="G4567"\w*; \w você é|strong="G1510"\w* \w para mim|strong="G1473"\w* \w um obstáculo|strong="G4625"\w*, \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w pensa|strong="G5426"\w* \w as coisas|strong="G3588"\w* \w de Deus|strong="G3588,G2316"\w*, \w mas|strong="G235"\w* \w as|strong="G3588"\w* \w dos seres humanos|strong="G3588,G444"\w*.”\f + \fr 16.23: \ft Lit.: σκάνδαλον, “pedra de tropeço, obstáculo, armadilha”.\f*\x - \xo 16:23 \xt MRK 8:33; COL 3:2; LUK 9:23; ROM 8:5-8; PHP 3:19; 1CO 2:14\x*
\v 24 \w Então|strong="G5119"\w* \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w*: “\w Se alguém|strong="G1487,G5100"\w* \w quer|strong="G2309"\w* \w vir|strong="G2064"\w* \w atrás de mim|strong="G3694,G3165"\w*, \w negue|strong="G533"\w* \w a si mesmo|strong="G1438"\w*, \w e|strong="G2532"\w* \w tome|strong="G142"\w* \w a sua cruz|strong="G3588,G4716,G846"\w* \w e|strong="G2532"\w* \w siga-me|strong="G190,G3165"\w*.\x - \xo 16:24 \xt MAT 10:38; LUK 9:23; MRK 8:34; LUK 14:27; 1PE 4:1-2; MRK 10:21\x*
\v 25 \w Pois|strong="G1063"\w* \w quem|strong="G3739,G1437"\w* \w quiser|strong="G2309"\w* \w salvar|strong="G4982"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w a perderá|strong="G622,G846"\w*; \w mas|strong="G1161"\w* \w quem|strong="G3739,G302"\w* \w perder|strong="G622"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w por causa de mim|strong="G1752,G1473"\w* \w a achará|strong="G2147,G846"\w*.\x - \xo 16:25 \xt MRK 8:35; MAT 10:39; LUK 9:24; LUK 17:33; MAT 18:11; MAT 19:29\x*
\v 26 \w Pois|strong="G1063"\w* \w o que|strong="G5101"\w* \w aproveitará|strong="G5623"\w* \w ao ser humano|strong="G444"\w* \w se|strong="G1437"\w* \w ganhar|strong="G2770"\w* \w o mundo|strong="G3588,G2889"\w* \w inteiro|strong="G3650"\w* \w e|strong="G1161"\w* \w perder|strong="G2210"\w* \w a sua vida|strong="G3588,G5590,G846"\w*? \w Ou|strong="G2228"\w* \w o que|strong="G5101"\w* \w dará|strong="G1325"\w* \w o ser humano|strong="G444"\w* \w em troca|strong="G465"\w* \w da sua vida|strong="G3588,G5590,G846"\w*?\x - \xo 16:26 \xt MRK 8:36; LUK 9:25; MRK 8:37; JOB 27:8; LUK 12:20; MAT 10:39\x*
\v 27 \w Pois|strong="G1063"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w está para|strong="G3195"\w* \w vir|strong="G2064"\w* \w na glória|strong="G1722,G3588,G1391"\w* \w do seu Pai|strong="G3588,G3962,G846"\w* \w com os seus anjos|strong="G3326,G3588,G32,G846"\w*, \w e|strong="G2532"\w* \w então|strong="G5119"\w* \w retribuirá|strong="G591"\w* \w a cada um|strong="G1538"\w* \w conforme|strong="G2596"\w* \w a sua conduta|strong="G3588,G4234,G846"\w*.\f + \fr 16.27: \ft Nota cultural: ecoa Sl 62:12 e Pv 24:12 (Deus retribui a cada um conforme as suas obras).\f*\x - \xo 16:27 \xt PSA 62:12; PRO 24:12; ROM 2:6; MAT 25:31; REV 22:12; 2CO 5:10\x*
\v 28 \w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w há|strong="G1510"\w* \w alguns|strong="G5100"\w* \w dos que aqui|strong="G3588,G5602"\w* \w estão de pé|strong="G2476"\w*, \w os quais|strong="G3748"\w* \w de modo algum|strong="G3756,G3361"\w* \w provarão|strong="G1089"\w* \w a morte|strong="G2288"\w* \w até que|strong="G2193,G302"\w* \w vejam|strong="G1492"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w vindo|strong="G2064"\w* \w no seu reino|strong="G1722,G3588,G932,G846"\w*.”\f + \fr 16.28: \ft Variante: o verso termina o cap. 16 em todas as edições; a aplicação (transfiguração, ressurreição ou vinda final) é discutida.\f*\x - \xo 16:28 \xt MRK 9:1; LUK 9:27; MAT 24:34; LUK 21:32; JHN 8:52; JHN 1:51\x*
\c 17
\p
\v 1 \w E|strong="G2532"\w* \w depois de|strong="G3326"\w* \w seis|strong="G1803"\w* \w dias|strong="G2250"\w*, \w Jesus|strong="G3588,G2424"\w* \w tomou consigo|strong="G3880"\w* \w Pedro|strong="G3588,G4074"\w*, \w Tiago|strong="G2532,G2385"\w* \w e|strong="G2532"\w* \w João|strong="G2491"\w*, \w seu irmão|strong="G3588,G80,G846"\w*, \w e|strong="G2532"\w* \w os levou|strong="G399,G846"\w* \w a um monte|strong="G1519,G3735"\w* \w alto|strong="G5308"\w*, \w à parte|strong="G2596,G2398"\w*.\x - \xo 17:1 \xt MRK 9:2; LUK 9:28; MRK 5:37; JHN 1:14; MAT 26:37; 2CO 13:1\x*
\v 2 \w E|strong="G2532"\w* \w foi transfigurado|strong="G3339"\w* \w diante deles|strong="G1715,G846"\w*, \w e|strong="G2532"\w* \w brilhou|strong="G2989"\w* \w o seu rosto|strong="G3588,G4383,G846"\w* \w como o sol|strong="G5613,G3588,G2246"\w*, \w e|strong="G1161"\w* \w as suas vestes|strong="G3588,G2440,G846"\w* \w ficaram brancas|strong="G1096,G3022"\w* \w como a luz|strong="G5613,G3588,G5457"\w*.\f + \fr 17.2: \ft Lit.: μεταμορφόω, “transformar a forma, transfigurar”.\f*\x - \xo 17:2 \xt JHN 1:14; EXO 34:29; MRK 9:2; REV 10:1; PSA 104:2; MAT 28:3\x*
\v 3 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w lhes apareceram|strong="G3700,G846"\w* \w Moisés|strong="G3475"\w* \w e|strong="G2532"\w* \w Elias|strong="G2243"\w*, \w conversando|strong="G4814"\w* \w com ele|strong="G3326,G846"\w*.\f + \fr 17.3: \ft Nota cultural: Moisés (a Lei) e Elias (os Profetas) representam as Escrituras de Israel e testemunham de Jesus.\f*\x - \xo 17:3 \xt MRK 9:4; LUK 9:30; 2PE 1:17; JHN 1:14; MRK 9:2; ACT 7:37\x*
\v 4 \w E Pedro|strong="G1161,G3588,G4074"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w* \w a Jesus|strong="G3588,G2424"\w*: “\w Senhor|strong="G2962"\w*, \w é bom|strong="G2570,G1510"\w* \w que estejamos|strong="G3165,G1511"\w* \w aqui|strong="G5602"\w*; \w se|strong="G1487"\w* \w quiser|strong="G2309"\w*, \w farei|strong="G4160"\w* \w aqui|strong="G5602"\w* \w três tendas|strong="G5140,G4633"\w*: \w uma para você|strong="G4771,G1520"\w*, \w e|strong="G2532"\w* \w uma para Moisés|strong="G3475,G1520"\w*, \w e|strong="G2532"\w* \w uma para Elias|strong="G2243,G1520"\w*.”\f + \fr 17.4: \ft Variante: Treg e o RP trazem ποιήσωμεν (“façamos”) em lugar de ποιήσω (“farei”); o RP também inverte a ordem de “uma para Elias” (μίαν Ἠλίᾳ).\f*\x - \xo 17:4 \xt MRK 9:5; LUK 9:33; JHN 1:14; MRK 9:2; ACT 7:37; MRK 9:4\x*
\v 5 \w Enquanto ele|strong="G846"\w* \w ainda|strong="G2089"\w* \w falava|strong="G2980"\w*, \w olhem|strong="G2400"\w*, \w uma nuvem|strong="G3507"\w* \w luminosa|strong="G5460"\w* \w os cobriu com sombra|strong="G1982,G846"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w uma voz|strong="G5456"\w* \w da nuvem|strong="G1537,G3588,G3507"\w* \w dizendo|strong="G3004"\w*: “\w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w o meu Filho|strong="G3588,G5207,G3165"\w*, \w o amado|strong="G3588,G27"\w*, \w em quem|strong="G1722,G3739"\w* \w me agradei|strong="G2106"\w*; \w ouçam-no|strong="G191,G846"\w*.”\f + \fr 17.5: \ft Nota cultural: a voz repete a do batismo (3:17) e acrescenta “ouçam-no”, que remete a Dt 18:15.\f*\x - \xo 17:5 \xt DEU 18:15; 2PE 1:17; MRK 9:7; MAT 3:17; MRK 1:11; LUK 9:34\x*
\v 6 \w E|strong="G2532"\w* \w ao ouvirem|strong="G191"\w*, \w os discípulos|strong="G3588,G3101"\w*, \w caíram|strong="G4098"\w* \w sobre o seu rosto|strong="G1909,G4383,G846"\w* \w e|strong="G2532"\w* \w ficaram com muito temor|strong="G5399,G4970"\w*.\x - \xo 17:6 \xt MRK 9:2; 2PE 1:18; MRK 9:7; ACT 26:14; LUK 5:8; LUK 9:34\x*
\v 7 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w aproximando-se|strong="G4334"\w* \w e|strong="G2532"\w* \w tocando-os|strong="G681,G846"\w*, \w disse|strong="G2036"\w*: “\w Levantem-se|strong="G1453"\w* \w e|strong="G2532"\w* \w não temam|strong="G3361,G5399"\w*.”\x - \xo 17:7 \xt LUK 7:14; MRK 9:2; MAT 14:27; DAN 10:18; MRK 9:7; DAN 8:18\x*
\v 8 \w E levantando|strong="G1869,G1161"\w* \w os olhos|strong="G3588,G3788"\w* \w deles|strong="G846"\w*, \w não viram|strong="G1492"\w* \w ninguém|strong="G3762"\w*, \w a não ser|strong="G1487,G3361"\w* \w somente|strong="G3441"\w* \w o próprio Jesus|strong="G846,G2424"\w*.\x - \xo 17:8 \xt JHN 17:1; LUK 6:20; MRK 9:8; MRK 9:2; LUK 9:36; ACT 12:10-11\x*
\v 9 \w E|strong="G2532"\w* \w descendo eles|strong="G2597,G846"\w* \w do monte|strong="G1537,G3588,G3735"\w*, \w lhes ordenou|strong="G1781,G846"\w* \w Jesus|strong="G3588,G2424"\w*, \w dizendo|strong="G3004"\w*: “\w A ninguém|strong="G3367"\w* \w contem|strong="G2036"\w* \w a visão|strong="G3588,G3705"\w*, \w até que|strong="G2193,G3739"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w seja ressuscitado|strong="G1453"\w* \w dos mortos|strong="G1537,G3498"\w*.”\x - \xo 17:9 \xt MRK 9:9; MAT 28:6; EZK 1:1; LUK 9:36; MRK 8:30; LUK 24:46-47\x*
\v 10 \w E|strong="G2532"\w* \w o interrogaram|strong="G1905,G846"\w* \w os discípulos|strong="G3588,G3101"\w*, \w dizendo|strong="G3004"\w*: \add “Por\add* \w que|strong="G5101"\w*, \w então|strong="G3767"\w*, \w os escribas|strong="G3588,G1122"\w* \w dizem|strong="G3004"\w* \w que|strong="G3754"\w* \w é necessário|strong="G1163"\w* \w que Elias|strong="G2243"\w* \w venha|strong="G2064"\w* \w primeiro|strong="G4413"\w*?”\f + \fr 17.10: \ft Acréscimo: “Por” (em “discípulos dizendo Por que então”): preposição ou artigo que a regência do português exige.\f*\x - \xo 17:10 \xt MRK 9:11; MAL 4:5; MAT 11:14; JHN 1:21; MAL 3:1; MRK 9:9\x*
\v 11 \w E ele|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: “\w Elias|strong="G2243"\w*, \w de fato|strong="G3303"\w*, \w vem|strong="G2064"\w* \w e|strong="G2532"\w* \w restaurará|strong="G600"\w* \w todas as coisas|strong="G3956"\w*;\f + \fr 17.11: \ft Nota cultural: ecoa Ml 3:23-24 (4:5-6): Elias volta antes do dia do Senhor.\f*\f + \fr 17.11: \ft Variante: o RP acrescenta Ἰησοῦς depois de δέ e αὐτοῖς (“lhes”) depois de “disse”; o TR e o RP trazem também πρῶτον (“primeiro”) depois de “vem”.\f*\x - \xo 17:11 \xt MAL 3:23-24; JHN 1:21; MRK 9:12; ACT 1:6; MAL 4:5; MAT 11:14\x*
\v 12 \w mas|strong="G1161"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w Elias|strong="G2243"\w* \w já|strong="G2235"\w* \w veio|strong="G2064"\w*, \w e|strong="G2532"\w* \w não o reconheceram|strong="G3756,G1921,G846"\w*, \w mas|strong="G235"\w* \w fizeram|strong="G4160"\w* \w com ele|strong="G1722,G846"\w* \w o que|strong="G3745"\w* \w quiseram|strong="G2309"\w*; \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w está para|strong="G3195"\w* \w sofrer|strong="G3958"\w* \w da parte deles|strong="G5259,G846"\w*.”\x - \xo 17:12 \xt MAT 11:14; MRK 9:13; MRK 9:12; MAL 4:5; LUK 1:17; MAT 16:21\x*
\v 13 \w Então|strong="G5119"\w* \w os discípulos|strong="G3588,G3101"\w* \w entenderam|strong="G4920"\w* \w que|strong="G3754"\w* \w a respeito de João|strong="G4012,G2491"\w* \w o Batista|strong="G3588,G910"\w* \w lhes falou|strong="G2036,G846"\w*.\x - \xo 17:13 \xt MAT 3:1; MRK 8:28; MAL 4:5; MAT 11:14; MAL 3:1; MRK 9:13\x*
\p
\v 14 \w E|strong="G2532"\w* \w tendo eles chegado|strong="G2064"\w* \w junto à multidão|strong="G4314,G3588,G3793"\w*, \w aproximou-se|strong="G4334"\w* \w dele|strong="G846"\w* \w um homem|strong="G444"\w*, \w ajoelhando-se|strong="G1120"\w* \w diante dele|strong="G846"\w*\x - \xo 17:14 \xt MRK 9:14; LUK 9:37; MRK 1:40; ACT 10:25-26; MRK 10:17\x*
\v 15 \w e|strong="G2532"\w* \w dizendo|strong="G3004"\w*: “\w Senhor|strong="G2962"\w*, \w tenha misericórdia|strong="G1653"\w* \w do meu filho|strong="G3165,G3588,G5207"\w*, \w porque|strong="G3754"\w* \w é epiléptico|strong="G4583"\w* \w e|strong="G2532"\w* \w sofre muito|strong="G2560,G3958"\w*; \w pois|strong="G1063"\w* \w muitas vezes|strong="G4178"\w* \w cai|strong="G4098"\w* \w no fogo|strong="G1519,G3588,G4442"\w* \w e|strong="G2532"\w* \w muitas vezes|strong="G4178"\w* \w na água|strong="G1519,G3588,G5204"\w*.\f + \fr 17.15: \ft Variante: WH e Treg trazem ἔχει (“está”, na expressão κακῶς ἔχει, “está mal”) em lugar de πάσχει (“sofre”), lido por NA28 e pelo RP.\f*\x - \xo 17:15 \xt MAT 9:27; MAT 4:24; LUK 9:37; MAT 15:22; MRK 9:14; LUK 6:18\x*
\v 16 \w E|strong="G2532"\w* \w o trouxe|strong="G4374,G846"\w* \w aos seus discípulos|strong="G3588,G3101,G4771"\w*, \w e|strong="G2532"\w* \w não puderam|strong="G3756,G1410"\w* \w curá-lo|strong="G846,G2323"\w*.”\x - \xo 17:16 \xt LUK 9:37; MRK 9:14; MAT 17:19-20; MRK 9:18\x*
\v 17 \w E Jesus|strong="G1161,G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: “\w Ó|strong="G5599"\w* \w geração|strong="G1074"\w* \w incrédula|strong="G571"\w* \w e|strong="G2532"\w* \w perversa|strong="G1294"\w*, \w até quando|strong="G2193,G4219"\w* \w estarei|strong="G1510"\w* \w com vocês|strong="G3326,G4771"\w*? \w Até quando|strong="G2193,G4219"\w* \w os suportarei|strong="G430,G4771"\w*? \w Tragam-no|strong="G5342,G846"\w* \w a mim|strong="G3165"\w* \w aqui|strong="G5602"\w*.”\f + \fr 17.17: \ft Nota cultural: ecoa a queixa de Dt 32:5 e 20 contra a geração perversa e infiel.\f*\x - \xo 17:17 \xt DEU 32:5; MRK 9:19; LUK 9:41; MAT 17:20; NUM 14:11; MAT 6:30\x*
\v 18 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w o repreendeu|strong="G2008,G846"\w*, \w e|strong="G2532"\w* \w saiu|strong="G1831"\w* \w dele|strong="G575,G846"\w* \w o demônio|strong="G3588,G1140"\w*; \w e|strong="G2532"\w* \w o menino|strong="G3588,G3816"\w* \w foi curado|strong="G2323"\w* \w desde aquela hora|strong="G575,G3588,G5610,G1565"\w*.\x - \xo 17:18 \xt LUK 9:37; MAT 4:24; MRK 9:14; MRK 9:25; MAT 9:22; MRK 1:34\x*
\v 19 \w Então|strong="G5119"\w* \w os discípulos|strong="G3588,G3101"\w*, \w aproximando-se|strong="G4334"\w* \w de Jesus|strong="G3588,G2424"\w*, \w à parte|strong="G2596,G2398"\w*, \w disseram|strong="G2036"\w*: “\w Por que|strong="G1223,G5101"\w* \w nós|strong="G3165"\w* \w não pudemos|strong="G3756,G1410"\w* \w expulsá-lo|strong="G1544,G846"\w*?”\x - \xo 17:19 \xt MRK 9:28; 1CO 12:9; LUK 9:37; ACT 3:16; MRK 9:14; MRK 9:18\x*
\v 20 \w E ele|strong="G3588,G1161"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Por causa|strong="G1223"\w* \w da pouca fé|strong="G3588,G6066"\w* \w de vocês|strong="G4771"\w*; \w pois em verdade|strong="G281,G1063"\w* \w lhes digo|strong="G3004,G4771"\w*: \w se|strong="G1437"\w* \w tiverem|strong="G2192"\w* \w fé|strong="G4102"\w* \w como um grão|strong="G5613,G2848"\w* \w de mostarda|strong="G4615"\w*, \w dirão|strong="G4483"\w* \w a este monte|strong="G3588,G3735,G3778"\w*: ‘\w Passe|strong="G3327"\w* \w daqui|strong="G6033"\w* \w para lá|strong="G1563"\w*’, \w e|strong="G2532"\w* \w passará|strong="G3327"\w*, \w e|strong="G2532"\w* \w nada|strong="G3762"\w* \w será impossível|strong="G101"\w* \w para vocês|strong="G4771"\w*.”\f + \fr 17.20: \ft Variante: o v. 21 (“Mas esta espécie só sai com oração e jejum”) não consta do SBLGNT, mas está no TR e em outros manuscritos (cf. Mc 9:29).\f*\x - \xo 17:20 \xt MRK 9:29; LUK 17:6; MRK 11:23; MAT 13:31; MRK 4:31; MRK 9:23\x*
\p
\v 22 \w E enquanto se reuniam|strong="G4962,G1161,G846"\w* \w na Galileia|strong="G1722,G3588,G1056"\w*, \w lhes disse|strong="G2036,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w O Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w está para|strong="G3195"\w* \w ser entregue|strong="G3860"\w* \w nas mãos|strong="G1519,G5495"\w* \w de seres humanos|strong="G444"\w*,\f + \fr 17.22: \ft Variante: o RP traz Ἀναστρεφομένων (“andando, permanecendo”) em lugar de Συστρεφομένων (“reunindo-se”).\f*\x - \xo 17:22 \xt LUK 9:44; MAT 16:21; LUK 24:6; LUK 18:31; MRK 8:31; MAT 17:23\x*
\v 23 \w e|strong="G2532"\w* \w o matarão|strong="G615,G846"\w*, \w e|strong="G2532"\w* \w ao terceiro dia|strong="G3588,G5154,G2250"\w* \w será ressuscitado|strong="G1453"\w*.” \w E|strong="G2532"\w* \w ficaram muito tristes|strong="G3076,G4970"\w*.\x - \xo 17:23 \xt MAT 16:21; MAT 26:22; LUK 24:6; MAT 12:40; MAT 17:22; MAT 28:6\x*
\p
\v 24 \w E tendo eles chegado|strong="G2064,G1161,G846"\w* \w a Cafarnaum|strong="G1519,G2584"\w*, \w aproximaram-se|strong="G4334"\w* \w de Pedro|strong="G3588,G4074"\w* \w os que cobravam|strong="G3588,G2983"\w* \w as duas dracmas|strong="G3588,G1323"\w* \w e|strong="G2532"\w* \w disseram|strong="G2036"\w*: “\w O mestre|strong="G3588,G1320"\w* \w de vocês|strong="G4771"\w* \w não|strong="G3756"\w* \w paga|strong="G5055"\w* \w as duas dracmas|strong="G3588,G1323"\w*?”\f + \fr 17.24: \ft Lit.: δίδραχμον, “didracma”, o imposto anual do templo de meio siclo (Êx 30:13; Ne 10:32).\f*\x - \xo 17:24 \xt EXO 30:13; NEH 10:32; EXO 38:26; ROM 13:6; MRK 9:33\x*
\v 25 \w Ele disse|strong="G3004"\w*: “\w Sim|strong="G3483"\w*.” \w E|strong="G2532"\w* \w tendo ele entrado|strong="G2064"\w* \w na casa|strong="G1519,G3588,G3614"\w*, \w se antecipou|strong="G4399"\w* \w a ele|strong="G846"\w* \w Jesus|strong="G3588,G2424"\w*, \w dizendo|strong="G3004"\w*: “\w O que|strong="G5101"\w* \w lhe parece|strong="G4771,G1380"\w*, \w Simão|strong="G4613"\w*? \w De quem|strong="G575,G5101"\w* \w os reis|strong="G3588,G935"\w* \w da terra|strong="G3588,G1093"\w* \w recebem|strong="G2983"\w* \w tributos|strong="G5056"\w* \w ou|strong="G2228"\w* \w imposto|strong="G2778"\w*? \w Dos seus filhos|strong="G575,G3588,G5207,G846"\w* \w ou|strong="G2228"\w* \w dos estranhos|strong="G575,G3588,G245"\w*?”\f + \fr 17.25: \ft Lit.: κῆνσος, “imposto individual (census)”; ἀλλότριοι, “estranhos, de fora (da família)”.\f*\f + \fr 17.25: \ft Tradução: τέλη (τέλος, G5056) está aqui como “tributos”; o termo pode ser “fim”, “término”, “objetivo”, “resultado” ou “imposto”, e o contexto decide.\f*\x - \xo 17:25 \xt MAT 22:17; ROM 13:7; MAT 22:21; ROM 13:6; MAT 22:19; 1SA 17:25\x*
\v 26 \w E tendo ele dito|strong="G2036,G1161"\w*: “\w Dos estranhos|strong="G575,G3588,G245"\w*”, \w lhe disse|strong="G5346,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Então|strong="G686,G1065"\w* \w os filhos|strong="G3588,G5207"\w* \w são|strong="G1510"\w* \w livres|strong="G1658"\w*.\x - \xo 17:26 \xt ROM 13:6; MRK 12:14; NEH 10:32; 1TH 5:22\x*
\v 27 \w Mas|strong="G1161"\w*, \w para que não|strong="G2443,G3361"\w* \w os escandalizemos|strong="G4624,G846"\w*, \w vá|strong="G4198"\w* \w ao mar|strong="G1519,G2281"\w*, \w lance|strong="G906"\w* \w o anzol|strong="G44"\w* \w e|strong="G2532"\w* \w tome|strong="G142"\w* \w o primeiro|strong="G4413"\w* \w peixe|strong="G2486"\w* \w que subir|strong="G3588,G305"\w*; \w e|strong="G2532"\w*, \w abrindo|strong="G455"\w* \w a boca|strong="G3588,G4750"\w* \w dele|strong="G846"\w*, \w encontrará|strong="G2147"\w* \w uma moeda de quatro dracmas|strong="G4715"\w*; \w tome-a|strong="G1565,G2983"\w* \add e\add* \w dê|strong="G1325"\w* \w a eles|strong="G846"\w* \w por mim|strong="G473,G1473"\w* \w e|strong="G2532"\w* \w por você|strong="G4771"\w*.”\f + \fr 17.27: \ft Lit.: στατήρ, “estáter”, moeda de quatro dracmas, suficiente para o imposto de duas pessoas.\f*\f + \fr 17.27: \ft Acréscimo: “e” (em “tome a e dê a”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 17:27 \xt 2CO 6:3; LUK 5:4; 1CO 8:9; 1CO 9:19-22; 2CO 8:9; 1CO 8:13\x*
\c 18
\p
\v 1 \w Naquela hora|strong="G1722,G1565,G3588,G5610"\w*, \w se aproximaram|strong="G4334"\w* \w de Jesus|strong="G3588,G2424"\w* \w os discípulos|strong="G3588,G3101"\w*, \w dizendo|strong="G3004"\w*: “\w Quem|strong="G5101"\w*, \w então|strong="G686"\w*, \w é|strong="G1510"\w* \w o maior|strong="G3173"\w* \w no reino|strong="G1722,G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w*?”\x - \xo 18:1 \xt MAT 5:3; MRK 9:33; LUK 9:46; MAT 20:20-28; LUK 22:24-27; PHP 2:3\x*
\v 2 \w E|strong="G2532"\w* \w chamando|strong="G4341"\w* \w uma criança|strong="G3813"\w*, \w colocou-a|strong="G2476,G846"\w* \w no meio|strong="G1722,G3319"\w* \w deles|strong="G846"\w*\x - \xo 18:2 \xt MRK 9:36; LUK 24:36; MAT 5:3; MAT 7:13; ROM 12:16; LUK 9:46\x*
\v 3 \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w*: \w se não|strong="G1437,G3361"\w* \w se converterem|strong="G4762"\w* \w e|strong="G2532"\w* \w se tornarem|strong="G1096"\w* \w como as crianças|strong="G5613,G3588,G3813"\w*, \w de modo algum|strong="G3756,G3361"\w* \w entrarão|strong="G1525"\w* \w no reino|strong="G1519,G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w*.\x - \xo 18:3 \xt MRK 10:15; LUK 18:17; MRK 10:14; MAT 7:21; MAT 19:14; JHN 3:5\x*
\v 4 \w Portanto|strong="G3767"\w*, \w quem|strong="G3748"\w* \w se humilhar|strong="G5013,G1438"\w* \w como|strong="G5613"\w* \w esta criança|strong="G3588,G3813,G3778"\w*, \w este|strong="G3778"\w* \w é|strong="G1510"\w* \w o maior|strong="G3588,G3173"\w* \w no reino|strong="G1722,G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w*;\x - \xo 18:4 \xt MAT 23:12; MRK 10:14; LUK 18:16; PRO 29:23; JAS 4:10; MRK 9:37\x*
\v 5 \w e|strong="G2532"\w* \w quem|strong="G3739,G1437"\w* \w receber|strong="G1209"\w* \w uma criança|strong="G1520,G3813"\w* \w como esta|strong="G5108"\w* \w em meu nome|strong="G1909,G3588,G3686,G3165"\w*, \w recebe a mim|strong="G1473,G1209"\w*.\x - \xo 18:5 \xt MRK 9:37; LUK 9:48; LUK 18:17; MRK 10:15; MAT 25:40; JHN 1:12\x*
\v 6 \w Mas|strong="G1161"\w* \w quem|strong="G3739,G302"\w* \w fizer tropeçar|strong="G4624"\w* \w um|strong="G1520"\w* \w destes pequeninos|strong="G3588,G3398,G3778"\w* \w que creem|strong="G3588,G4100"\w* \w em mim|strong="G1519,G1473"\w*, \w convém-lhe|strong="G4851,G846"\w* \w que se pendure|strong="G2443,G2910"\w* \w uma pedra de moinho|strong="G3458,G3684"\w* \w no seu pescoço|strong="G1519,G3588,G5137,G846"\w* \w e|strong="G2532"\w* \w seja afogado|strong="G2670"\w* \w no fundo|strong="G1722,G3588,G3989"\w* \w do mar|strong="G3588,G2281"\w*.\f + \fr 18.6: \ft Lit.: μύλος ὀνικός, “pedra de moinho de burro”, a mó grande que se movia com a força de um animal.\f*\f + \fr 18.6: \ft Variante: alguns manuscritos trazem περί (“ao redor do”) em lugar de εἰς antes de “pescoço”.\f*\x - \xo 18:6 \xt MRK 9:42; LUK 17:2; LUK 17:1-2; MAT 25:40; MAT 18:10; 2TH 1:6-9\x*
\v 7 \w Ai|strong="G3759"\w* \w do mundo|strong="G3588,G2889"\w* \w por causa dos escândalos|strong="G575,G3588,G4625"\w*! \w Pois|strong="G1063"\w* \w é inevitável|strong="G318"\w* \w que venham|strong="G2064"\w* \w os escândalos|strong="G3588,G4625"\w*; \w mas|strong="G4133"\w* \w ai|strong="G3759"\w* \w do ser humano|strong="G3588,G444"\w* \w por meio de quem|strong="G1223,G3739"\w* \w vem|strong="G2064"\w* \w o escândalo|strong="G3588,G4625"\w*.\f + \fr 18.7: \ft Acréscimo: verbo ser/estar suprido em “é inevitável”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 18:7 \xt LUK 17:1; 1CO 11:19; MAT 26:24; 1TI 4:1-3; JUD 1:4; ROM 16:17\x*
\v 8 \w Mas se|strong="G1487,G1161"\w* \w a sua mão|strong="G3588,G5495,G4771"\w* \w ou|strong="G2228"\w* \w o seu pé|strong="G3588,G4228,G4771"\w* \w faz você tropeçar|strong="G4624,G4771"\w*, \w corte-o|strong="G1581,G846"\w* \w e|strong="G2532"\w* \w jogue-o|strong="G906"\w* \w longe de você|strong="G575,G4771"\w*; \w é melhor|strong="G2570,G1510"\w* \w para você|strong="G4771"\w* \w entrar|strong="G1525"\w* \w na vida|strong="G1519,G3588,G2222"\w* \w aleijado|strong="G2948"\w* \w ou|strong="G2228"\w* \w coxo|strong="G5560"\w*, \w do que|strong="G2228"\w* \w tendo|strong="G2192"\w* \w duas mãos|strong="G1417,G5495"\w* \w ou|strong="G2228"\w* \w dois pés|strong="G1417,G4228"\w*, \w ser lançado|strong="G906"\w* \w no fogo|strong="G1519,G3588,G4442"\w* \w eterno|strong="G3588,G166"\w*.\f + \fr 18.8: \ft Variante: o RP traz αὐτά (“os”, plural) em lugar de αὐτόν (“o”); Treg e o RP trazem a ordem χωλὸν ἢ κυλλόν (“coxo ou aleijado”).\f*\x - \xo 18:8 \xt MRK 9:43; MRK 9:45; MAT 5:29; PHP 3:8-9; PRO 23:2; LUK 18:22-23\x*
\v 9 \w E|strong="G2532"\w* \w se|strong="G1487"\w* \w o seu olho|strong="G3588,G3788,G4771"\w* \w faz você tropeçar|strong="G4624,G4771"\w*, \w arranque-o|strong="G1807,G846"\w* \w e|strong="G2532"\w* \w jogue-o|strong="G906"\w* \w longe de você|strong="G575,G4771"\w*; \w é melhor|strong="G2570,G1510"\w* \w para você|strong="G4771"\w* \w entrar|strong="G1525"\w* \w na vida|strong="G1519,G3588,G2222"\w* \w com um só olho|strong="G3442"\w*, \w do que|strong="G2228"\w*, \w tendo|strong="G2192"\w* \w dois olhos|strong="G1417,G3788"\w*, \w ser lançado|strong="G906"\w* \w na geena|strong="G1519,G3588,G1067"\w* \w do fogo|strong="G3588,G4442"\w*.\x - \xo 18:9 \xt MRK 9:47; MAT 5:29; MRK 9:43; MRK 9:45; PRO 23:2; PSA 18:23\x*
\v 10 \w Cuidado|strong="G3708"\w* \w para não|strong="G3361"\w* \w desprezarem|strong="G2706"\w* \w um|strong="G1520"\w* \w destes pequeninos|strong="G3588,G3398,G3778"\w*; \w pois|strong="G1063"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w os anjos|strong="G3588,G32"\w* \w deles|strong="G846"\w* \w nos céus|strong="G1722,G3772"\w* \w sempre|strong="G1223,G3956"\w* \w veem|strong="G991"\w* \w a face|strong="G3588,G4383"\w* \w do meu Pai|strong="G3588,G3962,G3165"\w*, \w que está|strong="G3588,G1722"\w* \w nos céus|strong="G3772"\w*.\f + \fr 18.10: \ft Variante: o v. 11 (“Pois o Filho do Homem veio salvar o que estava perdido”) não consta do SBLGNT, mas está no TR e em outros manuscritos (cf. Lc 19:10).\f*\f + \fr 18.10: \ft Acréscimo: “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 18:10 \xt LUK 19:10; MAT 9:13; JHN 10:10; 1TI 4:12; PSA 91:11; PSA 34:7\x*
\v 12 \w O que|strong="G5101"\w* \w lhes parece|strong="G4771,G1380"\w*? \w Se|strong="G1437"\w* \w um homem|strong="G5100,G444"\w* \w tiver|strong="G1096"\w* \w cem ovelhas|strong="G1540,G4263"\w* \w e|strong="G2532"\w* \w uma|strong="G1520"\w* \w delas|strong="G1537,G846"\w* \w se desgarrar|strong="G4105"\w*, \w não|strong="G3780"\w* \w deixará|strong="G863"\w* \w as noventa e nove|strong="G3588,G1768,G1767"\w* \w nos montes|strong="G1909,G3588,G3735"\w* \w e|strong="G2532"\w*, \w indo|strong="G4198"\w*, \w procurará|strong="G2212"\w* \w a que se desgarrou|strong="G3588,G4105"\w*?\x - \xo 18:12 \xt LUK 15:4; MAT 9:13; 1PE 2:25; EZK 34:12; EZK 34:16; GAL 6:1\x*
\v 13 \w E|strong="G2532"\w* \w se|strong="G1437"\w* \w acontecer|strong="G1096"\w* \w de achá-la|strong="G2147,G846"\w*, \w em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w se alegra|strong="G5463"\w* \w por ela|strong="G1909,G846"\w* \w mais|strong="G3123"\w* \w do que|strong="G2228"\w* \w pelas noventa e nove|strong="G1909,G3588,G1768,G1767"\w* \w que não|strong="G3588,G3361"\w* \w se desgarraram|strong="G4105"\w*.\x - \xo 18:13 \xt LUK 15:4; LUK 15:7; MAT 9:13; GAL 6:1; ISA 53:6; EZK 34:4\x*
\v 14 \w Assim|strong="G3779"\w*, \w não|strong="G3756"\w* \w é|strong="G1510"\w* \w vontade|strong="G2307"\w* \w diante do Pai|strong="G1715,G3588,G3962"\w* \w de vocês|strong="G4771"\w*, \w que está|strong="G3588,G1722"\w* \w nos céus|strong="G3772"\w*, \w que se perca|strong="G2443,G622"\w* \w um só|strong="G1520"\w* \w destes pequeninos|strong="G3588,G3398,G3778"\w*.\f + \fr 18.14: \ft Variante: WH e Treg trazem μου (“do meu Pai”) em lugar de ὑμῶν (“de vocês”), lido por NA28 e pelo RP; o RP traz εἷς em lugar de ἕν (“um”).\f*\f + \fr 18.14: \ft Acréscimo: “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 18:14 \xt JHN 6:39; LUK 15:4; GAL 6:1; ISA 53:6; MAT 18:6; LUK 15:10\x*
\p
\v 15 \w Se|strong="G1437,G1161"\w* \w o seu irmão|strong="G3588,G80,G4771"\w* \w pecar|strong="G264"\w* \w contra você|strong="G1519,G4771"\w*, \w vá|strong="G5217"\w*, \w repreenda-o|strong="G1651,G846"\w* \w a sós|strong="G3441"\w*, \w entre você|strong="G3342,G4771"\w* \w e|strong="G2532"\w* \w ele|strong="G846"\w*; \w se|strong="G1437"\w* \w ele o ouvir|strong="G4771,G191"\w*, \add você\add* \w ganhou|strong="G2770"\w* \w o seu irmão|strong="G3588,G80,G4771"\w*;\f + \fr 18.15: \ft Acréscimo: “você” (em “o ouvir você ganhou o”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 18:15 \xt LEV 19:17; GAL 6:1; LUK 17:3; 2TH 3:15; COL 3:13; JAS 5:16\x*
\v 16 \w mas se|strong="G1437,G1161"\w* \w não|strong="G3361"\w* \w ouvir|strong="G191"\w*, \w leve|strong="G3880"\w* \w com você|strong="G3326,G4771"\w* \w ainda|strong="G2089"\w* \w um|strong="G1520"\w* \w ou|strong="G2228"\w* \w dois|strong="G1417"\w*, \w para que|strong="G2443"\w* \w pela boca|strong="G1909,G4750"\w* \w de duas|strong="G1417"\w* \w ou três|strong="G2228,G5140"\w* \w testemunhas|strong="G3144"\w* \w toda palavra|strong="G3956,G4487"\w* \w se estabeleça|strong="G2476"\w*;\f + \fr 18.16: \ft Nota cultural: cita Dt 19:15.\f*\x - \xo 18:16 \xt DEU 19:15; 2CO 13:1; 1TI 5:19; HEB 10:28; COL 3:13; JAS 5:16\x*
\v 17 \w e se|strong="G1437,G1161"\w* \w não os ouvir|strong="G3878,G846"\w*, \w diga|strong="G2036"\w* \w à comunidade|strong="G3588,G1577"\w*; \w e se|strong="G1437,G1161"\w* \w também|strong="G2532"\w* \w não ouvir|strong="G3878"\w* \w a comunidade|strong="G3588,G1577"\w*, \w seja|strong="G1510"\w* \w para você|strong="G4771"\w* \w como|strong="G5618"\w* \w o gentio|strong="G3588,G1482"\w* \w e|strong="G2532"\w* \w o cobrador de impostos|strong="G3588,G5057"\w*.\f + \fr 18.17: \ft Lit.: ἐκκλησία, “assembleia, comunidade”: nos evangelhos, só aparece aqui e em 16:18.\f*\x - \xo 18:17 \xt COL 3:13; JAS 5:16; 1CO 5:11; TIT 3:10; LUK 17:3; 2TH 3:6\x*
\v 18 \w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w*: \w tudo o que|strong="G3745,G1437"\w* \w vocês ligarem|strong="G1210"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w terá sido ligado|strong="G1510,G1210"\w* \w no céu|strong="G1722,G3772"\w*, \w e|strong="G2532"\w* \w tudo o que|strong="G3745,G1437"\w* \w desligarem|strong="G3089"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w terá sido desligado|strong="G1510,G3089"\w* \w no céu|strong="G1722,G3772"\w*.\x - \xo 18:18 \xt MAT 16:19; 1CO 7:27; 2CO 2:10; JHN 20:23; ISA 22:22; 1CO 5:4\x*
\v 19 \w De novo|strong="G3825"\w* \w em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w*, \w se|strong="G1437"\w* \w dois|strong="G1417"\w* \w de vocês|strong="G1537,G4771"\w* \w concordarem|strong="G4856"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w sobre qualquer|strong="G4012,G3956"\w* \w assunto|strong="G4229"\w* \w que|strong="G3739,G1437"\w* \w pedirem|strong="G154"\w*, \w será feito|strong="G1096"\w* \w a eles|strong="G846"\w* \w por meu Pai|strong="G3844,G3588,G3962,G3165"\w*, \w que está|strong="G3588,G1722"\w* \w nos céus|strong="G3772"\w*.\f + \fr 18.19: \ft Variante: a NIV omite ἀμήν (“em verdade”) no início do verso; o RP inverte a ordem de “dois de vocês concordarem” (ὑμῶν συμφωνήσωσιν).\f*\f + \fr 18.19: \ft Acréscimo: “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 18:19 \xt MRK 11:24; MAT 7:7; 1JN 5:14-16; MAT 21:22; JHN 14:13-14; JHN 16:23\x*
\v 20 \w Pois|strong="G1063"\w* \w onde|strong="G3757"\w* \w dois|strong="G1417"\w* \w ou|strong="G2228"\w* \w três|strong="G5140"\w* \w estão|strong="G1510"\w* \w reunidos|strong="G4863"\w* \w em meu nome|strong="G1519,G3588,G1473,G3686"\w*, \w ali|strong="G1563"\w* \w estou|strong="G1510"\w* \w no meio|strong="G1722,G3319"\w* \w deles|strong="G846"\w*.”\x - \xo 18:20 \xt 1CO 5:4; HEB 10:25; REV 21:3; MAT 28:20; ZEC 2:5; JHN 20:26\x*
\v 21 \w Então|strong="G5119"\w* \w Pedro|strong="G3588,G4074"\w*, \w aproximando-se|strong="G4334"\w* \w dele|strong="G846"\w*, \w disse|strong="G2036"\w*: “\w Senhor|strong="G2962"\w*, \w quantas vezes|strong="G4212"\w* \w pecará|strong="G264"\w* \w contra mim|strong="G1519,G1473"\w* \w o meu irmão|strong="G3588,G80,G3165"\w* \w e|strong="G2532"\w* \w lhe perdoarei|strong="G863,G846"\w*? \w Até|strong="G2193"\w* \w sete vezes|strong="G2034"\w*?”\x - \xo 18:21 \xt LUK 17:4; MAT 6:12; LUK 17:3; EPH 4:32; COL 3:13; MAT 6:14\x*
\v 22 \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Não|strong="G3756"\w* \w lhe digo|strong="G3004,G4771"\w* \w até|strong="G2193"\w* \w sete vezes|strong="G2034"\w*, \w mas|strong="G235"\w* \w até|strong="G2193"\w* \w setenta vezes|strong="G1441"\w* \w sete|strong="G2033"\w*.\f + \fr 18.22: \ft Lit.: ἑβδομηκοντάκις ἑπτά pode ser entendido como setenta e sete vezes (cf. Gn 4:24) ou setenta vezes sete (490); em qualquer caso, quer dizer “sempre”.\f*\x - \xo 18:22 \xt GEN 4:24; MAT 6:12; EPH 4:32; COL 3:13; MAT 6:14; MRK 11:25\x*
\p
\v 23 \w Por isso|strong="G1223,G3778"\w* \w o reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w foi comparado|strong="G3666"\w* \w a um rei|strong="G444,G935"\w*, \w que|strong="G3739"\w* \w quis|strong="G2309"\w* \w ajustar contas|strong="G4868,G3056"\w* \w com os seus escravos|strong="G3326,G3588,G1401,G846"\w*;\x - \xo 18:23 \xt MAT 25:19; LUK 13:20; MAT 22:2; MAT 6:12; EPH 4:32; COL 3:13\x*
\v 24 \w e tendo ele começado|strong="G757,G1161,G846"\w* \w a ajustar|strong="G4868"\w*, \w lhe foi apresentado|strong="G4374,G846"\w* \w um devedor|strong="G1520,G3781"\w* \w de dez mil|strong="G3463"\w* \w talentos|strong="G5007"\w*.\f + \fr 18.24: \ft Lit.: μύριοι τάλαντα, “dez mil talentos”: um talento valia cerca de seis mil denários, e dez mil talentos somam uma dívida impagável (cerca de sessenta milhões de denários).\f*\x - \xo 18:24 \xt MAT 6:12; EPH 4:32; COL 3:13; MAT 6:14; MRK 11:25; MAT 25:15\x*
\v 25 \w E como|strong="G1161"\w* \w ele|strong="G846"\w* \w não tinha|strong="G3361,G2192"\w* \w com que pagar|strong="G591"\w*, \w ordenou|strong="G2753"\w* \w o senhor|strong="G3588,G2962"\w* \w que fosse vendido|strong="G4097"\w* \w ele|strong="G846"\w*, \w e|strong="G2532"\w* \w a mulher|strong="G3588,G1135"\w* \w e|strong="G2532"\w* \w os filhos|strong="G3588,G5043"\w* \w e|strong="G2532"\w* \w tudo o que|strong="G3956,G3745"\w* \w tinha|strong="G2192"\w*, \w e|strong="G2532"\w* \w que se pagasse|strong="G591"\w*.\x - \xo 18:25 \xt MAT 6:12; EPH 4:32; COL 3:13; MAT 6:14; MRK 11:25; 2KI 4:1\x*
\v 26 \w Então|strong="G3767"\w* \w o escravo|strong="G3588,G1401"\w*, \w caindo|strong="G4098"\w*, \w prostrava-se|strong="G4352"\w* \w diante dele|strong="G846"\w*, \w dizendo|strong="G3004"\w*: ‘\w Tenha paciência|strong="G3114"\w* \w comigo|strong="G1909,G1473"\w*, \w e|strong="G2532"\w* \w pagarei|strong="G591"\w* \w tudo|strong="G3956"\w* \w a você|strong="G4771"\w*.’\f + \fr 18.26: \ft Tradução: προσεκύνει (προσκυνέω, G4352) está aqui como “prostrava-se”; o termo pode ser “adorar”, “prostrar-se” ou “prestar homenagem”, e o contexto decide.\f*\x - \xo 18:26 \xt MAT 18:29; MAT 4:9; MAT 6:12; EPH 4:32; COL 3:13; MAT 6:14\x*
\v 27 \w E movido de compaixão|strong="G4697,G1161"\w*, \w o senhor|strong="G3588,G2962"\w* \w daquele escravo|strong="G3588,G1401,G1565"\w*, \w o soltou|strong="G630,G846"\w* \w e|strong="G2532"\w* \w lhe perdoou|strong="G863,G846"\w* \w a dívida|strong="G3588,G1156"\w*.\x - \xo 18:27 \xt MAT 6:12; EPH 4:32; COL 3:13; MAT 6:14; MRK 11:25; PSA 145:8\x*
\v 28 \w Mas|strong="G1161"\w* \w aquele escravo|strong="G3588,G1401,G1565"\w*, \w saindo|strong="G1831"\w*, \w encontrou|strong="G2147"\w* \w um|strong="G1520"\w* \w dos seus|strong="G3588,G846"\w* \w companheiros de escravidão|strong="G4889"\w*, \w que|strong="G3739"\w* \w lhe devia|strong="G3784,G846"\w* \w cem|strong="G1540"\w* \w denários|strong="G1220"\w*, \w e|strong="G2532"\w*, \w agarrando-o|strong="G2902,G846"\w*, \w o sufocava|strong="G4155"\w*, \w dizendo|strong="G3004"\w*: ‘\w Pague|strong="G591"\w* \w o que|strong="G1487,G5100"\w* \w deve|strong="G3784"\w*.’\f + \fr 18.28: \ft Lit.: δηνάριον, “denário”, salário de um dia de trabalho; cem denários eram uma dívida pequena em comparação com os dez mil talentos.\f*\x - \xo 18:28 \xt MAT 6:12; EPH 4:32; COL 3:13; MAT 6:14; MRK 11:25; JAS 2:13\x*
\v 29 \w Então|strong="G3767"\w* \w o seu|strong="G846"\w* \w companheiro de escravidão|strong="G3588,G4889"\w*, \w caindo|strong="G4098"\w*, \w lhe suplicava|strong="G3870,G846"\w*, \w dizendo|strong="G3004"\w*: ‘\w Tenha paciência|strong="G3114"\w* \w comigo|strong="G1909,G1473"\w*, \w e|strong="G2532"\w* \w pagarei|strong="G591"\w* \w a você|strong="G4771"\w*.’\f + \fr 18.29: \ft Variante: o RP e o TR acrescentam εἰς τοὺς πόδας αὐτοῦ (“aos pés dele”) depois de “caindo”, e o TR acrescenta πάντα (“tudo”) depois de “e pagarei”; Treg traz ἐμέ em lugar de ἐμοί (“comigo”).\f*\x - \xo 18:29 \xt MAT 18:26; MAT 6:12; EPH 4:32; COL 3:13; MAT 6:14; MRK 11:25\x*
\v 30 \w Mas ele|strong="G3588,G1161"\w* \w não quis|strong="G3756,G2309"\w*, \w mas|strong="G235"\w*, \w indo|strong="G565"\w*, \w o lançou|strong="G906,G846"\w* \w na prisão|strong="G1519,G5438"\w* \w até que|strong="G2193,G3739"\w* \w pagasse|strong="G591"\w* \w o que devia|strong="G3588,G3784"\w*.\x - \xo 18:30 \xt MAT 18:34; MAT 6:12; EPH 4:32; COL 3:13; MAT 6:14; MRK 11:25\x*
\v 31 \w Vendo|strong="G1492"\w*, \w pois|strong="G3767"\w*, \w os seus|strong="G846"\w* \w companheiros de escravidão|strong="G3588,G4889"\w* \w o que acontecera|strong="G3588,G1096"\w*, \w ficaram muito tristes|strong="G3076,G4970"\w* \w e|strong="G2532"\w*, \w indo|strong="G2064"\w*, \w relataram|strong="G1285"\w* \w ao seu senhor|strong="G3588,G2962,G1438"\w* \w tudo o que acontecera|strong="G3956,G3588,G1096"\w*.\x - \xo 18:31 \xt MAT 6:12; EPH 4:32; COL 3:13; MAT 6:14; MRK 11:25; JAS 2:13\x*
\v 32 \w Então|strong="G5119"\w* \w chamando-o|strong="G4341,G846"\w*, \w o seu senhor|strong="G3588,G2962,G846"\w* \w lhe disse|strong="G3004,G846"\w*: ‘\w Escravo|strong="G1401"\w* \w mau|strong="G4190"\w*, \w perdoei|strong="G863"\w* \w a você|strong="G4771"\w* \w toda aquela dívida|strong="G3956,G3588,G3782,G1565"\w*, \w porque|strong="G1893"\w* \w me suplicou|strong="G3870,G3165"\w*;\x - \xo 18:32 \xt MAT 6:12; EPH 4:32; COL 3:13; MAT 6:14; MIC 6:8; MRK 11:25\x*
\v 33 \w não|strong="G3756"\w* \w devia|strong="G1163"\w* \w também|strong="G2532"\w* \w você|strong="G4771"\w* \w ter compaixão|strong="G1653"\w* \w do seu|strong="G4771"\w* \w companheiro de escravidão|strong="G3588,G4889"\w*, \w como|strong="G5613"\w* \w eu também|strong="G2532_B,G1473"\w* \w tive compaixão|strong="G1653"\w* \w de você|strong="G4771"\w*?’\x - \xo 18:33 \xt MAT 5:7; MAT 6:12; EPH 4:32; COL 3:13; MAT 6:14; MIC 6:8\x*
\v 34 \w E|strong="G2532"\w* \w o seu senhor|strong="G3588,G2962,G846"\w*, \w irado|strong="G3710"\w*, \w o entregou|strong="G3860,G846"\w* \w aos torturadores|strong="G3588,G930"\w*, \w até que|strong="G2193,G3739"\w* \w pagasse|strong="G591"\w* \w tudo o que devia|strong="G3956,G3588,G3784"\w*.\x - \xo 18:34 \xt MAT 18:30; MAT 5:7; MAT 6:12; EPH 4:32; COL 3:13; MAT 6:14\x*
\v 35 \w Assim|strong="G3779"\w* \w também|strong="G2532"\w* \w o meu Pai|strong="G3588,G3962,G3165"\w* \w celestial|strong="G3588,G3770"\w* \w fará|strong="G4160"\w* \w a vocês|strong="G4771"\w*, \w se|strong="G1437"\w* \w cada um|strong="G1538"\w* \w não|strong="G3361"\w* \w perdoar|strong="G863"\w* \w ao seu irmão|strong="G3588,G80,G846"\w* \w de coração|strong="G575,G3588,G2588,G4771"\w*.”\f + \fr 18.35: \ft Lit.: βασανιστής, “torturador, carcereiro que aplica tormento”.\f*\f + \fr 18.35: \ft Variante: o RP e o TR acrescentam τὰ παραπτώματα αὐτῶν (“as ofensas deles”) no fim do verso; o RP traz ἐπουράνιος em lugar de οὐράνιος (“celestial”).\f*\x - \xo 18:35 \xt MAT 6:14; MAT 5:7; MAT 6:12; MAT 6:15; EPH 4:32; COL 3:13\x*
\c 19
\p
\v 1 \w E|strong="G2532"\w* \w aconteceu que|strong="G1096"\w*, \w quando|strong="G3753"\w* \w Jesus|strong="G3588,G2424"\w* \w terminou|strong="G5055"\w* \w estas palavras|strong="G3588,G3056,G3778"\w*, \w partiu|strong="G3332"\w* \w da Galileia|strong="G575,G3588,G1056"\w* \w e|strong="G2532"\w* \w foi|strong="G2064"\w* \w para as regiões|strong="G1519,G3588,G3725"\w* \w da Judeia|strong="G3588,G2449"\w*, \w do outro lado|strong="G4008"\w* \w do Jordão|strong="G3588,G2446"\w*.\x - \xo 19:1 \xt MAT 13:53; JHN 10:40; MAT 19:1\x*
\v 2 \w E|strong="G2532"\w* \w o seguiram|strong="G190,G846"\w* \w muitas multidões|strong="G4183,G3793"\w*, \w e|strong="G2532"\w* \w as curou|strong="G2323,G846"\w* \w ali|strong="G1563"\w*.\x - \xo 19:2 \xt MAT 12:15; MAT 19:1; MAT 8:1\x*
\v 3 \w E|strong="G2532"\w* \w aproximaram-se|strong="G4334"\w* \w dele|strong="G846"\w* \w fariseus|strong="G5330"\w*, \w pondo-o à prova|strong="G3985,G846"\w* \w e|strong="G2532"\w* \w dizendo|strong="G3004"\w*: “\w É permitido|strong="G1487,G1832"\w* \w a um homem|strong="G444"\w* \w despedir|strong="G630"\w* \w a sua mulher|strong="G3588,G1135,G846"\w* \w por qualquer|strong="G2596,G3956"\w* \w motivo|strong="G156"\w*?”\x - \xo 19:3 \xt MRK 10:2; GEN 2:24; 1PE 3:7; MAL 2:16; MAT 5:31; 1CO 7:10\x*
\v 4 \w E ele|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: “\w Não|strong="G3756"\w* \w leram|strong="G314"\w* \w que|strong="G3754"\w* \w o Criador|strong="G3588,G2936"\w*, \w desde o princípio|strong="G575,G746"\w*, \w os fez|strong="G4160,G846"\w* \w homem|strong="G730"\w* \w e|strong="G2532"\w* \w mulher|strong="G2338"\w*,\f + \fr 19.4: \ft Lit.: ἄρσεν καὶ θῆλυ, “macho e fêmea”, palavras de Gn 1:27.\f*\f + \fr 19.4: \ft Variante: o RP acrescenta αὐτοῖς (“lhes”) depois de “disse” e traz ποιήσας (“fez”) em lugar de κτίσας (“criou”, traduzido aqui “o Criador”).\f*\x - \xo 19:4 \xt GEN 1:27; GEN 2:24; MRK 10:6; GEN 2:23; 1PE 3:7; GEN 5:2\x*
\v 5 \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: ‘\w Por isso|strong="G1752,G3778"\w* \w deixará|strong="G2641"\w* \w o ser humano|strong="G444"\w* \w o pai|strong="G3588,G3962"\w* \w e|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w* \w e|strong="G2532"\w* \w se unirá|strong="G2853"\w* \w à sua mulher|strong="G3588,G1135,G846"\w*, \w e|strong="G2532"\w* \w os dois|strong="G3588,G1417"\w* \w serão|strong="G1510"\w* \w uma só|strong="G1519,G1520"\w* \w carne|strong="G4561"\w*’?\f + \fr 19.5: \ft Nota cultural: cita Gn 2:24.\f*\x - \xo 19:5 \xt GEN 2:24; MRK 10:7; EPH 5:31; 1CO 6:16; GEN 2:21-24; 1PE 3:7\x*
\v 6 \w Assim|strong="G5620"\w*, \w já não|strong="G2089,G3756"\w* \w são|strong="G1510"\w* \w dois|strong="G1417"\w*, \w mas|strong="G235"\w* \w uma só|strong="G1520"\w* \w carne|strong="G4561"\w*. \w O que|strong="G3739"\w*, \w portanto|strong="G3767"\w*, \w Deus|strong="G3588,G2316"\w* \w uniu|strong="G4801"\w*, \w o ser humano|strong="G444"\w* \w não separe|strong="G3361,G5563"\w*.”\f + \fr 19.6: \ft Lit.: συζεύγνυμι, “pôr sob o mesmo jugo, unir”.\f*\x - \xo 19:6 \xt MRK 10:9; GEN 2:24; MRK 10:8; 1PE 3:7; MAL 2:15; MAL 2:16\x*
\v 7 \w Disseram-lhe|strong="G3004,G846"\w*: \add “Por\add* \w que|strong="G5101"\w*, \w então|strong="G3767"\w*, \w Moisés|strong="G3475"\w* \w ordenou|strong="G1781"\w* \w dar|strong="G1325"\w* \w certidão|strong="G975"\w* \w de divórcio|strong="G647"\w* \w e|strong="G2532"\w* \w despedi-la|strong="G630,G846"\w*?”\f + \fr 19.7: \ft Nota cultural: refere-se a Dt 24:1-4.\f*\f + \fr 19.7: \ft Acréscimo: “Por” (em “Disseram lhe Por que então”): preposição ou artigo que a regência do português exige.\f*\x - \xo 19:7 \xt DEU 24:1; MRK 10:4; MAT 5:31; GEN 2:24; JHN 8:5; MRK 10:3\x*
\v 8 \w Disse-lhes|strong="G3004,G846"\w*: “\w Moisés|strong="G3475"\w*, \w por causa|strong="G4314"\w* \w da dureza de coração|strong="G3588,G4641"\w* \w de vocês|strong="G4771"\w*, \w permitiu|strong="G2010"\w* \w a vocês|strong="G4771"\w* \w despedir|strong="G630"\w* \w as suas mulheres|strong="G3588,G1135,G4771"\w*; \w mas|strong="G1161"\w* \w desde o princípio|strong="G575,G746"\w* \w não foi|strong="G3756,G1096"\w* \w assim|strong="G3779"\w*.\x - \xo 19:8 \xt GEN 2:24; 1PE 3:7; MAT 5:32; MAL 2:16; DEU 24:1; 1CO 7:10\x*
\v 9 \w E|strong="G1161"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w quem|strong="G3739,G302"\w* \w despedir|strong="G630"\w* \w a sua mulher|strong="G3588,G1135,G846"\w*, \w a não ser|strong="G3361,G1909"\w* \w por imoralidade sexual|strong="G4202"\w*, \w e|strong="G2532"\w* \w se casar|strong="G1060"\w* \w com outra|strong="G243"\w*, \w comete adultério|strong="G3429"\w*; \w e|strong="G2532"\w* \w o que|strong="G3588"\w* \w se casar|strong="G1060"\w* \w com a mulher despedida|strong="G630"\w*, \w comete adultério|strong="G3429"\w*\f + \fr 19.9: \ft Variante: Treg omite ὅτι (“que”); o trecho “e o que se casar com a divorciada comete adultério” consta de Treg e do RP, mas WH e NA28 o omitem.\f*\f + \fr 19.9: \ft Lit.: πορνεία, “imoralidade sexual”; o sentido exato da exceção (infidelidade, união ilícita) é debatido.\f*.”\x - \xo 19:9 \xt MRK 10:11; MAT 5:32; GEN 2:24; MRK 10:12; LUK 16:18; 1PE 3:7\x*
\v 10 \w Disseram-lhe|strong="G3004,G846"\w* \w os discípulos|strong="G3588,G3101"\w*: “\w Se|strong="G1487"\w* \w assim|strong="G3779"\w* \w é a situação|strong="G1510,G3588,G156"\w* \w do homem|strong="G3588,G444"\w* \w com a mulher|strong="G3326,G3588,G1135"\w*, \w não convém|strong="G3756,G4851"\w* \w casar|strong="G1060"\w*.”\x - \xo 19:10 \xt 1CO 7:1; 1CO 7:32-35; LUK 14:20\x*
\v 11 \w Mas ele|strong="G3588,G1161"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Nem todos|strong="G3756,G3956"\w* \w aceitam|strong="G5562"\w* \w esta palavra|strong="G3588,G3056,G3778"\w*, \w mas|strong="G235"\w* \w aqueles a quem|strong="G3739"\w* \w foi concedido|strong="G1325"\w*.\x - \xo 19:11 \xt MAT 13:11; 1CO 7:7; 1CO 7:17; 1CO 7:1; 1CO 7:2; 1CO 7:35\x*
\v 12 \w Pois|strong="G1063"\w* \w há|strong="G1510"\w* \w eunucos|strong="G2135"\w* \w que|strong="G3748"\w* \w nasceram|strong="G1080"\w* \w assim|strong="G3779"\w* \w do ventre|strong="G1537,G2836"\w* \w da mãe|strong="G3384"\w*, \w e|strong="G2532"\w* \w há|strong="G1510"\w* \w eunucos|strong="G2135"\w* \w que|strong="G3748"\w* \w foram feitos eunucos|strong="G2134"\w* \w pelos seres humanos|strong="G5259,G3588,G444"\w*, \w e|strong="G2532"\w* \w há|strong="G1510"\w* \w eunucos|strong="G2135"\w* \w que|strong="G3748"\w* \w se fizeram eunucos|strong="G2134,G1438"\w* \w por causa|strong="G1223"\w* \w do reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w*. \w Quem pode|strong="G3588,G1410"\w* \w aceitar|strong="G5562"\w*, \w aceite|strong="G5562"\w*.”\x - \xo 19:12 \xt 1CO 7:32-38; 1CO 7:7; MAT 5:29; 1CO 9:5; ISA 56:3; 1CO 7:17\x*
\p
\v 13 \w Então|strong="G5119"\w* \w lhe foram trazidas|strong="G4374,G846"\w* \w crianças|strong="G3813"\w*, \w para que|strong="G2443"\w* \w impusesse|strong="G2007"\w* \w as mãos|strong="G3588,G5495"\w* \w sobre elas|strong="G846"\w* \w e|strong="G2532"\w* \w orasse|strong="G4336"\w*; \w mas os discípulos|strong="G3588,G1161,G3101"\w* \w as repreenderam|strong="G2008,G846"\w*.\x - \xo 19:13 \xt MRK 10:13; LUK 18:15; ACT 8:17; ACT 13:3; MAT 18:2; ISA 56:3\x*
\v 14 \w Mas Jesus|strong="G3588,G1161,G2424"\w* \w disse|strong="G2036"\w*: “\w Deixem|strong="G863"\w* \w as crianças|strong="G3588,G3813"\w* \w e|strong="G2532"\w* \w não as impeçam|strong="G3361,G2967,G846"\w* \w de vir|strong="G2064"\w* \w a mim|strong="G4314,G3165"\w*, \w pois|strong="G1063"\w* \w o reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w é|strong="G1510"\w* \w dos que são como elas|strong="G3588,G5108"\w*.”\f + \fr 19.14: \ft Acréscimo: verbo ser/estar suprido em “dos que são como elas”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 19:14 \xt LUK 18:16; MRK 10:14; MAT 18:3; MRK 10:13; 1CO 14:20; LUK 18:15\x*
\v 15 \w E|strong="G2532"\w*, \w impondo-lhes|strong="G2007,G846"\w* \w as mãos|strong="G3588,G5495"\w*, \w partiu|strong="G4198"\w* \w dali|strong="G1564"\w*.\x - \xo 19:15 \xt ACT 8:17; ACT 8:19; MRK 10:13; LUK 18:15; ISA 56:3; MRK 9:36\x*
\p
\v 16 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w alguém|strong="G1520"\w*, \w aproximando-se|strong="G4334"\w* \w dele|strong="G846"\w*, \w disse|strong="G2036"\w*: “\w Mestre|strong="G1320"\w*, \w que coisa boa|strong="G5101,G18"\w* \w farei|strong="G4160"\w* \w para que|strong="G2443"\w* \w tenha|strong="G2192"\w* \w a vida|strong="G2222"\w* \w eterna|strong="G166"\w*?”\f + \fr 19.16: \ft Variante: o TR e o RP acrescentam ἀγαθέ (“bom”) depois de “Mestre”, trazem a ordem εἶπεν αὐτῷ (“lhe disse”) e ἔχω (“tenha”) em lugar de σχῶ.\f*\x - \xo 19:16 \xt LUK 18:18; MRK 10:17; JHN 3:15; LUK 10:25; 1JN 5:11; JHN 6:47\x*
\v 17 \w E ele|strong="G3588,G1161"\w* \w lhe disse|strong="G2036,G846"\w*: \add “Por\add* \w que|strong="G5101"\w* \w me pergunta|strong="G3165,G2065"\w* \w sobre|strong="G4012"\w* \w o que é bom|strong="G3588,G18"\w*? \w Um só|strong="G1520"\w* \w é|strong="G1510"\w* \w o Bom|strong="G3588,G18"\w*; \w mas se|strong="G1487,G1161"\w* \w quer|strong="G2309"\w* \w entrar|strong="G1525"\w* \w na vida|strong="G1519,G3588,G2222"\w*, \w guarde|strong="G5083"\w* \w os mandamentos|strong="G3588,G1785"\w*.”\f + \fr 19.17: \ft Variante: o TR traz “Por que me chama de bom? Ninguém é bom, senão um só, Deus” (Τί με λέγεις ἀγαθόν; οὐδεὶς ἀγαθὸς εἰ μὴ εἷς ὁ θεός) em lugar de “Por que me pergunta sobre o que é bom? Um só é o Bom” (cf. Mc 10:18; Lc 18:19).\f*\f + \fr 19.17: \ft Acréscimo: “Por” (em “lhe disse Por que me”): preposição ou artigo que a regência do português exige; verbo ser/estar suprido em “o que é bom”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 19:17 \xt MRK 10:18; LUK 18:19; 1JN 2:3; JHN 14:15; MRK 10:17; LEV 18:5\x*
\v 18 \w Ele lhe disse|strong="G3004,G846"\w*: “\w Quais|strong="G4169"\w*?” \w E Jesus|strong="G3588,G1161,G2424"\w* \w disse|strong="G2036"\w*: “\w Não|strong="G3588,G3756"\w* \w matará|strong="G5407"\w*, \w não|strong="G3756"\w* \w cometerá adultério|strong="G3431"\w*, \w não|strong="G3756"\w* \w furtará|strong="G2813"\w*, \w não|strong="G3756"\w* \w dará falso testemunho|strong="G5576"\w*,\x - \xo 19:18 \xt LUK 18:20; MRK 10:19; ROM 13:9; JAS 2:11; MRK 10:17; EXO 20:16\x*
\v 19 \w honre|strong="G5091"\w* \w o pai|strong="G3588,G3962"\w* \w e|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w*, \w e|strong="G2532"\w*: \w amará|strong="G25"\w* \w o seu próximo|strong="G3588,G4139,G4771"\w* \w como a si mesmo|strong="G5613,G4771"\w*.”\f + \fr 19.19: \ft Nota cultural: reúne Êx 20:12-16 (Dt 5:16-20) e Lv 19:18.\f*\x - \xo 19:19 \xt EXO 20:12; LEV 19:18; DEU 5:16; MAT 22:39; GAL 5:14; LUK 10:27\x*
\v 20 \w Disse-lhe|strong="G3004,G846"\w* \w o jovem|strong="G3588,G3495"\w*: “\w Tudo isto|strong="G3956,G3778"\w* \w guardei|strong="G5442"\w*; \w o que|strong="G5101"\w* \w ainda|strong="G2089"\w* \w me falta|strong="G5302"\w*?”\f + \fr 19.20: \ft Variante: o RP e o TR trazem ἐφυλαξάμην ἐκ νεότητός μου (“guardei desde a minha juventude”) e a ordem Ταῦτα πάντα em WH e Treg (NA28 e o RP trazem Πάντα ταῦτα).\f*\x - \xo 19:20 \xt MRK 10:17; JHN 5:39; LUK 18:18; MAT 13:22; GAL 3:24; ISA 56:3\x*
\v 21 \w Disse-lhe|strong="G5346,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Se|strong="G1487"\w* \w quer|strong="G2309"\w* \w ser perfeito|strong="G5046,G1511"\w*, \w vá|strong="G5217"\w*, \w venda|strong="G4453"\w* \w os seus bens|strong="G4771,G3588,G5225"\w* \w e|strong="G2532"\w* \w dê|strong="G1325"\w* \w aos pobres|strong="G4434"\w*, \w e|strong="G2532"\w* \w terá|strong="G2192"\w* \w um tesouro|strong="G2344"\w* \w nos céus|strong="G1722,G3772"\w*; \w e|strong="G2532"\w* \w venha|strong="G1204"\w*, \w siga-me|strong="G190,G3165"\w*.”\x - \xo 19:21 \xt MRK 10:21; LUK 18:22; MAT 13:44; MRK 10:17; MAT 6:20; LUK 12:33\x*
\v 22 \w E o jovem|strong="G1161,G3588,G3495"\w*, \w ouvindo|strong="G191"\w* \w a palavra|strong="G3588,G3056"\w*, \w foi embora|strong="G565"\w* \w triste|strong="G3076"\w*, \w pois|strong="G1063"\w* \w tinha|strong="G1510,G2192"\w* \w muitas|strong="G4183"\w* \w propriedades|strong="G2933"\w*.\x - \xo 19:22 \xt MRK 10:22; MRK 10:17; JHN 6:66; EZK 33:31; MAT 6:24; LUK 18:18\x*
\p
\v 23 \w E Jesus|strong="G3588,G1161,G2424"\w* \w disse|strong="G2036"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w*: “\w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w um rico|strong="G4145"\w* \w dificilmente|strong="G1423"\w* \w entrará|strong="G1525"\w* \w no reino|strong="G1519,G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w*;\x - \xo 19:23 \xt MRK 10:23; LUK 18:24; MAT 18:3; JHN 3:5; MRK 10:17; 1TI 6:9-10\x*
\v 24 \w e de novo|strong="G3825,G1161"\w* \w lhes digo|strong="G3004,G4771"\w*: \w é mais fácil|strong="G2123,G1510"\w* \w um camelo|strong="G2574"\w* \w entrar|strong="G1525"\w* \w pelo buraco|strong="G1223,G5169"\w* \w de uma agulha|strong="G4476"\w* \w do que|strong="G2228"\w* \w um rico|strong="G4145"\w* \add entrar\add* \w no reino|strong="G1519,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.”\f + \fr 19.24: \ft Nota cultural: a imagem do camelo e da agulha é hipérbole para o impossível humano (cf. v. 26).\f*\f + \fr 19.24: \ft Variante: o SBLGNT lê εἰσελθεῖν (“entrar”) pelo buraco da agulha, como WH e Treg; NA28, o TR e o RP trazem διελθεῖν (“passar através”); WH traz τρήματος em lugar de τρυπήματος; a segunda oração (“entrar no reino de Deus”) é construída diferentemente em NA28 e no RP.\f*\f + \fr 19.24: \ft Acréscimo: “entrar” (em “um rico entrar no reino”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 19:24 \xt MRK 10:25; LUK 18:25; MRK 10:17; JER 13:23; JHN 5:44; MAT 7:21\x*
\v 25 \w E os discípulos|strong="G1161,G3588,G3101"\w*, \w ouvindo|strong="G191"\w*, \w ficaram muito atônitos|strong="G1605,G4970"\w*, \w dizendo|strong="G3004"\w*: “\w Quem|strong="G5101"\w*, \w então|strong="G686"\w*, \w pode|strong="G1410"\w* \w ser salvo|strong="G4982"\w*?”\x - \xo 19:25 \xt MRK 10:26; MRK 10:17; JER 13:23; MRK 10:25; LUK 18:18; ISA 56:3\x*
\v 26 \w E Jesus|strong="G1161,G3588,G2424"\w*, \w olhando para eles|strong="G1689,G846"\w*, \w disse|strong="G2036"\w*: “\w Para os seres humanos|strong="G3844,G444"\w* \w isso|strong="G3778"\w* \w é|strong="G1510"\w* \w impossível|strong="G102"\w*, \w mas|strong="G1161"\w* \w para Deus|strong="G3844,G2316"\w* \w todas as coisas|strong="G3956"\w* \w são possíveis|strong="G1415"\w*.”\f + \fr 19.26: \ft Acréscimo: verbo ser/estar suprido em “são possíveis”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 19:26 \xt MRK 10:27; LUK 18:27; JER 32:27; LUK 1:37; JOB 42:2; JER 32:17\x*
\v 27 \w Então|strong="G5119"\w* \w Pedro|strong="G3588,G4074"\w*, \w respondendo|strong="G611"\w*, \w lhe disse|strong="G2036,G846"\w*: “\w Olhe|strong="G2400"\w*, \w nós|strong="G3165"\w* \w deixamos|strong="G863"\w* \w tudo|strong="G3956"\w* \w e|strong="G2532"\w* \w o seguimos|strong="G190,G4771"\w*; \w o que|strong="G5101"\w*, \w então|strong="G686"\w*, \w haverá|strong="G1510"\w* \w para nós|strong="G3165"\w*?”\x - \xo 19:27 \xt MRK 10:28; LUK 18:28; LUK 5:11; MAT 4:20; MRK 1:18; MRK 10:17\x*
\v 28 \w E Jesus|strong="G3588,G1161,G2424"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w vocês|strong="G4771"\w*, \w os que me seguiram|strong="G3588,G190,G3165"\w*, \w na regeneração|strong="G1722,G3588,G3824"\w*, \w quando|strong="G3752"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w se assentar|strong="G2523"\w* \w no trono|strong="G1909,G2362"\w* \w da sua glória|strong="G1391,G846"\w*, \w também vocês|strong="G2532,G4771"\w* \w se assentarão|strong="G2521"\w* \w sobre doze|strong="G1909,G1427"\w* \w tronos|strong="G2362"\w*, \w julgando|strong="G2919"\w* \w as doze|strong="G3588,G1427"\w* \w tribos|strong="G5443"\w* \w de Israel|strong="G3588,G2474"\w*.\f + \fr 19.28: \ft Lit.: παλιγγενεσία, “regeneração, renovação, novo nascimento” (do mundo, na vinda do Filho do Homem).\f*\f + \fr 19.28: \ft Variante: Treg e o RP trazem καθίσεσθε em lugar de καθήσεσθε (“se assentarão”), e Treg traz αὐτοί em lugar de ὑμεῖς.\f*\f + \fr 19.28: \ft Lit.: ἐν τῇ παλιγγενεσίᾳ (“na regeneração”) pode ligar-se a “os que me seguiram” ou a “se assentarão”; o grego permite as duas ligações.\f*\x - \xo 19:28 \xt MAT 25:31; LUK 22:30; REV 3:21; MRK 10:17; 1CO 6:2; REV 20:4\x*
\v 29 \w E|strong="G2532"\w* \w todo aquele|strong="G3956,G3748"\w* \w que deixou|strong="G863"\w* \w casas|strong="G3614"\w*, \w ou|strong="G2228"\w* \w irmãos|strong="G80"\w*, \w ou|strong="G2228"\w* \w irmãs|strong="G79"\w*, \w ou|strong="G2228"\w* \w pai|strong="G3962"\w*, \w ou|strong="G2228"\w* \w mãe|strong="G3384"\w*, \w ou|strong="G2228"\w* \w mulher|strong="G1135"\w*, \w ou|strong="G2228"\w* \w filhos|strong="G5043"\w*, \w ou|strong="G2228"\w* \w campos|strong="G68"\w*, \w por causa|strong="G1752"\w* \w do meu nome|strong="G3588,G3686,G3165"\w*, \w receberá|strong="G2983"\w* \w cem vezes mais|strong="G1542"\w* \w e|strong="G2532"\w* \w herdará|strong="G2816"\w* \w a vida|strong="G2222"\w* \w eterna|strong="G166"\w*.\f + \fr 19.29: \ft Variante: o RP traz ὅς em lugar de ὅστις; Treg omite οἰκίας ἢ (“casas, ou”) e traz “ou casas” depois de “campos”; WH traz ἐμοῦ ὀνόματος em lugar de ὀνόματός μου, e WH e Treg trazem πολλαπλασίονα (“muitas vezes mais”) em lugar de ἑκατονταπλασίονα (“cem vezes mais”); “ou mulher” (γυναῖκα ἢ) consta só do RP e do SBLGNT.\f*\x - \xo 19:29 \xt MRK 10:29; LUK 18:29; LUK 14:26; MAT 6:33; MRK 10:30; PHP 3:8\x*
\v 30 \w Mas|strong="G1161"\w* \w muitos|strong="G4183"\w* \w primeiros|strong="G4413"\w* \w serão|strong="G1510"\w* \w últimos|strong="G2078"\w* \w e|strong="G2532"\w* \w os últimos|strong="G2078"\w*, \w primeiros|strong="G4413"\w*.”\x - \xo 19:30 \xt MAT 20:16; MRK 10:31; LUK 13:30; MRK 10:17; MRK 10:28; LUK 18:29\x*
\c 20
\p
\v 1 “\w Pois|strong="G1063"\w* \w o reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w é|strong="G1510"\w* \w semelhante|strong="G3664"\w* \w a um homem|strong="G444"\w* \w dono de casa|strong="G3617"\w* \w que|strong="G3748"\w* \w saiu|strong="G1831"\w* \w de madrugada|strong="G260,G4404"\w* \w para contratar|strong="G3409"\w* \w trabalhadores|strong="G2040"\w* \w para a sua vinha|strong="G1519,G3588,G290,G846"\w*.\f + \fr 20.1: \ft Nota cultural: a vinha é, nas Escrituras, imagem frequente de Israel (Is 5:1-7).\f*\x - \xo 20:1 \xt ISA 5:1-7; JHN 15:1; MAT 13:24; MAT 25:1; MAT 13:47; HEB 13:21\x*
\v 2 \w E|strong="G1161"\w*, \w tendo combinado|strong="G4856"\w* \w com os trabalhadores|strong="G3326,G3588,G2040"\w* \w um denário|strong="G1537,G1220"\w* \w por dia|strong="G3588,G2250"\w*, \w os enviou|strong="G649,G846"\w* \w para a sua vinha|strong="G1519,G3588,G290,G846"\w*.\f + \fr 20.2: \ft Lit.: δηνάριον, “denário”, moeda de prata que era o salário comum de um dia de trabalho.\f*\x - \xo 20:2 \xt MAT 18:28; 1CO 3:9; MAT 22:1; 2TI 3:15; EXO 19:5-6; JOB 7:1\x*
\v 3 \w E|strong="G2532"\w*, \w saindo|strong="G1831"\w* \w por volta|strong="G4012"\w* \w da terceira hora|strong="G5154,G5610"\w*, \w viu|strong="G1492"\w* \w outros|strong="G243"\w* \w que estavam parados|strong="G2476"\w* \w na praça|strong="G1722,G3588,G58"\w*, \w desocupados|strong="G692"\w*,\f + \fr 20.3: \ft Lit.: τρίτη ὥρα, “terceira hora”, por volta das nove da manhã; o dia era contado desde o nascer do sol.\f*\x - \xo 20:3 \xt 1TI 5:13; 1CO 3:9; MAT 22:1; JOB 7:1; PRO 19:15\x*
\v 4 \w e|strong="G2532"\w* \w àqueles|strong="G1565"\w* \w disse|strong="G2036"\w*: ‘\w Vão|strong="G5217"\w* \w vocês também|strong="G2532,G4771"\w* \w para a vinha|strong="G1519,G3588,G290"\w*, \w e|strong="G2532"\w* \w o que|strong="G3739,G1437"\w* \w for|strong="G1510"\w* \w justo|strong="G1342"\w* \w darei|strong="G1325"\w* \w a vocês|strong="G4771"\w*.’\x - \xo 20:4 \xt MAT 20:7; 1CO 3:9; MAT 22:1; 1PE 4:2-3; JOB 7:1\x*
\v 5 \w E eles|strong="G3588,G1161"\w* \w foram|strong="G565"\w*. \w De novo|strong="G3825"\w*, \w saindo|strong="G1831"\w* \w por volta|strong="G4012"\w* \w da sexta|strong="G1623"\w* \w e|strong="G2532"\w* \w da nona|strong="G1766"\w* \w hora|strong="G5610"\w*, \w fez|strong="G4160"\w* \w o mesmo|strong="G5615"\w*.\x - \xo 20:5 \xt MAT 27:45; MRK 15:33; LUK 23:44; ACT 3:1; 1CO 3:9; MAT 22:1\x*
\v 6 \w E por volta|strong="G4012,G1161"\w* \w da décima primeira|strong="G3588,G1734"\w* \add hora,\add* \w saindo|strong="G1831"\w*, \w encontrou|strong="G2147"\w* \w outros|strong="G243"\w* \w que estavam parados|strong="G2476"\w*, \w e|strong="G2532"\w* \w disse|strong="G3004"\w* \w a eles|strong="G846"\w*: \add ‘Por\add* \w que|strong="G5101"\w* \w estão aqui|strong="G5602,G2476"\w* \w o dia inteiro|strong="G3650,G3588,G2250"\w* \w desocupados|strong="G692"\w*?’\f + \fr 20.6: \ft Variante: o RP e o TR trazem ὥραν (“hora”) depois de “décima primeira” e acrescentam ἀργούς (“desocupados”) depois de “parados”; WH, Treg e NA28 não os trazem.\f*\f + \fr 20.6: \ft Acréscimo: “hora” (em “décima primeira hora saindo encontrou”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; “Por” (em “a eles Por que estão”): preposição ou artigo que a regência do português exige.\f*\x - \xo 20:6 \xt JHN 9:4; JOS 18:3; 1CO 3:9; MAT 22:1; ACT 17:21; HEB 6:12\x*
\v 7 \w Disseram-lhe|strong="G3004,G846"\w*: ‘\w Porque|strong="G3754"\w* \w ninguém|strong="G3762"\w* \w nos contratou|strong="G3165,G3409"\w*.’ \w Disse-lhes|strong="G3004,G846"\w*: ‘\w Vão|strong="G5217"\w* \w vocês também|strong="G2532,G4771"\w* \w para a vinha|strong="G1519,G3588,G290"\w*.’\f + \fr 20.7: \ft Variante: o RP e o TR acrescentam καὶ ὃ ἐὰν ᾖ δίκαιον λήψεσθε (“e o que for justo receberão”) no fim da ordem de ir à vinha.\f*\x - \xo 20:7 \xt MAT 20:4; 1CO 3:9; EPH 2:11-12; HEB 6:10; MAT 22:1; ACT 17:30-31\x*
\v 8 \w E chegada a tarde|strong="G3798,G1161,G1096"\w*, \w disse|strong="G3004"\w* \w o dono|strong="G3588,G2962"\w* \w da vinha|strong="G3588,G290"\w* \w ao seu administrador|strong="G3588,G2012,G846"\w*: ‘\w Chame|strong="G2564"\w* \w os trabalhadores|strong="G3588,G2040"\w* \w e|strong="G2532"\w* \w pague-lhes|strong="G591,G846"\w* \w o salário|strong="G3588,G3408"\w*, \w começando|strong="G757"\w* \w pelos últimos|strong="G575,G3588,G2078"\w* \w até os primeiros|strong="G2193,G3588,G4413"\w*.’\f + \fr 20.8: \ft Lit.: μισθός, “pagamento, salário” (aqui, o pagamento do dia de trabalho); κύριος, “senhor, dono”; ἐπίτροπος, “administrador, encarregado”.\f*\x - \xo 20:8 \xt DEU 24:15; 1CO 3:9; 1PE 4:10; MAT 22:1; JOB 7:1; ROM 2:6-10\x*
\v 9 \w E|strong="G2532"\w*, \w chegando|strong="G2064"\w* \w os de por volta da|strong="G3588,G4012"\w* \w décima primeira|strong="G1734"\w* \w hora|strong="G5610"\w*, \w receberam|strong="G2983"\w* \w um denário|strong="G1220"\w* \w cada um|strong="G303"\w*.\x - \xo 20:9 \xt 1CO 3:9; EPH 2:8-10; MAT 22:1; ROM 4:3-6; EPH 1:6-8; JOB 7:1\x*
\v 10 \w E|strong="G2532"\w*, \w chegando|strong="G2064"\w* \w os primeiros|strong="G3588,G4413"\w*, \w pensaram|strong="G3543"\w* \w que|strong="G3754"\w* \w receberiam|strong="G2983"\w* \w mais|strong="G4119"\w*; \w e|strong="G2532"\w* \w receberam|strong="G2983"\w* \w também eles|strong="G2532,G846"\w* \w um denário cada um|strong="G3588,G303,G1220"\w*.\x - \xo 20:10 \xt 1CO 3:9; MAT 19:27; MAT 22:1; JOB 7:1\x*
\v 11 \w E|strong="G1161"\w*, \w ao receberem|strong="G2983"\w*, \w murmuravam|strong="G1111"\w* \w contra o dono de casa|strong="G2596,G3588,G3617"\w*,\x - \xo 20:11 \xt PHP 2:14; ISA 58:3; JOB 40:2; LUK 19:7; 1CO 3:9; 1TH 2:16\x*
\v 12 \w dizendo|strong="G3004"\w*: ‘\w Estes|strong="G3778"\w* \w últimos|strong="G3588,G2078"\w* \w trabalharam|strong="G4160"\w* \w uma hora|strong="G1520,G5610"\w*, \w e|strong="G2532"\w* \w você os fez|strong="G846,G4160"\w* \w iguais|strong="G2470"\w* \w a nós|strong="G3165"\w*, \w que suportamos|strong="G3588,G941"\w* \w o peso|strong="G3588,G922"\w* \w do dia|strong="G3588,G2250"\w* \w e|strong="G2532"\w* \w o calor ardente|strong="G3588,G2742"\w*.’\f + \fr 20.12: \ft Lit.: καύσων, “calor abrasador” (o vento quente do deserto ou o calor do meio-dia).\f*\x - \xo 20:12 \xt ROM 11:5-6; ISA 58:3; 1CO 3:9; 2CO 11:23-28; MAT 19:27; MAT 22:1\x*
\v 13 \w Mas ele|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w* \w a um|strong="G1520"\w* \w deles|strong="G846"\w*: ‘\w Amigo|strong="G2083"\w*, \w não|strong="G3756"\w* \w lhe faço injustiça|strong="G91,G4771"\w*; \w não|strong="G3780"\w* \w combinou|strong="G4856"\w* \w comigo|strong="G3165"\w* \w um denário|strong="G1220"\w*?\f + \fr 20.13: \ft Lit.: ἑταῖρος, “companheiro, amigo” (tratamento cortês, que pode trazer certa distância).\f*\x - \xo 20:13 \xt MAT 22:12; MAT 26:50; ROM 9:14-15; LUK 15:31; 1CO 3:9; MAT 22:1\x*
\v 14 \w Pegue|strong="G142"\w* \w o que é seu|strong="G3588,G4771"\w* \w e|strong="G2532"\w* \w vá|strong="G5217"\w*; \w e|strong="G1161"\w* \w quero|strong="G2309"\w* \w dar|strong="G1325"\w* \w a este|strong="G3778,G3588"\w* \w último|strong="G2078"\w* \w tanto quanto|strong="G5613,G2532"\w* \w a você|strong="G4771"\w*.\f + \fr 20.14: \ft Acréscimo: verbo ser/estar suprido em “o que é seu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 20:14 \xt JHN 6:67; JHN 17:2; LUK 15:31; 1CO 3:9; MAT 22:1; 2KI 10:30-31\x*
\v 15 \w Não me é permitido|strong="G3756,G1832,G3165"\w* \w fazer|strong="G4160"\w* \w o que quero|strong="G3739,G2309"\w* \w com o que é meu|strong="G1722,G3588,G1473"\w*? \w Ou|strong="G2228"\w* \w o seu olho|strong="G3588,G3788,G4771"\w* \w é|strong="G1510"\w* \w mau|strong="G4190"\w* \w porque|strong="G3754"\w* \w eu|strong="G1473"\w* \w sou|strong="G1510"\w* \w bom|strong="G18"\w*?’\f + \fr 20.15: \ft Lit.: “olho mau” é expressão semítica para a inveja ou a avareza (cf. Pv 23:6; Mt 6:23).\f*\f + \fr 20.15: \ft Variante: WH e Treg trazem οὐκ, enquanto NA28 e o RP trazem Ἢ οὐκ (“Ou não…?”); o RP inverte a ordem de “fazer o que quero” e traz Εἰ (“se”) em lugar de ἤ.\f*\f + \fr 20.15: \ft Acréscimo: verbo ser/estar suprido em “com o que é meu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 20:15 \xt MAT 6:23; PRO 23:6; JER 18:6; LUK 23:43; ROM 9:15-24; JON 4:4\x*
\v 16 \w Assim|strong="G3779"\w* \w os últimos|strong="G3588,G2078"\w* \w serão|strong="G1510"\w* \w primeiros|strong="G4413"\w* \w e|strong="G2532"\w* \w os primeiros|strong="G3588,G4413"\w* \w últimos|strong="G2078"\w*.”\f + \fr 20.16: \ft Variante: Treg, o TR e o RP acrescentam “pois muitos são chamados, mas poucos escolhidos” (πολλοὶ γὰρ εἰσιν κλητοί, ὀλίγοι δὲ ἐκλεκτοί; cf. 22:14); WH e NA28 não a trazem.\f*\x - \xo 20:16 \xt MAT 19:30; MRK 10:31; LUK 13:30; 1CO 15:45; MAT 22:14; MAT 7:14\x*
\p
\v 17 \w E|strong="G2532"\w*, \w subindo|strong="G305"\w* \w Jesus|strong="G3588,G2424"\w* \w a Jerusalém|strong="G1519,G2414"\w*, \w tomou consigo|strong="G3880"\w* \w os doze|strong="G3588,G1427"\w* \w discípulos|strong="G3101"\w* \w à parte|strong="G2596,G2398"\w*, \w e|strong="G2532"\w* \w no caminho|strong="G1722,G3588,G3598"\w* \w lhes disse|strong="G2036,G846"\w*:\f + \fr 20.17: \ft Variante: WH traz Μέλλων δὲ ἀναβαίνειν (“estando para subir”) em lugar de “E, subindo”; Treg omite “discípulos”; o RP traz a ordem ἐν τῇ ὁδῷ καὶ.\f*\x - \xo 20:17 \xt LUK 18:31; MRK 10:32; ACT 21:15; JHN 1:11; MAT 16:21; MAT 17:22\x*
\v 18 “\w Olhem|strong="G2400"\w*, \w subimos|strong="G305"\w* \w a Jerusalém|strong="G1519,G2414"\w*, \w e|strong="G2532"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w será entregue|strong="G3860"\w* \w aos chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w escribas|strong="G1122"\w*, \w e|strong="G2532"\w* \w o condenarão|strong="G2632,G846"\w* \w à morte|strong="G2288"\w*,\x - \xo 20:18 \xt MRK 10:33; ACT 21:15; LUK 18:31; HEB 12:2; MAT 16:21; MRK 10:32\x*
\v 19 \w e|strong="G2532"\w* \w o entregarão|strong="G3860,G846"\w* \w aos gentios|strong="G3588,G1484"\w* \w para zombar|strong="G1519,G3588,G1702"\w* \w e|strong="G2532"\w* \w açoitar|strong="G3146"\w* \w e|strong="G2532"\w* \w crucificar|strong="G4717"\w*, \w e|strong="G2532"\w* \w ao terceiro dia|strong="G3588,G5154,G2250"\w* \w será ressuscitado|strong="G1453"\w*.”\x - \xo 20:19 \xt MAT 26:2; LUK 18:33; LUK 18:31; HEB 12:2; MAT 16:21; JHN 18:32\x*
\p
\v 20 \w Então|strong="G5119"\w* \w se aproximou|strong="G4334"\w* \w dele|strong="G846"\w* \w a mãe|strong="G3588,G3384"\w* \w dos filhos|strong="G3588,G5207"\w* \w de Zebedeu|strong="G2199"\w* \w com os seus filhos|strong="G3326,G3588,G5207,G846"\w*, \w prostrando-se|strong="G4352"\w* \w e|strong="G2532"\w* \w pedindo|strong="G154"\w* \w algo|strong="G5100"\w* \w da parte dele|strong="G3844,G846"\w*.\f + \fr 20.20: \ft Variante: WH, Treg e NA28 trazem ἀπʼ αὐτοῦ em lugar de παρʼ αὐτοῦ (“da parte dele”), lido pelo SBLGNT e pelo RP; o sentido é o mesmo.\f*\f + \fr 20.20: \ft Tradução: προσκυνοῦσα (προσκυνέω, G4352) está aqui como “prostrando-se”; o termo pode ser “adorar”, “prostrar-se” ou “prestar homenagem”, e o contexto decide.\f*\x - \xo 20:20 \xt MRK 10:35; MAT 27:56; MAT 18:1; HEB 12:2; EST 5:3; LUK 9:46\x*
\v 21 \w Ele|strong="G3588,G1161"\w* \w lhe disse|strong="G2036,G846"\w*: \add “O\add* \w que|strong="G5101"\w* \w quer|strong="G2309"\w*?” \w Ela lhe disse|strong="G3004,G846"\w*: “\w Diga|strong="G2036"\w* \w que se assentem|strong="G2443,G2523"\w* \w estes meus|strong="G3778,G3165"\w* \w dois filhos|strong="G3588,G1417,G5207"\w*, \w um|strong="G1520"\w* \w à sua direita|strong="G1537,G1188,G4771"\w* \w e|strong="G2532"\w* \w um|strong="G1520"\w* \w à sua esquerda|strong="G1537,G2176,G4771"\w* \w no seu reino|strong="G1722,G3588,G932,G4771"\w*.”\f + \fr 20.21: \ft Acréscimo: “O” (em “lhe disse O que quer”): preposição ou artigo que a regência do português exige.\f*\x - \xo 20:21 \xt MRK 10:40; MRK 15:27; MAT 20:23; MAT 27:38; MAT 25:33; MRK 10:35\x*
\v 22 \w E Jesus|strong="G1161,G3588,G2424"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: “\w Não|strong="G3756"\w* \w sabem|strong="G6063"\w* \w o que|strong="G5101"\w* \w pedem|strong="G154"\w*. \w Podem|strong="G1410"\w* \w beber|strong="G4095"\w* \w o cálice|strong="G3588,G4221"\w* \w que eu|strong="G3739,G1473"\w* \w estou para|strong="G3195"\w* \w beber|strong="G4095"\w*?” \w Disseram-lhe|strong="G3004,G846"\w*: “\w Podemos|strong="G1410"\w*.”\f + \fr 20.22: \ft Nota cultural: o “cálice” é, nas Escrituras, imagem do destino determinado por Deus, de bênção ou de sofrimento (Sl 75:8; Is 51:17; cf. Mt 26:39).\f*\f + \fr 20.22: \ft Variante: o RP e o TR acrescentam ἢ τὸ βάπτισμα ὃ ἐγὼ βαπτίζομαι βαπτισθῆναι (“ou ser batizados com o batismo com que eu sou batizado”) depois de “beber”.\f*\x - \xo 20:22 \xt MAT 26:39; ISA 51:17; PSA 75:8; MRK 10:38; JHN 18:11; MRK 10:39\x*
\v 23 \w Disse-lhes|strong="G3004,G846"\w*: “\w O meu cálice|strong="G3588,G4221,G3165"\w* \w de fato|strong="G3303"\w* \w beberão|strong="G4095"\w*; \w mas o assentar-se|strong="G3588,G1161,G2523"\w* \w à minha direita|strong="G1537,G1188,G3165"\w* \w e|strong="G2532"\w* \w à esquerda|strong="G1537,G2176"\w* \w não|strong="G3756"\w* \w cabe a mim|strong="G1510,G1473"\w* \w dar|strong="G1325"\w*, \w mas|strong="G235"\w* \w àqueles para quem|strong="G3739"\w* \w foi preparado|strong="G2090"\w* \w por meu Pai|strong="G5259,G3588,G3962,G3165"\w*.”\f + \fr 20.23: \ft Variante: o RP e o TR acrescentam “e serão batizados com o batismo com que eu sou batizado” (καὶ τὸ βάπτισμα ὃ ἐγὼ βαπτίζομαι βαπτισθήσεσθε) depois de “beberão”; o RP traz Καὶ λέγει e μου depois de εὐωνύμων; NA28 acrescenta τοῦτο (“isto”) depois de ἐμόν.\f*\x - \xo 20:23 \xt MRK 10:40; MAT 20:21; MAT 25:33; 1CO 2:9; MRK 10:35; MAT 18:1\x*
\v 24 \w E|strong="G2532"\w*, \w ouvindo isso|strong="G191"\w*, \w os dez|strong="G3588,G1176"\w* \w se indignaram|strong="G23"\w* \w a respeito|strong="G4012"\w* \w dos dois|strong="G3588,G1417"\w* \w irmãos|strong="G80"\w*.\x - \xo 20:24 \xt MRK 10:41; MRK 10:35; MAT 18:1; ROM 12:16; 1PE 5:5; 3JN 1:9\x*
\v 25 \w Mas Jesus|strong="G3588,G1161,G2424"\w*, \w chamando-os|strong="G4341,G846"\w*, \w disse|strong="G2036"\w*: “\w Sabem|strong="G6063"\w* \w que|strong="G3754"\w* \w os governantes|strong="G3588,G758"\w* \w das nações|strong="G3588,G1484"\w* \w as dominam|strong="G2634,G846"\w* \w e|strong="G2532"\w* \w os grandes|strong="G3588,G3173"\w* \w exercem autoridade sobre elas|strong="G2715,G846"\w*.\f + \fr 20.25: \ft Lit.: κατακυριεύω, “dominar como senhor”; κατεξουσιάζω, “exercer autoridade sobre alguém”.\f*\x - \xo 20:25 \xt MRK 10:42; MRK 9:35; LUK 22:25; MRK 10:35; MAT 18:1; MAT 20:25\x*
\v 26 \w Não|strong="G3756"\w* \w será assim|strong="G3779,G1510"\w* \w entre vocês|strong="G1722,G4771"\w*; \w mas|strong="G235"\w* \w quem quiser|strong="G3739,G302,G2309"\w* \w tornar-se grande|strong="G3173,G1096"\w* \w entre vocês|strong="G1722,G4771"\w*, \w será|strong="G1510"\w* \w servidor de vocês|strong="G4771,G1249"\w*,\f + \fr 20.26: \ft Lit.: διάκονος, “servidor, auxiliar que serve à mesa”.\f*\f + \fr 20.26: \ft Variante: WH e Treg trazem ἐστίν em lugar de ἔσται; NA28 e o RP trazem ἐάν em lugar de ἄν; o RP traz δὲ ἔσται (“mas será”).\f*\x - \xo 20:26 \xt MRK 10:43; MAT 23:11; MRK 9:35; JHN 2:5; PHP 2:5; 1PE 5:3\x*
\v 27 \w e|strong="G2532"\w* \w quem quiser|strong="G3739,G302,G2309"\w* \w ser o primeiro|strong="G1511,G4413"\w* \w entre vocês|strong="G1722,G4771"\w*, \w será|strong="G1510"\w* \w escravo de vocês|strong="G4771,G1401"\w*;\x - \xo 20:27 \xt MRK 10:44; MRK 9:35; MRK 10:43; PHP 2:5; MRK 10:35; MAT 18:1\x*
\v 28 \add assim\add* \w como|strong="G5618"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w não|strong="G3756"\w* \w veio|strong="G2064"\w* \w para ser servido|strong="G1247"\w*, \w mas|strong="G235"\w* \w para servir|strong="G1247"\w* \w e|strong="G2532"\w* \w dar|strong="G1325"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w como resgate|strong="G3083"\w* \w em lugar de|strong="G473"\w* \w muitos|strong="G4183"\w*.”\f + \fr 20.28: \ft Lit.: λύτρον, “resgate”, o preço pago para libertar um cativo ou escravo; ἀντί, “em lugar de, em troca de”.\f*\f + \fr 20.28: \ft Acréscimo: “assim” (em “assim como o”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 20:28 \xt MRK 10:45; ISA 53:5; JHN 10:10; PHP 2:7; PHP 2:5; 2CO 8:9\x*
\p
\v 29 \w E|strong="G2532"\w*, \w saindo eles|strong="G1607,G846"\w* \w de Jericó|strong="G575,G2410"\w*, \w seguiu-o|strong="G190,G846"\w* \w uma grande multidão|strong="G3793,G4183"\w*.\x - \xo 20:29 \xt MRK 10:46; MAT 8:1; LUK 18:35; MAT 9:27-31\x*
\v 30 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w dois|strong="G1417"\w* \w cegos|strong="G5185"\w* \w sentados|strong="G2521"\w* \w à beira|strong="G3844"\w* \w do caminho|strong="G3588,G3598"\w*, \w ao ouvirem|strong="G191"\w* \w que|strong="G3754"\w* \w Jesus|strong="G2424"\w* \w passava|strong="G3855"\w*, \w gritaram|strong="G2896"\w*, \w dizendo|strong="G3004"\w*: “\w Senhor|strong="G2962"\w*, \w tenha misericórdia|strong="G1653"\w* \w de nós|strong="G3165"\w*, \w Filho de Davi|strong="G5207,G1138"\w*!”\f + \fr 20.30: \ft Variante: WH, Treg e a NIV trazem Κύριε, ἐλέησον ἡμᾶς (como o SBLGNT), enquanto NA28 e o RP trazem Ἐλέησον ἡμᾶς, κύριε; a NIV traz o vocativo υἱὲ (“filho”); Tyn acrescenta Ἰησοῦ (“Jesus”).\f*\x - \xo 20:30 \xt MAT 9:27; JHN 9:1; MRK 10:46; LUK 18:35; ISA 35:5; LUK 17:13\x*
\v 31 \w Mas a multidão|strong="G3588,G1161,G3793"\w* \w os repreendeu|strong="G2008,G846"\w* \w para que se calassem|strong="G2443,G4623"\w*; \w mas eles|strong="G3588,G1161"\w* \w gritaram|strong="G2896"\w* \add mais\add* \w alto|strong="G3173"\w*, \w dizendo|strong="G3004"\w*: “\w Senhor|strong="G2962"\w*, \w tenha misericórdia|strong="G1653"\w* \w de nós|strong="G3165"\w*, \w Filho de Davi|strong="G5207,G1138"\w*!”\f + \fr 20.31: \ft Variante: o RP traz ἔκραζον (“gritavam”) em lugar de ἔκραξαν (“gritaram”), e NA28 e o RP trazem a ordem Ἐλέησον ἡμᾶς, κύριε.\f*\f + \fr 20.31: \ft Acréscimo: “mais” (em “eles gritaram mais alto dizendo”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 20:31 \xt MRK 10:48; LUK 18:39; MAT 9:27; ISA 35:5; MRK 10:46; LUK 17:13\x*
\v 32 \w E|strong="G2532"\w*, \w parando|strong="G2476"\w*, \w Jesus|strong="G3588,G2424"\w* \w os chamou|strong="G5455,G846"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w O que|strong="G5101"\w* \w querem|strong="G2309"\w* \w que eu faça|strong="G4160"\w* \w a vocês|strong="G4771"\w*?”\x - \xo 20:32 \xt MRK 10:49; MAT 27:47; ISA 35:5; MRK 10:46; EZK 36:37; PHP 4:6\x*
\v 33 \w Disseram-lhe|strong="G3004,G846"\w*: “\w Senhor|strong="G2962"\w*, \w que se abram|strong="G2443,G455"\w* \w os nossos olhos|strong="G3588,G3788,G3165"\w*.”\x - \xo 20:33 \xt JHN 9:10; JHN 9:26; JHN 11:37; JHN 9:17; JHN 9:32; JHN 9:14\x*
\v 34 \w E Jesus|strong="G1161,G3588,G2424"\w*, \w movido de compaixão|strong="G4697"\w*, \w tocou|strong="G681"\w* \w os olhos|strong="G3588,G3659"\w* \w deles|strong="G846"\w*, \w e|strong="G2532"\w* \w imediatamente|strong="G2112"\w* \w voltaram a ver|strong="G308"\w* \w e|strong="G2532"\w* \w o seguiram|strong="G190,G846"\w*.\x - \xo 20:34 \xt ISA 35:5; MRK 10:46; MAT 9:29; HEB 4:15-16; LUK 22:51; MRK 10:49\x*
\c 21
\p
\v 1 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w se aproximaram|strong="G1448"\w* \w de Jerusalém|strong="G1519,G2414"\w* \w e|strong="G2532"\w* \w chegaram|strong="G2064"\w* \w a Betfagé|strong="G1519,G967"\w*, \w ao Monte|strong="G1519,G3588,G3735"\w* \w das Oliveiras|strong="G3588,G1636"\w*, \w então|strong="G5119"\w* \w Jesus|strong="G2424"\w* \w enviou|strong="G649"\w* \w dois|strong="G1417"\w* \w discípulos|strong="G3101"\w*,\x - \xo 21:1 \xt MRK 11:1; LUK 19:29; JHN 8:1; MAT 26:30; MRK 14:26; LUK 22:39\x*
\v 2 \w dizendo-lhes|strong="G3004,G846"\w*: “\w Vão|strong="G4198"\w* \w ao povoado|strong="G1519,G3588,G2968"\w* \w que está|strong="G3588"\w* \w em frente|strong="G2713"\w* \w de vocês|strong="G4771"\w*, \w e|strong="G2532"\w* \w imediatamente|strong="G2112"\w* \w encontrarão|strong="G2147"\w* \w uma jumenta|strong="G3688"\w* \w amarrada|strong="G1210"\w* \w e|strong="G2532"\w* \w um jumentinho|strong="G4454"\w* \w com ela|strong="G3326,G846"\w*; \w desamarrando-os|strong="G3089"\w*, \w tragam-nos|strong="G71"\w* \w a mim|strong="G3165"\w*.\f + \fr 21.2: \ft Acréscimo: “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 21:2 \xt MRK 11:2; LUK 19:30; JHN 12:14; MRK 11:1; JHN 2:5-8; LUK 19:29\x*
\v 3 \w E|strong="G2532"\w* \w se alguém|strong="G1437,G5100"\w* \w lhes disser|strong="G4771,G2036"\w* \w algo|strong="G5100"\w*, \w dirão|strong="G4483"\w*: ‘\w O Senhor|strong="G3588,G2962"\w* \w precisa|strong="G5532,G2192"\w* \w deles|strong="G846"\w*’; \w e|strong="G1161"\w* \w logo|strong="G2112"\w* \w os enviará|strong="G649,G846"\w*.”\x - \xo 21:3 \xt LUK 19:31; MRK 11:3; MRK 11:2; JHN 12:14; MRK 11:1; 2CO 8:1-2\x*
\v 4 \w E|strong="G1161"\w* \w isto|strong="G3778"\w* \w aconteceu|strong="G1096"\w* \w para que se cumprisse|strong="G2443,G4137"\w* \w o que foi dito|strong="G3588,G2046"\w* \w por meio do profeta|strong="G1223,G3588,G4396"\w*, \w dizendo|strong="G3004"\w*:\x - \xo 21:4 \xt MAT 1:22; MAT 12:17; ACT 2:16; MAT 4:14; MAT 2:15; MAT 13:35\x*
\q1
\v 5 “\w Digam|strong="G2036"\w* \w à filha|strong="G3588,G2364"\w* \w de Sião|strong="G4622"\w*: \w Olhem|strong="G2400"\w*, \w o seu rei|strong="G3588,G935,G4771"\w* \w vem|strong="G2064"\w* \w a você|strong="G4771"\w*, \w manso|strong="G4235"\w* \w e|strong="G2532"\w* \w montado|strong="G1910"\w* \w sobre uma jumenta|strong="G1909,G3688"\w* \w e|strong="G2532"\w* \w sobre um jumentinho|strong="G1909,G4454"\w*, \w filho|strong="G5207"\w* \w de animal de carga|strong="G5268"\w*.”\f + \fr 21.5: \ft Nota cultural: cita Is 62:11 e Zc 9:9.\f*\f + \fr 21.5: \ft Lit.: ὑποζύγιον, “animal de carga” (literalmente, “o que está sob o jugo”).\f*\x - \xo 21:5 \xt ZEC 9:9; ISA 62:11; JHN 12:15; ISA 12:6; ISA 9:6-7; MAT 5:5\x*
