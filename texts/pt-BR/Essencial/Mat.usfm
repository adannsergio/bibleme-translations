\c 23
\p
\v 1 \w Então|strong="G5119"\w* \w Jesus|strong="G3588,G2424"\w* \w falou|strong="G2980"\w* \w às multidões|strong="G3588,G3793"\w* \w e|strong="G2532"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w*,\x - \xo 23:1 \xt MRK 12:38; LUK 12:1; LUK 20:45; MAT 15:10-20; LUK 12:57\x*
\v 2 \w dizendo|strong="G3004"\w*: “\w Na cadeira|strong="G1909,G3588,G2515"\w* \w de Moisés|strong="G3475"\w* \w se assentaram|strong="G2523"\w* \w os escribas|strong="G3588,G1122"\w* \w e|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w*.\f + \fr 23.2: \ft Lit.: καθέδρα Μωϋσέως, “cadeira de Moisés”, o lugar de quem tem autoridade para ensinar a Lei.\f*\x - \xo 23:2 \xt MAT 15:1; MAT 5:20; LUK 11:46; LUK 20:46; MRK 12:38; MAL 2:7\x*
\v 3 \w Tudo o que|strong="G3956,G3745,G1437"\w*, \w pois|strong="G3767"\w*, \w lhes disserem|strong="G2036,G4771"\w*, \w façam|strong="G4160"\w* \w e|strong="G2532"\w* \w guardem|strong="G5083"\w*; \w mas conforme|strong="G2596,G1161"\w* \w as obras|strong="G3588,G2041"\w* \w deles|strong="G846"\w* \w não|strong="G3361"\w* \w façam|strong="G4160"\w*, \w pois|strong="G1063"\w* \w dizem|strong="G3004"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w fazem|strong="G4160"\w*.\f + \fr 23.3: \ft Variante: Treg traz ἄν em lugar de ἐάν; o RP e o TR trazem τηρεῖν τηρεῖτε καὶ ποιεῖτε (“guardar: guardem e façam”) em lugar de “façam e guardem” (ποιήσατε καὶ τηρεῖτε).\f*\x - \xo 23:3 \xt MAT 5:20; LUK 11:46; ROM 2:21; 2TI 3:5; MRK 12:38; ROM 2:19-24\x*
\v 4 \w E amarram|strong="G1195,G1161"\w* \w fardos pesados|strong="G5413,G926"\w* \w e|strong="G2532"\w* \w os põem|strong="G2007"\w* \w sobre os ombros|strong="G1909,G3588,G5606"\w* \w dos seres humanos|strong="G3588,G444"\w*, \w mas eles|strong="G846,G1161"\w* \w com o seu dedo|strong="G3588,G1147,G846"\w* \w não|strong="G3756"\w* \w querem|strong="G2309"\w* \w movê-los|strong="G2795,G846"\w*.\x - \xo 23:4 \xt LUK 11:46; MAT 11:28; MAT 5:20; ACT 15:10; ROM 2:21; GAL 6:13\x*
\v 5 \w E todas|strong="G3956,G1161"\w* \w as suas obras|strong="G3588,G2041,G846"\w* \w fazem|strong="G4160"\w* \w para serem vistos|strong="G4314,G3588,G2300"\w* \w pelos seres humanos|strong="G3588,G444"\w*; \w pois|strong="G1063"\w* \w alargam|strong="G4115"\w* \w os seus filactérios|strong="G3588,G5440,G846"\w* \w e|strong="G2532"\w* \w aumentam|strong="G3170"\w* \w as franjas|strong="G3588,G2899"\w*,\f + \fr 23.5: \ft Lit.: φυλακτήριον, “filactério”, caixinha com trechos da Lei, presa ao braço e à testa; κράσπεδον, “franja, borla” do manto (Nm 15:38-39; Dt 22:12).\f*\f + \fr 23.5: \ft Variante: o RP traz δέ em lugar de γάρ; a NIV, o TR e o RP acrescentam τῶν ἱματίων αὐτῶν (“das suas vestes”) depois de “franjas”.\f*\x - \xo 23:5 \xt NUM 15:38; DEU 22:12; MAT 6:1; JHN 12:43; MAT 5:20; MAT 5:16\x*
\v 6 \w e gostam|strong="G5368,G1161"\w* \w do lugar de honra|strong="G3588,G4411"\w* \w nos banquetes|strong="G1722,G3588,G1173"\w* \w e|strong="G2532"\w* \w dos primeiros assentos|strong="G3588,G4410"\w* \w nas sinagogas|strong="G1722,G3588,G4864"\w*\f + \fr 23.6: \ft Lit.: πρωτοκλισία, “o primeiro lugar à mesa”; πρωτοκαθεδρία, “o primeiro assento”.\f*\f + \fr 23.6: \ft Tradução: φιλοῦσι (φιλέω, G5368) está aqui como “e gostam”; o termo pode ser “amar (com afeição)”, “gostar de”, “beijar” ou “ter apreço”, e o contexto decide.\f*\x - \xo 23:6 \xt MRK 12:39; LUK 20:46; LUK 11:43; JHN 12:43; ROM 2:21; MRK 12:38\x*
\v 7 \w e|strong="G2532"\w* \w das saudações|strong="G3588,G783"\w* \w nas praças|strong="G1722,G3588,G58"\w* \w e|strong="G2532"\w* \w de serem chamados|strong="G2564"\w* \w pelos seres humanos|strong="G5259,G3588,G444"\w*: ‘\w Rabi|strong="G4461"\w*’.\f + \fr 23.7: \ft Lit.: ῥαββί, do hebraico “meu mestre”.\f*\f + \fr 23.7: \ft Variante: o RP e o TR repetem Ῥαββί (“Rabi, Rabi”) no fim do verso.\f*\x - \xo 23:7 \xt MRK 12:38; LUK 11:43; LUK 20:46; JHN 12:43; ROM 2:21; 3JN 1:9\x*
\v 8 \w Mas vocês|strong="G4771,G1161"\w*, \w não|strong="G3361"\w* \w sejam chamados|strong="G2564"\w* ‘\w Rabi|strong="G4461"\w*’; \w pois|strong="G1063"\w* \w um só|strong="G1520"\w* \w é|strong="G1510"\w* \w o mestre|strong="G3588,G1320"\w* \w de vocês|strong="G4771"\w*, \w e|strong="G1161"\w* \w todos|strong="G3956"\w* \w vocês|strong="G4771"\w* \w são|strong="G1510"\w* \w irmãos e irmãs|strong="G80"\w*\f + \fr 23.8: \ft Variante: o RP traz καθηγητής ὁ χριστός (“o instrutor, o Cristo”) em lugar de διδάσκαλος (“mestre”).\f*.\x - \xo 23:8 \xt JHN 1:38; JHN 3:2; MRK 10:43; JAS 3:1; ROM 2:21; LUK 22:32\x*
\v 9 \w E|strong="G2532"\w* \w não chamem|strong="G3361,G2564"\w* \add ninguém\add* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w de pai de vocês|strong="G3962,G4771"\w*; \w pois|strong="G1063"\w* \w um só|strong="G1520"\w* \w é|strong="G1510"\w* \w o Pai|strong="G3588,G3962"\w* \w de vocês|strong="G4771"\w*, \w o celestial|strong="G3588,G3770"\w*.\f + \fr 23.9: \ft Acréscimo: “ninguém” (em “não chamem ninguém sobre a”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 23:9 \xt MRK 10:43; MAT 6:9; 1JN 3:1; JAS 3:1; HEB 12:9; MAL 1:6\x*
\v 10 \w Nem sejam chamados|strong="G3366,G2564"\w* \w instrutores|strong="G2519"\w*, \w porque|strong="G3754"\w* \w o instrutor|strong="G2519"\w* \w de vocês|strong="G4771"\w* \w é|strong="G1510"\w* \w um só|strong="G1520"\w*, \w o Cristo|strong="G3588,G5547"\w*.\f + \fr 23.10: \ft Lit.: καθηγητής, “guia, instrutor”.\f*\x - \xo 23:10 \xt ACT 4:18; MRK 10:43; JAS 3:1; ROM 2:21; 1CO 1:12; 1PE 5:3\x*
\v 11 \w Mas o maior|strong="G3588,G1161,G3173"\w* \w de vocês|strong="G4771"\w* \w será|strong="G1510"\w* \w servidor de vocês|strong="G4771,G1249"\w*.\x - \xo 23:11 \xt MRK 10:43; MAT 20:26; 2CO 11:15; 1CO 9:19; GAL 5:13; JHN 13:14-15\x*
\v 12 \w E quem|strong="G3748,G1161"\w* \w se exaltar|strong="G5312,G1438"\w* \w será humilhado|strong="G5013"\w*, \w e|strong="G2532"\w* \w quem|strong="G3748"\w* \w se humilhar|strong="G5013,G1438"\w* \w será exaltado|strong="G5312"\w*.\x - \xo 23:12 \xt JAS 4:10; LUK 14:11; 1PE 5:6; LUK 18:14; MAT 18:4; PRO 29:23\x*
\p
\v 13 \w Mas ai|strong="G3759,G1161"\w* \w de vocês|strong="G4771"\w*, \w escribas|strong="G1122"\w* \w e|strong="G2532"\w* \w fariseus|strong="G5330"\w* \w hipócritas|strong="G5273"\w*, \w porque|strong="G3754"\w* \w fecham|strong="G2808"\w* \w o reino|strong="G3588,G932"\w* \w dos céus|strong="G3588,G3772"\w* \w diante dos seres humanos|strong="G1715,G3588,G444"\w*; \w pois|strong="G1063"\w* \w vocês|strong="G4771"\w* \w não|strong="G3756"\w* \w entram|strong="G1525"\w*, \w nem|strong="G3761"\w* \w deixam|strong="G863"\w* \w entrar|strong="G1525"\w*\f + \fr 23.13: \ft Variante: o v. 14 (“Ai de vocês, escribas e fariseus hipócritas, porque devoram as casas das viúvas e fazem longas orações por aparência; por isso receberão maior condenação”) não consta do SBLGNT; é lido pelo TR e por outros manuscritos (cf. Mc 12:40; Lc 20:47).\f*\f + \fr 23.13: \ft Lit.: οὐαί, “ai”, exclamação de lamento e de advertência, como nos profetas (Is 5:8-23).\f* \w os que estão entrando|strong="G3588,G1525"\w*.\x - \xo 23:13 \xt MRK 12:40; LUK 20:47; ISA 5:8; MRK 7:6; MAT 23:29; MAT 23:23\x*
\v 15 \w Ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w escribas|strong="G1122"\w* \w e|strong="G2532"\w* \w fariseus|strong="G5330"\w* \w hipócritas|strong="G5273"\w*, \w porque|strong="G3754"\w* \w percorrem|strong="G4013"\w* \w o mar|strong="G3588,G2281"\w* \w e|strong="G2532"\w* \w a terra seca|strong="G3588,G3584"\w* \w para fazer|strong="G4160"\w* \w um só|strong="G1520"\w* \w prosélito|strong="G4339"\w*, \w e|strong="G2532"\w* \w quando|strong="G3752"\w* \w isso acontece|strong="G1096"\w*, \w o tornam|strong="G4160,G846"\w* \w filho|strong="G5207"\w* \w da geena|strong="G1067"\w* \w duas vezes mais|strong="G1362"\w* \w do que vocês|strong="G4771"\w*.\f + \fr 23.15: \ft Lit.: προσήλυτος, “prosélito”, o gentio convertido ao judaísmo; “filho da geena” é semitismo para quem está destinado à geena.\f*\x - \xo 23:15 \xt MRK 7:6; MAT 23:13; JER 23:1; ISA 50:7; MAT 5:29; MAT 7:5\x*
\v 16 \w Ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w guias|strong="G3595"\w* \w cegos|strong="G5185"\w*, \w que dizem|strong="G3588,G3004"\w*: ‘\w Quem jurar|strong="G3739,G302,G3660"\w* \w pelo santuário|strong="G1722,G3588,G3485"\w*, \w não é nada|strong="G3762,G1510"\w*; \w mas quem jurar|strong="G3739,G1161,G302,G3660"\w* \w pelo ouro|strong="G1722,G3588,G5557"\w* \w do santuário|strong="G3588,G3485"\w*, \w fica obrigado|strong="G3784"\w*.’\f + \fr 23.16: \ft Lit.: ὀφείλω, “dever, estar obrigado” (ao cumprimento do juramento).\f*\x - \xo 23:16 \xt MAT 23:24; ISA 5:20; JAS 5:12; JER 23:1; ISA 50:7; MAT 5:34\x*
\v 17 \w Tolos|strong="G3474"\w* \w e|strong="G2532"\w* \w cegos|strong="G5185"\w*! \w Pois|strong="G1063"\w* \w qual|strong="G5101"\w* \w é|strong="G1510"\w* \w maior|strong="G3173"\w*: \w o ouro|strong="G3588,G5557"\w* \w ou|strong="G2228"\w* \w o santuário|strong="G3588,G3485"\w* \w que santificou|strong="G3588,G37"\w* \w o ouro|strong="G3588,G5557"\w*?\x - \xo 23:17 \xt MAT 23:19; ISA 5:20; JAS 5:12; JER 23:1; ISA 50:7; MAT 5:34\x*
\v 18 \w E|strong="G2532"\w*: ‘\w Quem jurar|strong="G3739,G302,G3660"\w* \w pelo altar|strong="G1722,G3588,G2379"\w*, \w não é nada|strong="G3762,G1510"\w*; \w mas quem jurar|strong="G3739,G1161,G302,G3660"\w* \w pela oferta|strong="G1722,G3588,G1435"\w* \w que está sobre ele|strong="G3588,G1883,G846"\w*, \w fica obrigado|strong="G3784"\w*.’\f + \fr 23.18: \ft Variante: o RP traz ἐάν em lugar de ἄν; o RP e o TR acrescentam μωροὶ καί (“tolos e”) antes de “cegos” no verso anterior (cf. v. 17).\f*\f + \fr 23.18: \ft Acréscimo: “que está sobre ele”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 23:18 \xt MAT 23:20; MAT 15:5; ISA 5:20; JAS 5:12; JER 23:1; ISA 50:7\x*
\v 19 \w Cegos|strong="G5185"\w*! \w Pois|strong="G1063"\w* \w o que é|strong="G5101"\w* \w maior|strong="G3173"\w*: \w a oferta|strong="G3588,G1435"\w* \w ou|strong="G2228"\w* \w o altar|strong="G3588,G2379"\w* \w que santifica|strong="G3588,G37"\w* \w a oferta|strong="G3588,G1435"\w*?\f + \fr 23.19: \ft Acréscimo: verbo ser/estar suprido em “o que é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 23:19 \xt MAT 5:23; MAT 23:17; ISA 5:20; JAS 5:12; JER 23:1; ISA 50:7\x*
\v 20 \w Quem jura|strong="G3588,G3660"\w*, \w pois|strong="G3767"\w*, \w pelo altar|strong="G1722,G3588,G2379"\w*, \w jura|strong="G3660"\w* \w por ele|strong="G1722,G846"\w* \w e|strong="G2532"\w* \w por tudo|strong="G1722,G3956"\w* \w o que está sobre ele|strong="G3588,G1883,G846"\w*;\f + \fr 23.20: \ft Acréscimo: “o que está sobre ele”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 23:20 \xt MAT 23:18; MAT 23:22; ISA 5:20; JAS 5:12; JER 23:1; ISA 50:7\x*
\v 21 \w e|strong="G2532"\w* \w quem jura|strong="G3588,G3660"\w* \w pelo santuário|strong="G1722,G3588,G3485"\w* \w jura|strong="G3660"\w* \w por ele|strong="G1722,G846"\w* \w e|strong="G2532"\w* \w por aquele|strong="G1722,G3588"\w* \w que nele habita|strong="G2730,G846"\w*;\x - \xo 23:21 \xt ISA 66:1; ISA 5:20; JAS 5:12; JER 23:1; ISA 50:7; MAT 5:34\x*
\v 22 \w e|strong="G2532"\w* \w quem jura|strong="G3588,G3660"\w* \w pelo céu|strong="G1722,G3588,G3772"\w* \w jura|strong="G3660"\w* \w pelo trono|strong="G1722,G3588,G2362"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w por aquele|strong="G1722,G3588"\w* \w que nele está sentado|strong="G2521,G1883,G846"\w*.\x - \xo 23:22 \xt MAT 5:34; MAT 23:20; REV 5:7; ISA 66:1; ISA 5:20; JAS 5:12\x*
\v 23 \w Ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w escribas|strong="G1122"\w* \w e|strong="G2532"\w* \w fariseus|strong="G5330"\w* \w hipócritas|strong="G5273"\w*, \w porque|strong="G3754"\w* \w dão o dízimo|strong="G586"\w* \w da hortelã|strong="G3588,G2238"\w* \w e|strong="G2532"\w* \w do endro|strong="G3588,G432"\w* \w e|strong="G2532"\w* \w do cominho|strong="G3588,G2951"\w*, \w e|strong="G2532"\w* \w deixaram de lado|strong="G863"\w* \w as coisas mais pesadas|strong="G3588,G926"\w* \w da Lei|strong="G3588,G3551"\w*: \w a justiça|strong="G3588,G2920"\w*, \w e|strong="G2532"\w* \w a misericórdia|strong="G3588,G1656"\w* \w e|strong="G2532"\w* \w a fidelidade|strong="G3588,G4102"\w*; \w era necessário|strong="G1163"\w* \w fazer|strong="G4160"\w* \w estas coisas|strong="G3778"\w*, \w sem deixar de lado|strong="G3361,G863"\w* \w aquelas também|strong="G1565,G2532"\w*.\f + \fr 23.23: \ft Lit.: κρίσις, “juízo, justiça”; πίστις, “fé, fidelidade”.\f*\x - \xo 23:23 \xt LUK 11:42; 1SA 15:22; MAT 23:13; MIC 6:8; HOS 6:6; MAT 9:13\x*
\v 24 \w Guias|strong="G3595"\w* \w cegos|strong="G5185"\w*, \w que coam|strong="G3588,G1368"\w* \w o mosquito|strong="G3588,G2971"\w* \w mas engolem|strong="G1161,G2666"\w* \w o camelo|strong="G3588,G2574"\w*!\f + \fr 23.24: \ft Nota cultural: o mosquito e o camelo eram, ambos, animais impuros (Lv 11:4, 20-23); a imagem contrasta o detalhe minúsculo com o enorme descuido.\f*\x - \xo 23:24 \xt LEV 11:4; MAT 15:14; MAT 23:16; JER 23:1; MAT 5:20; ISA 50:7\x*
\v 25 \w Ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w escribas|strong="G1122"\w* \w e|strong="G2532"\w* \w fariseus|strong="G5330"\w* \w hipócritas|strong="G5273"\w*, \w porque|strong="G3754"\w* \w limpam|strong="G2511"\w* \w o exterior|strong="G3588,G1855"\w* \w do copo|strong="G3588,G4221"\w* \w e|strong="G2532"\w* \w do prato|strong="G3588,G3953"\w*, \w mas por dentro|strong="G2081,G1161"\w* \w estão cheios|strong="G1073"\w* \w de rapina|strong="G1537,G724"\w* \w e|strong="G2532"\w* \w intemperança|strong="G192"\w*.\f + \fr 23.25: \ft Lit.: ἁρπαγή, “rapina, roubo violento”; ἀκρασία, “falta de domínio próprio, intemperança”.\f*\f + \fr 23.25: \ft Variante: o RP traz ἀδικίας (“injustiça”) em lugar de ἀκρασίας (“intemperança”).\f*\x - \xo 23:25 \xt LUK 11:39; MAT 23:13; MAT 5:8; ISA 55:7; JAS 4:8; JER 23:1\x*
\v 26 \w Fariseu|strong="G5330"\w* \w cego|strong="G5185"\w*, \w limpe|strong="G2511"\w* \w primeiro|strong="G4413"\w* \w o interior|strong="G3588,G1787"\w* \w do copo|strong="G3588,G4221"\w* \w e|strong="G2532"\w* \w do prato|strong="G3588,G3953"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w o exterior|strong="G3588,G1622"\w* \w dele|strong="G846"\w* \w se torne|strong="G1096"\w* \w limpo|strong="G2513"\w*.\f + \fr 23.26: \ft Variante: WH (à margem) e NA28 omitem καὶ τῆς παροψίδος (“e do prato”); o RP traz αὐτῶν (“deles”) em lugar de αὐτοῦ.\f*\x - \xo 23:26 \xt MAT 5:8; 1PE 3:4; ISA 55:7; JAS 4:8; JER 23:1; MAT 5:20\x*
\v 27 \w Ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w escribas|strong="G1122"\w* \w e|strong="G2532"\w* \w fariseus|strong="G5330"\w* \w hipócritas|strong="G5273"\w*, \w porque|strong="G3754"\w* \w se parecem|strong="G3945"\w* \w com sepulcros|strong="G5028"\w* \w caiados|strong="G2867"\w*, \w que|strong="G3748"\w* \w por fora|strong="G1855,G3303"\w* \w parecem|strong="G5316"\w* \w belos|strong="G5611"\w*, \w mas por dentro|strong="G2081,G1161"\w* \w estão cheios|strong="G1073"\w* \w de ossos|strong="G3747"\w* \w de mortos|strong="G3498"\w* \w e|strong="G2532"\w* \w de toda|strong="G3956"\w* \w impureza|strong="G167"\w*;\f + \fr 23.27: \ft Nota cultural: os sepulcros eram caiados para sinalizar a impureza ritual de quem os tocasse, sobretudo antes da Páscoa (cf. Nm 19:16).\f*\x - \xo 23:27 \xt NUM 19:16; 2TI 3:5; MAT 5:8; JER 23:1; MAT 5:20; JHN 8:7\x*
\v 28 \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w por fora|strong="G1855,G3303"\w* \w parecem|strong="G5316"\w* \w aos seres humanos|strong="G3588,G444"\w* \w justos|strong="G1342"\w*, \w mas por dentro|strong="G2081,G1161"\w* \w estão|strong="G1510"\w* \w cheios|strong="G3324"\w* \w de hipocrisia|strong="G5272"\w* \w e|strong="G2532"\w* \w de iniquidade|strong="G458"\w*.\f + \fr 23.28: \ft Lit.: ἀνομία, “iniquidade, ilegalidade” (literalmente, “ausência de lei”).\f*\x - \xo 23:28 \xt 2TI 3:5; MAT 5:8; MAT 6:1; JER 23:1; MAT 5:20; JHN 8:7\x*
\v 29 \w Ai|strong="G3759"\w* \w de vocês|strong="G4771"\w*, \w escribas|strong="G1122"\w* \w e|strong="G2532"\w* \w fariseus|strong="G5330"\w* \w hipócritas|strong="G5273"\w*, \w porque|strong="G3754"\w* \w constroem|strong="G3618"\w* \w os sepulcros|strong="G3588,G5028"\w* \w dos profetas|strong="G3588,G4396"\w* \w e|strong="G2532"\w* \w enfeitam|strong="G2885"\w* \w os túmulos|strong="G3588,G3419"\w* \w dos justos|strong="G3588,G1342"\w*,\x - \xo 23:29 \xt LUK 11:47; MAT 23:13; MAT 6:1; JER 23:1; ROM 2:1; ISA 50:7\x*
