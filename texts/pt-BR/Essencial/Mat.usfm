\v 32 \w o qual|strong="G3739"\w* \w é|strong="G1510"\w* \w menor|strong="G3398,G3303"\w* \w do que todas|strong="G3956"\w* \w as sementes|strong="G3588,G4690"\w*, \w mas|strong="G1161"\w* \w quando|strong="G3752"\w* \w cresce|strong="G837"\w*, \w é maior|strong="G3173,G1510"\w* \w do que as hortaliças|strong="G3588,G3001"\w* \w e|strong="G2532"\w* \w se torna|strong="G1096"\w* \w árvore|strong="G1186"\w*, \w de modo que|strong="G5620"\w* \w vêm|strong="G2064"\w* \w as aves|strong="G3588,G4071"\w* \w do céu|strong="G3588,G3772"\w* \w e|strong="G2532"\w* \w se aninham|strong="G2681"\w* \w nos seus ramos|strong="G1722,G3588,G2798,G846"\w*.”\f + \fr 13.32: \ft Nota cultural: a árvore em que as aves se abrigam ecoa Dn 4:12 e Ez 17:23.\f*\x - \xo 13:32 \xt DAN 4:12; EZK 17:23; LUK 13:19; MRK 4:32; JOB 8:7; ISA 60:22\x*
