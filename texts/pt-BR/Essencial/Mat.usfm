\v 36 \w Mas|strong="G1161"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w*, \w de toda|strong="G3956"\w* \w palavra|strong="G4487"\w* \w ociosa|strong="G692"\w* \w que|strong="G3739"\w* \w falarem|strong="G2980"\w* \w os seres humanos|strong="G3588,G444"\w*, \w darão|strong="G591"\w* \w conta|strong="G3056"\w* \w a respeito dela|strong="G4012,G846"\w* \w no dia|strong="G1722,G2250"\w* \w do juízo|strong="G2920"\w*;\x - \xo 12:36 \xt PRO 18:21; ECC 12:14; EPH 4:29; LUK 6:45; ROM 2:16; ROM 14:12\x*
\v 37 \w pois|strong="G1063"\w* \w pelas suas palavras|strong="G1537,G3588,G3056,G4771"\w* \w será declarado justo|strong="G1344"\w*, \w e|strong="G2532"\w* \w pelas suas palavras|strong="G1537,G3588,G3056,G4771"\w* \w será condenado|strong="G2613"\w*.”\x - \xo 12:37 \xt PRO 18:21; EPH 4:29; LUK 6:45; PRO 13:3; JAS 3:2; MAT 15:11\x*
