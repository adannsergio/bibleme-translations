\v 28 \w E o que|strong="G5101,G1161"\w* \w lhes parece|strong="G4771,G1380"\w*? \w Um homem|strong="G444"\w* \w tinha|strong="G2192"\w* \w dois filhos|strong="G5043,G1417"\w*. \w Aproximando-se|strong="G4334"\w* \w do primeiro|strong="G3588,G4413"\w*, \w disse|strong="G2036"\w*: ‘\w Filho|strong="G5043"\w*, \w vá|strong="G5217"\w* \w hoje|strong="G4594"\w* \w trabalhar|strong="G2038"\w* \w na vinha|strong="G1722,G3588,G290"\w*.’\x - \xo 21:28 \xt MAT 9:13; MAT 11:12; ACT 2:38; ISA 1:19; JER 6:16; MAT 3:8\x*
\v 29 \w Mas ele|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: ‘\w Não|strong="G3756"\w* \w quero|strong="G2309"\w*’; \w mas depois|strong="G5306,G1161"\w*, \w mudando de ideia|strong="G3338"\w*, \w foi|strong="G565"\w*.\f + \fr 21.29: \ft Lit.: μεταμέλομαι, “sentir pesar, mudar de ideia” (diferente de μετανοέω, “mudar de mente, arrepender-se”).\f*\x - \xo 21:29 \xt MAT 21:32; MAT 9:13; MAT 11:12; ACT 2:38; MAT 7:21; ISA 1:19\x*
\v 30 \w Aproximando-se|strong="G4334,G1161"\w* \w do segundo|strong="G3588,G1208"\w*, \w disse|strong="G2036"\w* \w o mesmo|strong="G5615"\w*; \w e ele|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: ‘\w Eu|strong="G1473"\w* \add vou,\add* \w senhor|strong="G2962"\w*’; \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w foi|strong="G565"\w*.\f + \fr 21.30: \ft Variante: NA28 traz ἑτέρῳ (“a outro”) em lugar de δευτέρῳ (“ao segundo”); o RP traz Καὶ προσελθών; WH traz, em lugar de “Eu vou, senhor; e não foi”, οὐ θέλω ὕστερον μεταμεληθείς (“não quero; depois, mudando de ideia”), o que inverte a ordem dos filhos em relação ao resto do texto.\f*\f + \fr 21.30: \ft Acréscimo: “vou” (em “disse Eu vou senhor e”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 21:30 \xt MAT 9:13; MAT 11:12; ACT 2:38; MAT 7:21; ISA 1:19; JER 6:16\x*
\v 31 \w Qual|strong="G5101"\w* \w dos dois|strong="G1537,G3588,G1417"\w* \w fez|strong="G4160"\w* \w a vontade|strong="G3588,G2307"\w* \w do pai|strong="G3588,G3962"\w*?” \w Disseram|strong="G3004"\w*: “\w O primeiro|strong="G3588,G4413"\w*.” \w Jesus lhes disse|strong="G3004,G846,G3588,G2424"\w*: “\w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w os cobradores de impostos|strong="G3588,G5057"\w* \w e|strong="G2532"\w* \w as prostitutas|strong="G3588,G4204"\w* \w entram antes de vocês|strong="G4254,G4771"\w* \w no reino|strong="G1519,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 21.31: \ft Lit.: προάγω, “ir adiante, preceder”.\f*\f + \fr 21.31: \ft Variante: NA28 e o RP trazem πρῶτος (“o primeiro”), mas WH e Treg trazem ὕστερος (“o último”); o RP acrescenta αὐτῷ (“lhe”) depois de “disseram”.\f*\x - \xo 21:31 \xt MAT 7:21; 1CO 6:16; MAT 9:13; LUK 11:9; MAT 11:12; ACT 2:38\x*
\v 32 \w Pois|strong="G1063"\w* \w João|strong="G2491"\w* \w veio|strong="G2064"\w* \w a vocês|strong="G4314,G4771"\w* \w no caminho|strong="G1722,G3598"\w* \w da justiça|strong="G1343"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w creram nele|strong="G4100,G846"\w*; \w mas os cobradores de impostos|strong="G3588,G1161,G5057"\w* \w e|strong="G2532"\w* \w as prostitutas|strong="G3588,G4204"\w* \w creram nele|strong="G4100,G846"\w*; \w mas vocês|strong="G4771,G1161"\w*, \w vendo isso|strong="G1492"\w*, \w nem sequer|strong="G3761"\w* \w mudaram de ideia|strong="G3338"\w* \w depois|strong="G5306"\w*, \w para crerem nele|strong="G3588,G4100,G846"\w*.\x - \xo 21:32 \xt MAT 21:29; MAT 9:13; MAT 11:12; ACT 2:38; ISA 1:19; JER 6:16\x*
\v 33 \w Ouçam|strong="G191"\w* \w outra parábola|strong="G243,G3850"\w*. \w Havia|strong="G1510"\w* \w um homem|strong="G444"\w*, \w dono de casa|strong="G3617"\w*, \w que|strong="G3748"\w* \w plantou|strong="G5452"\w* \w uma vinha|strong="G290"\w*, \w e|strong="G2532"\w* \w pôs|strong="G4060"\w* \w uma cerca|strong="G5418"\w* \w ao redor dela|strong="G846"\w*, \w e|strong="G2532"\w* \w cavou|strong="G3736"\w* \w nela|strong="G1722,G846"\w* \w um lagar|strong="G3025"\w*, \w e|strong="G2532"\w* \w construiu|strong="G3618"\w* \w uma torre|strong="G4444"\w*, \w e|strong="G2532"\w* \w a arrendou|strong="G1554,G846"\w* \w a lavradores|strong="G1092"\w*, \w e|strong="G2532"\w* \w partiu em viagem|strong="G589"\w*.\f + \fr 21.33: \ft Nota cultural: a descrição ecoa o canto da vinha de Is 5:1-2.\f*\x - \xo 21:33 \xt ISA 5:1; MRK 12:1; LUK 20:9; JHN 15:1; MAT 25:14; 1CO 3:9\x*
\v 34 \w E quando|strong="G3753,G1161"\w* \w se aproximou|strong="G1448"\w* \w o tempo|strong="G3588,G2540"\w* \w dos frutos|strong="G3588,G2590"\w*, \w enviou|strong="G649"\w* \w os seus escravos|strong="G3588,G1401,G846"\w* \w aos lavradores|strong="G4314,G3588,G1092"\w* \w para receber|strong="G2983"\w* \w os frutos|strong="G3588,G2590"\w* \w dele|strong="G846"\w*.\x - \xo 21:34 \xt MRK 12:2; LUK 20:10; 2TI 2:6; PSA 1:3; LUK 20:9; LUK 13:6\x*
\v 35 \w E|strong="G2532"\w*, \w os lavradores|strong="G3588,G1092"\w*, \w agarrando|strong="G2983"\w* \w os seus escravos|strong="G3588,G1401,G846"\w*, \w a um|strong="G3739,G3303"\w* \w espancaram|strong="G1194"\w*, \w a outro|strong="G3739,G1161"\w* \w mataram|strong="G615"\w*, \w e a outro|strong="G3739,G1161"\w* \w apedrejaram|strong="G3036"\w*.\x - \xo 21:35 \xt MRK 12:5; LUK 20:10; LUK 20:9; 2CH 36:15-16; LUK 13:6; MAT 23:37\x*
\v 36 \w De novo|strong="G3825"\w* \w enviou|strong="G649"\w* \w outros escravos|strong="G243,G1401"\w* \w em maior número|strong="G4119"\w* \w do que os primeiros|strong="G3588,G4413"\w*, \w e|strong="G2532"\w* \w fizeram|strong="G4160"\w* \w com eles|strong="G846"\w* \w o mesmo|strong="G5615"\w*.\x - \xo 21:36 \xt MRK 12:4; LUK 20:9; LUK 13:6; MAT 23:37; 1CO 3:9; MAT 20:1\x*
\v 37 \w E por último|strong="G5306,G1161"\w* \w enviou-lhes|strong="G649,G4314,G846"\w* \w o seu filho|strong="G3588,G5207,G846"\w*, \w dizendo|strong="G3004"\w*: ‘\w Respeitarão|strong="G1788"\w* \w o meu filho|strong="G3588,G5207,G3165"\w*.’\x - \xo 21:37 \xt MRK 12:6; LUK 20:9; LUK 13:6; 1CO 3:9; MAT 20:1; 2TI 2:6\x*
\v 38 \w Mas os lavradores|strong="G3588,G1161,G1092"\w*, \w vendo|strong="G1492"\w* \w o filho|strong="G3588,G5207"\w*, \w disseram|strong="G2036"\w* \w entre si|strong="G1722,G1438"\w*: ‘\w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w o herdeiro|strong="G3588,G2818"\w*; \w venham|strong="G1205"\w*, \w matemo-lo|strong="G615,G846"\w* \w e|strong="G2532"\w* \w fiquemos|strong="G2192"\w* \w com a herança|strong="G3588,G2817"\w* \w dele|strong="G846"\w*.’\x - \xo 21:38 \xt MRK 12:7; LUK 20:14; HEB 1:2; JHN 7:1; LUK 20:9; LUK 13:6\x*
\v 39 \w E|strong="G2532"\w*, \w agarrando-o|strong="G2983,G846"\w*, \w o lançaram|strong="G1544"\w* \w para fora|strong="G1854"\w* \w da vinha|strong="G3588,G290"\w* \w e|strong="G2532"\w* \w o mataram|strong="G615"\w*.\x - \xo 21:39 \xt MRK 12:8; LUK 20:15; JHN 9:35; JHN 6:37; LUK 20:9; ACT 2:23\x*
\v 40 \w Quando|strong="G3752"\w*, \w pois|strong="G3767"\w*, \w vier|strong="G2064"\w* \w o dono|strong="G3588,G2962"\w* \w da vinha|strong="G3588,G290"\w*, \w o que|strong="G5101"\w* \w fará|strong="G4160"\w* \w com aqueles lavradores|strong="G3588,G1092,G1565"\w*?”\f + \fr 21.40: \ft Tradução: κύριος (κύριος, G2962) está aqui como “o dono”; o termo pode ser “Senhor” (Deus ou Jesus), “senhor” (título de respeito), “dono” ou “patrão”, e o contexto decide.\f*\x - \xo 21:40 \xt MRK 12:9; LUK 20:16; LUK 20:9; MRK 12:2; LUK 13:6; 1CO 3:9\x*
\v 41 \w Disseram-lhe|strong="G3004,G846"\w*: “\w Aos maus|strong="G2556"\w*, \w miseravelmente|strong="G2560"\w* \w os destruirá|strong="G622,G846"\w*, \w e|strong="G2532"\w* \w arrendará|strong="G1554"\w* \w a vinha|strong="G3588,G290"\w* \w a outros|strong="G243"\w* \w lavradores|strong="G1092"\w*, \w que lhe entregarão|strong="G3748,G591,G846"\w* \w os frutos|strong="G3588,G2590"\w* \w em seus tempos|strong="G1722,G3588,G2540,G846"\w*.”\f + \fr 21.41: \ft Lit.: Κακοὺς κακῶς, jogo de palavras (literalmente “aos maus, malmente”).\f*\x - \xo 21:41 \xt LUK 20:16; MRK 12:9; LUK 20:9; MRK 12:2; MAT 21:43; PSA 1:3\x*
\v 42 \w Disse-lhes|strong="G3004,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Nunca|strong="G3763"\w* \w leram|strong="G314"\w* \w nas Escrituras|strong="G1722,G3588,G1124"\w*: ‘\w A pedra|strong="G3037"\w* \w que rejeitaram|strong="G3739,G593"\w* \w os construtores|strong="G3588,G3618"\w*, \w esta|strong="G3778"\w* \w se tornou|strong="G1096"\w* \w cabeça|strong="G1519,G2776"\w* \w de esquina|strong="G1137"\w*; \w da parte do Senhor|strong="G3844,G2962"\w* \w isso aconteceu|strong="G1096,G3778"\w*, \w e|strong="G2532"\w* \w é|strong="G1510"\w* \w maravilhosa|strong="G2298"\w* \w aos nossos olhos|strong="G1722,G3788,G3165"\w*’?\f + \fr 21.42: \ft Nota cultural: cita Sl 118:22-23; “cabeça de esquina” designa a pedra angular ou o remate do canto do edifício.\f*\x - \xo 21:42 \xt PSA 118:22; MRK 12:10; LUK 20:17; 1PE 2:7; ACT 4:11; MRK 12:11\x*
\v 43 \w Por isso|strong="G1223,G3778"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w será tirado|strong="G142"\w* \w de vocês|strong="G575,G4771"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w será dado|strong="G1325"\w* \w a uma nação|strong="G1484"\w* \w que produza|strong="G4160"\w* \w os seus frutos|strong="G3588,G2590,G846"\w*.\x - \xo 21:43 \xt MAT 21:41; ACT 4:11; LUK 14:24; MAT 8:11-12; MAT 8:12; ACT 13:46\x*
\v 44 \w E|strong="G2532"\w* \w quem cair|strong="G3588,G4098"\w* \w sobre esta pedra|strong="G1909,G3588,G3037,G3778"\w* \w será despedaçado|strong="G4917"\w*; \w mas aquele sobre quem|strong="G1909,G3739,G1161"\w* \w ela cair|strong="G302,G4098"\w*, \w o esmagará|strong="G3039,G846"\w*.”\x - \xo 21:44 \xt LUK 20:18; ISA 8:14-15; 1PE 2:8; ACT 4:11; DAN 2:34-35; ZEC 12:3\x*
\p
\v 45 \w E|strong="G2532"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w*, \w ouvindo|strong="G191"\w* \w as parábolas|strong="G3588,G3850"\w* \w dele|strong="G846"\w*, \w perceberam|strong="G1097"\w* \w que|strong="G3754"\w* \w falava|strong="G3004"\w* \w a respeito deles|strong="G4012,G846"\w*,\x - \xo 21:45 \xt LUK 20:19; MRK 4:13; MRK 12:12; ACT 4:11; HOS 4:6; LUK 20:9\x*
\v 46 \w e|strong="G2532"\w*, \w procurando|strong="G2212"\w* \w prendê-lo|strong="G846,G2902"\w*, \w temeram|strong="G5399"\w* \w as multidões|strong="G3588,G3793"\w*, \w porque|strong="G1893"\w* \w o consideravam|strong="G846,G2192"\w* \w como profeta|strong="G1519,G4396"\w*.\x - \xo 21:46 \xt MRK 12:12; MAT 21:26; MRK 11:32; LUK 20:9; MAT 21:11; PSA 21:11\x*
