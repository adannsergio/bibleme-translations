\v 33 \w Ou|strong="G2228"\w* \w façam|strong="G4160"\w* \w a árvore|strong="G3588,G1186"\w* \w boa|strong="G2570"\w* \w e|strong="G2532"\w* \w o seu fruto|strong="G3588,G2590,G846"\w* \w bom|strong="G2570"\w*, \w ou|strong="G2228"\w* \w façam|strong="G4160"\w* \w a árvore|strong="G3588,G1186"\w* \w podre|strong="G4550"\w* \w e|strong="G2532"\w* \w o seu fruto|strong="G3588,G2590,G846"\w* \w podre|strong="G4550"\w*; \w pois|strong="G1063"\w* \w pelo fruto|strong="G1537,G3588,G2590"\w* \w a árvore|strong="G3588,G1186"\w* \w é conhecida|strong="G1097"\w*.\x - \xo 12:33 \xt LUK 6:43; MAT 7:17; MAT 7:18; LUK 3:9; MAT 7:19; 2CO 5:17\x*
\v 34 \w Raça|strong="G1081"\w* \w de víboras|strong="G2191"\w*, \w como|strong="G4459"\w* \w podem|strong="G1410"\w* \w falar|strong="G2980"\w* \w coisas boas|strong="G18"\w*, \w sendo|strong="G1510"\w* \w maus|strong="G4190"\w*? \w Pois|strong="G1063"\w* \w do que transborda|strong="G1537,G3588,G4051"\w* \w do coração|strong="G3588,G2588"\w* \w a boca|strong="G3588,G4750"\w* \w fala|strong="G2980"\w*.\x - \xo 12:34 \xt LUK 6:45; PRO 4:23; MAT 23:33; LUK 3:7; MAT 3:7; EPH 4:29\x*
