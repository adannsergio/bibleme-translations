\v 28 \w E ele|strong="G3588,G1161"\w* \w lhes disse|strong="G5346,G846"\w*: ‘\w Um inimigo|strong="G2190,G444"\w* \w fez|strong="G4160"\w* \w isto|strong="G3778"\w*.’ \w E os escravos|strong="G3588,G1161,G1401"\w* \w lhe dizem|strong="G846,G3004"\w*: ‘\w Quer|strong="G2309"\w*, \w então|strong="G3767"\w*, \w que, indo|strong="G565"\w*, \w os colhamos|strong="G4816,G846"\w*?’\x - \xo 13:28 \xt 1CO 3:9; 1CO 5:3-7; MAT 13:47; MRK 9:39; 1TH 5:14; ECC 3:2\x*
\v 29 \w Mas ele|strong="G3588,G1161"\w* \w diz|strong="G5346"\w*: ‘\w Não|strong="G3756"\w*, \w para que não|strong="G4218,G3361"\w*, \w ao colherem|strong="G4816"\w* \w o joio|strong="G3588,G2215"\w*, \w arranquem|strong="G1610"\w* \w junto com ele|strong="G260,G846"\w* \w o trigo|strong="G3588,G4621"\w*.\x - \xo 13:29 \xt 1CO 3:9; MAT 13:47; MRK 9:39; ECC 3:2\x*
\v 30 \w Deixem|strong="G863"\w* \w crescer juntos|strong="G4885"\w* \w ambos|strong="G297"\w* \w até|strong="G3360"\w* \w a colheita|strong="G3588,G2326"\w*; \w e|strong="G2532"\w* \w no tempo|strong="G1722,G2540"\w* \w da colheita|strong="G3588,G2326"\w* \w direi|strong="G4483"\w* \w aos ceifeiros|strong="G3588,G2327"\w*: \w Colham|strong="G4816"\w* \w primeiro|strong="G4413"\w* \w o joio|strong="G3588,G2215"\w* \w e|strong="G2532"\w* \w amarrem-no|strong="G1210,G846"\w* \w em feixes|strong="G1519,G1197"\w* \w para queimá-lo|strong="G4314,G3588,G2618,G846"\w*, \w mas|strong="G1161"\w* \w o trigo|strong="G3588,G4621"\w* \w juntem|strong="G4863"\w* \w no meu celeiro|strong="G1519,G3588,G596,G3165"\w*.’”\f + \fr 13.30: \ft Variante: WH, Treg e NA28 trazem ἕως (“até”) em lugar de μέχρι, e WH e Treg trazem o presente συνάγετε (“juntem”) em lugar de συναγάγετε.\f*\x - \xo 13:30 \xt MAT 3:12; LUK 3:17; 1TI 5:24; 1CO 4:5; JHN 15:6; MAL 3:18-4:1\x*
