\v 29 \w pois|strong="G1063"\w* \w a todo o que tem|strong="G3588,G2192,G3956"\w* \w será dado|strong="G1325"\w* \w e|strong="G2532"\w* \w lhe sobrará|strong="G4052"\w*; \w mas daquele que não tem|strong="G3588,G1161,G3361,G2192"\w*, \w até o que tem|strong="G2532,G3739,G2192"\w* \w será tirado|strong="G142"\w* \w dele|strong="G575,G846"\w*.\x - \xo 25:29 \xt MAT 13:12; 2TI 1:6; LUK 12:48; LUK 8:18; MRK 4:25; LUK 19:12\x*
\v 30 \w E|strong="G2532"\w* \w lancem|strong="G1544"\w* \w o escravo|strong="G3588,G1401"\w* \w inútil|strong="G888"\w* \w nas trevas exteriores|strong="G1519,G3588,G4655,G1857"\w*; \w ali|strong="G1563"\w* \w haverá|strong="G1510"\w* \w o choro|strong="G3588,G2805"\w* \w e|strong="G2532"\w* \w o ranger|strong="G3588,G1030"\w* \w de dentes|strong="G3588,G3599"\w*.’\x - \xo 25:30 \xt MAT 8:12; MAT 22:13; MAT 13:50; MAT 13:42; LUK 13:28; MAT 24:51\x*
\v 31 \w Mas quando|strong="G3752,G1161"\w* \w vier|strong="G2064"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w na sua glória|strong="G1722,G3588,G1391,G846"\w* \w e|strong="G2532"\w* \w todos os anjos|strong="G3956,G3588,G32"\w* \w com ele|strong="G3326,G846"\w*, \w então|strong="G5119"\w* \w se assentará|strong="G2523"\w* \w no trono|strong="G1909,G2362"\w* \w da sua glória|strong="G1391,G846"\w*,\f + \fr 25.31: \ft Variante: o RP e o TR acrescentam ἅγιοι (“santos”) depois de “todos os”.\f*\x - \xo 25:31 \xt MAT 19:28; LUK 9:26; REV 3:21; MAT 16:27; MRK 8:38; 1CO 15:58\x*
\v 32 \w e|strong="G2532"\w* \w serão reunidas|strong="G4863"\w* \w diante dele|strong="G1715,G846"\w* \w todas as nações|strong="G3956,G3588,G1484"\w*, \w e|strong="G2532"\w* \w os separará|strong="G873,G846"\w* \w uns dos outros|strong="G575,G240"\w*, \w assim como|strong="G5618"\w* \w o pastor|strong="G3588,G4166"\w* \w separa|strong="G873"\w* \w as ovelhas|strong="G3588,G4263"\w* \w dos cabritos|strong="G575,G3588,G2056"\w*,\x - \xo 25:32 \xt 1CO 15:58; DEU 11:27; MAL 3:18; MAT 13:49; HEB 9:27; 2CO 5:10\x*
\v 33 \w e|strong="G2532"\w* \w colocará|strong="G2476"\w* \w as ovelhas|strong="G3588,G3303,G4263"\w* \w à sua direita|strong="G1537,G1188,G846"\w*, \w mas os cabritinhos|strong="G3588,G1161,G2055"\w* \w à esquerda|strong="G1537,G2176"\w*.\x - \xo 25:33 \xt MRK 10:40; MRK 16:19; MAT 20:21; MAT 20:23; 1CO 15:58; DEU 11:27\x*
\v 34 \w Então|strong="G5119"\w* \w dirá|strong="G4483"\w* \w o rei|strong="G3588,G935"\w* \w aos que estão|strong="G3588,G1537"\w* \w à sua direita|strong="G1188,G846"\w*: ‘\w Venham|strong="G1205"\w*, \w os abençoados|strong="G3588,G2127"\w* \w do meu Pai|strong="G3588,G3962,G3165"\w*, \w herdem|strong="G2816"\w* \w o reino|strong="G3588,G932"\w* \w preparado|strong="G2090"\w* \w para vocês|strong="G4771"\w* \w desde a fundação|strong="G575,G2602"\w* \w do mundo|strong="G2889"\w*;\f + \fr 25.34: \ft Acréscimo: verbo ser/estar suprido em “aos que estão”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 25:34 \xt JHN 14:15; REV 13:8; EPH 1:4; 1CO 2:9; 1CO 15:58; DEU 11:27\x*
\v 35 \w pois|strong="G1063"\w* \w tive fome|strong="G3983"\w* \w e|strong="G2532"\w* \w me deram|strong="G1325,G3165"\w* \w de comer|strong="G5315"\w*; \w tive sede|strong="G1372"\w* \w e|strong="G2532"\w* \w me deram de beber|strong="G4222,G3165"\w*; \w era estrangeiro|strong="G3581,G1510"\w* \w e|strong="G2532"\w* \w me acolheram|strong="G4863,G3165"\w*;\x - \xo 25:35 \xt MAT 25:42; JHN 14:15; ROM 12:20; MAT 25:37; HEB 13:2; 1CO 15:58\x*
\v 36 \w nu|strong="G1131"\w* \w e|strong="G2532"\w* \w me vestiram|strong="G4016,G3165"\w*; \w adoeci|strong="G770"\w* \w e|strong="G2532"\w* \w me visitaram|strong="G1980,G3165"\w*; \w estava|strong="G1510"\w* \w na prisão|strong="G1722,G5438"\w* \w e|strong="G2532"\w* \w vieram|strong="G2064"\w* \w a mim|strong="G4314,G3165"\w*.’\x - \xo 25:36 \xt MAT 25:43; JHN 14:15; 1CO 15:58; DEU 11:27; JAS 1:27; ACT 20:35\x*
\v 37 \w Então|strong="G5119"\w* \w lhe responderão|strong="G611,G846"\w* \w os justos|strong="G3588,G1342"\w*, \w dizendo|strong="G3004"\w*: ‘\w Senhor|strong="G2962"\w*, \w quando|strong="G4219"\w* \w o vimos|strong="G4771,G1492"\w* \w com fome|strong="G3983"\w* \w e|strong="G2532"\w* \w o alimentamos|strong="G5142"\w*, \w ou|strong="G2228"\w* \w com sede|strong="G1372"\w* \w e|strong="G2532"\w* \w lhe demos de beber|strong="G4222"\w*?\x - \xo 25:37 \xt JHN 14:15; MAT 25:42; MAT 25:35; MAT 25:44; 1CO 15:58; DEU 11:27\x*
\v 38 \w E|strong="G1161"\w* \w quando|strong="G4219"\w* \w o vimos|strong="G4771,G1492"\w* \w estrangeiro|strong="G3581"\w* \w e|strong="G2532"\w* \w o acolhemos|strong="G4863"\w*, \w ou|strong="G2228"\w* \w nu|strong="G1131"\w* \w e|strong="G2532"\w* \w o vestimos|strong="G4016"\w*?\x - \xo 25:38 \xt JHN 14:15; MAT 25:43; MAT 25:44; 1CO 15:58; DEU 11:27; JAS 1:27\x*
\v 39 \w E|strong="G1161"\w* \w quando|strong="G4219"\w* \w o vimos|strong="G4771,G1492"\w* \w doente|strong="G770"\w* \w ou|strong="G2228"\w* \w na prisão|strong="G1722,G5438"\w*, \w e|strong="G2532"\w* \w fomos|strong="G2064"\w* \w até você|strong="G4314,G4771"\w*?’\x - \xo 25:39 \xt JHN 14:15; 1CO 15:58; DEU 11:27; JAS 1:27; ACT 20:35; HEB 13:16\x*
\v 40 \w E|strong="G2532"\w* \w o rei|strong="G3588,G935"\w*, \w respondendo|strong="G611"\w*, \w lhes dirá|strong="G4483,G846"\w*: ‘\w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w*: \w na medida em que|strong="G1909,G3745"\w* \w fizeram|strong="G4160"\w* \w isso a um|strong="G1520"\w* \w destes meus irmãos e irmãs mais pequenos|strong="G3778,G3588,G80,G3165,G1646"\w*, \w a mim|strong="G1473"\w* \w o fizeram|strong="G4160"\w*\f + \fr 25.40: \ft Lit.: ἐλάχιστος, “o menor, o mais pequeno”; a identificação dos “irmãos mais pequenos” é debatida entre os intérpretes.\f*.’\x - \xo 25:40 \xt MAT 25:45; JHN 14:15; ROM 8:29; PRO 19:17; PRO 14:31; 1CO 15:58\x*
\v 41 \w Então|strong="G5119"\w* \w dirá|strong="G4483"\w* \w também|strong="G2532"\w* \w aos que estão|strong="G3588,G1537"\w* \w à esquerda|strong="G2176"\w*: ‘\w Vão embora|strong="G4198"\w* \w de mim|strong="G575,G1473"\w*, \w os amaldiçoados|strong="G3588,G2672"\w*, \w para o fogo|strong="G1519,G3588,G4442"\w* \w eterno|strong="G3588,G166"\w* \w preparado|strong="G3588,G2090"\w* \w para o diabo|strong="G3588,G1228"\w* \w e|strong="G2532"\w* \w para os seus anjos|strong="G3588,G32,G846"\w*;\f + \fr 25.41: \ft Acréscimo: verbo ser/estar suprido em “aos que estão”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 25:41 \xt DEU 11:27; JAS 1:27; MAT 7:23; 2PE 2:4; REV 22:3; HEB 9:27\x*
\v 42 \w pois|strong="G1063"\w* \w tive fome|strong="G3983"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w me deram|strong="G1325,G3165"\w* \w de comer|strong="G5315"\w*; \w tive sede|strong="G1372"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w me deram de beber|strong="G4222,G3165"\w*;\x - \xo 25:42 \xt MAT 25:35; MAT 25:37; ROM 12:20; MAT 5:6; DEU 11:27; JAS 1:27\x*
\v 43 \w era estrangeiro|strong="G3581,G1510"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w me acolheram|strong="G4863,G3165"\w*; \w nu|strong="G1131"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w me vestiram|strong="G4016,G3165"\w*; \w doente|strong="G772"\w* \w e|strong="G2532"\w* \w na prisão|strong="G1722,G5438"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w me visitaram|strong="G1980,G3165"\w*.’\x - \xo 25:43 \xt MAT 25:36; MAT 25:38; DEU 11:27; JAS 1:27; HEB 9:27; ISA 58:7\x*
\v 44 \w Então|strong="G5119"\w* \w responderão|strong="G611"\w* \w também|strong="G2532"\w* \w eles|strong="G846"\w*, \w dizendo|strong="G3004"\w*: ‘\w Senhor|strong="G2962"\w*, \w quando|strong="G4219"\w* \w o vimos|strong="G4771,G1492"\w* \w com fome|strong="G3983"\w* \w ou|strong="G2228"\w* \w com sede|strong="G1372"\w* \w ou|strong="G2228"\w* \w estrangeiro|strong="G3581"\w* \w ou|strong="G2228"\w* \w nu|strong="G1131"\w* \w ou|strong="G2228"\w* \w doente|strong="G772"\w* \w ou|strong="G2228"\w* \w na prisão|strong="G1722,G5438"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w o servimos|strong="G1247,G4771"\w*?’\x - \xo 25:44 \xt MAT 25:37; MAT 25:38; DEU 11:27; JAS 1:27; HEB 9:27; ISA 58:7\x*
\v 45 \w Então|strong="G5119"\w* \w lhes responderá|strong="G611,G846"\w*, \w dizendo|strong="G3004"\w*: ‘\w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w*: \w na medida em que|strong="G1909,G3745"\w* \w não|strong="G3756"\w* \w fizeram|strong="G4160"\w* \w isso a um|strong="G1520"\w* \w destes|strong="G3778"\w* \w mais pequenos|strong="G3588,G1646"\w*, \w nem a mim|strong="G3761,G1473"\w* \w o fizeram|strong="G4160"\w*.’\x - \xo 25:45 \xt MAT 25:40; MAT 25:12; DEU 11:27; JAS 1:27; HEB 9:27; ISA 58:7\x*
\v 46 \w E|strong="G2532"\w* \w irão embora|strong="G565"\w* \w estes|strong="G3778"\w* \w para o castigo|strong="G1519,G2851"\w* \w eterno|strong="G166"\w*, \w mas os justos|strong="G3588,G1161,G1342"\w* \w para a vida|strong="G1519,G2222"\w* \w eterna|strong="G166"\w*.”\f + \fr 25.46: \ft Lit.: κόλασις, “castigo, punição”; αἰώνιος, “eterno, próprio da era vindoura”.\f*\x - \xo 25:46 \xt JHN 3:15; 1JN 5:11; JHN 17:2; 1JN 2:25; ROM 6:23; DEU 11:27\x*
\c 26
\p
\v 1 \w E|strong="G2532"\w* \w aconteceu que|strong="G1096"\w*, \w quando|strong="G3753"\w* \w Jesus|strong="G3588,G2424"\w* \w terminou|strong="G5055"\w* \w todas estas palavras|strong="G3956,G3588,G3056,G3778"\w*, \w disse|strong="G2036"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w*:\x - \xo 26:1 \xt MAT 7:28; MAT 13:53; JHN 19:30\x*
\v 2 “\w Sabem|strong="G6063"\w* \w que|strong="G3754"\w* \w depois de dois dias|strong="G3326,G1417,G2250"\w* \w a Páscoa|strong="G3588,G3957"\w* \w acontece|strong="G1096"\w*, \w e|strong="G2532"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w é entregue|strong="G3860"\w* \w para ser crucificado|strong="G1519,G3588,G4717"\w*.”\x - \xo 26:2 \xt MRK 14:1; JHN 19:16; JHN 18:32; LUK 22:1; 1CO 11:23; JHN 13:1\x*
\v 3 \w Então|strong="G5119"\w* \w se reuniram|strong="G4863"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os anciãos|strong="G3588,G4245"\w* \w do povo|strong="G3588,G2992"\w* \w no pátio|strong="G1519,G3588,G833"\w* \w do sumo sacerdote|strong="G3588,G749"\w*, \w chamado|strong="G3588,G3004"\w* \w Caifás|strong="G2533"\w*,\f + \fr 26.3: \ft Variante: o RP e o TR acrescentam καὶ οἱ γραμματεῖς (“e os escribas”) depois de “chefes dos sacerdotes”.\f*\x - \xo 26:3 \xt MAT 26:57; JHN 11:49; JHN 18:24; JHN 18:13; LUK 3:2; JHN 11:47\x*
\v 4 \w e|strong="G2532"\w* \w deliberaram|strong="G4823"\w* \w para que|strong="G2443"\w* \w prendessem|strong="G2902"\w* \w Jesus|strong="G3588,G2424"\w* \w com astúcia|strong="G1388"\w* \w e|strong="G2532"\w* \w o matassem|strong="G615"\w*;\x - \xo 26:4 \xt MRK 14:1; PRO 19:21; ACT 23:12; MAT 12:14; PSA 21:11; PSA 35:20\x*
\v 5 \w e diziam|strong="G3004,G1161"\w*: “\w Não|strong="G3361"\w* \w durante a festa|strong="G1722,G3588,G1859"\w*, \w para que não|strong="G2443,G3361"\w* \w haja|strong="G1096"\w* \w tumulto|strong="G2351"\w* \w entre o povo|strong="G1722,G3588,G2992"\w*.”\x - \xo 26:5 \xt MRK 14:2; PRO 19:21; LUK 7:36; MAT 27:24; PSA 21:11; MAT 14:5\x*
\p
\v 6 \w E estando|strong="G3588,G1161,G1096"\w* \w Jesus|strong="G2424"\w* \w em Betânia|strong="G1722,G963"\w*, \w na casa|strong="G1722,G3614"\w* \w de Simão|strong="G4613"\w*, \w o leproso|strong="G3588,G3015"\w*,\f + \fr 26.6: \ft Lit.: λεπρός, “leproso”, alguém com uma doença de pele que o tornava ritualmente impuro (Lv 13–14).\f*\x - \xo 26:6 \xt MRK 14:3; JHN 12:1; JHN 11:2; LUK 7:37; JHN 12:3; JHN 11:1-2\x*
\v 7 \w aproximou-se|strong="G4334"\w* \w dele|strong="G846"\w* \w uma mulher|strong="G1135"\w* \w que tinha|strong="G2192"\w* \w um frasco de alabastro|strong="G211"\w* \w de perfume|strong="G3464"\w* \w muito caro|strong="G927"\w*, \w e|strong="G2532"\w* \add o\add* \w derramou|strong="G2708"\w* \w sobre a cabeça|strong="G1909,G3588,G2776"\w* \w dele|strong="G846"\w*, \w que estava reclinado à mesa|strong="G345"\w*.\f + \fr 26.7: \ft Acréscimo: “o” (em “caro e o derramou sobre”): preposição ou artigo que a regência do português exige.\f*\x - \xo 26:7 \xt MRK 14:3; LUK 7:37; JHN 11:2; JHN 12:3; JHN 12:2-3; LUK 7:46\x*
\v 8 \w E vendo isso|strong="G1492,G1161"\w*, \w os discípulos|strong="G3588,G3101"\w* \w se indignaram|strong="G23"\w*, \w dizendo|strong="G3004"\w*: “\w Para que|strong="G1519,G5101"\w* \w este desperdício|strong="G3588,G684,G3778"\w*?\x - \xo 26:8 \xt MRK 14:4; JHN 12:3; JHN 12:4-6; MRK 14:3; LUK 7:37; JHN 12:5\x*
\v 9 \w Pois|strong="G1063"\w* \w isto|strong="G3778"\w* \w podia|strong="G1410"\w* \w ser vendido|strong="G4097"\w* \w por muito|strong="G4183"\w* \w e|strong="G2532"\w* \w dado|strong="G1325"\w* \w aos pobres|strong="G4434"\w*.”\f + \fr 26.9: \ft Variante: a NIV, o TR e o RP acrescentam τὸ μύρον (“o perfume”) depois de “isto”.\f*\x - \xo 26:9 \xt JHN 12:5; MRK 14:5; JHN 12:3; MRK 14:3; LUK 7:37; MRK 14:4\x*
\v 10 \w E Jesus|strong="G1161,G3588,G2424"\w*, \w percebendo|strong="G1097"\w*, \w lhes disse|strong="G2036,G846"\w*: \add “Por\add* \w que|strong="G5101"\w* \w incomodam|strong="G2873,G3930"\w* \w a mulher|strong="G3588,G1135"\w*? \w Pois|strong="G1063"\w* \w uma boa|strong="G2570"\w* \w obra|strong="G2041"\w* \w ela fez|strong="G2038"\w* \w a mim|strong="G1519,G1473"\w*;\f + \fr 26.10: \ft Lit.: κόπους παρέχω, “causar esforço, incomodar”.\f*\f + \fr 26.10: \ft Acréscimo: “Por” (em “lhes disse Por que incomodam”): preposição ou artigo que a regência do português exige.\f*\x - \xo 26:10 \xt MRK 14:6; GAL 6:17; JHN 6:28; JHN 12:3; MRK 14:3; TIT 3:8\x*
\v 11 \w pois|strong="G1063"\w* \w sempre|strong="G3842"\w* \w têm|strong="G2192"\w* \w os pobres|strong="G3588,G4434"\w* \w consigo|strong="G3326,G1438"\w*, \w mas a mim|strong="G1473,G1161"\w* \w não|strong="G3756"\w* \w sempre|strong="G3842"\w* \w têm|strong="G2192"\w*;\x - \xo 26:11 \xt JHN 12:8; MRK 14:7; DEU 15:11; JHN 12:3; MRK 14:3; JHN 16:28\x*
\v 12 \w pois|strong="G1063"\w* \w esta|strong="G3778"\w*, \w derramando|strong="G906"\w* \w este perfume|strong="G3588,G3464,G3778"\w* \w sobre o meu corpo|strong="G1909,G3588,G4983,G3165"\w*, \w fez isso|strong="G4160"\w* \w para me preparar para o sepultamento|strong="G4314,G3588,G1779,G3165"\w*.\f + \fr 26.12: \ft Lit.: ἐνταφιάζω, “preparar para o sepultamento (com perfumes e óleos)”.\f*\x - \xo 26:12 \xt JHN 12:3; MRK 14:3; LUK 7:37; MRK 14:9; JHN 12:7; MRK 14:8\x*
\v 13 \w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w*: \w onde quer que|strong="G3699,G1437"\w* \w seja proclamada|strong="G2784"\w* \w esta boa notícia|strong="G3588,G2098,G3778"\w* \w no mundo inteiro|strong="G1722,G3650,G3588,G2889"\w*, \w será contado|strong="G2980"\w* \w também|strong="G2532"\w* \w o que|strong="G3739"\w* \w ela fez|strong="G4160,G3778"\w*, \w em memória|strong="G1519,G3422"\w* \w dela|strong="G846"\w*.”\x - \xo 26:13 \xt MRK 14:9; MAT 24:14; JHN 12:3; MRK 14:3; ACT 10:4; LUK 7:37\x*
\p
\v 14 \w Então|strong="G5119"\w*, \w tendo ido|strong="G4198"\w* \w um|strong="G1520"\w* \w dos doze|strong="G3588,G1427"\w*, \w chamado|strong="G3588,G3004"\w* \w Judas|strong="G2455"\w* \w Iscariotes|strong="G2469"\w*, \w aos chefes dos sacerdotes|strong="G4314,G3588,G749"\w*,\x - \xo 26:14 \xt MRK 14:10; JHN 6:71; MRK 3:19; LUK 22:3; JHN 12:4; MAT 10:4\x*
\v 15 \w disse|strong="G2036"\w*: “\w O que|strong="G5101"\w* \w querem|strong="G2309"\w* \w me dar|strong="G3165,G1325"\w*, \w e eu|strong="G2532,G1473"\w* \w lhes entregarei|strong="G4771,G3860"\w* \w ele|strong="G846"\w*?” \w E eles|strong="G3588,G1161"\w* \w lhe fixaram|strong="G2476,G846"\w* \w trinta|strong="G5144"\w* \w moedas de prata|strong="G694"\w*.\f + \fr 26.15: \ft Lit.: ἵστημι, “pôr, fixar, pesar (o preço)”; a cena evoca Zc 11:12, onde o preço do pastor é trinta moedas de prata.\f*\x - \xo 26:15 \xt ZEC 11:12; JHN 6:71; EXO 21:32; GEN 25:34; LUK 22:3; MRK 14:10\x*
\v 16 \w E|strong="G2532"\w* \w desde então|strong="G575,G5119"\w* \w procurava|strong="G2212"\w* \w uma boa oportunidade|strong="G2120"\w* \w para entregá-lo|strong="G2443,G846,G3860"\w*.\x - \xo 26:16 \xt LUK 22:6; JHN 6:71; LUK 22:3; MRK 14:10; PSA 37:12; MRK 3:19\x*
\p
\v 17 \w E no primeiro dia|strong="G3588,G1161,G4413"\w* \w dos pães sem fermento|strong="G3588,G106"\w*, \w aproximaram-se|strong="G4334"\w* \w de Jesus|strong="G3588,G2424"\w* \w os discípulos|strong="G3588,G3101"\w*, \w dizendo|strong="G3004"\w*: “\w Onde|strong="G4226"\w* \w quer|strong="G2309"\w* \w que preparemos|strong="G2090"\w* \w para você|strong="G4771"\w* \w comer|strong="G5315"\w* \w a Páscoa|strong="G3588,G3957"\w*?”\f + \fr 26.17: \ft Lit.: ἄζυμα, “pães sem fermento”, a festa que acompanha a Páscoa (Êx 12:15-20).\f*\x - \xo 26:17 \xt EXO 12:15-20; MRK 14:12; LUK 22:7; LUK 22:9; EZR 6:22; 1CO 11:23\x*
\v 18 \w Mas ele|strong="G3588,G1161"\w* \w disse|strong="G2036"\w*: “\w Vão|strong="G5217"\w* \w à cidade|strong="G1519,G3588,G4172"\w* \w a certo homem|strong="G4314,G3588,G1170"\w*, \w e|strong="G2532"\w* \w digam-lhe|strong="G2036,G846"\w*: ‘\w O Mestre|strong="G3588,G1320"\w* \w diz|strong="G3004"\w*: “\w O meu tempo|strong="G3588,G2540,G3165"\w* \w está perto|strong="G1451,G1510"\w*; \w em sua casa|strong="G4314,G4771"\w* \w celebro|strong="G4160"\w* \w a Páscoa|strong="G3588,G3957"\w* \w com os meus discípulos|strong="G3326,G3588,G3101,G3165"\w*.”’”\f + \fr 26.18: \ft Lit.: τὸν δεῖνα, “fulano, certo homem” (designação de alguém não nomeado).\f*\x - \xo 26:18 \xt JHN 7:6; JHN 6:4; MRK 14:13; JHN 13:1; JHN 17:1; JHN 7:30\x*
\v 19 \w E|strong="G2532"\w* \w os discípulos|strong="G3588,G3101"\w* \w fizeram|strong="G4160"\w* \w como|strong="G5613"\w* \w lhes ordenou|strong="G4929,G846"\w* \w Jesus|strong="G3588,G2424"\w*, \w e|strong="G2532"\w* \w prepararam|strong="G2090"\w* \w a Páscoa|strong="G3588,G3957"\w*.\x - \xo 26:19 \xt MRK 14:12; LUK 22:13; MRK 14:16; EXO 12:11; LUK 22:10; MRK 11:4\x*
\p
\v 20 \w E chegada a tarde|strong="G3798,G1161,G1096"\w*, \w estava reclinado à mesa|strong="G345"\w* \w com os doze discípulos|strong="G3326,G3588,G1427,G3101"\w*\f + \fr 26.20: \ft Variante: o SBLGNT e WH trazem μαθητῶν (“discípulos”); Treg, NA28 e o RP omitem a palavra (“com os doze”).\f*.\x - \xo 26:20 \xt MRK 14:17; LUK 22:14; EXO 12:11; JHN 13:21; DEU 16:6; SNG 1:12\x*
\v 21 \w E|strong="G2532"\w*, \w enquanto comiam|strong="G2068,G846"\w*, \w disse|strong="G2036"\w*: “\w Em verdade|strong="G281"\w* \w lhes digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w um|strong="G1520"\w* \w de vocês|strong="G1537,G4771"\w* \w me entregará|strong="G3860,G3165"\w*.”\x - \xo 26:21 \xt MRK 14:18; JHN 13:21; PSA 55:12; HEB 4:13; JHN 6:70-71; PRO 29:1\x*
\v 22 \w E|strong="G2532"\w*, \w ficando muito tristes|strong="G3076,G4970"\w*, \w começaram|strong="G757"\w* \w a dizer-lhe|strong="G3004,G846"\w*, \w um por um|strong="G1520,G1538"\w*: “\w Será que sou eu|strong="G3385,G1473,G1510"\w*, \w Senhor|strong="G2962"\w*?”\x - \xo 26:22 \xt MRK 14:19; MAT 17:23; PSA 55:12; PRO 29:1; JHN 13:22; LUK 22:21\x*
\v 23 \w Mas ele|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: “\w O que|strong="G3588"\w* \w mergulhou|strong="G1686"\w* \w comigo|strong="G3326,G1473"\w* \w a mão|strong="G3588,G5495"\w* \w no prato|strong="G1722,G3588,G5165"\w*, \w este|strong="G3778"\w* \w me entregará|strong="G3165,G3860"\w*.\x - \xo 26:23 \xt MRK 14:20; PSA 41:9; JHN 13:18; MIC 7:6; JHN 13:26; PSA 55:12\x*
\v 24 \w O Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w*, \w de fato|strong="G3303"\w*, \w vai embora|strong="G5217"\w*, \w como|strong="G2531"\w* \w está escrito|strong="G1125"\w* \w a respeito dele|strong="G4012,G846"\w*; \w mas ai|strong="G3759,G1161"\w* \w daquele homem|strong="G3588,G444,G1565"\w* \w por meio de quem|strong="G1223,G3739"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w é entregue|strong="G3860"\w*! \w Melhor lhe seria|strong="G2570,G1510,G846"\w* \w se|strong="G1487"\w* \w não tivesse nascido|strong="G3756,G1080"\w* \w aquele homem|strong="G3588,G444,G1565"\w*.”\x - \xo 26:24 \xt MRK 14:21; LUK 22:22; MAT 18:7; ACT 26:22-23; LUK 24:46; MAT 26:54\x*
\v 25 \w E Judas|strong="G1161,G2455"\w*, \w o que o entregava|strong="G3588,G3860,G846"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w*: “\w Será que sou eu|strong="G3385,G1473,G1510"\w*, \w Rabi|strong="G4461"\w*?” \w Disse-lhe|strong="G3004,G846"\w*: “\w Você|strong="G4771"\w*\f + \fr 26.25: \ft Lit.: Σὺ εἶπας, “você o disse”: fórmula de resposta afirmativa, em tom reservado.\f* \add o\add* \w disse|strong="G2036"\w*.”\f + \fr 26.25: \ft Acréscimo: “o” (em “lhe Você o disse”): preposição ou artigo que a regência do português exige.\f*\x - \xo 26:25 \xt MRK 14:21; MAT 26:64; MAT 27:11; PSA 55:21; MAT 26:14; PRO 29:1\x*
\p
\v 26 \w E enquanto comiam|strong="G2068,G1161,G846"\w*, \w Jesus|strong="G3588,G2424"\w*, \w tomando|strong="G2983"\w* \w pão|strong="G740"\w* \w e|strong="G2532"\w* \w tendo abençoado|strong="G2127"\w*, \w partiu|strong="G2806"\w* \w e|strong="G2532"\w*, \w dando|strong="G1325"\w* \w aos discípulos|strong="G3588,G3101"\w*, \w disse|strong="G2036"\w*: “\w Tomem|strong="G2983"\w*, \w comam|strong="G5315"\w*; \w isto|strong="G3778"\w* \w é|strong="G1510"\w* \w o meu corpo|strong="G3588,G4983,G3165"\w*.”\f + \fr 26.26: \ft Lit.: εὐλογέω, “abençoar”, isto é, louvar a Deus pelo alimento.\f*\f + \fr 26.26: \ft Variante: o RP traz τὸν ἄρτον (“o pão”), εὐχαριστήσας (“tendo dado graças”) em lugar de εὐλογήσας, e ἐδίδου τοῖς μαθηταῖς καί (“dava aos discípulos e”) em lugar de “dando aos discípulos”.\f*\f + \fr 26.26: \ft Lit.: ἐστιν, “é”: o sentido do “é” (identidade, representação, presença) é discutido entre as tradições.\f*\x - \xo 26:26 \xt MRK 14:22; 1CO 10:16; LUK 22:19; LUK 24:30; MAT 14:19; ACT 27:35\x*
\v 27 \w E|strong="G2532"\w*, \w tomando|strong="G2983"\w* \w um cálice|strong="G4221"\w* \w e|strong="G2532"\w* \w tendo dado graças|strong="G2168"\w*, \w lhes deu|strong="G1325,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Bebam|strong="G4095"\w* \w dele|strong="G1537,G846"\w* \w todos|strong="G3956"\w*,\x - \xo 26:27 \xt MRK 14:23; 1CO 11:28; LUK 22:17; JHN 18:11; MAT 20:22; MRK 10:39\x*
\v 28 \w pois|strong="G1063"\w* \w isto|strong="G3778"\w* \w é|strong="G1510"\w* \w o meu sangue|strong="G3588,G129,G3165"\w* \w da aliança|strong="G3588,G1242"\w*, \w que é derramado|strong="G3588,G1632"\w* \w em favor de|strong="G4012"\w* \w muitos|strong="G4183"\w* \w para perdão|strong="G1519,G859"\w* \w de pecados|strong="G266"\w*.\f + \fr 26.28: \ft Lit.: διαθήκη, “aliança, pacto”; ἄφεσις, “perdão, remissão”.\f*\f + \fr 26.28: \ft Nota cultural: as palavras evocam Êx 24:8, a aliança selada com sangue no Sinai, e Jr 31:31-34, a nova aliança.\f*\f + \fr 26.28: \ft Variante: Treg e o RP trazem καινῆς (“da nova aliança”) depois de τῆς; o RP também traz τό depois de μου.\f*\x - \xo 26:28 \xt JER 31:31; EXO 24:8; MRK 14:24; EPH 1:7; HEB 9:20; COL 1:14\x*
\v 29 \w E lhes digo|strong="G3004,G1161,G4771"\w*: \w de modo algum|strong="G3756,G3361"\w* \w beberei|strong="G4095"\w* \w desde agora|strong="G575,G737"\w* \w deste fruto|strong="G1537,G3778,G3588,G6013"\w* \w da videira|strong="G3588,G288"\w* \w até aquele dia|strong="G2193,G3588,G2250,G1565"\w* \w em que|strong="G3752"\w* \w o|strong="G846"\w* \w beba|strong="G4095"\w* \w novo|strong="G2537"\w* \w com vocês|strong="G3326,G4771"\w* \w no reino|strong="G1722,G3588,G932"\w* \w do meu Pai|strong="G3588,G3962,G3165"\w*.”\x - \xo 26:29 \xt MRK 14:25; LUK 22:18; HEB 12:2; REV 7:17; MAT 6:9; MRK 14:22\x*
\p
\v 30 \w E|strong="G2532"\w*, \w tendo cantado um hino|strong="G5214"\w*, \w saíram|strong="G1831"\w* \w para o Monte|strong="G1519,G3588,G3735"\w* \w das Oliveiras|strong="G3588,G1636"\w*.\f + \fr 26.30: \ft Nota cultural: o “hino” é provavelmente o Hallel (Sl 113–118), cantado na ceia pascal.\f*\x - \xo 26:30 \xt MRK 14:26; LUK 22:39; JHN 8:1; MAT 21:1; MRK 11:1; HEB 5:7\x*
\v 31 \w Então|strong="G5119"\w* \w lhes disse|strong="G3004,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Todos|strong="G3956"\w* \w vocês|strong="G4771"\w* \w tropeçarão|strong="G4624"\w* \w por minha causa|strong="G1722,G1473"\w* \w nesta noite|strong="G1722,G3588,G3571,G3778"\w*; \w pois|strong="G1063"\w* \w está escrito|strong="G1125"\w*: ‘\w Ferirei|strong="G3960"\w* \w o pastor|strong="G3588,G4166"\w*, \w e|strong="G2532"\w* \w serão dispersadas|strong="G1287"\w* \w as ovelhas|strong="G3588,G4263"\w* \w do rebanho|strong="G3588,G4167"\w*.’\f + \fr 26.31: \ft Nota cultural: cita Zc 13:7.\f*\x - \xo 26:31 \xt ZEC 13:7; MRK 14:27; JHN 16:32; EZK 34:5-6; HEB 5:7; JHN 16:1\x*
\v 32 \w Mas depois|strong="G3326,G1161"\w* \w de eu ser ressuscitado|strong="G3588,G1453,G3165"\w*, \w irei adiante|strong="G4254"\w* \w de vocês|strong="G4771"\w* \w para a Galileia|strong="G1519,G3588,G1056"\w*.”\x - \xo 26:32 \xt MRK 14:28; MAT 28:7; MRK 16:7; HEB 5:7; JHN 16:1; MAT 28:16\x*
\v 33 \w E Pedro|strong="G1161,G3588,G4074"\w*, \w respondendo|strong="G611"\w*, \w lhe disse|strong="G2036,G846"\w*: \add “Ainda\add* \w que|strong="G1487"\w* \w todos|strong="G3956"\w* \w tropecem|strong="G4624"\w* \w por sua causa|strong="G1722,G4771"\w*, \w eu|strong="G1473"\w* \w nunca|strong="G3763"\w* \w tropeçarei|strong="G4624"\w*.”\f + \fr 26.33: \ft Acréscimo: “Ainda” (em “lhe disse Ainda que todos”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 26:33 \xt MRK 14:29; JHN 7:46; MAT 14:28; 1CO 10:12; HEB 5:7; JHN 16:1\x*
\v 34 \w Disse-lhe|strong="G5346,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Em verdade|strong="G281"\w* \w lhe digo|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w nesta noite|strong="G1722,G3778,G3588,G3571"\w*, \w antes que|strong="G4250"\w* \w um galo|strong="G220"\w* \w cante|strong="G5455"\w*, \w três vezes|strong="G5151"\w* \w você me negará|strong="G533,G3165"\w*.”\x - \xo 26:34 \xt MRK 14:30; LUK 22:34; MAT 26:75; LUK 22:61; JHN 13:38; MRK 14:72\x*
\v 35 \w Disse-lhe|strong="G3004,G846"\w* \w Pedro|strong="G3588,G4074"\w*: “\w Mesmo que|strong="G1437,G2532"\w* \w seja necessário|strong="G1163"\w* \w que eu|strong="G3165"\w* \w morra|strong="G599"\w* \w com você|strong="G4862,G4771"\w*, \w de modo algum|strong="G3756,G3361"\w* \w o negarei|strong="G4771,G533"\w*.” \w Da mesma forma|strong="G3668,G2532"\w* \w todos os discípulos|strong="G3956,G3588,G3101"\w* \w disseram|strong="G2036"\w*.\x - \xo 26:35 \xt HEB 5:7; LUK 22:33; 2TI 2:12; JHN 11:16; MAT 14:28; JHN 13:37\x*
\p
\v 36 \w Então|strong="G5119"\w* \w Jesus|strong="G3588,G2424"\w* \w veio|strong="G2064"\w* \w com eles|strong="G3326,G846"\w* \w a um lugar|strong="G1519,G5564"\w* \w chamado|strong="G3004"\w* \w Getsêmani|strong="G1068"\w*, \w e|strong="G2532"\w* \w disse|strong="G3004"\w* \w aos discípulos|strong="G3588,G3101"\w*: “\w Sentem-se|strong="G2523"\w* \w aqui|strong="G847"\w* \w até que|strong="G2193,G3739"\w* \add eu,\add* \w indo|strong="G565"\w* \w ali|strong="G1563"\w*, \w ore|strong="G4336"\w*.”\f + \fr 26.36: \ft Lit.: Gethsemani, do aramaico, “prensa de azeite”, nome de um lugar no Monte das Oliveiras.\f*\f + \fr 26.36: \ft Acréscimo: “eu” (em “até que eu indo ali”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 26:36 \xt MRK 14:32; MAT 6:6; HEB 5:7; PSA 69:13; LUK 22:40; JHN 18:1\x*
\v 37 \w E|strong="G2532"\w*, \w tomando consigo|strong="G3880"\w* \w Pedro|strong="G3588,G4074"\w* \w e|strong="G2532"\w* \w os dois|strong="G3588,G1417"\w* \w filhos|strong="G5207"\w* \w de Zebedeu|strong="G2199"\w*, \w começou|strong="G757"\w* \w a entristecer-se|strong="G3076"\w* \w e|strong="G2532"\w* \w a angustiar-se|strong="G85"\w*.\x - \xo 26:37 \xt MRK 14:33; MAT 6:6; HEB 5:7; MAT 17:1; PSA 69:13; LUK 22:40\x*
\v 38 \w Então|strong="G5119"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Está profundamente triste|strong="G4036,G1510"\w* \w a minha alma|strong="G3588,G5590,G3165"\w* \w até a morte|strong="G2193,G2288"\w*; \w fiquem|strong="G3306"\w* \w aqui|strong="G5602"\w* \w e|strong="G2532"\w* \w vigiem|strong="G1127"\w* \w comigo|strong="G3326,G1473"\w*.”\f + \fr 26.38: \ft Variante: o RP e o texto bizantino acrescentam ὁ Ἰησοῦς (“Jesus”) depois de “lhes disse”.\f*\x - \xo 26:38 \xt MRK 14:34; MAT 6:6; HEB 5:7; PSA 20:1; MAT 24:42; JHN 12:27\x*
\v 39 \w E|strong="G2532"\w*, \w avançando|strong="G4281"\w* \w um pouco|strong="G3398"\w*, \w caiu|strong="G4098"\w* \w sobre o seu rosto|strong="G1909,G4383,G846"\w*, \w orando|strong="G4336"\w* \w e|strong="G2532"\w* \w dizendo|strong="G3004"\w*: “\w Meu Pai|strong="G3962,G3165"\w*, \w se|strong="G1487"\w* \w é possível|strong="G1415,G1510"\w*, \w passe|strong="G3928"\w* \w de mim|strong="G575,G1473"\w* \w este cálice|strong="G3588,G4221,G3778"\w*; \w contudo|strong="G4133"\w*, \w não|strong="G3756"\w* \w como eu|strong="G5613,G1473"\w* \w quero|strong="G2309"\w*, \w mas como|strong="G235,G5613"\w* \w você|strong="G4771"\w*.”\f + \fr 26.39: \ft Nota cultural: o “cálice” é imagem do destino determinado por Deus (cf. 20:22; Is 51:17).\f*\x - \xo 26:39 \xt ISA 51:17; MRK 14:35; MRK 14:36; LUK 22:42; JHN 6:38; MAT 6:6\x*
\v 40 \w E|strong="G2532"\w* \w veio|strong="G2064"\w* \w aos discípulos|strong="G4314,G3588,G3101"\w* \w e|strong="G2532"\w* \w os encontrou|strong="G2147,G846"\w* \w dormindo|strong="G2518"\w*, \w e|strong="G2532"\w* \w disse|strong="G3004"\w* \w a Pedro|strong="G3588,G4074"\w*: “\w Assim|strong="G3779"\w*, \w não|strong="G3756"\w* \w foram capazes|strong="G2480"\w* \w de vigiar|strong="G1127"\w* \w uma hora|strong="G1520,G5610"\w* \w comigo|strong="G3326,G1473"\w*?\x - \xo 26:40 \xt MRK 14:37; 1TH 5:6; MAT 26:43; MAT 25:13; 1CO 10:12; ROM 13:11\x*
\v 41 \w Vigiem|strong="G1127"\w* \w e|strong="G2532"\w* \w orem|strong="G4336"\w*, \w para que não|strong="G2443,G3361"\w* \w entrem|strong="G1525"\w* \w em provação|strong="G1519,G3986"\w*; \w o espírito|strong="G3588,G4151"\w*, \w de fato|strong="G3303"\w*, \w está disposto|strong="G4289"\w*, \w mas a carne|strong="G3588,G1161,G4561"\w* \w é fraca|strong="G772"\w*.”\f + \fr 26.41: \ft Acréscimo: verbo ser/estar suprido em “está disposto”, “é fraca”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 26:41 \xt MRK 14:38; LUK 22:46; LUK 22:40; 1CO 16:13; EPH 6:18; MAT 6:13\x*
\v 42 \w De novo|strong="G3825"\w*, \w pela segunda vez|strong="G1537,G1208"\w*, \w indo|strong="G565"\w*, \w orou|strong="G4336"\w*, \w dizendo|strong="G3004"\w*: “\w Meu Pai|strong="G3962,G3165"\w*, \w se|strong="G1487"\w* \w não|strong="G3756"\w* \w é possível|strong="G1410"\w* \w que isto|strong="G3778"\w* \w passe|strong="G3928"\w* \w a menos que|strong="G1437,G3361"\w* \add eu\add* \w o|strong="G846"\w* \w beba|strong="G4095"\w*, \w seja feita|strong="G1096"\w* \w a sua vontade|strong="G3588,G2307,G4771"\w*.”\f + \fr 26.42: \ft Variante: o RP e o TR acrescentam τὸ ποτήριον (“o cálice”) depois de “isto” e ἀπʼ ἐμοῦ (“de mim”) depois de “passe”.\f*\f + \fr 26.42: \ft Acréscimo: “eu” (em “menos que eu o beba”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 26:42 \xt MRK 14:39; MAT 6:10; LUK 22:42; MAT 26:39; HEB 5:7; MAT 20:22\x*
\v 43 \w E|strong="G2532"\w*, \w voltando|strong="G2064"\w*, \w de novo|strong="G3825"\w* \w os encontrou|strong="G2147,G846"\w* \w dormindo|strong="G2518"\w*, \w pois|strong="G1063"\w* \w os olhos|strong="G3588,G3788"\w* \w deles|strong="G846"\w* \w estavam|strong="G1510"\w* \w pesados|strong="G916"\w*.\x - \xo 26:43 \xt MRK 14:40; MAT 26:40; HEB 5:7; MRK 14:39; PSA 69:13; 2CO 12:8\x*
\v 44 \w E|strong="G2532"\w*, \w deixando-os|strong="G863,G846"\w*, \w de novo|strong="G3825"\w*, \w indo|strong="G565"\w*, \w orou|strong="G4336"\w* \w pela terceira vez|strong="G1537,G5154"\w*, \w dizendo|strong="G2036"\w* \w a mesma|strong="G3588,G846"\w* \w palavra|strong="G3056"\w* \w de novo|strong="G3825"\w*.\x - \xo 26:44 \xt MRK 14:39; JHN 20:10; JHN 4:3; HEB 5:7; MAT 6:7; PSA 69:13\x*
\v 45 \w Então|strong="G5119"\w* \w veio|strong="G2064"\w* \w aos discípulos|strong="G4314,G3588,G3101"\w* \w e|strong="G2532"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Durmam|strong="G2518"\w* \w daqui em diante|strong="G3588,G3063"\w* \w e|strong="G2532"\w* \w descansem|strong="G373"\w*; \w olhem|strong="G2400"\w*, \w chegou perto|strong="G1448"\w* \w a hora|strong="G3588,G5610"\w*, \w e|strong="G2532"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w é entregue|strong="G3860"\w* \w nas mãos|strong="G1519,G5495"\w* \w de pecadores|strong="G268"\w*.\x - \xo 26:45 \xt MRK 14:41; PSA 69:13; LUK 22:40; EXO 17:12; JHN 13:1; ISA 29:9\x*
\v 46 \w Levantem-se|strong="G1453"\w*, \w vamos|strong="G71"\w*; \w olhem|strong="G2400"\w*, \w chegou perto|strong="G1448"\w* \w o que me entrega|strong="G3588,G3860,G3165"\w*.”\x - \xo 26:46 \xt MRK 14:42; PSA 69:13; LUK 22:40; MAT 17:22; JHN 14:31; MRK 14:32\x*
\p
\v 47 \w E|strong="G2532"\w*, \w enquanto ele ainda falava|strong="G2089,G846,G2980"\w*, \w olhem|strong="G2400"\w*, \w Judas|strong="G2455"\w*, \w um|strong="G1520"\w* \w dos doze|strong="G3588,G1427"\w*, \w veio|strong="G2064"\w*, \w e|strong="G2532"\w* \w com ele|strong="G3326,G846"\w* \w uma grande multidão|strong="G3793,G4183"\w* \w com espadas|strong="G3326,G3162"\w* \w e|strong="G2532"\w* \w paus|strong="G3586"\w*, \w da parte|strong="G575"\w* \w dos chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w anciãos|strong="G4245"\w* \w do povo|strong="G3588,G2992"\w*.\x - \xo 26:47 \xt MRK 14:43; LUK 22:47; MAT 26:14; MAT 26:55; ACT 1:16; MRK 3:19\x*
\v 48 \w E o que o entregava|strong="G3588,G1161,G3860,G846"\w* \w lhes deu|strong="G1325,G846"\w* \w um sinal|strong="G4592"\w*, \w dizendo|strong="G3004"\w*: “\w Aquele a quem|strong="G3739,G302"\w* \w eu beijar|strong="G5368"\w*, \w este|strong="G846"\w* \w é|strong="G1510"\w*; \w prendam-no|strong="G2902,G846"\w*.”\f + \fr 26.48: \ft Tradução: φιλήσω (φιλέω, G5368) está aqui como “eu beijar”; o termo pode ser “amar (com afeição)”, “gostar de”, “beijar” ou “ter apreço”, e o contexto decide.\f*\x - \xo 26:48 \xt MRK 14:44; LUK 22:48; PRO 27:6; MRK 14:43; 2SA 20:9; JER 9:8\x*
\v 49 \w E|strong="G2532"\w* \w imediatamente|strong="G2112"\w*, \w aproximando-se|strong="G4334"\w* \w de Jesus|strong="G3588,G2424"\w*, \w disse|strong="G2036"\w*: “\w Salve|strong="G5463"\w*, \w Rabi|strong="G4461"\w*!” \w E|strong="G2532"\w* \w o beijou|strong="G2705,G846"\w*.\f + \fr 26.49: \ft Tradução: Χαῖρε (χαίρω, G5463) está aqui como “Salve”; o termo pode ser “alegrar-se”, “regozijar-se” ou “saudar” (χαῖρε como saudação), e o contexto decide.\f*\x - \xo 26:49 \xt MRK 14:45; PRO 18:24; MIC 7:6; LUK 22:48; MRK 14:44; PRO 27:6\x*
\v 50 \w Mas Jesus|strong="G3588,G1161,G2424"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Amigo|strong="G2083"\w*, \w para o que|strong="G1909,G3739"\w* \w você veio|strong="G3918"\w*.” \w Então|strong="G5119"\w*, \w aproximando-se|strong="G4334"\w*, \w lançaram|strong="G1911"\w* \w as mãos|strong="G3588,G5495"\w* \w sobre Jesus|strong="G1909,G3588,G2424"\w* \w e|strong="G2532"\w* \w o prenderam|strong="G2902,G846"\w*.\f + \fr 26.50: \ft Lit.: ἐφʼ ὃ πάρει é frase breve, que pode ser lida como afirmação (“faça aquilo para que veio”) ou como pergunta (“para que você veio?”).\f*\x - \xo 26:50 \xt MRK 14:46; MAT 20:13; PRO 18:24; MAT 22:12; MIC 7:6; LUK 22:48\x*
\v 51 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w um|strong="G1520"\w* \w dos que estavam|strong="G3588,G3326"\w* \w com Jesus|strong="G2424"\w*, \w estendendo|strong="G1614"\w* \w a mão|strong="G3588,G5495"\w*, \w puxou|strong="G645"\w* \w a sua espada|strong="G3588,G3162,G846"\w* \w e|strong="G2532"\w*, \w ferindo|strong="G3960"\w* \w o escravo|strong="G3588,G1401"\w* \w do sumo sacerdote|strong="G3588,G749"\w*, \w lhe cortou|strong="G851,G846"\w* \w a orelha|strong="G3588,G5621"\w*.\f + \fr 26.51: \ft Acréscimo: verbo ser/estar suprido em “dos que estavam”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 26:51 \xt LUK 22:50; LUK 22:49; MRK 14:47; JHN 18:10; 2CO 10:4; JHN 18:36\x*
\v 52 \w Então|strong="G5119"\w* \w lhe disse|strong="G3004,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Devolva|strong="G654"\w* \w a sua espada|strong="G3588,G3162,G4771"\w* \w ao lugar dela|strong="G1519,G3588,G5117,G846"\w*; \w pois|strong="G1063"\w* \w todos|strong="G3956"\w* \w os que pegam|strong="G3588,G2983"\w* \w espada|strong="G3162"\w* \w pela espada|strong="G1722,G3162"\w* \w perecerão|strong="G622"\w*.\x - \xo 26:52 \xt GEN 9:6; REV 13:10; ROM 12:19; JHN 18:10; 1PE 2:21-23; 1PE 3:9\x*
\v 53 \w Ou|strong="G2228"\w* \w acha|strong="G1380"\w* \w que|strong="G3754"\w* \w não|strong="G3756"\w* \w posso|strong="G1410"\w* \w pedir ajuda|strong="G3870"\w* \w ao meu Pai|strong="G3588,G3962,G3165"\w*, \w e|strong="G2532"\w* \w ele me colocaria à disposição|strong="G3936,G3165"\w* \w agora|strong="G737"\w* \w mais de|strong="G4183"\w* \w doze|strong="G1427"\w* \w legiões|strong="G3003"\w* \w de anjos|strong="G32"\w*?\f + \fr 26.53: \ft Lit.: λεγιών, “legião”, unidade do exército romano de cerca de seis mil soldados.\f*\f + \fr 26.53: \ft Tradução: δοκεῖς (δοκέω, G1380) está aqui como “acha”; o termo pode ser “parecer”, “pensar”, “julgar” ou “ser considerado”, e o contexto decide.\f*\x - \xo 26:53 \xt 2KI 6:16; MAT 4:11; 2KI 6:17; JHN 18:10; PSA 55:18; LUK 22:43\x*
\v 54 \w Como|strong="G4459"\w*, \w então|strong="G3767"\w*, \w se cumpririam|strong="G4137"\w* \w as Escrituras|strong="G3588,G1124"\w*, \w de que|strong="G3754"\w* \w assim|strong="G3779"\w* \w é necessário|strong="G1163"\w* \w acontecer|strong="G1096"\w*?”\x - \xo 26:54 \xt MRK 14:49; MAT 26:56; ACT 1:16; 2TI 3:16; JHN 3:14; JHN 18:10\x*
\v 55 \w Naquela hora|strong="G1722,G1565,G3588,G5610"\w* \w disse|strong="G2036"\w* \w Jesus|strong="G3588,G2424"\w* \w às multidões|strong="G3588,G3793"\w*: “\w Como contra|strong="G5613,G1909"\w* \w um assaltante|strong="G3027"\w* \w saíram|strong="G1831"\w* \w com espadas|strong="G3326,G3162"\w* \w e|strong="G2532"\w* \w paus|strong="G3586"\w* \w para me prender|strong="G4815,G3165"\w*? \w Dia após dia|strong="G2596,G2250"\w* \w no templo|strong="G1722,G3588,G2411"\w* \w me sentava|strong="G2516"\w* \w ensinando|strong="G1321"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w me prenderam|strong="G2902,G3165"\w*.\f + \fr 26.55: \ft Variante: Treg, o RP e o TR acrescentam πρὸς ὑμᾶς (“junto a vocês”) depois de “dia após dia”; o RP traz a ordem ἐκαθεζόμην διδάσκων ἐν τῷ ἱερῷ.\f*\x - \xo 26:55 \xt MRK 14:48; LUK 22:52; MAT 26:47; JHN 10:18; JHN 8:2; JHN 18:20\x*
\v 56 \w Mas tudo isto|strong="G3778,G1161,G3650"\w* \w aconteceu|strong="G1096"\w* \w para que se cumprissem|strong="G2443,G4137"\w* \w as Escrituras|strong="G3588,G1124"\w* \w dos profetas|strong="G3588,G4396"\w*.” \w Então|strong="G5119"\w* \w todos os discípulos|strong="G3588,G3101,G3956"\w*, \w deixando-o|strong="G863,G846"\w*, \w fugiram|strong="G5343"\w*.\f + \fr 26.56: \ft Lit.: a frase “Mas tudo isto aconteceu…” pode ser lida como fala de Jesus ou como comentário do narrador.\f*\x - \xo 26:56 \xt MRK 14:50; MAT 26:54; MAT 21:4; MRK 14:49; MAT 4:14; ZEC 13:7\x*
\p
\v 57 \w Mas os que prenderam|strong="G3588,G1161,G2902"\w* \w Jesus|strong="G3588,G2424"\w* \w o levaram|strong="G520"\w* \w a Caifás|strong="G4314,G2533"\w*, \w o sumo sacerdote|strong="G3588,G749"\w*, \w onde|strong="G3699"\w* \w os escribas|strong="G3588,G1122"\w* \w e|strong="G2532"\w* \w os anciãos|strong="G3588,G4245"\w* \w se haviam reunido|strong="G4863"\w*.\x - \xo 26:57 \xt MRK 14:53; MAT 26:3; JHN 18:24; JHN 18:13; LUK 22:54; JHN 18:12\x*
\v 58 \w E Pedro|strong="G3588,G1161,G4074"\w* \w o seguia|strong="G190,G846"\w* \w de longe|strong="G575,G3113"\w* \w até o pátio|strong="G2193,G3588,G833"\w* \w do sumo sacerdote|strong="G3588,G749"\w*, \w e|strong="G2532"\w*, \w entrando|strong="G1525"\w* \w lá dentro|strong="G2080"\w*, \w sentou-se|strong="G2521"\w* \w com os guardas|strong="G3326,G3588,G5257"\w* \w para ver|strong="G1492"\w* \w o fim|strong="G3588,G5056"\w*.\x - \xo 26:58 \xt MRK 14:54; LUK 22:54; JHN 18:15; MRK 14:66; JHN 7:45; JHN 7:32\x*
\v 59 \w Mas os chefes dos sacerdotes|strong="G3588,G1161,G749"\w* \w e|strong="G2532"\w* \w todo o Sinédrio|strong="G3588,G4892,G3650"\w* \w procuravam|strong="G2212"\w* \w falso testemunho|strong="G5577"\w* \w contra Jesus|strong="G2596,G3588,G2424"\w*, \w para que o pusessem à morte|strong="G3704,G846,G2289"\w*\f + \fr 26.59: \ft Variante: o RP e o TR acrescentam οἱ πρεσβύτεροι καί (“os anciãos e”) depois de “chefes dos sacerdotes”; Treg traz θανατώσουσιν (“matarão”) em lugar de θανατώσωσιν, e o RP traz a ordem θανατώσωσιν αὐτόν.\f*,\x - \xo 26:59 \xt MRK 14:55; PSA 2:2; EXO 20:16; PSA 27:12; ACT 6:11; PSA 64:6\x*
\v 60 \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w encontraram|strong="G2147"\w*, \w embora se aproximassem|strong="G4334"\w* \w muitas|strong="G4183"\w* \w falsas testemunhas|strong="G5575"\w*. \w Por fim|strong="G5306,G1161"\w*, \w aproximando-se|strong="G4334"\w* \w dois|strong="G1417"\w*\x - \xo 26:60 \xt JHN 2:19; EXO 20:16; PSA 27:12; ACT 6:11; DEU 19:15; EXO 23:1\x*
\v 61 \w disseram|strong="G2036"\w*: “\w Este|strong="G3778"\w* \w disse|strong="G5346"\w*: ‘\w Posso|strong="G1410"\w* \w destruir|strong="G2647"\w* \w o santuário|strong="G3588,G3485"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w em três dias|strong="G1223,G5140,G2250"\w* \w reconstruí-lo|strong="G3618"\w*.’”\x - \xo 26:61 \xt MAT 27:40; MRK 15:29; JHN 2:19; MRK 14:58; EXO 23:1; PSA 119:69\x*
\v 62 \w E|strong="G2532"\w*, \w levantando-se|strong="G450"\w* \w o sumo sacerdote|strong="G3588,G749"\w*, \w lhe disse|strong="G2036,G846"\w*: “\w Nada|strong="G3762"\w* \w responde|strong="G611"\w*? \w O que|strong="G5101"\w* \w estes|strong="G3778"\w* \w testemunham|strong="G2649"\w* \w contra você|strong="G4771"\w*?”\x - \xo 26:62 \xt MRK 14:60; MAT 27:12; ACT 8:32; PSA 119:69; MRK 14:53; JHN 18:15\x*
\v 63 \w Mas Jesus|strong="G3588,G1161,G2424"\w* \w permanecia calado|strong="G4623"\w*. \w E|strong="G2532"\w* \w o sumo sacerdote|strong="G3588,G749"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Eu o faço jurar|strong="G1844,G4771"\w* \w pelo Deus|strong="G2596,G3588,G2316"\w* \w vivo|strong="G3588,G2198"\w*, \w que nos diga|strong="G2443,G3165,G2036"\w* \w se|strong="G1487"\w* \w você|strong="G4771"\w* \w é|strong="G1510"\w* \w o Cristo|strong="G3588,G5547"\w*, \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w*.”\f + \fr 26.63: \ft Lit.: ἐξορκίζω, “fazer jurar, conjurar”.\f*\x - \xo 26:63 \xt MRK 14:61; ISA 53:7; MAT 16:16; ACT 8:32; LEV 5:1; HEB 1:2\x*
\v 64 \w Disse-lhe|strong="G3004,G846"\w* \w Jesus|strong="G3588,G2424"\w*: \add “Você mesmo\add* \w disse|strong="G4771,G2036"\w*; \w mas|strong="G4133"\w* \w eu lhes digo|strong="G3004,G4771"\w*: \w desde agora|strong="G575,G737"\w* \w verão|strong="G3700"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w sentado|strong="G2521"\w* \w à direita|strong="G1537,G1188"\w* \w do Poder|strong="G3588,G1411"\w* \w e|strong="G2532"\w* \w vindo|strong="G2064"\w* \w sobre as nuvens|strong="G1909,G3588,G3507"\w* \w do céu|strong="G3588,G3772"\w*.”\f + \fr 26.64: \ft Nota cultural: combina Sl 110:1 e Dn 7:13; “o Poder” é modo reverente de designar Deus.\f*\f + \fr 26.64: \ft Acréscimo: “Você” (em “lhe Jesus Você mesmo disse”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo; “mesmo” (em “Jesus Você mesmo disse mas”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 26:64 \xt DAN 7:13; PSA 110:1; MRK 14:62; LUK 21:27; LUK 22:69; MAT 24:30\x*
\v 65 \w Então|strong="G5119"\w* \w o sumo sacerdote|strong="G3588,G749"\w* \w rasgou|strong="G1284"\w* \w as suas vestes|strong="G3588,G2440,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Blasfemou|strong="G987"\w*! \w Que|strong="G5101"\w* \w mais|strong="G2089"\w* \w necessidade|strong="G5532"\w* \w temos|strong="G2192"\w* \w de testemunhas|strong="G3144"\w*? \w Olhem|strong="G2396"\w*, \w agora|strong="G3568"\w* \w ouviram|strong="G191"\w* \w a blasfêmia|strong="G3588,G988"\w*\f + \fr 26.65: \ft Lit.: rasgar as vestes era gesto de horror ou de luto.\f*.\x - \xo 26:65 \xt MRK 14:63; ACT 14:14; ISA 53:8; ACT 7:56; JHN 19:7; LEV 21:10\x*
\v 66 \w O que|strong="G5101"\w* \w lhes parece|strong="G4771,G1380"\w*?” \w E eles|strong="G3588,G1161"\w*, \w respondendo|strong="G611"\w*, \w disseram|strong="G2036"\w*: “\w É|strong="G1510"\w* \w réu|strong="G1777"\w* \w de morte|strong="G2288"\w*.”\x - \xo 26:66 \xt ISA 53:8; JHN 19:7; PSA 119:69; JER 26:11; MRK 14:53; DEU 21:22\x*
\v 67 \w Então|strong="G5119"\w* \w cuspiram|strong="G1716"\w* \w no seu rosto|strong="G1519,G3588,G4383,G846"\w* \w e|strong="G2532"\w* \w o esmurraram|strong="G2852,G846"\w*; \w e outros|strong="G3588,G1161"\w* \w lhe deram tapas|strong="G4474"\w*\f + \fr 26.67: \ft Lit.: κολαφίζω, “esbofetear, golpear com o punho”; ῥαπίζω, “bater (com vara ou com a palma da mão)”.\f*,\x - \xo 26:67 \xt MRK 14:65; ISA 53:3; ISA 50:6; HEB 12:2; ISA 52:14; ISA 49:7\x*
\v 68 \w dizendo|strong="G3004"\w*: “\w Profetize|strong="G4395"\w* \w para nós|strong="G3165"\w*, \w Cristo|strong="G5547"\w*: \w quem|strong="G5101"\w* \w é|strong="G1510"\w* \w o que bateu|strong="G3588,G3817"\w* \w em você|strong="G4771"\w*?”\x - \xo 26:68 \xt LUK 22:64; HEB 12:2; MRK 14:65; LUK 22:63; PSA 119:69; MRK 14:53\x*
\p
\v 69 \w E Pedro|strong="G3588,G1161,G4074"\w* \w estava sentado|strong="G2521"\w* \w fora|strong="G1854"\w* \w no pátio|strong="G1722,G3588,G833"\w*; \w e|strong="G2532"\w* \w aproximou-se|strong="G4334"\w* \w dele|strong="G846"\w* \w uma serva|strong="G1520,G3814"\w*, \w dizendo|strong="G3004"\w*: “\w Também você|strong="G2532,G4771"\w* \w estava|strong="G1510"\w* \w com Jesus|strong="G3326,G2424"\w*, \w o galileu|strong="G3588,G1057"\w*.”\x - \xo 26:69 \xt MRK 14:66; LUK 22:55; JHN 18:17; PRO 29:25; 1PE 3:6; 1KI 19:13\x*
\v 70 \w Mas ele|strong="G3588,G1161"\w* \w negou|strong="G720"\w* \w diante de todos|strong="G1715,G3956"\w*, \w dizendo|strong="G3004"\w*: “\w Não|strong="G3756"\w* \w sei|strong="G6063"\w* \w o que|strong="G5101"\w* \w diz|strong="G3004"\w*.”\x - \xo 26:70 \xt MAT 10:33; REV 3:8; PRO 29:25; 1PE 3:6; 1CO 10:12; GEN 27:19\x*
\v 71 \w E tendo ele saído|strong="G1831,G1161"\w* \w para o pórtico|strong="G1519,G3588,G4440"\w*, \w outra serva|strong="G243"\w* \w o viu|strong="G1492,G846"\w* \w e|strong="G2532"\w* \w disse|strong="G3004"\w* \w aos que estavam ali|strong="G3588,G1563"\w*: “\w Este|strong="G3778"\w* \w estava|strong="G1510"\w* \w com Jesus|strong="G3326,G2424"\w*, \w o nazareno|strong="G3588,G3480"\w*.”\f + \fr 26.71: \ft Acréscimo: verbo ser/estar suprido em “aos que estavam ali”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 26:71 \xt REV 3:8; PRO 29:25; 1PE 3:6; MAT 10:33; GEN 27:19; MRK 10:47\x*
\v 72 \w E|strong="G2532"\w* \w de novo|strong="G3825"\w* \w negou|strong="G720"\w* \w com juramento|strong="G3326,G3727"\w*: “\w Não|strong="G3756"\w* \w conheço|strong="G6063"\w* \w esse homem|strong="G3588,G444"\w*.”\x - \xo 26:72 \xt MAT 5:33; REV 3:8; PRO 29:25; 1PE 3:6; MAT 10:33; PRO 30:9\x*
\v 73 \w E pouco depois|strong="G3326,G3398,G1161"\w*, \w aproximando-se|strong="G4334"\w* \w os que estavam ali|strong="G3588,G2476"\w*, \w disseram|strong="G2036"\w* \w a Pedro|strong="G3588,G4074"\w*: “\w Verdadeiramente|strong="G230"\w* \w também você|strong="G2532,G4771"\w* \w é|strong="G1510"\w* \w um deles|strong="G1537,G846"\w*; \w pois também|strong="G2532,G1063"\w* \w o seu modo de falar|strong="G3588,G2981,G4771"\w* \w o denuncia|strong="G1212,G4771,G4160"\w*.”\x - \xo 26:73 \xt MRK 14:70; PRO 29:25; 1PE 3:6; ACT 4:13; MAT 10:33; GEN 27:19\x*
\v 74 \w Então|strong="G5119"\w* \w começou|strong="G757"\w* \w a amaldiçoar-se|strong="G2653"\w* \w e|strong="G2532"\w* \w a jurar|strong="G3660"\w*: “\w Não|strong="G3756"\w* \w conheço|strong="G6063"\w* \w esse homem|strong="G3588,G444"\w*!” \w E|strong="G2532"\w* \w imediatamente|strong="G2112"\w* \w um galo|strong="G220"\w* \w cantou|strong="G5455"\w*\f + \fr 26.74: \ft Lit.: καταθεματίζω, “lançar maldição (sobre si mesmo, se mentir)”.\f*.\x - \xo 26:74 \xt JHN 18:27; LUK 22:60; MRK 14:71; LUK 22:34; PRO 29:25; 1PE 3:6\x*
\v 75 \w E|strong="G2532"\w* \w Pedro|strong="G3588,G4074"\w* \w se lembrou|strong="G3403"\w* \w da palavra|strong="G3588,G4487"\w* \w que Jesus tinha dito|strong="G2424,G2046"\w*: “\w Antes que|strong="G4250"\w* \w um galo|strong="G220"\w* \w cante|strong="G5455"\w*, \w três vezes|strong="G5151"\w* \w você me negará|strong="G533,G3165"\w*.” \w E|strong="G2532"\w*, \w saindo|strong="G1831"\w* \w fora|strong="G1854"\w*, \w chorou|strong="G2799"\w* \w amargamente|strong="G4090"\w*.\x - \xo 26:75 \xt MAT 26:34; MRK 14:72; LUK 22:62; LUK 22:61; MRK 14:30; LUK 22:34\x*
\c 27
\p
\v 1 \w E chegada a manhã|strong="G4405,G1161,G1096"\w*, \w tomaram conselho|strong="G4824,G2983"\w* \w todos os chefes dos sacerdotes|strong="G3956,G3588,G749"\w* \w e|strong="G2532"\w* \w os anciãos|strong="G3588,G4245"\w* \w do povo|strong="G3588,G2992"\w* \w contra Jesus|strong="G2596,G3588,G2424"\w* \w para pô-lo à morte|strong="G5620,G2289,G846"\w*;\x - \xo 27:1 \xt MRK 15:1; MAT 28:12; PSA 2:2; PSA 22:12; LUK 23:1; PSA 31:13\x*
\v 2 \w e|strong="G2532"\w*, \w tendo-o amarrado|strong="G1210,G846"\w*, \w o levaram|strong="G520"\w* \w e|strong="G2532"\w* \w o entregaram|strong="G3860"\w* \w a Pilatos|strong="G4091"\w*, \w o governador|strong="G3588,G2232"\w*.\f + \fr 27.2: \ft Variante: o RP e o TR acrescentam αὐτὸν Ποντίῳ (“a Pôncio”) antes de “Pilatos”.\f*\x - \xo 27:2 \xt MRK 15:1; LUK 23:1; ACT 3:13; ACT 4:27; MAT 20:19; LUK 3:1\x*
\v 3 \w Então|strong="G5119"\w* \w Judas|strong="G2455"\w*, \w o que o entregara|strong="G3588,G3860,G846"\w*, \w vendo|strong="G1492"\w* \w que|strong="G3754"\w* \w foi condenado|strong="G2632"\w*, \w sentindo remorso|strong="G3338"\w*, \w devolveu|strong="G4762"\w* \w as trinta|strong="G3588,G5144"\w* \w moedas de prata|strong="G694"\w* \w aos chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w anciãos|strong="G4245"\w*,\f + \fr 27.3: \ft Lit.: μεταμέλομαι, “sentir pesar, remorso” (não é o verbo usual para o arrependimento que leva à conversão, μετανοέω).\f*\x - \xo 27:3 \xt ACT 1:18; ZEC 11:13; JOB 20:15; 2CO 7:10; MAT 26:14; PSA 15:5\x*
\v 4 \w dizendo|strong="G3004"\w*: “\w Pequei|strong="G264"\w*, \w entregando|strong="G3860"\w* \w sangue|strong="G129"\w* \w inocente|strong="G121"\w*.” \w Mas eles|strong="G3588,G1161"\w* \w disseram|strong="G2036"\w*: “\w O que|strong="G5101"\w* \w isso tem a ver|strong="G4314"\w* \w conosco|strong="G3165"\w*? \w Veja você mesmo|strong="G4771,G3708"\w*.”\f + \fr 27.4: \ft Variante: WH traz δίκαιον (“justo”) em lugar de ἀθῷον (“inocente”); o RP traz ὄψει em lugar de ὄψῃ.\f*\x - \xo 27:4 \xt MAT 27:24; ACT 1:18; ZEC 11:13; JOB 20:15; 1SA 19:5; PRO 28:13\x*
\v 5 \w E|strong="G2532"\w*, \w atirando|strong="G4496"\w* \w as moedas de prata|strong="G3588,G694"\w* \w no santuário|strong="G1519,G3588,G3485"\w*, \w retirou-se|strong="G402"\w*, \w e|strong="G2532"\w*, \w indo embora|strong="G565"\w*, \w se enforcou|strong="G519"\w*.\x - \xo 27:5 \xt ACT 1:18; ZEC 11:13; 2SA 17:23; GAL 3:13; PRO 28:13; PRO 17:13\x*
\v 6 \w Mas os chefes dos sacerdotes|strong="G3588,G1161,G749"\w*, \w tomando|strong="G2983"\w* \w as moedas de prata|strong="G3588,G694"\w*, \w disseram|strong="G2036"\w*: “\w Não|strong="G3756"\w* \w é permitido|strong="G1832"\w* \w pô-las|strong="G906,G846"\w* \w no tesouro|strong="G1519,G3588,G2878"\w*, \w porque|strong="G1893"\w* \w é preço|strong="G5092,G1510"\w* \w de sangue|strong="G129"\w*.”\f + \fr 27.6: \ft Lit.: κορβανᾶς, do aramaico, o tesouro do templo onde se guardavam as ofertas.\f*\x - \xo 27:6 \xt ACT 1:18; ZEC 11:13; JOS 6:19; MAT 23:24; JHN 18:28; LUK 21:1\x*
\v 7 \w E tomando conselho|strong="G4824,G1161,G2983"\w*, \w compraram|strong="G59"\w* \w com elas|strong="G1537,G846"\w* \w o Campo|strong="G3588,G68"\w* \w do Oleiro|strong="G3588,G2763"\w* \w para sepultura|strong="G1519,G5027"\w* \w dos estrangeiros|strong="G3588,G3581"\w*.\x - \xo 27:7 \xt MAT 27:10; ACT 1:18; ZEC 11:13; MAT 23:24; JHN 18:28; EXO 21:32\x*
\v 8 \w Por isso|strong="G1352"\w* \w foi chamado|strong="G2564"\w* \w aquele campo|strong="G3588,G68,G1565"\w* \w Campo|strong="G68"\w* \w de Sangue|strong="G129"\w* \w até hoje|strong="G2193,G3588,G4594"\w*.\x - \xo 27:8 \xt ACT 1:18; ZEC 11:13; MAT 28:15; ACT 1:19; MAT 23:24; JHN 18:28\x*
\v 9 \w Então|strong="G5119"\w* \w se cumpriu|strong="G4137"\w* \w o que foi dito|strong="G3588,G2046"\w* \w por meio de Jeremias|strong="G1223,G2408"\w*, \w o profeta|strong="G3588,G4396"\w*, \w que diz|strong="G3004"\w*: “\w E|strong="G2532"\w* \w tomaram|strong="G2983"\w* \w as trinta|strong="G3588,G5144"\w* \w moedas de prata|strong="G694"\w*, \w o preço|strong="G3588,G5092"\w* \w daquele que foi avaliado|strong="G3588,G5091"\w*, \w a quem avaliaram|strong="G3739,G5091"\w* \w da parte dos filhos|strong="G575,G5207"\w* \w de Israel|strong="G2474"\w*,\f + \fr 27.9: \ft Nota cultural: a citação lembra sobretudo Zc 11:12-13 e tem ecos de Jr 18:1-3, 19:1-13 e 32:6-15; a atribuição a Jeremias é discutida.\f*\f + \fr 27.9: \ft Tradução: τιμὴν (τιμή, G5092) está aqui como “o preço”; o termo pode ser “honra”, “preço”, “valor” ou “estima”, e o contexto decide.\f*\x - \xo 27:9 \xt ZEC 11:12-13; JER 18:1-3; JER 19:1-13; JER 32:6-15; MAT 2:17; ACT 1:18\x*
\v 10 \w e|strong="G2532"\w* \w as deram|strong="G1325,G846"\w* \w pelo campo|strong="G1519,G3588,G68"\w* \w do oleiro|strong="G3588,G2763"\w*, \w conforme|strong="G2505"\w* \w me ordenou|strong="G4929,G3165"\w* \w o Senhor|strong="G2962"\w*.”\x - \xo 27:10 \xt MAT 27:7; ACT 1:18; ZEC 11:13; ISA 53:3; JHN 18:28\x*
\p
\v 11 \w E Jesus|strong="G3588,G1161,G2424"\w* \w ficou de pé|strong="G2476"\w* \w diante|strong="G1715"\w* \w do governador|strong="G3588,G2232"\w*; \w e|strong="G2532"\w* \w o governador|strong="G3588,G2232"\w* \w o interrogou|strong="G1905,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Você|strong="G4771"\w* \w é|strong="G1510"\w* \w o rei|strong="G3588,G935"\w* \w dos judeus|strong="G3588,G2453"\w*?” \w E Jesus|strong="G3588,G1161,G2424"\w* \w disse|strong="G5346"\w*: “\w Você|strong="G4771"\w* \w o diz|strong="G3004"\w*.”\x - \xo 27:11 \xt MRK 15:2; LUK 23:3; MAT 10:18; 1TI 6:13; JHN 1:49; LUK 23:2-3\x*
\v 12 \w E|strong="G2532"\w*, \w enquanto era acusado|strong="G1722,G3588,G2723,G846"\w* \w pelos chefes dos sacerdotes|strong="G5259,G3588,G749"\w* \w e|strong="G2532"\w* \w anciãos|strong="G4245"\w*, \w nada|strong="G3762"\w* \w respondeu|strong="G611"\w*.\x - \xo 27:12 \xt MRK 15:3; MAT 26:62; ISA 53:7; 1SA 10:27; MAT 26:63; MRK 15:2\x*
\v 13 \w Então|strong="G5119"\w* \w lhe disse|strong="G3004,G846"\w* \w Pilatos|strong="G3588,G4091"\w*: “\w Não|strong="G3756"\w* \w ouve|strong="G191"\w* \w quantas coisas|strong="G4214"\w* \w testemunham contra você|strong="G4771,G2649"\w*?”\x - \xo 27:13 \xt ISA 53:7; 1SA 10:27; MRK 15:2; JHN 18:29; PSA 39:2; AMO 5:13\x*
\v 14 \w E|strong="G2532"\w* \w não|strong="G3756"\w* \w lhe respondeu|strong="G611,G846"\w* \w nem sequer|strong="G4314,G3761"\w* \w uma|strong="G1520"\w* \w palavra|strong="G4487"\w*, \w de modo que|strong="G5620"\w* \w o governador|strong="G3588,G2232"\w* \w ficou muito admirado|strong="G2296,G3029"\w*.\x - \xo 27:14 \xt MRK 15:5; ISA 53:7; 1SA 10:27; ISA 52:14; LUK 23:9; MRK 15:2\x*
\v 15 \w E a cada festa|strong="G2596,G1161,G1859"\w* \w o governador|strong="G3588,G2232"\w* \w costumava|strong="G1486"\w* \w soltar|strong="G630"\w* \w para a multidão|strong="G3588,G3793"\w* \w um preso|strong="G1520,G1198"\w* \w que quisessem|strong="G3739,G2309"\w*.\x - \xo 27:15 \xt MRK 15:6; JHN 18:39; MAT 27:21\x*
\v 16 \w E tinham|strong="G2192,G1161"\w* \w então|strong="G5119"\w* \w um preso|strong="G1198"\w* \w famoso|strong="G1978"\w*, \w chamado|strong="G3004"\w* \w Jesus|strong="G2424"\w* \w Barrabás|strong="G912"\w*.\f + \fr 27.16: \ft Variante: o SBLGNT traz Ἰησοῦν (“Jesus”) antes de “Barrabás”, como NA28; WH, Treg, a NIV e o RP omitem o nome “Jesus” aqui.\f*\x - \xo 27:16 \xt JHN 18:39; MRK 15:7; JHN 18:40\x*
\v 17 \w Então, estando eles reunidos|strong="G3767,G4863,G846"\w*, \w Pilatos|strong="G3588,G4091"\w* \w lhes disse|strong="G2036,G846"\w*: “\w A quem|strong="G5101"\w* \w querem|strong="G2309"\w* \w que eu solte|strong="G630"\w* \w para vocês|strong="G4771"\w*: \w Jesus|strong="G2424"\w* \w o Barrabás|strong="G3588,G912"\w* \w ou|strong="G2228"\w* \w Jesus|strong="G2424"\w* \w o chamado|strong="G3588,G3004"\w* \w Cristo|strong="G5547"\w*?”\f + \fr 27.17: \ft Variante: o SBLGNT e NA28 trazem Ἰησοῦν τὸν Βαραββᾶν (“Jesus, o Barrabás”); WH traz só τὸν Βαραββᾶν, e Treg, a NIV e o RP omitem “Jesus” e o artigo.\f*\x - \xo 27:17 \xt MAT 27:21; MRK 15:9; LUK 23:18; JHN 18:39; MAT 1:16; 1KI 18:21\x*
\v 18 \w Pois|strong="G1063"\w* \w sabia|strong="G1492"\w* \w que|strong="G3754"\w* \w por inveja|strong="G1223,G5355"\w* \w o haviam entregado|strong="G3860,G846"\w*.\x - \xo 27:18 \xt MRK 15:10; PRO 27:4; ACT 7:9; JHN 18:39; ACT 5:17; DAN 6:4\x*
\v 19 \w E estando ele sentado|strong="G2521,G1161,G846"\w* \w no tribunal|strong="G1909,G3588,G968"\w*, \w enviou-lhe|strong="G649,G4314,G846"\w* \w a sua mulher|strong="G3588,G1135,G846"\w* \add um recado,\add* \w dizendo|strong="G3004"\w*: “\w Nada|strong="G3367"\w* \w haja entre você|strong="G4771"\w* \w e|strong="G2532"\w* \w aquele justo|strong="G3588,G1342,G1565"\w*; \w pois|strong="G1063"\w* \w muito|strong="G4183"\w* \w sofri|strong="G3958"\w* \w hoje|strong="G4594"\w* \w em sonho|strong="G2596,G3677"\w* \w por causa dele|strong="G1223,G846"\w*.”\f + \fr 27.19: \ft Lit.: Μηδὲν σοὶ καὶ τῷ δικαίῳ ἐκείνῳ, expressão elíptica: “nada (haja) entre você e aquele justo”, isto é, “não se envolva”.\f*\f + \fr 27.19: \ft Acréscimo: “um” (em “sua mulher um recado dizendo”): preposição ou artigo que a regência do português exige; “recado” (em “mulher um recado dizendo Nada”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; verbo ser/estar suprido em “haja entre você”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 27:19 \xt GEN 20:3; MAT 2:12; GEN 31:24; NUM 22:12; ZEC 9:9; 1PE 2:22\x*
\v 20 \w Mas os chefes dos sacerdotes|strong="G3588,G1161,G749"\w* \w e|strong="G2532"\w* \w os anciãos|strong="G3588,G4245"\w* \w persuadiram|strong="G3982"\w* \w as multidões|strong="G3588,G3793"\w* \w para que pedissem|strong="G2443,G154"\w* \w Barrabás|strong="G3588,G912"\w* \w e|strong="G3588,G1161"\w* \w destruíssem|strong="G622"\w* \w Jesus|strong="G2424"\w*.\x - \xo 27:20 \xt MRK 15:11; PSA 22:6; ACT 3:14-15; JHN 19:15-16; ACT 3:13; EXO 12:6\x*
\v 21 \w E o governador|strong="G1161,G3588,G2232"\w*, \w respondendo|strong="G611"\w*, \w lhes disse|strong="G2036,G846"\w*: “\w A qual|strong="G5101"\w* \w dos dois|strong="G575,G3588,G1417"\w* \w querem|strong="G2309"\w* \w que eu solte|strong="G630"\w* \w para vocês|strong="G4771"\w*?” \w E eles|strong="G3588,G1161"\w* \w disseram|strong="G2036"\w*: “\w Barrabás|strong="G3588,G912"\w*.”\x - \xo 27:21 \xt MAT 27:17; PSA 22:6; ACT 3:13; GEN 19:4\x*
\v 22 \w Disse-lhes|strong="G3004,G846"\w* \w Pilatos|strong="G3588,G4091"\w*: “\w O que|strong="G5101"\w*, \w então|strong="G3767"\w*, \w farei|strong="G4160"\w* \w com Jesus|strong="G2424"\w* \w o chamado|strong="G3588,G3004"\w* \w Cristo|strong="G5547"\w*?” \w Disseram|strong="G3004"\w* \w todos|strong="G3956"\w*: “\w Seja crucificado|strong="G4717"\w*.”\x - \xo 27:22 \xt JHN 19:10; MRK 15:14; JHN 19:15; 1SA 30:6; PSA 22:6; ISA 53:2-3\x*
\v 23 \w Mas ele|strong="G3588,G1161"\w* \w disse|strong="G5346"\w*: “\w Pois|strong="G1063"\w* \w que mal|strong="G5101,G2556"\w* \w fez|strong="G4160"\w*?” \w Mas eles|strong="G3588,G1161"\w* \w gritavam|strong="G2896"\w* \add ainda\add* \w mais|strong="G4057"\w*, \w dizendo|strong="G3004"\w*: “\w Seja crucificado|strong="G4717"\w*!”\f + \fr 27.23: \ft Acréscimo: “ainda” (em “eles gritavam ainda mais dizendo”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 27:23 \xt MRK 15:14; MRK 15:13; PSA 22:6; 1SA 20:32; JHN 18:29; ACT 23:12-15\x*
\v 24 \w E Pilatos|strong="G1161,G3588,G4091"\w*, \w vendo|strong="G1492"\w* \w que|strong="G3754"\w* \w nada|strong="G3762"\w* \w adianta|strong="G5623"\w*, \w mas|strong="G235"\w* \w antes|strong="G3123"\w* \w um tumulto|strong="G2351"\w* \w se levanta|strong="G1096"\w*, \w tomando|strong="G2983"\w* \w água|strong="G5204"\w*, \w lavou|strong="G633"\w* \w as mãos|strong="G3588,G5495"\w* \w diante da multidão|strong="G561,G3588,G3793"\w*, \w dizendo|strong="G3004"\w*: “\w Inocente sou|strong="G121,G1510"\w* \w do sangue|strong="G575,G3588,G129"\w* \w deste|strong="G3778"\w*; \w isso é com vocês|strong="G4771,G3700"\w*.”\f + \fr 27.24: \ft Lit.: ὑμεῖς ὄψεσθε, literalmente “vocês verão”; é um modo de dizer que a responsabilidade passa aos outros: “isso é com vocês”.\f*\f + \fr 27.24: \ft Lit.: τούτου, “deste”, pode ser lido como “deste homem” ou “deste sangue”.\f*\f + \fr 27.24: \ft Variante: WH e Treg trazem κατέναντι em lugar de ἀπέναντι; Treg, o RP, o TR e Tyn acrescentam τοῦ δικαίου (“deste justo”) depois de “sangue”.\f*\x - \xo 27:24 \xt MAT 27:4; EPH 5:15; 2CO 5:21; EXO 23:2; PSA 26:6; MAT 26:5\x*
\v 25 \w E|strong="G2532"\w*, \w respondendo|strong="G611"\w*, \w todo o povo|strong="G3956,G3588,G2992"\w* \w disse|strong="G2036"\w*: “\w O sangue|strong="G3588,G129"\w* \w dele|strong="G846"\w* \w sobre nós|strong="G1909,G3165"\w* \w e|strong="G2532"\w* \w sobre os nossos filhos|strong="G1909,G3588,G5043,G3165"\w*\f + \fr 27.25: \ft Nota cultural: fórmula de aceitação de responsabilidade pelo sangue (cf. 2Sm 1:16; Jr 26:15); o alcance da frase é debatido pelos intérpretes.\f*.”\x - \xo 27:25 \xt 2SA 1:16; JER 26:15; ACT 5:28; JOS 2:19; ACT 7:52; GEN 27:13\x*
\v 26 \w Então|strong="G5119"\w* \w lhes soltou|strong="G630,G846"\w* \w Barrabás|strong="G3588,G912"\w*, \w e|strong="G3588,G1161"\w* \w Jesus|strong="G2424"\w*, \w tendo mandado açoitá-lo|strong="G5417"\w*, \w entregou|strong="G3860"\w* \w para que fosse crucificado|strong="G2443,G4717"\w*.\f + \fr 27.26: \ft Lit.: φραγελλόω, “açoitar com o flagelo romano”.\f*\x - \xo 27:26 \xt MRK 15:15; JHN 19:16; ISA 53:5; LUK 23:24; JHN 19:1; 1PE 2:24\x*
\p
\v 27 \w Então|strong="G5119"\w* \w os soldados|strong="G3588,G4757"\w* \w do governador|strong="G3588,G2232"\w*, \w levando|strong="G3880"\w* \w Jesus|strong="G3588,G2424"\w* \w ao pretório|strong="G1519,G3588,G4232"\w*, \w reuniram|strong="G4863"\w* \w em torno dele|strong="G1909,G846"\w* \w toda a coorte|strong="G3650,G3588,G4686"\w*,\f + \fr 27.27: \ft Lit.: πραιτώριον, “pretório”, a residência e o quartel do governador; σπεῖρα, “coorte”, unidade de cerca de seiscentos soldados.\f*\x - \xo 27:27 \xt MRK 15:16; HEB 12:2; JHN 18:28; JHN 18:33; ACT 10:1; ACT 23:35\x*
\v 28 \w e|strong="G2532"\w*, \w tendo-o despido|strong="G1562,G846"\w*, \w lhe puseram|strong="G4060,G846"\w* \w um manto|strong="G5511"\w* \w escarlate|strong="G2847"\w*,\x - \xo 27:28 \xt HEB 12:2; MRK 15:16; JHN 19:2; LUK 23:11; MRK 15:17; GEN 37:23\x*
\v 29 \w e|strong="G2532"\w*, \w tendo trançado|strong="G4120"\w* \w uma coroa|strong="G4735"\w* \w de espinhos|strong="G1537,G173"\w*, \w a puseram|strong="G2007"\w* \w sobre a sua cabeça|strong="G1909,G3588,G2776,G846"\w* \w e|strong="G2532"\w* \w um caniço|strong="G2563"\w* \w na sua mão direita|strong="G1722,G3588,G1188,G846"\w*; \w e|strong="G2532"\w*, \w ajoelhando-se|strong="G1120"\w* \w diante dele|strong="G1715,G846"\w*, \w zombaram|strong="G1702"\w* \w dele|strong="G846"\w*, \w dizendo|strong="G3004"\w*: “\w Salve|strong="G5463"\w*, \w rei|strong="G935"\w* \w dos judeus|strong="G3588,G2453"\w*!”\f + \fr 27.29: \ft Tradução: Χαῖρε (χαίρω, G5463) está aqui como “Salve”; o termo pode ser “alegrar-se”, “regozijar-se” ou “saudar” (χαῖρε como saudação), e o contexto decide.\f*\x - \xo 27:29 \xt JHN 19:2; MAT 27:37; HEB 12:2; PHP 2:10; ISA 53:3; MRK 15:16\x*
\v 30 \w E|strong="G2532"\w*, \w cuspindo|strong="G1716"\w* \w nele|strong="G1519,G846"\w*, \w tomaram|strong="G2983"\w* \w o caniço|strong="G3588,G2563"\w* \w e|strong="G2532"\w* \w batiam|strong="G5180"\w* \w na sua cabeça|strong="G1519,G3588,G2776,G846"\w*.\x - \xo 27:30 \xt MRK 15:19; ISA 50:6; HEB 12:2; MRK 15:16; MAT 26:67; ISA 52:14\x*
\v 31 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w zombaram|strong="G1702"\w* \w dele|strong="G846"\w*, \w o despiram|strong="G1562,G846"\w* \w do manto|strong="G3588,G5511"\w* \w e|strong="G2532"\w* \w o vestiram|strong="G1746,G846"\w* \w com as suas vestes|strong="G3588,G2440,G846"\w*, \w e|strong="G2532"\w* \w o levaram|strong="G520,G846"\w* \w para ser crucificado|strong="G1519,G3588,G4717"\w*.\x - \xo 27:31 \xt MRK 15:20; HEB 12:2; MRK 15:16; ISA 53:7; JHN 19:1; JHN 19:16\x*
\v 32 \w E saindo|strong="G1831,G1161"\w*, \w encontraram|strong="G2147"\w* \w um homem|strong="G444"\w* \w cireneu|strong="G2956"\w*, \w de nome|strong="G3686"\w* \w Simão|strong="G4613"\w*; \w a este|strong="G3778"\w* \w forçaram|strong="G29"\w* \w a que levasse|strong="G2443,G142"\w* \w a cruz|strong="G3588,G4716"\w* \w dele|strong="G846"\w*.\f + \fr 27.32: \ft Lit.: ἀγγαρεύω, “requisitar (para carregar fardo)”, direito que os soldados romanos tinham sobre os habitantes; Κυρηναῖος, “de Cirene”, no norte da África.\f*\x - \xo 27:32 \xt MRK 15:21; LUK 23:26; MAT 16:24; HEB 12:2; ACT 2:10; ACT 6:9\x*
\v 33 \w E|strong="G2532"\w*, \w tendo chegado|strong="G2064"\w* \w a um lugar|strong="G1519,G5117"\w* \w chamado|strong="G3004"\w* \w Gólgota|strong="G1115"\w*, \w que|strong="G3739"\w* \w é|strong="G1510"\w* \w chamado|strong="G3004"\w* \w Lugar|strong="G5117"\w* \w da Caveira|strong="G2898"\w*,\f + \fr 27.33: \ft Lit.: Γολγοθᾶ, do aramaico gûlgaltâ, “crânio, caveira”.\f*\x - \xo 27:33 \xt MRK 15:22; JHN 19:17; LUK 23:33; HEB 12:2; LUK 23:26; LUK 23:44\x*
\v 34 \w deram-lhe|strong="G1325,G846"\w* \w de beber|strong="G4095"\w* \w vinho|strong="G3631"\w* \w misturado|strong="G3396"\w* \w com fel|strong="G3326,G5521"\w*; \w e|strong="G2532"\w*, \w tendo provado|strong="G1089"\w*, \w não|strong="G3756"\w* \w quis|strong="G2309"\w* \w beber|strong="G4095"\w*.\f + \fr 27.34: \ft Nota cultural: evoca Sl 69:22 (69:21 no hebraico).\f*\f + \fr 27.34: \ft Variante: o RP traz ὄξος (“vinagre”) em lugar de οἶνον (“vinho”), e ἤθελεν em lugar de ἠθέλησεν.\f*\x - \xo 27:34 \xt PSA 69:22; PSA 69:21; HEB 12:2; MRK 15:23; MAT 27:48; LUK 23:26\x*
\v 35 \w E tendo-o crucificado|strong="G4717,G1161,G846"\w*, \w repartiram|strong="G1266"\w* \w as suas vestes|strong="G3588,G2440,G846"\w*, \w lançando|strong="G906"\w* \w sorte|strong="G2819"\w*,\f + \fr 27.35: \ft Nota cultural: cumpre-se aqui o que descreve Sl 22:19 (22:18 no hebraico).\f*\f + \fr 27.35: \ft Variante: o TR acrescenta “para que se cumprisse o que foi dito pelo profeta: Repartiram entre si as minhas vestes, e sobre a minha túnica lançaram sorte” (cf. Jo 19:24).\f*\x - \xo 27:35 \xt JHN 19:24; PSA 22:19; MRK 15:24; LUK 23:34; PSA 22:18; PSA 22:16\x*
\v 36 \w e|strong="G2532"\w*, \w sentados|strong="G2521"\w*, \w o guardavam|strong="G5083,G846"\w* \w ali|strong="G1563"\w*,\x - \xo 27:36 \xt HEB 12:2; MAT 27:54; LUK 23:26; MRK 15:22; MRK 15:24; LUK 23:34\x*
\v 37 \w e|strong="G2532"\w* \w puseram|strong="G2007"\w* \w acima|strong="G1883"\w* \w da sua cabeça|strong="G3588,G2776,G846"\w* \w a acusação|strong="G3588,G156"\w* \w contra ele|strong="G846"\w* \w escrita|strong="G1125"\w*: “\w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w Jesus|strong="G2424"\w*, \w o rei|strong="G3588,G935"\w* \w dos judeus|strong="G3588,G2453"\w*.”\x - \xo 27:37 \xt MRK 15:26; MAT 27:29; ISA 44:6; HEB 12:2; JHN 19:19; LUK 23:26\x*
\v 38 \w Então|strong="G5119"\w* \w são crucificados|strong="G4717"\w* \w com ele|strong="G4862,G846"\w* \w dois|strong="G1417"\w* \w assaltantes|strong="G3027"\w*, \w um|strong="G1520"\w* \w à direita|strong="G1537,G1188"\w* \w e|strong="G2532"\w* \w um|strong="G1520"\w* \w à esquerda|strong="G1537,G2176"\w*.\x - \xo 27:38 \xt MRK 15:27; MAT 27:44; MAT 20:21; HEB 12:2; LUK 23:32; JHN 19:18\x*
\v 39 \w E os que passavam|strong="G3588,G1161,G3899"\w* \w o insultavam|strong="G987,G846"\w*, \w balançando|strong="G2795"\w* \w as suas cabeças|strong="G3588,G2776,G846"\w*\f + \fr 27.39: \ft Nota cultural: o gesto de balançar a cabeça evoca Sl 22:8 e 109:25.\f*\x - \xo 27:39 \xt PSA 109:25; PSA 22:8; MRK 15:29; MAT 5:11; HEB 12:2; ISA 53:3\x*
\v 40 \w e|strong="G2532"\w* \w dizendo|strong="G3004"\w*: “\w O que destrói|strong="G3588,G2647"\w* \w o santuário|strong="G3588,G3485"\w* \w e|strong="G2532"\w* \w em três dias|strong="G1722,G5140,G2250"\w* \w o reconstrói|strong="G3618"\w*, \w salve|strong="G4982"\w* \w a si mesmo|strong="G4771"\w*; \w se|strong="G1487"\w* \w é Filho|strong="G5207,G1510"\w* \w de Deus|strong="G3588,G2316"\w*, \w desça|strong="G2597"\w* \w da cruz|strong="G575,G3588,G4716"\w*!”\x - \xo 27:40 \xt MAT 26:61; MRK 15:29; JHN 2:19; MRK 15:30; MRK 14:58; HEB 12:2\x*
\v 41 \w Do mesmo modo|strong="G3668"\w*, \w também|strong="G2532"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w*, \w zombando|strong="G1702"\w* \w com os escribas|strong="G3326,G3588,G1122"\w* \w e|strong="G2532"\w* \w anciãos|strong="G4245"\w*, \w diziam|strong="G3004"\w*:\f + \fr 27.41: \ft Variante: Treg e o RP trazem δὲ καί em lugar de καί; o RP acrescenta καὶ Φαρισαίων (“e fariseus”) depois de “anciãos”.\f*\x - \xo 27:41 \xt MRK 15:31; HEB 12:2; ISA 53:3; LUK 23:26; PSA 22:17; MRK 15:22\x*
\v 42 “\w Salvou|strong="G4982"\w* \w outros|strong="G243"\w*, \w a si mesmo|strong="G1438"\w* \w não|strong="G3756"\w* \w pode|strong="G1410"\w* \w salvar|strong="G4982"\w*; \w é rei|strong="G1510,G935"\w* \w de Israel|strong="G2474"\w*, \w desça|strong="G2597"\w* \w agora|strong="G3568"\w* \w da cruz|strong="G575,G3588,G4716"\w*, \w e|strong="G2532"\w* \w creremos nele|strong="G4100,G1909,G846"\w*.\x - \xo 27:42 \xt MRK 15:30; MRK 15:32; PSA 22:8; HEB 12:2; JHN 1:49; ISA 53:3\x*
\v 43 \w Confia|strong="G3982"\w* \w em Deus|strong="G1909,G3588,G2316"\w*; \w livre-o|strong="G4506,G846"\w* \w agora|strong="G3568"\w*, \w se|strong="G1487"\w* \w o quer|strong="G2309"\w*; \w pois|strong="G1063"\w* \w disse|strong="G2036"\w*: ‘\f + \fr 27.43: \ft Nota cultural: as palavras dos zombadores ecoam Sl 22:9 (22:8 no hebraico).\f* \w Sou Filho de Deus|strong="G2316,G1510,G5207"\w*.’”\x - \xo 27:43 \xt PSA 22:9; PSA 22:8; HEB 12:2; NAM 1:7; ISA 53:3; LUK 3:22\x*
\v 44 \w E da mesma forma|strong="G3588,G1161,G846"\w*, \w também|strong="G2532"\w*, \w os assaltantes|strong="G3588,G3027"\w* \w crucificados juntamente|strong="G3588,G4957"\w* \w com ele|strong="G4862,G846"\w* \w o injuriavam|strong="G3679,G846"\w*.\x - \xo 27:44 \xt MRK 15:32; MAT 27:38; HEB 12:2; LUK 23:39; ISA 53:3; LUK 23:26\x*
\p
\v 45 \w E desde|strong="G575,G1161"\w* \w a sexta|strong="G1623"\w* \w hora|strong="G5610"\w*, \w houve|strong="G1096"\w* \w trevas|strong="G4655"\w* \w sobre toda|strong="G1909,G3956"\w* \w a terra|strong="G3588,G1093"\w* \w até a hora|strong="G2193,G5610"\w* \w nona|strong="G1766"\w*.\x - \xo 27:45 \xt MRK 15:33; LUK 23:44; MAT 20:5; AMO 8:9; HEB 12:2; ISA 50:3\x*
\v 46 \w E por volta|strong="G4012,G1161"\w* \w da nona|strong="G3588,G1766"\w* \w hora|strong="G5610"\w*, \w clamou|strong="G310"\w* \w Jesus|strong="G3588,G2424"\w* \w em alta voz|strong="G5456,G3173"\w*, \w dizendo|strong="G3004"\w*: “\w Eli|strong="G2241"\w*, \w Eli|strong="G2241"\w*, \w lemá|strong="G2982"\w* \w sabactâni|strong="G4518"\w*?”, \w isto é|strong="G3778,G1510"\w*: “\w Meu Deus|strong="G2316,G3165"\w*, \w meu Deus|strong="G2316,G3165"\w*, \w por que|strong="G2444"\w* \w me abandonou|strong="G3165,G1459"\w*?”\f + \fr 27.46: \ft Nota cultural: cita Sl 22:1 (22:2 no hebraico; 21:2 na LXX), em hebraico (Eli) e aramaico (sabactâni).\f*\x - \xo 27:46 \xt PSA 22:1; MRK 15:34; HEB 5:7; ISA 53:10; JHN 19:28-30; LUK 23:46\x*
\v 47 \w E alguns|strong="G5100,G1161"\w* \w dos que estavam ali|strong="G3588,G1563,G2476"\w*, \w ao ouvirem|strong="G191"\w*, \w diziam|strong="G3004"\w*: “\w Este|strong="G3778"\w* \w chama|strong="G5455"\w* \w Elias|strong="G2243"\w*.”\x - \xo 27:47 \xt MRK 15:35; MAT 20:32; LUK 23:46; HEB 12:2; MAL 4:5; 1KI 17:1\x*
\v 48 \w E|strong="G2532"\w* \w imediatamente|strong="G2112"\w*, \w correndo|strong="G5143"\w* \w um|strong="G1520"\w* \w deles|strong="G1537,G846"\w* \w e|strong="G2532"\w* \w tomando|strong="G2983"\w* \w uma esponja|strong="G4699"\w*, \w tendo-a embebido|strong="G4130,G5037"\w* \w de vinagre|strong="G3690"\w* \w e|strong="G2532"\w* \w prendendo-a|strong="G4060"\w* \w num caniço|strong="G2563"\w*, \w dava-lhe de beber|strong="G4222,G846"\w*.\f + \fr 27.48: \ft Nota cultural: evoca Sl 69:22 (69:21 no hebraico).\f*\x - \xo 27:48 \xt PSA 69:22; MRK 15:36; JHN 19:29; LUK 23:46; PSA 69:21; HEB 12:2\x*
\v 49 \w E os demais|strong="G3588,G1161,G3062"\w* \w diziam|strong="G3004"\w*: “\w Deixe|strong="G863"\w*, \w vejamos|strong="G1492"\w* \w se|strong="G1487"\w* \w vem|strong="G2064"\w* \w Elias|strong="G2243"\w* \w para salvá-lo|strong="G4982,G846"\w*.”\f + \fr 27.49: \ft Variante: WH traz, entre colchetes duplos, “outro, tomando uma lança, lhe perfurou o lado, e saiu água e sangue” (cf. Jo 19:34); o SBLGNT não traz o trecho; WH e Treg trazem εἶπαν em lugar de ἔλεγον.\f*\x - \xo 27:49 \xt JHN 19:34; LUK 23:46; HEB 12:2; MAL 4:5; MRK 15:35; 1KI 17:1\x*
\v 50 \w E Jesus|strong="G3588,G1161,G2424"\w*, \w de novo|strong="G3825"\w*, \w tendo clamado|strong="G2896"\w* \w em alta voz|strong="G5456,G3173"\w*, \w entregou|strong="G863"\w* \w o espírito|strong="G3588,G4151"\w*.\f + \fr 27.50: \ft Lit.: ἀφῆκεν τὸ πνεῦμα, “deixou partir o espírito”, isto é, expirou.\f*\x - \xo 27:50 \xt MRK 15:37; MRK 15:13; LUK 23:46; HEB 5:7; JHN 19:30; HEB 12:2\x*
\v 51 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w o véu|strong="G3588,G2665"\w* \w do santuário|strong="G3588,G3485"\w* \w se rasgou|strong="G4977"\w* \w de cima|strong="G575,G509"\w* \w até embaixo|strong="G2193,G2736"\w* \w em duas partes|strong="G1519,G1417"\w*, \w e|strong="G2532"\w* \w a terra|strong="G3588,G1093"\w* \w tremeu|strong="G4579"\w*, \w e|strong="G2532"\w* \w as rochas|strong="G3588,G4073"\w* \w se partiram|strong="G4977"\w*,\f + \fr 27.51: \ft Lit.: καταπέτασμα, “véu”, a cortina do santuário (provavelmente a que separava o Santo dos Santos).\f*\x - \xo 27:51 \xt MRK 15:38; LUK 23:45; LUK 23:46; HEB 10:19-22; HEB 6:19; ISA 25:7\x*
\v 52 \w e|strong="G2532"\w* \w os túmulos|strong="G3588,G3419"\w* \w se abriram|strong="G455"\w* \w e|strong="G2532"\w* \w muitos|strong="G4183"\w* \w corpos|strong="G4983"\w* \w dos santos|strong="G3588,G40"\w* \w que haviam adormecido|strong="G2837"\w* \w foram ressuscitados|strong="G1453"\w*,\f + \fr 27.52: \ft Tradução: κεκοιμημένων, literalmente “que haviam adormecido”: eufemismo comum para os mortos; ἠγέρθησαν é o verbo de “levantar-se, ser ressuscitado”. O texto não detalha a natureza nem o momento do episódio; ver a nota de 27:53.\f*\x - \xo 27:52 \xt 1CO 15:20; LUK 23:46; ISA 26:19; 1TH 4:14; JHN 5:25-29; DAN 12:2\x*
\v 53 \w e|strong="G2532"\w*, \w saindo|strong="G1831"\w* \w dos túmulos|strong="G1537,G3588,G3419"\w*, \w depois|strong="G3326"\w* \w da ressurreição|strong="G3588,G1454"\w* \w dele|strong="G846"\w*, \w entraram|strong="G1525"\w* \w na cidade santa|strong="G1519,G3588,G40,G4172"\w* \w e|strong="G2532"\w* \w apareceram|strong="G1718"\w* \w a muitos|strong="G4183"\w*.\f + \fr 27.53: \ft Nota cultural: a cidade santa é Jerusalém; o episódio dos santos que ressurgem aparece apenas em Mateus.\f*\x - \xo 27:53 \xt LUK 23:46; MRK 15:38; LUK 19:40; PSA 17:15; 2KI 13:21; MAT 4:5\x*
\v 54 \w Mas o centurião|strong="G3588,G1161,G1543"\w* \w e|strong="G2532"\w* \w os que com ele|strong="G3588,G3326,G846"\w* \w guardavam|strong="G5083"\w* \w Jesus|strong="G3588,G2424"\w*, \w vendo|strong="G1492"\w* \w o terremoto|strong="G3588,G4578"\w* \w e|strong="G2532"\w* \w o que tinha acontecido|strong="G3588,G1096"\w*, \w temeram|strong="G5399"\w* \w muito|strong="G4970"\w*, \w dizendo|strong="G3004"\w*: “\w Verdadeiramente|strong="G230"\w* \w este era|strong="G1510,G3778"\w* \w Filho|strong="G5207"\w* \w de Deus|strong="G2316"\w*\f + \fr 27.54: \ft Lit.: θεοῦ υἱός, sem artigo: “filho de Deus” ou “um filho de Deus”; a tradução “Filho de Deus” segue a leitura cristã do contexto.\f*.”\x - \xo 27:54 \xt MAT 16:16; LUK 23:46; LUK 23:47; MAT 27:36; JHN 1:34; MRK 15:39\x*
\p
\v 55 \w E havia|strong="G1510,G1161"\w* \w ali|strong="G1563"\w* \w muitas|strong="G4183"\w* \w mulheres|strong="G1135"\w*, \w observando|strong="G2334"\w* \w de longe|strong="G575,G3113"\w*, \w as quais|strong="G3748"\w* \w seguiram|strong="G190"\w* \w Jesus|strong="G3588,G2424"\w* \w desde a Galileia|strong="G575,G3588,G1056"\w*, \w servindo-o|strong="G1247,G846"\w*;\x - \xo 27:55 \xt LUK 23:49; MRK 15:40; LUK 23:46; JHN 19:25; LUK 8:2; LUK 23:48-49\x*
\v 56 \w entre as quais|strong="G1722,G3739"\w* \w estava|strong="G1510"\w* \w Maria|strong="G3137"\w* \w Madalena|strong="G3588,G3094"\w*, \w e|strong="G2532"\w* \w Maria|strong="G3137"\w*, \w a mãe|strong="G3588,G3384"\w* \w de Tiago|strong="G3588,G2385"\w* \w e|strong="G2532"\w* \w José|strong="G2501"\w*, \w e|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w* \w dos filhos|strong="G3588,G5207"\w* \w de Zebedeu|strong="G2199"\w*.\f + \fr 27.56: \ft Lit.: Μαγδαληνή, “de Magdala”, cidade às margens do lago da Galileia.\f*\x - \xo 27:56 \xt JHN 19:25; JHN 20:18; MAT 13:55; MRK 15:40; LUK 24:10; MAT 20:20\x*
\p
\v 57 \w E chegada a tarde|strong="G3798,G1161,G1096"\w*, \w veio|strong="G2064"\w* \w um homem|strong="G444"\w* \w rico|strong="G4145"\w* \w de Arimateia|strong="G575,G707"\w*, \w de nome|strong="G5122"\w* \w José|strong="G2501"\w*, \w que|strong="G3739"\w* \w também ele|strong="G2532,G846"\w* \w se tornou discípulo|strong="G3100"\w* \w de Jesus|strong="G3588,G2424"\w*;\f + \fr 27.57: \ft Variante: o RP traz ἐμαθήτευσεν (“foi discípulo”) em lugar de ἐμαθητεύθη (“tornou-se discípulo”).\f*\x - \xo 27:57 \xt JHN 19:38; MRK 15:43; ISA 53:9; 1CO 15:4; LUK 23:50; ACT 13:29\x*
\v 58 \w este|strong="G3778"\w*, \w aproximando-se|strong="G4334"\w* \w de Pilatos|strong="G3588,G4091"\w*, \w pediu|strong="G154"\w* \w o corpo|strong="G3588,G4983"\w* \w de Jesus|strong="G3588,G2424"\w*. \w Então|strong="G5119"\w* \w Pilatos|strong="G3588,G4091"\w* \w ordenou|strong="G2753"\w* \w que fosse entregue|strong="G591"\w*.\x - \xo 27:58 \xt LUK 23:52; ISA 53:9; 1CO 15:4; LUK 23:50; ACT 13:29; JHN 12:7\x*
\v 59 \w E|strong="G2532"\w*, \w tomando|strong="G2983"\w* \w o corpo|strong="G3588,G4983"\w*, \w José|strong="G3588,G2501"\w* \w o envolveu|strong="G1794,G846"\w* \w num lençol|strong="G4616"\w* \w limpo|strong="G2513"\w*,\x - \xo 27:59 \xt LUK 23:53; ISA 53:9; 1CO 15:4; LUK 23:50; MRK 15:46; ACT 13:29\x*
\v 60 \w e|strong="G2532"\w* \w o colocou|strong="G5087,G846"\w* \w no seu túmulo novo|strong="G1722,G3588,G2537,G846,G3419"\w*, \w que|strong="G3739"\w* \w tinha escavado|strong="G2998"\w* \w na rocha|strong="G1722,G3588,G4073"\w*; \w e|strong="G2532"\w*, \w rolando|strong="G4351"\w* \w uma grande pedra|strong="G3037,G3173"\w* \w para a porta|strong="G3588,G2374"\w* \w do túmulo|strong="G3588,G3419"\w*, \w foi embora|strong="G565"\w*.\x - \xo 27:60 \xt MRK 15:46; MRK 16:3; ISA 53:9; JHN 20:1; LUK 23:53; ISA 22:16\x*
\v 61 \w E estavam|strong="G1510,G1161"\w* \w ali|strong="G1563"\w* \w Maria|strong="G3137"\w* \w Madalena|strong="G3588,G3094"\w* \w e|strong="G2532"\w* \w a outra|strong="G3588,G243"\w* \w Maria|strong="G3137"\w*, \w sentadas|strong="G2521"\w* \w em frente|strong="G561"\w* \w do sepulcro|strong="G3588,G5028"\w*.\x - \xo 27:61 \xt MAT 28:1; MAT 27:56; MRK 16:3; LUK 23:50; LUK 23:55; MRK 15:40\x*
\p
\v 62 \w E no dia seguinte|strong="G3588,G1161,G1887"\w*, \w que é|strong="G3748,G1510"\w* \w depois da Preparação|strong="G3326,G3588,G3904"\w*, \w reuniram-se|strong="G4863"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w* \w junto a Pilatos|strong="G4314,G4091"\w*,\f + \fr 27.62: \ft Lit.: παρασκευή, “Preparação”, o dia que antecede o sábado (a sexta-feira).\f*\x - \xo 27:62 \xt LUK 23:54; MRK 15:42; MRK 16:3; JHN 19:14; JHN 19:42; JHN 16:20\x*
\v 63 \w dizendo|strong="G3004"\w*: “\w Senhor|strong="G2962"\w*, \w lembramo-nos|strong="G3403"\w* \w de que|strong="G3754"\w* \w aquele enganador|strong="G1565,G3588,G4108"\w* \w disse|strong="G2036"\w*, \w ainda|strong="G2089"\w* \w vivo|strong="G2198"\w*: ‘\w Depois de três dias|strong="G3326,G5140,G2250"\w* \w ressuscitarei|strong="G1453"\w*.’\x - \xo 27:63 \xt LUK 24:6; PRO 19:21; MAT 12:40; MAT 28:6; LUK 9:22; MAT 16:21\x*
\v 64 \w Ordene|strong="G2753"\w*, \w pois|strong="G3767"\w*, \w que seja assegurado|strong="G805"\w* \w o sepulcro|strong="G3588,G5028"\w* \w até o terceiro dia|strong="G2193,G3588,G5154,G2250"\w*, \w para que não|strong="G4218,G3361"\w* \w venham|strong="G2064"\w* \w os seus discípulos|strong="G3588,G3101,G846"\w*, \w o roubem|strong="G2813,G846"\w* \w e|strong="G2532"\w* \w digam|strong="G2036"\w* \w ao povo|strong="G3588,G2992"\w*: ‘\w Foi ressuscitado|strong="G1453"\w* \w dentre os mortos|strong="G575,G3588,G3498"\w*’; \w e|strong="G2532"\w* \w será|strong="G1510"\w* \w o último|strong="G3588,G2078"\w* \w engano|strong="G4106"\w* \w pior|strong="G5501"\w* \w do que o primeiro|strong="G3588,G4413"\w*.”\f + \fr 27.64: \ft Variante: WH omite αὐτοῦ (“seus”); o RP e o TR trazem αὐτοῦ νυκτός (“os seus discípulos, de noite”).\f*\x - \xo 27:64 \xt PRO 19:21; MAT 12:40; MRK 16:3; PSA 21:11; ACT 4:10; EST 5:1\x*
\v 65 \w Disse-lhes|strong="G5346,G846"\w* \w Pilatos|strong="G3588,G4091"\w*: “\w Têm|strong="G2192"\w* \w uma guarda|strong="G2892"\w*; \w vão|strong="G5217"\w*, \w assegurem|strong="G805"\w* \w como|strong="G5613"\w* \w sabem|strong="G6063"\w*.”\f + \fr 27.65: \ft Lit.: κουστωδία, do latim custodia, “guarda” (soldados encarregados de vigiar).\f*\x - \xo 27:65 \xt MRK 16:3; ACT 4:10; MAT 27:66; MAT 28:4; ACT 16:23; JHN 16:20\x*
\v 66 \w E eles|strong="G3588,G1161"\w*, \w indo|strong="G4198"\w*, \w asseguraram|strong="G805"\w* \w o sepulcro|strong="G3588,G5028"\w*, \w selando|strong="G4972"\w* \w a pedra|strong="G3588,G3037"\w* \w com a guarda|strong="G3326,G3588,G2892"\w*.\x - \xo 27:66 \xt DAN 6:17; MRK 16:3; ACT 4:10; MAT 27:60; MAT 27:65; MAT 28:4\x*
\c 28
\p
\v 1 \w E depois do sábado|strong="G3796,G1161,G4521"\w*, \w ao amanhecer|strong="G3588,G2020"\w* \w para o primeiro dia|strong="G1519,G1520"\w* \w da semana|strong="G4521"\w*, \w veio|strong="G2064"\w* \w Maria|strong="G3137"\w* \w Madalena|strong="G3588,G3094"\w* \w e|strong="G2532"\w* \w a outra|strong="G3588,G243"\w* \w Maria|strong="G3137"\w* \w para ver|strong="G2334"\w* \w o sepulcro|strong="G3588,G5028"\w*.\f + \fr 28.1: \ft Lit.: ὀψὲ σαββάτων, “tarde do sábado”, isto é, depois do sábado; μία σαββάτων, “primeiro (dia) da semana” (σάββατον significa tanto “sábado” quanto “semana”).\f*\x - \xo 28:1 \xt MAT 27:61; JHN 20:1; MRK 16:1; PSA 118:24; LUK 23:56-24:10; MAT 27:56\x*
\v 2 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w houve|strong="G1096"\w* \w um grande|strong="G3173"\w* \w terremoto|strong="G4578"\w*; \w pois|strong="G1063"\w* \w um anjo|strong="G32"\w* \w do Senhor|strong="G2962"\w*, \w descendo|strong="G2597"\w* \w do céu|strong="G1537,G3772"\w* \w e|strong="G2532"\w* \w aproximando-se|strong="G4334"\w*, \w rolou|strong="G617"\w* \w a pedra|strong="G3588,G3037"\w* \w e|strong="G2532"\w* \w sentou-se|strong="G2521"\w* \w em cima dela|strong="G1883,G846"\w*.\f + \fr 28.2: \ft Variante: o RP omite καί no início; o RP e o TR acrescentam ἀπὸ τῆς θύρας (“da porta”) depois de “pedra”.\f*\x - \xo 28:2 \xt LUK 24:2; MRK 16:3; MRK 16:4; PSA 118:24; MRK 16:1; PSA 21:11\x*
\v 3 \w E a sua aparência|strong="G1161,G3588,G2397,G846"\w* \w era|strong="G1510"\w* \w como|strong="G5613"\w* \w relâmpago|strong="G796"\w*, \w e|strong="G2532"\w* \w a sua roupa|strong="G3588,G1742,G846"\w* \w branca|strong="G3022"\w* \w como|strong="G5613"\w* \w neve|strong="G5510"\w*.\x - \xo 28:3 \xt REV 1:14; MAT 17:2; MRK 9:3; PSA 118:24; ACT 1:10; JDG 13:6\x*
\v 4 \w E por causa|strong="G575,G1161"\w* \w do medo|strong="G3588,G5401"\w* \w dele|strong="G846"\w*, \w tremeram|strong="G4579"\w* \w os guardas|strong="G3588,G5083"\w* \w e|strong="G2532"\w* \w ficaram|strong="G1096"\w* \w como|strong="G5613"\w* \w mortos|strong="G3498"\w*.\x - \xo 28:4 \xt PSA 118:24; JDG 13:6; LUK 24:5; MRK 16:1; PSA 21:11; PSA 57:3\x*
\v 5 \w E o anjo|strong="G1161,G3588,G32"\w*, \w respondendo|strong="G611"\w*, \w disse|strong="G2036"\w* \w às mulheres|strong="G3588,G1135"\w*: “\w Não temam|strong="G3361,G5399"\w* \w vocês|strong="G4771"\w*; \w pois|strong="G1063"\w* \w sei|strong="G6063"\w* \w que|strong="G3754"\w* \w procuram|strong="G2212"\w* \w Jesus|strong="G2424"\w*, \w o crucificado|strong="G3588,G4717"\w*.\x - \xo 28:5 \xt LUK 1:30; LUK 1:13; DAN 10:12; EXO 14:13; PSA 118:24; GEN 15:1\x*
\v 6 \w Não está|strong="G3756,G1510"\w* \w aqui|strong="G5602"\w*; \w pois|strong="G1063"\w* \w foi ressuscitado|strong="G1453"\w*, \w como|strong="G2531"\w* \w disse|strong="G2036"\w*. \w Venham|strong="G1205"\w*, \w vejam|strong="G1492"\w* \w o lugar|strong="G3588,G5117"\w* \w onde|strong="G3699"\w* \w estava deitado|strong="G2749"\w*.\f + \fr 28.6: \ft Variante: Treg, o RP e o TR acrescentam ὁ κύριος (“o Senhor”) depois de “estava deitado”.\f*\x - \xo 28:6 \xt MRK 16:6; MAT 12:40; LUK 24:6; MAT 16:21; LUK 24:23; JHN 20:4-9\x*
\v 7 \w E|strong="G2532"\w*, \w indo|strong="G4198"\w* \w depressa|strong="G5035"\w*, \w digam|strong="G2036"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w*: ‘\w Foi ressuscitado|strong="G1453"\w* \w dentre os mortos|strong="G575,G3588,G3498"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w vai adiante|strong="G4254"\w* \w de vocês|strong="G4771"\w* \w para a Galileia|strong="G1519,G3588,G1056"\w*; \w ali|strong="G1563"\w* \w o verão|strong="G846,G3700"\w*.’ \w Olhem|strong="G2400"\w*, \w eu lhes disse|strong="G2036,G4771"\w*.”\x - \xo 28:7 \xt MAT 26:32; MRK 14:28; MRK 16:7; MAT 28:10; JHN 11:29; PSA 118:24\x*
\v 8 \w E|strong="G2532"\w*, \w afastando-se|strong="G565"\w* \w depressa|strong="G5035"\w* \w do túmulo|strong="G575,G3588,G3419"\w* \w com temor|strong="G3326,G5401"\w* \w e|strong="G2532"\w* \w grande|strong="G3173"\w* \w alegria|strong="G5479"\w*, \w correram|strong="G5143"\w* \w para anunciar|strong="G518"\w* \w aos seus discípulos|strong="G3588,G3101,G846"\w*.\f + \fr 28.8: \ft Variante: o RP traz ἐξελθοῦσαι (“saindo”) em lugar de ἀπελθοῦσαι (“afastando-se”); o TR traz “E, enquanto iam anunciar aos discípulos dele” (Ὡς δὲ ἐπορεύοντο ἀπαγγεῖλαι τοῖς μαθηταῖς αὐτοῦ) no fim do verso.\f*\x - \xo 28:8 \xt PSA 118:24; PSA 2:11; MRK 16:1; MRK 16:8; LUK 24:1; LUK 24:36-41\x*
\v 9 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w Jesus|strong="G2424"\w* \w foi ao encontro|strong="G5221"\w* \w delas|strong="G846"\w*, \w dizendo|strong="G3004"\w*: “\w Salve|strong="G5463"\w*.” \w E elas|strong="G3588,G1161"\w*, \w aproximando-se|strong="G4334"\w*, \w seguraram|strong="G2902"\w* \w os pés|strong="G3588,G4228"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w se prostraram|strong="G4352"\w* \w diante dele|strong="G846"\w*.\f + \fr 28.9: \ft Lit.: προσκυνέω, “prostrar-se” (em reverência ou em adoração).\f*\f + \fr 28.9: \ft Tradução: Χαίρετε (χαίρω, G5463) está aqui como “Salve”; o termo pode ser “alegrar-se”, “regozijar-se” ou “saudar” (χαῖρε como saudação), e o contexto decide.\f*\x - \xo 28:9 \xt MAT 28:17; MAT 14:33; JHN 20:28; JHN 20:14; MRK 16:1; ACT 1:3\x*
\v 10 \w Então|strong="G5119"\w* \w lhes disse|strong="G3004,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Não temam|strong="G3361,G5399"\w*; \w vão|strong="G5217"\w*, \w anunciem|strong="G518"\w* \w aos meus irmãos|strong="G3588,G80,G3165"\w* \w para que vão|strong="G2443,G565"\w* \w para a Galileia|strong="G1519,G3588,G1056"\w*, \w e ali|strong="G1563,G2532"\w* \w me verão|strong="G3165,G3700"\w*.”\x - \xo 28:10 \xt MRK 16:7; MAT 28:7; MAT 12:50; 1CO 15:6; MAT 26:32; ROM 8:29\x*
\p
\v 11 \w E enquanto elas iam|strong="G4198,G1161,G846"\w*, \w olhem|strong="G2400"\w*, \w alguns|strong="G5100"\w* \w da guarda|strong="G3588,G2892"\w*, \w tendo ido|strong="G2064"\w* \w à cidade|strong="G1519,G3588,G4172"\w*, \w relataram|strong="G518"\w* \w aos chefes dos sacerdotes|strong="G3588,G749"\w* \w tudo o que acontecera|strong="G537,G3588,G1096"\w*.\x - \xo 28:11 \xt ACT 4:10; MAT 28:4; LUK 8:34\x*
\v 12 \w E|strong="G2532"\w*, \w reunidos|strong="G4863"\w* \w com os anciãos|strong="G3326,G3588,G4245"\w* \w e|strong="G5037"\w* \w tendo tomado conselho|strong="G4824,G2983"\w*, \w deram|strong="G1325"\w* \w bastantes moedas de prata|strong="G694,G2425"\w* \w aos soldados|strong="G3588,G4757"\w*,\x - \xo 28:12 \xt MAT 27:1; ACT 4:10; ACT 4:5-22; ACT 5:40; MAT 26:3-4; MAT 27:62-64\x*
\v 13 \w dizendo|strong="G3004"\w*: “\w Digam|strong="G2036"\w*: ‘\w Os seus discípulos|strong="G3588,G3101,G846"\w*, \w vindo|strong="G2064"\w* \w de noite|strong="G3571"\w*, \w o roubaram|strong="G2813,G846"\w* \w enquanto nós dormíamos|strong="G3165,G2837"\w*.’\x - \xo 28:13 \xt MAT 26:64; ACT 4:10; MAT 27:64\x*
\v 14 \w E|strong="G2532"\w* \w se isto|strong="G1437,G3778"\w* \w chegar aos ouvidos|strong="G191"\w* \w do governador|strong="G1909,G3588,G2232"\w*, \w nós|strong="G3165"\w* \w o persuadiremos|strong="G3982,G846"\w* \w e|strong="G2532"\w* \w os deixaremos|strong="G4771,G4160"\w* \w livres de preocupação|strong="G275"\w*.”\x - \xo 28:14 \xt ACT 4:10; MAT 27:2; ACT 12:19\x*
\v 15 \w E eles|strong="G3588,G1161"\w*, \w tomando|strong="G2983"\w* \w as moedas de prata|strong="G3588,G694"\w*, \w fizeram|strong="G4160"\w* \w como|strong="G5613"\w* \w foram instruídos|strong="G1321"\w*. \w E|strong="G2532"\w* \w espalhou-se|strong="G1310"\w* \w esta história|strong="G3588,G3056,G3778"\w* \w entre os judeus|strong="G3844,G2453"\w* \w até o dia de hoje|strong="G3360,G3588,G4594,G2250"\w*.\x - \xo 28:15 \xt 1TI 6:10; MAT 27:8; ACT 4:10; MAT 26:15; MRK 1:45\x*
\p
\v 16 \w E os onze|strong="G3588,G1161,G1733"\w* \w discípulos|strong="G3101"\w* \w foram|strong="G4198"\w* \w para a Galileia|strong="G1519,G3588,G1056"\w*, \w ao monte|strong="G1519,G3588,G3735"\w* \w que|strong="G3757"\w* \w Jesus|strong="G3588,G2424"\w* \w lhes havia designado|strong="G5021,G846"\w*,\f + \fr 28.16: \ft Lit.: οὗ ἐτάξατο αὐτοῖς ὁ Ἰησοῦς, literalmente “onde Jesus lhes designou”; em português o objeto precisa aparecer: “o monte que Jesus lhes havia designado”.\f*\x - \xo 28:16 \xt MAT 26:32; MRK 14:28; MAT 28:10; MAT 28:7; MRK 16:7; MRK 16:14\x*
\v 17 \w e|strong="G2532"\w*, \w vendo-o|strong="G1492,G846"\w*, \w se prostraram|strong="G4352"\w*; \w mas alguns|strong="G3588,G1161"\w* \w duvidaram|strong="G1365"\w*.\f + \fr 28.17: \ft Lit.: διστάζω, “hesitar, duvidar”.\f*\f + \fr 28.17: \ft Tradução: προσεκύνησαν (προσκυνέω, G4352) está aqui como “se prostraram”; o termo pode ser “adorar”, “prostrar-se” ou “prestar homenagem”, e o contexto decide.\f*\x - \xo 28:17 \xt MAT 28:9; PSA 45:11; MRK 16:7; MAT 14:33; MAT 8:2; JHN 5:23\x*
\v 18 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w*, \w aproximando-se|strong="G4334"\w*, \w lhes falou|strong="G2980,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Foi dada|strong="G1325"\w* \w a mim|strong="G3165"\w* \w toda autoridade|strong="G3956,G1849"\w* \w no céu|strong="G1722,G3772"\w* \w e|strong="G2532"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*.\f + \fr 28.18: \ft Nota cultural: ecoa Dn 7:13-14.\f*\x - \xo 28:18 \xt DAN 7:13-14; ISA 9:6; MAT 11:27; JHN 3:35; 1PE 3:22; PHP 2:10\x*
\v 19 \w Vão|strong="G4198"\w*, \w pois|strong="G3767"\w*, \add e\add* \w façam discípulos|strong="G3100"\w* \w de todas as nações|strong="G3956,G3588,G1484"\w*, \w batizando-os|strong="G907,G846"\w* \w no nome|strong="G1519,G3588,G3686"\w* \w do Pai|strong="G3588,G3962"\w* \w e|strong="G2532"\w* \w do Filho|strong="G3588,G5207"\w* \w e|strong="G2532"\w* \w do Espírito Santo|strong="G3588,G40,G4151"\w*\f + \fr 28.19: \ft Lit.: μαθητεύω, “fazer discípulos”; ἔθνη, “nações, povos”; εἰς τὸ ὄνομα, “para dentro do nome”, também traduzido “em nome de”.\f*,\f + \fr 28.19: \ft Acréscimo: “e” (em “Vão pois e façam discípulos”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 28:19 \xt ACT 1:8; ACT 2:38; MRK 16:15; LUK 24:47; 1CO 1:15; ACT 19:5\x*
\v 20 \w ensinando-os|strong="G1321,G846"\w* \w a guardar|strong="G5083"\w* \w tudo o que|strong="G3956,G3745"\w* \w lhes ordenei|strong="G1781,G4771"\w*. \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w eu|strong="G1473"\w* \w estou|strong="G1510"\w* \w com vocês|strong="G3326,G4771"\w* \w todos os dias|strong="G3956,G3588,G2250"\w* \w até o fim|strong="G2193,G3588,G4930"\w* \w da era|strong="G3588,G165"\w*.”\f + \fr 28.20: \ft Variante: o RP e o TR acrescentam Ἀμήν (“amém”) no fim do verso.\f*\x - \xo 28:20 \xt ISA 41:10; MAT 13:49; JOS 1:5; ACT 18:9-10; JOS 1:8; PSA 23:4\x*
