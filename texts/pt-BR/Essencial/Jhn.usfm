\v 38 \w Ele|strong="G3588"\w* \w disse|strong="G5346"\w*: “\w Creio|strong="G4100"\w*, \w Senhor|strong="G2962"\w*”; \w e|strong="G2532"\w* \w o adorou|strong="G4352,G846"\w*.\f + \fr 9.38: \ft Lit.: Προσκυνέω, “prostrar-se, adorar, render homenagem”.\f*\x - \xo 9:38 \xt JHN 20:28; GAL 2:20; LUK 17:15; MAT 14:33; MAT 28:9; MAT 8:2\x*
\v 39 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Para julgamento|strong="G1519,G2917"\w* \w eu|strong="G1473"\w* \w vim|strong="G2064"\w* \w a este mundo|strong="G1519,G3588,G2889,G3778"\w*, \w para que|strong="G2443"\w* \w os que não veem|strong="G3588,G3361,G991"\w* \w vejam|strong="G991"\w* \w e|strong="G2532"\w* \w os que veem|strong="G3588,G991"\w* \w cegos|strong="G5185"\w* \w se tornem|strong="G1096"\w*.”\f + \fr 9.39: \ft Lit.: Κρίμα, “sentença, julgamento” (resultado do julgar), distinto de κρίσις, “julgamento” (ato de julgar).\f*\x - \xo 9:39 \xt ISA 35:5; LUK 4:18; JHN 3:19; PSA 119:18; JHN 5:22; ACT 26:18\x*
\v 40 \w Ouviram|strong="G191"\w* \w estas coisas|strong="G3778"\w* \w aqueles|strong="G3588"\w* \w dentre os fariseus|strong="G1537,G3588,G5330"\w* \w que estavam|strong="G1510"\w* \w com ele|strong="G3326,G846"\w*, \w e|strong="G2532"\w* \w lhe disseram|strong="G2036,G846"\w*: “\w Será que|strong="G3361"\w* \w também|strong="G2532"\w* \w nós|strong="G3165"\w* \w cegos|strong="G5185"\w* \w somos|strong="G1510"\w*?”\f + \fr 9.40: \ft Variante: o RP acrescenta “e” (καί) no início e traz “estando com ele” em outra ordem.\f*\f + \fr 9.40: \ft Acréscimo: verbo ser/estar suprido em “Será que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:40 \xt JHN 9:13; LUK 4:18; JHN 3:19; REV 3:17; MAT 11:25; EZK 12:2\x*
\v 41 \w Disse-lhes|strong="G2036,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Se|strong="G1487"\w* \w cegos|strong="G5185"\w* \w fossem|strong="G1510"\w*, \w não|strong="G3756"\w* \w teriam|strong="G302,G2192"\w* \w pecado|strong="G266"\w*; \w agora|strong="G3568"\w*, \w porém|strong="G1161"\w*, \w dizem|strong="G3004"\w*: ‘\w Vemos|strong="G991"\w*’; \w o pecado|strong="G3588,G266"\w* \w de vocês|strong="G4771"\w* \w permanece|strong="G3306"\w*.”\f + \fr 9.41: \ft Variante: o RP acrescenta “portanto” (οὖν) depois de “o” (ἡ ἁμαρτία): “Portanto, o pecado de vocês permanece”.\f*\x - \xo 9:41 \xt JHN 15:22; JAS 4:17; HEB 10:26; LUK 4:18; ISA 5:21; LUK 12:47\x*
\c 10
\p
\v 1 “\w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w aquele que não entra|strong="G3588,G3361,G1525"\w* \w pela porta|strong="G1223,G3588,G2374"\w* \w no curral|strong="G1519,G3588,G833"\w* \w das ovelhas|strong="G3588,G4263"\w*, \w mas|strong="G235"\w* \w sobe|strong="G305"\w* \w por outro lado|strong="G237"\w*, \w aquele|strong="G1565"\w* \w é ladrão|strong="G2812,G1510"\w* \w e|strong="G2532"\w* \w assaltante|strong="G3027"\w*;\f + \fr 10.1: \ft Lit.: Κλέπτης, “ladrão” (que furta às escondidas), e λῃστής, “assaltante, bandoleiro” (que rouba com violência).\f*\x - \xo 10:1 \xt JHN 10:8; JHN 10:7; JHN 10:10; JHN 10:9; MAT 7:15; 1JN 4:1\x*
\v 2 \w aquele que entra|strong="G3588,G1525"\w* \w pela porta|strong="G1223,G3588,G2374"\w*, \w porém|strong="G1161"\w*, \w é pastor|strong="G4166,G1510"\w* \w das ovelhas|strong="G3588,G4263"\w*.\x - \xo 10:2 \xt JHN 10:7; JHN 10:11; JHN 10:16; HEB 13:20; JHN 10:9; JER 3:15\x*
\v 3 \w Para este|strong="G3778"\w* \w o porteiro|strong="G3588,G2377"\w* \w abre|strong="G455"\w*, \w e|strong="G2532"\w* \w as ovelhas|strong="G3588,G4263"\w* \w a voz dele|strong="G3588,G5456,G846"\w* \w ouvem|strong="G191"\w* \w e|strong="G2532"\w* \w as suas próprias|strong="G3588,G2398"\w* \w ovelhas|strong="G4263"\w* \w chama|strong="G5455"\w* \w pelo nome|strong="G2596,G3686"\w* \w e|strong="G2532"\w* \w as conduz para fora|strong="G1806,G846"\w*.\x - \xo 10:3 \xt JHN 10:27; HEB 3:7; EZK 34:11-16; JER 3:15; 2TI 2:19; JHN 10:4\x*
\v 4 \w Quando|strong="G3752"\w* \w todas|strong="G3956"\w* \w as suas próprias|strong="G3588,G2398"\w* \w tiver levado para fora|strong="G1544"\w*, \w adiante delas|strong="G1715,G846"\w* \w vai|strong="G4198"\w*, \w e|strong="G2532"\w* \w as ovelhas|strong="G3588,G4263"\w* \w o seguem|strong="G846,G190"\w*, \w porque|strong="G3754"\w* \w sabem|strong="G6063"\w* \w a voz|strong="G3588,G5456"\w* \w dele|strong="G846"\w*;\f + \fr 10.4: \ft Lit.: Ἐκβάλλω, “lançar para fora”: expressa saída enérgica e é usado também para “expulsar” (9:34-35).\f*\f + \fr 10.4: \ft Variante: o RP acrescenta “E” (καί) no início e traz “ovelhas” (πρόβατα) em lugar de “todas” (πάντα).\f*\x - \xo 10:4 \xt JHN 10:27; DEU 1:30; JHN 10:16; JER 3:15; JHN 12:26; 1JN 2:20\x*
\v 5 \w A um estranho|strong="G245"\w*, \w porém|strong="G1161"\w*, \w de modo algum|strong="G3756,G3361"\w* \w seguirão|strong="G190"\w*, \w mas|strong="G235"\w* \w fugirão|strong="G5343"\w* \w dele|strong="G575,G846"\w*, \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w conhecem|strong="G6063"\w* \w a voz|strong="G3588,G5456"\w* \w dos estranhos|strong="G3588,G245"\w*.”\x - \xo 10:5 \xt JER 3:15; 1JN 2:20; 1JN 4:5-6; 1CO 4:16; COL 2:6-10; NUM 9:17\x*
\v 6 \w Esta comparação|strong="G3778,G3588,G3942"\w* \w lhes disse|strong="G2036,G846"\w* \w Jesus|strong="G3588,G2424"\w*; \w aqueles|strong="G1565"\w*, \w porém|strong="G1161"\w*, \w não|strong="G3756"\w* \w entenderam|strong="G1097"\w* \w qual era|strong="G5101,G1510"\w* \w o que|strong="G3739"\w* \w lhes dizia|strong="G2980,G846"\w*\f + \fr 10.6: \ft Lit.: Παροιμία, “figura de linguagem, comparação, provérbio”; em João ocupa o lugar de “parábola”, termo que este evangelho não usa (cf. 16:25, 29).\f*.\x - \xo 10:6 \xt JHN 16:25; ISA 56:11; LUK 18:34; PRO 28:5; PSA 82:5\x*
\p
\v 7 \w Disse|strong="G2036"\w* \w então|strong="G3767"\w* \w de novo|strong="G3825"\w* \w a eles|strong="G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w eu sou|strong="G1473,G1510"\w* \w a porta|strong="G3588,G2374"\w* \w das ovelhas|strong="G3588,G4263"\w*\f + \fr 10.7: \ft Variante: WH e NA28 omitem “a eles” (αὐτοῖς); WH e Treg omitem “que” (ὅτι).\f*.\x - \xo 10:7 \xt JHN 10:1; JHN 10:2; JHN 14:6; JHN 10:9; EPH 2:18; EZK 34:31\x*
\v 8 \w Todos os que|strong="G3956,G3745"\w* \w vieram|strong="G2064"\w* \w antes de mim|strong="G4253,G1473"\w* \w são|strong="G1510"\w* \w ladrões|strong="G2812"\w* \w e|strong="G2532"\w* \w assaltantes|strong="G3027"\w*; \w mas|strong="G235"\w* \w não|strong="G3756"\w* \w os ouviram|strong="G191,G846"\w* \w as ovelhas|strong="G3588,G4263"\w*.\x - \xo 10:8 \xt JHN 10:1; JHN 10:27; EZK 34:2; JHN 10:4; JER 23:1; ACT 5:36\x*
\v 9 \w Eu sou|strong="G1473,G1510"\w* \w a porta|strong="G3588,G2374"\w*; \w por meio de mim|strong="G1223,G1473"\w*, \w se|strong="G1437"\w* \w alguém|strong="G5100"\w* \w entrar|strong="G1525"\w*, \w será salvo|strong="G4982"\w*, \w e|strong="G2532"\w* \w entrará|strong="G1525"\w* \w e|strong="G2532"\w* \w sairá|strong="G1831"\w* \w e|strong="G2532"\w* \w encontrará|strong="G2147"\w* \w pasto|strong="G3542"\w*.\x - \xo 10:9 \xt JHN 14:6; MAT 7:13; JHN 10:2; EPH 2:18; JHN 10:7; JHN 10:1\x*
\v 10 \w O|strong="G3588"\w* \w ladrão|strong="G2812"\w* \w não|strong="G3756"\w* \w vem|strong="G2064"\w* \w a não ser|strong="G1487,G3361"\w* \w para que|strong="G2443"\w* \w roube|strong="G2813"\w* \w e|strong="G2532"\w* \w mate|strong="G2380"\w* \w e|strong="G2532"\w* \w destrua|strong="G622"\w*; \w eu|strong="G1473"\w* \w vim|strong="G2064"\w* \w para que|strong="G2443"\w* \w vida|strong="G2222"\w* \w tenham|strong="G2192"\w* \w e|strong="G2532"\w* \w em abundância|strong="G4053"\w* \w tenham|strong="G2192"\w*.\f + \fr 10.10: \ft Lit.: Θύω, “sacrificar, matar (para sacrifício ou refeição)”.\f*\x - \xo 10:10 \xt JHN 12:47; JHN 3:17; JHN 6:33; JHN 6:51; LUK 19:10; 1TI 1:15\x*
\v 11 \w Eu sou|strong="G1473,G1510"\w* \w o pastor|strong="G3588,G4166"\w* \w bom|strong="G3588,G2570"\w*; \w o pastor|strong="G3588,G4166"\w* \w bom|strong="G3588,G2570"\w* \w entrega|strong="G5087"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w em favor|strong="G5228"\w* \w das ovelhas|strong="G3588,G4263"\w*.\f + \fr 10.11: \ft Lit.: Καλός, “bom, belo, exemplar”; ψυχή, “vida, alma, pessoa”; τίθησιν, “põe, entrega” (cf. 10:15, 17, 18; 13:37-38; 15:13).\f*\x - \xo 10:11 \xt JHN 15:13; JHN 10:14; 1PE 2:25; 1JN 3:16; JHN 10:15; PSA 23:1\x*
\v 12 \w O assalariado|strong="G3588,G3411"\w* \w e|strong="G2532"\w* \w que não é|strong="G3756,G1510"\w* \w pastor|strong="G4166"\w*, \w de quem|strong="G3739"\w* \w não são|strong="G3756,G1510"\w* \w as ovelhas|strong="G3588,G4263"\w* \w próprias|strong="G2398"\w*, \w vê|strong="G2334"\w* \w o lobo|strong="G3588,G3074"\w* \w que vem|strong="G2064"\w* \w e|strong="G2532"\w* \w abandona|strong="G863"\w* \w as ovelhas|strong="G3588,G4263"\w* \w e|strong="G2532"\w* \w foge|strong="G5343"\w* — \w e|strong="G2532"\w* \w o lobo|strong="G3588,G3074"\w* \w as arrebata|strong="G726,G846"\w* \w e|strong="G2532"\w* \w as dispersa|strong="G4650"\w*—\f + \fr 10.12: \ft Variante: Treg e o RP acrescentam “porém” (δέ) depois de “assalariado”; o RP traz “são” (εἰσιν) em lugar de “é” (ἔστιν) e acrescenta “as ovelhas” depois de “dispersa”.\f*\f + \fr 10.12: \ft Tradução: ἀφίησιν (ἀφίημι, G863) está aqui como “abandona”; o termo pode ser “deixar”, “perdoar”, “permitir”, “abandonar” ou “mandar embora”, e o contexto decide.\f*\x - \xo 10:12 \xt JHN 10:2; 1PE 2:25; ISA 40:11; JER 23:1; EZK 34:12; MAT 18:12\x*
\v 13 \w porque|strong="G3754"\w* \w é assalariado|strong="G3411,G1510"\w* \w e|strong="G2532"\w* \w não lhe importam|strong="G3756,G3199,G846"\w* \w as ovelhas|strong="G4012,G3588,G4263"\w*.\f + \fr 10.13: \ft Variante: o RP acrescenta, antes de “porque”, “O assalariado foge” (Ὁ δὲ μισθωτὸς φεύγει).\f*\x - \xo 10:13 \xt 1PE 2:25; 1PE 5:7; ISA 40:11; MAT 18:12; ZEC 13:7; JHN 21:16\x*
\v 14 \w Eu sou|strong="G1473,G1510"\w* \w o pastor|strong="G3588,G4166"\w* \w bom|strong="G3588,G2570"\w*, \w e|strong="G2532"\w* \w conheço|strong="G1097"\w* \w as minhas|strong="G3588,G1473"\w*, \w e|strong="G2532"\w* \w me conhecem|strong="G1097,G3165"\w* \w as minhas|strong="G3588,G1473"\w*,\f + \fr 10.14: \ft Variante: o RP traz “e sou conhecido pelas minhas” (γινώσκομαι ὑπὸ τῶν ἐμῶν) em lugar de “e as minhas me conhecem”.\f*\x - \xo 10:14 \xt JHN 10:11; 2TI 2:19; PSA 23:1; JHN 10:27; 1PE 2:25; NAM 1:7\x*
\v 15 \w assim como|strong="G2531"\w* \w me conhece|strong="G1097,G3165"\w* \w o Pai|strong="G3588,G3962"\w*, \w e eu|strong="G2532_A,G1473"\w* \w conheço|strong="G1097"\w* \w o Pai|strong="G3588,G3962"\w*, \w e|strong="G2532"\w* \w entrego|strong="G5087"\w* \w a minha vida|strong="G3588,G5590,G3165"\w* \w em favor|strong="G5228"\w* \w das ovelhas|strong="G3588,G4263"\w*.\x - \xo 10:15 \xt JHN 10:11; JHN 15:13; 1JN 3:16; JHN 10:17; JHN 10:27; MAT 11:27\x*
\v 16 \w E|strong="G2532"\w* \w outras ovelhas|strong="G243,G4263"\w* \w tenho|strong="G2192"\w* \w que não|strong="G3739,G3756"\w* \w são|strong="G1510"\w* \w deste curral|strong="G1537,G3588,G833,G3778"\w*; \w também aquelas|strong="G1565,G2532"\w* \w é necessário|strong="G1163"\w* \w que eu|strong="G3165"\w* \w conduza|strong="G71"\w*, \w e|strong="G2532"\w* \w a minha voz|strong="G3588,G5456,G3165"\w* \w ouvirão|strong="G191"\w*, \w e|strong="G2532"\w* \w haverá|strong="G1096"\w* \w um só|strong="G1520"\w* \w rebanho|strong="G4167"\w*, \w um só|strong="G1520"\w* \w pastor|strong="G4166"\w*.\f + \fr 10.16: \ft Variante: o RP traz “me é necessário” (με δεῖ) em outra ordem e o singular γενήσεται em lugar de γενήσονται (“haverá”).\f*\x - \xo 10:16 \xt JHN 10:2; JHN 10:27; JHN 10:11; 1PE 2:25; ISA 56:8; GAL 3:28\x*
\v 17 \w Por isso|strong="G1223,G3778"\w* \w o Pai|strong="G3588,G3962"\w* \w me ama|strong="G3165,G25"\w*, \w porque|strong="G3754"\w* \w eu|strong="G1473"\w* \w entrego|strong="G5087"\w* \w a minha vida|strong="G3588,G5590,G3165"\w*, \w para que|strong="G2443"\w* \w de novo|strong="G3825"\w* \w a retome|strong="G2983,G846"\w*.\x - \xo 10:17 \xt JHN 10:11; JHN 10:15; JHN 10:18; MAT 18:12; JHN 2:19; HEB 2:9\x*
\v 18 \w Ninguém|strong="G3762"\w* \w a tira|strong="G142,G846"\w* \w de mim|strong="G575,G1473"\w*, \w mas|strong="G235"\w* \w eu|strong="G1473"\w* \w a entrego|strong="G5087,G846"\w* \w por mim mesmo|strong="G575,G1473"\w*. \w Autoridade|strong="G1849"\w* \w tenho|strong="G2192"\w* \w de entregá-la|strong="G5087,G846"\w*, \w e|strong="G2532"\w* \w autoridade|strong="G1849"\w* \w tenho|strong="G2192"\w* \w de novo|strong="G3825"\w* \w de retomá-la|strong="G2983,G846"\w*; \w este mandamento|strong="G3778,G3588,G1785"\w* \w recebi|strong="G2983"\w* \w da parte|strong="G3844"\w* \w do meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w*.”\f + \fr 10.18: \ft Variante: WH traz o aoristo ἦρεν (“tirou”) em lugar do presente αἴρει (“tira”).\f*\x - \xo 10:18 \xt PHP 2:8; JHN 5:19; JHN 19:30; JHN 10:11; ACT 2:24; HEB 2:9\x*
\v 19 \w Houve|strong="G1096"\w* \w de novo|strong="G3825"\w* \w divisão|strong="G4978"\w* \w entre os judeus|strong="G1722,G3588,G2453"\w* \w por causa|strong="G1223"\w* \w destas palavras|strong="G3588,G3056,G3778"\w*.\f + \fr 10.19: \ft Variante: o RP acrescenta “então” (οὖν) depois de “Divisão”.\f*\x - \xo 10:19 \xt MAT 18:12; 1CO 1:10; JHN 6:52; JHN 7:43; JHN 9:16; 1CO 3:3\x*
\v 20 \w Diziam|strong="G3004"\w* \w muitos|strong="G4183"\w* \w dentre eles|strong="G1537,G846"\w*: “\w Tem|strong="G2192"\w* \w demônio|strong="G1140"\w* \w e|strong="G2532"\w* \w está louco|strong="G3105"\w*; \w por que|strong="G5101"\w* \w o ouvem|strong="G846,G191"\w*?”\x - \xo 10:20 \xt MAT 18:12; MRK 3:21; JHN 7:20; JHN 8:52; MAT 11:18; 1CO 2:14\x*
\v 21 \w Outros|strong="G243"\w* \w diziam|strong="G3004"\w*: “\w Estas palavras|strong="G3778,G3588,G4487"\w* \w não são|strong="G3756,G1510"\w* \w de um endemoninhado|strong="G1139"\w*; \w será que|strong="G3361"\w* \w um demônio|strong="G1140"\w* \w pode|strong="G1410"\w* \w abrir|strong="G455"\w* \w olhos|strong="G3788"\w* \w de cegos|strong="G5185"\w*?”\f + \fr 10.21: \ft Acréscimo: verbo ser/estar suprido em “será que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 10:21 \xt JHN 9:32; JHN 11:37; JHN 9:17; MAT 18:12; EXO 4:11; ISA 35:5-6\x*
\p
\v 22 \w Aconteceu|strong="G1096"\w* \w então|strong="G5119"\w* \w a Dedicação|strong="G3588,G1456"\w* \w em Jerusalém|strong="G1722,G3588,G2414"\w*; \w era inverno|strong="G5494,G1510"\w*,\f + \fr 10.22: \ft Nota cultural: Ἐγκαίνια, “renovação, dedicação”: a festa de Hanucá, em dezembro, que recorda a purificação e nova dedicação do templo por Judas Macabeu, em 164 a.C.\f*\f + \fr 10.22: \ft Variante: Treg e o RP trazem “e” (δέ) em lugar de “então” (τότε); o RP omite o artigo (τοῖς) diante de “Jerusalém” e acrescenta “e” (καί) antes de “inverno”.\f*\x - \xo 10:22 \xt 2CH 7:5; PSA 78:52; EZR 6:16\x*
\v 23 \w e|strong="G2532"\w* \w andava|strong="G4043"\w* \w Jesus|strong="G3588,G2424"\w* \w no templo|strong="G1722,G3588,G2411"\w*, \w no pórtico|strong="G1722,G3588,G4745"\w* \w de Salomão|strong="G3588,G4672"\w*.\x - \xo 10:23 \xt ACT 3:11; ACT 5:12; MRK 10:30; MRK 11:27; PSA 78:52; 1KI 6:3\x*
\v 24 \w Cercaram-no|strong="G2944,G846"\w* \w então|strong="G3767"\w* \w os judeus|strong="G3588,G2453"\w* \w e|strong="G2532"\w* \w lhe diziam|strong="G3004,G846"\w*: “\w Até quando|strong="G2193,G4219"\w* \w você nos mantém em suspense|strong="G3588,G5590,G3165,G142"\w*? \w Se|strong="G1487"\w* \w você|strong="G4771"\w* \w é|strong="G1510"\w* \w o Cristo|strong="G3588,G5547"\w*, \w diga-nos|strong="G2036,G3165"\w* \w abertamente|strong="G3954"\w*.”\f + \fr 10.24: \ft Lit.: Ἕως πότε τὴν ψυχὴν ἡμῶν αἴρεις;, literalmente “até quando você levanta (ou tira) a nossa alma?”; costuma-se entender como “até quando nos deixará em suspense?”.\f*\f + \fr 10.24: \ft Variante: WH traz a forma εἰπόν (aoristo, “eles disseram”) em lugar do imperativo εἰπέ (“diga”).\f*\x - \xo 10:24 \xt JHN 1:19; LUK 3:15; LUK 22:67; PSA 78:52; 1KI 18:21; JHN 11:14\x*
\v 25 \w Respondeu-lhes|strong="G611,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Eu disse|strong="G2036"\w* \w a vocês|strong="G4771"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w creem|strong="G4100"\w*; \w as obras|strong="G3588,G2041"\w* \w que|strong="G3739"\w* \w eu|strong="G1473"\w* \w faço|strong="G4160"\w* \w em nome|strong="G1722,G3588,G3686"\w* \w do meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w*, \w estas|strong="G3778"\w* \w dão testemunho|strong="G3140"\w* \w a meu respeito|strong="G4012,G1473"\w*;\x - \xo 10:25 \xt JHN 14:11; JHN 10:37; JHN 6:29; JHN 5:36; JHN 10:38; JHN 9:36\x*
\v 26 \w mas|strong="G235"\w* \w vocês|strong="G4771"\w* \w não|strong="G3756"\w* \w creem|strong="G4100"\w*, \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w são|strong="G1510"\w* \w das minhas|strong="G1537,G3588,G1473"\w* \w ovelhas|strong="G4263"\w*.\f + \fr 10.26: \ft Variante: o RP traz “pois não” (οὐ γάρ) em lugar de “porque não” (ὅτι οὐκ) e acrescenta, no fim, “como eu disse a vocês” (καθὼς εἶπον ὑμῖν).\f*\x - \xo 10:26 \xt 1CO 2:14; JHN 18:37; JHN 8:47; PSA 100:3; JHN 6:65; ACT 13:48\x*
\v 27 \w As minhas|strong="G3588,G1473"\w* \w ovelhas|strong="G4263"\w* \w a minha voz|strong="G3588,G5456,G3165"\w* \w ouvem|strong="G191"\w*, \w e eu|strong="G2532_A,G1473"\w* \w as conheço|strong="G1097,G846"\w*, \w e|strong="G2532"\w* \w me seguem|strong="G190,G3165"\w*,\x - \xo 10:27 \xt PSA 23:1; NAM 1:7; JHN 10:16; JHN 10:15; JHN 10:14; 2TI 2:19\x*
\v 28 \w e eu|strong="G2532_A,G1473"\w* \w lhes dou|strong="G1325,G846"\w* \w vida eterna|strong="G2222,G166"\w*, \w e|strong="G2532"\w* \w de modo algum|strong="G3756,G3361"\w* \w perecerão|strong="G622"\w* \w para sempre|strong="G1519,G3588,G165"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w as arrebatará|strong="G726,G846"\w* \w alguém|strong="G5100"\w* \w da minha mão|strong="G1537,G3588,G5495,G3165"\w*.\x - \xo 10:28 \xt JHN 3:16; JHN 3:15; ISA 54:17; PSA 23:1; JHN 6:39; JHN 17:2\x*
\v 29 \w O|strong="G3588"\w* \w meu|strong="G3165"\w* \w Pai|strong="G3962"\w*, \w quanto ao que|strong="G3739"\w* \w me deu|strong="G1325,G3165"\w*, \w é maior|strong="G3173,G1510"\w* \w do que todos|strong="G3956"\w*, \w e|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w pode|strong="G1410"\w* \w arrebatar|strong="G726"\w* \w da mão|strong="G1537,G3588,G5495"\w* \w do Pai|strong="G3588,G3962"\w*.\f + \fr 10.29: \ft Lit.: Ὁ πατήρ μου ὃ δέδωκέν μοι πάντων μεῖζων ἐστίν: o texto do SBLGNT (leitura de Holmes e da margem de WH) une um relativo neutro (ὃ, “o que”) a um comparativo masculino (μεῖζων, “maior”): “o meu Pai, quanto ao que me deu, é maior do que todos”; a construção é difícil e as edições se dividem.\f*\f + \fr 10.29: \ft Variante: WH, Treg e NA28 trazem o neutro μεῖζον (“o que o meu Pai me deu é maior do que tudo”); o RP e a NIV trazem ὅς… μείζων πάντων (“o meu Pai, que as deu a mim, é maior do que todos”); a NIV acrescenta “elas” (αὐτά) depois de “deu”; Treg e o RP acrescentam “meu” (μου) depois do segundo “Pai”.\f*\x - \xo 10:29 \xt ISA 54:17; PSA 23:1; ROM 8:31; 2TI 2:19; EPH 3:20; 1JN 4:4\x*
\v 30 \w Eu|strong="G1473"\w* \w e|strong="G2532"\w* \w o Pai|strong="G3588,G3962"\w* \w somos um|strong="G1520,G1510"\w*.”\f + \fr 10.30: \ft Lit.: Ἕν, neutro: “uma só coisa” (unidade), não “uma só pessoa” (que seria εἷς).\f*\x - \xo 10:30 \xt ISA 54:17; JHN 1:1; PSA 23:1; ROM 8:31; 2TI 2:19; EPH 3:20\x*
\v 31 \w Pegaram|strong="G941"\w* \w então|strong="G3767"\w* \w de novo|strong="G3825"\w* \w pedras|strong="G3037"\w* \w os judeus|strong="G3588,G2453"\w* \w para que|strong="G2443"\w* \w o apedrejassem|strong="G3034,G846"\w*.\f + \fr 10.31: \ft Variante: WH e NA28 omitem “então” (οὖν).\f*\x - \xo 10:31 \xt JHN 1:1; JHN 11:8; PSA 94:14; JHN 5:18; JHN 8:59; JHN 10:39\x*
\v 32 \w Respondeu-lhes|strong="G611,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Muitas obras|strong="G4183,G2041"\w* \w boas|strong="G2570"\w* \w mostrei|strong="G1166"\w* \w a vocês|strong="G4771"\w* \w da parte do Pai|strong="G1537,G3588,G3962"\w*; \w por qual|strong="G1223,G4169"\w* \w delas|strong="G846"\w* \w obra|strong="G2041"\w* \w me apedrejam|strong="G1473,G3034"\w*?”\f + \fr 10.32: \ft Variante: Treg e o RP acrescentam “meu” (μου) depois de “Pai”.\f*\x - \xo 10:32 \xt JHN 1:1; JHN 9:4; ACT 10:38; PSA 35:12; JHN 8:59; PSA 38:20\x*
\v 33 \w Responderam-lhe|strong="G611,G846"\w* \w os judeus|strong="G3588,G2453"\w*: “\w Por uma boa obra|strong="G4012,G2570,G2041"\w* \w não|strong="G3756"\w* \w apedrejamos você|strong="G3034,G4771"\w*, \w mas|strong="G235"\w* \w por blasfêmia|strong="G4012,G988"\w*, \w e|strong="G2532"\w* \w porque|strong="G3754"\w* \w você|strong="G4771"\w*, \w sendo|strong="G1510"\w* \w um homem|strong="G444"\w*, \w faz de si mesmo|strong="G4160,G4771"\w* \w Deus|strong="G2316"\w*.”\f + \fr 10.33: \ft Variante: o RP acrescenta “dizendo” (λέγοντες) depois de “judeus”.\f*\x - \xo 10:33 \xt JHN 1:1; PHP 2:6; JHN 5:18; JHN 10:30; JHN 8:59; LEV 24:16\x*
\v 34 \w Respondeu-lhes|strong="G611,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Não|strong="G3756"\w* \w está escrito|strong="G1510,G1125"\w* \w na lei|strong="G1722,G3588,G3551"\w* \w de vocês|strong="G4771"\w*: ‘\w Eu|strong="G1473"\w* \w disse|strong="G2036"\w*: \w Vocês são|strong="G1510"\w* \w deuses|strong="G2316"\w*’?\f + \fr 10.34: \ft Lit.: Νόμος, “lei”: aqui usado em sentido amplo, para as Escrituras; a citação é de Sl 82:6.\f*\f + \fr 10.34: \ft Nota cultural: Sl 82:6 (81:6 na LXX).\f*\x - \xo 10:34 \xt PSA 82:6; LUK 4:4; JHN 19:22; JHN 12:34; LUK 10:26; EXO 7:1\x*
\v 35 \w Se|strong="G1487"\w* \w àqueles|strong="G1565"\w* \w chamou|strong="G2036"\w* \w deuses|strong="G2316"\w*, \w a quem|strong="G4314,G3739"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w* \w veio|strong="G1096"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w pode|strong="G1410"\w* \w ser desfeita|strong="G3089"\w* \w a Escritura|strong="G3588,G1124"\w*,\x - \xo 10:35 \xt PSA 82:6; 2TI 3:16; ISA 34:16; ISA 40:8; MAT 24:35; PSA 82:1\x*
\v 36 \w àquele que|strong="G3739"\w* \w o Pai|strong="G3588,G3962"\w* \w consagrou|strong="G37"\w* \w e|strong="G2532"\w* \w enviou|strong="G649"\w* \w ao mundo|strong="G1519,G3588,G2889"\w*, \w vocês|strong="G4771"\w* \w dizem|strong="G3004"\w*: ‘\w Blasfema|strong="G987"\w*’, \w porque|strong="G3754"\w* \w disse|strong="G2036"\w*: ‘\w Sou|strong="G1510"\w* \w Filho|strong="G5207"\w* \w de Deus|strong="G3588,G2316"\w*’?\f + \fr 10.36: \ft Lit.: Ἁγιάζω, “consagrar, separar para Deus, santificar”.\f*\x - \xo 10:36 \xt PSA 82:6; JHN 17:18; JHN 3:17; JHN 17:21; 1JN 4:14; 2PE 1:17\x*
\v 37 \w Se|strong="G1487"\w* \w não|strong="G3756"\w* \w faço|strong="G4160"\w* \w as obras|strong="G3588,G2041"\w* \w do meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w*, \w não acreditem|strong="G3361,G4100"\w* \w em mim|strong="G3165"\w*;\x - \xo 10:37 \xt JHN 14:11; JHN 14:10; JHN 10:25; JHN 6:29; JHN 14:12; GAL 2:16\x*
\v 38 \w se|strong="G1487"\w*, \w porém|strong="G1161"\w*, \w faço|strong="G4160"\w*, \w mesmo que|strong="G1437,G2532"\w* \w em mim|strong="G1473"\w* \w não acreditem|strong="G3361,G4100"\w*, \w nas obras|strong="G3588,G2041"\w* \w acreditem|strong="G4100"\w*, \w para que|strong="G2443"\w* \w venham a conhecer|strong="G1097"\w* \w e|strong="G2532"\w* \w continuem conhecendo|strong="G1097"\w* \w que|strong="G3754"\w* \w em mim|strong="G1722,G1473"\w* \add está\add* \w o Pai|strong="G3588,G3962"\w*, \w e eu|strong="G2532_C,G1473"\w* \add estou\add* \w no Pai|strong="G1722,G3588,G3962"\w*\f + \fr 10.38: \ft Variante: o RP traz πιστεύσατε (“creiam”, aoristo) em lugar de πιστεύετε, πιστεύσητε (“venham a crer”) em lugar de γινώσκητε (“saibam”) e αὐτῷ (“nele”) em lugar de “no Pai”.\f*.”\f + \fr 10.38: \ft Acréscimo: “está” (em “em mim está o Pai”), “estou” (em “e eu estou no Pai”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 10:38 \xt JHN 14:11; JHN 14:10; JHN 10:25; JHN 2:24; COL 2:9; JHN 14:20\x*
