\v 43 \w E|strong="G2532"\w* \w tendo dito|strong="G2036"\w* \w isto|strong="G3778"\w*, \w com grande voz|strong="G5456,G3173"\w* \w gritou|strong="G2905"\w*: “\w Lázaro|strong="G2976"\w*, \w venha|strong="G1204"\w* \w para fora|strong="G1854"\w*!”\x - \xo 11:43 \xt EPH 5:14; LUK 7:14; 2KI 4:33-36; ACT 9:40; JHN 12:28; ACT 9:34\x*
\v 44 \w Saiu|strong="G1831"\w* \w o que estava morto|strong="G3588,G2348"\w*, \w atado|strong="G1210"\w* \w nos pés|strong="G3588,G4228"\w* \w e|strong="G2532"\w* \w nas mãos|strong="G3588,G5495"\w* \w com faixas|strong="G2750"\w*, \w e|strong="G2532"\w* \w o rosto|strong="G3588,G3799"\w* \w dele|strong="G846"\w* \w com um lenço|strong="G4676"\w* \w estava envolvido|strong="G4019"\w*. \w Disse-lhes|strong="G3004,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Soltem-no|strong="G3089,G846"\w* \w e|strong="G2532"\w* \w deixem-no|strong="G863,G846"\w* \w ir|strong="G5217"\w*\f + \fr 11.44: \ft Variante: o RP acrescenta “E” (καί) no início e omite o segundo “o” (αὐτόν) depois de “deixem”; WH inverte a ordem de “Jesus” e “lhes”.\f*\f + \fr 11.44: \ft Nota cultural: os mortos eram envolvidos em faixas de linho e o rosto era coberto por um lenço (σουδάριον); cf. 20:5-7.\f*.”\x - \xo 11:44 \xt EPH 5:14; JHN 5:25; JHN 20:7; JHN 11:25-26; LUK 7:14; JHN 12:28\x*
\p
\v 45 \w Muitos|strong="G4183"\w* \w então|strong="G3767"\w* \w dos judeus|strong="G1537,G3588,G2453"\w*, \w os que tinham vindo|strong="G3588,G2064"\w* \w a Maria|strong="G4314,G3588,G3137"\w* \w e|strong="G2532"\w* \w tendo visto|strong="G2300"\w* \w o que|strong="G3739"\w* \w fez|strong="G4160"\w*, \w creram|strong="G4100"\w* \w nele|strong="G1519,G846"\w*;\f + \fr 11.45: \ft Variante: o RP acrescenta “Jesus” (ὁ Ἰησοῦς) depois de “fez”.\f*\x - \xo 11:45 \xt JHN 12:11; JHN 11:19; EXO 14:31; HEB 11:35; JHN 2:23; LUK 16:31\x*
\v 46 \w alguns|strong="G5100"\w* \w dentre eles|strong="G1537,G846"\w* \w foram|strong="G565"\w* \w aos fariseus|strong="G4314,G3588,G5330"\w* \w e|strong="G2532"\w* \w lhes disseram|strong="G2036,G846"\w* \w o que|strong="G3739"\w* \w fez|strong="G4160"\w* \w Jesus|strong="G2424"\w*.\x - \xo 11:46 \xt LUK 16:31; JHN 9:13; LUK 16:30-31\x*
\v 47 \w Reuniram|strong="G4863"\w* \w então|strong="G3767"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w* \w o Sinédrio|strong="G4892"\w*, \w e|strong="G2532"\w* \w diziam|strong="G3004"\w*: “\w O que|strong="G5101"\w* \w fazemos|strong="G4160"\w*, \w porque|strong="G3754"\w* \w este homem|strong="G3778,G3588,G444"\w* \w muitos|strong="G4183"\w* \w sinais|strong="G4592"\w* \w faz|strong="G4160"\w*?\f + \fr 11.47: \ft Lit.: Συνέδριον, “conselho, assembleia”: o Sinédrio, o conselho supremo de Jerusalém.\f*\x - \xo 11:47 \xt MAT 2:3; MAT 26:3; JHN 12:10; JHN 3:2; LUK 16:31; NUM 23:23\x*
\v 48 \w Se|strong="G1437"\w* \w o deixarmos|strong="G863,G846"\w* \w assim|strong="G3779"\w*, \w todos|strong="G3956"\w* \w crerão|strong="G4100"\w* \w nele|strong="G1519,G846"\w*, \w e|strong="G2532"\w* \w virão|strong="G2064"\w* \w os romanos|strong="G3588,G4514"\w* \w e|strong="G2532"\w* \w tirarão|strong="G142"\w* \w de nós|strong="G3165"\w* \w tanto|strong="G2532"\w* \w o lugar|strong="G3588,G5117"\w* \w como|strong="G2532"\w* \w a nação|strong="G3588,G1484"\w*.”\f + \fr 11.48: \ft Lit.: Τόπος, “lugar”: provavelmente o templo (cf. At 6:13-14; 21:28) ou a cidade; ἔθνος, “nação, povo”.\f*\x - \xo 11:48 \xt ACT 21:28; ACT 6:13-14; MAT 2:3; 1TH 2:15-16; JHN 12:10; JHN 3:2\x*
\v 49 \w Um|strong="G1520"\w* \w certo|strong="G5100"\w* \w dentre eles|strong="G1537,G846"\w*, \w Caifás|strong="G2533"\w*, \w sendo sumo sacerdote|strong="G749,G1510"\w* \w daquele ano|strong="G3588,G1763,G1565"\w*, \w lhes disse|strong="G2036,G846"\w*: “\w Vocês|strong="G4771"\w* \w não|strong="G3756"\w* \w sabem|strong="G6063"\w* \w nada|strong="G3762"\w*,\x - \xo 11:49 \xt JHN 18:13; MAT 26:3; JHN 11:51; LUK 3:2; ACT 4:6; JHN 18:14\x*
\v 50 \w nem|strong="G3761"\w* \w consideram|strong="G3049"\w* \w que|strong="G3754"\w* \w convém|strong="G4851"\w* \w a vocês|strong="G4771"\w* \w que|strong="G2443"\w* \w um só|strong="G1520"\w* \w homem|strong="G444"\w* \w morra|strong="G599"\w* \w em favor|strong="G5228"\w* \w do povo|strong="G3588,G2992"\w* \w e|strong="G2532"\w* \w não|strong="G3361"\w* \w a nação inteira|strong="G3650,G3588,G1484"\w* \w pereça|strong="G622"\w*.”\f + \fr 11.50: \ft Variante: o RP traz διαλογίζεσθε (“ponderam”) em lugar de λογίζεσθε (“consideram”) e ἡμῖν (“a nós”) em lugar de ὑμῖν (“a vocês”).\f*\x - \xo 11:50 \xt JHN 18:14; ISA 53:8; MAT 20:28; JHN 12:10; JON 1:12; LUK 16:31\x*
\v 51 \w Isto|strong="G3778"\w* \w de si mesmo|strong="G575,G1438"\w* \w não|strong="G3756"\w* \w disse|strong="G2036"\w*, \w mas|strong="G235"\w*, \w sendo sumo sacerdote|strong="G749,G1510"\w* \w daquele ano|strong="G3588,G1763,G1565"\w*, \w profetizou|strong="G4395"\w* \w que|strong="G3754"\w* \w Jesus|strong="G2424"\w* \w estava para|strong="G3195"\w* \w morrer|strong="G599"\w* \w em favor|strong="G5228"\w* \w da nação|strong="G3588,G1484"\w*,\x - \xo 11:51 \xt JHN 11:49; JHN 18:13; 1JN 2:2; JHN 18:14; ISA 53:8; MAT 20:28\x*
\v 52 \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w em favor|strong="G5228"\w* \w da nação|strong="G3588,G1484"\w* \w somente|strong="G3441"\w*, \w mas|strong="G235"\w* \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w os filhos|strong="G3588,G5043"\w* \w de Deus|strong="G3588,G2316"\w* \w dispersos|strong="G3588,G1287"\w* \w reunisse|strong="G4863"\w* \w em um só|strong="G1519,G1520"\w*.\x - \xo 11:52 \xt JHN 10:16; JHN 1:12; GAL 3:28; 1JN 2:2; ACT 13:48; JHN 18:14\x*
\v 53 \w Desde aquele dia|strong="G575,G1565,G3588,G2250"\w* \w então|strong="G3767"\w* \w resolveram|strong="G1011"\w* \w para que|strong="G2443"\w* \w o matassem|strong="G615,G846"\w*.\x - \xo 11:53 \xt JHN 12:10; LUK 16:31; MAT 10:23; MAT 12:14; MAT 26:3; GEN 37:18\x*
\v 54 \w Jesus|strong="G3588,G2424"\w* \w então|strong="G3767"\w* \w já não|strong="G2089,G3756"\w* \w andava|strong="G4043"\w* \w abertamente|strong="G3954"\w* \w entre os judeus|strong="G1722,G3588,G2453"\w*, \w mas|strong="G235"\w* \w retirou-se|strong="G565"\w* \w dali|strong="G1564"\w* \w para a região|strong="G1519,G3588,G5561"\w* \w perto|strong="G1451"\w* \w do deserto|strong="G3588,G2048"\w*, \w para uma cidade|strong="G1519,G4172"\w* \w chamada|strong="G3004"\w* \w Efraim|strong="G2187"\w*, \w e ali|strong="G1563,G2532"\w* \w ficou|strong="G3306"\w* \w com os discípulos|strong="G3326,G3588,G3101"\w*\f + \fr 11.54: \ft Variante: o RP traz διέτριβεν (“permaneceu”) em lugar de ἔμεινεν (“ficou”) e acrescenta “dele” (αὐτοῦ) depois de “discípulos”.\f*.\x - \xo 11:54 \xt JHN 7:1; MAT 10:23; MRK 11:18; MAT 12:15; 2CH 13:19; ACT 12:17\x*
\p
\v 55 \w Estava|strong="G1510"\w* \w perto|strong="G1451"\w* \w a Páscoa|strong="G3588,G3957"\w* \w dos judeus|strong="G3588,G2453"\w*, \w e|strong="G2532"\w* \w subiram|strong="G305"\w* \w muitos|strong="G4183"\w* \w a Jerusalém|strong="G1519,G2414"\w* \w da região|strong="G1537,G3588,G5561"\w* \w antes|strong="G4253"\w* \w da Páscoa|strong="G3588,G3957"\w*, \w para que|strong="G2443"\w* \w purificassem|strong="G48"\w* \w a si mesmos|strong="G1438"\w*.\f + \fr 11.55: \ft Nota cultural: a purificação ritual era exigida de quem tivera contato com a morte antes de participar da Páscoa (cf. Nm 9:6-10; 2Cr 30:17-19).\f*\x - \xo 11:55 \xt NUM 9:6; 2CH 30:17-19; JHN 2:13; JHN 6:4; 2CH 30:17-20; HEB 9:13-14\x*
\v 56 \w Procuravam|strong="G2212"\w* \w então|strong="G3767"\w* \w Jesus|strong="G3588,G2424"\w* \w e|strong="G2532"\w* \w diziam|strong="G3004"\w* \w uns com os outros|strong="G3326,G240"\w*, \w no templo|strong="G1722,G3588,G2411"\w* \w estando de pé|strong="G2476"\w*: “\w O que|strong="G5101"\w* \w lhes parece|strong="G1380,G4771"\w*? \w Que|strong="G3754"\w* \w de modo algum|strong="G3756,G3361"\w* \w virá|strong="G2064"\w* \w à festa|strong="G1519,G3588,G1859"\w*?”\x - \xo 11:56 \xt JHN 7:11; MRK 11:18; LUK 22:1; MRK 14:1\x*
\v 57 \w Tinham dado|strong="G1325"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w* \w ordens|strong="G1785"\w*: \w para que|strong="G2443"\w* \w se alguém|strong="G1437,G5100"\w* \w soubesse|strong="G1097"\w* \w onde|strong="G4226"\w* \w está|strong="G1510"\w*, \w informasse|strong="G3377"\w*, \w para que|strong="G3704"\w* \w o prendessem|strong="G4084,G846"\w*.\f + \fr 11.57: \ft Variante: o RP acrescenta “também” (καί) depois de “porém” e traz o singular ἐντολήν (“uma ordem”) em lugar de ἐντολάς (“ordens”).\f*\x - \xo 11:57 \xt PSA 94:20; JHN 12:10; MRK 11:18; JHN 11:47; LUK 22:1; MRK 10:2\x*
\c 12
\p
\v 1 \w Jesus|strong="G3588,G2424"\w*, \w então|strong="G3767"\w*, \w seis dias|strong="G1803,G2250"\w* \w antes|strong="G4253"\w* \w da Páscoa|strong="G3588,G3957"\w*, \w veio|strong="G2064"\w* \w a Betânia|strong="G1519,G963"\w*, \w onde|strong="G3699"\w* \w estava|strong="G1510"\w* \w Lázaro|strong="G2976"\w*, \w a quem|strong="G3739"\w* \w ressuscitou|strong="G1453"\w* \w dentre os mortos|strong="G1537,G3498"\w* \w Jesus|strong="G2424"\w*.\f + \fr 12.1: \ft Variante: Treg e o RP acrescentam “o que estava morto” (ὁ τεθνηκώς) depois de “Lázaro”; Treg traz o artigo diante do “Jesus” final e o RP omite essa palavra.\f*\x - \xo 12:1 \xt JHN 11:1; MRK 14:3; MAT 26:6; LUK 10:38; LUK 24:50; LUK 7:37\x*
\v 2 \w Fizeram-lhe|strong="G4160,G846"\w* \w então|strong="G3767"\w* \w um jantar|strong="G1173"\w* \w ali|strong="G1563"\w*, \w e|strong="G2532"\w* \w Marta|strong="G3588,G3136"\w* \w servia|strong="G1247"\w*, \w Lázaro|strong="G3588,G2976"\w* \w era|strong="G1510"\w* \w um|strong="G1520"\w* \w dos que estavam reclinados|strong="G1537,G3588,G345"\w* \w com ele|strong="G4862,G846"\w*.\f + \fr 12.2: \ft Lit.: Διακονέω, “servir” (aqui, à mesa); o mesmo radical aparece em διάκονος, “servo”, no v. 26.\f*\x - \xo 12:2 \xt LUK 22:27; JHN 12:9; MRK 14:3; MAT 26:6; LUK 10:38; MAT 26:7\x*
\v 3 \w Maria|strong="G3588,G3137"\w* \w então|strong="G3767"\w*, \w tomando|strong="G2983"\w* \w uma libra|strong="G3046"\w* \w de perfume|strong="G3464"\w* \w de nardo|strong="G3487"\w* \w puro|strong="G4101"\w* \w de grande valor|strong="G4186"\w*, \w ungiu|strong="G218"\w* \w os pés|strong="G3588,G4228"\w* \w de Jesus|strong="G3588,G2424"\w* \w e|strong="G2532"\w* \w enxugou|strong="G1591"\w* \w com os cabelos|strong="G3588,G2359"\w* \w dela|strong="G846"\w* \w os pés|strong="G3588,G4228"\w* \w dele|strong="G846"\w*; \w a casa|strong="G3588,G3614"\w* \w se encheu|strong="G4137"\w* \w do aroma|strong="G1537,G3588,G3744"\w* \w do perfume|strong="G3588,G3464"\w*.\f + \fr 12.3: \ft Nota cultural: uma libra romana (λίτρα) pesava cerca de 327 g.\f*\f + \fr 12.3: \ft Lit.: Πιστικός, “genuíno, puro” (sentido incerto; também em Mc 14:3).\f*\x - \xo 12:3 \xt MRK 14:3; JHN 11:2; LUK 7:46; LUK 10:38; MAT 26:6; LUK 7:37\x*
\v 4 \w Disse|strong="G3004"\w* \w Judas|strong="G2455"\w* \w o Iscariotes|strong="G3588,G2469"\w*, \w um|strong="G1520"\w* \w dos|strong="G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w*, \w aquele que estava para|strong="G3588,G3195"\w* \w entregá-lo|strong="G846,G3860"\w*:\f + \fr 12.4: \ft Variante: Treg e o RP trazem “então” (οὖν) em lugar de “porém” (δέ); NA28 traz εἷς ἐκ τῶν μαθητῶν αὐτοῦ (“um dentre os seus discípulos”); o RP traz “um dos seus discípulos, Judas, filho de Simão Iscariotes”.\f*\x - \xo 12:4 \xt MRK 3:19; MAT 10:4; JHN 6:71; MAT 26:14; JHN 13:2; LUK 6:16\x*
\v 5 “\w Por que|strong="G1223,G5101"\w* \w este|strong="G3778"\w* \w perfume|strong="G3588,G3464"\w* \w não|strong="G3756"\w* \w foi vendido|strong="G4097"\w* \w por trezentos|strong="G5145"\w* \w denários|strong="G1220"\w* \w e|strong="G2532"\w* \w dado|strong="G1325"\w* \w a pobres|strong="G4434"\w*?”\x - \xo 12:5 \xt MRK 14:5; MAT 26:9; MRK 14:3; MAT 26:6; MAT 26:8; LUK 12:33\x*
\v 6 \w Disse|strong="G2036"\w* \w isto|strong="G3778"\w*, \w não porque|strong="G3756,G3754"\w* \w lhe importavam|strong="G3199,G846"\w* \w os pobres|strong="G4012,G3588,G4434"\w*, \w mas|strong="G235"\w* \w porque|strong="G3754"\w* \w ladrão|strong="G2812"\w* \w era|strong="G1510"\w* \w e|strong="G2532"\w*, \w tendo|strong="G2192"\w* \w a caixa|strong="G3588,G1101"\w*, \w levava|strong="G941"\w* \w o que nela era posto|strong="G3588,G906"\w*.\f + \fr 12.6: \ft Lit.: Ἐβάσταζεν, “carregava, levava”; o verbo também pode significar “levar embora, furtar”, sentido que o contexto (“ladrão”) favorece.\f*\f + \fr 12.6: \ft Variante: o RP traz εἶχεν (“tinha”) e acrescenta “e” (καί) em lugar do particípio ἔχων (“tendo”).\f*\x - \xo 12:6 \xt JHN 13:29; JHN 10:10; MRK 14:3; MAT 26:6; MAT 26:8; PSA 50:16-20\x*
\v 7 \w Disse|strong="G2036"\w* \w então|strong="G3767"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Deixe-a|strong="G863,G846"\w*, \w para que|strong="G2443"\w* \w o guarde|strong="G5083,G846"\w* \w para o dia|strong="G1519,G3588,G2250"\w* \w do meu|strong="G3588,G3165"\w* \w sepultamento|strong="G1780"\w*.\f + \fr 12.7: \ft Lit.: Ἐνταφιασμός, “preparação do corpo para o sepultamento”.\f*\f + \fr 12.7: \ft Variante: o RP omite “para que” (ἵνα) e traz o perfeito τετήρηκεν (“guardou”): “Deixe-a: ela o guardou para o dia do meu sepultamento”.\f*\x - \xo 12:7 \xt MRK 14:3; MAT 26:6; MRK 14:8; MAT 26:12; LUK 7:37; MRK 14:6\x*
\v 8 \w Pois|strong="G1063"\w* \w os pobres|strong="G3588,G4434"\w* \w sempre|strong="G3842"\w* \w têm|strong="G2192"\w* \w com vocês|strong="G3326,G1438"\w*, \w a mim|strong="G1473"\w*, \w porém|strong="G1161"\w*, \w não|strong="G3756"\w* \w sempre|strong="G3842"\w* \w têm|strong="G2192"\w*.”\x - \xo 12:8 \xt MAT 26:11; MRK 14:7; DEU 15:11; MRK 14:3; MAT 26:6; JHN 12:35\x*
\v 9 \w Soube|strong="G1097"\w* \w então|strong="G3767"\w* \w uma grande|strong="G4183"\w* \w multidão|strong="G3793"\w* \w dos judeus|strong="G1537,G3588,G2453"\w* \w que|strong="G3754"\w* \w ali|strong="G1563"\w* \w estava|strong="G1510"\w*, \w e|strong="G2532"\w* \w vieram|strong="G2064"\w* \w não|strong="G3756"\w* \w por causa de|strong="G1223"\w* \w Jesus|strong="G3588,G2424"\w* \w somente|strong="G3441"\w*, \w mas|strong="G235"\w* \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w Lázaro|strong="G3588,G2976"\w* \w vissem|strong="G1492"\w*, \w a quem|strong="G3739"\w* \w ressuscitou|strong="G1453"\w* \w dentre os mortos|strong="G1537,G3498"\w*.\x - \xo 12:9 \xt JHN 12:17; JHN 12:2; JHN 11:1; ACT 4:14\x*
\v 10 \w Resolveram|strong="G1011"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w Lázaro|strong="G3588,G2976"\w* \w matassem|strong="G615"\w*,\x - \xo 12:10 \xt JHN 11:53; LUK 16:31; GEN 4:4-10; JHN 11:47-53; MAT 2:16; DAN 5:21-23\x*
\v 11 \w porque|strong="G3754"\w* \w muitos|strong="G4183"\w* \w dos judeus|strong="G3588,G2453"\w* \w por causa dele|strong="G1223,G846"\w* \w se afastavam|strong="G5217"\w* \w e|strong="G2532"\w* \w criam|strong="G4100"\w* \w em Jesus|strong="G1519,G3588,G2424"\w*.\x - \xo 12:11 \xt JHN 11:45; JHN 12:18; ACT 13:45; JAS 3:14-16; JHN 12:42; LUK 16:31\x*
\p
\v 12 \w No dia seguinte|strong="G3588,G1887"\w*, \w a grande multidão|strong="G3588,G3793,G4183"\w* \w que tinha vindo|strong="G3588,G2064"\w* \w à festa|strong="G1519,G3588,G1859"\w*, \w tendo ouvido|strong="G191"\w* \w que|strong="G3754"\w* \w Jesus|strong="G3588,G2424"\w* \w vinha|strong="G2064"\w* \w a Jerusalém|strong="G1519,G2414"\w*,\x - \xo 12:12 \xt JHN 5:1; MRK 11:7; LUK 19:35-38; MAT 21:4-9; LUK 19:37\x*
\v 13 \w pegaram|strong="G2983"\w* \w os ramos|strong="G3588,G902"\w* \w de palmeiras|strong="G3588,G5404"\w* \w e|strong="G2532"\w* \w saíram|strong="G1831"\w* \w ao encontro|strong="G1519,G5222"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w gritavam|strong="G2905"\w*: “\w Hosana|strong="G5614"\w*! \w Bendito|strong="G2127"\w* \w o que vem|strong="G3588,G2064"\w* \w em nome|strong="G1722,G3686"\w* \w do Senhor|strong="G2962"\w*, \w e|strong="G2532"\w* \w o rei|strong="G3588,G935"\w* \w de Israel|strong="G3588,G2474"\w*!”\f + \fr 12.13: \ft Nota cultural: Sl 118:25-26 (117:25-26 na LXX); “Hosana” transcreve o hebraico “salva, por favor”.\f*\f + \fr 12.13: \ft Variante: o RP omite “e o” (καὶ ὁ) antes de “rei”, de modo que “o rei de Israel” fica em aposição a “o que vem”.\f*\x - \xo 12:13 \xt PSA 118:25-26; MAT 21:9; MRK 11:9; ZEC 9:9; REV 7:9; PSA 118:26\x*
\v 14 \w Tendo encontrado|strong="G2147"\w* \w Jesus|strong="G3588,G2424"\w* \w um jumentinho|strong="G3678"\w*, \w sentou-se|strong="G2523"\w* \w sobre ele|strong="G1909,G846"\w*, \w como|strong="G2531"\w* \w está escrito|strong="G1510,G1125"\w*:\f + \fr 12.14: \ft Lit.: Ὀνάριον, “jumentinho” (diminutivo de ὄνος, “jumento”).\f*\x - \xo 12:14 \xt ZEC 9:9; MAT 21:9; JHN 1:49; MRK 11:1; MAT 21:1-7; LUK 19:29\x*
\v 15 “\w Não tenha medo|strong="G3361,G5399"\w*, \w filha|strong="G2364"\w* \w de Sião|strong="G4622"\w*; \w olhe|strong="G2400"\w*, \w o seu|strong="G3588,G4771"\w* \w rei|strong="G935"\w* \w vem|strong="G2064"\w*, \w sentado|strong="G2521"\w* \w sobre um potro|strong="G1909,G4454"\w* \w de jumento|strong="G3688"\w*.”\f + \fr 12.15: \ft Nota cultural: citação de Zc 9:9 (com eco de Is 62:11).\f*\x - \xo 12:15 \xt ZEC 9:9; ISA 62:11; MAT 21:5; ISA 1:8; MAT 21:9; MAT 21:4\x*
\v 16 \w Estas coisas|strong="G3778"\w* \w não|strong="G3756"\w* \w entenderam|strong="G1097"\w* \w os|strong="G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w* \w no início|strong="G3588,G4413"\w*, \w mas|strong="G235"\w* \w quando|strong="G3753"\w* \w foi glorificado|strong="G1392"\w* \w Jesus|strong="G2424"\w*, \w então|strong="G5119"\w* \w se lembraram|strong="G3403"\w* \w que|strong="G3754"\w* \w estas coisas|strong="G3778"\w* \w estavam escritas|strong="G1510,G1125"\w* \w a respeito dele|strong="G1909,G846"\w* \w e|strong="G2532"\w* \w que estas coisas|strong="G3778"\w* \w fizeram|strong="G4160"\w* \w a ele|strong="G846"\w*.\x - \xo 12:16 \xt JHN 2:22; ZEC 9:9; JHN 13:7; JHN 14:26; MRK 11:1; JHN 7:39\x*
\v 17 \w Dava testemunho|strong="G3140"\w* \w então|strong="G3767"\w* \w a multidão|strong="G3588,G3793"\w* \w que estava|strong="G3588,G1510"\w* \w com ele|strong="G3326,G846"\w* \w quando|strong="G3753"\w* \w a Lázaro|strong="G3588,G2976"\w* \w chamou|strong="G5455"\w* \w do túmulo|strong="G1537,G3588,G3419"\w* \w e|strong="G2532"\w* \w o ressuscitou|strong="G1453,G846"\w* \w dentre os mortos|strong="G1537,G3498"\w*.\x - \xo 12:17 \xt JHN 12:9; JHN 11:1; MRK 11:1; REV 1:2; 1JN 5:9-12; ACT 2:22\x*
\v 18 \w Por isso|strong="G1223,G3778"\w* \w também|strong="G2532"\w* \w foi ao encontro|strong="G5221"\w* \w dele|strong="G846"\w* \w a multidão|strong="G3588,G3793"\w*, \w porque|strong="G3754"\w* \w ouviram|strong="G191"\w* \add que\add* \w ele|strong="G846"\w* \w tinha feito|strong="G4160"\w* \w este sinal|strong="G3778,G3588,G4592"\w*.\f + \fr 12.18: \ft Acréscimo: “que” (em “porque ouviram que ele tinha”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 12:18 \xt JHN 12:11; MRK 11:1; ACT 4:16; LUK 12:49; MAT 21:10\x*
\v 19 \w Os fariseus|strong="G3588,G5330"\w* \w então|strong="G3767"\w* \w disseram|strong="G2036"\w* \w entre si|strong="G4314,G1438"\w*: “\w Vocês veem|strong="G2334"\w* \w que|strong="G3754"\w* \w não conseguem|strong="G3756,G5623"\w* \w nada|strong="G3762"\w*; \w veja|strong="G2396"\w*, \w o mundo|strong="G3588,G2889"\w* \w foi embora|strong="G565"\w* \w atrás dele|strong="G3694,G846"\w*.”\f + \fr 12.19: \ft Variante: a NIV acrescenta “todo” (ὅλος) depois de “mundo”.\f*\x - \xo 12:19 \xt GAL 5:2; MRK 11:1; ACT 17:6; MAT 20:16; ACT 4:16-17; JHN 3:26\x*
