\v 31 \w Se|strong="G1437"\w* \w eu|strong="G1473"\w* \w dou testemunho|strong="G3140"\w* \w a respeito de mim mesmo|strong="G4012,G1473"\w*, \w o meu|strong="G3588,G3165"\w* \w testemunho|strong="G3141"\w* \w não|strong="G3756"\w* \w é|strong="G1510"\w* \w verdadeiro|strong="G227"\w*;\x - \xo 5:31 \xt JHN 8:13; JHN 21:24; 1JN 5:9; JHN 3:11; JHN 19:35; 3JN 1:12\x*
\v 32 \w outro|strong="G243"\w* \w é|strong="G1510"\w* \w o que dá testemunho|strong="G3588,G3140"\w* \w a meu respeito|strong="G4012,G1473"\w*, \w e|strong="G2532"\w* \w sei|strong="G6063"\w* \w que|strong="G3754"\w* \w verdadeiro|strong="G227"\w* \w é|strong="G1510"\w* \w o testemunho|strong="G3588,G3141"\w* \w que dá|strong="G3739,G3140"\w* \w a meu respeito|strong="G4012,G1473"\w*.\x - \xo 5:32 \xt JHN 8:13; JHN 21:24; 1JN 5:9; JHN 8:17; JHN 3:11; JHN 19:35\x*
\v 33 \w Vocês|strong="G4771"\w* \w enviaram|strong="G649"\w* \w a João|strong="G4314,G2491"\w*, \w e|strong="G2532"\w* \add ele\add* \w deu testemunho|strong="G3140"\w* \w da verdade|strong="G3588,G225"\w*;\f + \fr 5.33: \ft Acréscimo: “ele” (em “João e ele deu testemunho”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 5:33 \xt JHN 1:6; JHN 1:15; JHN 3:28; JHN 5:36; JHN 1:7; JHN 1:19\x*
\v 34 \w eu|strong="G1473"\w*, \w porém|strong="G1161"\w*, \w não|strong="G3756"\w* \w de um ser humano|strong="G3844,G444"\w* \w recebo|strong="G2983"\w* \w o testemunho|strong="G3588,G3141"\w*, \w mas|strong="G235"\w* \w digo|strong="G3004"\w* \w estas coisas|strong="G3778"\w* \w para que|strong="G2443"\w* \w vocês|strong="G4771"\w* \w sejam salvos|strong="G4982"\w*.\x - \xo 5:34 \xt JHN 1:7; ROM 10:1; JHN 1:15; 2TI 2:25; JHN 1:19; JHN 3:11\x*
\v 35 \w Aquele|strong="G1565"\w* \w era|strong="G1510"\w* \w a lâmpada|strong="G3588,G3088"\w* \w que ardia|strong="G3588,G2545"\w* \w e|strong="G2532"\w* \w brilhava|strong="G5316"\w*; \w vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w quiseram|strong="G2309"\w* \w alegrar-se|strong="G21"\w* \w por uma hora|strong="G4314,G5610"\w* \w na luz|strong="G1722,G3588,G5457"\w* \w dele|strong="G846"\w*;\x - \xo 5:35 \xt MAT 5:14; JHN 1:7; DAN 12:3; 2PE 1:19; JHN 1:15; MAT 13:20\x*
