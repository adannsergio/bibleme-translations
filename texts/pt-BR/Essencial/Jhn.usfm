\p
\v 1 “\w Estas coisas|strong="G3778"\w* \w lhes falei|strong="G2980,G4771"\w*, \w para que|strong="G2443"\w* \w não tropecem|strong="G3361,G4624"\w*.\x - \xo 16:1 \xt 1PE 2:8; MAT 13:21; MAT 26:31-33; MAT 10:27; JHN 15:18-27; MAT 24:10\x*
\v 2 \w Expulsarão vocês da sinagoga|strong="G656,G4160,G4771"\w*; \w mas|strong="G235"\w* \w vem|strong="G2064"\w* \w hora|strong="G5610"\w* \w em que|strong="G2443"\w* \w todo|strong="G3956"\w* \w aquele que matar|strong="G3588,G615"\w* \w vocês|strong="G4771"\w* \w pensará|strong="G1380"\w* \w que oferece culto|strong="G2999,G4374"\w* \w a Deus|strong="G3588,G2316"\w*.\x - \xo 16:2 \xt MAT 24:9; JHN 9:22; ACT 26:9; REV 6:9; MAT 7:14; 2TI 3:12\x*
\v 3 \w E|strong="G2532"\w* \w estas coisas|strong="G3778"\w* \w farão|strong="G4160"\w* \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w conheceram|strong="G1097"\w* \w o Pai|strong="G3588,G3962"\w* \w nem|strong="G3761"\w* \w a mim|strong="G1473"\w*.\x - \xo 16:3 \xt 1JN 3:6; JHN 8:19; 1JN 3:1; EPH 1:17; JHN 15:21; JER 4:22\x*
\v 4 \w Mas|strong="G235"\w* \w estas coisas|strong="G3778"\w* \w lhes falei|strong="G2980,G4771"\w*, \w para que|strong="G2443"\w* \w quando|strong="G3752"\w* \w chegar|strong="G2064"\w* \w a hora|strong="G3588,G5610"\w* \w deles|strong="G846"\w*, \w se lembrem|strong="G3421"\w* \w delas|strong="G846"\w* \w que|strong="G3754"\w* \w eu|strong="G1473"\w* \w disse|strong="G2036"\w* \w a vocês|strong="G4771"\w*. \w Estas coisas|strong="G3778"\w* \w a vocês|strong="G4771"\w* \w desde o princípio|strong="G1537,G746"\w* \w não|strong="G3756"\w* \w disse|strong="G2036"\w*, \w porque|strong="G3754"\w* \w com vocês|strong="G3326,G4771"\w* \w estava|strong="G1510"\w*.\f + \fr 16.4: \ft Variante: o primeiro “deles” (αὐτῶν) falta na NIV e no RP; o segundo “delas” (αὐτῶν) falta na NIV.\f*\x - \xo 16:4 \xt JHN 14:29; JHN 14:2; MRK 13:23; JHN 13:19; JHN 17:12-13; JHN 16:1\x*
\v 5 \w Agora|strong="G3568"\w* \w vou|strong="G5217"\w* \w àquele que me enviou|strong="G4314,G3588,G3992,G3165"\w*, \w e|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w dentre vocês|strong="G1537,G4771"\w* \w me pergunta|strong="G2065,G3165"\w*: ‘\w Para onde|strong="G4226"\w* \w vai|strong="G5217"\w*?’\x - \xo 16:5 \xt JHN 13:36; JHN 7:33; LUK 16:27; JHN 14:29; JHN 16:17; JHN 12:8\x*
\v 6 \w mas|strong="G235"\w* \w porque|strong="G3754"\w* \w estas coisas|strong="G3778"\w* \w lhes falei|strong="G2980,G4771"\w*, \w a tristeza|strong="G3588,G3077"\w* \w encheu|strong="G4137"\w* \w o coração|strong="G3588,G2588"\w* \w de vocês|strong="G4771"\w*.\x - \xo 16:6 \xt JHN 16:22; 2CO 9:7; JHN 14:29; JHN 12:8; JHN 14:1; JHN 16:20\x*
\v 7 \w Mas|strong="G235"\w* \w eu|strong="G1473"\w* \w a verdade|strong="G3588,G225"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w convém|strong="G4851"\w* \w a vocês|strong="G4771"\w* \w que|strong="G2443"\w* \w eu|strong="G1473"\w* \add vá\add* \w embora|strong="G565"\w*. \w Pois|strong="G1063"\w* \w se|strong="G1437"\w* \w não|strong="G3361"\w* \add eu for\add* \w embora|strong="G565"\w*, \w o Paráclito|strong="G3588,G3875"\w* \w de modo algum|strong="G3756,G3361"\w* \w virá|strong="G2064"\w* \w a vocês|strong="G4314,G4771"\w*; \w se|strong="G1437"\w*, \w porém|strong="G1161"\w*, \w eu for|strong="G4198"\w*, \w o enviarei|strong="G3992,G846"\w* \w a vocês|strong="G4314,G4771"\w*.\f + \fr 16.7: \ft Variante: NA28 e o RP trazem οὐκ ἐλεύσεται (“não virá”) em lugar de οὐ μὴ ἔλθῃ (“de modo algum virá”); o RP acrescenta “eu” (ἐγώ) depois de “pois”.\f*\f + \fr 16.7: \ft Acréscimo: “vá” (em “que eu vá embora Pois”), “for” (em “não eu for embora o”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; “eu” (em “se não eu for embora”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 16:7 \xt JHN 14:26; JHN 15:26; JHN 14:16; ACT 2:33; ACT 1:4; JHN 7:39\x*
\v 8 \w E|strong="G2532"\w* \w tendo vindo|strong="G2064"\w* \w aquele|strong="G1565"\w*, \w convencerá|strong="G1651"\w* \w o mundo|strong="G3588,G2889"\w* \w a respeito de|strong="G4012"\w* \w pecado|strong="G266"\w* \w e|strong="G2532"\w* \w a respeito de|strong="G4012"\w* \w justiça|strong="G1343"\w* \w e|strong="G2532"\w* \w a respeito de|strong="G4012"\w* \w julgamento|strong="G2920"\w*;\f + \fr 16.8: \ft Lit.: Ἐλέγχω, “convencer, expor, repreender, pôr à luz”; aqui o Paráclito “convencerá” o mundo (cf. 3:20; 8:9, 46).\f*\x - \xo 16:8 \xt JHN 8:46; JUD 1:15; JHN 12:31; JHN 14:16; LUK 24:49; 1CO 2:14\x*
\v 9 \w a respeito de|strong="G4012"\w* \w pecado|strong="G266"\w* \w de fato|strong="G3303"\w*, \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w creem|strong="G4100"\w* \w em mim|strong="G1519,G1473"\w*;\x - \xo 16:9 \xt JHN 8:24; JHN 14:16; LUK 24:49; 1CO 2:14; ACT 1:4; JHN 12:31\x*
\v 10 \w a respeito de|strong="G4012"\w* \w justiça|strong="G1343"\w*, \w porém|strong="G1161"\w*, \w porque|strong="G3754"\w* \w ao Pai|strong="G4314,G3588,G3962"\w* \w vou|strong="G5217"\w* \w e|strong="G2532"\w* \w já não|strong="G2089,G3756"\w* \w me veem|strong="G2334,G3165"\w*;\f + \fr 16.10: \ft Variante: o RP acrescenta “meu” (μου) depois de “Pai”.\f*\x - \xo 16:10 \xt JHN 14:16; LUK 24:49; 1CO 2:14; ACT 1:4; JHN 12:31; 2CO 5:21\x*
\v 11 \w a respeito de|strong="G4012"\w* \w julgamento|strong="G2920"\w*, \w porém|strong="G1161"\w*, \w porque|strong="G3754"\w* \w o governante|strong="G3588,G758"\w* \w deste mundo|strong="G3588,G2889,G3778"\w* \w foi julgado|strong="G2919"\w*.\x - \xo 16:11 \xt JHN 12:31; JHN 14:30; JHN 5:22; JHN 14:16; EPH 6:12; LUK 10:18\x*
\v 12 \w Ainda|strong="G2089"\w* \w muitas coisas|strong="G4183"\w* \w tenho|strong="G2192"\w* \w a dizer|strong="G3004"\w* \w a vocês|strong="G4771"\w*, \w mas|strong="G235"\w* \w não|strong="G3756"\w* \w podem|strong="G1410"\w* \w suportar|strong="G941"\w* \w agora|strong="G737"\w*;\x - \xo 16:12 \xt JHN 14:16; 1CO 3:2; LUK 24:49; 1CO 2:14; ACT 1:4; MRK 4:33\x*
\v 13 \w Quando|strong="G3752"\w* \w vier|strong="G2064"\w* \w aquele|strong="G1565"\w*, \w o Espírito|strong="G3588,G4151"\w* \w da verdade|strong="G3588,G225"\w*, \w guiará|strong="G3594"\w* \w vocês|strong="G4771"\w* \w em toda|strong="G1722,G3956"\w* \w a verdade|strong="G3588,G225"\w*, \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w falará|strong="G2980"\w* \w por si mesmo|strong="G575,G1438"\w*, \w mas|strong="G235"\w* \w tudo o que|strong="G3745"\w* \w ouvir|strong="G191"\w* \w falará|strong="G2980"\w*, \w e|strong="G2532"\w* \w as coisas que vêm|strong="G3588,G2064"\w* \w anunciará|strong="G312"\w* \w a vocês|strong="G4771"\w*.\f + \fr 16.13: \ft Variante: WH e Treg trazem “para toda a verdade” (εἰς τὴν ἀλήθειαν πᾶσαν) e o RP, εἰς πᾶσαν τὴν ἀλήθειαν, em lugar de “em toda a verdade” (ἐν τῇ ἀληθείᾳ πάσῃ); WH traz o presente ἀκούει (“ouve”) e o RP ἂν ἀκούσῃ (“quando ouvir”).\f*\x - \xo 16:13 \xt JHN 14:26; 1CO 2:10; JHN 16:15; JHN 14:17; JHN 15:26; 1JN 2:27\x*
\v 14 \w Aquele|strong="G1565"\w* \w a mim|strong="G1473"\w* \w glorificará|strong="G1392"\w*, \w porque|strong="G3754"\w* \w do que é meu|strong="G1537,G3588,G1473"\w* \w receberá|strong="G2983"\w* \w e|strong="G2532"\w* \w anunciará|strong="G312"\w* \w a vocês|strong="G4771"\w*.\f + \fr 16.14: \ft Acréscimo: verbo ser/estar suprido em “do que é meu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 16:14 \xt JHN 14:16; 1CO 2:16; JHN 14:26; JHN 15:26; JHN 6:45; 1CO 2:12\x*
\v 15 \w Tudo|strong="G3956"\w* \w o que|strong="G3745"\w* \w o Pai|strong="G3588,G3962"\w* \w tem|strong="G2192"\w* \w é meu|strong="G1473,G1510"\w*; \w por isso|strong="G1223,G3778"\w* \w disse|strong="G2036"\w* \w que|strong="G3754"\w* \w do que é meu|strong="G1537,G3588,G1699"\w* \w recebe|strong="G2983"\w* \w e|strong="G2532"\w* \w anunciará|strong="G312"\w* \w a vocês|strong="G4771"\w*.\f + \fr 16.15: \ft Acréscimo: verbo ser/estar suprido em “do que é meu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 16:15 \xt JHN 16:13; ACT 14:27; ACT 15:4; JHN 14:16; 1CO 2:16; JHN 15:26\x*
\p
\v 16 \w Um pouco|strong="G3398"\w* \w e|strong="G2532"\w* \w já não|strong="G2089,G3756"\w* \w me veem|strong="G2334,G3165"\w*, \w e|strong="G2532"\w* \w de novo|strong="G3825"\w* \w um pouco|strong="G3398"\w* \w e|strong="G2532"\w* \w me verão|strong="G3700,G3165"\w*.”\f + \fr 16.16: \ft Lit.: Θεωρέω (“contemplar, ver”) e ὁράω (“ver”) alternam neste trecho (16:16-22); a diferença de sentido, se existe, é discutida.\f*\f + \fr 16.16: \ft Variante: o RP traz οὐ (“não”) em lugar de οὐκέτι (“já não”) e acrescenta, no fim, “porque vou ao Pai” (ὅτι ὑπάγω πρὸς τὸν πατέρα).\f*\x - \xo 16:16 \xt JHN 16:19; JHN 14:19; JHN 7:33; 1CO 2:16; LUK 24:49; JHN 12:35\x*
\v 17 \w Disseram|strong="G2036"\w* \w então|strong="G3767"\w* \w alguns dentre os|strong="G1537,G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w* \w uns aos outros|strong="G4314,G240"\w*: “\w O que|strong="G5101"\w* \w é|strong="G1510"\w* \w isto|strong="G3778"\w* \w que|strong="G3739"\w* \w nos diz|strong="G3004,G3165"\w*: ‘\w Um pouco|strong="G3398"\w* \w e|strong="G2532"\w* \w não me veem|strong="G3756,G2334,G3165"\w*, \w e|strong="G2532"\w* \w de novo|strong="G3825"\w* \w um pouco|strong="G3398"\w* \w e|strong="G2532"\w* \w me verão|strong="G3700,G3165"\w*’, \w e|strong="G2532"\w*: ‘\w Porque|strong="G3754"\w* \w vou|strong="G5217"\w* \w ao Pai|strong="G4314,G3588,G3962"\w*’?”\f + \fr 16.17: \ft Variante: o RP acrescenta “Eu” (Ἐγώ) antes de “vou”.\f*\x - \xo 16:17 \xt JHN 16:19; JHN 14:29; JHN 16:16; JHN 16:5; MRK 9:32; LUK 24:44\x*
\v 18 \w Diziam|strong="G3004"\w* \w então|strong="G3767"\w*: “\w O que|strong="G5101"\w* \w é|strong="G1510"\w* \w isto|strong="G3778"\w* \w que|strong="G3739"\w* \w diz|strong="G3004"\w* \w um pouco|strong="G3398"\w*? \w Não|strong="G3756"\w* \w sabemos|strong="G6063"\w* \w o que|strong="G5101"\w* \w fala|strong="G2980"\w*.”\x - \xo 16:18 \xt JHN 14:29; MRK 9:10; LUK 18:34; LUK 24:25; HEB 5:12; JHN 13:33\x*
\v 19 \w Soube|strong="G1097"\w* \w Jesus|strong="G2424"\w* \w que|strong="G3754"\w* \w queriam|strong="G2309"\w* \w perguntar-lhe|strong="G846,G2065"\w*, \w e|strong="G2532"\w* \w disse-lhes|strong="G2036,G846"\w*: “\w A respeito disto|strong="G4012,G3778"\w* \w discutem|strong="G2212"\w* \w uns com os outros|strong="G3326,G240"\w*, \w de eu ter dito|strong="G3754,G2036"\w*: ‘\w Um pouco|strong="G3398"\w* \w e|strong="G2532"\w* \w não me veem|strong="G3756,G2334,G3165"\w*, \w e|strong="G2532"\w* \w de novo|strong="G3825"\w* \w um pouco|strong="G3398"\w* \w e|strong="G2532"\w* \w me verão|strong="G3700,G3165"\w*\f + \fr 16.19: \ft Variante: NA28 acrescenta o artigo ὁ diante de “Jesus”; o RP traz “então” (οὖν) e o artigo.\f*’?\f + \fr 16.19: \ft Tradução: ζητεῖτε (ζητέω, G2212) está aqui como “discutem”; o termo pode ser “procurar”, “buscar”, “tentar” ou “exigir”, e o contexto decide.\f*\x - \xo 16:19 \xt JHN 16:17; JHN 16:16; JHN 14:29; MRK 9:32; MRK 9:10; MAT 9:4\x*
\v 20 \w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w chorarão|strong="G2799"\w* \w e|strong="G2532"\w* \w lamentarão|strong="G2354"\w* \w vocês|strong="G4771"\w*, \w o mundo|strong="G3588,G2889"\w* \w se alegrará|strong="G5463"\w*; \w vocês|strong="G4771"\w* \w ficarão tristes|strong="G3076"\w*, \w mas|strong="G235"\w* \w a tristeza|strong="G3588,G3077"\w* \w de vocês|strong="G4771"\w* \w se tornará|strong="G1096"\w* \w em alegria|strong="G1519,G5479"\w*\f + \fr 16.20: \ft Variante: o RP acrescenta “porém” (δέ) depois de “vocês”.\f*.\x - \xo 16:20 \xt MAT 5:4; PSA 30:5; ISA 61:3; PSA 126:5; JAS 1:2; ECC 3:4\x*
\v 21 \w A mulher|strong="G3588,G1135"\w*, \w quando|strong="G3752"\w* \w dá à luz|strong="G5088"\w*, \w tem|strong="G2192"\w* \w dor|strong="G3077"\w*, \w porque|strong="G3754"\w* \w chegou|strong="G2064"\w* \w a sua|strong="G3588,G846"\w* \w hora|strong="G5610"\w*; \w quando|strong="G3752"\w* \w tiver dado à luz|strong="G1080"\w* \w a criança|strong="G3588,G3813"\w*, \w já não|strong="G2089,G3756"\w* \w se lembra|strong="G3421"\w* \w da aflição|strong="G3588,G2347"\w* \w por causa|strong="G1223"\w* \w da alegria|strong="G3588,G5479"\w*, \w de que|strong="G3754"\w* \w nasceu|strong="G1080"\w* \w um ser humano|strong="G444"\w* \w no mundo|strong="G1519,G3588,G2889"\w*.\f + \fr 16.21: \ft Lit.: Λύπη, “tristeza, dor” (traduzida por “tristeza” nos vv. 6, 20 e 22 e por “dor” aqui, no contexto do parto); θλῖψις, “aflição, pressão, tribulação” (também em 16:33).\f*\x - \xo 16:21 \xt MAT 5:4; PSA 30:5; PSA 126:5; GEN 3:16; ECC 3:4; GEN 21:6\x*
\v 22 \w E|strong="G2532"\w* \w também vocês|strong="G4771"\w* \w portanto|strong="G3767"\w* \w agora|strong="G3568"\w* \w de fato|strong="G3303"\w* \w têm|strong="G2192"\w* \w tristeza|strong="G3077"\w*; \w de novo|strong="G3825"\w*, \w porém|strong="G1161"\w*, \w os verei|strong="G3708,G4771"\w*, \w e|strong="G2532"\w* \w se alegrará|strong="G5463"\w* \w o coração|strong="G3588,G2588"\w* \w de vocês|strong="G4771"\w*, \w e|strong="G2532"\w* \w a alegria|strong="G3588,G5479"\w* \w de vocês|strong="G4771"\w* \w ninguém|strong="G3762"\w* \w tira|strong="G142"\w* \w de vocês|strong="G575,G4771"\w*.\f + \fr 16.22: \ft Variante: WH e Treg trazem o futuro ἀρεῖ (“tirará”) em lugar do presente αἴρει (“tira”).\f*\x - \xo 16:22 \xt JHN 14:1; JHN 16:6; PHP 2:28; JHN 17:13; 2CO 2:3; MAT 5:4\x*
\v 23 \w E|strong="G2532"\w* \w naquele dia|strong="G1722,G1565,G3588,G2250"\w* \w a mim|strong="G1473"\w* \w não|strong="G3756"\w* \w perguntarão|strong="G2065"\w* \w nada|strong="G3762"\w*. \w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w se algo|strong="G302,G5100"\w* \w pedirem|strong="G154"\w* \w ao Pai|strong="G3588,G3962"\w*, \w lhes dará|strong="G1325,G4771"\w* \w em meu nome|strong="G1722,G3588,G3686,G3165"\w*.\f + \fr 16.23: \ft Lit.: Ἐρωτάω, “perguntar” ou “pedir”; em 16:23-26 alterna com αἰτέω, “pedir (como solicitação)”.\f*\f + \fr 16.23: \ft Variante: o RP traz “tudo o que” (ὅτι ὅσα ἄν) em lugar de “se algo” (ἄν τι) e, com NA28, coloca “em meu nome” antes de “dará”.\f*\x - \xo 16:23 \xt JHN 14:13; JHN 16:26; LUK 11:9; MRK 11:24; JHN 14:1; MAT 21:22\x*
\v 24 \w Até agora|strong="G2193,G737"\w* \w não|strong="G3756"\w* \w pediram|strong="G154"\w* \w nada|strong="G3762"\w* \w em meu nome|strong="G1722,G3588,G3686,G3165"\w*; \w peçam|strong="G154"\w* \w e|strong="G2532"\w* \w receberão|strong="G2983"\w*, \w para que|strong="G2443"\w* \w a alegria|strong="G3588,G5479"\w* \w de vocês|strong="G4771"\w* \w esteja|strong="G1510"\w* \w completa|strong="G4137"\w*.\x - \xo 16:24 \xt JHN 15:11; LUK 11:9; MRK 11:24; 1JN 1:4; MAT 7:7; JHN 17:13\x*
\p
\v 25 \w Estas coisas|strong="G3778"\w* \w em comparações|strong="G1722,G3942"\w* \w lhes falei|strong="G2980,G4771"\w*; \w vem|strong="G2064"\w* \w hora|strong="G5610"\w* \w em que|strong="G3753"\w* \w já não|strong="G2089,G3756"\w* \w em comparações|strong="G1722,G3942"\w* \w falarei|strong="G2980"\w* \w a vocês|strong="G4771"\w*, \w mas|strong="G235"\w* \w abertamente|strong="G3954"\w* \w a respeito do|strong="G4012,G3588"\w* \w Pai|strong="G3962"\w* \w anunciarei|strong="G518"\w* \w a vocês|strong="G4771"\w*.\f + \fr 16.25: \ft Variante: o RP acrescenta “mas” (ἀλλ’) antes de “vem” e traz ἀναγγελῶ em lugar de ἀπαγγελῶ (“anunciarei”).\f*\x - \xo 16:25 \xt MRK 11:24; JHN 16:29; MAT 6:8; JHN 16:12; EPH 5:20; JHN 14:29\x*
