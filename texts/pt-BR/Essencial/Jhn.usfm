\v 27 \w pois|strong="G1063"\w* \w o próprio|strong="G846"\w* \w Pai|strong="G3588,G3962"\w* \w ama|strong="G5368"\w* \w vocês|strong="G4771"\w*, \w porque|strong="G3754"\w* \w vocês|strong="G4771"\w* \w a mim|strong="G1473"\w* \w têm amado|strong="G5368"\w* \w e|strong="G2532"\w* \w têm crido|strong="G4100"\w* \w que|strong="G3754"\w* \w eu|strong="G1473"\w* \w da parte|strong="G3844"\w* \w de Deus|strong="G3588,G2316"\w* \w saí|strong="G1831"\w*.\f + \fr 16.27: \ft Variante: WH e Treg trazem “do Pai” (πατρός) em lugar de “de Deus” (θεοῦ).\f*\x - \xo 16:27 \xt MRK 11:24; JHN 17:8; JHN 16:30; PSA 91:14; JHN 14:21; MAT 6:8\x*
\v 28 \w Saí|strong="G1831"\w* \w do Pai|strong="G1537,G3588,G3962"\w* \w e|strong="G2532"\w* \w vim|strong="G2064"\w* \w ao mundo|strong="G1519,G3588,G2889"\w*; \w de novo|strong="G3825"\w* \w deixo|strong="G863"\w* \w o mundo|strong="G3588,G2889"\w* \w e|strong="G2532"\w* \w vou|strong="G4198"\w* \w ao Pai|strong="G4314,G3588,G3962"\w*.”\f + \fr 16.28: \ft Variante: NA28 e o RP trazem “da parte do Pai” (παρὰ τοῦ πατρός) em lugar de “do Pai” (ἐκ τοῦ πατρός).\f*\x - \xo 16:28 \xt JHN 1:1; JHN 8:42; JHN 20:17; JHN 13:1; JHN 3:13; JHN 3:31\x*
