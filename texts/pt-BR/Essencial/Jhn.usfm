\v 45 \w Não pensem|strong="G3361,G1380"\w* \w que|strong="G3754"\w* \w eu|strong="G1473"\w* \w acusarei|strong="G2723"\w* \w vocês|strong="G4771"\w* \w diante do Pai|strong="G4314,G3588,G3962"\w*; \w há quem|strong="G1510,G3588"\w* \w os acuse|strong="G2723,G4771"\w*: \w Moisés|strong="G3475"\w*, \w em quem|strong="G1519,G3739"\w* \w vocês|strong="G4771"\w* \w puseram a esperança|strong="G1679"\w*.\x - \xo 5:45 \xt JHN 1:45; JHN 3:17; LUK 24:27; JHN 12:48; JHN 1:17; GAL 3:10\x*
\v 46 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w* \w vocês cressem|strong="G4100"\w* \w em Moisés|strong="G3475"\w*, \w creriam|strong="G4100,G302"\w* \w em mim|strong="G1473"\w*, \w pois|strong="G1063"\w* \w a meu respeito|strong="G4012,G1473"\w* \w aquele|strong="G1565"\w* \w escreveu|strong="G1125"\w*.\x - \xo 5:46 \xt ACT 3:22; DEU 18:15; LUK 24:44; ROM 9:15; DEU 18:18-19; JHN 1:45\x*
\v 47 \w Mas|strong="G1161"\w* \w se|strong="G1487"\w* \w nos escritos|strong="G3588,G1121"\w* \w dele|strong="G1565"\w* \w não creem|strong="G3756,G4100"\w*, \w como|strong="G4459"\w* \w nas minhas|strong="G3588,G1473"\w* \w palavras|strong="G4487"\w* \w crerão|strong="G4100"\w*?”\x - \xo 5:47 \xt JHN 7:15; 2CH 20:20; JER 6:16; ISA 8:20; LUK 24:27; LUK 16:31\x*
\c 6
\p
\v 1 \w Depois destas coisas|strong="G3326,G3778"\w* \w foi|strong="G565"\w* \w Jesus|strong="G3588,G2424"\w* \w para o outro lado|strong="G4008"\w* \w do mar|strong="G3588,G2281"\w* \w da Galileia|strong="G3588,G1056"\w*, \w o de Tiberíades|strong="G3588,G5085"\w*.\f + \fr 6.1: \ft Nota cultural: o mar da Galileia também era chamado “de Tiberíades”, nome da cidade fundada por Herodes Antipas na margem ocidental (cf. 21:1).\f*\x - \xo 6:1 \xt JHN 21:1; MRK 6:31; JHN 6:23; LUK 5:1; MAT 14:13; MAT 4:18\x*
\v 2 \w Seguia-o|strong="G190,G846"\w* \w uma grande|strong="G4183"\w* \w multidão|strong="G3793"\w*, \w porque|strong="G3754"\w* \w viam|strong="G2334"\w* \w os sinais|strong="G3588,G4592"\w* \w que fazia|strong="G3739,G4160"\w* \w nos doentes|strong="G1909,G3588,G770"\w*.\x - \xo 6:2 \xt MAT 5:1; JHN 2:11; MAT 4:24-25; JHN 6:26; MRK 6:33; MAT 14:13\x*
\v 3 \w Jesus|strong="G2424"\w* \w subiu|strong="G424"\w* \w ao monte|strong="G1519,G3588,G3735"\w*, \w e|strong="G2532"\w* \w ali|strong="G1563"\w* \w estava sentado|strong="G2521"\w* \w com os|strong="G3326,G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w*.\x - \xo 6:3 \xt MAT 5:1; JHN 6:15; MAT 14:13; LUK 9:28; MAT 14:23\x*
\v 4 \w Estava perto|strong="G1510,G1451"\w* \w a Páscoa|strong="G3588,G3957"\w*, \w a festa|strong="G3588,G1859"\w* \w dos judeus|strong="G3588,G2453"\w*.\x - \xo 6:4 \xt JHN 2:13; JHN 7:2; JHN 11:55; JHN 5:1; LUK 22:1; MAT 26:18\x*
\v 5 \w Levantando|strong="G1869"\w* \w então|strong="G3767"\w* \w os olhos|strong="G3588,G3788"\w* \w e|strong="G2532"\w* \w vendo|strong="G2300"\w* \w que|strong="G3754"\w* \w uma grande|strong="G4183"\w* \w multidão|strong="G3793"\w* \w vinha|strong="G2064"\w* \w a ele|strong="G4314,G846"\w*, \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G3004"\w* \w a Filipe|strong="G4314,G5376"\w*: “\w De onde|strong="G4159"\w* \w vamos comprar|strong="G59"\w* \w pães|strong="G740"\w* \w para que|strong="G2443"\w* \w comam|strong="G5315"\w* \w estes|strong="G3778"\w*?”\x - \xo 6:5 \xt MRK 6:37; MAT 4:4; LUK 9:13; JHN 1:43; MRK 6:35; JHN 14:8\x*
\v 6 \w Isto|strong="G3778"\w* \w dizia|strong="G3004"\w* \w para testá-lo|strong="G3985,G846"\w*, \w pois|strong="G1063"\w* \w ele mesmo|strong="G846"\w* \w sabia|strong="G1492"\w* \w o que|strong="G5101"\w* \w ia|strong="G3195"\w* \w fazer|strong="G4160"\w*.\x - \xo 6:6 \xt MAT 4:4; GEN 22:1; 2CO 13:5; 2CH 32:31; DEU 13:3; LUK 9:13\x*
\v 7 \w Respondeu-lhe|strong="G611,G846"\w* \w Filipe|strong="G5376"\w*: “\w Duzentos|strong="G1250"\w* \w denários|strong="G1220"\w* \w de pães|strong="G740"\w* \w não bastam|strong="G3756,G714"\w* \w para eles|strong="G846"\w*, \w para que|strong="G2443"\w* \w cada um|strong="G1538"\w* \w receba|strong="G2983"\w* \w um pouco|strong="G1024,G5100"\w*.”\f + \fr 6.7: \ft Nota cultural: o denário era uma moeda romana de prata; segundo Mt 20:2, era o pagamento de um dia de trabalho, de modo que duzentos denários correspondem a cerca de duzentas diárias.\f*\x - \xo 6:7 \xt MAT 20:2; MRK 6:37; JHN 14:8; MAT 4:4; LUK 9:13; MRK 6:35\x*
\v 8 \w Disse-lhe|strong="G3004,G846"\w* \w um|strong="G1520"\w* \w dos|strong="G1537,G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w*, \w André|strong="G406"\w*, \w o irmão|strong="G3588,G80"\w* \w de Simão Pedro|strong="G4613,G4074"\w*:\x - \xo 6:8 \xt JHN 1:40; MAT 10:2; MAT 4:18; LUK 6:14; MRK 1:16; JHN 1:44\x*
\v 9 “\w Há|strong="G1510"\w* \w aqui|strong="G5602"\w* \w um menino|strong="G3808"\w* \w que tem|strong="G3739,G2192"\w* \w cinco|strong="G4002"\w* \w pães|strong="G740"\w* \w de cevada|strong="G2916"\w* \w e|strong="G2532"\w* \w dois|strong="G1417"\w* \w peixinhos|strong="G3795"\w*; \w mas|strong="G235"\w* \w o que|strong="G5101"\w* \w são|strong="G1510"\w* \w estes|strong="G3778"\w* \w para tantos|strong="G1519,G5118"\w*?”\f + \fr 6.9: \ft Lit.: Ὀψάριον, diminutivo: “peixinho”, o alimento que se comia com o pão.\f*\x - \xo 6:9 \xt MAT 14:17; MRK 6:38; MAT 4:4; 2KI 4:42; LUK 9:13; PSA 78:19\x*
\v 10 \w Disse|strong="G2036"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Mandem|strong="G4160"\w* \w as pessoas|strong="G3588,G444"\w* \w se acomodar|strong="G377"\w*.” \w Havia|strong="G1510"\w* \w muita|strong="G4183"\w* \w grama|strong="G5528"\w* \w no lugar|strong="G1722,G3588,G5117"\w*. \w Acomodaram-se|strong="G377"\w* \w então|strong="G3767"\w* \w os homens|strong="G3588,G435"\w*, \w em número|strong="G3588,G706"\w* \w de cerca de|strong="G5613"\w* \w cinco mil|strong="G4000"\w*.\f + \fr 6.10: \ft Lit.: Ἀναπίπτω, “reclinar-se, recostar-se”, como para uma refeição.\f*\f + \fr 6.10: \ft Lit.: Ἄνδρες, “homens” (adultos do sexo masculino), distinto de ἄνθρωποι, “pessoas”, usado no começo do versículo.\f*\x - \xo 6:10 \xt MAT 4:4; MRK 8:6; LUK 9:14-16; MRK 6:35; MAT 16:9; MAT 14:13\x*
\v 11 \w Tomou|strong="G2983"\w* \w então|strong="G3767"\w* \w os pães|strong="G3588,G740"\w* \w Jesus|strong="G3588,G2424"\w* \w e|strong="G2532"\w*, \w dando graças|strong="G2168"\w*, \w distribuiu|strong="G1239"\w* \w aos que estavam reclinados|strong="G3588,G345"\w*, \w do mesmo modo|strong="G3668"\w* \w também|strong="G2532"\w* \w dos peixinhos|strong="G1537,G3588,G3795"\w*, \w quanto|strong="G3745"\w* \w queriam|strong="G2309"\w*.\f + \fr 6.11: \ft Variante: o RP traz “porém” (δέ) em lugar de “então” (οὖν) e, depois de “distribuiu”, acrescenta “aos discípulos, e os discípulos”.\f*\x - \xo 6:11 \xt JHN 21:13; MAT 4:4; 1TH 5:18; JHN 6:23; MRK 8:6; MRK 6:35\x*
\v 12 \w Quando|strong="G5613"\w* \w ficaram saciados|strong="G1705"\w*, \w disse|strong="G3004"\w* \w aos|strong="G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w*: “\w Recolham|strong="G4863"\w* \w os pedaços|strong="G3588,G2801"\w* \w que sobraram|strong="G4052"\w*, \w para que|strong="G2443"\w* \w nada|strong="G3361,G5100"\w* \w se perca|strong="G622"\w*.”\x - \xo 6:12 \xt LUK 9:17; MAT 14:20; MAT 4:4; LUK 1:53; MRK 6:35; MAT 16:9\x*
\v 13 \w Recolheram|strong="G4863"\w* \w então|strong="G3767"\w*, \w e|strong="G2532"\w* \w encheram|strong="G1072"\w* \w doze|strong="G1427"\w* \w cestos|strong="G2894"\w* \w de pedaços|strong="G2801"\w* \w dos cinco|strong="G1537,G3588,G4002"\w* \w pães de cevada|strong="G740,G3588,G2916"\w* \w que sobraram|strong="G3739,G4052"\w* \w para os que tinham comido|strong="G3588,G977"\w*.\x - \xo 6:13 \xt LUK 9:17; MAT 14:20; MRK 8:19; MAT 16:9; MAT 4:4; DEU 8:8\x*
\v 14 \w As pessoas|strong="G3588,G444"\w* \w então|strong="G3767"\w*, \w vendo|strong="G1492"\w* \w o sinal que ele fez|strong="G3739,G4160,G4592"\w*, \w diziam|strong="G3004"\w*: “\w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w verdadeiramente|strong="G230"\w* \w o profeta|strong="G3588,G4396"\w* \w que vem|strong="G3588,G2064"\w* \w ao mundo|strong="G1519,G3588,G2889"\w*.”\f + \fr 6.14: \ft Nota cultural: “o profeta” remete à expectativa de um profeta como Moisés (Dt 18:15,18), já presente em Jo 1:21.\f*\f + \fr 6.14: \ft Variante: WH traz o plural ἃ ἐποίησεν σημεῖα (“os sinais que fez”); o RP acrescenta “Jesus” (ὁ Ἰησοῦς) logo antes de “diziam”.\f*\x - \xo 6:14 \xt DEU 18:15; JHN 1:21; JHN 7:40; JHN 4:42; MAT 4:4; MAT 21:11\x*
\v 15 \w Jesus|strong="G2424"\w* \w então|strong="G3767"\w*, \w sabendo|strong="G1097"\w* \w que|strong="G3754"\w* \w estavam para|strong="G3195"\w* \w vir|strong="G2064"\w* \w e|strong="G2532"\w* \w levá-lo à força|strong="G726,G846"\w*, \w para o fazerem|strong="G2443,G4160"\w* \w rei|strong="G935"\w*, \w retirou-se|strong="G402"\w* \w novamente|strong="G3825"\w* \w ao monte|strong="G1519,G3588,G3735"\w*, \w ele mesmo|strong="G846"\w* \w sozinho|strong="G3441"\w*.\f + \fr 6.15: \ft Variante: o RP traz “o” (αὐτόν) como objeto de “fazerem rei” e omite “novamente” (πάλιν).\f*\x - \xo 6:15 \xt MAT 4:4; MRK 1:35; JHN 18:36; MAT 14:22; JHN 7:3-4; MRK 6:45\x*
\p
\v 16 \w Quando|strong="G5613"\w* \w chegou a tarde|strong="G3798,G1096"\w*, \w desceram|strong="G2597"\w* \w os|strong="G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w* \w ao mar|strong="G1909,G3588,G2281"\w*,\x - \xo 6:16 \xt MRK 6:47; MAT 14:22; MRK 6:45; JHN 6:15; MAT 14:23\x*
\v 17 \w e|strong="G2532"\w* \w embarcando|strong="G1684"\w* \w num barco|strong="G1519,G4143"\w*, \w iam|strong="G2064"\w* \w para o outro lado|strong="G4008"\w* \w do mar|strong="G3588,G2281"\w* \w rumo a Cafarnaum|strong="G1519,G2584"\w*. \w E|strong="G2532"\w* \w já tinha escurecido|strong="G4653,G2235,G1096"\w*, \w e|strong="G2532"\w* \add ainda\add* \w não|strong="G3768"\w* \w tinha chegado|strong="G2064"\w* \w até eles|strong="G4314,G846"\w* \w Jesus|strong="G3588,G2424"\w*,\f + \fr 6.17: \ft Acréscimo: “ainda” (em “escurecido e ainda não tinha”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 6:17 \xt MAT 14:22; MRK 6:45; JHN 6:24; JHN 6:15; MAT 14:23; MRK 4:35\x*
\v 18 \w E|strong="G5037"\w* \w o mar|strong="G3588,G2281"\w*, \w soprando|strong="G4154"\w* \w um grande|strong="G3173"\w* \w vento|strong="G417"\w*, \w se agitava|strong="G1326"\w*.\x - \xo 6:18 \xt MAT 14:22; MRK 6:45; JHN 6:15; PSA 135:7; MAT 14:24; PSA 107:25\x*
\v 19 \w Tendo remado|strong="G1643"\w* \w então|strong="G3767"\w* \w cerca de|strong="G5613"\w* \w vinte e cinco|strong="G1501,G4002"\w* \w ou|strong="G2228"\w* \w trinta|strong="G5144"\w* \w estádios|strong="G4712"\w*, \w viram|strong="G2334"\w* \w Jesus|strong="G3588,G2424"\w* \w andando|strong="G4043"\w* \w sobre o mar|strong="G1909,G3588,G2281"\w* \w e|strong="G2532"\w* \w chegando perto|strong="G1451,G1096"\w* \w do barco|strong="G3588,G4143"\w*, \w e|strong="G2532"\w* \w ficaram com medo|strong="G5399"\w*.\f + \fr 6.19: \ft Nota cultural: um estádio mede cerca de 185 m; 25 ou 30 estádios são, portanto, aproximadamente 4,6 a 5,5 km.\f*\x - \xo 6:19 \xt MAT 14:22; MRK 6:47-49; MRK 6:50; MAT 14:25; MRK 4:40; MRK 6:45\x*
\v 20 \w Mas|strong="G1161"\w* \w ele|strong="G3588"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Eu sou|strong="G1473,G1510"\w*; \w não tenham medo|strong="G3361,G5399"\w*.”\f + \fr 6.20: \ft Lit.: Ἐγώ εἰμι, “eu sou” ou “sou eu”: aqui é identificação, mas em João a expressão também ecoa a fórmula de revelação divina (Ex 3:14 LXX; Is 43:10 LXX); cf. 4:26.\f*\x - \xo 6:20 \xt EXO 3:14; ISA 43:10; MAT 14:22; MAT 14:27; ISA 43:1-2; ISA 44:8\x*
\v 21 \w Queriam|strong="G2309"\w* \w então|strong="G3767"\w* \w recebê-lo|strong="G2983,G846"\w* \w no barco|strong="G1519,G3588,G4143"\w*, \w e|strong="G2532"\w* \w logo|strong="G2112"\w* \w chegou|strong="G1096"\w* \w o barco|strong="G3588,G4143"\w* \w à terra|strong="G1909,G3588,G1093"\w* \w para a qual|strong="G1519,G3739"\w* \w se dirigiam|strong="G5217"\w*.\x - \xo 6:21 \xt MAT 4:22; MRK 6:54; MAT 14:22; MRK 6:45; MRK 6:51; PSA 107:30\x*
\p
\v 22 \w No dia seguinte|strong="G3588,G1887"\w*, \w a multidão|strong="G3588,G3793"\w* \w que estava|strong="G3588,G2476"\w* \w do outro lado|strong="G4008"\w* \w do mar|strong="G3588,G2281"\w* \w viu|strong="G1492"\w* \w que|strong="G3754"\w* \w não havia|strong="G3756,G1510"\w* \w ali|strong="G1563"\w* \w outro|strong="G243"\w* \w barquinho|strong="G4142"\w* \w senão um|strong="G1487,G3361,G1520"\w*, \w e|strong="G2532"\w* \w que|strong="G3754"\w* \w Jesus|strong="G3588,G2424"\w* \w não|strong="G3756"\w* \w tinha entrado|strong="G4897"\w* \w com os|strong="G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w* \w no barco|strong="G1519,G3588,G4143"\w*, \w mas|strong="G235"\w* \w somente os|strong="G3441,G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w* \w haviam partido|strong="G565"\w*;\f + \fr 6.22: \ft Variante: depois de “senão um”, o RP acrescenta “aquele em que entraram os discípulos dele”; o RP traz ainda o particípio “vendo” (ἰδών) em lugar de “viu” (εἶδον) e “barquinho” (πλοιάριον) em lugar de “barco” (πλοῖον) na segunda ocorrência.\f*\x - \xo 6:22 \xt MRK 6:45; MRK 5:21; MAT 8:18\x*
\v 23 \w Mas|strong="G235"\w* \w vieram|strong="G2064"\w* \w barquinhos|strong="G4142"\w* \w de Tiberíades|strong="G1537,G5085"\w* \w perto do lugar|strong="G1451,G3588,G5117"\w* \w onde comeram|strong="G3699,G5315"\w* \w o pão|strong="G3588,G740"\w*, \w tendo dado graças|strong="G2168"\w* \w o Senhor|strong="G3588,G2962"\w*.\f + \fr 6.23: \ft Variante: o SBLGNT, WH e Treg trazem ἀλλά (“mas”); NA28 traz ἄλλα (“outros”) e o RP, ἄλλα δέ (“e outros”). WH traz πλοῖα (“barcos”) em lugar de πλοιάρια (“barquinhos”).\f*\x - \xo 6:23 \xt JHN 6:1; JHN 6:11; DEU 8:10; LUK 22:19; LUK 9:16; MRK 6:41\x*
\v 24 \w Quando|strong="G3753"\w* \w então|strong="G3767"\w* \w a multidão|strong="G3588,G3793"\w* \w viu|strong="G1492"\w* \w que|strong="G3754"\w* \w Jesus|strong="G2424"\w* \w não|strong="G3756"\w* \w estava|strong="G1510"\w* \w ali|strong="G1563"\w*, \w nem|strong="G3761"\w* \w os|strong="G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w*, \w embarcaram|strong="G1684"\w* \w eles mesmos|strong="G846"\w* \w nos barquinhos|strong="G1519,G3588,G4142"\w* \w e|strong="G2532"\w* \w foram|strong="G2064"\w* \w a Cafarnaum|strong="G1519,G2584"\w*, \w procurando|strong="G2212"\w* \w Jesus|strong="G3588,G2424"\w*.\x - \xo 6:24 \xt JHN 6:17; MRK 6:53; JHN 6:26; JHN 6:59; LUK 14:25; LUK 8:40\x*
\v 25 \w E|strong="G2532"\w*, \w tendo-o encontrado|strong="G2147,G846"\w* \w do outro lado|strong="G4008"\w* \w do mar|strong="G3588,G2281"\w*, \w disseram-lhe|strong="G2036,G846"\w*: “\w Rabi|strong="G4461"\w*, \w quando|strong="G4219"\w* \w chegou aqui|strong="G5602,G1096"\w*?”\x - \xo 6:25 \xt JHN 1:38; MRK 6:53; TIT 2:12; JHN 6:17; MAT 23:7; LUK 14:25\x*
\v 26 \w Respondeu-lhes|strong="G611,G846"\w* \w Jesus|strong="G3588,G2424"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w vocês me procuram|strong="G2212,G3165"\w*, \w não|strong="G3756"\w* \w porque|strong="G3754"\w* \w viram|strong="G1492"\w* \w sinais|strong="G4592"\w*, \w mas|strong="G235"\w* \w porque|strong="G3754"\w* \w comeram|strong="G5315"\w* \w dos pães|strong="G1537,G3588,G740"\w* \w e|strong="G2532"\w* \w se fartaram|strong="G5526"\w*.\x - \xo 6:26 \xt MRK 6:42; MRK 8:12; JAS 4:3-4; PHP 2:21; PHP 3:19; JHN 6:53\x*
\v 27 \w Não|strong="G3361"\w* \w trabalhem|strong="G2038"\w* \w pelo alimento|strong="G3588,G1035"\w* \w que perece|strong="G3588,G622"\w*, \w mas|strong="G235"\w* \w pelo alimento|strong="G3588,G1035"\w* \w que permanece|strong="G3588,G3306"\w* \w para a vida|strong="G1519,G2222"\w* \w eterna|strong="G166"\w*, \w o qual|strong="G3739"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w lhes dará|strong="G4771,G1325"\w*; \w pois|strong="G1063"\w* \w a este|strong="G3778"\w* \w o Pai|strong="G3588,G3962"\w*, \w Deus|strong="G3588,G2316"\w*, \w selou|strong="G4972"\w*.”\f + \fr 6.27: \ft Lit.: Σφραγίζω, “selar, marcar com selo”: autenticar ou atestar.\f*\x - \xo 6:27 \xt MAT 6:33; MAT 5:6; JHN 10:28; EPH 2:8; COL 3:2; ISA 55:2\x*
\v 28 \w Disseram|strong="G2036"\w* \w então|strong="G3767"\w* \w a ele|strong="G4314,G846"\w*: “\w O que|strong="G5101"\w* \w devemos fazer|strong="G4160"\w* \w para que|strong="G2443"\w* \w realizemos|strong="G2038"\w* \w as obras|strong="G3588,G2041"\w* \w de Deus|strong="G3588,G2316"\w*?”\x - \xo 6:28 \xt 1CO 15:58; JHN 3:21; 1CO 16:10; MRK 14:6; JHN 9:4; MAT 26:10\x*
\v 29 \w Respondeu|strong="G611"\w* \w Jesus|strong="G3588,G2424"\w* \w e|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Esta|strong="G3778"\w* \w é|strong="G1510"\w* \w a obra|strong="G3588,G2041"\w* \w de Deus|strong="G3588,G2316"\w*: \w que vocês creiam|strong="G2443,G4100"\w* \w naquele que|strong="G1519,G3739"\w* \w ele|strong="G1565"\w* \w enviou|strong="G649"\w*.”\f + \fr 6.29: \ft Variante: o RP traz o aoristo πιστεύσητε (“venham a crer”) em lugar do presente πιστεύητε (“creiam”, “continuem a crer”), e omite o artigo antes de “Jesus”.\f*\x - \xo 6:29 \xt JHN 10:37; JHN 14:11; JHN 9:36; 1CO 15:58; MRK 16:16; JHN 10:25\x*
\v 30 \w Disseram-lhe|strong="G2036,G846"\w* \w então|strong="G3767"\w*: “\w Que sinal|strong="G5101,G4592"\w* \w então|strong="G3767"\w* \w você faz|strong="G4160,G4771"\w*, \w para que|strong="G2443"\w* \w vejamos|strong="G1492"\w* \w e|strong="G2532"\w* \w creiamos|strong="G4100"\w* \w em você|strong="G4771"\w*? \w O que|strong="G5101"\w* \w você realiza|strong="G2038"\w*?\x - \xo 6:30 \xt JHN 12:37; JHN 2:11; JHN 4:48; JHN 20:25; EXO 16:35; EXO 7:9\x*
\v 31 \w Os nossos|strong="G3588,G3165"\w* \w pais|strong="G3962"\w* \w comeram|strong="G5315"\w* \w o maná|strong="G3588,G3131"\w* \w no deserto|strong="G1722,G3588,G2048"\w*, \w conforme|strong="G2531"\w* \w está escrito|strong="G1510,G1125"\w*: ‘\w Pão|strong="G740"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w lhes deu|strong="G1325,G846"\w* \w para comer|strong="G5315"\w*.’”\f + \fr 6.31: \ft Nota cultural: a citação ecoa Êx 16:4,15; Sl 78:24 (77:24 na LXX); Ne 9:15.\f*\x - \xo 6:31 \xt NEH 9:15; PSA 78:24; EXO 16:4; JHN 6:49; MAT 4:4; JHN 6:58\x*
\v 32 \w Disse|strong="G2036"\w* \w então|strong="G3767"\w* \w a eles|strong="G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w não|strong="G3756"\w* \w Moisés|strong="G3475"\w* \w lhes deu|strong="G1325,G4771"\w* \w o pão|strong="G3588,G740"\w* \w do céu|strong="G1537,G3588,G3772"\w*, \w mas|strong="G235"\w* \w o meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w* \w lhes dá|strong="G1325,G4771"\w* \w o pão|strong="G3588,G740"\w* \w do céu|strong="G1537,G3588,G3772"\w*, \w o verdadeiro|strong="G3588,G228"\w*.\f + \fr 6.32: \ft Variante: o SBLGNT, NA28 e o RP trazem o perfeito δέδωκεν (“tem dado”); WH e Treg trazem o aoristo ἔδωκεν (“deu”).\f*\x - \xo 6:32 \xt MAT 4:4; MAT 6:11; JHN 15:1; JHN 1:9; ROM 6:23; EXO 16:15\x*
\v 33 \w Pois|strong="G1063"\w* \w o pão|strong="G3588,G740"\w* \w de Deus|strong="G3588,G2316"\w* \w é|strong="G1510"\w* \w aquele que desce|strong="G3588,G2597"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w e|strong="G2532"\w* \w dá vida|strong="G2222,G1325"\w* \w ao mundo|strong="G3588,G2889"\w*.”\x - \xo 6:33 \xt JHN 6:51; JHN 6:48; JHN 10:10; MAT 4:4; JHN 6:50; JHN 6:41\x*
\v 34 \w Disseram|strong="G2036"\w* \w então|strong="G3767"\w* \w a ele|strong="G4314,G846"\w*: “\w Senhor|strong="G2962"\w*, \w sempre|strong="G3842"\w* \w dê-nos|strong="G1325,G3165"\w* \w este pão|strong="G3588,G740,G3778"\w*.”\x - \xo 6:34 \xt MAT 4:4; MAT 6:11; MAT 26:26; JHN 4:15; JHN 6:48; EXO 16:35\x*
\p
\v 35 \w Disse-lhes|strong="G2036,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Eu sou|strong="G1473,G1510"\w* \w o pão|strong="G3588,G740"\w* \w da vida|strong="G3588,G2222"\w*; \w aquele que vem|strong="G3588,G2064"\w* \w a mim|strong="G4314,G1473"\w* \w de modo algum|strong="G3756,G3361"\w* \w terá fome|strong="G3983"\w*, \w e|strong="G2532"\w* \w aquele que crê|strong="G3588,G4100"\w* \w em mim|strong="G1519,G1473"\w* \w de modo algum|strong="G3756,G3361"\w* \w terá sede|strong="G1372"\w* \w jamais|strong="G4455"\w*.\f + \fr 6.35: \ft Lit.: Ἐγώ εἰμι com predicado: a primeira das declarações “Eu sou” de João (6:35; 8:12; 10:7, 11; 11:25; 14:6; 15:1).\f*\f + \fr 6.35: \ft Variante: depois de “Disse”, a NIV acrescenta “então” (οὖν) e o RP, “e” (δέ); o RP traz με em lugar de ἐμέ e o subjuntivo διψήσῃ em lugar do futuro διψήσει.\f*\x - \xo 6:35 \xt JHN 6:48; MAT 4:4; REV 22:17; REV 7:16; JHN 4:14; MRK 16:16\x*
\v 36 \w Mas|strong="G235"\w* \w eu disse|strong="G2036"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w até|strong="G2532"\w* \w me viram|strong="G3708,G3165"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w creem|strong="G4100"\w*.\x - \xo 6:36 \xt JHN 11:40; MAT 4:4; JHN 20:29; 1PE 1:8; JHN 1:50; MAT 6:11\x*
\v 37 \w Tudo o que|strong="G3956,G3739"\w* \w me dá|strong="G1325,G3165"\w* \w o Pai|strong="G3588,G3962"\w* \w virá|strong="G2240"\w* \w a mim|strong="G4314,G1473"\w*, \w e|strong="G2532"\w* \w aquele que vem|strong="G3588,G2064"\w* \w a mim|strong="G4314,G1473"\w* \w de modo algum|strong="G3756,G3361"\w* \w lançarei para fora|strong="G1544,G1854"\w*,\x - \xo 6:37 \xt MAT 11:28; MAT 4:4; JHN 10:28; JHN 9:35; EPH 2:8; LUK 20:15\x*
\v 38 \w porque|strong="G3754"\w* \w desci|strong="G2597"\w* \w do céu|strong="G575,G3588,G3772"\w*, \w não|strong="G3756"\w* \w para fazer|strong="G2443,G4160"\w* \w a minha|strong="G3588,G1473"\w* \w vontade|strong="G2307"\w* \w mas|strong="G235"\w* \w a vontade|strong="G3588,G2307"\w* \w daquele que me enviou|strong="G3588,G3992,G3165"\w*.\x - \xo 6:38 \xt JHN 4:34; JHN 5:30; MAT 4:4; LUK 2:49; HEB 10:7; MAT 26:39\x*
\v 39 \w Esta|strong="G3778"\w* \w é|strong="G1510"\w* \w a vontade|strong="G3588,G2307"\w* \w daquele que me enviou|strong="G3588,G3992,G3165"\w*: \w que|strong="G2443"\w* \w de tudo o que|strong="G3956,G3739,G1537,G846"\w* \w me deu|strong="G1325,G3165"\w* \add eu\add* \w não perca|strong="G3361,G622"\w* \add nada,\add* \w mas|strong="G235"\w* \w o ressuscite|strong="G450,G846"\w* \w no último|strong="G3588,G2078"\w* \w dia|strong="G2250"\w*.\f + \fr 6.39: \ft Lit.: Πᾶν ὃ… ἐξ αὐτοῦ: o neutro singular “tudo o que” é coletivo e é retomado por αὐτό (“o”); literalmente, “que, de tudo o que me deu, eu não perca (nada) dele”.\f*\f + \fr 6.39: \ft Variante: o RP acrescenta “Pai” (πατρός) depois de “me enviou”; NA28 acrescenta ἐν antes de “o último dia”, sem mudança de sentido.\f*\f + \fr 6.39: \ft Acréscimo: “eu” (em “me deu eu não perca”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo; “nada” (em “não perca nada mas o”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 6:39 \xt JHN 6:44; MAT 4:4; JHN 10:28; MAT 18:14; JHN 11:25; JHN 6:37\x*
\v 40 \w Pois|strong="G1063"\w* \w esta|strong="G3778"\w* \w é|strong="G1510"\w* \w a vontade|strong="G3588,G2307"\w* \w do meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w*: \w que todo|strong="G2443,G3956"\w* \w aquele que contempla|strong="G3588,G2334"\w* \w o Filho|strong="G3588,G5207"\w* \w e|strong="G2532"\w* \w crê|strong="G4100"\w* \w nele|strong="G1519,G846"\w* \w tenha|strong="G2192"\w* \w vida eterna|strong="G2222,G166"\w*, \w e|strong="G2532"\w* \w eu|strong="G1473"\w* \w o ressuscitarei|strong="G450,G846"\w* \w no último|strong="G3588,G2078"\w* \w dia|strong="G2250"\w*.”\f + \fr 6.40: \ft Variante: o RP traz “porém” (δέ) em lugar de “pois” (γάρ) e “daquele que me enviou” (πέμψαντός με) em lugar de “do meu Pai”; NA28 acrescenta ἐν antes de “o último dia”, sem mudança de sentido.\f*\x - \xo 6:40 \xt JHN 3:16; JHN 3:15; JHN 5:24; MAT 4:4; JHN 6:44; JHN 6:54\x*
\p
\v 41 \w Murmuravam|strong="G1111"\w* \w então|strong="G3767"\w* \w os judeus|strong="G3588,G2453"\w* \w a respeito dele|strong="G4012,G846"\w*, \w porque|strong="G3754"\w* \w disse|strong="G2036"\w*: “\w Eu sou|strong="G1473,G1510"\w* \w o pão|strong="G3588,G740"\w* \w que desceu|strong="G3588,G2597"\w* \w do céu|strong="G1537,G3588,G3772"\w*”,\f + \fr 6.41: \ft Lit.: Ἰουδαῖοι: aqui designa quem murmura em Cafarnaum, na Galileia (cf. 6:59); ver a nota de 1:19 sobre o termo.\f*\x - \xo 6:41 \xt MAT 4:4; JHN 6:33; JHN 6:51; JHN 6:35; MAT 6:11; JHN 6:48\x*
\v 42 \w e|strong="G2532"\w* \w diziam|strong="G3004"\w*: “\w Não|strong="G3756"\w* \w é|strong="G1510"\w* \w este|strong="G3778"\w* \w Jesus|strong="G2424"\w*, \w o filho|strong="G3588,G5207"\w* \w de José|strong="G2501"\w*, \w de quem|strong="G3739"\w* \w nós|strong="G3165"\w* \w conhecemos|strong="G6063"\w* \w o pai|strong="G3588,G3962"\w* \w e|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w*? \w Como|strong="G4459"\w* \w agora|strong="G3568"\w* \w diz|strong="G3004"\w*: ‘\w Do céu|strong="G1537,G3588,G3772"\w* \w desci|strong="G2597"\w*’?”\f + \fr 6.42: \ft Variante: WH e Treg trazem Οὐχί no início da pergunta; o RP traz “então” (οὖν) em lugar de “agora” (νῦν) e acrescenta “este” (οὗτος) depois de “diz”.\f*\x - \xo 6:42 \xt MAT 4:4; MAT 13:55; MAT 6:11; JHN 3:13; JHN 1:45; MRK 6:3\x*
\v 43 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Não|strong="G3361"\w* \w murmurem|strong="G1111"\w* \w uns com os outros|strong="G3326,G240"\w*.\f + \fr 6.43: \ft Variante: o RP acrescenta “então” (οὖν) depois de “Respondeu” e o artigo diante de “Jesus”.\f*\x - \xo 6:43 \xt MAT 4:4; MAT 6:11; HEB 4:13; MAL 3:2; EXO 16:35; PSA 78:24\x*
\v 44 \w Ninguém|strong="G3762"\w* \w pode|strong="G1410"\w* \w vir|strong="G2064"\w* \w a mim|strong="G4314,G3165"\w* \w a não ser que|strong="G1437,G3361"\w* \w o Pai|strong="G3588,G3962"\w* \w que me enviou|strong="G3588,G3992,G3165"\w* \w o atraia|strong="G1670,G846"\w*, \w e eu|strong="G2532,G1473"\w* \w o ressuscitarei|strong="G450,G846"\w* \w no último|strong="G1722,G3588,G2078"\w* \w dia|strong="G2250"\w*\f + \fr 6.44: \ft Lit.: Κἀγώ, “e eu”: contração de καὶ ἐγώ; o pronome tem ênfase.\f*\f + \fr 6.44: \ft Lit.: Ἑλκύω, “puxar, arrastar”; usado também para puxar a espada (18:10) e a rede cheia de peixes (21:6, 11).\f*.\x - \xo 6:44 \xt JHN 6:65; JHN 6:39; MAT 4:4; MAT 11:25-27; JHN 11:25; EPH 2:8\x*
\v 45 \w Está escrito|strong="G1510,G1125"\w* \w nos profetas|strong="G1722,G3588,G4396"\w*: ‘\w E|strong="G2532"\w* \w serão|strong="G1510"\w* \w todos|strong="G3956"\w* \w ensinados|strong="G1318"\w* \w por Deus|strong="G2316"\w*.’ \w Todo|strong="G3956"\w* \w aquele que ouviu|strong="G3588,G191"\w* \w do Pai|strong="G3844,G3588,G3962"\w* \w e|strong="G2532"\w* \w aprendeu|strong="G3129"\w* \w vem|strong="G2064"\w* \w a mim|strong="G4314,G1473"\w*.\f + \fr 6.45: \ft Nota cultural: a citação é de Isaías 54:13 (LXX).\f*\f + \fr 6.45: \ft Variante: o RP acrescenta “então” (οὖν) depois de “Todo”, traz o particípio presente ἀκούων (“ouvindo”) e με em lugar de ἐμέ.\f*\x - \xo 6:45 \xt ISA 54:13; MAT 4:4; JER 31:33-34; ISA 48:17; HEB 10:16; HEB 8:10-11\x*
\v 46 \w Não|strong="G3756"\w* \w que|strong="G3754"\w* \w alguém|strong="G5100"\w* \add tenha\add* \w visto|strong="G3708"\w* \w o Pai|strong="G3588,G3962"\w*, \w a não ser|strong="G1487,G3361"\w* \w aquele que é|strong="G3588,G1510"\w* \w da parte de Deus|strong="G3844,G3588,G2316"\w*: \w este|strong="G3778"\w* \w viu|strong="G3708"\w* \w o Pai|strong="G3588,G3962"\w*.\f + \fr 6.46: \ft Acréscimo: “tenha” (em “que alguém tenha visto o”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 6:46 \xt JHN 8:38; MAT 4:4; JHN 1:18; MAT 11:27; MAT 6:11; LUK 10:22\x*
\v 47 \w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w aquele que crê|strong="G3588,G4100"\w* \w tem|strong="G2192"\w* \w vida eterna|strong="G2222,G166"\w*.\f + \fr 6.47: \ft Variante: Treg e o RP acrescentam “em mim” (εἰς ἐμέ) depois de “crê”.\f*\x - \xo 6:47 \xt JHN 3:15; JHN 5:24; MAT 4:4; 1JN 5:11; JHN 3:36; JHN 6:40\x*
\v 48 \w Eu sou|strong="G1473,G1510"\w* \w o pão|strong="G3588,G740"\w* \w da vida|strong="G3588,G2222"\w*.\x - \xo 6:48 \xt JHN 6:35; JHN 6:33; MAT 4:4; JHN 6:51; MAT 5:6; MAT 6:11\x*
\v 49 \w Os pais|strong="G3588,G3962"\w* \w de vocês|strong="G4771"\w* \w comeram|strong="G5315"\w* \w no deserto|strong="G1722,G3588,G2048"\w* \w o maná|strong="G3588,G3131"\w* \w e|strong="G2532"\w* \w morreram|strong="G599"\w*.\x - \xo 6:49 \xt JHN 6:31; MAT 4:4; MAT 5:6; JHN 6:35; MAT 6:11; ISA 55:2\x*
\v 50 \w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w o pão|strong="G3588,G740"\w* \w que desce|strong="G3588,G2597"\w* \w do céu|strong="G1537,G3588,G3772"\w*, \w para que|strong="G2443"\w* \w alguém|strong="G5100"\w* \w coma|strong="G5315"\w* \w dele|strong="G1537,G846"\w* \w e|strong="G2532"\w* \w não|strong="G3361"\w* \w morra|strong="G599"\w*.\x - \xo 6:50 \xt JHN 6:58; MAT 4:4; JHN 6:33; MAT 26:26; LUK 14:15; MAT 5:6\x*
\v 51 \w Eu sou|strong="G1473,G1510"\w* \w o pão|strong="G3588,G740"\w* \w vivo|strong="G3588,G2198"\w* \w que desceu|strong="G3588,G2597"\w* \w do céu|strong="G1537,G3588,G3772"\w*; \w se|strong="G1437"\w* \w alguém|strong="G5100"\w* \w comer|strong="G5315"\w* \w deste pão|strong="G1537,G3778,G3588,G740"\w*, \w viverá|strong="G2198"\w* \w para sempre|strong="G1519,G3588,G165"\w*, \w e|strong="G2532"\w* \w o pão|strong="G3588,G740"\w* \w também|strong="G1161"\w* \w que eu darei|strong="G3739,G1473,G1325"\w* \w é|strong="G1510"\w* \w a minha|strong="G3588,G3165"\w* \w carne|strong="G4561"\w* \w em favor da|strong="G5228,G3588"\w* \w vida|strong="G2222"\w* \w do mundo|strong="G3588,G2889"\w*.”\f + \fr 6.51: \ft Variante: depois de “é”, o RP acrescenta “a qual eu darei” (ἣν ἐγὼ δώσω); Treg e o RP trazem a forma média ζήσεται (“viverá”, mesmo sentido).\f*\x - \xo 6:51 \xt JHN 6:33; JHN 10:10; MAT 4:4; JHN 6:58; JHN 6:48; JHN 14:6\x*
\p
\v 52 \w Disputavam|strong="G3164"\w* \w então|strong="G3767"\w* \w uns com os outros|strong="G4314,G240"\w* \w os judeus|strong="G3588,G2453"\w*, \w dizendo|strong="G3004"\w*: “\w Como|strong="G4459"\w* \w pode|strong="G1410"\w* \w este|strong="G3778"\w* \w nos dar|strong="G3165,G1325"\w* \w a sua|strong="G3588,G846"\w* \w carne|strong="G4561"\w* \w para comer|strong="G5315"\w*?”\f + \fr 6.52: \ft Variante: Treg e o RP omitem “sua” (αὐτοῦ).\f*\x - \xo 6:52 \xt MAT 4:4; MAT 5:6; JHN 6:35; MAT 6:11; ISA 55:2; MAT 26:26\x*
\v 53 \w Disse-lhes|strong="G2036,G846"\w* \w então|strong="G3767"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w se não|strong="G1437,G3361"\w* \w comerem|strong="G5315"\w* \w a carne|strong="G3588,G4561"\w* \w do Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w e|strong="G2532"\w* \w beberem|strong="G4095"\w* \w o sangue dele|strong="G846,G3588,G129"\w*, \w não|strong="G3756"\w* \w têm|strong="G2192"\w* \w vida|strong="G2222"\w* \w em si mesmos|strong="G1722,G1438"\w*.\x - \xo 6:53 \xt MAT 4:4; JHN 6:47; JHN 6:51; MAT 5:6; LUK 12:29; 1CO 9:4\x*
\v 54 \w Aquele que come|strong="G3588,G5176"\w* \w a minha|strong="G3165,G3588"\w* \w carne|strong="G4561"\w* \w e|strong="G2532"\w* \w bebe|strong="G4095"\w* \w o meu|strong="G3165,G3588"\w* \w sangue|strong="G129"\w* \w tem|strong="G2192"\w* \w vida eterna|strong="G2222,G166"\w*, \w e eu|strong="G2532_B,G1473"\w* \w o ressuscitarei|strong="G450,G846"\w* \w no último|strong="G3588,G2078"\w* \w dia|strong="G2250"\w*\f + \fr 6.54: \ft Lit.: Τρώγω, “mastigar, comer (mastigando)”: verbo mais concreto que o ἐσθίω usado em 6:53; aparece em 6:54, 56, 57 e 58.\f*.\x - \xo 6:54 \xt MAT 4:4; JHN 6:40; JHN 6:56; MAT 5:6; JHN 6:47; JHN 6:35\x*
\v 55 \w Pois|strong="G1063"\w* \w a minha|strong="G3588,G3165"\w* \w carne|strong="G4561"\w* \w é|strong="G1510"\w* \w verdadeiro|strong="G227"\w* \w alimento|strong="G1035"\w*, \w e|strong="G2532"\w* \w o meu|strong="G3588,G3165"\w* \w sangue|strong="G129"\w* \w é|strong="G1510"\w* \w verdadeira|strong="G227"\w* \w bebida|strong="G4213"\w*.\f + \fr 6.55: \ft Variante: o RP traz o advérbio ἀληθῶς (“verdadeiramente”) nas duas ocorrências, em lugar do adjetivo ἀληθής (“verdadeiro/verdadeira”).\f*\x - \xo 6:55 \xt MAT 4:4; ROM 14:17; MAT 5:6; COL 2:16; JHN 6:35; JHN 15:1\x*
\v 56 \w Aquele que come|strong="G3588,G5176"\w* \w a minha|strong="G3165,G3588"\w* \w carne|strong="G4561"\w* \w e|strong="G2532"\w* \w bebe|strong="G4095"\w* \w o meu|strong="G3165,G3588"\w* \w sangue|strong="G129"\w* \w permanece|strong="G3306"\w* \w em mim|strong="G1722,G1473"\w*, \w e eu|strong="G2532_B,G1473"\w* \w nele|strong="G1722,G846"\w*.\x - \xo 6:56 \xt MAT 4:4; JHN 6:54; 2CO 6:16; MAT 5:6; JHN 15:4; JHN 6:35\x*
\v 57 \w Assim como|strong="G2531"\w* \w me enviou|strong="G649,G3165"\w* \w o Pai|strong="G3588,G3962"\w* \w vivo|strong="G2198"\w*, \w e eu|strong="G2532_A,G1473"\w* \w vivo|strong="G2198"\w* \w por causa do|strong="G1223,G3588"\w* \w Pai|strong="G3962"\w*, \w e|strong="G2532"\w* \w aquele que me come|strong="G3588,G5176,G3165"\w*, \w também esse|strong="G1565,G2532"\w* \w viverá|strong="G2198"\w* \w por causa de mim|strong="G1223,G1473"\w*.\x - \xo 6:57 \xt MAT 4:4; JHN 17:21; MAT 5:6; JHN 14:6; JHN 6:35; JHN 3:17\x*
\v 58 \w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w o pão|strong="G3588,G740"\w* \w que desceu|strong="G3588,G2597"\w* \w do céu|strong="G1537,G3772"\w*, \w não|strong="G3756"\w* \w como|strong="G2531"\w* \w comeram|strong="G5315"\w* \w os pais|strong="G3588,G3962"\w* \w e|strong="G2532"\w* \w morreram|strong="G599"\w*; \w aquele que come|strong="G3588,G5176"\w* \w este pão|strong="G3778,G3588,G740"\w* \w viverá|strong="G2198"\w* \w para sempre|strong="G1519,G3588,G165"\w*.”\f + \fr 6.58: \ft Variante: depois de “pais”, a NIV e o RP acrescentam “de vocês, o maná” (ὑμῶν τὸ μάννα); o RP traz “do” (ἐκ τοῦ) antes de “céu” e a forma média ζήσεται (“viverá”).\f*\x - \xo 6:58 \xt JHN 6:50; MAT 4:4; JHN 6:51; JHN 11:26; MAT 5:6; JHN 6:31\x*
\v 59 \w Estas coisas|strong="G3778"\w* \w disse|strong="G2036"\w* \w numa sinagoga|strong="G1722,G4864"\w*, \w ensinando|strong="G1321"\w* \w em Cafarnaum|strong="G1722,G2584"\w*.\x - \xo 6:59 \xt MAT 4:4; MRK 1:21; LUK 4:31; LUK 13:10; LUK 4:15; MAT 6:11\x*
\p
\v 60 \w Muitos|strong="G4183"\w* \w então|strong="G3767"\w* \w dos|strong="G1537,G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w*, \w tendo ouvido|strong="G191"\w*, \w disseram|strong="G2036"\w*: “\w Dura|strong="G4642"\w* \w é|strong="G1510"\w* \w esta palavra|strong="G3588,G3056,G3778"\w*; \w quem|strong="G5101"\w* \w pode|strong="G1410"\w* \w ouvi-la|strong="G846,G191"\w*?”\f + \fr 6.60: \ft Lit.: Σκληρός, “duro, áspero”: difícil de suportar ou de aceitar; λόγος aqui pode ser “palavra” ou “discurso, ensino”.\f*\x - \xo 6:60 \xt JHN 6:66; JHN 3:9; JHN 8:43; LUK 7:23; MAT 11:6; JHN 8:31\x*
\v 61 \w Sabendo|strong="G6063"\w* \w Jesus|strong="G3588,G2424"\w* \w em si mesmo|strong="G1722,G1438"\w* \w que|strong="G3754"\w* \w murmuravam|strong="G1111"\w* \w a respeito disto|strong="G4012,G3778"\w* \w os|strong="G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w*, \w disse-lhes|strong="G2036,G846"\w*: “\w Isto|strong="G3778"\w* \w faz vocês tropeçar|strong="G4771,G4624"\w*?\f + \fr 6.61: \ft Lit.: Σκανδαλίζω, “fazer tropeçar, causar queda”; “escandalizar, ofender”.\f*\x - \xo 6:61 \xt LUK 7:23; MAT 11:6; JUD 1:16; MAT 13:57; MAT 9:4; PSA 78:24\x*
\v 62 \w Então|strong="G3767"\w*, \add e\add* \w se|strong="G1437"\w* \w vocês virem|strong="G2334"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w* \w subir|strong="G305"\w* \w para onde|strong="G3699"\w* \w estava|strong="G1510"\w* \w antes|strong="G3588,G4387"\w*\f + \fr 6.62: \ft Lit.: a oração principal (apódose) fica subentendida: “E se virem…, o que dirão?”.\f*?\f + \fr 6.62: \ft Acréscimo: “e” (em “Então e se vocês”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 6:62 \xt JHN 3:13; ACT 1:9; MRK 16:19; EPH 4:8-10; LUK 24:51; LUK 7:23\x*
\v 63 \w O|strong="G3588"\w* \w Espírito|strong="G4151"\w* \w é|strong="G1510"\w* \w o que dá vida|strong="G3588,G2227"\w*; \w a|strong="G3588"\w* \w carne|strong="G4561"\w* \w não adianta|strong="G3756,G5623"\w* \w nada|strong="G3762"\w*; \w as palavras|strong="G3588,G4487"\w* \w que eu|strong="G3739,G1473"\w* \w lhes falei|strong="G2980,G4771"\w* \w são espírito|strong="G4151,G1510"\w* \w e|strong="G2532"\w* \w são vida|strong="G2222,G1510"\w*.\f + \fr 6.63: \ft Lit.: Τὸ πνεῦμα: “o Espírito” ou “o espírito”; o grego não distingue maiúsculas (cf. 3:6-8; 4:24).\f*\f + \fr 6.63: \ft Variante: o RP traz λαλῶ (“falo”) em lugar de λελάληκα (“falei”).\f*\x - \xo 6:63 \xt MAT 4:4; ISA 55:11; ACT 5:20; GAL 5:25; HEB 4:12; PSA 119:93\x*
\v 64 \w Mas|strong="G235"\w* \w há|strong="G1510"\w* \w entre vocês|strong="G1537,G4771"\w* \w alguns|strong="G5100"\w* \w que não creem|strong="G3739,G3756,G4100"\w*.” \w Pois|strong="G1063"\w* \w sabia|strong="G1492"\w* \w desde o princípio|strong="G1537,G746"\w* \w Jesus|strong="G3588,G2424"\w* \w quem|strong="G5101"\w* \w eram|strong="G1510"\w* \w os que não criam|strong="G3588,G3361,G4100"\w* \w e|strong="G2532"\w* \w quem|strong="G5101"\w* \w era|strong="G1510"\w* \w o que o entregaria|strong="G3588,G3860,G846"\w*.\x - \xo 6:64 \xt LUK 1:2; JHN 2:24; 1CO 11:27; JHN 6:66; JHN 2:25; 2TI 2:19\x*
\v 65 \w E|strong="G2532"\w* \w dizia|strong="G3004"\w*: “\w Por isso|strong="G1223,G3778"\w* \w lhes disse|strong="G2046,G4771"\w* \w que|strong="G3754"\w* \w ninguém|strong="G3762"\w* \w pode|strong="G1410"\w* \w vir|strong="G2064"\w* \w a mim|strong="G4314,G3165"\w* \w a não ser que|strong="G1437,G3361"\w* \w lhe seja dado|strong="G1510,G1325,G846"\w* \w pelo Pai|strong="G1537,G3588,G3962"\w*.”\f + \fr 6.65: \ft Variante: o RP traz “do meu Pai” (τοῦ πατρός μου) no fim.\f*\x - \xo 6:65 \xt JHN 6:44; JHN 9:33; JHN 6:45; EPH 2:8; PHP 2:13; JHN 6:37\x*
\v 66 \w Por causa disto|strong="G1537,G3778"\w*, \w muitos|strong="G4183"\w* \w dos|strong="G1537,G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w* \w voltaram atrás|strong="G565,G1519,G3588,G3694"\w* \w e|strong="G2532"\w* \w já não|strong="G2089,G3756"\w* \w andavam|strong="G4043"\w* \w com ele|strong="G3326,G846"\w*.\f + \fr 6.66: \ft Lit.: Ἐκ τούτου: “por causa disto” ou “a partir de então”.\f*\x - \xo 6:66 \xt JHN 8:31; LUK 9:62; 1JN 2:19; HEB 10:38; JHN 6:60; 2TI 4:10\x*
\p
\v 67 \w Disse|strong="G2036"\w* \w então|strong="G3767"\w* \w Jesus|strong="G3588,G2424"\w* \w aos doze|strong="G3588,G1427"\w*: “\w Será que|strong="G3361"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w querem|strong="G2309"\w* \w ir embora|strong="G5217"\w*?”\f + \fr 6.67: \ft Acréscimo: verbo ser/estar suprido em “Será que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:67 \xt JOS 24:15; MAT 20:14; JHN 8:31; PSA 62:5; JOB 23:12; JHN 6:70\x*
\v 68 \w Respondeu-lhe|strong="G611,G846"\w* \w Simão|strong="G4613"\w* \w Pedro|strong="G4074"\w*: “\w Senhor|strong="G2962"\w*, \w a quem|strong="G4314,G5101"\w* \w iremos|strong="G565"\w*? \w Palavras|strong="G4487"\w* \w de vida|strong="G2222"\w* \w eterna|strong="G166"\w* \w você tem|strong="G2192"\w*,\f + \fr 6.68: \ft Variante: o RP acrescenta “então” (οὖν) depois de “Respondeu”.\f*\x - \xo 6:68 \xt JOS 24:15; MAT 16:16; 1JN 5:11; ACT 5:20; LUK 9:20; 1JN 2:25\x*
\v 69 \w e|strong="G2532"\w* \w nós|strong="G3165"\w* \w temos crido|strong="G4100"\w* \w e|strong="G2532"\w* \w temos conhecido|strong="G1097"\w* \w que|strong="G3754"\w* \w você|strong="G4771"\w* \w é|strong="G1510"\w* \w o Santo|strong="G3588,G40"\w* \w de Deus|strong="G3588,G2316"\w*.”\f + \fr 6.69: \ft Variante: o RP traz “o Cristo, o Filho do Deus vivo” (ὁ χριστὸς ὁ υἱὸς τοῦ θεοῦ τοῦ ζῶντος) em lugar de “o Santo de Deus”.\f*\x - \xo 6:69 \xt JHN 2:24; 1JN 4:16; ACT 19:2; JHN 8:31; MAT 16:16; PSA 62:5\x*
\v 70 \w Respondeu-lhes|strong="G611,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Não|strong="G3756"\w* \w escolhi|strong="G1586"\w* \w eu|strong="G1473"\w* \w a vocês|strong="G4771"\w*, \w os doze|strong="G3588,G1427"\w*? \w E|strong="G2532"\w* \w um|strong="G1520"\w* \w de vocês|strong="G1537,G4771"\w* \w é|strong="G1510"\w* \w um diabo|strong="G1228"\w*.”\f + \fr 6.70: \ft Lit.: Διάβολος, “acusador, caluniador”; sem artigo, “um diabo” (ou “um adversário”).\f*\x - \xo 6:70 \xt LUK 6:13; JHN 8:31; JHN 15:16; ROM 10:9; JHN 13:27; JHN 13:2\x*
\v 71 \w Falava|strong="G3004"\w* \w de Judas|strong="G3588,G2455"\w*, \w filho de Simão|strong="G4613"\w* \w Iscariotes|strong="G2469"\w*; \w pois|strong="G1063"\w* \w este|strong="G3778"\w* \w estava para|strong="G3195"\w* \w entregá-lo|strong="G3860,G846"\w*, \w sendo um|strong="G1520"\w* \w dos doze|strong="G1537,G3588,G1427"\w*.\f + \fr 6.71: \ft Lit.: Σίμωνος, genitivo de filiação: “filho de Simão”.\f*\f + \fr 6.71: \ft Acréscimo: verbo ser/estar suprido em “sendo um”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:71 \xt JHN 12:4; MRK 3:19; MRK 14:10; MAT 10:4; MAT 26:14; JHN 13:2\x*
\c 7
\p
\v 1 \w E|strong="G2532"\w* \w depois destas coisas|strong="G3326,G3778"\w* \w andava|strong="G4043"\w* \w Jesus|strong="G3588,G2424"\w* \w pela Galileia|strong="G1722,G3588,G1056"\w*; \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w queria|strong="G2309"\w* \w andar|strong="G4043"\w* \w pela Judeia|strong="G1722,G3588,G2449"\w*, \w porque|strong="G3754"\w* \w o procuravam|strong="G2212,G846"\w* \w matar|strong="G615"\w* \w os judeus|strong="G3588,G2453"\w*.\f + \fr 7.1: \ft Lit.: Ἰουδαῖοι: “judeus” ou “judeanos”; aqui, pelo contraste com a Galileia e a Judeia, são as autoridades e os habitantes de Jerusalém e da Judeia (ver a nota de 1:19).\f*\x - \xo 7:1 \xt JHN 4:3; JHN 4:54; JHN 7:19; JHN 5:18; JHN 8:40; JHN 5:16-18\x*
\v 2 \w E|strong="G1161"\w* \w estava perto|strong="G1510,G1451"\w* \w a festa|strong="G3588,G1859"\w* \w dos judeus|strong="G3588,G2453"\w*, \w a das Tendas|strong="G3588,G4634"\w*.\f + \fr 7.2: \ft Nota cultural: a Festa das Tendas (Sucot, “cabanas”) era celebrada no outono, por sete dias, em memória da peregrinação no deserto (Lv 23:33-43).\f*\x - \xo 7:2 \xt LEV 23:33-43; JHN 6:4; JHN 5:1; JHN 7:11; LEV 23:34; DEU 16:13\x*
\v 3 \w Disseram|strong="G2036"\w* \w então|strong="G3767"\w* \w a ele|strong="G4314,G846"\w* \w os|strong="G3588"\w* \w irmãos|strong="G80"\w* \w dele|strong="G846"\w*: “\w Saia|strong="G3327"\w* \w daqui|strong="G1782"\w* \w e|strong="G2532"\w* \w vá|strong="G5217"\w* \w para a Judeia|strong="G1519,G3588,G2449"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w os seus|strong="G3588,G4771"\w* \w discípulos|strong="G3101"\w* \w vejam|strong="G2334"\w* \w as suas obras|strong="G4771,G3588,G2041"\w* \w que você faz|strong="G3739,G4160"\w*;\x - \xo 7:3 \xt MAT 12:46; JHN 6:15; MRK 3:21; JHN 7:5; JHN 2:12; DAN 5:13\x*
\v 4 \w pois|strong="G1063"\w* \w ninguém|strong="G3762"\w* \w faz algo|strong="G5100,G4160"\w* \w em segredo|strong="G1722,G2927"\w* \w e|strong="G2532"\w* \w procura|strong="G2212"\w* \w ele mesmo|strong="G846"\w* \w estar em público|strong="G1722,G3954,G1511"\w*; \w se você faz|strong="G1487,G4160"\w* \w estas coisas|strong="G3778"\w*, \w manifeste|strong="G5319"\w* \w a si mesmo|strong="G4771"\w* \w ao mundo|strong="G3588,G2889"\w*.”\x - \xo 7:4 \xt JHN 18:20; MAT 6:3; JHN 6:15; PRO 18:1-2; MRK 3:21; JHN 2:12\x*
\v 5 \w Pois|strong="G1063"\w* \w nem mesmo|strong="G3761"\w* \w os|strong="G3588"\w* \w seus|strong="G846"\w* \w irmãos|strong="G80"\w* \w criam|strong="G4100"\w* \w nele|strong="G1519,G846"\w*.\x - \xo 7:5 \xt ACT 19:2; MRK 16:13; MRK 3:21; MAT 12:46; JHN 1:11-13; JHN 7:3\x*
\v 6 \w Disse-lhes|strong="G3004,G846"\w* \w então|strong="G3767"\w* \w Jesus|strong="G3588,G2424"\w*: “\w O meu|strong="G3588,G1473"\w* \w momento certo|strong="G2540"\w* \add ainda\add* \w não|strong="G3768"\w* \w chegou|strong="G3918"\w*, \w mas|strong="G1161"\w* \w o momento certo|strong="G3588,G2540"\w* \w de vocês|strong="G3588,G4771"\w* \w está sempre|strong="G3842,G1510"\w* \w pronto|strong="G2092"\w*.\f + \fr 7.6: \ft Lit.: Καιρός, “momento oportuno, tempo certo”; distinto de ὥρα, “hora” (2:4; 7:30).\f*\f + \fr 7.6: \ft Acréscimo: “ainda” (em “momento certo ainda não chegou”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 7:6 \xt JHN 7:8; JHN 13:1; JHN 17:1; JHN 2:4; JHN 7:30; JHN 8:20\x*
\v 7 \w Não|strong="G3756"\w* \w pode|strong="G1410"\w* \w o mundo|strong="G3588,G2889"\w* \w odiar|strong="G3404"\w* \w vocês|strong="G4771"\w*, \w mas|strong="G1161"\w* \w a mim|strong="G1473"\w* \w odeia|strong="G3404"\w*, \w porque|strong="G3754"\w* \w eu|strong="G1473"\w* \w dou testemunho|strong="G3140"\w* \w a respeito dele|strong="G4012,G846"\w*, \w que|strong="G3754"\w* \w as obras|strong="G3588,G2041"\w* \w dele|strong="G846"\w* \w são más|strong="G4190,G1510"\w*.\x - \xo 7:7 \xt JHN 15:18; JHN 17:14; 1JN 3:13; JHN 3:19; JHN 3:20; ROM 12:2\x*
\v 8 \w Vocês|strong="G4771"\w* \w subam|strong="G305"\w* \w à festa|strong="G1519,G3588,G1859"\w*; \w eu|strong="G1473"\w* \w não|strong="G3756"\w* \w subo|strong="G305"\w* \w a esta festa|strong="G1519,G3588,G1859,G3778"\w*, \w porque|strong="G3754"\w* \w o meu|strong="G3588,G1473"\w* \w momento certo|strong="G2540"\w* \w ainda não|strong="G3768"\w* \w se cumpriu|strong="G4137"\w*.”\f + \fr 7.8: \ft Variante: o SBLGNT, Treg e NA28 trazem οὐκ (“não subo”); WH, a NIV e o RP trazem οὔπω (“ainda não subo”). O RP acrescenta “esta” (ταύτην) depois da primeira “festa”.\f*\x - \xo 7:8 \xt JHN 7:6; JHN 5:1; MRK 3:21; MAT 26:18; JHN 8:20; EXO 12:41\x*
\v 9 \w Tendo dito|strong="G2036"\w* \w estas coisas|strong="G3778"\w*, \w ele mesmo|strong="G846"\w* \w ficou|strong="G3306"\w* \w na Galileia|strong="G1722,G3588,G1056"\w*.\f + \fr 7.9: \ft Variante: Treg omite “porém” (δέ); WH e o RP trazem αὐτοῖς (“com eles”) em lugar de αὐτός (“ele mesmo”), isto é, “ficou com eles na Galileia”.\f*\x - \xo 7:9 \xt MRK 3:21; JHN 11:55\x*
\p
\v 10 \w Quando|strong="G5613"\w* \w subiram|strong="G305"\w* \w os|strong="G3588"\w* \w seus|strong="G846"\w* \w irmãos|strong="G80"\w* \w à festa|strong="G1519,G3588,G1859"\w*, \w então|strong="G5119"\w* \w também|strong="G2532"\w* \w ele mesmo|strong="G846"\w* \w subiu|strong="G305"\w*, \w não|strong="G3756"\w* \w abertamente|strong="G5320"\w*, \w mas|strong="G235"\w* \w como que|strong="G5613"\w* \w em segredo|strong="G1722,G2927"\w*.\x - \xo 7:10 \xt AMO 5:13; MRK 3:21; MAT 10:16; MAT 12:46; ISA 42:2-3; JHN 7:25\x*
\v 11 \w Os judeus|strong="G3588,G2453"\w* \w então|strong="G3767"\w* \w o procuravam|strong="G2212,G846"\w* \w na festa|strong="G1722,G3588,G1859"\w* \w e|strong="G2532"\w* \w diziam|strong="G3004"\w*: “\w Onde|strong="G4226"\w* \w está|strong="G1510"\w* \w aquele|strong="G1565"\w*?”\x - \xo 7:11 \xt JHN 11:56; JHN 7:2; JHN 5:1; JHN 7:25\x*
\v 12 \w E|strong="G2532"\w* \w havia|strong="G1510"\w* \w muito|strong="G4183"\w* \w murmúrio|strong="G1112"\w* \w a respeito dele|strong="G4012,G846"\w* \w entre as multidões|strong="G1722,G3588,G3793"\w*: \w uns|strong="G3588,G3303"\w* \w diziam|strong="G3004"\w*: “\w É|strong="G1510"\w* \w bom|strong="G18"\w*”; \w outros|strong="G243,G1161"\w* \w diziam|strong="G3004"\w*: “\w Não|strong="G3756"\w*, \w mas|strong="G235"\w* \w engana|strong="G4105"\w* \w o povo|strong="G3588,G3793"\w*.”\f + \fr 7.12: \ft Lit.: Ὄχλος, “multidão, povo (em geral)”; aqui, os peregrinos reunidos para a festa.\f*\x - \xo 7:12 \xt JHN 1:9; JHN 7:47; JHN 7:40-43; JHN 9:16; ACT 11:24; JHN 6:41\x*
\v 13 \w Ninguém|strong="G3762"\w*, \w contudo|strong="G3305"\w*, \w falava abertamente|strong="G3954,G2980"\w* \w a respeito dele|strong="G4012,G846"\w* \w por causa|strong="G1223"\w* \w do medo|strong="G3588,G5401"\w* \w dos judeus|strong="G3588,G2453"\w*.\x - \xo 7:13 \xt JHN 12:42; JHN 9:22; JHN 20:19; JHN 19:38; PRO 29:25; REV 2:13\x*
\p
\v 14 \w Já|strong="G2235"\w* \w estando a festa|strong="G3588,G1859"\w* \w no meio|strong="G3322"\w*, \w subiu|strong="G305"\w* \w Jesus|strong="G2424"\w* \w ao templo|strong="G1519,G3588,G2411"\w* \w e|strong="G2532"\w* \w ensinava|strong="G1321"\w*.\f + \fr 7.14: \ft Acréscimo: verbo ser/estar suprido em “estando a festa”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:14 \xt JHN 5:1; LUK 19:47; JHN 7:28; HAG 2:7-9; JHN 18:20; JHN 8:2\x*
\v 15 \w Admiravam-se|strong="G2296"\w* \w então|strong="G3767"\w* \w os judeus|strong="G3588,G2453"\w*, \w dizendo|strong="G3004"\w*: “\w Como|strong="G4459"\w* \w este|strong="G3778"\w* \w conhece|strong="G6063"\w* \w letras|strong="G1121"\w*, \w sem ter aprendido|strong="G3361,G3129"\w*?”\f + \fr 7.15: \ft Lit.: Γράμματα, “letras”: aqui, instrução formal nas Escrituras.\f*\f + \fr 7.15: \ft Variante: o RP traz “E se admiravam” (Καὶ ἐθαύμαζον) em lugar de “Admiravam-se então” (ἐθαύμαζον οὖν).\f*\x - \xo 7:15 \xt JHN 5:47; ISA 50:4; ACT 4:13; ISA 29:12; LUK 4:22; MRK 6:2\x*
\v 16 \w Respondeu-lhes|strong="G611,G846"\w* \w então|strong="G3767"\w* \w Jesus|strong="G3588,G2424"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w O meu|strong="G3588,G1473"\w* \w ensino|strong="G1322"\w* \w não|strong="G3756"\w* \w é|strong="G1510"\w* \w meu|strong="G1473"\w*, \w mas|strong="G235"\w* \w daquele que me enviou|strong="G3588,G3992,G3165"\w*.\f + \fr 7.16: \ft Variante: WH e Treg omitem o artigo diante de “Jesus” (ὁ Ἰησοῦς), sem mudança de sentido.\f*\x - \xo 7:16 \xt ISA 59:21; ISA 50:4; 2JN 1:9; JHN 16:13; JHN 14:24; JHN 17:7\x*
\v 17 \w Se|strong="G1437"\w* \w alguém|strong="G5100"\w* \w quiser|strong="G2309"\w* \w fazer|strong="G4160"\w* \w a vontade|strong="G3588,G2307"\w* \w dele|strong="G846"\w*, \w saberá|strong="G1097"\w* \w a respeito do|strong="G4012,G3588"\w* \w ensino|strong="G1322"\w* \w se|strong="G4220"\w* \w é|strong="G1510"\w* \w de Deus|strong="G1537,G3588,G2316"\w* \w ou|strong="G2228"\w* \add se\add* \w eu|strong="G1473"\w* \w falo|strong="G2980"\w* \w por mim mesmo|strong="G575,G1473"\w*.\f + \fr 7.17: \ft Acréscimo: “se” (em “Deus ou se eu falo”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 7:17 \xt ISA 59:21; ISA 50:4; 2JN 1:9; JHN 8:32; JHN 16:13; JHN 8:12\x*
\v 18 \w Aquele que fala|strong="G3588,G2980"\w* \w por si mesmo|strong="G575,G1438"\w* \w a sua própria|strong="G3588,G2398"\w* \w glória|strong="G1391"\w* \w procura|strong="G2212"\w*; \w mas|strong="G1161"\w* \w aquele que procura|strong="G3588,G2212"\w* \w a glória|strong="G3588,G1391"\w* \w daquele que o enviou|strong="G3588,G3992,G846"\w*, \w esse|strong="G3778"\w* \w é|strong="G1510"\w* \w verdadeiro|strong="G227"\w*, \w e|strong="G2532"\w* \w injustiça|strong="G93"\w* \w nele|strong="G1722,G846"\w* \w não|strong="G3756"\w* \w há|strong="G1510"\w*.\x - \xo 7:18 \xt JHN 8:50; 1TH 2:6; JHN 16:13; PHP 4:8; HEB 5:5; JHN 5:41\x*
\v 19 \w Não|strong="G3756"\w* \w lhes deu|strong="G1325,G4771"\w* \w Moisés|strong="G3475"\w* \w a lei|strong="G3588,G3551"\w*? \w E|strong="G2532"\w* \w nenhum|strong="G3762"\w* \w de vocês|strong="G1537,G4771"\w* \w pratica|strong="G4160"\w* \w a lei|strong="G3588,G3551"\w*. \add Por\add* \w que|strong="G5101"\w* \w me procuram|strong="G3165,G2212"\w* \w matar|strong="G615"\w*?”\f + \fr 7.19: \ft Variante: WH e Treg trazem o aoristo ἔδωκεν (“deu”) em lugar do perfeito δέδωκεν (“tem dado”).\f*\f + \fr 7.19: \ft Acréscimo: “Por” (em “a lei Por que me”): preposição ou artigo que a regência do português exige.\f*\x - \xo 7:19 \xt JHN 1:17; JHN 7:1; JHN 8:37; ACT 7:53; JHN 5:18; DEU 33:4\x*
\v 20 \w Respondeu|strong="G611"\w* \w a multidão|strong="G3588,G3793"\w*: “\w Você tem|strong="G2192"\w* \w um demônio|strong="G1140"\w*! \w Quem|strong="G5101"\w* \w procura|strong="G2212"\w* \w matar você|strong="G4771,G615"\w*?”\f + \fr 7.20: \ft Variante: o RP acrescenta “e disse” (καὶ εἶπεν) depois de “multidão”.\f*\x - \xo 7:20 \xt JHN 8:48; JHN 10:20; MAT 10:25; MRK 3:21-22; JHN 8:52; LUK 6:9\x*
\v 21 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Uma só|strong="G1520"\w* \w obra|strong="G2041"\w* \w fiz|strong="G4160"\w*, \w e|strong="G2532"\w* \w todos|strong="G3956"\w* \w vocês se admiram|strong="G2296"\w*.\x - \xo 7:21 \xt JHN 5:20; MRK 15:5; LUK 13:15; LUK 6:9; MAT 12:2; JHN 5:2-11\x*
\v 22 \w Por isso|strong="G1223,G3778"\w* \w Moisés|strong="G3475"\w* \w lhes deu|strong="G1325,G4771"\w* \w a circuncisão|strong="G3588,G4061"\w* — \w não|strong="G3756"\w* \w porque|strong="G3754"\w* \w é de Moisés|strong="G1537,G3588,G3475,G1510"\w*, \w mas|strong="G235"\w* \w dos pais|strong="G1537,G3588,G3962"\w* — \w e|strong="G2532"\w* \w no sábado|strong="G1722,G4521"\w* \w circuncidam|strong="G4059"\w* \w um homem|strong="G444"\w*.\x - \xo 7:22 \xt ACT 15:1; COL 2:11; MAT 12:5; LEV 12:3; GEN 17:10; HEB 1:1\x*
\v 23 \w Se|strong="G1487"\w* \w um homem|strong="G444"\w* \w recebe|strong="G2983"\w* \w circuncisão|strong="G4061"\w* \w no sábado|strong="G1722,G4521"\w*, \w para que|strong="G2443"\w* \w não|strong="G3361"\w* \w seja desfeita|strong="G3089"\w* \w a lei|strong="G3588,G3551"\w* \w de Moisés|strong="G3475"\w*, \w vocês se irritam|strong="G5520"\w* \w comigo|strong="G1473"\w* \w porque|strong="G3754"\w* \w tornei|strong="G4160"\w* \w são|strong="G5199"\w* \w um homem inteiro|strong="G3650,G444"\w* \w no sábado|strong="G1722,G4521"\w*?\f + \fr 7.23: \ft Lit.: Χολάω, “irritar-se, estar encolerizado” (só aparece aqui no Novo Testamento).\f*\f + \fr 7.23: \ft Acréscimo: verbo ser/estar suprido em “são”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:23 \xt JHN 5:9; MAT 12:5; LEV 12:3; MRK 2:27; JHN 5:14-16; ACT 3:16\x*
\v 24 \w Não|strong="G3361"\w* \w julguem|strong="G2919"\w* \w segundo a aparência|strong="G2596,G3799"\w*, \w mas|strong="G235"\w* \w julguem|strong="G2919"\w* \w com julgamento|strong="G3588,G2920"\w* \w justo|strong="G1342"\w*.”\f + \fr 7.24: \ft Lit.: Κατʼ ὄψιν, “segundo o que se vê, segundo a aparência”.\f*\x - \xo 7:24 \xt 1SA 16:7; LUK 12:57; ACT 4:19; JAS 2:4; ISA 11:3; JAS 2:9\x*
\p
\v 25 \w Diziam|strong="G3004"\w* \w então|strong="G3767"\w* \w alguns|strong="G5100"\w* \w dos|strong="G1537,G3588"\w* \w habitantes de Jerusalém|strong="G2415"\w*: “\w Não|strong="G3756"\w* \w é|strong="G1510"\w* \w este|strong="G3778"\w*, \w a quem|strong="G3739"\w* \w procuram|strong="G2212"\w* \w matar|strong="G615"\w*?\x - \xo 7:25 \xt LUK 2:11; MRK 12:12; JHN 7:10-11\x*
\v 26 \w E|strong="G2532"\w* \w veja|strong="G2396"\w*, \w fala abertamente|strong="G3954,G2980"\w*, \w e|strong="G2532"\w* \w nada|strong="G3762"\w* \w lhe dizem|strong="G3004,G846"\w*; \add será\add* \w que|strong="G4218,G3361"\w* \w as autoridades|strong="G3588,G758"\w* \w reconheceram|strong="G1097"\w* \w de fato|strong="G230"\w* \w que|strong="G3754"\w* \w este|strong="G3778"\w* \w é|strong="G1510"\w* \w o Cristo|strong="G3588,G5547"\w*?\f + \fr 7.26: \ft Variante: o RP acrescenta “verdadeiramente” (ἀληθῶς) depois de “é”.\f*\f + \fr 7.26: \ft Acréscimo: “será” (em “lhe dizem será que as”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 7:26 \xt JHN 18:20; LUK 2:11; 2TI 1:7-8; EPH 6:19-20; JHN 7:46; JHN 7:48\x*
\v 27 \w Mas|strong="G235"\w* \w a este|strong="G3778"\w* \w sabemos|strong="G6063"\w* \w de onde|strong="G4159"\w* \w é|strong="G1510"\w*; \w o Cristo|strong="G3588,G5547"\w*, \w porém|strong="G1161"\w*, \w quando|strong="G3752"\w* \w vier|strong="G2064"\w*, \w ninguém|strong="G3762"\w* \w sabe|strong="G1097"\w* \w de onde|strong="G4159"\w* \w é|strong="G1510"\w*.”\x - \xo 7:27 \xt MIC 5:2; JHN 7:41-42; JHN 6:42; JHN 9:29; LUK 2:11; MAT 13:54-57\x*
\v 28 \w Gritou|strong="G2896"\w* \w então|strong="G3767"\w*, \w ensinando|strong="G1321"\w* \w no templo|strong="G1722,G3588,G2411"\w*, \w Jesus|strong="G3588,G2424"\w* \w e|strong="G2532"\w* \w dizendo|strong="G3004"\w*: “\w Também a mim|strong="G2532_B,G1473"\w* \w vocês conhecem|strong="G6063"\w* \w e|strong="G2532"\w* \w sabem|strong="G6063"\w* \w de onde|strong="G4159"\w* \w sou|strong="G1510"\w*; \w e|strong="G2532"\w* \w por mim mesmo|strong="G575,G1473"\w* \w não|strong="G3756"\w* \w vim|strong="G2064"\w*, \w mas|strong="G235"\w* \w é|strong="G1510"\w* \w verdadeiro|strong="G228"\w* \w aquele que me enviou|strong="G3588,G3992,G3165"\w*, \w a quem|strong="G3739"\w* \w vocês|strong="G4771"\w* \w não|strong="G3756"\w* \w conhecem|strong="G6063"\w*;\f + \fr 7.28: \ft Lit.: Κἀμὲ οἴδατε καὶ οἴδατε πόθεν εἰμί: pode ser lido como afirmação (concessão irônica) ou como pergunta.\f*\x - \xo 7:28 \xt JHN 12:44; JHN 8:26; JHN 8:42; JHN 8:19; JHN 14:10; JHN 8:55\x*
\v 29 \w eu|strong="G1473"\w* \w o conheço|strong="G6063,G846"\w*, \w porque|strong="G3754"\w* \w da parte dele|strong="G3844,G846"\w* \w sou|strong="G1510"\w*, \w e aquele|strong="G1565,G2532"\w* \w me enviou|strong="G3165,G649"\w*.”\x - \xo 7:29 \xt JHN 1:6; MAT 11:27; JHN 8:42; JHN 3:17; JHN 17:3; JHN 8:55\x*
\v 30 \w Procuravam|strong="G2212"\w* \w então|strong="G3767"\w* \w prendê-lo|strong="G846,G4084"\w*, \w e|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w lançou|strong="G1911"\w* \w a mão|strong="G3588,G5495"\w* \w sobre ele|strong="G1909,G846"\w*, \w porque|strong="G3754"\w* \w ainda não|strong="G3768"\w* \w tinha chegado|strong="G2064"\w* \w a hora|strong="G3588,G5610"\w* \w dele|strong="G846"\w*.\x - \xo 7:30 \xt JHN 7:44; JHN 7:6; JHN 10:39; JHN 2:4; JHN 8:20; JHN 19:11\x*
\v 31 \w Da multidão|strong="G1537,G3588,G3793"\w* \w muitos|strong="G4183"\w* \w creram|strong="G4100"\w* \w nele|strong="G1519,G846"\w*, \w e|strong="G2532"\w* \w diziam|strong="G3004"\w*: “\w O Cristo|strong="G3588,G5547"\w*, \w quando|strong="G3752"\w* \w vier|strong="G2064"\w*, \w será que|strong="G3361"\w* \w fará|strong="G4160"\w* \w mais|strong="G4119"\w* \w sinais|strong="G4592"\w* \w do que os que|strong="G3739"\w* \w este|strong="G3778"\w* \w fez|strong="G4160"\w*?”\f + \fr 7.31: \ft Variante: o RP traz “que” (ὅτι) depois de “diziam”, μήτι em lugar de μή e acrescenta “estes” (τούτων) depois de “sinais”.\f*\f + \fr 7.31: \ft Acréscimo: verbo ser/estar suprido em “será que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:31 \xt JHN 2:23; JHN 12:42; JHN 15:24; JHN 3:2; JHN 8:30; MAT 12:23\x*
\p
\v 32 \w Ouviram|strong="G191"\w* \w os fariseus|strong="G3588,G5330"\w* \w a multidão|strong="G3588,G3793"\w* \w murmurar|strong="G1111"\w* \w a respeito dele|strong="G4012,G846"\w* \w estas coisas|strong="G3778"\w*, \w e|strong="G2532"\w* \w enviaram|strong="G649"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w* \w guardas|strong="G5257"\w* \w para que|strong="G2443"\w* \w o prendessem|strong="G4084,G846"\w*.\f + \fr 7.32: \ft Lit.: Ὑπηρέτης, “auxiliar, oficial”; aqui, guardas do templo a serviço das autoridades.\f*\x - \xo 7:32 \xt JHN 7:45; 1SA 19:20; MAT 26:58; ACT 5:26; JHN 7:30; JHN 7:12\x*
\v 33 \w Disse|strong="G2036"\w* \w então|strong="G3767"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Ainda por pouco tempo|strong="G2089,G3398,G5550"\w* \w estou|strong="G1510"\w* \w com vocês|strong="G3326,G4771"\w*, \w e|strong="G2532"\w* \w vou|strong="G5217"\w* \w àquele que me enviou|strong="G4314,G3588,G3992,G3165"\w*.\x - \xo 7:33 \xt JHN 12:35; JHN 16:16; JHN 13:33; JHN 16:5; JHN 14:19; ISA 55:6\x*
\v 34 \w Vocês me procurarão|strong="G2212,G3165"\w* \w e|strong="G2532"\w* \w não encontrarão|strong="G3756,G2147"\w*, \w e|strong="G2532"\w* \w onde|strong="G3699"\w* \w eu|strong="G1473"\w* \w estou|strong="G1510"\w* \w vocês|strong="G4771"\w* \w não|strong="G3756"\w* \w podem|strong="G1410"\w* \w vir|strong="G2064"\w*.”\f + \fr 7.34: \ft Variante: WH e NA28 acrescentam “me” (με) depois de “encontrarão” (também em 7:36).\f*\x - \xo 7:34 \xt JHN 7:36; JHN 8:21; MRK 1:37; JHN 13:33; ISA 55:6; HOS 5:6\x*
\v 35 \w Disseram|strong="G2036"\w* \w então|strong="G3767"\w* \w os judeus|strong="G3588,G2453"\w* \w entre si|strong="G4314,G1438"\w*: “\w Para onde|strong="G4226"\w* \w este|strong="G3778"\w* \w está para|strong="G3195"\w* \w ir|strong="G4198"\w*, \w que|strong="G3754"\w* \w nós|strong="G3165"\w* \w não|strong="G3756"\w* \w o encontraremos|strong="G2147,G846"\w*? \w Será que|strong="G3361"\w* \w para a dispersão|strong="G1519,G3588,G1290"\w* \w dos gregos|strong="G3588,G1672"\w* \w está para|strong="G3195"\w* \w ir|strong="G4198"\w* \w e|strong="G2532"\w* \w ensinar|strong="G1321"\w* \w os gregos|strong="G3588,G1672"\w*?\f + \fr 7.35: \ft Lit.: Διασπορὰ τῶν Ἑλλήνων: “a dispersão (diáspora) entre os gregos”, isto é, os judeus espalhados pelo mundo de língua grega; “gregos” pode designar também os não judeus de cultura grega.\f*\f + \fr 7.35: \ft Acréscimo: verbo ser/estar suprido em “Será que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:35 \xt JAS 1:1; JHN 12:20; 1PE 1:1; 1TI 2:7; EST 3:8; ISA 11:12\x*
\v 36 \w Qual|strong="G5101"\w* \w é|strong="G1510"\w* \w esta palavra|strong="G3588,G3056,G3778"\w* \w que ele disse|strong="G3739,G2036"\w*: ‘\w Vocês me procurarão|strong="G2212,G3165"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w encontrarão|strong="G2147"\w*, \w e|strong="G2532"\w* \w onde|strong="G3699"\w* \w eu|strong="G1473"\w* \w estou|strong="G1510"\w* \w vocês|strong="G4771"\w* \w não|strong="G3756"\w* \w podem|strong="G1410"\w* \w vir|strong="G2064"\w*’?”\x - \xo 7:36 \xt JHN 7:34; MRK 1:37; JHN 8:21; JHN 3:9; PRO 1:23; 1CO 2:14\x*
\p
\v 37 \w No último|strong="G1722,G3588,G2078"\w* \w dia|strong="G2250"\w* \w o grande|strong="G3588,G3173"\w* \w da festa|strong="G3588,G1859"\w*, \w estava de pé|strong="G2476"\w* \w Jesus|strong="G3588,G2424"\w* \w e|strong="G2532"\w* \w gritou|strong="G2896"\w*, \w dizendo|strong="G3004"\w*: “\w Se|strong="G1437"\w* \w alguém|strong="G5100"\w* \w tem sede|strong="G1372"\w*, \w venha|strong="G2064"\w* \w a mim|strong="G4314,G3165"\w* \w e|strong="G2532"\w* \w beba|strong="G4095"\w*.\f + \fr 7.37: \ft Nota cultural: a Festa das Tendas durava sete dias (Lv 23:34-36 acrescenta um oitavo dia solene); o “último e grande dia” pode ser o sétimo ou o oitavo.\f*\x - \xo 7:37 \xt LEV 23:34-36; ISA 44:3; MAT 11:28; ISA 55:1; MRK 16:16; JHN 4:10\x*
\v 38 \w Aquele que crê|strong="G3588,G4100"\w* \w em mim|strong="G1519,G1473"\w*, \w conforme|strong="G2531"\w* \w disse|strong="G2036"\w* \w a Escritura|strong="G3588,G1124"\w*: ‘\w Rios|strong="G4215"\w* \w de água|strong="G5204"\w* \w viva|strong="G2198"\w* \w correrão|strong="G4482"\w* \w do ventre|strong="G1537,G3588,G2836"\w* \w dele|strong="G846"\w*.’”\f + \fr 7.38: \ft Lit.: a pontuação é discutida: “quem crê em mim,… de seu ventre (κοιλία, “ventre, interior”) correrão rios”, isto é, do crente; ou, ligando “beba” de 7:37 a “aquele que crê em mim”, os rios correrão do interior de Jesus.\f*\f + \fr 7.38: \ft Nota cultural: não há no Antigo Testamento um texto idêntico a esta citação; costuma-se relacioná-la com passagens como Is 44:3, Is 58:11 e Zc 14:8.\f*\x - \xo 7:38 \xt ISA 44:3; ISA 58:11; ZEC 14:8; ISA 12:3; JHN 4:10; JHN 4:14\x*
\v 39 \w Isto|strong="G3778"\w* \w disse|strong="G2036"\w* \w a respeito do|strong="G4012,G3588"\w* \w Espírito|strong="G4151"\w*, \w o qual|strong="G3739"\w* \w iam|strong="G3195"\w* \w receber|strong="G2983"\w* \w os que creram|strong="G3588,G4100"\w* \w nele|strong="G1519,G846"\w*; \w pois|strong="G1063"\w* \w ainda não|strong="G3768"\w* \w havia|strong="G1510"\w* \w Espírito|strong="G4151"\w*, \w porque|strong="G3754"\w* \w Jesus|strong="G2424"\w* \w ainda não|strong="G3764"\w* \add fora\add* \w glorificado|strong="G1392"\w*.\f + \fr 7.39: \ft Lit.: Οὔπω γὰρ ἦν πνεῦμα, “pois ainda não havia Espírito”: o sentido é que o Espírito ainda não estava disponível ou dado (a NIV acrescenta “dado”).\f*\f + \fr 7.39: \ft Variante: Treg e o RP acrescentam “Santo” (ἅγιον) depois de “Espírito”; NA28 traz ὅ (“o que”) em lugar de οὗ (“o qual”); o RP traz o particípio presente πιστεύοντες (“os que creem”); WH e Treg trazem οὔπω em lugar de οὐδέπω antes de “fora glorificado”.\f*\f + \fr 7.39: \ft Acréscimo: “fora” (em “ainda não fora glorificado”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 7:39 \xt ISA 44:3; JHN 4:14; REV 22:1; ISA 59:21; JHN 4:10; JOL 2:28\x*
\v 40 \w Da multidão|strong="G1537,G3588,G3793"\w* \w então|strong="G3767"\w*, \w tendo ouvido|strong="G191"\w* \w estas palavras|strong="G3588,G3056,G3778"\w*, \w diziam|strong="G3004"\w*: “\w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w verdadeiramente|strong="G230"\w* \w o profeta|strong="G3588,G4396"\w*.”\f + \fr 7.40: \ft Variante: o RP traz “Muitos, então, da multidão” (Πολλοὶ οὖν ἐκ τοῦ ὄχλου) e “a palavra” (τὸν λόγον) em lugar de “estas palavras”; WH acrescenta “que” (ὅτι) depois de “diziam”.\f*\x - \xo 7:40 \xt JHN 6:14; MAT 21:11; MAT 10:34; JHN 1:21; JHN 10:19; JHN 4:19\x*
\v 41 \w Outros|strong="G243"\w* \w diziam|strong="G3004"\w*: “\w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w o Cristo|strong="G3588,G5547"\w*.” \w Outros|strong="G3588,G1161"\w* \w diziam|strong="G3004"\w*: “\w Pois|strong="G1063"\w* \w será que|strong="G3361"\w* \w o Cristo|strong="G3588,G5547"\w* \w vem|strong="G2064"\w* \w da Galileia|strong="G1537,G3588,G1056"\w*?\f + \fr 7.41: \ft Acréscimo: verbo ser/estar suprido em “será que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:41 \xt JHN 1:46; JHN 7:52; LUK 1:26; LUK 9:20; MAT 10:34; JHN 7:27\x*
\v 42 \w Não|strong="G3756"\w* \w disse|strong="G2036"\w* \w a Escritura|strong="G3588,G1124"\w*: ‘\w Da descendência|strong="G1537,G3588,G4690"\w* \w de Davi|strong="G1138"\w*, \w e|strong="G2532"\w* \w de Belém|strong="G575,G965"\w*, \w a aldeia|strong="G3588,G2968"\w* \w onde|strong="G3699"\w* \w estava|strong="G1510"\w* \w Davi|strong="G1138"\w*, \w vem|strong="G2064"\w* \w o Cristo|strong="G3588,G5547"\w*’?”\f + \fr 7.42: \ft Nota cultural: ecoa a expectativa de um Messias da descendência de Davi (2Sm 7:12-16; Sl 89:3-4), nascido em Belém (Mq 5:2); cf. Mt 2:5-6.\f*\x - \xo 7:42 \xt MIC 5:2; MAT 2:5; 2SA 7:12-16; PSA 89:3-4; MAT 2:6; MAT 2:1\x*
\v 43 \w Houve|strong="G1096"\w* \w então|strong="G3767"\w* \w uma divisão|strong="G4978"\w* \w na multidão|strong="G1722,G3588,G3793"\w* \w por causa dele|strong="G1223,G846"\w*.\x - \xo 7:43 \xt MAT 10:34; 1CO 1:10; JHN 10:19; JHN 9:16; JHN 7:12; ACT 23:7\x*
\v 44 \w Alguns|strong="G5100"\w* \w dentre eles|strong="G1537,G846"\w* \w queriam|strong="G2309"\w* \w prendê-lo|strong="G4084,G846"\w*, \w mas|strong="G235"\w* \w ninguém|strong="G3762"\w* \w lançou|strong="G1911"\w* \w as mãos|strong="G3588,G5495"\w* \w sobre ele|strong="G1909,G846"\w*.\x - \xo 7:44 \xt JHN 7:30; JHN 10:39; MRK 14:46; JHN 8:20; MAT 10:34; ACT 23:11\x*
\p
\v 45 \w Foram|strong="G2064"\w* \w então|strong="G3767"\w* \w os guardas|strong="G3588,G5257"\w* \w aos chefes dos sacerdotes|strong="G4314,G3588,G749"\w* \w e|strong="G2532"\w* \w fariseus|strong="G5330"\w*, \w e|strong="G2532"\w* \w lhes disseram|strong="G2036,G846"\w* \w aqueles|strong="G1565"\w*: “\w Por que|strong="G1223,G5101"\w* \w não|strong="G3756"\w* \w o trouxeram|strong="G71,G846"\w*?”\x - \xo 7:45 \xt JHN 7:32; MAT 26:58; MAT 10:34; 1SA 19:20; LUK 22:53\x*
\v 46 \w Responderam|strong="G611"\w* \w os guardas|strong="G3588,G5257"\w*: “\w Jamais|strong="G3763"\w* \w falou|strong="G2980"\w* \w assim|strong="G3779"\w* \w um homem|strong="G444"\w*.”\f + \fr 7.46: \ft Variante: Treg e o RP acrescentam “como este homem” (ὡς οὗτος ὁ ἄνθρωπος) no fim.\f*\x - \xo 7:46 \xt MAT 26:33; ISA 50:4; PSA 45:2; ACT 6:10; MAT 10:34; MAT 7:28\x*
\v 47 \w Responderam-lhes|strong="G611,G846"\w* \w então|strong="G3767"\w* \w os fariseus|strong="G3588,G5330"\w*: “\w Será que|strong="G3361"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w foram enganados|strong="G4105"\w*?\f + \fr 7.47: \ft Acréscimo: verbo ser/estar suprido em “Será que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:47 \xt MAT 24:4; MAT 22:29; JHN 3:1; MAT 10:34; 1PE 4:14; ECC 9:16\x*
\v 48 \w Será que|strong="G3361"\w* \w alguém|strong="G5100"\w* \w dentre as|strong="G1537,G3588"\w* \w autoridades|strong="G758"\w* \w creu|strong="G4100"\w* \w nele|strong="G1519,G846"\w* \w ou|strong="G2228"\w* \w dentre os|strong="G1537,G3588"\w* \w fariseus|strong="G5330"\w*?\f + \fr 7.48: \ft Acréscimo: verbo ser/estar suprido em “Será que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:48 \xt JHN 3:1; JHN 12:42; MAT 9:34; MAT 12:24; MAT 10:34; 1PE 4:14\x*
\v 49 \w Mas|strong="G235"\w* \w esta multidão|strong="G3588,G3793,G3778"\w*, \w que não conhece|strong="G3588,G3361,G1097"\w* \w a lei|strong="G3588,G3551"\w*, \w é maldita|strong="G6035,G1510"\w*.”\x - \xo 7:49 \xt JHN 3:1; MAT 10:34; 1CO 1:20-21; 1CO 3:18-20; 1PE 4:14; ECC 9:16\x*
\v 50 \w Disse|strong="G3004"\w* \w Nicodemos|strong="G3530"\w* \w a eles|strong="G4314,G846"\w*, \w aquele que tinha ido|strong="G3588,G2064"\w* \w a ele|strong="G4314,G846"\w* \w antes|strong="G4387"\w*, \w sendo|strong="G1510"\w* \w um|strong="G1520"\w* \w deles|strong="G1537,G846"\w*:\f + \fr 7.50: \ft Variante: o RP acrescenta “de noite” (νυκτός) depois de “ido”; NA28 traz τὸ πρότερον (“antes”, com artigo) e o RP omite a palavra.\f*\x - \xo 7:50 \xt JHN 3:1; MAT 10:34; JHN 19:39; 1PE 4:14; EXO 23:2; LUK 11:52\x*
\v 51 “\w Será que|strong="G3361"\w* \w a nossa|strong="G3588,G3165"\w* \w lei|strong="G3551"\w* \w julga|strong="G2919"\w* \w o homem|strong="G3588,G444"\w*, \w se não|strong="G1437,G3361"\w* \w ouvir|strong="G191"\w* \w primeiro|strong="G4413"\w* \w da parte dele|strong="G3844,G846"\w* \w e|strong="G2532"\w* \w souber|strong="G1097"\w* \w o que|strong="G5101"\w* \w faz|strong="G4160"\w*?”\f + \fr 7.51: \ft Acréscimo: verbo ser/estar suprido em “Será que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:51 \xt PRO 18:13; ACT 25:16; MAT 10:34; DEU 1:17; ACT 23:3; 1PE 4:14\x*
\v 52 \w Responderam|strong="G611"\w* \w e|strong="G2532"\w* \w lhe disseram|strong="G2036,G846"\w*: “\w Será que|strong="G3361"\w* \w também|strong="G2532"\w* \w você|strong="G4771"\w* \w é da Galileia|strong="G1537,G3588,G1056,G1510"\w*? \w Examine|strong="G2045"\w* \w e|strong="G2532"\w* \w veja|strong="G1492"\w* \w que|strong="G3754"\w* \w da Galileia|strong="G1537,G3588,G1056"\w* \w profeta|strong="G4396"\w* \w não|strong="G3756"\w* \w surge|strong="G1453"\w*.”\f + \fr 7.52: \ft Variante: o RP traz o perfeito ἐγήγερται (“surgiu”) em lugar de ἐγείρεται (“surge”) e inverte a ordem de “profeta” e “da Galileia”.\f*\f + \fr 7.52: \ft Acréscimo: verbo ser/estar suprido em “Será que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:52 \xt JHN 1:46; JHN 7:41; JHN 5:39; MAT 10:34; 1PE 1:10; ISA 9:1-2\x*
\v 53 \w E|strong="G2532"\w* \w foi|strong="G4198"\w* \w cada um|strong="G1538"\w* \w para a sua casa|strong="G1519,G3588,G3624,G846"\w*.\f + \fr 7.53: \ft Variante: a passagem 7:53–8:11 não consta de vários dos manuscritos mais antigos e importantes (como P66, P75, ℵ e B) e, onde aparece, ocupa lugares diferentes (por exemplo, depois de Lc 21:38 em alguns manuscritos); o SBLGNT a imprime entre colchetes duplos e o RP a traz sem ressalva, com texto próprio.\f*\x - \xo 7:53 \xt LUK 21:38; PSA 33:10; LUK 2:3\x*
\c 8
\p
\v 1 \w Jesus|strong="G2424"\w* \w foi|strong="G4198"\w* \w para o monte|strong="G1519,G3588,G3735"\w* \w das Oliveiras|strong="G3588,G1636"\w*.\f + \fr 8.1: \ft Variante: parte da passagem 7:53–8:11; ver a nota var de 7:53. A tradição manuscrita desta passagem varia muito de um testemunho para outro.\f*\x - \xo 8:1 \xt LUK 22:39; MAT 21:1; MRK 11:1; MRK 14:26; MAT 26:30; MRK 11:11\x*
\v 2 \w Ao amanhecer|strong="G3722"\w* \w de novo|strong="G3825"\w* \w chegou|strong="G3854"\w* \w ao templo|strong="G1519,G3588,G2411"\w*, \w e|strong="G2532"\w* \w todo o povo|strong="G3956,G3588,G2992"\w* \w vinha|strong="G2064"\w*; \w e|strong="G2532"\w* \w sentando-se|strong="G2523"\w*, \w os ensinava|strong="G1321,G846"\w*.\f + \fr 8.2: \ft Variante: ver a nota var de 7:53.\f*\x - \xo 8:2 \xt ACT 5:21; LUK 21:38; MAT 26:55; LUK 4:20; MRK 14:49; LUK 21:37\x*
\v 3 \w Trouxeram|strong="G71"\w* \w os escribas|strong="G3588,G1122"\w* \w e|strong="G2532"\w* \w os fariseus|strong="G3588,G5330"\w* \w até ele|strong="G4314,G846"\w* \w uma mulher|strong="G1135"\w* \w apanhada|strong="G2638"\w* \w em adultério|strong="G1722,G3430"\w*, \w e|strong="G2532"\w* \w tendo-a posto|strong="G2476,G846"\w* \w no meio|strong="G1722,G3319"\w*,\f + \fr 8.3: \ft Variante: ver a nota var de 7:53.\f*\x - \xo 8:3 \xt LUK 24:36; MRK 7:1; EZK 16:38\x*
\v 4 \w disseram-lhe|strong="G3004,G846"\w*, \w testando-o|strong="G3985"\w*: “\w Mestre|strong="G1320"\w*, \w esta mulher|strong="G3778,G3588,G1135"\w* \w foi apanhada|strong="G2638"\w* \w em flagrante|strong="G1909,G1888"\w* \w cometendo adultério|strong="G3431"\w*.\f + \fr 8.4: \ft Lit.: Ἐπʼ αὐτοφόρῳ, “em flagrante” (expressão rara, só aqui no Novo Testamento).\f*\f + \fr 8.4: \ft Variante: ver a nota var de 7:53.\f*\x - \xo 8:4 \xt MAT 1:19; LEV 20:10; DEU 22:22\x*
\v 5 \w Na lei|strong="G1722,G3588,G3551"\w* \w Moisés|strong="G3475"\w* \w nos ordenou|strong="G3165,G1781"\w* \w que tais mulheres|strong="G3588,G5108"\w* \w sejam apedrejadas|strong="G3036"\w*; \w você|strong="G4771"\w* \w então|strong="G3767"\w* \w o que|strong="G5101"\w* \w diz|strong="G3004"\w*?”\f + \fr 8.5: \ft Variante: ver a nota var de 7:53.\f*\x - \xo 8:5 \xt MRK 10:3; LEV 20:10; DEU 22:21-24; EZK 16:38; MAT 1:19; MAT 5:17\x*
\v 6 \w Isto|strong="G3778"\w* \w diziam|strong="G3004"\w* \w para testá-lo|strong="G3985,G846"\w*, \w para que|strong="G2443"\w* \w pudessem|strong="G2192"\w* \w acusá-lo|strong="G2723,G846"\w*. \w Jesus|strong="G3588,G2424"\w*, \w porém|strong="G1161"\w*, \w inclinando-se para baixo|strong="G2736,G2955"\w*, \w com o dedo|strong="G3588,G1147"\w* \w escrevia|strong="G1125"\w* \w na terra|strong="G1519,G3588,G1093"\w*, \w sem fazer caso|strong="G3361,G4364"\w*.\f + \fr 8.6: \ft Lit.: Ἔγραφεν, “escrevia” (ou “traçava”); o texto não diz o que ele escreveu.\f*\f + \fr 8.6: \ft Variante: ver a nota var de 7:53.\f*\x - \xo 8:6 \xt JHN 8:8; JER 17:13; LUK 10:25; ECC 3:7; MAT 12:10; PSA 38:12-14\x*
\v 7 \w Como|strong="G5613,G1161"\w* \w continuavam perguntando-lhe|strong="G1961,G2065,G846"\w*, \w levantando-se|strong="G352"\w* \w disse|strong="G2036"\w* \w a eles|strong="G4314,G846"\w*: “\w O sem pecado|strong="G3588,G361"\w* \w entre vocês|strong="G4771"\w*, \w atire|strong="G906"\w* \w primeiro|strong="G4413"\w* \w a pedra|strong="G3588,G3037"\w* \w nela|strong="G1909,G846"\w*.”\f + \fr 8.7: \ft Lit.: Ἀναμάρτητος, “sem pecado” (só aparece aqui no Novo Testamento).\f*\f + \fr 8.7: \ft Variante: ver a nota var de 7:53.\f*\x - \xo 8:7 \xt MAT 7:3; MAT 7:1-5; ROM 2:1; JER 17:13; ROM 2:21-25; LUK 6:41\x*
\v 8 \w E|strong="G2532"\w* \w de novo|strong="G3825"\w*, \w inclinando-se para baixo|strong="G2736,G2955"\w*, \w escrevia|strong="G1125"\w* \w na terra|strong="G1519,G3588,G1093"\w*.\f + \fr 8.8: \ft Variante: ver a nota var de 7:53.\f*\x - \xo 8:8 \xt JHN 8:6; MAT 7:3; ROM 2:1; JER 17:13; PSA 130:3; ECC 7:22\x*
\v 9 \w Eles|strong="G3588"\w*, \w porém|strong="G1161"\w*, \w tendo ouvido|strong="G191"\w*, \w e|strong="G2532"\w* \w sendo convencidos|strong="G1651"\w* \w pela consciência|strong="G5259,G3588,G4893"\w*, \w saíam|strong="G1831"\w* \w um a um|strong="G1520,G2596"\w*, \w começando|strong="G757"\w* \w pelos mais velhos|strong="G575,G3588,G4245"\w*; \w e|strong="G2532"\w* \w ficou|strong="G2641"\w* \w sozinho|strong="G3441"\w* \w Jesus|strong="G3588,G2424"\w*, \w e|strong="G2532"\w* \w a mulher|strong="G3588,G1135"\w* \w que estava|strong="G1510"\w* \w no meio|strong="G1722,G3319"\w*.\f + \fr 8.9: \ft Variante: ver a nota var de 7:53.\f*\f + \fr 8.9: \ft Lit.: πρεσβύτερος, “mais velho”: pode designar a idade ou um líder do povo ou da comunidade; as traduções usam “ancião” ou “presbítero”, e este livro usa “mais velhos”.\f*\x - \xo 8:9 \xt MAT 7:3; ROM 2:1; ECC 7:22; PSA 130:3; ROM 2:15; 1JN 3:20\x*
\v 10 \w Levantando-se|strong="G352"\w* \w Jesus|strong="G3588,G2424"\w*, \w e|strong="G2532"\w* \w não vendo ninguém|strong="G3367,G2300"\w* \w a não ser|strong="G4133"\w* \w a mulher|strong="G3588,G1135"\w*, \w lhe disse|strong="G2036,G846"\w*: “\w Onde|strong="G4226"\w* \w estão|strong="G1510"\w* \w eles|strong="G1565"\w*, \w os seus|strong="G3588,G4771"\w* \w acusadores|strong="G2725"\w*? \w Ninguém|strong="G3762"\w* \w condenou você|strong="G4771,G2632"\w*?”\f + \fr 8.10: \ft Variante: ver a nota var de 7:53.\f*\x - \xo 8:10 \xt ISA 41:11-12; JHN 8:9; LUK 17:17\x*
\v 11 \w Ela|strong="G3588"\w* \w disse|strong="G2036"\w*: “\w Ninguém|strong="G3762"\w*, \w Senhor|strong="G2962"\w*.” \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Nem eu|strong="G3761,G1473"\w* \w condeno você|strong="G4771,G2919"\w*; \w vá|strong="G4198"\w* \w e|strong="G2532"\w* \w não peque mais|strong="G3371,G264"\w*\f + \fr 8.11: \ft Variante: ver a nota var de 7:53.\f*\f + \fr 8.11: \ft Lit.: Κρίνω, “julgar”; aqui no sentido de “condenar”, em paralelo com κατακρίνω do v. 10.\f*.”\x - \xo 8:11 \xt JHN 5:14; JHN 8:15; JHN 5:22; JHN 3:17; ISA 1:16-18; LUK 15:7\x*
\p
\v 12 \w De novo|strong="G3825"\w* \w então|strong="G3767"\w* \w lhes falou|strong="G846,G2980"\w* \w Jesus|strong="G3588,G2424"\w*, \w dizendo|strong="G3004"\w*: “\w Eu sou|strong="G1473,G1510"\w* \w a luz|strong="G3588,G5457"\w* \w do mundo|strong="G3588,G2889"\w*; \w aquele que me segue|strong="G3588,G190,G1473"\w* \w de modo algum|strong="G3756,G3361"\w* \w andará|strong="G4043"\w* \w na escuridão|strong="G1722,G3588,G4653"\w*, \w mas|strong="G235"\w* \w terá|strong="G2192"\w* \w a luz|strong="G3588,G5457"\w* \w da vida|strong="G3588,G2222"\w*.”\x - \xo 8:12 \xt JHN 12:46; JHN 12:35; JHN 9:5; JHN 1:4; 1JN 1:5; EPH 5:8\x*
\v 13 \w Disseram-lhe|strong="G2036,G846"\w* \w então|strong="G3767"\w* \w os fariseus|strong="G3588,G5330"\w*: “\w Você|strong="G4771"\w* \w dá testemunho|strong="G3140"\w* \w a respeito de si mesmo|strong="G4012,G4771"\w*; \w o seu|strong="G3588,G4771"\w* \w testemunho|strong="G3141"\w* \w não|strong="G3756"\w* \w é|strong="G1510"\w* \w verdadeiro|strong="G227"\w*.”\x - \xo 8:13 \xt JHN 5:31; JHN 21:24; JHN 5:32; JHN 19:35; 1JN 5:9; 3JN 1:12\x*
\v 14 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: \add “Ainda\add* \w que|strong="G1437,G2532"\w* \w eu|strong="G1473"\w* \w dê testemunho|strong="G3140"\w* \w a respeito de mim mesmo|strong="G4012,G1473"\w*, \w verdadeiro|strong="G227"\w* \w é|strong="G1510"\w* \w o meu|strong="G3588,G3165"\w* \w testemunho|strong="G3141"\w*, \w porque|strong="G3754"\w* \w sei|strong="G6063"\w* \w de onde|strong="G4159"\w* \w vim|strong="G2064"\w* \w e|strong="G2532"\w* \w para onde|strong="G4226"\w* \w vou|strong="G5217"\w*; \w vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w não|strong="G3756"\w* \w sabem|strong="G6063"\w* \w de onde|strong="G4159"\w* \w venho|strong="G2064"\w* \w ou|strong="G2228"\w* \w para onde|strong="G4226"\w* \w vou|strong="G5217"\w*.\f + \fr 8.14: \ft Acréscimo: “Ainda” (em “lhes disse Ainda que eu”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 8:14 \xt JHN 5:31; JHN 21:24; JHN 3:11; JHN 5:32; JHN 19:35; LUK 20:7\x*
\v 15 \w Vocês|strong="G4771"\w* \w julgam|strong="G2919"\w* \w segundo a carne|strong="G2596,G3588,G4561"\w*; \w eu|strong="G1473"\w* \w não|strong="G3756"\w* \w julgo|strong="G2919"\w* \w ninguém|strong="G3762"\w*.\f + \fr 8.15: \ft Lit.: Κατὰ τὴν σάρκα, “segundo a carne”: segundo critérios humanos, pela aparência.\f*\x - \xo 8:15 \xt JHN 8:11; JHN 5:30; JHN 5:22; JHN 3:17; ISA 11:3; 1SA 16:7\x*
\v 16 \w E|strong="G2532"\w* \w se eu julgo|strong="G1437,G2919,G1473"\w* \w o meu|strong="G3588,G1473"\w* \w julgamento|strong="G2920"\w* \w é verdadeiro|strong="G228,G1510"\w*, \w porque|strong="G3754"\w* \w sozinho|strong="G3441"\w* \w não|strong="G3756"\w* \w estou|strong="G1510"\w*, \w mas|strong="G235"\w* \w eu|strong="G1473"\w* \w e|strong="G2532"\w* \w o Pai|strong="G3588,G3962"\w* \w que me enviou|strong="G3992,G3165"\w*.\f + \fr 8.16: \ft Variante: o RP traz ἀληθής (“verdadeiro”) em lugar de ἀληθινή (“verdadeiro, autêntico”).\f*\x - \xo 8:16 \xt JHN 5:30; JHN 5:22; JHN 8:29; JHN 3:17; ISA 11:3; JHN 16:32\x*
\v 17 \w E|strong="G2532"\w* \w na lei|strong="G1722,G3588,G3551"\w* \w de vocês|strong="G3588,G4771"\w* \w está escrito|strong="G1125"\w* \w que|strong="G3754"\w* \w o testemunho|strong="G3588,G3141"\w* \w de duas pessoas|strong="G1417,G444"\w* \w é|strong="G1510"\w* \w verdadeiro|strong="G227"\w*.\f + \fr 8.17: \ft Nota cultural: cf. Dt 19:15 (e Dt 17:6): a exigência de dois ou três testemunhas.\f*\x - \xo 8:17 \xt DEU 19:15; DEU 17:6; JHN 5:32; JHN 21:24; JHN 5:31; JHN 3:33\x*
\v 18 \w Eu sou|strong="G1473,G1510"\w* \w aquele que dá testemunho|strong="G3588,G3140"\w* \w a respeito de mim mesmo|strong="G4012,G1473"\w*, \w e|strong="G2532"\w* \w dá testemunho|strong="G3140"\w* \w a meu respeito|strong="G4012,G1473"\w* \w o Pai|strong="G3588,G3962"\w* \w que me enviou|strong="G3992,G3165"\w*.”\x - \xo 8:18 \xt JHN 5:37; 2CO 13:1; 1JN 5:9; JHN 6:27; JHN 8:38; JHN 8:58\x*
\v 19 \w Diziam-lhe|strong="G3004,G846"\w* \w então|strong="G3767"\w*: “\w Onde|strong="G4226"\w* \w está|strong="G1510"\w* \w o seu|strong="G3588,G4771"\w* \w pai|strong="G3962"\w*?” \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w*: “\w Nem|strong="G3777"\w* \w a mim|strong="G1473"\w* \w conhecem|strong="G6063"\w* \w nem|strong="G3777"\w* \w o meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w*; \w se|strong="G1487"\w* \w a mim|strong="G1473"\w* \w conhecessem|strong="G1492"\w*, \w também|strong="G2532"\w* \w o meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w* \w conheceriam|strong="G302,G1492"\w*.”\x - \xo 8:19 \xt JHN 16:3; JHN 8:54-55; JHN 14:7; JHN 14:6-9; 1JN 2:23; 2CO 4:4-6\x*
\v 20 \w Estas palavras|strong="G3778,G3588,G4487"\w* \w falou|strong="G2980"\w* \w no tesouro|strong="G1722,G3588,G1049"\w*, \w ensinando|strong="G1321"\w* \w no templo|strong="G1722,G3588,G2411"\w*; \w e|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w o prendeu|strong="G4084,G846"\w*, \w porque|strong="G3754"\w* \w ainda não|strong="G3768"\w* \w tinha chegado|strong="G2064"\w* \w a hora|strong="G3588,G5610"\w* \w dele|strong="G846"\w*.\f + \fr 8.20: \ft Nota cultural: γαζοφυλάκιον, “tesouro”: a área do templo onde ficavam os cofres das ofertas (cf. Mc 12:41).\f*\f + \fr 8.20: \ft Variante: o RP acrescenta “Jesus” (ὁ Ἰησοῦς) depois de “falou”.\f*\x - \xo 8:20 \xt MRK 12:41; JHN 7:6; JHN 7:30; JHN 2:4; JHN 7:44; LUK 21:1\x*
\v 21 \w Disse|strong="G2036"\w* \w então|strong="G3767"\w* \w de novo|strong="G3825"\w* \w a eles|strong="G846"\w*: “\w Eu|strong="G1473"\w* \add vou\add* \w embora|strong="G5217"\w* \w e|strong="G2532"\w* \w vocês me procurarão|strong="G2212,G3165"\w*, \w e|strong="G2532"\w* \w no pecado|strong="G1722,G3588,G266"\w* \w de vocês|strong="G4771"\w* \w morrerão|strong="G599"\w*; \w para onde|strong="G3699"\w* \w eu|strong="G1473"\w* \w vou|strong="G5217"\w* \w vocês|strong="G4771"\w* \w não|strong="G3756"\w* \w podem|strong="G1410"\w* \w vir|strong="G2064"\w*.”\f + \fr 8.21: \ft Acréscimo: “vou” (em “eles Eu vou embora e”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 8:21 \xt JHN 7:34; JHN 8:24; JHN 13:33; JHN 7:36; ISA 55:6; REV 22:11\x*
\v 22 \w Diziam|strong="G3004"\w* \w então|strong="G3767"\w* \w os judeus|strong="G3588,G2453"\w*: “\w Será que|strong="G3385"\w* \w vai matar|strong="G615"\w* \w a si mesmo|strong="G1438"\w*, \w porque|strong="G3754"\w* \w diz|strong="G3004"\w*: ‘\w Para onde|strong="G3699"\w* \w eu|strong="G1473"\w* \w vou|strong="G5217"\w* \w vocês|strong="G4771"\w* \w não|strong="G3756"\w* \w podem|strong="G1410"\w* \w vir|strong="G2064"\w*’?”\f + \fr 8.22: \ft Acréscimo: verbo ser/estar suprido em “Será que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 8:22 \xt JHN 13:33; JHN 7:34; JHN 8:52; PSA 22:6; EZK 33:6; HEB 12:3\x*
\v 23 \w E|strong="G2532"\w* \w lhes dizia|strong="G3004,G846"\w*: “\w Vocês|strong="G4771"\w* \w são|strong="G1510"\w* \w de baixo|strong="G1537,G3588,G2736"\w*, \w eu|strong="G1473"\w* \w sou|strong="G1510"\w* \w de cima|strong="G1537,G3588,G507"\w*; \w vocês|strong="G4771"\w* \w são|strong="G1510"\w* \w deste mundo|strong="G1537,G3778,G3588,G2889"\w*, \w eu|strong="G1473"\w* \w não|strong="G3756"\w* \w sou|strong="G1510"\w* \w deste mundo|strong="G1537,G3588,G2889,G3778"\w*.\x - \xo 8:23 \xt JHN 3:31; 1JN 4:5; JHN 17:14; 1JN 2:15-16; JHN 16:9; JHN 17:16\x*
\v 24 \w Disse|strong="G2036"\w* \w então|strong="G3767"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w morrerão|strong="G599"\w* \w nos pecados|strong="G1722,G3588,G266"\w* \w de vocês|strong="G4771"\w*; \w pois|strong="G1063"\w* \w se não|strong="G1437,G3361"\w* \w crerem|strong="G4100"\w* \w que|strong="G3754"\w* \w eu sou|strong="G1473,G1510"\w*, \w morrerão|strong="G599"\w* \w nos pecados|strong="G1722,G3588,G266"\w* \w de vocês|strong="G4771"\w*.”\f + \fr 8.24: \ft Lit.: Ἐγώ εἰμι, sem predicado: “eu sou” (cf. 8:28, 58; 13:19), ecoando a fórmula divina de Is 43:10 LXX; também se pode ler “sou eu (aquele de quem falo)”.\f*\x - \xo 8:24 \xt ISA 43:10; JHN 16:9; MRK 16:16; JHN 8:21; ROM 6:7; JHN 11:26\x*
\v 25 \w Diziam-lhe|strong="G3004,G846"\w* \w então|strong="G3767"\w*: “\w Quem|strong="G5101"\w* \w é|strong="G1510"\w* \w você|strong="G4771"\w*?” \w Disse-lhes|strong="G2036,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w O que|strong="G3739,G5100"\w* \w desde o princípio|strong="G3588,G746"\w* \w também|strong="G2532"\w* \w lhes venho dizendo|strong="G2980,G4771"\w*.\f + \fr 8.25: \ft Lit.: Τὴν ἀρχὴν ὅ τι καὶ λαλῶ ὑμῖν: frase de sentido muito discutido; possibilidades: “o que desde o princípio também lhes digo”, “primeiramente (sou) o que lhes digo”, “por que, afinal, ainda lhes falo?”.\f*\f + \fr 8.25: \ft Variante: WH traz ὅτι (“que, porque”) em lugar de ὅ τι (“o que”); o RP acrescenta “e” (καί) no início de “disse”.\f*\x - \xo 8:25 \xt JHN 5:17-29; JHN 8:18; 1JN 2:24; JHN 1:22; JHN 10:24; JHN 8:12\x*
\v 26 \w Muitas coisas|strong="G4183"\w* \w tenho|strong="G2192"\w* \w a falar|strong="G2980"\w* \w a respeito de vocês|strong="G4012,G4771"\w* \w e|strong="G2532"\w* \w a julgar|strong="G2919"\w*; \w mas|strong="G235"\w* \w aquele que me enviou|strong="G3588,G3992,G3165"\w* \w é|strong="G1510"\w* \w verdadeiro|strong="G227"\w*, \w e eu|strong="G2532_B,G1473"\w* \w o que|strong="G3739"\w* \w ouvi|strong="G191"\w* \w da parte dele|strong="G3844,G846"\w*, \w isso|strong="G3778"\w* \w falo|strong="G2980"\w* \w ao mundo|strong="G1519,G3588,G2889"\w*\f + \fr 8.26: \ft Variante: o RP traz λέγω (“digo”) em lugar de λαλῶ (“falo”).\f*.”\x - \xo 8:26 \xt JHN 7:28; JHN 12:49; JHN 15:15; JHN 8:40; REV 1:1; JHN 12:47\x*
