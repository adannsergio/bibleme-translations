\v 37 \w e|strong="G2532"\w* \w o Pai|strong="G3962"\w* \w que me enviou|strong="G3588,G3992,G3165"\w*, \w esse|strong="G1565"\w* \w deu testemunho|strong="G3140"\w* \w a meu respeito|strong="G4012,G1473"\w*. \w Nem a voz|strong="G3777,G5456"\w* \w dele|strong="G846"\w* \w jamais|strong="G4455"\w* \w ouviram|strong="G191"\w*, \w nem a forma|strong="G3777,G1491"\w* \w dele|strong="G846"\w* \w viram|strong="G3708"\w*,\x - \xo 5:37 \xt JHN 8:18; JHN 1:18; JHN 3:11; 2PE 1:17; JHN 6:27; 1JN 4:14\x*
\v 38 \w e|strong="G2532"\w* \w vocês não têm|strong="G3756,G2192"\w* \w a palavra|strong="G3588,G3056"\w* \w dele|strong="G846"\w* \w permanecendo|strong="G3306"\w* \w em vocês|strong="G1722,G4771"\w*, \w porque|strong="G3754"\w* \w naquele que|strong="G3739,G3778"\w* \w ele|strong="G1565"\w* \w enviou|strong="G649"\w*, \w vocês|strong="G4771"\w* \w não creem|strong="G3756,G4100"\w*.\x - \xo 5:38 \xt 1JN 4:16; JHN 6:29; JHN 14:10; JHN 8:31; JHN 6:45; JHN 3:17\x*
\v 39 \w Vocês examinam|strong="G2045"\w* \w as Escrituras|strong="G3588,G1124"\w*\f + \fr 5.39: \ft Lit.: Ἐραυνᾶτε: indicativo (“vocês examinam”) ou imperativo (“examinem”).\f*, \w porque|strong="G3754"\w* \w vocês|strong="G4771"\w* \w pensam|strong="G1380"\w* \w ter|strong="G2192"\w* \w nelas|strong="G1722,G846"\w* \w vida|strong="G2222"\w* \w eterna|strong="G166"\w*; \w e|strong="G2532"\w* \w são elas|strong="G1565,G1510,G3588"\w* \w que dão testemunho|strong="G3140"\w* \w a meu respeito|strong="G4012,G1473"\w*;\x - \xo 5:39 \xt 1JN 2:25; LUK 24:27; LUK 24:44; 2PE 1:19; ACT 26:22; ACT 17:11\x*
\v 40 \w e|strong="G2532"\w* \w não querem|strong="G3756,G2309"\w* \w vir|strong="G2064"\w* \w a mim|strong="G4314,G3165"\w* \w para que|strong="G2443"\w* \w tenham|strong="G2192"\w* \w vida|strong="G2222"\w*.\x - \xo 5:40 \xt REV 22:17; JHN 6:45; ISA 30:15; JHN 6:35; JHN 3:19; JHN 6:68\x*
\v 41 \w Glória|strong="G1391"\w* \w da parte de seres humanos|strong="G3844,G444"\w* \w não|strong="G3756"\w* \w recebo|strong="G2983"\w*,\x - \xo 5:41 \xt JHN 5:44; JHN 12:43; JHN 7:18; MAT 6:2; JHN 8:50; 1TH 2:6\x*
\v 42 \w mas|strong="G235"\w* \w conheço|strong="G1097"\w* \w vocês|strong="G4771"\w*: \w que|strong="G3754"\w* \w o amor|strong="G3588,G26"\w* \w de Deus|strong="G3588,G2316"\w* \w não|strong="G3756"\w* \w têm|strong="G2192"\w* \w em si mesmos|strong="G1722,G1438"\w*.\f + \fr 5.42: \ft Lit.: Ἀγάπη τοῦ θεοῦ, genitivo: “o amor a Deus” ou “o amor de Deus (por eles)”.\f*\x - \xo 5:42 \xt 1JN 4:8; JHN 13:35; 1JN 4:16; MRK 7:6; 1JN 3:16; 1JN 4:7\x*
