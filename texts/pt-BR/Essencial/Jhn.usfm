\v 30 \w Não|strong="G3756"\w* \w posso|strong="G1410"\w* \w eu|strong="G1473"\w* \w fazer|strong="G4160"\w* \w por mim mesmo|strong="G575,G1473"\w* \w nada|strong="G3762"\w*; \w como ouço|strong="G2531,G191"\w* \w julgo|strong="G2919"\w*, \w e|strong="G2532"\w* \w o meu|strong="G3588,G1473"\w* \w julgamento|strong="G2920"\w* \w justo|strong="G1342"\w* \w é|strong="G1510"\w*, \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w busco|strong="G2212"\w* \w a minha|strong="G3588,G1473"\w* \w vontade|strong="G2307"\w* \w mas|strong="G235"\w* \w a vontade|strong="G3588,G2307"\w* \w daquele que me enviou|strong="G3588,G3992,G3165"\w*.\f + \fr 5.30: \ft Variante: o RP acrescenta “Pai” (πατρός) depois de “me enviou”.\f*\x - \xo 5:30 \xt JHN 6:38; JHN 8:16; JHN 8:15; JHN 8:50; JHN 5:22; JHN 4:34\x*
