\v 6 \w Quando|strong="G5613"\w* \w então|strong="G3767"\w* \w ouviu|strong="G191"\w* \w que|strong="G3754"\w* \w estava doente|strong="G770"\w*, \w então|strong="G5119"\w* \w de fato|strong="G3303"\w* \w ficou|strong="G3306"\w* \w no lugar|strong="G1722,G5117"\w* \w em que|strong="G3739"\w* \w estava|strong="G1510"\w* \w dois|strong="G1417"\w* \w dias|strong="G2250"\w*;\x - \xo 11:6 \xt ISA 30:18; ISA 55:8-9; LUK 7:36; JHN 11:1; MAT 8:24\x*
