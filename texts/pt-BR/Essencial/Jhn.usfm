\v 1 \w Havia|strong="G1510"\w* \w um certo|strong="G5100"\w* \w doente|strong="G770"\w*, \w Lázaro|strong="G2976"\w*, \w de Betânia|strong="G575,G963"\w*, \w da aldeia|strong="G1537,G3588,G2968"\w* \w de Maria|strong="G3137"\w* \w e|strong="G2532"\w* \w de Marta|strong="G3136"\w*, \w irmã|strong="G3588,G79"\w* \w dela|strong="G846"\w*.\x - \xo 11:1 \xt JHN 11:5; LUK 10:38; JHN 12:1; JHN 11:3; JHN 12:17; MAT 26:6\x*
\v 2 \w Era|strong="G1510"\w* \w Maria|strong="G3137"\w* \w aquela que ungiu|strong="G3588,G218"\w* \w o Senhor|strong="G3588,G2962"\w* \w com perfume|strong="G3464"\w* \w e|strong="G2532"\w* \w enxugou|strong="G1591"\w* \w os pés|strong="G3588,G4228"\w* \w dele|strong="G846"\w* \w com os cabelos|strong="G3588,G2359"\w* \w dela|strong="G846"\w*, \w cujo irmão|strong="G3739,G3588,G80"\w* \w Lázaro|strong="G2976"\w* \w estava doente|strong="G770"\w*.\f + \fr 11.2: \ft Nota cultural: alude à unção narrada em 12:1-8, ainda futura na narrativa.\f*\x - \xo 11:2 \xt JHN 12:3; LUK 7:38; LUK 10:38; MRK 14:3; MAT 26:6; LUK 7:37\x*
\v 3 \w Mandaram|strong="G649"\w* \w então|strong="G3767"\w* \w as irmãs|strong="G3588,G79"\w* \w até ele|strong="G4314,G846"\w* \w dizer|strong="G3004"\w*: “\w Senhor|strong="G2962"\w*, \w veja|strong="G2396"\w*: \w aquele a quem|strong="G3739"\w* \w você ama|strong="G5368"\w* \w está doente|strong="G770"\w*.”\f + \fr 11.3: \ft Lit.: Φιλέω, “amar (com afeição de amigo)”; no v. 5 aparece ἀγαπάω; João usa os dois verbos para o amor de Jesus por Lázaro.\f*\x - \xo 11:3 \xt JHN 11:36; JHN 11:1; LUK 10:38; JHN 11:5; REV 3:19; 2KI 13:14\x*
\v 4 \w Ouvindo|strong="G191"\w* \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Esta doença|strong="G3778,G3588,G769"\w* \w não|strong="G3756"\w* \w é|strong="G1510"\w* \w para a morte|strong="G4314,G2288"\w*, \w mas|strong="G235"\w* \w em favor|strong="G5228"\w* \w da glória|strong="G3588,G1391"\w* \w de Deus|strong="G3588,G2316"\w*, \w para que|strong="G2443"\w* \w seja glorificado|strong="G1392"\w* \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w* \w por meio dela|strong="G1223,G846"\w*.”\x - \xo 11:4 \xt JHN 8:54; JHN 17:5; JHN 9:3; PSA 118:17; JHN 11:40; 1PE 4:14\x*
