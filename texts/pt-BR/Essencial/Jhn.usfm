\v 29 \w Disseram|strong="G3004"\w* \w os seus|strong="G3588,G846"\w* \w discípulos|strong="G3101"\w*: “\w Veja|strong="G2396"\w*, \w agora|strong="G3568"\w* \w abertamente|strong="G1722,G3954"\w* \w você fala|strong="G2980"\w*, \w e|strong="G2532"\w* \w nenhuma|strong="G3762"\w* \w comparação|strong="G3942"\w* \w diz|strong="G3004"\w*.\f + \fr 16.29: \ft Variante: o RP acrescenta “lhe” (αὐτῷ) depois de “Disseram” e omite “em” (ἐν) diante de “abertamente”.\f*\x - \xo 16:29 \xt JHN 16:25; JHN 3:13; JHN 14:29; MRK 8:32; MAT 10:27; 2CO 3:12\x*
\v 30 \w Agora|strong="G3568"\w* \w sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w sabe|strong="G6063"\w* \w tudo|strong="G3956"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w tem|strong="G2192"\w* \w necessidade|strong="G5532"\w* \w de que alguém|strong="G2443,G5100"\w* \w lhe pergunte|strong="G4771,G2065"\w*; \w nisto|strong="G1722,G3778"\w* \w cremos|strong="G4100"\w* \w que|strong="G3754"\w* \w da parte|strong="G575"\w* \w de Deus|strong="G2316"\w* \w saiu|strong="G1831"\w*.”\x - \xo 16:30 \xt JHN 16:27; JHN 17:20; JHN 17:8; JHN 2:24; JHN 21:17; JHN 3:13\x*
