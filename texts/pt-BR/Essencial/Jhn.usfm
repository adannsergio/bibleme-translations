\v 27 \w aquele que vem|strong="G3588,G2064"\w* \w depois de mim|strong="G3694,G3165"\w*, \w de quem|strong="G3739"\w* \w não sou|strong="G3756,G1510"\w* \w digno|strong="G514"\w* \w de desamarrar|strong="G2443,G3089"\w* \w dele|strong="G846"\w* \w a correia|strong="G3588,G2438"\w* \w da sandália|strong="G3588,G5266"\w*.”\f + \fr 1.27: \ft Variante: WH omite o artigo ὁ no início; o RP acrescenta “é ele quem” (αὐτός ἐστιν ὁ) antes de “depois de mim” e “que passou à minha frente” (ὃς ἔμπροσθέν μου γέγονεν) depois de “vem”. O SBLGNT, que segue Holmes e a margem de WH, traz “não sou digno” sem “eu” (ἐγώ), que WH, Treg, NA28 e o RP trazem em posições diferentes.\f*\x - \xo 1:27 \xt MRK 1:7; LUK 3:16; ACT 13:25; MAT 3:11; MAT 8:8; LUK 1:17\x*
\v 28 \w Estas coisas|strong="G3778"\w* \w aconteceram|strong="G1096"\w* \w em Betânia|strong="G1722,G963"\w* \w do outro lado|strong="G4008"\w* \w do Jordão|strong="G3588,G2446"\w*, \w onde|strong="G3699"\w* \w estava|strong="G1510"\w* \w João|strong="G3588,G2491"\w* \w batizando|strong="G907"\w*.\x - \xo 1:28 \xt JHN 10:40; JHN 3:26; MAT 3:6; LUK 1:17; JHN 3:23; LUK 3:4\x*
\p
\v 29 \w No dia seguinte|strong="G3588,G1887"\w* \w viu|strong="G991"\w*\f + \fr 1.29: \ft Lit.: Βλέπει, λέγει: presente histórico, traduzido no pretérito ao longo do livro.\f* \w Jesus|strong="G3588,G2424"\w* \w vindo|strong="G2064"\w* \w até ele|strong="G4314,G846"\w*, \w e|strong="G2532"\w* \w disse|strong="G3004"\w*: “\w Vejam|strong="G2396"\w*: \w o Cordeiro|strong="G3588,G286"\w* \w de Deus|strong="G3588,G2316"\w*, \w que tira|strong="G3588,G142"\w* \w o pecado|strong="G3588,G266"\w* \w do mundo|strong="G3588,G2889"\w*!”\f + \fr 1.29: \ft Lit.: Αἴρω, “levantar, carregar, tirar”.\f*\x - \xo 1:29 \xt 1JN 3:5; JHN 1:36; JHN 3:16; ISA 53:7; 1JN 2:2; 1PE 1:19\x*
\v 30 \w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w aquele a respeito de quem|strong="G5228,G3739"\w* \w eu|strong="G1473"\w* \w disse|strong="G2036"\w*: ‘\w Depois de mim|strong="G3694,G3165"\w* \w vem|strong="G2064"\w* \w um homem|strong="G435"\w* \w que passou à minha frente|strong="G3739,G1715,G3165,G1096"\w*, \w porque|strong="G3754"\w* \w era antes de mim|strong="G4413,G3165,G1510"\w*.’\x - \xo 1:30 \xt JHN 1:15; LUK 1:17; JHN 1:27; LUK 3:4; ACT 19:4; LUK 3:16\x*
\v 31 \w Eu também|strong="G2532,G1473"\w* \w não o|strong="G3756,G846"\w* \w conhecia|strong="G1492"\w*, \w mas|strong="G235"\w* \w para que|strong="G2443"\w* \w fosse manifestado|strong="G5319"\w* \w a Israel|strong="G3588,G2474"\w*, \w por isso|strong="G1223,G3778"\w* \w vim|strong="G2064"\w* \w eu|strong="G1473"\w* \w batizando|strong="G907"\w* \w com água|strong="G1722,G5204"\w*.”\x - \xo 1:31 \xt ACT 1:5; MRK 1:8; MAT 3:16; JHN 1:33; LUK 3:4; MAL 3:1\x*
\v 32 \w E|strong="G2532"\w* \w testemunhou|strong="G3140"\w* \w João|strong="G2491"\w*, \w dizendo|strong="G3004"\w*: “\w Contemplei|strong="G2300"\w* \w o Espírito|strong="G3588,G4151"\w* \w descendo|strong="G2597"\w* \w como pomba|strong="G5613,G4058"\w* \w do céu|strong="G1537,G3772"\w*, \w e|strong="G2532"\w* \w permaneceu|strong="G3306"\w* \w sobre ele|strong="G1909,G846"\w*;\x - \xo 1:32 \xt MRK 1:10; LUK 3:22; MAT 3:16; ISA 61:1; LUK 3:21; ISA 11:2\x*
\v 33 \w eu também|strong="G2532_A,G1473"\w* \w não o|strong="G3756,G846"\w* \w conhecia|strong="G1492"\w*, \w mas|strong="G235"\w* \w aquele que me enviou|strong="G3588,G3992,G3165"\w* \w para batizar|strong="G907"\w* \w com água|strong="G1722,G5204"\w* \w esse|strong="G1565"\w* \w me disse|strong="G3165,G2036"\w*: ‘\w Aquele sobre quem|strong="G1909,G3739,G302"\w* \w você vir|strong="G1492"\w* \w o Espírito|strong="G3588,G4151"\w* \w descendo|strong="G2597"\w* \w e|strong="G2532"\w* \w permanecendo|strong="G3306"\w* \w sobre ele|strong="G1909,G846"\w*, \w esse é|strong="G3778,G1510"\w* \w o que batiza|strong="G3588,G907"\w* \w no Espírito|strong="G1722,G4151"\w* \w Santo|strong="G40"\w*.’\x - \xo 1:33 \xt ACT 1:5; MAT 3:16; MRK 1:8; JHN 1:31; ACT 11:16; ISA 61:1\x*
\v 34 \w Eu mesmo|strong="G2532_A,G1473"\w* \w vi|strong="G3708"\w*, \w e|strong="G2532"\w* \w dei testemunho|strong="G3140"\w* \w de que|strong="G3754"\w* \w este é|strong="G3778,G1510"\w* \w o Escolhido|strong="G3588,G1588"\w* \w de Deus|strong="G3588,G2316"\w*.”\f + \fr 1.34: \ft Variante: o SBLGNT, seguindo Holmes e a margem de WH, traz “o Escolhido” (ἐκλεκτός); WH, Treg, NA28 e o RP trazem “o Filho” (υἱός).\f*\x - \xo 1:34 \xt LUK 3:21; MAT 3:16; PSA 2:7; JHN 1:49; JHN 1:7; LUK 1:35\x*
\p
\v 35 \w No dia seguinte|strong="G3588,G1887"\w* \w novamente|strong="G3825"\w* \w estava de pé|strong="G2476"\w* \w João|strong="G3588,G2491"\w* \w e|strong="G2532"\w* \w dois|strong="G1417"\w* \w dos discípulos|strong="G1537,G3588,G3101"\w* \w dele|strong="G846"\w*,\x - \xo 1:35 \xt LUK 3:4; MAL 3:16; JHN 3:25-26; JHN 1:43; JHN 3:26; MRK 11:30\x*
\v 36 \w e|strong="G2532"\w*, \w fixando o olhar|strong="G1689"\w* \w em Jesus|strong="G3588,G2424"\w* \w que andava|strong="G4043"\w*, \w disse|strong="G3004"\w*: “\w Vejam|strong="G2396"\w*: \w o Cordeiro|strong="G3588,G286"\w* \w de Deus|strong="G3588,G2316"\w*!”\x - \xo 1:36 \xt JHN 1:29; 1PE 1:19; GEN 22:8; REV 5:6; JHN 1:7; LEV 1:3\x*
\v 37 \w E|strong="G2532"\w* \w os dois|strong="G3588,G1417"\w* \w discípulos|strong="G3101"\w* \w o ouviram|strong="G191,G846"\w* \w falar|strong="G2980"\w*, \w e|strong="G2532"\w* \w seguiram|strong="G190"\w* \w Jesus|strong="G3588,G2424"\w*.\x - \xo 1:37 \xt JHN 1:40; ROM 10:17; JHN 1:43; REV 22:17; ZEC 8:21; JHN 4:39-42\x*
\v 38 \w Voltando-se|strong="G4762"\w* \w Jesus|strong="G3588,G2424"\w* \w e|strong="G2532"\w* \w vendo-os|strong="G2300,G846"\w* \w seguindo|strong="G190"\w*, \w disse|strong="G3004"\w* \w a eles|strong="G846"\w*: “\w O que|strong="G5101"\w* \w procuram|strong="G2212"\w*?” \w E eles|strong="G3588,G1161"\w* \w lhe disseram|strong="G2036,G846"\w*: “\w Rabi|strong="G4461"\w* (\w que quer dizer|strong="G3739,G3004"\w* \w traduzido|strong="G3177"\w* \w Mestre|strong="G1320"\w*), \w onde|strong="G4226"\w* \w você fica|strong="G3306"\w*?”\f + \fr 1.38: \ft Lit.: Μένω, “ficar, permanecer, morar”; verbo-chave em João.\f*\x - \xo 1:38 \xt JHN 3:2; JHN 18:7; JHN 1:49; JHN 18:4; PRO 8:34; PSA 27:4\x*
\v 39 \w Disse|strong="G3004"\w* \w a eles|strong="G846"\w*: “\w Venham|strong="G2064"\w* \w e|strong="G2532"\w* \w verão|strong="G3700"\w*.” \w Foram|strong="G2064"\w* \w então|strong="G3767"\w* \w e|strong="G2532"\w* \w viram|strong="G1492"\w* \w onde|strong="G4226"\w* \w fica|strong="G3306"\w*, \w e|strong="G2532"\w* \w ficaram|strong="G3306"\w* \w com ele|strong="G3844,G846"\w* \w naquele dia|strong="G3588,G2250,G1565"\w*; \w era|strong="G1510"\w* \w a hora|strong="G5610"\w* \w cerca da|strong="G5613"\w* \w décima|strong="G1182"\w*.\f + \fr 1.39: \ft Nota cultural: As horas do dia eram contadas a partir do nascer do sol; a “décima hora” seria no fim da tarde. O texto não dá um horário de relógio.\f*\f + \fr 1.39: \ft Variante: o RP traz ἴδετε (“vejam”) em lugar de ὄψεσθε (“verão”), e outra pontuação antes de “foram”.\f*\x - \xo 1:39 \xt LUK 24:29; MAT 11:28-30; JHN 6:37; JHN 1:46; JHN 4:40; PRO 8:17\x*
\v 40 \w Era|strong="G1510"\w* \w André|strong="G406"\w*, \w o irmão|strong="G3588,G80"\w* \w de Simão|strong="G4613"\w* \w Pedro|strong="G4074"\w*, \w um|strong="G1520"\w* \w dos dois|strong="G1537,G3588,G1417"\w* \w que ouviram|strong="G3588,G191"\w* \w da parte de João|strong="G3844,G2491"\w* \w e|strong="G2532"\w* \w o seguiram|strong="G190,G846"\w*.\x - \xo 1:40 \xt JHN 6:8; MAT 4:18; MAT 10:2; MRK 1:16; LUK 6:14; ACT 1:13\x*
\v 41 \w Este|strong="G3778"\w* \w encontrou|strong="G2147"\w* \w primeiro|strong="G4413"\w* \w o seu próprio|strong="G3588,G2398"\w* \w irmão|strong="G80"\w* \w Simão|strong="G4613"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Encontramos|strong="G2147"\w* \w o Messias|strong="G3588,G3323"\w* (\w que significa|strong="G3739,G1510"\w* \w traduzido|strong="G3177"\w* \w Cristo|strong="G5547"\w*).”\f + \fr 1.41: \ft Variante: o RP traz πρῶτος (“sendo o primeiro”) em lugar de πρῶτον (“primeiro”).\f*\x - \xo 1:41 \xt ISA 61:1; MAT 4:18; LUK 4:18; JHN 4:25; JHN 1:45; LUK 2:11\x*
\v 42 \w Levou-o|strong="G71,G846"\w* \w até|strong="G4314"\w* \w Jesus|strong="G3588,G2424"\w*. \w Fixando o olhar|strong="G1689"\w* \w nele|strong="G846"\w*, \w Jesus|strong="G3588,G2424"\w* \w disse|strong="G2036"\w*: “\w Você|strong="G4771"\w* \w é|strong="G1510"\w* \w Simão|strong="G4613"\w*, \w o filho|strong="G3588,G5207"\w* \w de João|strong="G2491"\w*; \w você|strong="G4771"\w* \w será chamado|strong="G2564"\w* \w Cefas|strong="G2786"\w* (\w que se traduz|strong="G3739,G2059"\w* \w Pedro|strong="G4074"\w*\f + \fr 1.42: \ft Variante: o RP traz “E” (καί) antes de “levou” e “Jonas” (Ἰωνᾶ) em lugar de “João” (Ἰωάννου).\f*\f + \fr 1.42: \ft Lit.: Κηφᾶς, “Cefas”, forma aramaica; πέτρος, “pedra” em grego.\f*).”\x - \xo 1:42 \xt MAT 16:18; MAT 4:18; 1CO 3:22; JHN 21:15-17; 1CO 15:5; MRK 1:16\x*
\p
\v 43 \w No dia seguinte|strong="G3588,G1887"\w* \w quis|strong="G2309"\w* \w sair|strong="G1831"\w* \w para a Galileia|strong="G1519,G3588,G1056"\w*. \w E|strong="G2532"\w* \w encontrou|strong="G2147"\w* \w Filipe|strong="G5376"\w*, \w e|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Siga-me|strong="G190,G3165"\w*.”\x - \xo 1:43 \xt JHN 12:21; MAT 4:19; ISA 65:1; JHN 14:8; MAT 9:9; JHN 1:37\x*
\v 44 \w Filipe|strong="G3588,G5376"\w* \w era|strong="G1510"\w* \w de Betsaida|strong="G575,G966"\w*, \w da cidade|strong="G1537,G3588,G4172"\w* \w de André|strong="G406"\w* \w e|strong="G2532"\w* \w de Pedro|strong="G4074"\w*.\x - \xo 1:44 \xt JHN 12:21; JHN 6:8; JHN 12:22; LUK 6:14; JHN 14:8; MAT 11:21\x*
\v 45 \w Filipe|strong="G5376"\w* \w encontrou|strong="G2147"\w* \w Natanael|strong="G3588,G3482"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Aquele sobre quem|strong="G3739"\w* \w Moisés|strong="G3475"\w* \w escreveu|strong="G1125"\w* \w na lei|strong="G1722,G3588,G3551"\w* \w e|strong="G2532"\w* \w os profetas|strong="G3588,G4396"\w*, \w encontramos|strong="G2147"\w*: \w Jesus|strong="G2424"\w*, \w filho|strong="G5207"\w* \w de José|strong="G3588,G2501"\w*, \w o de|strong="G3588,G575"\w* \w Nazaré|strong="G3478"\w*.”\x - \xo 1:45 \xt LUK 24:44; MAT 21:11; DEU 18:18; JHN 5:46; DEU 18:15; MIC 5:2\x*
\v 46 \w E|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w* \w Natanael|strong="G3482"\w*: “\w De Nazaré|strong="G1537,G3478"\w* \w pode|strong="G1410"\w* \w haver|strong="G1511"\w* \w alguma coisa|strong="G5100"\w* \w boa|strong="G18"\w*?” \w Filipe|strong="G3588,G5376"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Venha|strong="G2064"\w* \w e|strong="G2532"\w* \w veja|strong="G1492"\w*.”\x - \xo 1:46 \xt LUK 11:9; JHN 7:52; JHN 7:41; JHN 4:29; JHN 1:45; JHN 1:39\x*
\v 47 \w Jesus|strong="G3588,G2424"\w* \w viu|strong="G1492"\w* \w Natanael|strong="G3588,G3482"\w* \w vindo|strong="G2064"\w* \w até ele|strong="G4314,G846"\w* \w e|strong="G2532"\w* \w disse|strong="G3004"\w* \w a respeito dele|strong="G4012,G846"\w*: “\w Vejam|strong="G2396"\w*: \w verdadeiramente|strong="G230"\w* \w israelita|strong="G2475"\w* \w em quem|strong="G1722,G3739"\w* \w engano|strong="G1388"\w* \w não há|strong="G3756,G1510"\w*.”\x - \xo 1:47 \xt LUK 11:9; PSA 32:2; PSA 119:1; MAT 15:8; EPH 4:15; JHN 1:45\x*
\v 48 \w Natanael|strong="G3482"\w* \w lhe disse|strong="G3004,G846"\w*: “\w De onde|strong="G4159"\w* \w me conhece|strong="G3165,G1097"\w*?” \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Antes de|strong="G4253,G3588"\w* \w Filipe|strong="G5376"\w* \w chamar|strong="G5455"\w* \w você|strong="G4771"\w*, \w estando|strong="G1510"\w* \w debaixo|strong="G5259"\w* \w da figueira|strong="G3588,G4808"\w*, \w vi|strong="G1492"\w* \w você|strong="G4771"\w*.”\x - \xo 1:48 \xt JHN 1:45; LUK 11:9; ISA 65:24; JHN 2:25; MAT 6:6; PSA 139:1-2\x*
\v 49 \w Respondeu|strong="G611"\w* \w a ele|strong="G846"\w* \w Natanael|strong="G3482"\w*: “\w Rabi|strong="G4461"\w*, \w você é|strong="G4771,G1510"\w* \w o Filho|strong="G3588,G5207"\w* \w de Deus|strong="G3588,G2316"\w*, \w você|strong="G4771"\w* \w é rei|strong="G935,G1510"\w* \w de Israel|strong="G3588,G2474"\w*.”\f + \fr 1.49: \ft Variante: o RP traz outra ordem e acrescenta “e disse a ele” (καὶ λέγει αὐτῷ) depois de “Natanael”, além de “é o rei” (εἶ ὁ βασιλεύς).\f*\x - \xo 1:49 \xt LUK 11:9; MAT 16:16; JHN 1:34; LUK 1:35; ZEP 3:15; JHN 1:38\x*
\v 50 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: \add “Você\add* \w crê|strong="G4100"\w* \w porque|strong="G3754"\w* \w eu disse|strong="G2036"\w* \w a você|strong="G4771"\w* \w que|strong="G3754"\w* \w vi|strong="G1492"\w* \w você|strong="G4771"\w* \w debaixo|strong="G5270"\w* \w da figueira|strong="G3588,G4808"\w*? \w Coisas maiores|strong="G3173"\w* \w do que estas|strong="G3778"\w* \w verá|strong="G3708"\w*.”\f + \fr 1.50: \ft Variante: o RP omite o primeiro “porque” (ὅτι).\f*\f + \fr 1.50: \ft Acréscimo: “Você” (em “lhe disse Você crê porque”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 1:50 \xt JHN 11:40; JHN 20:29; JHN 6:36; JHN 2:11; LUK 1:45; MAT 25:29\x*
\v 51 \w E|strong="G2532"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w verão|strong="G3700"\w* \w o céu|strong="G3588,G3772"\w* \w aberto|strong="G455"\w* \w e|strong="G2532"\w* \w os anjos|strong="G3588,G32"\w* \w de Deus|strong="G3588,G2316"\w* \w subindo|strong="G305"\w* \w e|strong="G2532"\w* \w descendo|strong="G2597"\w* \w sobre|strong="G1909"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w*.”\f + \fr 1.51: \ft Nota cultural: Eco de Gênesis 28:12 (a escada de Jacó).\f*\f + \fr 1.51: \ft Lit.: Λέγει αὐτῷ… ὑμῖν: “disse a ele… a vocês (plural)”: a fala passa do singular (Natanael) ao plural.\f*\f + \fr 1.51: \ft Variante: o RP acrescenta “de agora em diante” (ἀπʼ ἄρτι) depois de “a vocês”.\f*\x - \xo 1:51 \xt GEN 28:12; JHN 3:13; MAT 3:16; LUK 22:43; ACT 7:56; JHN 3:3\x*
\c 2
\p
\v 1 \w E|strong="G2532"\w* \w no terceiro dia|strong="G3588,G2250,G5154"\w* \w houve|strong="G1096"\w* \w um casamento|strong="G1062"\w* \w em Caná|strong="G1722,G2580"\w* \w da Galileia|strong="G3588,G1056"\w*, \w e|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w* \w de Jesus|strong="G3588,G2424"\w* \w estava|strong="G1510"\w* \w ali|strong="G1563"\w*;\x - \xo 2:1 \xt JHN 4:46; PRO 31:10-12; JHN 1:43; JHN 21:2; MAT 12:46; PRO 18:22\x*
\v 2 \w e|strong="G1161"\w* \w também|strong="G2532"\w* \w foi convidado|strong="G2564"\w* \w Jesus|strong="G3588,G2424"\w* \w e|strong="G2532"\w* \w os discípulos|strong="G3588,G3101"\w* \w dele|strong="G846"\w* \w para o casamento|strong="G1519,G3588,G1062"\w*.\x - \xo 2:2 \xt MAT 22:3; MAT 22:9; MAT 22:8; REV 19:9; JHN 4:46; LUK 8:24\x*
\v 3 \w E|strong="G2532"\w*, \w tendo faltado|strong="G5302"\w* \w vinho|strong="G3631"\w*, \w a mãe|strong="G3588,G3384"\w* \w de Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G3004,G4314,G846"\w*: “\w Vinho|strong="G3631"\w* \w não têm|strong="G3756,G2192"\w*.”\x - \xo 2:3 \xt PSA 104:15; PHP 4:6; ECC 10:19; ISA 24:11; ISA 55:1; JHN 2:7\x*
\v 4 \w E|strong="G2532"\w* \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G3004,G846"\w*: “\w O que há|strong="G5101"\w* \w entre mim|strong="G1473"\w* \w e|strong="G2532"\w* \w você|strong="G4771"\w*, \w mulher|strong="G1135"\w*\f + \fr 2.4: \ft Lit.: Τί ἐμοὶ καὶ σοί: “que há entre mim e você?”: expressão idiomática que pode marcar distância, recusa ou objeção; o tom depende do contexto. Γύναι, “mulher”: forma de tratamento sem sentido ofensivo no grego.\f*? \w Ainda não|strong="G3768"\w* \w chegou|strong="G2240"\w* \w a minha|strong="G3588,G3165"\w* \w hora|strong="G5610"\w*.”\f + \fr 2.4: \ft Acréscimo: “O que há”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 2:4 \xt JHN 7:6; JHN 7:30; JHN 8:20; JHN 13:1; JHN 12:23; ECC 3:1\x*
\v 5 \w Disse|strong="G3004"\w* \w a mãe|strong="G3588,G3384"\w* \w dele|strong="G846"\w* \w aos servos|strong="G3588,G1249"\w*: “\w O que quer que|strong="G3739,G5100,G302"\w* \w ele disser|strong="G3004"\w* \w a vocês|strong="G4771"\w*, \w façam|strong="G4160"\w*.”\x - \xo 2:5 \xt MRK 10:43; MAT 20:26; LUK 5:5; GEN 6:22; JHN 15:14; HEB 11:8\x*
\v 6 \w Havia|strong="G1510"\w* \w ali|strong="G1563"\w* \w seis|strong="G1803"\w* \w jarras|strong="G5201"\w* \w de pedra|strong="G3035"\w*, \w postas|strong="G2749"\w* \w para a purificação|strong="G2596,G3588,G2512"\w* \w dos judeus|strong="G3588,G2453"\w*, \w cada uma com capacidade|strong="G5562,G303"\w* \w de duas|strong="G1417"\w* \w ou|strong="G2228"\w* \w três|strong="G5140"\w* \w metretas|strong="G3355"\w*\f + \fr 2.6: \ft Lit.: Μετρητής, medida de líquidos.\f*.\x - \xo 2:6 \xt JHN 3:25; EPH 5:26; HEB 9:10; MRK 7:2-5; HEB 10:22; HEB 9:19\x*
\v 7 \w Jesus|strong="G3588,G2424"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Encham|strong="G1072"\w* \w as jarras|strong="G3588,G5201"\w* \w de água|strong="G5204"\w*.” \w E|strong="G2532"\w* \w as encheram|strong="G1072,G846"\w* \w até em cima|strong="G2193,G507"\w*.\x - \xo 2:7 \xt 2KI 4:2-6; JHN 2:5; 1KI 17:13; ISA 55:1; JHN 2:3; JHN 4:46\x*
\v 8 \w E|strong="G2532"\w* \w lhes disse|strong="G3004,G846"\w*: “\w Tirem|strong="G501"\w* \w agora|strong="G3568"\w* \w e|strong="G2532"\w* \w levem|strong="G5342"\w* \w ao mestre-sala|strong="G3588,G755"\w*\f + \fr 2.8: \ft Lit.: Ἀρχιτρίκλινος, “encarregado do banquete”.\f*.” \w E|strong="G1161"\w* \w eles|strong="G3588"\w* \w levaram|strong="G5342"\w*.\x - \xo 2:8 \xt JHN 2:9; PRO 3:5-6; ISA 55:1; JHN 4:46; MAT 1:24; MAT 21:2\x*
\v 9 \w Quando|strong="G5613"\w* \w o mestre-sala|strong="G3588,G755"\w* \w provou|strong="G1089"\w* \w a água|strong="G3588,G5204"\w* \w que se tornara vinho|strong="G3631,G1096"\w*, \w e|strong="G2532"\w* \w não sabia|strong="G3756,G1492"\w* \w de onde|strong="G4159"\w* \w vinha|strong="G1510"\w*, \w mas|strong="G1161"\w* \w os servos|strong="G3588,G1249"\w* \w sabiam|strong="G1492"\w*, \w os que tinham tirado|strong="G3588,G501"\w* \w a água|strong="G3588,G5204"\w*, \w o mestre-sala|strong="G3588,G755"\w* \w chamou|strong="G5455"\w* \w o noivo|strong="G3588,G3566"\w*,\x - \xo 2:9 \xt JHN 4:46; JHN 2:8; JHN 7:17; ISA 55:1; 2KI 4:4; PSA 119:100\x*
\v 10 \w e|strong="G2532"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Toda|strong="G3956"\w* \w pessoa|strong="G444"\w* \w serve|strong="G5087"\w* \w primeiro|strong="G4413"\w* \w o bom|strong="G3588,G2570"\w* \w vinho|strong="G3631"\w*, \w e|strong="G2532"\w* \w quando|strong="G3752"\w* \w se embriagam|strong="G3184"\w*\f + \fr 2.10: \ft Lit.: Μεθύσκομαι, “embriagar-se”; aqui descreve o costume das festas, sem aprovar nem condenar.\f* \add serve\add* \w o inferior|strong="G3588,G1640"\w*; \w você guardou|strong="G4771,G5083"\w* \w o bom|strong="G3588,G2570"\w* \w vinho|strong="G3631"\w* \w até agora|strong="G2193,G737"\w*.”\f + \fr 2.10: \ft Variante: Treg e o RP acrescentam “então” (τότε) depois de “se embriagaram”.\f*\f + \fr 2.10: \ft Acréscimo: “serve” (em “se embriagam serve o inferior”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 2:10 \xt REV 7:16-17; PRO 9:1-6; ISA 55:1; JHN 4:46; LUK 16:25; MRK 10:34\x*
\v 11 \w Este|strong="G3778"\w* \w foi o princípio|strong="G746"\w* \w dos sinais|strong="G3588,G4592"\w*\f + \fr 2.11: \ft Lit.: Σημεῖον, “sinal”: ato que aponta para algo além de si.\f* \w que fez|strong="G4160"\w* \w Jesus|strong="G3588,G2424"\w* \w em Caná|strong="G1722,G2580"\w* \w da Galileia|strong="G3588,G1056"\w*, \w e|strong="G2532"\w* \w manifestou|strong="G5319"\w* \w a glória|strong="G3588,G1391"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w creram|strong="G4100"\w* \w nele|strong="G1519,G846"\w* \w os discípulos|strong="G3588,G3101"\w* \w dele|strong="G846"\w*.\f + \fr 2.11: \ft Acréscimo: verbo ser/estar suprido em “foi o princípio”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:11 \xt JHN 6:30; JHN 4:46; JHN 1:14; JHN 20:30; JHN 3:2; JHN 6:2\x*
\v 12 \w Depois disto|strong="G3326,G3778"\w* \w desceu|strong="G2597"\w* \w a Cafarnaum|strong="G1519,G2584"\w* \w ele|strong="G846"\w* \w e|strong="G2532"\w* \w a mãe|strong="G3588,G3384"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w os irmãos|strong="G3588,G80"\w* \w e|strong="G2532"\w* \w os discípulos|strong="G3588,G3101"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w ali|strong="G1563"\w* \w ficaram|strong="G3306"\w* \w não muitos|strong="G3756,G4183"\w* \w dias|strong="G2250"\w*.\f + \fr 2.12: \ft Variante: NA28 e o RP acrescentam “dele” (αὐτοῦ) depois de “os irmãos”.\f*\x - \xo 2:12 \xt MAT 11:23; MAT 12:46; 1CO 9:5; ACT 1:13-14; GAL 1:19; JHN 7:3-5\x*
\p
\v 13 \w E|strong="G2532"\w* \w estava perto|strong="G1451,G1510"\w* \w a Páscoa|strong="G3588,G3957"\w* \w dos judeus|strong="G3588,G2453"\w*, \w e|strong="G2532"\w* \w subiu|strong="G305"\w* \w a Jerusalém|strong="G1519,G2414"\w* \w Jesus|strong="G3588,G2424"\w*.\x - \xo 2:13 \xt JHN 11:55; JHN 6:4; JHN 5:1; JHN 2:23; ACT 21:15; MRK 11:15\x*
\v 14 \w E|strong="G2532"\w* \w encontrou|strong="G2147"\w* \w no templo|strong="G1722,G3588,G2411"\w* \w os que vendiam|strong="G3588,G4453"\w* \w bois|strong="G1016"\w* \w e|strong="G2532"\w* \w ovelhas|strong="G4263"\w* \w e|strong="G2532"\w* \w pombas|strong="G4058"\w*, \w e|strong="G2532"\w* \w os cambistas|strong="G3588,G2773"\w*\f + \fr 2.14: \ft Lit.: Κερματιστής e κολλυβιστής (v. 15) são ambos “cambistas”: o primeiro lida com moedas miúdas.\f* \w sentados|strong="G2521"\w*,\x - \xo 2:14 \xt MAT 21:12; MRK 11:15; LUK 19:45; PSA 69:9; MRK 11:17; DEU 14:23-26\x*
\v 15 \w e|strong="G2532"\w*, \w tendo feito|strong="G4160"\w* \w um chicote|strong="G5416"\w* \w de cordas|strong="G1537,G4979"\w*, \w expulsou|strong="G1544"\w* \w todos|strong="G3956"\w* \w do templo|strong="G1537,G3588,G2411"\w*, \w tanto as|strong="G3588,G5037"\w* \w ovelhas|strong="G4263"\w* \w como os|strong="G2532,G3588"\w* \w bois|strong="G1016"\w*, \w e|strong="G2532"\w* \w dos cambistas|strong="G3588,G2855"\w* \w derramou|strong="G1632"\w* \w as moedas|strong="G3588,G2772"\w* \w e|strong="G2532"\w* \w as mesas|strong="G3588,G5132"\w* \w virou|strong="G390"\w*,\f + \fr 2.15: \ft Variante: NA28 e o RP trazem o singular “a moeda” (τὸ κέρμα) em lugar do plural “as moedas”; WH e NA28 trazem ἀνέτρεψεν (“derrubou”) em lugar de ἀνέστρεψεν (“virou”).\f*\x - \xo 2:15 \xt MAT 21:12; MRK 11:15; PSA 69:9; LUK 19:45; PSA 26:8; JHN 4:45\x*
\v 16 \w e|strong="G2532"\w* \w aos que vendiam|strong="G3588,G4453"\w* \w pombas|strong="G4058"\w* \w disse|strong="G2036"\w*: “\w Tirem|strong="G142"\w* \w estas coisas|strong="G3778"\w* \w daqui|strong="G1782"\w*, \w não façam|strong="G3361,G4160"\w* \w da casa|strong="G3588,G3624"\w* \w do meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w* \w uma casa|strong="G3624"\w* \w de comércio|strong="G1712"\w*.”\x - \xo 2:16 \xt MAT 21:12; JER 7:11; MAT 21:13; MRK 11:17; PSA 69:9; ISA 56:5-11\x*
\v 17 \w Lembraram-se|strong="G3403"\w* \w os discípulos|strong="G3588,G3101"\w* \w dele|strong="G846"\w* \w de que|strong="G3754"\w* \w está escrito|strong="G1125,G1510"\w*: “\w O zelo|strong="G3588,G2205"\w* \w pela sua casa|strong="G3588,G3624,G4771"\w* \w me devorará|strong="G2719,G3165"\w*.”\f + \fr 2.17: \ft Nota cultural: Citação do Salmo 69:9 (68:10 no grego), com forma verbal diferente (aqui, futuro).\f*\x - \xo 2:17 \xt PSA 69:9; PSA 119:139; MAT 21:12; MRK 11:15; LUK 2:49; ISA 59:17\x*
\v 18 \w Responderam|strong="G611"\w* \w então|strong="G3767"\w* \w os judeus|strong="G3588,G2453"\w* \w e|strong="G2532"\w* \w lhe disseram|strong="G2036,G846"\w*: “\w Que sinal|strong="G5101,G4592"\w* \w nos mostra|strong="G1166,G3165"\w*, \w já que|strong="G3754"\w* \w faz|strong="G4160"\w* \w estas coisas|strong="G3778"\w*?”\x - \xo 2:18 \xt MAT 12:38; 1CO 1:22; ROM 1:4; EXO 7:9; LUK 11:29; 1KI 13:3\x*
\v 19 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Destruam|strong="G3089"\w* \w este|strong="G3778"\w* \w santuário|strong="G3588,G3485"\w* \w e|strong="G2532"\w* \w em três|strong="G1722,G5140"\w* \w dias|strong="G2250"\w* \w eu o levantarei|strong="G1453,G846"\w*.”\f + \fr 2.19: \ft Lit.: Ἐγείρω, “levantar, erguer”; também “ressuscitar”.\f*\x - \xo 2:19 \xt MRK 14:58; MAT 27:40; MRK 15:29; MAT 26:61; MAT 26:60-61; MAT 12:40\x*
\v 20 \w Disseram|strong="G2036"\w* \w então|strong="G3767"\w* \w os judeus|strong="G3588,G2453"\w*: “\w Este|strong="G3778"\w* \w santuário|strong="G3588,G3485"\w* \w foi construído|strong="G3618"\w* \w em quarenta|strong="G5062"\w* \w e|strong="G2532"\w* \w seis|strong="G1803"\w* \w anos|strong="G2094"\w*, \w e|strong="G2532"\w* \w você|strong="G4771"\w* \w em três|strong="G1722,G5140"\w* \w dias|strong="G2250"\w* \w o levantará|strong="G1453,G846"\w*?”\x - \xo 2:20 \xt MAT 26:61; MAT 27:40; MRK 15:29; JHN 10:18; ACT 2:24; ROM 1:4\x*
\v 21 \w Mas|strong="G1161"\w* \w ele|strong="G1565"\w* \w falava|strong="G3004"\w* \w a respeito do santuário|strong="G4012,G3588,G3485"\w* \w do corpo|strong="G3588,G4983"\w* \w dele|strong="G846"\w*.\x - \xo 2:21 \xt 1CO 6:19; JHN 10:18; ACT 2:24; COL 2:9; 1CO 3:16; MAT 26:61\x*
\v 22 \w Quando|strong="G3753"\w* \w então|strong="G3767"\w* \w foi ressuscitado|strong="G1453"\w* \w dentre os mortos|strong="G1537,G3498"\w*, \w lembraram-se|strong="G3403"\w* \w os discípulos|strong="G3588,G3101"\w* \w dele|strong="G846"\w* \w de que|strong="G3754"\w* \w isto|strong="G3778"\w* \w ele dizia|strong="G3004"\w*, \w e|strong="G2532"\w* \w creram|strong="G4100"\w* \w na Escritura|strong="G3588,G1124"\w* \w e|strong="G2532"\w* \w na palavra|strong="G3588,G3056"\w* \w que disse|strong="G3739,G2036"\w* \w Jesus|strong="G3588,G2424"\w*.\x - \xo 2:22 \xt JHN 12:16; 1CO 15:4; JHN 20:9; ACT 13:30; JHN 14:26; JHN 16:4\x*
\p
\v 23 \w Quando|strong="G5613"\w* \w esteve|strong="G1510"\w* \w em Jerusalém|strong="G1722,G3588,G2414"\w* \w na Páscoa|strong="G1722,G3588,G3957"\w*, \w na festa|strong="G1722,G3588,G1859"\w*, \w muitos|strong="G4183"\w* \w creram|strong="G4100"\w* \w no nome|strong="G1519,G3588,G3686"\w* \w dele|strong="G846"\w*, \w vendo|strong="G2334"\w* \w os sinais|strong="G3588,G4592"\w* \w dele|strong="G846"\w* \w que fazia|strong="G3739,G4160"\w*;\x - \xo 2:23 \xt JHN 2:13; JHN 4:45; JHN 1:12; 1JN 5:13; JHN 5:36; JHN 7:31\x*
\v 24 \w mas|strong="G1161"\w* \w o próprio|strong="G846"\w* \w Jesus|strong="G2424"\w* \w não se confiava|strong="G3756,G4100,G1438"\w*\f + \fr 2.24: \ft Lit.: Ἐπίστευεν, aqui “confiava, entregava-se a”: o verbo é o mesmo de “crer”, com outro matiz.\f* \w a eles|strong="G846"\w*, \w porque|strong="G1223,G3588"\w* \w ele|strong="G846"\w* \w conhecia|strong="G1097"\w* \w todos|strong="G3956"\w*\x - \xo 2:24 \xt JHN 6:69; 1JN 4:16; JHN 10:38; JHN 4:53; JHN 6:64; ACT 1:24\x*
\v 25 \w e|strong="G2532"\w* \w porque|strong="G3754"\w* \w não tinha|strong="G3756,G2192"\w* \w necessidade|strong="G5532"\w* \w de que alguém|strong="G2443,G5100"\w* \w desse testemunho|strong="G3140"\w* \w a respeito do ser humano|strong="G4012,G3588,G444"\w*, \w pois|strong="G1063"\w* \w ele mesmo|strong="G846"\w* \w sabia|strong="G1097"\w* \w o que havia|strong="G5101,G1510"\w* \w no ser humano|strong="G1722,G3588,G444"\w*.\x - \xo 2:25 \xt 1CH 28:9; JER 17:10; JOB 42:2; JHN 13:11; MAT 9:4; PRO 21:2\x*
\c 3
\p
\v 1 \w Havia|strong="G1510"\w* \w um homem|strong="G444"\w* \w dentre os|strong="G1537,G3588"\w* \w fariseus|strong="G5330"\w*, \w de nome|strong="G3686,G846"\w* \w Nicodemos|strong="G3530"\w*, \add um\add* \w governante|strong="G758"\w* \w dos judeus|strong="G3588,G2453"\w*;\f + \fr 3.1: \ft Acréscimo: “um” (em “nome Nicodemos um governante dos”): preposição ou artigo que a regência do português exige.\f*\x - \xo 3:1 \xt JHN 7:48; JHN 19:39; JHN 3:10; JHN 7:47-50; JHN 1:24; LUK 23:13\x*
\v 2 \w este|strong="G3778"\w* \w veio|strong="G2064"\w* \w até ele|strong="G4314,G846"\w* \w de noite|strong="G3571"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Rabi|strong="G4461"\w*, \w sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w da parte de Deus|strong="G575,G2316"\w* \w você veio|strong="G2064"\w* \w como mestre|strong="G1320"\w*; \w pois|strong="G1063"\w* \w ninguém|strong="G3762"\w* \w pode|strong="G1410"\w* \w fazer|strong="G4160"\w* \w estes|strong="G3778,G3588"\w* \w sinais|strong="G4592"\w* \w que|strong="G3739"\w* \w você|strong="G4771"\w* \w faz|strong="G4160"\w*, \w a não ser que|strong="G1437,G3361"\w* \w Deus esteja|strong="G1510,G3588,G2316"\w* \w com ele|strong="G3326,G846"\w*.”\f + \fr 3.2: \ft Variante: o TR traz “Jesus” (Ἰησοῦν) em lugar de “ele” (αὐτόν); o RP traz a ordem “estes sinais… pode fazer” (ταῦτα τὰ σημεῖα δύναται).\f*\x - \xo 3:2 \xt MAT 23:8; JHN 1:38; JHN 9:33; ACT 10:38; JHN 2:11; JHN 5:36\x*
\v 3 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a você|strong="G4771"\w*: \w se alguém|strong="G1437,G3361,G5100"\w* \w nascer|strong="G1080"\w* \w do alto|strong="G509"\w*, \w não pode|strong="G3756,G1410"\w* \w ver|strong="G1492"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.”\f + \fr 3.3: \ft Lit.: Γεννηθῇ ἄνωθεν: ἄνωθεν pode ser “do alto” ou “de novo”; a reação de Nicodemos no v. 4 mostra que ele entendeu “de novo”.\f*\x - \xo 3:3 \xt JHN 3:5; 2CO 5:17; JHN 3:7; EZK 36:26; 1PE 1:23; JHN 5:19\x*
\v 4 \w Nicodemos|strong="G3588,G3530"\w* \w lhe disse|strong="G3004,G4314,G846"\w*: “\w Como|strong="G4459"\w* \w pode|strong="G1410"\w* \w uma pessoa|strong="G444"\w* \w nascer|strong="G1080"\w* \w sendo idosa|strong="G1088,G1510"\w*? \w Acaso|strong="G3361"\w* \w pode|strong="G1410"\w* \w entrar|strong="G1525"\w* \w uma segunda vez|strong="G1208"\w* \w no ventre|strong="G1519,G3588,G2836"\w* \w da sua mãe|strong="G3588,G3384,G846"\w* \w e|strong="G2532"\w* \w nascer|strong="G1080"\w*?”\x - \xo 3:4 \xt JHN 3:9; EZK 36:26; 1JN 2:29; JAS 1:18; 1PE 1:3; TIT 3:5\x*
\v 5 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w*: “\w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a você|strong="G4771"\w*: \w se alguém|strong="G1437,G3361,G5100"\w* \w nascer|strong="G1080"\w* \w de água|strong="G1537,G5204"\w* \w e|strong="G2532"\w* \w de Espírito|strong="G4151"\w*, \w não pode|strong="G3756,G1410"\w* \w entrar|strong="G1525"\w* \w no reino|strong="G1519,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 3.5: \ft Lit.: Ἐξ ὕδατος καὶ πνεύματος: “de água e de Espírito”: o sentido de “água” é discutido (nascimento físico, purificação, batismo); πνεῦμα é o Espírito (cf. v. 6).\f*\x - \xo 3:5 \xt JHN 3:3; EZK 36:25; MAT 18:3; MAT 7:21; MRK 10:15; EZK 36:26\x*
\v 6 \w O que nasceu|strong="G3588,G1080"\w* \w da carne|strong="G1537,G3588,G4561"\w* \w é carne|strong="G4561,G1510"\w*, \w e|strong="G2532"\w* \w o que nasceu|strong="G3588,G1080"\w* \w do Espírito|strong="G1537,G3588,G4151"\w* \w é espírito|strong="G4151,G1510"\w*.\x - \xo 3:6 \xt JHN 1:13; JHN 3:3; GAL 4:29; GAL 4:23; ROM 8:5; GAL 5:16-21\x*
\v 7 \w Não se admire|strong="G3361,G2296"\w* \w de eu ter dito|strong="G3754,G2036"\w* \w a você|strong="G4771"\w*: ‘\w É necessário|strong="G1163"\w* \w que vocês|strong="G4771"\w* \w nasçam|strong="G1080"\w* \w do alto|strong="G509"\w*.’\f + \fr 3.7: \ft Lit.: Σοι… ὑμᾶς: singular e plural: Jesus passa de Nicodemos a um “vocês” mais amplo.\f*\x - \xo 3:7 \xt JHN 3:3; 1PE 1:3; JHN 1:13; EPH 4:22-24; JHN 6:44; ROM 12:1-2\x*
\v 8 \w O vento|strong="G3588,G4151"\w* \w sopra|strong="G4154"\w* \w onde|strong="G3699"\w* \w quer|strong="G2309"\w*\f + \fr 3.8: \ft Lit.: Πνεῦμα significa “vento”, “sopro” e “Espírito”; o jogo de sentidos do grego não se reproduz em português.\f*, \w e|strong="G2532"\w* \w você ouve|strong="G191"\w* \w o som|strong="G3588,G5456"\w* \w dele|strong="G846"\w*, \w mas|strong="G235"\w* \w não sabe|strong="G3756,G6063"\w* \w de onde|strong="G4159"\w* \w vem|strong="G2064"\w* \w e|strong="G2532"\w* \w para onde|strong="G4226"\w* \w vai|strong="G5217"\w*; \w assim é|strong="G3779,G1510"\w* \w todo aquele|strong="G3956,G3588"\w* \w que nasceu|strong="G1080"\w* \w do Espírito|strong="G1537,G3588,G4151"\w*.”\x - \xo 3:8 \xt ECC 11:4-5; 1CO 2:11; ACT 2:2; ECC 11:5; 1PE 1:3; EZK 37:9\x*
\v 9 \w Respondeu|strong="G611"\w* \w Nicodemos|strong="G3530"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Como|strong="G4459"\w* \w pode|strong="G1410"\w* \w acontecer|strong="G1096"\w* \w isto|strong="G3778"\w*?”\x - \xo 3:9 \xt JHN 3:4; ISA 42:16; JHN 6:52; JHN 6:60; LUK 1:34; JHN 7:36\x*
\v 10 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Você|strong="G4771"\w* \w é o mestre|strong="G1510,G3588,G1320"\w* \w de Israel|strong="G3588,G2474"\w* \w e|strong="G2532"\w* \w não entende|strong="G3756,G1097"\w* \w estas coisas|strong="G3778"\w*?\x - \xo 3:10 \xt MRK 12:29; MAT 22:29; JER 8:8-9; JHN 3:1; EZK 11:19; ECC 12:11\x*
\v 11 \w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a você|strong="G4771"\w* \w que|strong="G3754"\w* \w o que|strong="G3739"\w* \w sabemos|strong="G6063"\w* \w falamos|strong="G2980"\w*, \w e|strong="G2532"\w* \w o que|strong="G3739"\w* \w vimos|strong="G3708"\w* \w testemunhamos|strong="G3140"\w*, \w e|strong="G2532"\w* \w o nosso|strong="G3588,G3165"\w* \w testemunho|strong="G3141"\w* \w vocês não|strong="G3756"\w* \w recebem|strong="G2983"\w*\f + \fr 3.11: \ft Lit.: Οἴδαμεν… λαλοῦμεν: plural “sabemos… falamos”; o sentido do “nós” é discutido.\f*.\x - \xo 3:11 \xt JHN 3:32; REV 1:2; JHN 5:31; 1JN 5:9; JHN 8:14; JHN 19:35\x*
\v 12 \w Se|strong="G1487"\w* \w as coisas da terra|strong="G3588,G1919"\w* \w eu disse|strong="G2036"\w* \w a vocês|strong="G4771"\w* \w e|strong="G2532"\w* \w não creem|strong="G3756,G4100"\w*, \w como|strong="G4459"\w* \w se eu disser|strong="G1437,G2036"\w* \w a vocês|strong="G4771"\w* \w as coisas do céu|strong="G3588,G2032"\w* \w crerão|strong="G4100"\w*?\x - \xo 3:12 \xt 1CO 15:40; PHP 2:10; 1CO 3:1-2; JHN 3:31; 1CO 2:7-9; HEB 5:11\x*
\v 13 \w E|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w subiu|strong="G305"\w* \w ao céu|strong="G1519,G3588,G3772"\w* \w a não ser|strong="G1487,G3361"\w* \w aquele que|strong="G3588"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w desceu|strong="G2597"\w*, \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w*.\f + \fr 3.13: \ft Variante: Treg e o RP acrescentam “que está no céu” (ὁ ὢν ἐν τῷ οὐρανῷ) depois de “do Homem”.\f*\x - \xo 3:13 \xt EPH 4:9; JHN 1:51; EPH 4:10; PRO 30:4; DAN 7:13; JHN 6:38\x*
\v 14 \w E|strong="G2532"\w* \w assim como|strong="G2531"\w* \w Moisés|strong="G3475"\w* \w levantou|strong="G5312"\w*\f + \fr 3.14: \ft Lit.: Ὑψόω, “levantar, elevar, exaltar”; em João sugere também a elevação na cruz (cf. 8:28; 12:32-34).\f* \w a serpente|strong="G3588,G3789"\w* \w no deserto|strong="G1722,G3588,G2048"\w*\f + \fr 3.14: \ft Nota cultural: Alusão a Números 21:8-9.\f*, \w assim|strong="G3779"\w* \w é necessário|strong="G1163"\w* \w que seja levantado|strong="G5312"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w*,\x - \xo 3:14 \xt NUM 21:8; JHN 8:28; NUM 21:7-9; JHN 12:34; EPH 2:8; JHN 12:32\x*
\v 15 \w para que|strong="G2443"\w* \w todo|strong="G3956"\w* \w aquele que|strong="G3588"\w* \w crê|strong="G4100"\w* \w nele|strong="G1722,G846"\w* \w tenha|strong="G2192"\w* \w vida|strong="G2222"\w* \w eterna|strong="G166"\w*.\f + \fr 3.15: \ft Variante: o RP traz “nele não pereça, mas” (εἰς αὐτὸν μὴ ἀπόληται ἀλλʼ) em lugar de “nele” (ἐν αὐτῷ).\f*\x - \xo 3:15 \xt JHN 6:47; JHN 10:28; JHN 3:36; 1JN 5:11; JHN 20:31; JHN 6:40\x*
\v 16 \w Pois|strong="G1063"\w* \w Deus|strong="G3588,G2316"\w* \w amou|strong="G25"\w* \w o mundo|strong="G3588,G2889"\w* \w de tal modo|strong="G3779"\w* \w que|strong="G5620"\w* \w deu|strong="G1325"\w* \w o Filho|strong="G3588,G5207"\w* \w unigênito|strong="G3588,G3439"\w*, \w para que|strong="G2443"\w* \w todo|strong="G3956"\w* \w aquele que|strong="G3588"\w* \w crê|strong="G4100"\w* \w nele|strong="G1519,G846"\w* \w não|strong="G3361"\w* \w pereça|strong="G622"\w* \w mas|strong="G235"\w* \w tenha|strong="G2192"\w* \w vida|strong="G2222"\w* \w eterna|strong="G166"\w*.\f + \fr 3.16: \ft Variante: Treg e o RP trazem “o seu Filho” (τὸν υἱὸν αὐτοῦ) em lugar de “o Filho”.\f*\x - \xo 3:16 \xt 1JN 4:9; JHN 10:28; JHN 6:40; 1JN 4:19; 1TI 1:15; 2CO 5:19-21\x*
\v 17 \w Pois|strong="G1063"\w* \w Deus|strong="G3588,G2316"\w* \w não|strong="G3756"\w* \w enviou|strong="G649"\w* \w o Filho|strong="G3588,G5207"\w* \w ao mundo|strong="G1519,G3588,G2889"\w* \w para que|strong="G2443"\w* \w julgasse|strong="G2919"\w* \w o mundo|strong="G3588,G2889"\w*, \w mas|strong="G235"\w* \w para que|strong="G2443"\w* \w fosse salvo|strong="G4982"\w* \w o mundo|strong="G3588,G2889"\w* \w por meio dele|strong="G1223,G846"\w*.\f + \fr 3.17: \ft Lit.: Κρίνω, “julgar, condenar”.\f*\x - \xo 3:17 \xt JHN 12:47; 1JN 4:14; JHN 10:10; JHN 10:36; JHN 17:21; JHN 17:18\x*
\v 18 \w Aquele que crê|strong="G3588,G4100"\w* \w nele|strong="G1519,G846"\w* \w não|strong="G3756"\w* \w é julgado|strong="G2919"\w*; \w mas|strong="G1161"\w* \w aquele que|strong="G3588"\w* \w não|strong="G3361"\w* \w crê|strong="G4100"\w* \w já|strong="G2235"\w* \w foi julgado|strong="G2919"\w*, \w porque|strong="G3754"\w* \w não|strong="G3361"\w* \w creu|strong="G4100"\w* \w no nome|strong="G1519,G3588,G3686"\w* \w do Filho|strong="G3588,G5207"\w* \w unigênito|strong="G3439"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 3:18 \xt MRK 16:16; ROM 8:1; JHN 20:31; JHN 1:12; JHN 5:24; HEB 11:6\x*
\v 19 \w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w o julgamento|strong="G3588,G2920"\w*: \w que|strong="G3754"\w* \w a luz|strong="G3588,G5457"\w* \w veio|strong="G2064"\w* \w ao mundo|strong="G1519,G3588,G2889"\w* \w e|strong="G2532"\w* \w as pessoas|strong="G3588,G444"\w* \w amaram|strong="G25"\w* \w mais|strong="G3123"\w* \w a escuridão|strong="G3588,G4655"\w* \w do que|strong="G2228"\w* \w a luz|strong="G3588,G5457"\w*, \w pois|strong="G1063"\w* \w eram|strong="G1510"\w* \w más|strong="G4190"\w* \w as obras|strong="G3588,G2041"\w* \w deles|strong="G846"\w*.\x - \xo 3:19 \xt MRK 16:16; ROM 8:1; JHN 12:43; JHN 9:5; JHN 7:7; EPH 5:11\x*
\v 20 \w Pois|strong="G1063"\w* \w todo|strong="G3956"\w* \w aquele que|strong="G3588"\w* \w pratica coisas ruins|strong="G5337,G4238"\w* \w odeia|strong="G3404"\w* \w a luz|strong="G3588,G5457"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w vem|strong="G2064"\w* \w à luz|strong="G4314,G3588,G5457"\w*, \w para que não|strong="G2443,G3361"\w* \w sejam expostas|strong="G1651"\w* \w as obras|strong="G3588,G2041"\w* \w dele|strong="G846"\w*;\x - \xo 3:20 \xt EPH 5:13; JHN 1:5; JHN 7:7; 2TI 3:16; EPH 5:11; 1JN 1:6\x*
\v 21 \w mas|strong="G1161"\w* \w aquele que|strong="G3588"\w* \w pratica|strong="G4160"\w* \w a verdade|strong="G3588,G225"\w* \w vem|strong="G2064"\w* \w à luz|strong="G4314,G3588,G5457"\w*, \w para que|strong="G2443"\w* \w se manifeste|strong="G5319"\w* \w que|strong="G3754"\w* \w as obras|strong="G3588,G2041"\w* \w dele|strong="G846"\w* \w foram feitas|strong="G1510,G2038"\w*\f + \fr 3.21: \ft Lit.: O grego não marca onde termina a fala de Jesus: as aspas se estendem até o v. 21 por convenção; alguns entendem que as palavras do narrador começam no v. 16.\f* \w em Deus|strong="G1722,G2316"\w*.”\x - \xo 3:21 \xt EPH 5:13; JHN 6:28; EPH 5:9; PSA 31:19; EPH 2:10; 1JN 1:6\x*
\p
\v 22 \w Depois destas coisas|strong="G3326,G3778"\w* \w foi|strong="G2064"\w* \w Jesus|strong="G3588,G2424"\w* \w e|strong="G2532"\w* \w os discípulos|strong="G3588,G3101"\w* \w dele|strong="G846"\w* \w para a região|strong="G1519,G3588,G1093"\w* \w da Judeia|strong="G2453"\w*, \w e|strong="G2532"\w* \w ali|strong="G1563"\w* \w passava o tempo|strong="G1304"\w* \w com eles|strong="G3326,G846"\w* \w e|strong="G2532"\w* \w batizava|strong="G907"\w*.\x - \xo 3:22 \xt JHN 4:1; JHN 3:26; JHN 4:3\x*
\v 23 \w E|strong="G1161"\w* \w também|strong="G2532"\w* \w João|strong="G3588,G2491"\w* \w estava|strong="G1510"\w* \w batizando|strong="G907"\w* \w em Enom|strong="G1722,G137"\w* \w perto|strong="G1451"\w* \w de Salim|strong="G3588,G4530"\w*, \w porque|strong="G3754"\w* \w havia ali|strong="G1510,G1563"\w* \w muitas|strong="G4183"\w* \w águas|strong="G5204"\w*, \w e|strong="G2532"\w* \w as pessoas vinham|strong="G3854"\w* \w e|strong="G2532"\w* \w eram batizadas|strong="G907"\w*;\x - \xo 3:23 \xt ACT 1:5; MRK 1:8; JHN 1:28; MRK 1:4; 1SA 9:4; ACT 8:36\x*
\v 24 \w pois|strong="G1063"\w* \w ainda não tinha sido lançado|strong="G3768,G1510,G906"\w* \w na prisão|strong="G1519,G3588,G5438"\w* \w João|strong="G3588,G2491"\w*.\x - \xo 3:24 \xt LUK 3:20; MAT 4:12; MAT 14:3; MRK 6:17; LUK 3:19-20; LUK 9:7-9\x*
\v 25 \w Houve|strong="G1096"\w* \w então|strong="G3767"\w* \w uma discussão|strong="G2214"\w* \w da parte|strong="G1537"\w* \w dos discípulos|strong="G3588,G3101"\w* \w de João|strong="G2491"\w* \w com um judeu|strong="G3326,G2453"\w* \w a respeito de purificação|strong="G4012,G2512"\w*.\f + \fr 3.25: \ft Variante: o TR traz “com judeus” (Ἰουδαίων, plural) em lugar de “com um judeu” (Ἰουδαίου).\f*\x - \xo 3:25 \xt JHN 2:6; MAT 3:11; HEB 6:2; 1PE 3:21; HEB 9:10; HEB 9:23\x*
\v 26 \w E|strong="G2532"\w* \w foram|strong="G2064"\w* \w até|strong="G4314"\w* \w João|strong="G3588,G2491"\w* \w e|strong="G2532"\w* \w lhe disseram|strong="G2036,G846"\w*: “\w Rabi|strong="G4461"\w*, \w aquele que|strong="G3739"\w* \w estava|strong="G1510"\w* \w com você|strong="G3326,G4771"\w* \w do outro lado|strong="G4008"\w* \w do Jordão|strong="G3588,G2446"\w*, \w a quem|strong="G3739"\w* \w você|strong="G4771"\w* \w deu testemunho|strong="G3140"\w*, \w veja|strong="G2396"\w*: \w este|strong="G3778"\w* \w batiza|strong="G907"\w* \w e|strong="G2532"\w* \w todos|strong="G3956"\w* \w vão|strong="G2064"\w* \w até ele|strong="G4314,G846"\w*.”\x - \xo 3:26 \xt JHN 1:28; JHN 10:40; JHN 4:1; JHN 1:7; JHN 1:15; JHN 7:18\x*
\v 27 \w Respondeu|strong="G611"\w* \w João|strong="G2491"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Não|strong="G3756"\w* \w pode|strong="G1410"\w* \w uma pessoa|strong="G444"\w* \w receber|strong="G2983"\w* \w coisa alguma|strong="G3761,G1520"\w* \w a não ser que|strong="G1437,G3361"\w* \w lhe|strong="G846"\w* \w tenha sido dado|strong="G1510,G1325"\w* \w do céu|strong="G1537,G3588,G3772"\w*.\x - \xo 3:27 \xt JAS 1:17; MRK 11:30; PHP 2:13; 1CO 4:7; 1CO 15:10; 1PE 4:10-11\x*
\v 28 \add Vocês\add* \w mesmos|strong="G846,G4771"\w* \w me|strong="G3165"\w* \w são testemunhas|strong="G3140"\w* \w de que|strong="G3754"\w* \w eu disse|strong="G2036"\w*: ‘\w Eu|strong="G1473"\w* \w não sou|strong="G3756,G1510"\w* \w o Cristo|strong="G3588,G5547"\w*, \w mas|strong="G235"\w* \w fui enviado|strong="G649,G1510"\w* \w à frente|strong="G1715"\w* \w daquele|strong="G1565"\w*\f + \fr 3.28: \ft Variante: o RP omite “de mim” (μοι); WH acrescenta “eu” (ἐγώ) e NA28 acrescenta “que” (ὅτι) depois de “disse”.\f*.’\f + \fr 3.28: \ft Acréscimo: “Vocês” (em “Vocês mesmos me”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 3:28 \xt JHN 1:15; JHN 5:33; JHN 1:23; JHN 1:6; JHN 1:8; LUK 1:17\x*
\v 29 \w Aquele que tem|strong="G3588,G2192"\w* \w a noiva|strong="G3588,G3565"\w* \w é o noivo|strong="G3566,G1510"\w*; \w mas|strong="G1161"\w* \w o amigo|strong="G3588,G5384"\w* \w do noivo|strong="G3588,G3566"\w*, \w que está de pé|strong="G3588,G2476"\w* \w e|strong="G2532"\w* \w o ouve|strong="G191,G846"\w*, \w se alegra imensamente|strong="G5479,G5463"\w*\f + \fr 3.29: \ft Lit.: Χαρᾷ χαίρει, “alegra-se com alegria”: hebraísmo que reforça o verbo.\f* \w por causa da voz|strong="G1223,G3588,G5456"\w* \w do noivo|strong="G3588,G3566"\w*. \w Portanto|strong="G3767"\w*, \w esta|strong="G3778"\w* \w minha|strong="G3588,G1473"\w* \w alegria|strong="G5479"\w* \w está completa|strong="G4137"\w*.\x - \xo 3:29 \xt JHN 15:11; 1JN 1:4; JHN 17:13; PHP 2:2; MAT 25:1; REV 19:7\x*
\v 30 \w É necessário|strong="G1163"\w* \w que ele|strong="G1565"\w* \w cresça|strong="G837"\w*, \w mas|strong="G1161"\w* \w que eu|strong="G1473"\w* \w diminua|strong="G1642"\w*.”\x - \xo 3:30 \xt COL 1:18; PSA 72:17-19; HEB 3:2-6; ISA 9:7; 1CO 3:5; REV 11:15\x*
\p
\v 31 \w Aquele que vem|strong="G3588,G2064"\w* \w do alto|strong="G509"\w* \w está acima|strong="G1883,G1510"\w* \w de todos|strong="G3956"\w*. \w Aquele que é|strong="G3588,G1510"\w* \w da terra|strong="G1537,G3588,G1093"\w* \w é da terra|strong="G1537,G3588,G1093,G1510"\w* \w e|strong="G2532"\w* \w da terra|strong="G1537,G3588,G1093"\w* \w fala|strong="G2980"\w*; \w aquele que vem|strong="G3588,G2064"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w está acima|strong="G1883,G1510"\w* \w de todos|strong="G3956"\w*;\f + \fr 3.31: \ft Lit.: O grego não marca onde termina a fala de João (v. 30) nem se os vv. 31-36 são dele ou do narrador; as aspas fecham no v. 30 por convenção.\f*\x - \xo 3:31 \xt MAT 28:18; JHN 8:23; ROM 9:5; JHN 6:33; 1JN 4:5; JHN 3:12\x*
\v 32 \w o que|strong="G3739"\w* \w viu|strong="G3708"\w* \w e|strong="G2532"\w* \w ouviu|strong="G191"\w*, \w isto|strong="G3778"\w* \w testemunha|strong="G3140"\w*, \w e|strong="G2532"\w* \w o testemunho|strong="G3588,G3141"\w* \w dele|strong="G846"\w* \w ninguém|strong="G3762"\w* \w recebe|strong="G2983"\w*.\x - \xo 3:32 \xt JHN 3:11; 1JN 5:9; JHN 1:7; JHN 19:35; REV 1:2; JHN 5:31\x*
\v 33 \w Aquele que recebeu|strong="G3588,G2983"\w* \w o testemunho|strong="G3588,G3141"\w* \w dele|strong="G846"\w* \w selou|strong="G4972"\w*\f + \fr 3.33: \ft Lit.: Σφραγίζω, “selar, atestar”.\f* \w que|strong="G3754"\w* \w Deus|strong="G3588,G2316"\w* \w é verdadeiro|strong="G227,G1510"\w*.\x - \xo 3:33 \xt JHN 5:31; JHN 21:24; JHN 5:32; JHN 8:13; JHN 8:17; JHN 19:35\x*
\v 34 \w Pois|strong="G1063"\w* \w aquele que|strong="G3739"\w* \w Deus|strong="G3588,G2316"\w* \w enviou|strong="G649"\w* \w fala|strong="G2980"\w* \w as palavras|strong="G3588,G4487"\w* \w de Deus|strong="G3588,G2316"\w*, \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w dá por medida|strong="G1537,G3358,G1325"\w* \w o Espírito|strong="G3588,G4151"\w*\f + \fr 3.34: \ft Variante: o sujeito de “dá” não está expresso; Treg e o RP acrescentam “Deus” (ὁ θεός).\f*.\x - \xo 3:34 \xt ISA 59:21; ISA 61:1; ACT 10:38; JHN 17:3; ISA 11:2; LUK 4:18\x*
\v 35 \w O|strong="G3588"\w* \w Pai|strong="G3962"\w* \w ama|strong="G25"\w* \w o Filho|strong="G3588,G5207"\w*, \w e|strong="G2532"\w* \w tudo|strong="G3956"\w* \w colocou|strong="G1325"\w* \w na mão|strong="G1722,G3588,G5495"\w* \w dele|strong="G846"\w*.\x - \xo 3:35 \xt MAT 28:18; MAT 11:27; 2PE 1:17; DAN 7:14; COL 1:13; JHN 13:3\x*
\v 36 \w Aquele que crê|strong="G3588,G4100"\w* \w no Filho|strong="G1519,G3588,G5207"\w* \w tem|strong="G2192"\w* \w vida|strong="G2222"\w* \w eterna|strong="G166"\w*; \w mas|strong="G1161"\w* \w aquele que desobedece|strong="G3588,G544"\w* \w ao Filho|strong="G3588,G5207"\w* \w não|strong="G3756"\w* \w verá|strong="G3700"\w* \w vida|strong="G2222"\w*, \w mas|strong="G235"\w* \w a ira|strong="G3588,G3709"\w* \w de Deus|strong="G3588,G2316"\w* \w permanece|strong="G3306"\w* \w sobre ele|strong="G1909,G846"\w*.\f + \fr 3.36: \ft Lit.: Ἀπειθέω, “desobedecer, recusar-se a crer”.\f*\x - \xo 3:36 \xt JHN 5:24; JHN 3:15; ACT 4:12; JHN 3:16; MRK 16:16; ROM 6:23\x*
\c 4
\p
\v 1 \w Quando|strong="G5613"\w* \w então|strong="G3767"\w* \w soube|strong="G1097"\w* \w Jesus|strong="G3588,G2424"\w* \w que ouviram|strong="G3754,G191"\w* \w os fariseus|strong="G3588,G5330"\w* \w que|strong="G3754"\w* \w Jesus|strong="G2424"\w* \w faz|strong="G4160"\w* \w mais|strong="G4119"\w* \w discípulos|strong="G3101"\w* \w e|strong="G2532"\w* \w batiza|strong="G907"\w* \w do que|strong="G2228"\w* \w João|strong="G2491"\w*—\f + \fr 4.1: \ft Variante: WH, Treg e o RP trazem “o Senhor” (κύριος) em lugar de “Jesus” (Ἰησοῦς) como sujeito de “soube”.\f*\x - \xo 4:1 \xt JHN 3:26; JHN 3:22; 2CO 4:5; ACT 8:38; HEB 6:2; MAT 11:2\x*
\v 2 \w embora|strong="G2544"\w* \w o próprio|strong="G846"\w* \w Jesus|strong="G2424"\w* \w não|strong="G3756"\w* \w batizasse|strong="G907"\w*, \w mas|strong="G235"\w* \w os discípulos|strong="G3588,G3101"\w* \w dele|strong="G846"\w*—\x - \xo 4:2 \xt JHN 3:22; 1CO 1:13-17; ACT 10:48; 1CO 1:17; HEB 6:2\x*
\v 3 \w deixou|strong="G863"\w* \w a Judeia|strong="G3588,G2449"\w* \w e|strong="G2532"\w* \w partiu|strong="G565"\w* \w de novo|strong="G3825"\w* \w para a Galileia|strong="G1519,G3588,G1056"\w*.\x - \xo 4:3 \xt JHN 7:1; JHN 4:54; JHN 20:10; MAT 26:44; JHN 3:22; LUK 17:11\x*
\v 4 \w Era necessário|strong="G1163"\w* \w que ele|strong="G846"\w* \w passasse|strong="G1330"\w* \w pela Samaria|strong="G1223,G3588,G4540"\w*.\x - \xo 4:4 \xt LUK 17:11; 1KI 16:24; LUK 9:51-52\x*
\v 5 \w Chegou|strong="G2064"\w* \w então|strong="G3767"\w* \w a uma cidade|strong="G1519,G4172"\w* \w da Samaria|strong="G3588,G4540"\w* \w chamada|strong="G3004"\w* \w Sicar|strong="G4965"\w*, \w perto|strong="G4139"\w* \w do campo|strong="G3588,G5564"\w* \w que deu|strong="G3739,G1325"\w* \w Jacó|strong="G2384"\w* \w a José|strong="G3588,G2501"\w*, \w seu filho|strong="G3588,G5207,G846"\w*;\x - \xo 4:5 \xt JOS 24:32; GEN 33:19; GEN 48:22; GEN 33:18; JHN 4:12; JHN 4:39\x*
\v 6 \w Havia|strong="G1510"\w* \w ali|strong="G1563"\w* \w uma fonte|strong="G4077"\w* \w de Jacó|strong="G3588,G2384"\w*. \w Jesus|strong="G3588,G2424"\w*, \w então|strong="G3767"\w*, \w cansado|strong="G2872"\w* \w da viagem|strong="G1537,G3588,G3597"\w*, \w sentou-se|strong="G2516"\w* \w assim|strong="G3779"\w* \w junto à fonte|strong="G1909,G3588,G4077"\w*; \w era|strong="G1510"\w* \w a hora|strong="G5610"\w* \w cerca da|strong="G5613"\w* \w sexta|strong="G1623"\w*.\f + \fr 4.6: \ft Nota cultural: Contadas a partir do nascer do sol, a “sexta hora” seria por volta do meio-dia. O texto não dá um horário de relógio.\f*\x - \xo 4:6 \xt HEB 4:15; HEB 2:17; EXO 2:15; MAT 8:24; 2TI 4:2; GEN 29:2\x*
\v 7 \w Veio|strong="G2064"\w* \w uma mulher|strong="G1135"\w* \w da Samaria|strong="G1537,G3588,G4540"\w* \w tirar|strong="G501"\w* \w água|strong="G5204"\w*. \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Dê|strong="G1325"\w*-\w me|strong="G3165"\w* \w de beber|strong="G4095"\w*.”\x - \xo 4:7 \xt MAT 10:42; 1KI 17:10; GEN 24:17; 2TI 4:2; JHN 4:28; LUK 19:5\x*
\v 8 \w Pois|strong="G1063"\w* \w os discípulos|strong="G3588,G3101"\w* \w dele|strong="G846"\w* \w tinham ido|strong="G565"\w* \w à cidade|strong="G1519,G3588,G4172"\w*, \w para comprar|strong="G2443,G59"\w* \w alimentos|strong="G5160"\w*.\x - \xo 4:8 \xt 2TI 4:2; LUK 19:5; GEN 30:1; JHN 4:27; RUT 2:9\x*
\v 9 \w A|strong="G3588"\w* \w mulher|strong="G1135"\w* \w samaritana|strong="G3588,G4542"\w* \w lhe disse|strong="G3004,G3767,G846"\w*: “\w Como|strong="G4459"\w* \w você|strong="G4771"\w*, \w sendo|strong="G1510"\w* \w judeu|strong="G2453"\w*, \w me pede|strong="G3844,G1473,G154"\w* \w de beber|strong="G4095"\w*, \w sendo eu|strong="G1510"\w* \w mulher|strong="G1135"\w* \w samaritana|strong="G4542"\w*?” (\w Pois|strong="G1063"\w* \w não se relacionam|strong="G3756,G4798"\w* \w judeus|strong="G2453"\w* \w com samaritanos|strong="G4541"\w*.)\f + \fr 4.9: \ft Lit.: Συγχράομαι, “ter relações, usar em comum”: pode indicar não compartilhar utensílios ou não ter trato com samaritanos.\f*\x - \xo 4:9 \xt JHN 8:48; LUK 17:16; MAT 10:5; ACT 10:28; 2KI 17:24-41; LUK 10:33\x*
\v 10 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Se|strong="G1487"\w* \w você conhecesse|strong="G1492"\w* \w o dom|strong="G3588,G1431"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w quem|strong="G5101"\w* \w é|strong="G1510"\w* \w aquele que|strong="G3588,G3004"\w* \w lhe diz|strong="G4771"\w*: ‘\w Dê|strong="G1325"\w*-\w me|strong="G3165"\w* \w de beber|strong="G4095"\w*’, \w você é que|strong="G4771,G302"\w* \w lhe teria pedido|strong="G154,G846"\w*, \w e|strong="G2532"\w* \w ele lhe teria dado|strong="G1325,G302,G4771"\w* \w água viva|strong="G5204,G2198"\w*.”\f + \fr 4.10: \ft Lit.: Ὕδωρ ζῶν, “água viva”: também “água corrente”; o duplo sentido sustenta o diálogo.\f*\f + \fr 4.10: \ft Acréscimo: verbo ser/estar suprido em “você é que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:10 \xt JHN 4:14; JHN 7:38; LUK 11:9; REV 7:17; JHN 14:13; REV 22:1\x*
\v 11 \w A mulher|strong="G3588,G1135"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Senhor|strong="G2962"\w*, \w você não tem|strong="G3777,G2192"\w* \w nem balde|strong="G502"\w* \w e|strong="G2532"\w* \w o poço|strong="G3588,G5421"\w* \w é fundo|strong="G1510,G901"\w*; \w de onde então|strong="G4159,G3767"\w* \w você tem|strong="G2192"\w* \w a água|strong="G3588,G5204"\w* \w viva|strong="G3588,G2198"\w*?\x - \xo 4:11 \xt REV 22:1; ISA 55:1; REV 7:17; ISA 12:3; JHN 3:4; 1CO 2:14\x*
\v 12 \w Acaso|strong="G3361"\w* \w você|strong="G4771"\w* \w é maior|strong="G3173,G1510"\w* \w do que o nosso pai|strong="G3588,G3962,G3165"\w* \w Jacó|strong="G2384"\w*, \w que nos deu|strong="G3739,G1325,G3165"\w* \w o poço|strong="G3588,G5421"\w* \w e|strong="G2532"\w* \w ele mesmo|strong="G846"\w* \w dele|strong="G1537,G846"\w* \w bebeu|strong="G4095"\w* \w e|strong="G2532"\w* \w os filhos|strong="G3588,G5207"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w o seu gado|strong="G3588,G2353,G846"\w*?”\x - \xo 4:12 \xt ISA 55:1; ISA 12:3; JHN 3:4; REV 22:14; JHN 8:53; MAT 12:42\x*
\v 13 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Todo|strong="G3956"\w* \w aquele que bebe|strong="G3588,G4095"\w* \w desta água|strong="G1537,G3588,G5204,G3778"\w* \w terá sede|strong="G1372"\w* \w de novo|strong="G3825"\w*;\x - \xo 4:13 \xt ISA 55:1; JHN 6:35; ISA 12:3; JHN 6:27; ISA 41:17; ISA 65:13-14\x*
\v 14 \w mas|strong="G1161"\w* \w quem quer que|strong="G3739,G302"\w* \w beba|strong="G4095"\w* \w da água|strong="G1537,G3588,G5204"\w* \w que eu|strong="G3739,G1473"\w* \w lhe darei|strong="G1325,G846"\w*, \w jamais|strong="G3756,G3361"\w* \w terá sede|strong="G1372"\w* \w para sempre|strong="G1519,G3588,G165"\w*, \w mas|strong="G235"\w* \w a água|strong="G3588,G5204"\w* \w que|strong="G3739"\w* \w lhe darei|strong="G1325,G846"\w* \w se tornará|strong="G1096"\w* \w nele|strong="G1722,G846"\w* \w uma fonte|strong="G4077"\w* \w de água|strong="G5204"\w* \w que jorra|strong="G242"\w* \w para vida|strong="G1519,G2222"\w* \w eterna|strong="G166"\w*.”\x - \xo 4:14 \xt JHN 4:10; REV 21:6; JHN 7:38; MAT 5:6; REV 22:17; ISA 59:21\x*
\v 15 \w A mulher|strong="G3588,G1135"\w* \w lhe disse|strong="G3004,G4314,G846"\w*: “\w Senhor|strong="G2962"\w*, \w dê|strong="G1325"\w*-\w me|strong="G3165"\w* \w esta água|strong="G3778,G3588,G5204"\w*, \w para que não|strong="G2443,G3361"\w* \w eu tenha sede|strong="G1372"\w* \w nem|strong="G3366"\w* \w venha|strong="G1330"\w* \w aqui|strong="G1759"\w* \w tirar água|strong="G501"\w*.”\x - \xo 4:15 \xt JHN 6:34; ISA 41:17; PSA 4:6; ROM 8:5; JAS 4:3; JHN 17:2-3\x*
\v 16 \w Disse-lhe|strong="G3004,G846"\w*: “\w Vá|strong="G5217"\w* \w chame|strong="G5455"\w* \w o seu|strong="G3588,G4771"\w* \w marido|strong="G435"\w* \w e|strong="G2532"\w* \w venha|strong="G2064"\w* \w aqui|strong="G1759"\w*.”\f + \fr 4.16: \ft Variante: Treg e o RP acrescentam “Jesus” (ὁ Ἰησοῦς) depois de “disse-lhe”; WH traz a ordem “seu marido” (σου τὸν ἄνδρα).\f*\x - \xo 4:16 \xt HEB 4:13; JHN 21:17; REV 2:23; JHN 2:24-25\x*
\v 17 \w Respondeu|strong="G611"\w* \w a mulher|strong="G3588,G1135"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Não tenho|strong="G3756,G2192"\w* \w marido|strong="G435"\w*.” \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Disse|strong="G2036"\w* \w bem|strong="G2573"\w*: ‘\w marido|strong="G435"\w* \w não tenho|strong="G3756,G2192"\w*’;\x - \xo 4:17 \xt 1CO 11:8; LUK 20:39; JHN 4:29; ROM 11:20\x*
\v 18 \w pois|strong="G1063"\w* \w cinco|strong="G4002"\w* \w maridos|strong="G435"\w* \w você teve|strong="G2192"\w*, \w e|strong="G2532"\w* \w agora|strong="G3568"\w* \w aquele que|strong="G3739"\w* \w você tem|strong="G2192"\w* \w não|strong="G3756"\w* \w é|strong="G1510"\w* \w seu|strong="G4771"\w* \w marido|strong="G435"\w*; \w isto|strong="G3778"\w* \w você disse|strong="G2046"\w* \w com verdade|strong="G227"\w*.”\x - \xo 4:18 \xt 1CO 7:10-11; JER 3:20; ROM 7:3; JHN 4:29; MRK 10:12; ROM 11:20\x*
\v 19 \w A mulher|strong="G3588,G1135"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Senhor|strong="G2962"\w*, \w vejo|strong="G2334"\w* \w que|strong="G3754"\w* \w profeta|strong="G4396"\w* \w é você|strong="G1510,G4771"\w*.\x - \xo 4:19 \xt JHN 6:14; JHN 15:15; LUK 7:39; JHN 9:17; LUK 7:16; MAT 21:11\x*
\v 20 \w Os nossos|strong="G3588,G3165"\w* \w pais|strong="G3962"\w* \w neste|strong="G1722,G3588,G3778"\w* \w monte|strong="G3735"\w* \w adoraram|strong="G4352"\w*\f + \fr 4.20: \ft Nota cultural: “Este monte” é provavelmente o monte Gerizim, que os samaritanos tinham como lugar de culto.\f*; \w e|strong="G2532"\w* \w vocês|strong="G4771"\w* \w dizem|strong="G3004"\w* \w que|strong="G3754"\w* \w em Jerusalém|strong="G1722,G2414"\w* \w está|strong="G1510"\w* \w o lugar|strong="G3588,G5117"\w* \w onde|strong="G3699"\w* \w é necessário|strong="G1163"\w* \w adorar|strong="G4352"\w*.”\x - \xo 4:20 \xt ISA 66:1; EXO 20:24; DEU 12:5; GEN 33:18-20; 2CH 7:12; DEU 11:29\x*
\v 21 \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Acredite em mim|strong="G4100,G3165"\w*, \w mulher|strong="G1135"\w*, \w que|strong="G3754"\w* \w vem|strong="G2064"\w* \w uma hora|strong="G5610"\w* \w em que|strong="G3753"\w* \w nem|strong="G3777"\w* \w neste|strong="G1722,G3588,G3778"\w* \w monte|strong="G3735"\w* \w nem|strong="G3777"\w* \w em Jerusalém|strong="G1722,G2414"\w* \w adorarão|strong="G4352"\w* \w ao Pai|strong="G3588,G3962"\w*.\x - \xo 4:21 \xt JHN 4:23; ISA 66:1; 1TI 2:8; ACT 7:49; EXO 20:24; EPH 2:18\x*
\v 22 \w Vocês|strong="G4771"\w* \w adoram|strong="G4352"\w* \w o que|strong="G3739"\w* \w não conhecem|strong="G3756,G6063"\w*, \w nós|strong="G3165"\w* \w adoramos|strong="G4352"\w* \w o que|strong="G3739"\w* \w conhecemos|strong="G6063"\w*, \w porque|strong="G3754"\w* \w a salvação|strong="G3588,G4991"\w* \w vem|strong="G1537,G1510"\w* \w dos judeus|strong="G3588,G2453"\w*;\x - \xo 4:22 \xt ACT 17:23; ACT 17:24; ISA 2:3; ROM 9:4-5; LUK 24:47; ACT 17:30\x*
\v 23 \w mas|strong="G235"\w* \w vem|strong="G2064"\w* \w uma hora|strong="G5610"\w* — \w e|strong="G2532"\w* \w agora|strong="G3568"\w* \w é|strong="G1510"\w* —, \w em que|strong="G3753"\w* \w os verdadeiros|strong="G3588,G228"\w* \w adoradores|strong="G4353"\w* \w adorarão|strong="G4352"\w* \w ao Pai|strong="G3588,G3962"\w* \w em espírito|strong="G1722,G4151"\w* \w e|strong="G2532"\w* \w verdade|strong="G225"\w*\f + \fr 4.23: \ft Lit.: Ἐν πνεύματι καὶ ἀληθείᾳ: “em espírito e verdade”: πνεῦμα pode ser a dimensão interior ou o Espírito; o v. 24 diz que Deus é πνεῦμα.\f*, \w pois|strong="G2532,G1063"\w* \w também o Pai|strong="G3588,G3962"\w* \w procura|strong="G2212"\w* \w tais|strong="G5108"\w* \add pessoas,\add* \w os que o adoram|strong="G3588,G4352,G846"\w*;\f + \fr 4.23: \ft Acréscimo: “pessoas” (em “procura tais pessoas os que”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 4:23 \xt JHN 5:25; JHN 4:21; PHP 3:3; MAT 15:7-9; GAL 4:6; ROM 8:26\x*
\v 24 \w Deus|strong="G3588,G2316"\w* \w é espírito|strong="G4151"\w*, \w e|strong="G2532"\w* \w os que o adoram|strong="G3588,G4352,G846"\w* \w é necessário|strong="G1163"\w* \w que adorem|strong="G4352"\w* \w em espírito|strong="G1722,G4151"\w* \w e|strong="G2532"\w* \w verdade|strong="G225"\w*.”\f + \fr 4.24: \ft Acréscimo: verbo ser/estar suprido em “é espírito”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:24 \xt 2CO 3:17; MAT 15:8-9; 1CH 28:9; PHP 3:3; 1SA 7:3; PSA 145:18\x*
\v 25 \w A mulher|strong="G3588,G1135"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Sei|strong="G6063"\w* \w que|strong="G3754"\w* \w o Messias|strong="G3323"\w* \w vem|strong="G2064"\w*, \w chamado|strong="G3588,G3004"\w* \w Cristo|strong="G5547"\w*; \w quando|strong="G3752"\w* \w ele vier|strong="G2064,G1565"\w*, \w anunciará|strong="G312"\w* \w a nós|strong="G3165"\w* \w tudo|strong="G537"\w*.”\x - \xo 4:25 \xt DEU 18:18; LUK 4:21; JHN 1:41; JHN 1:49; DAN 9:24-26; JHN 4:10\x*
\v 26 \w Jesus|strong="G3588,G2424"\w* \w lhe disse|strong="G3004,G846"\w*: “\w Eu sou|strong="G1473,G1510"\w*, \w aquele que fala|strong="G3588,G2980"\w* \w com você|strong="G4771"\w*.”\f + \fr 4.26: \ft Lit.: Ἐγώ εἰμι, “eu sou”: aqui responde à expectativa do Messias (“sou eu”); em João a expressão aparece também em usos absolutos (por exemplo 8:58).\f*\x - \xo 4:26 \xt JHN 8:24; LUK 4:21; MRK 14:61-62; JHN 4:10; JHN 9:35-37; JHN 9:37\x*
\v 27 \w E|strong="G2532"\w* \w neste momento|strong="G1909,G3778"\w* \w chegaram|strong="G2064"\w* \w os discípulos|strong="G3588,G3101"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w estavam admirados|strong="G2296"\w* \w de que|strong="G3754"\w* \w falasse|strong="G2980"\w* \w com uma mulher|strong="G3326,G1135"\w*; \w ninguém|strong="G3762"\w*, \w contudo|strong="G3305"\w*, \w disse|strong="G2036"\w*: “\w O que|strong="G5101"\w* \w procura|strong="G2212"\w*?” \w ou|strong="G2228"\w* “\w Por que|strong="G5101"\w* \w fala|strong="G2980"\w* \w com ela|strong="G3326,G846"\w*?”\x - \xo 4:27 \xt LUK 7:39; ACT 10:28; GEN 37:15; JHN 4:8-9; JHN 4:9; MRK 9:32\x*
\v 28 \w Deixou|strong="G863"\w* \w então|strong="G3767"\w* \w a sua|strong="G3588,G846"\w* \w jarra|strong="G5201"\w* \w a mulher|strong="G3588,G1135"\w* \w e|strong="G2532"\w* \w foi|strong="G565"\w* \w para a cidade|strong="G1519,G3588,G4172"\w* \w e|strong="G2532"\w* \w disse|strong="G3004"\w* \w às pessoas|strong="G3588,G444"\w*:\x - \xo 4:28 \xt JHN 1:41; JHN 4:7; JDG 13:10; LUK 24:33; MAT 28:8\x*
