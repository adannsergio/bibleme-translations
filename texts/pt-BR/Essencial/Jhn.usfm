\v 32 \w Olhem|strong="G2400"\w*, \w vem|strong="G2064"\w* \w hora|strong="G5610"\w* \w e|strong="G2532"\w* \w já veio|strong="G2064"\w*, \w para que|strong="G2443"\w* \w sejam dispersos|strong="G4650"\w* \w cada um|strong="G1538"\w* \w para o que é seu|strong="G1519,G3588,G2398"\w* \w e me|strong="G2532_B,G1473"\w* \w deixem|strong="G863"\w* \w sozinho|strong="G3441"\w*; \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w estou|strong="G1510"\w* \w sozinho|strong="G3441"\w*, \w porque|strong="G3754"\w* \w o Pai|strong="G3588,G3962"\w* \w está|strong="G1510"\w* \w comigo|strong="G3326,G1473"\w*\f + \fr 16.32: \ft Variante: o RP traz “agora” (νῦν) onde o SBLGNT traz “e” (καί), antes de “já veio”.\f*.\f + \fr 16.32: \ft Acréscimo: verbo ser/estar suprido em “para o que é seu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 16:32 \xt ZEC 13:7; MAT 26:31; JHN 8:29; PSA 27:10; MRK 14:27; JHN 8:16\x*
\v 33 \w Estas coisas|strong="G3778"\w* \w lhes falei|strong="G2980,G4771"\w*, \w para que|strong="G2443"\w* \w em mim|strong="G1722,G1473"\w* \w paz|strong="G1515"\w* \w tenham|strong="G2192"\w*; \w no mundo|strong="G1722,G3588,G2889"\w* \w aflição|strong="G2347"\w* \w têm|strong="G2192"\w*, \w mas|strong="G235"\w* \w tenham ânimo|strong="G2293"\w*: \w eu|strong="G1473"\w* \w venci|strong="G3528"\w* \w o mundo|strong="G3588,G2889"\w*.”\x - \xo 16:33 \xt 1JN 5:4; 1JN 4:4; 2TH 3:16; ISA 26:3; JHN 14:1; JHN 14:27\x*
\c 17
\p
\v 1 \w Estas coisas|strong="G3778"\w* \w falou|strong="G2980"\w* \w Jesus|strong="G2424"\w*, \w e|strong="G2532"\w* \w erguendo|strong="G1869"\w* \w os olhos|strong="G3588,G3788"\w* \w dele|strong="G846"\w* \w ao céu|strong="G1519,G3588,G3772"\w*, \w disse|strong="G2036"\w*: “\w Pai|strong="G3962"\w*, \w chegou|strong="G2064"\w* \w a hora|strong="G3588,G5610"\w*; \w glorifique|strong="G1392"\w* \w o seu Filho|strong="G4771,G3588,G5207"\w*, \w para que|strong="G2443"\w* \w o Filho|strong="G3588,G5207"\w* \w glorifique|strong="G1392"\w* \w você|strong="G4771"\w*,\f + \fr 17.1: \ft Variante: o RP acrescenta o artigo diante de “Jesus”, traz “ergueu os olhos… e disse” (ἐπῆρεν… καὶ εἶπεν) em lugar de “erguendo… disse”, acrescenta “também” (καί) depois de “para que” e “seu” (σου) depois do segundo “Filho”.\f*\x - \xo 17:1 \xt JHN 12:23; JHN 7:6; MAT 17:8; LUK 6:20; JHN 17:4-5; PHP 2:9\x*
\v 2 \w assim como|strong="G2531"\w* \w deu|strong="G1325"\w* \w a ele|strong="G846"\w* \w autoridade|strong="G1849"\w* \w sobre toda|strong="G3956"\w* \w carne|strong="G4561"\w*, \w para que|strong="G2443"\w* \w tudo o que|strong="G3956,G3739"\w* \w deu|strong="G1325"\w* \w a ele|strong="G846"\w*, \w dê|strong="G1325"\w* \w a eles|strong="G846"\w* \w vida eterna|strong="G2222,G166"\w*.\f + \fr 17.2: \ft Lit.: Πᾶσα σάρξ, “toda carne”: toda a humanidade, todo ser humano.\f*\f + \fr 17.2: \ft Variante: WH e o RP trazem o futuro δώσει (“dará”) em lugar do subjuntivo δώσῃ (“dê”).\f*\x - \xo 17:2 \xt JHN 3:15; 1JN 5:11; JHN 10:28; 1JN 2:25; JHN 14:6; ROM 6:23\x*
\v 3 \w Esta|strong="G3778"\w* \w é|strong="G1510"\w* \w a vida|strong="G3588,G2222"\w* \w eterna|strong="G166"\w*: \w que conheçam|strong="G2443,G1097"\w* \w você|strong="G4771"\w*, \w o único|strong="G3588,G3441"\w* \w verdadeiro|strong="G228"\w* \w Deus|strong="G2316"\w*, \w e|strong="G2532"\w* \w aquele que|strong="G3739"\w* \w você enviou|strong="G649"\w*, \w Jesus|strong="G2424"\w* \w Cristo|strong="G5547"\w*.\x - \xo 17:3 \xt 1JN 5:20; 1JN 5:11; JHN 17:25; JHN 3:15; JHN 14:6; 1JN 2:25\x*
\v 4 \w Eu|strong="G1473"\w* \w glorifiquei|strong="G1392"\w* \w você|strong="G4771"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*, \w tendo completado|strong="G5048"\w* \w a obra|strong="G3588,G2041"\w* \w que|strong="G3739"\w* \w me deu|strong="G1325,G3165"\w* \w para que|strong="G2443"\w* \w eu fizesse|strong="G4160"\w*\f + \fr 17.4: \ft Variante: o RP traz o aoristo ἐτελείωσα (“completei”) em lugar do particípio τελειώσας (“tendo completado”).\f*;\x - \xo 17:4 \xt JHN 19:30; JHN 4:34; JHN 9:4; JHN 17:1; HEB 12:2; HEB 5:7\x*
\v 5 \w e|strong="G2532"\w* \w agora|strong="G3568"\w* \w glorifique|strong="G1392"\w* \w a mim|strong="G3165"\w* \w você|strong="G4771"\w*, \w Pai|strong="G3962"\w*, \w junto de si mesmo|strong="G3844,G4771"\w* \w com a glória|strong="G3588,G1391"\w* \w que|strong="G3739"\w* \w tinha|strong="G2192"\w* \w antes que|strong="G4253,G3588"\w* \w o mundo|strong="G3588,G2889"\w* \w existisse|strong="G1511"\w* \w junto de você|strong="G3844,G4771"\w*.\x - \xo 17:5 \xt JHN 1:1; JHN 17:24; JHN 8:54; JHN 13:31; JHN 11:4; PHP 2:6\x*
\p
\v 6 \w Manifestei|strong="G5319"\w* \w o seu nome|strong="G4771,G3588,G3686"\w* \w aos seres humanos|strong="G3588,G444"\w* \w que|strong="G3739"\w* \w me deu|strong="G1325,G3165"\w* \w do mundo|strong="G1537,G3588,G2889"\w*. \w Eram seus|strong="G4771,G1510"\w*, \w e a mim|strong="G2532_A,G1473"\w* \w os deu|strong="G846,G1325"\w*, \w e|strong="G2532"\w* \w a sua palavra|strong="G3588,G3056,G4771"\w* \w têm guardado|strong="G5083"\w*.\x - \xo 17:6 \xt MAT 11:27; REV 3:8; JHN 1:18; JHN 17:26; 1JN 5:20; JHN 14:21-24\x*
\v 7 \w Agora|strong="G3568"\w* \w reconheceram|strong="G1097"\w* \w que|strong="G3754"\w* \w tudo|strong="G3956"\w* \w o que|strong="G3745"\w* \w me deu|strong="G1325,G3165"\w* \w é|strong="G1510"\w* \w da parte de você|strong="G3844,G4771"\w*.\x - \xo 17:7 \xt JHN 11:22; JHN 7:16-17; JHN 17:20; PSA 69:13; 1CO 2:16; JHN 16:15\x*
\v 8 \w Porque|strong="G3754"\w* \w as palavras|strong="G3588,G4487"\w* \w que|strong="G3739"\w* \w me deu|strong="G1325,G3165"\w* \w dei|strong="G1325"\w* \w a eles|strong="G846"\w*, \w e|strong="G2532"\w* \w eles|strong="G846"\w* \w receberam|strong="G2983"\w* \w e|strong="G2532"\w* \w reconheceram|strong="G1097"\w* \w verdadeiramente|strong="G230"\w* \w que|strong="G3754"\w* \w da parte de você|strong="G3844,G4771"\w* \w saí|strong="G1831"\w*, \w e|strong="G2532"\w* \w creram|strong="G4100"\w* \w que|strong="G3754"\w* \w você|strong="G4771"\w* \w me enviou|strong="G3165,G649"\w*.\x - \xo 17:8 \xt JHN 16:27; JHN 14:10; 1TH 2:13; JHN 8:42; JHN 17:25; JHN 4:42\x*
\v 9 \w Eu|strong="G1473"\w* \w a respeito deles|strong="G4012,G846"\w* \w rogo|strong="G2065"\w*; \w não|strong="G3756"\w* \w a respeito do mundo|strong="G4012,G3588,G2889"\w* \w rogo|strong="G2065"\w*, \w mas|strong="G235"\w* \w a respeito daqueles que|strong="G4012,G3739"\w* \w me deu|strong="G1325,G3165"\w*, \w porque|strong="G3754"\w* \w seus|strong="G4771"\w* \w são|strong="G1510"\w*,\x - \xo 17:9 \xt JHN 17:15; LUK 22:32; HEB 9:24; JHN 17:2; JHN 14:16; 2TI 1:9\x*
\v 10 \w e|strong="G2532"\w* \w tudo o que é meu|strong="G3588,G1473,G3956"\w* \w é seu|strong="G4771,G1510"\w* \w e|strong="G2532"\w* \w o que é seu|strong="G3588,G4771"\w* \w é meu|strong="G1473"\w*, \w e|strong="G2532"\w* \w tenho sido glorificado|strong="G1392"\w* \w neles|strong="G1722,G846"\w*.\f + \fr 17.10: \ft Acréscimo: verbo ser/estar suprido em “tudo o que é meu”, “o que é seu”, “é meu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 17:10 \xt LUK 22:32; JHN 10:30; JHN 16:15; JHN 14:16; 1PE 2:9; REV 5:8-14\x*
\v 11 \w E|strong="G2532"\w* \w já não|strong="G2089,G3756"\w* \w estou|strong="G1510"\w* \w no mundo|strong="G1722,G3588,G2889"\w*, \w e|strong="G2532"\w* \w eles|strong="G846"\w* \w no mundo|strong="G1722,G3588,G2889"\w* \w estão|strong="G1510"\w*, \w e eu|strong="G2532_C,G1473"\w* \w para junto de você|strong="G4314,G4771"\w* \w venho|strong="G2064"\w*. \w Pai|strong="G3962"\w* \w santo|strong="G40"\w*, \w guarde|strong="G5083"\w*-\w os|strong="G846"\w* \w no seu nome|strong="G1722,G3588,G3686,G4771"\w*, \w que|strong="G3739"\w* \w me deu|strong="G1325,G3165"\w*, \w para que|strong="G2443"\w* \w sejam|strong="G1510"\w* \w um|strong="G1520"\w* \w assim como|strong="G2531"\w* \w nós|strong="G3165"\w*.\f + \fr 17.11: \ft Variante: Treg e o RP trazem “estes” (οὗτοι) em lugar de “eles” (αὐτοί); Treg acrescenta “também” (καί) depois de “assim como”.\f*\x - \xo 17:11 \xt NUM 6:24; JHN 17:21; LUK 22:32; MAT 6:9; PRO 18:10; JHN 14:16\x*
\v 12 \w Quando|strong="G3753"\w* \w estava|strong="G1510"\w* \w com eles|strong="G3326,G846"\w*, \w eu|strong="G1473"\w* \w os guardava|strong="G5083,G846"\w* \w no seu|strong="G1722,G3588,G4771"\w* \w nome|strong="G3686"\w*, \w que|strong="G3739"\w* \w me deu|strong="G1325,G3165"\w*, \w e|strong="G2532"\w* \w protegi|strong="G5442"\w*, \w e|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w dentre eles|strong="G1537,G846"\w* \w se perdeu|strong="G622"\w* \w a não ser|strong="G1487,G3361"\w* \w o filho|strong="G3588,G5207"\w* \w da perdição|strong="G3588,G684"\w*, \w para que|strong="G2443"\w* \w a Escritura|strong="G3588,G1124"\w* \w se cumprisse|strong="G4137"\w*.\f + \fr 17.12: \ft Lit.: Τηρέω e φυλάσσω, “guardar, proteger”: dois verbos de sentido próximo. Ὁ υἱὸς τῆς ἀπωλείας, “o filho da perdição”: semitismo para “aquele destinado à perdição”; refere-se a Judas (cf. 6:70-71; 13:18).\f*\f + \fr 17.12: \ft Variante: o RP acrescenta “no mundo” (ἐν τῷ κόσμῳ) depois de “com eles”, traz “os que” (οὓς) em lugar de “no qual” (ᾧ) e omite “e” (καί) antes de “protegi”.\f*\x - \xo 17:12 \xt JHN 18:9; PSA 109:6-19; JHN 10:27-28; JHN 6:39; JHN 13:18; JHN 10:28\x*
\v 13 \w Agora|strong="G3568"\w* \w para junto de você|strong="G4314,G4771"\w* \w venho|strong="G2064"\w*, \w e|strong="G2532"\w* \w estas coisas|strong="G3778"\w* \w falo|strong="G2980"\w* \w no mundo|strong="G1722,G3588,G2889"\w*, \w para que|strong="G2443"\w* \w tenham|strong="G2192"\w* \w a minha|strong="G3588,G1473"\w* \w alegria|strong="G5479"\w* \w completada|strong="G4137"\w* \w em si mesmos|strong="G1722,G1438"\w*.\f + \fr 17.13: \ft Variante: o RP traz αὐτοῖς (“neles”) em lugar de ἑαυτοῖς (“em si mesmos”).\f*\x - \xo 17:13 \xt JHN 15:11; 1JN 1:4; ACT 13:52; 2JN 1:12; JHN 3:29; JHN 16:22\x*
\v 14 \w Eu|strong="G1473"\w* \w dei|strong="G1325"\w* \w a eles|strong="G846"\w* \w a sua palavra|strong="G3588,G3056,G4771"\w*, \w e|strong="G2532"\w* \w o mundo|strong="G3588,G2889"\w* \w os odiou|strong="G3404,G846"\w*, \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w são|strong="G1510"\w* \w do mundo|strong="G1537,G3588,G2889"\w*, \w assim como|strong="G2531"\w* \w eu|strong="G1473"\w* \w não|strong="G3756"\w* \w sou|strong="G1510"\w* \w do mundo|strong="G1537,G3588,G2889"\w*.\x - \xo 17:14 \xt JHN 17:16; JHN 15:18; 1JN 3:13; ROM 12:2; JHN 7:7; JHN 15:19\x*
\v 15 \w Não|strong="G3756"\w* \w rogo|strong="G2065"\w* \w para que|strong="G2443"\w* \w os tire|strong="G142,G846"\w* \w do mundo|strong="G1537,G3588,G2889"\w*, \w mas|strong="G235"\w* \w para que|strong="G2443"\w* \w os guarde|strong="G5083,G846"\w* \w do Maligno|strong="G1537,G3588,G4190"\w*.\f + \fr 17.15: \ft Lit.: Ἐκ τοῦ πονηροῦ: “do Maligno” (masculino) ou “do mal” (neutro); aqui se segue a leitura pessoal (cf. 1Jo 5:18-19).\f*\x - \xo 17:15 \xt 1JN 5:18; JHN 17:9; JHN 17:11; JHN 5:12; 2TH 3:3; MAT 6:13\x*
\v 16 \w Do mundo|strong="G1537,G3588,G2889"\w* \w não|strong="G3756"\w* \w são|strong="G1510"\w*, \w assim como|strong="G2531"\w* \w eu|strong="G1473"\w* \w não|strong="G3756"\w* \w sou|strong="G1510"\w* \w do mundo|strong="G1537,G3588,G2889"\w*.\x - \xo 17:16 \xt JHN 17:14; ROM 8:29; JHN 17:18; JHN 17:11; JHN 17:21; JHN 17:23\x*
\v 17 \w Consagre-os|strong="G37,G846"\w* \w na verdade|strong="G1722,G3588,G225"\w*; \w a sua palavra|strong="G3588,G3056,G4771"\w* \w é verdade|strong="G225,G1510"\w*.\f + \fr 17.17: \ft Variante: o RP acrescenta “sua” (σου) depois de “verdade”.\f*\f + \fr 17.17: \ft Tradução: ἁγίασον (ἁγιάζω, G37) está aqui como “Consagre-os”; o termo pode ser “santificar”, “consagrar” ou “purificar”, e o contexto decide.\f*\x - \xo 17:17 \xt JHN 17:19; JHN 8:32; PSA 119:160; JHN 15:3; EPH 5:26; 1PE 1:22\x*
\v 18 \w Assim como|strong="G2531"\w* \w a mim|strong="G1473"\w* \w você enviou|strong="G649"\w* \w ao mundo|strong="G1519,G3588,G2889"\w*, \w também eu|strong="G2532,G1473"\w* \w os enviei|strong="G649,G846"\w* \w ao mundo|strong="G1519,G3588,G2889"\w*;\x - \xo 17:18 \xt JHN 17:21; JHN 17:23; JHN 20:21; JHN 17:16; JHN 17:25; JHN 10:36\x*
\v 19 \w e|strong="G2532"\w* \w em favor|strong="G5228"\w* \w deles|strong="G846"\w* \w eu|strong="G1473"\w* \w me consagro|strong="G37,G1473"\w*, \w para que|strong="G2443"\w* \w sejam|strong="G1510"\w* \w também|strong="G2532"\w* \w eles mesmos|strong="G846"\w* \w consagrados|strong="G37"\w* \w em verdade|strong="G1722,G225"\w*.\f + \fr 17.19: \ft Tradução: ἡγιασμένοι (ἁγιάζω, G37) está aqui como “consagrados”; o termo pode ser “santificar”, “consagrar” ou “purificar”, e o contexto decide.\f*\x - \xo 17:19 \xt JHN 17:17; ROM 8:29; 2CO 13:8; EPH 5:26; JHN 20:21; JOS 3:5\x*
\p
\v 20 \w Não|strong="G3756"\w* \w a respeito destes|strong="G4012,G3778"\w*, \w porém|strong="G1161"\w*, \w rogo|strong="G2065"\w* \w somente|strong="G3441"\w*, \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w a respeito|strong="G4012"\w* \w dos que creem|strong="G3588,G4100"\w* \w em mim|strong="G1519,G1473"\w* \w por meio da palavra deles|strong="G1223,G3588,G3056,G846"\w*,\x - \xo 17:20 \xt JHN 16:30; MRK 4:10; GAL 3:28; JHN 14:16; JHN 17:6-11; PSA 86:11\x*
\v 21 \w para que|strong="G2443"\w* \w todos|strong="G3956"\w* \w um|strong="G1520"\w* \w sejam|strong="G1510"\w*, \w assim como|strong="G2531"\w* \w você|strong="G4771"\w*, \w Pai|strong="G3962"\w*, \w em mim|strong="G1722,G1473"\w*, \w e eu|strong="G2532_A,G1473"\w* \w em você|strong="G1722,G4771"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w eles|strong="G846"\w* \w em nós|strong="G1722,G3165"\w* \w sejam|strong="G1510"\w*, \w para que|strong="G2443"\w* \w o mundo|strong="G3588,G2889"\w* \w creia|strong="G4100"\w* \w que|strong="G3754"\w* \w você|strong="G4771"\w* \w me enviou|strong="G3165,G649"\w*.\f + \fr 17.21: \ft Variante: Treg traz “Pai” em nominativo (πατήρ); o RP acrescenta “um” (ἕν) depois de “em nós” e traz πιστεύσῃ (“venha a crer”) em lugar de πιστεύῃ (“creia”).\f*\x - \xo 17:21 \xt JHN 17:18; JHN 17:23; JHN 6:57; JHN 3:17; JHN 17:25; JHN 17:16\x*
\v 22 \w E eu|strong="G2532,G1473"\w* \w a glória|strong="G3588,G1391"\w* \w que|strong="G3739"\w* \w me deu|strong="G1325,G3165"\w* \w dei|strong="G1325"\w* \w a eles|strong="G846"\w*, \w para que|strong="G2443"\w* \w sejam|strong="G1510"\w* \w um|strong="G1520"\w* \w assim como|strong="G2531"\w* \w nós|strong="G3165"\w* \w somos um|strong="G1520"\w*.\f + \fr 17.22: \ft Variante: o RP acrescenta “somos” (ἐσμεν) depois de “um”.\f*\f + \fr 17.22: \ft Acréscimo: verbo ser/estar suprido em “somos um”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 17:22 \xt ROM 8:29; ROM 15:7; JHN 10:30; 1CO 6:17; EPH 2:6; JHN 14:20\x*
\v 23 \w Eu|strong="G1473"\w* \w neles|strong="G1722,G846"\w* \w e|strong="G2532"\w* \w você|strong="G4771"\w* \w em mim|strong="G1722,G1473"\w*, \w para que|strong="G2443"\w* \w sejam|strong="G1510"\w* \w aperfeiçoados|strong="G5048"\w* \w em um|strong="G1519,G1520"\w*, \w para que|strong="G2443"\w* \w conheça|strong="G1097"\w* \w o mundo|strong="G3588,G2889"\w* \w que|strong="G3754"\w* \w você|strong="G4771"\w* \w me enviou|strong="G3165,G649"\w* \w e|strong="G2532"\w* \w os amou|strong="G25,G846"\w* \w assim como|strong="G2531"\w* \w a mim|strong="G1473"\w* \w amou|strong="G25"\w*.\f + \fr 17.23: \ft Variante: o RP acrescenta “e” (καί) antes do segundo “para que”.\f*\x - \xo 17:23 \xt JHN 17:18; ROM 8:29; JHN 17:21; JHN 15:9; JHN 17:25; 1JN 4:12\x*
\v 24 \w Pai|strong="G3962"\w*, \w o que|strong="G3739"\w* \w me deu|strong="G1325,G3165"\w*, \w quero|strong="G2309"\w* \w que|strong="G2443"\w* \w onde|strong="G3699"\w* \w eu|strong="G1473"\w* \w estou|strong="G1510"\w*, \w também eles|strong="G1565,G2532"\w* \w estejam|strong="G1510"\w* \w comigo|strong="G3326,G1473"\w*, \w para que|strong="G2443"\w* \w contemplem|strong="G2334"\w* \w a minha glória|strong="G3588,G1391,G1473"\w*, \w que|strong="G3739"\w* \w me deu|strong="G1325,G3165"\w*, \w porque|strong="G3754"\w* \w me amou|strong="G25,G3165"\w* \w antes|strong="G4253"\w* \w da fundação|strong="G2602"\w* \w do mundo|strong="G2889"\w*.\f + \fr 17.24: \ft Variante: o RP traz “os que” (οὕς, masculino) em lugar de “o que” (ὅ, neutro) e ἔδωκας (“deu”) em lugar de δέδωκας; Treg traz “Pai” em nominativo (Πατήρ).\f*\x - \xo 17:24 \xt EPH 1:4; JHN 17:5; 2CO 3:18; LUK 23:43; EPH 2:6; JHN 15:9\x*
\v 25 \w Pai|strong="G3962"\w* \w justo|strong="G1342"\w*, \w e|strong="G2532"\w* \w o mundo|strong="G3588,G2889"\w* \w não conheceu|strong="G3756,G1097"\w* \w você|strong="G4771"\w*, \w eu|strong="G1473"\w*, \w porém|strong="G1161"\w*, \w conheci|strong="G1097"\w* \w você|strong="G4771"\w*, \w e|strong="G2532"\w* \w estes|strong="G3778"\w* \w reconheceram|strong="G1097"\w* \w que|strong="G3754"\w* \w você|strong="G4771"\w* \w me enviou|strong="G3165,G649"\w*,\x - \xo 17:25 \xt JHN 1:10; JHN 17:3; 1JN 3:1; JHN 17:18; JHN 17:23; MAT 11:27\x*
\v 26 \w e|strong="G2532"\w* \w dei a conhecer|strong="G1107"\w* \w a eles|strong="G846"\w* \w o seu nome|strong="G3588,G3686,G4771"\w* \w e|strong="G2532"\w* \w darei a conhecer|strong="G1107"\w*, \w para que|strong="G2443"\w* \w o amor|strong="G3588,G26"\w* \w com que|strong="G3739"\w* \w me amou|strong="G25,G3165"\w* \w neles|strong="G1722,G846"\w* \w esteja|strong="G1510"\w*, \w e eu|strong="G2532_C,G1473"\w* \w neles|strong="G1722,G846"\w*.”\x - \xo 17:26 \xt ROM 8:29; JHN 15:9; MAT 11:27; EPH 2:6; JHN 1:18; COL 1:27\x*
\c 18
\p
\v 1 \w Tendo dito|strong="G2036"\w* \w estas coisas|strong="G3778"\w*, \w Jesus|strong="G2424"\w* \w saiu|strong="G1831"\w* \w com os|strong="G4862,G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w* \w para o outro lado|strong="G4008"\w* \w do ribeiro|strong="G3588,G5493"\w* \w do Cedrom|strong="G3588,G2748"\w*, \w onde|strong="G3699"\w* \w havia|strong="G1510"\w* \w um jardim|strong="G2779"\w*, \w no qual|strong="G1519,G3739"\w* \w entrou|strong="G1525"\w* \w ele mesmo|strong="G846"\w* \w e|strong="G2532"\w* \w os seus|strong="G3588,G846"\w* \w discípulos|strong="G3101"\w*.\f + \fr 18.1: \ft Variante: o RP acrescenta o artigo diante de “Jesus”; WH e o RP trazem τῶν Κέδρων (“dos Cedros”) em lugar de τοῦ Κεδρών (“do Cedrom”).\f*\x - \xo 18:1 \xt 2SA 15:23; MRK 14:32; MAT 26:36; JER 31:40; JHN 18:26; LUK 22:39\x*
\v 2 \w Sabia|strong="G1492"\w* \w também|strong="G2532"\w* \w Judas|strong="G2455"\w*, \w aquele que o entregava|strong="G3588,G3860,G846"\w*, \w o lugar|strong="G3588,G5117"\w*, \w porque|strong="G3754"\w* \w muitas vezes|strong="G4178"\w* \w se reuniu|strong="G4863"\w* \w Jesus|strong="G2424"\w* \w ali|strong="G1563"\w* \w com os|strong="G3326,G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w*.\x - \xo 18:2 \xt JHN 12:4; ACT 1:16; LUK 21:37; LUK 22:39; MAT 26:14; LEV 2:6\x*
\v 3 \w Judas|strong="G3588,G2455"\w* \w então|strong="G3767"\w*, \w tendo tomado|strong="G2983"\w* \w a coorte|strong="G3588,G4686"\w* \w e|strong="G2532"\w* \w guardas|strong="G5257"\w* \w dos chefes dos sacerdotes|strong="G1537,G3588,G749"\w* \w e|strong="G2532"\w* \w dos fariseus|strong="G1537,G3588,G5330"\w*, \w veio|strong="G2064"\w* \w ali|strong="G1563"\w* \w com lanternas|strong="G3326,G5322"\w* \w e|strong="G2532"\w* \w tochas|strong="G2985"\w* \w e|strong="G2532"\w* \w armas|strong="G3696"\w*\f + \fr 18.3: \ft Nota cultural: σπεῖρα, “coorte”: unidade militar romana (em princípio, cerca de 600 homens; o número efetivo aqui é incerto); o χιλίαρχος do v. 12 é seu comandante.\f*.\x - \xo 18:3 \xt JHN 18:12; ACT 1:16; MRK 14:43; JHN 12:4; LUK 22:47; LEV 2:6\x*
\v 4 \w Jesus|strong="G2424"\w* \w então|strong="G3767"\w*, \w sabendo|strong="G6063"\w* \w tudo|strong="G3956"\w* \w o que vinha|strong="G3588,G2064"\w* \w sobre ele|strong="G1909,G846"\w*, \w saiu|strong="G1831"\w*, \w e|strong="G2532"\w* \w lhes disse|strong="G3004,G846"\w*: \add “A\add* \w quem|strong="G5101"\w* \w procuram|strong="G2212"\w*?”\f + \fr 18.4: \ft Variante: Treg traz “porém” (δέ) em lugar de “então” (οὖν); o RP traz “saindo, disse” (ἐξελθὼν εἶπεν) em lugar de “saiu e disse”.\f*\f + \fr 18.4: \ft Acréscimo: “A” (em “lhes disse A quem procuram”): preposição ou artigo que a regência do português exige.\f*\x - \xo 18:4 \xt JHN 10:39; JHN 19:28; JER 20:11; JHN 1:38; ACT 1:16; JHN 13:1\x*
\v 5 \w Responderam-lhe|strong="G611,G846"\w*: “\w Jesus|strong="G2424"\w*, \w o Nazareu|strong="G3588,G3480"\w*.” \w Disse-lhes|strong="G3004,G846"\w*: “\w Eu sou|strong="G1473,G1510"\w*.” \w Estava de pé|strong="G2476"\w* \w também|strong="G2532"\w* \w Judas|strong="G2455"\w*, \w aquele que o entregava|strong="G3588,G3860,G846"\w*, \w com eles|strong="G3326,G846"\w*.\f + \fr 18.5: \ft Lit.: Ναζωραῖος, “nazareno” (de Nazaré), também “nazoreu”; usado aqui, em 18:7 e em 19:19.\f*\f + \fr 18.5: \ft Lit.: Ἐγώ εἰμι: “sou eu” (identificação), mas a reação do v. 6 sugere o peso da fórmula divina (cf. 8:24, 28, 58; 13:19).\f*\f + \fr 18.5: \ft Variante: o RP acrescenta “Jesus” (ὁ Ἰησοῦς) depois de “lhes”.\f*\x - \xo 18:5 \xt JHN 12:4; MAT 10:4; ACT 22:8; JER 20:11; JHN 1:45; ACT 1:16\x*
\v 6 \w Quando|strong="G5613"\w* \w então|strong="G3767"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Eu sou|strong="G1473,G1510"\w*”, \w recuaram|strong="G565,G1519,G3588,G3694"\w* \w e|strong="G2532"\w* \w caíram|strong="G4098"\w* \w no chão|strong="G5476"\w*.\f + \fr 18.6: \ft Variante: o RP acrescenta “que” (ὅτι) depois de “lhes disse”.\f*\x - \xo 18:6 \xt JER 20:11; PSA 27:2; PSA 70:2; PSA 56:9; ACT 1:16; 2KI 1:9-15\x*
\v 7 \w De novo|strong="G3825"\w* \w então|strong="G3767"\w* \w lhes perguntou|strong="G1905,G846"\w*: \add “A\add* \w quem|strong="G5101"\w* \w procuram|strong="G2212"\w*?” \w Eles|strong="G3588,G1161"\w* \w disseram|strong="G2036"\w*: “\w Jesus|strong="G2424"\w*, \w o Nazareu|strong="G3588,G3480"\w*.”\f + \fr 18.7: \ft Acréscimo: “A” (em “lhes perguntou A quem procuram”): preposição ou artigo que a regência do português exige.\f*\x - \xo 18:7 \xt MRK 10:10; JHN 1:45; JHN 1:38; ACT 1:16; JHN 20:15; LUK 4:30\x*
\v 8 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w*: “\w Eu disse|strong="G2036"\w* \w a vocês|strong="G4771"\w*: ‘\w Eu sou|strong="G1473,G1510"\w*’; \w se|strong="G1487"\w* \w então|strong="G3767"\w* \w a mim|strong="G1473"\w* \w procuram|strong="G2212"\w*, \w deixem|strong="G863"\w* \w estes|strong="G3778"\w* \w ir|strong="G5217"\w*;”\x - \xo 18:8 \xt ACT 1:16; MRK 14:43; JHN 10:28; 2CO 12:9; LEV 2:6; LUK 22:51\x*
\v 9 \w para que|strong="G2443"\w* \w se cumprisse|strong="G4137"\w* \w a palavra|strong="G3588,G3056"\w* \w que|strong="G3739"\w* \w disse|strong="G2036"\w*: “\w Aqueles que|strong="G3739"\w* \w me deu|strong="G1325,G3165"\w*, \w não perdi|strong="G3756,G622"\w* \w nenhum|strong="G3762"\w* \w deles|strong="G1537,G846"\w*\f + \fr 18.9: \ft Lit.: cf. 17:12; 6:39.\f*.”\x - \xo 18:9 \xt JHN 17:12; JHN 10:28; NUM 31:49; JHN 6:39; 1SA 22:23; ACT 8:32\x*
