\v 23 \w Jesus|strong="G3588,G2424"\w* \w lhes respondeu|strong="G611,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Chegou|strong="G2064"\w* \w a hora|strong="G3588,G5610"\w* \w para que|strong="G2443"\w* \w seja glorificado|strong="G1392"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w*.\x - \xo 12:23 \xt JHN 17:1; JHN 8:54; JHN 2:4; JHN 4:23; JHN 13:1; JHN 12:27\x*
\v 24 \w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w se não|strong="G1437,G3361"\w* \w o grão|strong="G3588,G2848"\w* \w de trigo|strong="G3588,G4621"\w* \w tendo caído|strong="G4098"\w* \w na terra|strong="G1519,G3588,G1093"\w* \w morrer|strong="G599"\w*, \w ele mesmo|strong="G846"\w* \w sozinho|strong="G3441"\w* \w fica|strong="G3306"\w*; \w se|strong="G1437,G1161"\w* \w morrer|strong="G599"\w*, \w muito|strong="G4183"\w* \w fruto|strong="G2590"\w* \w produz|strong="G5342"\w*.\x - \xo 12:24 \xt 1CO 15:36; JHN 15:5; HEB 2:9-10; ISA 53:10; JHN 12:32-33; PSA 72:16\x*
\v 25 \w Aquele que ama|strong="G3588,G5368"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w a perde|strong="G622,G846"\w*, \w e|strong="G2532"\w* \w aquele que odeia|strong="G3588,G3404"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w neste mundo|strong="G1722,G3588,G2889,G3778"\w* \w para a vida|strong="G1519,G2222"\w* \w eterna|strong="G166"\w* \w a guardará|strong="G5442,G846"\w*.\f + \fr 12.25: \ft Lit.: Μισέω, “odiar”: em linguagem de contraste, “amar menos, desprezar em comparação”; ψυχή, “vida, alma”.\f*\x - \xo 12:25 \xt MAT 10:39; LUK 9:23; LUK 14:26; MRK 8:35; MAT 16:25; LUK 17:33\x*
\v 26 \w Se|strong="G1437"\w* \w alguém|strong="G5100"\w* \w me servir|strong="G1473,G1247"\w*, \w me siga|strong="G1473,G190"\w*, \w e|strong="G2532"\w* \w onde|strong="G3699"\w* \w eu|strong="G1473"\w* \w estou|strong="G1510"\w*, \w ali|strong="G1563"\w* \w também|strong="G2532"\w* \w o meu|strong="G3588,G1473"\w* \w servo|strong="G1249"\w* \w estará|strong="G1510"\w*; \w se|strong="G1437"\w* \w alguém|strong="G5100"\w* \w me servir|strong="G1473,G1247"\w*, \w o honrará|strong="G5091,G846"\w* \w o Pai|strong="G3588,G3962"\w*.\x - \xo 12:26 \xt LUK 9:23; REV 22:3; MAT 25:21; MAT 4:19; JHN 14:3; 1SA 2:30\x*
\v 27 \w Agora|strong="G3568"\w* \w a minha|strong="G3588,G3165"\w* \w alma|strong="G5590"\w* \w está perturbada|strong="G5015"\w*, \w e|strong="G2532"\w* \w o que|strong="G5101"\w* \w direi|strong="G2036"\w*? \w Pai|strong="G3962"\w*, \w salve-me|strong="G4982,G3165"\w* \w desta hora|strong="G1537,G3588,G5610,G3778"\w*. \w Mas|strong="G235"\w* \w por isso|strong="G1223,G3778"\w* \w vim|strong="G2064"\w* \w a esta hora|strong="G1519,G3588,G5610,G3778"\w*.\f + \fr 12.27: \ft Lit.: a pontuação é discutida: “Pai, livra-me desta hora” (pedido) ou “Pai, livra-me desta hora?” (pergunta retórica, que Jesus em seguida descarta).\f*\x - \xo 12:27 \xt LUK 22:42; HEB 12:2; HEB 5:7; JHN 14:1; JHN 17:1; MAT 26:39\x*
\v 28 \w Pai|strong="G3962"\w*, \w glorifique|strong="G1392"\w* \w o seu nome|strong="G4771,G3588,G3686"\w*.” \w Veio|strong="G2064"\w* \w então|strong="G3767"\w* \w uma voz|strong="G5456"\w* \w do céu|strong="G1537,G3588,G3772"\w*: “\w E|strong="G2532"\w* \w glorifiquei|strong="G1392"\w* \w e|strong="G2532"\w* \w de novo|strong="G3825"\w* \w glorificarei|strong="G1392"\w*.”\x - \xo 12:28 \xt JHN 14:13; 2PE 1:17; LUK 22:42; HEB 12:2; HEB 5:7; JHN 17:1\x*
\v 29 \w A multidão|strong="G3588,G3793"\w* \w então|strong="G3767"\w*, \w a que estava de pé|strong="G3588,G2476"\w* \w e|strong="G2532"\w* \w tendo ouvido|strong="G191"\w*, \w dizia|strong="G3004"\w* \w que tinha havido|strong="G1096"\w* \w um trovão|strong="G1027"\w*; \w outros|strong="G243"\w* \w diziam|strong="G3004"\w*: “\w Um anjo|strong="G32"\w* \w lhe falou|strong="G846,G2980"\w*.”\x - \xo 12:29 \xt 2PE 1:17; MAT 3:17; PHP 2:8; ACT 9:7; ISA 53:11; JOB 37:2-5\x*
\v 30 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Não|strong="G3756"\w* \w por mim|strong="G1223,G1473"\w* \w esta voz|strong="G3588,G5456,G3778"\w* \w aconteceu|strong="G1096"\w*, \w mas|strong="G235"\w* \w por vocês|strong="G1223,G4771"\w*.\x - \xo 12:30 \xt MAT 3:17; PHP 2:8; ISA 53:11; JHN 11:42; DEU 4:12; JHN 11:15\x*
\v 31 \w Agora|strong="G3568"\w* \w é o julgamento|strong="G2920,G1510"\w* \w deste mundo|strong="G3588,G2889,G3778"\w*; \w agora|strong="G3568"\w* \w o governante|strong="G3588,G758"\w* \w deste mundo|strong="G3588,G2889,G3778"\w* \w será lançado|strong="G1544"\w* \w fora|strong="G1854"\w*;\f + \fr 12.31: \ft Lit.: Ὁ ἄρχων τοῦ κόσμου τούτου, “o governante deste mundo”: título do adversário (cf. 14:30; 16:11).\f*\x - \xo 12:31 \xt JHN 16:11; JHN 14:30; EPH 2:2; JHN 16:8; 1JN 4:4; EPH 6:12\x*
\v 32 \w e eu|strong="G2532,G1473"\w*, \w quando|strong="G1437"\w* \w for levantado|strong="G5312"\w* \w da terra|strong="G1537,G3588,G1093"\w*, \w atrairei|strong="G1670"\w* \w todos|strong="G3956"\w* \w a mim mesmo|strong="G4314,G1473"\w*.”\f + \fr 12.32: \ft Lit.: Ὑψόω, “levantar, elevar”, como em 3:14 e 8:28; ἑλκύω, “puxar, atrair” (cf. 6:44).\f*\x - \xo 12:32 \xt COL 2:15; JHN 3:14; JHN 8:28; JHN 12:24; JHN 6:44; COL 1:13\x*
\v 33 \w Isto|strong="G3778"\w* \w dizia|strong="G3004"\w* \w indicando|strong="G4591"\w* \w de que tipo de|strong="G4169"\w* \w morte|strong="G2288"\w* \w estava para|strong="G3195"\w* \w morrer|strong="G599"\w*.\x - \xo 12:33 \xt JHN 18:32; JHN 21:19; JHN 3:14; JHN 12:24; HEB 2:14; GEN 3:15\x*
\v 34 \w Respondeu-lhe|strong="G611,G846"\w* \w então|strong="G3767"\w* \w a multidão|strong="G3588,G3793"\w*: “\w Nós|strong="G3165"\w* \w ouvimos|strong="G191"\w* \w da lei|strong="G1537,G3588,G3551"\w* \w que|strong="G3754"\w* \w o Cristo|strong="G3588,G5547"\w* \w permanece|strong="G3306"\w* \w para sempre|strong="G1519,G3588,G165"\w*, \w e|strong="G2532"\w* \w como|strong="G4459"\w* \w você diz|strong="G3004,G4771"\w* \w que|strong="G3754"\w* \w é necessário|strong="G1163"\w* \w que seja levantado|strong="G5312"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w*? \w Quem|strong="G5101"\w* \w é|strong="G1510"\w* \w este|strong="G3778"\w* \w Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w*?”\f + \fr 12.34: \ft Variante: Treg e o RP omitem “então” (οὖν) e “que” (ὅτι); o RP inverte a ordem de “você diz” (σὺ λέγεις).\f*\x - \xo 12:34 \xt JHN 3:14; JHN 10:34; HEB 7:24; EZK 37:24-25; ISA 9:7; DAN 7:14\x*
\v 35 \w Disse-lhes|strong="G2036,G846"\w* \w então|strong="G3767"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Ainda|strong="G2089"\w* \w por pouco tempo|strong="G3398,G5550"\w* \w a luz|strong="G3588,G5457"\w* \w está|strong="G1510"\w* \w entre vocês|strong="G1722,G4771"\w*. \w Andem|strong="G4043"\w* \w enquanto|strong="G5613"\w* \w têm|strong="G2192"\w* \w a luz|strong="G3588,G5457"\w*, \w para que|strong="G2443"\w* \w a escuridão|strong="G4653"\w* \w não|strong="G3361"\w* \w os alcance|strong="G4771,G2638"\w*; \w e|strong="G2532"\w* \w aquele que anda|strong="G3588,G4043"\w* \w na escuridão|strong="G1722,G3588,G4653"\w* \w não|strong="G3756"\w* \w sabe|strong="G6063"\w* \w para onde|strong="G4226"\w* \w vai|strong="G5217"\w*\f + \fr 12.35: \ft Variante: o RP traz “com vocês” (μεθʼ ὑμῶν) em lugar de “entre vocês” (ἐν ὑμῖν) e ἕως (“até que, enquanto”) em lugar de ὡς.\f*\f + \fr 12.35: \ft Lit.: Καταλαμβάνω, “apanhar, alcançar, dominar”: o mesmo verbo de 1:5.\f*.\x - \xo 12:35 \xt JHN 8:12; JHN 1:5; JHN 7:33; 1JN 2:11; 1JN 1:5; JHN 12:46\x*
\v 36 \w Enquanto|strong="G5613"\w* \w têm|strong="G2192"\w* \w a luz|strong="G3588,G5457"\w*, \w creiam|strong="G4100"\w* \w na luz|strong="G1519,G3588,G5457"\w*, \w para que|strong="G2443"\w* \w filhos|strong="G5207"\w* \w da luz|strong="G5457"\w* \w se tornem|strong="G1096"\w*.” \w Estas coisas|strong="G3778"\w* \w falou|strong="G2980"\w* \w Jesus|strong="G2424"\w*, \w e|strong="G2532"\w* \w retirando-se|strong="G565"\w* \w se escondeu|strong="G2928"\w* \w deles|strong="G575,G846"\w*.\f + \fr 12.36: \ft Variante: o RP traz Ἕως (“enquanto, até que”) em lugar de ὡς e acrescenta o artigo diante de “Jesus”.\f*\x - \xo 12:36 \xt MAT 5:14; JHN 12:46; JHN 1:7; ISA 55:6; JHN 1:5; 1JN 1:5\x*
\p
\v 37 \w Tendo ele feito|strong="G846,G4160"\w* \w tantos sinais|strong="G5118,G4592"\w* \w diante deles|strong="G1715,G846"\w*, \w não|strong="G3756"\w* \w criam|strong="G4100"\w* \w nele|strong="G1519,G846"\w*,\x - \xo 12:37 \xt JHN 6:30; JHN 4:48; JHN 1:5; MRK 4:12; 1CO 2:14; JHN 6:65\x*
\v 38 \w para que|strong="G2443"\w* \w a palavra|strong="G3588,G3056"\w* \w de Isaías|strong="G2268"\w*, \w o profeta|strong="G3588,G4396"\w*, \w se cumprisse|strong="G4137"\w*, \w que|strong="G3739"\w* \w disse|strong="G2036"\w*: “\w Senhor|strong="G2962"\w*, \w quem|strong="G5101"\w* \w creu|strong="G4100"\w* \w na nossa|strong="G3588,G3165"\w* \w mensagem|strong="G189"\w*? \w E|strong="G2532"\w* \w o braço|strong="G3588,G1023"\w* \w do Senhor|strong="G2962"\w* \w a quem|strong="G5101"\w* \w foi revelado|strong="G601"\w*?”\f + \fr 12.38: \ft Nota cultural: citação de Is 53:1.\f*\f + \fr 12.38: \ft Lit.: Ἀκοή, “audição, o que se ouve, mensagem”.\f*\x - \xo 12:38 \xt ISA 53:1; ROM 10:16; MAT 12:17; JHN 1:5; MRK 4:12; ISA 28:9\x*
\v 39 \w Por isso|strong="G1223,G3778"\w* \w não|strong="G3756"\w* \w podiam|strong="G1410"\w* \w crer|strong="G4100"\w*, \w porque|strong="G3754"\w* \w de novo|strong="G3825"\w* \w disse|strong="G2036"\w* \w Isaías|strong="G2268"\w*:\x - \xo 12:39 \xt ISA 44:18; ROM 10:16; JHN 1:5; 2TH 2:11; MAT 13:14; MRK 4:12\x*
\v 40 “\w Cegou|strong="G5186"\w* \w os olhos|strong="G3588,G3788"\w* \w deles|strong="G846"\w* \w e|strong="G2532"\w* \w endureceu|strong="G4456"\w* \w o coração|strong="G3588,G2588"\w* \w deles|strong="G846"\w*, \w para que|strong="G2443"\w* \w não|strong="G3361"\w* \w vejam|strong="G1492"\w* \w com os olhos|strong="G3588,G3788"\w* \w e|strong="G2532"\w* \w entendam|strong="G3539"\w* \w com o coração|strong="G3588,G2588"\w* \w e|strong="G2532"\w* \w se voltem|strong="G4762"\w*, \w e|strong="G2532"\w* \w eu os curarei|strong="G2390,G846"\w*.”\f + \fr 12.40: \ft Nota cultural: citação de Is 6:10.\f*\f + \fr 12.40: \ft Variante: o RP traz πεπώρωκεν (“endureceu”, perfeito) em lugar de ἐπώρωσεν, ἐπιστραφῶσιν em lugar de στραφῶσιν e o subjuntivo ἰάσωμαι (“eu os cure”) em lugar de ἰάσομαι.\f*\x - \xo 12:40 \xt ISA 6:10; 2CO 4:4; ISA 44:18; MRK 8:18; MRK 8:17; MRK 6:52\x*
\v 41 \w Estas coisas|strong="G3778"\w* \w disse|strong="G2036"\w* \w Isaías|strong="G2268"\w* \w porque|strong="G3754"\w* \w viu|strong="G1492"\w* \w a glória|strong="G3588,G1391"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w falou|strong="G2980"\w* \w a respeito dele|strong="G4012,G846"\w*.\f + \fr 12.41: \ft Lit.: Αὐτοῦ: “dele” — em João, refere-se a Jesus (cf. Is 6:1, a visão do Senhor no templo).\f*\f + \fr 12.41: \ft Variante: o RP traz “quando” (ὅτε) em lugar de “porque” (ὅτι): “… disse Isaías quando viu a glória dele”.\f*\x - \xo 12:41 \xt ISA 6:1; 2CO 3:18; 2TH 2:11; JHN 1:14; MRK 4:12; JHN 1:18\x*
\v 42 \w Mesmo assim, contudo|strong="G3676,G3305"\w*, \w também|strong="G2532"\w* \w dentre as autoridades|strong="G1537,G3588,G758"\w* \w muitos|strong="G4183"\w* \w creram|strong="G4100"\w* \w nele|strong="G1519,G846"\w*, \w mas|strong="G235"\w* \w por causa|strong="G1223"\w* \w dos fariseus|strong="G3588,G5330"\w* \w não|strong="G3756"\w* \w o confessavam|strong="G3670"\w*, \w para que|strong="G2443"\w* \w não|strong="G3361"\w* \w fossem expulsos da sinagoga|strong="G656,G1096"\w*,\x - \xo 12:42 \xt JHN 7:48; JHN 9:22; PRO 29:25; ROM 10:9; REV 21:8; 2TH 2:11\x*
\v 43 \w pois|strong="G1063"\w* \w amaram|strong="G25"\w* \w a glória|strong="G3588,G1391"\w* \w dos seres humanos|strong="G3588,G444"\w* \w mais|strong="G3123"\w* \w do que|strong="G2260"\w* \w a glória|strong="G3588,G1391"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 12:43 \xt JHN 3:19; 2CO 3:11; MAT 6:1; JHN 5:44; PRO 29:25; ROM 10:9\x*
\p
\v 44 \w Jesus|strong="G2424"\w* \w gritou|strong="G2896"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Aquele que crê|strong="G3588,G4100"\w* \w em mim|strong="G1519,G1473"\w* \w não|strong="G3756"\w* \w crê|strong="G4100"\w* \w em mim|strong="G1519,G1473"\w*, \w mas|strong="G235"\w* \w naquele que me enviou|strong="G1519,G3588,G3992,G3165"\w*,\x - \xo 12:44 \xt JHN 7:28; JHN 5:24; JHN 14:1; JHN 3:15; MAT 10:40; JHN 14:13\x*
\v 45 \w e|strong="G2532"\w* \w aquele que contempla|strong="G3588,G2334"\w* \w a mim|strong="G1473"\w* \w contempla|strong="G2334"\w* \w aquele que me enviou|strong="G3588,G3992,G3165"\w*.\x - \xo 12:45 \xt JHN 14:9; JHN 3:15; JOB 42:5; 2CO 4:6; MRK 9:37; 2CO 4:4\x*
\v 46 \w Eu|strong="G1473"\w* \w vim|strong="G2064"\w* \w como luz|strong="G5457"\w* \w ao mundo|strong="G1519,G3588,G2889"\w*, \w para que|strong="G2443"\w* \w todo aquele que crê|strong="G3956,G3588,G4100"\w* \w em mim|strong="G1519,G1473"\w* \w não|strong="G3361"\w* \w permaneça|strong="G3306"\w* \w na escuridão|strong="G1722,G3588,G4653"\w*.\x - \xo 12:46 \xt JHN 8:12; JHN 1:9; JHN 9:5; MRK 16:16; JHN 12:35; JHN 5:38\x*
\v 47 \w E|strong="G2532"\w* \w se alguém|strong="G1437,G5100"\w* \w ouvir|strong="G191"\w* \w as minhas palavras|strong="G3165,G3588,G4487"\w* \w e|strong="G2532"\w* \w não|strong="G3361"\w* \w as guardar|strong="G5442"\w*, \w eu|strong="G1473"\w* \w não|strong="G3756"\w* \w o julgo|strong="G2919,G846"\w*; \w pois|strong="G1063"\w* \w não|strong="G3756"\w* \w vim|strong="G2064"\w* \w para que|strong="G2443"\w* \w julgue|strong="G2919"\w* \w o mundo|strong="G3588,G2889"\w*, \w mas|strong="G235"\w* \w para que|strong="G2443"\w* \w salve|strong="G4982"\w* \w o mundo|strong="G3588,G2889"\w*.\f + \fr 12.47: \ft Variante: o RP traz πιστεύσῃ (“crer”) em lugar de φυλάξῃ (“guardar”).\f*\x - \xo 12:47 \xt JHN 3:17; JHN 10:10; MRK 16:16; ACT 11:14; 1TI 1:15; PRO 2:1\x*
\v 48 \w Aquele que rejeita|strong="G3588,G114"\w* \w a mim|strong="G1473"\w* \w e|strong="G2532"\w* \w não|strong="G3361"\w* \w recebe|strong="G2983"\w* \w as minhas palavras|strong="G3588,G4487,G3165"\w* \w tem|strong="G2192"\w* \w quem o julgue|strong="G3588,G2919,G846"\w*: \w a palavra|strong="G3588,G3056"\w* \w que|strong="G3739"\w* \w falei|strong="G2980"\w*, \w essa|strong="G1565"\w* \w o julgará|strong="G2919,G846"\w* \w no último|strong="G1722,G3588,G2078"\w* \w dia|strong="G2250"\w*;\x - \xo 12:48 \xt MRK 16:16; JHN 3:17; LUK 10:16; HEB 9:27-28; LUK 12:47; ROM 2:16\x*
\v 49 \w porque|strong="G3754"\w* \w eu|strong="G1473"\w* \w por mim mesmo|strong="G1537,G1473"\w* \w não|strong="G3756"\w* \w falei|strong="G2980"\w*, \w mas|strong="G235"\w* \w o Pai|strong="G3588,G3962"\w* \w que me enviou|strong="G3992,G3165"\w*, \w ele mesmo|strong="G846"\w*, \w me deu|strong="G3165,G1325"\w* \w um mandamento|strong="G1785"\w*: \w o que|strong="G5101"\w* \w direi|strong="G2036"\w* \w e|strong="G2532"\w* \w o que|strong="G5101"\w* \w falarei|strong="G2980"\w*.\x - \xo 12:49 \xt JHN 8:42; JHN 5:19; JHN 16:13; DEU 18:18; JHN 14:10; JHN 6:63\x*
\v 50 \w E|strong="G2532"\w* \w sei|strong="G6063"\w* \w que|strong="G3754"\w* \w o mandamento|strong="G3588,G1785"\w* \w dele|strong="G846"\w* \w é vida|strong="G2222,G1510"\w* \w eterna|strong="G166"\w*. \w O que|strong="G3739"\w* \w então|strong="G3767"\w* \w eu|strong="G1473"\w* \w falo|strong="G2980"\w*, \w assim como|strong="G2531"\w* \w me disse|strong="G2046,G3165"\w* \w o Pai|strong="G3588,G3962"\w*, \w assim|strong="G3779"\w* \w falo|strong="G2980"\w*.”\x - \xo 12:50 \xt 1JN 5:11; 1JN 2:25; JHN 17:3; JHN 6:68; JHN 17:2; JHN 3:15\x*
\c 13
\p
\v 1 \w Antes|strong="G4253"\w* \w da festa|strong="G3588,G1859"\w* \w da Páscoa|strong="G3588,G3957"\w*, \w sabendo|strong="G6063"\w* \w Jesus|strong="G3588,G2424"\w* \w que|strong="G3754"\w* \w tinha chegado|strong="G2064"\w* \w a sua|strong="G846,G3588"\w* \w hora|strong="G5610"\w*, \w para que|strong="G2443"\w* \w passasse|strong="G3327"\w* \w deste mundo|strong="G1537,G3588,G2889,G3778"\w* \w para o Pai|strong="G4314,G3588,G3962"\w*, \w tendo amado|strong="G25"\w* \w os seus|strong="G3588,G2398"\w* \w que estavam|strong="G3588"\w* \w no mundo|strong="G1722,G3588,G2889"\w*, \w até o fim|strong="G1519,G5056"\w* \w os amou|strong="G25,G846"\w*.\f + \fr 13.1: \ft Lit.: Εἰς τέλος, “até o fim” ou “até o extremo, completamente”.\f*\f + \fr 13.1: \ft Acréscimo: “que estavam”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 13:1 \xt JHN 7:6; JHN 2:4; ZEP 3:17; 2PE 1:17; JHN 12:23; JHN 19:28\x*
\v 2 \w E|strong="G2532"\w* \w durante o jantar|strong="G1173,G1096"\w*, \w o diabo|strong="G3588,G1228"\w* \w já tendo posto|strong="G2235,G906"\w* \w no coração|strong="G1519,G3588,G2588"\w* \w que|strong="G2443"\w*\f + \fr 13.2: \ft Variante: o RP traz “no coração de Judas Iscariotes, filho de Simão, que o entregasse” (Ἰούδα Σίμωνος Ἰσκαριώτου ἵνα αὐτὸν παραδῷ), com “Judas” em dativo (possuidor do coração); WH e Treg trazem Ἰσκαριώτης (nominativo) em lugar de Ἰσκαριώτου.\f* \w Judas|strong="G2455"\w*, \w filho de Simão|strong="G4613"\w* \w Iscariotes|strong="G2469"\w*, \w o entregasse|strong="G3860,G846"\w*,\x - \xo 13:2 \xt MRK 3:19; JHN 12:4; MAT 10:4; MRK 14:10; LUK 22:3; JHN 13:26\x*
\v 3 \w sabendo|strong="G6063"\w* \w que|strong="G3754"\w* \w tudo|strong="G3956"\w* \w lhe deu|strong="G1325,G846"\w* \w o Pai|strong="G3588,G3962"\w* \w nas mãos|strong="G1519,G3588,G5495"\w*, \w e|strong="G2532"\w* \w que|strong="G3754"\w* \w da parte de Deus|strong="G575,G2316"\w* \w saiu|strong="G1831"\w* \w e|strong="G2532"\w* \w para Deus|strong="G4314,G3588,G2316"\w* \w vai|strong="G5217"\w*,\f + \fr 13.3: \ft Variante: o RP acrescenta “Jesus” (ὁ Ἰησοῦς) depois de “sabendo” e traz o perfeito δέδωκεν (“tem dado”) em lugar de ἔδωκεν.\f*\x - \xo 13:3 \xt MRK 7:29; MAT 11:27; MAT 28:18; HEB 2:8; 2PE 1:17; HEB 1:2\x*
\v 4 \w levantou-se|strong="G1453"\w* \w do jantar|strong="G1537,G3588,G1173"\w* \w e|strong="G2532"\w* \w pôs de lado|strong="G5087"\w* \w as vestes|strong="G3588,G2440"\w*, \w e|strong="G2532"\w* \w tomando|strong="G2983"\w* \w uma toalha|strong="G3012"\w*, \w se cingiu|strong="G1241,G1438"\w*\f + \fr 13.4: \ft Lit.: Λέντιον, “toalha de linho” (do latim linteum).\f*;\x - \xo 13:4 \xt MAT 20:28; 2CO 8:9; LUK 12:37; PHP 2:7; LUK 22:27; PHP 2:6-8\x*
\v 5 \w Depois|strong="G1534"\w* \w pôs|strong="G906"\w* \w água|strong="G5204"\w* \w na bacia|strong="G1519,G3588,G3537"\w*, \w e|strong="G2532"\w* \w começou|strong="G757"\w* \w a lavar|strong="G3538"\w* \w os pés|strong="G3588,G4228"\w* \w dos discípulos|strong="G3588,G3101"\w* \w e|strong="G2532"\w* \w a enxugá-los|strong="G1591"\w* \w com a toalha|strong="G3588,G3012"\w* \w com a qual|strong="G3739"\w* \w estava cingido|strong="G1510,G1241"\w*.\x - \xo 13:5 \xt MAT 20:28; LUK 7:44; 1TI 5:10; LUK 12:37; PHP 2:7; PSA 51:2\x*
\v 6 \w Chegou|strong="G2064"\w* \w então|strong="G3767"\w* \w até|strong="G4314"\w* \w Simão|strong="G4613"\w* \w Pedro|strong="G4074"\w*. \w Este lhe disse|strong="G3004,G846"\w*: “\w Senhor|strong="G2962"\w*, \w você|strong="G4771"\w* \w lava|strong="G3538"\w* \w os|strong="G3588"\w* \w meus|strong="G3165"\w* \w pés|strong="G4228"\w*?”\x - \xo 13:6 \xt JHN 13:8; JHN 13:9; JHN 13:14; MAT 20:28; PHP 2:7; LUK 22:27\x*
\v 7 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w O que|strong="G3739"\w* \w eu|strong="G1473"\w* \w faço|strong="G4160"\w*, \w você|strong="G4771"\w* \w não|strong="G3756"\w* \w sabe|strong="G6063"\w* \w agora|strong="G737"\w*, \w mas|strong="G1161"\w* \w compreenderá|strong="G1097"\w* \w depois disto|strong="G3326,G3778"\w*.”\x - \xo 13:7 \xt JHN 16:31; MAT 3:15; JHN 14:7; JHN 5:17; JHN 9:25; DAN 12:8\x*
\v 8 \w Disse-lhe|strong="G3004,G846"\w* \w Pedro|strong="G4074"\w*: “\w De modo algum|strong="G3756,G3361"\w* \w você lavará|strong="G3538"\w* \w os|strong="G3588"\w* \w meus|strong="G3165"\w* \w pés|strong="G4228"\w* \w jamais|strong="G1519,G3588,G165"\w*.” \w Respondeu-lhe|strong="G611,G846"\w* \w Jesus|strong="G2424"\w*: “\w Se|strong="G1437"\w* \w não|strong="G3361"\w* \w eu lavar|strong="G3538"\w* \w você|strong="G4771"\w*, \w não tem parte|strong="G3756,G2192,G3313"\w* \w comigo|strong="G3326,G1473"\w*.”\f + \fr 13.8: \ft Tradução: αἰῶνα (αἰών, G165) está aqui como “jamais”; o termo pode ser “era”, “século”, “eternidade”, “para sempre” ou “mundo (esta era)”, e o contexto decide.\f*\x - \xo 13:8 \xt JHN 13:6; MAT 20:28; REV 7:14; ACT 22:16; EZK 36:25; TIT 3:5\x*
\v 9 \w Disse-lhe|strong="G3004,G846"\w* \w Simão|strong="G4613"\w* \w Pedro|strong="G4074"\w*: “\w Senhor|strong="G2962"\w*, \w não|strong="G3361"\w* \w os pés|strong="G3588,G4228"\w* \w meus|strong="G3165"\w* \w somente|strong="G3441"\w*, \w mas|strong="G235"\w* \w também|strong="G2532"\w* \w as mãos|strong="G3588,G5495"\w* \w e|strong="G2532"\w* \w a cabeça|strong="G3588,G2776"\w*.”\x - \xo 13:9 \xt JHN 13:6; MAT 20:28; REV 7:14; HEB 10:22; PHP 2:7; MAT 3:15\x*
\v 10 \w Disse-lhe|strong="G3004,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Aquele que se banhou|strong="G3588,G3068"\w* \w não|strong="G3756"\w* \w tem|strong="G2192"\w* \w necessidade|strong="G5532"\w* \w a não ser|strong="G1487,G3361"\w* \w de lavar|strong="G3538"\w* \w os pés|strong="G3588,G4228"\w*, \w mas|strong="G235"\w* \w está|strong="G1510"\w* \w limpo|strong="G2513"\w* \w por inteiro|strong="G3650"\w*; \w e|strong="G2532"\w* \w vocês|strong="G4771"\w* \w limpos|strong="G2513"\w* \w estão|strong="G1510"\w*, \w mas|strong="G235"\w* \w não|strong="G3780"\w* \w todos|strong="G3956"\w*.”\f + \fr 13.10: \ft Lit.: Λούω, “banhar(-se)” (o corpo inteiro), distinto de νίπτω, “lavar” (partes do corpo, como os pés).\f*\f + \fr 13.10: \ft Variante: WH omite o artigo ὁ diante de “banhou”; o RP traz outra ordem (οὐ χρείαν ἔχει) e “ou” (ἢ) em lugar de “a não ser” (εἰ μὴ).\f*\x - \xo 13:10 \xt HEB 10:22; JHN 15:3; MAT 20:28; REV 7:14; 2CO 7:1; JHN 13:7\x*
\v 11 \w Pois|strong="G1063"\w* \add ele\add* \w sabia|strong="G1492"\w* \w quem o entregaria|strong="G3588,G3860,G846"\w*; \w por isso|strong="G1223,G3778"\w* \w disse|strong="G2036"\w*: “\w Não|strong="G3780"\w* \w todos|strong="G3956"\w* \w estão limpos|strong="G2513,G1510"\w*.”\f + \fr 13.11: \ft Acréscimo: “ele” (em “Pois ele sabia quem”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 13:11 \xt JHN 2:25; MAT 20:28; REV 7:14; JHN 13:7; PHP 2:7; LUK 22:27\x*
\p
\v 12 \w Quando|strong="G3753"\w* \w então|strong="G3767"\w* \w lavou|strong="G3538"\w* \w os pés|strong="G3588,G4228"\w* \w deles|strong="G846"\w* \w e|strong="G2532"\w* \w tomou|strong="G2983"\w* \w as vestes|strong="G3588,G2440"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w se reclinou|strong="G377"\w*, \w de novo|strong="G3825"\w* \w lhes disse|strong="G2036,G846"\w*: “\w Entendem|strong="G1097"\w* \w o que|strong="G5101"\w* \w lhes fiz|strong="G4160,G4771"\w*?\x - \xo 13:12 \xt MAT 20:28; REV 7:14; JHN 13:7; MAT 20:25; PHP 2:7; LUK 22:27\x*
\v 13 \w Vocês|strong="G4771"\w* \w me chamam|strong="G5455,G3165"\w* ‘\w O|strong="G3588"\w* \w Mestre|strong="G1320"\w*’ \w e|strong="G2532"\w* ‘\w O|strong="G3588"\w* \w Senhor|strong="G2962"\w*’, \w e|strong="G2532"\w* \w dizem bem|strong="G3004,G2573"\w*, \w pois|strong="G1063"\w* \w eu o sou|strong="G1510"\w*.\x - \xo 13:13 \xt LUK 20:39; JHN 11:28; MAL 1:6; PHP 2:11; LUK 6:46; MAT 20:28\x*
\v 14 \w Se|strong="G1487"\w* \w então|strong="G3767"\w* \w eu|strong="G1473"\w* \w lavei|strong="G3538"\w* \w os pés|strong="G3588,G4228"\w* \w de vocês|strong="G4771"\w*, \w o Senhor|strong="G3588,G2962"\w* \w e|strong="G2532"\w* \w o Mestre|strong="G3588,G1320"\w*, \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w devem|strong="G3784"\w* \w uns aos outros|strong="G240"\w* \w lavar|strong="G3538"\w* \w os pés|strong="G3588,G4228"\w*;\x - \xo 13:14 \xt JHN 13:6; PHP 2:5; GAL 6:2; MAL 1:6; MRK 10:45; 1PE 5:5\x*
\v 15 \w pois|strong="G1063"\w* \w um exemplo|strong="G5262"\w* \w dei|strong="G1325"\w* \w a vocês|strong="G4771"\w*, \w para que|strong="G2443"\w* \w assim como|strong="G2531"\w* \w eu|strong="G1473"\w* \w fiz|strong="G4160"\w* \w a vocês|strong="G4771"\w*, \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w façam|strong="G4160"\w*.\x - \xo 13:15 \xt 1JN 2:6; PHP 2:5; GAL 6:2; MAL 1:6; MAT 11:29; 1PE 2:21\x*
\v 16 \w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w não|strong="G3756"\w* \w é|strong="G1510"\w* \w escravo|strong="G1401"\w* \w maior|strong="G3173"\w* \add do que\add* \w o seu|strong="G3588,G846"\w* \w senhor|strong="G2962"\w*, \w nem|strong="G3761"\w* \w enviado|strong="G652"\w* \w maior|strong="G3173"\w* \add do que\add* \w aquele que o enviou|strong="G3588,G3992,G846"\w*.\f + \fr 13.16: \ft Lit.: Ἀπόστολος, “enviado” (aqui no sentido geral; é a única ocorrência da palavra em João).\f*\f + \fr 13.16: \ft Acréscimo: “do” (em “escravo maior do que o”), “do” (em “enviado maior do que aquele”): preposição ou artigo que a regência do português exige; “que” (em “maior do que o seu”), “que” (em “maior do que aquele que”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 13:16 \xt MAT 10:24; JHN 13:20; MAL 1:6; LUK 6:40; JHN 15:20; LUK 6:46\x*
\v 17 \w Se|strong="G1487"\w* \w estas coisas|strong="G3778"\w* \w sabem|strong="G6063"\w*, \w felizes|strong="G3107"\w* \w são|strong="G1510"\w*, \w se|strong="G1437"\w* \w as fizerem|strong="G4160,G846"\w*.\f + \fr 13.17: \ft Lit.: Μακάριος, “feliz, bem-aventurado”.\f*\x - \xo 13:17 \xt MAT 7:24; JAS 1:22; JOS 1:8; DEU 11:27; JAS 4:17; LUK 11:28\x*
\v 18 \w Não|strong="G3756"\w* \w a respeito de todos|strong="G4012,G3956"\w* \w vocês|strong="G4771"\w* \w falo|strong="G3004"\w*; \w eu|strong="G1473"\w* \w sei|strong="G6063"\w* \w quais|strong="G5101"\w* \w escolhi|strong="G1586"\w*; \w mas|strong="G235"\w* \w para que|strong="G2443"\w* \w a Escritura|strong="G3588,G1124"\w* \w se cumpra|strong="G4137"\w*: ‘\w Aquele que come|strong="G3588,G5176"\w* \w o meu pão|strong="G3165,G3588,G740"\w* \w levantou|strong="G1869"\w* \w contra mim|strong="G1909,G1473"\w* \w o seu|strong="G3588,G846"\w* \w calcanhar|strong="G4418"\w*.’\f + \fr 13.18: \ft Nota cultural: citação de Sl 41:9 (40:10 na LXX).\f*\x - \xo 13:18 \xt PSA 41:9; ACT 1:16; JHN 15:16; JHN 17:12; MAT 26:23; 2TI 2:19\x*
\v 19 \w Desde agora|strong="G575,G737"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w* \w antes que|strong="G4253,G3588"\w* \w aconteça|strong="G1096"\w*, \w para que|strong="G2443"\w* \w creiam|strong="G4100"\w* \w quando|strong="G3752"\w* \w acontecer|strong="G1096"\w* \w que|strong="G3754"\w* \w eu sou|strong="G1473,G1510"\w*.\f + \fr 13.19: \ft Lit.: Ἐγώ εἰμι, sem predicado (cf. 8:24, 28, 58): “eu sou”.\f*\f + \fr 13.19: \ft Variante: WH e Treg trazem πιστεύητε (presente: “continuem a crer”) em lugar de πιστεύσητε; o RP traz “quando acontecer, creiam”, em outra ordem.\f*\x - \xo 13:19 \xt JHN 16:31; JHN 14:29; JHN 14:1; ISA 42:9; ISA 43:10; 1CO 11:27\x*
\v 20 \w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w aquele que recebe|strong="G3588,G2983"\w* \w quem quer que|strong="G302,G5100"\w* \w eu enviar|strong="G3992"\w*, \w a mim|strong="G1473"\w* \w recebe|strong="G2983"\w*; \w aquele que|strong="G3588"\w* \w a mim|strong="G1473"\w* \w recebe|strong="G2983"\w*, \w recebe|strong="G2983"\w* \w aquele que me enviou|strong="G3588,G3992,G3165"\w*.”\x - \xo 13:20 \xt JHN 13:16; 2CH 20:20; LUK 10:16; JHN 20:21; MAT 10:40; LUK 9:48\x*
\p
\v 21 \w Tendo dito|strong="G2036"\w* \w estas coisas|strong="G3778"\w*, \w Jesus|strong="G3588,G2424"\w* \w se perturbou|strong="G5015"\w* \w no espírito|strong="G3588,G4151"\w* \w e|strong="G2532"\w* \w testemunhou|strong="G3140"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w um|strong="G1520"\w* \w dentre vocês|strong="G1537,G4771"\w* \w me entregará|strong="G3860,G3165"\w*.”\x - \xo 13:21 \xt MAT 26:21; MRK 14:18; 1CO 11:27; JHN 13:18; JHN 12:27; 2CO 2:12-13\x*
\v 22 \w Olhavam|strong="G991"\w* \w uns para os outros|strong="G1519,G240"\w* \w os discípulos|strong="G3588,G3101"\w*, \w perplexos|strong="G639"\w* \w a respeito de quem|strong="G4012,G5101"\w* \w falava|strong="G3004"\w*.\f + \fr 13.22: \ft Variante: Treg e o RP acrescentam “então” (οὖν) depois de “Olhavam”.\f*\x - \xo 13:22 \xt 1CO 11:27; LUK 22:21; LUK 22:23; MRK 14:17; MRK 14:19; MAT 26:22\x*
\v 23 \w Estava reclinado|strong="G1510,G345"\w* \w um|strong="G1520"\w* \w dos|strong="G1537,G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w* \w no seio|strong="G1722,G3588,G2859"\w* \w de Jesus|strong="G3588,G2424"\w*, \w a quem|strong="G3739"\w* \w amava|strong="G25"\w* \w Jesus|strong="G3588,G2424"\w*;\f + \fr 13.23: \ft Lit.: Κόλπος, “seio, peito”: reclinado junto ao peito de Jesus, posição de intimidade à mesa.\f*\f + \fr 13.23: \ft Nota cultural: este é o primeiro aparecimento do “discípulo a quem Jesus amava” em João (cf. 19:26; 20:2; 21:7, 20); o texto não o nomeia.\f*\x - \xo 13:23 \xt JHN 19:26; 1CO 11:27; JHN 20:2; JHN 21:20; JHN 21:7; JHN 1:18\x*
\v 24 \w Fez sinal|strong="G3506"\w* \w então|strong="G3767"\w* \w a este|strong="G3778"\w* \w Simão|strong="G4613"\w* \w Pedro|strong="G4074"\w* \w para perguntar|strong="G4441"\w* \w quem|strong="G5101"\w* \w seria|strong="G302,G1510"\w* \w aquele de quem|strong="G4012,G3739"\w* \w falava|strong="G3004"\w*.\f + \fr 13.24: \ft Variante: WH e Treg trazem “e lhe disse: Diga quem é aquele de quem fala” (καὶ λέγει αὐτῷ Εἰπὲ τίς ἐστιν) em lugar de “para perguntar quem seria”.\f*\x - \xo 13:24 \xt 1CO 11:27; ACT 3:1; ACT 13:16; JHN 21:20; LUK 1:22; LUK 22:23\x*
\v 25 \w Recostando-se|strong="G377"\w* \w aquele|strong="G1565"\w* \w assim|strong="G3779"\w* \w sobre o peito|strong="G1909,G3588,G4738"\w* \w de Jesus|strong="G3588,G2424"\w*, \w disse-lhe|strong="G3004,G846"\w*: “\w Senhor|strong="G2962"\w*, \w quem|strong="G5101"\w* \w é|strong="G1510"\w*?”\f + \fr 13.25: \ft Variante: NA28 traz “então” (οὖν) depois de ἀναπεσών; o RP traz “inclinando-se porém” (ἐπιπεσὼν δέ) em lugar de ἀναπεσών.\f*\x - \xo 13:25 \xt JHN 21:20; 1CO 11:27; ACT 3:1; JHN 13:23; LUK 22:23; MRK 14:17\x*
\v 26 \w Respondeu|strong="G611"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Aquele|strong="G1565"\w* \w é|strong="G1510"\w* \w a quem|strong="G3739"\w* \w eu|strong="G1473"\w* \w molharei|strong="G911"\w* \w o pedaço|strong="G3588,G5596"\w* \w e|strong="G2532"\w* \w darei|strong="G1325"\w* \w a ele|strong="G846"\w*.” \w Tendo molhado|strong="G911"\w* \w então|strong="G3767"\w* \w o pedaço|strong="G3588,G5596"\w*, \w deu|strong="G1325"\w* \w a Judas|strong="G2455"\w*, \w filho de Simão|strong="G4613"\w* \w Iscariotes|strong="G2469"\w*.\f + \fr 13.26: \ft Variante: WH acrescenta “então” (οὖν) depois de “Respondeu”; o RP traz βάψας (“tendo molhado”) e ἐπιδώσω (“darei”) em lugar de “molharei” e “darei a ele”, e “tendo mergulhado” (ἐμβάψας) em lugar de “tendo molhado então”; WH, Treg e NA28 acrescentam “toma e” (λαμβάνει καί) antes de “deu”; o RP traz Ἰσκαριώτῃ (dativo).\f*\x - \xo 13:26 \xt MRK 3:19; JHN 6:71; MAT 10:4; JHN 12:4; JHN 13:2; LUK 22:3\x*
\v 27 \w E|strong="G2532"\w* \w depois do pedaço|strong="G3326,G3588,G5596"\w*, \w então|strong="G5119"\w* \w entrou|strong="G1525"\w* \w naquele|strong="G1519,G1565"\w* \w Satanás|strong="G3588,G4567"\w*. \w Disse-lhe|strong="G3004,G846"\w* \w então|strong="G3767"\w* \w Jesus|strong="G3588,G2424"\w*: “\w O que|strong="G3739"\w* \w faz|strong="G4160"\w*, \w faça|strong="G4160"\w* \w mais depressa|strong="G5032"\w*.”\x - \xo 13:27 \xt PSA 41:9; JHN 6:70; 1CO 11:27; LUK 22:3; EPH 2:2; REV 2:10\x*
\v 28 \w Isto|strong="G3778"\w* \w nenhum|strong="G3762"\w* \w dos que estavam à mesa|strong="G3588,G345"\w* \w entendeu|strong="G1097"\w* \w com que fim|strong="G4314,G5101"\w* \w lhe disse|strong="G2036,G846"\w*.\x - \xo 13:28 \xt 1CO 2:11; ZEC 11:12; MRK 3:19; MAT 26:23; MAT 10:4\x*
\v 29 \w Pois|strong="G1063"\w* \w alguns|strong="G5100"\w* \w pensavam|strong="G1380"\w*, \w porque|strong="G1893"\w* \w a caixa|strong="G3588,G1101"\w* \w tinha|strong="G2192"\w* \w Judas|strong="G2455"\w*, \w que|strong="G3754"\w* \w lhe dizia|strong="G3004,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Compre|strong="G59"\w* \w aquilo de que|strong="G3739"\w* \w temos|strong="G2192"\w* \w necessidade|strong="G5532"\w* \w para a festa|strong="G1519,G3588,G1859"\w*”, \w ou|strong="G2228"\w* \w aos pobres|strong="G3588,G4434"\w* \w para que desse|strong="G2443,G1325"\w* \w algo|strong="G5100"\w*.\x - \xo 13:29 \xt JHN 12:6; MAT 25:35; ZEC 11:12; LUK 3:11; MRK 3:19; ACT 20:34-35\x*
\v 30 \w Tendo recebido|strong="G2983"\w* \w então|strong="G3767"\w* \w o pedaço|strong="G3588,G5596"\w*, \w aquele|strong="G1565"\w* \w saiu|strong="G1831"\w* \w imediatamente|strong="G2112"\w*. \w Era|strong="G1510"\w* \w noite|strong="G3571"\w*.\f + \fr 13.30: \ft Lit.: Ἦν δὲ νύξ, “era porém noite”: indicação de tempo que em João também tem peso simbólico (cf. 3:2; 9:4; 11:10).\f*\x - \xo 13:30 \xt ISA 59:7; MAT 26:14; ZEC 11:12; JHN 13:26; MRK 3:19; PRO 4:16\x*
\p
\v 31 \w Quando|strong="G3753"\w* \w então|strong="G3767"\w* \w saiu|strong="G1831"\w*, \w disse|strong="G3004"\w* \w Jesus|strong="G2424"\w*: “\w Agora|strong="G3568"\w* \w foi glorificado|strong="G1392"\w* \w o Filho|strong="G3588,G5207"\w* \w do Homem|strong="G3588,G444"\w*, \w e|strong="G2532"\w* \w Deus|strong="G3588,G2316"\w* \w foi glorificado|strong="G1392"\w* \w nele|strong="G1722,G846"\w*;\x - \xo 13:31 \xt JHN 17:1; HEB 12:2; JHN 12:28; JHN 7:18; JHN 11:4; JHN 12:23\x*
\v 32 \w se|strong="G1487"\w* \w Deus|strong="G3588,G2316"\w* \w foi glorificado|strong="G1392"\w* \w nele|strong="G1722,G846"\w*, \w também|strong="G2532"\w* \w Deus|strong="G3588,G2316"\w* \w o glorificará|strong="G1392,G846"\w* \w em si mesmo|strong="G1722,G1438"\w*, \w e|strong="G2532"\w* \w logo|strong="G2112"\w* \w o glorificará|strong="G1392,G846"\w*.\f + \fr 13.32: \ft Variante: WH omite a primeira oração (“se Deus foi glorificado nele”); WH traz αὑτῷ (“em si mesmo”), Treg e NA28 αὐτῷ (“nele”) e o RP ἑαυτῷ (“em si mesmo”).\f*\x - \xo 13:32 \xt JHN 17:1; HEB 12:2; JHN 12:28; JHN 7:18; JHN 11:4; JHN 12:23\x*
\v 33 \w Filhinhos|strong="G5040"\w*, \w ainda|strong="G2089"\w* \w por pouco tempo|strong="G3398"\w* \w com vocês|strong="G3326,G4771"\w* \w estou|strong="G1510"\w*; \w vocês me procurarão|strong="G2212,G3165"\w*, \w e|strong="G2532"\w* \w assim como|strong="G2531"\w* \w eu disse|strong="G2036"\w* \w aos judeus|strong="G3588,G2453"\w*: ‘\w Para onde|strong="G3699"\w* \w eu|strong="G1473"\w* \w vou|strong="G5217"\w* \w vocês|strong="G4771"\w* \w não|strong="G3756"\w* \w podem|strong="G1410"\w* \w vir|strong="G2064"\w*’, \w também|strong="G2532"\w* \w a vocês|strong="G4771"\w* \w digo|strong="G3004"\w* \w agora|strong="G737"\w*.\f + \fr 13.33: \ft Lit.: Τεκνία, “filhinhos”: tratamento afetuoso, único uso deste termo no evangelho (cf. 1Jo 2:1).\f*\x - \xo 13:33 \xt 1JN 2:1; JHN 7:34; JHN 7:33; JHN 8:21; JHN 14:2; JHN 12:8\x*
\v 34 \w Um mandamento novo|strong="G1785,G2537"\w* \w dou|strong="G1325"\w* \w a vocês|strong="G4771"\w*: \w que amem|strong="G2443,G25"\w* \w uns aos outros|strong="G240"\w*, \w assim como|strong="G2531"\w* \w amei|strong="G25"\w* \w vocês|strong="G4771"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w amem|strong="G25"\w* \w uns aos outros|strong="G240"\w*.\x - \xo 13:34 \xt 1JN 3:23; JHN 15:12; JHN 15:17; 1JN 4:21; 2JN 1:5; 1JN 2:7\x*
\v 35 \w Nisto|strong="G1722,G3778"\w* \w saberão|strong="G1097"\w* \w todos|strong="G3956"\w* \w que|strong="G3754"\w* \w meus|strong="G1473"\w* \w discípulos|strong="G3101"\w* \w são|strong="G1510"\w*: \w se|strong="G1437"\w* \w amor|strong="G26"\w* \w tiverem|strong="G2192"\w* \w uns pelos outros|strong="G1722,G240"\w*.”\x - \xo 13:35 \xt JHN 5:42; PSA 133:1; 1JN 2:5; 1JN 4:7; 1JN 4:8; 1JN 4:16\x*
\v 36 \w Disse-lhe|strong="G3004,G846"\w* \w Simão|strong="G4613"\w* \w Pedro|strong="G4074"\w*: “\w Senhor|strong="G2962"\w*, \w para onde|strong="G4226"\w* \w vai|strong="G5217"\w*?” \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w*: “\w Para onde|strong="G3699"\w* \w vou|strong="G5217"\w* \w não|strong="G3756"\w* \w pode|strong="G1410"\w* \w agora|strong="G3568"\w* \w me seguir|strong="G3165,G190"\w*, \w mas|strong="G1161"\w* \w me seguirá|strong="G190"\w* \w depois|strong="G5305"\w*.”\x - \xo 13:36 \xt JHN 16:5; JHN 14:2; JHN 21:18; JHN 13:7; LUK 22:33; 2PE 1:14\x*
\v 37 \w Disse-lhe|strong="G3004,G846"\w* \w Pedro|strong="G3588,G4074"\w*: “\w Senhor|strong="G2962"\w*, \w por que|strong="G1223,G5101"\w* \w não|strong="G3756"\w* \w posso|strong="G1410"\w* \w segui-lo|strong="G4771,G190"\w* \w agora|strong="G737"\w*? \w A minha vida|strong="G3588,G5590,G3165"\w* \w em favor de|strong="G5228"\w* \w você|strong="G4771"\w* \w entregarei|strong="G5087"\w*.”\x - \xo 13:37 \xt RUT 1:16; LUK 9:57; JHN 11:16; LUK 22:33; MAT 8:19; ACT 20:24\x*
\v 38 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w*: “\w A sua vida|strong="G3588,G5590,G4771"\w* \w em favor|strong="G5228"\w* \w de mim|strong="G1473"\w* \w entregará|strong="G5087"\w*? \w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a você|strong="G4771"\w*: \w de modo algum|strong="G3756,G3361"\w* \w o galo|strong="G220"\w* \w cantará|strong="G5455"\w* \w até que|strong="G2193,G3739"\w* \w me negue|strong="G720,G3165"\w* \w três vezes|strong="G5151"\w*.”\f + \fr 13.38: \ft Variante: o RP traz “Respondeu-lhe Jesus” (Ἀπεκρίθη αὐτῷ ὁ Ἰησοῦς) e ἀπαρνήσῃ (forma reforçada de “negar”) em lugar de ἀρνήσῃ.\f*\x - \xo 13:38 \xt LUK 22:34; MAT 26:34; JHN 18:27; MRK 14:30; MRK 14:68; MAT 26:75\x*
\c 14
\p
\v 1 “\w Não se perturbe|strong="G3361,G5015"\w* \w o coração|strong="G3588,G2588"\w* \w de vocês|strong="G4771"\w*; \w creiam|strong="G4100"\w* \w em Deus|strong="G1519,G3588,G2316"\w*, \w e|strong="G2532"\w* \w em mim|strong="G1519,G1473"\w* \w creiam|strong="G4100"\w*.\f + \fr 14.1: \ft Lit.: Πιστεύετε: imperativo (“creiam”) ou indicativo (“vocês creem”); o mesmo vale para a segunda ocorrência.\f*\x - \xo 14:1 \xt JHN 14:27; ISA 26:3; JHN 16:33; JHN 16:22; LUK 24:38; ISA 12:2-3\x*
\v 2 \w Na casa|strong="G1722,G3588,G3614"\w* \w do meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w* \w moradas|strong="G3438"\w* \w muitas|strong="G4183"\w* \w há|strong="G1510"\w*; \w se não fosse assim|strong="G1487,G1161,G3361"\w*, \w teria dito|strong="G2036,G302"\w* \w a vocês|strong="G4771"\w*; \w pois|strong="G3754"\w* \w vou|strong="G4198"\w* \w preparar|strong="G2090"\w* \w lugar|strong="G5117"\w* \w para vocês|strong="G4771"\w*.\f + \fr 14.2: \ft Lit.: Μονή, “lugar de permanência, morada” (do verbo μένω, “permanecer”); aparece de novo em 14:23. O sentido da oração final (“pois vou preparar-lhes lugar” ou “teria dito que vou…”) é discutido; o RP omite ὅτι.\f*\f + \fr 14.2: \ft Acréscimo: verbo ser/estar suprido em “se não fosse assim”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 14:2 \xt 2CO 5:1; JHN 13:36; HEB 13:14; REV 21:2; HEB 11:10; REV 3:12\x*
\v 3 \w E|strong="G2532"\w* \w se eu for|strong="G1437,G4198"\w* \w e|strong="G2532"\w* \w preparar|strong="G2090"\w* \w lugar|strong="G5117"\w* \w para vocês|strong="G4771"\w*, \w de novo|strong="G3825"\w* \w venho|strong="G2064"\w* \w e|strong="G2532"\w* \w os levarei|strong="G3880,G4771"\w* \w para junto de mim|strong="G4314,G1473"\w*, \w para que|strong="G2443"\w* \w onde|strong="G3699"\w* \w eu|strong="G1473"\w* \w estou|strong="G1510"\w*, \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w estejam|strong="G1510"\w*.\x - \xo 14:3 \xt REV 22:3; 1TH 4:16-17; LUK 23:43; JHN 12:26; JHN 14:18; 2TI 2:12\x*
\v 4 \w E|strong="G2532"\w* \w para onde|strong="G3699"\w* \w eu|strong="G1473"\w* \w vou|strong="G5217"\w*, \w sabem|strong="G6063"\w* \w o caminho|strong="G3588,G3598"\w*.”\f + \fr 14.4: \ft Variante: o RP traz “e sabem o caminho” (καὶ τὴν ὁδὸν οἴδατε): “Para onde eu vou, vocês sabem, e sabem o caminho”.\f*\x - \xo 14:4 \xt LUK 9:57; JHN 10:9; JHN 16:28; JHN 12:26; JHN 13:3; JHN 14:2\x*
\v 5 \w Disse-lhe|strong="G3004,G846"\w* \w Tomé|strong="G2381"\w*: “\w Senhor|strong="G2962"\w*, \w não|strong="G3756"\w* \w sabemos|strong="G6063"\w* \w para onde|strong="G4226"\w* \w vai|strong="G5217"\w*; \w como|strong="G4459"\w* \w podemos|strong="G1410"\w* \w saber|strong="G6063"\w* \w o caminho|strong="G3588,G3598"\w*?”\f + \fr 14.5: \ft Variante: WH e Treg trazem “como sabemos o caminho?” (οἴδαμεν τὴν ὁδόν) em lugar de “como podemos saber o caminho?”; o RP acrescenta “e” (καί) antes de “como”.\f*\x - \xo 14:5 \xt JHN 16:5; JHN 16:23; JHN 11:16; JHN 16:17; JHN 20:25-28; MRK 9:19\x*
\v 6 \w Disse-lhe|strong="G3004,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Eu sou|strong="G1473,G1510"\w* \w o caminho|strong="G3588,G3598"\w* \w e|strong="G2532"\w* \w a verdade|strong="G3588,G225"\w* \w e|strong="G2532"\w* \w a vida|strong="G3588,G2222"\w*; \w ninguém|strong="G3762"\w* \w vem|strong="G2064"\w* \w ao Pai|strong="G4314,G3588,G3962"\w* \w a não ser|strong="G1487,G3361"\w* \w por meio de mim|strong="G1223,G1473"\w*.\x - \xo 14:6 \xt 1JN 5:11; 1JN 5:20; 1PE 3:18; ACT 4:12; EPH 2:18; HEB 7:25\x*
\v 7 \w Se|strong="G1487"\w* \w me tivessem conhecido|strong="G1097,G3165"\w*, \w também|strong="G2532"\w* \w o meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w* \w teriam conhecido|strong="G302,G1492"\w*; \w desde agora|strong="G575,G737"\w* \w o conhecem|strong="G1097,G846"\w* \w e|strong="G2532"\w* \w o têm visto|strong="G3708,G846"\w*.”\f + \fr 14.7: \ft Variante: NA28 traz ἐγνώκατε (“tivessem conhecido”, forma diferente de ἐγνώκειτε) e “conhecerão” (γνώσεσθε) em lugar de “teriam conhecido”; NA28 e o RP acrescentam “e” (καί) antes de “desde agora”; WH omite o último “o” (αὐτόν).\f*\x - \xo 14:7 \xt MAT 11:27; JHN 14:9; JHN 13:7; COL 1:15-17; JHN 8:19; LUK 10:22\x*
\v 8 \w Disse-lhe|strong="G3004,G846"\w* \w Filipe|strong="G5376"\w*: “\w Senhor|strong="G2962"\w*, \w mostre-nos|strong="G1166,G3165"\w* \w o Pai|strong="G3588,G3962"\w*, \w e|strong="G2532"\w* \w isso nos basta|strong="G714,G3165"\w*.”\x - \xo 14:8 \xt MAT 11:27; JHN 8:19; EXO 33:18-23; 2PE 1:17; REV 22:3-5; JHN 1:43\x*
\v 9 \w Disse-lhe|strong="G3004,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Por tanto tempo|strong="G5118,G5550"\w* \w estou|strong="G1510"\w* \w com vocês|strong="G3326,G4771"\w*, \w e|strong="G2532"\w* \w não me conheceu|strong="G3756,G1097,G3165"\w*, \w Filipe|strong="G5376"\w*? \w Aquele que me viu|strong="G3588,G3708,G1473"\w* \w viu|strong="G3708"\w* \w o Pai|strong="G3588,G3962"\w*; \w como|strong="G4459"\w* \w você|strong="G4771"\w* \w diz|strong="G3004"\w*: ‘\w Mostre-nos|strong="G1166,G3165"\w* \w o Pai|strong="G3588,G3962"\w*’?\x - \xo 14:9 \xt MAT 11:27; JHN 14:7; COL 1:15; JHN 10:30; JHN 12:45; HEB 1:3\x*
\v 10 \w Não crê|strong="G3756,G4100"\w* \w que|strong="G3754"\w* \w eu|strong="G1473"\w* \w no Pai|strong="G1722,G3588,G3962"\w* \add estou\add* \w e|strong="G2532"\w* \w o Pai|strong="G3588,G3962"\w* \w em mim|strong="G1722,G1473"\w* \w está|strong="G1510"\w*? \w As palavras|strong="G3588,G4487"\w* \w que|strong="G3739"\w* \w eu|strong="G1473"\w* \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*, \w por mim mesmo|strong="G575,G1473"\w* \w não|strong="G3756"\w* \w falo|strong="G2980"\w*; \w o Pai|strong="G3588,G3962"\w*, \w porém|strong="G1161"\w*, \w permanecendo|strong="G3306"\w* \w em mim|strong="G1722,G1473"\w*, \w faz|strong="G4160"\w* \w as suas obras|strong="G3588,G2041,G846"\w*.\f + \fr 14.10: \ft Variante: o RP traz λαλῶ (“falo”) em lugar de λέγω (“digo”), “ele mesmo” (αὐτός) depois de “permanecendo” e omite “suas” (αὐτοῦ); Treg e o RP acrescentam o artigo ὁ diante de “permanecendo” (“o Pai que permanece em mim faz as obras”).\f*\f + \fr 14.10: \ft Acréscimo: “estou” (em “no Pai estou e o”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 14:10 \xt JHN 10:37; JHN 8:42; JHN 10:38; JHN 17:8; JHN 15:7; 1PE 1:25\x*
\v 11 \w Acreditem|strong="G4100"\w* \w em mim|strong="G3165"\w* \w que|strong="G3754"\w* \w eu|strong="G1473"\w* \w no Pai|strong="G1722,G3588,G3962"\w* \add estou\add* \w e|strong="G2532"\w* \w o Pai|strong="G3588,G3962"\w* \w em mim|strong="G1722,G1473"\w*; \w se|strong="G1487,G1161"\w* \w não|strong="G3361"\w*, \w por causa|strong="G1223"\w* \w das próprias obras|strong="G3588,G2041,G846"\w* \w creiam|strong="G4100"\w*.\f + \fr 14.11: \ft Variante: Treg e o RP acrescentam “me” (μοι) depois do último “creiam”.\f*\f + \fr 14.11: \ft Acréscimo: “estou” (em “no Pai estou e o”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 14:11 \xt JHN 10:37; JHN 10:25; JHN 10:38; JHN 6:29; GAL 2:16; 2PE 1:17\x*
\v 12 \w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w aquele que crê|strong="G3588,G4100"\w* \w em mim|strong="G1519,G1473"\w*, \w as obras|strong="G3588,G2041"\w* \w que|strong="G3739"\w* \w eu|strong="G1473"\w* \w faço|strong="G4160"\w*, \w também ele|strong="G1565,G2532"\w* \w fará|strong="G4160"\w*, \w e|strong="G2532"\w* \w maiores|strong="G3173"\w* \w do que estas|strong="G3778"\w* \w fará|strong="G4160"\w*, \w porque|strong="G3754"\w* \w eu|strong="G1473"\w* \w para o Pai|strong="G4314,G3588,G3962"\w* \w vou|strong="G4198"\w*;\f + \fr 14.12: \ft Variante: o RP acrescenta “meu” (μου) depois de “Pai”.\f*\x - \xo 14:12 \xt JHN 10:37; JHN 14:28; MAT 21:21; MRK 16:17; LUK 10:17-19; ACT 16:18\x*
\v 13 \w e|strong="G2532"\w* \w tudo o que|strong="G3739,G5100,G302"\w* \w pedirem|strong="G154"\w* \w em meu nome|strong="G1722,G3588,G3686,G3165"\w*, \w isso|strong="G3778"\w* \w farei|strong="G4160"\w*, \w para que|strong="G2443"\w* \w seja glorificado|strong="G1392"\w* \w o Pai|strong="G3588,G3962"\w* \w no Filho|strong="G1722,G3588,G5207"\w*;\x - \xo 14:13 \xt JHN 16:23; MAT 21:22; JHN 16:26; JHN 15:16; JHN 15:7; LUK 11:9\x*
\v 14 \w se|strong="G1437"\w* \w algo|strong="G5100"\w* \w me pedirem|strong="G154,G3165"\w* \w em meu nome|strong="G1722,G3588,G3686,G3165"\w*, \w eu|strong="G1473"\w* \w farei|strong="G4160"\w*.\f + \fr 14.14: \ft Variante: Treg omite “me” (με); WH traz “isso” (τοῦτο) em lugar de “eu” (ἐγώ): “isso farei”.\f*\x - \xo 14:14 \xt JHN 16:23; JHN 16:26; JHN 15:16; LUK 1:63; MAT 7:7; JHN 16:24\x*
\p
\v 15 \w Se|strong="G1437"\w* \w me amam|strong="G25,G3165"\w*, \w os meus|strong="G3588,G1473"\w* \w mandamentos|strong="G1785"\w* \w guardarão|strong="G5083"\w*;\f + \fr 14.15: \ft Variante: o RP traz o imperativo τηρήσατε (“guardem”) em lugar do futuro τηρήσετε (“guardarão”).\f*\x - \xo 14:15 \xt 1JN 2:3; JHN 14:21; JHN 15:10; 1JN 5:2; 1JN 5:3; JHN 14:23\x*
\v 16 \w e eu|strong="G2532_A,G1473"\w* \w rogarei|strong="G2065"\w* \w ao Pai|strong="G3588,G3962"\w* \w e|strong="G2532"\w* \add ele\add* \w dará|strong="G1325"\w* \w a vocês|strong="G4771"\w* \w outro Paráclito|strong="G243,G3875"\w*, \w para que|strong="G2443"\w* \w esteja|strong="G1510"\w* \w com vocês|strong="G3326,G4771"\w* \w para sempre|strong="G1519,G3588,G165"\w*\f + \fr 14.16: \ft Variante: NA28 traz “esteja” (ᾖ) depois de “para sempre”, em outra ordem; o RP acrescenta “permaneça” (μένῃ).\f*\f + \fr 14.16: \ft Lit.: Παράκλητος, “chamado para junto de alguém”: advogado, defensor, intercessor, consolador, auxiliador; o termo aparece em 14:16, 26; 15:26; 16:7 (e em 1Jo 2:1). Aqui é transliterado.\f*,\f + \fr 14.16: \ft Acréscimo: “ele” (em “Pai e ele dará a”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 14:16 \xt 1JN 2:1; JHN 14:26; LUK 20:3; ROM 8:26; JHN 15:26; JHN 16:7\x*
\v 17 \w o Espírito|strong="G3588,G4151"\w* \w da verdade|strong="G3588,G225"\w*, \w que|strong="G3739"\w* \w o mundo|strong="G3588,G2889"\w* \w não|strong="G3756"\w* \w pode|strong="G1410"\w* \w receber|strong="G2983"\w*, \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w o vê|strong="G2334,G846"\w* \w nem|strong="G3761"\w* \w conhece|strong="G1097"\w*; \w vocês|strong="G4771"\w* \w o conhecem|strong="G1097,G846"\w*, \w porque|strong="G3754"\w* \w junto de vocês|strong="G3844,G4771"\w* \w permanece|strong="G3306"\w* \w e|strong="G2532"\w* \w em vocês|strong="G1722,G4771"\w* \w estará|strong="G1510"\w*.\f + \fr 14.17: \ft Lit.: Πνεῦμα é neutro em grego, e os pronomes ὅ e αὐτό (“que”, “o”) concordam com ele; em 14:26 e 15:26, porém, aparecem pronomes masculinos (ἐκεῖνος).\f*\f + \fr 14.17: \ft Variante: Treg e o RP acrescentam “o” (αὐτό) depois de “conhece” e “porém” (δέ) depois de “vocês”; WH e Treg trazem ἐστίν (“está”) em lugar de ἔσται (“estará”).\f*\x - \xo 14:17 \xt 1JN 4:6; 1JN 3:24; 1CO 3:16; JHN 16:13; 1JN 4:4; EZK 36:27\x*
\v 18 \w Não|strong="G3756"\w* \w deixarei|strong="G863"\w* \w vocês|strong="G4771"\w* \w órfãos|strong="G3737"\w*, \w venho|strong="G2064"\w* \w a vocês|strong="G4314,G4771"\w*.\x - \xo 14:18 \xt 1JN 4:4; MAT 28:20; JHN 14:3; PSA 23:4; JHN 14:16; JHN 14:27-28\x*
\v 19 \w Ainda|strong="G2089"\w* \w um pouco|strong="G3398"\w* \w e|strong="G2532"\w* \w o mundo|strong="G3588,G2889"\w* \w já não|strong="G2089_B,G3756"\w* \w me vê|strong="G3165,G2334"\w*; \w vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w me veem|strong="G2334,G3165"\w*, \w porque|strong="G3754"\w* \w eu|strong="G1473"\w* \w vivo|strong="G2198"\w* \w e|strong="G2532"\w* \w vocês|strong="G4771"\w* \w viverão|strong="G2198"\w*.\x - \xo 14:19 \xt JHN 16:16; JHN 7:33; JHN 14:6; 1JN 4:4; MAT 28:20; GAL 2:20\x*
\v 20 \w Naquele dia|strong="G1722,G1565,G3588,G2250"\w* \w vocês|strong="G4771"\w* \w saberão|strong="G1097"\w* \w que|strong="G3754"\w* \w eu|strong="G1473"\w* \add estou\add* \w no meu Pai|strong="G1722,G3588,G3962,G3165"\w* \w e|strong="G2532"\w* \w vocês|strong="G4771"\w* \w em mim|strong="G1722,G1473"\w*, \w e eu|strong="G2532_B,G1473"\w* \w em vocês|strong="G1722,G4771"\w*.\f + \fr 14.20: \ft Acréscimo: “estou” (em “que eu estou no meu”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 14:20 \xt 2CO 5:17; COL 1:27; DEU 6:5; 1JN 4:4; MAT 28:20; ROM 8:1\x*
\v 21 \w Aquele que tem|strong="G3588,G2192"\w* \w os meus|strong="G3588,G3165"\w* \w mandamentos|strong="G1785"\w* \w e|strong="G2532"\w* \w os guarda|strong="G5083,G846"\w*, \w esse|strong="G1565"\w* \w é|strong="G1510"\w* \w aquele que me ama|strong="G3588,G25,G3165"\w*; \w aquele que|strong="G3588"\w* \w me ama|strong="G25,G3165"\w* \w será amado|strong="G25"\w* \w pelo meu Pai|strong="G5259,G3588,G3962,G3165"\w*, \w e eu|strong="G2532_B,G1473"\w* \w o amarei|strong="G25,G846"\w* \w e|strong="G2532"\w* \w me manifestarei|strong="G1718,G1473"\w* \w a ele|strong="G846"\w*.”\f + \fr 14.21: \ft Lit.: Ἐμφανίζω, “tornar visível, manifestar”; reflexivo: “manifestar-me a ele” (também no v. 22).\f*\x - \xo 14:21 \xt JHN 14:15; 1JN 5:3; JOS 1:8; 1JN 2:3; 1JN 2:5; 1JN 3:24\x*
\p
\v 22 \w Disse-lhe|strong="G3004,G846"\w* \w Judas|strong="G2455"\w*, \w não o Iscariotes|strong="G3756,G3588,G2469"\w*: “\w Senhor|strong="G2962"\w*, \w o que aconteceu|strong="G5101,G1096"\w* \w que|strong="G3754"\w* \w você vai|strong="G3195"\w* \w se manifestar|strong="G1718,G4771"\w* \w a nós|strong="G3165"\w* \w e|strong="G2532"\w* \w não|strong="G3780"\w* \w ao mundo|strong="G3588,G2889"\w*\f + \fr 14.22: \ft Variante: NA28 e o RP trazem “e que” (καὶ τί) em lugar de “que” (τί).\f*\f + \fr 14.22: \ft Nota cultural: “Judas, não o Iscariotes” é provavelmente o discípulo chamado “Judas de Tiago” em Lc 6:16 e At 1:13.\f*?”\x - \xo 14:22 \xt LUK 6:16; ACT 1:13; JHN 14:15; JHN 12:4; MRK 3:19; JHN 6:71\x*
\v 23 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Se|strong="G1437"\w* \w alguém|strong="G5100"\w* \w me ama|strong="G25,G3165"\w*, \w a minha palavra|strong="G3588,G3056,G3165"\w* \w guardará|strong="G5083"\w*, \w e|strong="G2532"\w* \w o meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w* \w o amará|strong="G25,G846"\w*, \w e|strong="G2532"\w* \w até ele|strong="G4314,G846"\w* \w viremos|strong="G2064"\w* \w e|strong="G2532"\w* \w morada|strong="G3438"\w* \w junto dele|strong="G3844,G846"\w* \w faremos|strong="G4160"\w*.\x - \xo 14:23 \xt JHN 14:15; PSA 91:14; PRO 8:17; DEU 11:27; JHN 14:21; REV 3:20\x*
\v 24 \w Aquele que não me ama|strong="G3588,G3361,G25,G3165"\w* \w as minhas palavras|strong="G3588,G3056,G3165"\w* \w não|strong="G3756"\w* \w guarda|strong="G5083"\w*; \w e|strong="G2532"\w* \w a palavra|strong="G3588,G3056"\w* \w que|strong="G3739"\w* \w ouvem|strong="G191"\w* \w não|strong="G3756"\w* \w é|strong="G1510"\w* \w minha|strong="G1473"\w*, \w mas|strong="G235"\w* \w do Pai|strong="G3588,G3962"\w* \w que me enviou|strong="G3992,G3165"\w*.\x - \xo 14:24 \xt JHN 14:15; JHN 14:21; PRO 3:1; MAT 7:24; 1JN 5:3; JHN 7:16\x*
\v 25 \w Estas coisas|strong="G3778"\w* \w falei|strong="G2980"\w* \w a vocês|strong="G4771"\w* \w permanecendo|strong="G3306"\w* \w junto de vocês|strong="G3844,G4771"\w*;\x - \xo 14:25 \xt 2TI 3:14; 1CO 7:24; 1JN 4:13; JHN 17:6-8; JHN 13:19; JHN 16:1-4\x*
\v 26 \w O Paráclito|strong="G3588,G3875"\w*, \w porém|strong="G1161"\w*, \w o Espírito Santo|strong="G3588,G4151,G40"\w*, \w que|strong="G3739"\w* \w enviará|strong="G3992"\w* \w o Pai|strong="G3588,G3962"\w* \w em meu nome|strong="G1722,G3588,G3686,G3165"\w*, \w aquele|strong="G1565"\w* \w ensinará|strong="G1321"\w* \w a vocês|strong="G4771"\w* \w tudo|strong="G3956"\w*, \w e|strong="G2532"\w* \w fará lembrar|strong="G5279"\w* \w a vocês|strong="G4771"\w* \w tudo|strong="G3956"\w* \w o que|strong="G3739"\w* \w eu disse|strong="G2036"\w* \w a vocês|strong="G4771"\w*.\f + \fr 14.26: \ft Variante: WH e NA28 acrescentam “eu” (ἐγώ) depois de “disse a vocês”.\f*\x - \xo 14:26 \xt JHN 15:26; JHN 16:7; JHN 16:13; JHN 14:16; 1CO 2:10; 1JN 2:27\x*
\v 27 \w Paz|strong="G1515"\w* \w deixo|strong="G863"\w* \w a vocês|strong="G4771"\w*, \w a minha|strong="G3588,G1473"\w* \w paz|strong="G1515"\w* \w dou|strong="G1325"\w* \w a vocês|strong="G4771"\w*; \w não|strong="G3756"\w* \w como|strong="G2531"\w* \w o mundo|strong="G3588,G2889"\w* \w dá|strong="G1325"\w*, \w eu|strong="G1473"\w* \w dou|strong="G1325"\w* \w a vocês|strong="G4771"\w*. \w Não se perturbe|strong="G3361,G5015"\w* \w o coração|strong="G3588,G2588"\w* \w de vocês|strong="G4771"\w* \w nem|strong="G3366"\w* \w se acovarde|strong="G1168"\w*.\x - \xo 14:27 \xt COL 3:15; JHN 14:1; 2TH 3:16; 2TI 1:7; ISA 26:3; ISA 41:10\x*
\v 28 \w Ouviram|strong="G191"\w* \w que|strong="G3754"\w* \w eu|strong="G1473"\w* \w disse|strong="G2036"\w* \w a vocês|strong="G4771"\w*: ‘\w Vou embora|strong="G5217"\w* \w e|strong="G2532"\w* \w venho|strong="G2064"\w* \w a vocês|strong="G4314,G4771"\w*.’ \w Se|strong="G1487"\w* \w me amassem|strong="G25,G3165"\w*, \w se alegrariam|strong="G5463,G302"\w*, \w porque|strong="G3754"\w* \w vou|strong="G4198"\w* \w ao Pai|strong="G4314,G3588,G3962"\w*, \w porque|strong="G3754"\w* \w o Pai|strong="G3588,G3962"\w* \w é maior|strong="G3173,G1510"\w* \w do que eu|strong="G3165"\w*.\f + \fr 14.28: \ft Lit.: Μείζων μού ἐστιν, “é maior do que eu”: o sentido de “maior” é discutido desde a antiguidade.\f*\f + \fr 14.28: \ft Variante: o RP acrescenta “eu disse” (εἶπον) depois do segundo “porque” e “meu” (μου) depois de “Pai”.\f*\x - \xo 14:28 \xt JHN 14:12; JHN 14:1; JHN 14:18; JHN 14:3; ACT 1:4; JHN 10:29\x*
\v 29 \w E|strong="G2532"\w* \w agora|strong="G3568"\w* \w lhes disse|strong="G2046,G4771"\w* \w antes que|strong="G4250"\w* \w aconteça|strong="G1096"\w*, \w para que|strong="G2443"\w* \w quando|strong="G3752"\w* \w acontecer|strong="G1096"\w* \w creiam|strong="G4100"\w*.\x - \xo 14:29 \xt JHN 13:19; JHN 16:4; MAT 24:24-25; MRK 13:23; MAT 28:7\x*
\v 30 \w Já não|strong="G2089,G3756"\w* \w muito|strong="G4183"\w* \w falarei|strong="G2980"\w* \w com vocês|strong="G3326,G4771"\w*, \w pois|strong="G1063"\w* \w vem|strong="G2064"\w* \w o governante|strong="G3588,G758"\w* \w do mundo|strong="G3588,G2889"\w*; \w e|strong="G2532"\w* \w em mim|strong="G1722,G1473"\w* \w não|strong="G3756"\w* \w tem|strong="G2192"\w* \w nada|strong="G3762"\w*,\x - \xo 14:30 \xt JHN 12:31; JHN 16:11; EPH 2:2; ROM 12:2; EPH 6:12; 1JN 5:19\x*
\v 31 \w mas|strong="G235"\w* \w para que|strong="G2443"\w* \w conheça|strong="G1097"\w* \w o mundo|strong="G3588,G2889"\w* \w que|strong="G3754"\w* \w amo|strong="G25"\w* \w o Pai|strong="G3588,G3962"\w*, \w e|strong="G2532"\w* \w assim como|strong="G2531"\w* \w me ordenou|strong="G1781,G3165"\w* \w o Pai|strong="G3588,G3962"\w*, \w assim|strong="G3779"\w* \w faço|strong="G4160"\w*. \w Levantem-se|strong="G1453"\w*, \w vamos|strong="G71"\w* \w daqui|strong="G1782"\w*.”\f + \fr 14.31: \ft Lit.: Ἐγείρεσθε, ἄγωμεν ἐντεῦθεν: “levantem-se, vamos daqui”; a passagem para os caps. 15–17, que prosseguem o discurso, é objeto de discussão sobre a composição do evangelho.\f*\f + \fr 14.31: \ft Variante: WH e Treg trazem “me deu mandamento” (ἐντολὴν ἔδωκέν) em lugar de “me ordenou” (ἐνετείλατο).\f*\x - \xo 14:31 \xt JHN 12:49; MAT 26:39; JHN 10:18; JHN 15:10; JHN 17:4; PHP 2:8\x*
\c 15
\p
\v 1 “\w Eu sou|strong="G1473,G1510"\w* \w a videira|strong="G3588,G288"\w* \w verdadeira|strong="G3588,G228"\w*, \w e|strong="G2532"\w* \w o meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w* \w é|strong="G1510"\w* \w o agricultor|strong="G3588,G1092"\w*.\f + \fr 15.1: \ft Nota cultural: a videira é imagem frequente de Israel no Antigo Testamento (por exemplo Sl 80:8-16; Is 5:1-7; Jr 2:21; Os 10:1).\f*\x - \xo 15:1 \xt JER 2:21; PSA 80:8; ISA 5:1; HOS 10:1; JHN 14:6; ISA 27:2-3\x*
\v 2 \w Todo ramo|strong="G3956,G2814"\w* \w em mim|strong="G1722,G1473"\w* \w que não dá|strong="G3361,G5342"\w* \w fruto|strong="G2590"\w*, \w ele o tira|strong="G142,G846"\w*; \w e|strong="G2532"\w* \w todo o que|strong="G3956,G3588"\w* \w dá|strong="G5342"\w* \w fruto|strong="G2590"\w*, \w o limpa|strong="G2508,G846"\w*, \w para que|strong="G2443"\w* \w mais|strong="G4119"\w* \w fruto|strong="G2590"\w* \w dê|strong="G5342"\w*.\f + \fr 15.2: \ft Lit.: Αἴρω, “levantar” ou “tirar, remover”; καθαίρω, “limpar, podar” (jogo de palavras com καθαροί, “limpos”, do v. 3).\f*\x - \xo 15:2 \xt JHN 15:8; GAL 5:22; MAT 3:10; HEB 12:10-11; JHN 15:4; JHN 15:5\x*
\v 3 \w Já|strong="G2235"\w* \w vocês|strong="G4771"\w* \w limpos|strong="G2513"\w* \w estão|strong="G1510"\w* \w por causa|strong="G1223"\w* \w da palavra|strong="G3588,G3056"\w* \w que|strong="G3739"\w* \w lhes falei|strong="G2980,G4771"\w*;\x - \xo 15:3 \xt JHN 17:17; EPH 5:26; 1PE 1:22; JHN 13:10; COL 1:27; PSA 119:9\x*
\v 4 \w Permaneçam|strong="G3306"\w* \w em mim|strong="G1722,G1473"\w*, \w e eu|strong="G2532,G1473"\w* \w em vocês|strong="G1722,G4771"\w*. \w Assim como|strong="G2531"\w* \w o ramo|strong="G3588,G2814"\w* \w não|strong="G3756"\w* \w pode|strong="G1410"\w* \w fruto|strong="G2590"\w* \w dar|strong="G5342"\w* \w por si mesmo|strong="G575,G1438"\w* \w se não|strong="G1437,G3361"\w* \w permanecer|strong="G3306"\w* \w na videira|strong="G1722,G3588,G288"\w*, \w assim|strong="G3779"\w* \w nem|strong="G3761"\w* \w vocês|strong="G4771"\w* \w se não|strong="G1437,G3361"\w* \w em mim|strong="G1722,G1473"\w* \w permanecerem|strong="G3306"\w*.\f + \fr 15.4: \ft Lit.: Μένω, “permanecer, ficar, morar”: verbo-chave repetido em todo o trecho 15:4-16.\f*\x - \xo 15:4 \xt 1JN 2:6; PHP 4:13; GAL 2:20; JHN 8:31; JHN 15:2; 2JN 1:9\x*
\v 5 \w Eu sou|strong="G1473,G1510"\w* \w a videira|strong="G3588,G288"\w*, \w vocês|strong="G4771"\w* \w os ramos|strong="G3588,G2814"\w*. \w Aquele que permanece|strong="G3588,G3306"\w* \w em mim|strong="G1722,G1473"\w*, \w e eu|strong="G2532,G1473"\w* \w nele|strong="G1722,G846"\w*, \w esse|strong="G3778"\w* \w dá|strong="G5342"\w* \w fruto|strong="G2590"\w* \w muito|strong="G4183"\w*, \w porque|strong="G3754"\w* \w separados de mim|strong="G5565,G1473"\w* \w não|strong="G3756"\w* \w podem|strong="G1410"\w* \w fazer|strong="G4160"\w* \w nada|strong="G3762"\w*.\x - \xo 15:5 \xt JHN 15:16; COL 1:10; GAL 5:22; PHP 4:13; 2CO 5:17; PRO 11:30\x*
\v 6 \w Se alguém não|strong="G1437,G3361,G5100"\w* \w permanecer|strong="G3306"\w* \w em mim|strong="G1722,G1473"\w*, \w é lançado|strong="G906"\w* \w fora|strong="G1854"\w* \w como|strong="G5613"\w* \w o ramo|strong="G3588,G2814"\w* \w e|strong="G2532"\w* \w seca|strong="G3583"\w*, \w e|strong="G2532"\w* \w os recolhem|strong="G4863,G846"\w* \w e|strong="G2532"\w* \w no fogo|strong="G1519,G3588,G4442"\w* \w os lançam|strong="G906"\w* \w e|strong="G2532"\w* \w são queimados|strong="G2545"\w*.\x - \xo 15:6 \xt JHN 15:4; PSA 1:3; JHN 8:31; MAT 7:19; 1JN 2:6; JHN 14:20\x*
\v 7 \w Se|strong="G1437"\w* \w permanecerem|strong="G3306"\w* \w em mim|strong="G1722,G1473"\w* \w e|strong="G2532"\w* \w as minhas palavras|strong="G3588,G4487,G3165"\w* \w em vocês|strong="G1722,G4771"\w* \w permanecerem|strong="G3306"\w*, \w o que quiserem|strong="G3739,G1437,G2309"\w*, \w peçam|strong="G154"\w* \w e|strong="G2532"\w* \w acontecerá|strong="G1096"\w* \w a vocês|strong="G4771"\w*;\f + \fr 15.7: \ft Variante: o RP traz o futuro αἰτήσεσθε (“pedirão”) em lugar do imperativo αἰτήσασθε (“peçam”).\f*\x - \xo 15:7 \xt JHN 15:16; 1JN 3:22; 1JN 5:14; JHN 14:13; LUK 11:9; MRK 11:24\x*
\v 8 \w Nisto|strong="G1722,G3778"\w* \w é glorificado|strong="G1392"\w* \w o meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w*: \w que|strong="G2443"\w* \w muito|strong="G4183"\w* \w fruto|strong="G2590"\w* \w deem|strong="G5342"\w* \w e|strong="G2532"\w* \w se tornem|strong="G1096"\w* \w meus|strong="G1473"\w* \w discípulos|strong="G3101"\w*.\f + \fr 15.8: \ft Variante: o RP traz o futuro γενήσεσθε (“se tornarão”) em lugar de γένησθε.\f*\x - \xo 15:8 \xt JHN 15:2; MAT 5:16; JHN 15:5; JHN 15:16; JHN 8:31; PHP 1:11\x*
\v 9 \w Assim como|strong="G2531"\w* \w me amou|strong="G25,G3165"\w* \w o Pai|strong="G3588,G3962"\w*, \w também eu|strong="G2532,G1473"\w* \w amei|strong="G25"\w* \w vocês|strong="G4771"\w*; \w permaneçam|strong="G3306"\w* \w no meu|strong="G1722,G3588,G1473"\w* \w amor|strong="G26"\w*.\x - \xo 15:9 \xt JHN 17:23; JHN 17:26; 1JN 4:8; 1JN 4:16; 1JN 2:15; JHN 14:21\x*
\v 10 \w Se|strong="G1437"\w* \w os meus|strong="G3588,G3165"\w* \w mandamentos|strong="G1785"\w* \w guardarem|strong="G5083"\w*, \w permanecerão|strong="G3306"\w* \w no meu|strong="G1722,G3588,G3165"\w* \w amor|strong="G26"\w*, \w assim como|strong="G2531"\w* \w eu|strong="G1473"\w* \w os mandamentos|strong="G3588,G1785"\w* \w do meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w* \w tenho guardado|strong="G5083"\w* \w e|strong="G2532"\w* \w permaneço|strong="G3306"\w* \w no amor|strong="G1722,G3588,G26"\w* \w dele|strong="G846"\w*.\x - \xo 15:10 \xt JHN 14:15; 1JN 5:3; JHN 14:21; 1JN 2:3; 1JN 3:24; 2JN 1:6\x*
\v 11 \w Estas coisas|strong="G3778"\w* \w lhes falei|strong="G2980,G4771"\w*, \w para que|strong="G2443"\w* \w a minha|strong="G3588,G1473"\w* \w alegria|strong="G5479"\w* \w esteja|strong="G1510"\w* \w em vocês|strong="G1722,G4771"\w* \w e|strong="G2532"\w* \w a alegria|strong="G3588,G5479"\w* \w de vocês|strong="G4771"\w* \w seja completada|strong="G4137"\w*.\f + \fr 15.11: \ft Variante: o RP traz “permaneça” (μείνῃ) em lugar de “esteja” (ᾖ).\f*\x - \xo 15:11 \xt 1JN 1:4; JHN 17:13; ROM 15:13; JHN 16:24; JHN 14:15; ACT 13:52\x*
\v 12 \w Este|strong="G3778"\w* \w é|strong="G1510"\w* \w o meu|strong="G3588,G1473"\w* \w mandamento|strong="G1785"\w*: \w que amem|strong="G2443,G25"\w* \w uns aos outros|strong="G240"\w* \w assim como|strong="G2531"\w* \w amei|strong="G25"\w* \w vocês|strong="G4771"\w*;\x - \xo 15:12 \xt JHN 14:15; JHN 13:34; 1JN 4:21; 1JN 3:23; 1JN 4:11; JHN 15:17\x*
\v 13 \w Maior|strong="G3173"\w* \w amor|strong="G26"\w* \w do que este|strong="G3778"\w* \w ninguém|strong="G3762"\w* \w tem|strong="G2192"\w*: \w que alguém|strong="G2443,G5100"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w entregue|strong="G5087"\w* \w em favor|strong="G5228"\w* \w dos|strong="G3588"\w* \w seus|strong="G846"\w* \w amigos|strong="G5384"\w*.\x - \xo 15:13 \xt JHN 10:11; JHN 10:15; 1JN 3:16; JHN 14:15; ROM 5:8; EPH 5:2\x*
\v 14 \w Vocês|strong="G4771"\w* \w meus|strong="G3165"\w* \w amigos|strong="G5384"\w* \w são|strong="G1510"\w* \w se fizerem|strong="G1437,G4160"\w* \w o que|strong="G3739"\w* \w eu|strong="G1473"\w* \w mando|strong="G1781"\w* \w a vocês|strong="G4771"\w*.\f + \fr 15.14: \ft Variante: WH traz ὅ (“o que”, singular) e o RP ὅσα (“tudo o que”) em lugar de ἅ.\f*\x - \xo 15:14 \xt JHN 14:15; DEU 28:1; PRO 18:24; PRO 17:17; LUK 5:5; MAT 7:24\x*
\v 15 \add Já\add* \w não|strong="G2089,G3756"\w* \w chamo|strong="G3004"\w* \w vocês|strong="G4771"\w* \w escravos|strong="G1401"\w*, \w porque|strong="G3754"\w* \w o escravo|strong="G3588,G1401"\w* \w não|strong="G3756"\w* \w sabe|strong="G6063"\w* \w o que|strong="G5101"\w* \w faz|strong="G4160"\w* \w o seu|strong="G846,G3588"\w* \w senhor|strong="G2962"\w*; \w a vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w chamei|strong="G2046"\w* \w amigos|strong="G5384"\w*, \w porque|strong="G3754"\w* \w tudo|strong="G3956"\w* \w o que|strong="G3739"\w* \w ouvi|strong="G191"\w* \w da parte|strong="G3844"\w* \w do meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w* \w dei a conhecer|strong="G1107"\w* \w a vocês|strong="G4771"\w*.\f + \fr 15.15: \ft Acréscimo: “Já” (em “Já não chamo”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 15:15 \xt AMO 3:7; PSA 25:14; PRO 18:24; 1CO 2:9-12; MAT 13:11; JAS 2:23\x*
\v 16 \w Não|strong="G3756"\w* \w vocês|strong="G4771"\w* \w a mim|strong="G3165"\w* \w escolheram|strong="G1586"\w*, \w mas|strong="G235"\w* \w eu|strong="G1473"\w* \w escolhi|strong="G1586"\w* \w vocês|strong="G4771"\w*, \w e|strong="G2532"\w* \w os constituí|strong="G5087,G4771"\w*, \w para que|strong="G2443"\w* \w vocês|strong="G4771"\w* \w vão|strong="G5217"\w* \w e|strong="G2532"\w* \w fruto|strong="G2590"\w* \w deem|strong="G5342"\w* \w e|strong="G2532"\w* \w o fruto|strong="G3588,G2590"\w* \w de vocês|strong="G4771"\w* \w permaneça|strong="G3306"\w*, \w para que|strong="G2443"\w* \w tudo o que|strong="G3739,G5100,G302"\w* \w peçam|strong="G154"\w* \w ao Pai|strong="G3588,G3962"\w* \w em meu nome|strong="G1722,G3588,G3686,G3165"\w*, \w ele dê|strong="G1325"\w* \w a vocês|strong="G4771"\w*.\x - \xo 15:16 \xt JHN 15:5; JHN 15:7; JHN 14:13; LUK 11:9; PSA 37:4; MAT 7:7\x*
\v 17 \w Estas coisas|strong="G3778"\w* \w mando|strong="G1781"\w* \w a vocês|strong="G4771"\w*: \w que amem|strong="G2443,G25"\w* \w uns aos outros|strong="G240"\w*.”\x - \xo 15:17 \xt JHN 13:34; JHN 15:12; 1TH 4:9; 1JN 3:14; ROM 12:10; 1PE 1:2\x*
\p
\v 18 “\w Se|strong="G1487"\w* \w o mundo|strong="G3588,G2889"\w* \w odeia|strong="G3404"\w* \w vocês|strong="G4771"\w*, \w saibam|strong="G1097"\w* \w que|strong="G3754"\w* \w a mim|strong="G1473"\w* \w antes|strong="G4413"\w* \w de vocês|strong="G4771"\w* \w odiou|strong="G3404"\w*.\f + \fr 15.18: \ft Lit.: Γινώσκετε: indicativo (“vocês sabem”) ou imperativo (“saibam”).\f*\x - \xo 15:18 \xt 1JN 3:13; JHN 17:14; JHN 7:7; JHN 1:10; JHN 16:33; MAT 7:14\x*
\v 19 \w Se|strong="G1487"\w* \w do mundo|strong="G1537,G3588,G2889"\w* \w fossem|strong="G1510"\w*, \w o mundo|strong="G3588,G2889"\w* \w amaria|strong="G302,G5368"\w* \w o que era seu|strong="G3588,G2398"\w*; \w porque|strong="G3754"\w* \w do mundo|strong="G1537,G3588,G2889"\w* \w não|strong="G3756"\w* \w são|strong="G1510"\w*, \w mas|strong="G235"\w* \w eu|strong="G1473"\w* \w escolhi|strong="G1586"\w* \w vocês|strong="G4771"\w* \w do mundo|strong="G1537,G3588,G2889"\w*, \w por isso|strong="G1223,G3778"\w* \w odeia|strong="G3404"\w* \w vocês|strong="G4771"\w* \w o mundo|strong="G3588,G2889"\w*.\f + \fr 15.19: \ft Acréscimo: verbo ser/estar suprido em “o que era seu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 15:19 \xt ROM 12:2; JHN 17:14; 1JN 3:13; JHN 7:7; JHN 15:16; 1JN 2:15\x*
\v 20 \w Lembrem-se|strong="G3421"\w* \w da palavra|strong="G3588,G3056"\w* \w que|strong="G3739"\w* \w eu|strong="G1473"\w* \w lhes disse|strong="G2036,G4771"\w*: ‘\w Não|strong="G3756"\w* \w é|strong="G1510"\w* \w escravo|strong="G1401"\w* \w maior|strong="G3173"\w* \add do que\add* \w o seu|strong="G3588,G846"\w* \w senhor|strong="G2962"\w*.’ \w Se|strong="G1487"\w* \w a mim|strong="G1473"\w* \w perseguiram|strong="G1377"\w*, \w também|strong="G2532"\w* \w a vocês|strong="G4771"\w* \w perseguirão|strong="G1377"\w*; \w se|strong="G1487"\w* \w a palavra|strong="G3588,G3056"\w* \w minha|strong="G3165"\w* \w guardaram|strong="G5083"\w*, \w também|strong="G2532"\w* \w a de vocês|strong="G3588,G4771"\w* \w guardarão|strong="G5083"\w*.\f + \fr 15.20: \ft Acréscimo: “do” (em “escravo maior do que o”): preposição ou artigo que a regência do português exige; “que” (em “maior do que o seu”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 15:20 \xt JHN 16:33; MAT 24:9; MAT 7:14; 2TI 3:12; MAT 5:10; MAT 10:22\x*
\v 21 \w Mas|strong="G235"\w* \w todas estas coisas|strong="G3778,G3956"\w* \w farão|strong="G4160"\w* \w a vocês|strong="G1519,G4771"\w* \w por causa|strong="G1223"\w* \w do meu nome|strong="G3588,G3686,G3165"\w*, \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w conhecem|strong="G6063"\w* \w aquele que me enviou|strong="G3588,G3992,G3165"\w*.\x - \xo 15:21 \xt JHN 16:33; MAT 5:11; MAT 10:22; JHN 17:14; ZEC 2:8; 2CO 12:10\x*
\v 22 \w Se|strong="G1487"\w* \w não|strong="G3361"\w* \w eu tivesse vindo|strong="G2064"\w* \w e|strong="G2532"\w* \w lhes tivesse falado|strong="G2980,G846"\w*, \w pecado|strong="G266"\w* \w não teriam|strong="G3756,G2192"\w*; \w agora|strong="G3568"\w*, \w porém|strong="G1161"\w*, \w desculpa|strong="G4392"\w* \w não|strong="G3756"\w* \w têm|strong="G2192"\w* \w a respeito|strong="G4012"\w* \w do pecado|strong="G3588,G266"\w* \w deles|strong="G846"\w*.\x - \xo 15:22 \xt JHN 9:41; JAS 4:17; LUK 12:48; ROM 1:20; ACT 17:30; LUK 12:47\x*
\v 23 \w Aquele que me odeia|strong="G3588,G1473,G3404"\w* \w também|strong="G2532"\w* \w o meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w* \w odeia|strong="G3404"\w*.\x - \xo 15:23 \xt JHN 8:42; JAS 4:4; JHN 9:41; JHN 5:23; LUK 12:47; LUK 23:34\x*
\v 24 \w Se|strong="G1487"\w* \w as obras|strong="G3588,G2041"\w* \w não|strong="G3361"\w* \w tivesse feito|strong="G4160"\w* \w entre eles|strong="G1722,G846"\w* \w que|strong="G3739"\w* \w nenhum|strong="G3762"\w* \w outro|strong="G243"\w* \w fez|strong="G4160"\w*, \w pecado|strong="G266"\w* \w não teriam|strong="G3756,G2192"\w*; \w agora|strong="G3568"\w*, \w porém|strong="G1161"\w*, \w também|strong="G2532"\w* \w viram|strong="G3708"\w* \w e|strong="G2532"\w* \w odiaram|strong="G3404"\w*, \w tanto|strong="G2532"\w* \w a mim|strong="G1473"\w* \w quanto|strong="G2532"\w* \w ao meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w*.\x - \xo 15:24 \xt JHN 7:7; MRK 7:6; JHN 8:42; JAS 4:4; JHN 9:41; JHN 5:23\x*
\v 25 \w Mas|strong="G235"\w* \w para que|strong="G2443"\w* \w se cumpra|strong="G4137"\w* \w a palavra|strong="G3588,G3056"\w* \w escrita|strong="G3588,G1125"\w* \w na lei|strong="G1722,G3588,G3551"\w* \w deles|strong="G846"\w*: ‘\w Odiaram-me|strong="G3404,G3165"\w* \w sem motivo|strong="G1432"\w*\f + \fr 15.25: \ft Nota cultural: ecoa Sl 35:19 e Sl 69:4 (“na lei deles”: aqui, as Escrituras em geral).\f*.’\x - \xo 15:25 \xt PSA 69:4; PSA 35:19; LUK 24:44; PSA 109:3; PSA 25:3; JHN 16:9\x*
\v 26 \w Quando|strong="G3752"\w* \w vier|strong="G2064"\w* \w o Paráclito|strong="G3588,G3875"\w*, \w que|strong="G3739"\w* \w eu|strong="G1473"\w* \w enviarei|strong="G3992"\w* \w a vocês|strong="G4771"\w* \w da parte|strong="G3844"\w* \w do Pai|strong="G3588,G3962"\w*, \w o Espírito|strong="G3588,G4151"\w* \w da verdade|strong="G3588,G225"\w*, \w que|strong="G3739"\w* \w da parte|strong="G3844"\w* \w do Pai|strong="G3588,G3962"\w* \w procede|strong="G1607"\w*, \w aquele|strong="G1565"\w* \w dará testemunho|strong="G3140"\w* \w a meu respeito|strong="G4012,G1473"\w*;\f + \fr 15.26: \ft Lit.: Ἐκπορεύομαι, “sair, proceder”; é o único trecho do Novo Testamento em que se diz do Espírito que “procede” do Pai.\f*\f + \fr 15.26: \ft Variante: Treg e o RP acrescentam “porém” (δέ) depois de “Quando”.\f*\x - \xo 15:26 \xt JHN 14:26; JHN 16:7; 1JN 5:6; JHN 14:16; JHN 16:13; JHN 14:17\x*
\v 27 \w E|strong="G2532"\w* \w vocês|strong="G4771"\w* \w também|strong="G1161"\w* \w dão testemunho|strong="G3140"\w*, \w porque|strong="G3754"\w* \w desde o princípio|strong="G575,G746"\w* \w comigo|strong="G3326,G1473"\w* \w estão|strong="G1510"\w*.”\x - \xo 15:27 \xt ACT 1:8; LUK 1:2; 1JN 4:14; ACT 5:32; 1JN 1:2; ISA 43:10\x*
