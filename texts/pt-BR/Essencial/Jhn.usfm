\v 21 \w estes|strong="G3778"\w* \w então|strong="G3767"\w* \w se aproximaram|strong="G4334"\w* \w de Filipe|strong="G5376"\w*, \w o de Betsaida|strong="G3588,G575,G966"\w* \w da Galileia|strong="G3588,G1056"\w*, \w e|strong="G2532"\w* \w lhe pediam|strong="G2065,G846"\w*, \w dizendo|strong="G3004"\w*: “\w Senhor|strong="G2962"\w*, \w queremos|strong="G2309"\w* \w ver|strong="G1492"\w* \w Jesus|strong="G3588,G2424"\w*.”\x - \xo 12:21 \xt JHN 1:44; JHN 1:43; ISA 60:3; MAT 2:2; JHN 1:38; LUK 19:2-4\x*
