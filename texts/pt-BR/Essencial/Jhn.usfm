\v 31 \w Dizia|strong="G3004"\w* \w então|strong="G3767"\w* \w Jesus|strong="G3588,G2424"\w* \w aos judeus|strong="G4314,G3588,G2453"\w* \w que lhe tinham dado crédito|strong="G4100,G846"\w*: “\w Se|strong="G1437"\w* \w vocês|strong="G4771"\w* \w permanecerem|strong="G3306"\w* \w na minha|strong="G1722,G3588,G1473"\w* \w palavra|strong="G3056"\w*, \w vocês são|strong="G1510"\w* \w verdadeiramente|strong="G230"\w* \w meus|strong="G3165"\w* \w discípulos|strong="G3101"\w*\f + \fr 8.31: \ft Lit.: Ἰουδαίους πεπιστευκότας αὐτῷ: judeus que “haviam crido nele”; o texto indica uma crença inicial que o diálogo seguinte põe à prova (8:33, 37, 59).\f*,\x - \xo 8:31 \xt JHN 15:4; 2JN 1:9; JHN 5:38; JHN 8:36; 2TI 3:14; JHN 15:8\x*
\v 32 \w e|strong="G2532"\w* \w conhecerão|strong="G1097"\w* \w a verdade|strong="G3588,G225"\w*, \w e|strong="G2532"\w* \w a verdade|strong="G3588,G225"\w* \w libertará|strong="G1659"\w* \w vocês|strong="G4771"\w*.”\x - \xo 8:32 \xt JHN 14:6; ROM 8:2; JHN 8:36; JHN 17:17; 2CO 3:17; 1PE 2:16\x*
\v 33 \w Responderam-lhe|strong="G611,G4314,G846"\w*: “\w Descendência|strong="G4690"\w* \w de Abraão|strong="G11"\w* \w somos|strong="G1510"\w* \w e|strong="G2532"\w* \w de ninguém|strong="G3762"\w* \w fomos escravos|strong="G1398"\w* \w jamais|strong="G4455"\w*; \w como|strong="G4459"\w* \w você|strong="G4771"\w* \w diz|strong="G3004"\w*: ‘\w Vocês se tornarão|strong="G1096"\w* \w livres|strong="G1658"\w*’?”\x - \xo 8:33 \xt GAL 5:1; ISA 61:1; PSA 119:45; MAT 3:9; GAL 5:13; 1PE 2:16\x*
