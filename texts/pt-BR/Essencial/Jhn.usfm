\v 36 \w Se|strong="G1437"\w* \w então|strong="G3767"\w* \w o Filho|strong="G3588,G5207"\w* \w libertar vocês|strong="G4771,G1659"\w*, \w realmente|strong="G3689"\w* \w livres|strong="G1658"\w* \w serão|strong="G1510"\w*.\x - \xo 8:36 \xt 2CO 3:17; JHN 8:32; GAL 5:1; ROM 8:2; JHN 8:31; ISA 61:1\x*
\v 37 \w Sei|strong="G6063"\w* \w que|strong="G3754"\w* \w descendência|strong="G4690"\w* \w de Abraão|strong="G11"\w* \w são|strong="G1510"\w*; \w mas|strong="G235"\w* \w me procuram|strong="G2212,G3165"\w* \w matar|strong="G615"\w*, \w porque|strong="G3754"\w* \w a minha|strong="G3588,G1473"\w* \w palavra|strong="G3056"\w* \w não|strong="G3756"\w* \w tem lugar|strong="G5562"\w* \w em vocês|strong="G1722,G4771"\w*.\f + \fr 8.37: \ft Lit.: Χωρέω, “ter espaço, caber”: “a minha palavra não tem lugar em vocês” (ou “não avança em vocês”).\f*\x - \xo 8:37 \xt JHN 8:40; ROM 9:7; JHN 7:19; JHN 15:7; JHN 8:39; 1CO 2:14\x*
\v 38 \w O que|strong="G3739"\w* \w eu|strong="G1473"\w* \w vi|strong="G3708"\w* \w junto ao Pai|strong="G3844,G3588,G3962"\w* \w falo|strong="G2980"\w*; \w e|strong="G2532"\w* \w vocês|strong="G4771"\w* \w portanto|strong="G3767"\w* \w o que|strong="G3739"\w* \w ouviram|strong="G191"\w* \w da parte do pai|strong="G3844,G3588,G3962"\w* \w fazem|strong="G4160"\w*.”\f + \fr 8.38: \ft Lit.: Τοῦ πατρός sem possessivo: “do Pai” (de Deus) ou “do pai (de vocês)”; o v. 41 mostra que se trata de um pai distinto do de Jesus.\f*\f + \fr 8.38: \ft Variante: o RP traz “o que eu vi junto ao meu Pai” e “o que viram junto ao pai de vocês” (ἃ ἑωράκατε παρὰ τῷ πατρὶ ὑμῶν); a NIV acrescenta “de vocês” depois de “pai”.\f*\x - \xo 8:38 \xt JHN 6:46; ISA 59:21; JHN 8:44; JHN 16:13; JHN 3:11; JHN 5:19\x*
\v 39 \w Responderam|strong="G611"\w* \w e|strong="G2532"\w* \w lhe disseram|strong="G2036,G846"\w*: “\w O|strong="G3588"\w* \w nosso|strong="G3165"\w* \w pai|strong="G3962"\w* \w é|strong="G1510"\w* \w Abraão|strong="G11"\w*.” \w Disse-lhes|strong="G3004,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Se|strong="G1487"\w* \w fossem|strong="G1510"\w* \w filhos|strong="G5043"\w* \w de Abraão|strong="G3588,G11"\w*, \w fariam|strong="G4160"\w* \w as obras|strong="G3588,G2041"\w* \w de Abraão|strong="G3588,G11"\w*;\f + \fr 8.39: \ft Variante: a NIV e o RP trazem ἦτε (“fossem”) em lugar de ἐστε (“são”); WH traz o presente ποιεῖτε (“façam”) em lugar do imperfeito ἐποιεῖτε (“faziam”).\f*\x - \xo 8:39 \xt ROM 9:7; MAT 3:9; JAS 2:21; GAL 3:7; JHN 8:37; JHN 8:56\x*
\v 40 \w mas agora|strong="G3568,G1161"\w* \w me procuram|strong="G2212,G3165"\w* \w matar|strong="G615"\w*, \w um homem|strong="G444"\w* \w que|strong="G3739"\w* \w lhes disse|strong="G4771,G2980"\w* \w a verdade|strong="G3588,G225"\w*, \w que|strong="G3739"\w* \w ouvi|strong="G191"\w* \w da parte de Deus|strong="G3844,G3588,G2316"\w*; \w isto|strong="G3778"\w* \w Abraão|strong="G11"\w* \w não|strong="G3756"\w* \w fez|strong="G4160"\w*.\x - \xo 8:40 \xt JHN 8:37; JHN 7:1; JHN 8:26; ISA 51:16; JHN 1:13; GAL 4:29\x*
\v 41 \w Vocês|strong="G4771"\w* \w fazem|strong="G4160"\w* \w as obras|strong="G3588,G2041"\w* \w do pai|strong="G3588,G3962"\w* \w de vocês|strong="G4771"\w*.” \w Disseram-lhe|strong="G2036,G846"\w*: “\w Nós|strong="G3165"\w* \w não nascemos|strong="G3756,G1080"\w* \w de prostituição|strong="G1537,G4202"\w*; \w um só|strong="G1520"\w* \w pai|strong="G3962"\w* \w temos|strong="G2192"\w*: \w Deus|strong="G3588,G2316"\w*.”\f + \fr 8.41: \ft Lit.: Ἐκ πορνείας, “de prostituição”, isto é, filhos ilegítimos (de união ilícita); também pode ter sentido figurado, de infidelidade a Deus.\f*\f + \fr 8.41: \ft Variante: NA28 e o RP acrescentam “então” (οὖν) depois de “disseram”; WH e Treg trazem οὐκ ἐγεννήθημεν (“não fomos gerados”) em lugar de οὐ γεγεννήμεθα.\f*\x - \xo 8:41 \xt MRK 7:6; JHN 8:44; 2TH 2:9; ISA 64:8; JHN 1:13; JHN 8:38\x*
\v 42 \w Disse-lhes|strong="G2036,G846"\w* \w Jesus|strong="G3588,G2424"\w*: “\w Se|strong="G1487"\w* \w Deus|strong="G3588,G2316"\w* \w fosse|strong="G1510"\w* \w pai|strong="G3962"\w* \w de vocês|strong="G4771"\w*, \w me amariam|strong="G25,G302,G1473"\w*; \w pois|strong="G1063"\w* \w eu|strong="G1473"\w* \w de Deus|strong="G1537,G3588,G2316"\w* \w saí|strong="G1831"\w* \w e|strong="G2532"\w* \w estou aqui|strong="G2240"\w*; \w pois|strong="G1063"\w* \w nem|strong="G3761"\w* \w por mim mesmo|strong="G575,G1473"\w* \w vim|strong="G2064"\w*, \w mas|strong="G235"\w* \w aquele|strong="G1565"\w* \w me enviou|strong="G3165,G649"\w*.\f + \fr 8.42: \ft Variante: o RP acrescenta “então” (οὖν) depois de “disse”.\f*\x - \xo 8:42 \xt JHN 12:49; JHN 14:10; JHN 14:15; JHN 17:8; MRK 7:6; JHN 17:25\x*
\v 43 \w Por que|strong="G1223,G5101"\w* \w a minha|strong="G3588,G1473"\w* \w maneira de falar|strong="G2981"\w* \w não|strong="G3756"\w* \w entendem|strong="G1097"\w*? \w Porque|strong="G3754"\w* \w não|strong="G3756"\w* \w podem|strong="G1410"\w* \w ouvir|strong="G191"\w* \w a minha|strong="G3588,G1473"\w* \w palavra|strong="G3056"\w*.\f + \fr 8.43: \ft Lit.: Λαλιά, “fala, modo de falar”; distinto de λόγος, “palavra, mensagem”.\f*\x - \xo 8:43 \xt ISA 44:18; JHN 10:27; JHN 7:17; MAT 13:15; JHN 12:39-40; ROM 8:7-8\x*
\v 44 \w Vocês|strong="G4771"\w* \w são|strong="G1510"\w* \w do pai|strong="G1537,G3588,G3962"\w*, \w o diabo|strong="G3588,G1228"\w*, \w e|strong="G2532"\w* \w os desejos|strong="G3588,G1939"\w* \w do pai|strong="G3588,G3962"\w* \w de vocês|strong="G4771"\w* \w querem|strong="G2309"\w* \w fazer|strong="G4160"\w*. \w Aquele|strong="G1565"\w* \w era assassino|strong="G443,G1510"\w* \w desde o princípio|strong="G575,G746"\w*, \w e|strong="G2532"\w* \w na verdade|strong="G1722,G3588,G225"\w* \w não|strong="G3756"\w* \w se mantém firme|strong="G2476"\w*, \w porque|strong="G3754"\w* \w não|strong="G3756"\w* \w há|strong="G1510"\w* \w verdade|strong="G225"\w* \w nele|strong="G1722,G846"\w*. \w Quando|strong="G3752"\w* \w fala|strong="G2980"\w* \w a mentira|strong="G3588,G5579"\w*, \w do que lhe é próprio|strong="G1537,G3588,G2398"\w* \w fala|strong="G2980"\w*, \w porque|strong="G3754"\w* \w é mentiroso|strong="G5583,G1510"\w* \w e|strong="G2532"\w* \w o pai|strong="G3588,G3962"\w* \w dela|strong="G846"\w*.\f + \fr 8.44: \ft Lit.: Αὐτοῦ: “da mentira” (“o pai da mentira”) ou “dele” (“o pai do mentiroso”).\f*\f + \fr 8.44: \ft Lit.: ἔστηκεν: “não se mantém firme” (presente) ou “não permaneceu” (passado) na verdade.\f*\f + \fr 8.44: \ft Acréscimo: verbo ser/estar suprido em “do que lhe é próprio”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 8:44 \xt 1JN 2:4; ACT 13:10; 1JN 3:12; 1JN 3:8; 1PE 5:8; GEN 3:15\x*
\v 45 \w Eu|strong="G1473"\w*, \w porém|strong="G1161"\w*, \w porque|strong="G3754"\w* \w a verdade|strong="G3588,G225"\w* \w digo|strong="G3004"\w*, \w não|strong="G3756"\w* \w creem|strong="G4100"\w* \w em mim|strong="G3165"\w*.\x - \xo 8:45 \xt 2TH 2:12; GAL 4:16; 1JN 4:6; 2TI 4:3; JHN 8:37; JHN 8:47\x*
\v 46 \w Quem|strong="G5101"\w* \w dentre vocês|strong="G1537,G4771"\w* \w me convence|strong="G1651,G3165"\w* \w de pecado|strong="G4012,G266"\w*? \w Se|strong="G1487"\w* \w verdade|strong="G225"\w* \w digo|strong="G3004"\w*, \w por que|strong="G1223,G5101"\w* \w vocês|strong="G4771"\w* \w não|strong="G3756"\w* \w creem|strong="G4100"\w* \w em mim|strong="G3165"\w*?\x - \xo 8:46 \xt JHN 16:8; JHN 16:9; HEB 4:15; 1JN 4:6; JHN 8:37; 2TH 2:10\x*
\v 47 \w Aquele que é|strong="G3588,G1510"\w* \w de Deus|strong="G1537,G3588,G2316"\w* \w as palavras|strong="G3588,G4487"\w* \w de Deus|strong="G3588,G2316"\w* \w ouve|strong="G191"\w*; \w por isso|strong="G1223,G3778"\w* \w vocês|strong="G4771"\w* \w não|strong="G3756"\w* \w ouvem|strong="G191"\w*, \w porque|strong="G3754"\w* \w de Deus|strong="G1537,G3588,G2316"\w* \w não|strong="G3756"\w* \w são|strong="G1510"\w*.”\x - \xo 8:47 \xt JHN 18:37; 2JN 1:9; JHN 10:26; HOS 14:9; JHN 7:17; 1JN 4:6\x*
\v 48 \w Responderam|strong="G611"\w* \w os judeus|strong="G3588,G2453"\w* \w e|strong="G2532"\w* \w lhe disseram|strong="G2036,G846"\w*: “\w Não|strong="G3756"\w* \w dizemos|strong="G3004"\w* \w nós|strong="G3165"\w* \w corretamente|strong="G2573"\w* \w que|strong="G3754"\w* \w você|strong="G4771"\w* \w é|strong="G1510"\w* \w samaritano|strong="G4541"\w* \w e|strong="G2532"\w* \w tem|strong="G2192"\w* \w demônio|strong="G1140"\w*?”\f + \fr 8.48: \ft Nota cultural: chamar alguém de “samaritano” era um insulto entre judeus (cf. 4:9).\f*\f + \fr 8.48: \ft Variante: o RP acrescenta “então” (οὖν) depois de “Responderam”.\f*\x - \xo 8:48 \xt JAS 2:19; JHN 4:9; JHN 7:20; 1JN 4:6; ISA 53:3; PRO 26:28\x*
\v 49 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w*: “\w Eu|strong="G1473"\w* \w não tenho|strong="G3756,G2192"\w* \w demônio|strong="G1140"\w*, \w mas|strong="G235"\w* \w honro|strong="G5091"\w* \w o meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w*, \w e|strong="G2532"\w* \w vocês|strong="G4771"\w* \w me desonram|strong="G818,G3165"\w*.\x - \xo 8:49 \xt 1JN 4:6; JHN 7:18; PRO 26:28; 1PE 2:23; JHN 9:24; 1SA 2:30\x*
\v 50 \w Eu|strong="G1473"\w*, \w porém|strong="G1161"\w*, \w não|strong="G3756"\w* \w procuro|strong="G2212"\w* \w a minha|strong="G3588,G3165"\w* \w glória|strong="G1391"\w*; \w há|strong="G1510"\w* \w aquele que procura|strong="G3588,G2212"\w* \w e|strong="G2532"\w* \w julga|strong="G2919"\w*.\x - \xo 8:50 \xt JHN 5:30; JHN 7:18; 1TH 2:6; 1JN 4:6; JHN 5:41; JHN 8:54\x*
\v 51 \w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w se|strong="G1437"\w* \w alguém|strong="G5100"\w* \w guardar|strong="G5083"\w* \w a minha palavra|strong="G3588,G1473,G3056"\w*, \w de modo algum|strong="G3756,G3361"\w* \w verá|strong="G2334"\w* \w a morte|strong="G2288"\w* \w para sempre|strong="G1519,G3588,G165"\w*.”\x - \xo 8:51 \xt JHN 14:6; GAL 1:5; PHP 4:20; ROM 11:36; JHN 11:25-26; JHN 5:24\x*
\v 52 \w Disseram-lhe|strong="G2036,G846"\w* \w os judeus|strong="G3588,G2453"\w*: “\w Agora|strong="G3568"\w* \w sabemos|strong="G1097"\w* \w que|strong="G3754"\w* \w você tem|strong="G2192"\w* \w demônio|strong="G1140"\w*. \w Abraão|strong="G11"\w* \w morreu|strong="G599"\w* \w e|strong="G2532"\w* \w os profetas|strong="G3588,G4396"\w*, \w e|strong="G2532"\w* \w você|strong="G4771"\w* \w diz|strong="G3004"\w*: ‘\w Se|strong="G1437"\w* \w alguém|strong="G5100"\w* \w guardar|strong="G5083"\w* \w a minha palavra|strong="G3588,G3056,G3165"\w*, \w de modo algum|strong="G3756,G3361"\w* \w experimentará|strong="G1089"\w* \w a morte|strong="G2288"\w* \w para sempre|strong="G1519,G3588,G165"\w*’.\f + \fr 8.52: \ft Lit.: Γεύομαι θανάτου, “provar a morte”: experimentá-la.\f*\f + \fr 8.52: \ft Variante: NA28 e o RP acrescentam “então” (οὖν) depois de “disseram”.\f*\x - \xo 8:52 \xt JHN 11:26; MAT 16:28; MRK 9:1; 1CO 2:14; HEB 11:5; JHN 10:20\x*
\v 53 \w Será que|strong="G3361"\w* \w você|strong="G4771"\w* \w é maior|strong="G3173,G1510"\w* \add do que\add* \w o nosso|strong="G3588,G3165"\w* \w pai|strong="G3962"\w* \w Abraão|strong="G11"\w*, \w que|strong="G3748"\w* \w morreu|strong="G599"\w*? \w E|strong="G2532"\w* \w os profetas|strong="G3588,G4396"\w* \w morreram|strong="G599"\w*; \w quem|strong="G5101"\w* \w você faz|strong="G4160"\w* \w de si mesmo|strong="G4771"\w*?”\f + \fr 8.53: \ft Acréscimo: “do” (em “é maior do que o”): preposição ou artigo que a regência do português exige; “que” (em “maior do que o nosso”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição; verbo ser/estar suprido em “Será que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 8:53 \xt LUK 16:29; JHN 11:26; JHN 4:12; MAT 3:9; JHN 12:34; HEB 7:1-7\x*
\v 54 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w*: “\w Se|strong="G1437"\w* \w eu|strong="G1473"\w* \w glorificar|strong="G1392"\w* \w a mim mesmo|strong="G1473"\w*, \w a minha|strong="G3588,G3165"\w* \w glória|strong="G1391"\w* \w nada|strong="G3762"\w* \w é|strong="G1510"\w*; \w é|strong="G1510"\w* \w o meu|strong="G3588,G3165"\w* \w Pai|strong="G3962"\w* \w aquele que me glorifica|strong="G3588,G1392,G3165"\w*, \w do qual|strong="G3739"\w* \w vocês|strong="G4771"\w* \w dizem|strong="G3004"\w*: ‘\w É nosso|strong="G1510,G3165"\w* \w Deus|strong="G2316"\w*\f + \fr 8.54: \ft Variante: WH traz ὑμῶν (“de vocês”) em lugar de ἡμῶν (“nosso”); o RP traz o presente δοξάζω (“glorifico”) em lugar de δοξάσω (“glorificar”).\f*’,\x - \xo 8:54 \xt ISA 41:10; JHN 11:4; JHN 17:5; JHN 12:23; MRK 7:6; JHN 8:19\x*
\v 55 \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w o conhecem|strong="G1097,G846"\w*, \w mas|strong="G1161"\w* \w eu|strong="G1473"\w* \w o conheço|strong="G6063,G846"\w*; \w e se|strong="G1437,G2532"\w* \w disser|strong="G2036"\w* \w que|strong="G3754"\w* \w não|strong="G3756"\w* \w o conheço|strong="G6063,G846"\w*, \w serei|strong="G1510"\w* \w um mentiroso|strong="G5583"\w* \w semelhante a vocês|strong="G3664,G4771"\w*; \w mas|strong="G235"\w* \w o conheço|strong="G6063,G846"\w* \w e|strong="G2532"\w* \w guardo|strong="G5083"\w* \w a palavra dele|strong="G3588,G3056,G846"\w*.\x - \xo 8:55 \xt 1JN 2:4; ISA 41:10; MRK 7:6; JHN 8:19; EPH 1:17; 1CH 28:9\x*
\v 56 \w Abraão|strong="G11"\w*, \w o pai|strong="G3588,G3962"\w* \w de vocês|strong="G4771"\w*, \w exultou|strong="G21"\w* \w na expectativa de ver|strong="G2443,G1492"\w* \w o meu|strong="G3588,G1473"\w* \w dia|strong="G2250"\w*; \w e|strong="G2532"\w* \w viu|strong="G1492"\w* \w e|strong="G2532"\w* \w se alegrou|strong="G5463"\w*\f + \fr 8.56: \ft Lit.: Ἠγαλλιάσατο ἵνα ἴδῃ: “exultou para ver” (“exultou na expectativa de ver”, “exultou por poder ver”).\f*.”\x - \xo 8:56 \xt MAT 5:12; REV 19:7; HEB 13:8; HEB 11:13; GAL 3:7-9; GEN 22:18\x*
\v 57 \w Disseram|strong="G2036"\w* \w então|strong="G3767"\w* \w os judeus|strong="G3588,G2453"\w* \w a ele|strong="G4314,G846"\w*: “\w Cinquenta|strong="G4004"\w* \w anos|strong="G2094"\w* \w ainda não|strong="G3768"\w* \w tem|strong="G2192"\w*, \w e|strong="G2532"\w* \w viu|strong="G3708"\w* \w Abraão|strong="G11"\w*?”\x - \xo 8:57 \xt HEB 13:8; JHN 12:34; MAT 12:41\x*
\v 58 \w Disse-lhes|strong="G2036,G846"\w* \w Jesus|strong="G2424"\w*: “\w Em verdade, em verdade|strong="G281"\w*, \w digo|strong="G3004"\w* \w a vocês|strong="G4771"\w*: \w antes que|strong="G4250"\w* \w Abraão|strong="G11"\w* \w viesse a existir|strong="G1096"\w*, \w eu sou|strong="G1473,G1510"\w*.”\f + \fr 8.58: \ft Lit.: Πρὶν Ἀβραὰμ γενέσθαι ἐγὼ εἰμί: “antes que Abraão viesse a ser (ou nascesse), eu sou”; o contraste entre γενέσθαι (vir a ser) e εἰμί (ser) e o uso absoluto de Ἐγώ εἰμι ecoam a fórmula divina (Ex 3:14; Is 43:10 LXX).\f*\f + \fr 8.58: \ft Variante: o RP acrescenta o artigo diante de “Jesus” (ὁ Ἰησοῦς).\f*\x - \xo 8:58 \xt EXO 3:14; ISA 43:10; HEB 13:8; COL 1:17; JHN 10:30; JHN 17:5\x*
\v 59 \w Pegaram|strong="G142"\w* \w então|strong="G3767"\w* \w pedras|strong="G3037"\w* \w para que|strong="G2443"\w* \w as atirassem|strong="G906"\w* \w contra ele|strong="G1909,G846"\w*; \w Jesus|strong="G2424"\w* \w se escondeu|strong="G2928"\w* \w e|strong="G2532"\w* \w saiu|strong="G1831"\w* \w do templo|strong="G1537,G3588,G2411"\w*.\f + \fr 8.59: \ft Variante: o RP acrescenta, depois de “templo”, “passando pelo meio deles, e assim se foi” (διελθὼν διὰ μέσου αὐτῶν καὶ παρῆγεν οὕτως).\f*\x - \xo 8:59 \xt PHP 2:6; 1SA 30:6; LUK 4:30; JHN 10:39; JHN 11:8; LUK 4:29\x*
\c 9
\p
\v 1 \w E|strong="G2532"\w* \w passando|strong="G3855"\w* \w viu|strong="G1492"\w* \w um homem|strong="G444"\w* \w cego|strong="G5185"\w* \w de nascença|strong="G1537,G1079"\w*.\x - \xo 9:1 \xt MAT 9:27; MAT 20:30; ISA 35:5; JHN 5:5; ACT 4:22; ACT 14:8\x*
\v 2 \w E|strong="G2532"\w* \w lhe perguntaram|strong="G2065,G846"\w* \w os|strong="G3588"\w* \w seus|strong="G846"\w* \w discípulos|strong="G3101"\w*, \w dizendo|strong="G3004"\w*: “\w Rabi|strong="G4461"\w*, \w quem|strong="G5101"\w* \w pecou|strong="G264"\w*, \w este|strong="G3778"\w* \w ou|strong="G2228"\w* \w os pais|strong="G3588,G1118"\w* \w dele|strong="G846"\w*, \w para que|strong="G2443"\w* \w cego|strong="G5185"\w* \w nascesse|strong="G1080"\w*?”\x - \xo 9:2 \xt JHN 9:20; ISA 35:5; LUK 13:2; JHN 9:34; ACT 28:4; EXO 20:5\x*
\v 3 \w Respondeu|strong="G611"\w* \w Jesus|strong="G2424"\w*: “\w Nem|strong="G3777"\w* \w este|strong="G3778"\w* \w pecou|strong="G264"\w* \w nem|strong="G3777"\w* \w os pais|strong="G3588,G1118"\w* \w dele|strong="G846"\w*, \w mas|strong="G235"\w* \w para que|strong="G2443"\w* \w se manifestassem|strong="G5319"\w* \w as obras|strong="G3588,G2041"\w* \w de Deus|strong="G3588,G2316"\w* \w nele|strong="G1722,G846"\w*.\x - \xo 9:3 \xt JHN 11:4; ISA 35:5; JHN 11:40; ECC 9:1-2; JOB 2:3; JHN 17:4\x*
\v 4 \w É necessário|strong="G1163"\w* \w que nós|strong="G3165"\w* \w realizemos|strong="G2038"\w* \w as obras|strong="G3588,G2041"\w* \w daquele que me enviou|strong="G3588,G3992,G3165"\w*, \w enquanto|strong="G2193"\w* \w é dia|strong="G2250,G1510"\w*; \w vem|strong="G2064"\w* \w a noite|strong="G3571"\w*, \w quando|strong="G3753"\w* \w ninguém|strong="G3762"\w* \w pode|strong="G1410"\w* \w trabalhar|strong="G2038"\w*.\f + \fr 9.4: \ft Variante: o RP traz “eu” (ἐμέ) em lugar de “nós” (ἡμᾶς): “É necessário que eu realize as obras daquele que me enviou”.\f*\x - \xo 9:4 \xt JHN 5:17; JHN 12:35; PSA 90:12; JHN 6:28; EPH 5:16; JHN 4:34\x*
\v 5 \w Enquanto|strong="G3752"\w* \w estiver|strong="G1510"\w* \w no mundo|strong="G1722,G3588,G2889"\w*, \w sou|strong="G1510"\w* \w luz|strong="G5457"\w* \w do mundo|strong="G3588,G2889"\w*.”\x - \xo 9:5 \xt JHN 8:12; JHN 12:46; JHN 3:19; JHN 1:4; EPH 5:14; 1JN 1:5\x*
\v 6 \w Tendo dito|strong="G2036"\w* \w estas coisas|strong="G3778"\w*, \w cuspiu|strong="G4429"\w* \w no chão|strong="G5476"\w* \w e|strong="G2532"\w* \w fez|strong="G4160"\w* \w lama|strong="G4081"\w* \w da saliva|strong="G1537,G3588,G4427"\w*, \w e|strong="G2532"\w* \w aplicou|strong="G2025"\w* \w a lama|strong="G3588,G4081"\w* \w sobre os olhos|strong="G1909,G3588,G3788"\w* \w dele|strong="G846"\w*,\f + \fr 9.6: \ft Variante: WH traz ἐπέθηκεν (“pôs”) em lugar de ἐπέχρισεν (“aplicou, ungiu”); o RP omite “dele” (αὐτοῦ) e acrescenta “do cego” (τοῦ τυφλοῦ) depois de “olhos”.\f*\x - \xo 9:6 \xt JHN 9:11; ISA 35:5; MRK 7:33; MRK 8:23; JHN 11:37; 2KI 2:21\x*
\v 7 \w e|strong="G2532"\w* \w lhe disse|strong="G2036,G846"\w*: “\w Vá|strong="G5217"\w*, \w lave-se|strong="G3538"\w* \w no tanque|strong="G1519,G3588,G2861"\w* \w de Siloé|strong="G3588,G4611"\w*” (\w que|strong="G3739"\w* \w se traduz|strong="G2059"\w* \w Enviado|strong="G649"\w*). \w Foi|strong="G565"\w* \w então|strong="G3767"\w* \w e|strong="G2532"\w* \w se lavou|strong="G3538"\w*, \w e|strong="G2532"\w* \w voltou|strong="G2064"\w* \w enxergando|strong="G991"\w*.\f + \fr 9.7: \ft Nota cultural: Siloé era um tanque em Jerusalém, alimentado pela fonte de Giom por um canal (cf. Is 8:6; 2Rs 20:20).\f*\x - \xo 9:7 \xt ISA 8:6; 2KI 20:20; JHN 9:11; ISA 35:5; 2KI 5:10; MRK 8:23\x*
\p
\v 8 \w Os vizinhos|strong="G3588,G1069"\w* \w então|strong="G3767"\w* \w e|strong="G2532"\w* \w os que o viam|strong="G3588,G2334,G846"\w* \w antes|strong="G3588,G4387"\w*, \w sabendo que|strong="G3754"\w* \w era|strong="G1510"\w* \w mendigo|strong="G6075"\w*, \w diziam|strong="G3004"\w*: “\w Não|strong="G3756"\w* \w é|strong="G1510"\w* \w este|strong="G3778"\w* \w aquele que se sentava|strong="G3588,G2521"\w* \w e|strong="G2532"\w* \w mendigava|strong="G4319"\w*?”\f + \fr 9.8: \ft Variante: o RP traz “cego” (τυφλός) em lugar de “mendigo” (προσαίτης).\f*\x - \xo 9:8 \xt MRK 10:46; ACT 3:2; 1SA 2:8; LUK 18:35; MAT 9:27; PSA 146:8\x*
\v 9 \w Outros|strong="G243"\w* \w diziam|strong="G3004"\w*: “\w É|strong="G1510"\w* \w este|strong="G3778"\w*”; \w outros|strong="G243"\w* \w diziam|strong="G3004"\w*: “\w Não|strong="G3780"\w*, \w mas|strong="G235"\w* \w é semelhante|strong="G3664,G1510"\w* \w a ele|strong="G846"\w*.” \w Aquele|strong="G1565"\w* \w dizia|strong="G3004"\w*: “\w Sou eu|strong="G1473,G1510"\w*.”\f + \fr 9.9: \ft Lit.: Ἐγώ εἰμι, aqui apenas “sou eu”, identificação comum, sem o peso teológico de outros usos joaninos.\f*\x - \xo 9:9 \xt MAT 9:27; PSA 146:8; REV 3:18\x*
\v 10 \w Diziam-lhe|strong="G3004,G846"\w* \w então|strong="G3767"\w*: “\w Como|strong="G4459"\w* \w se abriram|strong="G455"\w* \w os|strong="G3588"\w* \w seus|strong="G4771"\w* \w olhos|strong="G3788"\w*?”\f + \fr 9.10: \ft Variante: WH e NA28 acrescentam “então” (οὖν) depois de “Como”.\f*\x - \xo 9:10 \xt JHN 9:26; MAT 20:33; JHN 9:21; JHN 11:37; JHN 9:17; JHN 9:32\x*
\v 11 \w Respondeu|strong="G611"\w* \w aquele|strong="G1565"\w*: “\w O homem|strong="G3588,G444"\w* \w chamado|strong="G3588,G3004"\w* \w Jesus|strong="G2424"\w* \w fez|strong="G4160"\w* \w lama|strong="G4081"\w* \w e|strong="G2532"\w* \w aplicou|strong="G2025"\w* \w nos meus olhos|strong="G3165,G3588,G3788"\w*, \w e|strong="G2532"\w* \w me disse|strong="G2036,G3165"\w*: ‘\w Vá|strong="G5217"\w* \w a Siloé|strong="G1519,G3588,G4611"\w* \w e|strong="G2532"\w* \w lave-se|strong="G3538"\w*’; \w indo|strong="G565"\w* \w então|strong="G3767"\w* \w e|strong="G2532"\w* \w lavando-me|strong="G3538"\w*, \w passei a ver|strong="G308"\w*.”\f + \fr 9.11: \ft Variante: o RP acrescenta “e disse” depois de “aquele”, traz “Um homem” (Ἄνθρωπος) em lugar de “O homem que”, omite “que” (ὅτι), traz “ao tanque de” (τὴν κολυμβήθραν τοῦ) antes de “Siloé” e “porém” (δέ) em lugar de “então” (οὖν).\f*\x - \xo 9:11 \xt JHN 9:15; JHN 9:6; JHN 9:7; JHN 5:15; MAT 9:27; PSA 146:8\x*
