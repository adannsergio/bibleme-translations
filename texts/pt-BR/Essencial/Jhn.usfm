\v 5 \w E|strong="G2532"\w* \w a luz|strong="G3588,G5457"\w* \w brilha|strong="G5316"\w* \w na escuridão|strong="G1722,G3588,G4653"\w*, \w e|strong="G2532"\w* \w a escuridão|strong="G3588,G4653"\w* \w não a|strong="G846,G3756"\w* \w dominou|strong="G2638"\w*.\f + \fr 1.5: \ft Lit.: Κατέλαβεν, de καταλαμβάνω: “apreender, dominar, compreender”; o grego não escolhe entre os sentidos.\f*\x - \xo 1:5 \xt JHN 8:12; JHN 12:35; JHN 12:46; 1JN 2:8; JHN 3:19-20; GEN 1:3\x*
