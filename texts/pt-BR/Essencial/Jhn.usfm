\v 9 \w Era|strong="G1510"\w* \w a luz|strong="G3588,G5457"\w* \w verdadeira|strong="G3588,G228"\w* \w que ilumina|strong="G3739,G5461"\w* \w toda pessoa|strong="G3956,G444"\w*, \w vindo|strong="G2064"\w* \w ao mundo|strong="G1519,G3588,G2889"\w*.\f + \fr 1.9: \ft Lit.: Ἐρχόμενον, “vindo”: pode se ligar a “luz” (a luz que vinha ao mundo) ou a “pessoa” (toda pessoa que vem ao mundo).\f*\x - \xo 1:9 \xt JHN 12:46; JHN 9:5; JHN 8:12; 1JN 1:5; ISA 60:1; GEN 1:3\x*
\v 10 \w Estava|strong="G1510"\w* \w no mundo|strong="G1722,G3588,G2889"\w*, \w e|strong="G2532"\w* \w o mundo|strong="G3588,G2889"\w* \w por meio dele|strong="G1223,G846"\w* \w veio a existir|strong="G1096"\w*, \w e|strong="G2532"\w* \w o mundo|strong="G3588,G2889"\w* \w não o|strong="G846,G3756"\w* \w conheceu|strong="G1097"\w*.\x - \xo 1:10 \xt JHN 17:25; 1JN 3:1; 1CO 1:21; JHN 15:18; JHN 17:23; JHN 1:3\x*
