\v 1 \add Nos\add* \w dias|strong="H3117"\w* \w em que os juízes julgavam|strong="H8199"\w*, \w houve|strong="H1961"\w* \w fome|strong="H7458"\w* \add na\add* \w terra|strong="H0776"\w*, \w e foi|strong="H1980"\w* \add um\add* \w homem|strong="H0376"\w* \w de Belém|strong="H1035"\w* \w de Judá|strong="H3063"\w* \w peregrinar|strong="H1481"\w* \w nos campos de|strong="H7704"\w* \w Moabe|strong="H4124"\w* — \w ele|strong="H1931"\w*, \w sua mulher|strong="H0802"\w* \w e seus dois|strong="H8147"\w* \w filhos|strong="H1121"\w*.\x - \xo 1:1 \xt GEN 12:10; JDG 17:7; JDG 17:8; 2KI 8:1; 1CH 8:8; GEN 26:1\x*
\v 2 \w E o nome|strong="H8034"\w* \w do homem|strong="H0376"\w* \w era Elimeleque|strong="H0458"\w*, \w e o nome|strong="H8034"\w* \w de sua mulher|strong="H0802"\w* \w era Noemi|strong="H5281"\w*, \w e o nome|strong="H8034"\w* \w de seus dois|strong="H8147"\w* \w filhos|strong="H1121"\w* \w era Malom|strong="H4248"\w* \w e Quiliom|strong="H3630"\w*, \w efrateus|strong="H0673"\w* \w de Belém|strong="H1035"\w* \w de Judá|strong="H3063"\w*; \w e vieram|strong="H0935"\w* \w aos campos|strong="H7704"\w* \add de\add* \w Moabe|strong="H4124"\w* \w e ali ficaram|strong="H1961,H8033"\w*.\x - \xo 1:2 \xt RUT 4:9; RUT 1:5; JDG 17:7; 1SA 1:1; GEN 35:19; RUT 4:11\x*
\v 3 \w E morreu|strong="H4191"\w* \w Elimeleque|strong="H0458"\w*, \w marido|strong="H0376"\w* \w de Noemi|strong="H5281"\w*, \w e ficou|strong="H7604"\w* \w ela|strong="H1931"\w* \w com seus dois|strong="H8147"\w* \w filhos|strong="H1121"\w*.\x - \xo 1:3 \xt RUT 4:3; RUT 2:1; PSA 34:19; 2KI 4:1; HEB 12:10-11; HEB 12:6\x*
\v 4 \w E tomaram|strong="H5375"\w* \w para si|strong="H9038"\w* \w mulheres|strong="H0802"\w* \w moabitas|strong="H4125"\w*; \w o nome|strong="H8034"\w* \w de uma|strong="H0259"\w* \w era Orfa|strong="H6204"\w*, \w e o nome|strong="H8034"\w* \w da outra|strong="H8145"\w* \w era Rute|strong="H7327"\w*; \w e habitaram|strong="H3427"\w* \w ali|strong="H8033"\w* \w cerca de dez|strong="H6235"\w* \w anos|strong="H8141"\w*.\x - \xo 1:4 \xt MAT 1:5; DEU 7:3; RUT 1:14\x*
\v 5 \w E morreram|strong="H4191"\w* \w também|strong="H1571"\w* \w os dois|strong="H8147"\w*, \w Malom|strong="H4248"\w* \w e Quiliom|strong="H3630"\w*, \w e ficou|strong="H7604"\w* \w a mulher|strong="H0802"\w* \w sem seus dois|strong="H8147"\w* \w filhos|strong="H3206"\w* \w e sem seu marido|strong="H0376"\w*.\x - \xo 1:5 \xt RUT 1:2; RUT 1:8; DEU 32:39; PSA 89:30-32\x*
\v 6 \w Então ela se levantou|strong="H6965,H1931"\w* \w com suas noras|strong="H3618"\w* \w e voltou|strong="H7725"\w* \w dos campos|strong="H7704"\w* \add de\add* \w Moabe|strong="H4124"\w*, \w porque|strong="H3588"\w* \w tinha ouvido|strong="H8085"\w*, \w estando ainda na região|strong="H7704"\w* \add de\add* \w Moabe|strong="H4124"\w*, \w que|strong="H3588"\w* \w o SENHOR|strong="H3068"\w*\f + \fr 1.6: \ft Nota cultural: no hebraico, o nome próprio de Deus, YHWH (dStrong H3068; primeira ocorrência no livro). Convenção provisória: escrito "SENHOR" em caixa alta, diferente de "Senhor" como título comum — ver docs/guias-de-estilo/pt-BR.md e convencoes.md desta tarefa\f* \w tinha visitado|strong="H6485"\w* \w seu povo|strong="H5971"\w*, \w dando-lhes|strong="H5414,H9038"\w* \w pão|strong="H3899"\w*.\x - \xo 1:6 \xt GEN 21:1; PSA 132:15; EXO 4:31; PSA 111:5; EXO 3:16; LUK 1:68\x*
\v 7 \w Ela saiu|strong="H3318"\w* \w do lugar|strong="H4480,H4725"\w* \w onde|strong="H0834"\w* \add tinha\add* \w estado|strong="H1961"\w* \w ali|strong="H8033"\w*, \w e suas duas|strong="H8147"\w* \w noras|strong="H3618"\w* \w foram com ela|strong="H5973,H1980"\w*, \w e se puseram a caminho|strong="H1870"\w* \w para voltar|strong="H7725"\w* \w à terra|strong="H0413,H0776"\w* \add de\add* \w Judá|strong="H3063"\w*.\x - \xo 1:7 \xt 2KI 8:3; GEN 38:16; JOB 28:23\x*
\p
\v 8 \w Disse então|strong="H0559"\w* \w Noemi|strong="H5281"\w* \w às duas|strong="H8147"\w* \w noras|strong="H3618"\w*: "\w Ide|strong="H1980"\w*, \w voltai|strong="H7725"\w*, \add cada\add* \w uma|strong="H0802"\w* \w para a casa|strong="H1004"\w* \w de sua mãe|strong="H0517"\w*. \w Que o SENHOR|strong="H3068"\w* \w trate|strong="H6213"\w*\f + \fr 1.8: \ft Variante: a Ketiv tem "ele tratará" (יַעֲשֶׂה), e a Qere, que seguimos, "que ele trate" (יַ֣עַשׂ), como desejo/bênção\f* \w com vocês|strong="H5973"\w* \w com bondade|strong="H2617"\w*\f + \fr 1.8: \ft Lit.: hebraico "chesed", lealdade de aliança, bondade firme; termo-chave do AT, a tradução pode variar por contexto — ver glossário\f* \add assim\add* \w como|strong="H0834"\w* \add vocês\add* \w trataram|strong="H6213"\w* \w com|strong="H5973"\w* \add os\add* \w mortos|strong="H4191"\w* \add e\add* \w comigo|strong="H5973"\w*."\x - \xo 1:8 \xt RUT 2:20; RUT 1:5; COL 3:18; RUT 3:10; COL 3:24; EPH 6:2-3\x*
\v 9 "\w Que o SENHOR|strong="H3068"\w* \w dê|strong="H5414"\w* \w a vocês|strong="H9036"\w* \w e que encontrem|strong="H4672"\w* \w descanso|strong="H4496"\w*, \add cada\add* \w uma|strong="H0802"\w* \w na casa|strong="H1004"\w* \w de seu marido|strong="H0376"\w*."\w E ela as beijou|strong="H5401,H9039"\w*, \w e elas levantaram|strong="H5375"\w* \add a\add* \w voz|strong="H6963"\w* \w e choraram|strong="H1058"\w*.\x - \xo 1:9 \xt GEN 29:11; GEN 45:15; RUT 3:1; ACT 20:37; GEN 27:27; GEN 21:16\x*
\v 10 \w E disseram-lhe|strong="H0559,H9034"\w*: "\w Não|strong="H3588"\w*!\f + \fr 1.10: \ft Lit.: hebraico "ki", normalmente "porque/pois"; aqui funciona como negação enfática na resposta\f* \w Voltaremos com você|strong="H0854,H7725"\w* \w para o seu povo|strong="H5971"\w*."\x - \xo 1:10 \xt ZEC 8:23; PSA 119:63; PSA 16:3\x*
\v 11 \w Mas Noemi disse|strong="H0559,H5281"\w*: "\w Voltem|strong="H7725"\w*, \add minhas\add* \w filhas|strong="H1323"\w*, \w por que|strong="H4100"\w* \w iriam comigo|strong="H1980,H5973"\w*? \w Ainda tenho|strong="H5750,H9030"\w* \w filhos|strong="H1121"\w* \w no meu ventre|strong="H4578"\w* \w para que se tornem|strong="H1961"\w* \w maridos|strong="H0582"\w* \w para vocês|strong="H9036"\w*?"\x - \xo 1:11 \xt DEU 25:5; JHN 6:67; GAL 4:27; GEN 38:11; GEN 38:8; ROM 4:18\x*
\v 12 "\w Voltem|strong="H7725"\w*, \add minhas\add* \w filhas|strong="H1323"\w*, \w vão|strong="H1980"\w*, \w porque|strong="H3588"\w* \w estou velha demais|strong="H2204,H1961"\w* \w para ter|strong="H1961"\w* \w marido|strong="H0376"\w*. \w Pois|strong="H3588"\w*, \w mesmo que eu dissesse|strong="H0559"\w* \w que ainda tenho|strong="H3426,H9030"\w* \w esperança|strong="H8615"\w*, \w e que|strong="H1571"\w* \w esta noite|strong="H3915"\w* \w me casasse|strong="H1961"\w* \w com um marido|strong="H0376"\w* \w e viesse a ter|strong="H1571,H3205"\w* \w filhos|strong="H1121"\w*—\x - \xo 1:12 \xt DEU 25:5; JHN 6:67; GAL 4:27; GEN 17:17; 1TI 5:9; ROM 4:18\x*
\v 13 \w será que|strong="H3860"\w* \w por isso|strong="H3860"\w* \w esperariam|strong="H7663"\w* \w até|strong="H5704"\w* \w que|strong="H0834"\w* \w crescessem|strong="H1431"\w*, \w ficando presas|strong="H5702"\w* \w sem|strong="H1115"\w* \w ter|strong="H1961"\w* \w marido|strong="H0376"\w*? \w Não|strong="H0408"\w*, \add minhas\add* \w filhas|strong="H1323"\w*; \w porque|strong="H3588"\w* \w isso|strong="H9030"\w* \add é\add* \w amargo|strong="H4843"\w* \w demais|strong="H3966"\w* \w do que para vocês|strong="H9036"\w*, \w pois|strong="H3588"\w* \w a mão|strong="H3027"\w* \w do SENHOR|strong="H3068"\w* \w saiu|strong="H3318"\w* \add contra\add* \w mim|strong="H9030"\w*."\x - \xo 1:13 \xt JOB 19:21; DEU 25:5; PSA 32:4; JHN 6:67; JDG 2:15; GAL 4:27\x*
\v 14 \w Elas levantaram|strong="H5375"\w* \add a\add* \w voz|strong="H6963"\w* \w e choraram|strong="H1058"\w* \add ainda\add* \w mais|strong="H5750"\w*. \w Orfa beijou|strong="H5401,H6204"\w* \w sua sogra|strong="H2545"\w*, \w mas|strong="H7327"\w* \w Rute|strong="H7327"\w* \w ficou|strong="H1692"\w* \w apegada|strong="H1692"\w* \add a\add* \w ela|strong="H9034"\w*.\x - \xo 1:14 \xt PRO 18:24; JHN 6:67; MAT 16:24; MAT 10:37; 2SA 19:39; DEU 4:4\x*
\v 15 \w Disse então Noemi|strong="H0559"\w*: "\w Veja|strong="H2009"\w*, \w sua cunhada|strong="H2994"\w* \w voltou|strong="H7725"\w* \w para o seu povo|strong="H0413,H5971"\w* \w e para os seus deuses|strong="H0413,H0430"\w*; \w volte você também|strong="H7725"\w* \w atrás de sua cunhada|strong="H0310,H2994"\w*."\x - \xo 1:15 \xt JOS 24:15; JHN 6:67; 2KI 2:2; DEU 4:4; JDG 11:24; RUT 2:11\x*
\v 16 \w Mas Rute|strong="H7327"\w* \w respondeu|strong="H0559"\w*: "\w Não|strong="H0408"\w* \w insista|strong="H6293"\w* \w comigo|strong="H9030"\w* \w para que eu a abandone|strong="H5800"\w* \w e deixe de segui-la|strong="H7725,H0310"\w*; \w porque|strong="H3588"\w* \w aonde|strong="H0413,H0834"\w* \add você\add* \w for|strong="H1980"\w*, \add eu\add* \w irei|strong="H1980"\w*, \w e onde|strong="H0834"\w* \add você passar a\add* \w noite|strong="H3885"\w*, \add eu passarei a\add* \w noite|strong="H3885"\w*; \w o seu povo|strong="H5971"\w* \w será o meu povo|strong="H5971"\w*, \w e o seu Deus|strong="H0430"\w* \w será o meu Deus|strong="H0430"\w*.\x - \xo 1:16 \xt JOS 24:15; 2SA 15:21; RUT 2:11; 2KI 2:2; PSA 45:10; MAT 8:19\x*
\v 17 \w Onde|strong="H0834"\w* \add você\add* \w morrer|strong="H4191"\w*, \add eu\add* \w morrerei|strong="H4191"\w*, \w e ali|strong="H8033"\w* \add serei\add* \w sepultada|strong="H6912"\w*. \w Assim me faça|strong="H3541,H6213,H9030"\w* \w o SENHOR|strong="H3068"\w* \w e ainda mais|strong="H3541"\w* \w acrescente|strong="H3254"\w*, \w se|strong="H3588"\w* \w não for a morte|strong="H4194"\w* \w que separe|strong="H6504"\w* \w entre mim e você|strong="H0996"\w*."\x - \xo 1:17 \xt MAT 1:5; 1SA 3:17; 2SA 15:21; ZEC 8:23; 1KI 19:2; 1KI 2:23\x*
\v 18 \w Vendo|strong="H7200"\w* \w que|strong="H3588"\w* \w ela|strong="H1931"\w* \add estava\add* \w decidida|strong="H0553"\w* \w a ir|strong="H1980"\w* \add com\add* \w ela|strong="H0854"\w*, \w Noemi|strong="H2308"\w* \w deixou|strong="H2308"\w* \add de\add* \w falar|strong="H1696"\w* \w mais sobre isso|strong="H0413"\w*.\x - \xo 1:18 \xt 1CO 15:58; ACT 21:14; JHN 6:67; 2KI 2:2; 2KI 4:30; RUT 2:11\x*
\p
\v 19 \w E foram|strong="H1980"\w* \add as\add* \w duas|strong="H8147"\w* \w até chegarem|strong="H5704,H0935"\w* \w a Belém|strong="H1035"\w*. \w E quando chegaram|strong="H0935,H1035"\w* \w a Belém|strong="H1035"\w*, \w toda a cidade|strong="H3605,H5892"\w* \w se alvoroçou|strong="H1949"\w* \w por causa delas|strong="H5921"\w*, \w e as mulheres diziam|strong="H0559"\w*: \add "Será\add* \w esta|strong="H2063"\w* \w Noemi|strong="H5281"\w*?"\x - \xo 1:19 \xt MAT 21:10; RUT 2:11; ISA 23:7; LAM 2:15; SNG 1:6\x*
\v 20 \w Mas ela respondia|strong="H0559"\w* \add a\add* \w elas|strong="H0413"\w*: "\w Não|strong="H0408"\w* \w me|strong="H9030"\w* \w chamem|strong="H7121"\w* \w Noemi|strong="H5281"\w*; \w chamem-me|strong="H7121,H9030"\w* \w Mara|strong="H4755"\w*, \w porque|strong="H3588"\w* \w o Todo-Poderoso|strong="H7706"\w* \w amargurou|strong="H4843"\w* \w muito|strong="H3966"\w* \w a minha vida|strong="H9030"\w*.\x - \xo 1:20 \xt JOB 27:2; JOB 6:4; EXO 15:23; HEB 12:11; PSA 88:15; 1SA 1:10\x*
\v 21 \w Eu saí|strong="H0589,H1980"\w* \w cheia|strong="H4392"\w*, \w e vazia|strong="H7387"\w* \w o SENHOR|strong="H3068"\w* \w me trouxe de volta|strong="H7725"\w*. \w Por que|strong="H4100"\w* \w me chamam|strong="H7121,H9030"\w* \w Noemi|strong="H5281"\w*, \w se o SENHOR|strong="H3068,H6030"\w* \w testemunhou contra mim|strong="H9030"\w* \w e o Todo-Poderoso|strong="H7706"\w* \w me afligiu|strong="H7489,H9030"\w*?"\x - \xo 1:21 \xt 1SA 2:7-8; JOB 1:21; JOB 10:17; JOB 13:26; JOB 16:8; RUT 2:11\x*
\v 22 \w Assim voltou|strong="H7725"\w* \w Noemi|strong="H5281"\w* \w com Rute|strong="H7327"\w*, \w a moabita|strong="H4125"\w*, \w sua nora|strong="H3618"\w*, \w que estava com ela|strong="H5973"\w*, \w vindo|strong="H7725"\w* \w dos campos|strong="H7704"\w* \add de\add* \w Moabe|strong="H4124"\w*; \w e elas|strong="H1992"\w* \w chegaram|strong="H0935"\w* \w a Belém|strong="H1035"\w* \w no início|strong="H8462"\w* \w da colheita|strong="H7105"\w* \w da cevada|strong="H8184"\w*.\x - \xo 1:22 \xt RUT 2:6; 2SA 21:9; MAT 1:5; RUT 2:23; EXO 9:31; RUT 2:11\x*
\c 2
\p
\v 1 \w Noemi|strong="H5281"\w* \w tinha|strong="H5281"\w* \w um parente|strong="H4129"\w*\f + \fr 2.1: \ft Variante: a Ketiv tem "מְיֻדָּע", "um conhecido"; seguimos a Qere, "מוֹדַ֣ע", "um parente"\f* \w de seu marido|strong="H0376"\w*, \w um homem|strong="H0376"\w* \w rico|strong="H1368,H2428"\w* \w do clã|strong="H4940"\w* \w de Elimeleque|strong="H0458"\w*, \w e seu nome|strong="H8034"\w* \w era Boaz|strong="H1162"\w*.\x - \xo 2:1 \xt RUT 1:3; RUT 4:21; RUT 3:12; RUT 3:2; MAT 1:5\x*
\v 2 \w Disse então|strong="H0559"\w* \w Rute|strong="H7327"\w*, \w a moabita|strong="H4125"\w*, \w a Noemi|strong="H0413,H5281"\w*: "\w Deixe-me|strong="H1980"\w* \w ir|strong="H1980"\w* \w por favor|strong="H4994"\w* \w ao campo|strong="H7704"\w* \w colher espigas|strong="H3950,H7641"\w* \w atrás|strong="H0310"\w* \w de quem|strong="H0834"\w* \w eu encontrar|strong="H4672"\w* \w favor|strong="H2580"\w* \w aos seus olhos|strong="H5869"\w*."\w E ela respondeu|strong="H0559,H9034"\w*: "\w Vá|strong="H1980"\w*, \add minha\add* \w filha|strong="H1323"\w*."\x - \xo 2:2 \xt RUT 4:5; LEV 23:22; LEV 19:9; DEU 24:19-21; 1TI 5:4; GEN 32:5\x*
\v 3 \w Ela foi|strong="H1980"\w* \w e chegou|strong="H0935"\w*, \w e colheu espigas|strong="H3950"\w* \w no campo|strong="H7704"\w* \w atrás|strong="H0310"\w* \w dos que colhiam|strong="H7114"\w*; \w e aconteceu|strong="H7136,H4745"\w* \w que a parte|strong="H2513"\w* \w do campo|strong="H7704"\w* \w pertencia a Boaz|strong="H1162"\w*, \w que|strong="H0834"\w* \w era|strong="H4940"\w* \w do clã|strong="H4940"\w* \w de Elimeleque|strong="H0458"\w*.\x - \xo 2:3 \xt 2TH 3:12; LEV 23:22; 1TH 4:11-12; LUK 10:31; MAT 10:29; PRO 31:13\x*
\p
\v 4 \w E eis que|strong="H2009"\w* \w Boaz|strong="H1162"\w* \w vinha|strong="H0935"\w* \w de Belém|strong="H1035"\w* \w e disse|strong="H0559"\w* \w aos que colhiam|strong="H7114"\w*: "\w O SENHOR|strong="H3068"\w* \w seja com vocês|strong="H5973"\w*!"\w E eles responderam|strong="H0559,H9033"\w*: "\w Que|strong="H1288"\w* \w o SENHOR|strong="H3068"\w* \w o bendiga|strong="H1288"\w*!"\x - \xo 2:4 \xt NUM 6:24; PSA 129:7-8; JDG 6:12; LUK 1:28; 2TH 3:16; 2TI 4:22\x*
\v 5 \w E Boaz perguntou|strong="H0559,H1162"\w* \w a seu servo|strong="H5288"\w*, \w que estava encarregado|strong="H5324,H5921"\w* \w dos que colhiam|strong="H7114"\w*: "\w De quem|strong="H4310"\w* \w é|strong="H4310"\w* \w aquela|strong="H2063"\w* \w jovem|strong="H5291"\w*?"\x - \xo 2:5 \xt LEV 23:22; 2KI 5:4; RUT 3:2\x*
\v 6 \w E o servo|strong="H5288"\w* \w que estava encarregado|strong="H5324,H5921,H7114"\w* \w dos que colhiam|strong="H5921,H7114"\w* \w respondeu|strong="H6030,H0559"\w*: "\w É uma jovem|strong="H5291,H1931"\w* \w moabita|strong="H4125"\w*, \w que|strong="H7725"\w* \w voltou|strong="H7725"\w* \w com Noemi|strong="H5973,H5281"\w* \w dos campos|strong="H7704"\w* \add de\add* \w Moabe|strong="H4124"\w*.\x - \xo 2:6 \xt RUT 1:22; LEV 23:22; MAT 24:45\x*
\v 7 \w Ela disse|strong="H0559"\w*: "\w Deixe-me|strong="H3950,H4994"\w* \add colher\add* \w espigas|strong="H3950"\w*, \w por favor|strong="H4994"\w*, \add e\add* \w recolher|strong="H0622"\w* \w entre os feixes|strong="H6016"\w* \w atrás|strong="H0310"\w* \w dos que colhem|strong="H7114"\w*."\w Ela veio|strong="H0935"\w* \w e ficou|strong="H5975"\w* \w desde esta manhã|strong="H0227,H1242"\w* \w até agora|strong="H5704,H6258"\w*, \w e só agora|strong="H2088"\w* \w se sentou|strong="H3427"\w* \w em casa|strong="H1004"\w* \w um pouco|strong="H4592"\w*.\x - \xo 2:7 \xt LEV 23:22; PRO 15:33; 1PE 5:5-6; EPH 5:21; PRO 13:4; PRO 18:23\x*
\v 8 \w E Boaz disse|strong="H0559,H1162"\w* \w a Rute|strong="H0413,H7327"\w*: "\w Não|strong="H3808"\w* \w ouviu|strong="H8085"\w*, \add minha\add* \w filha|strong="H1323"\w*? \w Não|strong="H0408"\w* \w vá|strong="H1980"\w* \add colher\add* \w espigas|strong="H3950"\w* \w em outro campo|strong="H7704,H0312"\w*, \w e também|strong="H1571"\w* \w não|strong="H3808"\w* \w saia|strong="H5674"\w* \w daqui|strong="H2088"\w*; \w fique sempre|strong="H3541,H1692"\w* \w com as minhas servas|strong="H5973,H5291"\w*.\x - \xo 2:8 \xt 2KI 5:13; 1SA 3:16; 1SA 3:6; MAT 9:2; RUT 3:2; SNG 1:7-8\x*
\v 9 \w Seus olhos|strong="H5869"\w* \w estejam sempre|strong="H7704"\w* \w no campo|strong="H7704"\w* \w onde|strong="H0834"\w* \w eles|strong="H7114"\w* \add estiverem\add* \w colhendo|strong="H7114"\w*, \w e vá atrás delas|strong="H1980,H0310"\w*. \w Não|strong="H3808"\w* \w foi|strong="H3808"\w* \w eu|strong="H6680"\w* \w que ordenei|strong="H6680"\w* \w aos servos|strong="H5288"\w* \w que não a tocassem|strong="H1115,H5060"\w*? \w E se tiver sede|strong="H6770"\w*, \w vá|strong="H1980"\w* \w aos vasos|strong="H0413,H3627"\w* \w e beba|strong="H8354"\w* \w da água|strong="H0834"\w* \w que os servos|strong="H5288"\w* \w tiverem tirado|strong="H7579"\w*."\x - \xo 2:9 \xt 1JN 5:18; GEN 20:6; 1CO 7:1; MAT 10:42; PRO 6:29; PSA 105:15\x*
\v 10 \w Ela se prostrou|strong="H5307"\w* \w com o rosto em terra|strong="H5921,H6440"\w* \w e se inclinou|strong="H7812,H0776"\w* \w e disse|strong="H0559"\w* \w a ele|strong="H0413"\w*: \add "Por\add* \w que|strong="H4069"\w* \w encontrei|strong="H4672"\w* \w favor|strong="H2580"\w* \w aos seus olhos|strong="H5869"\w*, \w para que o senhor|strong="H5234"\w* \w se interesse por mim|strong="H5234"\w*, \add sendo\add* \w eu|strong="H0595"\w* \w uma estrangeira|strong="H5237"\w*?"\x - \xo 2:10 \xt RUT 2:13; 1SA 25:23; 1SA 25:41; 2SA 19:28; LUK 1:43; LUK 1:48\x*
\v 11 \w Boaz respondeu|strong="H6030,H1162,H0559"\w* \w a ela|strong="H9034"\w*: \add "Foi-me contado\add* \w tudo|strong="H5046,H9030,H3605,H0834"\w* \w o que você fez|strong="H6213"\w* \w por sua sogra|strong="H0854,H2545"\w* \w depois da morte|strong="H0310,H4194"\w* \w de seu marido|strong="H0376"\w*, \w e como deixou|strong="H5800"\w* \w seu pai|strong="H0001"\w* \w e sua mãe|strong="H0517"\w* \w e a terra|strong="H0776"\w* \w onde nasceu|strong="H4138"\w*, \w para vir|strong="H1980"\w* \w a|strong="H0413"\w* \add um\add* \w povo|strong="H5971"\w* \w que você não conhecia|strong="H0834,H3808,H3045"\w* \w antes|strong="H8543,H8032"\w*.\x - \xo 2:11 \xt RUT 1:16; LUK 14:33; 2SA 9:7; LUK 18:29-30; RUT 3:9; RUT 4:15\x*
\v 12 \w Que o SENHOR|strong="H3068"\w* \w recompense|strong="H7999"\w* \w o que você fez|strong="H6467"\w*, \w e que seja|strong="H1961"\w* \w completa|strong="H8003"\w* \w sua recompensa|strong="H4909"\w* \w da parte do SENHOR|strong="H5973,H3068"\w*, \w o Deus|strong="H0430"\w* \w de Israel|strong="H3478"\w*, \w sob cujas|strong="H0834"\w* \w asas|strong="H3671"\w* \w você|strong="H0935"\w* \w veio|strong="H0935"\w* \w buscar refúgio|strong="H2620,H8478"\w*."\x - \xo 2:12 \xt PSA 36:7; PSA 91:4; RUT 1:16; GEN 15:1; JER 31:16; 2CH 15:7\x*
\v 13 \w E ela disse|strong="H0559"\w*: "\w Que|strong="H4672"\w* \w eu|strong="H4672"\w* \w encontre|strong="H4672"\w* \w favor|strong="H2580"\w* \w aos seus olhos|strong="H5869"\w*, \add meu\add* \w senhor|strong="H0113"\w*, \w pois|strong="H3588"\w* \w o senhor me consolou|strong="H5162"\w* \w e falou|strong="H3588,H1696"\w* \w ao coração|strong="H5921,H3820"\w* \w de sua serva|strong="H8198"\w*, \add ainda que\add* \w eu|strong="H0595"\w* \w nem|strong="H3808"\w* \w seja|strong="H1961"\w* \w como|strong="H0259"\w* \w uma de suas servas|strong="H8198"\w*."\x - \xo 2:13 \xt 1SA 1:18; GEN 47:25; GEN 33:15; GEN 33:8; RUT 2:10; GEN 32:5\x*
\v 14 \w Boaz|strong="H1162"\w* \w disse-lhe|strong="H0559,H9034"\w*: "\w Na hora|strong="H6256"\w* \w da refeição|strong="H0400"\w*, \w venha|strong="H5066"\w* \w aqui|strong="H1988"\w* \w e coma|strong="H0398"\w* \w do pão|strong="H4480,H3899"\w*, \w e molhe|strong="H2881"\w* \w seu pedaço|strong="H6595"\w* \w no vinagre|strong="H2558"\w*."\w Ela se sentou|strong="H3427"\w* \w ao lado|strong="H6654"\w* \w dos que colhiam|strong="H7114"\w*, \w e ele lhe serviu|strong="H6642,H9034"\w* \w grão tostado|strong="H7039"\w*; \w ela comeu|strong="H0398"\w*, \add ficou\add* \w satisfeita|strong="H7646"\w* \w e ainda sobrou|strong="H3498"\w*.\x - \xo 2:14 \xt RUT 2:18; 2KI 4:43-44; DEU 8:10; LUK 14:12-14; MAT 14:20\x*
\v 15 \w Quando|strong="H6965"\w* \add ela se\add* \w levantou|strong="H6965"\w* \w para colher espigas|strong="H3950"\w*, \w Boaz|strong="H1162"\w* \w ordenou|strong="H6680"\w* \w a seus servos|strong="H5288"\w*, \w dizendo|strong="H0559"\w*: "\w Mesmo|strong="H1571"\w* \w entre os feixes|strong="H0996,H6016"\w* \w deixem que ela colha|strong="H3950"\w*, \w e não|strong="H3808"\w* \w a humilhem|strong="H3637"\w*.\x - \xo 2:15 \xt LEV 23:22; LEV 19:9; EXO 16:16\x*
\v 16 \w E também|strong="H1571"\w* \w puxem|strong="H7997"\w* \w para ela|strong="H9034"\w* \w algumas espigas|strong="H4480,H6653"\w* \w dos molhos|strong="H6653"\w* \w e deixem-nas|strong="H5800"\w*, \w para que ela as colha|strong="H3950"\w*, \w e não|strong="H3808"\w* \w a repreendam|strong="H1605,H9034"\w*."\x - \xo 2:16 \xt LEV 23:22; 1JN 3:17-18; DEU 24:19; ROM 12:13; HEB 6:10; MAT 25:40\x*
\v 17 \w Ela colheu espigas|strong="H3950"\w* \w no campo|strong="H7704"\w* \w até a tarde|strong="H5704,H6153"\w*, \w e bateu|strong="H2251"\w* \w o que tinha colhido|strong="H0834,H3950"\w*; \w e foi|strong="H1961"\w* \w cerca de uma efa|strong="H0374"\w* \w de cevada|strong="H8184"\w*.\x - \xo 2:17 \xt LEV 23:22; PRO 31:27; EZK 45:11-12\x*
\v 18 \w Ela carregou|strong="H5375"\w* \w o que tinha colhido|strong="H0834,H3950"\w* \w e foi|strong="H0935"\w* \w à cidade|strong="H5892"\w*, \w e sua sogra|strong="H7200,H2545"\w* \w viu|strong="H7200"\w*; \w então ela tirou|strong="H3318"\w* \w e deu a ela|strong="H5414,H9034"\w* \w o que tinha sobrado|strong="H0834,H3498"\w* \w depois de comer o suficiente|strong="H7648"\w*.\x - \xo 2:18 \xt LEV 23:22; RUT 2:14; 1TI 5:4; JHN 6:12-13\x*
\v 19 \w Sua sogra lhe perguntou|strong="H0559,H9034,H2545"\w*: "\w Onde|strong="H0375"\w* \add você\add* \w colheu|strong="H3950"\w* \w hoje|strong="H3117"\w*, \add e\add* \w onde|strong="H0575"\w* \w trabalhou|strong="H6213"\w*? \w Bendito|strong="H1288"\w* \w seja|strong="H1961"\w* \w quem|strong="H5234"\w* \w se interessou|strong="H5234"\w* \w por você|strong="H5234"\w*!"\w Ela contou|strong="H5046"\w* \w à sua sogra|strong="H2545"\w* \w com quem|strong="H0853,H0834,H6213,H5973"\w* \add tinha\add* \w trabalhado|strong="H0834,H6213"\w* \w e disse|strong="H0559"\w*: \add "O\add* \w nome|strong="H8034"\w* \w do homem|strong="H0376"\w* \w com quem|strong="H0834,H6213,H5973"\w* \w trabalhei|strong="H6213"\w* \w hoje|strong="H3117"\w* \w é|strong="H1162"\w* \w Boaz|strong="H1162"\w*."\x - \xo 2:19 \xt LEV 23:22; PSA 41:1; RUT 2:10\x*
\v 20 \w Noemi|strong="H5281"\w* \w disse|strong="H0559"\w* \w a sua nora|strong="H3618"\w*: "\w Bendito|strong="H1288"\w* \w seja|strong="H1931"\w* \w ele|strong="H1931"\w* \w pelo SENHOR|strong="H3068"\w*, \w que|strong="H0834"\w* \w não abandonou|strong="H3808,H5800"\w* \w sua bondade|strong="H2617"\w* \w com|strong="H0854"\w* \add os\add* \w vivos|strong="H2416"\w* \w e os mortos|strong="H0854,H4191"\w*!"\w E Noemi disse-lhe|strong="H0559,H9034,H5281"\w* \add ainda: "Esse\add* \w homem|strong="H0376"\w* \w é nosso parente próximo|strong="H7138,H9035"\w*, \w um dos nossos redentores|strong="H1350,H1931"\w*."\x - \xo 2:20 \xt RUT 1:8; RUT 4:14; EPH 4:32; RUT 3:10; RUT 3:9; 2SA 2:5\x*
\v 21 \w Rute|strong="H7327"\w*, \w a moabita|strong="H4125"\w*, \w disse|strong="H0559"\w* \w ainda|strong="H1571"\w*: \add "Ele\add* \w até|strong="H3588,H0559"\w* \w me|strong="H0413"\w* \w disse|strong="H0559"\w*: '\w Fique|strong="H1692"\w* \w com os servos|strong="H5973,H5288"\w* \w que|strong="H0834"\w* \w trabalham para mim|strong="H9030"\w* \w até|strong="H5704,H0518"\w* \w eles terminarem|strong="H3615"\w* \w toda a colheita|strong="H3605,H7105"\w* \w que é minha|strong="H0834,H9030"\w*.'"\x - \xo 2:21 \xt LEV 23:22; RUT 3:2; SNG 1:7-8\x*
\v 22 \w Noemi|strong="H5281"\w* \w disse|strong="H0559"\w* \w a Rute|strong="H0413,H7327"\w*, \w sua nora|strong="H3618"\w*: \add "É\add* \w bom|strong="H2896"\w*, \add minha\add* \w filha|strong="H1323"\w*, \w que|strong="H3588"\w* \add você\add* \w saia|strong="H3318"\w* \w com as servas dele|strong="H5973,H5291"\w*, \w para que não a molestem|strong="H3808,H6293,H9032"\w* \w em outro campo|strong="H7704,H0312"\w*."\x - \xo 2:22 \xt LEV 23:22; RUT 3:2; SNG 1:8; PRO 27:10\x*
\v 23 \w Ela ficou|strong="H1692"\w* \w colhendo espigas|strong="H3950"\w* \w com as servas|strong="H5291"\w* \w de Boaz|strong="H1162"\w* \w até|strong="H5704"\w* \w terminar|strong="H3615"\w* \w a colheita|strong="H7105"\w* \w da cevada|strong="H7105,H8184"\w* \w e a do trigo|strong="H7105,H2406"\w*, \w e morou|strong="H3427"\w* \w com|strong="H0854"\w* \add sua\add* \w sogra|strong="H2545"\w*.\x - \xo 2:23 \xt RUT 3:2; LEV 23:22; RUT 1:22; EPH 6:1-3; EXO 9:31; 1CO 15:33\x*
\c 3
\p
\v 1 \w Disse-lhe|strong="H0559,H9034"\w* \w Noemi, sua sogra|strong="H5281,H2545"\w*: \add "Minha\add* \w filha|strong="H1323"\w*, \w não|strong="H3808"\w* \add devo\add* \w eu|strong="H1245"\w* \w buscar|strong="H1245"\w* \w um lugar de descanso|strong="H4494"\w* \add para\add* \w você|strong="H9032"\w*, \w que lhe|strong="H0834,H9032"\w* \w seja|strong="H3190"\w* \w bom|strong="H3190"\w*?\x - \xo 3:1 \xt RUT 1:9; 1TI 5:8; 1TI 5:14; GEN 2:18; PSA 128:2; 1CO 7:36\x*
\v 2 \w Agora|strong="H6258"\w*, \w não|strong="H3808"\w* \w é|strong="H1162"\w* \w Boaz|strong="H1162"\w* \w nosso parente|strong="H4130"\w*, \w com cujas servas|strong="H0834,H1961,H0854,H5291"\w* \add você\add* \w esteve|strong="H1961"\w*? \add Eis\add* \w que|strong="H2009,H1931"\w* \w ele|strong="H1931"\w* \add vai\add* \w debulhar|strong="H2219"\w* \w a cevada|strong="H1637,H8184"\w* \w na eira|strong="H1637"\w* \w esta noite|strong="H3915"\w*.\x - \xo 3:2 \xt DEU 25:5-10; RUT 2:20-23; RUT 2:1; RUT 2:8; HEB 2:11-14\x*
\v 3 \w Lave-se|strong="H7364"\w*, \w perfume-se|strong="H5480"\w* \w e vista|strong="H7760"\w* \w suas melhores roupas|strong="H8071,H5921"\w*\f + \fr 3.3: \ft Variante: a Ketiv tem o singular "sua roupa"; a Qere, que seguimos, o plural "suas roupas"\f*, \w e desça|strong="H3381"\w*\f + \fr 3.3: \ft Variante: a Ketiv tem a 1ª pessoa, "e eu desça"; seguimos a Qere, 2ª pessoa, "e desça você"\f* \add à\add* \w eira|strong="H1637"\w*; \w não se dê a conhecer|strong="H0408,H3045"\w* \add ao\add* \w homem|strong="H0376"\w* \w até que ele termine|strong="H5704,H3615"\w* \add de\add* \w comer|strong="H0398"\w* \w e de beber|strong="H8354"\w*.\x - \xo 3:3 \xt 2SA 12:20; EZK 16:9; MAT 6:17; 2SA 14:2; 1TI 2:9-10; ECC 9:8\x*
\v 4 \w E quando ele se deitar|strong="H1961,H7901"\w*, \w observe|strong="H3045"\w* \w o lugar|strong="H4725"\w* \w onde ele se deitar|strong="H0834,H7901,H8033"\w*; \add então\add* \w vá|strong="H0935"\w* \w e descubra|strong="H1540"\w* \w os pés dele|strong="H4772"\w* \w e deite-se|strong="H7901"\w*; \w e ele lhe dirá|strong="H1931,H5046,H9032"\w* \w o que você deve fazer|strong="H0834,H6213"\w*."\x - \xo 3:4 \xt RUT 3:7; RUT 3:8; RUT 3:14\x*
\v 5 \w Ela respondeu|strong="H0559,H0413"\w*: "\w Tudo o que|strong="H3605,H0834"\w* \w a senhora me disser|strong="H0413"\w*\f + \fr 3.5: \ft Variante: pequena diferença de grafia entre Ketiv e Qere na forma do verbo "dizer"; sem efeito no sentido\f*, \add eu\add* \w farei|strong="H6213"\w*."\x - \xo 3:5 \xt COL 3:20; EPH 6:1\x*
\v 6 \w Ela desceu|strong="H3381"\w* \w à eira|strong="H1637"\w* \w e fez|strong="H6213"\w* \w tudo como|strong="H3605,H0834"\w* \w sua sogra|strong="H2545"\w* \w tinha ordenado|strong="H6680"\w*.\x - \xo 3:6 \xt JHN 2:5; PRO 1:8; RUT 3:3\x*
\v 7 \w Boaz|strong="H1162"\w* \w comeu|strong="H0398"\w* \w e bebeu|strong="H8354"\w*, \w e ficou de bom humor|strong="H3190,H3820"\w*, \w e foi|strong="H0935"\w* \w deitar-se|strong="H7901"\w* \w na beira|strong="H7097"\w* \w do monte de grãos|strong="H6194"\w*. \w Ela veio|strong="H0935"\w* \w em segredo|strong="H3909"\w*, \w descobriu os pés dele|strong="H1540,H4772"\w* \w e se deitou|strong="H7901"\w*.\x - \xo 3:7 \xt JDG 19:6; EST 1:10; 2SA 13:28; JDG 19:9; ECC 10:19; ECC 2:24\x*
\v 8 \w E aconteceu|strong="H1961"\w* \w que|strong="H2677"\w*, \w no meio da noite|strong="H3915"\w*, \w o homem|strong="H2729,H0376"\w* \w estremeceu|strong="H2729"\w* \w e se voltou|strong="H3943"\w*, \w e eis que|strong="H2009"\w* \w havia|strong="H0802"\w* \add uma\add* \w mulher|strong="H0802"\w* \w deitada|strong="H7901"\w* \w a seus pés|strong="H4772"\w*.\x - \xo 3:8 \xt RUT 3:4; 1KI 3:19; RUT 3:14\x*
\v 9 \add Ele\add* \w perguntou|strong="H0559"\w*: "\w Quem|strong="H4310"\w* \w é|strong="H0859"\w* \w você|strong="H0859"\w*?"\w E ela respondeu|strong="H0559"\w*: \add "Eu\add* \w sou|strong="H0595"\w* \w Rute|strong="H7327"\w*, \add sua\add* \w serva|strong="H0519"\w*; \w estenda sobre mim|strong="H6566,H3671,H5921,H0519"\w* \add a sua\add* \w capa|strong="H3671"\w*, \w pois|strong="H3588"\w* \w o senhor|strong="H0859"\w* \w é|strong="H1350"\w* \w o redentor|strong="H1350"\w*."\x - \xo 3:9 \xt EZK 16:8; RUT 2:20; RUT 3:12; RUT 2:10-13; DEU 22:30; DEU 25:5\x*
\v 10 \add Ele\add* \w disse|strong="H0559"\w*: "\w Bendita|strong="H1288"\w* \w seja|strong="H1288"\w* \w você|strong="H0859"\w* \w pelo SENHOR|strong="H3068"\w*, \add minha\add* \w filha|strong="H1323"\w*! \add Você\add* \w mostrou|strong="H3190"\w* \w sua bondade|strong="H2617"\w* \w ainda mais agora|strong="H0314"\w* \w do que antes|strong="H4480,H7223"\w*, \add não\add* \w indo|strong="H1115,H1980"\w* \w atrás de jovens|strong="H0310,H0970"\w*, \w sejam|strong="H0518,H1800"\w* \w pobres|strong="H1800"\w* \w ou|strong="H0518"\w* \w ricos|strong="H6223"\w*.\x - \xo 3:10 \xt 1CO 13:4-5; RUT 2:20; GEN 14:19; RUT 1:8; RUT 2:4; GEN 24:31\x*
\v 11 \w Agora|strong="H6258"\w*, \add minha\add* \w filha|strong="H1323"\w*, \w não|strong="H0408"\w* \w tenha|strong="H3372"\w* \w medo|strong="H3372"\w*; \w farei|strong="H6213,H9032"\w* \w tudo o que|strong="H3605,H0834"\w* \add você\add* \w pedir|strong="H0559"\w*, \w pois|strong="H3588"\w* \w todo|strong="H3605"\w* \w o povo|strong="H8179,H5971"\w* \w da cidade|strong="H8179"\w* \w sabe|strong="H3045"\w* \w que|strong="H3588"\w* \w você|strong="H0859"\w* \w é|strong="H0802,H0859"\w* \w uma mulher exemplar|strong="H0802,H2428"\w*.\x - \xo 3:11 \xt PRO 31:29; JOB 6:21; PRO 31:10; PRO 12:4; PHP 4:8; 2PE 1:3\x*
\v 12 \add Mas\add* \w agora|strong="H6258"\w*, \w é verdade|strong="H3588,H0551"\w*\f + \fr 3.12: \ft Variante: a Ketiv tem aqui a partícula condicional "se" (אִם); a Qere a omite, sem efeito no sentido da frase\f* \w que eu|strong="H0595"\w* \w sou|strong="H1350"\w* \w um parente redentor|strong="H1350"\w*, \w mas|strong="H1571"\w* \w também|strong="H1571"\w* \w há|strong="H3426"\w* \w um redentor|strong="H1350"\w* \w mais próximo|strong="H1350,H7138"\w* \w do que eu|strong="H4480"\w*.\x - \xo 3:12 \xt RUT 4:1; RUT 3:9; 1TH 4:6; MAT 7:12; RUT 2:1; LEV 25:25\x*
\v 13 \w Passe esta noite|strong="H3885,H3915"\w* \add aqui;\add* \w e, amanhã|strong="H1961,H1242"\w*, \w se|strong="H0518"\w* \add ele\add* \w quiser|strong="H1350"\w* \w redimi-la|strong="H1350"\w*, \add muito\add* \w bem|strong="H2896"\w*, \add que ele a\add* \w redima|strong="H1350"\w*; \w mas|strong="H0518"\w* \w se|strong="H0518"\w* \w ele|strong="H2654"\w* \w não|strong="H3808"\w* \w quiser|strong="H2654"\w* \w redimi-la|strong="H1350"\w*, \add eu\add* \w mesmo|strong="H0595"\w* \w a|strong="H1350"\w* \w redimirei|strong="H1350"\w*, \w tão certo como vive|strong="H2416"\w* \w o SENHOR|strong="H3068"\w*! \w Fique|strong="H7901"\w* \w deitada|strong="H7901"\w* \w até|strong="H5704"\w* \add de\add* \w manhã|strong="H1242"\w*."\x - \xo 3:13 \xt JER 4:2; RUT 4:5; RUT 2:20; DEU 25:5-9; HEB 6:16; JDG 8:19\x*
\v 14 \w Ela ficou deitada|strong="H7901"\w* \w a seus pés|strong="H4772"\w*\f + \fr 3.14: \ft Variante: a Ketiv tem o singular "a seu pé"; a Qere, "a seus pés"\f* \w até de manhã|strong="H5704,H1242"\w* \w e se levantou|strong="H6965"\w* \w antes que|strong="H2962"\w*\f + \fr 3.14: \ft Variante: pequena diferença de grafia entre Ketiv e Qere em "antes"; sem efeito no sentido\f* \w alguém|strong="H0376"\w* \w pudesse|strong="H5234"\w* \w reconhecer|strong="H5234"\w* \add o\add* \w outro|strong="H7453"\w*, \w pois|strong="H0559"\w* \add ele\add* \w disse|strong="H0559"\w*: "\w Não|strong="H0408"\w* \w deixe|strong="H3045"\w* \add que se\add* \w saiba|strong="H3045"\w* \w que|strong="H3588"\w* \add a\add* \w mulher|strong="H0802"\w* \w veio|strong="H0935"\w* \w à eira|strong="H1637"\w*."\x - \xo 3:14 \xt 2CO 8:21; ROM 14:16; 1CO 10:32; 1PE 2:12; ROM 12:17\x*
\v 15 \add Ele\add* \w disse|strong="H0559"\w* \add ainda:\add* "\w Traga|strong="H3051"\w* \add o\add* \w manto|strong="H4304"\w* \w que você está usando|strong="H0834,H5921"\w* \w e segure-o|strong="H0270,H9034"\w*."\w Ela o segurou|strong="H0270,H9034"\w*, \w e ele mediu|strong="H4058"\w* \w seis medidas|strong="H8337,H8184"\w* \w de cevada|strong="H8184"\w* \w e as pôs sobre ela|strong="H7896,H5921"\w*; \w e ele foi|strong="H0935"\w* \w à cidade|strong="H5892"\w*.\x - \xo 3:15 \xt ISA 32:8; GAL 6:10; ISA 3:23\x*
\v 16 \w Ela chegou|strong="H0935,H0413,H2545"\w* \w à sua sogra|strong="H2545"\w*, \add que\add* \w perguntou|strong="H0559"\w*: \add "Como\add* \w foi|strong="H4310,H0859,H1323"\w*, \add minha\add* \w filha|strong="H1323"\w*?"\f + \fr 3.16: \ft Lit.: hebraico "quem é você, minha filha", lido por quase todos os tradutores como "como foi", pergunta idiomática\f* \w E ela contou a ela|strong="H5046,H9034"\w* \w tudo|strong="H0853,H3605"\w* \w o que|strong="H0834"\w* \add aquele\add* \w homem|strong="H0376"\w* \w tinha feito|strong="H6213"\w* \w por ela|strong="H9034"\w*.\x - \xo 3:16 \xt RUT 3:1; RUT 2:18; RUT 2:19\x*
\v 17 \add Disse\add* \w ainda|strong="H0559"\w*: "\w Estas|strong="H0428"\w* \w seis|strong="H8337"\w* \w medidas de cevada|strong="H8184"\w* \add ele me\add* \w deu|strong="H5414,H9030"\w*, \w pois|strong="H3588"\w* \add me\add* \w disse|strong="H0413"\w*\f + \fr 3.17: \ft Variante: pequena diferença de grafia entre Ketiv e Qere em "ele disse"; sem efeito no sentido\f*: '\w Não|strong="H0408"\w* \w volte|strong="H0935"\w* \w de mãos vazias|strong="H7387"\w* \w para a sua sogra|strong="H0413,H2545"\w*.'"\x - \xo 3:17 \xt RUT 2:23; 1SA 6:3\x*
\v 18 \w Ela respondeu|strong="H0559"\w*: "\w Espere|strong="H3427"\w*, \add minha\add* \w filha|strong="H1323"\w*, \w até|strong="H5704,H0834"\w* \add que você\add* \w saiba|strong="H3045"\w* \w como|strong="H0349"\w* \w vai terminar esse assunto|strong="H5307,H1697"\w*; \w pois|strong="H3588"\w* \add aquele\add* \w homem|strong="H0376"\w* \w não|strong="H3808"\w* \add vai\add* \w descansar|strong="H8252"\w*, \w antes|strong="H3588,H0518"\w* \add de\add* \w resolver|strong="H3615"\w* \add o\add* \w assunto|strong="H1697"\w* \add hoje\add* \w mesmo|strong="H3117"\w*."\x - \xo 3:18 \xt PSA 37:3-5; ISA 28:16; ISA 30:7; PSA 132:4\x*
\c 4
\p
\v 1 \w Boaz|strong="H1162"\w* \w subiu|strong="H5927"\w* \w ao portão|strong="H8179"\w* \w e se sentou|strong="H3427"\w* \w ali|strong="H8033"\w*; \w e eis que|strong="H2009"\w* \w o redentor|strong="H1350"\w* \w de quem|strong="H0834"\w* \w Boaz|strong="H1162"\w* \add tinha\add* \w falado|strong="H1696"\w* \add vinha\add* \w passando|strong="H5674"\w*. \w Ele disse|strong="H0559"\w*: "\w Venha|strong="H5493"\w*, \w sente-se|strong="H3427"\w* \w aqui|strong="H6311"\w*, \w amigo|strong="H6423,H0492"\w*."\f + \fr 4.1: \ft Nota cultural: hebraico "fulano, tal", uma forma de se dirigir a alguém sem dizer o nome — o texto não registra o nome desse parente\f* \w E ele veio|strong="H5493"\w* \w e se sentou|strong="H3427"\w*.\x - \xo 4:1 \xt 2KI 6:8; RUT 3:12; DEU 25:7; PRO 31:23; GEN 34:20; JOB 29:7\x*
