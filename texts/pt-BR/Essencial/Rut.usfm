\v 3 \w Ele disse|strong="H0559"\w* \w ao redentor|strong="H1350"\w*: "\w Noemi|strong="H5281"\w*, \w que voltou|strong="H7725"\w* \w dos campos|strong="H7704"\w* \add de\add* \w Moabe|strong="H4124"\w*, \w está vendendo|strong="H4376"\w* \w a parte|strong="H2513"\w* \w do campo|strong="H7704"\w* \w que|strong="H0834"\w* \w pertencia a nosso irmão|strong="H0251"\w* \w Elimeleque|strong="H0458"\w*.\x - \xo 4:3 \xt RUT 1:3; DEU 25:6; NUM 27:11; PSA 112:5\x*
