\v 11 \w E|strong="G2532"\w* \w Pedro|strong="G3588,G4074"\w*, \w caindo em si|strong="G1722,G1438,G1096"\w*, \w disse|strong="G2036"\w*: “\w Agora|strong="G3568"\w* \w sei|strong="G6063"\w* \w de verdade|strong="G230"\w* \w que|strong="G3754"\w* \w o Senhor|strong="G3588,G2962"\w* \w enviou|strong="G1821"\w* \w o seu|strong="G3588,G846"\w* \w anjo|strong="G32"\w* \w e|strong="G2532"\w* \w me livrou|strong="G1807,G3165"\w* \w da mão|strong="G1537,G5495"\w* \w de Herodes|strong="G2264"\w* \w e|strong="G2532"\w* \w de toda|strong="G3956"\w* \w a expectativa|strong="G3588,G4329"\w* \w do povo|strong="G3588,G2992"\w* \w dos judeus|strong="G3588,G2453"\w*.”\x - \xo 12:11 \xt JOB 5:12; ISA 65:24; JAS 5:16; PSA 34:17; DAN 6:22; ISA 63:9\x*
\v 12 \w E tendo compreendido|strong="G4894,G5037"\w*, \w foi|strong="G2064"\w* \w à casa|strong="G1909,G3588,G3614"\w* \w de Maria|strong="G3588,G3137"\w*, \w a mãe|strong="G3588,G3384"\w* \w de João|strong="G2491"\w*, \w chamado|strong="G3588,G1941"\w* \w Marcos|strong="G3138"\w*, \w onde|strong="G3757"\w* \w estavam|strong="G1510"\w* \w muitos|strong="G2425"\w* \w reunidos|strong="G4867"\w* \w e|strong="G2532"\w* \w orando|strong="G4336"\w*.\x - \xo 12:12 \xt ISA 65:24; PSA 68:6; 1JN 5:14-15; 2TI 4:11; ACT 12:25; ACT 12:5\x*
