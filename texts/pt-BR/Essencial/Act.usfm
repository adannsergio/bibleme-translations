\v 37 \w Mas Paulo|strong="G3588,G1161,G3972"\w* \w disse|strong="G5346"\w* \w a eles|strong="G4314,G846"\w*: “\w Tendo-nos açoitado|strong="G1194,G3165"\w* \w em público|strong="G1219"\w*, \w sem condenação|strong="G178"\w*, \w homens|strong="G444"\w* \w romanos|strong="G4514"\w* \w que somos|strong="G5225"\w*, \w lançaram-nos|strong="G906"\w* \w na prisão|strong="G1519,G5438"\w*; \w e|strong="G2532"\w* \w agora|strong="G3568"\w* \w em segredo|strong="G2977"\w* \w nos expulsam|strong="G3165,G1544"\w*? \w De modo algum|strong="G3756,G1063"\w*! \w Mas|strong="G235"\w* \w venham|strong="G2064"\w* \w eles mesmos|strong="G846"\w* \w e nos conduzam para fora|strong="G3165,G1806"\w*.”\x - \xo 16:37 \xt ACT 22:25; PHP 1:30; ACT 13:50; PSA 107:14; DEU 16:19; PHP 1:5\x*
