\v 22 \w começando|strong="G757"\w* \w do batismo|strong="G575,G3588,G908"\w* \w de João|strong="G2491"\w* \w até o dia|strong="G2193,G3588,G2250"\w* \w em que|strong="G3739"\w* \w foi elevado|strong="G353"\w* \w de nós|strong="G575,G3165"\w*, \w um destes|strong="G1520,G3778"\w* \w se torne|strong="G1096"\w* \w conosco|strong="G4862,G3165"\w* \w testemunha|strong="G3144"\w* \w da ressurreição|strong="G3588,G386"\w* \w dele|strong="G846"\w*.”\x - \xo 1:22 \xt LUK 20:4; ACT 1:8; ACT 4:33; LUK 1:2; PSA 109:8; 1JN 1:2\x*
