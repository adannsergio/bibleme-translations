\v 22 \w Ouviam-no|strong="G191,G1161,G846"\w* \w até esta|strong="G891,G3778,G3588"\w* \w palavra|strong="G3056"\w*, \w e|strong="G2532"\w* \w levantaram|strong="G1869"\w* \w a voz|strong="G3588,G5456"\w* \w deles|strong="G846"\w*, \w dizendo|strong="G3004"\w*: “\w Tire|strong="G142"\w* \w da terra|strong="G575,G3588,G1093"\w* \w um tal homem|strong="G3588,G5108"\w*, \w pois|strong="G1063"\w* \w não convinha|strong="G3756,G2520"\w* \w que ele|strong="G846"\w* \w vivesse|strong="G2198"\w*!”\x - \xo 22:22 \xt ACT 25:24; MAT 10:5; ACT 21:36; JHN 16:2; MAT 24:9; PHP 1:12\x*
\v 23 \w Enquanto gritavam|strong="G2905,G5037,G846"\w* \w e|strong="G2532"\w* \w lançavam|strong="G4496"\w* \w as vestes|strong="G3588,G2440"\w* \w e|strong="G2532"\w* \w jogavam|strong="G906"\w* \w poeira|strong="G2868"\w* \w para o ar|strong="G1519,G3588,G109"\w*,\x - \xo 22:23 \xt MAT 10:5; JHN 16:2; PHP 1:12; 2TI 1:12; ACT 16:22; ACT 17:6\x*
\v 24 \w mandou|strong="G2753"\w* \w o comandante|strong="G3588,G5506"\w* \w que fosse levado|strong="G1521,G846"\w* \w para a fortaleza|strong="G1519,G3588,G3925"\w*, \w dizendo|strong="G2036"\w* \w que fosse interrogado|strong="G426,G846"\w* \w com açoites|strong="G3148"\w*, \w para saber|strong="G2443,G1921"\w* \w por qual|strong="G1223,G3739"\w* \w motivo|strong="G156"\w* \w assim|strong="G3779"\w* \w gritavam|strong="G2019"\w* \w contra ele|strong="G846"\w*.\x - \xo 22:24 \xt ACT 21:34; ACT 22:29; PHP 1:12; 2TI 1:12; ACT 16:22; ACT 21:31-32\x*
\v 25 \w Quando|strong="G5613,G1161"\w* \w o estenderam|strong="G4385,G846"\w* \w com as correias|strong="G3588,G2438"\w*, \w disse|strong="G2036"\w* \w ao centurião|strong="G4314,G3588,G1543"\w* \w que estava presente|strong="G2476"\w* \w Paulo|strong="G3588,G3972"\w*: “\w É permitido|strong="G1832"\w* \w a vocês|strong="G4771"\w* \w açoitar|strong="G3147"\w* \w um homem|strong="G444"\w* \w romano|strong="G4514"\w* \w e|strong="G2532"\w* \w sem condenação|strong="G178"\w*?”\f + \fr 22.25: \ft Não traduzido: Εἰ (G1487): εἰ (if); sem equivalente natural em português neste ponto.\f*\x - \xo 22:25 \xt ACT 16:37; PHP 1:12; ACT 23:27; ACT 25:16; ACT 16:22; ACT 27:43\x*
\v 26 \w Ao ouvir|strong="G191,G1161"\w*, \w o centurião|strong="G3588,G1543"\w*, \w tendo-se aproximado|strong="G4334"\w* \w do comandante|strong="G3588,G5506"\w*, \w comunicou|strong="G518"\w*, \w dizendo|strong="G3004"\w*: “\w O que|strong="G5101"\w* \w vai|strong="G3195"\w* \w fazer|strong="G4160"\w*? \w Pois|strong="G1063"\w* \w este homem|strong="G3588,G444,G3778"\w* \w romano|strong="G4514"\w* \w é|strong="G1510"\w*\f + \fr 22.26: \ft Variante: RP e TR acrescentam ὅρα (“veja”) antes de τί; RP inverte a ordem de ἀπήγγειλεν e τῷ χιλιάρχῳ.\f*.”\x - \xo 22:26 \xt ACT 22:29; ACT 16:37; PHP 1:12; ACT 23:27; ACT 16:22; ACT 5:35\x*
\v 27 \w Aproximando-se|strong="G4334,G1161"\w* \w o comandante|strong="G3588,G5506"\w*, \w disse|strong="G2036"\w* \w a ele|strong="G846"\w*: “\w Diga-me|strong="G3004,G3165"\w*, \w você|strong="G4771"\w* \w romano|strong="G4514"\w* \w é|strong="G1510"\w*?” \w Ele|strong="G3588,G1161"\w* \w disse|strong="G5346"\w*: “\w Sim|strong="G3483"\w*.”\x - \xo 22:27 \xt ACT 16:37; PHP 1:12; ACT 23:27; ACT 22:25; JHN 18:12\x*
\v 28 \w Respondeu|strong="G611,G1161"\w* \w o comandante|strong="G3588,G5506"\w*: “\w Eu|strong="G1473"\w* \w por grande soma|strong="G4183,G2774"\w* \w esta cidadania|strong="G3588,G4174,G3778"\w* \w adquiri|strong="G2932"\w*.” \w Paulo|strong="G3588,G1161,G3972"\w* \w disse|strong="G5346"\w*: “\w Eu, porém|strong="G1473,G1161"\w*, \w nasci|strong="G1080"\w* \w também|strong="G2532"\w*.”\f + \fr 22.28: \ft Lit.: ἐγὼ δὲ καὶ γεγέννημαι: o grego subentende o predicado, “cidadão romano” (“eu, porém, nasci também cidadão”), tirado da frase anterior.\f*\x - \xo 22:28 \xt ACT 16:37; PHP 1:12; ACT 23:27; ACT 22:25; JHN 18:12\x*
\v 29 \w Imediatamente, então|strong="G2112,G3767"\w*, \w se afastaram|strong="G868"\w* \w dele|strong="G575,G846"\w* \w os que estavam para|strong="G3588,G3195"\w* \w interrogá-lo|strong="G846,G426"\w*; \w e|strong="G2532"\w* \w o comandante|strong="G3588,G5506"\w* \w também|strong="G1161"\w* \w teve medo|strong="G5399"\w*, \w tendo reconhecido|strong="G1921"\w* \w que|strong="G3754"\w* \w romano|strong="G4514"\w* \w era|strong="G1510"\w* \w e|strong="G2532"\w* \w que|strong="G3754"\w* \w o tinha amarrado|strong="G846,G1510,G1210"\w*.\x - \xo 22:29 \xt ACT 22:24; ACT 16:37; PHP 1:12; ACT 16:38; ACT 21:33; ACT 23:27\x*
\v 30 \w No dia seguinte|strong="G3588,G1161,G1887"\w*, \w querendo|strong="G1014"\w* \w saber|strong="G1097"\w* \w a certeza|strong="G3588,G804"\w* \w do que|strong="G3588,G5101"\w* \w é acusado|strong="G2723"\w* \w pelos judeus|strong="G5259,G3588,G2453"\w*, \w o soltou|strong="G3089,G846"\w*, \w e|strong="G2532"\w* \w mandou|strong="G2753"\w* \w que se reunissem|strong="G4905"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w todo|strong="G3956,G3588"\w* \w o Sinédrio|strong="G4892"\w*, \w e|strong="G2532"\w*, \w tendo trazido para baixo|strong="G2609"\w* \w Paulo|strong="G3588,G3972"\w*, \w o pôs|strong="G2476"\w* \w diante deles|strong="G1519,G846"\w*\f + \fr 22.30: \ft Variante: RP lê παρά em vez de ὑπό, acrescenta “das correntes” (ἀπὸ τῶν δεσμῶν) depois de αὐτόν, lê ἐλθεῖν, ὅλον e acrescenta αὐτῶν (“deles”) depois de συνέδριον.\f*.\x - \xo 22:30 \xt ACT 23:28; PHP 1:12; ACT 21:33; ACT 21:11; ACT 21:34; ACT 22:5\x*
\c 23
\p
\v 1 \w Paulo|strong="G1161,G3588,G3972"\w*, \w fixando os olhos|strong="G816"\w* \w no Sinédrio|strong="G3588,G4892"\w*, \w disse|strong="G2036"\w*: “\w Homens|strong="G435"\w*, \w irmãos|strong="G80"\w*, \w eu|strong="G1473"\w* \w com toda|strong="G3956"\w* \w consciência|strong="G4893"\w* \w boa|strong="G18"\w* \w tenho vivido como cidadão|strong="G4176"\w* \w diante de Deus|strong="G3588,G2316"\w* \w até este dia|strong="G891,G3778,G3588,G2250"\w*\f + \fr 23.1: \ft Lit.: πολιτεύομαι: “viver como cidadão”, “conduzir a vida”.\f*.”\x - \xo 23:1 \xt ACT 24:16; 2CO 1:12; 2TI 1:3; HEB 13:18; GEN 17:1; 1CO 4:4\x*
\v 2 \w O sumo sacerdote|strong="G3588,G1161,G749"\w* \w Ananias|strong="G367"\w* \w ordenou|strong="G2004"\w* \w aos que estavam|strong="G3588,G3936"\w* \w junto dele|strong="G846"\w* \w que batessem|strong="G5180"\w* \w em sua boca|strong="G846,G3588,G4750"\w*.\x - \xo 23:2 \xt JHN 18:22; MRK 14:65; 1KI 22:24; ACT 24:1; JOB 16:10; 1CO 4:11\x*
\v 3 \w Então|strong="G5119"\w* \w Paulo|strong="G3588,G3972"\w* \w lhe disse|strong="G4314,G846,G2036"\w*: “\w Deus|strong="G3588,G2316"\w* \w está para|strong="G3195"\w* \w bater em você|strong="G5180,G4771"\w*, \w parede|strong="G5109"\w* \w caiada|strong="G2867"\w*! \w E|strong="G2532"\w* \w você|strong="G4771"\w* \w está sentado|strong="G2521"\w* \w me julgando|strong="G2919,G3165"\w* \w segundo a lei|strong="G2596,G3588,G3551"\w*, \w e|strong="G2532"\w*, \w violando a lei|strong="G3891"\w*, \w manda|strong="G2753"\w* \w que me batam|strong="G3165,G5180"\w*?”\x - \xo 23:3 \xt MAT 23:27; DEU 25:1-2; JHN 7:51; ECC 3:16; EXO 22:28; LUK 11:44\x*
\v 4 \w Os que estavam presentes|strong="G3588,G1161,G3936"\w* \w disseram|strong="G2036"\w*: “\w O sumo sacerdote|strong="G3588,G749"\w* \w de Deus|strong="G3588,G2316"\w* \w você insulta|strong="G3058"\w*?”\x - \xo 23:4 \xt JHN 18:22; ACT 23:2; GAL 2:11\x*
\v 5 \w E|strong="G5037"\w* \w disse|strong="G5346"\w* \w Paulo|strong="G3588,G3972"\w*: “\w Não sabia|strong="G3756,G1492"\w*, \w irmãos|strong="G80"\w*, \w que|strong="G3754"\w* \w é|strong="G1510"\w* \w sumo sacerdote|strong="G749"\w*; \w pois|strong="G1063"\w* \w está escrito|strong="G1125"\w*: ‘\w Não falará mal|strong="G3756,G4483,G2560"\w* \w de um chefe|strong="G758"\w* \w do seu povo|strong="G3588,G2992,G4771"\w*.’”\f + \fr 23.5: \ft Nota cultural: cita Êx 22:28 (22:27 na LXX).\f*\x - \xo 23:5 \xt EXO 22:28; ECC 10:20; JUD 1:8; 2PE 2:10; 2SA 16:9; JOB 34:18\x*
\v 6 \w Paulo|strong="G1161,G3588,G3972"\w*, \w tendo percebido|strong="G1097"\w* \w que|strong="G3754"\w* \w uma parte|strong="G3588,G1520,G3313"\w* \w era|strong="G1510"\w* \w de saduceus|strong="G4523"\w* \w e a outra|strong="G3588,G1161,G2087"\w* \w de fariseus|strong="G5330"\w*, \w gritou|strong="G2896"\w* \w no Sinédrio|strong="G1722,G3588,G4892"\w*: “\w Homens|strong="G435"\w*, \w irmãos|strong="G80"\w*, \w eu|strong="G1473"\w* \w fariseu|strong="G5330"\w* \w sou|strong="G1510"\w*, \w filho de fariseus|strong="G5207,G5330"\w*; \w por causa da esperança|strong="G4012,G1680"\w* \w e|strong="G2532"\w* \w da ressurreição|strong="G386"\w* \w de mortos|strong="G3498"\w* \w eu|strong="G1473"\w* \w sou julgado|strong="G2919"\w*\f + \fr 23.6: \ft Variante: RP lê ἔκραξεν em vez de ἔκραζεν e Φαρισαίου (“de um fariseu”) em vez de Φαρισαίων; WH e Treg omitem ἐγώ (“eu”) diante de Φαρισαῖος.\f*.”\x - \xo 23:6 \xt ACT 24:21; MAT 22:23; ACT 24:15; COL 1:5; ACT 26:5; ACT 4:1\x*
\v 7 \w Falando|strong="G1161,G2980"\w* \w ele|strong="G846"\w* \w isto|strong="G3778"\w*, \w houve|strong="G1096"\w* \w uma dissensão|strong="G4714"\w* \w entre fariseus|strong="G3588,G5330"\w* \w e|strong="G2532"\w* \w saduceus|strong="G4523"\w*, \w e|strong="G2532"\w* \w se dividiu|strong="G4977"\w* \w a multidão|strong="G3588,G4128"\w*\f + \fr 23.7: \ft Variante: WH lê λαλοῦντος; NA28 e Treg leem εἰπόντος; RP lê λαλήσαντος (todos “ao dizer ele”); RP omite “e saduceus”.\f*.\x - \xo 23:7 \xt ACT 14:4; MAT 16:1; ACT 4:1; LUK 20:27; MAT 22:23; JHN 10:19\x*
\v 8 \w Pois os saduceus|strong="G4523,G3303,G1063"\w* \w dizem|strong="G3004"\w* \w que não existe|strong="G3361,G1511"\w* \w ressurreição|strong="G386"\w* \w nem|strong="G3383"\w* \w anjo|strong="G32"\w* \w nem|strong="G3383"\w* \w espírito|strong="G4151"\w*, \w mas os fariseus|strong="G5330,G1161"\w* \w afirmam|strong="G3670"\w* \w ambas as coisas|strong="G3588,G297"\w*.\x - \xo 23:8 \xt MAT 22:23; MRK 12:18; LUK 20:27; 1CO 15:12; ACT 4:1; JHN 1:24\x*
\v 9 \w Houve|strong="G1096,G1161"\w* \w um grande|strong="G3173"\w* \w clamor|strong="G2906"\w*, \w e|strong="G2532"\w*, \w levantando-se|strong="G450"\w* \w alguns|strong="G5100"\w* \w dos escribas|strong="G3588,G1122"\w* \w da parte|strong="G3588,G3313"\w* \w dos fariseus|strong="G3588,G5330"\w*, \w discutiam com veemência|strong="G1264"\w*, \w dizendo|strong="G3004"\w*: “\w Nenhum mal|strong="G3762,G2556"\w* \w achamos|strong="G2147"\w* \w neste homem|strong="G1722,G3588,G444,G3778"\w*; \w mas se|strong="G1487,G1161"\w* \w um espírito|strong="G4151"\w* \w lhe falou|strong="G2980,G846"\w* \w ou|strong="G2228"\w* \w um anjo|strong="G32"\w*\f + \fr 23.9: \ft Variante: RP lê οἱ γραμματεῖς (“os escribas”, sem “alguns”) e acrescenta μὴ θεομαχῶμεν (“não lutemos contra Deus”) depois de “um anjo”.\f*—”\x - \xo 23:9 \xt PSA 35:1; ACT 5:39; ACT 4:1; EPH 3:3; 2TI 2:24; ACT 22:17-18\x*
\v 10 \w Havendo|strong="G1161,G1096"\w* \w grande|strong="G4183"\w* \w dissensão|strong="G4714"\w*, \w o comandante|strong="G3588,G5506"\w*, \w temendo|strong="G5399"\w* \w que|strong="G3361"\w* \w Paulo|strong="G3588,G3972"\w* \w fosse despedaçado|strong="G1288"\w* \w por eles|strong="G5259,G846"\w*, \w mandou|strong="G2753"\w* \w a tropa|strong="G3588,G4753"\w*, \w descendo|strong="G2597"\w*, \w arrebatá-lo|strong="G726,G846"\w* \w do meio|strong="G1537,G3319"\w* \w deles|strong="G846"\w*, \w e|strong="G5037"\w* \w levá-lo|strong="G71"\w* \w para a fortaleza|strong="G1519,G3588,G3925"\w*.\x - \xo 23:10 \xt ACT 21:34; ACT 23:16; MAT 27:23; ACT 22:24; ACT 26:17; JAS 1:19\x*
\v 11 \w Na noite seguinte|strong="G3588,G1161,G1966,G3571"\w*, \w tendo-se apresentado|strong="G2186"\w* \w a ele|strong="G846"\w* \w o Senhor|strong="G3588,G2962"\w*, \w disse|strong="G2036"\w*: “\w Tenha ânimo|strong="G2293"\w*, \w pois|strong="G1063"\w* \w como|strong="G5613"\w* \w testemunhou|strong="G1263"\w* \w as coisas|strong="G3588"\w* \w a meu respeito|strong="G4012,G1473"\w* \w em Jerusalém|strong="G1519,G2419"\w*, \w assim|strong="G3779"\w* \w é necessário|strong="G1163"\w* \w que você|strong="G4771"\w* \w também|strong="G2532"\w* \w em Roma|strong="G1519,G4516"\w* \w testemunhe|strong="G3140"\w*.”\x - \xo 23:11 \xt JHN 16:33; MAT 14:27; ACT 18:9; 2TI 4:17; ACT 27:24; ACT 27:23\x*
\v 12 \w Ao amanhecer|strong="G1096,G1161,G2250"\w*, \w os judeus|strong="G3588,G2453"\w*, \w tendo feito|strong="G4160"\w* \w uma conspiração|strong="G4963"\w*, \w se puseram sob maldição|strong="G332,G1438"\w*, \w dizendo|strong="G3004"\w* \w que nem|strong="G3383"\w* \w comeriam|strong="G5315"\w* \w nem|strong="G3383"\w* \w beberiam|strong="G4095"\w* \w até que|strong="G2193,G3739"\w* \w matassem|strong="G615"\w* \w Paulo|strong="G3588,G3972"\w*.\x - \xo 23:12 \xt ACT 23:21; ACT 23:14; JOB 5:12; ACT 23:30; ISA 8:9-10; PSA 2:1-3\x*
