\v 51 \w Mas eles|strong="G3588,G1161"\w*, \w sacudindo|strong="G1621"\w* \w o pó|strong="G3588,G2868"\w* \w dos pés|strong="G3588,G4228"\w* \w contra eles|strong="G1909,G846"\w*, \w foram|strong="G2064"\w* \w a Icônio|strong="G1519,G2430"\w*,\x - \xo 13:51 \xt MAT 10:14; LUK 9:5; LUK 10:11; ACT 18:6; ACT 14:19; ACT 14:1\x*
\v 52 \w e os discípulos|strong="G3588,G5037,G3101"\w* \w estavam cheios|strong="G4137"\w* \w de alegria|strong="G5479"\w* \w e|strong="G2532"\w* \w de Espírito Santo|strong="G4151,G40"\w*.\x - \xo 13:52 \xt JHN 15:11; ROM 15:13; JHN 17:13; 1JN 1:4; ROM 14:17; 1TH 1:6\x*
\c 14
\p
\v 1 \w Aconteceu|strong="G1096,G1161"\w* \w em Icônio|strong="G1722,G2430"\w* \add que,\add* \w juntos|strong="G2596,G3588,G846"\w*, \w entraram|strong="G1525,G846"\w* \w na sinagoga|strong="G1519,G3588,G4864"\w* \w dos judeus|strong="G3588,G2453"\w* \w e|strong="G2532"\w* \w falaram|strong="G2980"\w* \w de tal modo|strong="G3779,G5620"\w* \add que\add* \w creu|strong="G4100"\w* \w uma grande|strong="G4183"\w* \w multidão|strong="G4128"\w* \w tanto de judeus|strong="G2453,G5037"\w* \w como de gregos|strong="G2532,G1672"\w*.\f + \fr 14.1: \ft Acréscimo: “que” (em “em Icônio que juntos entraram”), “que” (em “tal modo que creu uma”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 14:1 \xt ACT 18:4; ROM 1:16; ACT 17:4; LUK 12:52; ACT 13:46; ACT 13:51\x*
\v 2 \w Mas os judeus|strong="G3588,G1161,G2453"\w* \w que se recusaram a crer|strong="G544"\w* \w incitaram|strong="G1892"\w* \w e|strong="G2532"\w* \w irritaram|strong="G2559"\w* \w as almas|strong="G3588,G5590"\w* \w dos gentios|strong="G3588,G1484"\w* \w contra os irmãos|strong="G2596,G3588,G80"\w*\f + \fr 14.2: \ft Lit.: ἀπειθέω: “não obedecer”, “não se deixar persuadir”; ψυχή: “alma”, “vida”, “pessoa”.\f*.\x - \xo 14:2 \xt MAT 10:34; ACT 13:50; ACT 13:45; ACT 14:19; ACT 17:5; ACT 21:27\x*
\v 3 \w Por bastante|strong="G2425"\w* \w tempo|strong="G5550"\w*, \w então|strong="G3303,G3767"\w*, \w permaneceram|strong="G1304"\w* \w falando com ousadia|strong="G3955"\w* \w no Senhor|strong="G1909,G3588,G2962"\w*, \w que dava testemunho|strong="G3588,G3140"\w* \w à palavra|strong="G3588,G3056"\w* \w da graça|strong="G3588,G5485"\w* \w dele|strong="G846"\w*, \w concedendo que|strong="G1325"\w* \w sinais|strong="G4592"\w* \w e|strong="G2532"\w* \w prodígios|strong="G5059"\w* \w acontecessem|strong="G1096"\w* \w por meio das mãos|strong="G1223,G3588,G5495"\w* \w deles|strong="G846"\w*.\x - \xo 14:3 \xt JHN 4:48; PRO 28:1; MRK 16:20; HEB 2:4; ACT 20:24; ACT 4:29\x*
\v 4 \w Mas se dividiu|strong="G4977,G1161"\w* \w a multidão|strong="G3588,G4128"\w* \w da cidade|strong="G3588,G4172"\w*, \w e|strong="G2532"\w* \w uns|strong="G3588,G3303"\w* \w estavam|strong="G1510"\w* \w com os judeus|strong="G4862,G3588,G2453"\w*, \w outros|strong="G3588,G1161"\w* \w com os apóstolos|strong="G4862,G3588,G652"\w*.\x - \xo 14:4 \xt ACT 23:7; MAT 10:34; ACT 28:24; LUK 12:52; ACT 17:4; ACT 19:9\x*
\v 5 \w Mas quando|strong="G5613,G1161"\w* \w houve|strong="G1096"\w* \w um ímpeto|strong="G3730"\w* \w tanto dos gentios|strong="G3588,G1484,G5037"\w* \w como dos judeus|strong="G2532,G2453"\w*, \w com os seus|strong="G4862,G3588,G846"\w* \w chefes|strong="G758"\w*, \w para maltratar|strong="G5195"\w* \w e|strong="G2532"\w* \w apedrejar|strong="G3036"\w* \w a eles|strong="G846"\w*,\x - \xo 14:5 \xt ACT 14:19; LUK 6:28; 2CO 11:26; 2TI 3:11; 1TH 2:16; 2TI 1:12\x*
\v 6 \w tendo percebido|strong="G4894"\w*, \w fugiram|strong="G2703"\w* \w para as cidades|strong="G1519,G3588,G4172"\w* \w da Licaônia|strong="G3588,G3071"\w*, \w Listra|strong="G3082"\w* \w e|strong="G2532"\w* \w Derbe|strong="G1191"\w* \w e|strong="G2532"\w* \w a região vizinha|strong="G3588,G4066"\w*,\x - \xo 14:6 \xt ACT 16:1; 2TI 3:11; ACT 15:36; 2TI 1:12; ACT 20:4; 2CO 12:2\x*
\v 7 \w e ali|strong="G1563,G2532"\w* \w estavam anunciando a boa notícia|strong="G2097,G1510"\w*.\x - \xo 14:7 \xt ACT 14:21; ACT 8:4; 1TH 2:2; 2TI 4:2; ACT 14:15; ACT 16:10\x*
\p
\v 8 \w E|strong="G2532"\w* \w em Listra|strong="G1722,G3082"\w* \w estava sentado|strong="G2521"\w* \w um certo|strong="G5100"\w* \w homem|strong="G435"\w* \w sem força|strong="G102"\w* \w nos pés|strong="G3588,G4228"\w*, \w coxo|strong="G5560"\w* \w desde o ventre|strong="G1537,G2836"\w* \w de sua mãe|strong="G3384,G846"\w*, \w que nunca|strong="G3739,G3763"\w* \w tinha andado|strong="G4043"\w*.\x - \xo 14:8 \xt ACT 3:2; MAT 9:5; JHN 5:5; ACT 8:7; LUK 7:22; MRK 16:20\x*
\v 9 \w Este|strong="G3778"\w* \w ouviu|strong="G191"\w* \w a Paulo|strong="G3588,G3972"\w* \w falando|strong="G2980"\w*; \w o qual|strong="G3739"\w*, \w fixando os olhos|strong="G816"\w* \w nele|strong="G846"\w* \w e|strong="G2532"\w* \w vendo|strong="G1492"\w* \w que|strong="G3754"\w* \w tinha|strong="G2192"\w* \w fé|strong="G4102"\w* \w para ser curado|strong="G3588,G4982"\w*\f + \fr 14.9: \ft Lit.: σῴζω: “salvar”, “curar”, “livrar”; aqui o contexto é o da cura, mas o verbo é o mesmo usado para a salvação.\f*,\x - \xo 14:9 \xt LUK 8:48; ACT 13:9; MRK 9:23; MAT 9:5; ACT 3:16; MRK 5:34\x*
