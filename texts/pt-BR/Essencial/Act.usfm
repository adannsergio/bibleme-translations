\v 14 \w e|strong="G2532"\w*, \w reconhecendo|strong="G1921"\w* \w a voz|strong="G3588,G5456"\w* \w de Pedro|strong="G3588,G4074"\w*, \w de alegria|strong="G575,G3588,G5479"\w* \w não abriu|strong="G3756,G455"\w* \w o pórtico|strong="G3588,G4440"\w*; \w mas|strong="G1161"\w* \w correndo para dentro|strong="G1532"\w*, \w anunciou|strong="G518"\w* \w que Pedro|strong="G3588,G4074"\w* \w estava|strong="G2476"\w* \w diante do pórtico|strong="G4253,G3588,G4440"\w*.\x - \xo 12:14 \xt ISA 65:24; PSA 68:6; LUK 24:41; PSA 126:1; PSA 10:17; PSA 102:2\x*
\v 15 \w Mas eles|strong="G3588,G1161"\w* \w lhe disseram|strong="G4314,G846,G2036"\w*: “\w Você está louca|strong="G3105"\w*.” \w Mas ela|strong="G3588,G1161"\w* \w insistia|strong="G1340"\w* \w que era assim|strong="G3779,G2192"\w*. \w Mas eles|strong="G3588,G1161"\w* \w diziam|strong="G3004"\w*: “\w É o anjo|strong="G3588,G32,G1510"\w* \w dele|strong="G846"\w*.”\x - \xo 12:15 \xt ISA 65:24; PSA 68:6; MAT 18:10; PSA 126:1; PSA 10:17; PSA 102:2\x*
