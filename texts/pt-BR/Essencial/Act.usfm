\v 22 \w Mas o povo|strong="G3588,G1161,G1218"\w* \w gritava|strong="G2019"\w*: “\w Voz|strong="G5456"\w* \w de um deus|strong="G2316"\w* \w e|strong="G2532"\w* \w não de um homem|strong="G3756,G444"\w*!”\x - \xo 12:22 \xt JER 9:23; PSA 68:6; PSA 138:6; GEN 3:5; ACT 14:10-13; 1CO 4:7\x*
\v 23 \w E imediatamente|strong="G3916,G1161"\w* \w o feriu|strong="G3960,G846"\w* \w um anjo|strong="G32"\w* \w do Senhor|strong="G2962"\w*, \w porque|strong="G473,G3739"\w* \w não deu|strong="G3756,G1325"\w* \w a glória|strong="G3588,G1391"\w* \w a Deus|strong="G3588,G2316"\w*; \w e|strong="G2532"\w*, \w tornando-se|strong="G1096"\w* \w comido por vermes|strong="G4662"\w*, \w expirou|strong="G1634"\w*.\x - \xo 12:23 \xt PRO 29:23; HEB 1:14; JER 9:23; ACT 10:25-26; PSA 115:1; ECC 7:17\x*
\v 24 \w Mas a palavra|strong="G3588,G1161,G3056"\w* \w de Deus|strong="G3588,G2316"\w* \w crescia|strong="G837"\w* \w e|strong="G2532"\w* \w se multiplicava|strong="G4129"\w*.\f + \fr 12.24: \ft Variante: WH lê κυρίου (“do Senhor”) em vez de θεοῦ (“de Deus”).\f*\x - \xo 12:24 \xt ACT 6:7; ACT 7:17; ACT 19:20; PSA 68:6; 2TH 3:1; PRO 28:28\x*
\v 25 \w Mas Barnabé|strong="G921,G1161"\w* \w e|strong="G2532"\w* \w Saulo|strong="G4569"\w* \w voltaram|strong="G5290"\w* \w a Jerusalém|strong="G1519,G2419"\w*, \w tendo cumprido|strong="G4137"\w* \w o serviço|strong="G3588,G1248"\w*, \w levando consigo|strong="G4838"\w* \w João|strong="G2491"\w*, \w chamado|strong="G3588,G1941"\w* \w Marcos|strong="G3138"\w*.\f + \fr 12.25: \ft Variante: SBLGNT, WH, RP e NA28 leem εἰς (“a”); Treg lê ἐξ (“de”) e a NIV ἀπὸ; RP acrescenta καὶ depois de συμπαραλαβόντες.\f*\x - \xo 12:25 \xt ACT 15:37; ACT 11:30; PSA 68:6; ACT 12:12; 2TI 4:11; 1PE 5:13\x*
\c 13
\p
\v 1 \w Ora, havia|strong="G1510,G1161"\w* \w em Antioquia|strong="G1722,G490"\w*, \w na comunidade|strong="G2596,G3588,G1577"\w* \add que\add* \w existia|strong="G1510"\w*, \w profetas|strong="G4396"\w* \w e|strong="G2532"\w* \w mestres|strong="G1320"\w*: \w Barnabé|strong="G3588,G5037,G921"\w*, \w e|strong="G2532"\w* \w Simeão|strong="G4826"\w*, \w chamado|strong="G3588,G2564"\w* \w Níger|strong="G3526"\w*, \w e|strong="G2532"\w* \w Lúcio|strong="G3066"\w*, \w o cireneu|strong="G3588,G2956"\w*, \w e|strong="G5037"\w* \w Manaém|strong="G3127"\w*, \w que fora criado junto|strong="G4939"\w* \w com Herodes|strong="G2264"\w*, \w o tetrarca|strong="G3588,G5076"\w*, \w e|strong="G2532"\w* \w Saulo|strong="G4569"\w*.\f + \fr 13.1: \ft Acréscimo: “que” (em “na comunidade que existia profetas”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 13:1 \xt MAT 14:1; ACT 4:36; EPH 4:11; ACT 15:35; ACT 11:22; ACT 11:27\x*
\v 2 \w Enquanto eles|strong="G1161,G846"\w* \w serviam|strong="G3008"\w* \w ao Senhor|strong="G3588,G2962"\w* \w e|strong="G2532"\w* \w jejuavam|strong="G3522"\w*, \w disse|strong="G2036"\w* \w o Espírito|strong="G3588,G4151"\w* \w Santo|strong="G3588,G40"\w*: “\w Separem|strong="G873,G1211"\w* \w para mim|strong="G3165"\w* \w Barnabé|strong="G3588,G921"\w* \w e|strong="G2532"\w* \w Saulo|strong="G4569"\w* \w para a obra|strong="G1519,G3588,G2041"\w* \w para a qual|strong="G3739"\w* \w os chamei|strong="G4341,G846"\w*\f + \fr 13.2: \ft Lit.: λειτουργέω: “servir”, “prestar serviço público ou cultual”.\f*.”\x - \xo 13:2 \xt JHN 14:26; ACT 20:28; GAL 1:15; MAT 9:38; ACT 9:15; ECC 4:9\x*
\v 3 \w Então|strong="G5119"\w*, \w tendo jejuado|strong="G3522"\w* \w e|strong="G2532"\w* \w orado|strong="G4336"\w* \w e|strong="G2532"\w* \w imposto|strong="G2007"\w* \w as mãos|strong="G3588,G5495"\w* \w sobre eles|strong="G846"\w*, \w os despediram|strong="G630"\w*.\x - \xo 13:3 \xt ACT 6:6; ACT 8:17; MAT 19:13; 2TI 2:2; ACT 14:26; LUK 2:37\x*
\v 4 \w Eles|strong="G846"\w*, \w então|strong="G3767"\w*, \w enviados|strong="G1599"\w* \w pelo Espírito Santo|strong="G5259,G3588,G40,G4151"\w*, \w desceram|strong="G2718"\w* \w a Selêucia|strong="G1519,G4581"\w*, \w e|strong="G5037"\w* \w dali|strong="G1564"\w* \w navegaram|strong="G636"\w* \w para Chipre|strong="G1519,G2954"\w*,\x - \xo 13:4 \xt ACT 15:36; JHN 14:26; ROM 10:15; ACT 4:36; ACT 13:2; ACT 16:6\x*
