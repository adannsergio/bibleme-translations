\v 11 \w E|strong="G2532"\w* \w veio|strong="G1096"\w* \w grande|strong="G3173"\w* \w temor|strong="G5401"\w* \w sobre toda|strong="G1909,G3650"\w* \w a comunidade|strong="G3588,G1577"\w* \w e|strong="G2532"\w* \w sobre todos|strong="G1909,G3956"\w* \w os que ouviram|strong="G3588,G191"\w* \w estas coisas|strong="G3778"\w*.\x - \xo 5:11 \xt ACT 5:5; LUK 1:65; 1CO 10:11-12; 1TI 5:20; ACT 19:17; HEB 4:1\x*
