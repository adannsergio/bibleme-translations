\v 23 \w dizendo|strong="G3004"\w*: “\w A prisão|strong="G3588,G1201"\w* \w achamos|strong="G2147"\w* \w fechada|strong="G2808"\w* \w com toda|strong="G1722,G3956"\w* \w segurança|strong="G803"\w* \w e|strong="G2532"\w* \w os guardas|strong="G3588,G5441"\w* \w de pé|strong="G2476"\w* \w às portas|strong="G1909,G3588,G2374"\w*, \w mas|strong="G1161"\w* \w ao abrirmos|strong="G455"\w*, \w dentro|strong="G2080"\w* \w a ninguém|strong="G3762"\w* \w achamos|strong="G2147"\w*\f + \fr 5.23: \ft Variante: o RP acrescenta μέν depois de Τό e traz πρό em lugar de ἐπί.\f*.”\x - \xo 5:23 \xt ACT 12:18; PSA 2:4; PSA 33:10\x*
\v 24 \w Quando ouviram|strong="G5613,G1161,G191"\w* \w estas palavras|strong="G3588,G3056,G3778"\w*, \w o comandante|strong="G3588,G5037,G4755"\w* \w do templo|strong="G3588,G2411"\w* \w e|strong="G2532"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w ficaram perplexos|strong="G1280"\w* \w a respeito deles|strong="G4012,G846"\w*, \w sobre o que isto viria a ser|strong="G5101,G302,G1096,G3778"\w*.\f + \fr 5.24: \ft Variante: o RP acrescenta ἱερεὺς καὶ ὁ (“o sacerdote e o”) depois de τε.\f*\x - \xo 5:24 \xt ACT 4:1; LUK 22:4; ACT 5:26; ACT 12:18; ACT 4:17\x*
