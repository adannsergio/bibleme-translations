\v 19 \w E|strong="G2532"\w* \w tornou-se|strong="G1096"\w* \w conhecido|strong="G1110"\w* \w de todos|strong="G3956"\w* \w os que habitam|strong="G3588,G2730"\w* \w Jerusalém|strong="G2419"\w*, \w de modo que|strong="G5620"\w* \w aquele|strong="G1565"\w* \w campo|strong="G3588,G5564"\w* \w foi chamado|strong="G2564"\w* \w na própria|strong="G3588,G2398"\w* \w língua|strong="G1258"\w* \w deles|strong="G846"\w* \w Acéldama|strong="G184"\w*, \w isto é|strong="G3778,G1510"\w*, \w Campo|strong="G5564"\w* \w de Sangue|strong="G129"\w*.—\x - \xo 1:19 \xt JHN 17:12; 1TI 6:10; 1TI 3:16; PSA 109:8; PSA 55:15; ZEC 11:13\x*
