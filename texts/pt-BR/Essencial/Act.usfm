\v 1 \w E|strong="G2532"\w*, \w tendo-nos salvado|strong="G1295"\w*, \w então|strong="G5119"\w* \w reconhecemos|strong="G1921"\w* \w que|strong="G3754"\w* \w a ilha|strong="G3588,G3520"\w* \w se chama|strong="G2564"\w* \w Malta|strong="G3194"\w*.\f + \fr 28.1: \ft Variante: RP lê ἐπέγνωσαν (“reconheceram”, terceira pessoa); WH lê Μελιτήνη onde Treg, NA28 e RP leem Μελίτη.\f*\x - \xo 28:1 \xt ACT 27:26; PHP 1:12; ACT 27:44; ACT 27:39\x*
\v 2 \w E os bárbaros|strong="G3588,G5037,G915"\w* \w nos prestaram|strong="G3930,G3165"\w* \w não comum|strong="G3756,G3588,G5177"\w* \w bondade|strong="G5363"\w*, \w pois|strong="G1063"\w*, \w tendo acendido|strong="G681"\w* \w uma fogueira|strong="G4443"\w*, \w acolheram|strong="G4355"\w* \w a todos nós|strong="G3956,G3165"\w* \w por causa da chuva|strong="G1223,G3588,G5205"\w* \w que caía|strong="G3588,G2186"\w* \w e|strong="G2532"\w* \w por causa do frio|strong="G1223,G3588,G5592"\w*.\f + \fr 28.2: \ft Lit.: βάρβαρος: quem não fala grego; aqui, os habitantes locais, sem necessariamente sentido pejorativo.\f*\x - \xo 28:2 \xt EPH 4:32; COL 3:11; HEB 13:2; PHP 1:12; ROM 1:14; 1CO 14:11\x*
\v 3 \w Tendo Paulo|strong="G1161,G3588,G3972"\w* \w juntado|strong="G4962"\w* \w uma quantidade|strong="G5100,G4128"\w* \w de gravetos|strong="G5434"\w* \w e|strong="G2532"\w* \w colocado|strong="G2007"\w* \w sobre a fogueira|strong="G1909,G3588,G4443"\w*, \w uma víbora|strong="G2191"\w*, \w saindo|strong="G1831"\w* \w do calor|strong="G575,G3588,G2329"\w*, \w prendeu-se|strong="G2510"\w* \w à mão|strong="G3588,G5495"\w* \w dele|strong="G846"\w*.\x - \xo 28:3 \xt MRK 16:18; PSA 91:13; MAT 23:33; PHP 1:12; GEN 3:15; JOB 20:16\x*
\v 4 \w Quando|strong="G5613,G1161"\w* \w viram|strong="G1492"\w* \w os bárbaros|strong="G3588,G915"\w* \w pendendo|strong="G2910"\w* \w o animal|strong="G3588,G2342"\w* \w da mão|strong="G1537,G3588,G5495"\w* \w dele|strong="G846"\w*, \w uns aos outros|strong="G4314,G240"\w* \w diziam|strong="G3004"\w*: “\w Certamente|strong="G3843"\w* \w assassino|strong="G5406"\w* \w é|strong="G1510"\w* \w este homem|strong="G3588,G444,G3778"\w*, \w a quem|strong="G3739"\w*, \w salvo|strong="G1295"\w* \w do mar|strong="G1537,G3588,G2281"\w*, \w a Justiça|strong="G3588,G1349"\w* \w não deixou|strong="G3756,G1439"\w* \w viver|strong="G2198"\w*\f + \fr 28.4: \ft Nota cultural: ἡ δίκη: “a Justiça”, aqui provavelmente personificada como divindade.\f*.”\x - \xo 28:4 \xt MRK 16:18; PSA 91:13; LUK 13:2; JOB 4:7; LUK 13:4; PHP 1:12\x*
\v 5 \w Ele, então|strong="G3588,G3303,G3767"\w*, \w tendo sacudido|strong="G660"\w* \w o animal|strong="G3588,G2342"\w* \w no fogo|strong="G1519,G3588,G4442"\w*, \w não sofreu|strong="G3958"\w* \w nenhum|strong="G3762"\w* \w mal|strong="G2556"\w*;\x - \xo 28:5 \xt LUK 10:19; MRK 16:18; PSA 91:13; DAN 3:25; PHP 1:12; GEN 3:15\x*
\v 6 \w Mas eles|strong="G3588,G1161"\w* \w esperavam|strong="G4328"\w* \w que ele|strong="G846"\w* \w estivesse para|strong="G3195"\w* \w inchar|strong="G4092"\w* \w ou|strong="G2228"\w* \w cair|strong="G2667"\w* \w de repente|strong="G869"\w* \w morto|strong="G3498"\w*. \w Por muito tempo|strong="G1909,G4183,G1161"\w* \w esperando eles|strong="G846,G4328"\w* \w e|strong="G2532"\w* \add não\add* \w vendo|strong="G2334"\w* \w nada|strong="G3367"\w* \w anormal|strong="G824"\w* \w acontecer|strong="G1096"\w* \w com ele|strong="G1519,G846"\w*, \w mudando de ideia|strong="G3328"\w*, \w diziam|strong="G3004"\w* \w que ele|strong="G846"\w* \w era|strong="G1511"\w* \w um deus|strong="G2316"\w*.\f + \fr 28.6: \ft Acréscimo: “não” (em “eles e não vendo nada”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 28:6 \xt MRK 16:18; PSA 91:13; ACT 14:11; PHP 1:12; GEN 3:15; ACT 12:22\x*
\v 7 \w Nos arredores|strong="G1722,G1161,G3588,G4012"\w* \w daquele lugar|strong="G5117,G1565"\w* \w havia|strong="G5225"\w* \w propriedades|strong="G5564"\w* \w do principal|strong="G3588,G4413"\w* \w da ilha|strong="G3588,G3520"\w*, \w de nome|strong="G3686"\w* \w Públio|strong="G4196"\w*, \w o qual|strong="G3739"\w*, \w tendo-nos acolhido|strong="G324,G3165"\w*, \w por três|strong="G5140"\w* \w dias|strong="G2250"\w*, \w amigavelmente|strong="G5390"\w* \w nos hospedou|strong="G3579"\w*.\x - \xo 28:7 \xt 1PE 3:8; PHP 1:12; LUK 10:9; MAT 10:40-41\x*
\v 8 \w Aconteceu|strong="G1096,G1161"\w* \w que o pai|strong="G3588,G3962"\w* \w de Públio|strong="G3588,G4196"\w*, \w acometido|strong="G4912"\w* \w de febres|strong="G4446"\w* \w e|strong="G2532"\w* \w disenteria|strong="G1420"\w*, \w estava deitado|strong="G2621"\w*; \w junto a quem|strong="G4314,G3739"\w* \w Paulo|strong="G3588,G3972"\w*, \w tendo entrado|strong="G1525"\w* \w e|strong="G2532"\w* \w orado|strong="G4336"\w*, \w impondo|strong="G2007"\w* \w as mãos|strong="G3588,G5495"\w* \w sobre ele|strong="G846"\w*, \w o curou|strong="G2390,G846"\w*.\x - \xo 28:8 \xt MRK 16:18; JAS 5:14; ACT 9:40; MRK 6:5; MAT 25:36; MAT 9:18\x*
\v 9 \w Tendo acontecido isto|strong="G3778,G1161,G1096"\w*, \w também|strong="G2532"\w* \w os demais|strong="G3588,G3062"\w* \w da ilha|strong="G3588,G1722,G3520"\w* \add que\add* \w tinham|strong="G2192"\w* \w doenças|strong="G769"\w* \w vinham|strong="G4334"\w* \w e|strong="G2532"\w* \w eram curados|strong="G2323"\w*,\f + \fr 28.9: \ft Acréscimo: “que” (em “da ilha que tinham doenças”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 28:9 \xt MRK 16:18; MAT 25:36; PHP 1:12; EST 6:3; LUK 10:9; ACT 5:12\x*
\v 10 \w os quais|strong="G3739"\w* \w também|strong="G2532"\w* \w com muitas|strong="G4183"\w* \w honras|strong="G5092"\w* \w nos honraram|strong="G5091,G3165"\w* \w e|strong="G2532"\w*, \w ao zarparmos|strong="G321"\w*, \w nos providenciaram|strong="G2007"\w* \w o necessário|strong="G3588,G4314,G5532"\w*.\x - \xo 28:10 \xt 1TI 5:17; PHP 1:12; 1TH 2:6; EST 6:3; LUK 10:9; MAT 6:31-34\x*
\v 11 \w Depois|strong="G3326,G1161"\w* \w de três meses|strong="G5140,G3376"\w* \w zarpamos|strong="G321"\w* \w num navio|strong="G1722,G4143"\w* \w que tinha passado o inverno|strong="G3914"\w* \w na ilha|strong="G1722,G3588,G3520"\w*, \w alexandrino|strong="G222"\w*, \w com a insígnia|strong="G3902"\w* \w dos Dióscuros|strong="G1359"\w*\f + \fr 28.11: \ft Nota cultural: Dióscuros: Cástor e Pólux, divindades gregas protetoras dos navegantes.\f*.\x - \xo 28:11 \xt ACT 27:6; PHP 1:12; 1CO 16:6\x*
\v 12 \w E|strong="G2532"\w*, \w tendo chegado|strong="G2609"\w* \w a Siracusa|strong="G1519,G4946"\w*, \w ficamos|strong="G1961"\w* \w três|strong="G5140"\w* \w dias|strong="G2250"\w*,\x - \xo 28:12 \xt PHP 1:12; GAL 1:18; ACT 21:7\x*
\v 13 \w de onde|strong="G3606"\w*, \w tendo contornado|strong="G4014"\w*, \w chegamos|strong="G2658"\w* \w a Régio|strong="G1519,G4484"\w*. \w E|strong="G2532"\w* \w depois de|strong="G3326"\w* \w um|strong="G1520"\w* \w dia|strong="G2250"\w*, \w soprando|strong="G1920"\w* \w o vento sul|strong="G3558"\w*, \w no segundo dia|strong="G1206"\w* \w chegamos|strong="G2064"\w* \w a Putéoli|strong="G1519,G4223"\w*,\f + \fr 28.13: \ft Variante: WH e NA28 leem περιελόντες (“tendo contornado”); Treg e RP leem περιελθόντες (“tendo dado a volta”).\f*\x - \xo 28:13 \xt PHP 1:12; JOB 9:9; ACT 27:13\x*
\v 14 \w onde|strong="G3757"\w*, \w tendo encontrado|strong="G2147"\w* \w irmãos|strong="G80"\w*, \w fomos rogados|strong="G3870"\w* \w a ficar|strong="G1961"\w* \w com eles|strong="G3844,G846"\w* \w sete|strong="G2033"\w* \w dias|strong="G2250"\w*; \w e|strong="G2532"\w* \w assim|strong="G3779"\w* \w a Roma|strong="G1519,G3588,G4516"\w* \w chegamos|strong="G2064"\w*.\x - \xo 28:14 \xt PHP 1:12; 2TI 1:17; ROM 1:15\x*
\v 15 \w E dali|strong="G1564,G2532"\w*, \w os irmãos|strong="G3588,G80"\w*, \w tendo ouvido|strong="G191"\w* \w as notícias|strong="G3588"\w* \w a nosso respeito|strong="G4012,G3165"\w*, \w vieram|strong="G2064"\w* \w ao nosso encontro|strong="G1519,G529,G3165"\w* \w até|strong="G891"\w* \w o Foro de Ápio|strong="G675,G5410"\w* \w e|strong="G2532"\w* \w as Três Tabernas|strong="G5140,G4999"\w*. \w Ao vê-los|strong="G3739,G1492"\w*, \w Paulo|strong="G3588,G3972"\w* \w deu graças|strong="G2168"\w* \w a Deus|strong="G3588,G2316"\w* \add e\add* \w tomou|strong="G2983"\w* \w coragem|strong="G2294"\w*.\f + \fr 28.15: \ft Acréscimo: “e” (em “a Deus e tomou coragem”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 28:15 \xt PSA 27:14; HEB 13:3; PHP 1:12; NUM 22:36; ROM 15:24\x*
\v 16 \w Quando|strong="G3753,G1161"\w* \w entramos|strong="G1525"\w* \w em Roma|strong="G1519,G4516"\w*, \w foi permitido|strong="G2010"\w* \w a Paulo|strong="G3588,G3972"\w* \w ficar|strong="G3306"\w* \w por conta própria|strong="G2596,G1438"\w* \w com o soldado|strong="G4862,G3588,G4757"\w* \w que o guardava|strong="G5442,G846"\w*\f + \fr 28.16: \ft Variante: RP lê ἤλθομεν em vez de εἰσήλθομεν e traz uma frase mais longa: “o centurião entregou os prisioneiros ao comandante da guarda, mas a Paulo foi permitido…”.\f*.\x - \xo 28:16 \xt ACT 27:3; ACT 24:23; PHP 1:12; 1SA 23:17; 2TI 4:2; ACT 21:8\x*
\v 17 \w Aconteceu|strong="G1096,G1161"\w* \w que, depois de|strong="G3326"\w* \w três|strong="G5140"\w* \w dias|strong="G2250"\w*, \w ele convocou|strong="G4779,G846"\w* \w os que eram|strong="G3588,G1510"\w* \w os principais|strong="G4413"\w* \w dos judeus|strong="G3588,G2453"\w*; \w reunidos eles|strong="G4905,G1161,G846"\w*, \w lhes dizia|strong="G3004,G4314,G846"\w*: “\w Eu|strong="G1473"\w*, \w homens|strong="G435"\w* \w irmãos|strong="G80"\w*, \w nada|strong="G3762"\w* \w contrário|strong="G1727"\w* \w tendo feito|strong="G4160"\w* \w ao povo|strong="G3588,G2992"\w* \w ou|strong="G2228"\w* \w aos costumes|strong="G3588,G1485"\w* \w dos pais|strong="G3588,G3971"\w*, \w prisioneiro|strong="G1198"\w* \w de Jerusalém|strong="G1537,G2414"\w* \w fui entregue|strong="G3860"\w* \w nas mãos|strong="G1519,G3588,G5495"\w* \w dos romanos|strong="G3588,G4514"\w*\f + \fr 28.17: \ft Variante: RP lê τὸν Παῦλον no lugar de αὐτόν e outra ordem em “eu, homens irmãos”.\f*,\x - \xo 28:17 \xt ACT 25:8; PHP 1:12; ACT 6:14; ACT 22:1; ACT 23:18; ACT 24:12\x*
\v 18 \w os quais|strong="G3748"\w*, \w tendo-me interrogado|strong="G350,G3165"\w*, \w queriam|strong="G1014"\w* \w soltar|strong="G630"\w*, \w porque|strong="G1223,G3588"\w* \w nenhuma|strong="G3367"\w* \w causa|strong="G156"\w* \w de morte|strong="G2288"\w* \w havia|strong="G5225"\w* \w em mim|strong="G1722,G1473"\w*;\x - \xo 28:18 \xt ACT 26:31; ACT 26:32; PHP 1:12; ACT 23:29; ACT 22:24-25; ACT 25:10\x*
\v 19 \w mas objetando|strong="G483,G1161"\w* \w os judeus|strong="G3588,G2453"\w*, \w fui forçado|strong="G315"\w* \w a apelar|strong="G1941"\w* \w a César|strong="G2541"\w*, \w não como se|strong="G3756,G5613"\w* \w tivesse|strong="G2192"\w* \w algo|strong="G5100"\w* \w de acusar|strong="G2723"\w* \w contra a minha nação|strong="G3588,G1484,G3165"\w*.\x - \xo 28:19 \xt ACT 25:11; ACT 26:32; PHP 1:12; ACT 25:10-12; ACT 25:21; ACT 25:25\x*
\v 20 \w Por esta razão|strong="G1223,G3778,G3588,G156"\w*, \w então|strong="G3767"\w*, \w rogei|strong="G3870"\w* \w a vocês|strong="G4771"\w* \w para ver|strong="G1492"\w* \w e|strong="G2532"\w* \w falar com vocês|strong="G4354"\w*; \w pois|strong="G1063"\w* \w por causa da esperança|strong="G1752,G3588,G1680"\w* \w de Israel|strong="G3588,G2474"\w* \w esta corrente|strong="G3588,G254,G3778"\w* \w carrego|strong="G4029"\w*.”\x - \xo 28:20 \xt 2TI 1:16; 2TI 2:9; ACT 26:6; EPH 6:20; PHP 1:12; ACT 21:33\x*
\v 21 \w Eles|strong="G3588,G1161"\w* \w a ele|strong="G4314,G846"\w* \w disseram|strong="G2036"\w*: “\w Nós|strong="G3165"\w* \w nem|strong="G3777"\w* \w cartas|strong="G1121"\w* \w a seu respeito|strong="G4012,G4771"\w* \w recebemos|strong="G1209"\w* \w da Judeia|strong="G575,G3588,G2449"\w*, \w nem|strong="G3777"\w* \w tendo chegado|strong="G3854"\w* \w algum|strong="G5100"\w* \w dos irmãos|strong="G3588,G80"\w* \w relatou|strong="G518"\w* \w ou|strong="G2228"\w* \w falou|strong="G2980"\w* \w algo|strong="G5100"\w* \w a seu respeito|strong="G4012,G4771"\w* \w mau|strong="G4190"\w*.\x - \xo 28:21 \xt PHP 1:12; ACT 25:8; ISA 41:11; ISA 50:8; ISA 54:17; MAT 13:54\x*
\v 22 \w Mas julgamos justo|strong="G515,G1161"\w* \w ouvir|strong="G191"\w* \w de você|strong="G3844,G4771"\w* \w o que|strong="G3739"\w* \w pensa|strong="G5426"\w*; \w pois|strong="G1063"\w* \w a respeito|strong="G4012,G3303"\w* \w desta corrente|strong="G3588,G139,G3778"\w*, \w é conhecido|strong="G1110,G1510"\w* \w a nós|strong="G3165"\w* \w que|strong="G3754"\w* \w em toda parte|strong="G3837"\w* \w se fala contra ela|strong="G483"\w*.”\x - \xo 28:22 \xt ACT 24:5; ACT 17:6; MAT 24:9; 1PE 2:12; ACT 24:14; PHP 1:12\x*
\v 23 \w Tendo marcado|strong="G5021,G1161"\w* \w com ele|strong="G846"\w* \w um dia|strong="G2250"\w*, \w vieram|strong="G2240"\w* \w a ele|strong="G4314,G846"\w* \w ao alojamento|strong="G1519,G3588,G3578"\w* \w mais pessoas|strong="G4119"\w*, \w às quais|strong="G3739"\w* \w expunha|strong="G1620"\w*, \w testemunhando solenemente|strong="G1263"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G5037"\w* \w persuadindo|strong="G3982"\w* \w a elas|strong="G846"\w* \w a respeito de Jesus|strong="G4012,G3588,G2424"\w* \w tanto a partir|strong="G575,G5037"\w* \w da lei|strong="G3588,G3551"\w* \w de Moisés|strong="G3475"\w* \w como|strong="G2532"\w* \w dos Profetas|strong="G3588,G4396"\w*, \w da manhã|strong="G575,G4404"\w* \w até a tarde|strong="G2193,G2073"\w*\f + \fr 28.23: \ft Variante: RP lê ἧκον; WH, Treg e NA28 leem ἦλθον (ambos “vieram”); RP acrescenta τά depois de αὐτούς.\f*.\x - \xo 28:23 \xt JHN 1:17; ACT 28:31; NEH 8:8; HEB 1:1; HEB 3:5; JHN 3:11\x*
\v 24 \w E|strong="G2532"\w* \w uns|strong="G3588,G3303"\w* \w se deixavam persuadir|strong="G3982"\w* \w pelo que era dito|strong="G3588,G3004"\w*, \w outros|strong="G3588,G1161"\w* \w não criam|strong="G569"\w*,\x - \xo 28:24 \xt ACT 14:4; JHN 3:11; PHP 1:12; ROM 11:11; ACT 17:4; ACT 3:26\x*
