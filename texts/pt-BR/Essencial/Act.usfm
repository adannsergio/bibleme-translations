\v 46 \w Falando com franqueza|strong="G3955"\w*, \w Paulo|strong="G3588,G3972"\w* \w e|strong="G2532"\w* \w Barnabé|strong="G3588,G921"\w* \w disseram|strong="G2036,G5037"\w*: “\w A vocês|strong="G4771"\w* \w era necessário|strong="G1510,G316"\w* \w primeiro|strong="G4413"\w* \w que se falasse|strong="G2980"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w*; \w mas já que|strong="G1894"\w* \w a rejeitam|strong="G683,G846"\w* \w e|strong="G2532"\w* \w não se julgam|strong="G3756,G2919,G1438"\w* \w dignos|strong="G514"\w* \w da vida|strong="G3588,G2222"\w* \w eterna|strong="G166"\w*, \w olhem|strong="G2400"\w*, \w nos voltamos|strong="G4762"\w* \w para os gentios|strong="G1519,G3588,G1484"\w*;\x - \xo 13:46 \xt MAT 28:19; MRK 16:16; MAT 7:6; MAT 10:34; MAT 15:24; ACT 28:28\x*
