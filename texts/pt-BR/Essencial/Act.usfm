\v 18 \w Este|strong="G3778"\w*, \w então|strong="G3767"\w*, \w adquiriu|strong="G2932"\w* \w um campo|strong="G5564"\w* \w com o salário|strong="G1537,G3408"\w* \w da injustiça|strong="G3588,G93"\w*, \w e|strong="G2532"\w* \w caindo de cabeça|strong="G4248,G1096"\w*, \w arrebentou-se|strong="G2997"\w* \w pelo meio|strong="G3319"\w*, \w e|strong="G2532"\w* \w se derramaram|strong="G1632"\w* \w todas as|strong="G3956,G3588"\w* \w entranhas|strong="G4698"\w* \w dele|strong="G846"\w*.\f + \fr 1.18: \ft Lit.: πρηνὴς γενόμενος: “tendo ficado de bruços”, “caindo de cabeça”.\f*\x - \xo 1:18 \xt JHN 17:12; MAT 27:3-10; 1TI 6:10; PRO 29:1; PSA 109:8; PSA 55:15\x*
