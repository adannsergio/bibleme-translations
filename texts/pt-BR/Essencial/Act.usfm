\v 7 \w Passado|strong="G1096,G1161"\w* \w um intervalo|strong="G1292"\w* \w de cerca de|strong="G5613"\w* \w três horas|strong="G5610,G5140"\w*, \w e|strong="G2532"\w* \w a mulher|strong="G3588,G1135"\w* \w dele|strong="G846"\w*, \w sem saber|strong="G3361,G6063"\w* \w o que acontecera|strong="G3588,G1096"\w*, \w entrou|strong="G1525"\w*.\x - \xo 5:7 \xt MAL 1:14; MAT 22:12; MAT 13:22; 2KI 1:10; PSA 101:7; 2CO 10:6\x*
