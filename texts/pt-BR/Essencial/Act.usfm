\v 19 \w Mas um anjo|strong="G32,G1161"\w* \w do Senhor|strong="G2962"\w*, \w durante a noite|strong="G1223,G3571"\w*, \w abriu|strong="G455"\w* \w as portas|strong="G3588,G2374"\w* \w da prisão|strong="G3588,G5438"\w* \w e|strong="G5037"\w*, \w tendo-os conduzido para fora|strong="G1806,G846"\w*, \w disse|strong="G2036"\w*:\f + \fr 5.19: \ft Variante: o RP acrescenta τῆς depois de διά; a NA28 traz ἀνοίξας (“tendo aberto”) em lugar de ἤνοιξε.\f*\x - \xo 5:19 \xt ACT 12:7; HEB 1:14; ACT 16:26; MAT 2:13; PSA 69:33; PSA 34:7\x*
\v 20 “\w Vão|strong="G4198"\w* \w e|strong="G2532"\w*, \w de pé|strong="G2476"\w*, \w falem|strong="G2980"\w* \w no templo|strong="G1722,G3588,G2411"\w* \w ao povo|strong="G3588,G2992"\w* \w todas as palavras|strong="G3956,G3588,G4487"\w* \w desta vida|strong="G3588,G2222,G3778"\w*.”\x - \xo 5:20 \xt JHN 6:68; LUK 21:38; JHN 6:63; MAT 10:27; 1JN 5:11-12; EZK 33:7\x*
\v 21 \w Ao ouvirem|strong="G191,G1161"\w*, \w entraram|strong="G1525"\w* \w ao amanhecer|strong="G5259,G3588,G3722"\w* \w no templo|strong="G1519,G3588,G2411"\w* \w e|strong="G2532"\w* \w ensinavam|strong="G1321"\w*. \w Chegando|strong="G3854"\w* \w o sumo sacerdote|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os que estavam com ele|strong="G3588,G4862,G846"\w*, \w convocaram|strong="G4779"\w* \w o Sinédrio|strong="G3588,G4892"\w* \w e|strong="G2532"\w* \w todo|strong="G3956"\w* \w o conselho de anciãos|strong="G3588,G1087"\w* \w dos filhos|strong="G3588,G5207"\w* \w de Israel|strong="G2474"\w*, \w e|strong="G2532"\w* \w enviaram|strong="G649"\w* \w à prisão|strong="G1519,G3588,G1201"\w* \w para que fossem trazidos|strong="G71"\w* \w eles|strong="G846"\w*.\f + \fr 5.21: \ft Lit.: γερουσία: “conselho de anciãos”, “senado”.\f*\f + \fr 5.21: \ft Acréscimo: “os que estavam com ele”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 5:21 \xt JHN 8:2; ACT 2:46; ACT 22:30; ACT 22:5; PSA 58:1\x*
