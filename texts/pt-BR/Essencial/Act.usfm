\v 1 \w Festo|strong="G5347"\w* \w então|strong="G3767"\w*, \w tendo chegado|strong="G1910"\w* \w à província|strong="G3588,G1885"\w*, \w depois de|strong="G3326"\w* \w três dias|strong="G5140,G2250"\w* \w subiu|strong="G305"\w* \w a Jerusalém|strong="G1519,G2414"\w* \w de Cesareia|strong="G575,G2542"\w*,\x - \xo 25:1 \xt ACT 24:27; ACT 23:34; ACT 21:15\x*
\v 2 \w e|strong="G5037"\w* \w apresentaram|strong="G1718"\w* \w a ele|strong="G846"\w* \w os chefes dos sacerdotes|strong="G3588,G749"\w* \w e|strong="G2532"\w* \w os principais|strong="G3588,G4413"\w* \w dos judeus|strong="G3588,G2453"\w* \w queixa contra|strong="G2596,G3588"\w* \w Paulo|strong="G3972"\w*, \w e|strong="G2532"\w* \w rogavam|strong="G3870"\w* \w a ele|strong="G846"\w*\f + \fr 25.2: \ft Variante: RP lê δέ em vez de τε e ὁ ἀρχιερεύς (“o sumo sacerdote”, singular).\f*\x - \xo 25:2 \xt ACT 25:15; ACT 24:1; PRO 4:16; ROM 3:12-19; ACT 25:24; JER 26:11\x*
\v 3 \w pedindo|strong="G154"\w* \w um favor|strong="G5485"\w* \w contra ele|strong="G2596,G846"\w*, \w para que mandasse chamá-lo|strong="G3704,G3343,G846"\w* \w a Jerusalém|strong="G1519,G2419"\w*, \w preparando|strong="G4160"\w* \w uma emboscada|strong="G1747"\w* \w para matá-lo|strong="G337,G846"\w* \w no caminho|strong="G2596,G3588,G3598"\w*.\f + \fr 25.3: \ft Tradução: χάριν (χάρις, G5485) está aqui como “um favor”; o termo pode ser “graça”, “favor”, “gratidão” ou “mérito”, e o contexto decide.\f*\x - \xo 25:3 \xt ACT 23:12; PSA 64:2; 2CO 11:26; ACT 20:3; ACT 9:24; PSA 119:95\x*
\v 4 \w Festo, então|strong="G3588,G3303,G3767,G5347"\w*, \w respondeu|strong="G611"\w* \w que Paulo|strong="G3588,G3972"\w* \w estava sendo guardado|strong="G5083"\w* \w em Cesareia|strong="G1519,G2542"\w*, \w e que ele mesmo|strong="G1438,G1161"\w* \w estava para|strong="G3195"\w* \w partir|strong="G1607"\w* \w em breve|strong="G1722,G5034"\w*;\x - \xo 25:4 \xt ACT 8:40; ACT 25:16; JER 26:11\x*
\v 5 “\w Aqueles, portanto|strong="G3588,G3767"\w*, \w entre vocês|strong="G1722,G4771"\w*, \w diz|strong="G5346"\w*, \w que têm influência|strong="G1415"\w*, \w descendo comigo|strong="G4782"\w*, \w se algo|strong="G1487,G5100"\w* \w há|strong="G1510"\w* \w de impróprio|strong="G824"\w* \w neste homem|strong="G1722,G3588,G435"\w*, \w acusem|strong="G2723"\w* \w a ele|strong="G846"\w*.”\x - \xo 25:5 \xt ACT 23:30; ACT 25:16; ACT 25:18-19; ACT 25:25; JER 26:11; JHN 18:29-30\x*
\v 6 \w Tendo permanecido|strong="G1304,G1161"\w* \w entre eles|strong="G1722,G846"\w* \w dias|strong="G2250"\w* \w não mais de|strong="G3756,G4183"\w* \w oito|strong="G3638"\w* \w ou|strong="G2228"\w* \w dez|strong="G1176"\w*, \w tendo descido|strong="G2597"\w* \w a Cesareia|strong="G1519,G2542"\w*, \w no dia seguinte|strong="G3588,G1887"\w*, \w tendo-se sentado|strong="G2523"\w* \w no tribunal|strong="G1909,G3588,G968"\w*, \w mandou|strong="G2753"\w* \w que Paulo|strong="G3588,G3972"\w* \w fosse trazido|strong="G71"\w*\f + \fr 25.6: \ft Variante: A leitura “não mais de oito ou dez dias” varia: SBLGNT, WH, Treg e NA28 leem οὐ πλείους ὀκτὼ ἢ δέκα; RP lê πλείους (“mais de dez dias”); a NIV lê só ὀκτώ.\f*.\x - \xo 25:6 \xt ACT 25:17; ACT 25:10; MAT 27:19; ACT 23:30; JER 26:11\x*
\v 7 \w Tendo ele chegado|strong="G3854,G1161,G846"\w*, \w o rodearam|strong="G4026,G846"\w* \w os judeus|strong="G3588,G2453"\w* \w que desceram|strong="G2597"\w* \w de Jerusalém|strong="G575,G2414"\w*, \w apresentando|strong="G2702"\w* \w muitas|strong="G4183"\w* \w e|strong="G2532"\w* \w graves|strong="G926"\w* \w acusações|strong="G157"\w* \w as quais|strong="G3739"\w* \w não conseguiam|strong="G3756,G2480"\w* \w provar|strong="G584"\w*\f + \fr 25.7: \ft Variante: RP omite αὐτόν e lê φέροντες κατὰ τοῦ Παύλου (“trazendo contra Paulo”) em vez de καταφέροντες.\f*,\x - \xo 25:7 \xt ACT 24:13; 1PE 2:12; ACT 25:24; PSA 31:18; ACT 24:5-6; LUK 23:10\x*
\v 8 \w enquanto Paulo|strong="G3588,G3972"\w* \w se defendia|strong="G626"\w*: “\w Nem contra|strong="G3777,G1519"\w* \w a lei|strong="G3588,G3551"\w* \w dos judeus|strong="G3588,G2453"\w* \w nem contra|strong="G3777,G1519"\w* \w o templo|strong="G3588,G2411"\w* \w nem contra|strong="G3777,G1519"\w* \w César|strong="G2541"\w* \w em nada|strong="G5100"\w* \w pequei|strong="G264"\w*.”\x - \xo 25:8 \xt ACT 24:12; ACT 28:17; 2CO 1:12; DAN 6:22; JER 37:18; ACT 18:13\x*
