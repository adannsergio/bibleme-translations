\v 1 \w Mas|strong="G1161"\w* \w um certo|strong="G5100"\w* \w homem|strong="G435"\w*, \w de nome|strong="G3686"\w* \w Ananias|strong="G367"\w*, \w com Safira|strong="G4862,G4551"\w* \w sua mulher|strong="G3588,G1135,G846"\w*, \w vendeu|strong="G4453"\w* \w uma propriedade|strong="G2933"\w*\x - \xo 5:1 \xt LUK 14:33; LEV 10:1-3; MAL 1:14; 2TI 2:20; JOS 7:11; MAT 13:22\x*
