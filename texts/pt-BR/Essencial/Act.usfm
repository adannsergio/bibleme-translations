\p
\v 1 \w Aconteceu|strong="G1096,G1161"\w* \w enquanto|strong="G1722,G3588"\w* \w Apolo|strong="G3588,G625"\w* \w estava|strong="G1511"\w* \w em Corinto|strong="G1722,G2882"\w* \add que\add* \w Paulo|strong="G3972"\w*, \w tendo percorrido|strong="G1330"\w* \w as regiões|strong="G3588,G3313"\w* \w mais altas|strong="G510"\w*, \w chegou|strong="G2064"\w* \w a Éfeso|strong="G1519,G2181"\w* \w e|strong="G2532"\w* \w encontrou|strong="G2147"\w* \w alguns|strong="G5100"\w* \w discípulos|strong="G3101"\w*,\f + \fr 19.1: \ft Lit.: τὰ ἀνωτερικὰ μέρη: “as regiões superiores”, isto é, do interior (planalto).\f*\f + \fr 19.1: \ft Variante: NA28 lê κατελθεῖν (“descer”) onde SBLGNT, WH, Treg e RP leem ἐλθεῖν (“ir”); RP lê εὑρών em vez de εὑρεῖν.\f*\f + \fr 19.1: \ft Acréscimo: “que” (em “em Corinto que Paulo tendo”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 19:1 \xt 1CO 3:4; 1CO 1:12; 1CO 3:6; ACT 20:18; ACT 18:1; ACT 18:23-28\x*
\v 2 \w e|strong="G5037"\w* \w disse|strong="G2036"\w* \w a eles|strong="G4314,G846"\w*: “\w Receberam|strong="G2983"\w* \w Espírito Santo|strong="G4151,G40"\w* \w quando creram|strong="G4100"\w*?” \w Mas eles|strong="G3588,G1161"\w* \add disseram\add* \w a ele|strong="G4314,G846"\w*: “\w Mas|strong="G235"\w* \w nem|strong="G3761"\w* \w ouvimos|strong="G191"\w* \w se há|strong="G1487,G1510"\w* \w Espírito Santo|strong="G4151,G40"\w*.”\f + \fr 19.2: \ft Tradução: πνεῦμα ἅγιον, sem artigo: mantém a ambiguidade entre a Pessoa e a dádiva; ἔστιν pode ser “há” ou “foi dado”: os discípulos dizem não ter ouvido sobre isso.\f*\f + \fr 19.2: \ft Acréscimo: “disseram” (em “Mas eles disseram a ele”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\f + \fr 19.2: \ft Não traduzido: Εἰ (G1487): εἰ (if); sem equivalente natural em português neste ponto.\f*\x - \xo 19:2 \xt JHN 7:5; JHN 6:69; JHN 1:33; JHN 20:22; ROM 10:14; ACT 8:16\x*
\v 3 \w E|strong="G5037"\w* \w disse|strong="G2036"\w*: “\w Em que|strong="G1519,G5101"\w*, \w então|strong="G3767"\w*, \w foram batizados|strong="G907"\w*?” \w Mas eles|strong="G3588,G1161"\w* \w disseram|strong="G2036"\w*: “\w No batismo|strong="G1519,G3588,G908"\w* \w de João|strong="G2491"\w*.”\x - \xo 19:3 \xt LUK 7:29; MRK 1:4; LUK 20:4; MRK 11:30; ACT 13:24; ACT 11:16\x*
\v 4 \w E disse|strong="G2036,G1161"\w* \w Paulo|strong="G3972"\w*: “\w João|strong="G2491"\w* \w batizou|strong="G907"\w* \w com um batismo|strong="G908"\w* \w de arrependimento|strong="G3341"\w*, \w ao povo|strong="G3588,G2992"\w* \w dizendo|strong="G3004"\w* \w que cressem|strong="G2443,G4100"\w* \w naquele|strong="G1519,G3588"\w* \w que vinha|strong="G2064"\w* \w depois dele|strong="G3326,G846"\w*, \w isto é|strong="G3778,G1510"\w*, \w em Jesus|strong="G1519,G3588,G2424"\w*\f + \fr 19.4: \ft Variante: RP acrescenta μέν depois de Ἰωάννης e “Cristo” depois de τὸν Ἰησοῦν (TR também acrescenta “Cristo”).\f*.”\x - \xo 19:4 \xt MRK 1:4; ACT 13:24; MAT 21:25; LUK 7:29; LUK 20:4; LUK 3:3\x*
\v 5 \w Ao ouvirem|strong="G191,G1161"\w*, \w foram batizados|strong="G907"\w* \w em nome|strong="G1519,G3588,G3686"\w* \w do Senhor|strong="G3588,G2962"\w* \w Jesus|strong="G2424"\w*;\x - \xo 19:5 \xt MAT 28:19; 1CO 1:15; ACT 2:38; 1CO 1:13; ACT 8:12; ACT 10:48\x*
\v 6 \w e|strong="G2532"\w*, \w impondo|strong="G2007"\w* \w sobre eles|strong="G846"\w* \w Paulo|strong="G3588,G3972"\w* \w as mãos|strong="G5495"\w*, \w veio|strong="G2064"\w* \w o Espírito Santo|strong="G3588,G4151,G40"\w* \w sobre eles|strong="G1909,G846"\w*, \w e|strong="G5037"\w* \w falavam|strong="G2980"\w* \w em línguas|strong="G1100"\w* \w e|strong="G2532"\w* \w profetizavam|strong="G4395"\w*.\x - \xo 19:6 \xt ACT 8:17; ACT 6:6; ACT 8:19; MRK 16:17; 2TI 1:6; 1CO 14:2\x*
\v 7 \w Ora, eram|strong="G1510,G1161"\w* \w ao todo|strong="G3588,G3956"\w* \w cerca de|strong="G5616"\w* \w doze|strong="G1427"\w* \w homens|strong="G435"\w*.\x - \xo 19:7 \xt REV 1:11; MAT 14:21; LUK 9:14\x*
\v 8 \w Entrando|strong="G1525,G1161"\w* \w na sinagoga|strong="G1519,G3588,G4864"\w*, \w falava com ousadia|strong="G3955"\w* \w por três|strong="G1909,G5140"\w* \w meses|strong="G3376"\w*, \w debatendo|strong="G1256"\w* \w e|strong="G2532"\w* \w persuadindo|strong="G3982"\w* \w sobre o reino|strong="G4012,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 19:8 \xt EPH 6:19; 1CO 16:9; ACT 20:31; ACT 1:3; ACT 28:23; ACT 4:29\x*
\v 9 \w Mas como|strong="G5613,G1161"\w* \w alguns|strong="G5100"\w* \w se endureciam|strong="G4645"\w* \w e|strong="G2532"\w* \w se recusavam a crer|strong="G544"\w*, \w falando mal|strong="G2551"\w* \w do Caminho|strong="G3588,G3598"\w* \w diante da multidão|strong="G1799,G3588,G4128"\w*, \w afastando-se|strong="G868"\w* \w deles|strong="G575,G846"\w*, \w separou|strong="G873"\w* \w os discípulos|strong="G3588,G3101"\w*, \w debatendo|strong="G1256"\w* \w todos os dias|strong="G2596,G2250"\w* \w na escola|strong="G1722,G3588,G4981"\w* \w de Tirano|strong="G5181"\w*.\f + \fr 19.9: \ft Lit.: ὁδός: “caminho”; aqui, designação do grupo dos seguidores de Jesus.\f*\x - \xo 19:9 \xt ACT 9:2; 1CO 16:9; ACT 19:23; ACT 18:6; 2PE 2:12; ACT 13:45\x*
\v 10 \w Isto|strong="G3778,G1161"\w* \w aconteceu|strong="G1096"\w* \w por dois|strong="G1909,G1417"\w* \w anos|strong="G2094"\w*, \w de modo que|strong="G5620"\w* \w todos os que habitavam|strong="G3956,G3588,G2730"\w* \w a Ásia|strong="G3588,G773"\w* \w ouviram|strong="G191"\w* \w a palavra|strong="G3588,G3056"\w* \w do Senhor|strong="G3588,G2962"\w*, \w tanto judeus|strong="G2453,G5037"\w* \w como gregos|strong="G2532,G1672"\w*\f + \fr 19.10: \ft Variante: RP e TR acrescentam “Jesus” depois de “Senhor”.\f*.\x - \xo 19:10 \xt ACT 2:9; ROM 10:12; ROM 1:16; 1CO 16:9; ACT 20:31; ACT 18:6\x*
\v 11 \w E|strong="G5037"\w* \w atos de poder|strong="G1411"\w* \w não comuns|strong="G3756,G3588,G5177"\w* \w Deus|strong="G3588,G2316"\w* \w fazia|strong="G4160"\w* \w por meio das mãos|strong="G1223,G3588,G5495"\w* \w de Paulo|strong="G3972"\w*,\f + \fr 19.11: \ft Lit.: δύναμις: “poder”, “ato de poder”, “milagre”.\f*\x - \xo 19:11 \xt ACT 5:12; MRK 16:17-20; ROM 15:18-19; HEB 2:4; ACT 16:18; ACT 8:13\x*
\v 12 \w de modo que|strong="G5620"\w* \w até|strong="G2532"\w* \w aos doentes|strong="G1909,G3588,G770"\w* \w eram levados|strong="G667"\w* \w do corpo|strong="G575,G3588,G5559"\w* \w dele|strong="G846"\w* \w lenços|strong="G4676"\w* \w ou|strong="G2228"\w* \w aventais|strong="G4612"\w*, \w e|strong="G2532"\w* \w as doenças|strong="G3588,G3554"\w* \w se afastavam|strong="G525"\w* \w deles|strong="G575,G846"\w*, \w e|strong="G5037"\w* \w os espíritos|strong="G3588,G4151"\w* \w maus|strong="G3588,G4190"\w* \w saíam|strong="G1607"\w*.\f + \fr 19.12: \ft Variante: RP lê ἐπιφέρεσθαι (“trazidos sobre”) em vez de ἀποφέρεσθαι e ἐξέρχεσθαι ἀπʼ αὐτῶν (“saíam deles”) em vez de ἐκπορεύεσθαι.\f*\x - \xo 19:12 \xt JHN 14:12; MRK 16:18; MRK 16:17; ACT 5:15; 2KI 13:20-21; MRK 5:27\x*
\v 13 \w Mas tentaram|strong="G2021,G1161"\w* \w alguns|strong="G5100"\w* \w também|strong="G2532"\w* \w dos judeus|strong="G3588,G2453"\w* \w itinerantes|strong="G4022"\w* \w exorcistas|strong="G1845"\w* \w invocar|strong="G3687"\w* \w sobre os que tinham|strong="G1909,G3588,G2192"\w* \w os espíritos|strong="G3588,G4151"\w* \w maus|strong="G3588,G4190"\w* \w o nome|strong="G3588,G3686"\w* \w do Senhor|strong="G3588,G2962"\w* \w Jesus|strong="G2424"\w*, \w dizendo|strong="G3004"\w*: “\w Eu conjuro vocês|strong="G3726,G4771"\w* \w por Jesus|strong="G3588,G2424"\w* \w a quem|strong="G3739"\w* \w Paulo|strong="G3972"\w* \w proclama|strong="G2784"\w*.”\f + \fr 19.13: \ft Variante: RP lê ἀπό em vez de καί, Ὁρκίζομεν (“nós conjuramos”) em vez de Ὁρκίζω, e acrescenta o artigo ὁ diante de Παῦλος.\f*\x - \xo 19:13 \xt MRK 16:17; MAT 12:27; MAT 7:22; MAT 7:21; MRK 9:38; ACT 3:16\x*
\v 14 \w Ora, eram|strong="G1510,G1161"\w* \w sete|strong="G2033"\w* \w filhos|strong="G5207"\w* \w de um certo|strong="G5100"\w* \w Ceva|strong="G4630"\w*, \w judeu|strong="G2453"\w*, \w sumo sacerdote|strong="G749"\w*, \w que faziam|strong="G4160"\w* \w isto|strong="G3778"\w*.\x - \xo 19:14 \xt MRK 16:17; MAT 7:22; MAT 7:21; ACT 3:16; ACT 3:6; ACT 16:18\x*
\v 15 \w Respondendo|strong="G611,G1161"\w* \w o espírito|strong="G3588,G4151"\w* \w mau|strong="G3588,G4190"\w*, \w disse|strong="G2036"\w* \w a eles|strong="G846"\w*: “\w Jesus|strong="G3588,G2424"\w* \w reconheço|strong="G1097"\w* \w e|strong="G2532"\w* \w Paulo|strong="G3588,G3972"\w* \w conheço|strong="G1987"\w*; \w mas vocês|strong="G4771,G1161"\w*, \w quem|strong="G5101"\w* \w são|strong="G1510"\w*?”\x - \xo 19:15 \xt MRK 16:17; JAS 2:19; MAT 7:22; ACT 16:17-18; MAT 7:21; LUK 4:33-35\x*
\v 16 \w E|strong="G2532"\w*, \w saltando|strong="G2177"\w* \w sobre eles|strong="G1909,G846"\w* \w o homem|strong="G3588,G444"\w* \w em quem|strong="G1722,G3739"\w* \w estava|strong="G1510"\w* \w o espírito|strong="G3588,G4151"\w* \w mau|strong="G3588,G4190"\w*, \w dominando|strong="G2634"\w* \w ambos|strong="G297"\w*, \w prevaleceu|strong="G2480"\w* \w contra eles|strong="G2596,G846"\w*, \w de modo que|strong="G5620"\w* \w nus|strong="G1131"\w* \w e|strong="G2532"\w* \w feridos|strong="G5135"\w* \w fugiram|strong="G1628"\w* \w daquela casa|strong="G1537,G3588,G3624,G1565"\w*.\f + \fr 19.16: \ft Variante: RP lê ἐφαλλόμενος, outra ordem em “o homem sobre eles” e καὶ κατακυριεῦσαν αὐτῶν no lugar de κατακυριεύσας ἀμφοτέρων.\f*\x - \xo 19:16 \xt MRK 16:17; MAT 7:21; 1SA 16:14; ACT 3:16; ACT 3:6; ACT 16:18\x*
\v 17 \w E isto|strong="G3778,G1161"\w* \w tornou-se|strong="G1096"\w* \w conhecido|strong="G1110"\w* \w a todos|strong="G3956"\w* \w os judeus|strong="G2453"\w* \w e|strong="G5037,G2532"\w* \w gregos|strong="G1672"\w* \w que habitavam|strong="G3588,G2730"\w* \w em Éfeso|strong="G3588,G2181"\w*, \w e|strong="G2532"\w* \w caiu|strong="G1968"\w* \w medo|strong="G5401"\w* \w sobre todos|strong="G1909,G3956"\w* \w eles|strong="G846"\w*, \w e|strong="G2532"\w* \w era engrandecido|strong="G3170"\w* \w o nome|strong="G3588,G3686"\w* \w do Senhor|strong="G3588,G2962"\w* \w Jesus|strong="G2424"\w*.\x - \xo 19:17 \xt COL 3:17; PSA 34:3; MAT 7:21; ACT 5:11; ACT 3:16; ACT 16:18\x*
\v 18 \w E|strong="G5037"\w* \w muitos|strong="G4183"\w* \w dos que tinham crido|strong="G3588,G4100"\w* \w vinham|strong="G2064"\w* \w confessando|strong="G1843"\w* \w e|strong="G2532"\w* \w declarando|strong="G312"\w* \w as suas|strong="G3588,G846"\w* \w práticas|strong="G4234"\w*.\x - \xo 19:18 \xt JAS 5:16; 1JN 1:9; MAT 7:21; MRK 1:5; MAT 3:6; ROM 10:10\x*
\v 19 \w E muitos|strong="G2425,G1161"\w* \w dos que praticavam|strong="G3588,G4238"\w* \w artes mágicas|strong="G3588,G4021"\w*, \w tendo reunido|strong="G4851"\w* \w os livros|strong="G3588,G976"\w*, \w queimavam-nos|strong="G2618"\w* \w diante de todos|strong="G1799,G3956"\w*; \w e|strong="G2532"\w* \w calcularam|strong="G4860"\w* \w o valor|strong="G3588,G5092"\w* \w deles|strong="G846"\w* \w e|strong="G2532"\w* \w acharam|strong="G2147"\w* \w cinquenta mil|strong="G3461,G4002"\w* \w peças de prata|strong="G694"\w*\f + \fr 19.19: \ft Lit.: τὰ περίεργα: “as coisas supérfluas”, “curiosidades”; aqui, em sentido de magia. μυριάς: “dez mil”; cinco miríades equivalem a 50.000.\f*.\f + \fr 19.19: \ft Tradução: τιμὰς (τιμή, G5092) está aqui como “o valor”; o termo pode ser “honra”, “preço”, “valor” ou “estima”, e o contexto decide.\f*\x - \xo 19:19 \xt MAT 7:21; DEU 18:10; ACT 13:8; ACT 8:9; DEU 7:25-26; EXO 22:18\x*
\v 20 \w Assim|strong="G3779"\w* \w com força|strong="G2596,G2904"\w* \w do Senhor|strong="G3588,G2962"\w* \w a palavra|strong="G3588,G3056"\w* \w crescia|strong="G837"\w* \w e|strong="G2532"\w* \w se fortalecia|strong="G2480"\w*.\x - \xo 19:20 \xt ACT 6:7; ACT 12:24; ISA 55:11; 2TH 3:1; MAT 7:21; MRK 4:31\x*
\v 21 \w Quando|strong="G5613,G1161"\w* \w foram cumpridas|strong="G4137"\w* \w estas coisas|strong="G3778"\w*, \w propôs|strong="G5087"\w* \w Paulo|strong="G3588,G3972"\w* \w no espírito|strong="G1722,G3588,G4151"\w*, \w tendo passado|strong="G1330"\w* \w pela Macedônia|strong="G3588,G3109"\w* \w e|strong="G2532"\w* \w Acaia|strong="G882"\w*, \w ir|strong="G4198"\w* \w a Jerusalém|strong="G1519,G2414"\w*, \w dizendo|strong="G2036"\w*: “\w Depois que eu|strong="G3326,G3588,G3165"\w* \w tiver estado|strong="G1096"\w* \w ali|strong="G1563"\w*, \w é necessário|strong="G1163"\w* \w que eu|strong="G3165"\w* \w também|strong="G2532"\w* \w veja|strong="G1492"\w* \w Roma|strong="G4516"\w*\f + \fr 19.21: \ft Lit.: ἐν τῷ πνεύματι: “no espírito” (de Paulo) ou “no Espírito”; o texto não permite decidir.\f*.”\x - \xo 19:21 \xt 1CO 16:5; ROM 1:13; ACT 23:11; ACT 20:22; ROM 15:25; ACT 20:16\x*
\v 22 \w Mas tendo enviado|strong="G649,G1161"\w* \w à Macedônia|strong="G1519,G3588,G3109"\w* \w dois|strong="G1417"\w* \w dos que o serviam|strong="G3588,G1247,G846"\w*, \w Timóteo|strong="G5095"\w* \w e|strong="G2532"\w* \w Erasto|strong="G2037"\w*, \w ele mesmo|strong="G846"\w* \w ficou|strong="G1907"\w* \w por algum tempo|strong="G5550"\w* \w na Ásia|strong="G1519,G3588,G773"\w*.\x - \xo 19:22 \xt ROM 16:23; 2TI 4:20; ACT 16:1; ACT 20:34; 1TH 1:1; 2CO 1:16\x*
\v 23 \w E houve|strong="G1096,G1161"\w* \w naquele|strong="G2596,G3588,G1565"\w* \w tempo|strong="G2540"\w* \w uma agitação|strong="G5017"\w* \w não pequena|strong="G3756,G3641"\w* \w a respeito|strong="G4012"\w* \w do Caminho|strong="G3588,G3598"\w*.\x - \xo 19:23 \xt ACT 12:18; ACT 9:2; 2CO 1:8; ACT 19:9; 2CO 6:5; ACT 18:25\x*
\v 24 \w Pois um certo|strong="G1063,G5100"\w* \w de nome|strong="G3686"\w* \w Demétrio|strong="G1216"\w*, \w ourives|strong="G695"\w*, \w fabricando|strong="G4160"\w* \w santuários|strong="G3485"\w* \w de prata|strong="G693"\w* \w de Ártemis|strong="G735"\w*, \w proporcionava|strong="G3930"\w* \w aos artesãos|strong="G3588,G5079"\w* \w não pouco|strong="G3756,G3641"\w* \w lucro|strong="G2039"\w*,\f + \fr 19.24: \ft Nota cultural: Ártemis de Éfeso: grande divindade da cidade, com templo famoso; os santuários de prata eram, provavelmente, miniaturas.\f*\x - \xo 19:24 \xt 1TI 6:9-10; 2CO 1:8; ACT 16:16; JER 12:6; REV 18:15; 2CO 6:5\x*
\q1
\v 25 \w os quais|strong="G3739"\w*, \w tendo reunido|strong="G4867"\w* \w e|strong="G2532"\w* \w os operários|strong="G3588,G2040"\w* \w desse tipo de trabalho|strong="G4012,G3588,G5108"\w*, \w disse|strong="G2036"\w*: “\w Homens|strong="G435"\w*, \w sabem|strong="G1987"\w* \w que|strong="G3754"\w* \w deste|strong="G1537,G3778,G3588"\w* \w lucro|strong="G2039"\w* \w vem|strong="G1510"\w* \w a nossa prosperidade|strong="G3588,G2142,G3165"\w*.\x - \xo 19:25 \xt 2CO 1:8; JER 12:6; REV 18:15; 2CO 6:5; ACT 16:19; ACT 17:5\x*
\q1
\v 26 \w E|strong="G2532"\w* \w veem|strong="G2334"\w* \w e|strong="G2532"\w* \w ouvem|strong="G191"\w* \w que|strong="G3754"\w* \w não somente|strong="G3756,G3441"\w* \w em Éfeso|strong="G2181"\w* \w mas|strong="G235"\w* \w quase|strong="G4975"\w* \w em toda|strong="G3956"\w* \w a Ásia|strong="G3588,G773"\w*, \w este|strong="G3778"\w* \w Paulo|strong="G3588,G3972"\w*, \w tendo persuadido|strong="G3982"\w*, \w desviou|strong="G3179"\w* \w uma multidão considerável|strong="G2425,G3793"\w*, \w dizendo|strong="G3004"\w* \w que|strong="G3754"\w* \w não são|strong="G3756,G1510"\w* \w deuses|strong="G2316"\w* \w os feitos|strong="G3588,G1096"\w* \w por mãos|strong="G1223,G5495"\w*.\x - \xo 19:26 \xt EXO 20:4; 2CO 1:8; 1CO 8:4; ACT 17:29; DAN 3:1; REV 9:20\x*
\q1
\v 27 \w Não somente|strong="G3756,G3441,G1161"\w* \w há o risco|strong="G2793"\w* \add de que\add* \w este nosso|strong="G3778,G3165"\w* \w ramo de negócio|strong="G3588,G3313"\w* \w caia|strong="G2064"\w* \w em descrédito|strong="G1519,G557"\w*, \w mas também|strong="G235,G2532"\w* \add de que\add* \w o templo|strong="G3588,G2411"\w* \w da grande|strong="G3588,G3173"\w* \w deusa|strong="G2299"\w* \w Ártemis|strong="G735"\w* \w seja considerado|strong="G3049"\w* \w como nada|strong="G1519,G3762"\w*, \w e|strong="G5037,G2532"\w* \add de que ela\add* \w esteja para|strong="G3195"\w* \w ser privada|strong="G2507"\w* \w da sua majestade|strong="G3588,G3168,G846"\w*, \w que|strong="G3739"\w* \w toda|strong="G3650,G3588"\w* \w a Ásia|strong="G773"\w* \w e|strong="G2532"\w* \w o mundo habitado|strong="G3588,G3625"\w* \w veneram|strong="G4576"\w*.”\f + \fr 19.27: \ft Acréscimo: “de” (em “o risco de que este”), “de” (em “mas também de que o”), “de” (em “nada e de que ela”): preposição ou artigo que a regência do português exige; “que” (em “risco de que este nosso”), “que” (em “também de que o templo”), “que” (em “e de que ela esteja”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição; “ela” (em “de que ela esteja para”): pronome acrescentado; o grego indica a pessoa só pela terminação do verbo.\f*\x - \xo 19:27 \xt EXO 20:4; 2CO 1:8; JER 12:6; JHN 3:26; NEH 2:10; REV 18:15\x*
\v 28 \w Ao ouvirem|strong="G191,G1161"\w* \w e|strong="G2532"\w* \w ficarem cheios|strong="G1096,G4134"\w* \w de furor|strong="G2372"\w*, \w gritavam|strong="G2896"\w*, \w dizendo|strong="G3004"\w*: “\w Grande|strong="G3173"\w* \w é a Ártemis|strong="G3588,G735"\w* \w dos efésios|strong="G2180"\w*!”\f + \fr 19.28: \ft Acréscimo: verbo ser/estar suprido em “é a Ártemis”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 19:28 \xt ACT 19:34; EXO 20:4; 2CO 1:8; JER 12:6; 2CO 6:5; ACT 16:22\x*
\v 29 \w E|strong="G2532"\w* \w se encheu|strong="G4130"\w* \w a cidade|strong="G3588,G4172"\w* \w de confusão|strong="G3588,G4799"\w*, \w e|strong="G5037"\w* \w correram|strong="G3729"\w* \w unânimes|strong="G3661"\w* \w ao teatro|strong="G1519,G3588,G2302"\w*, \w tendo arrebatado|strong="G4884"\w* \w Gaio|strong="G1050"\w* \w e|strong="G2532"\w* \w Aristarco|strong="G708"\w*, \w macedônios|strong="G3110"\w*, \w companheiros de viagem|strong="G4898"\w* \w de Paulo|strong="G3972"\w*.\f + \fr 19.29: \ft Variante: RP e TR acrescentam ὅλη (“toda”) depois de πόλις.\f*\x - \xo 19:29 \xt ACT 20:4; 3JN 1:1; EXO 20:4; 2CO 1:8; ACT 27:2; COL 4:10\x*
\v 30 \w Mas querendo|strong="G1161,G1014"\w* \w Paulo|strong="G3972"\w* \w entrar|strong="G1525"\w* \w diante do povo|strong="G1519,G3588,G1218"\w*, \w não o deixavam|strong="G3756,G1439,G846"\w* \w os discípulos|strong="G3588,G3101"\w*;\x - \xo 19:30 \xt EXO 20:4; 2CO 1:8; 2CO 6:5; ACT 16:22; ACT 17:5; ACT 21:39\x*
\v 31 \w Também|strong="G1161,G2532"\w* \w alguns|strong="G5100"\w* \w dos asiarcas|strong="G3588,G775"\w*, \w que eram|strong="G1510"\w* \w amigos dele|strong="G846,G5384"\w*, \w tendo enviado|strong="G3992"\w* \w recado a ele|strong="G4314,G846"\w*, \w rogavam|strong="G3870"\w* \w que não se entregasse|strong="G3361,G1325,G1438"\w* \w ao teatro|strong="G1519,G3588,G2302"\w*\f + \fr 19.31: \ft Nota cultural: asiarcas: autoridades da província romana da Ásia.\f*.\x - \xo 19:31 \xt EXO 20:4; 2CO 1:8; 1CO 4:9; 2CO 6:5; ACT 16:22; ACT 17:5\x*
\v 32 \w Uns|strong="G243,G3303,G3767"\w* \w gritavam|strong="G2896"\w* \w uma coisa|strong="G5100"\w* \add e outros\add* \w outra|strong="G243"\w*, \w pois|strong="G1063"\w* \w a assembleia|strong="G3588,G1577"\w* \w estava|strong="G1510"\w* \w confusa|strong="G4797"\w*, \w e|strong="G2532"\w* \w a maioria|strong="G3588,G4183"\w* \w não sabia|strong="G3756,G1492"\w* \w por que motivo|strong="G5101,G1752"\w* \w se tinham reunido|strong="G4905"\w*.\f + \fr 19.32: \ft Lit.: ἐκκλησία: aqui, “assembleia” de pessoas reunidas (sentido comum), e não a comunidade dos que seguem Jesus.\f*\f + \fr 19.32: \ft Acréscimo: “e” (em “uma coisa e outros outra”): conectivo acrescentado para ligar as orações em português; “outros” (em “coisa e outros outra pois”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 19:32 \xt EXO 20:4; 2CO 1:8; ACT 21:34; 2CO 6:5; ACT 16:22; ACT 17:5\x*
\v 33 \w Alguns da multidão|strong="G1537,G1161,G3588,G3793"\w* \w instruíram|strong="G4822"\w* \w Alexandre|strong="G223"\w*, \w os judeus|strong="G3588,G2453"\w* \w empurrando-o à frente|strong="G4261,G846"\w*; \w e Alexandre|strong="G3588,G1161,G223"\w*, \w acenando|strong="G2678"\w* \w com a mão|strong="G3588,G5495"\w*, \w queria|strong="G2309"\w* \w se defender|strong="G626"\w* \w diante do povo|strong="G3588,G1218"\w*\f + \fr 19.33: \ft Lit.: συμβιβάζω: “juntar”, “instruir”, “induzir”; o sentido aqui é discutido.\f*.\x - \xo 19:33 \xt EXO 20:4; 2CO 1:8; ACT 12:17; 1TI 1:20; 2TI 4:14; 2CO 6:5\x*
\v 34 \w Mas ao reconhecerem|strong="G1921,G1161"\w* \w que|strong="G3754"\w* \w judeu|strong="G2453"\w* \w ele era|strong="G1510"\w*, \w surgiu|strong="G1096"\w* \w uma só|strong="G1520"\w* \w voz|strong="G5456"\w* \w de todos|strong="G1537,G3956"\w*, \w gritando|strong="G2896"\w* \w por cerca de|strong="G5613,G1909"\w* \w duas horas|strong="G5610,G1417"\w*: “\w Grande|strong="G3173"\w* \w é a Ártemis|strong="G3588,G735"\w* \w dos efésios|strong="G2180"\w*!”\f + \fr 19.34: \ft Acréscimo: verbo ser/estar suprido em “é a Ártemis”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 19:34 \xt ACT 19:28; 1PE 1:18; EXO 20:4; 2CO 1:8; 2TI 4:14; MAT 6:7\x*
\v 35 \w O escrivão|strong="G3588,G1122"\w*, \w tendo acalmado|strong="G2687,G1161"\w* \w a multidão|strong="G3588,G3793"\w*, \w diz|strong="G5346"\w*: “\w Homens|strong="G435"\w* \w efésios|strong="G2180"\w*, \w quem|strong="G5101,G1063"\w* \w é|strong="G1510"\w* \w dos homens|strong="G444"\w* \w que|strong="G3739"\w* \w não conhece|strong="G3756,G1097"\w* \w a cidade|strong="G3588,G4172"\w* \w dos efésios|strong="G2180"\w* \w sendo|strong="G1510"\w* \w guardiã do templo|strong="G3511"\w* \w da grande|strong="G3588,G3173"\w* \w Ártemis|strong="G735"\w* \w e|strong="G2532"\w* \w da imagem caída do céu|strong="G3588,G1356"\w*\f + \fr 19.35: \ft Lit.: γραμματεύς: aqui, “escrivão” da cidade, alto funcionário municipal. νεωκόρος: “guardião do templo”.\f*?”\f + \fr 19.35: \ft Lit.: Τοῦ διοπετοῦς: literalmente “o caído de Zeus”, isto é, do céu; o grego não traz substantivo, e “imagem” é suprido (pode tratar-se de um objeto sagrado, como uma pedra).\f*\x - \xo 19:35 \xt 1PE 1:18; EXO 20:4; 2CO 1:8; JOB 12:9; ACT 14:12; EPH 2:2\x*
\v 36 \w Sendo, portanto|strong="G3767,G1510"\w* \w indiscutíveis|strong="G368"\w* \w estas coisas|strong="G3778"\w*, \w é necessário|strong="G1163,G1510"\w* \w que vocês|strong="G4771"\w* \w estejam calmos|strong="G2687,G5225"\w* \w e|strong="G2532"\w* \w nada|strong="G3367"\w* \w precipitado|strong="G4312"\w* \w façam|strong="G4238"\w*.\x - \xo 19:36 \xt ACT 16:22; ACT 26:17; ACT 4:14; ACT 5:35; PRO 14:29; REV 1:11\x*
\v 37 \w Pois trouxeram|strong="G71,G1063"\w* \w estes homens|strong="G3588,G435,G3778"\w*, \w que nem|strong="G3777"\w* \w roubam templos|strong="G2417"\w* \w nem|strong="G3777"\w* \w blasfemam contra|strong="G987"\w* \w a nossa deusa|strong="G3588,G2316,G3165"\w*.\f + \fr 19.37: \ft Variante: RP lê ὑμῶν (“de vocês”) em vez de ἡμῶν (“nossa”).\f*\x - \xo 19:37 \xt 2CO 6:3; ACT 16:22; ACT 26:17; REV 1:11; ROM 2:22\x*
\v 38 \w Se, portanto|strong="G1487,G3303,G3767"\w*, \w Demétrio|strong="G1216"\w* \w e|strong="G2532"\w* \w os artesãos|strong="G3588,G5079"\w* \w com ele|strong="G4862,G846"\w* \w têm|strong="G2192"\w* \w uma queixa|strong="G3056"\w* \w contra alguém|strong="G4314,G5100"\w*, \w realizam-se|strong="G71"\w* \w sessões de tribunal|strong="G60"\w* \w e|strong="G2532"\w* \w há procônsules|strong="G446,G1510"\w*: \w acusem-se|strong="G1458"\w* \w uns aos outros|strong="G240"\w*.\f + \fr 19.38: \ft Lit.: ἀγοραῖος: “relativo à praça”, isto é, dias de tribunal ou de assembleia.\f*\x - \xo 19:38 \xt ACT 13:7; 1CO 6:1; ACT 16:22; ACT 26:17; REV 1:11\x*
\v 39 \w Mas se|strong="G1487,G1161"\w* \w algo|strong="G5100"\w* \w mais além|strong="G6071"\w* \w procuram|strong="G1934"\w*, \w na assembleia|strong="G1722,G3588,G1577"\w* \w legal|strong="G1772"\w* \w será resolvido|strong="G1956"\w*.\f + \fr 19.39: \ft Variante: RP lê περὶ ἑτέρων (“acerca de outras coisas”) em vez de περαιτέρω (“algo mais além”).\f*\f + \fr 19.39: \ft Tradução: ἐκκλησίᾳ (ἐκκλησία, G1577) está aqui como “na assembleia”; o termo pode ser “comunidade” (os convocados), “assembleia” ou “congregação”, e o contexto decide.\f*\x - \xo 19:39 \xt ACT 16:22; ACT 26:17; REV 1:11\x*
\v 40 \w Pois|strong="G2532,G1063"\w* \w corremos o risco|strong="G2793"\w* \w de ser acusados|strong="G1458"\w* \w de sedição|strong="G4714"\w* \w a respeito de hoje|strong="G4012,G3588,G4594"\w*, \w não existindo|strong="G5225"\w* \w nenhum|strong="G3367"\w* \w motivo|strong="G159"\w* \w com o qual|strong="G4012,G3739"\w* \w possamos|strong="G3756,G1410"\w* \w dar|strong="G591"\w* \w explicação|strong="G3056"\w* \w a respeito deste|strong="G4012,G3588,G3778"\w* \w tumulto|strong="G4963"\w*. \w E|strong="G2532"\w* \w tendo dito|strong="G2036"\w* \w isto|strong="G3778"\w*, \w dispensou|strong="G630"\w* \w a assembleia|strong="G3588,G1577"\w*.\f + \fr 19.40: \ft Tradução: ἐκκλησίαν (ἐκκλησία, G1577) está aqui como “a assembleia”; o termo pode ser “comunidade” (os convocados), “assembleia” ou “congregação”, e o contexto decide.\f*\x - \xo 19:40 \xt ACT 16:22; ACT 17:5; ACT 26:17; REV 1:11\x*
\c 20
\p
\v 1 \w Depois de|strong="G3326,G1161,G3588"\w* \w cessar|strong="G3973"\w* \w o tumulto|strong="G3588,G2351"\w*, \w Paulo|strong="G3588,G3972"\w*, \w tendo mandado chamar|strong="G3343"\w* \w os discípulos|strong="G3588,G3101"\w* \w e|strong="G2532"\w* \w exortado|strong="G3870"\w*, \w tendo se despedido|strong="G782"\w*, \w partiu|strong="G1831"\w* \w para ir|strong="G4198"\w* \w à Macedônia|strong="G1519,G3109"\w*\f + \fr 20.1: \ft Variante: RP lê προσκαλεσάμενος (“tendo chamado”) em vez de μεταπεμψάμενος, omite παρακαλέσας, lê πορευθῆναι e acrescenta o artigo τὴν diante de Μακεδονίαν.\f*.\x - \xo 20:1 \xt 2CO 7:5; 1TI 1:3; ACT 16:9; ACT 19:21; 1CO 16:5; 1TH 5:26\x*
\v 2 \w Tendo percorrido|strong="G1330,G1161"\w* \w aquelas regiões|strong="G3588,G3313,G1565"\w* \w e|strong="G2532"\w* \w tendo-os exortado|strong="G3870,G846"\w* \w com muitas palavras|strong="G3056,G4183"\w*, \w chegou|strong="G2064"\w* \w à Grécia|strong="G1519,G3588,G1671"\w*.\x - \xo 20:2 \xt 1TH 4:1; 1TH 2:3; COL 1:28; ROM 12:8; 1TH 2:11; ACT 20:11\x*
\v 3 \w E|strong="G5037"\w*, \w tendo passado|strong="G4160"\w* \w três meses|strong="G3376,G5140"\w*; \w havendo|strong="G1096"\w* \w uma conspiração|strong="G1917"\w* \w contra ele|strong="G846"\w* \w por parte dos judeus|strong="G5259,G3588,G2453"\w*, \w quando estava para|strong="G3195"\w* \w embarcar|strong="G321"\w* \w para a Síria|strong="G1519,G3588,G4947"\w*, \w tomou a decisão|strong="G1096,G1106"\w* \w de voltar|strong="G3588,G5290"\w* \w pela Macedônia|strong="G1223,G3109"\w*.\x - \xo 20:3 \xt ACT 20:19; 2CO 11:26; ACT 25:3; ACT 9:23-24; 1TI 1:3; 2CO 7:5\x*
\v 4 \w Acompanhavam|strong="G4902,G1161"\w* \w a ele|strong="G846"\w* \w Sópatro|strong="G4986"\w* \w filho de Pirro|strong="G6077"\w*, \w beroense|strong="G961"\w*, \w e dos tessalonicenses|strong="G2331,G1161"\w* \w Aristarco|strong="G708"\w* \w e|strong="G2532"\w* \w Secundo|strong="G4580"\w*, \w e|strong="G2532"\w* \w Gaio|strong="G1050"\w* \w derbeu|strong="G1190"\w* \w e|strong="G2532"\w* \w Timóteo|strong="G5095"\w*, \w e da Ásia|strong="G774,G1161"\w* \w Tíquico|strong="G5190"\w* \w e|strong="G2532"\w* \w Trófimo|strong="G5161"\w*\f + \fr 20.4: \ft Variante: WH e NA28 terminam em αὐτῷ (“acompanhavam-no”); Treg e RP acrescentam ἄχρι τῆς Ἀσίας (“até a Ásia”); RP omite “de Pirro”.\f*;\x - \xo 20:4 \xt 1TH 1:1; ACT 19:29; EPH 6:21; 2TI 4:20; 3JN 1:1; 2TI 4:12\x*
\v 5 \w estes, porém|strong="G3778,G1161"\w*, \w tendo vindo|strong="G4334"\w*, \w nos esperavam|strong="G3306,G3165"\w* \w em Trôade|strong="G1722,G5174"\w*;\f + \fr 20.5: \ft Variante: NA28 lê προελθόντες (“tendo ido adiante”) onde SBLGNT, WH, Treg e RP leem προσελθόντες; RP omite δέ.\f*\f + \fr 20.5: \ft Tradução: ἔμενον (μένω, G3306) está aqui como “nos esperavam”; o termo pode ser “permanecer”, “ficar”, “morar”, “continuar” ou “esperar”, e o contexto decide.\f*\x - \xo 20:5 \xt ACT 16:8; 2CO 2:12; 2TI 4:13; ACT 16:1; ACT 16:10\x*
\v 6 \w mas nós|strong="G3165,G1161"\w* \w navegamos|strong="G1602"\w* \w depois dos dias|strong="G3326,G3588,G2250"\w* \w dos pães sem fermento|strong="G3588,G106"\w* \w de Filipos|strong="G575,G5375"\w*, \w e|strong="G2532"\w* \w chegamos|strong="G2064"\w* \w até eles|strong="G4314,G846"\w* \w a Trôade|strong="G1519,G3588,G5174"\w* \w em cinco|strong="G891,G4002"\w* \w dias|strong="G2250"\w*, \w onde|strong="G3757"\w* \w permanecemos|strong="G1304"\w* \w sete|strong="G2033"\w* \w dias|strong="G2250"\w*.\f + \fr 20.6: \ft Variante: NA28 lê ὅπου (“onde”) em vez de οὗ.\f*\x - \xo 20:6 \xt ACT 16:12; ACT 12:3; EXO 12:14-15; ACT 21:4; EXO 23:15; ROM 15:19\x*
\v 7 \w No primeiro dia|strong="G1722,G1161,G3588,G1520"\w* \w da semana|strong="G3588,G4521"\w*, \w estando nós reunidos|strong="G4863,G3165"\w* \w para partir|strong="G2806"\w* \w o pão|strong="G740"\w*, \w Paulo|strong="G3588,G3972"\w* \w conversava|strong="G1256"\w* \w com eles|strong="G846"\w*, \w estando para|strong="G3195"\w* \w partir|strong="G1826"\w* \w no dia seguinte|strong="G3588,G1887"\w*, \w e|strong="G5037"\w* \w prolongou|strong="G3905"\w* \w o discurso|strong="G3588,G3056"\w* \w até a meia-noite|strong="G3360,G3317"\w*\f + \fr 20.7: \ft Variante: RP lê τῶν μαθητῶν (“os discípulos”) em vez de ἡμῶν (“nós”): “estando os discípulos reunidos”.\f*\f + \fr 20.7: \ft Lit.: τῇ μιᾷ τῶν σαββάτων: literalmente “no um dos sábados”, isto é, no primeiro dia da semana. κλάω ἄρτον: “partir o pão”.\f*.\x - \xo 20:7 \xt HEB 10:25; ACT 2:42; 1CO 16:2; ACT 2:46; MAT 26:26; PSA 118:24\x*
\v 8 \w Havia|strong="G1510,G1161"\w* \w muitas|strong="G2425"\w* \w lâmpadas|strong="G2985"\w* \w no andar de cima|strong="G1722,G3588,G5253"\w* \w onde|strong="G3757"\w* \w estávamos|strong="G1510"\w* \w reunidos|strong="G4863"\w*;\f + \fr 20.8: \ft Variante: o TR traz ἦσαν (“eles estavam”) em lugar de ἦμεν (“nós estávamos”), leitura de NA28, SBLGNT, WH, Treg e RP.\f*\x - \xo 20:8 \xt ACT 1:13; MAT 25:1; LUK 22:12; ACT 9:37\x*
\v 9 \w Ora, um certo|strong="G1161,G5100"\w* \w jovem|strong="G3494"\w*, \w de nome|strong="G3686"\w* \w Êutico|strong="G2161"\w*, \w sentado|strong="G2516"\w* \w na janela|strong="G1909,G3588,G2376"\w*, \w sendo tomado|strong="G2702"\w* \w por um sono|strong="G5258"\w* \w profundo|strong="G901"\w*, \w enquanto Paulo|strong="G3588,G3972"\w* \w discursava|strong="G1256"\w* \w por mais tempo|strong="G1909,G4119"\w*, \w vencido|strong="G2702"\w* \w pelo sono|strong="G575,G3588,G5258"\w*, \w caiu|strong="G4098"\w* \w do terceiro andar|strong="G575,G3588,G5152"\w* \w para baixo|strong="G2736"\w*, \w e|strong="G2532"\w* \w foi levantado|strong="G142"\w* \w morto|strong="G3498"\w*.\x - \xo 20:9 \xt MRK 13:36; JHN 11:44; ACT 20:7; MAT 26:40-41; JON 1:5-6; MRK 9:26\x*
\v 10 \w Paulo|strong="G1161,G3588,G3972"\w*, \w tendo descido|strong="G2597"\w*, \w lançou-se sobre ele|strong="G1968,G846"\w* \w e|strong="G2532"\w*, \w abraçando-o|strong="G4843"\w*, \w disse|strong="G2036"\w*: “\w Não se alarmem|strong="G3361,G2350"\w*, \w pois|strong="G1063"\w* \w a vida|strong="G3588,G5590"\w* \w dele|strong="G846"\w* \w está nele|strong="G1722,G846,G1510"\w*\f + \fr 20.10: \ft Lit.: ψυχή: “alma”, “vida”.\f*.”\x - \xo 20:10 \xt MAT 9:24; 1KI 17:21; MRK 5:39; JHN 11:44; 2KI 4:34; JHN 11:40\x*
\v 11 \w Tendo subido|strong="G305,G1161"\w* \w e|strong="G2532"\w* \w partido|strong="G2806"\w* \w o pão|strong="G3588,G740"\w* \w e|strong="G2532"\w* \w comido|strong="G1089"\w*, \w e tendo conversado|strong="G5037,G3656"\w* \w por bastante tempo|strong="G1909,G2425"\w* \w até o amanhecer|strong="G891,G827"\w*, \w assim|strong="G3779"\w* \w partiu|strong="G1831"\w*.\x - \xo 20:11 \xt ACT 2:42; ACT 20:7; JHN 11:44; ACT 20:2; 1CO 10:16\x*
