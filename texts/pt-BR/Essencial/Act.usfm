\v 25 \w Em desacordo|strong="G800,G1161,G1510"\w* \w uns com os outros|strong="G4314,G240"\w*, \w se retiravam|strong="G630"\w*, \w tendo dito|strong="G2036"\w* \w Paulo|strong="G3588,G3972"\w* \w uma palavra|strong="G4487,G1520"\w*: “\w Bem|strong="G2573"\w* \w falou|strong="G2980"\w* \w o Espírito|strong="G3588,G4151"\w* \w Santo|strong="G3588,G40"\w* \w por meio de Isaías|strong="G1223,G2268"\w* \w o profeta|strong="G3588,G4396"\w* \w aos pais|strong="G4314,G3588,G3962"\w* \w de vocês|strong="G4771"\w*\f + \fr 28.25: \ft Variante: RP lê ἡμῶν (“de nossos pais”) em vez de ὑμῶν (“de vocês”).\f*,\x - \xo 28:25 \xt MAT 15:7; MRK 7:6; HEB 3:7; MAT 13:14; 2TI 3:16; ISA 6:8\x*
\q1
\v 26 \w dizendo|strong="G3004"\w*: ‘\w Vá|strong="G4198"\w* \w a este povo|strong="G4314,G3588,G2992,G3778"\w* \w e|strong="G2532"\w* \w diga|strong="G2036"\w*: \w Com o ouvido|strong="G189"\w* \w ouvirão|strong="G191"\w* \w e|strong="G2532"\w* \w de modo algum|strong="G3756,G3361"\w* \w entenderão|strong="G4920"\w*, \w e|strong="G2532"\w* \w olhando|strong="G991"\w* \w verão|strong="G991"\w* \w e|strong="G2532"\w* \w de modo algum|strong="G3756,G3361"\w* \w enxergarão|strong="G1492"\w*;\f + \fr 28.26: \ft Nota cultural: citação de Is 6:9-10 (LXX); também em Mt 13:14-15 e Jo 12:40.\f*\x - \xo 28:26 \xt MAT 13:14; ISA 6:9; JHN 12:40; MRK 8:18; MRK 4:12; LUK 8:10\x*
\q1
\v 27 \w pois|strong="G1063"\w* \w se tornou insensível|strong="G3975"\w* \w o coração|strong="G3588,G2588"\w* \w deste povo|strong="G3588,G2992,G3778"\w*, \w e|strong="G2532"\w* \w com os ouvidos|strong="G3588,G3775"\w* \w pesadamente|strong="G917"\w* \w ouviram|strong="G191"\w*, \w e|strong="G2532"\w* \w os olhos|strong="G3588,G3788"\w* \w deles|strong="G846"\w* \w fecharam|strong="G2576"\w*; \w para que nunca|strong="G4218,G3361"\w* \w vejam|strong="G1492"\w* \w com os olhos|strong="G3588,G3788"\w* \w e|strong="G2532"\w* \w com os ouvidos|strong="G3588,G3775"\w* \w ouçam|strong="G191"\w* \w e|strong="G2532"\w* \w com o coração|strong="G3588,G2588"\w* \w entendam|strong="G4920"\w* \w e|strong="G2532"\w* \w se voltem|strong="G1994"\w*, \w e|strong="G2532"\w* \w eu os curarei|strong="G2390,G846"\w*\f + \fr 28.27: \ft Nota cultural: cita Is 6:9-10 (LXX). lit: ἐπαχύνθη: “engordou”, “tornou-se grosseiro, insensível”.\f*.’\x - \xo 28:27 \xt ISA 6:9; MAT 13:15; MRK 8:18; MRK 4:12; ISA 6:10; MAT 13:14\x*
