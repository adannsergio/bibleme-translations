\v 38 \w Seja conhecido|strong="G1110,G1510"\w*, \w portanto|strong="G3767"\w*, \w a vocês|strong="G4771"\w*, \w homens|strong="G435"\w* \w irmãos|strong="G80"\w*, \w que|strong="G3754"\w* \w por meio deste|strong="G1223,G3778"\w* \w a vocês|strong="G4771"\w* \w é anunciado|strong="G2605"\w* \w o perdão|strong="G859"\w* \w de pecados|strong="G266"\w*, \w e|strong="G2532"\w* \w de tudo|strong="G575,G3956"\w* \w aquilo de que|strong="G3739"\w* \w não puderam|strong="G3756,G1410"\w* \w ser declarados justos|strong="G1344"\w* \w pela lei|strong="G1722,G3551"\w* \w de Moisés|strong="G3475"\w*,\x - \xo 13:38 \xt COL 1:14; ACT 10:43; LUK 1:77; PSA 16:10; PSA 32:1; ROM 5:1\x*
