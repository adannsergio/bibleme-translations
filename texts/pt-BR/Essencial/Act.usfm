\v 40 \w Mas Paulo|strong="G3972,G1161"\w*, \w tendo escolhido|strong="G1951"\w* \w Silas|strong="G4609"\w*, \w saiu|strong="G1831"\w*, \w entregue|strong="G3860"\w* \w à graça|strong="G3588,G5485"\w* \w do Senhor|strong="G3588,G2962"\w* \w pelos irmãos|strong="G5259,G3588,G80"\w*,\f + \fr 15.40: \ft Variante: RP lê θεοῦ (“de Deus”) em vez de κυρίου (“do Senhor”).\f*\x - \xo 15:40 \xt ACT 14:26; ACT 15:22; ECC 4:9; ACT 11:23; ACT 13:3; 1CO 15:10\x*
\v 41 \w e percorria|strong="G1330,G1161"\w* \w a Síria|strong="G3588,G4947"\w* \w e|strong="G2532"\w* \w a Cilícia|strong="G3588,G2791"\w*, \w fortalecendo|strong="G1991"\w* \w as comunidades|strong="G3588,G1577"\w*.\x - \xo 15:41 \xt GAL 1:21; ACT 15:23; ACT 14:22; ACT 15:32; ACT 16:4-5; ACT 16:5\x*
\c 16
\p
\v 1 \w Chegou|strong="G2658,G1161"\w* \w também|strong="G2532"\w* \w a Derbe|strong="G1519,G1191"\w* \w e|strong="G2532"\w* \w a Listra|strong="G1519,G3082"\w*. \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w havia|strong="G1510"\w* \w ali|strong="G1563"\w* \w um certo|strong="G5100"\w* \w discípulo|strong="G3101"\w*, \w de nome|strong="G3686"\w* \w Timóteo|strong="G5095"\w*, \w filho|strong="G5207"\w* \w de uma mulher|strong="G1135"\w* \w judia|strong="G2453"\w* \w crente|strong="G4103"\w*, \w mas de pai|strong="G3962,G1161"\w* \w grego|strong="G1672"\w*\f + \fr 16.1: \ft Lit.: πιστός: “fiel”, “que crê”.\f*,\x - \xo 16:1 \xt ACT 14:6; 2TI 1:5; 1TI 1:2; 1CO 4:17; 1TH 3:2; 2TI 1:2\x*
\v 2 \w o qual|strong="G3739"\w* \w tinha bom testemunho|strong="G3140"\w* \w por parte dos|strong="G5259,G3588"\w* \w irmãos|strong="G80"\w* \w que estavam em Listra|strong="G1722,G3082"\w* \w e|strong="G2532"\w* \w Icônio|strong="G2430"\w*;\f + \fr 16.2: \ft Acréscimo: “que estavam em Listra”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 16:2 \xt ACT 14:21; 1TI 1:2; 1TH 1:1; 1TI 5:10; 1TI 5:25; 2TI 3:15\x*
\v 3 \w Paulo|strong="G3588,G3972"\w* \w quis|strong="G2309"\w* \w que este|strong="G3778"\w* \w saísse|strong="G1831"\w* \w com ele|strong="G4862,G846"\w*, \w e|strong="G2532"\w*, \w tomando-o|strong="G2983"\w*, \w circuncidou-o|strong="G4059,G846"\w* \w por causa dos judeus|strong="G1223,G3588,G2453"\w* \w que havia|strong="G3588,G1510"\w* \w nesses|strong="G1722,G3588,G1565"\w* \w lugares|strong="G5117"\w*, \w pois|strong="G1063"\w* \w todos|strong="G537"\w* \w sabiam|strong="G1492"\w* \w que|strong="G3754"\w* \w o pai|strong="G3588,G3962"\w* \w dele|strong="G846"\w* \w era|strong="G5225"\w* \w grego|strong="G1672"\w*.\x - \xo 16:3 \xt GAL 2:3; GAL 5:2; 1CO 9:20; 1TI 1:2; GAL 5:6; GAL 5:1-3\x*
\v 4 \w À medida que|strong="G5613,G1161"\w* \w atravessavam|strong="G1279"\w* \w as cidades|strong="G3588,G4172"\w*, \w entregavam-lhes|strong="G3860,G846"\w* \w as decisões|strong="G3588,G1378"\w* \w tomadas|strong="G2919"\w* \w pelos apóstolos|strong="G5259,G3588,G652"\w* \w e|strong="G2532"\w* \w anciãos|strong="G4245"\w* \w que estavam|strong="G3588,G1722"\w* \w em Jerusalém|strong="G2414"\w*, \w para que as guardassem|strong="G5442"\w*.\f + \fr 16.4: \ft Acréscimo: “que estavam”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\f + \fr 16.4: \ft Tradução: κεκριμένα (κρίνω, G2919) está aqui como “tomadas”; o termo pode ser “julgar”, “decidir”, “condenar” ou “considerar”, e o contexto decide.\f*\x - \xo 16:4 \xt ACT 15:28-29; ACT 11:30; ACT 15:41; 1CO 9:21; ACT 15:2; ACT 15:30\x*
\v 5 \w Assim, então|strong="G3303,G3767"\w*, \w as comunidades|strong="G3588,G1577"\w* \w eram fortalecidas|strong="G4732"\w* \w na fé|strong="G3588,G4102"\w* \w e|strong="G2532"\w* \w aumentavam|strong="G4052"\w* \w em número|strong="G3588,G706"\w* \w a cada dia|strong="G2596,G2250"\w*.\x - \xo 16:5 \xt ACT 2:47; ACT 9:31; ACT 6:7; 1PE 5:10; ACT 15:41; EPH 4:13-16\x*
\v 6 \w E atravessaram|strong="G1330,G1161"\w* \w a Frígia|strong="G3588,G5435"\w* \w e|strong="G2532"\w* \w a região gálata|strong="G1054,G5561"\w*, \w impedidos|strong="G2967"\w* \w pelo Espírito Santo|strong="G5259,G3588,G40,G4151"\w* \w de falar|strong="G2980"\w* \w a palavra|strong="G3588,G3056"\w* \w na Ásia|strong="G1722,G3588,G773"\w*,\x - \xo 16:6 \xt ACT 18:23; JHN 14:26; 2TI 4:10; ACT 13:2; ACT 16:7; 1PE 1:1\x*
\v 7 \w Tendo chegado|strong="G2064,G1161"\w* \w junto à Mísia|strong="G2596,G3588,G3465"\w*, \w tentavam|strong="G3985"\w* \w ir|strong="G4198"\w* \w para a Bitínia|strong="G1519,G3588,G978"\w*, \w e|strong="G2532"\w* \w o Espírito de Jesus|strong="G3588,G4151,G2424"\w* \w não lhes permitiu|strong="G3756,G1439,G846"\w*\f + \fr 16.7: \ft Variante: RP omite δέ e Ἰησοῦ (“o Espírito” em vez de “o Espírito de Jesus”), lê κατὰ em vez de εἰς e πορεύεσθαι em vez de πορευθῆναι.\f*;\x - \xo 16:7 \xt PHP 1:19; GAL 4:6; ACT 13:2; ACT 16:6; ACT 8:29; ROM 8:9\x*
\v 8 \w Passando|strong="G3928,G1161"\w* \w pela Mísia|strong="G3588,G3465"\w*, \w desceram|strong="G2597"\w* \w a Trôade|strong="G1519,G5174"\w*.\x - \xo 16:8 \xt 2CO 2:12; 2TI 4:13; ACT 20:5; ACT 16:11; PHP 2:22\x*
\v 9 \w E|strong="G2532"\w* \w uma visão|strong="G3705"\w* \w durante a noite|strong="G1223,G3571"\w* \w apareceu|strong="G3700"\w* \w a Paulo|strong="G3588,G3972"\w*: \w um certo|strong="G5100"\w* \w homem|strong="G435"\w* \w macedônio|strong="G3110"\w* \w estava|strong="G1510"\w* \w de pé|strong="G2476"\w* \w e|strong="G2532"\w* \w rogando|strong="G3870"\w* \w a ele|strong="G846"\w* \w e|strong="G2532"\w* \w dizendo|strong="G3004"\w*: “\w Passe|strong="G1224"\w* \w à Macedônia|strong="G1519,G3109"\w* \add e\add* \w ajude-nos|strong="G997,G3165"\w*.”\f + \fr 16.9: \ft Acréscimo: “e” (em “à Macedônia e ajude nos”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 16:9 \xt ACT 18:9; MAT 9:37; PSA 17:3; 2CO 8:1; ACT 18:5; ACT 19:21\x*
\v 10 \w Quando|strong="G5613,G1161"\w* \w viu|strong="G1492"\w* \w a visão|strong="G3588,G3705"\w*, \w imediatamente|strong="G2112"\w* \w procuramos|strong="G2212"\w* \w partir|strong="G1831"\w* \w para a Macedônia|strong="G1519,G3109"\w*, \w concluindo|strong="G4822"\w* \w que|strong="G3754"\w* \w nos chamou|strong="G4341,G3165"\w* \w Deus|strong="G3588,G2316"\w* \w para anunciar-lhes a boa notícia|strong="G2097,G846"\w*\f + \fr 16.10: \ft Variante: RP acrescenta o artigo τὴν diante de Μακεδονίαν e lê κύριος (“o Senhor”) em vez de θεός (“Deus”).\f*\f + \fr 16.10: \ft Lit.: a partir daqui o relato passa para a primeira pessoa do plural (“procuramos”, “nos”).\f*.\x - \xo 16:10 \xt 2CO 2:12-13; LUK 10:2; ACT 14:7; ACT 19:22; ACT 20:5; ACT 21:8\x*
\v 11 \w Tendo zarpado|strong="G321"\w*, \w então|strong="G3767"\w*, \w de Trôade|strong="G575,G5174"\w*, \w fomos em linha reta|strong="G2113"\w* \w para Samotrácia|strong="G1519,G4543"\w*, \w e no dia seguinte|strong="G3588,G1161,G1966"\w* \w para Neápolis|strong="G1519,G3501,G4172"\w*,\f + \fr 16.11: \ft Variante: NA28 lê δέ onde SBLGNT, WH, Treg e RP leem οὖν (“então”); RP acrescenta o artigo τῆς depois de ἀπό, lê τε em vez de δέ e Νεάπολιν em vez de Νέαν Πόλιν.\f*\x - \xo 16:11 \xt ACT 21:1; ACT 16:8; 2TI 4:13; ACT 20:5; PHP 2:22\x*
\v 12 \w e dali|strong="G1564,G2532"\w* \w a Filipos|strong="G1519,G5375"\w*, \w que é|strong="G3748,G1510"\w* \w a primeira|strong="G4413"\w* \w cidade|strong="G4172"\w* \w do distrito|strong="G3588,G3310"\w* \w da Macedônia|strong="G3109"\w*, \w uma colônia|strong="G2862"\w*. \w E estávamos|strong="G1510,G1161"\w* \w nesta cidade|strong="G1722,G3778,G3588,G4172"\w*, \w permanecendo|strong="G1304"\w* \w alguns|strong="G5100"\w* \w dias|strong="G2250"\w*\f + \fr 16.12: \ft Variante: A leitura “primeira cidade do distrito da Macedônia” varia: SBLGNT, WH, Treg e NIV leem πρώτη τῆς μερίδος; NA28 lê πρώτης μερίδος τῆς (“cidade do primeiro distrito”); RP lê ἐκεῖθέν τε e αὐτῇ no lugar de κἀκεῖθεν e ταύτῃ.\f*.\x - \xo 16:12 \xt ACT 20:6; PHP 1:1; 1TH 2:2; PHP 1:5; PHP 2:22\x*
\v 13 \w E|strong="G5037"\w* \w no dia|strong="G3588,G2250"\w* \w de sábado|strong="G3588,G4521"\w*, \w saímos|strong="G1831"\w* \w para fora|strong="G1854"\w* \w da porta|strong="G3588,G4439"\w* \w junto a um rio|strong="G3844,G4215"\w*, \w onde|strong="G3757"\w* \w supúnhamos|strong="G3543"\w* \w haver|strong="G1511"\w* \w um lugar de oração|strong="G4335"\w*, \w e|strong="G2532"\w*, \w sentando-nos|strong="G2523"\w*, \w falávamos|strong="G2980"\w* \w às mulheres|strong="G3588,G1135"\w* \w que se haviam reunido|strong="G4905"\w*.\f + \fr 16.13: \ft Lit.: προσευχή: “oração”; aqui, provavelmente, o lugar onde se fazia oração.\f*\f + \fr 16.13: \ft Variante: RP lê πόλεως (“cidade”) em vez de πύλης (“porta”) e ἐνομίζετο προσευχὴ (“havia costume de haver oração”) em vez de ἐνομίζομεν προσευχὴν.\f*\x - \xo 16:13 \xt PHP 1:1; 2TI 4:2; ACT 13:14; ACT 16:16; LUK 4:20; PHP 1:5\x*
\v 14 \w E|strong="G2532"\w* \w uma certa|strong="G5100"\w* \w mulher|strong="G1135"\w*, \w de nome|strong="G3686"\w* \w Lídia|strong="G3070"\w*, \w vendedora de púrpura|strong="G4211"\w* \w da cidade|strong="G4172"\w* \w de Tiatira|strong="G2363"\w*, \w que reverenciava|strong="G4576"\w* \w a Deus|strong="G3588,G2316"\w*, \w ouvia|strong="G191"\w*; \w cujo|strong="G3739"\w* \w coração|strong="G3588,G2588"\w* \w o Senhor|strong="G3588,G2962"\w* \w abriu|strong="G1272"\w* \w para dar atenção|strong="G4337"\w* \w ao que era dito|strong="G3588,G2980"\w* \w por Paulo|strong="G5259,G3588,G3972"\w*.\x - \xo 16:14 \xt LUK 24:45; EPH 1:17-18; EPH 2:8; ISA 50:5; JHN 6:44-45; PHP 1:6\x*
\v 15 \w Quando|strong="G5613,G1161"\w* \w foi batizada|strong="G907"\w* \w e|strong="G2532"\w* \w a sua casa|strong="G3588,G3624,G846"\w*, \w rogou|strong="G3870"\w* \w dizendo|strong="G3004"\w*: “\w Se|strong="G1487"\w* \w me julgaram|strong="G2919,G3165"\w* \w ser|strong="G1511"\w* \w fiel|strong="G4103"\w* \w ao Senhor|strong="G3588,G2962"\w*, \w entrem|strong="G1525"\w* \w na minha casa|strong="G1519,G3588,G3624,G3165"\w* \add e\add* \w fiquem|strong="G3306"\w*.” \w E|strong="G2532"\w* \w insistiu conosco|strong="G3849,G3165"\w*.\f + \fr 16.15: \ft Acréscimo: “e” (em “minha casa e fiquem E”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 16:15 \xt LUK 24:29; ACT 2:38; MAT 28:19; PHP 1:1; ACT 11:14; HEB 13:2\x*
\v 16 \w Aconteceu|strong="G1096,G1161"\w* \add que,\add* \w ao irmos|strong="G4198,G3165"\w* \w para o lugar de oração|strong="G1519,G3588,G4335"\w*, \w veio ao nosso encontro|strong="G5221,G3165"\w* \w uma certa|strong="G5100"\w* \w jovem escrava|strong="G3814"\w* \w que tinha|strong="G2192"\w* \w um espírito|strong="G4151"\w* \w de Píton|strong="G4436"\w*, \w a qual|strong="G3748"\w* \w dava|strong="G3930"\w* \w muito|strong="G4183"\w* \w lucro|strong="G2039"\w* \w aos seus|strong="G3588,G846"\w* \w senhores|strong="G2962"\w*, \w adivinhando|strong="G3132"\w*;\f + \fr 16.16: \ft Nota cultural: πύθων: espírito de adivinhação, associado ao oráculo de Delfos e à serpente Píton.\f*\f + \fr 16.16: \ft Acréscimo: “que” (em “Aconteceu que ao irmos”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 16:16 \xt MAT 28:19; LEV 19:31; DEU 18:9-11; ISA 8:19; HEB 10:25; 1CH 10:13\x*
\v 17 \w Esta|strong="G3778"\w*, \w seguindo|strong="G2628"\w* \w a Paulo|strong="G3588,G3972"\w* \w e|strong="G2532"\w* \w a nós|strong="G3165"\w*, \w gritava|strong="G2896"\w*, \w dizendo|strong="G3004"\w*: “\w Estes homens|strong="G3778,G3588,G444"\w* \w são|strong="G1510"\w* \w servos|strong="G1401"\w* \w do Deus|strong="G3588,G2316"\w* \w Altíssimo|strong="G3588,G5310"\w*, \w os quais|strong="G3748"\w* \w anunciam|strong="G2605"\w* \w a vocês|strong="G4771"\w* \w um caminho|strong="G3598"\w* \w de salvação|strong="G4991"\w*.”\f + \fr 16.17: \ft Variante: RP lê κατακολουθήσασα (“tendo seguido”) e ἡμῖν (“a nós”) em vez de ὑμῖν (“a vocês”).\f*\f + \fr 16.17: \ft Tradução: δοῦλοι (δοῦλος, G1401) está aqui como “servos”; o termo pode ser “escravo” (condição social), “servo” ou “servidor”, e o contexto decide.\f*\x - \xo 16:17 \xt MAT 28:19; JAS 2:19; ACT 19:15; JHN 14:6; 1PE 2:16; MRK 5:7\x*
\v 18 \w E isto|strong="G3778,G1161"\w* \w ela fazia|strong="G4160"\w* \w por muitos|strong="G1909,G4183"\w* \w dias|strong="G2250"\w*. \w Mas Paulo|strong="G1161,G3972"\w*, \w irritado|strong="G1278"\w* \w e|strong="G2532"\w* \w voltando-se|strong="G1994"\w* \w para o espírito|strong="G3588,G4151"\w*, \w disse|strong="G2036"\w*: “\w Ordeno-lhe|strong="G3853,G4771"\w* \w em nome|strong="G1722,G3686"\w* \w de Jesus|strong="G2424"\w* \w Cristo|strong="G5547"\w* \w que saia|strong="G1831"\w* \w dela|strong="G575,G846"\w*.” \w E|strong="G2532"\w* \w saiu|strong="G1831"\w* \w na mesma|strong="G846,G3588"\w* \w hora|strong="G5610"\w*.\x - \xo 16:18 \xt JHN 14:12; MAT 28:19; MRK 16:17; ACT 3:6; ACT 3:16; ACT 19:11\x*
\v 19 \w Mas vendo|strong="G1492,G1161"\w* \w os seus senhores|strong="G3588,G2962,G846"\w* \w que|strong="G3754"\w* \w saiu|strong="G1831"\w* \w a esperança|strong="G3588,G1680"\w* \w do seu lucro|strong="G3588,G2039,G846"\w*, \w agarrando|strong="G1949"\w* \w a Paulo|strong="G3588,G3972"\w* \w e|strong="G2532"\w* \w a Silas|strong="G3588,G4609"\w*, \w arrastaram|strong="G1670"\w* \w até a praça|strong="G1519,G3588,G58"\w* \w diante das autoridades|strong="G1909,G3588,G758"\w*,\x - \xo 16:19 \xt ACT 21:30; MAT 28:19; ACT 17:6; PHP 1:30; 2CO 6:5; ACT 16:16\x*
\v 20 \w e|strong="G2532"\w*, \w tendo-os levado|strong="G4317,G846"\w* \w aos magistrados|strong="G3588,G4755"\w*, \w disseram|strong="G2036"\w*: “\w Estes homens|strong="G3778,G3588,G444"\w* \w perturbam|strong="G1613"\w* \w a nossa cidade|strong="G3165,G3588,G4172"\w*, \w sendo|strong="G5225"\w* \w judeus|strong="G2453"\w*;\x - \xo 16:20 \xt MAT 28:19; ACT 17:6; PHP 1:30; EST 3:8; 1KI 18:17; JAS 4:4\x*
\q1
\v 21 \w e|strong="G2532"\w* \w anunciam|strong="G2605"\w* \w costumes|strong="G1485"\w* \w que não nos é permitido|strong="G3739,G3756,G1832,G3165"\w* \w aceitar|strong="G3858"\w* \w nem|strong="G3761"\w* \w praticar|strong="G4160"\w*, \w sendo|strong="G1510"\w* \w romanos|strong="G4514"\w*.”\x - \xo 16:21 \xt MAT 28:19; ACT 17:6; PHP 1:30; EST 3:8; ACT 17:7; LUK 23:2\x*
\v 22 \w E|strong="G2532"\w* \w a multidão|strong="G3588,G3793"\w* \w se levantou|strong="G4911"\w* \w contra eles|strong="G2596,G846"\w*, \w e|strong="G2532"\w* \w os magistrados|strong="G3588,G4755"\w*, \w tendo rasgado|strong="G4048"\w* \w as vestes|strong="G3588,G2440"\w* \w deles|strong="G846"\w*, \w ordenaram|strong="G2753"\w* \w açoitá-los com varas|strong="G4463"\w*,\x - \xo 16:22 \xt MAT 28:19; 1TH 2:2; PHP 1:30; 2CO 6:5; 2CO 11:23-25; ACT 22:22-26\x*
\v 23 \w E, depois de lhes aplicarem|strong="G5037,G2007,G846"\w* \w muitos|strong="G4183"\w* \w golpes|strong="G4127"\w*, \w lançaram-nos|strong="G906"\w* \w na prisão|strong="G1519,G5438"\w*, \w ordenando|strong="G3853"\w* \w ao carcereiro|strong="G3588,G1200"\w* \w que os guardasse|strong="G5083,G846"\w* \w com segurança|strong="G806"\w*;\x - \xo 16:23 \xt MAT 28:19; PHP 1:30; 1TH 2:2; PHP 1:7; REV 2:10; ACT 5:41\x*
\v 24 \w o qual|strong="G3739"\w*, \w tendo recebido|strong="G2983"\w* \w tal|strong="G5108"\w* \w ordem|strong="G3852"\w*, \w os lançou|strong="G906,G846"\w* \w na prisão|strong="G1519,G3588,G5438"\w* \w mais interna|strong="G2082"\w*, \w e|strong="G2532"\w* \w prendeu|strong="G805"\w* \w os pés|strong="G3588,G4228"\w* \w deles|strong="G846"\w* \w no tronco|strong="G1519,G3588,G3586"\w*.\f + \fr 16.24: \ft Lit.: ξύλον: “madeira”, “tronco” (instrumento de prisão).\f*\x - \xo 16:24 \xt MAT 28:19; JAS 5:13; PHP 1:30; 1TH 2:2; JOB 13:27; JOB 33:11\x*
