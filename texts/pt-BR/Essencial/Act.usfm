\v 20 \w Ora, ele estava|strong="G1510,G1161"\w* \w irado|strong="G2371"\w* \w com os de Tiro|strong="G5183"\w* \w e|strong="G2532"\w* \w de Sidom|strong="G4606"\w*; \w mas|strong="G1161"\w* \w unânimes|strong="G3661"\w* \w se apresentaram|strong="G3918"\w* \w a ele|strong="G4314,G846"\w*, \w e|strong="G2532"\w*, \w tendo persuadido|strong="G3982"\w* \w Blasto|strong="G986"\w*, \w o camareiro|strong="G3588,G1909,G2846"\w* \w do rei|strong="G3588,G935"\w*, \w pediam|strong="G154"\w* \w paz|strong="G1515"\w*, \w porque|strong="G1223,G3588"\w* \w a sua região|strong="G846,G3588,G5561"\w* \w era alimentada|strong="G5142"\w* \w pelo território real|strong="G575,G3588,G937"\w*.\f + \fr 12.20: \ft Variante: RP e TR acrescentam “Herodes” como sujeito depois de δέ.\f*\x - \xo 12:20 \xt PSA 68:6; EZR 3:7; 1KI 5:9; EZK 27:17; MAT 11:21; PSA 102:2\x*
