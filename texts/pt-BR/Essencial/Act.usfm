\v 1 \add Enquanto\add* \w eles|strong="G846"\w* \w falavam|strong="G2980"\w* \w ao povo|strong="G4314,G3588,G2992"\w*, \w aproximaram-se|strong="G2186"\w* \w deles|strong="G846"\w* \w os sacerdotes|strong="G3588,G2409"\w*, \w e|strong="G2532"\w* \w o comandante|strong="G3588,G4755"\w* \w do templo|strong="G3588,G2411"\w*, \w e|strong="G2532"\w* \w os saduceus|strong="G3588,G4523"\w*\f + \fr 4.1: \ft Variante: o SBLGNT, com Treg, NA28 e RP, traz ἱερεῖς (“sacerdotes”); WH traz ἀρχιερεῖς (“chefes dos sacerdotes”).\f*,\f + \fr 4.1: \ft Acréscimo: “Enquanto” (em “Enquanto eles falavam”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 4:1 \xt ACT 5:24; LUK 20:27; LUK 22:4; ACT 23:6-9; ACT 6:12; ACT 5:26\x*
