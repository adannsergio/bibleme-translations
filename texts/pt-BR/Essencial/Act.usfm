\v 15 \w de modo que|strong="G5620"\w* \w até|strong="G2532"\w* \w levavam|strong="G1627"\w* \w os doentes|strong="G3588,G772"\w* \w para as ruas|strong="G1519,G3588,G4113"\w* \w e|strong="G2532"\w* \w os colocavam|strong="G5087"\w* \w em leitos|strong="G1909,G6055"\w* \w e|strong="G2532"\w* \w macas|strong="G2895"\w*, \w para que|strong="G2443"\w*, \w quando Pedro passasse|strong="G2064,G4074"\w*, \w ao menos|strong="G1437,G2532"\w* \w a sombra|strong="G3588,G4639"\w* \w cobrisse|strong="G1982"\w* \w algum|strong="G5100"\w* \w deles|strong="G846"\w*.\x - \xo 5:15 \xt JHN 14:12; MRK 16:18; ACT 19:12; MAT 10:8; ACT 19:11-12; MAT 14:36\x*
