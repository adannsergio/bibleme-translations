\v 34 \w por isso|strong="G1352"\w* \w exorto|strong="G3870"\w* \w vocês|strong="G4771"\w* \w a tomar|strong="G3335"\w* \w alimento|strong="G5160"\w*, \w pois|strong="G1063"\w* \w isto|strong="G3778"\w* \w é em vista da|strong="G4314,G3588,G5225"\w* \w sobrevivência de vocês|strong="G4771,G4991"\w*; \w pois|strong="G1063"\w* \w de nenhum|strong="G3762"\w* \w de vocês|strong="G4771"\w* \w um fio de cabelo|strong="G2359"\w* \w da cabeça|strong="G575,G3588,G2776"\w* \w se perderá|strong="G622"\w*\f + \fr 27.34: \ft Variante: RP lê προσλαβεῖν em vez de μεταλαβεῖν, ἐκ em vez de ἀπό e πεσεῖται (“cairá”) em vez de ἀπολεῖται (“se perderá”).\f*.”\x - \xo 27:34 \xt LUK 21:18; MAT 10:30; 1SA 14:45; 1KI 1:52; ACT 27:22; MAT 8:24\x*
\v 35 \w Tendo dito|strong="G2036,G1161"\w* \w isto|strong="G3778"\w* \w e|strong="G2532"\w* \w tomado|strong="G2983"\w* \w pão|strong="G740"\w*, \w deu graças|strong="G2168"\w* \w a Deus|strong="G3588,G2316"\w* \w diante de todos|strong="G1799,G3956"\w* \w e|strong="G2532"\w*, \w tendo partido|strong="G2806"\w*, \w começou|strong="G757"\w* \w a comer|strong="G2068"\w*.\x - \xo 27:35 \xt MAT 15:36; MRK 14:22; MAT 26:26; LUK 24:30; LUK 22:19; 1CO 15:57\x*
\v 36 \w Ficando animados|strong="G2115,G1161,G1096"\w* \w todos|strong="G3956"\w*, \w também|strong="G2532"\w* \w eles mesmos|strong="G846"\w* \w tomaram|strong="G4355"\w* \w alimento|strong="G5160"\w*.\x - \xo 27:36 \xt ACT 27:22; MAT 8:24; 2CO 1:4-6; 2CO 11:25; PSA 27:14\x*
\v 37 \w Éramos|strong="G1510,G1161"\w* \w ao todo|strong="G3588,G3956"\w* \w pessoas|strong="G5590"\w* \w no navio|strong="G1722,G3588,G4143"\w*, \w duzentas|strong="G1250"\w* \w e setenta|strong="G1440"\w* \w e seis|strong="G1803"\w*\f + \fr 27.37: \ft Variante: RP inverte a ordem de “ao todo pessoas no navio”; WH lê ὡς (“cerca de”) onde Treg, NA28 e RP leem διακόσιαι (“duzentas”).\f*.\f + \fr 27.37: \ft Tradução: ψυχαὶ (ψυχή, G5590) está aqui como “pessoas”; o termo pode ser “alma”, “vida”, “pessoa” ou “ser vivo”, e o contexto decide.\f*\x - \xo 27:37 \xt ACT 7:14; ACT 27:24; MAT 8:24; ACT 2:41; 1PE 3:20; 2CO 11:25\x*
\v 38 \w Saciados|strong="G2880,G1161"\w* \w de alimento|strong="G5160"\w*, \w aliviavam|strong="G2893"\w* \w o navio|strong="G3588,G4143"\w*, \w lançando|strong="G1544"\w* \w o trigo|strong="G3588,G4621"\w* \w ao mar|strong="G1519,G3588,G2281"\w*.\x - \xo 27:38 \xt ACT 27:18; MAT 8:24; JON 1:5; MAT 6:25; 2CO 11:25; ECC 3:6\x*
\v 39 \w Quando|strong="G3753,G1161"\w* \w amanheceu|strong="G2250,G1096"\w*, \w a terra|strong="G3588,G1093"\w* \w não reconheciam|strong="G3756,G1921"\w*, \w mas uma certa|strong="G1161,G5100"\w* \w baía|strong="G2859"\w* \w observavam|strong="G2657"\w* \w que tinha|strong="G2192"\w* \w praia|strong="G123"\w*, \w na qual|strong="G1519,G3739"\w* \w deliberaram|strong="G1011"\w* \w se pudessem|strong="G1487,G1410"\w* \w impelir|strong="G1856"\w* \w o navio|strong="G3588,G4143"\w*\f + \fr 27.39: \ft Variante: RP lê ἐβουλεύσαντο e δυνατόν; WH lê ἐκσῶσαι (“salvar”) onde Treg, NA28 e RP leem ἐξῶσαι (“impelir”).\f*.\x - \xo 27:39 \xt 2CO 11:25; ACT 28:1\x*
\v 40 \w E|strong="G2532"\w*, \w tendo soltado|strong="G4014"\w* \w as âncoras|strong="G3588,G45"\w*, \w as deixaram|strong="G1439"\w* \w no mar|strong="G1519,G3588,G2281"\w*, \w ao mesmo tempo|strong="G260"\w* \w desatando|strong="G447"\w* \w as amarras|strong="G3588,G2202"\w* \w dos lemes|strong="G3588,G4079"\w*, \w e|strong="G2532"\w*, \w içando|strong="G1869"\w* \w a vela de proa|strong="G3588,G736"\w* \w ao vento|strong="G3588,G4154"\w*, \w dirigiam-se|strong="G2722"\w* \w para a praia|strong="G1519,G3588,G123"\w*.\x - \xo 27:40 \xt HEB 6:19; 2CO 11:25; ACT 27:29\x*
\v 41 \w Tendo caído|strong="G4045,G1161"\w* \w num lugar|strong="G1519,G5117"\w* \w entre dois mares|strong="G1337"\w*, \w encalharam|strong="G2027"\w* \w o navio|strong="G3588,G3491"\w*, \w e|strong="G2532"\w* \w a proa|strong="G3588,G3303,G4408"\w*, \w tendo-se cravado|strong="G2043"\w*, \w permaneceu|strong="G3306"\w* \w imóvel|strong="G761"\w*, \w mas a popa|strong="G3588,G1161,G4403"\w* \w se desfazia|strong="G3089"\w* \w pela violência|strong="G5259,G3588,G970"\w*.\x - \xo 27:41 \xt ACT 27:10; 2CO 11:25; ACT 27:17; EZK 27:26\x*
\v 42 \w Dos soldados|strong="G3588,G1161,G4757"\w* \w houve|strong="G1096"\w* \w um plano|strong="G1012"\w* \w de que matassem|strong="G2443,G615"\w* \w os prisioneiros|strong="G3588,G1202"\w*, \w para que ninguém|strong="G3361,G5100"\w*, \w tendo escapado a nado|strong="G1579"\w*, \w fugisse|strong="G1309"\w*;\x - \xo 27:42 \xt 1PE 4:18; ACT 27:10; ACT 26:17\x*
\v 43 \w Mas o centurião|strong="G3588,G1161,G1543"\w*, \w querendo|strong="G1014"\w* \w salvar|strong="G1295"\w* \w Paulo|strong="G3588,G3972"\w*, \w os impediu|strong="G2967,G846"\w* \w do propósito|strong="G3588,G1013"\w*, \w e|strong="G5037"\w* \w mandou|strong="G2753"\w* \w que os que podiam|strong="G3588,G1410"\w* \w nadar|strong="G2860"\w*, \w tendo-se lançado|strong="G641"\w* \w primeiro|strong="G4413"\w*, \w saíssem|strong="G1826"\w* \w para a terra|strong="G1909,G3588,G1093"\w*,\x - \xo 27:43 \xt MAT 8:5; 1PE 4:18; ACT 22:25; ACT 27:10; ACT 27:3; ACT 10:1\x*
