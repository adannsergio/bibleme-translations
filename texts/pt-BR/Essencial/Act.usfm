\p
\v 1 \w Tendo passado por|strong="G1353,G1161"\w* \w Anfípolis|strong="G3588,G295"\w* \w e|strong="G2532"\w* \w Apolônia|strong="G3588,G624"\w*, \w chegaram|strong="G2064"\w* \w a Tessalônica|strong="G1519,G2332"\w*, \w onde|strong="G3699"\w* \w havia|strong="G1510"\w* \w uma sinagoga|strong="G4864"\w* \w dos judeus|strong="G3588,G2453"\w*.\x - \xo 17:1 \xt 1TH 1:1; PHP 4:16; 2TH 1:1; ACT 20:4; 2TI 4:10; ACT 17:11\x*
\v 2 \w Conforme|strong="G2596,G1161"\w* \w o costume|strong="G3588,G1486"\w* \w de Paulo|strong="G3588,G3972"\w*, \w entrou|strong="G1525"\w* \w onde estavam eles|strong="G4314,G846"\w*, \w e|strong="G2532"\w* \w por três|strong="G1909,G5140"\w* \w sábados|strong="G4521"\w* \w debateu|strong="G1256"\w* \w com eles|strong="G846"\w* \w a partir das Escrituras|strong="G575,G3588,G1124"\w*,\f + \fr 17.2: \ft Acréscimo: “onde estavam eles”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 17:2 \xt LUK 4:16; ACT 18:4; ISA 1:18; ACT 13:14; ACT 28:23; ACT 3:18\x*
\v 3 \w abrindo|strong="G1272"\w* \w e|strong="G2532"\w* \w expondo|strong="G3908"\w* \w que|strong="G3754"\w* \w era necessário|strong="G1163"\w* \w que o Cristo|strong="G3588,G5547"\w* \w sofresse|strong="G3958"\w* \w e|strong="G2532"\w* \w ressuscitasse|strong="G450"\w* \w dentre os mortos|strong="G1537,G3498"\w*, \w e|strong="G2532"\w* \w que|strong="G3754"\w* \w este é|strong="G3778,G1510"\w* \w o Cristo|strong="G3588,G5547"\w*, \w Jesus|strong="G3588,G2424"\w* \w a quem|strong="G3739"\w* \w eu|strong="G1473"\w* \w anuncio|strong="G2605"\w* \w a vocês|strong="G4771"\w*.\x - \xo 17:3 \xt LUK 24:46; LUK 24:26; LUK 2:11; ACT 18:28; ACT 18:5; ACT 9:22\x*
\v 4 \w E|strong="G2532"\w* \w alguns|strong="G5100"\w* \w deles|strong="G1537,G846"\w* \w foram persuadidos|strong="G3982"\w* \w e|strong="G2532"\w* \w se uniram|strong="G4345"\w* \w a Paulo|strong="G3588,G3972"\w* \w e|strong="G2532"\w* \w a Silas|strong="G3588,G4609"\w*, \w e também|strong="G3588,G5037"\w* \w uma grande|strong="G4183"\w* \w multidão|strong="G4128"\w* \w dos gregos|strong="G1672"\w* \w que reverenciavam a Deus|strong="G4576"\w*, \w e mulheres|strong="G1135,G5037"\w* \w das principais|strong="G3588,G4413"\w* \w em número não pequeno|strong="G3756,G3641"\w*.\x - \xo 17:4 \xt ACT 14:1; ACT 17:12; 1TH 2:2; ACT 13:43; ACT 14:4; ACT 28:24\x*
\v 5 \w Mas tomados de ciúme|strong="G2206,G1161"\w*, \w os judeus|strong="G3588,G2453"\w*, \w e|strong="G2532"\w* \w tendo recrutado|strong="G4355"\w* \w alguns|strong="G5100"\w* \w homens|strong="G435"\w* \w maus|strong="G4190"\w* \w dentre os da praça|strong="G3588,G60"\w*, \w e|strong="G2532"\w* \w tendo formado um tumulto|strong="G3792"\w*, \w alvoroçavam|strong="G2350"\w* \w a cidade|strong="G3588,G4172"\w*; \w e|strong="G2532"\w*, \w tendo assaltado|strong="G2186"\w* \w a casa|strong="G3588,G3614"\w* \w de Jasão|strong="G2394"\w*, \w procuravam|strong="G2212"\w* \w levá-los|strong="G846,G4254"\w* \w diante do povo|strong="G1519,G3588,G1218"\w*;\f + \fr 17.5: \ft Lit.: ζηλόω: “ter zelo”, “ter ciúme”, “ter inveja”.\f*\f + \fr 17.5: \ft Variante: RP e TR trazem uma frase de abertura diferente (“Mas os judeus desobedientes, tendo recrutado…”), com ἀπειθοῦντες (“desobedientes”); RP também troca a ordem de “alguns homens” e lê ἀγαγεῖν em vez de προαγαγεῖν.\f*\x - \xo 17:5 \xt ACT 14:2; PSA 2:1; ACT 17:13; GAL 5:26; ACT 5:17; 1TH 2:14\x*
\q1
\v 6 \w mas não os achando|strong="G3361,G2147,G1161,G846"\w*, \w arrastaram|strong="G4951"\w* \w Jasão|strong="G2394"\w* \w e|strong="G2532"\w* \w alguns|strong="G5100"\w* \w irmãos|strong="G80"\w* \w diante dos politarcas|strong="G1909,G3588,G4173"\w*, \w gritando|strong="G994"\w*: “\w Estes|strong="G3778"\w*, \w que subverteram|strong="G3588,G387"\w* \w o mundo habitado|strong="G3588,G3625"\w*, \w também|strong="G2532"\w* \w aqui|strong="G1759"\w* \w estão|strong="G3918"\w*,\f + \fr 17.6: \ft Nota cultural: πολιτάρχης: título dos magistrados de Tessalônica. lit: οἰκουμένη: “terra habitada”.\f*\x - \xo 17:6 \xt MAT 24:14; ACT 24:5; ACT 16:19; LUK 23:2; ACT 28:22; MAT 2:3\x*
\q1
\v 7 \w a quem|strong="G3739"\w* \w acolheu|strong="G5264"\w* \w Jasão|strong="G2394"\w*; \w e|strong="G2532"\w* \w todos estes|strong="G3778,G3956"\w* \w agem|strong="G4238"\w* \w contra os decretos|strong="G561,G3588,G1378"\w* \w de César|strong="G2541"\w*, \w dizendo|strong="G3004"\w* \w que outro|strong="G2087"\w* \w rei|strong="G935"\w* \w existe|strong="G1511"\w*, \w Jesus|strong="G2424"\w*.”\x - \xo 17:7 \xt LUK 23:2; MAT 2:3; 1TH 2:2; ACT 16:21; ACT 17:5; DAN 3:12\x*
\v 8 \w Perturbaram|strong="G5015,G1161"\w* \w a multidão|strong="G3588,G3793"\w* \w e|strong="G2532"\w* \w os politarcas|strong="G3588,G4173"\w* \w que ouviam|strong="G191"\w* \w estas coisas|strong="G3778"\w*,\x - \xo 17:8 \xt 1TH 2:2; JER 15:10; JHN 11:48; MAT 2:3\x*
\v 9 \w e|strong="G2532"\w*, \w tendo recebido|strong="G2983"\w* \w a fiança|strong="G3588,G2425"\w* \w de Jasão|strong="G3844,G3588,G2394"\w* \w e|strong="G2532"\w* \w dos demais|strong="G3588,G3062"\w*, \w os soltaram|strong="G630,G846"\w*.\f + \fr 17.9: \ft Lit.: τὸ ἱκανόν: “o suficiente”, isto é, uma garantia ou fiança.\f*\x - \xo 17:9 \xt 1TH 2:2; 1CO 2:3; 1TH 1:6\x*
\v 10 \w Mas os irmãos|strong="G3588,G1161,G80"\w*, \w imediatamente|strong="G2112"\w*, \w durante a noite|strong="G1223,G3571"\w*, \w enviaram|strong="G1599"\w* \w tanto Paulo|strong="G3588,G5037,G3972"\w* \w quanto|strong="G2532"\w* \w Silas|strong="G3588,G4609"\w* \w para Beroia|strong="G1519,G960"\w*; \w os quais|strong="G3748"\w*, \w tendo chegado|strong="G3854"\w*, \w foram|strong="G549"\w* \w à sinagoga|strong="G1519,G3588,G4864"\w* \w dos judeus|strong="G3588,G2453"\w*.\x - \xo 17:10 \xt ACT 17:14; 1TH 2:2; ACT 17:13-14; ACT 17:2; MAT 10:23; 1TH 2:17\x*
\v 11 \w Estes, porém|strong="G3778,G1161"\w*, \w eram|strong="G1510"\w* \w mais nobres|strong="G2104"\w* \w do que os|strong="G3588"\w* \w de Tessalônica|strong="G1722,G2332"\w*, \w os quais|strong="G3748"\w* \w receberam|strong="G1209"\w* \w a palavra|strong="G3588,G3056"\w* \w com toda|strong="G3326,G3956"\w* \w disposição|strong="G4288"\w*, \w examinando|strong="G350"\w* \w todo dia|strong="G3588,G2596,G2250"\w* \w as Escrituras|strong="G3588,G1124"\w* \w para ver se|strong="G1487"\w* \w estas coisas|strong="G3778"\w* \w se achavam|strong="G2192"\w* \w assim|strong="G3779"\w*.\f + \fr 17.11: \ft Lit.: εὐγενής: “bem nascido”, “de nobre caráter”.\f*\x - \xo 17:11 \xt ISA 34:16; PRO 2:1-5; JHN 5:39; MRK 4:24; 1TH 5:21; 1TH 2:13\x*
