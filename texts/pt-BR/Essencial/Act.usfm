\v 1 \w O primeiro|strong="G3588,G4413"\w* \w relato|strong="G3056"\w* \w fiz|strong="G4160"\w* \w sobre todas as coisas|strong="G4012,G3956"\w*, \w ó|strong="G5599"\w* \w Teófilo|strong="G2321"\w*, \w que|strong="G3739"\w* \w Jesus|strong="G3588,G2424"\w* \w começou|strong="G757"\w* \w a fazer|strong="G4160"\w* \w e|strong="G5037,G2532"\w* \w a ensinar|strong="G1321"\w*\f + \fr 1.1: \ft Lit.: λόγος: “relato”, “tratado”, “palavra”.\f*\x - \xo 1:1 \xt LUK 1:3; LUK 1:1; LUK 24:19; MAT 4:23-24; LUK 3:23; 1PE 2:21-23\x*
\v 2 \w até o dia|strong="G891,G2250"\w* \w em que|strong="G3739"\w* \w foi elevado|strong="G353"\w*, \w depois de dar instruções|strong="G1781"\w* \w aos apóstolos|strong="G3588,G652"\w* \w que escolheu|strong="G3739,G1586"\w* \w pelo Espírito Santo|strong="G1223,G4151,G40"\w*;\x - \xo 1:2 \xt LUK 6:13; LUK 1:1; ACT 1:9; MAT 24:14; ACT 10:38; HEB 9:24\x*
\v 3 \w aos quais|strong="G3739"\w* \w também|strong="G2532"\w* \w se apresentou|strong="G3936"\w* \w vivo|strong="G2198"\w* \w a si mesmo|strong="G1438"\w*, \w depois de|strong="G3326,G3588"\w* \w ele sofrer|strong="G3958,G846"\w*, \w com muitas|strong="G1722,G4183"\w* \w provas|strong="G5039"\w*, \w durante quarenta dias|strong="G1223,G2250,G5062"\w* \w aparecendo|strong="G3700"\w* \w a eles|strong="G846"\w* \w e|strong="G2532"\w* \w falando|strong="G3004"\w* \w das coisas|strong="G3588"\w* \w sobre o reino|strong="G4012,G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w*;\x - \xo 1:3 \xt 1CO 15:5; 1JN 1:1; ACT 13:31; LUK 1:1; JHN 20:26; ACT 8:12\x*
\q1
\v 4 \w e|strong="G2532"\w* \w comendo com eles|strong="G4871"\w*, \w ordenou-lhes|strong="G3853,G846"\w* \w que não se afastassem|strong="G3361,G5563"\w* \w de Jerusalém|strong="G575,G2414"\w*, \w mas|strong="G235"\w* \w aguardassem|strong="G4037"\w* \w a promessa|strong="G3588,G1860"\w* \w do Pai|strong="G3588,G3962"\w*, “\w que|strong="G3739"\w* \w ouviram|strong="G191"\w* \w de mim|strong="G3165"\w*:\f + \fr 1.4: \ft Lit.: συναλίζομαι: “comer sal junto”, “comer com”, “reunir-se com”.\f*\x - \xo 1:4 \xt 1CO 7:10; LUK 24:49; JHN 14:16; JHN 15:26; JHN 16:7; REV 22:1\x*
\q1
\v 5 \w porque|strong="G3754"\w* \w João|strong="G2491"\w* \w batizou|strong="G907"\w* \w com água|strong="G5204"\w*, \w mas|strong="G1161"\w* \w vocês|strong="G4771"\w* \w serão batizados|strong="G907"\w* \w no Espírito|strong="G1722,G4151"\w* \w Santo|strong="G40"\w* \w não depois de muitos|strong="G3756,G3326,G4183"\w* \w destes|strong="G3778"\w* \w dias|strong="G2250"\w*.”\f + \fr 1.5: \ft Lit.: ἐν πνεύματι ἁγίῳ: “no”, “com” ou “pelo” Espírito Santo; as traduções variam.\f*\x - \xo 1:5 \xt MRK 1:8; ACT 11:16; JHN 1:26; LUK 3:16; MAT 3:11; JHN 1:33\x*
\v 6 \w Então|strong="G3767"\w* \w os que|strong="G3588"\w* \w se haviam reunido|strong="G4905"\w* \w perguntavam|strong="G2065"\w* \w a ele|strong="G846"\w*, \w dizendo|strong="G3004"\w*: “\w Senhor|strong="G2962"\w*, \w é|strong="G1487"\w* \w neste tempo|strong="G1722,G3588,G5550,G3778"\w* \w que você restaura|strong="G600"\w* \w o reino|strong="G3588,G932"\w* \w a Israel|strong="G3588,G2474"\w*?”\f + \fr 1.6: \ft Acréscimo: verbo ser/estar suprido em “é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:6 \xt MAT 17:11; LUK 19:11; DAN 7:27; LUK 17:20; MAT 24:3; EZK 37:24-27\x*
\q1
\v 7 \w Mas ele disse|strong="G2036,G1161"\w* \w a eles|strong="G4314,G846"\w*: “\w Não cabe|strong="G3756,G1510"\w* \w a vocês|strong="G4771"\w* \w saber|strong="G1097"\w* \w tempos|strong="G5550"\w* \w ou|strong="G2228"\w* \w épocas|strong="G2540"\w* \w que|strong="G3739"\w* \w o Pai|strong="G3588,G3962"\w* \w fixou|strong="G5087"\w* \w por sua própria|strong="G1722,G3588,G2398"\w* \w autoridade|strong="G1849"\w*,\f + \fr 1.7: \ft Tradução: καιροὺς (καιρός, G2540) está aqui como “épocas”; o termo pode ser “tempo”, “ocasião”, “momento certo” ou “oportunidade”, e o contexto decide.\f*\x - \xo 1:7 \xt 1TH 5:1; DEU 29:29; JHN 7:6; MAT 24:36; PSA 31:15; HAB 2:3\x*
\q1
\v 8 \w mas|strong="G235"\w* \w receberão|strong="G2983"\w* \w poder|strong="G1411"\w* \w quando vier|strong="G1904"\w* \w sobre vocês|strong="G1909,G4771"\w* \w o Espírito Santo|strong="G3588,G40,G4151"\w*, \w e|strong="G2532"\w* \w serão|strong="G1510"\w* \w minhas|strong="G3165"\w* \w testemunhas|strong="G3144"\w* \w tanto em|strong="G1722,G5037"\w* \w Jerusalém|strong="G2419"\w*, \w e|strong="G2532"\w* \w em toda|strong="G1722,G3956"\w* \w a Judeia|strong="G3588,G2449"\w* \w e|strong="G2532"\w* \w Samaria|strong="G4540"\w*, \w e|strong="G2532"\w* \w até|strong="G2193"\w* \w o fim|strong="G2078"\w* \w da terra|strong="G3588,G1093"\w*.”\f + \fr 1.8: \ft Variante: o RP traz μοι (“para mim”) em lugar de μου.\f*\x - \xo 1:8 \xt 2TI 1:7; ACT 4:33; MRK 16:15; MAT 28:19; ROM 15:19; ACT 5:32\x*
\v 9 \w E|strong="G2532"\w* \w depois de dizer|strong="G2036"\w* \w estas coisas|strong="G3778"\w*, \w enquanto eles olhavam|strong="G991,G846"\w*, \w foi elevado|strong="G1869"\w*, \w e|strong="G2532"\w* \w uma nuvem|strong="G3507"\w* \w o recolheu|strong="G5274,G846"\w* \w dos olhos|strong="G575,G3588,G3788"\w* \w deles|strong="G846"\w*.\x - \xo 1:9 \xt REV 1:7; DAN 7:13; LUK 24:50-51; 1TH 4:17; MRK 16:19; ACT 1:2\x*
\v 10 \w E|strong="G2532"\w* \w enquanto|strong="G5613"\w* \w estavam|strong="G1510"\w* \w com os olhos fixos|strong="G816"\w* \w no céu|strong="G1519,G3588,G3772"\w* \w enquanto ele ia|strong="G4198,G846"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w dois homens|strong="G435,G1417"\w* \w estavam ao lado|strong="G3936"\w* \w deles|strong="G846"\w* \w com roupas|strong="G1722,G2066"\w* \w brancas|strong="G3022"\w*,\x - \xo 1:10 \xt LUK 24:4; REV 1:7; JHN 1:51; JHN 20:12; MRK 14:62; MAT 28:3\x*
\v 11 \w os quais|strong="G3739"\w* \w também|strong="G2532"\w* \w disseram|strong="G2036"\w*: “\w Homens|strong="G435"\w* \w galileus|strong="G1057"\w*, \w por que|strong="G5101"\w* \w estão parados|strong="G2476"\w* \w olhando|strong="G991"\w* \w para o céu|strong="G1519,G3588,G3772"\w*? \w Este|strong="G3778"\w* \w Jesus|strong="G3588,G2424"\w*, \w que foi elevado|strong="G3588,G353"\w* \w de vocês|strong="G575,G4771"\w* \w para o céu|strong="G1519,G3588,G3772"\w*, \w assim|strong="G3779"\w* \w virá|strong="G2064"\w* \w do mesmo modo que|strong="G3739,G5158"\w* \w o viram|strong="G2300,G846"\w* \w indo|strong="G4198"\w* \w para o céu|strong="G1519,G3588,G3772"\w*.”\f + \fr 1.11: \ft Variante: o SBLGNT, com WH e Treg, traz βλέποντες; a NA28 e o RP trazem ἐμβλέποντες (“olhando fixamente”).\f*\x - \xo 1:11 \xt REV 1:7; 1TH 4:16; MRK 13:26; JHN 14:3; MAT 24:30; DAN 7:13-14\x*
\v 12 \w Então|strong="G5119"\w* \w voltaram|strong="G5290"\w* \w a Jerusalém|strong="G1519,G2419"\w* \w do monte|strong="G575,G3735"\w* \w chamado|strong="G3588,G2564"\w* \w das Oliveiras|strong="G1638"\w*, \w que|strong="G3739"\w* \w está|strong="G1510"\w* \w perto|strong="G1451"\w* \w de Jerusalém|strong="G2419"\w*, \w à distância|strong="G2192"\w* \w de um sábado|strong="G4521"\w* \w de caminho|strong="G3598"\w*.\f + \fr 1.12: \ft Lit.: σαββάτου ἔχον ὁδόν: “à distância de uma caminhada de sábado”, isto é, a distância permitida de caminhada no sábado.\f*\x - \xo 1:12 \xt LUK 21:37; LUK 19:29; LUK 24:52; ZEC 14:4; MAT 21:1; LUK 24:50\x*
\v 13 \w E|strong="G2532"\w* \w quando entraram|strong="G3753,G1525"\w*, \w subiram|strong="G305"\w* \w ao cômodo superior|strong="G1519,G3588,G5253"\w* \w onde|strong="G3757"\w* \w estavam|strong="G1510"\w* \w hospedados|strong="G2650"\w*: \w Pedro|strong="G3588,G5037,G4074"\w* \w e|strong="G2532"\w* \w João|strong="G2491"\w* \w e|strong="G2532"\w* \w Tiago|strong="G2385"\w* \w e|strong="G2532"\w* \w André|strong="G406"\w*, \w Filipe|strong="G5376"\w* \w e|strong="G2532"\w* \w Tomé|strong="G2381"\w*, \w Bartolomeu|strong="G918"\w* \w e|strong="G2532"\w* \w Mateus|strong="G3156"\w*, \w Tiago|strong="G2385"\w* \w de Alfeu|strong="G256"\w* \w e|strong="G2532"\w* \w Simão|strong="G4613"\w* \w o zelote|strong="G3588,G2208"\w* \w e|strong="G2532"\w* \w Judas|strong="G2455"\w* \w de Tiago|strong="G2385"\w*.\f + \fr 1.13: \ft Lit.: Ἰούδας Ἰακώβου: “Judas de Tiago”, isto é, filho ou irmão de Tiago (discutido).\f*\x - \xo 1:13 \xt MRK 3:18; LUK 6:15; MAT 10:3; LUK 6:14; MAT 10:2; JHN 1:40\x*
\v 14 \w Todos estes|strong="G3778,G3956"\w* \w perseveravam|strong="G1510,G4342"\w* \w unânimes|strong="G3661"\w* \w na oração|strong="G3588,G4335"\w*, \w com mulheres|strong="G4862,G1135"\w* \w e|strong="G2532"\w* \w Maria|strong="G3137"\w*, \w a mãe|strong="G3588,G3384"\w* \w de Jesus|strong="G3588,G2424"\w*, \w e|strong="G2532"\w* \w com os irmãos|strong="G4862,G3588,G80"\w* \w dele|strong="G846"\w*.\f + \fr 1.14: \ft Variante: o RP acrescenta καὶ τῇ δεήσει (“e na súplica”) depois de προσευχῇ e traz Μαρίᾳ em lugar de Μαριάμ; a NA28 omite um dos σύν (“com”).\f*\x - \xo 1:14 \xt ACT 2:42; ACT 6:4; COL 4:2; ROM 12:12; ACT 2:46; EPH 6:18\x*
\v 15 \w E|strong="G2532"\w* \w naqueles dias|strong="G1722,G3588,G2250,G3778"\w* \w Pedro|strong="G4074"\w*, \w levantando-se|strong="G450"\w* \w no meio|strong="G1722,G3319"\w* \w dos irmãos e irmãs|strong="G3588,G80"\w*, \w disse|strong="G2036"\w* (\w o número|strong="G3793,G3686"\w* \w dos reunidos|strong="G1909,G3588,G846"\w* \w era|strong="G1510"\w* \w cerca de|strong="G5613"\w* \w cento e vinte|strong="G1540,G1501"\w*\f + \fr 1.15: \ft Variante: o RP traz μαθητῶν (“discípulos”) em lugar de ἀδελφῶν (“irmãos”); a NA28 traz ὡσεί em lugar de ὡς.\f*\f + \fr 1.15: \ft Lit.: ὄχλος ὀνομάτων, literalmente “multidão de nomes”; “nomes” está por “pessoas”.\f*):\f + \fr 1.15: \ft Não traduzido: τε (G5037): τε (and/both); sem equivalente natural em português neste ponto.\f*\x - \xo 1:15 \xt ACT 2:1; 1CO 15:6; ACT 2:41; ACT 21:20; ISA 45:2; MAT 28:16\x*
\q1
\v 16 “\w Homens|strong="G435"\w*, \w irmãos|strong="G80"\w*, \w era necessário|strong="G1163"\w* \w que se cumprisse|strong="G4137"\w* \w a Escritura|strong="G3588,G1124"\w* \w que|strong="G3739"\w* \w predisse|strong="G4277"\w* \w o Espírito Santo|strong="G3588,G4151,G40"\w* \w pela boca|strong="G1223,G4750"\w* \w de Davi|strong="G1138"\w* \w a respeito de Judas|strong="G4012,G2455"\w*, \w que se tornou|strong="G3588,G1096"\w* \w guia|strong="G3595"\w* \w dos que prenderam|strong="G3588,G4815"\w* \w Jesus|strong="G2424"\w*,\f + \fr 1.16: \ft Variante: o RP acrescenta ταύτην (“esta”) depois de γραφήν e traz τὸν Ἰησοῦν.\f*\x - \xo 1:16 \xt PSA 41:9; MAT 26:54; JHN 13:18; PSA 55:12-15; 2PE 1:21; 2TI 3:16\x*
\q1
\v 17 \w pois|strong="G3754"\w* \w era contado|strong="G2674,G1510"\w* \w entre nós|strong="G1722,G3165"\w* \w e|strong="G2532"\w* \w recebeu|strong="G2975"\w* \w a sorte|strong="G3588,G2819"\w* \w deste|strong="G3588,G3778"\w* \w serviço|strong="G1248"\w*.—\x - \xo 1:17 \xt JHN 17:12; COL 4:17; 1TI 6:10; ACT 20:24; PSA 109:8; ACT 21:19\x*
