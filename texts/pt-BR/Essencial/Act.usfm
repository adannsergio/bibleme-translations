\v 3 \w e|strong="G2532"\w*, \w por ser|strong="G1223,G3588,G1511"\w* \w do mesmo ofício|strong="G3673"\w*, \w ficou|strong="G3306"\w* \w com eles|strong="G3844,G846"\w* \w e|strong="G2532"\w* \w trabalhava|strong="G2038"\w*; \w pois|strong="G1063"\w* \w eram|strong="G1510"\w* \w fabricantes de tendas|strong="G4635"\w* \w de ofício|strong="G3588,G5078"\w*.\f + \fr 18.3: \ft Variante: WH lê ἠργάζοντο (plural: “trabalhavam”); RP lê τὴν τέχνην em vez de τῇ τέχνῃ.\f*\x - \xo 18:3 \xt 1CO 4:12; 1TH 2:9; ACT 20:34; 2TH 3:8; 1CO 9:6; 2CO 11:7\x*
\v 4 \w E debatia|strong="G1256,G1161"\w* \w na sinagoga|strong="G1722,G3588,G4864"\w* \w todo|strong="G2596,G3956"\w* \w sábado|strong="G4521"\w*, \w e|strong="G5037"\w* \w persuadia|strong="G3982"\w* \w judeus|strong="G2453"\w* \w e|strong="G2532"\w* \w gregos|strong="G1672"\w*.\x - \xo 18:4 \xt ACT 17:17; ACT 14:1; ACT 18:19; ACT 17:2; ISA 1:18; 1CO 3:6\x*
\v 5 \w Quando|strong="G5613,G1161"\w* \w desceram|strong="G2718"\w* \w da Macedônia|strong="G575,G3588,G3109"\w* \w tanto Silas|strong="G3588,G5037,G4609"\w* \w como Timóteo|strong="G2532,G3588,G5095"\w*, \w Paulo|strong="G3588,G3972"\w* \w estava absorvido|strong="G4912"\w* \w pela palavra|strong="G3588,G3056"\w*, \w testemunhando solenemente|strong="G1263"\w* \w aos judeus|strong="G3588,G2453"\w* \w que Jesus|strong="G2424"\w*\f + \fr 18.5: \ft Variante: RP lê πνεύματι (“pelo Espírito”) em vez de λόγῳ (“pela palavra”) e omite εἶναι.\f*\f + \fr 18.5: \ft Lit.: συνείχετο τῷ λόγῳ: “estava premido/ocupado pela palavra”; o sentido exato é discutido.\f* \w era|strong="G1511"\w* \w o Cristo|strong="G3588,G5547"\w*.\x - \xo 18:5 \xt ACT 17:14; ACT 20:21; ACT 9:22; ACT 13:46; 1CO 3:6; 2CO 5:14\x*
\v 6 \w Mas resistindo eles|strong="G498,G1161,G846"\w* \w e|strong="G2532"\w* \w blasfemando|strong="G987"\w*, \w sacudindo|strong="G1621"\w* \w as vestes|strong="G3588,G2440"\w*, \w disse|strong="G2036"\w* \w a eles|strong="G4314,G846"\w*: “\w O sangue|strong="G3588,G129"\w* \w de vocês|strong="G4771"\w* \w sobre a cabeça|strong="G1909,G3588,G2776"\w* \w de vocês|strong="G4771"\w*; \w estou limpo|strong="G2513,G1473"\w*; \w a partir de agora|strong="G575,G3588,G3568"\w* \w irei|strong="G4198"\w* \w para os gentios|strong="G1519,G3588,G1484"\w*.”\f + \fr 18.6: \ft Nota cultural: “O sangue de vocês sobre a cabeça de vocês”: fórmula de responsabilidade pela própria culpa.\f*\f + \fr 18.6: \ft Acréscimo: verbo ser/estar suprido em “estou limpo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 18:6 \xt EZK 33:4; MAT 10:14; 2SA 1:16; EZK 33:8-9; 1PE 4:4; EZK 18:13\x*
\v 7 \w e|strong="G2532"\w*, \w tendo saído|strong="G3327"\w* \w dali|strong="G1564"\w*, \w entrou|strong="G1525"\w* \w na casa|strong="G1519,G3614"\w* \w de alguém|strong="G5100"\w* \w de nome|strong="G3686"\w* \w Tício|strong="G6084"\w* \w Justo|strong="G2459"\w*, \w que reverenciava|strong="G4576"\w* \w a Deus|strong="G3588,G2316"\w*, \w cuja casa|strong="G3739,G3588,G3614"\w* \w era contígua|strong="G1510,G4927"\w* \w à sinagoga|strong="G3588,G4864"\w*.\f + \fr 18.7: \ft Variante: NA28 lê εἰσῆλθεν (“entrou”); WH, Treg e RP leem ἦλθεν (“foi”); RP omite “Tício”.\f*\x - \xo 18:7 \xt MAT 12:9; 1CO 3:6; ACT 16:14; COL 4:11; ACT 19:9; ACT 10:2\x*
\v 8 \w Mas Crispo|strong="G2921,G1161"\w*, \w o chefe da sinagoga|strong="G3588,G752"\w*, \w creu|strong="G4100"\w* \w no Senhor|strong="G3588,G2962"\w* \w com toda|strong="G4862,G3650"\w* \w a sua casa|strong="G3588,G3624,G846"\w*, \w e|strong="G2532"\w* \w muitos|strong="G4183"\w* \w dos coríntios|strong="G3588,G2881"\w*, \w ao ouvirem|strong="G191"\w*, \w criam|strong="G4100"\w* \w e|strong="G2532"\w* \w eram batizados|strong="G907"\w*.\x - \xo 18:8 \xt 1CO 1:14; ACT 16:31; 1CO 3:6; 1CO 1:13-17; ACT 19:9; MRK 16:15-16\x*
\q1
\v 9 \w E disse|strong="G2036,G1161"\w* \w o Senhor|strong="G3588,G2962"\w* \w durante a noite|strong="G1722,G3571"\w* \w numa visão|strong="G1223,G3705"\w* \w a Paulo|strong="G3588,G3972"\w*: “\w Não tenha medo|strong="G3361,G5399"\w*, \w mas|strong="G235"\w* \w fale|strong="G2980"\w* \w e|strong="G2532"\w* \w não se cale|strong="G3361,G4623"\w*,\x - \xo 18:9 \xt ACT 16:9; PSA 23:4; MAT 28:20; JOS 1:5; 2KI 6:16; PSA 91:15\x*
\q1
\v 10 \w porque|strong="G1360"\w* \w eu|strong="G1473"\w* \w estou|strong="G1510"\w* \w com você|strong="G3326,G4771"\w*, \w e|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w o atacará|strong="G2007,G4771"\w* \w para lhe fazer mal|strong="G3588,G2559,G4771"\w*, \w porque|strong="G1360"\w* \w tenho|strong="G1510,G3165"\w* \w um povo|strong="G2992"\w* \w numeroso|strong="G4183"\w* \w nesta cidade|strong="G1722,G3588,G4172,G3778"\w*.”\f + \fr 18.10: \ft Lit.: ἐπιτίθημι: “pôr sobre”, “atacar”.\f*\x - \xo 18:10 \xt PSA 23:4; MAT 28:20; JOS 1:5; 2KI 6:16; LUK 1:28; 2CO 12:9\x*
\v 11 \w E ficou|strong="G2523,G1161"\w* \w um ano|strong="G1763"\w* \w e|strong="G2532"\w* \w seis meses|strong="G3376,G1803"\w*, \w ensinando|strong="G1321"\w* \w entre eles|strong="G1722,G846"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 18:11 \xt 1CO 3:6; JHN 14:21; MIC 3:8; 1CO 1:2; ACT 14:3; ROM 16:3\x*
\v 12 \w Sendo|strong="G1161,G1510"\w* \w Galião|strong="G1058"\w* \w procônsul|strong="G446"\w* \w da Acaia|strong="G3588,G882"\w*, \w os judeus|strong="G3588,G2453"\w* \w se levantaram|strong="G2721"\w* \w unânimes|strong="G3661"\w* \w contra Paulo|strong="G3588,G3972"\w* \w e|strong="G2532"\w* \w o levaram|strong="G71,G846"\w* \w ao tribunal|strong="G1909,G3588,G968"\w*,\x - \xo 18:12 \xt JER 12:6; 2CO 11:10; ACT 13:50; ACT 13:7; ACT 14:2; ACT 16:19\x*
\v 13 \w dizendo|strong="G3004"\w*: “\w Contra a lei|strong="G3844,G3588,G3551"\w* \w este|strong="G3778"\w* \w persuade|strong="G374"\w* \w os homens|strong="G3588,G444"\w* \w a adorar|strong="G4576"\w* \w a Deus|strong="G3588,G2316"\w*.”\f + \fr 18.13: \ft Lit.: σέβομαι: “reverenciar”, “adorar”.\f*\x - \xo 18:13 \xt MAT 5:17; 2CO 5:11; ACT 16:19; ACT 17:6; 1TH 2:16; ACT 21:28\x*
\v 14 \w Estando Paulo|strong="G1161,G3588,G3972"\w* \w para abrir|strong="G3195,G455"\w* \w a boca|strong="G3588,G4750"\w*, \w disse|strong="G2036"\w* \w Galião|strong="G3588,G1058"\w* \w aos judeus|strong="G4314,G3588,G2453"\w*: “\w Se de fato|strong="G1487,G3303"\w* \w houvesse|strong="G1510"\w* \w algum delito|strong="G92,G5100"\w* \w ou|strong="G2228"\w* \w crime|strong="G4467"\w* \w perverso|strong="G4190"\w*, \w ó|strong="G5599"\w* \w judeus|strong="G2453"\w*, \w com razão|strong="G2596,G3056"\w* \w teria tolerado|strong="G302,G430"\w* \w vocês|strong="G4771"\w*\f + \fr 18.14: \ft Variante: RP acrescenta οὖν depois de μέν.\f*;\f + \fr 18.14: \ft Acréscimo: verbo ser/estar suprido em “Estando Paulo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 18:14 \xt 1PE 3:14-15; ACT 26:17; EST 1:16; ROM 16:3\x*
\v 15 \w mas se|strong="G1487,G1161"\w* \w há|strong="G1510"\w* \w questões|strong="G2213"\w* \w sobre palavra|strong="G4012,G3056"\w* \w e|strong="G2532"\w* \w nomes|strong="G3686"\w* \w e|strong="G2532"\w* \w sobre a lei|strong="G3551"\w* \w que há entre vocês|strong="G3588,G2596,G4771"\w*, \w vejam|strong="G3700"\w* \w vocês mesmos|strong="G846"\w*; \w juiz|strong="G2923"\w* \w eu|strong="G1473"\w* \w dessas coisas|strong="G3778"\w* \w não quero|strong="G3756,G1014"\w* \w ser|strong="G1511"\w*.”\f + \fr 18.15: \ft Variante: RP lê ζήτημά (singular) e acrescenta γάρ depois de κριτής.\f*\f + \fr 18.15: \ft Acréscimo: “que há entre vocês”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 18:15 \xt ACT 23:29; ACT 25:19; 1CO 2:14; 1TI 6:4; MAT 13:19; 1TI 1:4\x*
\v 16 \w E|strong="G2532"\w* \w os expulsou|strong="G556,G846"\w* \w do tribunal|strong="G575,G3588,G968"\w*.\x - \xo 18:16 \xt ACT 18:12; ACT 26:17; ROM 16:3\x*
\v 17 \w Mas todos|strong="G1161,G3956"\w*, \w tendo agarrado|strong="G1949"\w* \w Sóstenes|strong="G4988"\w*, \w o chefe da sinagoga|strong="G3588,G752"\w*, \w batiam-lhe|strong="G5180"\w* \w diante do tribunal|strong="G1715,G3588,G968"\w*; \w e|strong="G2532"\w* \w nada|strong="G3762"\w* \w disso|strong="G3778"\w* \w importava|strong="G3199"\w* \w a Galião|strong="G3588,G1058"\w*.\f + \fr 18.17: \ft Variante: RP e TR acrescentam “os gregos” (οἱ Ἕλληνες) depois de πάντες; RP lê ἔμελλεν em vez de ἔμελεν.\f*\x - \xo 18:17 \xt ACT 18:12; 1CO 1:1; MRK 5:22; LUK 10:32; ACT 13:15; ROM 16:3\x*
\v 18 \w Paulo|strong="G3588,G1161,G3972"\w*, \w tendo ficado ainda|strong="G2089,G4357"\w* \w muitos|strong="G2425"\w* \w dias|strong="G2250"\w*, \w tendo se despedido|strong="G657"\w* \w dos irmãos|strong="G3588,G80"\w*, \w navegou|strong="G1602"\w* \w para a Síria|strong="G1519,G3588,G4947"\w*, \w e|strong="G2532"\w* \w com ele|strong="G4862,G846"\w* \w Priscila|strong="G4252"\w* \w e|strong="G2532"\w* \w Áquila|strong="G207"\w*, \w tendo raspado|strong="G2751"\w* \w em Cencreia|strong="G1722,G2747"\w* \w a cabeça|strong="G3588,G2776"\w*, \w pois|strong="G1063"\w* \w tinha|strong="G2192"\w* \w um voto|strong="G2171"\w*\f + \fr 18.18: \ft Lit.: o sujeito gramatical de κειράμενος (“tendo raspado”) é discutido; costuma-se entender que se trata de Paulo. εὐχή: “voto”, “oração”.\f*.\x - \xo 18:18 \xt ACT 21:24; ACT 21:23; NUM 6:18; ROM 16:1; 1CO 9:20; ACT 18:2\x*
\v 19 \w Chegaram|strong="G2658,G1161"\w* \w a Éfeso|strong="G1519,G2181"\w*, \w e|strong="G1565,G2532"\w* \w os deixou|strong="G2641"\w* \w ali|strong="G847"\w*; \w mas ele mesmo|strong="G846,G1161"\w*, \w tendo entrado|strong="G1525"\w* \w na sinagoga|strong="G1519,G3588,G4864"\w*, \w debateu|strong="G1256"\w* \w com os judeus|strong="G3588,G2453"\w*\f + \fr 18.19: \ft Variante: RP lê Κατήντησεν (singular) e διελέχθη em vez de διελέξατο.\f*.\x - \xo 18:19 \xt ACT 18:4; ACT 18:24; ACT 20:18; 1TI 1:3; 2TI 1:18; EPH 1:1\x*
\v 20 \w Mas pedindo eles|strong="G2065,G1161,G846"\w* \w que permanecesse|strong="G3306"\w* \w por mais tempo|strong="G1909,G4119,G5550"\w*, \w não consentiu|strong="G3756,G1962"\w*,\x - \xo 18:20 \xt ACT 19:1; REV 1:11; ACT 1:6\x*
\v 21 \w mas|strong="G235"\w*, \w despedindo-se|strong="G657"\w* \w e|strong="G2532"\w* \w dizendo|strong="G2036"\w*: “\w Voltarei de novo|strong="G3825,G344"\w* \w a vocês|strong="G4314,G4771"\w*, \w se Deus quiser|strong="G3588,G2316,G2309"\w*”, \w zarpou|strong="G321"\w* \w de Éfeso|strong="G575,G3588,G2181"\w*,\f + \fr 18.21: \ft Variante: RP e TR acrescentam “É preciso que eu, de qualquer modo, celebre a festa que vem, em Jerusalém” depois de εἰπών; RP lê ἀλλʼ ἀπετάξατο αὐτοῖς (“mas se despediu deles”).\f*\x - \xo 18:21 \xt JAS 4:15; 1CO 16:7; ROM 1:10; 1CO 4:19; ROM 15:32; ACT 20:16\x*
\v 22 \w e|strong="G2532"\w*, \w tendo descido|strong="G2718"\w* \w a Cesareia|strong="G1519,G2542"\w*, \w tendo subido|strong="G305"\w* \w e|strong="G2532"\w* \w saudado|strong="G782"\w* \w a comunidade|strong="G3588,G1577"\w*, \w desceu|strong="G2597"\w* \w a Antioquia|strong="G1519,G490"\w*,\f + \fr 18.22: \ft Lit.: ἀναβάς: “tendo subido”; o texto não diz aonde (costuma-se entender: a Jerusalém).\f*\x - \xo 18:22 \xt ACT 11:27; ACT 8:40; ACT 15:30\x*
\v 23 \w e|strong="G2532"\w*, \w tendo passado|strong="G4160"\w* \w algum|strong="G5100"\w* \w tempo|strong="G5550"\w*, \w partiu|strong="G1831"\w*, \w percorrendo|strong="G1330"\w* \w em ordem|strong="G2517"\w* \w a região gálata|strong="G3588,G1054,G5561"\w* \w e|strong="G2532"\w* \w Frígia|strong="G5435"\w*, \w fortalecendo|strong="G4741"\w* \w todos os discípulos|strong="G3956,G3588,G3101"\w*.\f + \fr 18.23: \ft Variante: WH e Treg leem στηρίζων; NA28 e RP leem ἐπιστηρίζων (ambos “fortalecendo”).\f*\x - \xo 18:23 \xt ACT 16:6; ACT 14:22; ISA 35:3; REV 3:2; ACT 19:1; ACT 15:32\x*
\v 24 \w Ora, um certo|strong="G1161,G5100"\w* \w judeu|strong="G2453"\w*, \w de nome|strong="G3686"\w* \w Apolo|strong="G625"\w*, \w alexandrino|strong="G221"\w* \w de origem|strong="G3588,G1085"\w*, \w homem|strong="G435"\w* \w eloquente|strong="G3052"\w*, \w chegou|strong="G2658"\w* \w a Éfeso|strong="G1519,G2181"\w*, \w sendo poderoso|strong="G1415,G1510"\w* \w nas Escrituras|strong="G1722,G3588,G1124"\w*\f + \fr 18.24: \ft Lit.: λόγιος: “eloquente”, “culto”, “instruído”.\f*.\x - \xo 18:24 \xt ACT 18:19; TIT 3:13; 1CO 3:5-6; 1CO 4:6; 1CO 1:12; 1CO 16:12\x*
\v 25 \w Este|strong="G3778"\w* \w tinha sido instruído|strong="G1510,G2727"\w* \w no caminho|strong="G3588,G3598"\w* \w do Senhor|strong="G3588,G2962"\w*, \w e|strong="G2532"\w*, \w fervoroso|strong="G2204"\w* \w no espírito|strong="G3588,G4151"\w*, \w falava|strong="G2980"\w* \w e|strong="G2532"\w* \w ensinava|strong="G1321"\w* \w com exatidão|strong="G199"\w* \w as coisas a respeito|strong="G3588,G4012"\w* \w de Jesus|strong="G3588,G2424"\w*, \w conhecendo|strong="G1987"\w* \w somente|strong="G3441"\w* \w o batismo|strong="G3588,G908"\w* \w de João|strong="G2491"\w*.\f + \fr 18.25: \ft Lit.: ζέω τῷ πνεύματι: “ferver no espírito”; πνεῦμα pode ser o espírito de Apolo ou o Espírito, e o texto não permite decidir.\f*\f + \fr 18.25: \ft Variante: RP lê κυρίου (“do Senhor”) em vez de Ἰησοῦ (“de Jesus”).\f*\x - \xo 18:25 \xt ACT 19:3; ROM 12:11; 2TI 3:16; PSA 67:2; ACT 19:1; LUK 1:4\x*
\v 26 \w E|strong="G5037"\w* \w este|strong="G3778"\w* \w começou|strong="G757"\w* \w a falar com ousadia|strong="G3955"\w* \w na sinagoga|strong="G1722,G3588,G4864"\w*; \w mas ao ouvirem|strong="G191,G1161"\w* \w dele|strong="G846"\w* \w Priscila|strong="G4252"\w* \w e|strong="G2532"\w* \w Áquila|strong="G207"\w*, \w o acolheram|strong="G4355,G846"\w* \w e|strong="G2532"\w* \w com mais exatidão|strong="G197"\w* \w lhe expuseram|strong="G846,G1620"\w* \w o caminho|strong="G3588,G3598"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 18:26 \xt ACT 18:2; PRO 31:26; ROM 16:3; 1CO 3:6; ACT 19:1; EPH 6:19\x*
\v 27 \w Querendo ele|strong="G1014,G1161,G846"\w* \w passar|strong="G1330"\w* \w à Acaia|strong="G1519,G3588,G882"\w*, \w os irmãos|strong="G3588,G80"\w*, \w tendo-o encorajado|strong="G4389"\w*, \w escreveram|strong="G1125"\w* \w aos discípulos|strong="G3588,G3101"\w* \w que o acolhessem|strong="G588,G846"\w*; \w o qual|strong="G3739"\w*, \w tendo chegado|strong="G3854"\w*, \w ajudou|strong="G4820"\w* \w muito|strong="G4183"\w* \w os que tinham crido|strong="G3588,G4100"\w* \w por meio da graça|strong="G1223,G3588,G5485"\w*;\f + \fr 18.27: \ft Lit.: Διὰ τῆς χάριτος: pode ligar-se a “tinham crido” (“os que, pela graça, tinham crido”) ou a “ajudou muito” (“ajudou muito, pela graça, os que tinham crido”).\f*\x - \xo 18:27 \xt 2CO 3:1; 1CO 3:6; ACT 19:1; ACT 9:22; 2TH 2:13-14; ACT 18:12\x*
\v 28 \w pois|strong="G1063"\w* \w com vigor|strong="G2159"\w* \w refutava|strong="G1246"\w* \w os judeus|strong="G3588,G2453"\w* \w em público|strong="G1219"\w*, \w demonstrando|strong="G1925"\w* \w por meio das Escrituras|strong="G1223,G3588,G1124"\w* \w que Jesus|strong="G2424"\w* \w era|strong="G1511"\w* \w o Cristo|strong="G3588,G5547"\w*.\x - \xo 18:28 \xt 1CO 15:3-4; ACT 18:5; ACT 17:3; JUD 1:3; ACT 26:22-23; ACT 9:22\x*
