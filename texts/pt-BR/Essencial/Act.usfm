\v 35 \w Quando amanheceu|strong="G2250,G1161,G1096"\w*, \w os magistrados|strong="G3588,G4755"\w* \w enviaram|strong="G649"\w* \w os oficiais|strong="G3588,G4465"\w*, \w dizendo|strong="G3004"\w*: “\w Solte|strong="G630"\w* \w aqueles homens|strong="G3588,G444,G1565"\w*\f + \fr 16.35: \ft Lit.: ῥαβδοῦχος: “portador de vara” (oficial subalterno dos magistrados).\f*.”\x - \xo 16:35 \xt ACT 16:38; PHP 1:30; PSA 107:14; PHP 1:5; ACT 5:40\x*
