\v 18 \w Mas ao amanhecer|strong="G1096,G1161,G2250"\w*, \w houve|strong="G1510"\w* \w não pouca|strong="G3756,G3641"\w* \w agitação|strong="G5017"\w* \w entre os soldados|strong="G1722,G3588,G4757"\w*, \w sobre o que|strong="G5101"\w* \w teria acontecido|strong="G686,G1096"\w* \w a Pedro|strong="G3588,G4074"\w*.\x - \xo 12:18 \xt ACT 19:23; PSA 68:6; LUK 4:30; PSA 10:17; PSA 102:2; ACT 5:22-25\x*
