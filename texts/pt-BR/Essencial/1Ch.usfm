\p
\v 13 \w Assim morreu|strong="H4191"\w* \w Saul|strong="H7586"\w* \w por causa da sua infidelidade|strong="H4604"\w*, \w pois tinha sido infiel|strong="H0834,H4603"\w* \w ao SENHOR|strong="H3068"\w*, \w não guardando|strong="H0834,H3808,H8104"\w* \w a palavra|strong="H5921,H1697"\w* \w do SENHOR|strong="H3068"\w*, \add e\add* \w também|strong="H1571"\w* \w por ter consultado|strong="H7592,H1875"\w* \w uma médium|strong="H0178"\w*.\x - \xo 10:13 \xt 1SA 28:7; ISA 8:19; LEV 20:6; LEV 19:31; 1JN 3:4; 1SA 15:23\x*
\v 14 \w e não|strong="H3808"\w* \w consultou|strong="H1875"\w* \w o SENHOR|strong="H3068"\w*; \w por isso ele o matou|strong="H4191"\w* \w e transferiu|strong="H5437"\w* \add o\add* \w reino|strong="H4410"\w* \w para Davi|strong="H1732"\w*, \w filho|strong="H1121"\w* \add de\add* \w Jessé|strong="H3448"\w*.\x - \xo 10:14 \xt 1KI 2:15; 1SA 15:28; PSA 27:4; JOS 9:14; 2CH 16:12; 1SA 13:14\x*
\c 11
\p
\v 1 \w E todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \add se\add* \w reuniu|strong="H6908"\w* \w em torno de|strong="H0413"\w* \w Davi|strong="H1732"\w*, \add em\add* \w Hebrom|strong="H2275"\w*, \w dizendo|strong="H0559"\w*: \add "Eis\add* \w que|strong="H2009"\w* \w nós|strong="H0587"\w* \add somos\add* \w osso e carne|strong="H6106,H1320"\w* \add teus."\add*\x - \xo 11:1 \xt 2SA 5:1; JDG 9:2; 2SA 19:12\x*
\v 2 \add "Já\add* \w antes|strong="H1571,H8543,H8032"\w*, \w quando|strong="H1961"\w* \w Saul|strong="H7586"\w* \add ainda\add* \w era|strong="H1961"\w* \w rei|strong="H4428"\w*, \add foste\add* \w tu|strong="H0859"\w* \w quem conduzia|strong="H3318"\w* \w e trazia de volta|strong="H0935"\w* \w Israel|strong="H3478"\w*; \w e o SENHOR|strong="H0559,H3068"\w* \w teu Deus|strong="H0430"\w* \w te|strong="H9031"\w* \w disse|strong="H0559"\w*: '\w Tu|strong="H0859"\w* \w pastorearás|strong="H7462"\w* \w o meu povo|strong="H5971"\w* \w Israel|strong="H0853,H3478"\w*, \w e tu serás|strong="H0859,H1961"\w* \w o líder|strong="H5057"\w* \w sobre o meu povo|strong="H5921,H5971"\w* \w Israel|strong="H3478"\w*.'"\x - \xo 11:2 \xt 2SA 5:2; 2KI 13:5; 2SA 3:17; GEN 31:2; 2SA 5:1; JHN 10:4\x*
\v 3 \w E vieram|strong="H0935"\w* \w todos|strong="H3605"\w* \w os anciãos|strong="H2205"\w* \add de\add* \w Israel|strong="H3478"\w* \w ao|strong="H0413"\w* \w rei|strong="H4428"\w*, \add em\add* \w Hebrom|strong="H2275"\w*, \w e Davi fez|strong="H3772,H1732"\w* \w um pacto|strong="H9038,H1285"\w* \add com eles, em\add* \w Hebrom|strong="H2275"\w*, \w diante|strong="H6440"\w* \w do SENHOR|strong="H3068"\w*; \w e ungiram|strong="H4886"\w* \w Davi|strong="H1732"\w* \w como rei|strong="H4428"\w* \w sobre Israel|strong="H5921,H3478"\w*, \w conforme a palavra|strong="H1697"\w* \w do SENHOR|strong="H3068"\w* \w por meio de|strong="H3027"\w* \w Samuel|strong="H8050"\w*.\x - \xo 11:3 \xt 2SA 5:3; EXO 23:32; 2SA 5:1; 1SA 16:1; 1SA 16:12-13; 2SA 2:4\x*
\p
\v 4 \w E foi Davi|strong="H1980,H1732"\w* \w com todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w a Jerusalém|strong="H3389"\w* — \w esta|strong="H1931"\w* \w era Jebus|strong="H2982"\w* —, \w onde estavam|strong="H8033"\w* \add os\add* \w jebuseus|strong="H2983"\w*, \w habitantes|strong="H3427"\w* \add da\add* \w terra|strong="H0776"\w*.\x - \xo 11:4 \xt JDG 1:21; JOS 15:63; JDG 19:11; 2SA 5:6; JOS 15:8; 1CH 11:5\x*
\v 5 \w E os habitantes de Jebus|strong="H3427,H2982"\w* \w disseram|strong="H0559"\w* \w a Davi|strong="H1732"\w*: "\w Não|strong="H3808"\w* \w entrarás|strong="H0935"\w* \w aqui|strong="H2008"\w*!" \add Mas\add* \w Davi|strong="H3920,H1732"\w* \w tomou|strong="H3920"\w* \w a fortaleza|strong="H4686"\w* \add de\add* \w Sião|strong="H6726"\w*, \w que|strong="H1931"\w* \w é a Cidade|strong="H5892"\w* \add de\add* \w Davi|strong="H1732"\w*.\x - \xo 11:5 \xt 2SA 5:7; JOS 15:63; 1CH 11:4; 2SA 5:6; PSA 132:13\x*
\v 6 \w E Davi tinha dito|strong="H0559,H1732"\w*: "\w Quem|strong="H3605,H5221"\w* \w primeiro|strong="H7223"\w* \w atacar|strong="H5221"\w* \add os\add* \w jebuseus|strong="H2983"\w* \add se\add* \w tornará|strong="H1961"\w* \w chefe e comandante|strong="H7218,H8269"\w*."\w E subiu primeiro|strong="H5927,H7223"\w* \w Joabe|strong="H3097"\w*, \w filho|strong="H1121"\w* \add de\add* \w Zeruia|strong="H6870"\w*, \w e se tornou|strong="H1961"\w* \w chefe|strong="H7218"\w*.\x - \xo 11:6 \xt 1CH 18:15; 2SA 8:16; 2SA 14:1; 1CH 27:34; EST 6:3; JOS 15:63\x*
\v 7 \w E Davi|strong="H1732"\w* \add passou a\add* \w habitar|strong="H3427"\w* \w na fortaleza|strong="H4679"\w*; \add por\add* \w isso|strong="H5921,H3651"\w* \add a\add* \w chamaram|strong="H7121,H9033"\w* \w Cidade|strong="H5892"\w* \add de\add* \w Davi|strong="H1732"\w*.\x - \xo 11:7 \xt JOS 15:63; PSA 65:1; 2SA 5:6; 2SA 5:7\x*
\v 8 \w E ele construiu|strong="H1129"\w* \w a cidade|strong="H5892"\w* \w em todo o seu redor|strong="H5439"\w*, \w desde|strong="H4480"\w* \add o\add* \w Milo|strong="H4407"\w* \w até|strong="H5704"\w* \add o\add* \w resto|strong="H5439"\w*; \w e Joabe|strong="H3097"\w* \w restaurou|strong="H2421"\w* \w o restante|strong="H7605"\w* \w da cidade|strong="H5892"\w*.\x - \xo 11:8 \xt 2SA 5:9; 1KI 11:27; JOS 15:63; 2SA 5:6\x*
\v 9 \w E Davi|strong="H1732"\w* \w ia|strong="H1980"\w* \w cada vez mais|strong="H1980"\w* \w crescendo|strong="H1431"\w*, \w e o SENHOR|strong="H3068"\w* \add dos\add* \w Exércitos|strong="H6635"\w* \w estava|strong="H5973"\w* \add com ele.\add*\x - \xo 11:9 \xt 2SA 5:10; 2SA 7:26; 1CH 17:24; ZEP 2:10; DAN 8:10; 2SA 3:1\x*
\p
\v 10 \w E estes|strong="H0428"\w* \w foram os chefes|strong="H7218"\w* \w dos valentes|strong="H1368"\w* \w que|strong="H0834"\w* \w pertenciam a Davi|strong="H1732"\w*, \w que|strong="H2388"\w* \w o apoiaram firmemente|strong="H2388,H5973"\w* \w em seu reinado|strong="H4438"\w*, \add junto\add* \w com|strong="H5973"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w para fazê-lo rei|strong="H4427"\w*, \w conforme a palavra|strong="H1697"\w* \w do SENHOR|strong="H3068"\w* \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w*.\x - \xo 11:10 \xt 1CH 12:23; 2SA 23:8; 1CH 28:1; NEH 2:18; 1CH 11:3\x*
\v 11 \w E estes|strong="H0428"\w* \w foram, em número|strong="H4557"\w*, \w os valentes|strong="H1368"\w* \w que|strong="H0834"\w* \w pertenciam a Davi|strong="H1732"\w*: \w Jasobeão|strong="H3434"\w*, \w filho|strong="H1121"\w* \w de um hacmonita|strong="H2453"\w*, \w o chefe|strong="H7218"\w* \w dos capitães|strong="H7991"\w*\f + \fr 11.11: \ft Variante: a Ketiv tem "הַשְּׁלוֹשִׁים" (os trinta); seguimos a Qere, "הַשָּׁלִישִׁים" (os capitães)\f*; \w ele|strong="H1931"\w* \w brandiu|strong="H5782"\w* \w a sua lança|strong="H2595"\w* \w contra|strong="H5921"\w* \w trezentos|strong="H7969,H3967"\w* \w homens, matando-os|strong="H2491"\w* \w de uma só vez|strong="H6471,H0259"\w*.\x - \xo 11:11 \xt 2SA 23:8; LEV 26:8; 1CH 27:2; 1CH 28:1\x*
