\c 10
\p
\v 1 \w Os filisteus|strong="H6430"\w* \w lutaram|strong="H3898"\w* \add contra\add* \w Israel|strong="H3478"\w*, \w e os homens|strong="H0376,H3478"\w* \add de Israel\add* \w fugiram|strong="H5127"\w* \w de diante|strong="H6440"\w* \add dos\add* \w filisteus|strong="H6430"\w*, \w e caíram|strong="H5307"\w* \w mortos|strong="H2491"\w* \w no monte|strong="H2022"\w* \w Gilboa|strong="H1533"\w*.\x - \xo 10:1 \xt 1SA 31:1; 1CH 10:8; 1SA 31:8; 1SA 28:4; 2SA 1:4; 2SA 1:21\x*
\v 2 \w Os filisteus|strong="H6430"\w* \add perseguiram de\add* \w perto|strong="H1692"\w* \w Saul|strong="H0310,H7586"\w* \w e os seus filhos|strong="H0310,H1121"\w*, \w e mataram|strong="H5221,H6430"\w* \w Jônatas|strong="H3129"\w*, \w Abinadabe|strong="H0041"\w* \w e Malquisua|strong="H4444"\w*, \w os filhos de Saul|strong="H1121,H7586"\w*.\x - \xo 10:2 \xt 1SA 31:2; 1CH 9:39; 1SA 31:1; 2SA 1:4; ISA 57:1-2\x*
\v 3 \w E a batalha|strong="H4421"\w* \add se tornou\add* \w pesada|strong="H3513"\w* \w contra|strong="H5921"\w* \w Saul|strong="H7586"\w*, \w e os flecheiros|strong="H3384"\w* \w o atingiram|strong="H4672,H7198"\w*, \w e ele se angustiou|strong="H2342"\w* \w por causa dos flecheiros|strong="H4480,H3384"\w*.\x - \xo 10:3 \xt 1SA 31:3; 1SA 31:1; 2SA 1:4; PSA 64:7\x*
\p
\v 4 \w Então Saul disse|strong="H0559,H7586"\w* \w ao seu escudeiro|strong="H0413,H5375,H3627"\w*: "\w Tira|strong="H8025"\w* \w a tua espada|strong="H2719"\w* \w e me atravessa|strong="H1856,H9034"\w* \add com ela, para\add* \w que|strong="H6435"\w* \w não|strong="H6435"\w* \w venham|strong="H0935"\w* \w estes|strong="H0428"\w* \w incircuncisos|strong="H6189"\w* \w e me maltratem|strong="H5953,H9030"\w*."\w Mas|strong="H3808"\w* \w o escudeiro|strong="H5375,H3627"\w* \w não|strong="H3808"\w* \w quis|strong="H0014"\w*, \w porque|strong="H3588"\w* \w estava|strong="H3372"\w* \w muito|strong="H3966"\w* \w atemorizado|strong="H3372"\w*. \add Então\add* \w Saul|strong="H3947,H7586"\w* \w tomou|strong="H3947"\w* \add a\add* \w espada|strong="H2719"\w* \w e se lançou|strong="H5307"\w* \add sobre\add* \w ela|strong="H5921"\w*.\x - \xo 10:4 \xt 1SA 31:4; JDG 9:54; 1SA 31:1; 2SA 1:4; PSA 64:7; ACT 1:18\x*
\v 5 \w E quando o escudeiro|strong="H5375,H3627"\w* \w viu|strong="H7200"\w* \w que|strong="H3588"\w* \w Saul|strong="H7586"\w* \add tinha\add* \w morrido|strong="H4191"\w*, \w ele|strong="H1931"\w* \w também|strong="H1571"\w* \add se\add* \w lançou|strong="H5307"\w* \w sobre|strong="H5921"\w* \add a\add* \w espada|strong="H2719"\w* \w e morreu|strong="H4191"\w*.\x - \xo 10:5 \xt 1SA 31:5; 1SA 31:6; 2SA 1:4; 1SA 16:21; 1SA 31:1; PSA 64:7\x*
\v 6 \w Assim morreu|strong="H4191,H7586"\w* \add Saul\add* \w com três|strong="H7969"\w* \w de seus filhos|strong="H1121"\w*; \add e\add* \w toda|strong="H3605"\w* \w a sua casa|strong="H1004"\w* \w morreu|strong="H4191"\w* \w junta|strong="H3162"\w*.\x - \xo 10:6 \xt 1SA 31:6; 1SA 31:1; 2SA 1:4; PSA 64:7; 1SA 12:25; ECC 9:1-2\x*
\v 7 \add E quando\add* \w todos|strong="H3605"\w* \w os homens|strong="H0376"\w* \add de\add* \w Israel|strong="H3478"\w* \w que|strong="H0834"\w* \add estavam no\add* \w vale|strong="H6010"\w* \w viram|strong="H7200"\w* \w que|strong="H3588"\w* \w tinham fugido|strong="H5127"\w* \w e que|strong="H3588"\w* \w Saul e os seus filhos|strong="H7586,H1121"\w* \w tinham morrido|strong="H4191"\w*, \w abandonaram|strong="H5800"\w* \w as suas cidades|strong="H5892"\w* \w e fugiram|strong="H5127"\w*; \w e vieram|strong="H0935"\w* \add os\add* \w filisteus|strong="H6430"\w* \w e nelas habitaram|strong="H3427,H9038"\w*.\x - \xo 10:7 \xt 1SA 31:7; 1SA 17:19; 1SA 31:1; PSA 64:7; 1SA 13:6\x*
\p
\v 8 \w E no dia seguinte|strong="H1961,H4283"\w*, \w vieram os filisteus|strong="H0935,H6430"\w* \w para despojar|strong="H6584"\w* \add os\add* \w mortos|strong="H2491"\w*, \w e encontraram|strong="H4672"\w* \w Saul|strong="H7586"\w* \w e os seus filhos|strong="H1121"\w* \w caídos|strong="H5307"\w* \w no monte|strong="H2022"\w* \w Gilboa|strong="H1533"\w*.\x - \xo 10:8 \xt 1SA 31:8; 1CH 10:1; 1SA 31:1\x*
\v 9 \w E o despojaram|strong="H6584"\w*, \w e tomaram|strong="H5375"\w* \w a sua cabeça|strong="H7218"\w* \w e as suas armas|strong="H3627"\w*, \w e enviaram mensageiros|strong="H7971"\w* \w pela terra|strong="H0776"\w* \add dos\add* \w filisteus|strong="H6430"\w*, \w por todos os lados|strong="H5439"\w*, \w para anunciar a notícia|strong="H1319"\w* \w aos seus ídolos|strong="H6091"\w* \add e ao\add* \w povo|strong="H5971"\w*.\x - \xo 10:9 \xt 1SA 31:9; 1SA 31:1; 2SA 1:20\x*
\v 10 \w E puseram|strong="H7760"\w* \w as suas armas|strong="H3627"\w* \w no templo|strong="H1004"\w* \w dos seus deuses|strong="H0430"\w*, \w e fixaram|strong="H8628"\w* \w a sua cabeça|strong="H1538"\w* \w no templo|strong="H1004"\w* \add de\add* \w Dagom|strong="H1712"\w*.\x - \xo 10:10 \xt 1SA 31:1; 1SA 31:10; 1SA 5:2\x*
\p
\v 11 \add E quando\add* \w todos|strong="H3605"\w* \w os de Jabes|strong="H3003"\w*-\w Gileade|strong="H1568"\w* \w ouviram|strong="H8085"\w* \w tudo|strong="H3605"\w* \w o que|strong="H0834"\w* \add os\add* \w filisteus|strong="H6430"\w* \add tinham\add* \w feito|strong="H6213"\w* \add a\add* \w Saul|strong="H7586"\w*,\x - \xo 10:11 \xt 1SA 31:11; 2SA 2:4; JDG 21:9; 2SA 2:5; JDG 21:14; 1SA 31:1\x*
