\p
\v 1 \w Sejam imitadores|strong="G3402,G1096"\w* \w meus|strong="G3165"\w*, \w assim como|strong="G2531"\w* \w eu também|strong="G2532,G1473"\w* \w de Cristo|strong="G5547"\w*.\x - \xo 11:1 \xt 1TH 2:14; 1TI 4:12; PHP 3:17; 1JN 2:6; 1TH 1:6; EPH 5:1-2\x*
\v 2 \w Elogio|strong="G1867"\w* \w vocês|strong="G4771"\w*, \w porque|strong="G3754"\w* \w em tudo|strong="G3956"\w* \w se lembram|strong="G3403"\w* \w de mim|strong="G3165"\w* \w e|strong="G2532"\w* \w mantêm|strong="G2722"\w* \w as tradições|strong="G3588,G3862"\w* \w tal como|strong="G2531"\w* \w as transmiti|strong="G3860"\w* \w a vocês|strong="G4771"\w*.\f + \fr 11.2: \ft Lit.: παράδοσις: “tradição”, “ensino transmitido”.\f*\x - \xo 11:2 \xt 2TH 2:15; MAT 25:1; ACT 2:42; MAT 28:20; 1CH 15:13; 1CO 4:17\x*
\p
\v 3 \w Quero|strong="G2309"\w* \w que vocês|strong="G4771"\w* \w saibam|strong="G6063"\w* \w que|strong="G3754"\w* \w de todo homem|strong="G3956,G435"\w* \w a cabeça|strong="G3588,G2776"\w* \w é o Cristo|strong="G3588,G5547,G1510"\w*, \w e cabeça|strong="G2776,G1161"\w* \w da mulher|strong="G1135"\w* \w o homem|strong="G3588,G435"\w*, \w e cabeça|strong="G2776,G1161"\w* \w do Cristo|strong="G3588,G5547"\w* \w Deus|strong="G3588,G2316"\w*.\f + \fr 11.3: \ft Lit.: ἀνήρ e γυνή: “homem” e “mulher” ou “marido” e “esposa”; κεφαλή: “cabeça”, com sentidos discutidos (autoridade, origem, proeminência). Esta tradução usa “homem” e “mulher” em 11:3-16.\f*\x - \xo 11:3 \xt EPH 5:23; EPH 5:22; 1CO 11:8; 1CO 11:7; COL 3:18; 1CO 7:16\x*
\v 4 \w Todo|strong="G3956"\w* \w homem|strong="G435"\w* \w que ora|strong="G4336"\w* \w ou|strong="G2228"\w* \w profetiza|strong="G4395"\w* \w tendo|strong="G2192"\w* \w algo sobre a cabeça|strong="G2596,G2776"\w* \w desonra|strong="G2617"\w* \w a sua cabeça|strong="G3588,G2776,G846"\w*.\f + \fr 11.4: \ft Lit.: κατὰ κεφαλῆς ἔχων: “tendo (algo) sobre a cabeça” ou “caindo da cabeça”, isto é, véu ou manto.\f*\x - \xo 11:4 \xt DEU 22:5; EPH 5:23; 2SA 15:30; 1TH 5:20; ACT 21:9\x*
\v 5 \w Mas toda|strong="G3956,G1161"\w* \w mulher|strong="G1135"\w* \w que ora|strong="G4336"\w* \w ou|strong="G2228"\w* \w profetiza|strong="G4395"\w* \w com a cabeça|strong="G3588,G2776"\w* \w descoberta|strong="G177"\w* \w desonra|strong="G2617"\w* \w a sua cabeça|strong="G3588,G2776,G846"\w*, \w pois|strong="G1063"\w* \w é|strong="G1510"\w* \w uma só|strong="G1520"\w* \w e a mesma coisa|strong="G2532,G3588,G846"\w* \w que ser raspada|strong="G3588,G3587"\w*.\f + \fr 11.5: \ft Tradução: Faz parte da passagem 11:2-16, de termos difíceis (ἀνήρ e γυνή: “homem e mulher” ou “marido e esposa”; κεφαλή; ἐξουσία; cabelo ou véu); ver as notas de 11:3 e de 11:10.\f*\x - \xo 11:5 \xt DEU 22:5; EPH 5:23; 1CO 14:34; DEU 21:12; LUK 2:36; ACT 2:17\x*
\v 6 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w* \w uma mulher|strong="G1135"\w* \w não se cobre|strong="G3756,G2619"\w*, \w que também|strong="G2532"\w* \w corte o cabelo|strong="G2751"\w*; \w mas se|strong="G1487,G1161"\w* \w é vergonhoso|strong="G150"\w* \w para a mulher|strong="G1135"\w* \w cortar o cabelo|strong="G3588,G2751"\w* \w ou|strong="G2228"\w* \w raspar-se|strong="G3587"\w*, \w que se cubra|strong="G2619"\w*.\f + \fr 11.6: \ft Tradução: Faz parte da passagem 11:2-16, de termos difíceis (ἀνήρ e γυνή: “homem e mulher” ou “marido e esposa”; κεφαλή; ἐξουσία; cabelo ou véu); ver as notas de 11:3 e de 11:10.\f*\f + \fr 11.6: \ft Acréscimo: verbo ser/estar suprido em “é vergonhoso”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:6 \xt DEU 22:5; EPH 5:23; GEN 24:65\x*
\v 7 \w Pois|strong="G1063"\w* \w o homem|strong="G435"\w* \w não deve|strong="G3756,G3784"\w* \w cobrir|strong="G2619"\w* \w a cabeça|strong="G3588,G2776"\w*, \w sendo|strong="G5225"\w* \w imagem|strong="G1504"\w* \w e|strong="G2532"\w* \w glória|strong="G1391"\w* \w de Deus|strong="G2316"\w*; \w mas a mulher|strong="G3588,G1135,G1161"\w* \w é|strong="G1510"\w* \w glória|strong="G1391"\w* \w do homem|strong="G435"\w*.\x - \xo 11:7 \xt 1CO 11:3; GEN 2:18; DEU 22:5; GEN 1:26; GEN 1:27; EPH 5:23\x*
\v 8 \w Pois|strong="G1063"\w* \w o homem|strong="G435"\w* \w não é|strong="G3756,G1510"\w* \w da mulher|strong="G1537,G1135"\w*, \w mas|strong="G235"\w* \w a mulher|strong="G1135"\w* \w do homem|strong="G1537,G435"\w*;\f + \fr 11.8: \ft Tradução: Faz parte da passagem 11:2-16, de termos difíceis (ἀνήρ e γυνή: “homem e mulher” ou “marido e esposa”; κεφαλή; ἐξουσία; cabelo ou véu); ver as notas de 11:3 e de 11:10.\f*\x - \xo 11:8 \xt EPH 5:23; 1CO 7:16; EPH 5:22; 1CO 11:3; 1CO 11:12; JHN 4:17\x*
\v 9 \w pois também|strong="G2532,G1063"\w* \w não foi criado|strong="G3756,G2936"\w* \w o homem|strong="G435"\w* \w por causa da mulher|strong="G1223,G3588,G1135"\w*, \w mas|strong="G235"\w* \w a mulher|strong="G1135"\w* \w por causa do homem|strong="G1223,G3588,G435"\w*.\f + \fr 11.9: \ft Tradução: Faz parte da passagem 11:2-16, de termos difíceis (ἀνήρ e γυνή: “homem e mulher” ou “marido e esposa”; κεφαλή; ἐξουσία; cabelo ou véu); ver as notas de 11:3 e de 11:10.\f*\x - \xo 11:9 \xt EPH 5:23; GEN 2:18; DEU 22:5; GEN 1:27; GEN 2:22; GEN 2:23\x*
\v 10 \w Por isso|strong="G1223,G3778"\w* \w a mulher|strong="G3588,G1135"\w* \w deve|strong="G3784"\w* \w ter|strong="G2192"\w* \w autoridade|strong="G1849"\w* \w sobre a cabeça|strong="G1909,G3588,G2776"\w*, \w por causa dos anjos|strong="G1223,G3588,G32"\w*.\f + \fr 11.10: \ft Lit.: ἐξουσίαν ἔχειν ἐπὶ τῆς κεφαλῆς: “ter autoridade sobre a cabeça”, expressão de sentido discutido (sinal de autoridade sobre a mulher, ou autoridade da própria mulher); διὰ τοὺς ἀγγέλους: “por causa dos anjos”, de sentido discutido.\f*\x - \xo 11:10 \xt EPH 5:23; GEN 2:18; DEU 22:5; 1CO 14:34; GEN 24:64-65; HEB 1:14\x*
\v 11 \w Contudo|strong="G4133"\w*, \w nem|strong="G3777"\w* \w a mulher|strong="G1135"\w* \w sem o homem|strong="G5565,G435"\w*, \w nem|strong="G3777"\w* \w o homem|strong="G435"\w* \w sem a mulher|strong="G5565,G1135"\w*, \w no Senhor|strong="G1722,G2962"\w*.\f + \fr 11.11: \ft Tradução: Faz parte da passagem 11:2-16, de termos difíceis (ἀνήρ e γυνή: “homem e mulher” ou “marido e esposa”; κεφαλή; ἐξουσία; cabelo ou véu); ver as notas de 11:3 e de 11:10.\f*\x - \xo 11:11 \xt GEN 2:18; DEU 22:5; PRO 12:4; GAL 3:28; 1CO 7:10-14; 1PE 5:3\x*
\v 12 \w Pois|strong="G1063"\w* \w assim como|strong="G5618"\w* \w a mulher|strong="G3588,G1135"\w* \w vem do homem|strong="G1537,G3588,G435"\w*, \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w o homem|strong="G3588,G435"\w* \w nasce por meio da mulher|strong="G1223,G3588,G1135"\w*; \w e todas as coisas|strong="G3588,G1161,G3956"\w* \w vêm de Deus|strong="G1537,G3588,G2316"\w*.\f + \fr 11.12: \ft Tradução: Faz parte da passagem 11:2-16, de termos difíceis (ἀνήρ e γυνή: “homem e mulher” ou “marido e esposa”; κεφαλή; ἐξουσία; cabelo ou véu); ver as notas de 11:3 e de 11:10.\f*\x - \xo 11:12 \xt JHN 5:26; 1CO 11:8; EPH 5:24; GEN 2:18; DEU 22:5; ROM 11:36\x*
\v 13 \w Julguem|strong="G2919"\w* \w entre vocês mesmos|strong="G1722,G4771,G846"\w*: \w é apropriado|strong="G4241,G1510"\w* \w que uma mulher|strong="G1135"\w* \w ore|strong="G4336"\w* \w a Deus|strong="G3588,G2316"\w* \w descoberta|strong="G177"\w*?\f + \fr 11.13: \ft Variante: diferença entre as edições, conforme o TAGNT: o TR e o texto bizantino trazem a mais ἢ.\f*\x - \xo 11:13 \xt DEU 22:5; ROM 14:13; 1CO 11:5\x*
\v 14 \w Nem|strong="G3761"\w* \w a própria natureza|strong="G3588,G5449,G846"\w* \w lhes ensina|strong="G1321,G4771"\w* \w que|strong="G3754"\w* \w se um homem|strong="G435,G1437"\w* \w deixa o cabelo crescer|strong="G2863"\w*, \w é desonra|strong="G819,G1510"\w* \w para ele|strong="G846"\w*,\f + \fr 11.14: \ft Tradução: Faz parte da passagem 11:2-16, de termos difíceis (ἀνήρ e γυνή: “homem e mulher” ou “marido e esposa”; κεφαλή; ἐξουσία; cabelo ou véu); ver as notas de 11:3 e de 11:10.\f*\x - \xo 11:14 \xt DEU 22:5; EZK 44:20; 2SA 14:26\x*
\v 15 \w mas se uma mulher|strong="G1135,G1161,G1437"\w* \w deixa o cabelo crescer|strong="G2863"\w*, \w é glória|strong="G1391,G1510"\w* \w para ela|strong="G846"\w*? \w Porque|strong="G3754"\w* \w o cabelo|strong="G3588,G2864"\w* \w lhe foi dado|strong="G1325"\w* \w em lugar de|strong="G473"\w* \w um manto|strong="G4018"\w*.\f + \fr 11.15: \ft Lit.: περιβόλαιον: “manto”, “véu”, “cobertura”.\f*\x - \xo 11:15 \xt DEU 22:5; NUM 6:5; REV 9:8\x*
\v 16 \w Mas se|strong="G1487,G1161"\w* \w alguém|strong="G5100"\w* \w parece|strong="G1380"\w* \w ser|strong="G1511"\w* \w contencioso|strong="G5380"\w*, \w nós|strong="G3165"\w* \w não temos|strong="G3756,G2192"\w* \w tal|strong="G5108"\w* \w costume|strong="G4914"\w*, \w nem|strong="G3761"\w* \w as comunidades|strong="G3588,G1577"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 11.16: \ft Tradução: Faz parte da passagem 11:2-16, de termos difíceis (ἀνήρ e γυνή: “homem e mulher” ou “marido e esposa”; κεφαλή; ἐξουσία; cabelo ou véu); ver as notas de 11:3 e de 11:10.\f*\x - \xo 11:16 \xt 1CO 14:33; 1CO 7:17; 1TI 6:3-4; 1TH 2:14; 1CO 4:17; ACT 21:24\x*
\v 17 \w Mas|strong="G1161"\w* \w ao ordenar|strong="G3853"\w* \w isto|strong="G3778"\w*, \w não elogio|strong="G3756,G1867"\w*, \w porque|strong="G3754"\w* \w vocês se reúnem|strong="G4905"\w* \w não|strong="G3756"\w* \w para o melhor|strong="G1519,G3588,G2908"\w*, \w mas|strong="G235"\w* \w para o pior|strong="G1519,G3588,G2276"\w*.\x - \xo 11:17 \xt HEB 10:25; 1CO 11:2; 1CO 11:22; 1CO 14:23; 1PE 2:14; ISA 1:13\x*
\v 18 \w Pois|strong="G1063"\w* \w primeiramente|strong="G4413,G3303"\w*, \w quando vocês se reúnem|strong="G4905,G4771"\w* \w em comunidade|strong="G1722,G1577"\w*, \w ouço dizer|strong="G191"\w* \w que há|strong="G5225"\w* \w divisões|strong="G4978"\w* \w entre vocês|strong="G1722,G4771"\w*, \w e|strong="G2532"\w* \w em parte|strong="G3313,G5100"\w* \w creio|strong="G4100"\w*.\x - \xo 11:18 \xt HEB 10:25; 1CO 1:10; 1CO 3:3; ACT 14:27; ROM 16:17; 1CO 13:5\x*
\v 19 \w Pois|strong="G1063"\w* \w é necessário|strong="G1163"\w* \w também|strong="G2532"\w* \w que haja|strong="G1511"\w* \w facções|strong="G139"\w* \w entre vocês|strong="G1722,G4771"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w os aprovados|strong="G3588,G1384"\w* \w se tornem|strong="G1096"\w* \w manifestos|strong="G5318"\w* \w entre vocês|strong="G1722,G4771"\w*.\f + \fr 11.19: \ft Lit.: αἵρεσις: “facção”, “partido”, “escola”.\f*\x - \xo 11:19 \xt 1JN 2:19; 2PE 2:1; LUK 17:1; MAT 18:7; TIT 3:10; ACT 20:30\x*
\v 20 \w Quando vocês se reúnem|strong="G4905,G4771"\w* \w no mesmo lugar|strong="G1909,G3588,G846"\w*, \w então|strong="G3767"\w*, \w não é|strong="G3756,G1510"\w* \w a ceia|strong="G1173"\w* \w do Senhor|strong="G2960"\w* \w o que comem|strong="G5315"\w*,\f + \fr 11.20: \ft Lit.: ἐπὶ τὸ αὐτό: “no mesmo (lugar)”, “juntos”.\f*\x - \xo 11:20 \xt HEB 10:25; ACT 2:42; JUD 1:12; ACT 2:46; ZEC 7:6; 2PE 2:13\x*
\v 21 \w pois|strong="G1063"\w* \w cada um|strong="G1538"\w* \w toma antes|strong="G4301"\w* \w a sua própria|strong="G3588,G2398"\w* \w ceia|strong="G1173"\w* \w ao comer|strong="G1722,G3588,G5315"\w*, \w e|strong="G2532"\w* \w um|strong="G3739,G3303"\w* \w passa fome|strong="G3983"\w*, \w e outro|strong="G3739,G1161"\w* \w se embriaga|strong="G3184"\w*.\x - \xo 11:21 \xt 1CO 11:34; 2PE 2:13; ACT 2:42; JUD 1:12; ACT 2:46; EPH 5:18\x*
\v 22 \w Pois acaso não|strong="G3361,G1063,G3756"\w* \w têm|strong="G2192"\w* \w casas|strong="G3614"\w* \w para comer|strong="G1519,G3588,G2068"\w* \w e|strong="G2532"\w* \w beber|strong="G4095"\w*? \w Ou|strong="G2228"\w* \w desprezam|strong="G2706"\w* \w a comunidade|strong="G3588,G1577"\w* \w de Deus|strong="G3588,G2316"\w*, \w e|strong="G2532"\w* \w envergonham|strong="G2617"\w* \w os que não têm|strong="G3588,G3361,G2192"\w*? \w O que|strong="G5101"\w* \w lhes direi|strong="G2036,G4771"\w*? \w Eu os elogiarei|strong="G1867,G4771"\w*? \w Nisto|strong="G1722,G3778"\w* \w não elogio|strong="G3756,G1867"\w*.\x - \xo 11:22 \xt JAS 2:6; 1CO 11:34; ACT 20:28; ECC 5:1; ACT 2:42; JUD 1:12\x*
\v 23 \w Pois|strong="G1063"\w* \w eu|strong="G1473"\w* \w recebi|strong="G3880"\w* \w do Senhor|strong="G575,G3588,G2962"\w* \w o que|strong="G3739"\w* \w também|strong="G2532"\w* \w transmiti|strong="G3860"\w* \w a vocês|strong="G4771"\w*: \w que|strong="G3754"\w* \w o Senhor|strong="G3588,G2962"\w* \w Jesus|strong="G2424"\w* \w na noite|strong="G1722,G3588,G3571"\w* \w em que|strong="G3739"\w* \w foi entregue|strong="G3860"\w* \w tomou|strong="G2983"\w* \w pão|strong="G740"\w*,\f + \fr 11.23: \ft Lit.: παραλαμβάνω e παραδίδωμι: “receber” e “transmitir”; o mesmo verbo, em παρεδίδετο, significa “era entregue” ou “era traído”.\f*\x - \xo 11:23 \xt 1CO 15:3; JHN 19:16; LUK 22:19; MAT 26:26; JHN 6:35; 1CO 10:16\x*
\v 24 \w e|strong="G2532"\w* \w tendo dado graças|strong="G2168"\w*, \w partiu|strong="G2806"\w* \w e|strong="G2532"\w* \w disse|strong="G2036"\w*: “\w Isto|strong="G3778"\w* \w é|strong="G1510"\w* \w o meu corpo|strong="G3165,G3588,G4983"\w* \w que é|strong="G3588"\w* \w em favor|strong="G5228"\w* \w de vocês|strong="G4771"\w*; \w façam|strong="G4160"\w* \w isto|strong="G3778"\w* \w em minha memória|strong="G1519,G3588,G1473,G364"\w*.”\f + \fr 11.24: \ft Variante: o RP acrescenta Λάβετε φάγετε (“tomem, comam”) depois de εἶπεν e κλώμενον (“partido”) depois de ὑμῶν.\f*\f + \fr 11.24: \ft Lit.: ἐστιν, “é”: o sentido do “é” (identidade, representação, presença) é discutido entre as tradições.\f*\f + \fr 11.24: \ft Acréscimo: verbo ser/estar suprido em “que é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:24 \xt LUK 22:19; MAT 26:26; MRK 14:22; JHN 6:35; JHN 6:53-58; 1CO 10:16\x*
\v 25 \w Do mesmo modo|strong="G5615"\w*, \w também|strong="G2532"\w* \w o cálice|strong="G3588,G4221"\w* \w depois de ter ceado|strong="G3326,G3588,G1172"\w*, \w dizendo|strong="G3004"\w*: “\w Este|strong="G3778"\w* \w cálice|strong="G3588,G4221"\w* \w é|strong="G1510"\w* \w a nova|strong="G3588,G2537"\w* \w aliança|strong="G1242"\w* \w no meu|strong="G1722,G3588,G1473"\w* \w sangue|strong="G129"\w*; \w façam|strong="G4160"\w* \w isto|strong="G3778"\w*, \w todas as vezes que|strong="G3740,G1437"\w* \w beberem|strong="G4095"\w*, \w em minha memória|strong="G1519,G3588,G1473,G364"\w*.”\f + \fr 11.25: \ft Tradução: διαθήκη, “aliança” (também “testamento”); a fórmula é a da instituição da ceia, comparável a Lc 22:20; ver as notas de 11:23-24.\f*\x - \xo 11:25 \xt LUK 22:20; LUK 22:19; MAT 26:26; JER 31:31; JHN 6:35; 1CO 10:16\x*
\v 26 \w Pois|strong="G1063"\w* \w todas as vezes que|strong="G3740,G1437"\w* \w comerem|strong="G2068"\w* \w este pão|strong="G3588,G740,G3778"\w* \w e|strong="G2532"\w* \w beberem|strong="G4095"\w* \w o cálice|strong="G3588,G4221"\w*, \w anunciam|strong="G2605"\w* \w a morte|strong="G3588,G2288"\w* \w do Senhor|strong="G3588,G2962"\w* \w até que|strong="G891,G3739"\w* \w ele venha|strong="G2064"\w*.\f + \fr 11.26: \ft Variante: o RP traz ἂν em lugar de ἐάν, acrescenta τοῦτο (“este”) depois de ποτήριον e ἂν depois de οὗ.\f*\x - \xo 11:26 \xt 1CO 11:28; LUK 22:19; MAT 26:26; JHN 6:35; 1CO 10:16; HEB 9:28\x*
\v 27 \w De modo que|strong="G5620"\w* \w quem|strong="G3739,G302"\w* \w comer|strong="G2068"\w* \w o pão|strong="G3588,G740"\w* \w ou|strong="G2228"\w* \w beber|strong="G4095"\w* \w o cálice|strong="G3588,G4221"\w* \w do Senhor|strong="G3588,G2962"\w* \w indignamente|strong="G371"\w*, \w será réu|strong="G1777,G1510"\w* \w do corpo|strong="G3588,G4983"\w* \w e|strong="G2532"\w* \w do sangue|strong="G3588,G129"\w* \w do Senhor|strong="G3588,G2962"\w*.\f + \fr 11.27: \ft Variante: o RP acrescenta τοῦτον (“este”) depois de ἄρτον e τοῦ κυρίου depois de ἀναξίως.\f*\x - \xo 11:27 \xt MAT 26:26; 1CO 10:16; 1CO 11:29; MRK 14:22; LUK 22:19; JHN 6:51\x*
\v 28 \w Ponha à prova|strong="G1381"\w* \w a si mesma|strong="G1438"\w* \w a pessoa|strong="G444"\w*, \w e|strong="G2532"\w* \w assim|strong="G3779"\w* \w coma|strong="G2068"\w* \w do pão|strong="G1537,G3588,G740"\w* \w e|strong="G2532"\w* \w beba|strong="G4095"\w* \w do cálice|strong="G1537,G3588,G4221"\w*.\f + \fr 11.28: \ft Lit.: δοκιμάζω: “provar”, “pôr à prova”, “examinar”.\f*\x - \xo 11:28 \xt MAT 26:27; 2CO 13:5; 1CO 11:26; MRK 14:22; LUK 22:19; MAT 26:26\x*
\v 29 \w Pois|strong="G1063"\w* \w quem come|strong="G3588,G2068"\w* \w e|strong="G2532"\w* \w bebe|strong="G4095"\w*, \w come|strong="G2068"\w* \w e|strong="G2532"\w* \w bebe|strong="G4095"\w* \w julgamento|strong="G2917"\w* \w para si mesmo|strong="G1438"\w*, \w não discernindo|strong="G3361,G1252"\w* \w o corpo|strong="G3588,G4983"\w*.\f + \fr 11.29: \ft Lit.: διακρίνω: “discernir”, “distinguir”, “julgar”; τὸ σῶμα: “o corpo”, o corpo de Cristo na ceia ou a comunidade.\f*\f + \fr 11.29: \ft Variante: o RP acrescenta ἀναξίως (“indignamente”) depois de πίνων e τοῦ κυρίου (“do Senhor”) depois de σῶμα.\f*\x - \xo 11:29 \xt 1CO 11:27; MRK 14:22; LUK 22:19; MAT 26:26; JHN 6:35; ROM 14:23\x*
\v 30 \w Por isso|strong="G1223,G3778"\w* \w entre vocês|strong="G1722,G4771"\w* \w há muitos|strong="G4183"\w* \w fracos|strong="G772"\w* \w e|strong="G2532"\w* \w doentes|strong="G732"\w*, \w e|strong="G2532"\w* \w bastantes|strong="G2425"\w* \w dormem|strong="G2837"\w*.\f + \fr 11.30: \ft Lit.: κοιμῶνται: “dormem”, eufemismo para morrer.\f*\f + \fr 11.30: \ft Acréscimo: verbo ser/estar suprido em “há muitos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 11:30 \xt ROM 14:23; JAS 3:1; JAS 5:15; REV 3:19; EXO 15:26; MAL 1:7\x*
\v 31 \w Mas se|strong="G1487,G1161"\w* \w a nós mesmos|strong="G1438"\w* \w discerníssemos|strong="G1252"\w*, \w não|strong="G3756"\w* \w seríamos julgados|strong="G302,G2919"\w*.\x - \xo 11:31 \xt 2CO 13:5; ROM 14:23; 1JN 1:9; PSA 32:3-5; JAS 3:1; 1CO 11:28\x*
\v 32 \w Mas|strong="G1161"\w* \w sendo julgados|strong="G2919"\w* \w pelo Senhor|strong="G5259,G2962"\w*, \w somos disciplinados|strong="G3811"\w*, \w para que|strong="G2443"\w* \w não|strong="G3361"\w* \add sejamos\add* \w condenados|strong="G2632"\w* \w com o mundo|strong="G4862,G3588,G2889"\w*.\f + \fr 11.32: \ft Acréscimo: “sejamos” (em “que não sejamos condenados com”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 11:32 \xt PSA 119:71; HEB 12:5; REV 3:19; PSA 94:12; PSA 118:18; 1TI 1:20\x*
\v 33 \w De modo que|strong="G5620"\w*, \w meus irmãos e irmãs|strong="G80,G3165"\w*, \w quando se reunirem|strong="G4905"\w* \w para comer|strong="G1519,G3588,G5315"\w*, \w esperem|strong="G1551"\w* \w uns pelos outros|strong="G240"\w*\f + \fr 11.33: \ft Lit.: ἐκδέχομαι: “esperar”, “aguardar” ou “acolher”.\f*.\x - \xo 11:33 \xt 1CO 11:29; ACT 20:7; MRK 3:20\x*
\v 34 \w Se|strong="G1487"\w* \w alguém|strong="G5100"\w* \w tem fome|strong="G3983"\w*, \w coma|strong="G2068"\w* \w em casa|strong="G1722,G3624"\w*, \w para que|strong="G2443"\w* \w não|strong="G3361"\w* \w se reúnam|strong="G4905"\w* \w para julgamento|strong="G1519,G2917"\w*. \w Quanto às demais coisas|strong="G3588,G1161,G3062"\w*, \w quando|strong="G5613,G302"\w* \w eu for|strong="G2064"\w*, \w darei instruções|strong="G1299"\w*.\x - \xo 11:34 \xt 1CO 11:29; 1CO 11:21-22; 1CO 14:40; 1CO 4:19; 1CO 7:17; 1TI 5:12\x*
\c 12
\p
\v 1 \w Quanto|strong="G4012,G1161"\w* \w às coisas espirituais|strong="G3588,G4152"\w*, \w irmãos e irmãs|strong="G80"\w*, \w não quero|strong="G3756,G2309"\w* \w que vocês|strong="G4771"\w* \w ignorem|strong="G50"\w*\f + \fr 12.1: \ft Lit.: τῶν πνευματικῶν: neutro (“as coisas espirituais”, “os dons espirituais”) ou masculino (“as pessoas espirituais”).\f*.\x - \xo 12:1 \xt 1TH 4:13; 1CO 12:4-11; 1CO 14:1; EPH 4:11; 1CO 14:37; 1CO 2:13\x*
\v 2 \w Vocês sabem|strong="G6063"\w* \w que|strong="G3754"\w*, \w quando|strong="G3753"\w* \w eram|strong="G1510"\w* \w gentios|strong="G1484"\w*, \w eram arrastados|strong="G520"\w* \w aos ídolos|strong="G4314,G3588,G1497"\w* \w mudos|strong="G3588,G880"\w*, \w conforme|strong="G5613,G302"\w* \w eram conduzidos|strong="G71"\w*.\f + \fr 12.2: \ft Variante: diferença entre as edições, conforme o TAGNT: ὅτε consta do SBLGNT e não consta no TR.\f*\x - \xo 12:2 \xt 1PE 4:3; 1TH 1:9; PSA 115:5; JER 10:5; GAL 4:8; HAB 2:18\x*
\v 3 \w Por isso|strong="G1352"\w* \w faço saber|strong="G1107"\w* \w a vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w ninguém|strong="G3762"\w* \w falando|strong="G2980"\w* \w pelo Espírito|strong="G1722,G4151"\w* \w de Deus|strong="G2316"\w* \w diz|strong="G3004"\w*: “\w Jesus|strong="G2424"\w* \add é\add* \w anátema|strong="G331"\w*”, \w e|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w pode|strong="G1410"\w* \w dizer|strong="G2036"\w*: “\w Jesus|strong="G2424"\w* \add é\add* \w Senhor|strong="G2962"\w*”, \w a não ser|strong="G1487,G3361"\w* \w pelo Espírito Santo|strong="G1722,G4151,G40"\w*\f + \fr 12.3: \ft Lit.: Ἀνάθεμα Ἰησοῦς: “Jesus seja anátema (maldito)”.\f*.\f + \fr 12.3: \ft Acréscimo: “é” (em “diz Jesus é anátema e”), “é” (em “dizer Jesus é Senhor a”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 12:3 \xt 1JN 4:2; ROM 10:9; JHN 14:26; MAT 16:16-17; MRK 9:39; PHP 2:11\x*
\p
\v 4 \w Ora, há|strong="G1161,G1510"\w* \w variedades|strong="G1243"\w* \w de dons|strong="G5486"\w*, \w mas|strong="G1161"\w* \w o mesmo|strong="G3588,G846"\w* \w Espírito|strong="G4151"\w*;\f + \fr 12.4: \ft Lit.: διαίρεσις: “divisão”, “distribuição”, “variedade”.\f*\x - \xo 12:4 \xt 1PE 4:10; MAT 28:19; ROM 12:6; EPH 4:4; EXO 31:3; 1CO 12:28\x*
\v 5 \w e|strong="G2532"\w* \w há|strong="G1510"\w* \w variedades|strong="G1243"\w* \w de serviços|strong="G1248"\w*, \w e|strong="G2532"\w* \w o mesmo|strong="G3588,G846"\w* \w Senhor|strong="G2962"\w*;\x - \xo 12:5 \xt 1PE 4:10; MAT 28:19; ROM 12:6; EPH 4:4; EXO 31:3; JAS 1:17\x*
\v 6 \w e|strong="G2532"\w* \w há|strong="G1510"\w* \w variedades|strong="G1243"\w* \w de atuações|strong="G1755"\w*, \w mas|strong="G1161"\w* \w o mesmo|strong="G3588,G846"\w* \w Deus|strong="G2316"\w*, \w que realiza|strong="G3588,G1754"\w* \w todas as coisas|strong="G3588,G3956"\w* \w em todos|strong="G1722,G3956"\w*.\x - \xo 12:6 \xt 1PE 4:10; PHP 2:13; MAT 28:19; ROM 12:6; EPH 4:4; EXO 31:3\x*
\v 7 \w A cada um|strong="G1538"\w* \w é dada|strong="G1325"\w* \w a manifestação|strong="G3588,G5321"\w* \w do Espírito|strong="G3588,G4151"\w* \w para o bem comum|strong="G4314,G3588,G4851"\w*.\x - \xo 12:7 \xt 1PE 4:10; 2TI 3:16; ROM 12:6; EPH 4:4; EXO 31:3; 1CO 14:26\x*
\v 8 \w Pois|strong="G1063"\w* \w a um|strong="G3739,G3303"\w* \w é dada|strong="G1325"\w* \w por meio do Espírito|strong="G1223,G3588,G4151"\w* \w uma palavra|strong="G3056"\w* \w de sabedoria|strong="G4678"\w*, \w a outro|strong="G243,G1161"\w* \w uma palavra|strong="G3056"\w* \w de conhecimento|strong="G1108"\w* \w segundo o mesmo|strong="G2596,G3588,G846"\w* \w Espírito|strong="G4151"\w*,\x - \xo 12:8 \xt 1PE 4:10; ROM 12:6; EPH 4:4; EXO 31:3; 1CO 14:26; EPH 4:7\x*
\v 9 \w a outro|strong="G2087"\w* \w fé|strong="G4102"\w* \w no mesmo|strong="G1722,G3588,G846"\w* \w Espírito|strong="G4151"\w*, \w a outro|strong="G243"\w* \w dons|strong="G5486"\w* \w de curas|strong="G2386"\w* \w no único|strong="G1722,G3588,G1520"\w* \w Espírito|strong="G4151"\w*,\f + \fr 12.9: \ft Variante: o RP acrescenta δέ depois de ἑτέρῳ e traz αὐτῷ em lugar de ἑνί; o SBLGNT traz ἄλλῳ sem δέ (leitura atribuída a Holmes), e WH, Treg, NA28 e RP trazem ἄλλῳ δέ.\f*\x - \xo 12:9 \xt 1CO 12:30; 1CO 12:28; 1PE 4:10; ROM 12:6; EPH 4:4; EXO 31:3\x*
\v 10 \w a outro|strong="G243"\w* \w atuações|strong="G1755"\w* \w de poderes|strong="G1411"\w*, \w a outro|strong="G243"\w* \w profecia|strong="G4394"\w*, \w a outro|strong="G243"\w* \w discernimento|strong="G1253"\w* \w de espíritos|strong="G4151"\w*, \w a outro|strong="G2087"\w* \w variedades|strong="G1085"\w* \w de línguas|strong="G1100"\w*, \w a outro|strong="G243"\w* \w interpretação|strong="G2058"\w* \w de línguas|strong="G1100"\w*;\f + \fr 12.10: \ft Lit.: δυνάμεων: “obras de poder”, “milagres”; γλῶσσαι: “línguas”, isto é, falas extáticas ou idiomas, de sentido discutido.\f*\x - \xo 12:10 \xt 1PE 4:10; MRK 16:17; JHN 14:12; ACT 2:4; ROM 12:6; EPH 4:4\x*
\v 11 \w todas estas coisas|strong="G3956,G3778"\w* \w realiza|strong="G1754"\w* \w o único|strong="G3588,G1520"\w* \w e|strong="G2532"\w* \w mesmo|strong="G3588,G846"\w* \w Espírito|strong="G4151"\w*, \w distribuindo|strong="G1244"\w* \w em particular|strong="G2398"\w* \w a cada um|strong="G1538"\w* \w como|strong="G2531"\w* \w quer|strong="G1014"\w*.\x - \xo 12:11 \xt 1PE 4:10; JHN 14:12; ROM 12:6; EPH 4:4; EXO 31:3; EPH 4:7\x*
\p
\v 12 \w Pois|strong="G1063"\w* \w assim como|strong="G2509"\w* \w o corpo|strong="G3588,G4983"\w* \w é|strong="G1510"\w* \w um|strong="G1520"\w* \w e|strong="G2532"\w* \w tem|strong="G2192"\w* \w muitos|strong="G4183"\w* \w membros|strong="G3196"\w*, \w e todos|strong="G3956,G1161"\w* \w os membros|strong="G3588,G3196"\w* \w do corpo|strong="G3588,G4983"\w*, \w sendo|strong="G1510"\w* \w muitos|strong="G4183"\w*, \w são|strong="G1510"\w* \w um só|strong="G1520"\w* \w corpo|strong="G4983"\w*, \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w o Cristo|strong="G3588,G5547"\w*.\f + \fr 12.12: \ft Variante: o RP traz a ordem ἔχει πολλά e acrescenta τοῦ ἑνός (“do um só”) depois de σώματος.\f*\x - \xo 12:12 \xt ROM 12:4; EPH 5:30; 1CO 12:27; 1CO 12:14; ROM 12:5; 1CO 12:20\x*
\v 13 \w Pois também|strong="G2532,G1063"\w* \w em um só|strong="G1722,G1520"\w* \w Espírito|strong="G4151"\w* \w nós|strong="G3165"\w* \w todos|strong="G3956"\w* \w fomos batizados|strong="G907"\w* \w em um só|strong="G1519,G1520"\w* \w corpo|strong="G4983"\w*, \w sejam|strong="G1535"\w* \w judeus|strong="G2453"\w*, \w sejam|strong="G1535"\w* \w gregos|strong="G1672"\w*, \w sejam|strong="G1535"\w* \w escravos|strong="G1401"\w*, \w sejam|strong="G1535"\w* \w livres|strong="G1658"\w*, \w e|strong="G2532"\w* \w todos|strong="G3956"\w* \w fomos levados a beber|strong="G4222"\w* \w de um só|strong="G1520"\w* \w Espírito|strong="G4151"\w*.\f + \fr 12.13: \ft Lit.: ἐποτίσθημεν: “fomos dados a beber”, “fomos regados”.\f*\f + \fr 12.13: \ft Acréscimo: verbo ser/estar suprido em “sejam”, “sejam”, “sejam”, “sejam”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:13 \xt GAL 3:28; COL 3:11; 1CO 6:17; EPH 2:18; EPH 4:3; GAL 3:27\x*
\v 14 \w Pois também|strong="G2532,G1063"\w* \w o corpo|strong="G3588,G4983"\w* \w não é|strong="G3756,G1510"\w* \w um só|strong="G1520"\w* \w membro|strong="G3196"\w*, \w mas|strong="G235"\w* \w muitos|strong="G4183"\w*.\x - \xo 12:14 \xt EPH 5:30; 1CO 12:27; 1CO 12:19; 1CO 12:20; ROM 12:5; ROM 12:4\x*
\v 15 \w Se|strong="G1437"\w* \w o pé|strong="G3588,G4228"\w* \w disser|strong="G2036"\w*: “\w Porque|strong="G3754"\w* \w não sou|strong="G3756,G1510"\w* \w mão|strong="G5495"\w*, \w não sou|strong="G3756,G1510"\w* \w do corpo|strong="G1537,G3588,G4983"\w*”, \w não é por isso que|strong="G3756,G3844,G3778"\w* \w não é|strong="G3756,G1510"\w* \w do corpo|strong="G1537,G3588,G4983"\w*?\f + \fr 12.15: \ft Acréscimo: verbo ser/estar suprido em “não é por isso que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:15 \xt LUK 24:40; EPH 5:30; MAT 25:14; PHP 1:27; 1CO 12:27; EPH 1:23\x*
\v 16 \w E|strong="G2532"\w* \w se|strong="G1437"\w* \w a orelha|strong="G3588,G3775"\w* \w disser|strong="G2036"\w*: “\w Porque|strong="G3754"\w* \w não sou|strong="G3756,G1510"\w* \w olho|strong="G3788"\w*, \w não sou|strong="G3756,G1510"\w* \w do corpo|strong="G1537,G3588,G4983"\w*”, \w não é por isso que|strong="G3756,G3844,G3778"\w* \w não é|strong="G3756,G1510"\w* \w do corpo|strong="G1537,G3588,G4983"\w*;\f + \fr 12.16: \ft Acréscimo: verbo ser/estar suprido em “não é por isso que”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:16 \xt MAT 13:16; MRK 8:18; EPH 5:30; MAT 25:14; PHP 1:27; 1CO 12:27\x*
\v 17 \w Se|strong="G1487"\w* \w todo|strong="G3650"\w* \w o corpo|strong="G3588,G4983"\w* \add fosse\add* \w olho|strong="G3788"\w*, \w onde|strong="G4226"\w* \w estaria a audição|strong="G3588,G189"\w*? \w Se|strong="G1487"\w* \w todo|strong="G3650"\w* \add fosse\add* \w audição|strong="G189"\w*, \w onde|strong="G4226"\w* \w estaria o olfato|strong="G3588,G3750"\w*?\f + \fr 12.17: \ft Acréscimo: “fosse” (em “o corpo fosse olho onde”), “fosse” (em “Se todo fosse audição onde”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige; verbo ser/estar suprido em “estaria a audição”, “estaria o olfato”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:17 \xt EPH 5:30; MAT 25:14; PHP 1:27; 1CO 12:27; EPH 1:23; EPH 4:16\x*
\v 18 \w Mas agora|strong="G3570,G1161"\w* \w Deus|strong="G3588,G2316"\w* \w colocou|strong="G5087"\w* \w os membros|strong="G3588,G3196"\w*, \w cada um|strong="G1520,G1538"\w* \w deles|strong="G846"\w*, \w no corpo|strong="G1722,G3588,G4983"\w*, \w como|strong="G2531"\w* \w quis|strong="G2309"\w*.\x - \xo 12:18 \xt EPH 5:30; 1CO 12:27; 1CO 15:38; 1CO 12:14; ECC 4:9; 1CO 12:28\x*
\v 19 \w Mas se|strong="G1487,G1161"\w* \w todos|strong="G3588,G3956"\w* \w fossem|strong="G1510"\w* \w um só|strong="G1520"\w* \w membro|strong="G3196"\w*, \w onde|strong="G4226"\w* \w estaria o corpo|strong="G3588,G4983"\w*?\f + \fr 12.19: \ft Acréscimo: verbo ser/estar suprido em “estaria o corpo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:19 \xt EPH 5:30; 1CO 12:14; 1CO 12:27; ROM 12:5; 1CO 12:12; 1CO 6:15\x*
\v 20 \w Mas agora|strong="G3568,G1161"\w* \w há muitos|strong="G4183"\w* \w de fato|strong="G3303"\w* \w membros|strong="G3196"\w*, \w mas|strong="G1161"\w* \w um só|strong="G1520"\w* \w corpo|strong="G4983"\w*.\f + \fr 12.20: \ft Acréscimo: verbo ser/estar suprido em “há muitos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:20 \xt EPH 5:30; 1CO 12:14; ROM 12:5; 1CO 12:27; 1CO 12:12; 1CO 6:15\x*
