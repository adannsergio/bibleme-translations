\v 1 \w Pois|strong="G1063"\w* \w não quero|strong="G3756,G2309"\w* \w que vocês|strong="G4771"\w* \w ignorem|strong="G50"\w*, \w irmãos e irmãs|strong="G80"\w*, \w que|strong="G3754"\w* \w os nossos pais|strong="G3588,G3962,G3165"\w* \w todos|strong="G3956"\w* \w estiveram|strong="G1510"\w* \w sob a nuvem|strong="G5259,G3588,G3507"\w* \w e|strong="G2532"\w* \w todos|strong="G3956"\w* \w atravessaram|strong="G1330"\w* \w o mar|strong="G1223,G3588,G2281"\w*,\x - \xo 10:1 \xt JUD 1:5; EXO 13:21; EXO 14:29; NEH 9:11-12; MAT 25:2; PSA 78:13-14\x*
\v 2 \w e|strong="G2532"\w* \w todos|strong="G3956"\w* \w foram batizados|strong="G907"\w* \w em Moisés|strong="G1519,G3588,G3475"\w* \w na nuvem|strong="G1722,G3588,G3507"\w* \w e|strong="G2532"\w* \w no mar|strong="G1722,G3588,G2281"\w*,\f + \fr 10.2: \ft Lit.: εἰς τὸν Μωϋσῆν: “para Moisés”, “em Moisés”, indicando pertença; ἐβαπτίσαντο (voz média): “se deixaram batizar”.\f*\f + \fr 10.2: \ft Variante: o SBLGNT, com WH, Treg e o RP, traz ἐβαπτίσαντο; a NA28 traz ἐβαπτίσθησαν (“foram batizados”, sem a nuance da voz média).\f*\x - \xo 10:2 \xt JUD 1:5; EXO 13:21; MAT 25:2; ACT 19:5; HEB 3:2-3; 1CO 1:13\x*
