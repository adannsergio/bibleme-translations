\v 22 \w pelo contrário|strong="G235"\w*, \w muito mais|strong="G4183,G3123"\w* \w os membros|strong="G3588,G3196"\w* \w do corpo|strong="G3588,G4983"\w* \w que parecem|strong="G1380"\w* \w mais fracos|strong="G772,G5225"\w* \w são|strong="G1510"\w* \w necessários|strong="G316"\w*,\x - \xo 12:22 \xt EPH 5:30; 1CO 12:14; PHP 2:4; ROM 15:1; MAT 25:14; PHP 1:27\x*
\v 23 \w e|strong="G2532"\w* \w aqueles que|strong="G3739"\w* \w pensamos|strong="G1380"\w* \w ser menos honrosos|strong="G820,G1511"\w* \w do corpo|strong="G3588,G4983"\w*, \w a esses|strong="G3778"\w* \w conferimos|strong="G4060"\w* \w honra|strong="G5092"\w* \w mais abundante|strong="G4055"\w*; \w e|strong="G2532"\w* \w as partes indecorosas|strong="G3588,G809"\w* \w de nós|strong="G3165"\w* \w recebem|strong="G2192"\w* \w decoro|strong="G2157"\w* \w mais abundante|strong="G4055"\w*,\f + \fr 12.23: \ft Lit.: ἀσχήμων: “indecoroso”, “o que não tem apresentação”; εὐσχημοσύνη: “decoro”.\f*\x - \xo 12:23 \xt PHP 2:4; ROM 15:1; EPH 5:30; MAT 25:14; PHP 1:27; EPH 1:23\x*
\v 24 \w mas|strong="G1161"\w* \w as nossas partes decorosas|strong="G3588,G2158,G3165"\w* \w não|strong="G3756"\w* \w têm|strong="G2192"\w* \w necessidade|strong="G5532"\w*. \w Mas|strong="G235"\w* \w Deus|strong="G3588,G2316"\w* \w combinou|strong="G4786"\w* \w o corpo|strong="G3588,G4983"\w*, \w dando|strong="G1325"\w* \w honra|strong="G5092"\w* \w mais abundante|strong="G4055"\w* \w ao que tem falta|strong="G3588,G5302"\w*,\f + \fr 12.24: \ft Variante: o SBLGNT, com o RP, traz ὑστεροῦντι; WH, Treg e NA28 trazem ὑστερουμένῳ (“ao que é carente”); a NIV acrescenta τιμῆς depois de ἔχει.\f*\x - \xo 12:24 \xt PHP 2:4; ROM 15:1; EPH 5:30; MAT 25:14; PHP 1:27; EPH 1:23\x*
\v 25 \w para que|strong="G2443"\w* \w não|strong="G3361"\w* \w haja|strong="G1510"\w* \w divisão|strong="G4978"\w* \w no corpo|strong="G1722,G3588,G4983"\w*, \w mas|strong="G235"\w* \w que os membros|strong="G3588,G3196"\w* \w tenham o mesmo cuidado|strong="G3588,G846,G3309"\w* \w uns pelos outros|strong="G5228,G240"\w*.\x - \xo 12:25 \xt EPH 5:30; ROM 12:5; 1CO 12:14; 1CO 1:10; JHN 17:21; PHP 2:4\x*
\v 26 \w E|strong="G2532"\w* \w se|strong="G1535"\w* \w sofre|strong="G3958"\w* \w um|strong="G1520"\w* \w membro|strong="G3196"\w*, \w sofrem junto|strong="G4841"\w* \w todos os|strong="G3956,G3588"\w* \w membros|strong="G3196"\w*; \w ou se|strong="G1535"\w* \w é honrado|strong="G1392"\w* \w um membro|strong="G3196"\w*, \w alegram-se junto|strong="G4796"\w* \w todos os|strong="G3956,G3588"\w* \w membros|strong="G3196"\w*.\f + \fr 12.26: \ft Tradução: δοξάζεται (δοξάζω, G1392) está aqui como “é honrado”; o termo pode ser “glorificar”, “honrar” ou “exaltar”, e o contexto decide.\f*\x - \xo 12:26 \xt ROM 12:15; JHN 13:34; ACT 12:5; JHN 17:21; PHP 2:4; 1PE 3:8\x*
\v 27 \w Vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w são|strong="G1510"\w* \w corpo|strong="G4983"\w* \w de Cristo|strong="G5547"\w* \w e|strong="G2532"\w* \w membros|strong="G3196"\w* \w cada um por sua parte|strong="G1537,G3313"\w*.\x - \xo 12:27 \xt EPH 5:30; 1CO 12:14; ROM 12:5; 1CO 12:12; ROM 12:4; 1CO 6:15\x*
\v 28 \w E|strong="G2532"\w* \w a uns|strong="G3739,G3303"\w* \w Deus|strong="G3588,G2316"\w* \w colocou|strong="G5087"\w* \w na comunidade|strong="G1722,G3588,G1577"\w*: \w primeiro|strong="G4413"\w* \w apóstolos|strong="G652"\w*, \w segundo|strong="G1208"\w* \w profetas|strong="G4396"\w*, \w terceiro|strong="G5154"\w* \w mestres|strong="G1320"\w*, \w depois|strong="G1899"\w* \w poderes|strong="G1411"\w*, \w depois|strong="G1899"\w* \w dons|strong="G5486"\w* \w de curas|strong="G2386"\w*, \w auxílios|strong="G484"\w*, \w governos|strong="G2941"\w*, \w variedades|strong="G1085"\w* \w de línguas|strong="G1100"\w*.\f + \fr 12.28: \ft Lit.: ἀντίλημψις: “auxílio”, “ajuda”; κυβέρνησις: “governo”, “direção” (como a do piloto de um navio).\f*\x - \xo 12:28 \xt 1CO 12:9; EPH 4:11; MRK 16:17; ROM 12:6; JAS 3:1; 1CO 12:4\x*
\v 29 \w Acaso todos|strong="G3361,G3956"\w* \w são apóstolos|strong="G652"\w*? \w Acaso todos|strong="G3361,G3956"\w* \w profetas|strong="G4396"\w*? \w Acaso todos|strong="G3361,G3956"\w* \w mestres|strong="G1320"\w*? \w Acaso todos|strong="G3361,G3956"\w* \w têm poderes|strong="G1411"\w*?\f + \fr 12.29: \ft Acréscimo: verbo ser/estar suprido em “são apóstolos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 12:29 \xt EPH 4:11; ROM 12:6; MAT 25:14; PHP 1:27; 1CO 12:10; ACT 20:28\x*
\v 30 \w Acaso todos|strong="G3361,G3956"\w* \w têm|strong="G2192"\w* \w dons|strong="G5486"\w* \w de curas|strong="G2386"\w*? \w Acaso todos|strong="G3361,G3956"\w* \w falam|strong="G2980"\w* \w em línguas|strong="G1100"\w*? \w Acaso todos|strong="G3361,G3956"\w* \w interpretam|strong="G1329"\w*?\x - \xo 12:30 \xt 1CO 12:9; 1CO 14:13; 1CO 14:5; MRK 16:17; ROM 12:6; PHP 1:27\x*
\v 31 \w Busquem com zelo|strong="G2206"\w* \w os dons|strong="G3588,G5486"\w* \w maiores|strong="G3588,G3173"\w*. \w E|strong="G2532"\w* \w um caminho|strong="G3598"\w* \w ainda mais excelente|strong="G2089,G2596,G5236"\w* \w lhes mostro|strong="G4771,G1166"\w*.\f + \fr 12.31: \ft Lit.: ζηλοῦτε pode ser imperativo (“busquem com zelo”) ou indicativo (“vocês buscam com zelo”).\f*\f + \fr 12.31: \ft Variante: o RP traz κρείττονα (“melhores”) em lugar de μείζονα (“maiores”).\f*\x - \xo 12:31 \xt ROM 12:6; 1CO 13:1-14:1; 1CO 16:14; PHP 1:27; 1CO 14:39; ACT 20:28\x*
\c 13
\p
\v 1 \w Se|strong="G1437"\w* \w eu falar|strong="G2980"\w* \w nas línguas|strong="G3588,G1100"\w* \w dos seres humanos|strong="G3588,G444"\w* \w e|strong="G2532"\w* \w dos anjos|strong="G3588,G32"\w*, \w mas|strong="G1161"\w* \w não tiver|strong="G3361,G2192"\w* \w amor|strong="G26"\w*, \w me tornei|strong="G1096"\w* \w bronze|strong="G5475"\w* \w que soa|strong="G2278"\w* \w ou|strong="G2228"\w* \w címbalo|strong="G2950"\w* \w que retine|strong="G214"\w*.\x - \xo 13:1 \xt 1CO 13:13; 1PE 4:8; 1TI 1:5; GAL 5:22; 1CO 13:8; GAL 5:6\x*
\v 2 \w E|strong="G2532"\w* \w se|strong="G1437"\w* \w eu tiver|strong="G2192"\w* \w profecia|strong="G4394"\w* \w e|strong="G2532"\w* \w conhecer|strong="G6063"\w* \w todos os|strong="G3588,G3956"\w* \w mistérios|strong="G3466"\w* \w e|strong="G2532"\w* \w todo o|strong="G3956,G3588"\w* \w conhecimento|strong="G1108"\w*, \w e|strong="G2532"\w* \w se|strong="G1437"\w* \w eu tiver|strong="G2192"\w* \w toda a|strong="G3956,G3588"\w* \w fé|strong="G4102"\w*, \w de modo a|strong="G5620"\w* \w remover|strong="G3179"\w* \w montes|strong="G3735"\w*, \w mas|strong="G1161"\w* \w não tiver|strong="G3361,G2192"\w* \w amor|strong="G26"\w*, \w nada|strong="G3762"\w* \w sou|strong="G1510"\w*.\x - \xo 13:2 \xt 1CO 13:13; 1CO 13:8; 1CO 14:2; 2CO 8:7; MAT 17:20; MRK 11:23\x*
\v 3 \w E se|strong="G2532,G1437"\w* \w eu distribuir em comida|strong="G5595"\w* \w todos os meus bens|strong="G3956,G3588,G5225,G3165"\w*, \w e|strong="G2532"\w* \w se|strong="G1437"\w* \w eu entregar|strong="G3860"\w* \w o meu corpo|strong="G3588,G4983,G3165"\w*, \w para que|strong="G2443"\w* \w seja queimado|strong="G2545"\w*, \w mas|strong="G1161"\w* \w não tiver|strong="G3361,G2192"\w* \w amor|strong="G26"\w*, \w de nada|strong="G3762"\w* \w me aproveito|strong="G5623"\w*.\f + \fr 13.3: \ft Lit.: ψωμίζω: “alimentar dando pedaços”, “distribuir em comida”.\f*\f + \fr 13.3: \ft Variante: o SBLGNT traz καυθήσομαι (“para que eu seja queimado”); Treg e o RP trazem καυθήσωμαι (subjuntivo, mesmo sentido); WH e NA28 trazem καυχήσωμαι (“para que eu me glorie”). No início do verso e na segunda condicional, o SBLGNT traz καὶ ἐάν; WH, Treg e NA28 trazem κἄν (“e mesmo que”) na primeira, e WH também na segunda.\f*\x - \xo 13:3 \xt 1CO 13:13; 1CO 13:1; PHP 4:8; 1CO 13:2; COL 3:14; JAS 2:14\x*
\p
\v 4 \w O amor|strong="G3588,G26"\w* \w é paciente|strong="G3114"\w*, \w o amor|strong="G3588,G26"\w* \w é bondoso|strong="G5541"\w*; \w o amor|strong="G3588,G26"\w* \w não tem inveja|strong="G3756,G2206"\w*, \w não|strong="G3756"\w* \w se vangloria|strong="G4068"\w*, \w não|strong="G3756"\w* \w se enche de orgulho|strong="G5448"\w*,\x - \xo 13:4 \xt 1PE 4:8; GAL 5:22; EPH 4:32; 1CO 13:13; 1CO 8:1; GAL 5:21-22\x*
\v 5 \w não age|strong="G3756"\w* \w de modo indecoroso|strong="G807"\w*, \w não busca|strong="G3756,G2212"\w* \w o que é seu|strong="G3588,G1438"\w*, \w não se irrita|strong="G3756,G3947"\w*, \w não leva em conta|strong="G3756,G3049"\w* \w o mal|strong="G3588,G2556"\w*,\f + \fr 13.5: \ft Acréscimo: verbo ser/estar suprido em “o que é seu”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:5 \xt GAL 5:22; 1CO 13:13; ROM 13:10; JAS 3:17; EPH 4:2; PHP 2:4\x*
\v 6 \w não se alegra|strong="G3756,G5463"\w* \w com a injustiça|strong="G1909,G3588,G93"\w*, \w mas|strong="G1161"\w* \w se alegra junto|strong="G4796"\w* \w com a verdade|strong="G3588,G225"\w*;\x - \xo 13:6 \xt GAL 5:22; PHP 2:18; 2TH 2:12; 3JN 1:3; PHP 2:17; 1CO 13:13\x*
\v 7 \w tudo|strong="G3956"\w* \w suporta|strong="G4722"\w*, \w tudo|strong="G3956"\w* \w crê|strong="G4100"\w*, \w tudo|strong="G3956"\w* \w espera|strong="G1679"\w*, \w tudo|strong="G3956"\w* \w persevera|strong="G5278"\w*.\f + \fr 13.7: \ft Lit.: στέγω: “suportar”, “cobrir”, “aguentar”.\f*\x - \xo 13:7 \xt GAL 5:22; 1CO 13:13; 1PE 4:8; ROM 13:10; EPH 4:2; JAS 3:17\x*
\v 8 \w O amor|strong="G3588,G26"\w* \w nunca|strong="G3763"\w* \w cai|strong="G4098"\w*. \w Mas|strong="G1161"\w* \w sejam|strong="G1535"\w* \w profecias|strong="G4394"\w*, \w serão anuladas|strong="G2673"\w*; \w sejam|strong="G1535"\w* \w línguas|strong="G1100"\w*, \w cessarão|strong="G3973"\w*; \w seja|strong="G1535"\w* \w conhecimento|strong="G1108"\w*, \w será anulado|strong="G2673"\w*.\f + \fr 13.8: \ft Lit.: πίπτει: “cai”, “falha”, “fracassa”.\f*\f + \fr 13.8: \ft Acréscimo: verbo ser/estar suprido em “sejam”, “sejam”, “seja”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:8 \xt 1CO 13:13; MRK 12:31; 1CO 13:1; MAT 5:44; PHP 4:8; COL 3:14\x*
\v 9 \w Pois|strong="G1063"\w* \w em parte|strong="G1537,G3313"\w* \w conhecemos|strong="G1097"\w* \w e|strong="G2532"\w* \w em parte|strong="G1537,G3313"\w* \w profetizamos|strong="G4395"\w*;\x - \xo 13:9 \xt 1CO 13:12; PHP 4:8; COL 3:14; COL 2:2-3; EPH 3:18-19; 1CO 2:9\x*
\v 10 \w mas quando|strong="G3752,G1161"\w* \w vier|strong="G2064"\w* \w o que é perfeito|strong="G3588,G5046"\w*, \w o que é em parte|strong="G3588,G1537,G3313"\w* \w será anulado|strong="G2673"\w*.\f + \fr 13.10: \ft Lit.: τὸ τέλειον: “o perfeito”, “o completo”, “o maduro”.\f*\f + \fr 13.10: \ft Variante: o RP traz τότε τό (“então o que é em parte”) em lugar de τό.\f*\f + \fr 13.10: \ft Acréscimo: verbo ser/estar suprido em “o que é perfeito”, “o que é em parte”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:10 \xt 1CO 2:6; 1CO 13:12; PHP 4:8; COL 3:14; ISA 60:19-20; 2CO 5:7-8\x*
\v 11 \w Quando|strong="G3753"\w* \w eu era|strong="G1510"\w* \w criança|strong="G3516"\w*, \w falava|strong="G2980"\w* \w como|strong="G5613"\w* \w criança|strong="G3516"\w*, \w pensava|strong="G5426"\w* \w como|strong="G5613"\w* \w criança|strong="G3516"\w*, \w raciocinava|strong="G3049"\w* \w como|strong="G5613"\w* \w criança|strong="G3516"\w*; \w quando|strong="G3753"\w* \w me tornei|strong="G1096"\w* \w adulto|strong="G435"\w*, \w anulei|strong="G2673"\w* \w as coisas|strong="G3588"\w* \w de criança|strong="G3588,G3516"\w*.\f + \fr 13.11: \ft Tradução: ἐλογιζόμην (λογίζομαι, G3049) está aqui como “raciocinava”; o termo pode ser “considerar”, “contar”, “atribuir”, “calcular” ou “raciocinar”, e o contexto decide.\f*\x - \xo 13:11 \xt 1CO 14:20; 2CO 5:17; 1CO 3:1-2; GAL 4:1; ECC 11:10; PHP 4:8\x*
\v 12 \w Pois|strong="G1063"\w* \w vemos|strong="G991"\w* \w agora|strong="G737"\w* \w por meio de um espelho|strong="G1223,G2072"\w* \w de modo enigmático|strong="G1722,G135"\w*, \w mas então|strong="G5119,G1161"\w* \w face|strong="G4383"\w* \w a face|strong="G4314,G4383"\w*; \w agora|strong="G737"\w* \w conheço|strong="G1097"\w* \w em parte|strong="G1537,G3313"\w*, \w mas então|strong="G5119,G1161"\w* \w conhecerei plenamente|strong="G1921"\w*, \w assim como|strong="G2531"\w* \w também|strong="G2532"\w* \w fui plenamente conhecido|strong="G1921"\w*.\f + \fr 13.12: \ft Lit.: ἔσοπτρον: “espelho” (de metal polido); αἴνιγμα: “enigma”, “imagem indireta”; ἐπιγινώσκω: “conhecer plenamente”.\f*\x - \xo 13:12 \xt 1CO 13:9; JAS 1:23; 2CO 3:18; 1JN 3:2; PHP 3:12; MAT 5:8\x*
\v 13 \w Mas agora|strong="G3570,G1161"\w* \w permanecem|strong="G3306"\w* \w fé|strong="G4102"\w*, \w esperança|strong="G1680"\w*, \w amor|strong="G26"\w*: \w estes três|strong="G3588,G5140,G3778"\w*; \w o maior|strong="G3173"\w* \w deles|strong="G3778"\w* \w é o amor|strong="G3588,G26"\w*.\f + \fr 13.13: \ft Acréscimo: verbo ser/estar suprido em “é o amor”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:13 \xt 1CO 16:14; COL 3:14; 1TH 1:3; 1JN 4:7-18; 1CO 13:1-8; GAL 5:6\x*
\c 14
\p
\v 1 \w Busquem|strong="G1377"\w* \w o amor|strong="G3588,G26"\w*, \w e desejem com zelo|strong="G2206,G1161"\w* \w as coisas espirituais|strong="G3588,G4152"\w*, \w mas antes|strong="G3123,G1161"\w* \w que profetizem|strong="G2443,G4395"\w*.\x - \xo 14:1 \xt 1CO 14:39; 1CO 13:13; 1TI 4:14; 1CO 16:14; 1PE 3:13; ROM 12:6\x*
\v 2 \w Pois|strong="G1063"\w* \w quem fala|strong="G3588,G2980"\w* \w em língua|strong="G1100"\w* \w não fala|strong="G3756,G2980"\w* \w a seres humanos|strong="G444"\w*, \w mas|strong="G235"\w* \w a Deus|strong="G2316"\w*; \w pois|strong="G1063"\w* \w ninguém|strong="G3762"\w* \w entende|strong="G191"\w*, \w mas|strong="G1161"\w* \w em espírito|strong="G4151"\w* \w fala|strong="G2980"\w* \w mistérios|strong="G3466"\w*.\f + \fr 14.2: \ft Lit.: ἀκούει: “ouve”, aqui “entende”; πνεύματι: “em espírito” (o do falante) ou “pelo Espírito”.\f*\x - \xo 14:2 \xt 1CO 13:2; MRK 16:17; ACT 10:46; ACT 19:6; ACT 2:4-11; 1CO 14:14\x*
\v 3 \w Mas|strong="G1161"\w* \w quem profetiza|strong="G3588,G4395"\w* \w fala|strong="G2980"\w* \w a seres humanos|strong="G444"\w* \w edificação|strong="G3619"\w* \w e|strong="G2532"\w* \w exortação|strong="G3874"\w* \w e|strong="G2532"\w* \w consolo|strong="G3889"\w*.\x - \xo 14:3 \xt 1CO 14:5; HEB 10:25; 1CO 14:12; 1TH 5:20; 1TI 4:13; ROM 12:6\x*
\v 4 \w Quem fala|strong="G3588,G2980"\w* \w em língua|strong="G1100"\w* \w edifica|strong="G3618"\w* \w a si mesmo|strong="G1438"\w*; \w mas|strong="G1161"\w* \w quem profetiza|strong="G3588,G4395"\w* \w edifica|strong="G3618"\w* \w a comunidade|strong="G1577"\w*.\x - \xo 14:4 \xt ACT 19:6; JUD 1:20; MRK 16:17; 1CO 14:22; 1TH 5:20; ROM 12:6\x*
\v 5 \w Quero|strong="G2309"\w* \w que todos vocês|strong="G3956,G4771"\w* \w falem|strong="G2980"\w* \w em línguas|strong="G1100"\w*, \w mas antes|strong="G3123,G1161"\w* \w que profetizem|strong="G2443,G4395"\w*; \w e maior|strong="G3173,G1161"\w* \w é quem profetiza|strong="G3588,G4395"\w* \w do que|strong="G2228"\w* \w quem fala|strong="G3588,G2980"\w* \w em línguas|strong="G1100"\w*, \w a não ser que|strong="G1622,G1487,G3361"\w* \w interprete|strong="G1329"\w*, \w para que|strong="G2443"\w* \w a comunidade|strong="G3588,G1577"\w* \w receba|strong="G2983"\w* \w edificação|strong="G3619"\w*.\x - \xo 14:5 \xt 1CO 14:3; ACT 19:6; JUD 1:20; MRK 16:17; NUM 11:29; 1TH 5:20\x*
\v 6 \w Agora|strong="G3568,G1161"\w*, \w irmãos e irmãs|strong="G80"\w*, \w se|strong="G1437"\w* \w eu for|strong="G2064"\w* \w até vocês|strong="G4314,G4771"\w* \w falando|strong="G2980"\w* \w em línguas|strong="G1100"\w*, \w em que|strong="G5101"\w* \w os beneficiarei|strong="G4771,G5623"\w*, \w se|strong="G1437"\w* \w não|strong="G3361"\w* \w lhes falar|strong="G4771,G2980"\w* \w em revelação|strong="G2228,G1722,G602"\w*, \w ou em conhecimento|strong="G2228,G1722,G1108"\w*, \w ou em profecia|strong="G2228,G1722,G4394"\w*, \w ou em ensino|strong="G2228,G1722,G1322"\w*?\x - \xo 14:6 \xt 1CO 14:26; MRK 16:17; 1CO 13:1; 1TH 5:20; EPH 1:17; ACT 20:20\x*
