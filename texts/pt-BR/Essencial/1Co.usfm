\v 34 \w As mulheres|strong="G3588,G1135"\w* \w nas comunidades|strong="G1722,G3588,G1577"\w* \w fiquem em silêncio|strong="G4601"\w*, \w pois|strong="G1063"\w* \w não lhes|strong="G3756,G846"\w* \w é permitido|strong="G2010"\w* \w falar|strong="G2980"\w*; \w mas|strong="G235"\w* \w sujeitem-se|strong="G5293"\w*, \w como|strong="G2531"\w* \w também|strong="G2532"\w* \w a Lei|strong="G3588,G3551"\w* \w diz|strong="G3004"\w*.\f + \fr 14.34: \ft Lit.: γυναῖκες e ἄνδρες (v. 35): “mulheres” e “homens” ou “esposas” e “maridos”; o trecho dos vv. 34-35 é de interpretação discutida.\f*\f + \fr 14.34: \ft Variante: o RP acrescenta ὑμῶν (“as suas mulheres”) depois de γυναῖκες, traz ἐπιτέτραπται em lugar de ἐπιτρέπεται e ὑποτάσσεσθαι (infinitivo) em lugar de ὑποτασσέσθωσαν.\f*\f + \fr 14.34: \ft Variante: alguns manuscritos trazem os vv. 34-35 depois do v. 40.\f*\x - \xo 14:34 \xt COL 3:18; 1CO 14:28; 1TI 2:12; EPH 5:24; 1TI 2:11; GEN 3:16\x*
\v 35 \w Mas se|strong="G1487,G1161"\w* \w querem|strong="G2309"\w* \w aprender|strong="G3129"\w* \w algo|strong="G5100"\w*, \w perguntem|strong="G1905"\w* \w em casa|strong="G1722,G3624"\w* \w aos próprios|strong="G3588,G2398"\w* \w maridos|strong="G435"\w*; \w pois|strong="G1063"\w* \w é vergonhoso|strong="G150,G1510"\w* \w para a mulher|strong="G1135"\w* \w falar|strong="G2980"\w* \w na comunidade|strong="G1722,G1577"\w*.\f + \fr 14.35: \ft Variante: WH traz μανθάνειν em lugar de μαθεῖν; o RP traz a ordem ἐν ἐκκλησίᾳ λαλεῖν.\f*\x - \xo 14:35 \xt 1CO 14:34; 1TI 2:11; 1PE 3:7; EPH 5:12; EPH 5:25-27\x*
\v 36 \w Ou|strong="G2228"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w* \w saiu|strong="G1831"\w* \w de vocês|strong="G575,G4771"\w*, \w ou|strong="G2228"\w* \w chegou|strong="G2658"\w* \w somente a vocês|strong="G1519,G4771,G3441"\w*?\x - \xo 14:36 \xt ACT 8:31; 1CO 14:5; 1CO 4:7\x*
\v 37 \w Se|strong="G1487"\w* \w alguém|strong="G5100"\w* \w pensa|strong="G1380"\w* \w ser|strong="G1511"\w* \w profeta|strong="G4396"\w* \w ou|strong="G2228"\w* \w espiritual|strong="G4152"\w*, \w reconheça|strong="G1921"\w* \w que o que|strong="G3739,G3754"\w* \w escrevo|strong="G1125"\w* \w a vocês|strong="G4771"\w* \w é|strong="G1510"\w* \w do Senhor|strong="G2962"\w*.\f + \fr 14.37: \ft Variante: o SBLGNT traz ἐστίν (leitura atribuída a Holmes); WH, Treg e NA28 trazem ἐστὶν ἐντολή (“é mandamento”); o RP traz εἰσὶν ἐντολαί (“são mandamentos”).\f*\x - \xo 14:37 \xt 1JN 4:6; MAT 28:20; GAL 6:1; 1TH 5:20; 1CO 2:15; 2CO 10:7\x*
\v 38 \w Mas se|strong="G1487,G1161"\w* \w alguém|strong="G5100"\w* \w ignora|strong="G50"\w*, \w é ignorado|strong="G50"\w*.\f + \fr 14.38: \ft Lit.: ἀγνοεῖται pode ser indicativo (“é ignorado”) ou, em outra leitura, imperativo (“seja ignorado”).\f*\x - \xo 14:38 \xt 1TH 5:20; 2TI 4:3-4; 1TI 6:3-5; MAT 7:6; REV 22:11-12; 1CO 10:1\x*
\v 39 \w De modo que|strong="G5620"\w*, \w meus irmãos e irmãs|strong="G80,G3165"\w*, \w desejem com zelo|strong="G2206"\w* \w o profetizar|strong="G3588,G4395"\w*, \w e|strong="G2532"\w* \w não proíbam|strong="G3361,G2967"\w* \w o falar|strong="G3588,G2980"\w* \w em línguas|strong="G1100"\w*.\x - \xo 14:39 \xt 1CO 14:1; 1CO 12:10; 1CO 12:31; 1TH 5:20; 1CO 14:24-25; 1CO 14:3\x*
\v 40 \w Mas|strong="G1161"\w* \w tudo|strong="G3956"\w* \w aconteça|strong="G1096"\w* \w com decoro|strong="G2156"\w* \w e|strong="G2532"\w* \w em ordem|strong="G2596,G5010"\w*.\x - \xo 14:40 \xt 1CO 14:33; COL 2:5; TIT 1:5; 1CO 14:26; 1CH 15:13; 1CO 11:34\x*
\c 15
\p
\v 1 \w Faço saber|strong="G1107"\w* \w a vocês|strong="G4771"\w*, \w irmãos e irmãs|strong="G80"\w*, \w a boa notícia|strong="G3588,G2098"\w* \w que|strong="G3739"\w* \w anunciei|strong="G2097"\w* \w a vocês|strong="G4771"\w*, \w a qual|strong="G3739"\w* \w também|strong="G2532"\w* \w receberam|strong="G3880"\w*, \w na qual|strong="G1722,G3739"\w* \w também|strong="G2532"\w* \w estão firmes|strong="G2476"\w*,\x - \xo 15:1 \xt GAL 1:11; 1CO 16:13; ROM 5:2; GAL 1:6-12; 1PE 1:25; 1CO 1:23-24\x*
\v 2 \w por meio da qual|strong="G1223,G3739"\w* \w também|strong="G2532"\w* \w são salvos|strong="G4982"\w*, \w se|strong="G1487"\w* \w a conservam|strong="G2722"\w* \w na forma em que|strong="G5101,G3056"\w* \w a anunciei|strong="G2097"\w* \w a vocês|strong="G4771"\w*, \w a não ser que|strong="G1622,G1487,G3361"\w* \w tenham crido|strong="G4100"\w* \w em vão|strong="G1500"\w*.\f + \fr 15.2: \ft Lit.: τίνι λόγῳ: “com que palavra”, “em que termos”, “na forma em que”.\f*\x - \xo 15:2 \xt 1CO 16:13; ROM 1:16; ROM 11:22; HEB 3:6; 1CO 1:18; 1PE 1:25\x*
\v 3 \w Pois|strong="G1063"\w* \w transmiti|strong="G3860"\w* \w a vocês|strong="G4771"\w* \w em primeiro lugar|strong="G1722,G4413"\w* \w o que|strong="G3739"\w* \w também|strong="G2532"\w* \w recebi|strong="G3880"\w*: \w que|strong="G3754"\w* \w Cristo|strong="G5547"\w* \w morreu|strong="G599"\w* \w pelos nossos pecados|strong="G5228,G3588,G266,G3165"\w* \w segundo as Escrituras|strong="G2596,G3588,G1124"\w*\f + \fr 15.3: \ft Lit.: ἐν πρώτοις: “em primeiro lugar”, “entre as coisas principais”.\f*,\x - \xo 15:3 \xt 1CO 11:23; 2CO 5:21; ISA 59:21; ISA 53:5; 1PE 2:24; GAL 1:4\x*
\v 4 \w e|strong="G2532"\w* \w que|strong="G3754"\w* \w foi sepultado|strong="G2290"\w*, \w e|strong="G2532"\w* \w que|strong="G3754"\w* \w foi ressuscitado|strong="G1453"\w* \w no terceiro dia|strong="G3588,G2250,G5154"\w* \w segundo as Escrituras|strong="G2596,G3588,G1124"\w*,\f + \fr 15.4: \ft Lit.: ἐγήγερται (perfeito passivo): “foi ressuscitado”, com ideia de estado permanente.\f*\x - \xo 15:4 \xt ACT 10:40; MAT 17:23; ISA 59:21; HOS 6:2; MAT 12:40; PSA 16:10-11\x*
\v 5 \w e|strong="G2532"\w* \w que|strong="G3754"\w* \w apareceu|strong="G3700"\w* \w a Cefas|strong="G2786"\w*, \w depois|strong="G1534"\w* \w aos doze|strong="G3588,G1427"\w*;\f + \fr 15.5: \ft Lit.: ὤφθη: “foi visto”, “apareceu”.\f*\x - \xo 15:5 \xt ISA 59:21; ACT 1:3; MRK 16:14; JHN 1:42; MRK 16:6; LUK 24:34\x*
\v 6 \w depois|strong="G1899"\w* \w apareceu|strong="G3700"\w* \w a mais de|strong="G1883"\w* \w quinhentos|strong="G4001"\w* \w irmãos e irmãs|strong="G80"\w* \w de uma só vez|strong="G2178"\w*, \w dos quais|strong="G1537,G3739"\w* \w a maioria|strong="G3588,G4119"\w* \w permanece|strong="G3306"\w* \w até agora|strong="G2193,G737"\w*, \w mas|strong="G1161"\w* \w alguns|strong="G5100"\w* \w adormeceram|strong="G2837"\w*;\x - \xo 15:6 \xt ISA 59:21; ACT 1:3; 1TH 4:13; MRK 16:7; MAT 28:10; MRK 16:6\x*
\v 7 \w depois|strong="G1899"\w* \w apareceu|strong="G3700"\w* \w a Tiago|strong="G2385"\w*, \w depois|strong="G1534"\w* \w a todos|strong="G3956"\w* \w os apóstolos|strong="G3588,G652"\w*;\x - \xo 15:7 \xt ISA 59:21; ACT 1:3; MRK 16:6; 1CO 15:1; ACT 17:31; LUK 24:50\x*
\v 8 \w e por último|strong="G2078,G1161"\w* \w de todos|strong="G3956"\w*, \w como|strong="G5619"\w* \w a um aborto|strong="G3588,G1626"\w*, \w apareceu|strong="G3700"\w* \w também a mim|strong="G2532,G1473"\w*.\f + \fr 15.8: \ft Lit.: ἔκτρωμα: “aborto”, “criança nascida fora de tempo”.\f*\x - \xo 15:8 \xt ISA 59:21; 1CO 9:1; ACT 26:16; ACT 18:9; ACT 22:18; ACT 9:3\x*
\v 9 \w Pois|strong="G1063"\w* \w eu|strong="G1473"\w* \w sou|strong="G1510"\w* \w o menor|strong="G3588,G1646"\w* \w dos apóstolos|strong="G3588,G652"\w*, \w que|strong="G3739"\w* \w não sou|strong="G3756,G1510"\w* \w digno|strong="G2425"\w* \w de ser chamado|strong="G2564"\w* \w apóstolo|strong="G652"\w*, \w porque|strong="G1360"\w* \w persegui|strong="G1377"\w* \w a comunidade|strong="G3588,G1577"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 15:9 \xt ISA 59:21; EPH 3:8; PHP 2:3; LUK 17:10; 1TI 1:15; ACT 20:28\x*
\v 10 \w Mas|strong="G1161"\w* \w pela graça|strong="G5485"\w* \w de Deus|strong="G2316"\w* \w sou|strong="G1510"\w* \w o que|strong="G3739"\w* \w sou|strong="G1510"\w*, \w e|strong="G2532"\w* \w a graça|strong="G3588,G5485"\w* \w dele|strong="G846"\w* \w para comigo|strong="G3588,G1519,G1473"\w* \w não foi|strong="G3756,G1096"\w* \w vã|strong="G2756"\w*, \w mas|strong="G235"\w* \w trabalhei arduamente|strong="G2872"\w* \w mais|strong="G4054"\w* \w do que todos|strong="G3956"\w* \w eles|strong="G846"\w*; \w não eu|strong="G3756,G1473"\w*, \w porém|strong="G1161"\w*, \w mas|strong="G235"\w* \w a graça|strong="G3588,G5485"\w* \w de Deus|strong="G3588,G2316"\w* \w que está comigo|strong="G3588,G4862,G1473"\w*.\f + \fr 15.10: \ft Acréscimo: “que está comigo”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 15:10 \xt 2CO 6:1; PHP 2:13; 2CO 12:9; ISA 59:21; PHP 4:13; 2CO 3:5\x*
\v 11 \w Portanto|strong="G3767"\w*, \w seja|strong="G1535"\w* \w eu|strong="G1473"\w*, \w sejam|strong="G1535"\w* \w eles|strong="G1565"\w*, \w assim|strong="G3779"\w* \w proclamamos|strong="G2784"\w* \w e|strong="G2532"\w* \w assim|strong="G3779"\w* \w vocês creram|strong="G4100"\w*.\f + \fr 15.11: \ft Acréscimo: verbo ser/estar suprido em “seja”, “sejam”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 15:11 \xt ISA 59:21; PHP 1:18; 1CO 15:1; 2TI 2:8; COL 1:6; 1CO 15:2\x*
\v 12 \w Mas se|strong="G1487,G1161"\w* \w é proclamado|strong="G2784"\w* \w que|strong="G3754"\w* \w Cristo|strong="G5547"\w* \w foi ressuscitado|strong="G1453"\w* \w dentre os mortos|strong="G1537,G3498"\w*, \w como|strong="G4459"\w* \w dizem|strong="G3004"\w* \w alguns|strong="G5100"\w* \w entre vocês|strong="G1722,G4771"\w* \w que não há|strong="G3754,G3756,G1510"\w* \w ressurreição|strong="G386"\w* \w de mortos|strong="G3498"\w*?\x - \xo 15:12 \xt ACT 17:32; ACT 26:8; ACT 13:30; ACT 4:2; ISA 59:21; 1TH 4:14\x*
\v 13 \w Mas se|strong="G1487,G1161"\w* \w não há|strong="G3756,G1510"\w* \w ressurreição|strong="G386"\w* \w de mortos|strong="G3498"\w*, \w nem|strong="G3761"\w* \w Cristo|strong="G5547"\w* \w foi ressuscitado|strong="G1453"\w*;\x - \xo 15:13 \xt 1CO 15:16; ACT 13:30; GAL 1:1; ACT 26:8; ROM 4:24; ACT 17:32\x*
\v 14 \w e se|strong="G1487,G1161"\w* \w Cristo|strong="G5547"\w* \w não foi ressuscitado|strong="G3756,G1453"\w*, \w vã|strong="G2756"\w* \w então|strong="G686"\w* \w a nossa|strong="G3588,G3165"\w* \w proclamação|strong="G2782"\w*, \w vã|strong="G2756"\w* \w também|strong="G2532"\w* \w a fé|strong="G3588,G4102"\w* \w de vocês|strong="G4771"\w*\f + \fr 15.14: \ft Variante: a NA28 acrescenta καί depois de ἄρα, que WH, Treg e o RP trazem sem ele; o RP acrescenta δέ depois de κενή; WH traz ἡμῶν (“a nossa fé”) em lugar de ὑμῶν (“a fé de vocês”).\f*,\x - \xo 15:14 \xt ISA 59:21; ROM 10:9; PSA 127:1; GAL 2:21; 1CO 15:17; HEB 6:2\x*
\v 15 \w e somos achados|strong="G2147,G1161"\w* \w também|strong="G2532"\w* \w falsas testemunhas|strong="G5575"\w* \w de Deus|strong="G3588,G2316"\w*, \w porque|strong="G3754"\w* \w testemunhamos|strong="G3140"\w* \w contra Deus|strong="G2596,G3588,G2316"\w* \w que|strong="G3754"\w* \w ressuscitou|strong="G1453"\w* \w o Cristo|strong="G3588,G5547"\w*, \w a quem|strong="G3739"\w* \w não ressuscitou|strong="G3756,G1453"\w*, \w se de fato|strong="G1512,G686"\w* \w os mortos|strong="G3498"\w* \w não ressuscitam|strong="G3756,G1453"\w*.\f + \fr 15.15: \ft Lit.: κατὰ τοῦ θεοῦ: “contra Deus”, ou “a respeito de Deus”.\f*\x - \xo 15:15 \xt ISA 59:21; ROM 10:9; HEB 6:2; 1TH 4:14; ACT 2:24; ACT 26:8\x*
\v 16 \w Pois|strong="G1063"\w* \w se|strong="G1487"\w* \w os mortos|strong="G3498"\w* \w não ressuscitam|strong="G3756,G1453"\w*, \w nem|strong="G3761"\w* \w Cristo|strong="G5547"\w* \w foi ressuscitado|strong="G1453"\w*;\x - \xo 15:16 \xt ROM 10:9; ACT 13:30; 1CO 15:13; GAL 1:1; ACT 26:8; 1CO 15:12\x*
\v 17 \add e\add* \w se|strong="G1487,G1161"\w* \w Cristo|strong="G5547"\w* \w não foi ressuscitado|strong="G3756,G1453"\w*, \w inútil|strong="G3152"\w* \w a fé|strong="G3588,G4102"\w* \w de vocês|strong="G4771"\w*; \w ainda|strong="G2089"\w* \w estão|strong="G1510"\w* \w nos pecados|strong="G1722,G3588,G266"\w* \w de vocês|strong="G4771"\w*.\f + \fr 15.17: \ft Acréscimo: “e” (em “e se Cristo”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 15:17 \xt ISA 59:21; ROM 10:9; ROM 4:25; 1PE 1:3; 1CO 15:14; HEB 6:2\x*
\v 18 \w Então|strong="G686"\w* \w também|strong="G2532"\w* \w os que adormeceram|strong="G3588,G2837"\w* \w em Cristo|strong="G1722,G5547"\w* \w pereceram|strong="G622"\w*.\x - \xo 15:18 \xt ISA 59:21; ROM 10:9; 1TH 4:13; JHN 11:25; HEB 6:2; 1TH 4:14\x*
\v 19 \w Se|strong="G1487"\w* \w nesta|strong="G1722,G3588,G3778"\w* \w vida|strong="G2222"\w* \w temos esperado|strong="G1679,G1510"\w* \w em Cristo|strong="G1722,G5547"\w* \w somente|strong="G3441"\w*, \w somos mais dignos de pena|strong="G1652,G1510"\w* \w do que todos|strong="G3956"\w* \w os seres humanos|strong="G444"\w*.\x - \xo 15:19 \xt ISA 59:21; 1PE 1:21; 1TH 4:13; REV 14:13; COL 1:5; HEB 6:2\x*
\v 20 \w Mas agora|strong="G3570,G1161"\w* \w Cristo|strong="G5547"\w* \w foi ressuscitado|strong="G1453"\w* \w dentre os mortos|strong="G1537,G3498"\w*, \w primícia|strong="G536"\w* \w dos que adormeceram|strong="G3588,G2837"\w*.\f + \fr 15.20: \ft Variante: o RP acrescenta ἐγένετο (“tornou-se”) depois de κεκοιμημένων.\f*\x - \xo 15:20 \xt MAT 27:52; 1CO 15:13; ISA 59:21; ROM 8:11; COL 1:18; 1CO 15:23\x*
\v 21 \w Pois|strong="G1063"\w* \w já que|strong="G1894"\w* \w por meio de um ser humano|strong="G1223,G444"\w* \w veio a morte|strong="G2288"\w*, \w também|strong="G2532"\w* \w por meio de um ser humano|strong="G1223,G444"\w* \add veio\add* \w a ressurreição|strong="G386"\w* \w dos mortos|strong="G3498"\w*.\f + \fr 15.21: \ft Acréscimo: “veio” (em “ser humano veio a ressurreição”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 15:21 \xt PHP 3:10; ROM 5:12; ACT 26:23; ACT 17:32; ROM 5:17; ISA 59:21\x*
\v 22 \w Pois|strong="G1063"\w* \w assim como|strong="G5618"\w* \w em Adão|strong="G1722,G3588,G76"\w* \w todos|strong="G3956"\w* \w morrem|strong="G599"\w*, \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w em Cristo|strong="G1722,G3588,G5547"\w* \w todos|strong="G3956"\w* \w serão vivificados|strong="G2227"\w*.\f + \fr 15.22: \ft Lit.: ζῳοποιέω: “dar vida”, “vivificar”.\f*\x - \xo 15:22 \xt 1CO 15:45; JHN 5:21; ROM 5:12; ROM 5:17; ROM 8:1; ISA 59:21\x*
\v 23 \w Cada um|strong="G1538"\w* \w em sua própria|strong="G1722,G3588,G2398"\w* \w ordem|strong="G5001"\w*: \w primícia|strong="G536"\w*, \w Cristo|strong="G5547"\w*; \w depois|strong="G1899"\w* \w os de Cristo|strong="G3588,G5547"\w* \w na vinda|strong="G1722,G3588,G3952"\w* \w dele|strong="G846"\w*.\f + \fr 15.23: \ft Lit.: τάγμα: “ordem”, “turno”, “divisão (militar)”; παρουσία: “vinda”, “presença”.\f*\x - \xo 15:23 \xt ISA 59:21; 1TH 4:16; COL 1:13; COL 1:18; 1CO 15:20; PHP 3:10\x*
\v 24 \w Depois|strong="G1534"\w*, \w o fim|strong="G3588,G5056"\w*, \w quando|strong="G3752"\w* \w entregar|strong="G3860"\w* \w o reino|strong="G3588,G932"\w* \w ao Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w Pai|strong="G3962"\w*, \w quando|strong="G3752"\w* \w tiver anulado|strong="G2673"\w* \w todo|strong="G3956"\w* \w governo|strong="G746"\w* \w e|strong="G2532"\w* \w toda|strong="G3956"\w* \w autoridade|strong="G1849"\w* \w e|strong="G2532"\w* \w poder|strong="G1411"\w*.\f + \fr 15.24: \ft Lit.: ἀρχή: “governo”, “principado”, “poder”.\f*\x - \xo 15:24 \xt ISA 59:21; COL 1:13; DAN 7:14; DAN 7:27; JHN 11:25; ISA 9:7\x*
