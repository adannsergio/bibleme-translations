\v 1 \add Que\add* \w uma pessoa|strong="G444"\w* \w nos considere|strong="G3165,G3049"\w* \w assim|strong="G3779"\w*: \w como|strong="G5613"\w* \w auxiliares|strong="G5257"\w* \w de Cristo|strong="G5547"\w* \w e|strong="G2532"\w* \w administradores|strong="G3623"\w* \w dos mistérios|strong="G3466"\w* \w de Deus|strong="G2316"\w*.\f + \fr 4.1: \ft Lit.: ὑπηρέτης: “auxiliar”, “subordinado”, “assistente”.\f*\f + \fr 4.1: \ft Acréscimo: “Que” (em “Que uma pessoa”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 4:1 \xt 1PE 4:10; HEB 13:17; MAT 24:45; MAT 25:14; TIT 1:7; 1TI 3:9\x*
\v 2 \w Aqui|strong="G5602"\w*, \w além disso|strong="G3063"\w*, \w se exige|strong="G2212"\w* \w dos administradores|strong="G1722,G3588,G3623"\w* \w que|strong="G2443"\w* \w alguém|strong="G5100"\w* \w seja encontrado|strong="G2147"\w* \w fiel|strong="G4103"\w*.\f + \fr 4.2: \ft Tradução: ζητεῖται (ζητέω, G2212) está aqui como “se exige”; o termo pode ser “procurar”, “buscar”, “tentar” ou “exigir”, e o contexto decide.\f*\x - \xo 4:2 \xt LUK 12:42; MAT 25:21; 1PE 4:10; LUK 16:10-12; COL 4:17; HEB 13:17\x*
\v 3 \w Para mim|strong="G1473"\w*, \w porém|strong="G1161"\w*, \w é|strong="G1510"\w* \w coisa mínima|strong="G1519,G1646"\w* \w ser examinado|strong="G2443,G350"\w* \w por vocês|strong="G5259,G4771"\w* \w ou|strong="G2228"\w* \w por um julgamento|strong="G5259,G2250"\w* \w humano|strong="G442"\w*; \w mas|strong="G235"\w* \w nem eu mesmo|strong="G3761,G1473"\w* \w me examino|strong="G350"\w*.\f + \fr 4.3: \ft Lit.: ἀνθρωπίνης ἡμέρας: “dia humano”, isto é, julgamento ou tribunal humano.\f*\x - \xo 4:3 \xt 1CO 2:15; MAT 7:1; LUK 6:37; JAS 3:1; PRO 28:20; ISA 11:3\x*
\v 4 \w Pois|strong="G1063"\w* \w de nada|strong="G3762"\w* \w estou ciente|strong="G6083"\w* \w contra mim mesmo|strong="G1473"\w*, \w mas|strong="G235"\w* \w nisso|strong="G1722,G3778"\w* \w não|strong="G3756"\w* \w fui declarado justo|strong="G1344"\w*; \w quem|strong="G3588"\w* \w me examina|strong="G350,G3165"\w*, \w porém|strong="G1161"\w*, \w é o Senhor|strong="G2962,G1510"\w*.\f + \fr 4.4: \ft Lit.: σύνοιδα ἐμαυτῷ: “estar ciente (de algo) contra mim”, “ter a consciência pesada”.\f*\x - \xo 4:4 \xt 1CO 2:15; MAT 7:1; 1JN 3:20; PSA 143:2; LUK 6:37; ROM 14:4\x*
\v 5 \w De modo que|strong="G5620"\w* \w não julguem|strong="G3361,G2919"\w* \w nada|strong="G5100"\w* \w antes do tempo|strong="G4253,G2540"\w*, \w até que|strong="G2193,G302"\w* \w venha|strong="G2064"\w* \w o Senhor|strong="G3588,G2962"\w*, \w o qual|strong="G3739"\w* \w também|strong="G2532"\w* \w iluminará|strong="G5461"\w* \w as coisas ocultas|strong="G3588,G2927"\w* \w das trevas|strong="G3588,G4655"\w* \w e|strong="G2532"\w* \w revelará|strong="G5319"\w* \w as intenções|strong="G3588,G1012"\w* \w dos corações|strong="G3588,G2588"\w*; \w e|strong="G2532"\w* \w então|strong="G5119"\w* \w o elogio|strong="G3588,G1868"\w* \w virá|strong="G1096"\w* \w a cada um|strong="G1538"\w* \w da parte de Deus|strong="G575,G3588,G2316"\w*.\x - \xo 4:5 \xt ROM 2:29; HEB 4:13; MAT 7:1; JAS 5:7; 2CO 5:10; LUK 16:15\x*
\v 6 \w Essas coisas|strong="G3778"\w*, \w irmãos e irmãs|strong="G80"\w*, \w apliquei como figura|strong="G3345"\w* \w a mim mesmo|strong="G1519,G1473"\w* \w e|strong="G2532"\w* \w a Apolo|strong="G625"\w* \w por causa de vocês|strong="G1223,G4771"\w*, \w para que|strong="G2443"\w* \w em nós|strong="G1722,G3165"\w* \w aprendam|strong="G3129"\w* \w o|strong="G3588"\w* “\w Não|strong="G3361"\w* \w além do que|strong="G5228,G3739"\w* \w está escrito|strong="G1125"\w*”, \w para que|strong="G2443"\w* \w não|strong="G3361"\w* \w um|strong="G1520"\w* \w a favor de|strong="G5228"\w* \w um só|strong="G3588,G1520"\w* \w se encha de orgulho|strong="G5448"\w* \w contra|strong="G2596"\w* \w o outro|strong="G3588,G2087"\w*\f + \fr 4.6: \ft Lit.: μετεσχημάτισα: “transferi em forma de figura”, “apliquei por figura”; a expressão τὸ Μὴ ὑπὲρ ἃ γέγραπται é de sentido discutido.\f*.\x - \xo 4:6 \xt 1CO 3:4; 1CO 10:12; 1CO 13:4; 1CO 3:21; 2CO 11:4; 2CO 12:19\x*
\v 7 \w Pois|strong="G1063"\w* \w quem|strong="G5101"\w* \w faz de você alguém diferente dos outros|strong="G4771,G1252"\w*? \w E|strong="G1161"\w* \w o que|strong="G5101"\w* \w você tem|strong="G2192"\w* \w que não|strong="G3739,G3756"\w* \w recebeu|strong="G2983"\w*? \w Mas se|strong="G1487,G1161"\w* \w também|strong="G2532"\w* \w recebeu|strong="G2983"\w*, \w por que|strong="G5101"\w* \w se gloria|strong="G2744"\w* \w como se|strong="G5613"\w* \w não tivesse recebido|strong="G3361,G2983"\w*?\x - \xo 4:7 \xt JHN 3:27; 1PE 4:10; JAS 1:17; 1CH 29:11-16; JHN 1:16; ROM 12:6\x*
\v 8 \w Já|strong="G2235"\w* \w estão saciados|strong="G2880,G1510"\w*, \w já|strong="G2235"\w* \w enriqueceram|strong="G4147"\w*, \w sem nós|strong="G5565,G3165"\w* \w passaram a reinar|strong="G936"\w*; \w e|strong="G2532"\w* \w oxalá|strong="G3785,G1065"\w* \w realmente reinassem|strong="G936"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w nós|strong="G3165"\w* \w reinássemos com vocês|strong="G4771,G4821"\w*.\f + \fr 4.8: \ft Lit.: o tom dos vv. 8-10 costuma ser lido como irônico.\f*\x - \xo 4:8 \xt 1CO 10:12; 2CO 1:8; PRO 13:7; REV 3:17; 1CO 5:6; 2CO 13:9\x*
\v 9 \w Pois|strong="G1063"\w* \w creio|strong="G1380"\w* \add que\add* \w Deus|strong="G3588,G2316"\w* \w nos exibiu|strong="G584"\w* \w a nós|strong="G3165"\w*, \w os apóstolos|strong="G3588,G652"\w*, \w como os últimos|strong="G2078,G5613"\w*, \w como condenados à morte|strong="G1935"\w*, \w porque|strong="G3754"\w* \w nos tornamos|strong="G1096"\w* \w espetáculo|strong="G2302"\w* \w para o mundo|strong="G3588,G2889"\w*, \w tanto para anjos|strong="G2532,G32"\w* \w quanto para seres humanos|strong="G2532,G444"\w*.\f + \fr 4.9: \ft Acréscimo: “que” (em “Pois creio que Deus nos”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\f + \fr 4.9: \ft Tradução: δοκῶ (δοκέω, G1380) está aqui como “creio”; o termo pode ser “parecer”, “pensar”, “julgar” ou “ser considerado”, e o contexto decide.\f*\x - \xo 4:9 \xt 1PE 1:6; MAT 5:10; ROM 8:36; 1CO 15:31; HEB 10:33; 1CO 15:19\x*
\v 10 \w Nós|strong="G3165"\w* \w somos loucos|strong="G3474"\w* \w por causa de Cristo|strong="G1223,G5547"\w*, \w mas|strong="G1161"\w* \w vocês|strong="G4771"\w* \w são sensatos|strong="G5429"\w* \w em Cristo|strong="G1722,G5547"\w*; \w nós|strong="G3165"\w* \w fracos|strong="G772"\w*, \w mas|strong="G1161"\w* \w vocês|strong="G4771"\w* \w fortes|strong="G2478"\w*; \w vocês|strong="G4771"\w* \w honrados|strong="G1741"\w*, \w mas|strong="G1161"\w* \w nós|strong="G3165"\w* \w desprezados|strong="G820"\w*.\f + \fr 4.10: \ft Acréscimo: verbo ser/estar suprido em “somos loucos”, “são sensatos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:10 \xt 1CO 1:25; MAT 5:11; 1PE 1:6; MAT 5:10; 1CO 2:3; 1CO 15:31\x*
\v 11 \w Até a hora presente|strong="G891,G3588,G737,G5610"\w* \w passamos fome|strong="G3983"\w* \w e|strong="G2532"\w* \w sede|strong="G1372"\w*, \w e|strong="G2532"\w* \w andamos mal vestidos|strong="G1130"\w*, \w e|strong="G2532"\w* \w somos esbofeteados|strong="G2852"\w*, \w e|strong="G2532"\w* \w não temos morada fixa|strong="G790"\w*,\f + \fr 4.11: \ft Lit.: γυμνιτεύω: “andar nu”, “andar mal vestido”; κολαφίζω: “esbofetear”; ἀστατέω: “não ter morada fixa”, “andar errante”.\f*\x - \xo 4:11 \xt PHP 4:11; ROM 8:35; 1PE 1:6; MAT 5:10; 1CO 9:27; 1CO 15:31\x*
\v 12 \w e|strong="G2532"\w* \w nos cansamos|strong="G2872"\w* \w trabalhando|strong="G2038"\w* \w com as próprias|strong="G3588,G2398"\w* \w mãos|strong="G5495"\w*; \w insultados|strong="G3058"\w*, \w abençoamos|strong="G2127"\w*; \w perseguidos|strong="G1377"\w*, \w suportamos|strong="G430"\w*;\x - \xo 4:12 \xt ROM 12:14; LUK 6:28; MAT 5:44; PHP 4:11; LUK 23:34; 1PE 1:6\x*
\v 13 \w difamados|strong="G6022"\w*, \w respondemos com gentileza|strong="G3870"\w*; \w como|strong="G5613"\w* \w lixo|strong="G4027"\w* \w do mundo|strong="G3588,G2889"\w* \w nos tornamos|strong="G1096"\w*, \w de todos|strong="G3956"\w* \w escória|strong="G4067"\w* \w até agora|strong="G2193,G737"\w*.\f + \fr 4.13: \ft Lit.: παρακαλέω: “exortar”, “consolar”, “apelar”; aqui, “responder com apelo gentil”; περικάθαρμα e περίψημα: “refugo”, “escória”, o que se joga fora na limpeza.\f*\x - \xo 4:13 \xt JHN 5:17; MAT 23:39; MAT 5:44; ROM 12:14; 1PE 1:6; 1PE 3:9\x*
\v 14 \w Não|strong="G3756"\w* \w para envergonhar|strong="G1788"\w* \w vocês|strong="G4771"\w* \w escrevo|strong="G1125"\w* \w estas coisas|strong="G3778"\w*, \w mas|strong="G235"\w* \w para advertir|strong="G3560"\w* \w como|strong="G5613"\w* \w meus filhos|strong="G5043,G3165"\w* \w amados|strong="G27"\w*.\x - \xo 4:14 \xt LUK 20:13; MRK 12:6; GAL 4:19; 1TH 2:11; 1TI 1:2; 1CO 6:5\x*
\v 15 \w Pois|strong="G1063"\w* \w mesmo que|strong="G1437"\w* \w tenham|strong="G2192"\w* \w dez mil|strong="G3463"\w* \w tutores|strong="G3807"\w* \w em Cristo|strong="G1722,G5547"\w*, \w mas|strong="G235"\w* \w não|strong="G3756"\w* \w muitos|strong="G4183"\w* \w pais|strong="G3962"\w*; \w pois|strong="G1063"\w* \w em Cristo|strong="G1722,G5547"\w* \w Jesus|strong="G2424"\w* \w por meio da boa notícia|strong="G1223,G3588,G2098"\w* \w eu|strong="G1473"\w* \w vocês|strong="G4771"\w* \w gerei|strong="G1080"\w*.\f + \fr 4.15: \ft Lit.: παιδαγωγός: “tutor”, “pedagogo” (o escravo que conduzia a criança).\f*\x - \xo 4:15 \xt GAL 4:19; 1TH 2:11; 1TI 1:2; PHM 1:10; GAL 1:6; 1CO 3:10\x*
\v 16 \w Exorto|strong="G3870"\w* \w vocês|strong="G4771"\w*, \w portanto|strong="G3767"\w*: \w sejam imitadores|strong="G3402,G1096"\w* \w meus|strong="G3165"\w*.\x - \xo 4:16 \xt 1CO 11:1; EPH 4:1; 1CO 1:10; PHP 3:17; 2TH 3:9; 1TH 1:6\x*
\v 17 \w Por isso|strong="G1223,G3778"\w* \w enviei|strong="G3992"\w* \w a vocês|strong="G4771"\w* \w Timóteo|strong="G5095"\w*, \w que é|strong="G3739,G1510"\w* \w meu filho|strong="G3165,G5043"\w* \w amado|strong="G27"\w* \w e|strong="G2532"\w* \w fiel|strong="G4103"\w* \w no Senhor|strong="G1722,G2962"\w*, \w o qual|strong="G3739"\w* \w lembrará|strong="G363"\w* \w a vocês|strong="G4771"\w* \w os meus caminhos|strong="G3588,G3598,G3165"\w* \w que estão|strong="G3588,G1722"\w* \w em Cristo|strong="G5547"\w* \w Jesus|strong="G2424"\w*, \w como|strong="G2531"\w* \w ensino|strong="G1321"\w* \w por toda parte|strong="G3837"\w* \w em toda|strong="G1722,G3956"\w* \w comunidade|strong="G1577"\w*.\f + \fr 4.17: \ft Variante: o RP traz τέκνον μου (ordem inversa); Treg e o RP omitem Ἰησοῦ depois de Χριστῷ.\f*\f + \fr 4.17: \ft Acréscimo: “que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 4:17 \xt 2TI 1:2; 1CO 7:17; PHP 2:19; 1CO 16:10; 1TI 1:2; 1CO 14:33\x*
\v 18 \w Mas|strong="G1161"\w* \w como se|strong="G5613"\w* \w eu|strong="G3165"\w* \w não fosse|strong="G3361,G2064"\w* \w até vocês|strong="G4314,G4771"\w*, \w alguns|strong="G5100"\w* \w se encheram de orgulho|strong="G5448"\w*;\x - \xo 4:18 \xt 1CO 13:4; 1CO 4:19; 1CO 4:6; 1CO 5:2; 1CO 5:6; 2CO 10:2\x*
\v 19 \w mas|strong="G1161"\w* \w irei|strong="G2064"\w* \w logo|strong="G5030"\w* \w até vocês|strong="G4314,G4771"\w*, \w se|strong="G1437"\w* \w o Senhor|strong="G3588,G2962"\w* \w quiser|strong="G2309"\w*, \w e|strong="G2532"\w* \w conhecerei|strong="G1097"\w* \w não|strong="G3756"\w* \w a palavra|strong="G3588,G3056"\w* \w dos que estão inchados|strong="G3588,G5448"\w*, \w mas|strong="G235"\w* \w o poder|strong="G3588,G1411"\w*;\x - \xo 4:19 \xt 2CO 1:15; 2CO 13:1-4; ACT 18:21; 1CO 16:7; JAS 4:15; 1CO 11:34\x*
\v 20 \w pois|strong="G1063"\w* \w o reino|strong="G3588,G932"\w* \w de Deus|strong="G3588,G2316"\w* \w não está|strong="G3756"\w* \w em palavra|strong="G1722,G3056"\w*, \w mas|strong="G235"\w* \w em poder|strong="G1722,G1411"\w*.\f + \fr 4.20: \ft Acréscimo: verbo ser/estar suprido em “não está”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 4:20 \xt 1CO 2:4; ROM 14:17; 1TH 1:5; 2CO 10:4-5; ROM 1:16; ROM 15:19\x*
\v 21 \w O que|strong="G5101"\w* \w querem|strong="G2309"\w*? \w Que eu vá|strong="G2064"\w* \w até vocês|strong="G4314,G4771"\w* \w com vara|strong="G1722,G4464"\w*, \w ou|strong="G2228"\w* \w com amor|strong="G1722,G26"\w* \w e|strong="G5037"\w* \w espírito|strong="G4151"\w* \w de mansidão|strong="G4236"\w*?\x - \xo 4:21 \xt GAL 6:1; 2CO 13:2; 2CO 1:23; 2CO 13:10; 1TH 2:7; 2CO 12:20\x*
\c 5
\p
\v 1 \w Realmente|strong="G3654"\w* \w se ouve falar|strong="G191"\w* \w entre vocês|strong="G1722,G4771"\w* \w de imoralidade sexual|strong="G4202"\w*, \w e|strong="G2532"\w* \w tal imoralidade sexual|strong="G5108,G4202"\w* \w que|strong="G3748"\w* \w nem entre os gentios|strong="G3761,G1722,G3588,G1484"\w* \add existe:\add* \w a ponto de|strong="G5620"\w* \w alguém|strong="G5100"\w* \w ter|strong="G2192"\w* \w a mulher|strong="G1135"\w* \w do pai|strong="G3588,G3962"\w*.\f + \fr 5.1: \ft Lit.: γυναῖκα τοῦ πατρός: “a mulher do pai”, isto é, provavelmente a madrasta.\f*\f + \fr 5.1: \ft Variante: o RP acrescenta ὀνομάζεται (“se nomeia”) depois de ἔθνεσιν.\f*\f + \fr 5.1: \ft Acréscimo: “existe” (em “os gentios existe a ponto”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 5:1 \xt REV 21:8; 1CO 6:9; REV 2:21; COL 3:5; 1CO 5:11; EPH 5:3\x*
\v 2 \w E|strong="G2532"\w* \w vocês|strong="G4771"\w* \w estão inchados de orgulho|strong="G5448,G1510"\w*, \w e|strong="G2532"\w* \w não|strong="G3780"\w* \w antes|strong="G3123"\w* \w lamentaram|strong="G3996"\w*, \w para que|strong="G2443"\w* \w fosse removido|strong="G142"\w* \w do meio|strong="G1537,G3319"\w* \w de vocês|strong="G4771"\w* \w aquele que|strong="G3588"\w* \w fez|strong="G4160"\w* \w esta ação|strong="G3588,G2041,G3778"\w*?\f + \fr 5.2: \ft Variante: o SBLGNT traz ἀρθῇ, com WH, Treg e NA28; o RP traz ἐξαρθῇ. O SBLGNT traz ποιήσας, com Treg e o RP; WH e NA28 trazem πράξας (“tendo praticado”).\f*\x - \xo 5:2 \xt 1CO 5:11; REV 2:20-22; 1CO 5:6; 2CO 7:7-11; JOS 7:1; MAT 13:47\x*
\v 3 \w Pois|strong="G1063"\w* \w eu|strong="G1473"\w*, \w ausente|strong="G548"\w* \w no corpo|strong="G3588,G4983"\w* \w mas presente|strong="G3918,G1161"\w* \w em espírito|strong="G3588,G4151"\w*, \w já|strong="G2235"\w* \w julguei|strong="G2919"\w*, \w como|strong="G5613"\w* \w se estivesse presente|strong="G3918"\w*, \w aquele que|strong="G3588"\w* \w assim|strong="G3779"\w* \w fez|strong="G2716"\w* \w isto|strong="G3778"\w*\f + \fr 5.3: \ft Lit.: πνεύματι: “em espírito” (o de Paulo).\f*\f + \fr 5.3: \ft Variante: o RP traz ὡς ἀπών (“como ausente”) em lugar de ἀπών.\f*\x - \xo 5:3 \xt COL 2:5; 2KI 5:26; 1TH 2:17; 1CO 5:11; MAT 18:17; 2CO 10:6\x*
\v 4 \w em nome|strong="G1722,G3588,G3686"\w* \w do nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus|strong="G2424"\w*, \w estando vocês reunidos|strong="G4863,G4771"\w* \w e|strong="G2532"\w* \w o meu espírito|strong="G3588,G1473,G4151"\w* \w com o poder|strong="G4862,G3588,G1411"\w* \w do nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus|strong="G2424"\w*,\f + \fr 5.4: \ft Variante: o RP acrescenta Χριστοῦ depois de Ἰησοῦ, nas duas ocorrências do verso.\f*\x - \xo 5:4 \xt MAT 18:20; ACT 4:7; HEB 10:25; MAT 18:18; 1TI 1:20; COL 2:5\x*
\v 5 \w entregar|strong="G3860"\w* \w um tal homem|strong="G3588,G5108"\w* \w a Satanás|strong="G3588,G4567"\w* \w para a destruição|strong="G1519,G3639"\w* \w da carne|strong="G3588,G4561"\w*, \w para que|strong="G2443"\w* \w o espírito|strong="G3588,G4151"\w* \w seja salvo|strong="G4982"\w* \w no dia|strong="G1722,G3588,G2250"\w* \w do Senhor|strong="G3588,G2962"\w*.\f + \fr 5.5: \ft Lit.: ὄλεθρος: “destruição”, “ruína”; τῆς σαρκός: “da carne”, ou do corpo físico, ou da natureza pecaminosa (discutido).\f*\f + \fr 5.5: \ft Variante: o SBLGNT traz κυρίου, com WH e NA28; Treg e o RP acrescentam Ἰησοῦ (“do Senhor Jesus”).\f*\x - \xo 5:5 \xt 1TI 1:20; 2TH 3:14-15; GAL 6:1-2; JAS 5:19-20; MAT 18:18; JOB 2:6\x*
\p
\v 6 \w Não é bom|strong="G3756,G2570"\w* \w o gloriar-se|strong="G3588,G2745"\w* \w de vocês|strong="G4771"\w*. \w Não sabem|strong="G3756,G6063"\w* \w que|strong="G3754"\w* \w um pouco|strong="G3398"\w* \w de fermento|strong="G2219"\w* \w fermenta|strong="G2220"\w* \w toda|strong="G3650"\w* \w a massa|strong="G3588,G5445"\w*?\f + \fr 5.6: \ft Lit.: καύχημα: “motivo de orgulho”, “vanglória”.\f*\f + \fr 5.6: \ft Acréscimo: verbo ser/estar suprido em “Não é bom”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:6 \xt GAL 5:9; LUK 13:21; MAT 13:33; 1CO 15:33; MRK 8:15; JAS 4:16\x*
\v 7 \w Limpem|strong="G1571"\w* \w o fermento|strong="G3588,G2219"\w* \w velho|strong="G3820"\w*, \w para que|strong="G2443"\w* \w sejam|strong="G1510"\w* \w massa|strong="G5445"\w* \w nova|strong="G3501"\w*, \w como|strong="G2531"\w* \w são|strong="G1510"\w* \w sem fermento|strong="G106"\w*. \w Pois|strong="G1063"\w* \w também|strong="G2532"\w* \w a nossa|strong="G3588,G3165"\w* \w Páscoa|strong="G3957"\w* \w foi sacrificada|strong="G2380"\w*: \w Cristo|strong="G5547"\w*.\f + \fr 5.7: \ft Lit.: τὸ πάσχα: a Páscoa, isto é, o cordeiro pascal.\f*\f + \fr 5.7: \ft Variante: o RP acrescenta ὑπὲρ ἡμῶν (“por nós”) depois de ἡμῶν.\f*\x - \xo 5:7 \xt LUK 22:7; MRK 14:12; GAL 5:9; ROM 12:1; 1PE 1:19; EPH 4:22\x*
\v 8 \w De modo que|strong="G5620"\w* \w celebremos a festa|strong="G1858"\w*, \w não|strong="G3361"\w* \w com fermento|strong="G1722,G2219"\w* \w velho|strong="G3820"\w* \w nem|strong="G3366"\w* \w com fermento|strong="G1722,G2219"\w* \w de maldade|strong="G2549"\w* \w e|strong="G2532"\w* \w de perversidade|strong="G4189"\w*, \w mas|strong="G235"\w* \w com pães sem fermento|strong="G1722,G106"\w* \w de sinceridade|strong="G1505"\w* \w e|strong="G2532"\w* \w de verdade|strong="G225"\w*.\x - \xo 5:8 \xt ROM 12:1; MRK 8:15; LUK 12:1; 1PE 2:1; 1CO 11:24; 1CO 5:11\x*
\v 9 \w Escrevi|strong="G1125"\w* \w a vocês|strong="G4771"\w* \w na carta|strong="G1722,G3588,G1992"\w* \w que não se misturem|strong="G3361,G4874"\w* \w com imorais sexuais|strong="G4205"\w*,\f + \fr 5.9: \ft Lit.: ἐν τῇ ἐπιστολῇ: “na carta”; costuma-se entender uma carta anterior a esta.\f*\x - \xo 5:9 \xt 2TH 3:14; 1CO 5:11; 2CO 6:14; EPH 5:11; 1TH 4:3; MAT 18:17\x*
\v 10 \w não|strong="G3756"\w* \w de modo absoluto|strong="G3843"\w* \w com os imorais sexuais|strong="G3588,G4205"\w* \w deste mundo|strong="G3588,G2889,G3778"\w*, \w ou|strong="G2228"\w* \w com os avarentos|strong="G3588,G4123"\w* \w e|strong="G2532"\w* \w extorsionários|strong="G727"\w*, \w ou|strong="G2228"\w* \w com os idólatras|strong="G1496"\w*, \w pois|strong="G1893"\w* \w então|strong="G686"\w* \w teriam de|strong="G3784"\w* \w sair|strong="G1831"\w* \w do mundo|strong="G1537,G3588,G2889"\w*.\f + \fr 5.10: \ft Lit.: ἅρπαξ: “o que toma à força”, “extorsionário”, “rapace”.\f*\x - \xo 5:10 \xt EPH 5:5; 1CO 6:9; LUK 12:15; 1TH 4:3; EPH 2:2; EPH 5:11\x*
\v 11 \w Mas agora|strong="G3568,G1161"\w* \w escrevi|strong="G1125"\w* \w a vocês|strong="G4771"\w* \w que não se misturem|strong="G3361,G4874"\w*: \w se|strong="G1437"\w* \w alguém|strong="G5100"\w* \w chamado|strong="G3687"\w* \w irmão|strong="G80"\w* \w for|strong="G1510"\w* \w imoral sexual|strong="G4205"\w*, \w ou|strong="G2228"\w* \w avarento|strong="G4123"\w*, \w ou|strong="G2228"\w* \w idólatra|strong="G1496"\w*, \w ou|strong="G2228"\w* \w insultador|strong="G3060"\w*, \w ou|strong="G2228"\w* \w bêbado|strong="G3183"\w*, \w ou|strong="G2228"\w* \w extorsionário|strong="G727"\w*, \w com alguém assim|strong="G3588,G5108"\w* \w nem sequer|strong="G3366"\w* \w comer junto|strong="G4906"\w*.\x - \xo 5:11 \xt 1CO 6:10; EPH 5:5; ROM 16:17; 2TH 3:14; 2TH 3:6; MAT 18:17\x*
\v 12 \w Pois|strong="G1063"\w* \w o que|strong="G5101"\w* \w tenho eu|strong="G3165"\w* \w com julgar|strong="G2919"\w* \w os de fora|strong="G3588,G1854"\w*? \w Não|strong="G3780"\w* \w são os de dentro|strong="G3588,G2080"\w* \w que vocês|strong="G4771"\w* \w julgam|strong="G2919"\w*?\f + \fr 5.12: \ft Acréscimo: verbo ser/estar suprido em “são os de dentro”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 5:12 \xt COL 4:5; 2CO 2:5; 2TH 3:6; MRK 4:11; 1CO 6:4; 1TI 3:7\x*
\v 13 \w Mas os de fora|strong="G3588,G1161,G1854"\w* \w Deus|strong="G3588,G2316"\w* \w julga|strong="G2919"\w*. \w Removam|strong="G1808"\w* \w o mau|strong="G3588,G4190"\w* \w do meio|strong="G1537"\w* \w de vocês mesmos|strong="G4771,G846"\w*.\f + \fr 5.13: \ft Nota cultural: ecoa Dt 17:7; 19:19; 22:21, 24; 24:7 (LXX).\f*\f + \fr 5.13: \ft Lit.: τὸν πονηρόν: “o mau”, “o perverso” (a pessoa).\f*\f + \fr 5.13: \ft Lit.: a pontuação do SBLGNT (vírgula depois de κρίνετε e ponto de interrogação depois de κρίνει) liga as duas orações numa só pergunta; aqui 5:12 termina com a pergunta “não são os de dentro que vocês julgam?” e 5:13 começa a afirmação “mas os de fora Deus julga”, leitura de várias edições.\f*\x - \xo 5:13 \xt DEU 17:7; DEU 22:21; DEU 19:19; DEU 13:5; 1CO 5:11; DEU 21:21\x*
\c 6
\p
\v 1 \w Algum|strong="G5100"\w* \w de vocês|strong="G4771"\w*, \w tendo|strong="G2192"\w* \w uma causa|strong="G4229"\w* \w contra|strong="G4314"\w* \w o outro|strong="G3588,G2087"\w*, \w ousa|strong="G5111"\w* \w ir a julgamento|strong="G2919"\w* \w diante dos|strong="G1909,G3588"\w* \w injustos|strong="G94"\w*, \w e|strong="G2532"\w* \w não|strong="G3780"\w* \w diante dos|strong="G1909,G3588"\w* \w santos|strong="G40"\w*?\x - \xo 6:1 \xt MAT 18:15-17; 1CO 3:3; ACT 19:38; 1CO 14:33; EXO 18:16\x*
\v 2 \w Ou|strong="G2228"\w* \w não sabem|strong="G3756,G6063"\w* \w que|strong="G3754"\w* \w os santos|strong="G3588,G40"\w* \w julgarão|strong="G2919"\w* \w o mundo|strong="G3588,G2889"\w*? \w E|strong="G2532"\w* \w se|strong="G1487"\w* \w por vocês|strong="G1722,G4771"\w* \w é julgado|strong="G2919"\w* \w o mundo|strong="G3588,G2889"\w*, \w são indignos|strong="G370,G1510"\w* \w de tribunais|strong="G2922"\w* \w mínimos|strong="G1646"\w*?\f + \fr 6.2: \ft Variante: o RP omite ἤ (“ou”) no início do verso.\f*\x - \xo 6:2 \xt MAT 19:28; DAN 7:22; REV 20:4; LUK 22:30; REV 3:21; REV 2:26-27\x*
\v 3 \w Não sabem|strong="G3756,G6063"\w* \w que|strong="G3754"\w* \w julgaremos|strong="G2919"\w* \w anjos|strong="G32"\w*? \w Quanto mais|strong="G3386"\w* \w as coisas desta vida|strong="G982"\w*?\x - \xo 6:3 \xt REV 20:4; REV 3:21; 1CO 3:16; JUD 1:6; MAT 19:28; 1CO 6:9\x*
\v 4 \w Então|strong="G3767"\w*, \w se|strong="G1437"\w* \w vocês têm|strong="G2192"\w* \w tribunais|strong="G2922"\w* \w das coisas desta vida|strong="G982"\w*, \w esses|strong="G3778"\w* \w que são desprezados|strong="G3588,G1848"\w* \w na comunidade|strong="G1722,G3588,G1577"\w*, \w vocês os fazem sentar|strong="G2523"\w*\f + \fr 6.4: \ft Lit.: καθίζετε pode ser indicativo (“vocês fazem sentar”, em pergunta) ou imperativo (“façam sentar”); τοὺς ἐξουθενημένους: “os desprezados”, de sentido discutido (os de menor estima na comunidade ou os de fora).\f* \add como juízes?\add*\f + \fr 6.4: \ft Acréscimo: “como” (em “fazem sentar como juízes”): conectivo acrescentado para ligar as orações em português; “juízes” (em “sentar como juízes”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 6:4 \xt 1CO 6:2; ISA 40:28; 1CO 5:12; 1CO 6:3; 1CO 3:3; MAT 11:11\x*
\v 5 \w Falo|strong="G3004"\w* \w para envergonhar|strong="G4314,G1791"\w* \w vocês|strong="G4771"\w*. \w Assim|strong="G3779"\w*, \w não há|strong="G3756,G1762"\w* \w entre vocês|strong="G1722,G4771"\w* \w ninguém|strong="G3762"\w* \w sábio|strong="G4680"\w* \w que possa|strong="G3739,G1410"\w* \w decidir|strong="G1252"\w* \w entre|strong="G303,G3319"\w* \w um irmão|strong="G3588,G80,G846"\w* \add e outro,\add*\f + \fr 6.5: \ft Lit.: a frase é elíptica: “decidir entre um irmão e outro”.\f*\f + \fr 6.5: \ft Acréscimo: “e” (em “um irmão e outro”): conectivo acrescentado para ligar as orações em português; “outro” (em “irmão e outro”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 6:5 \xt 1CO 15:34; PSA 14:3; JAS 3:13; ISA 40:28; 1CO 4:14; ROM 12:16\x*
\v 6 \w mas|strong="G235"\w* \w irmão com irmão|strong="G80,G3326"\w* \w vai a julgamento|strong="G2919"\w*, \w e|strong="G2532"\w* \w isso|strong="G3778"\w* \w diante de|strong="G1909"\w* \w descrentes|strong="G571"\w*?\x - \xo 6:6 \xt ACT 26:8; MAT 18:15; GEN 13:8; GAL 5:15; MAT 5:9; PHP 2:14-15\x*
\v 7 \w Já|strong="G2235"\w*, \w então|strong="G3767"\w*, \w é|strong="G1510"\w* \w um fracasso|strong="G2275"\w* \w completo|strong="G3654"\w* \w para vocês|strong="G4771"\w* \w que|strong="G3754"\w* \w tenham|strong="G2192"\w* \w processos|strong="G2917"\w* \w uns com os outros|strong="G3326,G1438"\w*. \w Por que|strong="G1223,G5101"\w* \w não preferem|strong="G3780,G3123"\w* \w ser injustiçados|strong="G91"\w*? \w Por que|strong="G1223,G5101"\w* \w não preferem|strong="G3780,G3123"\w* \w ser defraudados|strong="G650"\w*?\f + \fr 6.7: \ft Lit.: ἥττημα: “fracasso”, “derrota”, “diminuição”; κρίμα: “processo”, “litígio”.\f*\x - \xo 6:7 \xt COL 3:13; ROM 12:17; PRO 20:22; 1PE 2:19-23; 1PE 3:9; MAT 5:39\x*
\v 8 \w Pelo contrário|strong="G235"\w*, \w vocês|strong="G4771"\w* \w cometem injustiça|strong="G91"\w* \w e|strong="G2532"\w* \w defraudam|strong="G650"\w*, \w e|strong="G2532"\w* \w isso|strong="G3778"\w* \w a irmãos|strong="G80"\w*.\x - \xo 6:8 \xt COL 3:13; MAT 18:15; 1TH 4:6; GAL 5:15; 1CO 3:3; EST 1:16\x*
\v 9 \w Ou|strong="G2228"\w* \w não sabem|strong="G3756,G6063"\w* \w que|strong="G3754"\w* \w os injustos|strong="G94"\w* \w o reino|strong="G932"\w* \w de Deus|strong="G2316"\w* \w não herdarão|strong="G3756,G2816"\w*? \w Não se enganem|strong="G3361,G4105"\w*: \w nem|strong="G3777"\w* \w imorais sexuais|strong="G4205"\w*, \w nem|strong="G3777"\w* \w idólatras|strong="G1496"\w*, \w nem|strong="G3777"\w* \w adúlteros|strong="G3432"\w*, \w nem|strong="G3777"\w* \w os moles|strong="G3120"\w*, \w nem|strong="G3777"\w* \w os que se deitam com homens|strong="G733"\w*,\f + \fr 6.9: \ft Lit.: μαλακοί: literalmente “macios”, “moles”; o sentido neste contexto é discutido (por exemplo, passividade moral ou sexual); ἀρσενοκοῖται: palavra rara formada de ἄρσην, “macho”, e κοίτη, “leito”, com sentido sexual; o sentido exato é discutido.\f*\x - \xo 6:9 \xt EPH 5:5; REV 21:8; 1TI 1:10; 1TI 1:9-10; GAL 5:19; MAT 9:13\x*
\v 10 \w nem|strong="G3777"\w* \w ladrões|strong="G2812"\w*, \w nem|strong="G3777"\w* \w avarentos|strong="G4123"\w*, \w nem|strong="G3756"\w* \w bêbados|strong="G3183"\w*, \w nem|strong="G3756"\w* \w insultadores|strong="G3060"\w*, \w nem|strong="G3756"\w* \w extorsionários|strong="G727"\w* \w herdarão|strong="G2816"\w* \w o reino|strong="G932"\w* \w de Deus|strong="G2316"\w*.\f + \fr 6.10: \ft Tradução: A lista continua a de 6:9, cujos termos têm sentido discutido; aqui πλεονέκται, “avarentos” (quem quer ter sempre mais), λοίδοροι, “insultadores”, ἅρπαγες, “extorsionários”; ver a nota de 6:9.\f*\x - \xo 6:10 \xt 1CO 5:11; REV 21:8; GAL 5:19; MAT 9:13; COL 1:13; 1CO 6:9\x*
\v 11 \w E|strong="G2532"\w* \w alguns de vocês|strong="G5100"\w* \w eram|strong="G1510"\w* \w isso|strong="G3778"\w*; \w mas|strong="G235"\w* \w foram lavados|strong="G628"\w*, \w mas|strong="G235"\w* \w foram santificados|strong="G37"\w*, \w mas|strong="G235"\w* \w foram declarados justos|strong="G1344"\w* \w no nome|strong="G1722,G3588,G3686"\w* \w do Senhor|strong="G3588,G2962"\w* \w Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w no Espírito|strong="G1722,G3588,G4151"\w* \w do nosso Deus|strong="G3588,G2316,G3165"\w*.\f + \fr 6.11: \ft Lit.: ἀπελούσασθε (voz média): “vocês se lavaram” ou “vocês foram lavados”.\f*\f + \fr 6.11: \ft Variante: o SBLGNT, com o RP, traz Ἰησοῦ; Treg e NA28 trazem Ἰησοῦ Χριστοῦ; WH traz ἡμῶν Ἰησοῦ Χριστοῦ (“do nosso Senhor Jesus Cristo”).\f*\x - \xo 6:11 \xt ACT 22:16; MAT 9:13; TIT 3:5; COL 1:13; JHN 3:5; EPH 5:26\x*
\v 12 \w Tudo|strong="G3956"\w* \w me é permitido|strong="G3165,G1832"\w*, \w mas|strong="G235"\w* \w nem tudo|strong="G3756,G3956"\w* \w convém|strong="G4851"\w*. \w Tudo|strong="G3956"\w* \w me é permitido|strong="G3165,G1832"\w*, \w mas|strong="G235"\w* \w eu não|strong="G3756,G1473"\w* \w serei dominado|strong="G1850"\w* \w por nada|strong="G5259,G5100"\w*.\f + \fr 6.12: \ft Lit.: as frases “tudo me é permitido” e as semelhantes dos vv. 13 e 12 são tidas por alguns como lemas dos coríntios, o que o texto não indica com aspas.\f*\x - \xo 6:12 \xt 1CO 10:23; 1CO 9:27; HEB 12:15-16; ROM 14:14-23; 1CO 8:7-13; 2CO 5:10\x*
\v 13 \w Os alimentos|strong="G3588,G1033"\w* \w são para o ventre|strong="G3588,G2836"\w*, \w e|strong="G2532"\w* \w o ventre|strong="G3588,G2836"\w* \w para os alimentos|strong="G3588,G1033"\w*; \w mas|strong="G1161"\w* \w Deus|strong="G3588,G2316"\w* \w tanto anulará|strong="G2532,G2673"\w* \w este|strong="G3778"\w* \w quanto aqueles|strong="G2532,G3778"\w*. \w O corpo|strong="G3588,G4983"\w* \w não é|strong="G3756"\w* \w para a imoralidade sexual|strong="G3588,G4202"\w*, \w mas|strong="G235"\w* \w para o Senhor|strong="G3588,G2962"\w*, \w e|strong="G2532"\w* \w o Senhor|strong="G3588,G2962"\w* \w para o corpo|strong="G3588,G4983"\w*.\f + \fr 6.13: \ft Acréscimo: verbo ser/estar suprido em “são para o ventre”, “não é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:13 \xt MRK 7:19; ROM 12:1; 1CO 9:27; 1JN 4:4; 1CO 6:19; 1CO 3:16\x*
\v 14 \w E Deus|strong="G3588,G1161,G2316"\w* \w tanto ressuscitou|strong="G2532,G1453"\w* \w o Senhor|strong="G3588,G2962"\w* \w quanto nos ressuscitará|strong="G2532,G3165,G1825"\w* \w por meio do seu poder|strong="G1223,G3588,G1411,G846"\w*.\x - \xo 6:14 \xt ROM 12:1; ROM 8:11; ACT 2:24; 1TH 4:3; 2CO 4:14; ROM 6:4\x*
\v 15 \w Não sabem|strong="G3756,G6063"\w* \w que|strong="G3754"\w* \w os corpos|strong="G3588,G4983"\w* \w de vocês|strong="G4771"\w* \w são|strong="G1510"\w* \w membros|strong="G3196"\w* \w de Cristo|strong="G5547"\w*? \w Então|strong="G3767"\w*, \w tomando|strong="G142"\w* \w os membros|strong="G3588,G3196"\w* \w do Cristo|strong="G3588,G5547"\w*, \w eu os faria|strong="G4160"\w* \w membros|strong="G3196"\w* \w de uma prostituta|strong="G4204"\w*? \w De modo nenhum|strong="G3361,G1096"\w*!\x - \xo 6:15 \xt EPH 5:30; ROM 12:5; 1CO 12:27; 1CO 12:14; ROM 12:1; 1CO 12:19\x*
\v 16 \w Ou|strong="G2228"\w* \w não sabem|strong="G3756,G6063"\w* \w que|strong="G3754"\w* \w quem se une|strong="G3588,G2853"\w* \w à prostituta|strong="G3588,G4204"\w* \w é|strong="G1510"\w* \w um só|strong="G1520"\w* \w corpo|strong="G4983"\w*? \w Pois|strong="G1063"\w*, \w diz a Escritura|strong="G5346"\w*: “\w os dois|strong="G3588,G1417"\w* \w serão|strong="G1510"\w* \w uma só|strong="G1519,G1520"\w* \w carne|strong="G4561"\w*.”\f + \fr 6.16: \ft Nota cultural: cita Gn 2:24.\f*\f + \fr 6.16: \ft Lit.: φησίν: “diz”, subentendido “a Escritura” ou “Deus”.\f*\x - \xo 6:16 \xt GEN 2:24; MAT 19:5; MRK 10:8; ROM 12:1; MAT 21:31; 1CO 6:19\x*
\v 17 \w Mas|strong="G1161"\w* \w quem se une|strong="G3588,G2853"\w* \w ao Senhor|strong="G3588,G2962"\w* \w é|strong="G1510"\w* \w um só|strong="G1520"\w* \w espírito|strong="G4151"\w*.\x - \xo 6:17 \xt ROM 12:1; JHN 17:21-23; GAL 2:20; 1CO 12:13; GEN 2:24; EPH 4:3-4\x*
\v 18 \w Fujam|strong="G5343"\w* \w da imoralidade sexual|strong="G3588,G4202"\w*. \w Todo pecado|strong="G3956,G265"\w* \w que|strong="G3739,G1437"\w* \w alguém cometer|strong="G4160,G444"\w* \w é|strong="G1510"\w* \w fora do|strong="G1622,G3588"\w* \w corpo|strong="G4983"\w*; \w mas|strong="G1161"\w* \w quem pratica imoralidade sexual|strong="G3588,G4203"\w* \w peca|strong="G264"\w* \w contra o próprio|strong="G1519,G3588,G2398"\w* \w corpo|strong="G4983"\w*.\x - \xo 6:18 \xt ROM 12:1; 1CO 7:2; 1PE 2:11; 2TI 2:22; 1TH 4:3; COL 3:5\x*
\v 19 \w Ou|strong="G2228"\w* \w não sabem|strong="G3756,G6063"\w* \w que|strong="G3754"\w* \w o corpo|strong="G3588,G4983"\w* \w de vocês|strong="G4771"\w* \w é|strong="G1510"\w* \w santuário|strong="G3485"\w* \w do Espírito Santo|strong="G3588,G40,G4151"\w* \w que está em vocês|strong="G1722,G4771"\w*, \w o qual|strong="G3739"\w* \w têm|strong="G2192"\w* \w da parte de Deus|strong="G575,G2316"\w*, \w e|strong="G2532"\w* \w que não|strong="G3756"\w* \w são|strong="G1510"\w* \w de si mesmos|strong="G1438"\w*?\f + \fr 6.19: \ft Acréscimo: “que está em vocês”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 6:19 \xt JHN 2:21; EPH 2:21; 1CO 3:17; 1CO 3:16; 2CO 6:16; 1PE 2:5\x*
\v 20 \w Pois|strong="G1063"\w* \w foram comprados|strong="G59"\w* \w por preço|strong="G5092"\w*; \w glorifiquem|strong="G1392"\w* \w então|strong="G1211"\w* \w a Deus|strong="G3588,G2316"\w* \w no corpo|strong="G1722,G3588,G4983"\w*\f + \fr 6.20: \ft Variante: o RP acrescenta καὶ ἐν τῷ πνεύματι ὑμῶν ἅτινά ἐστιν τοῦ θεοῦ (“e em seu espírito, que pertencem a Deus”).\f* \w de vocês|strong="G4771"\w*.\f + \fr 6.20: \ft Tradução: τιμῆς (τιμή, G5092) está aqui como “por preço”; o termo pode ser “honra”, “preço”, “valor” ou “estima”, e o contexto decide.\f*\x - \xo 6:20 \xt 1CO 7:23; ROM 12:1; 1PE 2:9; 1PE 1:18; 2CO 5:15; PSA 116:12\x*
\c 7
\p
\v 1 \w Agora|strong="G1161"\w* \w quanto|strong="G4012"\w* \w ao que|strong="G3739"\w* \w vocês escreveram|strong="G1125"\w*: \w é bom|strong="G2570"\w* \w para o homem|strong="G444"\w* \w não tocar|strong="G3361,G681"\w* \w em mulher|strong="G1135"\w*.\f + \fr 7.1: \ft Lit.: γυναικὸς μὴ ἅπτεσθαι: “não tocar mulher”, expressão que pode designar relação sexual ou casamento; alguns a entendem como lema dos coríntios.\f*\f + \fr 7.1: \ft Variante: Treg e o RP acrescentam μοι (“a mim”) depois de ἐγράψατε.\f*\f + \fr 7.1: \ft Acréscimo: verbo ser/estar suprido em “é bom”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:1 \xt 1CO 7:8; 1CO 7:26; MAT 19:10; 1CO 7:37-38; 1CO 7:38; PRO 6:29\x*
\v 2 \w Mas|strong="G1161"\w* \w por causa das|strong="G1223,G3588"\w* \w imoralidades sexuais|strong="G4202"\w*, \w cada homem|strong="G1538"\w* \w tenha|strong="G2192"\w* \w a sua própria|strong="G3588,G1438"\w* \w mulher|strong="G1135"\w*, \w e|strong="G2532"\w* \w cada mulher|strong="G1538"\w* \w tenha|strong="G2192"\w* \w o seu próprio|strong="G3588,G2398"\w* \w marido|strong="G435"\w*.\x - \xo 7:2 \xt EPH 5:33; EPH 5:22; 1CO 6:18; 1CO 11:8; EPH 5:28; PRO 18:22\x*
\v 3 \w À mulher|strong="G3588,G1135"\w* \w o marido|strong="G3588,G435"\w* \w dê|strong="G591"\w* \w o que lhe é devido|strong="G3588,G3782"\w*, \w e igualmente|strong="G3668,G1161,G2532"\w* \w a mulher|strong="G3588,G1135"\w* \w ao marido|strong="G3588,G435"\w*.\f + \fr 7.3: \ft Variante: o RP traz ὀφειλομένην εὔνοιαν (“a devida benevolência”) em lugar de ὀφειλήν.\f*\f + \fr 7.3: \ft Acréscimo: verbo ser/estar suprido em “o que lhe é devido”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:3 \xt 1PE 3:7; HEB 13:4; GEN 2:24; PRO 5:15; EXO 21:10; LUK 20:34\x*
\v 4 \w A mulher|strong="G3588,G1135"\w* \w não tem autoridade|strong="G3756,G1850"\w* \w sobre o próprio|strong="G3588,G2398"\w* \w corpo|strong="G4983"\w*, \w mas|strong="G235"\w* \w o marido|strong="G3588,G435"\w*; \w e igualmente|strong="G3668,G1161,G2532"\w* \w o marido|strong="G3588,G435"\w* \w não tem autoridade|strong="G3756,G1850"\w* \w sobre o próprio|strong="G3588,G2398"\w* \w corpo|strong="G4983"\w*, \w mas|strong="G235"\w* \w a mulher|strong="G3588,G1135"\w*.\x - \xo 7:4 \xt EPH 5:22; HEB 13:4; GEN 2:24; MAT 19:5; ROM 7:2; MAT 5:32\x*
\v 5 \w Não se privem|strong="G3361,G650"\w* \w um do outro|strong="G240"\w*, \w a não ser|strong="G1487,G3385,G302"\w* \w por acordo|strong="G1537,G4859"\w* \w por um tempo|strong="G4314,G2540"\w*, \w para que|strong="G2443"\w* \w se dediquem|strong="G4980"\w* \w à oração|strong="G3588,G4335"\w*; \w e|strong="G2532"\w* \w novamente|strong="G3825"\w* \w voltem a estar juntos|strong="G1909,G3588,G846,G1510"\w*, \w para que|strong="G2443"\w* \w não|strong="G3361"\w* \w os tente|strong="G3985,G4771"\w* \w Satanás|strong="G3588,G4567"\w* \w por causa da|strong="G1223,G3588"\w* \w falta de domínio próprio|strong="G192"\w* \w de vocês|strong="G4771"\w*.\f + \fr 7.5: \ft Lit.: ἀκρασία: “falta de domínio próprio”, “incontinência”; σχολάζω: “ter tempo livre para”, “dedicar-se a”.\f*\f + \fr 7.5: \ft Variante: o RP traz σχολάζητε (presente) em lugar de σχολάσητε, acrescenta τῇ νηστείᾳ καὶ (“ao jejum e”) e traz συνέρχησθε em lugar de ἦτε.\f*\x - \xo 7:5 \xt HEB 13:4; 2CO 2:11; PRO 5:15; GAL 6:1; MAT 6:16; ACT 13:2\x*
\v 6 \w Isto|strong="G3778"\w* \w digo|strong="G3004"\w* \w como concessão|strong="G2596,G4774"\w*, \w não|strong="G3756"\w* \w como ordem|strong="G2596,G2003"\w*.\x - \xo 7:6 \xt HEB 13:4; 2CO 8:8; 1CO 7:25; 1CO 7:12; 1CO 7:10; LUK 20:34\x*
\v 7 \w Quero|strong="G2309"\w*, \w porém|strong="G1161"\w*, \w que todos os seres humanos|strong="G3956,G444"\w* \w sejam|strong="G1511"\w* \w como|strong="G5613"\w* \w também|strong="G2532"\w* \w eu mesmo|strong="G1473"\w*; \w mas|strong="G235"\w* \w cada um|strong="G1538"\w* \w tem|strong="G2192"\w* \w seu próprio|strong="G2398"\w* \w dom|strong="G5486"\w* \w da parte de Deus|strong="G1537,G2316"\w*, \w um|strong="G3588,G3303"\w* \w assim|strong="G3779"\w*, \w outro|strong="G3588,G1161"\w* \w assim|strong="G3779"\w*.\x - \xo 7:7 \xt HEB 13:4; ROM 12:6; MAT 19:11; 1CO 4:7; 1CO 7:8; 1CO 9:5\x*
\v 8 \w Digo|strong="G3004"\w* \w aos solteiros|strong="G3588,G22"\w* \w e|strong="G2532"\w* \w às viúvas|strong="G3588,G5503"\w*: \w é bom|strong="G2570"\w* \w para eles|strong="G846"\w* \w se|strong="G1437"\w* \w permanecerem|strong="G3306"\w* \w como eu|strong="G5613,G2532_B,G1473"\w*.\f + \fr 7.8: \ft Acréscimo: verbo ser/estar suprido em “é bom”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:8 \xt HEB 13:4; 1CO 7:1; 1CO 7:26; 1CO 7:32; 1CO 7:7; 1TI 5:14\x*
\v 9 \w Mas se|strong="G1487,G1161"\w* \w não têm domínio próprio|strong="G3756,G1467"\w*, \w casem-se|strong="G1060"\w*; \w pois|strong="G1063"\w* \w é melhor|strong="G2908,G1510"\w* \w casar-se|strong="G1060"\w* \w do que|strong="G2228"\w* \w arder|strong="G4448"\w*.\f + \fr 7.9: \ft Lit.: πυροῦσθαι: “arder”, isto é, de desejo, ou ser consumido (de sentido discutido).\f*\x - \xo 7:9 \xt HEB 13:4; 1CO 7:2; 1TH 4:4; 1TI 5:14; 1TI 5:11; 2TI 3:3\x*
