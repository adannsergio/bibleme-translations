\v 35 \w Isto|strong="G3778"\w* \w digo|strong="G3004"\w* \w para o proveito|strong="G4314,G3588,G4851"\w* \w de vocês mesmos|strong="G4771,G846"\w*, \w não|strong="G3756"\w* \w para que|strong="G2443"\w* \w lhes|strong="G4771"\w* \w lance|strong="G1911"\w* \w um laço|strong="G1029"\w*, \w mas|strong="G235"\w* \w para o que é|strong="G4314,G3588"\w* \w decoroso|strong="G2158"\w* \w e|strong="G2532"\w* \w de dedicação constante|strong="G2145"\w* \w ao Senhor|strong="G3588,G2962"\w* \w sem distração|strong="G563"\w*.\f + \fr 7.35: \ft Lit.: βρόχος: “laço”; εὐπάρεδρος: “de dedicação assídua”, “que assiste ao lado”.\f*\f + \fr 7.35: \ft Acréscimo: verbo ser/estar suprido em “para o que é”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 7:35 \xt LUK 10:41; 1CO 7:33-34; 1CO 7:36; MAT 19:12; LUK 8:14; 1CO 7:2\x*
\v 36 \w Mas se|strong="G1487,G1161"\w* \w alguém|strong="G5100"\w* \w pensa|strong="G3543"\w* \w estar agindo de modo indecoroso|strong="G807"\w* \w com a sua virgem|strong="G1909,G3588,G3933,G846"\w*, \w se|strong="G1437"\w* \w ela passou da flor da idade|strong="G1510,G5230"\w*, \w e|strong="G2532"\w* \w assim|strong="G3779"\w* \w deve|strong="G3784"\w* \w acontecer|strong="G1096"\w*, \w faça|strong="G4160"\w* \w o que|strong="G3739"\w* \w quer|strong="G2309"\w*; \w não peca|strong="G3756,G264"\w*; \w casem-se|strong="G1060"\w*.\f + \fr 7.36: \ft Lit.: τὴν παρθένον αὐτοῦ: “a sua virgem”, isto é, a sua noiva ou a sua filha; o sentido dos vv. 36-38 é discutido; ὑπέρακμος: “passada do auge”, “de idade avançada” ou “de desejo forte”.\f*\x - \xo 7:36 \xt 1CO 7:28; GEN 2:18; RUT 3:1; 1CO 7:35; MAT 19:12; 1TI 4:3\x*
\v 37 \w Mas quem|strong="G3739,G1161"\w* \w está firme|strong="G2476,G1476"\w* \w no seu coração|strong="G1722,G3588,G2588,G846"\w*, \w não tendo|strong="G3361,G2192"\w* \w necessidade|strong="G318"\w*, \w mas|strong="G1161"\w* \w tem|strong="G2192"\w* \w autoridade|strong="G1849"\w* \w sobre a sua própria|strong="G4012,G3588,G2398"\w* \w vontade|strong="G2307"\w*, \w e|strong="G2532"\w* \w isto|strong="G3778"\w* \w decidiu|strong="G2919"\w* \w no seu próprio|strong="G1722,G3588,G2398"\w* \w coração|strong="G2588"\w*, \w guardar|strong="G5083"\w* \w a sua|strong="G3588,G1438"\w* \w virgem|strong="G3933"\w*, \w fará|strong="G4160"\w* \w bem|strong="G2573"\w*.\f + \fr 7.37: \ft Tradução: τὴν ἑαυτοῦ παρθένον, literalmente “a sua virgem”: de sentido discutido (noiva, filha ou parceira); ver a nota de 7:36.\f*\f + \fr 7.37: \ft Tradução: κέκρικεν (κρίνω, G2919) está aqui como “decidiu”; o termo pode ser “julgar”, “decidir”, “condenar” ou “considerar”, e o contexto decide.\f*\x - \xo 7:37 \xt DAN 1:8; MAT 19:12; 1TI 4:3; 1CO 7:1; 1CO 7:26; 1CO 7:36\x*
\v 38 \w De modo que|strong="G5620"\w* \w tanto|strong="G2532"\w* \w quem|strong="G3588"\w* \w dá em casamento|strong="G1061"\w* \w a sua|strong="G3588,G1438"\w* \w virgem|strong="G3933"\w* \w faz bem|strong="G2573,G4160"\w*, \w quanto|strong="G2532"\w* \w quem|strong="G3588"\w* \w não dá em casamento|strong="G3361,G1061"\w* \w fará melhor|strong="G2908,G4160"\w*.\f + \fr 7.38: \ft Lit.: γαμίζω: “dar em casamento” (ou “casar”, se o sujeito for o noivo).\f*\f + \fr 7.38: \ft Variante: o SBLGNT traz γαμίζων, o RP ἐκγαμίζων; o SBLGNT e Treg trazem τὴν παρθένον ἑαυτοῦ, WH e NA28 τὴν ἑαυτοῦ παρθένον, e o RP omite essas palavras; o RP traz ὁ δέ em lugar de καὶ ὁ e ποιεῖ (presente) em lugar de ποιήσει.\f*\x - \xo 7:38 \xt MAT 19:12; HEB 13:4; 1TI 4:3; 1CO 7:1; 1CO 7:26; 1CO 7:32-34\x*
\v 39 \w A mulher|strong="G1135"\w* \w está ligada|strong="G1210"\w* \w por todo o tempo|strong="G1909,G3745,G5550"\w* \add em que\add* \w vive|strong="G2198"\w* \w o seu marido|strong="G3588,G435,G846"\w*; \w mas se|strong="G1437,G1161"\w* \w o marido|strong="G3588,G435"\w* \w morrer|strong="G2837"\w*, \w ela é livre|strong="G1658,G1510"\w* \w para casar-se|strong="G1060"\w* \w com quem|strong="G3739"\w* \w quiser|strong="G2309"\w*, \w somente|strong="G3441"\w* \w no Senhor|strong="G1722,G2962"\w*.\f + \fr 7.39: \ft Lit.: κοιμηθῇ: “adormecer”, eufemismo para morrer.\f*\f + \fr 7.39: \ft Variante: o RP acrescenta νόμῳ (“pela lei”) depois de δέδεται e καί depois de δέ.\f*\f + \fr 7.39: \ft Acréscimo: “em” (em “o tempo em que vive”): preposição ou artigo que a regência do português exige; “que” (em “tempo em que vive o”): conjunção que o português exige onde o grego usa infinitivo, particípio ou justaposição.\f*\x - \xo 7:39 \xt ROM 7:2; 1CO 7:10; MAT 19:9; 2CO 6:14; 1TI 4:3; 1CO 7:15\x*
\v 40 \w É|strong="G1510"\w* \w mais feliz|strong="G3107"\w* \w se|strong="G1437"\w* \w assim|strong="G3779"\w* \w permanecer|strong="G3306"\w*, \w segundo|strong="G2596"\w* \w o meu|strong="G3588,G1473"\w* \w parecer|strong="G1106"\w*; \w julgo|strong="G1380"\w* \w que também eu|strong="G2532,G1473"\w* \w tenho|strong="G2192"\w* \w o Espírito|strong="G4151"\w* \w de Deus|strong="G2316"\w*.\f + \fr 7.40: \ft Tradução: δοκῶ (δοκέω, G1380) está aqui como “julgo”; o termo pode ser “parecer”, “pensar”, “julgar” ou “ser considerado”, e o contexto decide.\f*\x - \xo 7:40 \xt 1CO 7:25; 2CO 8:10; 1CO 7:1; 1CO 7:8; 1TI 5:11; ACT 15:28\x*
\c 8
\p
\v 1 \w Quanto|strong="G4012,G1161"\w* \w às coisas oferecidas a ídolos|strong="G3588,G1494"\w*: \w sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w todos|strong="G3956"\w* \w temos|strong="G2192"\w* \w conhecimento|strong="G1108"\w*. \w O conhecimento|strong="G3588,G1108"\w* \w faz inchar|strong="G5448"\w*, \w mas|strong="G1161"\w* \w o amor|strong="G3588,G26"\w* \w edifica|strong="G3618"\w*.\f + \fr 8.1: \ft Lit.: εἰδωλόθυτον: “(carne) oferecida a ídolo”; φυσιόω: “inchar de orgulho”, “envaidecer”.\f*\x - \xo 8:1 \xt PRO 3:5; 1CO 8:10; 1CO 13:4; 1CO 8:7; 1CO 13:1; 1CO 13:13\x*
\v 2 \w Se|strong="G1487"\w* \w alguém|strong="G5100"\w* \w pensa|strong="G1380"\w* \w ter conhecido|strong="G1097"\w* \w algo|strong="G5100"\w*, \w ainda não|strong="G3768"\w* \w conheceu|strong="G1097"\w* \w como|strong="G2531"\w* \w é necessário|strong="G1163"\w* \w conhecer|strong="G1097"\w*;\x - \xo 8:2 \xt PRO 3:5; 1CO 10:12; GAL 6:3; 1CO 13:12; 1CO 3:18; 1CO 13:9\x*
\v 3 \w mas se|strong="G1487,G1161"\w* \w alguém|strong="G5100"\w* \w ama|strong="G25"\w* \w a Deus|strong="G3588,G2316"\w*, \w esse|strong="G3778"\w* \w é conhecido|strong="G1097"\w* \w por ele|strong="G5259,G846"\w*.\x - \xo 8:3 \xt 1JN 5:2; 2TI 2:19; EXO 33:17; REV 3:8-9; NAM 1:7; 1CO 2:9\x*
\v 4 \w Quanto|strong="G4012"\w* \w ao comer|strong="G3588,G1035"\w* \w as coisas oferecidas a ídolos|strong="G3588,G1494"\w*, \w portanto|strong="G3767"\w*, \w sabemos|strong="G6063"\w* \w que|strong="G3754"\w* \w um ídolo|strong="G1497"\w* \w no mundo|strong="G1722,G2889"\w* \w não é nada|strong="G3762"\w*, \w e|strong="G2532"\w* \w que|strong="G3754"\w* \w nenhum|strong="G3762"\w* \w Deus|strong="G2316"\w* \add existe\add* \w a não ser|strong="G1487,G3361"\w* \w um só|strong="G1520"\w*.\f + \fr 8.4: \ft Acréscimo: “existe” (em “nenhum Deus existe a não”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige; verbo ser/estar suprido em “não é nada”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 8:4 \xt 1CO 10:19; 1CO 8:6; DEU 4:39; DEU 6:4; GAL 4:8; MRK 12:29\x*
\v 5 \w Pois|strong="G1063"\w* \w também|strong="G2532"\w* \w se de fato|strong="G1512"\w* \w existem|strong="G1510"\w* \w os chamados|strong="G3004"\w* \w deuses|strong="G2316"\w*, \w seja|strong="G1535"\w* \w no céu|strong="G1722,G3772"\w*, \w seja|strong="G1535"\w* \w na terra|strong="G1909,G1093"\w*, \w como|strong="G5618"\w* \w existem|strong="G1510"\w* \w deuses|strong="G2316"\w* \w muitos|strong="G4183"\w* \w e|strong="G2532"\w* \w senhores|strong="G2962"\w* \w muitos|strong="G4183"\w*,\f + \fr 8.5: \ft Acréscimo: verbo ser/estar suprido em “seja”, “seja”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 8:5 \xt DEU 6:4; 2TH 2:4; 1TI 4:1; PSA 81:9; ACT 15:20; COL 2:18\x*
\v 6 \w mas|strong="G235"\w* \w para nós|strong="G3165"\w* \w um só|strong="G1520"\w* \w Deus|strong="G2316"\w*, \w o Pai|strong="G3588,G3962"\w*, \w de quem|strong="G1537,G3739"\w* \w todas as coisas|strong="G3588,G3956"\w* \w e|strong="G2532"\w* \w nós|strong="G3165"\w* \w para ele|strong="G1519,G846"\w*; \w e|strong="G2532"\w* \w um só|strong="G1520"\w* \w Senhor|strong="G2962"\w*, \w Jesus|strong="G2424"\w* \w Cristo|strong="G5547"\w*, \w por meio de quem|strong="G1223,G3739"\w* \w todas as coisas|strong="G3588,G3956"\w* \w e|strong="G2532"\w* \w nós|strong="G3165"\w* \w por meio dele|strong="G1223,G846"\w*.\x - \xo 8:6 \xt GEN 1:1; JHN 1:3; COL 1:16; COL 1:17; ROM 11:36; 1TI 2:5\x*
\v 7 \w Mas|strong="G235"\w* \w nem em todos|strong="G3756,G1722,G3956"\w* \w este conhecimento|strong="G3588,G1108"\w*; \w alguns|strong="G5100"\w*, \w porém|strong="G1161"\w*, \w por hábito|strong="G3588,G4914"\w* \w até agora|strong="G2193,G737"\w* \w em relação ao ídolo|strong="G3588,G1497"\w*, \w comem|strong="G2068"\w* \w como|strong="G5613"\w* \w coisa oferecida a ídolo|strong="G1494"\w*, \w e|strong="G2532"\w* \w a consciência|strong="G3588,G4893"\w* \w deles|strong="G846"\w*, \w sendo|strong="G1510"\w* \w fraca|strong="G772"\w*, \w é contaminada|strong="G3435"\w*.\f + \fr 8.7: \ft Lit.: συνήθεια: “hábito”, “costume”.\f*\f + \fr 8.7: \ft Variante: o RP traz συνειδήσει (“por consciência”) em lugar de συνηθείᾳ e a ordem τοῦ εἰδώλου ἕως ἄρτι.\f*\x - \xo 8:7 \xt 1CO 8:10; 1CO 8:4; 1CO 8:1; ROM 14:1; ROM 14:23; DAN 1:8\x*
\v 8 \w A comida|strong="G1033"\w* \w não|strong="G3756"\w* \w nos apresentará|strong="G3165,G3936"\w* \w a Deus|strong="G3588,G2316"\w*; \w pois|strong="G1063"\w* \w nem|strong="G3777"\w* \w se|strong="G1437"\w* \w comermos|strong="G5315"\w* \w temos de sobra|strong="G4052"\w*, \w nem|strong="G3777"\w* \w se não comermos|strong="G1437,G3361,G5315"\w* \w nos falta algo|strong="G5302"\w*.\x - \xo 8:8 \xt ROM 14:17; ROM 14:1; DAN 1:8; 1TI 4:3; 1CO 6:12; HEB 13:9\x*
\v 9 \w Cuidem|strong="G991"\w* \w para que não|strong="G3361,G4458"\w* \w este direito|strong="G3588,G1849,G3778"\w* \w de vocês|strong="G4771"\w* \w se torne|strong="G1096"\w* \w tropeço|strong="G4348"\w* \w para os fracos|strong="G3588,G772"\w*.\f + \fr 8.9: \ft Lit.: ἐξουσία: “autoridade”, “direito”, “liberdade”.\f*\x - \xo 8:9 \xt GAL 5:13; 1CO 10:23; ROM 14:1; ROM 14:20; 1PE 2:16; DAN 1:8\x*
\v 10 \w Pois|strong="G1063"\w* \w se|strong="G1437"\w* \w alguém|strong="G5100"\w* \w vir|strong="G1492"\w* \w você|strong="G4771"\w*, \w que tem|strong="G3588,G2192"\w* \w conhecimento|strong="G1108"\w*, \w reclinado|strong="G2621"\w* \w num templo de ídolos|strong="G1722,G1493"\w*, \w não será|strong="G3780"\w* \w a consciência|strong="G3588,G4893"\w* \w dele|strong="G846"\w*, \w sendo fraca|strong="G772,G1510"\w*, \w edificada|strong="G3618"\w* \w para comer|strong="G1519,G3588,G2068"\w* \w coisas oferecidas a ídolos|strong="G3588,G1494"\w*?\f + \fr 8.10: \ft Lit.: οἰκοδομηθήσεται: “será edificada”, em sentido irônico (será encorajada a agir contra a própria consciência); εἰδωλεῖον: “templo de ídolos”.\f*\f + \fr 8.10: \ft Acréscimo: verbo ser/estar suprido em “não será”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 8:10 \xt 1CO 8:7; 1CO 8:1; 1CO 10:28; ROM 14:1; DAN 1:8; ROM 14:13\x*
\v 11 \w Pois|strong="G1063"\w* \w é destruído|strong="G622"\w* \w o fraco|strong="G3588,G770"\w* \w por meio do seu conhecimento|strong="G1722,G3588,G4771,G1108"\w*, \w o irmão|strong="G3588,G80"\w* \w por causa de quem|strong="G1223,G3739"\w* \w Cristo|strong="G5547"\w* \w morreu|strong="G599"\w*.\f + \fr 8.11: \ft Variante: o RP traz Καὶ ἀπολεῖται (“e perecerá”) em lugar de ἀπόλλυται γάρ, ἀδελφὸς ἐπί (“o irmão, por causa de”) em lugar de ἐν, e omite ὁ ἀδελφός depois de γνώσει.\f*\x - \xo 8:11 \xt ROM 14:1; ROM 14:13; MAT 18:6; 1CO 6:12; ROM 14:15; 1CO 10:28\x*
\v 12 \w Assim|strong="G3779"\w*, \w pecando|strong="G264"\w* \w contra os irmãos|strong="G1519,G3588,G80"\w* \w e|strong="G2532"\w* \w ferindo|strong="G5180"\w* \w a consciência|strong="G3588,G4893"\w* \w deles|strong="G846"\w* \w fraca|strong="G770"\w*, \w vocês pecam|strong="G264"\w* \w contra Cristo|strong="G1519,G5547"\w*.\x - \xo 8:12 \xt ROM 14:1; ROM 14:13; MAT 18:6; 1CO 6:12; ROM 14:15; MAT 18:15\x*
\v 13 \w Por isso|strong="G1355"\w*, \w se|strong="G1487"\w* \w a comida|strong="G1033"\w* \w faz cair|strong="G4624"\w* \w o meu irmão|strong="G3588,G80,G3165"\w*, \w jamais|strong="G3756,G3361"\w* \w comerei|strong="G5315"\w* \w carne|strong="G2907"\w* \w para sempre|strong="G1519,G3588,G165"\w*, \w para que|strong="G2443"\w* \w não|strong="G3361"\w* \w faça cair|strong="G4624"\w* \w o meu irmão|strong="G3588,G80,G3165"\w*.\x - \xo 8:13 \xt ROM 14:21; ROM 14:1; 1CO 9:27; LUK 17:1; ROM 14:13; MAT 18:6\x*
\c 9
\p
\v 1 \w Não sou|strong="G3756,G1510"\w* \w livre|strong="G1658"\w*? \w Não sou|strong="G3756,G1510"\w* \w apóstolo|strong="G652"\w*? \w Não vi|strong="G3780,G3708"\w* \w Jesus|strong="G2424"\w*, \w nosso Senhor|strong="G3588,G2962,G3165"\w*? \w Não são|strong="G3756,G1510"\w* \w vocês|strong="G4771"\w* \w a minha obra|strong="G3588,G2041,G3165"\w* \w no Senhor|strong="G1722,G2962"\w*?\f + \fr 9.1: \ft Variante: o RP traz a ordem ἀπόστολος οὐκ εἰμὶ ἐλεύθερος (“Não sou apóstolo? Não sou livre?”) e acrescenta Χριστόν depois de Ἰησοῦν.\f*\x - \xo 9:1 \xt 1CO 15:8; ROM 1:1; 1CO 3:6; 2CO 3:2; ACT 9:17; 1CO 9:19\x*
\v 2 \w Se|strong="G1487"\w* \w para outros|strong="G243"\w* \w não sou|strong="G3756,G1510"\w* \w apóstolo|strong="G652"\w*, \w mas|strong="G235"\w* \w certamente|strong="G1065"\w* \w para vocês|strong="G4771"\w* \w sou|strong="G1510"\w*; \w pois|strong="G1063"\w* \w o selo|strong="G3588,G4973"\w* \w do meu apostolado|strong="G3165,G3588,G651"\w*, \w vocês|strong="G4771"\w* \w são|strong="G1510"\w* \w no Senhor|strong="G1722,G2962"\w*.\x - \xo 9:2 \xt 2CO 3:2; 2CO 12:12; ACT 1:25; 1CO 3:10; 1CO 9:12; JHN 6:27\x*
\v 3 \w A minha|strong="G3588,G1473"\w* \w defesa|strong="G627"\w* \w para os que|strong="G3588"\w* \w me examinam|strong="G1473,G350"\w* \w é|strong="G1510"\w* \w esta|strong="G3778"\w*.\x - \xo 9:3 \xt 2CO 13:3; 1CO 14:37; 1CO 7:40\x*
\v 4 \w Acaso não|strong="G3361,G3756"\w* \w temos|strong="G2192"\w* \w o direito|strong="G1849"\w* \w de comer|strong="G5315"\w* \w e|strong="G2532"\w* \w beber|strong="G4095"\w*?\f + \fr 9.4: \ft Tradução: ἐξουσίαν (ἐξουσία, G1849) está aqui como “o direito”; o termo pode ser “autoridade”, “poder”, “direito” ou “liberdade de agir”, e o contexto decide.\f*\x - \xo 9:4 \xt LUK 12:29; ACT 9:9; JHN 6:53; MAT 6:31; 1CO 9:14; LUK 10:7\x*
\v 5 \w Acaso não|strong="G3361,G3756"\w* \w temos|strong="G2192"\w* \w o direito|strong="G1849"\w* \w de levar consigo|strong="G4013"\w* \w uma irmã|strong="G79"\w* \w como esposa|strong="G1135"\w*, \w como|strong="G5613"\w* \w também|strong="G2532"\w* \w os demais|strong="G3588,G3062"\w* \w apóstolos|strong="G652"\w* \w e|strong="G2532"\w* \w os irmãos|strong="G3588,G80"\w* \w do Senhor|strong="G3588,G2962"\w* \w e|strong="G2532"\w* \w Cefas|strong="G2786"\w*?\f + \fr 9.5: \ft Lit.: ἀδελφὴν γυναῖκα: “uma irmã como esposa”, isto é, uma esposa crente; ἐξουσία: “autoridade”, “direito”.\f*\x - \xo 9:5 \xt 1TI 5:17; HEB 13:4; JHN 1:42; LUK 10:7; MAT 19:12; 1CO 7:7\x*
\v 6 \w Ou|strong="G2228"\w* \w só|strong="G3441"\w* \w eu|strong="G1473"\w* \w e|strong="G2532"\w* \w Barnabé|strong="G921"\w* \w não temos|strong="G3756,G2192"\w* \w o direito|strong="G1849"\w* \w de não trabalhar|strong="G3361,G2038"\w*?\f + \fr 9.6: \ft Tradução: ἐξουσίαν (ἐξουσία, G1849) está aqui como “o direito”; o termo pode ser “autoridade”, “poder”, “direito” ou “liberdade de agir”, e o contexto decide.\f*\x - \xo 9:6 \xt 1TI 5:17; 2TH 3:7-9; LUK 10:7; ACT 13:1; 1TH 2:9; 2CO 12:13\x*
\v 7 \w Quem|strong="G5101"\w* \w serve como soldado|strong="G4754"\w* \w com recursos próprios|strong="G2398,G3800"\w* \w alguma vez|strong="G4218"\w*? \w Quem|strong="G5101"\w* \w planta|strong="G5452"\w* \w vinha|strong="G290"\w* \w e|strong="G2532"\w* \w não come|strong="G3756,G2068"\w* \w o fruto|strong="G3588,G2590"\w* \w dela|strong="G846"\w*? \w Quem|strong="G5101"\w* \w pastoreia|strong="G4165"\w* \w um rebanho|strong="G4167"\w* \w e|strong="G2532"\w* \w não se alimenta|strong="G3756,G2068"\w* \w do leite|strong="G1537,G3588,G1051"\w* \w do rebanho|strong="G3588,G4167"\w*?\f + \fr 9.7: \ft Lit.: ὀψώνιον: “soldo”, “provisão”.\f*\x - \xo 9:7 \xt 1TI 5:18; 2TI 2:6; 2CO 10:4; 1TI 5:17; PRO 27:18; LUK 10:7\x*
\v 8 \w Acaso|strong="G3361"\w* \w falo|strong="G2980"\w* \w estas coisas|strong="G3778"\w* \w segundo|strong="G2596"\w* \w o ser humano|strong="G444"\w*? \w Ou|strong="G2228"\w* \w a Lei|strong="G3588,G3551"\w* \w também|strong="G2532"\w* \w não diz|strong="G3756,G3004"\w* \w estas coisas|strong="G3778"\w*?\x - \xo 9:8 \xt 1TI 5:18; 2TI 2:6; 1TI 5:17; LUK 10:7; 1TH 5:13; 1CO 3:6\x*
\v 9 \w Pois|strong="G1063"\w* \w na Lei|strong="G1722,G3588,G3551"\w* \w de Moisés|strong="G3475"\w* \w está escrito|strong="G1125"\w*: “\w Não porá focinheira|strong="G3756,G5392"\w* \w no boi|strong="G1016"\w* \w que debulha|strong="G248"\w*.” \w Acaso|strong="G3361"\w* \w Deus|strong="G3588,G2316"\w* \w se preocupa|strong="G3199"\w* \w com os bois|strong="G3588,G1016"\w*?\f + \fr 9.9: \ft Nota cultural: cita Dt 25:4.\f*\x - \xo 9:9 \xt DEU 25:4; 1TI 5:18; GAL 6:6; ROM 15:4; 2TI 2:6; PRO 14:4\x*
\v 10 \w Ou|strong="G2228"\w* \w é certamente|strong="G3843"\w* \w por nossa causa|strong="G1223,G3165"\w* \w que ele diz|strong="G3004"\w*? \w Pois|strong="G1063"\w* \w por nossa causa|strong="G1223,G3165"\w* \w foi escrito|strong="G1125"\w*, \w porque|strong="G3754"\w* \w o que ara|strong="G3588,G722"\w* \w deve arar|strong="G3784,G722"\w* \w com esperança|strong="G1909,G1680"\w*, \w e|strong="G2532"\w* \w o que debulha|strong="G3588,G248"\w* \w com esperança|strong="G1909,G1680"\w* \w de participar|strong="G3588,G3348"\w*.\f + \fr 9.10: \ft Variante: o RP traz a ordem ἐπʼ ἐλπίδι ὀφείλει e τῆς ἐλπίδος αὐτοῦ μετέχειν ἐπʼ ἐλπίδι (“de participar da sua esperança, com esperança”).\f*\f + \fr 9.10: \ft Acréscimo: verbo ser/estar suprido em “é certamente”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:10 \xt 1TI 5:18; GAL 6:6; ROM 15:4; 2TI 2:6; DEU 25:4; PRO 14:4\x*
\v 11 \w Se|strong="G1487"\w* \w nós|strong="G3165"\w* \w semeamos|strong="G4687"\w* \w para vocês|strong="G4771"\w* \w as coisas espirituais|strong="G3588,G4152"\w*, \w é muito|strong="G3173"\w* \w se|strong="G1487"\w* \w nós|strong="G3165"\w* \w colhermos|strong="G2325"\w* \w de vocês|strong="G4771"\w* \w as coisas materiais|strong="G3588,G4559"\w*?\f + \fr 9.11: \ft Lit.: σαρκικά: “carnais”, aqui “materiais”.\f*\f + \fr 9.11: \ft Acréscimo: verbo ser/estar suprido em “é muito”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:11 \xt ROM 15:27; GAL 6:7; 2CO 9:6; GAL 6:6; 2TI 2:6; PRO 14:4\x*
