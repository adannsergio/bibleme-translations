\v 7 \w Nem|strong="G3366"\w* \w se tornem|strong="G1096"\w* \w idólatras|strong="G1496"\w*, \w como|strong="G2531"\w* \w alguns|strong="G5100"\w* \w deles|strong="G846"\w*; \w conforme|strong="G5618"\w* \w está escrito|strong="G1125"\w*: “\w O povo|strong="G3588,G2992"\w* \w sentou-se|strong="G2523"\w* \w para comer|strong="G5315"\w* \w e|strong="G2532"\w* \w beber|strong="G4095"\w*, \w e|strong="G2532"\w* \w se levantaram|strong="G450"\w* \w para se divertir|strong="G3815"\w*.”\f + \fr 10.7: \ft Nota cultural: cita Êx 32:6.\f*\f + \fr 10.7: \ft Lit.: παίζω: “brincar”, “divertir-se”, aqui com sentido de festejo cultual e, possivelmente, sexual.\f*\x - \xo 10:7 \xt EXO 32:6; JUD 1:5; 1JN 5:21; PSA 106:19; 1CO 6:9; DEU 9:12\x*
