\v 20 \w E|strong="G2532"\w* \w fui|strong="G1096"\w* \w para os judeus|strong="G3588,G2453"\w* \w como judeu|strong="G5613,G2453"\w*, \w para que|strong="G2443"\w* \w ganhe|strong="G2770"\w* \w judeus|strong="G2453"\w*; \w para os que estão|strong="G3588,G5259"\w* \w sob a lei|strong="G3551"\w*, \w como|strong="G5613"\w* \w sob a lei|strong="G5259,G3551"\w*, \w não estando|strong="G3361,G1510"\w* \w eu mesmo|strong="G846"\w* \w sob a lei|strong="G5259,G3551"\w*, \w para que|strong="G2443"\w* \w ganhe|strong="G2770"\w* \w os que estão|strong="G3588,G5259"\w* \w sob a lei|strong="G3551"\w*;\f + \fr 9.20: \ft Variante: o RP omite μὴ ὢν αὐτὸς ὑπὸ νόμον (“não estando eu mesmo sob a lei”).\f*\f + \fr 9.20: \ft Acréscimo: verbo ser/estar suprido em “para os que estão”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula; “os que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 9:20 \xt GAL 5:18; GAL 4:21; ROM 6:15; ROM 6:14; ACT 16:3; 1CO 10:24\x*
\v 21 \w para os sem lei|strong="G3588,G459"\w*, \w como|strong="G5613"\w* \w sem lei|strong="G459"\w*, \w não estando|strong="G3361,G1510"\w* \w sem lei|strong="G459"\w* \w para com Deus|strong="G2316"\w*, \w mas|strong="G235"\w* \w dentro da lei|strong="G1772"\w* \w de Cristo|strong="G5547"\w*, \w para que|strong="G2443"\w* \w ganhe|strong="G2770"\w* \w os sem lei|strong="G3588,G459"\w*;\f + \fr 9.21: \ft Lit.: ἄνομος θεοῦ / ἔννομος Χριστοῦ: “sem lei de Deus” / “em lei de Cristo”, isto é, “sem lei diante de Deus” / “dentro da lei de Cristo”.\f*\x - \xo 9:21 \xt GAL 6:2; ROM 2:12; 1CO 10:24; PRO 11:30; GAL 3:2; MRK 10:43\x*
\v 22 \w fui|strong="G1096"\w* \w para os fracos|strong="G3588,G772"\w* \w fraco|strong="G772"\w*, \w para que|strong="G2443"\w* \w ganhe|strong="G2770"\w* \w os fracos|strong="G3588,G772"\w*; \w para todos|strong="G3588,G3956"\w* \w me tornei|strong="G1096"\w* \w tudo|strong="G3956"\w*, \w para que|strong="G2443"\w* \w de todo modo|strong="G3843"\w* \w salve|strong="G4982"\w* \w alguns|strong="G5100"\w*.\f + \fr 9.22: \ft Variante: o RP acrescenta ὡς (“como”) depois de ἀσθενέσιν e τά depois de γέγονα.\f*\x - \xo 9:22 \xt ROM 15:1; ROM 14:1; 1CO 10:33; 1CO 9:19; 1CO 10:24; PRO 11:30\x*
\v 23 \w Tudo|strong="G3956"\w* \w faço|strong="G4160"\w* \w por causa da boa notícia|strong="G1223,G3588,G2098"\w*, \w para que|strong="G2443"\w* \w me torne|strong="G1096"\w* \w coparticipante|strong="G4791"\w* \w dela|strong="G846"\w*.\f + \fr 9.23: \ft Variante: o RP traz Τοῦτο (“isto”) em lugar de πάντα (“tudo”).\f*\x - \xo 9:23 \xt PHP 1:7; MRK 8:35; MRK 10:29; 1CO 10:24; PRO 11:30; 2TI 2:10\x*
\v 24 \w Não sabem|strong="G3756,G6063"\w* \w que|strong="G3754"\w* \w os que correm|strong="G3588,G5143"\w* \w no estádio|strong="G1722,G4712"\w* \w todos|strong="G3956"\w* \w correm|strong="G5143"\w*, \w mas|strong="G1161"\w* \w um só|strong="G1520"\w* \w recebe|strong="G2983"\w* \w o prêmio|strong="G3588,G1017"\w*? \w Assim|strong="G3779"\w* \w corram|strong="G5143"\w*, \w para que|strong="G2443"\w* \add o\add* \w alcancem|strong="G2638"\w*.\f + \fr 9.24: \ft Acréscimo: “o” (em “para que o alcancem”): preposição ou artigo que a regência do português exige.\f*\x - \xo 9:24 \xt HEB 12:1; PHP 3:14; 2TI 4:7; PHP 3:13; REV 3:11; PHP 2:16\x*
\v 25 \w Todo|strong="G3956"\w* \w aquele que compete|strong="G3588,G75"\w*, \w porém|strong="G1161"\w*, \w se controla|strong="G1467"\w* \w em tudo|strong="G3956"\w*; \w aqueles|strong="G1565"\w* \w de fato|strong="G3303,G3767"\w*, \w para que|strong="G2443"\w* \w recebam|strong="G2983"\w* \w uma coroa|strong="G4735"\w* \w perecível|strong="G5349"\w*, \w mas nós|strong="G3165,G1161"\w* \w uma imperecível|strong="G862"\w*.\x - \xo 9:25 \xt HEB 12:1; 2TI 4:7; EPH 6:12; JAS 1:12; PHP 3:13; 1CO 9:27\x*
\v 26 \w Eu|strong="G1473"\w*, \w portanto|strong="G5106"\w*, \w corro|strong="G5143"\w* \w assim|strong="G3779"\w* \w como quem não corre|strong="G5613,G3756"\w* \w sem rumo certo|strong="G84"\w*; \w assim|strong="G3779"\w* \w boxeio|strong="G4438"\w* \w como quem não|strong="G5613,G3756"\w* \w golpeia|strong="G1194"\w* \w o ar|strong="G109"\w*;\f + \fr 9.26: \ft Lit.: πυκτεύω: “lutar boxe”; ἀδήλως: “sem rumo certo”, “de modo incerto”.\f*\x - \xo 9:26 \xt HEB 12:1; 1CO 14:9; 2TI 4:7; EPH 6:12; PHP 3:13; 1TI 6:12\x*
