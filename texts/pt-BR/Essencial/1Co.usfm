\v 1 \w Paulo|strong="G3972"\w*, \w chamado|strong="G2822"\w* \w apóstolo|strong="G652"\w* \w de Cristo|strong="G5547"\w* \w Jesus|strong="G2424"\w* \w pela vontade|strong="G1223,G2307"\w* \w de Deus|strong="G2316"\w*, \w e|strong="G2532"\w* \w Sóstenes|strong="G4988"\w*, \w o irmão|strong="G3588,G80"\w*,\x - \xo 1:1 \xt ROM 1:1; COL 1:1; EPH 1:1; 2TI 1:1; GAL 1:1; 2CO 1:1\x*
\v 2 \w à comunidade|strong="G3588,G1577"\w* \w de Deus|strong="G3588,G2316"\w* \w que está|strong="G3588,G1510"\w* \w em Corinto|strong="G1722,G2882"\w*, \w santificados|strong="G37"\w* \w em Cristo|strong="G1722,G5547"\w* \w Jesus|strong="G2424"\w*, \w chamados|strong="G2822"\w* \w santos|strong="G40"\w*, \w junto com|strong="G4862"\w* \w todos os que|strong="G3956,G3588"\w* \w invocam|strong="G1941"\w* \w o nome|strong="G3588,G3686"\w* \w do nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus|strong="G2424"\w* \w Cristo|strong="G5547"\w* \w em todo|strong="G1722,G3956"\w* \w lugar|strong="G5117"\w*, \w deles|strong="G846"\w* \w e|strong="G2532"\w* \w nosso|strong="G3165"\w*:\f + \fr 1.2: \ft Lit.: αὐτῶν καὶ ἡμῶν, “deles e nosso”, pode ligar-se a “lugar” (em todo lugar, deles e nosso) ou a “Senhor”.\f*\x - \xo 1:2 \xt ACT 2:21; 2CO 1:1; JER 33:3; 2TI 2:19; 1CO 1:30; 1CO 6:11\x*
\v 3 \w Graça a vocês|strong="G5485,G4771"\w* \w e|strong="G2532"\w* \w paz|strong="G1515"\w* \w da parte de|strong="G575"\w* \w Deus|strong="G2316"\w* \w nosso Pai|strong="G3962,G3165"\w* \w e|strong="G2532"\w* \w do Senhor|strong="G2962"\w* \w Jesus|strong="G2424"\w* \w Cristo|strong="G5547"\w*.\x - \xo 1:3 \xt 2CO 1:2; EPH 1:2; 2TH 1:2; GAL 1:3; PHP 1:2; PHM 1:3\x*
\v 4 \w Dou graças|strong="G2168"\w* \w ao meu Deus|strong="G3588,G2316,G3165"\w* \w sempre|strong="G3842"\w* \w por vocês|strong="G4012,G4771"\w*, \w pela graça|strong="G1909,G3588,G5485"\w* \w de Deus|strong="G3588,G2316"\w* \w que lhes foi dada|strong="G3588,G1325,G4771"\w* \w em Cristo|strong="G1722,G5547"\w* \w Jesus|strong="G2424"\w*,\x - \xo 1:4 \xt COL 1:3; EPH 5:20; 1TH 1:2; PHM 1:4; PHP 1:3; JHN 1:16\x*
\v 5 \w porque|strong="G3754"\w* \w em tudo|strong="G1722,G3956"\w* \w foram enriquecidos|strong="G4148"\w* \w nele|strong="G1722,G846"\w*, \w em toda palavra|strong="G1722,G3956,G3056"\w* \w e|strong="G2532"\w* \w em todo conhecimento|strong="G3956,G1108"\w*,\x - \xo 1:5 \xt 2CO 9:11; 2CO 8:7; COL 2:3; JHN 1:16; PHP 1:9; ROM 12:6\x*
\v 6 \w assim como|strong="G2531"\w* \w o testemunho|strong="G3588,G3142"\w* \w de Cristo|strong="G3588,G5547"\w* \w foi confirmado|strong="G950"\w* \w entre vocês|strong="G1722,G4771"\w*,\x - \xo 1:6 \xt REV 1:2; ROM 12:6; 2TI 1:8; 1TI 2:6; 1CO 2:1; 2CO 12:12\x*
\v 7 \w de modo que|strong="G5620"\w* \w vocês|strong="G4771"\w* \w não ficam em falta|strong="G3361,G5302"\w* \w de nenhum|strong="G1722,G3367"\w* \w dom|strong="G5486"\w*, \w enquanto aguardam|strong="G553"\w* \w a revelação|strong="G3588,G602"\w* \w do nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus|strong="G2424"\w* \w Cristo|strong="G5547"\w*;\x - \xo 1:7 \xt ROM 8:19; TIT 2:13; 1PE 1:13; HEB 12:2; PHP 3:20; 2PE 3:12\x*
\v 8 \w o qual|strong="G3739"\w* \w também|strong="G2532"\w* \w os confirmará|strong="G950,G4771"\w* \w até o fim|strong="G2193,G5056"\w*, \w irrepreensíveis|strong="G410"\w* \w no dia|strong="G1722,G3588,G2250"\w* \w do nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus|strong="G2424"\w* \w Cristo|strong="G5547"\w*.\x - \xo 1:8 \xt PHP 1:6; 1TH 5:23; 1TH 3:13; COL 1:22; JUD 1:24-25; MAT 24:13\x*
\v 9 \w Fiel|strong="G4103"\w* \w é Deus|strong="G3588,G2316"\w*, \w por meio de quem|strong="G1223,G3739"\w* \w foram chamados|strong="G2564"\w* \w para a comunhão|strong="G1519,G2842"\w* \w do seu Filho|strong="G3588,G5207,G846"\w* \w Jesus|strong="G2424"\w* \w Cristo|strong="G5547"\w*, \w nosso Senhor|strong="G3588,G2962,G3165"\w*.\f + \fr 1.9: \ft Lit.: κοινωνία: “comunhão”, “participação”.\f*\f + \fr 1.9: \ft Acréscimo: verbo ser/estar suprido em “é Deus”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:9 \xt 1TH 5:24; ROM 8:28; HEB 10:23; 2TH 3:3; 1TH 5:23; DEU 7:9\x*
\p
\v 10 \w Exorto|strong="G3870"\w* \w vocês|strong="G4771"\w*, \w irmãos e irmãs|strong="G80"\w*, \w pelo nome|strong="G1223,G3588,G3686"\w* \w do nosso Senhor|strong="G3588,G2962,G3165"\w* \w Jesus|strong="G2424"\w* \w Cristo|strong="G5547"\w*, \w para que|strong="G2443"\w* \w digam|strong="G3004"\w* \w todos|strong="G3956"\w* \w a mesma coisa|strong="G3588,G846"\w*, \w e|strong="G2532"\w* \w que não haja|strong="G3361,G1510"\w* \w entre vocês|strong="G1722,G4771"\w* \w divisões|strong="G4978"\w*, \w mas sejam|strong="G1510,G1161"\w* \w bem ajustados|strong="G2675"\w* \w na mesma|strong="G1722,G3588,G846"\w* \w mente|strong="G3563"\w* \w e|strong="G2532"\w* \w no mesmo|strong="G1722,G3588,G846"\w* \w parecer|strong="G1106"\w*\f + \fr 1.10: \ft Lit.: σχίσμα: “divisão”, literalmente “rasgão”; κατηρτισμένοι: “restaurados”, “bem ajustados”; γνώμη: “parecer”, “opinião”, “propósito”.\f*.\x - \xo 1:10 \xt PSA 133:1; PHP 2:1-4; EPH 4:1-7; 1CO 12:25; ACT 4:32; ROM 12:16\x*
\v 11 \w Pois|strong="G1063"\w* \w me foi informado|strong="G1213,G3165"\w* \w a respeito de vocês|strong="G4012,G4771"\w*, \w meus irmãos e irmãs|strong="G80,G3165"\w*, \w pelos de|strong="G5259,G3588"\w* \w Cloé|strong="G5514"\w*, \w que|strong="G3754"\w* \w há|strong="G1510"\w* \w rivalidades|strong="G2054"\w* \w entre vocês|strong="G1722,G4771"\w*.\x - \xo 1:11 \xt 1CO 12:25; ROM 16:17; PHP 2:14; 1CO 3:3; 1CO 11:18; 2CO 12:20\x*
\v 12 \w Quero dizer|strong="G3004,G1161"\w* \w isto|strong="G3778"\w*: \w que|strong="G3754"\w* \w cada um|strong="G1538"\w* \w de vocês|strong="G4771"\w* \w diz|strong="G3004"\w*: “\w Eu|strong="G1473"\w* \w sou|strong="G1510"\w* \w de Paulo|strong="G3972"\w*”; “\w e eu|strong="G1473,G1161"\w* \w de Apolo|strong="G625"\w*”; “\w e eu|strong="G1473,G1161"\w* \w de Cefas|strong="G2786"\w*”; “\w e eu|strong="G1473,G1161"\w* \w de Cristo|strong="G5547"\w*”.\x - \xo 1:12 \xt 1CO 3:4; 1CO 3:22; 1CO 3:5; ACT 19:1; 1CO 12:25; ROM 16:17\x*
\v 13 \w Foi dividido|strong="G3307"\w* \w o Cristo|strong="G3588,G5547"\w*? \w Acaso|strong="G3361"\w* \w Paulo|strong="G3972"\w* \w foi crucificado|strong="G4717"\w* \w em favor|strong="G5228"\w* \w de vocês|strong="G4771"\w*, \w ou|strong="G2228"\w* \w foram batizados|strong="G907"\w* \w em nome|strong="G1519,G3588,G3686"\w* \w de Paulo|strong="G3972"\w*?\f + \fr 1.13: \ft Lit.: βαπτίζω εἰς τὸ ὄνομα: “batizar para o nome de”, “em nome de”, indicando pertença; μεμέρισται: “foi repartido”, “foi dividido”.\f*\x - \xo 1:13 \xt ACT 19:5; 1CO 1:15; MAT 28:19; ACT 2:38; EPH 4:5; ROM 16:17\x*
\v 14 \w Dou graças|strong="G2168"\w* \w de que|strong="G3754"\w* \w a nenhum|strong="G3762"\w* \w de vocês|strong="G4771"\w* \w batizei|strong="G907"\w*, \w a não ser|strong="G1487,G3361"\w* \w Crispo|strong="G2921"\w* \w e|strong="G2532"\w* \w Gaio|strong="G1050"\w*,\x - \xo 1:14 \xt ACT 18:8; MAT 28:19; ACT 2:38; 3JN 1:1; JHN 4:2; ROM 16:23\x*
\v 15 \w para que|strong="G2443"\w* \w ninguém|strong="G3361,G5100"\w* \w diga|strong="G2036"\w* \w que|strong="G3754"\w* \w foram batizados|strong="G907"\w* \w em meu|strong="G1519,G3588,G1473"\w* \w nome|strong="G3686"\w*.\f + \fr 1.15: \ft Variante: o RP traz ἐβάπτισα (“eu batizei”) em lugar de ἐβαπτίσθητε (“foram batizados”).\f*\x - \xo 1:15 \xt ACT 19:5; MAT 28:19; ACT 2:38; 1CO 1:13; ACT 10:48; ACT 8:16\x*
\v 16 \w Batizei|strong="G907"\w* \w também|strong="G2532"\w* \w a casa|strong="G3588,G3624"\w* \w de Estéfanas|strong="G4734"\w*; \w quanto ao resto|strong="G3063"\w*, \w não sei|strong="G3756,G6063"\w* \w se|strong="G1487"\w* \w batizei|strong="G907"\w* \w algum|strong="G5100"\w* \w outro|strong="G243"\w*.\x - \xo 1:16 \xt MAT 28:19; ACT 2:38; JHN 4:2; 1CO 16:15; ACT 16:33; ACT 18:8\x*
\v 17 \w Pois|strong="G1063"\w* \w Cristo|strong="G5547"\w* \w não me enviou|strong="G3756,G649,G3165"\w* \w para batizar|strong="G907"\w*, \w mas|strong="G235"\w* \w para anunciar a boa notícia|strong="G2097"\w*, \w não com|strong="G3756,G1722"\w* \w sabedoria|strong="G4678"\w* \w de palavra|strong="G3056"\w*, \w para que|strong="G2443"\w* \w não seja esvaziada|strong="G3361,G2758"\w* \w a cruz|strong="G3588,G4716"\w* \w de Cristo|strong="G3588,G5547"\w*.\f + \fr 1.17: \ft Lit.: σοφία λόγου: “sabedoria de palavra”, isto é, sabedoria de discurso, eloquência.\f*\x - \xo 1:17 \xt 1CO 2:4; 1CO 2:1; ACT 2:38; 1CO 2:13; 2PE 1:16; 1CO 2:5\x*
\v 18 \w Pois|strong="G1063"\w* \w a mensagem|strong="G3588,G3056"\w* \w da cruz|strong="G3588,G4716"\w* \w é|strong="G1510"\w* \w loucura|strong="G3472"\w* \w para os que|strong="G3588,G3303"\w* \w estão perecendo|strong="G622"\w*, \w mas|strong="G1161"\w* \w para os que|strong="G3588"\w* \w estão sendo salvos|strong="G4982"\w*, \w para nós|strong="G3165"\w*, \w é|strong="G1510"\w* \w poder|strong="G1411"\w* \w de Deus|strong="G2316"\w*.\f + \fr 1.18: \ft Lit.: λόγος: “palavra”, “mensagem”.\f*\x - \xo 1:18 \xt 1CO 1:23; 1CO 1:21; 2CO 2:15; 1CO 2:14; MAT 18:11; ROM 1:16\x*
\v 19 \w Pois|strong="G1063"\w* \w está escrito|strong="G1125"\w*: “\w Destruirei|strong="G622"\w* \w a sabedoria|strong="G3588,G4678"\w* \w dos sábios|strong="G3588,G4680"\w*, \w e|strong="G2532"\w* \w o entendimento|strong="G3588,G4907"\w* \w dos entendidos|strong="G3588,G4908"\w* \w rejeitarei|strong="G114"\w*.”\f + \fr 1.19: \ft Nota cultural: cita Is 29:14 (LXX).\f*\x - \xo 1:19 \xt ISA 29:14; 1CO 3:19; MAT 11:25; 2CO 10:5; JER 8:9; ROM 1:16\x*
\v 20 \w Onde está|strong="G4226"\w* \w o sábio|strong="G4680"\w*? \w Onde está|strong="G4226"\w* \w o escriba|strong="G1122"\w*? \w Onde está|strong="G4226"\w* \w o debatedor|strong="G4804"\w* \w desta era|strong="G3588,G165,G3778"\w*? \w Acaso não|strong="G3780"\w* \w Deus|strong="G3588,G2316"\w* \w tornou louca|strong="G3471"\w* \w a sabedoria|strong="G3588,G4678"\w* \w do mundo|strong="G3588,G2889"\w*?\f + \fr 1.20: \ft Nota cultural: ecoa Is 33:18 e Is 19:12 (LXX).\f*\f + \fr 1.20: \ft Lit.: συζητητής: “debatedor”, “pesquisador”.\f*\f + \fr 1.20: \ft Acréscimo: “Onde está”, “Onde está”, “Onde está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 1:20 \xt ISA 19:12; ISA 33:18; ROM 1:22; 1CO 3:19; 1CO 1:27; ROM 1:16\x*
\v 21 \w Pois|strong="G1063"\w* \w já que|strong="G1894"\w* \w na sabedoria|strong="G1722,G3588,G4678"\w* \w de Deus|strong="G3588,G2316"\w* \w o mundo|strong="G3588,G2889"\w* \w não conheceu|strong="G3756,G1097"\w* \w a Deus|strong="G3588,G2316"\w* \w por meio da sabedoria|strong="G1223,G3588,G4678"\w*, \w agradou|strong="G2106"\w* \w a Deus|strong="G3588,G2316"\w* \w salvar|strong="G4982"\w* \w os que creem|strong="G3588,G4100"\w* \w por meio da loucura|strong="G1223,G3588,G3472"\w* \w da proclamação|strong="G3588,G2782"\w*.\x - \xo 1:21 \xt 1CO 1:18; JHN 1:10; ROM 1:16; ROM 10:17; 1CO 3:18; JER 9:23\x*
\v 22 \w Já que|strong="G1894"\w* \w também|strong="G2532"\w* \w judeus|strong="G2453"\w* \w pedem|strong="G154"\w* \w sinais|strong="G4592"\w* \w e|strong="G2532"\w* \w gregos|strong="G1672"\w* \w buscam|strong="G2212"\w* \w sabedoria|strong="G4678"\w*,\f + \fr 1.22: \ft Variante: o RP traz σημεῖον (singular, “um sinal”) em lugar de σημεῖα.\f*\x - \xo 1:22 \xt JHN 2:18; ROM 1:16; ROM 10:17; 1CO 2:2; MAT 11:25; 2CO 10:4\x*
\v 23 \w nós|strong="G3165"\w*, \w porém|strong="G1161"\w*, \w proclamamos|strong="G2784"\w* \w Cristo|strong="G5547"\w* \w crucificado|strong="G4717"\w*: \w para judeus|strong="G2453,G3303"\w* \w escândalo|strong="G4625"\w*, \w mas para gentios|strong="G1484,G1161"\w* \w loucura|strong="G3472"\w*,\f + \fr 1.23: \ft Lit.: σκάνδαλον: “o que faz cair”, “causa de queda”, “escândalo”.\f*\f + \fr 1.23: \ft Variante: o RP traz Ἕλλησιν (“para gregos”) em lugar de ἔθνεσιν (“para gentios”).\f*\x - \xo 1:23 \xt 1CO 1:18; GAL 5:11; ROM 1:16; ROM 10:17; 1CO 2:2; 1PE 2:8\x*
\v 24 \w mas|strong="G1161"\w* \w para os próprios|strong="G846"\w* \w chamados|strong="G3588,G2822"\w*, \w tanto judeus|strong="G2453,G5037"\w* \w quanto gregos|strong="G2532,G1672"\w*, \w Cristo|strong="G5547"\w*: \w poder|strong="G1411"\w* \w de Deus|strong="G2316"\w* \w e|strong="G2532"\w* \w sabedoria|strong="G4678"\w* \w de Deus|strong="G2316"\w*.\x - \xo 1:24 \xt ROM 1:16; ACT 19:10; ACT 14:1; 1CO 1:18; 1CO 4:20; COL 2:3\x*
\v 25 \w Porque|strong="G3754"\w* \w o que é loucura|strong="G3588,G3474"\w* \w de Deus|strong="G3588,G2316"\w* \w é mais sábio|strong="G4680,G1510"\w* \w que os seres humanos|strong="G3588,G444"\w*, \w e|strong="G2532"\w* \w o que é fraqueza|strong="G3588,G772"\w* \w de Deus|strong="G3588,G2316"\w* \w é mais forte|strong="G2478"\w* \w que os seres humanos|strong="G3588,G444"\w*.\f + \fr 1.25: \ft Acréscimo: verbo ser/estar suprido em “o que é loucura”, “o que é fraqueza”, “é mais forte”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:25 \xt 1CO 1:27; 1CO 4:10; 1CO 1:18; 1CO 2:2; MAT 11:25; ACT 5:39\x*
\v 26 \w Vejam|strong="G991"\w*, \w pois|strong="G1063"\w*, \w o chamado|strong="G3588,G2821"\w* \w de vocês|strong="G4771"\w*, \w irmãos e irmãs|strong="G80"\w*: \w que|strong="G3754"\w* \w não muitos|strong="G3756,G4183"\w* \w são sábios|strong="G4680"\w* \w segundo a carne|strong="G2596,G4561"\w*, \w não muitos|strong="G3756,G4183"\w* \w poderosos|strong="G1415"\w*, \w não muitos|strong="G3756,G4183"\w* \w de família nobre|strong="G2104"\w*.\f + \fr 1.26: \ft Acréscimo: verbo ser/estar suprido em “são sábios”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:26 \xt JAS 2:5; MAT 11:25; 1CO 3:18-20; LUK 1:48; ROM 9:16; 1CO 2:8\x*
\v 27 \w Mas|strong="G235"\w* \w as coisas loucas|strong="G3588,G3474"\w* \w do mundo|strong="G3588,G2889"\w* \w Deus escolheu|strong="G1586,G3588,G2316"\w*, \w para que|strong="G2443"\w* \w envergonhasse|strong="G2617"\w* \w os sábios|strong="G3588,G4680"\w*, \w e|strong="G2532"\w* \w as coisas fracas|strong="G3588,G772"\w* \w do mundo|strong="G3588,G2889"\w* \w Deus escolheu|strong="G1586,G3588,G2316"\w*, \w para que|strong="G2443"\w* \w envergonhasse|strong="G2617"\w* \w as coisas fortes|strong="G3588,G2478"\w*,\x - \xo 1:27 \xt 1CO 1:25; JER 9:23; JAS 2:5; MAT 11:25; 1CO 1:20; ACT 4:13\x*
\v 28 \w e|strong="G2532"\w* \w as coisas de origem humilde|strong="G3588,G36"\w* \w do mundo|strong="G3588,G2889"\w* \w e|strong="G2532"\w* \w as desprezadas|strong="G3588,G1848"\w* \w Deus escolheu|strong="G1586,G3588,G2316"\w*, \w as que não são|strong="G3588,G3361,G1510"\w*, \w para que|strong="G2443"\w* \w as que são|strong="G3588,G1510"\w* \w anulasse|strong="G2673"\w*,\f + \fr 1.28: \ft Lit.: ἀγενής: “sem nobreza”, “de origem humilde”; καταργέω: “anular”, “tornar inoperante”, “reduzir a nada”.\f*\x - \xo 1:28 \xt JER 9:23; ROM 4:17; ZEC 4:10; 2CO 4:7; 2CO 10:5; JAS 2:5\x*
\v 29 \w para que|strong="G3704"\w* \w nenhuma|strong="G3361,G3956"\w* \w carne|strong="G4561"\w* \w se glorie|strong="G2744"\w* \w diante de Deus|strong="G1799,G3588,G2316"\w*.\f + \fr 1.29: \ft Variante: diferença entre as edições, conforme o TAGNT: τοῦ θεοῦ consta do SBLGNT e não consta no TR.\f*\f + \fr 1.29: \ft Lit.: καυχάομαι e família (καύχημα, καύχησις): “gloriar-se”; também “orgulhar-se”, “vangloriar-se”, “gabar-se” e “alegrar-se com confiança”. O sentido vai do positivo (confiança, motivo de alegria) ao negativo (jactância), conforme o contexto.\f*\x - \xo 1:29 \xt PHP 3:3; 2CO 11:18; JER 9:23; ZEC 4:10; 2CO 10:5; EPH 2:9\x*
\v 30 \w Mas|strong="G1161"\w* \w dele|strong="G1537,G846"\w* \w vocês|strong="G4771"\w* \w estão|strong="G1510"\w* \w em Cristo|strong="G1722,G5547"\w* \w Jesus|strong="G2424"\w*, \w o qual|strong="G3739"\w* \w se tornou|strong="G1096"\w* \w para nós|strong="G3165"\w* \w sabedoria|strong="G4678"\w* \w da parte de Deus|strong="G575,G2316"\w*, \w justiça|strong="G1343"\w* \w e|strong="G5037,G2532"\w* \w santificação|strong="G38"\w* \w e|strong="G2532"\w* \w redenção|strong="G629"\w*,\f + \fr 1.30: \ft Lit.: ἀπολύτρωσις: “redenção”, “libertação mediante resgate”.\f*\x - \xo 1:30 \xt 2CO 5:17; ROM 8:1; MAT 6:33; 2CO 5:21; ISA 45:17; EPH 1:7\x*
\v 31 \w para que|strong="G2443"\w*, \w como|strong="G2531"\w* \w está escrito|strong="G1125"\w*: “\w Quem se gloria|strong="G3588,G2744"\w*, \w que se glorie|strong="G2744"\w* \w no Senhor|strong="G1722,G2962"\w*.”\f + \fr 1.31: \ft Nota cultural: cita de forma resumida Jr 9:23-24 (cf. 1Sm 2:10 na LXX).\f*\x - \xo 1:31 \xt JER 9:23-24; 1SA 2:10; ISA 45:17; JER 9:24; COL 2:10; 2CO 10:17\x*
\c 2
\p
\v 1 \w E eu|strong="G2532,G1473"\w*, \w quando cheguei|strong="G2064"\w* \w até vocês|strong="G4314,G4771"\w*, \w irmãos e irmãs|strong="G80"\w*, \w não vim|strong="G2064,G3756"\w* \w com superioridade|strong="G2596,G5247"\w* \w de palavra|strong="G3056"\w* \w ou de sabedoria|strong="G2228,G4678"\w*, \w anunciando|strong="G2605"\w* \w a vocês|strong="G4771"\w* \w o testemunho|strong="G3588,G3142"\w* \w de Deus|strong="G3588,G2316"\w*\f + \fr 2.1: \ft Variante: o SBLGNT, com Treg, o RP e a NIV, traz μαρτύριον (“testemunho”); WH e NA28 trazem μυστήριον (“mistério”).\f*.\x - \xo 2:1 \xt 1CO 2:4; 1CO 1:17; 1CO 2:13; 2TI 4:3; 1CO 1:6; EXO 4:10\x*
\v 2 \w Pois|strong="G1063"\w* \w não decidi|strong="G3756,G2919"\w* \w saber|strong="G6063"\w* \w coisa alguma|strong="G5100"\w* \w entre vocês|strong="G1722,G4771"\w* \w a não ser|strong="G1487,G3361"\w* \w Jesus|strong="G2424"\w* \w Cristo|strong="G5547"\w*, \w e|strong="G2532"\w* \w este|strong="G3778"\w* \w crucificado|strong="G4717"\w*;\f + \fr 2.2: \ft Tradução: ἔκρινά (κρίνω, G2919) está aqui como “não decidi”; o termo pode ser “julgar”, “decidir”, “condenar” ou “considerar”, e o contexto decide.\f*\x - \xo 2:2 \xt GAL 6:14; ROM 1:16; 1CO 1:22-25; PHP 3:8; JHN 17:3; GAL 3:1\x*
\v 3 \w e eu|strong="G2532_A,G1473"\w* \w estive|strong="G1096"\w* \w entre vocês|strong="G4314,G4771"\w* \w em fraqueza|strong="G1722,G769"\w* \w e|strong="G2532"\w* \w em temor|strong="G1722,G5401"\w* \w e|strong="G2532"\w* \w em muito|strong="G1722,G4183"\w* \w tremor|strong="G5156"\w*,\x - \xo 2:3 \xt PHP 2:12; 2CO 4:7; 1CO 4:10; 1TH 1:5; 2CO 13:4; GAL 4:13\x*
\v 4 \w e|strong="G2532"\w* \w a minha|strong="G3588,G3165"\w* \w palavra|strong="G3056"\w* \w e|strong="G2532"\w* \w a minha|strong="G3588,G3165"\w* \w proclamação|strong="G2782"\w* \w não foram|strong="G3756"\w* \w em persuasão|strong="G1722,G3981"\w* \w de sabedoria|strong="G4678"\w*, \w mas|strong="G235"\w* \w em demonstração|strong="G1722,G585"\w* \w do Espírito|strong="G4151"\w* \w e|strong="G2532"\w* \w de poder|strong="G1411"\w*,\f + \fr 2.4: \ft Variante: o SBLGNT traz πειθοῖ σοφίας (leitura atribuída a Holmes); WH, Treg e NA28 trazem πειθοῖς σοφίας λόγοις (“em palavras persuasivas de sabedoria”); o RP traz πειθοῖς ἀνθρωπίνης σοφίας λόγοις (“em palavras persuasivas da sabedoria humana”).\f*\f + \fr 2.4: \ft Acréscimo: verbo ser/estar suprido em “não foram”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 2:4 \xt ZEC 4:6; 2TI 1:7; 1CO 4:20; 1TH 1:5; 1CO 1:17; ROM 1:16\x*
\v 5 \w para que|strong="G2443"\w* \w a fé|strong="G3588,G4102"\w* \w de vocês|strong="G4771"\w* \w não esteja|strong="G3361,G1510"\w* \w na sabedoria|strong="G1722,G4678"\w* \w dos seres humanos|strong="G444"\w*, \w mas|strong="G235"\w* \w no poder|strong="G1722,G1411"\w* \w de Deus|strong="G2316"\w*.\x - \xo 2:5 \xt ZEC 4:6; 2CO 12:9; 2CO 10:4; 2CO 4:7; MRK 16:20; 2CO 6:7\x*
\p
\v 6 \w Falamos|strong="G2980"\w* \w sabedoria|strong="G4678"\w* \w entre os maduros|strong="G1722,G3588,G5046"\w*, \w mas|strong="G1161"\w* \w sabedoria|strong="G4678"\w* \w não|strong="G3756"\w* \w desta era|strong="G3588,G165,G3778"\w* \w nem|strong="G3761"\w* \w dos governantes|strong="G3588,G758"\w* \w desta era|strong="G3588,G165,G3778"\w*, \w dos que estão sendo anulados|strong="G3588,G2673"\w*;\f + \fr 2.6: \ft Lit.: τέλειος: “maduro”, “perfeito”, “completo”.\f*\x - \xo 2:6 \xt COL 1:28; 1CO 2:8; 1CO 13:10; 2TI 2:15; JAS 3:17; JER 3:15\x*
\v 7 \w mas|strong="G235"\w* \w falamos|strong="G2980"\w* \w sabedoria|strong="G4678"\w* \w de Deus|strong="G2316"\w* \w em mistério|strong="G1722,G3466"\w*, \w a que estava oculta|strong="G3588,G613"\w*, \w a qual|strong="G3739"\w* \w Deus|strong="G3588,G2316"\w* \w destinou de antemão|strong="G4309"\w* \w antes|strong="G4253"\w* \w das eras|strong="G3588,G165"\w* \w para a nossa glória|strong="G1519,G1391,G3165"\w*;\x - \xo 2:7 \xt COL 1:26; ROM 8:29; JER 33:3; JAS 3:17; MAT 13:35; 2PE 1:3\x*
\v 8 \w a qual|strong="G3739"\w* \w nenhum|strong="G3762"\w* \w dos governantes|strong="G3588,G758"\w* \w desta era|strong="G3588,G165,G3778"\w* \w conheceu|strong="G1097"\w*; \w pois|strong="G1063"\w* \w se|strong="G1487"\w* \w a tivessem conhecido|strong="G1097"\w*, \w não teriam|strong="G3756,G302"\w* \w crucificado|strong="G4717"\w* \w o Senhor|strong="G3588,G2962"\w* \w da glória|strong="G3588,G1391"\w*.\x - \xo 2:8 \xt JER 33:3; 1CO 2:6; LUK 23:34; JHN 1:10; PSA 24:7; JHN 3:12\x*
\v 9 \w Mas|strong="G235"\w* \w como|strong="G2531"\w* \w está escrito|strong="G1125"\w*: “\w O que|strong="G3739"\w* \w olho|strong="G3788"\w* \w não viu|strong="G3756,G1492"\w* \w e|strong="G2532"\w* \w ouvido|strong="G3775"\w* \w não ouviu|strong="G3756,G191"\w* \w e|strong="G2532"\w* \w ao coração|strong="G1909,G2588"\w* \w de ser humano|strong="G444"\w* \w não subiu|strong="G3756,G305"\w*, \w tudo o que|strong="G3745"\w* \w Deus|strong="G3588,G2316"\w* \w preparou|strong="G2090"\w* \w para os que|strong="G3588"\w* \w o amam|strong="G25,G846"\w*.”\f + \fr 2.9: \ft Nota cultural: ecoa Is 64:3 (64:4 na LXX) e Is 65:16; a fonte exata é discutida.\f*\f + \fr 2.9: \ft Variante: o SBLGNT, com WH e Treg, traz ὅσα (“tudo o que”); a NA28 e o RP trazem ἅ (“as coisas que”).\f*\x - \xo 2:9 \xt ISA 64:3; ISA 65:16; EPH 3:20; ISA 64:4; JAS 1:12; PSA 31:19\x*
\v 10 \w Pois|strong="G1063"\w* \w a nós|strong="G3165"\w* \w Deus|strong="G3588,G2316"\w* \w revelou|strong="G601"\w* \w por meio do Espírito|strong="G1223,G3588,G4151"\w*; \w pois|strong="G1063"\w* \w o Espírito|strong="G3588,G4151"\w* \w examina|strong="G2045"\w* \w tudo|strong="G3956"\w*, \w inclusive|strong="G2532"\w* \w as profundezas|strong="G3588,G899"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 2.10: \ft Variante: o SBLGNT, com WH, traz γάρ (“pois”); Treg, NA28 e RP trazem δέ; o RP traz a ordem ὁ θεὸς ἀπεκάλυψεν e acrescenta αὐτοῦ (“seu Espírito”) depois de πνεύματος.\f*\x - \xo 2:10 \xt JHN 16:13; JER 33:3; JHN 14:26; ISA 64:4; JHN 15:15; MAT 13:11\x*
\v 11 \w Pois|strong="G1063"\w* \w quem|strong="G5101"\w* \w entre os seres humanos|strong="G444"\w* \w conhece|strong="G6063"\w* \w as coisas|strong="G3588"\w* \w do ser humano|strong="G3588,G444"\w*, \w a não ser|strong="G1487,G3361"\w* \w o espírito|strong="G3588,G4151"\w* \w do ser humano|strong="G3588,G444"\w* \w que está nele|strong="G3588,G1722,G846"\w*? \w Assim|strong="G3779"\w* \w também|strong="G2532"\w* \w as coisas|strong="G3588"\w* \w de Deus|strong="G3588,G2316"\w* \w ninguém|strong="G3762"\w* \w conheceu|strong="G1097"\w*, \w a não ser|strong="G1487,G3361"\w* \w o Espírito|strong="G3588,G4151"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 2.11: \ft Acréscimo: “que está nele”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 2:11 \xt JHN 16:13; JER 33:3; JHN 14:26; JHN 13:28; PRO 20:27; JHN 15:15\x*
\v 12 \w Nós|strong="G3165"\w*, \w porém|strong="G1161"\w*, \w não|strong="G3756"\w* \w recebemos|strong="G2983"\w* \w o espírito|strong="G3588,G4151"\w* \w do mundo|strong="G3588,G2889"\w*, \w mas|strong="G235"\w* \w o Espírito|strong="G3588,G4151"\w* \w que vem|strong="G3588,G1537"\w* \w de Deus|strong="G3588,G2316"\w*, \w para que|strong="G2443"\w* \w saibamos|strong="G6063"\w* \w as coisas|strong="G3588"\w* \w que por Deus|strong="G5259,G3588,G2316"\w* \w nos foram concedidas|strong="G5483,G3165"\w*;\x - \xo 2:12 \xt JHN 16:13; 1JN 4:4; JHN 14:26; ROM 8:15; JHN 15:15; 1JN 2:27\x*
\v 13 \w as quais|strong="G3739"\w* \w também|strong="G2532"\w* \w falamos|strong="G2980"\w*, \w não|strong="G3756"\w* \w com palavras|strong="G1722,G3056"\w* \w ensinadas|strong="G1318"\w* \w pela sabedoria|strong="G4678"\w* \w humana|strong="G442"\w*, \w mas|strong="G235"\w* \w com as ensinadas|strong="G1722,G1318"\w* \w pelo Espírito|strong="G4151"\w*, \w comparando|strong="G4793"\w* \w coisas espirituais|strong="G4152"\w* \w a espirituais|strong="G4152"\w*.\f + \fr 2.13: \ft Lit.: πνευματικοῖς πνευματικὰ συγκρίνοντες: “comparando (ou interpretando) coisas espirituais a espirituais”; o sentido é discutido (“a pessoas espirituais”, “com palavras espirituais”).\f*\f + \fr 2.13: \ft Variante: o RP acrescenta ἁγίου (“do Espírito Santo”) depois de πνεύματος.\f*\x - \xo 2:13 \xt JHN 16:13; JHN 14:26; 1JN 2:27; 1JN 4:6; JHN 3:27; JER 3:15\x*
\v 14 \w Mas|strong="G1161"\w* \w o ser humano|strong="G444"\w* \w natural|strong="G5591"\w* \w não aceita|strong="G3756,G1209"\w* \w as coisas|strong="G3588"\w* \w do Espírito|strong="G3588,G4151"\w* \w de Deus|strong="G3588,G2316"\w*, \w pois|strong="G1063"\w* \w são|strong="G1510"\w* \w loucura|strong="G3472"\w* \w para ele|strong="G846"\w*, \w e|strong="G2532"\w* \w não pode|strong="G3756,G1410"\w* \w conhecê-las|strong="G1097"\w*, \w porque|strong="G3754"\w* \w são examinadas|strong="G350"\w* \w espiritualmente|strong="G4153"\w*.\f + \fr 2.14: \ft Lit.: ψυχικός: “natural”, “psíquico”, “animal”; ἀνακρίνω: “examinar”, “avaliar”, “discernir”.\f*\x - \xo 2:14 \xt 1CO 1:18; ROM 8:5; JHN 1:5; MAT 13:11; 2CO 4:4-6; ROM 8:7\x*
\v 15 \w Mas|strong="G1161"\w* \w o espiritual|strong="G3588,G4152"\w* \w examina|strong="G350"\w* \w todas as coisas|strong="G3588,G3956"\w*, \w e|strong="G1161"\w* \w ele mesmo|strong="G846"\w* \w por ninguém|strong="G5259,G3762"\w* \w é examinado|strong="G350"\w*.\x - \xo 2:15 \xt 1CO 4:3; 1CO 4:4; 1CO 14:24; HEB 5:14; 1CO 3:1; 1TH 5:21\x*
\v 16 \w Pois|strong="G1063"\w* “\w quem|strong="G5101"\w* \w conheceu|strong="G1097"\w* \w a mente|strong="G3563"\w* \w do Senhor|strong="G2962"\w*, \w que|strong="G3739"\w* \w o instruirá|strong="G4822,G846"\w*?” \w Nós|strong="G3165"\w*, \w porém|strong="G1161"\w*, \w temos|strong="G2192"\w* \w a mente|strong="G3563"\w* \w de Cristo|strong="G5547"\w*.\f + \fr 2.16: \ft Nota cultural: cita Is 40:13 (LXX).\f*\x - \xo 2:16 \xt ISA 40:13; ROM 11:34; DEU 29:29; JHN 16:13-16; JHN 15:15; ISA 40:28\x*
\c 3
\p
\v 1 \w E eu|strong="G2532,G1473"\w*, \w irmãos e irmãs|strong="G80"\w*, \w não pude|strong="G3756,G1410"\w* \w falar|strong="G2980"\w* \w a vocês|strong="G4771"\w* \w como a espirituais|strong="G5613,G4152"\w*, \w mas|strong="G235"\w* \w como a carnais|strong="G5613,G4560"\w*, \w como a crianças|strong="G5613,G3516"\w* \w em Cristo|strong="G1722,G5547"\w*\f + \fr 3.1: \ft Lit.: σάρκινος: “de carne”, “carnal” (feito de carne); νήπιος: “criança pequena”, “bebê”.\f*.\x - \xo 3:1 \xt ROM 7:14; 1CO 13:11; HEB 5:12; 1PE 2:2; HEB 5:13; 1CO 2:14-15\x*
\v 2 \w Dei de beber a vocês|strong="G4771,G4222"\w* \w leite|strong="G1051"\w*, \w não|strong="G3756"\w* \w comida|strong="G1033"\w*, \w pois|strong="G1063"\w* \w ainda não|strong="G3768"\w* \w podiam|strong="G1410"\w*. \w Mas|strong="G235"\w* \w nem ainda agora|strong="G3761,G2089,G3568"\w* \w podem|strong="G1410"\w*,\x - \xo 3:2 \xt 1CO 13:11; HEB 5:12; 1PE 2:2; 2TI 2:15; HEB 5:11-14; JHN 16:12\x*
\v 3 \w pois|strong="G1063"\w* \w ainda|strong="G2089"\w* \w são|strong="G1510"\w* \w carnais|strong="G4559"\w*. \w Pois|strong="G1063"\w* \w onde|strong="G3699"\w* \w entre vocês|strong="G1722,G4771"\w* \add há\add* \w inveja|strong="G2205"\w* \w e|strong="G2532"\w* \w rivalidade|strong="G2054"\w*, \w não são|strong="G3780,G1510"\w* \w carnais|strong="G4559"\w* \w e|strong="G2532"\w* \w andam|strong="G4043"\w* \w segundo|strong="G2596"\w* \w o ser humano|strong="G444"\w*?\f + \fr 3.3: \ft Lit.: σαρκικός: “carnal”, “da carne”.\f*\f + \fr 3.3: \ft Variante: o RP acrescenta καὶ διχοστασίαι (“e divisões”) depois de ἔρις.\f*\f + \fr 3.3: \ft Acréscimo: “há” (em “entre vocês há inveja e”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 3:3 \xt ROM 13:13; HEB 5:12; GAL 5:19; JAS 3:16; PHP 2:3; GAL 5:15\x*
\v 4 \w Pois|strong="G1063"\w* \w quando|strong="G3752"\w* \w alguém|strong="G5100"\w* \w diz|strong="G3004"\w*: “\w Eu|strong="G1473"\w* \w sou|strong="G1510"\w* \w de Paulo|strong="G3972"\w*”, \w e outro|strong="G2087,G1161"\w*: “\w Eu|strong="G1473"\w* \w de Apolo|strong="G625"\w*”, \w não são|strong="G3756,G1510"\w* \w meros seres humanos|strong="G444"\w*?\f + \fr 3.4: \ft Variante: o RP traz οὐχὶ σαρκικοί (“não são carnais?”) em lugar de οὐκ ἄνθρωποί (“não são meros seres humanos?”).\f*\x - \xo 3:4 \xt 1CO 1:12; 1CO 4:6; ACT 19:1; 2TI 3:7; 1CO 3:1; PHP 2:14\x*
\v 5 \w O que|strong="G5101"\w*, \w então|strong="G3767"\w*, \w é|strong="G1510"\w* \w Apolo|strong="G625"\w*? \w E|strong="G1161"\w* \w o que|strong="G5101"\w* \w é|strong="G1510"\w* \w Paulo|strong="G3972"\w*? \w Servidores|strong="G1249"\w* \w por meio dos quais|strong="G1223,G3739"\w* \w vocês creram|strong="G4100"\w*, \w e|strong="G2532"\w* \w a cada um|strong="G1538"\w* \w conforme|strong="G5613"\w* \w o Senhor|strong="G3588,G2962"\w* \w concedeu|strong="G1325"\w*.\f + \fr 3.5: \ft Variante: o RP traz Τίς (“quem”) em lugar de Τί, a ordem Παῦλος… Ἀπολλῶς, e acrescenta ἀλλʼ ἢ (“senão”) antes de διάκονοι.\f*\x - \xo 3:5 \xt 1CO 1:12; ECC 11:6; ACT 19:1; 1CO 3:22; JHN 3:30; 2CO 6:4\x*
\v 6 \w Eu|strong="G1473"\w* \w plantei|strong="G5452"\w*, \w Apolo|strong="G625"\w* \w regou|strong="G4222"\w*, \w mas|strong="G235"\w* \w Deus|strong="G3588,G2316"\w* \w fazia crescer|strong="G837"\w*.\x - \xo 3:6 \xt ECC 11:6; ISA 55:11; LUK 10:2; 1CO 3:9; JHN 1:13; GEN 26:12\x*
\v 7 \w De modo que|strong="G5620"\w* \w nem|strong="G3777"\w* \w quem planta|strong="G3588,G5452"\w* \w é|strong="G1510"\w* \w algo|strong="G5100"\w*, \w nem|strong="G3777"\w* \w quem rega|strong="G3588,G4222"\w*, \w mas|strong="G235"\w* \w Deus|strong="G2316"\w*, \w que faz crescer|strong="G3588,G837"\w*.\x - \xo 3:7 \xt PSA 127:1; ECC 11:6; ISA 55:11; PSA 90:17; JHN 15:5; LUK 10:2\x*
