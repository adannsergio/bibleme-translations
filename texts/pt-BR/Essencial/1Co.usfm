\v 53 \w Pois|strong="G1063"\w* \w é necessário|strong="G1163"\w* \w que este ser corruptível|strong="G3588,G5349,G3778"\w* \w se revista|strong="G1746"\w* \w de incorrupção|strong="G861"\w*, \w e|strong="G2532"\w* \w que este ser mortal|strong="G3588,G2349,G3778"\w* \w se revista|strong="G1746"\w* \w de imortalidade|strong="G110"\w*.\f + \fr 15.53: \ft Acréscimo: verbo ser/estar suprido em “que este ser corruptível”, “que este ser mortal”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 15:53 \xt 1TH 4:15; PHP 3:21; 1PE 1:23; 2CO 5:2; HOS 13:14; ROM 8:11\x*
\v 54 \w Quando|strong="G3752"\w* \w este ser corruptível|strong="G3588,G5349,G3778"\w* \w se revestir|strong="G1746"\w* \w de incorrupção|strong="G861"\w*, \w e|strong="G2532"\w* \w este ser mortal|strong="G3588,G2349,G3778"\w* \w se revestir|strong="G1746"\w* \w de imortalidade|strong="G110"\w*, \w então|strong="G5119"\w* \w se cumprirá|strong="G1096"\w* \w a palavra|strong="G3588,G3056"\w* \w que está escrita|strong="G3588,G1125"\w*: “\w A morte|strong="G3588,G2288"\w* \w foi engolida|strong="G2666"\w* \w na vitória|strong="G1519,G3534"\w*\f + \fr 15.54: \ft Nota cultural: cita Is 25:8, com eco de Os 13:14.\f*.”\f + \fr 15.54: \ft Acréscimo: verbo ser/estar suprido em “este ser corruptível”, “este ser mortal”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 15:54 \xt ISA 25:8; HOS 13:14; REV 21:4; HEB 2:14; PHP 3:21; 1PE 1:23\x*
\v 55 “\w Onde está|strong="G4226"\w*, \w morte|strong="G2288"\w*, \w a sua|strong="G4771,G3588"\w* \w vitória|strong="G3534"\w*? \w Onde está|strong="G4226"\w*, \w morte|strong="G2288"\w*, \w o seu|strong="G4771,G3588"\w* \w ferrão|strong="G2759"\w*?”\f + \fr 15.55: \ft Nota cultural: ecoa Os 13:14.\f*\f + \fr 15.55: \ft Variante: o RP traz Ποῦ σου θάνατε τὸ κέντρον; ποῦ σου ᾅδη τὸ νῖκος (“Onde está, morte, o seu ferrão? Onde está, Hades, a sua vitória?”), invertendo a ordem das duas perguntas e trocando θάνατε por ᾅδη na segunda.\f*\f + \fr 15.55: \ft Acréscimo: “Onde está”, “Onde está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 15:55 \xt HOS 13:14; PSA 23:4; REV 21:4; HEB 2:14; PHP 3:21; 1CO 15:26\x*
\v 56 \w O ferrão|strong="G3588,G2759"\w* \w da morte|strong="G3588,G2288"\w* \w é o pecado|strong="G3588,G266"\w*, \w e|strong="G1161"\w* \w o poder|strong="G3588,G1411"\w* \w do pecado|strong="G3588,G266"\w* \w é a lei|strong="G3588,G3551"\w*.\f + \fr 15.56: \ft Acréscimo: verbo ser/estar suprido em “é o pecado”, “é a lei”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 15:56 \xt PSA 23:4; REV 21:4; HEB 2:14; PHP 3:21; GEN 2:17; ROM 4:15\x*
\v 57 \w Mas|strong="G1161"\w* \w graças|strong="G5485"\w* \w a Deus|strong="G3588,G2316"\w*, \w que nos dá|strong="G3588,G1325,G3165"\w* \w a vitória|strong="G3588,G3534"\w* \w por meio do nosso Senhor|strong="G1223,G3588,G2962,G3165"\w* \w Jesus|strong="G2424"\w* \w Cristo|strong="G5547"\w*.\x - \xo 15:57 \xt ROM 8:37; 1JN 5:4; 2CO 2:14; PSA 23:4; PRO 21:31; REV 12:11\x*
\v 58 \w De modo que|strong="G5620"\w*, \w meus amados irmãos e irmãs|strong="G80,G3165,G27"\w*, \w sejam|strong="G1096"\w* \w firmes|strong="G1476"\w*, \w inabaláveis|strong="G277"\w*, \w abundando|strong="G4052"\w* \w na obra|strong="G1722,G3588,G2041"\w* \w do Senhor|strong="G3588,G2962"\w* \w sempre|strong="G3842"\w*, \w sabendo|strong="G6063"\w* \w que|strong="G3754"\w* \w o esforço|strong="G3588,G2873"\w* \w de vocês|strong="G4771"\w* \w não é|strong="G3756,G1510"\w* \w vão|strong="G2756"\w* \w no Senhor|strong="G1722,G2962"\w*.\x - \xo 15:58 \xt 1CO 16:13; 1CO 3:8; 2CH 15:7; 2PE 3:17; COL 1:23; GAL 6:9\x*
\c 16
\p
\v 1 \w Quanto|strong="G4012,G1161"\w* \w à coleta|strong="G3588,G3048"\w* \w para os santos|strong="G3588,G1519,G40"\w*, \w como|strong="G5618"\w* \w ordenei|strong="G1299"\w* \w às comunidades|strong="G3588,G1577"\w* \w da Galácia|strong="G3588,G1053"\w*, \w assim|strong="G3779"\w* \w também|strong="G2532"\w* \w façam|strong="G4160"\w* \w vocês|strong="G4771"\w*.\x - \xo 16:1 \xt GAL 1:2; 1JN 3:17; 2CO 8:1-9; 2CO 9:12-15; ROM 12:13; GAL 2:10\x*
\v 2 \w Em cada primeiro dia|strong="G2596,G1520"\w* \w da semana|strong="G4521"\w*, \w cada um|strong="G1538"\w* \w de vocês|strong="G4771"\w* \w ponha|strong="G5087"\w* \w de lado|strong="G3844,G1438"\w* \w guardando|strong="G2343"\w* \w conforme|strong="G3739,G5100,G1437"\w* \w tiver prosperado|strong="G2137"\w*, \w para que|strong="G2443"\w* \w as coletas|strong="G3048"\w* \w não|strong="G3361"\w* \w sejam feitas|strong="G1096"\w* \w quando|strong="G3752"\w* \w eu chegar|strong="G2064"\w*\f + \fr 16.2: \ft Lit.: μία σαββάτου: “primeiro dia da semana”, literalmente “um (dia) do sábado”.\f*.\f + \fr 16.2: \ft Não traduzido: τότε (G5119): τότε (then); sem equivalente natural em português neste ponto.\f*\x - \xo 16:2 \xt PRO 3:9; ACT 20:7; MAL 3:9-10; LUK 16:10; DEU 15:11-14; DEU 8:18\x*
\v 3 \w Quando|strong="G3752,G1161"\w* \w eu chegar|strong="G3854"\w*, \w a quem|strong="G3739,G1437"\w* \w aprovarem|strong="G1381"\w* \w por cartas|strong="G1223,G1992"\w*, \w a esses|strong="G3778"\w* \w enviarei|strong="G3992"\w* \w para levar|strong="G667"\w* \w a dádiva|strong="G3588,G5485"\w* \w de vocês|strong="G4771"\w* \w a Jerusalém|strong="G1519,G2419"\w*.\f + \fr 16.3: \ft Lit.: χάρις: “graça”, aqui “dádiva”, isto é, a coleta.\f*\f + \fr 16.3: \ft Lit.: Δι᾽ ἐπιστολῶν, “por cartas”: pode ligar-se a “aprovarem” (aprovados por cartas) ou a “enviarei” (“enviarei, com cartas, os que vocês aprovarem”).\f*\x - \xo 16:3 \xt HEB 6:10; 2CO 3:1; 2CO 8:19; ACT 24:17; 2CO 8:4; ACT 6:3\x*
\v 4 \w Mas se|strong="G1437,G1161"\w* \w for conveniente|strong="G514,G1510"\w* \w que eu também|strong="G3588,G2532,G1473"\w* \w vá|strong="G4198"\w*, \w comigo|strong="G4862,G1473"\w* \w irão|strong="G4198"\w*.\x - \xo 16:4 \xt 2CO 8:19; ACT 24:17; 2CO 8:4\x*
\v 5 \w Irei|strong="G2064"\w* \w até vocês|strong="G4314,G4771"\w* \w quando|strong="G3752"\w* \w tiver passado|strong="G1330"\w* \w pela Macedônia|strong="G3109"\w*, \w pois|strong="G1063"\w* \w passo|strong="G1330"\w* \w pela Macedônia|strong="G3109"\w*;\x - \xo 16:5 \xt 2CO 1:16; ACT 19:21; 2JN 1:12; 1CO 4:19; ACT 20:1; ROM 15:24\x*
\v 6 \w e|strong="G1161"\w* \w com vocês|strong="G4314,G4771"\w* \w talvez|strong="G5177"\w* \w ficarei|strong="G3887"\w* \w ou até|strong="G2228,G2532"\w* \w passarei o inverno|strong="G3914"\w*, \w para que|strong="G2443"\w* \w vocês|strong="G4771"\w* \w me encaminhem|strong="G3165,G4311"\w* \w para onde|strong="G3757,G1437"\w* \w eu for|strong="G4198"\w*.\x - \xo 16:6 \xt 2CO 1:16; ACT 15:3; 1CO 16:11; 2JN 1:12; 3JN 1:6-7; ROM 15:24\x*
\v 7 \w Pois|strong="G1063"\w* \w não quero|strong="G3756,G2309"\w* \w ver|strong="G1492"\w* \w vocês|strong="G4771"\w* \w agora|strong="G737"\w* \w de passagem|strong="G1722,G3938"\w*; \w pois|strong="G1063"\w* \w espero|strong="G1679"\w* \w ficar|strong="G1961"\w* \w por algum|strong="G5100"\w* \w tempo|strong="G5550"\w* \w com vocês|strong="G4314,G4771"\w*, \w se|strong="G1437"\w* \w o Senhor|strong="G3588,G2962"\w* \w permitir|strong="G2010"\w*.\x - \xo 16:7 \xt 2CO 1:16; ACT 18:21; JAS 4:15; 1CO 4:19; 2JN 1:12; HEB 6:3\x*
\v 8 \w Ficarei|strong="G1961"\w* \w em Éfeso|strong="G1722,G2181"\w* \w até|strong="G2193"\w* \w Pentecostes|strong="G3588,G4005"\w*;\x - \xo 16:8 \xt ACT 20:16; ACT 2:1; ACT 14:3; ACT 18:19; ACT 19:26; EXO 23:16\x*
\v 9 \w pois|strong="G1063"\w* \w uma porta|strong="G2374"\w* \w grande|strong="G3173"\w* \w e|strong="G2532"\w* \w eficaz|strong="G1756"\w* \w se abriu|strong="G455"\w* \w para mim|strong="G3165"\w*, \w e|strong="G2532"\w* \w há muitos|strong="G4183"\w* \w adversários|strong="G480"\w*.\f + \fr 16.9: \ft Acréscimo: verbo ser/estar suprido em “há muitos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 16:9 \xt 2CO 2:12; REV 3:8; ACT 14:27; COL 4:3; REV 3:7-8; 2CO 1:8\x*
\v 10 \w Mas se|strong="G1437,G1161"\w* \w vier|strong="G2064"\w* \w Timóteo|strong="G5095"\w*, \w vejam|strong="G991"\w* \w que|strong="G2443"\w* \w esteja|strong="G1096"\w* \w sem temor|strong="G870"\w* \w entre vocês|strong="G4314,G4771"\w*; \w pois|strong="G1063"\w* \w realiza|strong="G2038"\w* \w a obra|strong="G3588,G2041"\w* \w do Senhor|strong="G2962"\w*, \w como|strong="G5613"\w* \w eu também|strong="G2532,G1473"\w*.\x - \xo 16:10 \xt JHN 6:28; 1CO 15:58; 1TI 4:12; 1CO 4:17; 3JN 1:8; ECC 9:10\x*
\v 11 \w Que ninguém|strong="G3361,G5100"\w*, \w portanto|strong="G3767"\w*, \w o despreze|strong="G846,G1848"\w*. \w E encaminhem-no|strong="G4311,G1161,G846"\w* \w em paz|strong="G1722,G1515"\w*, \w para que|strong="G2443"\w* \w venha|strong="G2064"\w* \w até mim|strong="G4314,G3165"\w*, \w pois|strong="G1063"\w* \w o espero|strong="G1551,G846"\w* \w com os irmãos|strong="G3326,G3588,G80"\w*.\x - \xo 16:11 \xt 1TI 4:12; MAT 18:10; 3JN 1:8; ACT 15:33; TIT 2:15; 1CO 16:10\x*
\v 12 \w Quanto|strong="G4012,G1161"\w* \w a Apolo|strong="G625"\w*, \w o irmão|strong="G3588,G80"\w*, \w exortei-o|strong="G3870,G846"\w* \w muitas vezes|strong="G4183"\w* \w a que|strong="G2443"\w* \w vá|strong="G2064"\w* \w até vocês|strong="G4314,G4771"\w* \w com os irmãos|strong="G3326,G3588,G80"\w*; \w e|strong="G2532"\w* \w de modo algum|strong="G3843,G3756"\w* \w era vontade|strong="G1510,G2307"\w* \w que|strong="G2443"\w* \w agora|strong="G3568"\w* \w fosse|strong="G2064"\w*, \w mas irá|strong="G2064,G1161"\w* \w quando|strong="G3752"\w* \w tiver oportunidade|strong="G2119"\w*.\x - \xo 16:12 \xt ACT 18:24; 1CO 1:12; ACT 19:1; 1CO 3:5\x*
\v 13 \w Vigiem|strong="G1127"\w*, \w permaneçam firmes|strong="G4739"\w* \w na fé|strong="G1722,G3588,G4102"\w*, \w sejam corajosos|strong="G407"\w*, \w fortaleçam-se|strong="G2901"\w*.\f + \fr 16.13: \ft Lit.: ἀνδρίζομαι: “comportar-se como homem”, “ter coragem”.\f*\x - \xo 16:13 \xt 1CO 15:58; 2CO 12:9-10; EPH 6:10; EPH 6:13-18; GAL 5:1; JOS 1:9\x*
\v 14 \w Que tudo|strong="G3956"\w* \w o que fazem|strong="G4771"\w* \w aconteça|strong="G1096"\w* \w em amor|strong="G1722,G26"\w*.\x - \xo 16:14 \xt 1CO 13:13; JHN 13:34-35; PHP 1:27; 1PE 4:8; 1TI 1:5; 1JN 4:7-8\x*
\v 15 \w Exorto|strong="G3870"\w* \w vocês|strong="G4771"\w*, \w irmãos e irmãs|strong="G80"\w*: \w vocês conhecem|strong="G6063"\w* \w a casa|strong="G3588,G3614"\w* \w de Estéfanas|strong="G4734"\w*, \w que|strong="G3754"\w* \w é|strong="G1510"\w* \w primícia|strong="G536"\w* \w da Acaia|strong="G3588,G882"\w* \w e|strong="G2532"\w* \w se colocaram|strong="G5021"\w* \w a si mesmos|strong="G1438"\w* \w a serviço|strong="G1519,G1248"\w* \w dos santos|strong="G3588,G40"\w*;\x - \xo 16:15 \xt 1CO 1:16; ROM 16:5; ROM 12:13; 2CO 8:4; ROM 15:25; 1PE 4:10\x*
\v 16 \w que|strong="G2443"\w* \w também|strong="G2532"\w* \w vocês|strong="G4771"\w* \w se sujeitem|strong="G5293"\w* \w a tais pessoas|strong="G3588,G5108"\w* \w e|strong="G2532"\w* \w a todo|strong="G3956"\w* \w aquele que colabora|strong="G3588,G4903"\w* \w e|strong="G2532"\w* \w trabalha arduamente|strong="G2872"\w*.\x - \xo 16:16 \xt HEB 13:17; 1TH 5:12; 1TI 5:17; EPH 5:21; ROM 16:12; ROM 16:3\x*
\v 17 \w Alegro-me|strong="G5463"\w* \w com a vinda|strong="G1909,G3588,G3952"\w* \w de Estéfanas|strong="G4734"\w* \w e|strong="G2532"\w* \w Fortunato|strong="G5415"\w* \w e|strong="G2532"\w* \w Acaico|strong="G883"\w*, \w porque|strong="G3754"\w* \w estes|strong="G3778"\w* \w supriram|strong="G378"\w* \w o que faltava|strong="G5303"\w* \w da parte de vocês|strong="G3588,G4771"\w*,\x - \xo 16:17 \xt PHP 2:30; 2CO 11:9; 1CO 1:16; 2CO 7:6; PHM 1:13\x*
\v 18 \w pois|strong="G1063"\w* \w deram descanso|strong="G373"\w* \w ao meu|strong="G3588,G1473"\w* \w espírito|strong="G4151"\w* \w e|strong="G2532"\w* \w ao de vocês|strong="G3588,G4771"\w*. \w Reconheçam|strong="G1921"\w*, \w portanto|strong="G3767"\w*, \w pessoas assim|strong="G3588,G5108"\w*.\x - \xo 16:18 \xt 1TH 5:12; PHP 2:29; PHM 1:7; ROM 15:32; 2CO 7:13; 2TI 1:16\x*
\v 19 \w Saúdam|strong="G782"\w* \w vocês|strong="G4771"\w* \w as comunidades|strong="G3588,G1577"\w* \w da Ásia|strong="G3588,G773"\w*. \w Saúdam|strong="G782"\w* \w vocês|strong="G4771"\w* \w no Senhor|strong="G1722,G2962"\w* \w muito|strong="G4183"\w* \w Áquila|strong="G207"\w* \w e|strong="G2532"\w* \w Prisca|strong="G4251"\w*, \w com a comunidade|strong="G4862,G3588,G1577"\w* \w que está na casa|strong="G2596,G3624"\w* \w deles|strong="G846"\w*.\f + \fr 16.19: \ft Variante: WH e NA28 trazem ἀσπάζεται (singular), como o SBLGNT; Treg e o RP trazem ἀσπάζονται; o RP traz Πρίσκιλλα em lugar de Πρίσκα.\f*\f + \fr 16.19: \ft Acréscimo: “que está na casa”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 16:19 \xt 2TI 4:19; ROM 16:3; ROM 16:5; ACT 18:2; PHM 1:2\x*
\v 20 \w Todos os irmãos e irmãs|strong="G3588,G80,G3956"\w* \w saúdam|strong="G782"\w* \w vocês|strong="G4771"\w*. \w Saúdem|strong="G782"\w* \w uns aos outros|strong="G240"\w* \w com um beijo|strong="G1722,G5370"\w* \w santo|strong="G40"\w*.\x - \xo 16:20 \xt 2CO 13:12; ROM 16:16; 1TH 5:26; 1PE 5:14; HEB 13:24; PHP 4:21\x*
\v 21 \w A saudação|strong="G3588,G783"\w* \w de minha própria mão|strong="G3588,G1473,G5495"\w*: \w de Paulo|strong="G3972"\w*.\x - \xo 16:21 \xt 2TH 3:17; COL 4:18; PHM 1:19; GAL 6:11; MAT 25:40; JHN 21:15\x*
\v 22 \w Se|strong="G1487"\w* \w alguém|strong="G5100"\w* \w não ama|strong="G3756,G5368"\w* \w o Senhor|strong="G3588,G2962"\w*, \w seja|strong="G1510"\w* \w anátema|strong="G331"\w*. \w Maranata|strong="G3134"\w*.\f + \fr 16.22: \ft Lit.: Μαράνα θά: transliteração do aramaico, “Nosso Senhor, vem!” ou “Nosso Senhor veio”; a divisão das palavras e o sentido são discutidos.\f*\f + \fr 16.22: \ft Variante: o RP acrescenta Ἰησοῦν Χριστόν (“Jesus Cristo”) depois de κύριον; o SBLGNT traz Μαράνα θά, com a NA28, e WH, Treg e o RP trazem Μαρὰν ἀθά (outra divisão das palavras aramaicas).\f*\x - \xo 16:22 \xt JHN 14:15; JHN 8:42; GAL 1:8; PRO 8:36; EPH 6:24; REV 22:20\x*
\v 23 \w A graça|strong="G3588,G5485"\w* \w do Senhor|strong="G3588,G2962"\w* \w Jesus|strong="G2424"\w* \w esteja com|strong="G3326"\w* \w vocês|strong="G4771"\w*.\f + \fr 16.23: \ft Variante: o RP acrescenta Χριστοῦ depois de Ἰησοῦ.\f*\f + \fr 16.23: \ft Acréscimo: verbo ser/estar suprido em “esteja com”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 16:23 \xt 2CO 13:14; ROM 16:20; ACT 15:11; GAL 6:11; EPH 6:24; ROM 1:7\x*
\v 24 \w O meu amor|strong="G3588,G26,G3165"\w* \w esteja com|strong="G3326"\w* \w todos|strong="G3956"\w* \w vocês|strong="G4771"\w* \w em Cristo|strong="G1722,G5547"\w* \w Jesus|strong="G2424"\w*.\f + \fr 16.24: \ft Variante: o RP acrescenta Ἀμήν depois de Ἰησοῦ.\f*\f + \fr 16.24: \ft Acréscimo: verbo ser/estar suprido em “esteja com”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 16:24 \xt MAT 6:13; REV 3:19; 1CO 14:16; 2CO 12:15\x*
