\v 1 \w Depois disto|strong="G3326,G3778"\w* \w vi|strong="G1492"\w* \w outro anjo|strong="G243,G32"\w* \w descendo|strong="G2597"\w* \w do céu|strong="G1537,G3588,G3772"\w*, \w tendo|strong="G2192"\w* \w grande autoridade|strong="G1849,G3173"\w*, \w e|strong="G2532"\w* \w a terra|strong="G3588,G1093"\w* \w foi iluminada|strong="G5461"\w* \w pela glória|strong="G1537,G3588,G1391"\w* \w dele|strong="G846"\w*.\x - \xo 18:1 \xt EZK 43:2; REV 19:1; LUK 17:24; LUK 2:9; REV 21:23; 2TH 2:8\x*
\v 2 \w E|strong="G2532"\w* \w clamou|strong="G2896"\w* \w em forte voz|strong="G1722,G2478,G5456"\w*, \w dizendo|strong="G3004"\w*: “\w Caiu|strong="G4098"\w*, \w caiu|strong="G4098"\w* \w Babilônia|strong="G897"\w*, \w a grande|strong="G3588,G3173"\w*, \w e|strong="G2532"\w* \w se tornou|strong="G1096"\w* \w morada|strong="G2732"\w* \w de demônios|strong="G1140"\w* \w e|strong="G2532"\w* \w prisão|strong="G5438"\w* \w de todo|strong="G3956"\w* \w espírito|strong="G4151"\w* \w impuro|strong="G169"\w* \w e|strong="G2532"\w* \w prisão|strong="G5438"\w* \w de toda|strong="G3956"\w* \w ave|strong="G3732"\w* \w impura|strong="G169"\w* \w e|strong="G2532"\w* \w prisão|strong="G5438"\w* \w de toda|strong="G3956"\w* \w fera|strong="G2342"\w* \w impura|strong="G169"\w* \w e|strong="G2532"\w* \w odiada|strong="G3404"\w*,\f + \fr 18.2: \ft Lit.: Φυλακή, “prisão, lugar de guarda”, aqui o lugar onde espíritos, aves e feras impuros são confinados ou se refugiam; θηρίον, “animal selvagem”.\f*\f + \fr 18.2: \ft Nota cultural: a cidade em ruínas, habitada por demônios, aves e feras impuras, ecoa Is 13:19-22 e 34:11-15 e Jr 50:39 e 51:37.\f*\f + \fr 18.2: \ft Variante: WH, Treg e o RP omitem “e prisão de toda fera impura” (καὶ φυλακὴ παντὸς θηρίου ἀκαθάρτου); o TR acrescenta “grande” (μεγάλῃ) depois de “forte”; Treg e o RP omitem o segundo “caiu” (ἔπεσεν); o RP traz δαιμόνων em lugar de δαιμονίων (“de demônios”).\f*\x - \xo 18:2 \xt JER 51:37; JER 50:39; ISA 13:19-22; ISA 34:11; JER 51:8; REV 14:8\x*
\v 3 \w porque|strong="G3754"\w* \w do vinho|strong="G1537,G3588,G3631"\w* \w do furor|strong="G3588,G2372"\w* \w da prostituição|strong="G3588,G4202"\w* \w dela|strong="G846"\w* \w caíram|strong="G4098"\w* \w todas as nações|strong="G3956,G3588,G1484"\w*, \w e|strong="G2532"\w* \w os reis|strong="G3588,G935"\w* \w da terra|strong="G3588,G1093"\w* \w com ela|strong="G3326,G846"\w* \w se prostituíram|strong="G4203"\w*, \w e|strong="G2532"\w* \w os comerciantes|strong="G3588,G1713"\w* \w da terra|strong="G3588,G1093"\w* \w enriqueceram|strong="G4147"\w* \w com o poder|strong="G1537,G3588,G1411"\w* \w do luxo|strong="G3588,G4764"\w* \w dela|strong="G846"\w*.”\f + \fr 18.3: \ft Lit.: Στρῆνος, “luxo, sensualidade desenfreada”; ἔμπορος, “comerciante, negociante de longa distância”.\f*\f + \fr 18.3: \ft Variante: NA28 traz πέπωκαν (“beberam”) em lugar de πέπτωκαν (“caíram”).\f*\x - \xo 18:3 \xt REV 17:2; REV 14:8; REV 18:15; REV 18:23; REV 18:9; REV 19:1\x*
\v 4 \w E|strong="G2532"\w* \w ouvi|strong="G191"\w* \w outra voz|strong="G243,G5456"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w dizendo|strong="G3004"\w*: “\w Saiam|strong="G1831"\w* \w dela|strong="G1537,G846"\w*, \w povo meu|strong="G3588,G2992,G3165"\w*, \w para que não|strong="G2443,G3361"\w* \w participem|strong="G4790"\w* \w dos pecados|strong="G3588,G266"\w* \w dela|strong="G846"\w*, \w e|strong="G2532"\w* \w para que não|strong="G2443,G3361"\w* \w recebam|strong="G2983"\w* \w das pragas|strong="G1537,G3588,G4127"\w* \w dela|strong="G846"\w*;\f + \fr 18.4: \ft Nota cultural: o chamado “saiam dela, povo meu” ecoa Is 48:20 e 52:11 e Jr 50:8 e 51:6, 45.\f*\f + \fr 18.4: \ft Variante: o RP traz o singular Ἔξελθε (“saia”) e coloca “dela” antes de “povo meu”.\f*\x - \xo 18:4 \xt ISA 52:11; JER 51:6; JER 50:8; ISA 48:20; 2CO 6:17; PRO 13:20\x*
\v 5 \w porque|strong="G3754"\w* \w se amontoaram|strong="G2853"\w* \w os pecados|strong="G3588,G266"\w* \w dela|strong="G846"\w* \w até o céu|strong="G891,G3588,G3772"\w*, \w e|strong="G2532"\w* \w Deus|strong="G3588,G2316"\w* \w se lembrou|strong="G3421"\w* \w das injustiças|strong="G3588,G92"\w* \w dela|strong="G846"\w*.\f + \fr 18.5: \ft Lit.: Κολλάω, “colar-se, grudar-se, amontoar-se”.\f*\f + \fr 18.5: \ft Variante: o TR traz ἠκολούθησαν (“seguiram, alcançaram”) em lugar de ἐκολλήθησαν.\f*\x - \xo 18:5 \xt EZR 9:6; GEN 18:20-21; JER 51:9; REV 16:19; JON 1:2; REV 19:1\x*
\v 6 \w Retribuam|strong="G591"\w* \w a ela|strong="G846"\w* \w como|strong="G5613"\w* \w também|strong="G2532"\w* \w ela|strong="G846"\w* \w retribuiu|strong="G591"\w*, \w e|strong="G2532"\w* \w dobrem|strong="G1363"\w* \w o dobro|strong="G3588,G1362"\w* \w conforme as obras|strong="G2596,G3588,G2041"\w* \w dela|strong="G846"\w*; \w no cálice|strong="G1722,G3588,G4221"\w* \w em que|strong="G3739"\w* \w misturou|strong="G2767"\w*, \w misturem|strong="G2767"\w* \w para ela|strong="G846"\w* \w o dobro|strong="G1362"\w*;\f + \fr 18.6: \ft Nota cultural: a lei de retribuição ecoa Jr 50:15, 29 e Sl 137:8.\f*\f + \fr 18.6: \ft Variante: o RP acrescenta “a ela” (αὐτῇ) depois de “dobrem” e omite o artigo τά antes de “dobro”.\f*\x - \xo 18:6 \xt PSA 137:8; JER 50:15; REV 14:10; JER 50:29; ISA 40:2; MAT 7:2\x*
\v 7 \w Quanto|strong="G3745"\w* \w ela se glorificou|strong="G1392,G1438"\w* \w e|strong="G2532"\w* \w viveu em luxo|strong="G4763"\w*, \w tanto|strong="G5118"\w* \w deem|strong="G1325"\w* \w a ela|strong="G846"\w* \w tormento|strong="G929"\w* \w e|strong="G2532"\w* \w luto|strong="G3997"\w*; \w porque|strong="G3754"\w* \w no coração|strong="G1722,G3588,G2588"\w* \w dela|strong="G846"\w* \w diz|strong="G3004"\w*: ‘\w Estou sentada|strong="G2521"\w* \w como rainha|strong="G938"\w*, \w e|strong="G2532"\w* \w viúva|strong="G5503"\w* \w não|strong="G3756"\w* \w sou|strong="G1510"\w*, \w e|strong="G2532"\w* \w luto|strong="G3997"\w* \w de modo algum|strong="G3756,G3361"\w* \w verei|strong="G1492"\w*\f + \fr 18.7: \ft Nota cultural: a arrogância de Babilônia (“estou sentada como rainha, e não serei viúva”) ecoa Is 47:7-9.\f*.’\x - \xo 18:7 \xt ISA 47:7-9; MRK 8:36; ZEP 2:15; 1TH 5:3; 1TI 5:6; JOB 36:11\x*
\v 8 \w Por isso|strong="G1223,G3778"\w* \w num só dia|strong="G1722,G1520,G2250"\w* \w virão|strong="G2240"\w* \w as pragas|strong="G3588,G4127"\w* \w dela|strong="G846"\w*, \w morte|strong="G2288"\w* \w e|strong="G2532"\w* \w luto|strong="G3997"\w* \w e|strong="G2532"\w* \w fome|strong="G3042"\w*, \w e|strong="G2532"\w* \w com fogo|strong="G1722,G4442"\w* \w será queimada|strong="G2618"\w*; \w porque|strong="G3754"\w* \w forte|strong="G2478"\w* \add é\add* \w o Senhor Deus|strong="G2962,G3588,G2316"\w*, \w que a julgou|strong="G3588,G2919,G846"\w*.”\f + \fr 18.8: \ft Acréscimo: “é” (em “porque forte é o Senhor”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 18:8 \xt MRK 8:36; 1TH 5:3; REV 18:10; REV 17:16; REV 19:1; JAS 4:9\x*
\v 9 \w E|strong="G2532"\w* \w chorarão|strong="G2799"\w* \w e|strong="G2532"\w* \w se lamentarão|strong="G2875"\w* \w por ela|strong="G1909,G846"\w* \w os reis|strong="G3588,G935"\w* \w da terra|strong="G3588,G1093"\w*, \w os que|strong="G3588"\w* \w com ela|strong="G3326,G846"\w* \w se prostituíram|strong="G4203"\w* \w e|strong="G2532"\w* \w viveram em luxo|strong="G4763"\w*, \w quando|strong="G3752"\w* \w virem|strong="G991"\w* \w a fumaça|strong="G3588,G2586"\w* \w do incêndio|strong="G3588,G4451"\w* \w dela|strong="G846"\w*,\f + \fr 18.9: \ft Lit.: Κόπτω (voz média), “bater no peito, lamentar-se”; πύρωσις, “incêndio, queima”.\f*\f + \fr 18.9: \ft Nota cultural: o lamento dos reis, mercadores e marinheiros pela queda da cidade imita o lamento sobre Tiro em Ez 26–27.\f*\x - \xo 18:9 \xt REV 18:18; REV 18:3; REV 19:3; GEN 19:28; REV 17:2; REV 19:1\x*
\v 10 \w de longe|strong="G575,G3113"\w* \w de pé|strong="G2476"\w* \w por causa do medo|strong="G1223,G3588,G5401"\w* \w do tormento|strong="G3588,G929"\w* \w dela|strong="G846"\w*, \w dizendo|strong="G3004"\w*: “\w Ai|strong="G3759"\w*, \w ai|strong="G3759"\w*, \w a grande cidade|strong="G3588,G4172,G3173"\w*, \w Babilônia|strong="G897"\w*, \w a cidade forte|strong="G3588,G4172,G2478"\w*, \w porque|strong="G3754"\w* \w numa só hora|strong="G1520,G5610"\w* \w veio|strong="G2064"\w* \w o seu julgamento|strong="G3588,G2920,G4771"\w*!”\x - \xo 18:10 \xt REV 18:15; REV 18:19; REV 18:8; REV 14:8; REV 19:1; REV 11:8\x*
\v 11 \w E|strong="G2532"\w* \w os comerciantes|strong="G3588,G1713"\w* \w da terra|strong="G3588,G1093"\w* \w choram|strong="G2799"\w* \w e|strong="G2532"\w* \w lamentam|strong="G3996"\w* \w por ela|strong="G1909,G846"\w*, \w porque|strong="G3754"\w* \w ninguém|strong="G3762"\w* \w compra mais|strong="G59,G2089,G3756"\w* \w a carga deles|strong="G3588,G1117,G846"\w*,\f + \fr 18.11: \ft Variante: o RP traz os futuros κλαύσουσιν e πενθήσουσιν (“chorarão”, “lamentarão”) e o dativo αὐτῇ (“por ela”).\f*\x - \xo 18:11 \xt REV 18:15; 1JN 2:16; REV 19:1; REV 18:23; REV 18:3; EZK 27:27\x*
\v 12 \w carga de ouro|strong="G1117,G5557"\w* \w e|strong="G2532"\w* \w de prata|strong="G696"\w* \w e|strong="G2532"\w* \w de pedra|strong="G3037"\w* \w preciosa|strong="G5093"\w* \w e|strong="G2532"\w* \w de pérolas|strong="G3135"\w* \w e|strong="G2532"\w* \w de linho fino|strong="G1039"\w* \w e|strong="G2532"\w* \w de púrpura|strong="G4209"\w* \w e|strong="G2532"\w* \w de seda|strong="G4596"\w* \w e|strong="G2532"\w* \w de escarlate|strong="G2847"\w*, \w e|strong="G2532"\w* \w toda madeira de tuia|strong="G3956,G3586,G2367"\w* \w e|strong="G2532"\w* \w todo objeto|strong="G3956,G4632"\w* \w de marfim|strong="G1661"\w* \w e|strong="G2532"\w* \w todo objeto|strong="G3956,G4632"\w* \w de madeira|strong="G1537,G3586"\w* \w muito preciosa|strong="G5093"\w* \w e|strong="G2532"\w* \w de bronze|strong="G5475"\w* \w e|strong="G2532"\w* \w de ferro|strong="G4604"\w* \w e|strong="G2532"\w* \w de mármore|strong="G3139"\w*,\f + \fr 18.12: \ft Lit.: Βύσσινος, “de linho fino”; σιρικός, “de seda”; θύϊνος, “de tuia” (madeira aromática e valiosa).\f*\f + \fr 18.12: \ft Variante: o RP traz o singular μαργαρίτου (“de pérola”) e o adjetivo πορφυροῦ (“de púrpura”).\f*\x - \xo 18:12 \xt 1JN 2:16; REV 17:4; REV 19:1; REV 18:23; EZK 27:15; ZEC 14:21\x*
\v 13 \w e|strong="G2532"\w* \w canela|strong="G2792"\w* \w e|strong="G2532"\w* \w amomo|strong="G6007"\w* \w e|strong="G2532"\w* \w incensos|strong="G2368"\w* \w e|strong="G2532"\w* \w perfume|strong="G3464"\w* \w e|strong="G2532"\w* \w olíbano|strong="G3030"\w* \w e|strong="G2532"\w* \w vinho|strong="G3631"\w* \w e|strong="G2532"\w* \w azeite|strong="G1637"\w* \w e|strong="G2532"\w* \w flor de farinha|strong="G4585"\w* \w e|strong="G2532"\w* \w trigo|strong="G4621"\w* \w e|strong="G2532"\w* \w gado|strong="G2934"\w* \w e|strong="G2532"\w* \w ovelhas|strong="G4263"\w*, \w e|strong="G2532"\w* \w cavalos|strong="G2462"\w* \w e|strong="G2532"\w* \w carruagens|strong="G4480"\w* \w e|strong="G2532"\w* \w corpos|strong="G4983"\w*, \w e|strong="G2532"\w* \w vidas|strong="G5590"\w* \w de seres humanos|strong="G444"\w*.\f + \fr 18.13: \ft Lit.: Σώματα, “corpos”, termo usado para escravos; ψυχὰς ἀνθρώπων, “vidas humanas”: a lista termina com o tráfico de escravos (cf. Ez 27:13); σεμίδαλις, “flor de farinha, farinha fina”.\f*\f + \fr 18.13: \ft Variante: o TR e o RP omitem “e amomo” (καὶ ἄμωμον); o RP inverte a ordem de “gado” e “ovelhas”.\f*\x - \xo 18:13 \xt EZK 27:13; 1JN 2:16; REV 19:1; AMO 2:6; REV 18:23; 1CH 5:21\x*
\v 14 \w E|strong="G2532"\w* \w o fruto maduro|strong="G3588,G3703"\w* \w do desejo|strong="G3588,G1939"\w* \w da sua alma|strong="G4771,G3588,G5590"\w* \w se foi|strong="G565"\w* \w de você|strong="G575,G4771"\w*, \w e|strong="G2532"\w* \w todas as coisas|strong="G3956,G3588"\w* \w suntuosas|strong="G3045"\w* \w e|strong="G2532"\w* \w esplêndidas|strong="G3588,G2986"\w* \w se perderam|strong="G622"\w* \w de você|strong="G575,G4771"\w*, \w e|strong="G2532"\w* \w de modo algum|strong="G3756,G3361"\w* \w mais|strong="G2089,G3756"\w* \w as acharão|strong="G846,G2147"\w*.\f + \fr 18.14: \ft Variante: o RP traz a ordem “da alma, o seu (desejo)” em outra posição e a forma εὕρῃς (“você achará”) em lugar de εὑρήσουσιν (3ª pessoa do plural, impessoal: “não as acharão”); Treg omite “mais” (οὐκέτι).\f*\x - \xo 18:14 \xt 1JN 2:16; REV 19:1; REV 18:23; 1CO 10:6; ZEC 14:21; EZK 32:9\x*
\v 15 \w Os comerciantes|strong="G3588,G1713"\w* \add destas\add* \w coisas|strong="G3778"\w*, \w os que enriqueceram|strong="G3588,G4147"\w* \w por meio dela|strong="G575,G846"\w*, \w de longe|strong="G575,G3113"\w* \w estarão de pé|strong="G2476"\w* \w por causa do medo|strong="G1223,G3588,G5401"\w* \w do tormento|strong="G3588,G929"\w* \w dela|strong="G846"\w*, \w chorando|strong="G2799"\w* \w e|strong="G2532"\w* \w lamentando|strong="G3996"\w*,\f + \fr 18.15: \ft Acréscimo: “destas” (em “Os comerciantes destas coisas os”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 18:15 \xt REV 18:10; REV 18:11; REV 18:3; REV 18:19; 1JN 2:16; REV 19:1\x*
\v 16 \w dizendo|strong="G3004"\w*: “\w Ai|strong="G3759"\w*, \w ai|strong="G3759"\w*, \w a grande cidade|strong="G3588,G4172,G3173"\w*, \w a que estava vestida|strong="G3588,G4016"\w* \w de linho fino|strong="G1039"\w* \w e|strong="G2532"\w* \w púrpura|strong="G4210"\w* \w e|strong="G2532"\w* \w escarlate|strong="G2847"\w*, \w e|strong="G2532"\w* \w adornada|strong="G5558"\w* \w com ouro|strong="G5553"\w* \w e|strong="G2532"\w* \w pedra preciosa|strong="G3037,G5093"\w* \w e|strong="G2532"\w* \w pérola|strong="G3135"\w*,\f + \fr 18.16: \ft Variante: o RP traz “e dizendo” (καὶ λέγοντες) e o plural μαργαρίταις (“pérolas”); WH e NA28 acrescentam “com” (ἐν) depois de “adornada”.\f*\x - \xo 18:16 \xt REV 17:4; 1JN 2:16; REV 18:10; REV 19:1; REV 18:23; 1PE 1:7\x*
\v 17 \w porque|strong="G3754"\w* \w numa só hora|strong="G1520,G5610"\w* \w foi devastada|strong="G2049"\w* \w tanta riqueza|strong="G3588,G5118,G4149"\w*.” \w E|strong="G2532"\w* \w todo piloto|strong="G3956,G2942"\w* \w e|strong="G2532"\w* \w todo aquele|strong="G3956,G3588"\w* \w que navega|strong="G4126"\w* \w para algum lugar|strong="G1909,G5117"\w*, \w e|strong="G2532"\w* \w marinheiros|strong="G3492"\w* \w e|strong="G2532"\w* \w todos os que|strong="G3745"\w* \w trabalham|strong="G2038"\w* \w no mar|strong="G3588,G2281"\w*, \w de longe|strong="G575,G3113"\w* \w pararam|strong="G2476"\w*\f + \fr 18.17: \ft Variante: o TR omite “para algum lugar” (τόπον) e acrescenta “a multidão” (ὁ ὅμιλος).\f*\x - \xo 18:17 \xt 1JN 2:16; REV 18:10; REV 19:1; REV 18:23; 1PE 1:7; LAM 1:1\x*
\v 18 \w e|strong="G2532"\w* \w gritaram|strong="G2896"\w* \w ao verem|strong="G991"\w* \w a fumaça|strong="G3588,G2586"\w* \w do incêndio|strong="G3588,G4451"\w* \w dela|strong="G846"\w*, \w dizendo|strong="G3004"\w*: “\w Quem|strong="G5101"\w* \w é semelhante|strong="G3664"\w* \w à grande cidade|strong="G3588,G4172,G3173"\w*?”\f + \fr 18.18: \ft Variante: WH traz o aoristo ἔκραξαν (“gritaram”); Treg, NA28, o TR e o RP trazem o imperfeito ἔκραζον (“gritavam”).\f*\f + \fr 18.18: \ft Acréscimo: verbo ser/estar suprido em “é semelhante”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 18:18 \xt REV 18:9; REV 13:4; REV 19:1; REV 19:3; REV 18:23; REV 14:8\x*
\v 19 \w e|strong="G2532"\w* \w lançaram|strong="G906"\w* \w pó|strong="G5522"\w* \w sobre as suas|strong="G1909,G3588,G846"\w* \w cabeças|strong="G2776"\w*, \w e|strong="G2532"\w* \w gritaram|strong="G2896"\w*, \w chorando|strong="G2799"\w* \w e|strong="G2532"\w* \w lamentando|strong="G3996"\w*, \w dizendo|strong="G3004"\w*: “\w Ai|strong="G3759"\w*, \w ai|strong="G3759"\w*, \w a grande cidade|strong="G3588,G4172,G3173"\w*, \w na qual|strong="G1722,G3739"\w* \w enriqueceram|strong="G4147"\w* \w todos os que|strong="G3956,G3588"\w* \w têm|strong="G2192"\w* \w os navios|strong="G3588,G4143"\w* \w no mar|strong="G1722,G3588,G2281"\w* \w por causa da riqueza|strong="G1537,G3588,G5094"\w* \w dela|strong="G846"\w*, \w porque|strong="G3754"\w* \w numa só hora|strong="G1520,G5610"\w* \w foi devastada|strong="G2049"\w*\f + \fr 18.19: \ft Variante: WH traz o aoristo ἔκραξαν; Treg, NA28 e o RP trazem ἔκραζον (“gritavam”); o RP acrescenta “e” (καί) depois de “lamentando”.\f*\f + \fr 18.19: \ft Nota cultural: o pó lançado sobre a cabeça, o choro e o luto dos marinheiros imitam Ez 27:28-36 (lamento sobre Tiro).\f*\f + \fr 18.19: \ft Lit.: Τιμιότης, “preciosidade, riqueza”.\f*!”\x - \xo 18:19 \xt EZK 27:28-36; REV 18:15; REV 18:10; JOS 7:6; REV 19:1; EZK 27:30\x*
\v 20 “\w Alegre-se|strong="G2165"\w* \w por causa dela|strong="G1909,G846"\w*, \w ó céu|strong="G3772"\w*, \w e|strong="G2532"\w* \w os santos|strong="G3588,G40"\w* \w e|strong="G2532"\w* \w os apóstolos|strong="G3588,G652"\w* \w e|strong="G2532"\w* \w os profetas|strong="G3588,G4396"\w*, \w porque|strong="G3754"\w* \w julgou|strong="G2919"\w* \w Deus|strong="G3588,G2316"\w* \w a causa|strong="G3588,G2917"\w* \w de vocês|strong="G4771"\w* \w contra ela|strong="G1537,G846"\w*\f + \fr 18.20: \ft Lit.: ἔκρινεν… τὸ κρίμα ὑμῶν ἐξ αὐτῆς, literalmente “julgou o julgamento de vocês contra ela”: Deus deu a sentença que vocês reclamavam.\f*!”\x - \xo 18:20 \xt ISA 49:25; EPH 4:11; PRO 24:16; REV 12:12; LUK 18:7; PSA 5:11\x*
\v 21 \w E|strong="G2532"\w* \w um anjo|strong="G1520,G32"\w* \w forte|strong="G2478"\w* \w levantou|strong="G142"\w* \w uma pedra|strong="G3037"\w* \w como uma mó|strong="G5613,G6061"\w* \w grande|strong="G3173"\w*, \w e|strong="G2532"\w* \w a lançou|strong="G906"\w* \w no mar|strong="G1519,G3588,G2281"\w*, \w dizendo|strong="G3004"\w*: “\w Assim|strong="G3779"\w* \w com violência|strong="G3731"\w* \w será lançada|strong="G906"\w* \w Babilônia|strong="G897"\w*, \w a grande cidade|strong="G3588,G3173,G4172"\w*, \w e|strong="G2532"\w* \w de modo algum|strong="G3756,G3361"\w* \w será achada|strong="G2147"\w* \w mais|strong="G2089"\w*.\f + \fr 18.21: \ft Nota cultural: a pedra de moinho lançada ao mar ecoa Jr 51:63-64 (o livro lançado no Eufrates como sinal da queda de Babilônia).\f*\f + \fr 18.21: \ft Variante: Treg e o RP trazem μύλον (“mó”) em lugar de μύλινον (“de mó”).\f*\x - \xo 18:21 \xt JER 51:63; PRO 24:16; EZK 26:21; REV 19:1; REV 16:19; REV 11:8\x*
\v 22 \w E|strong="G2532"\w* \w som|strong="G5456"\w* \w de harpistas|strong="G2790"\w* \w e|strong="G2532"\w* \w de músicos|strong="G3451"\w* \w e|strong="G2532"\w* \w de flautistas|strong="G834"\w* \w e|strong="G2532"\w* \w de trombeteiros|strong="G4538"\w* \w de modo algum|strong="G3756,G3361"\w* \w será ouvido|strong="G191"\w* \w em você|strong="G1722,G4771"\w* \w mais|strong="G2089"\w*, \w e|strong="G2532"\w* \w todo artífice|strong="G3956,G5079"\w* \w de qualquer arte|strong="G3956,G5078"\w* \w de modo algum|strong="G3756,G3361"\w* \w será achado|strong="G2147"\w* \w em você|strong="G1722,G4771"\w* \w mais|strong="G2089"\w*, \w e|strong="G2532"\w* \w o som|strong="G5456"\w* \w de moinho|strong="G3458"\w* \w de modo algum|strong="G3756,G3361"\w* \w será ouvido|strong="G191"\w* \w em você|strong="G1722,G4771"\w* \w mais|strong="G2089"\w*,\x - \xo 18:22 \xt EZK 26:13; JER 25:10; REV 19:1; REV 18:23; ISA 14:23; ISA 23:12\x*
\v 23 \w e|strong="G2532"\w* \w a luz|strong="G5457"\w* \w de lâmpada|strong="G3088"\w* \w de modo algum|strong="G3756,G3361"\w* \w brilhará|strong="G5316"\w* \w em você|strong="G1722,G4771"\w* \w mais|strong="G2089"\w*, \w e|strong="G2532"\w* \w a voz|strong="G5456"\w* \w de noivo|strong="G3566"\w* \w e|strong="G2532"\w* \w de noiva|strong="G3565"\w* \w de modo algum|strong="G3756,G3361"\w* \w será ouvida|strong="G191"\w* \w em você|strong="G1722,G4771"\w* \w mais|strong="G2089"\w*; \w porque|strong="G3754"\w* \w os seus comerciantes|strong="G3588,G1713,G4771"\w* \w eram|strong="G1510"\w* \w os grandes|strong="G3588,G3175"\w* \w da terra|strong="G3588,G1093"\w*, \w porque|strong="G3754"\w* \w pela sua feitiçaria|strong="G1722,G3588,G5331,G4771"\w* \w foram enganadas|strong="G4105"\w* \w todas as nações|strong="G3956,G3588,G1484"\w*,\f + \fr 18.23: \ft Nota cultural: o fim da música, do moinho, da lâmpada e da voz de noivo e noiva reproduz o silêncio descrito em Jr 25:10.\f*\x - \xo 18:23 \xt JER 25:10; REV 18:3; ISA 23:8; NAM 3:4; JER 7:34; REV 22:15\x*
\v 24 \w e|strong="G2532"\w* \w nela|strong="G1722,G846"\w* \w foi achado|strong="G2147"\w* \w sangue|strong="G129"\w* \w de profetas|strong="G4396"\w* \w e|strong="G2532"\w* \w de santos|strong="G40"\w* \w e|strong="G2532"\w* \w de todos os que|strong="G3956,G3588"\w* \w foram imolados|strong="G4969"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*.”\f + \fr 18.24: \ft Variante: o RP traz o plural αἵματα (“sangues”) em lugar de αἷμα.\f*\x - \xo 18:24 \xt REV 16:6; REV 17:6; DAN 7:25; MAT 23:35; REV 19:1; JER 51:49\x*
\c 19
\p
\v 1 \w Depois disto|strong="G3326,G3778"\w* \w ouvi|strong="G191"\w* \w como que|strong="G5613"\w* \w uma grande|strong="G3173"\w* \w voz|strong="G5456"\w* \w de uma grande|strong="G4183"\w* \w multidão|strong="G3793"\w* \w no céu|strong="G1722,G3588,G3772"\w*, \w dizendo|strong="G3004"\w*: “\w Aleluia|strong="G239"\w*! \w A salvação|strong="G3588,G4991"\w* \w e|strong="G2532"\w* \w a glória|strong="G3588,G1391"\w* \w e|strong="G2532"\w* \w o poder|strong="G3588,G1411"\w* \add pertencem\add* \w ao nosso Deus|strong="G3588,G2316,G3165"\w*,\f + \fr 19.1: \ft Lit.: Ἁλληλουϊά, do hebraico hallelû-yāh, “louvem a Yah (o Senhor)”; aparece só aqui no NT (19:1, 3, 4, 6).\f*\f + \fr 19.1: \ft Variante: o TR acrescenta “Senhor” (κυρίῳ) antes de “nosso Deus” e “e a honra” (καὶ ἡ τιμή) depois de “poder”; o RP inverte “poder” e “glória”.\f*\f + \fr 19.1: \ft Acréscimo: “pertencem” (em “o poder pertencem ao nosso”): verbo acrescentado: o grego traz a frase sem verbo (construção nominal ou elíptica) e o português exige um, tomado do contexto.\f*\x - \xo 19:1 \xt REV 7:10; REV 19:6; REV 12:10; PSA 62:11; PSA 96:7; PSA 5:11\x*
\v 2 \w porque|strong="G3754"\w* \w verdadeiros|strong="G228"\w* \w e|strong="G2532"\w* \w justos|strong="G1342"\w* \w são os julgamentos|strong="G3588,G2920"\w* \w dele|strong="G846"\w*; \w porque|strong="G3754"\w* \w julgou|strong="G2919"\w* \w a grande prostituta|strong="G3588,G4204,G3173"\w*, \w a que corrompia|strong="G3748,G5351"\w* \w a terra|strong="G3588,G1093"\w* \w com a sua prostituição|strong="G1722,G3588,G4202,G846"\w*, \w e|strong="G2532"\w* \w vingou|strong="G1556"\w* \w o sangue|strong="G3588,G129"\w* \w dos servos|strong="G3588,G1401"\w* \w dele|strong="G846"\w* \w da mão|strong="G1537,G5495"\w* \w dela|strong="G846"\w*.”\f + \fr 19.2: \ft Variante: o RP traz διέφθειρεν (“corrompia”, outra forma do mesmo verbo) em lugar de ἔφθειρεν.\f*\f + \fr 19.2: \ft Acréscimo: verbo ser/estar suprido em “são os julgamentos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\f + \fr 19.2: \ft Tradução: δούλων (δοῦλος, G1401) está aqui como “dos servos”; o termo pode ser “escravo” (condição social), “servo” ou “servidor”, e o contexto decide.\f*\x - \xo 19:2 \xt REV 6:10; REV 16:7; PSA 5:11; EXO 15:11; ISA 55:12; REV 15:4\x*
\v 3 \w E|strong="G2532"\w* \w pela segunda vez|strong="G1208"\w* \w disseram|strong="G2046"\w*: “\w Aleluia|strong="G239"\w*! \w E|strong="G2532"\w* \w a fumaça|strong="G3588,G2586"\w* \w dela|strong="G846"\w* \w sobe|strong="G305"\w* \w para os séculos|strong="G1519,G3588,G165"\w* \w dos séculos|strong="G3588,G165"\w*.”\f + \fr 19.3: \ft Nota cultural: a fumaça que sobe para sempre ecoa Is 34:10.\f*\f + \fr 19.3: \ft Variante: o RP traz o singular εἴρηκεν (“disse”) em lugar de εἴρηκαν.\f*\x - \xo 19:3 \xt ISA 34:10; REV 14:11; PSA 5:11; EXO 15:11; ISA 55:12; REV 19:1\x*
\v 4 \w e|strong="G2532"\w* \w caíram|strong="G4098"\w* \w os vinte e quatro|strong="G3588,G1501,G5064"\w* \w anciãos|strong="G4245"\w* \w e|strong="G2532"\w* \w os quatro|strong="G3588,G5064"\w* \w seres vivos|strong="G2226"\w*, \w e|strong="G2532"\w* \w adoraram|strong="G4352"\w* \w a Deus|strong="G3588,G2316"\w*, \w o que está sentado|strong="G3588,G2521"\w* \w sobre o trono|strong="G1909,G3588,G2362"\w*, \w dizendo|strong="G3004"\w*: “\w Amém|strong="G281"\w*, \w Aleluia|strong="G239"\w*!”\f + \fr 19.4: \ft Variante: o RP traz “do trono” (τοῦ θρόνου) em lugar de τῷ θρόνῳ.\f*\x - \xo 19:4 \xt REV 5:14; REV 4:10; REV 11:16; REV 7:11; REV 5:8; REV 4:4\x*
\v 5 \w E|strong="G2532"\w* \w uma voz|strong="G5456"\w* \w saiu|strong="G1831"\w* \w do trono|strong="G575,G3588,G2362"\w*, \w dizendo|strong="G3004"\w*: “\w Louvem|strong="G134"\w* \w o nosso Deus|strong="G3588,G2316,G3165"\w*, \w todos|strong="G3956"\w* \w os seus servos|strong="G3588,G1401,G846"\w*, \w e|strong="G2532"\w* \w os que o temem|strong="G3588,G5399,G846"\w*, \w os pequenos|strong="G3588,G3398"\w* \w e|strong="G2532"\w* \w os grandes|strong="G3588,G3173"\w*.”\f + \fr 19.5: \ft Variante: o RP traz o acusativo τὸν θεόν (“a Deus”) em lugar do dativo; Treg, NA28 e o RP acrescentam “e” (καί) antes de “os que o temem”.\f*\f + \fr 19.5: \ft Tradução: δοῦλοι (δοῦλος, G1401) está aqui como “os seus servos”; o termo pode ser “escravo” (condição social), “servo” ou “servidor”, e o contexto decide.\f*\x - \xo 19:5 \xt REV 20:12; PSA 5:11; PSA 34:3; ECC 12:13; EXO 15:11; ISA 55:12\x*
\v 6 \w e|strong="G2532"\w* \w ouvi|strong="G191"\w* \w como a voz|strong="G5613,G5456"\w* \w de uma grande|strong="G4183"\w* \w multidão|strong="G3793"\w* \w e|strong="G2532"\w* \w como a voz|strong="G5613,G5456"\w* \w de muitas|strong="G4183"\w* \w águas|strong="G5204"\w* \w e|strong="G2532"\w* \w como a voz|strong="G5613,G5456"\w* \w de fortes|strong="G2478"\w* \w trovões|strong="G1027"\w*, \w dizendo|strong="G3004"\w*: “\w Aleluia|strong="G239"\w*, \w porque|strong="G3754"\w* \w reinou|strong="G936"\w* \w o Senhor|strong="G2962"\w*, \w Deus|strong="G3588,G2316"\w*, \w o Todo-Poderoso|strong="G3588,G3841"\w*.\f + \fr 19.6: \ft Variante: WH, Treg, NA28 e o RP acrescentam “nosso” (ἡμῶν) depois de “Deus”; o RP traz λέγοντες (“dizendo”, nominativo).\f*\x - \xo 19:6 \xt REV 19:1; REV 11:17; PSA 5:11; PSA 34:3; EZK 1:24; EXO 15:11\x*
\v 7 \w Alegremo-nos|strong="G5463"\w* \w e|strong="G2532"\w* \w exultemos|strong="G21"\w*, \w e|strong="G2532"\w* \w daremos|strong="G1325"\w* \w a glória|strong="G3588,G1391"\w* \w a ele|strong="G846"\w*, \w porque|strong="G3754"\w* \w chegaram|strong="G2064"\w* \w as bodas|strong="G3588,G1062"\w* \w do cordeiro|strong="G3588,G721"\w*, \w e|strong="G2532"\w* \w a esposa|strong="G3588,G1135"\w* \w dele|strong="G846"\w* \w se preparou|strong="G2090,G1438"\w*,\f + \fr 19.7: \ft Lit.: Γάμος, “casamento, festa de casamento”; ἀγαλλιάω, “exultar, rejubilar-se”.\f*\f + \fr 19.7: \ft Variante: NA28 traz o subjuntivo δώσωμεν (“demos”); Treg e o RP trazem δῶμεν; o RP traz ἀγαλλιώμεθα (“exultemos”).\f*\x - \xo 19:7 \xt REV 19:9; JHN 8:56; MAT 25:1; ISA 61:10; PSA 5:11; REV 21:9\x*
\v 8 \w e|strong="G2532"\w* \w foi dado|strong="G1325"\w* \w a ela|strong="G846"\w* \w que se vista|strong="G2443,G4016"\w* \w de linho fino|strong="G1039"\w* \w brilhante|strong="G2986"\w* \w e puro|strong="G2513"\w*; \w pois|strong="G1063"\w* \w o linho fino|strong="G3588,G1039"\w* \w são|strong="G1510"\w* \w as ações justas|strong="G3588,G1345"\w* \w dos santos|strong="G3588,G40"\w*.”\f + \fr 19.8: \ft Lit.: ἐστίν (singular) com o predicado plural τὰ δικαιώματα (“as ações justas”): em português o verbo concorda com o predicado plural (“são”).\f*\f + \fr 19.8: \ft Lit.: Δικαίωμα, “ato justo, decreto justo”; aqui, as ações justas dos santos, que formam a veste da esposa.\f*\f + \fr 19.8: \ft Variante: o RP acrescenta “e” (καί) depois de “brilhante”.\f*\x - \xo 19:8 \xt REV 19:14; ISA 61:10; REV 3:18; REV 7:13-14; EPH 5:26-27; JHN 3:29\x*
\v 9 \w E|strong="G2532"\w* \w me disse|strong="G3004,G3165"\w*: “\w Escreva|strong="G1125"\w*: \w Felizes|strong="G3107"\w* \w os que foram chamados|strong="G3588,G2564"\w* \w para a ceia|strong="G1519,G3588,G1173"\w* \w das bodas|strong="G3588,G1062"\w* \w do cordeiro|strong="G3588,G721"\w*.” \w E|strong="G2532"\w* \w me disse|strong="G3004,G3165"\w*: “\w Estas|strong="G3778"\w* \w são|strong="G1510"\w* \w as palavras|strong="G3588,G3056"\w* \w verdadeiras|strong="G228"\w* \w de Deus|strong="G3588,G2316"\w*.”\f + \fr 19.9: \ft Lit.: Δεῖπνον, “ceia, refeição principal, banquete”.\f*\x - \xo 19:9 \xt REV 19:7; JHN 2:2; REV 3:20; JHN 1:29; MAT 5:3; REV 21:5\x*
\v 10 \w E|strong="G2532"\w* \w caí|strong="G4098"\w* \w diante|strong="G1715"\w* \w dos pés|strong="G3588,G4228"\w* \w dele|strong="G846"\w* \w para adorá-lo|strong="G4352,G846"\w*. \w E|strong="G2532"\w* \w me disse|strong="G3004,G3165"\w*: “\w Cuidado|strong="G3708"\w*, \w não|strong="G3361"\w* \add faça isso!\add* \w Sou conservo|strong="G4889,G1510"\w* \w seu|strong="G4771"\w* \w e|strong="G2532"\w* \w dos seus|strong="G3588,G4771"\w* \w irmãos e irmãs|strong="G80"\w* \w que têm|strong="G3588,G2192"\w* \w o testemunho|strong="G3588,G3141"\w* \w de Jesus|strong="G2424"\w*; \w adore|strong="G4352"\w* \w a Deus|strong="G3588,G2316"\w*. \w Pois|strong="G1063"\w* \w o testemunho|strong="G3588,G3141"\w* \w de Jesus|strong="G2424"\w* \w é|strong="G1510"\w* \w o espírito|strong="G3588,G4151"\w* \w da profecia|strong="G3588,G4394"\w*\f + \fr 19.10: \ft Variante: o RP acrescenta “o” (τοῦ) antes de “Jesus” na segunda ocorrência.\f*\f + \fr 19.10: \ft Nota cultural: o anjo recusa a adoração e se coloca no mesmo nível dos que testemunham de Jesus (cf. 22:8-9).\f*\f + \fr 19.10: \ft Lit.: o genitivo em “o testemunho de Jesus” é ambíguo: pode ser o testemunho dado por Jesus ou o testemunho a respeito de Jesus; σύνδουλος, “companheiro de escravidão, co-escravo”.\f*.”\f + \fr 19.10: \ft Acréscimo: “faça” (em “Cuidado não faça isso Sou”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; “isso” (em “não faça isso Sou conservo”): demonstrativo acrescentado para retomar o que foi dito.\f*\x - \xo 19:10 \xt REV 22:8; REV 22:9; MAT 4:9; ACT 10:25; LUK 24:44; 2PE 1:21\x*
\p
\v 11 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w o céu|strong="G3588,G3772"\w* \w aberto|strong="G455"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w um cavalo|strong="G2462"\w* \w branco|strong="G3022"\w*, \w e|strong="G2532"\w* \w o que está sentado|strong="G3588,G2521"\w* \w sobre ele|strong="G1909,G846"\w* \w chamado|strong="G2564"\w* \w Fiel|strong="G4103"\w* \w e|strong="G2532"\w* \w Verdadeiro|strong="G228"\w*, \w e|strong="G2532"\w* \w com justiça|strong="G1722,G1343"\w* \w julga|strong="G2919"\w* \w e|strong="G2532"\w* \w guerreia|strong="G4170"\w*.\f + \fr 19.11: \ft Nota cultural: “Fiel e Verdadeiro” retoma o título de Cristo em 3:14.\f*\f + \fr 19.11: \ft Variante: WH e Treg trazem “Fiel chamado” (πιστὸς καλούμενος); NA28 e o RP trazem “chamado Fiel” em ordem diferente.\f*\x - \xo 19:11 \xt REV 6:2; JHN 14:6; PSA 96:13; 1CO 10:13; EXO 15:3; ISA 11:3-5\x*
\v 12 \w Os olhos|strong="G3588,G3788"\w* \w dele|strong="G846"\w* \add são\add* \w uma chama|strong="G5395"\w* \w de fogo|strong="G4442"\w*, \w e|strong="G2532"\w* \w sobre a cabeça|strong="G1909,G3588,G2776"\w* \w dele|strong="G846"\w* \w muitos diademas|strong="G1238,G4183"\w*, \w tendo|strong="G2192"\w* \w um nome|strong="G3686"\w* \w escrito|strong="G1125"\w* \w que|strong="G3739"\w* \w ninguém|strong="G3762"\w* \w conhece|strong="G6063"\w*, \w a não ser|strong="G1487,G3361"\w* \w ele mesmo|strong="G846"\w*\f + \fr 19.12: \ft Variante: NA28 acrescenta “como” (ὡς) antes de “chama”; o RP acrescenta “nomes escritos e” (ὀνόματα γεγραμμένα καί) depois de “tendo”.\f*\f + \fr 19.12: \ft Nota cultural: os olhos como chama de fogo retomam 1:14 e 2:18.\f*,\f + \fr 19.12: \ft Acréscimo: “são” (em “olhos dele são uma chama”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 19:12 \xt REV 1:14; REV 2:17; EXO 15:3; REV 19:16; LUK 10:22; DAN 10:6\x*
\v 13 \w e|strong="G2532"\w* \w vestido|strong="G4016"\w* \w de um manto|strong="G2440"\w* \w banhado|strong="G911"\w* \w em sangue|strong="G129"\w*, \w e|strong="G2532"\w* \w o seu nome|strong="G3588,G3686,G846"\w* \w é chamado|strong="G2564"\w*: \w A Palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 19.13: \ft Lit.: Λόγος, “palavra, razão”: título de Cristo em Jo 1:1, 14; βάπτω, “mergulhar, banhar”.\f*\f + \fr 19.13: \ft Nota cultural: o manto banhado em sangue ecoa Is 63:1-3.\f*\f + \fr 19.13: \ft Variante: WH traz ῥεραντισμένον (“respingado”) em lugar de βεβαμμένον (“banhado”); o RP traz καλεῖται (“é chamado”) em lugar de κέκληται.\f*\x - \xo 19:13 \xt JHN 1:1; ISA 63:1; REV 19:16; ISA 63:3; ISA 63:2; REV 2:17\x*
\v 14 \w E|strong="G2532"\w* \w os exércitos|strong="G3588,G4753"\w* \w que estão|strong="G3588"\w* \w no céu|strong="G1722,G3588,G3772"\w* \w o seguiam|strong="G190,G846"\w* \w sobre cavalos|strong="G1909,G2462"\w* \w brancos|strong="G3022"\w*, \w vestidos|strong="G1746"\w* \w de linho fino|strong="G1039"\w* \w branco|strong="G3022"\w* \w puro|strong="G2513"\w*.\f + \fr 19.14: \ft Acréscimo: “que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 19:14 \xt REV 19:8; REV 19:19; ISA 63:3; EXO 15:3; 2KI 6:17; JUD 1:14\x*
\v 15 \w E|strong="G2532"\w* \w da boca|strong="G1537,G3588,G4750"\w* \w dele|strong="G846"\w* \w sai|strong="G1607"\w* \w uma espada|strong="G4501"\w* \w afiada|strong="G3691"\w*, \w para que|strong="G2443"\w* \w com ela|strong="G1722,G846"\w* \w fira|strong="G3960"\w* \w as nações|strong="G3588,G1484"\w*, \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w as pastoreará|strong="G4165,G846"\w* \w com vara|strong="G1722,G4464"\w* \w de ferro|strong="G4603"\w*; \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w pisa|strong="G3961"\w* \w o lagar|strong="G3588,G3025"\w* \w do vinho|strong="G3588,G3631"\w* \w do furor|strong="G3588,G2372"\w* \w da ira|strong="G3588,G3709"\w* \w de Deus|strong="G3588,G2316"\w*, \w o Todo-Poderoso|strong="G3588,G3841"\w*.\f + \fr 19.15: \ft Lit.: Ῥομφαία, “espada longa”.\f*\f + \fr 19.15: \ft Nota cultural: a espada que sai da boca, a vara de ferro e o lagar da ira ecoam Is 11:4, Sl 2:9 e Is 63:3.\f*\f + \fr 19.15: \ft Variante: o RP acrescenta “de dois gumes” (δίστομος) depois de “espada”.\f*\x - \xo 19:15 \xt ISA 63:3; ISA 11:4; PSA 2:9; REV 2:27; REV 12:5; HEB 4:12\x*
\v 16 \w E|strong="G2532"\w* \w tem|strong="G2192"\w* \w sobre o manto|strong="G1909,G3588,G2440"\w* \w e|strong="G2532"\w* \w sobre a coxa|strong="G1909,G3588,G3382"\w* \w dele|strong="G846"\w* \w um nome|strong="G3686"\w* \w escrito|strong="G1125"\w*: \w Rei|strong="G935"\w* \w de reis|strong="G935"\w* \w e|strong="G2532"\w* \w Senhor|strong="G2962"\w* \w de senhores|strong="G2962"\w*.\x - \xo 19:16 \xt ISA 9:6; PHP 2:9; REV 17:14; 1TI 6:15; MAT 28:18; EXO 15:3\x*
\p
\v 17 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w um anjo|strong="G1520,G32"\w* \w de pé|strong="G2476"\w* \w no sol|strong="G1722,G3588,G2246"\w*, \w e|strong="G2532"\w* \w clamou|strong="G2896"\w* \w em voz|strong="G5456"\w* \w grande|strong="G3173"\w*, \w dizendo|strong="G3004"\w* \w a todas as aves|strong="G3956,G3588,G3732"\w* \w que voam|strong="G3588,G4072"\w* \w no meio do céu|strong="G1722,G3321"\w*: “\w Venham|strong="G1205"\w*, \w reúnam-se|strong="G4863"\w* \w para a grande ceia|strong="G1519,G3588,G1173,G3173"\w* \w de Deus|strong="G3588,G2316"\w*,\f + \fr 19.17: \ft Nota cultural: o convite às aves para o banquete sobre os mortos ecoa Ez 39:17-20.\f*\f + \fr 19.17: \ft Variante: WH e NA28 acrescentam “em” (ἐν) antes de “voz”; o RP omite “um” (ἕνα) antes de “anjo”.\f*\x - \xo 19:17 \xt EZK 39:17; REV 8:13; ZEP 3:19; EXO 15:3; REV 17:14; PSA 24:8\x*
\v 18 \w para que|strong="G2443"\w* \w comam|strong="G5315"\w* \w carnes|strong="G4561"\w* \w de reis|strong="G935"\w* \w e|strong="G2532"\w* \w carnes|strong="G4561"\w* \w de comandantes|strong="G5506"\w* \w e|strong="G2532"\w* \w carnes|strong="G4561"\w* \w de poderosos|strong="G2478"\w* \w e|strong="G2532"\w* \w carnes|strong="G4561"\w* \w de cavalos|strong="G2462"\w* \w e|strong="G2532"\w* \w dos que estão sentados|strong="G3588,G2521"\w* \w sobre eles|strong="G1909,G846"\w*, \w e|strong="G2532"\w* \w carnes|strong="G4561"\w* \w de todos|strong="G3956"\w*, \w livres|strong="G1658"\w* \w e|strong="G5037,G2532"\w* \w escravos|strong="G1401"\w*, \w e|strong="G2532"\w* \w pequenos|strong="G3398"\w* \w e|strong="G2532"\w* \w grandes|strong="G3173"\w*.”\f + \fr 19.18: \ft Variante: WH e Treg trazem αὐτούς (acusativo) em lugar de αὐτῶν; o RP traz “tanto livres como escravos” (τε καὶ) com a partícula adicional.\f*\x - \xo 19:18 \xt REV 6:15; REV 13:16; ZEP 3:19; EXO 15:3; EZK 39:17; REV 17:14\x*
\v 19 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w a fera|strong="G3588,G2342"\w* \w e|strong="G2532"\w* \w os reis|strong="G3588,G935"\w* \w da terra|strong="G3588,G1093"\w* \w e|strong="G2532"\w* \w os exércitos|strong="G3588,G4753"\w* \w deles|strong="G846"\w* \w reunidos|strong="G4863"\w* \w para fazer|strong="G4160"\w* \w a guerra|strong="G3588,G4171"\w* \w contra o que está sentado|strong="G3326,G3588,G2521"\w* \w sobre o cavalo|strong="G1909,G3588,G2462"\w* \w e|strong="G2532"\w* \w contra o exército|strong="G3326,G3588,G4753"\w* \w dele|strong="G846"\w*.\x - \xo 19:19 \xt REV 16:14; ZEP 3:19; EXO 15:3; JER 1:10; REV 17:14; PSA 24:8\x*
\v 20 \w E|strong="G2532"\w* \w foi capturada|strong="G4084"\w* \w a fera|strong="G3588,G2342"\w*, \w e|strong="G2532"\w* \w com ela|strong="G3326,G846"\w* \w o falso profeta|strong="G3588,G5578"\w*, \w o que fez|strong="G3588,G4160"\w* \w os sinais|strong="G3588,G4592"\w* \w diante dela|strong="G1799,G846"\w*, \w com os quais|strong="G1722,G3739"\w* \w enganou|strong="G4105"\w* \w os que receberam|strong="G3588,G2983"\w* \w a marca|strong="G3588,G5480"\w* \w da fera|strong="G3588,G2342"\w* \w e|strong="G2532"\w* \w os que adoravam|strong="G3588,G4352"\w* \w a sua imagem|strong="G3588,G1504,G846"\w*; \w vivos|strong="G2198"\w* \w foram lançados|strong="G906"\w* \w os dois|strong="G3588,G1417"\w* \w no lago|strong="G1519,G3588,G3041"\w* \w do fogo|strong="G3588,G4442"\w* \w que arde|strong="G3588,G2545"\w* \w com enxofre|strong="G1722,G2303"\w*.\f + \fr 19.20: \ft Lit.: Ἐπιάσθη (de πιάζω), “foi preso, foi capturado”.\f*\f + \fr 19.20: \ft Nota cultural: a fera lançada viva no fogo ecoa Dn 7:11.\f*\x - \xo 19:20 \xt DAN 7:11; REV 20:10; REV 13:14; MAT 24:11; REV 13:15; ZEP 3:19\x*
\v 21 \w E|strong="G2532"\w* \w os restantes|strong="G3588,G3062"\w* \w foram mortos|strong="G615"\w* \w com a espada|strong="G1722,G3588,G4501"\w* \w do que está sentado|strong="G3588,G2521"\w* \w sobre o cavalo|strong="G1909,G3588,G2462"\w*, \w a que saiu|strong="G3588,G1831"\w* \w da boca|strong="G1537,G3588,G4750"\w* \w dele|strong="G846"\w*; \w e|strong="G2532"\w* \w todas as aves|strong="G3956,G3588,G3732"\w* \w se fartaram|strong="G5526"\w* \w das carnes|strong="G1537,G3588,G4561"\w* \w deles|strong="G846"\w*.\x - \xo 19:21 \xt HEB 4:12; ZEP 3:19; EXO 15:3; 2TH 2:8; JER 1:10; REV 1:16\x*
\c 20
\p
\v 1 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w um anjo|strong="G32"\w* \w descendo|strong="G2597"\w* \w do céu|strong="G1537,G3588,G3772"\w*, \w tendo|strong="G2192"\w* \w a chave|strong="G3588,G2807"\w* \w do abismo|strong="G3588,G12"\w* \w e|strong="G2532"\w* \w uma grande|strong="G3173"\w* \w corrente|strong="G254"\w* \w na mão|strong="G1909,G3588,G5495"\w* \w dele|strong="G846"\w*.\x - \xo 20:1 \xt REV 9:1; 2PE 2:4; PSA 91:13; REV 1:18; MRK 3:27; GEN 3:15\x*
\v 2 \w E|strong="G2532"\w* \w prendeu|strong="G2902"\w* \w o dragão|strong="G3588,G1404"\w*, \w a antiga serpente|strong="G3588,G3789,G744"\w*, \w que é|strong="G3739,G1510"\w* \w o Diabo|strong="G1228"\w* \w e|strong="G2532"\w* \w Satanás|strong="G3588,G4567"\w*, \w e|strong="G2532"\w* \w o amarrou|strong="G1210,G846"\w* \w por mil|strong="G5507"\w* \w anos|strong="G2094"\w*,\f + \fr 20.2: \ft Variante: o RP traz o acusativo τὸν ὄφιν τὸν ἀρχαῖον (“a antiga serpente”) e acrescenta “o que engana o mundo todo” (ὁ πλανῶν τὴν οἰκουμένην ὅλην) depois de “Satanás”.\f*\x - \xo 20:2 \xt REV 12:9; REV 20:7; GEN 3:1; EPH 6:11; LUK 10:18; 2CO 4:4\x*
\v 3 \w e|strong="G2532"\w* \w o lançou|strong="G906,G846"\w* \w no abismo|strong="G1519,G3588,G12"\w*, \w e|strong="G2532"\w* \w fechou|strong="G2808"\w* \w e|strong="G2532"\w* \w selou|strong="G4972"\w* \w sobre ele|strong="G1883,G846"\w*, \w para que|strong="G2443"\w* \w não|strong="G3361"\w* \w engane|strong="G4105"\w* \w mais|strong="G2089"\w* \w as nações|strong="G3588,G1484"\w*, \w até que|strong="G891"\w* \w se completem|strong="G5055"\w* \w os mil|strong="G3588,G5507"\w* \w anos|strong="G2094"\w*; \w depois disto|strong="G3326,G3778"\w* \w é necessário|strong="G1163"\w* \w que ele seja solto|strong="G3089,G846"\w* \w por um pouco de|strong="G3398"\w* \w tempo|strong="G5550"\w*.\f + \fr 20.3: \ft Variante: o RP traz o presente πλανᾷ (“engane”) em lugar de πλανήσῃ, acrescenta “e” (καί) antes de “depois disto” e inverte “solto ele”.\f*\x - \xo 20:3 \xt REV 20:7; EPH 6:11; 2CO 4:4; 2PE 2:4; MRK 3:27; MAT 7:13\x*
\v 4 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w tronos|strong="G2362"\w*, \w e|strong="G2532"\w* \w se assentaram|strong="G2523"\w* \w sobre eles|strong="G1909,G846"\w*, \w e|strong="G2532"\w* \w o julgamento|strong="G2917"\w* \w foi dado|strong="G1325"\w* \w a eles|strong="G846"\w*; \w e|strong="G2532"\w* \w as almas|strong="G3588,G5590"\w* \w dos que foram decapitados|strong="G3588,G3990"\w* \w por causa do testemunho|strong="G1223,G3588,G3141"\w* \w de Jesus|strong="G2424"\w* \w e|strong="G2532"\w* \w por causa da palavra|strong="G1223,G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w*, \w e|strong="G2532"\w* \w os que|strong="G3748"\w* \w não|strong="G3756"\w* \w adoraram|strong="G4352"\w* \w a fera|strong="G3588,G2342"\w* \w nem|strong="G3761"\w* \w a sua imagem|strong="G3588,G1504,G846"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w receberam|strong="G2983"\w* \w a marca|strong="G3588,G5480"\w* \w sobre a testa|strong="G1909,G3588,G3359"\w* \w e|strong="G2532"\w* \w sobre a mão|strong="G1909,G3588,G5495"\w* \w deles|strong="G846"\w*; \w e|strong="G2532"\w* \w viveram|strong="G2198"\w* \w e|strong="G2532"\w* \w reinaram|strong="G936"\w* \w com o Cristo|strong="G3326,G3588,G5547"\w* \w por mil|strong="G5507"\w* \w anos|strong="G2094"\w*.\f + \fr 20.4: \ft Lit.: Πελεκίζω, “decapitar com machado”; κρίμα, “julgamento, autoridade de julgar”; ψυχή, “alma, vida”.\f*\f + \fr 20.4: \ft Nota cultural: os tronos e o julgamento dado aos santos ecoam Dn 7:9, 22 e 27.\f*\f + \fr 20.4: \ft Variante: o RP traz o artigo τά antes de “mil” (τὰ χίλια).\f*\f + \fr 20.4: \ft Lit.: Ἔζησαν (aoristo): “viveram” ou, entendido como começo de ação, “voltaram a viver”; o mesmo vale para “não viveram” (οὐκ ἔζησαν) no v. 5.\f*\x - \xo 20:4 \xt DAN 7:9; REV 13:15; REV 14:11; REV 14:9; HEB 4:12; EZK 9:4\x*
\v 5 \w Os restantes|strong="G3588,G3062"\w* \w dos mortos|strong="G3588,G3498"\w* \w não|strong="G3756"\w* \w viveram|strong="G2198"\w* \w até que|strong="G891"\w* \w se completassem|strong="G5055"\w* \w os mil|strong="G3588,G5507"\w* \w anos|strong="G2094"\w*. \w Esta|strong="G3778"\w* \add é\add* \w a primeira ressurreição|strong="G3588,G386,G4413"\w*.\f + \fr 20.5: \ft Lit.: Ἔζησαν (aoristo), “viveram, voltaram à vida” (o mesmo verbo do v. 4); ἀνάστασις, “ressurreição, levantamento”.\f*\f + \fr 20.5: \ft Variante: o TR traz ἀνέζησαν (“tornaram a viver”) em lugar de ἔζησαν; Treg e o RP acrescentam “e” (καί) no começo.\f*\f + \fr 20.5: \ft Acréscimo: “é” (em “anos Esta é a primeira”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 20:5 \xt JHN 11:25; 1TH 4:16; REV 20:6; PHP 3:11; ISA 26:19; REV 11:18\x*
\v 6 \w Feliz|strong="G3107"\w* \w e|strong="G2532"\w* \w santo|strong="G40"\w* \w o que tem|strong="G3588,G2192"\w* \w parte|strong="G3313"\w* \w na primeira ressurreição|strong="G1722,G3588,G386,G4413"\w*; \w sobre estes|strong="G1909,G3778"\w* \w a segunda morte|strong="G3588,G1208,G2288"\w* \w não|strong="G3756"\w* \w tem|strong="G2192"\w* \w autoridade|strong="G1849"\w*, \w mas|strong="G235"\w* \w serão|strong="G1510"\w* \w sacerdotes|strong="G2409"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w do Cristo|strong="G3588,G5547"\w*, \w e|strong="G2532"\w* \w reinarão|strong="G936"\w* \w com ele|strong="G3326,G846"\w* \w por mil|strong="G5507"\w* \w anos|strong="G2094"\w*.\f + \fr 20.6: \ft Nota cultural: os santos como “sacerdotes” e “reino” retomam 1:6 e 5:10 (cf. Êx 19:6).\f*\x - \xo 20:6 \xt EXO 19:6; REV 5:10; 1PE 2:9; REV 1:6; REV 14:13; 1PE 2:5\x*
\v 7 \w E|strong="G2532"\w* \w quando|strong="G3752"\w* \w se completarem|strong="G5055"\w* \w os mil|strong="G3588,G5507"\w* \w anos|strong="G2094"\w*, \w será solto|strong="G3089"\w* \w Satanás|strong="G3588,G4567"\w* \w da sua prisão|strong="G1537,G3588,G5438,G846"\w*,\x - \xo 20:7 \xt REV 20:3; REV 20:2; JHN 8:44; EPH 6:11; MAT 12:29; 1JN 5:19\x*
\v 8 \w e|strong="G2532"\w* \w sairá|strong="G1831"\w* \w para enganar|strong="G4105"\w* \w as nações|strong="G3588,G1484"\w* \w que estão|strong="G3588"\w* \w nos quatro|strong="G1722,G3588,G5064"\w* \w cantos|strong="G1137"\w* \w da terra|strong="G3588,G1093"\w*, \w Gogue|strong="G3588,G1136"\w* \w e|strong="G2532"\w* \w Magogue|strong="G3098"\w*, \w para reuni-los|strong="G4863,G846"\w* \w para a guerra|strong="G1519,G3588,G4171"\w*, \w dos quais|strong="G3739"\w* \w o número|strong="G3588,G706"\w* \w deles|strong="G846"\w* \w é como|strong="G5613"\w* \w a areia|strong="G3588,G285"\w* \w do mar|strong="G3588,G2281"\w*.\f + \fr 20.8: \ft Nota cultural: Gogue e Magogue provêm de Ez 38–39, onde Gogue é o príncipe da terra de Magogue; aqui designam as nações que se reúnem contra os santos.\f*\f + \fr 20.8: \ft Variante: Treg e o RP acrescentam o artigo τόν antes de “Gogue”; o RP omite “deles” (αὐτῶν).\f*\f + \fr 20.8: \ft Acréscimo: verbo ser/estar suprido em “é como”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula; “que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 20:8 \xt JHN 8:44; EPH 6:11; MAT 12:29; EZK 38:1-39:1; ISA 54:15; REV 16:14\x*
\v 9 \w E|strong="G2532"\w* \w subiram|strong="G305"\w* \w sobre a largura|strong="G1909,G3588,G4114"\w* \w da terra|strong="G3588,G1093"\w*, \w e|strong="G2532"\w* \w cercaram|strong="G6059"\w* \w o acampamento|strong="G3588,G3925"\w* \w dos santos|strong="G3588,G40"\w* \w e|strong="G2532"\w* \w a cidade amada|strong="G3588,G4172,G25"\w*, \w e|strong="G2532"\w* \w desceu|strong="G2597"\w* \w fogo|strong="G4442"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w e|strong="G2532"\w* \w os devorou|strong="G2719,G846"\w*.\f + \fr 20.9: \ft Variante: Treg, o TR e o RP acrescentam “da parte de Deus” (ἀπὸ τοῦ θεοῦ) antes de “do céu” (no RP, depois); Treg e o RP trazem ἐκύκλωσαν em lugar de ἐκύκλευσαν (“cercaram”).\f*\x - \xo 20:9 \xt REV 13:13; ZEP 3:19; JHN 8:44; EZK 38:16; MAT 12:29; EZK 39:6\x*
\v 10 \w E|strong="G2532"\w* \w o Diabo|strong="G3588,G1228"\w*, \w o que os enganava|strong="G3588,G4105,G846"\w*, \w foi lançado|strong="G906"\w* \w no lago|strong="G1519,G3588,G3041"\w* \w de fogo|strong="G3588,G4442"\w* \w e|strong="G2532"\w* \w enxofre|strong="G2303"\w*, \w onde|strong="G3699"\w* \w também|strong="G2532"\w* \add estão\add* \w a fera|strong="G3588,G2342"\w* \w e|strong="G2532"\w* \w o falso profeta|strong="G3588,G5578"\w*, \w e|strong="G2532"\w* \w serão atormentados|strong="G928"\w* \w de dia|strong="G2250"\w* \w e|strong="G2532"\w* \w de noite|strong="G3571"\w* \w para os séculos|strong="G1519,G3588,G165"\w* \w dos séculos|strong="G3588,G165"\w*.\f + \fr 20.10: \ft Acréscimo: “estão” (em “onde também estão a fera”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 20:10 \xt REV 19:20; REV 20:14; 1PE 5:8; JHN 8:44; MAT 10:28; MAT 25:41\x*
\p
\v 11 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w um grande trono|strong="G2362,G3173"\w* \w branco|strong="G3022"\w* \w e|strong="G2532"\w* \w o que está sentado|strong="G3588,G2521"\w* \w sobre ele|strong="G1909,G846"\w*, \w de cuja face|strong="G3739,G575,G3588,G4383"\w* \w fugiu|strong="G5343"\w* \w a terra|strong="G3588,G1093"\w* \w e|strong="G2532"\w* \w o céu|strong="G3588,G3772"\w*, \w e|strong="G2532"\w* \w lugar|strong="G5117"\w* \w não|strong="G3756"\w* \w se achou|strong="G2147"\w* \w para eles|strong="G846"\w*.\f + \fr 20.11: \ft Variante: NA28 e o RP trazem o acusativo ἐπʼ αὐτόν em lugar de ἐπʼ αὐτοῦ; Treg traz ἐπάνω αὐτοῦ (“por cima dele”).\f*\x - \xo 20:11 \xt MAT 24:35; REV 16:20; REV 4:2; REV 6:16; MAT 10:28; 2CO 5:10\x*
\v 12 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w os mortos|strong="G3588,G3498"\w*, \w os grandes|strong="G3588,G3173"\w* \w e|strong="G2532"\w* \w os pequenos|strong="G3588,G3398"\w*, \w de pé|strong="G2476"\w* \w diante do trono|strong="G1799,G3588,G2362"\w*, \w e|strong="G2532"\w* \w livros|strong="G975"\w* \w foram abertos|strong="G455"\w*; \w e|strong="G2532"\w* \w outro livro|strong="G243,G975"\w* \w foi aberto|strong="G455"\w*, \w que é|strong="G3739,G1510"\w* \w o da vida|strong="G3588,G2222"\w*; \w e|strong="G2532"\w* \w foram julgados|strong="G2919"\w* \w os mortos|strong="G3588,G3498"\w* \w pelas coisas escritas|strong="G1537,G3588,G1125"\w* \w nos livros|strong="G1722,G3588,G975"\w*, \w conforme|strong="G2596"\w* \w as obras|strong="G3588,G2041"\w* \w deles|strong="G846"\w*.\f + \fr 20.12: \ft Nota cultural: os livros abertos e o livro da vida ecoam Dn 7:10 e Sl 69:28.\f*\f + \fr 20.12: \ft Variante: o TR traz “diante de Deus” (θεοῦ) em lugar de “diante do trono” (θρόνου).\f*\x - \xo 20:12 \xt DAN 7:10; PSA 69:28; REV 19:5; 2CO 5:10; MAT 16:27; MAT 12:36\x*
\v 13 \w E|strong="G2532"\w* \w o mar|strong="G3588,G2281"\w* \w entregou|strong="G1325"\w* \w os mortos|strong="G3588,G3498"\w* \w que estavam nele|strong="G3588,G1722,G846"\w*, \w e|strong="G2532"\w* \w a Morte|strong="G3588,G2288"\w* \w e|strong="G2532"\w* \w o Hades|strong="G3588,G86"\w* \w entregaram|strong="G1325"\w* \w os mortos|strong="G3588,G3498"\w* \w que estavam neles|strong="G3588,G1722,G846"\w*, \w e|strong="G2532"\w* \w foram julgados|strong="G2919"\w* \w cada um|strong="G1538"\w* \w conforme|strong="G2596"\w* \w as obras|strong="G3588,G2041"\w* \w deles|strong="G846"\w*.\f + \fr 20.13: \ft Lit.: ᾍδης, “Hades, o lugar dos mortos” (equivalente grego do hebraico šeʾôl).\f*\f + \fr 20.13: \ft Acréscimo: “que estavam nele”, “que estavam neles”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 20:13 \xt MAT 10:28; 2CO 5:10; MAT 13:49; ROM 8:11; DAN 7:10; ISA 26:19\x*
\v 14 \w E|strong="G2532"\w* \w a Morte|strong="G3588,G2288"\w* \w e|strong="G2532"\w* \w o Hades|strong="G3588,G86"\w* \w foram lançados|strong="G906"\w* \w no lago|strong="G1519,G3588,G3041"\w* \w de fogo|strong="G3588,G4442"\w*. \w Esta|strong="G3778"\w* \w é|strong="G1510"\w* \w a segunda morte|strong="G3588,G2288,G1208"\w*, \w o lago|strong="G3588,G3041"\w* \w de fogo|strong="G3588,G4442"\w*.\f + \fr 20.14: \ft Variante: o TR omite “o lago de fogo” (ἡ λίμνη τοῦ πυρός) no fim; Treg traz “segunda morte” em ordem diferente.\f*\x - \xo 20:14 \xt REV 21:8; REV 1:18; REV 20:10; REV 21:4; MAT 10:28; 2CO 5:10\x*
\v 15 \w E|strong="G2532"\w* \w se alguém|strong="G1487,G5100"\w* \w não|strong="G3756"\w* \w foi achado|strong="G2147"\w* \w escrito|strong="G1125"\w* \w no livro|strong="G1722,G3588,G976"\w* \w da vida|strong="G3588,G2222"\w*, \w foi lançado|strong="G906"\w* \w no lago|strong="G1519,G3588,G3041"\w* \w de fogo|strong="G3588,G4442"\w*.\f + \fr 20.15: \ft Variante: o RP traz βιβλίῳ (“livro”, outra forma) em lugar de βίβλῳ.\f*\x - \xo 20:15 \xt JHN 14:6; REV 20:10; MRK 16:16; ACT 4:12; REV 21:8; LUK 10:20\x*
\c 21
\p
\v 1 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w um novo|strong="G2537"\w* \w céu|strong="G3772"\w* \w e|strong="G2532"\w* \w uma nova|strong="G2537"\w* \w terra|strong="G1093"\w*; \w pois|strong="G1063"\w* \w o primeiro|strong="G3588,G4413"\w* \w céu|strong="G3772"\w* \w e|strong="G2532"\w* \w a primeira|strong="G3588,G4413"\w* \w terra|strong="G1093"\w* \w se foram|strong="G565"\w*, \w e|strong="G2532"\w* \w o mar|strong="G3588,G2281"\w* \w já não|strong="G3756,G2089"\w* \w existe|strong="G1510"\w*.\f + \fr 21.1: \ft Lit.: Καινός, “novo” (renovado em qualidade, diferente do que havia), em contraste com νέος (“novo em tempo”).\f*\f + \fr 21.1: \ft Nota cultural: o novo céu e a nova terra cumprem Is 65:17 e 66:22 (cf. 2Pe 3:13); o mar, símbolo do caos e de onde sobe a fera (13:1), já não existe.\f*\x - \xo 21:1 \xt ISA 65:17; 2PE 3:13; ISA 66:22; 2CO 5:17; 2PE 3:10; REV 21:4\x*
\v 2 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w a cidade santa|strong="G3588,G4172,G40"\w*, \w a nova|strong="G2537"\w* \w Jerusalém|strong="G2419"\w*, \w descendo|strong="G2597"\w* \w do céu|strong="G1537,G3588,G3772"\w*, \w da parte de Deus|strong="G575,G3588,G2316"\w*, \w preparada|strong="G2090"\w* \w como uma noiva|strong="G5613,G3565"\w* \w adornada|strong="G2885"\w* \w para o seu marido|strong="G3588,G435,G846"\w*.\f + \fr 21.2: \ft Nota cultural: a cidade-noiva, a nova Jerusalém, contrasta com a prostituta Babilônia (caps. 17–18) e retoma Is 61:10 e 52:1.\f*\f + \fr 21.2: \ft Variante: o TR acrescenta “eu, João” (ἐγὼ Ἰωάννης) antes de “vi”.\f*\x - \xo 21:2 \xt ISA 61:10; ISA 52:1; REV 3:12; REV 21:10; 2CO 5:17; ISA 65:17\x*
\v 3 \w E|strong="G2532"\w* \w ouvi|strong="G191"\w* \w uma grande|strong="G3173"\w* \w voz|strong="G5456"\w* \w do trono|strong="G1537,G3588,G2362"\w* \w dizendo|strong="G3004"\w*: “\w Olhem|strong="G2400"\w*, \w a tenda|strong="G3588,G4633"\w* \w de Deus|strong="G3588,G2316"\w* \w está com|strong="G3326"\w* \w os seres humanos|strong="G3588,G444"\w*, \w e|strong="G2532"\w* \w armará a sua tenda|strong="G4637"\w* \w com eles|strong="G3326,G846"\w*, \w e|strong="G2532"\w* \w eles|strong="G846"\w* \w serão|strong="G1510"\w* \w os povos|strong="G2992"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w o próprio Deus|strong="G846,G3588,G2316"\w* \w estará|strong="G1510"\w* \w com eles|strong="G3326,G846"\w*,\f + \fr 21.3: \ft Nota cultural: a presença de Deus entre o povo cumpre as promessas de Lv 26:11-12, Ez 37:27 e Zc 2:10.\f*\f + \fr 21.3: \ft Variante: Treg e o RP trazem “do céu” (οὐρανοῦ) em lugar de “do trono” (θρόνου); o RP traz o singular λαός (“povo”); NA28 e o TR acrescentam “o Deus deles” (αὐτῶν θεός) no fim.\f*\f + \fr 21.3: \ft Acréscimo: verbo ser/estar suprido em “está com”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 21:3 \xt EZK 37:27; LEV 26:11; ZEC 2:10; 2CO 6:16; REV 22:3; REV 7:15\x*
\v 4 \w e|strong="G2532"\w* \w enxugará|strong="G1813"\w* \w toda lágrima|strong="G3956,G1144"\w* \w dos olhos|strong="G1537,G3588,G3788"\w* \w deles|strong="G846"\w*, \w e|strong="G2532"\w* \w a morte|strong="G3588,G2288"\w* \w já não|strong="G3756,G2089"\w* \w existirá|strong="G1510"\w*; \w nem|strong="G3777"\w* \w luto|strong="G3997"\w* \w nem|strong="G3777"\w* \w clamor|strong="G2906"\w* \w nem|strong="G3777"\w* \w dor|strong="G4192"\w* \w existirão mais|strong="G3756,G1510,G2089"\w*; \w as primeiras coisas|strong="G3588,G4413"\w* \w se foram|strong="G565"\w*.”\f + \fr 21.4: \ft Variante: Treg, NA28 e o RP acrescentam “porque” (ὅτι) antes de “as primeiras coisas”; o TR acrescenta “Deus” (ὁ θεός) como sujeito de “enxugará”; o RP traz ἀπό (“de”) em lugar de ἐκ antes de “olhos”.\f*\x - \xo 21:4 \xt ISA 25:8; MAT 5:4; REV 22:3; REV 7:17; 1CO 15:26; 2CO 5:17\x*
\v 5 \w E|strong="G2532"\w* \w o que estava sentado|strong="G3588,G2521"\w* \w sobre o trono|strong="G1909,G3588,G2362"\w* \w disse|strong="G2036"\w*: “\w Olhem|strong="G2400"\w*, \w faço novas todas as coisas|strong="G2537,G4160,G3956"\w*.” \w E|strong="G2532"\w* \w disse|strong="G3004"\w*: “\w Escreva|strong="G1125"\w*, \w porque|strong="G3754"\w* \w estas palavras|strong="G3778,G3588,G3056"\w* \w são|strong="G1510"\w* \w fiéis|strong="G4103"\w* \w e|strong="G2532"\w* \w verdadeiras|strong="G228"\w*.”\f + \fr 21.5: \ft Variante: Treg, o TR e o RP acrescentam “a mim” (μοι) depois de “disse”; o RP inverte “fiéis e verdadeiras” e “faço novas todas as coisas”.\f*\x - \xo 21:5 \xt ISA 43:19; REV 4:2; REV 22:6; 2CO 5:17; ISA 42:9; EZK 36:26\x*
\v 6 \w E|strong="G2532"\w* \w me disse|strong="G2036,G3165"\w*: “\w Tudo está feito|strong="G1096"\w*. \w Eu sou|strong="G1473"\w* \w o Alfa|strong="G3588,G1"\w* \w e|strong="G2532"\w* \w o Ômega|strong="G3588,G5598"\w*, \w o princípio|strong="G3588,G746"\w* \w e|strong="G2532"\w* \w o fim|strong="G3588,G5056"\w*. \w Eu|strong="G1473"\w* \w darei|strong="G1325"\w* \w ao que tem sede|strong="G3588,G1372"\w*, \w da fonte|strong="G1537,G3588,G4077"\w* \w da água|strong="G3588,G5204"\w* \w da vida|strong="G3588,G2222"\w*, \w gratuitamente|strong="G1432"\w*.\f + \fr 21.6: \ft Lit.: Γέγοναν (plural), “aconteceram, estão feitas”; cf. γέγονεν (singular) em 16:17.\f*\f + \fr 21.6: \ft Nota cultural: Alfa e Ômega (1:8; 22:13) retomam Is 41:4 e 44:6; a água da vida dada de graça ecoa Is 55:1.\f*\f + \fr 21.6: \ft Variante: Treg e NA28 acrescentam “eu sou” (εἰμι) depois do primeiro “eu”; o RP traz Γέγονα (“estou feito”) em lugar de Γέγοναν.\f*\f + \fr 21.6: \ft Acréscimo: verbo ser/estar suprido em “Eu sou”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 21:6 \xt ISA 55:1; ISA 41:4; ISA 44:6; REV 22:13; REV 1:8; REV 22:17\x*
\v 7 \w O que vencer|strong="G3588,G3528"\w* \w herdará|strong="G2816"\w* \w estas coisas|strong="G3778"\w*, \w e|strong="G2532"\w* \w eu serei|strong="G1510"\w* \w para ele|strong="G846"\w* \w Deus|strong="G2316"\w*, \w e|strong="G2532"\w* \w ele|strong="G846"\w* \w será|strong="G1510"\w* \w para mim|strong="G3165"\w* \w filho|strong="G5207"\w*.\f + \fr 21.7: \ft Nota cultural: a fórmula “eu serei o seu Deus, e ele será o meu filho” retoma 2Sm 7:14 e Sl 89:26-27, promessas feitas ao rei davídico, agora estendidas a todo vencedor.\f*\x - \xo 21:7 \xt 2SA 7:14; PSA 89:26-27; 2CO 6:16; ZEC 13:9; ROM 8:37; ROM 8:14\x*
\v 8 \w Mas para os|strong="G3588,G1161"\w* \w covardes|strong="G1169"\w* \w e|strong="G2532"\w* \w incrédulos|strong="G571"\w* \w e|strong="G2532"\w* \w abomináveis|strong="G948"\w* \w e|strong="G2532"\w* \w assassinos|strong="G5406"\w* \w e|strong="G2532"\w* \w imorais sexuais|strong="G4205"\w* \w e|strong="G2532"\w* \w feiticeiros|strong="G5333"\w* \w e|strong="G2532"\w* \w idólatras|strong="G1496"\w* \w e|strong="G2532"\w* \w todos os|strong="G3956,G3588"\w* \w mentirosos|strong="G5571"\w*, \w a parte|strong="G3588,G3313"\w* \w deles|strong="G846"\w* \add será\add* \w no lago|strong="G1722,G3588,G3041"\w* \w que arde|strong="G3588,G2545"\w* \w com fogo|strong="G4442"\w* \w e|strong="G2532"\w* \w enxofre|strong="G2303"\w*, \w o que é|strong="G3739,G1510"\w* \w a segunda morte|strong="G3588,G2288,G1208"\w*.”\f + \fr 21.8: \ft Lit.: Ἐβδελυγμένοις (de βδελύσσομαι), “contaminados pela abominação, abomináveis”; πόρνοι, “os que praticam imoralidade sexual”.\f*\f + \fr 21.8: \ft Variante: o RP acrescenta “e pecadores” (καὶ ἁμαρτωλοῖς) depois de “incrédulos”.\f*\f + \fr 21.8: \ft Acréscimo: “será” (em “parte deles será no lago”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 21:8 \xt REV 22:15; REV 20:14; 1CO 6:9; MRK 16:16; EPH 5:5; REV 2:11\x*
\v 9 \w E|strong="G2532"\w* \w veio|strong="G2064"\w* \w um|strong="G1520"\w* \w dos sete|strong="G1537,G3588,G2033"\w* \w anjos|strong="G32"\w* \w que tinham|strong="G3588,G2192"\w* \w as sete taças|strong="G3588,G2033,G5357"\w*, \w as cheias|strong="G3588,G1073"\w* \w das sete|strong="G3588,G2033"\w* \w pragas|strong="G4127"\w* \w últimas|strong="G3588,G2078"\w*, \w e|strong="G2532"\w* \w falou|strong="G2980"\w* \w comigo|strong="G3326,G1473"\w*, \w dizendo|strong="G3004"\w*: “\w Venha|strong="G1204"\w*, \w mostrarei|strong="G1166"\w* \w a você|strong="G4771"\w* \w a noiva|strong="G3588,G3565"\w*, \w a esposa|strong="G3588,G1135"\w* \w do cordeiro|strong="G3588,G721"\w*.”\f + \fr 21.9: \ft Variante: o TR acrescenta “a mim” (πρὸς με) depois de “falou”; o RP traz γεμούσας (“cheias”, acusativo) e inverte “a esposa, a noiva”.\f*\x - \xo 21:9 \xt REV 17:1; REV 15:7; REV 15:1; REV 19:7; MAT 25:1; JHN 1:29\x*
\v 10 \w e|strong="G2532"\w* \w me levou|strong="G667,G3165"\w* \w em espírito|strong="G1722,G4151"\w* \w sobre um monte|strong="G1909,G3735"\w* \w grande|strong="G3173"\w* \w e|strong="G2532"\w* \w alto|strong="G5308"\w*, \w e|strong="G2532"\w* \w me mostrou|strong="G1166,G3165"\w* \w a cidade santa|strong="G3588,G4172,G40"\w*, \w Jerusalém|strong="G2419"\w*, \w descendo|strong="G2597"\w* \w do céu|strong="G1537,G3588,G3772"\w*, \w da parte de Deus|strong="G575,G3588,G2316"\w*,\f + \fr 21.10: \ft Nota cultural: o monte alto de onde o vidente contempla a cidade ecoa Ez 40:2.\f*\f + \fr 21.10: \ft Variante: o TR e o RP acrescentam “a grande” (τὴν μεγάλην) depois de “cidade”.\f*\x - \xo 21:10 \xt EZK 40:2; REV 21:2; REV 1:10; HEB 11:10; EPH 5:27; ISA 62:4\x*
\v 11 \w tendo|strong="G2192"\w* \w a glória|strong="G3588,G1391"\w* \w de Deus|strong="G3588,G2316"\w*; \w o seu brilho|strong="G3588,G5458,G846"\w* \w semelhante|strong="G3664"\w* \w a uma pedra|strong="G3037"\w* \w preciosíssima|strong="G5093"\w*, \w como pedra|strong="G5613,G3037"\w* \w de jaspe|strong="G2393"\w*, \w cristalina|strong="G2929"\w*.\f + \fr 21.11: \ft Lit.: Φωστήρ, “luminar, fonte de luz, brilho”.\f*\x - \xo 21:11 \xt REV 4:3; REV 21:18; PSA 3:3; REV 21:23; HEB 11:10; EPH 5:27\x*
\v 12 \w Tendo|strong="G2192"\w* \w um muro|strong="G5038"\w* \w grande|strong="G3173"\w* \w e|strong="G2532"\w* \w alto|strong="G5308"\w*, \w tendo|strong="G2192"\w* \w doze portões|strong="G4440,G1427"\w*, \w e|strong="G2532"\w* \w sobre os portões|strong="G1909,G3588,G4440"\w* \w doze anjos|strong="G32,G1427"\w*, \w e|strong="G2532"\w* \w nomes|strong="G3686"\w* \w inscritos|strong="G1924"\w*, \w que são|strong="G3739,G1510"\w* \w os das doze|strong="G3588,G1427"\w* \w tribos|strong="G5443"\w* \w dos filhos|strong="G5207"\w* \w de Israel|strong="G2474"\w*;\f + \fr 21.12: \ft Nota cultural: os doze portões com os nomes das tribos retomam a descrição da cidade em Ez 48:30-35.\f*\f + \fr 21.12: \ft Variante: Treg, NA28 e o RP acrescentam “os nomes” (τὰ ὀνόματα) depois de “são”.\f*\x - \xo 21:12 \xt EZK 48:30-35; EZK 48:31; HEB 11:10; EPH 5:27; EXO 39:14; EPH 2:19\x*
\v 13 \w do nascente|strong="G575,G395"\w* \w três portões|strong="G4440,G5140"\w*, \w e|strong="G2532"\w* \w do norte|strong="G575,G1005"\w* \w três portões|strong="G4440,G5140"\w*, \w e|strong="G2532"\w* \w do sul|strong="G575,G3558"\w* \w três portões|strong="G4440,G5140"\w*, \w e|strong="G2532"\w* \w do poente|strong="G575,G1424"\w* \w três portões|strong="G4440,G5140"\w*;\x - \xo 21:13 \xt LUK 13:29; HEB 11:10; EPH 5:27; EPH 2:19; EZK 48:31; ISA 2:2\x*
\v 14 \w e|strong="G2532"\w* \w o muro|strong="G3588,G5038"\w* \w da cidade|strong="G3588,G4172"\w* \w tinha|strong="G2192"\w* \w doze alicerces|strong="G2310,G1427"\w*, \w e|strong="G2532"\w* \w sobre eles|strong="G1909,G846"\w* \w doze nomes|strong="G1427,G3686"\w* \w dos doze|strong="G3588,G1427"\w* \w apóstolos|strong="G652"\w* \w do cordeiro|strong="G3588,G721"\w*.\x - \xo 21:14 \xt REV 21:19; EPH 2:20; HEB 11:10; MAT 16:18; MAT 5:14; JHN 1:29\x*
\v 15 \w E|strong="G2532"\w* \w o que falava|strong="G3588,G2980"\w* \w comigo|strong="G3326,G1473"\w* \w tinha|strong="G2192"\w* \w uma cana|strong="G2563"\w* \w de medir|strong="G3358"\w* \w de ouro|strong="G5552"\w*, \w para medir|strong="G2443,G3354"\w* \w a cidade|strong="G3588,G4172"\w* \w e|strong="G2532"\w* \w os portões|strong="G3588,G4440"\w* \w dela|strong="G846"\w* \w e|strong="G2532"\w* \w o muro|strong="G3588,G5038"\w* \w dela|strong="G846"\w*.\f + \fr 21.15: \ft Variante: o TR omite “de medir” (μέτρον) antes de “cana”.\f*\f + \fr 21.15: \ft Nota cultural: o anjo que mede a cidade com uma cana repete a visão de Ez 40:3 e retoma 11:1.\f*\x - \xo 21:15 \xt EZK 40:3; REV 11:1; MAT 5:14; HEB 11:10; ZEC 2:1; EPH 5:27\x*
\v 16 \w E|strong="G2532"\w* \w a cidade|strong="G3588,G4172"\w* \w está disposta|strong="G2749"\w* \w em quadrado|strong="G5068"\w*, \w e|strong="G2532"\w* \w o comprimento|strong="G3588,G3372"\w* \w dela|strong="G846"\w* \w é tão grande quanto|strong="G3745"\w* \w a largura|strong="G3588,G4114"\w*. \w E|strong="G2532"\w* \w mediu|strong="G3354"\w* \w a cidade|strong="G3588,G4172"\w* \w com a cana|strong="G3588,G2563"\w*, \w até doze mil|strong="G1909,G1427,G5505"\w* \w estádios|strong="G4712"\w*; \w o comprimento|strong="G3588,G3372"\w* \w e|strong="G2532"\w* \w a largura|strong="G3588,G4114"\w* \w e|strong="G2532"\w* \w a altura|strong="G3588,G5311"\w* \w dela|strong="G846"\w* \w são|strong="G1510"\w* \w iguais|strong="G2470"\w*.\f + \fr 21.16: \ft Lit.: doze mil estádios correspondem a cerca de 2.200 km por lado; a cidade em forma de cubo lembra o Santo dos Santos (1Rs 6:20).\f*\f + \fr 21.16: \ft Variante: WH e NA28 trazem σταδίων (“de estádios”, genitivo) em lugar de σταδίους; o TR acrescenta “tanto quanto é” (τοσοῦτόν ἐστιν) depois de “largura”; NA28 acrescenta “também” (καί) antes de “a largura”; alguns manuscritos bizantinos repetem “doze” (δώδεκα).\f*\f + \fr 21.16: \ft Acréscimo: verbo ser/estar suprido em “é tão grande quanto”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 21:16 \xt 1KI 6:20; MAT 5:14; HEB 11:10; EPH 5:27; EPH 2:19; ISA 2:2\x*
\v 17 \w E|strong="G2532"\w* \w mediu|strong="G3354"\w* \w o muro|strong="G3588,G5038"\w* \w dela|strong="G846"\w*: \w cento e quarenta e quatro|strong="G1540,G5062,G5064"\w* \w côvados|strong="G4083"\w*, \w medida|strong="G3358"\w* \w de ser humano|strong="G444"\w*, \w que é|strong="G3739,G1510"\w* \w de anjo|strong="G32"\w*.\f + \fr 21.17: \ft Lit.: Πῆχυς, “côvado” (cerca de 45 cm); cento e quarenta e quatro côvados somam cerca de 65 m.\f*\x - \xo 21:17 \xt MAT 5:14; HEB 11:10; EPH 5:27; EPH 2:19; REV 13:18; ISA 2:2\x*
\v 18 \w E|strong="G2532"\w* \w o material de construção|strong="G3588,G1739"\w* \w do muro|strong="G3588,G5038"\w* \w dela|strong="G846"\w* \add era\add* \w jaspe|strong="G2393"\w*, \w e|strong="G2532"\w* \w a cidade|strong="G3588,G4172"\w* \add era\add* \w de ouro|strong="G5553"\w* \w puro|strong="G2513"\w* \w semelhante|strong="G3664"\w* \w a vidro|strong="G5194"\w* \w puro|strong="G2513"\w*.\f + \fr 21.18: \ft Lit.: Ἐνδώμησις, “material de construção, construção”.\f*\f + \fr 21.18: \ft Variante: Treg e o RP acrescentam “era” (ἦν) depois de “e”.\f*\f + \fr 21.18: \ft Acréscimo: “era” (em “muro dela era jaspe e”), “era” (em “a cidade era de ouro”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 21:18 \xt REV 21:21; REV 21:11; MAT 5:14; HEB 11:10; EPH 5:27; EPH 2:19\x*
\v 19 \w Os alicerces|strong="G3588,G2310"\w* \w do muro|strong="G3588,G5038"\w* \w da cidade|strong="G3588,G4172"\w* \w estavam adornados|strong="G2885"\w* \w com toda pedra preciosa|strong="G3956,G3037,G5093"\w*: \w o primeiro alicerce|strong="G3588,G2310,G4413"\w*, \w jaspe|strong="G2393"\w*; \w o segundo|strong="G3588,G1208"\w*, \w safira|strong="G4552"\w*; \w o terceiro|strong="G3588,G5154"\w*, \w calcedônia|strong="G5472"\w*; \w o quarto|strong="G3588,G5067"\w*, \w esmeralda|strong="G4665"\w*;\f + \fr 21.19: \ft Variante: Treg acrescenta “e” (καί) antes de “os alicerces”.\f*\x - \xo 21:19 \xt REV 21:11; REV 21:14; MAT 5:14; HEB 11:10; ISA 54:11; EPH 5:27\x*
\v 20 \w o quinto|strong="G3588,G3991"\w*, \w sardônica|strong="G4557"\w*; \w o sexto|strong="G3588,G1623"\w*, \w sárdio|strong="G4556"\w*; \w o sétimo|strong="G3588,G1442"\w*, \w crisólito|strong="G5555"\w*; \w o oitavo|strong="G3588,G3590"\w*, \w berilo|strong="G969"\w*; \w o nono|strong="G3588,G1766"\w*, \w topázio|strong="G5116"\w*; \w o décimo|strong="G3588,G1182"\w*, \w crisópraso|strong="G5556"\w*; \w o décimo primeiro|strong="G3588,G1734"\w*, \w jacinto|strong="G5192"\w*; \w o décimo segundo|strong="G3588,G1428"\w*, \w ametista|strong="G271"\w*;\f + \fr 21.20: \ft Nota cultural: a lista das doze pedras lembra as do peitoral do sumo sacerdote (Êx 28:17-20); a identificação exata de cada pedra é incerta.\f*\x - \xo 21:20 \xt EXO 28:17; MAT 5:14; HEB 11:10; EPH 5:27; EPH 2:19; ISA 2:2\x*
\v 21 \w e|strong="G2532"\w* \w os doze portões|strong="G3588,G1427,G4440"\w* \w eram doze|strong="G1427"\w* \w pérolas|strong="G3135"\w*, \w cada um|strong="G303,G1520,G1538"\w* \w dos portões|strong="G3588,G4440"\w* \w era|strong="G1510"\w* \w de uma só|strong="G1537,G1520"\w* \w pérola|strong="G3135"\w*; \w e|strong="G2532"\w* \w a praça|strong="G3588,G4113"\w* \w da cidade|strong="G3588,G4172"\w*, \w ouro|strong="G5553"\w* \w puro|strong="G2513"\w*, \w como|strong="G5613"\w* \w vidro|strong="G5194"\w* \w transparente|strong="G6897"\w*.\f + \fr 21.21: \ft Lit.: Πλατεῖα, “praça” ou “rua larga, avenida”.\f*\f + \fr 21.21: \ft Acréscimo: verbo ser/estar suprido em “eram doze”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 21:21 \xt REV 21:18; MAT 5:14; HEB 11:10; EPH 5:27; EPH 2:19; REV 17:4\x*
\v 22 \w E|strong="G2532"\w* \w santuário|strong="G3485"\w* \w não|strong="G3756"\w* \w vi|strong="G1492"\w* \w nela|strong="G1722,G846"\w*, \w pois|strong="G1063"\w* \w o Senhor|strong="G3588,G2962"\w*, \w Deus|strong="G3588,G2316"\w*, \w o Todo-Poderoso|strong="G3588,G3841"\w*, \w é|strong="G1510"\w* \w o santuário|strong="G3485"\w* \w dela|strong="G846"\w*, \w e|strong="G2532"\w* \w o cordeiro|strong="G3588,G721"\w*.\f + \fr 21.22: \ft Nota cultural: a ausência de santuário porque Deus e o cordeiro são o santuário contrasta com a visão de Ez 40–48.\f*\x - \xo 21:22 \xt REV 22:3; JHN 14:23; MAT 5:14; HEB 11:10; JHN 1:29; PSA 84:1\x*
\v 23 \w E|strong="G2532"\w* \w a cidade|strong="G3588,G4172"\w* \w não|strong="G3756"\w* \w tem|strong="G2192"\w* \w necessidade|strong="G5532"\w* \w do sol|strong="G3588,G2246"\w* \w nem|strong="G3761"\w* \w da lua|strong="G3588,G4582"\w*, \w para que|strong="G2443"\w* \w brilhem|strong="G5316"\w* \w nela|strong="G846"\w*; \w pois|strong="G1063"\w* \w a glória|strong="G3588,G1391"\w* \w de Deus|strong="G3588,G2316"\w* \w a iluminou|strong="G5461,G846"\w*, \w e|strong="G2532"\w* \w a lâmpada|strong="G3588,G3088"\w* \w dela|strong="G846"\w* \add é\add* \w o cordeiro|strong="G3588,G721"\w*.\f + \fr 21.23: \ft Nota cultural: Deus como luz da cidade, dispensando sol e lua, retoma Is 60:19-20.\f*\f + \fr 21.23: \ft Acréscimo: “é” (em “lâmpada dela é o cordeiro”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 21:23 \xt ISA 60:19; REV 22:5; PSA 84:11; ISA 60:1; PSA 27:1; PSA 3:3\x*
\v 24 \w E|strong="G2532"\w* \w as nações|strong="G3588,G1484"\w* \w andarão|strong="G4043"\w* \w pela luz|strong="G1223,G3588,G5457"\w* \w dela|strong="G846"\w*; \w e|strong="G2532"\w* \w os reis|strong="G3588,G935"\w* \w da terra|strong="G3588,G1093"\w* \w levam|strong="G5342"\w* \w a sua glória|strong="G3588,G1391,G846"\w* \w para ela|strong="G1519,G846"\w*;\f + \fr 21.24: \ft Nota cultural: os reis da terra que trazem a sua glória à cidade ecoam Is 60:3, 5, 11.\f*\f + \fr 21.24: \ft Variante: o TR acrescenta “dos que são salvos” (τῶν σωζομένων) depois de “as nações” e “e a honra” (καὶ τὴν τιμήν) depois de “glória”; o RP traz “a glória e a honra das nações para ela” em outra forma.\f*\x - \xo 21:24 \xt ISA 60:3; REV 21:26; JHN 8:12; ISA 49:23; PSA 15:1; MAT 5:14\x*
\v 25 \w e|strong="G2532"\w* \w os portões|strong="G3588,G4440"\w* \w dela|strong="G846"\w* \w de modo algum|strong="G3756,G3361"\w* \w se fecharão|strong="G2808"\w* \w de dia|strong="G2250"\w*, \w pois|strong="G1063"\w* \w noite|strong="G3571"\w* \w não|strong="G3756"\w* \w haverá|strong="G1510"\w* \w ali|strong="G1563"\w*,\f + \fr 21.25: \ft Nota cultural: portões sempre abertos ecoam Is 60:11.\f*\x - \xo 21:25 \xt ISA 60:11; ISA 49:23; MAT 5:14; REV 22:5; ZEC 14:7; HEB 11:10\x*
\v 26 \w e|strong="G2532"\w* \w levarão|strong="G5342"\w* \w para ela|strong="G1519,G846"\w* \w a glória|strong="G3588,G1391"\w* \w e|strong="G2532"\w* \w a honra|strong="G3588,G5092"\w* \w das nações|strong="G3588,G1484"\w*.\x - \xo 21:26 \xt REV 21:24; 2PE 1:17; ISA 49:23; ISA 60:11; MAT 5:14; HEB 11:10\x*
\v 27 \w E|strong="G2532"\w* \w de modo algum|strong="G3756,G3361"\w* \w entrará|strong="G1525"\w* \w nela|strong="G1519,G846"\w* \w qualquer coisa|strong="G3956"\w* \w impura|strong="G2839"\w*, \w e|strong="G2532"\w* \w quem pratica|strong="G4160"\w* \w abominação|strong="G946"\w* \w e|strong="G2532"\w* \w mentira|strong="G5579"\w*, \w a não ser|strong="G1487,G3361"\w* \w os que estão escritos|strong="G3588,G1125"\w* \w no livro|strong="G1722,G3588,G975"\w* \w da vida|strong="G3588,G2222"\w* \w do cordeiro|strong="G3588,G721"\w*.\f + \fr 21.27: \ft Lit.: Κοινός, “comum, profano, impuro”.\f*\f + \fr 21.27: \ft Variante: WH, Treg e NA28 acrescentam o artigo ὁ (“aquele que”) antes de “pratica”; o RP traz o neutro ποιοῦν.\f*\x - \xo 21:27 \xt REV 13:8; REV 22:14; 1PE 1:4; REV 3:5; ISA 35:8; ISA 52:1\x*
\c 22
\p
\v 1 \w E|strong="G2532"\w* \w me mostrou|strong="G1166,G3165"\w* \w um rio|strong="G4215"\w* \w de água|strong="G5204"\w* \w de vida|strong="G2222"\w*, \w brilhante|strong="G2986"\w* \w como cristal|strong="G5613,G2930"\w*, \w saindo|strong="G1607"\w* \w do trono|strong="G1537,G3588,G2362"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w do cordeiro|strong="G3588,G721"\w*,\f + \fr 22.1: \ft Nota cultural: o rio que sai do trono evoca o rio do Éden (Gn 2:10) e o rio do novo templo (Ez 47:1-12; Zc 14:8).\f*\f + \fr 22.1: \ft Variante: o TR e o RP acrescentam “puro” (καθαρόν) depois de “rio”.\f*\x - \xo 22:1 \xt ZEC 14:8; EZK 47:1; GEN 2:10; REV 7:17; JHN 4:14; PSA 23:2\x*
\v 2 \w no meio|strong="G1722,G3319"\w* \w da praça|strong="G3588,G4113"\w* \w dela|strong="G846"\w*; \w e|strong="G2532"\w* \w do rio|strong="G3588,G4215"\w*, \w de um lado|strong="G1782"\w* \w e|strong="G2532"\w* \w do outro|strong="G1564"\w*, \w a árvore|strong="G3586"\w* \w da vida|strong="G2222"\w*, \w que produz|strong="G4160"\w* \w doze frutos|strong="G1427,G2590"\w*, \w dando|strong="G591"\w* \w o seu fruto|strong="G3588,G2590,G846"\w* \w a cada mês|strong="G2596,G3376,G1538"\w*, \w e|strong="G2532"\w* \w as folhas|strong="G3588,G5444"\w* \w da árvore|strong="G3588,G3586"\w* \w são para|strong="G1519"\w* \w a cura|strong="G2322"\w* \w das nações|strong="G3588,G1484"\w*.\f + \fr 22.2: \ft Lit.: Ξύλον, “árvore, madeira”; θεραπεία, “cura, tratamento”.\f*\f + \fr 22.2: \ft Nota cultural: a árvore da vida, vedada em Gn 3:22-24, está agora aberta; as folhas para a cura das nações e o fruto mensal ecoam Ez 47:12.\f*\f + \fr 22.2: \ft Variante: o TR acrescenta “um” (ἕνα) antes de “cada”; Treg e o RP trazem ἀποδιδούς (nominativo) em lugar de ἀποδιδοῦν.\f*\f + \fr 22.2: \ft Acréscimo: verbo ser/estar suprido em “são para”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:2 \xt EZK 47:12; GEN 3:22; 1PE 2:24; REV 22:1; PSA 1:3; EXO 15:27\x*
\v 3 \w E|strong="G2532"\w* \w nenhuma maldição|strong="G3956,G2652,G3756"\w* \w existirá|strong="G1510"\w* \w mais|strong="G2089"\w*. \w E|strong="G2532"\w* \w o trono|strong="G3588,G2362"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w do cordeiro|strong="G3588,G721"\w* \w estará|strong="G1510"\w* \w nela|strong="G1722,G846"\w*, \w e|strong="G2532"\w* \w os servos|strong="G3588,G1401"\w* \w dele|strong="G846"\w* \w prestarão culto|strong="G3000"\w* \w a ele|strong="G846"\w*,\f + \fr 22.3: \ft Lit.: Κατάθεμα, “maldição, coisa maldita (anátema)”.\f*\f + \fr 22.3: \ft Nota cultural: “nunca mais haverá maldição” cumpre Zc 14:11 e desfaz a maldição de Gn 3:17.\f*\f + \fr 22.3: \ft Tradução: δοῦλοι (δοῦλος, G1401) está aqui como “os servos”; o termo pode ser “escravo” (condição social), “servo” ou “servidor”, e o contexto decide.\f*\x - \xo 22:3 \xt ZEC 14:11; GEN 3:17; REV 7:15; MAT 25:21; REV 21:3-4; REV 7:10\x*
\v 4 \w e|strong="G2532"\w* \w verão|strong="G3700"\w* \w o rosto|strong="G3588,G4383"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w o nome|strong="G3588,G3686"\w* \w dele|strong="G846"\w* \add estará\add* \w sobre as testas|strong="G1909,G3588,G3359"\w* \w deles|strong="G846"\w*.\f + \fr 22.4: \ft Nota cultural: ver o rosto de Deus e levar o seu nome na testa contrasta com a marca da fera em 13:16-17 (cf. Sl 17:15; Mt 5:8).\f*\f + \fr 22.4: \ft Acréscimo: “estará” (em “nome dele estará sobre as”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 22:4 \xt MAT 5:8; PSA 17:15; REV 14:1; 2TI 2:19; PSA 36:8; 1JN 3:2\x*
\v 5 \w E|strong="G2532"\w* \w noite|strong="G3571"\w* \w não haverá|strong="G3756,G1510"\w* \w mais|strong="G2089"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w têm|strong="G2192"\w* \w necessidade|strong="G5532"\w* \w de luz|strong="G5457"\w* \w de lâmpada|strong="G3088"\w* \w nem|strong="G2532"\w* \w de luz|strong="G5457"\w* \w de sol|strong="G2246"\w*, \w porque|strong="G3754"\w* \w o Senhor Deus|strong="G2962,G3588,G2316"\w* \w os iluminará|strong="G5461,G1909,G846"\w*, \w e|strong="G2532"\w* \w reinarão|strong="G936"\w* \w para os séculos|strong="G1519,G3588,G165"\w* \w dos séculos|strong="G3588,G165"\w*.\f + \fr 22.5: \ft Variante: o RP traz “ali” (ἐκεῖ) em lugar de “mais” (ἔτι) depois de “noite”, omite “de luz” (φωτός) antes de “de lâmpada” e omite ἐπʼ; para “de sol”, WH traz φῶς (“luz”) e NA28, Treg e o RP trazem φωτός (“de luz”).\f*\f + \fr 22.5: \ft Nota cultural: o Senhor como luz dos seus ecoa Is 60:19-20 e a bênção de Nm 6:25.\f*\x - \xo 22:5 \xt ISA 60:19; NUM 6:25; REV 21:23; ISA 60:1; 1JN 1:5; PSA 36:8\x*
\v 6 \w E|strong="G2532"\w* \w me disse|strong="G2036,G3165"\w*: “\w Estas|strong="G3778"\w* \w palavras|strong="G3588,G3056"\w* \add são\add* \w fiéis|strong="G4103"\w* \w e|strong="G2532"\w* \w verdadeiras|strong="G228"\w*; \w e|strong="G2532"\w* \w o Senhor|strong="G3588,G2962"\w*, \w o Deus|strong="G3588,G2316"\w* \w dos espíritos|strong="G3588,G4151"\w* \w dos profetas|strong="G3588,G4396"\w*, \w enviou|strong="G649"\w* \w o seu anjo|strong="G3588,G32,G846"\w* \w para mostrar|strong="G1166"\w* \w aos seus servos|strong="G3588,G1401,G846"\w* \w as coisas que|strong="G3739"\w* \w é necessário que|strong="G1163"\w* \w aconteçam|strong="G1096"\w* \w depressa|strong="G1722,G5034"\w*.\f + \fr 22.6: \ft Variante: o TR traz “dos santos profetas” (τῶν ἁγίων προφητῶν) em lugar de “dos espíritos dos profetas”; o RP traz λέγει (“diz”) em lugar de εἶπεν e omite o artigo ὁ antes de “Senhor”.\f*\f + \fr 22.6: \ft Acréscimo: “são” (em “Estas palavras são fiéis e”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\f + \fr 22.6: \ft Tradução: δούλοις (δοῦλος, G1401) está aqui como “aos seus servos”; o termo pode ser “escravo” (condição social), “servo” ou “servidor”, e o contexto decide.\f*\x - \xo 22:6 \xt REV 1:1; REV 21:5; PSA 36:8; REV 1:3; JHN 16:13; REV 22:16\x*
\v 7 \w E|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w venho|strong="G2064"\w* \w depressa|strong="G5035"\w*. \w Feliz|strong="G3107"\w* \w o que guarda|strong="G3588,G5083"\w* \w as palavras|strong="G3588,G3056"\w* \w da profecia|strong="G3588,G4394"\w* \w deste livro|strong="G3588,G975,G3778"\w*.”\f + \fr 22.7: \ft Nota cultural: a bem-aventurança sobre quem guarda as palavras deste livro retoma 1:3.\f*\x - \xo 22:7 \xt REV 1:3; REV 22:18; REV 22:9; REV 22:12; JAS 1:22; PSA 36:8\x*
\v 8 \w E eu|strong="G2532_A,G1473"\w*, \w João|strong="G2491"\w*, \add sou\add* \w o que ouvia|strong="G3588,G191"\w* \w e|strong="G2532"\w* \w via|strong="G991"\w* \w estas coisas|strong="G3778"\w*. \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w ouvi|strong="G191"\w* \w e|strong="G2532"\w* \w vi|strong="G991"\w*, \w caí|strong="G4098"\w* \w para adorar|strong="G4352"\w* \w diante|strong="G1715"\w* \w dos pés|strong="G3588,G4228"\w* \w do anjo|strong="G3588,G32"\w* \w que me mostrava|strong="G3588,G1166,G3165"\w* \w estas coisas|strong="G3778"\w*.\f + \fr 22.8: \ft Acréscimo: “sou” (em “eu João sou o que”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 22:8 \xt REV 19:10; MAT 4:9; ACT 10:25; PSA 36:8; JHN 16:13; PSA 95:6\x*
\v 9 \w E|strong="G2532"\w* \w me disse|strong="G3004,G3165"\w*: “\w Cuidado|strong="G3708"\w*, \w não|strong="G3361"\w* \add faça isso!\add* \w Sou conservo|strong="G4889,G1510"\w* \w seu|strong="G4771"\w* \w e|strong="G2532"\w* \w dos seus|strong="G3588,G4771"\w* \w irmãos|strong="G80"\w*, \w os profetas|strong="G3588,G4396"\w*, \w e|strong="G2532"\w* \w dos que guardam|strong="G3588,G5083"\w* \w as palavras|strong="G3588,G3056"\w* \w deste livro|strong="G3588,G975,G3778"\w*; \w adore|strong="G4352"\w* \w a Deus|strong="G3588,G2316"\w*.”\f + \fr 22.9: \ft Acréscimo: “faça” (em “Cuidado não faça isso Sou”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; “isso” (em “não faça isso Sou conservo”): demonstrativo acrescentado para retomar o que foi dito.\f*\x - \xo 22:9 \xt REV 19:10; REV 22:7; PSA 36:8; JHN 16:13; ACT 10:25; LUK 4:8\x*
\v 10 \w E|strong="G2532"\w* \w me disse|strong="G3004,G3165"\w*: “\w Não|strong="G3361"\w* \w sele|strong="G4972"\w* \w as palavras|strong="G3588,G3056"\w* \w da profecia|strong="G3588,G4394"\w* \w deste livro|strong="G3588,G975,G3778"\w*, \w porque|strong="G1063"\w* \w o tempo|strong="G3588,G2540"\w* \w está próximo|strong="G1451,G1510"\w*.\f + \fr 22.10: \ft Nota cultural: a ordem de não selar contrasta com Dn 12:4 e 9, onde as palavras são seladas para um tempo distante.\f*\x - \xo 22:10 \xt DAN 12:4; REV 1:3; REV 22:7; PSA 36:8; JHN 16:13; DAN 8:26\x*
\v 11 \w O que é injusto|strong="G3588,G91"\w* \w seja injusto|strong="G91"\w* \w ainda|strong="G2089"\w*; \w e|strong="G2532"\w* \w o que é imundo|strong="G3588,G4508"\w* \w seja imundo|strong="G4510"\w* \w ainda|strong="G2089"\w*; \w e|strong="G2532"\w* \w o justo|strong="G3588,G1342"\w* \w pratique|strong="G4160"\w* \w justiça|strong="G1343"\w* \w ainda|strong="G2089"\w*; \w e|strong="G2532"\w* \w o santo|strong="G3588,G40"\w* \w seja santificado|strong="G37"\w* \w ainda|strong="G2089"\w*.\f + \fr 22.11: \ft Lit.: Ἔτι, “ainda, de novo, por mais tempo”: a ordem permite que cada um continue como está, pois o tempo é curto.\f*\f + \fr 22.11: \ft Nota cultural: o versículo ecoa Dn 12:10.\f*\f + \fr 22.11: \ft Variante: WH, Treg e NA28 trazem ῥυπανθήτω (outra forma de “seja imundo”) em lugar de ῥυπαρευθήτω.\f*\f + \fr 22.11: \ft Acréscimo: verbo ser/estar suprido em “o que é imundo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:11 \xt DAN 12:10; PRO 4:18; EZK 3:27; 2TI 3:13; MAT 15:14; PSA 36:8\x*
\v 12 \w Olhem|strong="G2400"\w*, \w venho|strong="G2064"\w* \w depressa|strong="G5036"\w*, \w e|strong="G2532"\w* \w o meu salário|strong="G3588,G3408,G3165"\w* \w está comigo|strong="G3326,G1473"\w*, \w para retribuir|strong="G591"\w* \w a cada um|strong="G1538"\w* \w conforme é|strong="G5613,G1510"\w* \w a obra|strong="G3588,G2041"\w* \w dele|strong="G846"\w*.\f + \fr 22.12: \ft Nota cultural: o salário que acompanha o Senhor ecoa Is 40:10 e 62:11.\f*\f + \fr 22.12: \ft Variante: o RP traz o futuro ἔσται (“será”) em lugar de ἐστίν.\f*\f + \fr 22.12: \ft Acréscimo: verbo ser/estar suprido em “está comigo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:12 \xt ISA 62:11; ISA 40:10; ROM 2:6; 1CO 3:14; 1CO 3:8; MAT 16:27\x*
\v 13 \w Eu sou|strong="G1473"\w* \w o Alfa|strong="G3588,G1"\w* \w e|strong="G2532"\w* \w o Ômega|strong="G3588,G5598"\w*, \w o primeiro|strong="G3588,G4413"\w* \w e|strong="G2532"\w* \w o último|strong="G3588,G2078"\w*, \w o princípio|strong="G3588,G746"\w* \w e|strong="G2532"\w* \w o fim|strong="G3588,G5056"\w*.\f + \fr 22.13: \ft Nota cultural: os três pares de títulos (Alfa e Ômega, primeiro e último, princípio e fim) reúnem 1:8, 1:17 e 21:6 e remetem a Is 44:6 e 48:12.\f*\f + \fr 22.13: \ft Acréscimo: verbo ser/estar suprido em “Eu sou”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:13 \xt ISA 44:6; ISA 48:12; REV 1:8; REV 21:6; JHN 1:1; GEN 1:1\x*
\v 14 \w Felizes|strong="G3107"\w* \w os que lavam|strong="G3588,G4150"\w* \w as suas roupas|strong="G3588,G4749,G846"\w*, \w para que|strong="G2443"\w* \w seja|strong="G1510"\w* \w a autoridade|strong="G3588,G1849"\w* \w deles|strong="G846"\w* \w sobre a árvore|strong="G1909,G3588,G3586"\w* \w da vida|strong="G3588,G2222"\w* \w e|strong="G2532"\w* \w possam entrar|strong="G1525"\w* \w pelos portões|strong="G3588,G4440"\w* \w na cidade|strong="G1519,G3588,G4172"\w*.\f + \fr 22.14: \ft Lit.: Ἐξουσία, “autoridade, direito”: aqui, o direito de acesso à árvore da vida.\f*\f + \fr 22.14: \ft Variante: o TR e o RP trazem “os que praticam os seus mandamentos” (ποιοῦντες τὰς ἐντολὰς αὐτοῦ) em lugar de “os que lavam as suas roupas” (πλύνοντες τὰς στολὰς αὐτῶν).\f*\x - \xo 22:14 \xt REV 7:14; PSA 1:1; DEU 11:27; JOS 1:8; REV 21:27; 1JN 5:3\x*
\v 15 \w Fora|strong="G1854"\w* \w os cães|strong="G3588,G2965"\w* \w e|strong="G2532"\w* \w os feiticeiros|strong="G3588,G5333"\w* \w e|strong="G2532"\w* \w os imorais sexuais|strong="G3588,G4205"\w* \w e|strong="G2532"\w* \w os assassinos|strong="G3588,G5406"\w* \w e|strong="G2532"\w* \w os idólatras|strong="G3588,G1496"\w*, \w e|strong="G2532"\w* \w todo aquele|strong="G3956"\w* \w que ama|strong="G5368"\w* \w e|strong="G2532"\w* \w pratica|strong="G4160"\w* \w mentira|strong="G5579"\w*.\f + \fr 22.15: \ft Lit.: κύνες, “cães”, termo de desprezo para os impuros (cf. Dt 23:18 e Fp 3:2).\f*\x - \xo 22:15 \xt PHP 3:2; DEU 23:18; REV 21:8; EPH 5:5; 1CO 6:9; PSA 36:8\x*
\v 16 \w Eu|strong="G1473"\w*, \w Jesus|strong="G2424"\w*, \w enviei|strong="G3992"\w* \w o meu anjo|strong="G3588,G32,G3165"\w* \w para testemunhar|strong="G3140"\w* \w a vocês|strong="G4771"\w* \w estas coisas|strong="G3778"\w* \w nas comunidades|strong="G1909,G3588,G1577"\w*. \w Eu|strong="G1473"\w* \w sou|strong="G1510"\w* \w a raiz|strong="G3588,G4491"\w* \w e|strong="G2532"\w* \w a descendência|strong="G3588,G1085"\w* \w de Davi|strong="G1138"\w*, \w a estrela brilhante|strong="G3588,G792,G2986"\w*, \w a da manhã|strong="G3588,G4407"\w*.”\f + \fr 22.16: \ft Nota cultural: raiz e descendência de Davi retomam 5:5 e Is 11:1 e 10; a estrela da manhã ecoa Nm 24:17 e 2:28.\f*\f + \fr 22.16: \ft Variante: o TR traz “e” (καί) em lugar de “a” (ὁ) antes de “estrela”.\f*\x - \xo 22:16 \xt ISA 11:1; NUM 24:17; NUM 2:28; REV 2:28; REV 1:1; PSA 36:8\x*
\v 17 \w E|strong="G2532"\w* \w o Espírito|strong="G3588,G4151"\w* \w e|strong="G2532"\w* \w a noiva|strong="G3588,G3565"\w* \w dizem|strong="G3004"\w*: “\w Venha|strong="G2064"\w*!” \w E|strong="G2532"\w* \w o que ouve|strong="G3588,G191"\w* \w diga|strong="G2036"\w*: “\w Venha|strong="G2064"\w*!” \w E|strong="G2532"\w* \w o que tem sede|strong="G3588,G1372"\w* \w venha|strong="G2064"\w*; \w o que quiser|strong="G3588,G2309"\w* \w receba|strong="G2983"\w* \w água|strong="G5204"\w* \w da vida|strong="G2222"\w*, \w gratuitamente|strong="G1432"\w*.\f + \fr 22.17: \ft Lit.: o imperativo Ἔρχου (“venha”) é dirigido a Jesus (cf. v. 20); no fim do versículo, ἐρχέσθω (“venha”) é um convite a quem tem sede.\f*\x - \xo 22:17 \xt REV 21:6; ISA 44:3; JHN 4:14; MAT 11:28; JHN 6:35; JHN 14:6\x*
\v 18 \w Eu testemunho|strong="G3140,G1473"\w* \w a todo|strong="G3956"\w* \w aquele que ouve|strong="G3588,G191"\w* \w as palavras|strong="G3588,G3056"\w* \w da profecia|strong="G3588,G4394"\w* \w deste livro|strong="G3588,G975,G3778"\w*: \w se alguém|strong="G1437,G5100"\w* \w acrescentar|strong="G2007"\w* \w a elas|strong="G1909,G846"\w*, \w Deus|strong="G3588,G2316"\w* \w acrescentará|strong="G2007"\w* \w a ele|strong="G1909,G846"\w* \w as pragas escritas|strong="G3588,G4127,G1125"\w* \w neste livro|strong="G1722,G3588,G975,G3778"\w*;\f + \fr 22.18: \ft Nota cultural: a advertência de não acrescentar nem tirar nada lembra Dt 4:2 e 12:32.\f*\f + \fr 22.18: \ft Variante: o RP traz o optativo ἐπιθήσαι (“acrescente”) em lugar de ἐπιθήσει.\f*\x - \xo 22:18 \xt DEU 12:32; DEU 4:2; REV 22:7; PRO 30:6; GAL 1:8; REV 1:3\x*
\v 19 \w e|strong="G2532"\w* \w se alguém|strong="G1437,G5100"\w* \w tirar|strong="G851"\w* \w das palavras|strong="G575,G3588,G3056"\w* \w do livro|strong="G3588,G975"\w* \w desta profecia|strong="G3588,G4394,G3778"\w*, \w Deus|strong="G3588,G2316"\w* \w tirará|strong="G851"\w* \w a parte|strong="G3588,G3313"\w* \w dele|strong="G846"\w* \w da árvore da vida|strong="G575,G3588,G3586,G2222"\w* \w e|strong="G2532"\w* \w da cidade|strong="G1537,G3588,G4172"\w* \w santa|strong="G3588,G40"\w*, \w das coisas escritas|strong="G3588,G1125"\w* \w neste livro|strong="G1722,G3588,G975,G3778"\w*.\f + \fr 22.19: \ft Variante: o TR traz “do livro da vida” (βίβλου τῆς ζωῆς) em lugar de “da árvore da vida” (ξύλου τῆς ζωῆς); o RP traz o optativo ἀφέλοι (“tire”) em lugar de ἀφελεῖ.\f*\x - \xo 22:19 \xt DEU 4:2; GAL 1:8; DEU 12:32; PRO 30:6; JHN 16:13; GAL 1:9\x*
\v 20 \w Diz|strong="G3004"\w* \w o que testemunha|strong="G3588,G3140"\w* \w estas coisas|strong="G3778"\w*: “\w Sim|strong="G3483"\w*, \w venho|strong="G2064"\w* \w depressa|strong="G5035"\w*.” \w Amém|strong="G281"\w*! \w Venha|strong="G2064"\w*, \w Senhor|strong="G2962"\w* \w Jesus|strong="G2424"\w*!\f + \fr 22.20: \ft Variante: o TR e o RP acrescentam “Sim” (ναί) antes de “Venha, Senhor Jesus”.\f*\x - \xo 22:20 \xt ROM 13:11; REV 22:7; REV 3:11; REV 22:12; HEB 9:28; MAT 28:20\x*
\v 21 \w A graça|strong="G3588,G5485"\w* \w do Senhor|strong="G3588,G2962"\w* \w Jesus|strong="G2424"\w* \w esteja com|strong="G3326"\w* \w todos|strong="G3956"\w*.\f + \fr 22.21: \ft Variante: WH e o RP acrescentam “Cristo” (Χριστοῦ) depois de “Jesus”; o TR acrescenta “nosso” (ἡμῶν) depois de “Senhor”; em lugar de “com todos” (πάντων), WH e Treg trazem “com os santos” (τῶν ἁγίων), o RP “com todos os santos. Amém” e o TR “com todos vocês. Amém” (ὑμῶν ἀμήν).\f*\f + \fr 22.21: \ft Acréscimo: verbo ser/estar suprido em “esteja com”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 22:21 \xt MAT 28:20; JHN 16:13; 2TH 3:18; ROM 16:20; MAL 4:6; 2CO 13:14\x*
