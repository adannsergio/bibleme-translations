\p
\v 1 \w Revelação|strong="G602"\w* \w de Jesus Cristo|strong="G2424,G5547"\w*, \w que|strong="G3739"\w* \w deu|strong="G1325"\w* \w a ele|strong="G846"\w* \w Deus|strong="G3588,G2316"\w* \w para mostrar|strong="G1166"\w* \w aos servos|strong="G3588,G1401"\w* \w dele|strong="G846"\w*, \w as coisas que|strong="G3739"\w* \w é necessário|strong="G1163"\w* \w que aconteçam|strong="G1096"\w* \w em breve|strong="G1722,G5034"\w*, \w e|strong="G2532"\w* \w deu a conhecer|strong="G4591"\w* \w enviando|strong="G649"\w* \w por meio|strong="G1223"\w* \w do anjo|strong="G3588,G32"\w* \w dele|strong="G846"\w* \w ao servo|strong="G3588,G1401"\w* \w dele|strong="G846"\w* \w João|strong="G2491"\w*,\f + \fr 1.1: \ft Lit.: Ἀποκάλυψις, “revelação, descobrimento”; σημαίνω, “indicar, dar a conhecer por sinais”.\f*\f + \fr 1.1: \ft Nota cultural: “as coisas que é necessário que aconteçam” ecoa Dn 2:28-29, 45 (LXX): “o que deve acontecer no fim dos dias”; ἐν τάχει também pode ser “com rapidez” (cf. 22:6).\f*\f + \fr 1.1: \ft Lit.: δοῦλος aqui como autodesignação devocional, “servo de Deus/Cristo” (eco do hebraico עבד יהוה, “servo do SENHOR”, título de Moisés e dos profetas); onde a mesma palavra descreve a condição social, fica “escravo” (ver convencoes.md).\f*\x - \xo 1:1 \xt DAN 2:28-29; REV 22:6; AMO 3:7; REV 22:16; GAL 1:12; JHN 15:15\x*
\v 2 \w o qual|strong="G3739"\w* \w testemunhou|strong="G3140"\w* \w a palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w o testemunho|strong="G3588,G3141"\w* \w de Jesus Cristo|strong="G2424,G5547"\w*, \w tudo o que|strong="G3745"\w* \w viu|strong="G1492"\w*.\x - \xo 1:2 \xt JHN 21:24; JHN 3:11; 1JN 5:9; JHN 19:35; JHN 5:31; JHN 1:7\x*
\v 3 \w Feliz|strong="G3107"\w* \w o que lê|strong="G3588,G314"\w* \w e|strong="G2532"\w* \w os que ouvem|strong="G3588,G191"\w* \w as palavras|strong="G3588,G3056"\w* \w da profecia|strong="G3588,G4394"\w* \w e|strong="G2532"\w* \w guardam|strong="G5083"\w* \w as coisas|strong="G3588"\w* \w nela|strong="G1722,G846"\w* \w escritas|strong="G1125"\w*, \w pois|strong="G1063"\w* \w o|strong="G3588"\w* \w tempo|strong="G2540"\w* \w está próximo|strong="G1451"\w*.\f + \fr 1.3: \ft Acréscimo: verbo ser/estar suprido em “está próximo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 1:3 \xt REV 22:10; REV 22:7; LUK 11:28; ROM 13:11; 1PE 4:7; PRO 8:34\x*
\v 4 \w João|strong="G2491"\w* \w às sete|strong="G3588,G2033"\w* \w comunidades|strong="G1577"\w* \w que estão|strong="G3588"\w* \w na Ásia|strong="G1722,G3588,G773"\w*: \w graça|strong="G5485"\w* \w a vocês|strong="G4771"\w* \w e|strong="G2532"\w* \w paz|strong="G1515"\w* \w da parte|strong="G575"\w* \w daquele que é|strong="G3588,G1510"\w* \w e|strong="G2532"\w* \w que era|strong="G3588,G1510"\w* \w e|strong="G2532"\w* \w que vem|strong="G3588,G2064"\w*, \w e|strong="G2532"\w* \w da parte|strong="G575"\w* \w dos sete|strong="G3588,G2033"\w* \w espíritos|strong="G4151"\w* \w que estão|strong="G3739"\w* \w diante|strong="G1799"\w* \w do trono|strong="G3588,G2362"\w* \w dele|strong="G846"\w*\f + \fr 1.4: \ft Variante: o RP acrescenta “Deus” (θεοῦ) depois de “da parte de”; o TR traz o artigo τοῦ diante da fórmula.\f*\f + \fr 1.4: \ft Lit.: Ἀπὸ ὁ ὢν καὶ ὁ ἦν καὶ ὁ ἐρχόμενος: o nominativo depois de ἀπό (“da parte de”) é irregular e parece deliberado, tratando a fórmula como nome indeclinável de Deus (cf. Êx 3:14). Os “sete espíritos” diante do trono: o Espírito de Deus em sua plenitude (cf. 3:1; 4:5; 5:6) ou sete seres celestes; o sentido é discutido.\f*,\f + \fr 1.4: \ft Acréscimo: “que estão”, “que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 1:4 \xt EXO 3:14; COL 1:2; HEB 13:8; PHP 4:7; ISA 11:2; REV 1:8\x*
\v 5 \w e|strong="G2532"\w* \w da parte|strong="G575"\w* \w de Jesus Cristo|strong="G2424,G5547"\w*, \w a testemunha|strong="G3588,G3144"\w* \w a fiel|strong="G3588,G4103"\w*, \w o primogênito|strong="G3588,G4416"\w* \w dos mortos|strong="G3588,G3498"\w* \w e|strong="G2532"\w* \w o governante|strong="G3588,G758"\w* \w dos reis|strong="G3588,G935"\w* \w da terra|strong="G3588,G1093"\w*. \w Àquele que nos ama|strong="G3588,G25,G3165"\w* \w e|strong="G2532"\w* \w nos libertou|strong="G3089,G3165"\w* \w dos nossos|strong="G1537,G3588,G3165"\w* \w pecados|strong="G266"\w* \w no sangue|strong="G1722,G3588,G129"\w* \w dele|strong="G846"\w*—\f + \fr 1.5: \ft Variante: o TR e a tradição bizantina trazem λούσαντι (“lavou”) em lugar de λύσαντι (“libertou”).\f*\x - \xo 1:5 \xt JHN 3:16; ROM 8:29; COL 1:18; PSA 89:27; 1JN 1:7; JHN 14:6\x*
\v 6 \w e|strong="G2532"\w* \w fez|strong="G4160"\w*-\w nos|strong="G3165"\w* \w reino|strong="G932"\w*, \w sacerdotes|strong="G2409"\w* \w para o Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w Pai|strong="G3962"\w* \w dele|strong="G846"\w* — \w a ele|strong="G846"\w* \w a|strong="G3588"\w* \w glória|strong="G1391"\w* \w e|strong="G2532"\w* \w o|strong="G3588"\w* \w domínio|strong="G2904"\w* \w para os séculos|strong="G1519,G3588,G165"\w* \w dos séculos|strong="G3588,G165"\w*: \w amém|strong="G281"\w*.\f + \fr 1.6: \ft Nota cultural: ecoa Êx 19:6 (“reino de sacerdotes”) e Is 61:6.\f*\f + \fr 1.6: \ft Variante: o TR traz “reis” (βασιλεῖς) em lugar de “reino” (βασιλείαν) e acrescenta “e” (καί) antes de “sacerdotes”; WH omite “dos séculos” (τῶν αἰώνων).\f*\x - \xo 1:6 \xt EXO 19:6; ISA 61:6; 1PE 5:11; REV 5:10; ROM 11:36; 1PE 2:9\x*
\v 7 \w Olhem|strong="G2400"\w*, \w vem|strong="G2064"\w* \w com as nuvens|strong="G3326,G3588,G3507"\w*, \w e|strong="G2532"\w* \w o verá|strong="G3700,G846"\w* \w todo olho|strong="G3956,G3788"\w*, \w e|strong="G2532"\w* \w os que|strong="G3748"\w* \w o traspassaram|strong="G846,G1574"\w*, \w e|strong="G2532"\w* \w se lamentarão|strong="G2875"\w* \w por causa dele|strong="G1909,G846"\w* \w todas|strong="G3956"\w* \w as tribos|strong="G3588,G5443"\w* \w da terra|strong="G3588,G1093"\w*. \w Sim|strong="G3483"\w*, \w amém|strong="G281"\w*.\f + \fr 1.7: \ft Nota cultural: ecoa Dn 7:13 (vem com as nuvens) e Zc 12:10 (olharão para aquele a quem traspassaram; cf. Jo 19:37).\f*\x - \xo 1:7 \xt JHN 19:37; DAN 7:13; ZEC 12:10; MAT 24:30; MRK 14:62; LUK 21:27\x*
\v 8 \w Eu sou|strong="G1473,G1510"\w* \w o Alfa|strong="G3588,G1"\w* \w e|strong="G2532"\w* \w o Ômega|strong="G3588,G5598"\w*, \w diz|strong="G3004"\w* \w o Senhor|strong="G2962"\w*, \w Deus|strong="G3588,G2316"\w*, \w aquele que é|strong="G3588,G1510"\w* \w e|strong="G2532"\w* \w que era|strong="G3588,G1510"\w* \w e|strong="G2532"\w* \w que vem|strong="G3588,G2064"\w*, \w o Todo-Poderoso|strong="G3588,G3841"\w*.\f + \fr 1.8: \ft Lit.: Ἄλφα e Ὦ: a primeira e a última letras do alfabeto grego; παντοκράτωρ, “Todo-Poderoso” (na LXX, tradução de “Senhor dos Exércitos” ou “Shaddai”).\f*\f + \fr 1.8: \ft Variante: o TR acrescenta “princípio e fim” (ἀρχὴ καὶ τέλος) depois de “Ômega” e omite “Deus” (ὁ θεός).\f*\x - \xo 1:8 \xt REV 22:13; REV 21:6; JHN 1:1; HEB 13:8; ISA 44:6; EXO 3:14\x*
\v 9 \w Eu|strong="G1473"\w*, \w João|strong="G2491"\w*, \w o irmão|strong="G3588,G80"\w* \w de vocês|strong="G4771"\w* \w e|strong="G2532"\w* \w companheiro|strong="G4791"\w* \w na aflição|strong="G1722,G3588,G2347"\w* \w e|strong="G2532"\w* \w no reino|strong="G932"\w* \w e|strong="G2532"\w* \w na perseverança|strong="G5281"\w* \w em Jesus|strong="G1722,G2424"\w*, \w estive|strong="G1096"\w* \w na ilha|strong="G1722,G3588,G3520"\w* \w chamada|strong="G3588,G2564"\w* \w Patmos|strong="G3963"\w* \w por causa|strong="G1223"\w* \w da palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w do testemunho|strong="G3588,G3141"\w* \w de Jesus|strong="G2424"\w*.\f + \fr 1.9: \ft Variante: o RP e a tradição bizantina trazem “participante” (κοινωνός) em lugar de συγκοινωνός, acrescentam “Cristo” (Χριστῷ, Χριστοῦ) depois de “Jesus” (duas vezes) e “por causa de” (διά) antes de “o testemunho”.\f*\x - \xo 1:9 \xt ROM 5:3; ROM 10:17; HEB 12:1; REV 1:1; ACT 14:22; REV 3:10\x*
\v 10 \w Estive|strong="G1096"\w* \w em espírito|strong="G1722,G4151"\w* \w no dia|strong="G1722,G3588,G2250"\w* \w do Senhor|strong="G2960"\w*, \w e|strong="G2532"\w* \w ouvi|strong="G191"\w* \w atrás|strong="G3694"\w* \w de mim|strong="G3165"\w* \w uma voz|strong="G5456"\w* \w grande|strong="G3173"\w* \w como de trombeta|strong="G5613,G4536"\w*,\f + \fr 1.10: \ft Lit.: Κυριακὴ ἡμέρα, “dia do Senhor”: provavelmente o domingo, dia da ressurreição; ἐν πνεύματι, “em espírito”: em estado de êxtase profético, sob o Espírito.\f*\x - \xo 1:10 \xt REV 4:1; 1TH 4:16; ISA 58:13; REV 4:2; PSA 118:24; REV 21:10\x*
\v 11 \w dizendo|strong="G3004"\w*: “\w O que|strong="G3739"\w* \w vê|strong="G991"\w* \w escreva|strong="G1125"\w* \w num livro|strong="G1519,G975"\w* \w e|strong="G2532"\w* \w envie|strong="G3992"\w* \w às sete|strong="G3588,G2033"\w* \w comunidades|strong="G1577"\w*, \w a Éfeso|strong="G1519,G2181"\w* \w e|strong="G2532"\w* \w a Esmirna|strong="G1519,G4667"\w* \w e|strong="G2532"\w* \w a Pérgamo|strong="G1519,G4010"\w* \w e|strong="G2532"\w* \w a Tiatira|strong="G1519,G2363"\w* \w e|strong="G2532"\w* \w a Sardes|strong="G1519,G4554"\w* \w e|strong="G2532"\w* \w a Filadélfia|strong="G1519,G5359"\w* \w e|strong="G2532"\w* \w a Laodiceia|strong="G1519,G2993"\w*.”\f + \fr 1.11: \ft Nota cultural: as sete cidades da província romana da Ásia (oeste da atual Turquia) formam um circuito viário natural.\f*\f + \fr 1.11: \ft Variante: o TR acrescenta, no começo, “Eu sou o Alfa e o Ômega, o primeiro e o último” (ἐγώ εἰμι τὸ Α καὶ τὸ Ω, ὁ πρῶτος καὶ ὁ ἔσχατος) e “que estão na Ásia” (ταῖς ἐν Ἀσίᾳ) depois de “comunidades”.\f*\x - \xo 1:11 \xt REV 3:1; JHN 1:1; HEB 12:2; ISA 44:6; REV 2:1; MAT 18:20\x*
\v 12 \w E|strong="G2532"\w* \w voltei-me|strong="G1994"\w* \w para ver|strong="G991"\w* \w a voz|strong="G3588,G5456"\w* \w que|strong="G3748"\w* \w falava|strong="G2980"\w* \w comigo|strong="G3326,G1473"\w*; \w e|strong="G2532"\w* \w tendo me voltado|strong="G1994"\w* \w vi|strong="G1492"\w* \w sete|strong="G2033"\w* \w candelabros|strong="G3087"\w* \w de ouro|strong="G5552"\w*,\f + \fr 1.12: \ft Variante: a tradição bizantina acrescenta “ali” (ἐκεῖ) no começo.\f*\x - \xo 1:12 \xt REV 1:20; REV 2:1; ZEC 4:2; EXO 25:37; MAT 18:20; REV 1:13\x*
\v 13 \w e|strong="G2532"\w* \w no meio|strong="G1722,G3319"\w* \w dos candelabros|strong="G3588,G3087"\w* \w alguém semelhante|strong="G3664"\w* \w a um filho|strong="G5207"\w* \w de homem|strong="G444"\w*, \w vestido|strong="G1746"\w* \w com túnica até os pés|strong="G4158"\w* \w e|strong="G2532"\w* \w cingido|strong="G4024"\w* \w ao redor do peito|strong="G4314,G3588,G3149"\w* \w com um cinto|strong="G2223"\w* \w de ouro|strong="G5552"\w*;\f + \fr 1.13: \ft Lit.: Ὅμοιον υἱὸν ἀνθρώπου, “semelhante a um filho de homem”: ecoa Dn 7:13 e 10:5-6, sem artigo; remete ao título “Filho do Homem” dos evangelhos.\f*\f + \fr 1.13: \ft Variante: Treg e o RP acrescentam “sete” (ἑπτά) antes de “candelabros” e trazem υἱῷ (dativo) em lugar de υἱόν.\f*\x - \xo 1:13 \xt DAN 7:13; DAN 10:5; REV 15:6; REV 2:1; DAN 10:16; EXO 28:6-8\x*
\v 14 \w A|strong="G3588"\w* \w cabeça|strong="G2776"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w os cabelos|strong="G3588,G2359"\w* \add eram\add* \w brancos|strong="G3022"\w* \w como lã|strong="G5613,G2053"\w* \w branca|strong="G3022"\w*, \w como neve|strong="G5613,G5510"\w*, \w e|strong="G2532"\w* \w os olhos|strong="G3588,G3788"\w* \w dele|strong="G846"\w* \w como chama|strong="G5613,G5395"\w* \w de fogo|strong="G4442"\w*,\f + \fr 1.14: \ft Nota cultural: ecoa Dn 7:9 (cabelos como lã branca) e Dn 10:6 (olhos como tochas de fogo).\f*\f + \fr 1.14: \ft Acréscimo: “eram” (em “os cabelos eram brancos como”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 1:14 \xt DAN 10:6; DAN 7:9; REV 19:12; MAT 28:3; REV 2:18; DAN 10:5\x*
\v 15 \w e|strong="G2532"\w* \w os pés|strong="G3588,G4228"\w* \w dele|strong="G846"\w* \w semelhantes|strong="G3664"\w* \w a bronze incandescente|strong="G5474"\w*, \w como numa fornalha|strong="G5613,G1722,G2575"\w* \w refinado|strong="G4448"\w*, \w e|strong="G2532"\w* \w a|strong="G3588"\w* \w voz|strong="G5456"\w* \w dele|strong="G846"\w* \w como voz|strong="G5613,G5456"\w* \w de muitas|strong="G4183"\w* \w águas|strong="G5204"\w*,\f + \fr 1.15: \ft Lit.: Χαλκολίβανος, palavra rara de sentido incerto: “bronze polido, brilhante” ou “metal refinado”.\f*\f + \fr 1.15: \ft Variante: o RP traz πεπυρωμένοι (“incandescidos”, concordando com “pés”) em lugar de πεπυρωμένης.\f*\x - \xo 1:15 \xt REV 2:18; EZK 1:24; EZK 43:2; DAN 10:6; REV 14:2; REV 10:1\x*
\v 16 \w e|strong="G2532"\w* \w tendo|strong="G2192"\w* \w na sua|strong="G1722,G3588,G846"\w* \w mão direita|strong="G1188,G5495"\w* \w sete|strong="G2033"\w* \w estrelas|strong="G792"\w*, \w e|strong="G2532"\w* \w da boca|strong="G1537,G3588,G4750"\w* \w dele|strong="G846"\w* \w uma espada|strong="G4501"\w* \w de dois gumes|strong="G1366"\w* \w afiada|strong="G3691"\w* \w saindo|strong="G1607"\w*, \w e|strong="G2532"\w* \w a|strong="G3588"\w* \w aparência|strong="G3799"\w* \w dele|strong="G846"\w* \w como o sol|strong="G5613,G3588,G2246"\w* \w brilha|strong="G5316"\w* \w em seu|strong="G1722,G3588,G846"\w* \w poder|strong="G1411"\w*.\x - \xo 1:16 \xt REV 2:12; HEB 4:12; EPH 6:17; REV 19:15; REV 2:16; ISA 49:2\x*
\v 17 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w o vi|strong="G1492,G846"\w*, \w caí|strong="G4098"\w* \w aos pés|strong="G4314,G3588,G4228"\w* \w dele|strong="G846"\w* \w como morto|strong="G5613,G3498"\w*; \w e|strong="G2532"\w* \w pôs|strong="G5087"\w* \w a sua|strong="G3588,G846"\w* \w direita|strong="G1188"\w* \w sobre mim|strong="G1909,G1473"\w*, \w dizendo|strong="G3004"\w*: “\w Não tenha medo|strong="G3361,G5399"\w*; \w eu sou|strong="G1473,G1510"\w* \w o primeiro|strong="G3588,G4413"\w* \w e|strong="G2532"\w* \w o último|strong="G3588,G2078"\w*,\f + \fr 1.17: \ft Variante: o TR acrescenta “mão” (χεῖρα) depois de “direita”.\f*\x - \xo 1:17 \xt JHN 1:1; HEB 13:8; EXO 3:14; ISA 44:6; REV 22:13; REV 1:8\x*
\v 18 \w e|strong="G2532"\w* \w o que vive|strong="G3588,G2198"\w* — \w e|strong="G2532"\w* \w morri|strong="G1096,G3498"\w* \w e|strong="G2532"\w* \w olhe|strong="G2400"\w*, \w vivo|strong="G2198"\w* \w estou|strong="G1510"\w* \w para os séculos|strong="G1519,G3588,G165"\w* \w dos séculos|strong="G3588,G165"\w* — \w e|strong="G2532"\w* \w tenho|strong="G2192"\w* \w as chaves|strong="G3588,G2807"\w* \w da morte|strong="G3588,G2288"\w* \w e|strong="G2532"\w* \w do Hades|strong="G3588,G86"\w*\f + \fr 1.18: \ft Variante: o TR e a tradição bizantina acrescentam “amém” (ἀμήν) depois de “séculos”.\f*\f + \fr 1.18: \ft Lit.: Ἅιδης, “Hades”: o reino dos mortos.\f*.\x - \xo 1:18 \xt REV 20:14; ROM 6:9; HEB 13:8; MAT 16:19; HEB 7:25; ROM 14:8-9\x*
\v 19 \w Escreva|strong="G1125"\w* \w então|strong="G3767"\w* \w o que|strong="G3739"\w* \w viu|strong="G1492"\w* \w e|strong="G2532"\w* \w o que|strong="G3739"\w* \w são|strong="G1510"\w* \w e|strong="G2532"\w* \w o que|strong="G3739"\w* \w está para|strong="G3195"\w* \w acontecer|strong="G1096"\w* \w depois destas coisas|strong="G3326,G3778"\w*.\f + \fr 1.19: \ft Variante: NA28 traz γενέσθαι (aoristo) em lugar de γίνεσθαι (presente), com o mesmo sentido; o TR omite “então” (οὖν).\f*\x - \xo 1:19 \xt AMO 3:7; REV 1:1; HAB 2:2; JHN 16:13; REV 4:1; REV 1:2\x*
\v 20 \w O mistério|strong="G3588,G3466"\w* \w das sete|strong="G3588,G2033"\w* \w estrelas|strong="G792"\w* \w que|strong="G3739"\w* \w viu|strong="G1492"\w* \w na minha|strong="G1909,G3588,G3165"\w* \w direita|strong="G1188"\w*, \w e|strong="G2532"\w* \w os sete|strong="G3588,G2033"\w* \w candelabros|strong="G3087"\w* \w de ouro|strong="G3588,G5552"\w*: \w as sete|strong="G3588,G2033"\w* \w estrelas|strong="G792"\w* \w anjos|strong="G32"\w* \w das sete|strong="G3588,G2033"\w* \w comunidades|strong="G1577"\w* \w são|strong="G1510"\w*, \w e|strong="G2532"\w* \w os candelabros|strong="G3588,G3087"\w* \w os sete|strong="G3588,G2033"\w* \w são|strong="G1510"\w* \w as sete|strong="G2033"\w* \w comunidades|strong="G1577"\w*.”\f + \fr 1.20: \ft Lit.: Ἄγγελος, “anjo” ou “mensageiro”: o “anjo” de cada comunidade pode ser um ser celeste que a representa ou um líder/mensageiro humano; o sentido é discutido.\f*\f + \fr 1.20: \ft Variante: o RP traz ὧν (“das quais”) em lugar de οὓς (“que”); o TR acrescenta εἶδες (“viu”) em outro ponto do verso.\f*\x - \xo 1:20 \xt REV 2:1; REV 1:12; REV 3:1; DAN 12:3; REV 1:16; ZEC 4:2\x*
\c 2
\p
\v 1 \w Ao anjo|strong="G3588,G32"\w* \w da|strong="G3588"\w* \w comunidade|strong="G1577"\w* \w em Éfeso|strong="G1722,G2181"\w* \w escreva|strong="G1125"\w*: “\w Isto|strong="G3592"\w* \w diz|strong="G3004"\w* \w aquele que segura|strong="G3588,G2902"\w* \w as sete|strong="G3588,G2033"\w* \w estrelas|strong="G792"\w* \w na sua|strong="G1722,G3588,G846"\w* \w direita|strong="G1188"\w*, \w aquele que anda|strong="G3588,G4043"\w* \w no meio|strong="G1722,G3319"\w* \w dos sete|strong="G3588,G2033"\w* \w candelabros|strong="G3087"\w* \w de ouro|strong="G3588,G5552"\w*:\x - \xo 2:1 \xt REV 1:20; REV 3:1; REV 2:8; 2CO 6:16; MAT 18:20; REV 1:16\x*
\v 2 \w Conheço|strong="G6063"\w* \w as suas obras|strong="G3588,G2041,G4771"\w*, \w e|strong="G2532"\w* \w o trabalho|strong="G3588,G2873"\w* \w e|strong="G2532"\w* \w a perseverança|strong="G3588,G5281"\w* \w sua|strong="G4771"\w*, \w e|strong="G2532"\w* \w que|strong="G3754"\w* \w não|strong="G3756"\w* \w pode|strong="G1410"\w* \w suportar|strong="G941"\w* \w maus|strong="G2556"\w*, \w e|strong="G2532"\w* \w pôs à prova|strong="G3985"\w* \w os que dizem|strong="G3588,G3004"\w* \w a si mesmos|strong="G1438"\w* \w apóstolos|strong="G652"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w são|strong="G1510"\w*, \w e|strong="G2532"\w* \w os achou|strong="G2147,G846"\w* \w mentirosos|strong="G5571"\w*;\f + \fr 2.2: \ft Variante: o RP acrescenta “seu” (σου) depois de “trabalho” e “ser” (εἶναι) depois de “apóstolos”.\f*\x - \xo 2:2 \xt 1TH 1:3; 1JN 4:1; 2PE 2:1-3; 1TH 5:21; 2CO 11:13; REV 3:8\x*
\v 3 \w e|strong="G2532"\w* \w perseverança|strong="G5281"\w* \w tem|strong="G2192"\w*, \w e|strong="G2532"\w* \w suportou|strong="G941"\w* \w por causa|strong="G1223"\w* \w do meu|strong="G3588,G3165"\w* \w nome|strong="G3686"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w se cansou|strong="G2872"\w*.\f + \fr 2.3: \ft Variante: o RP traz οὐκ ἐκοπίασας (“não se cansou”, aoristo) em lugar do perfeito οὐ κεκοπίακες; o TR traz κεκοπίακας.\f*\x - \xo 2:3 \xt GAL 6:9; ISA 40:31; MAT 5:11; HEB 12:3; PRO 24:10; HEB 10:36\x*
\v 4 \w Mas|strong="G235"\w* \w tenho|strong="G2192"\w* \w contra você|strong="G2596,G4771"\w* \w que|strong="G3754"\w* \w o seu|strong="G3588,G4771"\w* \w amor|strong="G26"\w* \w o primeiro|strong="G3588,G4413"\w* \w abandonou|strong="G863"\w*.\f + \fr 2.4: \ft Tradução: ἀφῆκες (ἀφίημι, G863) está aqui como “abandonou”; o termo pode ser “deixar”, “perdoar”, “permitir”, “abandonar” ou “mandar embora”, e o contexto decide.\f*\x - \xo 2:4 \xt REV 2:19; MAT 24:12; JER 2:2-5; HEB 6:10-11; PHP 1:9; 2TH 1:3\x*
\v 5 \w Lembre-se|strong="G3421"\w* \w então|strong="G3767"\w* \w de onde|strong="G4159"\w* \w caiu|strong="G4098"\w*, \w e|strong="G2532"\w* \w arrependa-se|strong="G3340"\w* \w e|strong="G2532"\w* \w as primeiras|strong="G3588,G4413"\w* \w obras|strong="G2041"\w* \w faça|strong="G4160"\w*; \w se|strong="G1487"\w* \w não|strong="G3361"\w*, \w venho|strong="G2064"\w* \w a você|strong="G4771"\w*, \w e|strong="G2532"\w* \w moverei|strong="G2795"\w* \w o seu|strong="G3588,G4771"\w* \w candelabro|strong="G3087"\w* \w do seu|strong="G1537,G3588,G846"\w* \w lugar|strong="G5117"\w*, \w se|strong="G1437"\w* \w não|strong="G3361"\w* \w se arrepender|strong="G3340"\w*.\f + \fr 2.5: \ft Variante: WH traz πέπτωκες (forma diferente de πέπτωκας); o RP e o TR acrescentam “depressa” (ταχύ) depois de “a você”.\f*\x - \xo 2:5 \xt 2CO 13:5; REV 3:16; MAT 24:12; REV 3:2-3; REV 3:3; REV 3:19\x*
\v 6 \w Mas|strong="G235"\w* \w isto|strong="G3778"\w* \w tem|strong="G2192"\w*: \w que|strong="G3754"\w* \w odeia|strong="G3404"\w* \w as obras|strong="G3588,G2041"\w* \w dos nicolaítas|strong="G3588,G3531"\w*, \w as quais|strong="G3739"\w* \add também\add* \w eu|strong="G2532,G1473"\w* \w odeio|strong="G3404"\w*.\f + \fr 2.6: \ft Lit.: Νικολαΐται, “nicolaítas”: grupo de identificação incerta, associado à tolerância de práticas idolátricas e imorais (cf. 2:14-15).\f*\f + \fr 2.6: \ft Acréscimo: “também” (em “as quais também eu odeio”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 2:6 \xt PSA 101:3; PSA 26:5; REV 2:2; 2JN 1:9-10; PSA 139:21; REV 2:14-15\x*
\v 7 \w Quem tem|strong="G3588,G2192"\w* \w ouvido|strong="G3775"\w*, \w ouça|strong="G191"\w* \w o que|strong="G5101"\w* \w o Espírito|strong="G3588,G4151"\w* \w diz|strong="G3004"\w* \w às comunidades|strong="G3588,G1577"\w*. \w Ao que vence|strong="G3588,G3528"\w* \w darei|strong="G1325"\w* \w a ele|strong="G846"\w* \w comer|strong="G5315"\w* \w da árvore|strong="G1537,G3588,G3586"\w* \w da vida|strong="G3588,G2222"\w*, \w que|strong="G3739"\w* \w está|strong="G1510"\w* \w no paraíso|strong="G1722,G3588,G3857"\w* \w de Deus|strong="G3588,G2316"\w*.”\f + \fr 2.7: \ft Nota cultural: ecoa Gn 2:9 e 3:22, 24 (a árvore da vida).\f*\f + \fr 2.7: \ft Variante: o RP acrescenta “meu” (μου) depois de “Deus”; o TR traz “meio” (μέσῳ) antes de “paraíso”.\f*\x - \xo 2:7 \xt GEN 2:9; GEN 3:22; REV 2:11; REV 2:29; REV 3:22; REV 3:6\x*
\v 8 \w E|strong="G2532"\w* \w ao anjo|strong="G3588,G32"\w* \w da|strong="G3588"\w* \w comunidade|strong="G1577"\w* \w em Esmirna|strong="G1722,G4667"\w* \w escreva|strong="G1125"\w*: “\w Isto|strong="G3592"\w* \w diz|strong="G3004"\w* \w o primeiro|strong="G3588,G4413"\w* \w e|strong="G2532"\w* \w o último|strong="G3588,G2078"\w*, \w que|strong="G3739"\w* \w morreu|strong="G1096,G3498"\w* \w e|strong="G2532"\w* \w tornou a viver|strong="G2198"\w*:\f + \fr 2.8: \ft Lit.: ἐγένετο νεκρὸς καὶ ἔζησεν: literalmente “tornou-se morto e viveu”; o sentido é “morreu e voltou a viver” (o aoristo ἔζησεν marca o começo da vida, ou a volta a ela).\f*\x - \xo 2:8 \xt REV 2:1; JHN 1:1; ISA 44:6; HEB 12:2; REV 1:8; REV 1:17\x*
\v 9 \w Conheço|strong="G6063"\w* \w a sua|strong="G4771,G3588"\w* \w aflição|strong="G2347"\w* \w e|strong="G2532"\w* \w a pobreza|strong="G3588,G4432"\w*, \w mas|strong="G235"\w* \w rico|strong="G4145"\w* \w é|strong="G1510"\w*, \w e|strong="G2532"\w* \w a blasfêmia|strong="G3588,G988"\w* \w da parte dos|strong="G1537,G3588"\w* \w que dizem ser|strong="G3004,G1511,G1438"\w* \w judeus|strong="G2453"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w são|strong="G1510"\w*, \w mas|strong="G235"\w* \w uma sinagoga|strong="G4864"\w* \w de Satanás|strong="G3588,G4567"\w*.\f + \fr 2.9: \ft Nota cultural: “os que dizem ser judeus e não são” indica um conflito local entre a comunidade e uma sinagoga (cf. 3:9); o texto não permite generalizar a todo o povo judeu.\f*\f + \fr 2.9: \ft Variante: o RP e a tradição bizantina acrescentam “as obras e” (τὰ ἔργα καί) depois de “Conheço”.\f*\x - \xo 2:9 \xt 2CO 8:9; REV 3:9; 1CO 8:3; JAS 2:5; REV 2:10; MAT 6:20\x*
\v 10 \w Nada|strong="G3367"\w* \w tema|strong="G5399"\w* \w do que|strong="G3739"\w* \w está para|strong="G3195"\w* \w sofrer|strong="G3958"\w*. \w Olhem|strong="G2400"\w*, \w o diabo|strong="G3588,G1228"\w* \w está para|strong="G3195"\w* \w lançar|strong="G906"\w* \w alguns dentre vocês|strong="G1537,G4771"\w* \w na prisão|strong="G1519,G5438"\w*, \w para que|strong="G2443"\w* \w sejam provados|strong="G3985"\w*, \w e|strong="G2532"\w* \w terão|strong="G2192"\w* \w aflição|strong="G2347"\w* \w de dez|strong="G1176"\w* \w dias|strong="G2250"\w*. \w Seja|strong="G1096"\w* \w fiel|strong="G4103"\w* \w até a morte|strong="G891,G2288"\w*, \w e|strong="G2532"\w* \w darei|strong="G1325"\w* \w a você|strong="G4771"\w* \w a coroa|strong="G3588,G4735"\w* \w da vida|strong="G3588,G2222"\w*\f + \fr 2.10: \ft Variante: WH e Treg trazem μή em lugar de μηδέν (ambos “não/nada”); WH traz ἔχητε (“tenham”) em lugar de ἕξετε (“terão”).\f*\f + \fr 2.10: \ft Lit.: no mesmo verso a segunda pessoa passa do singular (o anjo/a comunidade) ao plural (os membros): “dentre vocês”, “sejam provados”.\f*.\x - \xo 2:10 \xt JAS 1:12; GAL 6:9; MAT 10:22; JAS 1:2; 1CO 10:13; MAT 24:13\x*
\v 11 \w Quem tem|strong="G3588,G2192"\w* \w ouvido|strong="G3775"\w*, \w ouça|strong="G191"\w* \w o que|strong="G5101"\w* \w o Espírito|strong="G3588,G4151"\w* \w diz|strong="G3004"\w* \w às comunidades|strong="G3588,G1577"\w*. \w O que vence|strong="G3588,G3528"\w* \w de modo algum|strong="G3756,G3361"\w* \w será ferido|strong="G91"\w* \w pela|strong="G1537,G3588"\w* \w morte|strong="G2288"\w* \w a segunda|strong="G3588,G1208"\w*.”\f + \fr 2.11: \ft Lit.: “a segunda morte”: expressão do Apocalipse para a condenação final (20:6, 14; 21:8).\f*\x - \xo 2:11 \xt REV 2:7; REV 3:22; REV 2:17; REV 2:29; REV 3:13; REV 3:6\x*
\v 12 \w E|strong="G2532"\w* \w ao anjo|strong="G3588,G32"\w* \w da|strong="G3588"\w* \w comunidade|strong="G1577"\w* \w em Pérgamo|strong="G1722,G4010"\w* \w escreva|strong="G1125"\w*: “\w Isto|strong="G3592"\w* \w diz|strong="G3004"\w* \w aquele que tem|strong="G3588,G2192"\w* \w a espada|strong="G3588,G4501"\w* \w a de dois gumes|strong="G3588,G1366"\w* \w a afiada|strong="G3588,G3691"\w*:\x - \xo 2:12 \xt REV 1:16; REV 2:16; HEB 4:12; ISA 49:2; 2TI 2:2; ISA 11:4\x*
\v 13 \w Conheço|strong="G6063"\w* \w onde|strong="G4226"\w* \w habita|strong="G2730"\w*, \w onde|strong="G3699"\w* \w o trono|strong="G3588,G2362"\w* \w de Satanás|strong="G3588,G4567"\w*, \w e|strong="G2532"\w* \w segura|strong="G2902"\w* \w o meu|strong="G3588,G3165"\w* \w nome|strong="G3686"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w negou|strong="G720"\w* \w a minha|strong="G3588,G3165"\w* \w fé|strong="G4102"\w* \w mesmo|strong="G2532"\w* \w nos dias|strong="G1722,G3588,G2250"\w* \w de Antipas|strong="G493"\w*, \w a minha|strong="G3588,G3165"\w* \w testemunha|strong="G3144"\w*, \w o meu|strong="G3588,G3165"\w* \w fiel|strong="G4103"\w*, \w que foi morto|strong="G3739,G615"\w* \w entre vocês|strong="G3844,G4771"\w*, \w onde|strong="G3699"\w* \w Satanás|strong="G3588,G4567"\w* \w habita|strong="G2730"\w*.\f + \fr 2.13: \ft Nota cultural: Antipas é conhecido só por este texto; a tradição posterior o faz bispo de Pérgamo martirizado.\f*\f + \fr 2.13: \ft Variante: o RP e a tradição bizantina acrescentam “as suas obras e” (τὰ ἔργα σου καί) depois de “Conheço”, omitem “mesmo” (καί), acrescentam “em que” (ἐν αἷς) depois de “dias” e omitem “meu” (μου) depois de “fiel”.\f*\x - \xo 2:13 \xt 1CO 8:3; 2TI 2:19; REV 3:8; REV 3:11; PRO 24:10; MAT 10:32\x*
\v 14 \w Mas|strong="G235"\w* \w tenho|strong="G2192"\w* \w contra você|strong="G2596,G4771"\w* \w algumas coisas|strong="G3641"\w*, \w porque|strong="G3754"\w* \w tem|strong="G2192"\w* \w ali|strong="G1563"\w* \w os que seguram|strong="G2902"\w* \w a doutrina|strong="G3588,G1322"\w* \w de Balaão|strong="G903"\w*, \w que ensinava|strong="G3739,G1321"\w* \w a Balaque|strong="G3588,G904"\w* \w pôr|strong="G906"\w* \w um tropeço|strong="G4625"\w* \w diante|strong="G1799"\w* \w dos filhos|strong="G3588,G5207"\w* \w de Israel|strong="G2474"\w*, \w comer|strong="G5315"\w* \w coisas sacrificadas a ídolos|strong="G1494"\w* \w e|strong="G2532"\w* \w se prostituir|strong="G4203"\w*;\f + \fr 2.14: \ft Nota cultural: refere-se a Balaão e Balaque (Nm 22–24) e ao episódio de Peor (Nm 25:1-3; 31:16).\f*\f + \fr 2.14: \ft Variante: o RP traz ἐδίδαξεν τὸν (“ensinou a”) em lugar de ἐδίδασκεν τῷ e acrescenta “e” (καί) antes de “comer”.\f*\x - \xo 2:14 \xt NUM 31:16; NUM 25:1; REV 2:20; 2PE 2:15; JUD 1:11; REV 2:4\x*
\v 15 \w Assim|strong="G3779"\w* \w tem|strong="G2192"\w* \w também|strong="G2532"\w* \w você|strong="G4771"\w* \w os que seguram|strong="G2902"\w* \w a doutrina|strong="G3588,G1322"\w* \w dos nicolaítas|strong="G3531"\w* \w do mesmo modo|strong="G3668"\w*.\f + \fr 2.15: \ft Variante: Treg, NA28 e o RP acrescentam “dos” (τῶν) antes de “nicolaítas”; o TR traz “que eu odeio” (ὅ μισῶ) em lugar de “do mesmo modo” (ὁμοίως).\f*\x - \xo 2:15 \xt REV 2:2; MAT 18:7; 2CO 2:17; 2TI 3:8; REV 2:6; 1TI 6:10\x*
\v 16 \w Arrependa-se|strong="G3340"\w* \w então|strong="G3767"\w*; \w se|strong="G1487"\w* \w não|strong="G3361"\w*, \w venho|strong="G2064"\w* \w a você|strong="G4771"\w* \w depressa|strong="G5035"\w*, \w e|strong="G2532"\w* \w lutarei|strong="G4170"\w* \w contra eles|strong="G3326,G846"\w* \w com a espada|strong="G1722,G3588,G4501"\w* \w da boca|strong="G3588,G4750"\w* \w minha|strong="G3165"\w*.\f + \fr 2.16: \ft Variante: o TR omite “então” (οὖν).\f*\x - \xo 2:16 \xt HEB 4:12; EPH 6:17; REV 2:5; REV 1:16; 2TH 2:8; REV 2:12\x*
\v 17 \w Quem tem|strong="G3588,G2192"\w* \w ouvido|strong="G3775"\w*, \w ouça|strong="G191"\w* \w o que|strong="G5101"\w* \w o Espírito|strong="G3588,G4151"\w* \w diz|strong="G3004"\w* \w às comunidades|strong="G3588,G1577"\w*. \w Ao que vence|strong="G3588,G3528"\w* \w darei|strong="G1325"\w* \w a ele|strong="G846"\w* \w do maná|strong="G3588,G3131"\w* \w escondido|strong="G3588,G2928"\w*, \w e|strong="G2532"\w* \w darei|strong="G1325"\w* \w a ele|strong="G846"\w* \w uma pedrinha|strong="G5586"\w* \w branca|strong="G3022"\w*, \w e|strong="G2532"\w* \w sobre a pedrinha|strong="G1909,G3588,G5586"\w* \w um nome|strong="G3686"\w* \w novo|strong="G2537"\w* \w escrito|strong="G1125"\w*, \w que|strong="G3739"\w* \w ninguém|strong="G3762"\w* \w conhece|strong="G6063"\w* \w a não ser|strong="G1487,G3361"\w* \w o que recebe|strong="G3588,G2983"\w*.”\f + \fr 2.17: \ft Lit.: Ψῆφος, “pedrinha, seixo” usado como voto, ficha de entrada ou amuleto; o sentido da “pedrinha branca” é discutido.\f*\f + \fr 2.17: \ft Variante: o RP acrescenta “comer” (φαγεῖν); o TR traz “comer de” (φαγεῖν ἀπό) antes de “maná”.\f*\x - \xo 2:17 \xt JER 33:3; REV 2:11; REV 3:22; REV 3:6; REV 2:7; JHN 6:31\x*
