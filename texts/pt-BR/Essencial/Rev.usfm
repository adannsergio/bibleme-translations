\p
\v 1 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w quando|strong="G3753"\w* \w o|strong="G3588"\w* \w cordeiro|strong="G721"\w* \w abriu|strong="G455"\w* \w um|strong="G1520"\w* \w dos|strong="G1537,G3588"\w* \w sete|strong="G2033"\w* \w selos|strong="G4973"\w*, \w e|strong="G2532"\w* \w ouvi|strong="G191"\w* \w um|strong="G1520"\w* \w dos quatro|strong="G1537,G3588,G5064"\w* \w seres vivos|strong="G2226"\w* \w dizendo|strong="G3004"\w* \w como voz|strong="G5613,G5456"\w* \w de trovão|strong="G1027"\w*: “\w Venha|strong="G2064"\w*\f + \fr 6.1: \ft Variante: o RP traz ὅτι (“que”) em lugar de ὅτε (“quando”) e acrescenta “e veja” (καὶ ἴδε) depois de “Venha”; o TR omite “sete” (ἑπτά).\f*\f + \fr 6.1: \ft Lit.: Ἔρχου, “vem”: imperativo dirigido ao cavaleiro (na leitura do SBLGNT); o RP acrescenta “e veja”, dirigido a João.\f*.”\x - \xo 6:1 \xt REV 6:7; REV 6:3; REV 6:5; JHN 1:29; REV 5:5; REV 5:1\x*
\v 2 \w e|strong="G2532"\w* \w vi|strong="G1492"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w um cavalo|strong="G2462"\w* \w branco|strong="G3022"\w*, \w e|strong="G2532"\w* \w o que estava sentado|strong="G3588,G2521"\w* \w sobre ele|strong="G1909,G846"\w* \w tendo|strong="G2192"\w* \w um arco|strong="G5115"\w*, \w e|strong="G2532"\w* \w foi dada|strong="G1325"\w* \w a ele|strong="G846"\w* \w uma coroa|strong="G4735"\w*, \w e|strong="G2532"\w* \w saiu|strong="G1831"\w* \w vencendo|strong="G3528"\w* \w e|strong="G2532"\w* \w para que|strong="G2443"\w* \w vencesse|strong="G3528"\w*.\f + \fr 6.2: \ft Variante: o RP omite “vi, e” (εἶδον καί).\f*\x - \xo 6:2 \xt REV 19:11; REV 14:14; ZEC 6:3; AMO 3:7; PSA 24:8; JHN 16:13\x*
\v 3 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w abriu|strong="G455"\w* \w o selo|strong="G3588,G4973"\w* \w o segundo|strong="G3588,G1208"\w*, \w ouvi|strong="G191"\w* \w do segundo|strong="G3588,G1208"\w* \w ser vivo|strong="G2226"\w* \w dizendo|strong="G3004"\w*: “\w Venha|strong="G2064"\w*.”\f + \fr 6.3: \ft Variante: o RP coloca “segundo” antes de “selo” (δευτέραν σφραγῖδα).\f*\f + \fr 6.3: \ft Acréscimo: verbo ser/estar suprido em “ser vivo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:3 \xt REV 6:7; REV 6:1; REV 8:1; REV 6:5; AMO 3:7; REV 4:7\x*
\v 4 \w e|strong="G2532"\w* \w saiu|strong="G1831"\w* \w outro|strong="G243"\w* \w cavalo|strong="G2462"\w* \w vermelho|strong="G4450"\w*, \w e|strong="G2532"\w* \w ao que estava sentado|strong="G3588,G2521"\w* \w sobre ele|strong="G1909,G846"\w* \w foi dado|strong="G1325"\w* \w a ele|strong="G846"\w* \w tirar|strong="G2983"\w* \w a paz|strong="G3588,G1515"\w* \w da terra|strong="G1537,G3588,G1093"\w* \w e|strong="G2532"\w* \w que uns aos outros|strong="G2443,G240"\w* \w se matassem|strong="G4969"\w*, \w e|strong="G2532"\w* \w foi dada|strong="G1325"\w* \w a ele|strong="G846"\w* \w uma espada|strong="G3162"\w* \w grande|strong="G3173"\w*.\f + \fr 6.4: \ft Variante: o RP omite “e” (καί) no começo e traz o subjuntivo σφάξωσιν (“se matem”).\f*\x - \xo 6:4 \xt MAT 10:34; AMO 3:7; ZEC 6:2; JER 15:2; JHN 16:13; ZEC 1:8\x*
\v 5 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w abriu|strong="G455"\w* \w o selo|strong="G3588,G4973"\w* \w o terceiro|strong="G3588,G5154"\w*, \w ouvi|strong="G191"\w* \w do terceiro|strong="G3588,G5154"\w* \w ser vivo|strong="G2226"\w* \w dizendo|strong="G3004"\w*: “\w Venha|strong="G2064"\w*.” \w E|strong="G2532"\w* \w vi|strong="G1492"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w um cavalo|strong="G2462"\w* \w preto|strong="G3189"\w*, \w e|strong="G2532"\w* \w o que estava sentado|strong="G3588,G2521"\w* \w sobre ele|strong="G1909,G846"\w* \w tendo|strong="G2192"\w* \w uma balança|strong="G2218"\w* \w na mão|strong="G1722,G3588,G5495"\w* \w dele|strong="G846"\w*.\f + \fr 6.5: \ft Lit.: Ζυγός, “balança” (também “jugo”).\f*\f + \fr 6.5: \ft Variante: o RP traz ἴδε (“veja”) em lugar de εἶδον (“vi”); o TR acrescenta “e veja” (καὶ βλέπε) depois de “Venha”.\f*\f + \fr 6.5: \ft Acréscimo: verbo ser/estar suprido em “ser vivo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:5 \xt REV 6:1; REV 6:3; AMO 3:7; ZEC 6:2; EZK 4:16; JER 15:2\x*
\v 6 \w E|strong="G2532"\w* \w ouvi|strong="G191"\w* \w como uma voz|strong="G5613,G5456"\w* \w no meio|strong="G1722,G3319"\w* \w dos quatro|strong="G3588,G5064"\w* \w seres vivos|strong="G2226"\w* \w dizendo|strong="G3004"\w*: “\w Uma medida|strong="G5518"\w* \w de trigo|strong="G4621"\w* \w por um denário|strong="G1220"\w*, \w e|strong="G2532"\w* \w três medidas|strong="G5140,G5518"\w* \w de cevada|strong="G2915"\w* \w por um denário|strong="G1220"\w*; \w e|strong="G2532"\w* \w o azeite|strong="G3588,G1637"\w* \w e|strong="G2532"\w* \w o vinho|strong="G3588,G3631"\w* \w não|strong="G3361"\w* \w danifique|strong="G91"\w*.”\f + \fr 6.6: \ft Nota cultural: uma χοῖνιξ equivale a cerca de um litro, a ração diária de trigo de um homem; um denário era o salário de um dia, de modo que os preços descrevem fome severa.\f*\f + \fr 6.6: \ft Variante: o RP omite “como” (ὡς) e traz κριθῆς em lugar de κριθῶν (“de cevada”).\f*\x - \xo 6:6 \xt AMO 3:7; REV 9:4; JER 15:2; JHN 16:13; 2KI 7:1; JHN 6:9\x*
\v 7 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w abriu|strong="G455"\w* \w o selo|strong="G3588,G4973"\w* \w o quarto|strong="G3588,G5067"\w*, \w ouvi|strong="G191"\w* \w a voz|strong="G5456"\w* \w do quarto|strong="G3588,G5067"\w* \w ser vivo|strong="G2226"\w* \w dizendo|strong="G3004"\w*: “\w Venha|strong="G2064"\w*.”\f + \fr 6.7: \ft Variante: o RP omite “voz” (φωνήν) e acrescenta “e veja” (καὶ ἴδε) depois de “Venha”.\f*\f + \fr 6.7: \ft Acréscimo: verbo ser/estar suprido em “ser vivo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 6:7 \xt REV 6:3; REV 6:1; REV 8:1; REV 4:7; AMO 3:7; JER 15:2\x*
\v 8 \w e|strong="G2532"\w* \w vi|strong="G1492"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w um cavalo|strong="G2462"\w* \w verde-pálido|strong="G5515"\w*, \w e|strong="G2532"\w* \w o que estava sentado|strong="G3588,G2521"\w* \w em cima|strong="G1883"\w* \w dele|strong="G846"\w*, \w o nome|strong="G3686"\w* \w dele|strong="G846"\w*: \w a|strong="G3588"\w* \w Morte|strong="G2288"\w*, \w e|strong="G2532"\w* \w o|strong="G3588"\w* \w Hades|strong="G86"\w* \w seguia|strong="G190"\w* \w com ele|strong="G3326,G846"\w*, \w e|strong="G2532"\w* \w foi dada|strong="G1325"\w* \w a eles|strong="G846"\w* \w autoridade|strong="G1849"\w* \w sobre a quarta parte|strong="G1909,G3588,G5067"\w* \w da terra|strong="G3588,G1093"\w*, \add para\add* \w matar|strong="G615"\w* \w com espada|strong="G1722,G4501"\w* \w e|strong="G2532"\w* \w com fome|strong="G1722,G3042"\w* \w e|strong="G2532"\w* \w com peste|strong="G1722,G2288"\w* \w e|strong="G2532"\w* \w pelas feras|strong="G5259,G3588,G2342"\w* \w da terra|strong="G3588,G1093"\w*\f + \fr 6.8: \ft Variante: o RP omite “vi, e” (εἶδον καί) e traz αὐτῷ (“a ele”) em lugar de μετʼ αὐτοῦ (“com ele”) e de αὐτοῖς (“a eles”).\f*\f + \fr 6.8: \ft Nota cultural: ecoa Ez 14:21 (espada, fome, feras e peste).\f*\f + \fr 6.8: \ft Lit.: Χλωρός, “verde-pálido, amarelado” (cor de cadáver ou de erva seca); ἐν θανάτῳ, “com morte”, possivelmente “com peste”.\f*.\f + \fr 6.8: \ft Acréscimo: “para” (em “da terra para matar com”): preposição ou artigo que a regência do português exige.\f*\x - \xo 6:8 \xt EZK 14:21; MAT 24:7; HOS 13:14; AMO 3:7; JER 15:2; REV 1:18\x*
\v 9 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w abriu|strong="G455"\w* \w o selo|strong="G3588,G4973"\w* \w o quinto|strong="G3991"\w*, \w vi|strong="G1492"\w* \w debaixo|strong="G5270"\w* \w do altar|strong="G3588,G2379"\w* \w as almas|strong="G3588,G5590"\w* \w dos que foram mortos|strong="G3588,G4969"\w* \w por causa|strong="G1223"\w* \w da palavra|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w por causa|strong="G1223"\w* \w do testemunho|strong="G3588,G3141"\w* \w que tinham|strong="G3739,G2192"\w*.\f + \fr 6.9: \ft Variante: o RP acrescenta “do cordeiro” (τοῦ ἀρνίου) depois de “testemunho”.\f*\x - \xo 6:9 \xt REV 20:4; MAT 24:9; JHN 16:2; REV 12:11; REV 12:17; REV 1:9\x*
\v 10 \w E|strong="G2532"\w* \w clamaram|strong="G2896"\w* \w em grande voz|strong="G5456,G3173"\w* \w dizendo|strong="G3004"\w*: “\w Até quando|strong="G2193,G4219"\w*, \w o Soberano|strong="G3588,G1203"\w* \w o santo|strong="G3588,G40"\w* \w e|strong="G2532"\w* \w verdadeiro|strong="G228"\w*, \w não|strong="G3756"\w* \w julga|strong="G2919"\w* \w e|strong="G2532"\w* \w vinga|strong="G1556"\w* \w o sangue|strong="G3588,G129"\w* \w nosso|strong="G3165"\w* \w contra os que habitam|strong="G1537,G3588,G2730"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*?”\x - \xo 6:10 \xt REV 19:2; LUK 18:7; MAT 24:9; PSA 9:12; REV 11:18; 2TH 1:6\x*
\v 11 \w e|strong="G2532"\w* \w foi dada|strong="G1325"\w* \w a eles|strong="G846"\w* \w a cada um|strong="G1538"\w* \w uma veste|strong="G4749"\w* \w branca|strong="G3022"\w*, \w e|strong="G2532"\w* \w foi dito|strong="G2046"\w* \w a eles|strong="G846"\w* \w que descansem|strong="G2443,G373"\w* \w ainda|strong="G2089"\w* \w um pouco|strong="G3398"\w* \w de tempo|strong="G5550"\w*, \w até que|strong="G2193"\w* \w se completem|strong="G4137"\w* \w também|strong="G2532"\w* \w os conservos|strong="G3588,G4889"\w* \w deles|strong="G846"\w* \w e|strong="G2532"\w* \w os irmãos e irmãs|strong="G3588,G80"\w* \w deles|strong="G846"\w*, \w os que estão para|strong="G3588,G3195"\w* \w ser mortos|strong="G615"\w* \w como também|strong="G5613,G2532"\w* \w eles|strong="G846"\w*\f + \fr 6.11: \ft Variante: o RP traz o subjuntivo ἀναπαύσωνται (“descansem”) em lugar de ἀναπαύσονται, omite “um pouco” (μικρόν), traz πληρώσωσιν (“completem”) em lugar de πληρωθῶσιν (Treg também) e acrescenta “e” (καί) depois de “deles”; o TR traz “vestes” (στολαί, plural).\f*.\x - \xo 6:11 \xt MAT 24:9; REV 14:13; REV 7:9; HEB 11:40; REV 3:4; AMO 3:7\x*
\v 12 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w quando|strong="G3753"\w* \w abriu|strong="G455"\w* \w o selo|strong="G3588,G4973"\w* \w o sexto|strong="G3588,G1623"\w*, \w e|strong="G2532"\w* \w um grande|strong="G3173"\w* \w terremoto|strong="G4578"\w* \w houve|strong="G1096"\w*, \w e|strong="G2532"\w* \w o|strong="G3588"\w* \w sol|strong="G2246"\w* \w se tornou|strong="G1096"\w* \w negro|strong="G3189"\w* \w como saco|strong="G5613,G4526"\w* \w de pelo|strong="G5155"\w*, \w e|strong="G2532"\w* \w a|strong="G3588"\w* \w lua|strong="G4582"\w* \w toda|strong="G3650"\w* \w se tornou|strong="G1096"\w* \w como sangue|strong="G5613,G129"\w*,\f + \fr 6.12: \ft Nota cultural: ecoa Jl 2:10, 31; Is 13:10; 50:3 (sol escurecido, lua como sangue).\f*\f + \fr 6.12: \ft Variante: o RP coloca “negro” antes de “se tornou” (μέλας ἐγένετο).\f*\x - \xo 6:12 \xt JOL 2:10; ISA 50:3; ISA 13:10; ACT 2:20; ISA 51:6; MAT 24:29\x*
\v 13 \w e|strong="G2532"\w* \w as|strong="G3588"\w* \w estrelas|strong="G792"\w* \w do céu|strong="G3588,G3772"\w* \w caíram|strong="G4098"\w* \w sobre a terra|strong="G1519,G3588,G1093"\w*, \w como uma figueira|strong="G5613,G4808"\w* \w lança|strong="G906"\w* \w os seus|strong="G3588,G846"\w* \w figos verdes|strong="G3653"\w* \w sacudida|strong="G4579"\w* \w por um grande|strong="G5259,G3173"\w* \w vento|strong="G417"\w*,\f + \fr 6.13: \ft Nota cultural: ecoa Is 34:4 (as estrelas caem como folhas da figueira).\f*\f + \fr 6.13: \ft Variante: o RP traz βαλοῦσα (“lançando”, particípio) em lugar de βάλλει.\f*\x - \xo 6:13 \xt ISA 34:4; MRK 13:25; ISA 51:6; JOL 2:31; LUK 21:25; MAT 24:29\x*
\v 14 \w e|strong="G2532"\w* \w o|strong="G3588"\w* \w céu|strong="G3772"\w* \w se retirou|strong="G673"\w* \w como um rolo|strong="G5613,G975"\w* \w enrolado|strong="G1667"\w*, \w e|strong="G2532"\w* \w todo|strong="G3956"\w* \w monte|strong="G3735"\w* \w e|strong="G2532"\w* \w ilha|strong="G3520"\w* \w dos seus|strong="G1537,G3588,G846"\w* \w lugares|strong="G5117"\w* \w foram removidos|strong="G2795"\w*.\x - \xo 6:14 \xt REV 16:20; MAT 24:35; ISA 51:6; ISA 34:4; LUK 21:25; 2PE 3:10\x*
\v 15 \w E|strong="G2532"\w* \w os|strong="G3588"\w* \w reis|strong="G935"\w* \w da terra|strong="G3588,G1093"\w* \w e|strong="G2532"\w* \w os|strong="G3588"\w* \w grandes|strong="G3175"\w* \w e|strong="G2532"\w* \w os|strong="G3588"\w* \w comandantes|strong="G5506"\w* \w e|strong="G2532"\w* \w os|strong="G3588"\w* \w ricos|strong="G4145"\w* \w e|strong="G2532"\w* \w os|strong="G3588"\w* \w poderosos|strong="G2478"\w* \w e|strong="G2532"\w* \w todo|strong="G3956"\w* \w escravo|strong="G1401"\w* \w e|strong="G2532"\w* \add todo\add* \w livre|strong="G1658"\w* \w esconderam|strong="G2928"\w* \w a si mesmos|strong="G1438"\w* \w nas cavernas|strong="G1519,G3588,G4693"\w* \w e|strong="G2532"\w* \w nas rochas|strong="G1519,G3588,G4073"\w* \w dos montes|strong="G3588,G3735"\w*;\f + \fr 6.15: \ft Variante: o TR traz πᾶς (“todo”) também antes de “livre”; o SBLGNT não o traz, e a tradução repete “todo” por paralelismo com “todo escravo”.\f*\f + \fr 6.15: \ft Acréscimo: “todo” (em “escravo e todo livre esconderam”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto.\f*\x - \xo 6:15 \xt REV 19:18; ISA 2:10; ISA 2:19; MAT 24:29; AMO 3:7; ISA 2:21\x*
\v 16 \w e|strong="G2532"\w* \w dizem|strong="G3004"\w* \w aos montes|strong="G3588,G3735"\w* \w e|strong="G2532"\w* \w às rochas|strong="G3588,G4073"\w*: “\w Caiam|strong="G4098"\w* \w sobre nós|strong="G1909,G3165"\w* \w e|strong="G2532"\w* \w escondam|strong="G2928"\w*-\w nos|strong="G3165"\w* \w da face|strong="G575,G4383"\w* \w daquele que está sentado|strong="G3588,G2521"\w* \w sobre o trono|strong="G1909,G3588,G2362"\w* \w e|strong="G2532"\w* \w da ira|strong="G575,G3588,G3709"\w* \w do cordeiro|strong="G3588,G721"\w*,\f + \fr 6.16: \ft Nota cultural: ecoa Os 10:8 (cf. Lc 23:30).\f*\x - \xo 6:16 \xt LUK 23:30; HOS 10:8; REV 20:11; JHN 1:29; ISA 2:10; REV 9:6\x*
\v 17 \w porque|strong="G3754"\w* \w chegou|strong="G2064"\w* \w o|strong="G3588"\w* \w dia|strong="G2250"\w* \w o grande|strong="G3588,G3173"\w* \w da ira|strong="G3588,G3709"\w* \w deles|strong="G846"\w*, \w e|strong="G2532"\w* \w quem|strong="G5101"\w* \w pode|strong="G1410"\w* \w ficar de pé|strong="G2476"\w*?”\f + \fr 6.17: \ft Variante: o RP traz “dele” (αὐτοῦ) em lugar de “deles” (αὐτῶν).\f*\x - \xo 6:17 \xt EPH 6:13; MAL 3:2; MAT 24:29; PSA 76:7; JOL 2:11; AMO 3:7\x*
\c 7
\p
\v 1 \w Depois disto|strong="G3326,G3778"\w* \w vi|strong="G1492"\w* \w quatro anjos|strong="G5064,G32"\w* \w de pé|strong="G2476"\w* \w sobre os quatro|strong="G1909,G3588,G5064"\w* \w cantos|strong="G1137"\w* \w da terra|strong="G3588,G1093"\w*, \w segurando|strong="G2902"\w* \w os quatro|strong="G3588,G5064"\w* \w ventos|strong="G417"\w* \w da terra|strong="G3588,G1093"\w*, \w para que|strong="G2443"\w* \w não|strong="G3361"\w* \w soprasse|strong="G4154"\w* \w vento|strong="G417"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w nem|strong="G3383"\w* \w sobre o mar|strong="G1909,G3588,G2281"\w* \w nem|strong="G3383"\w* \w sobre qualquer|strong="G1909,G3956"\w* \w árvore|strong="G1186"\w*.\f + \fr 7.1: \ft Variante: Treg e o RP trazem “E depois” (Καὶ μετά) no começo e “alguma” (τι) em lugar de “qualquer” (πᾶν).\f*\f + \fr 7.1: \ft Nota cultural: “os quatro cantos da terra” e “os quatro ventos” são expressões de totalidade (as quatro direções); ecoa Ez 7:2 e Zc 6:5.\f*\x - \xo 7:1 \xt EZK 7:2; ZEC 6:5; REV 7:3; MAT 24:31; DAN 7:2; JER 49:36\x*
\v 2 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w outro anjo|strong="G243,G32"\w* \w subindo|strong="G305"\w* \w do nascente|strong="G575,G395"\w* \w do sol|strong="G2246"\w*, \w tendo|strong="G2192"\w* \w o selo|strong="G4973"\w* \w do Deus|strong="G2316"\w* \w vivo|strong="G2198"\w*, \w e|strong="G2532"\w* \w clamou|strong="G2896"\w* \w em voz|strong="G5456"\w* \w grande|strong="G3173"\w* \w aos quatro|strong="G3588,G5064"\w* \w anjos|strong="G32"\w* \w aos quais|strong="G3739,G846"\w* \w foi dado|strong="G1325"\w* \w danificar|strong="G91"\w* \w a terra|strong="G3588,G1093"\w* \w e|strong="G2532"\w* \w o mar|strong="G3588,G2281"\w*,\f + \fr 7.2: \ft Lit.: Ἀνατολή, “nascente, leste” (lugar onde o sol nasce); ἀδικέω, “prejudicar, danificar”; οἷς… αὐτοῖς tem o pronome redundante, semitismo que a tradução absorve.\f*\x - \xo 7:2 \xt EZK 9:4; REV 9:4; 2CO 1:22; EPH 4:30; REV 7:3-8; 2TI 2:19\x*
\v 3 \w dizendo|strong="G3004"\w*: “\w Não|strong="G3361"\w* \w danifiquem|strong="G91"\w* \w a terra|strong="G3588,G1093"\w* \w nem|strong="G3383"\w* \w o mar|strong="G3588,G2281"\w* \w nem|strong="G3383"\w* \w as árvores|strong="G3588,G1186"\w*, \w até que|strong="G891"\w* \w selemos|strong="G4972"\w* \w os servos|strong="G3588,G1401"\w* \w do nosso Deus|strong="G3588,G2316,G3165"\w* \w sobre as testas|strong="G1909,G3588,G3359"\w* \w deles|strong="G846"\w*.”\f + \fr 7.3: \ft Lit.: Δοῦλος, “escravo” (servo de plena pertença ao senhor); σφραγίζω, “selar, marcar com selo”; μέτωπον, “testa”.\f*\x - \xo 7:3 \xt REV 9:4; REV 7:1; EZK 9:4; REV 22:4; EXO 12:23; REV 14:1\x*
\v 4 \w E|strong="G2532"\w* \w ouvi|strong="G191"\w* \w o número|strong="G3588,G706"\w* \w dos selados|strong="G3588,G4972"\w*: \w cento e quarenta e quatro|strong="G1540,G5062,G5064"\w* \w mil|strong="G5505"\w*, \w selados|strong="G4972"\w* \w de toda|strong="G1537,G3956"\w* \w tribo|strong="G5443"\w* \w de filhos|strong="G5207"\w* \w de Israel|strong="G2474"\w*:\f + \fr 7.4: \ft Lit.: Χιλιάς, “milhar”; “cento e quarenta e quatro mil” traduz ἑκατὸν τεσσεράκοντα τέσσαρες χιλιάδες (“cento e quarenta e quatro milhares”).\f*\f + \fr 7.4: \ft Variante: o RP traz “cento e quarenta” com “e” (ἑκατὸν καὶ τεσσεράκοντα) e o genitivo ἐσφραγισμένων (“de selados”) em lugar de ἐσφραγισμένοι.\f*\x - \xo 7:4 \xt REV 14:1; REV 14:3; REV 9:4; LUK 22:30; MAT 19:28; REV 7:2\x*
\v 5 \w Da tribo|strong="G1537,G5443"\w* \w de Judá|strong="G2455"\w* \w doze mil|strong="G1427,G5505"\w* \w selados|strong="G4972"\w*, \w da tribo|strong="G1537,G5443"\w* \w de Rúben|strong="G4502"\w* \w doze mil|strong="G1427,G5505"\w*, \w da tribo|strong="G1537,G5443"\w* \w de Gade|strong="G1045"\w* \w doze mil|strong="G1427,G5505"\w*,\f + \fr 7.5: \ft Variante: o RP traz o feminino ἐσφραγισμέναι (“seladas”) em lugar de ἐσφραγισμένοι.\f*\x - \xo 7:5 \xt REV 7:8; REV 7:7; REV 14:1; REV 7:2; 1CH 2:1; REV 21:12\x*
\v 6 \w da tribo|strong="G1537,G5443"\w* \w de Aser|strong="G768"\w* \w doze mil|strong="G1427,G5505"\w*, \w da tribo|strong="G1537,G5443"\w* \w de Naftali|strong="G3508"\w* \w doze mil|strong="G1427,G5505"\w*, \w da tribo|strong="G1537,G5443"\w* \w de Manassés|strong="G3128"\w* \w doze mil|strong="G1427,G5505"\w*,\x - \xo 7:6 \xt LUK 2:36; REV 14:1; REV 7:2; 1CH 2:1; REV 21:12; EZR 6:17\x*
\v 7 \w da tribo|strong="G1537,G5443"\w* \w de Simeão|strong="G4826"\w* \w doze mil|strong="G1427,G5505"\w*, \w da tribo|strong="G1537,G5443"\w* \w de Levi|strong="G3017"\w* \w doze mil|strong="G1427,G5505"\w*, \w da tribo|strong="G1537,G5443"\w* \w de Issacar|strong="G2466"\w* \w doze mil|strong="G1427,G5505"\w*,\x - \xo 7:7 \xt REV 7:5; REV 14:1; REV 7:2; 1CH 2:1; REV 21:12; GEN 35:23\x*
\v 8 \w da tribo|strong="G1537,G5443"\w* \w de Zebulom|strong="G2194"\w* \w doze mil|strong="G1427,G5505"\w*, \w da tribo|strong="G1537,G5443"\w* \w de José|strong="G2501"\w* \w doze mil|strong="G1427,G5505"\w*, \w da tribo|strong="G1537,G5443"\w* \w de Benjamim|strong="G958"\w* \w doze mil|strong="G1427,G5505"\w* \w selados|strong="G4972"\w*.\f + \fr 7.8: \ft Nota cultural: a lista das tribos omite Dã e Efraim e inclui Manassés e Levi; a ordem e a composição variam nas listas do AT (cf. Gn 49; Dt 33; Nm 1).\f*\f + \fr 7.8: \ft Variante: o RP traz o feminino ἐσφραγισμέναι (“seladas”) em lugar de ἐσφραγισμένοι.\f*\x - \xo 7:8 \xt REV 7:5; REV 14:1; REV 7:2; 1CH 2:1; REV 21:12; EZR 6:17\x*
\v 9 \w Depois|strong="G3326"\w* \w disto|strong="G3778"\w* \w vi|strong="G1492"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w uma multidão|strong="G3793"\w* \w grande|strong="G4183"\w*, \w a qual|strong="G3739,G846"\w* \w ninguém|strong="G3762"\w* \w podia|strong="G1410"\w* \w contar|strong="G705"\w*, \w de toda|strong="G1537,G3956"\w* \w nação|strong="G1484"\w* \w e|strong="G2532"\w* \w tribos|strong="G5443"\w* \w e|strong="G2532"\w* \w povos|strong="G2992"\w* \w e|strong="G2532"\w* \w línguas|strong="G1100"\w*, \add de\add* \w pé|strong="G2476"\w* \w diante do trono|strong="G1799,G3588,G2362"\w* \w e|strong="G2532"\w* \w diante do cordeiro|strong="G1799,G3588,G721"\w*, \w vestidos|strong="G4016"\w* \w de vestes|strong="G4749"\w* \w brancas|strong="G3022"\w*, \w e|strong="G2532"\w* \w palmas|strong="G5404"\w* \w nas mãos|strong="G1722,G3588,G5495"\w* \w deles|strong="G846"\w*\f + \fr 7.9: \ft Variante: o RP omite “a ela” (αὐτόν) e traz o acusativo ἑστῶτας (“de pé”) e φοίνικας (“palmas”).\f*\f + \fr 7.9: \ft Lit.: a concordância gramatical oscila entre o nominativo (ἑστῶτες, φοίνικες) e o acusativo (περιβεβλημένους); a tradução uniformiza em português.\f*;\f + \fr 7.9: \ft Acréscimo: “de” (em “e línguas de pé diante”): preposição ou artigo que a regência do português exige.\f*\x - \xo 7:9 \xt REV 7:13; JHN 14:6; ACT 4:12; REV 5:9; 1CH 29:11; JHN 12:13\x*
\q1
\v 10 \w e|strong="G2532"\w* \w clamam|strong="G2896"\w* \w em voz|strong="G5456"\w* \w grande|strong="G3173"\w*, \w dizendo|strong="G3004"\w*: “\w A salvação|strong="G3588,G4991"\w* \add pertence\add* \w ao nosso Deus|strong="G3588,G2316,G3165"\w*, \w ao que está sentado|strong="G3588,G2521"\w* \w sobre o trono|strong="G1909,G3588,G2362"\w* \w e|strong="G2532"\w* \w ao cordeiro|strong="G3588,G721"\w*.”\f + \fr 7.10: \ft Lit.: Ἡ σωτηρία τῷ θεῷ, aclamação sem verbo (“a salvação — pertence — ao nosso Deus”); σωτηρία significa “salvação, libertação, vitória”.\f*\f + \fr 7.10: \ft Acréscimo: “pertence” (em “A salvação pertence ao nosso”): verbo acrescentado: o grego traz a frase sem verbo (construção nominal ou elíptica) e o português exige um, tomado do contexto.\f*\x - \xo 7:10 \xt REV 19:1; REV 5:7; REV 22:3; REV 5:13; REV 4:2; JHN 14:6\x*
\v 11 \w e|strong="G2532"\w* \w todos os|strong="G3956,G3588"\w* \w anjos|strong="G32"\w* \add estavam de\add* \w pé|strong="G2476"\w* \w em volta|strong="G2945"\w* \w do trono|strong="G3588,G2362"\w* \w e|strong="G2532"\w* \w dos anciãos|strong="G3588,G4245"\w* \w e|strong="G2532"\w* \w dos quatro|strong="G3588,G5064"\w* \w seres vivos|strong="G2226"\w*, \w e|strong="G2532"\w* \w caíram|strong="G4098"\w* \w diante do trono|strong="G1799,G3588,G2362"\w* \w sobre os seus rostos|strong="G1909,G3588,G4383,G846"\w* \w e|strong="G2532"\w* \w adoraram|strong="G4352"\w* \w a Deus|strong="G3588,G2316"\w*,\f + \fr 7.11: \ft Variante: o TR traz “rosto” (πρόσωπον, singular) em lugar de “rostos” (πρόσωπα) e as formas ἑστήκεσαν (“estavam de pé”) e ἔπεσον (“caíram”) em lugar de εἱστήκεισαν e ἔπεσαν.\f*\f + \fr 7.11: \ft Acréscimo: “estavam” (em “os anjos estavam de pé”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige; “de” (em “anjos estavam de pé em”): preposição ou artigo que a regência do português exige.\f*\x - \xo 7:11 \xt REV 11:16; REV 19:4; REV 4:10; REV 5:11; REV 5:6; REV 5:14\x*
\q1
\v 12 \w dizendo|strong="G3004"\w*: “\w Amém|strong="G281"\w*! \w A bênção|strong="G3588,G2129"\w* \w e|strong="G2532"\w* \w a glória|strong="G3588,G1391"\w* \w e|strong="G2532"\w* \w a sabedoria|strong="G3588,G4678"\w* \w e|strong="G2532"\w* \w a ação de graças|strong="G3588,G2169"\w* \w e|strong="G2532"\w* \w a honra|strong="G3588,G5092"\w* \w e|strong="G2532"\w* \w o poder|strong="G3588,G1411"\w* \w e|strong="G2532"\w* \w a força|strong="G3588,G2479"\w* \w ao nosso Deus|strong="G3588,G2316,G3165"\w* \w para os séculos|strong="G1519,G3588,G165"\w* \w dos séculos|strong="G3588,G165"\w*. \w Amém|strong="G281"\w*!”\x - \xo 7:12 \xt REV 5:12; EPH 3:21; REV 4:9; PHP 4:20; 1TI 1:17; JHN 14:6\x*
\v 13 \w E|strong="G2532"\w* \w respondeu|strong="G611"\w* \w um|strong="G1520"\w* \w dos anciãos|strong="G1537,G3588,G4245"\w*, \w dizendo|strong="G3004"\w* \w a mim|strong="G3165"\w*: “\w Estes|strong="G3778"\w* \w que estão vestidos|strong="G3588,G4016"\w* \w com as vestes|strong="G3588,G4749"\w* \w brancas|strong="G3588,G3022"\w*, \w quem|strong="G5101"\w* \w são|strong="G1510"\w* \w e|strong="G2532"\w* \w de onde|strong="G4159"\w* \w vieram|strong="G2064"\w*\f + \fr 7.13: \ft Lit.: Ἀπεκρίθη, “respondeu”: aqui o ancião toma a palavra sem pergunta explícita (semitismo), pois responde à pergunta não dita do vidente.\f*?”\x - \xo 7:13 \xt REV 7:9; REV 4:4; LUK 20:7; JHN 14:6; EPH 3:21; REV 19:8\x*
\v 14 \w E|strong="G2532"\w* \w eu lhe disse|strong="G2046,G846"\w*: “\w Meu senhor|strong="G2962,G3165"\w*, \w você|strong="G4771"\w* \w sabe|strong="G6063"\w*.” \w E|strong="G2532"\w* \w ele me disse|strong="G2036,G3165"\w*: “\w Estes|strong="G3778"\w* \w são|strong="G1510"\w* \w os que vêm|strong="G3588,G2064"\w* \w da grande aflição|strong="G1537,G3588,G2347,G3173"\w*, \w e|strong="G2532"\w* \w lavaram|strong="G4150"\w* \w as suas vestes|strong="G3588,G4749,G846"\w* \w e|strong="G2532"\w* \w as embranqueceram|strong="G3021,G846"\w* \w no sangue|strong="G1722,G3588,G129"\w* \w do cordeiro|strong="G3588,G721"\w*\f + \fr 7.14: \ft Variante: o TR omite “meu” (μου); o RP traz εἶπον (“disse”) em lugar de εἴρηκα (“tenho dito”) e omite “as” (αὐτάς).\f*\f + \fr 7.14: \ft Lit.: Θλῖψις, “tribulação, aperto, pressão”; στολή, “veste longa”; λευκαίνω, “embranquecer”.\f*.\x - \xo 7:14 \xt REV 22:14; 1JN 1:7; ISA 1:18; JHN 16:33; HEB 13:12; JHN 14:6\x*
\v 15 \w Por isso|strong="G1223,G3778"\w* \w estão|strong="G1510"\w* \w diante do trono|strong="G1799,G3588,G2362"\w* \w de Deus|strong="G3588,G2316"\w*, \w e|strong="G2532"\w* \w prestam culto|strong="G3000"\w* \w a ele|strong="G846"\w* \w de dia|strong="G2250"\w* \w e|strong="G2532"\w* \w de noite|strong="G3571"\w* \w no santuário|strong="G1722,G3588,G3485"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w o que está sentado|strong="G3588,G2521"\w* \w sobre o trono|strong="G1909,G3588,G2362"\w* \w armará a sua tenda|strong="G4637"\w* \w sobre eles|strong="G1909,G846"\w*.\f + \fr 7.15: \ft Lit.: Λατρεύω, “servir religiosamente, prestar culto”; σκηνόω, “armar tenda, habitar em tenda” (da mesma raiz de ἐσκήνωσεν em Jo 1:14).\f*\f + \fr 7.15: \ft Nota cultural: a tenda que Deus arma sobre eles evoca a presença abrigadora de Deus (Êx 40:34-38; Is 4:5-6).\f*\f + \fr 7.15: \ft Variante: o RP traz “ao trono” em dativo (τῷ θρόνῳ) em lugar do genitivo τοῦ θρόνου na primeira ocorrência.\f*\x - \xo 7:15 \xt ISA 4:5-6; JHN 1:14; EXO 40:34-38; REV 22:3; REV 21:3; PSA 16:11\x*
\v 16 \w Não|strong="G3756"\w* \w terão mais fome|strong="G3983,G2089"\w* \w nem|strong="G3761"\w* \w terão mais sede|strong="G1372,G2089"\w*, \w nem|strong="G3761"\w* \w o sol|strong="G3588,G2246"\w* \w de modo algum|strong="G3361"\w* \w cairá|strong="G4098"\w* \w sobre eles|strong="G1909,G846"\w* \w nem|strong="G3761"\w* \w qualquer calor ardente|strong="G3956,G2738"\w*,\x - \xo 7:16 \xt MAT 5:6; JHN 6:35; REV 22:3; PSA 16:11; JHN 14:6; JHN 4:14\x*
\v 17 \w porque|strong="G3754"\w* \w o cordeiro|strong="G3588,G721"\w* \w que está|strong="G3588"\w* \w no meio|strong="G303,G3319"\w* \w do trono|strong="G3588,G2362"\w* \w os pastoreará|strong="G4165,G846"\w* \w e|strong="G2532"\w* \w os guiará|strong="G3594,G846"\w* \w para fontes|strong="G1909,G4077"\w* \w de águas|strong="G5204"\w* \w de vida|strong="G2222"\w*; \w e|strong="G2532"\w* \w Deus|strong="G3588,G2316"\w* \w enxugará|strong="G1813"\w* \w toda lágrima|strong="G3956,G1144"\w* \w dos olhos|strong="G1537,G3588,G3788"\w* \w deles|strong="G846"\w*.”\f + \fr 7.17: \ft Lit.: Ποιμαίνω, “pastorear” (guiar e cuidar como pastor); ἐξαλείφω, “apagar, limpar” (aqui “enxugar”).\f*\f + \fr 7.17: \ft Nota cultural: ecoa Is 49:10 (Deus os guia às fontes de águas) e Is 25:8 (Deus enxuga as lágrimas de todo rosto).\f*\f + \fr 7.17: \ft Variante: o RP traz os presentes ποιμαίνει (“pastoreia”) e ὁδηγεῖ (“guia”) em lugar dos futuros.\f*\f + \fr 7.17: \ft Acréscimo: “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 7:17 \xt ISA 25:8; ISA 49:10; PSA 23:1; PSA 23:2; REV 22:1; REV 21:4\x*
\c 8
\p
\v 1 \w E|strong="G2532"\w* \w quando|strong="G3752"\w* \w abriu|strong="G455"\w* \w o selo|strong="G3588,G4973"\w* \w o sétimo|strong="G3588,G1442"\w*, \w houve|strong="G1096"\w* \w silêncio|strong="G4602"\w* \w no céu|strong="G1722,G3588,G3772"\w* \w por cerca de|strong="G5613"\w* \w meia hora|strong="G2256"\w*.\f + \fr 8.1: \ft Variante: o RP traz ὅτε (“quando”) em lugar de ὅταν (“quando, sempre que”).\f*\x - \xo 8:1 \xt REV 6:3; REV 6:7; HAB 2:20; ZEC 2:13; REV 6:1; PSA 62:1\x*
\v 2 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w os sete|strong="G3588,G2033"\w* \w anjos|strong="G32"\w* \w que|strong="G3739"\w* \w diante de Deus|strong="G1799,G3588,G2316"\w* \w estão de pé|strong="G2476"\w*, \w e|strong="G2532"\w* \w foram dadas|strong="G1325"\w* \w a eles|strong="G846"\w* \w sete trombetas|strong="G2033,G4536"\w*.\x - \xo 8:2 \xt REV 8:6; MAT 24:31; REV 9:14; LUK 1:19; ZEC 4:10; 1CO 15:52\x*
\v 3 \w E|strong="G2532"\w* \w outro anjo|strong="G243,G32"\w* \w veio|strong="G2064"\w* \w e|strong="G2532"\w* \w ficou de pé|strong="G2476"\w* \w junto ao altar|strong="G1909,G3588,G2379"\w*, \w tendo|strong="G2192"\w* \w um incensário|strong="G3031"\w* \w de ouro|strong="G5552"\w*, \w e|strong="G2532"\w* \w foi dado|strong="G1325"\w* \w a ele|strong="G846"\w* \w muito incenso|strong="G2368,G4183"\w*, \w para que|strong="G2443"\w* \w o juntasse|strong="G1325"\w* \w às orações|strong="G3588,G4335"\w* \w de todos os santos|strong="G3588,G40,G3956"\w* \w sobre o altar|strong="G1909,G3588,G2379"\w* \w de ouro|strong="G3588,G5552"\w*, \w o que está|strong="G3588"\w* \w diante do trono|strong="G1799,G3588,G2362"\w*.\f + \fr 8.3: \ft Lit.: Λιβανωτός, “incensário, turíbulo”; δώσει ταῖς προσευχαῖς, literalmente “desse às orações”, isto é, “acrescentasse às orações” ou “oferecesse junto com as orações”.\f*\f + \fr 8.3: \ft Variante: o RP traz o subjuntivo δώσῃ em lugar do futuro δώσει.\f*\f + \fr 8.3: \ft Acréscimo: “o que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 8:3 \xt REV 5:8; LUK 1:11; REV 9:13; PSA 141:2; REV 8:4; LUK 1:10\x*
\v 4 \w E|strong="G2532"\w* \w subiu|strong="G305"\w* \w a fumaça|strong="G3588,G2586"\w* \w dos incensos|strong="G3588,G2368"\w* \w com as orações|strong="G3588,G4335"\w* \w dos santos|strong="G3588,G40"\w* \w da mão|strong="G1537,G5495"\w* \w do anjo|strong="G3588,G32"\w* \w diante de Deus|strong="G1799,G3588,G2316"\w*.\x - \xo 8:4 \xt REV 5:8; PSA 141:2; ACT 10:4; REV 8:3; ACT 10:31; ISA 6:6\x*
\v 5 \w E|strong="G2532"\w* \w o anjo|strong="G3588,G32"\w* \w tomou|strong="G2983"\w* \w o incensário|strong="G3588,G3031"\w*, \w e|strong="G2532"\w* \w o encheu|strong="G1072,G846"\w* \w do fogo|strong="G1537,G3588,G4442"\w* \w do altar|strong="G3588,G2379"\w*, \w e|strong="G2532"\w* \w o lançou|strong="G906"\w* \w sobre a terra|strong="G1519,G3588,G1093"\w*; \w e|strong="G2532"\w* \w houve|strong="G1096"\w* \w trovões|strong="G1027"\w* \w e|strong="G2532"\w* \w vozes|strong="G5456"\w* \w e|strong="G2532"\w* \w relâmpagos|strong="G796"\w* \w e|strong="G2532"\w* \w um terremoto|strong="G4578"\w*.\x - \xo 8:5 \xt REV 16:18; REV 4:5; REV 11:19; ISA 6:6; 2TI 3:1; EXO 19:16\x*
\v 6 \w E|strong="G2532"\w* \w os sete|strong="G3588,G2033"\w* \w anjos|strong="G32"\w* \w que tinham|strong="G3588,G2192"\w* \w as sete trombetas|strong="G3588,G2033,G4536"\w* \w se prepararam|strong="G2090,G1438"\w* \w para tocar a trombeta|strong="G2443,G4537"\w*.\f + \fr 8.6: \ft Variante: a grafia do reflexivo varia (αὑτούς, αὐτούς, ἑαυτούς), sem mudança de sentido.\f*\x - \xo 8:6 \xt REV 8:2; REV 11:15; 2TI 3:1; REV 9:1; REV 9:14; JOS 6:4\x*
\v 7 \w E|strong="G2532"\w* \w o primeiro|strong="G3588,G4413"\w* \w tocou a trombeta|strong="G4537"\w*; \w e|strong="G2532"\w* \w houve|strong="G1096"\w* \w granizo|strong="G5464"\w* \w e|strong="G2532"\w* \w fogo|strong="G4442"\w* \w misturados|strong="G3396"\w* \w com sangue|strong="G1722,G129"\w*, \w e|strong="G2532"\w* \w foram lançados|strong="G906"\w* \w sobre a terra|strong="G1519,G3588,G1093"\w*; \w e|strong="G2532"\w* \w a terça parte|strong="G3588,G5154"\w* \w da terra|strong="G3588,G1093"\w* \w foi queimada|strong="G2618"\w*, \w e|strong="G2532"\w* \w a terça parte|strong="G3588,G5154"\w* \w das árvores|strong="G3588,G1186"\w* \w foi queimada|strong="G2618"\w*, \w e|strong="G2532"\w* \w toda erva|strong="G3956,G5528"\w* \w verde|strong="G5515"\w* \w foi queimada|strong="G2618"\w*.\f + \fr 8.7: \ft Lit.: Σαλπίζω, “tocar a trombeta”; τρίτον, “terça parte, um terço”; χόρτος, “erva, capim”.\f*\f + \fr 8.7: \ft Variante: o TR acrescenta “anjo” (ἄγγελος) depois de “o primeiro” e omite “e a terça parte da terra foi queimada” (καὶ τὸ τρίτον τῆς γῆς κατεκάη).\f*\x - \xo 8:7 \xt REV 9:4; EZK 38:22; REV 16:2; REV 9:18; ZEC 13:8; 2TI 3:1\x*
\v 8 \w E|strong="G2532"\w* \w o segundo|strong="G3588,G1208"\w* \w anjo|strong="G32"\w* \w tocou a trombeta|strong="G4537"\w*; \w e|strong="G2532"\w* \w como um monte|strong="G5613,G3735"\w* \w grande|strong="G3173"\w* \w ardendo em fogo|strong="G4442,G2545"\w* \w foi lançado|strong="G906"\w* \w no mar|strong="G1519,G3588,G2281"\w*; \w e|strong="G2532"\w* \w a terça parte|strong="G3588,G5154"\w* \w do mar|strong="G3588,G2281"\w* \w se tornou|strong="G1096"\w* \w sangue|strong="G129"\w*,\x - \xo 8:8 \xt JER 51:25; ZEC 13:8; 2TI 3:1; EXO 7:17; REV 16:3; REV 8:12\x*
\v 9 \w e|strong="G2532"\w* \w morreu|strong="G599"\w* \w a terça parte|strong="G3588,G5154"\w* \w das criaturas|strong="G3588,G2938"\w* \w que estão|strong="G3588"\w* \w no mar|strong="G1722,G3588,G2281"\w*, \w as que têm|strong="G3588,G2192"\w* \w vida|strong="G5590"\w*, \w e|strong="G2532"\w* \w a terça parte|strong="G3588,G5154"\w* \w dos navios|strong="G3588,G4143"\w* \w foi destruída|strong="G1311"\w*.\f + \fr 8.9: \ft Lit.: o verbo διεφθάρησαν está no plural e concorda com “navios”; o RP traz o singular διεφθάρη.\f*\f + \fr 8.9: \ft Acréscimo: “que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 8:9 \xt ZEC 13:8; 2TI 3:1; REV 16:3; REV 8:12; ISA 2:16; PSA 47:5\x*
\v 10 \w E|strong="G2532"\w* \w o terceiro|strong="G3588,G5154"\w* \w anjo|strong="G32"\w* \w tocou a trombeta|strong="G4537"\w*; \w e|strong="G2532"\w* \w caiu|strong="G4098"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w uma estrela|strong="G792"\w* \w grande|strong="G3173"\w*, \w ardendo|strong="G2545"\w* \w como uma tocha|strong="G5613,G2985"\w*, \w e|strong="G2532"\w* \w caiu|strong="G4098"\w* \w sobre a terça parte|strong="G1909,G3588,G5154"\w* \w dos rios|strong="G3588,G4215"\w* \w e|strong="G2532"\w* \w sobre as fontes|strong="G1909,G3588,G4077"\w* \w das águas|strong="G3588,G5204"\w*.\x - \xo 8:10 \xt REV 16:4; REV 9:1; REV 8:12; ISA 14:12; ZEC 13:8; 2TI 3:1\x*
\v 11 \w E|strong="G2532"\w* \w o nome|strong="G3588,G3686"\w* \w da estrela|strong="G3588,G792"\w* \w é chamado|strong="G3004"\w* \w o Absinto|strong="G3588,G894"\w*; \w e|strong="G2532"\w* \w a terça parte|strong="G3588,G5154"\w* \w das águas|strong="G3588,G5204"\w* \w se tornou absinto|strong="G1096,G1519,G894"\w*, \w e|strong="G2532"\w* \w muitos|strong="G4183"\w* \w dos seres humanos|strong="G3588,G444"\w* \w morreram|strong="G599"\w* \w por causa das águas|strong="G1537,G3588,G5204"\w*, \w porque|strong="G3754"\w* \w ficaram amargas|strong="G4087"\w*.\f + \fr 8.11: \ft Lit.: Ἄψινθος, “absinto” (planta de sabor muito amargo); ἐπικράνθησαν, “foram amargadas, ficaram amargas”.\f*\f + \fr 8.11: \ft Nota cultural: ecoa Jr 9:15 e 23:15 (Deus dá a beber água de fel e absinto).\f*\f + \fr 8.11: \ft Variante: Treg omite o artigo ὁ antes de Ἄψινθος.\f*\x - \xo 8:11 \xt JER 23:15; JER 9:15; ZEC 13:8; 2TI 3:1; DEU 29:18; REV 16:4\x*
\v 12 \w E|strong="G2532"\w* \w o quarto|strong="G3588,G5067"\w* \w anjo|strong="G32"\w* \w tocou a trombeta|strong="G4537"\w*; \w e|strong="G2532"\w* \w foi atingida|strong="G4141"\w* \w a terça parte|strong="G3588,G5154"\w* \w do sol|strong="G3588,G2246"\w* \w e|strong="G2532"\w* \w a terça parte|strong="G3588,G5154"\w* \w da lua|strong="G3588,G4582"\w* \w e|strong="G2532"\w* \w a terça parte|strong="G3588,G5154"\w* \w das estrelas|strong="G3588,G792"\w*, \w para que|strong="G2443"\w* \w fosse escurecida|strong="G4654"\w* \w a terça parte|strong="G3588,G5154"\w* \w deles|strong="G846"\w* \w e|strong="G2532"\w* \w o dia|strong="G3588,G2250"\w* \w não|strong="G3361"\w* \w brilhasse|strong="G5316"\w* \w na sua terça parte|strong="G3588,G5154,G846"\w*, \w e|strong="G2532"\w* \w a noite|strong="G3588,G3571"\w* \w igualmente|strong="G3668"\w*.\f + \fr 8.12: \ft Variante: o RP traz “a terça parte dele, o dia não brilhasse” em ordem diferente (τὸ τρίτον αὐτῆς ἡ ἡμέρα μὴ φάνῃ).\f*\x - \xo 8:12 \xt MAT 24:29; MRK 13:24; JOL 2:31; ISA 13:10; JOL 2:10; ZEC 13:8\x*
\v 13 \w E|strong="G2532"\w* \w vi|strong="G1492"\w*, \w e|strong="G2532"\w* \w ouvi|strong="G191"\w* \w uma águia|strong="G1520,G105"\w* \w voando|strong="G4072"\w* \w no meio do céu|strong="G1722,G3321"\w*, \w dizendo|strong="G3004"\w* \w em voz|strong="G5456"\w* \w grande|strong="G3173"\w*: “\w Ai|strong="G3759"\w*, \w ai|strong="G3759"\w*, \w ai|strong="G3759"\w* \w dos que habitam|strong="G3588,G2730"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*, \w por causa|strong="G1537"\w* \w dos demais|strong="G3588,G3062"\w* \w sons|strong="G5456"\w* \w da trombeta|strong="G3588,G4536"\w* \w dos três|strong="G3588,G5140"\w* \w anjos|strong="G32"\w* \w que estão para|strong="G3588,G3195"\w* \w tocar a trombeta|strong="G4537"\w*!”\f + \fr 8.13: \ft Lit.: Μεσουράνημα, “meio do céu” (o ponto mais alto, onde todos podem ver e ouvir); οὐαί, “ai!”, grito de lamento e aviso de juízo.\f*\f + \fr 8.13: \ft Variante: o TR traz “anjo” (ἀγγέλου) em lugar de “águia” (ἀετοῦ); Treg e o RP trazem o dativo τοῖς κατοικοῦσιν (“aos que habitam”) em lugar do acusativo τοὺς κατοικοῦντας.\f*\x - \xo 8:13 \xt REV 14:6; REV 19:17; REV 12:12; REV 11:14; REV 9:12; REV 3:10\x*
\c 9
\p
\v 1 \w E|strong="G2532"\w* \w o quinto|strong="G3588,G3991"\w* \w anjo|strong="G32"\w* \w tocou a trombeta|strong="G4537"\w*; \w e|strong="G2532"\w* \w vi|strong="G1492"\w* \w uma estrela|strong="G792"\w* \w caída|strong="G4098"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w para a terra|strong="G1519,G3588,G1093"\w*, \w e|strong="G2532"\w* \w foi dada|strong="G1325"\w* \w a ele|strong="G846"\w* \w a chave|strong="G3588,G2807"\w* \w do poço|strong="G3588,G5421"\w* \w do abismo|strong="G3588,G12"\w*;\f + \fr 9.1: \ft Lit.: Ἄβυσσος, “abismo, profundeza sem fundo”; φρέαρ, “poço”; o pronome αὐτῷ (masculino) trata a estrela como um ser pessoal.\f*\x - \xo 9:1 \xt REV 20:1; REV 8:10; MAT 16:19; LUK 10:18; REV 9:2; ROM 10:7\x*
\v 2 \w e|strong="G2532"\w* \w abriu|strong="G455"\w* \w o poço|strong="G3588,G5421"\w* \w do abismo|strong="G3588,G12"\w*, \w e|strong="G2532"\w* \w subiu|strong="G305"\w* \w fumaça|strong="G2586"\w* \w do poço|strong="G1537,G3588,G5421"\w* \w como fumaça|strong="G5613,G2586"\w* \w de uma fornalha|strong="G2575"\w* \w grande|strong="G3173"\w*, \w e|strong="G2532"\w* \w foram escurecidos|strong="G4656"\w* \w o sol|strong="G3588,G2246"\w* \w e|strong="G2532"\w* \w o ar|strong="G3588,G109"\w* \w por causa da fumaça|strong="G1537,G3588,G2586"\w* \w do poço|strong="G3588,G5421"\w*.\f + \fr 9.2: \ft Variante: o RP traz “ardente” (καιομένης) em lugar de “grande” (μεγάλης).\f*\x - \xo 9:2 \xt JOL 2:10; REV 9:1; GEN 19:28; JOL 2:2; REV 16:10; ACT 2:19\x*
\v 3 \w E|strong="G2532"\w* \w da fumaça|strong="G1537,G3588,G2586"\w* \w saíram|strong="G1831"\w* \w gafanhotos|strong="G200"\w* \w para a terra|strong="G1519,G3588,G1093"\w*, \w e|strong="G2532"\w* \w foi dada|strong="G1325"\w* \w a eles|strong="G846"\w* \w autoridade|strong="G1849"\w*,\f + \fr 9.3: \ft Lit.: αὐταῖς (feminino plural, concordando com ἀκρίδες, “gafanhotos”): em português o pronome concorda com “gafanhotos” (masculino) e fica “a eles”.\f* \w como|strong="G5613"\w* \w têm|strong="G2192"\w* \w autoridade|strong="G1849"\w* \w os escorpiões|strong="G3588,G4651"\w* \w da terra|strong="G3588,G1093"\w*.\f + \fr 9.3: \ft Lit.: Ἀκρίς, “gafanhoto”; Ἐξουσία, “autoridade, poder delegado”.\f*\x - \xo 9:3 \xt JOL 1:4; REV 9:10; REV 9:5; 2CH 6:28; EXO 10:4; 1TI 4:1\x*
\v 4 \w E|strong="G2532"\w* \w foi dito|strong="G2046"\w* \w a eles|strong="G846"\w* \w que não|strong="G2443,G3361"\w* \w danificassem|strong="G91"\w* \w a erva|strong="G3588,G5528"\w* \w da terra|strong="G3588,G1093"\w* \w nem|strong="G3761"\w* \w qualquer verdura|strong="G3956,G5515"\w* \w nem|strong="G3761"\w* \w qualquer árvore|strong="G3956,G1186"\w*, \w a não ser|strong="G1487,G3361"\w* \w os seres humanos|strong="G3588,G444"\w* \w que|strong="G3748"\w* \w não|strong="G3756"\w* \w têm|strong="G2192"\w* \w o selo|strong="G3588,G4973"\w* \w de Deus|strong="G3588,G2316"\w* \w sobre as testas|strong="G1909,G3588,G3359"\w*.\f + \fr 9.4: \ft Variante: o RP acrescenta “deles” (αὐτῶν) depois de “testas”.\f*\x - \xo 9:4 \xt REV 7:3; REV 8:7; EZK 9:4; EZK 9:6; REV 7:2; EXO 12:23\x*
\v 5 \w E|strong="G2532"\w* \w foi dado|strong="G1325"\w* \w a eles|strong="G846"\w* \w que não|strong="G2443,G3361"\w* \w os matassem|strong="G615,G846"\w*, \w mas|strong="G235"\w* \w que|strong="G2443"\w* \w fossem atormentados|strong="G928"\w* \w por cinco meses|strong="G3376,G4002"\w*; \w e|strong="G2532"\w* \w o tormento deles|strong="G3588,G929,G846"\w* \w era como|strong="G5613"\w* \w o tormento|strong="G929"\w* \w de um escorpião|strong="G4651"\w*, \w quando|strong="G3752"\w* \w atinge|strong="G3817"\w* \w um ser humano|strong="G444"\w*.\f + \fr 9.5: \ft Lit.: Βασανίζω, “atormentar, torturar”; παίω, “ferir, golpear”.\f*\f + \fr 9.5: \ft Variante: WH e o RP trazem o feminino αὐταῖς (“a elas”) em lugar de αὐτοῖς (“a eles”); o RP traz o subjuntivo βασανισθῶσιν.\f*\f + \fr 9.5: \ft Acréscimo: verbo ser/estar suprido em “era como”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:5 \xt REV 9:10; JOB 2:6; JOL 1:4; REV 9:3; 2CH 6:28; 1TI 4:1\x*
\v 6 \w E|strong="G2532"\w* \w naqueles dias|strong="G1722,G3588,G2250,G1565"\w* \w procurarão|strong="G2212"\w* \w os seres humanos|strong="G3588,G444"\w* \w a morte|strong="G3588,G2288"\w* \w e|strong="G2532"\w* \w de modo algum|strong="G3756,G3361"\w* \w a encontrarão|strong="G2147,G846"\w*, \w e|strong="G2532"\w* \w desejarão|strong="G1937"\w* \w morrer|strong="G599"\w*, \w e|strong="G2532"\w* \w a morte|strong="G3588,G2288"\w* \w foge|strong="G5343"\w* \w deles|strong="G575,G846"\w*.\f + \fr 9.6: \ft Variante: o RP traz o futuro φεύξεται (“fugirá”) em lugar de φεύγει e inverte a ordem de “a morte” e “deles”.\f*\x - \xo 9:6 \xt JER 8:3; LUK 23:30; REV 6:16; ISA 2:19; HOS 10:8; JOB 7:15-16\x*
\v 7 \w E|strong="G2532"\w* \w a aparência|strong="G3588,G3667"\w* \w dos gafanhotos|strong="G3588,G200"\w* \w era semelhante|strong="G3664"\w* \w a cavalos|strong="G2462"\w* \w preparados|strong="G2090"\w* \w para a guerra|strong="G1519,G4171"\w*, \w e|strong="G2532"\w* \w sobre as cabeças|strong="G1909,G3588,G2776"\w* \w deles|strong="G846"\w* \w havia como|strong="G5613"\w* \w coroas|strong="G4735"\w* \w semelhantes|strong="G3664"\w* \w a ouro|strong="G5557"\w*, \w e|strong="G2532"\w* \w os rostos|strong="G3588,G4383"\w* \w deles|strong="G846"\w* \w eram como|strong="G5613"\w* \w rostos|strong="G4383"\w* \w de seres humanos|strong="G444"\w*,\f + \fr 9.7: \ft Lit.: Ὁμοίωμα, “semelhança, forma, aparência”.\f*\f + \fr 9.7: \ft Variante: o RP traz “de ouro” (χρυσοῖ) em lugar de “semelhantes a ouro” (ὅμοιοι χρυσῷ).\f*\f + \fr 9.7: \ft Acréscimo: verbo ser/estar suprido em “era semelhante”, “eram como”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:7 \xt JOL 2:4; JOL 1:4; 2CH 6:28; DAN 7:8; 1TI 4:1; JER 51:27\x*
\v 8 \w e|strong="G2532"\w* \w tinham|strong="G2192"\w* \w cabelos|strong="G2359"\w* \w como cabelos|strong="G5613,G2359"\w* \w de mulheres|strong="G1135"\w*, \w e|strong="G2532"\w* \w os dentes|strong="G3588,G3599"\w* \w deles|strong="G846"\w* \w eram|strong="G1510"\w* \w como os|strong="G5613"\w* \w de leões|strong="G3023"\w*,\x - \xo 9:8 \xt JOL 1:6; 2CH 6:28; PRO 30:14; 1TI 4:1; JER 51:27; PRO 30:27\x*
\v 9 \w e|strong="G2532"\w* \w tinham|strong="G2192"\w* \w couraças|strong="G2382"\w* \w como couraças|strong="G5613,G2382"\w* \w de ferro|strong="G4603"\w*, \w e|strong="G2532"\w* \w o som|strong="G3588,G5456"\w* \w das asas|strong="G3588,G4420"\w* \w deles|strong="G846"\w* \w era como|strong="G5613"\w* \w o som|strong="G5456"\w* \w de carros|strong="G716"\w* \w de muitos|strong="G4183"\w* \w cavalos|strong="G2462"\w* \w correndo|strong="G5143"\w* \w para a guerra|strong="G1519,G4171"\w*;\f + \fr 9.9: \ft Acréscimo: verbo ser/estar suprido em “era como”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:9 \xt EPH 6:14; JOL 2:5; 2CH 6:28; 2KI 7:6; 1KI 22:34; 1TI 4:1\x*
\v 10 \w e|strong="G2532"\w* \w têm|strong="G2192"\w* \w caudas|strong="G3769"\w* \w semelhantes|strong="G3664"\w* \w a escorpiões|strong="G4651"\w*, \w e|strong="G2532"\w* \w ferrões|strong="G2759"\w*, \w e|strong="G2532"\w* \w nas caudas|strong="G1722,G3588,G3769"\w* \w deles|strong="G846"\w* \w está a autoridade|strong="G3588,G1849"\w* \w deles|strong="G846"\w* \w de danificar|strong="G91"\w* \w os seres humanos|strong="G3588,G444"\w* \w por cinco meses|strong="G3376,G4002"\w*.\f + \fr 9.10: \ft Lit.: Κέντρον, “ferrão, aguilhão”.\f*\f + \fr 9.10: \ft Variante: o RP traz “têm autoridade de” (ἐξουσίαν ἔχουσιν τοῦ) em lugar de “a autoridade deles de” (ἡ ἐξουσία αὐτῶν).\f*\f + \fr 9.10: \ft Acréscimo: verbo ser/estar suprido em “está a autoridade”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:10 \xt REV 9:19; REV 9:5; REV 9:3; 2CH 6:28; 1TI 4:1; JER 51:27\x*
\v 11 \w Têm|strong="G2192"\w* \w sobre eles|strong="G1909,G846"\w* \w como rei|strong="G935"\w* \w o anjo|strong="G3588,G32"\w* \w do abismo|strong="G3588,G12"\w*; \w o nome dele|strong="G3686,G846"\w* \w em hebraico|strong="G1447"\w* \w é Abadom|strong="G3"\w*, \w e|strong="G2532"\w* \w em grego|strong="G1722,G3588,G1673"\w* \w tem por nome|strong="G3686,G2192"\w* \w Apolíon|strong="G623"\w*.\f + \fr 9.11: \ft Lit.: Ἀβαδδών vem do hebraico ʾăbaddôn, “destruição, ruína”; Ἀπολλύων é o particípio de ἀπόλλυμι, “o destruidor”.\f*\f + \fr 9.11: \ft Variante: o RP traz “tendo rei sobre elas” (Ἔχουσαι βασιλέα ἐπʼ αὐτῶν) e “em grego, porém” (ἐν δὲ) em lugar de “e em” (καὶ ἐν).\f*\f + \fr 9.11: \ft Acréscimo: verbo ser/estar suprido em “é Abadom”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:11 \xt JHN 8:44; REV 9:1; JOB 26:6; 2CH 6:28; 2CO 11:15; JOB 15:21\x*
\v 12 \w O primeiro ai|strong="G3588,G3759,G1520"\w* \w passou|strong="G565"\w*; \w olhem|strong="G2400"\w*, \w vêm|strong="G2064"\w* \w ainda|strong="G2089"\w* \w dois ais|strong="G1417,G3759"\w* \w depois disto|strong="G3326,G3778"\w*.\f + \fr 9.12: \ft Lit.: Οὐαί, “ai!”, aqui usado como substantivo: o “ai” é um período de calamidade anunciado pela águia (8:13).\f*\x - \xo 9:12 \xt REV 11:14; REV 8:13; REV 9:1; REV 12:12; REV 9:13-21\x*
\p
\v 13 \w E|strong="G2532"\w* \w o sexto|strong="G3588,G1623"\w* \w anjo|strong="G32"\w* \w tocou a trombeta|strong="G4537"\w*; \w e|strong="G2532"\w* \w ouvi|strong="G191"\w* \w uma voz|strong="G5456,G1520"\w* \w dos chifres|strong="G1537,G3588,G2768"\w* \w do altar|strong="G3588,G2379"\w* \w de ouro|strong="G3588,G5552"\w*, \w o que está|strong="G3588"\w* \w diante de Deus|strong="G1799,G3588,G2316"\w*,\f + \fr 9.13: \ft Variante: NA28, o TR e o RP acrescentam “quatro” (τεσσάρων) antes de “chifres”: “dos quatro chifres”.\f*\f + \fr 9.13: \ft Acréscimo: “o que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 9:13 \xt REV 8:3; REV 11:15; 1CO 15:52; REV 9:1; EXO 30:2-3; REV 10:1\x*
\v 14 \w dizendo|strong="G3004"\w* \w ao sexto|strong="G3588,G1623"\w* \w anjo|strong="G32"\w*, \w o que tinha|strong="G3588,G2192"\w* \w a trombeta|strong="G3588,G4536"\w*: “\w Solte|strong="G3089"\w* \w os quatro|strong="G3588,G5064"\w* \w anjos|strong="G32"\w* \w que estão presos|strong="G3588,G1210"\w* \w junto ao grande rio|strong="G1909,G3588,G4215,G3173"\w* \w Eufrates|strong="G2166"\w*.”\f + \fr 9.14: \ft Variante: o RP traz o feminino λέγουσαν (“dizendo”, concordando com “voz”) em lugar de λέγοντα.\f*\x - \xo 9:14 \xt REV 16:12; REV 8:2; 2SA 8:3; GEN 2:14; REV 9:15; JER 51:63\x*
\v 15 \w e|strong="G2532"\w* \w foram soltos|strong="G3089"\w* \w os quatro|strong="G3588,G5064"\w* \w anjos|strong="G32"\w* \w que estavam preparados|strong="G3588,G2090"\w* \w para a hora|strong="G1519,G3588,G5610"\w* \w e|strong="G2532"\w* \w dia|strong="G2250"\w* \w e|strong="G2532"\w* \w mês|strong="G3376"\w* \w e|strong="G2532"\w* \w ano|strong="G1763"\w*, \w para que|strong="G2443"\w* \w matassem|strong="G615"\w* \w a terça parte|strong="G3588,G5154"\w* \w dos seres humanos|strong="G3588,G444"\w*.\f + \fr 9.15: \ft Variante: o RP repete “para” (εἰς τήν) antes de “dia”.\f*\x - \xo 9:15 \xt REV 9:18; REV 9:14; REV 8:7; REV 8:12; REV 6:8; REV 8:9\x*
\v 16 \w E|strong="G2532"\w* \w o número|strong="G3588,G706"\w* \w das tropas|strong="G3588,G4753"\w* \w da cavalaria|strong="G3588,G2461"\w* \add era\add* \w duas miríades|strong="G3461_A,G1364"\w* \w de miríades|strong="G3461"\w*; \w ouvi|strong="G191"\w* \w o número|strong="G3588,G706"\w* \w deles|strong="G846"\w*.\f + \fr 9.16: \ft Lit.: Δισμυριάδες μυριάδων, “duas miríades de miríades”, isto é, 2 × 10.000 × 10.000, ou seja, duzentos milhões; a cifra indica uma multidão incontável.\f*\f + \fr 9.16: \ft Variante: WH e NA28 trazem a palavra δισμυριάδες; Treg traz δύο μυριάδες (“duas miríades”); o RP traz apenas μυριάδες e “do cavalo” (ἵππου) em lugar de “da cavalaria” (ἱππικοῦ).\f*\f + \fr 9.16: \ft Acréscimo: “era” (em “da cavalaria era duas miríades”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 9:16 \xt PSA 68:17; REV 7:4; DAN 7:10; EZK 38:4; REV 9:12\x*
\v 17 \w E|strong="G2532"\w* \w assim|strong="G3779"\w* \w vi|strong="G1492"\w* \w os cavalos|strong="G3588,G2462"\w* \w na visão|strong="G1722,G3588,G3706"\w* \w e|strong="G2532"\w* \w os que estavam sentados|strong="G3588,G2521"\w* \w sobre eles|strong="G1909,G846"\w*, \w tendo|strong="G2192"\w* \w couraças|strong="G2382"\w* \w cor de fogo|strong="G4447"\w* \w e|strong="G2532"\w* \w azul-jacinto|strong="G5191"\w* \w e|strong="G2532"\w* \w cor de enxofre|strong="G2306"\w*; \w e|strong="G2532"\w* \w as cabeças|strong="G3588,G2776"\w* \w dos cavalos|strong="G3588,G2462"\w* \w eram como|strong="G5613"\w* \w cabeças|strong="G2776"\w* \w de leões|strong="G3023"\w*, \w e|strong="G2532"\w* \w das bocas|strong="G1537,G3588,G4750"\w* \w deles|strong="G846"\w* \w sai|strong="G1607"\w* \w fogo|strong="G4442"\w* \w e|strong="G2532"\w* \w fumaça|strong="G2586"\w* \w e|strong="G2532"\w* \w enxofre|strong="G2303"\w*.\f + \fr 9.17: \ft Lit.: Πύρινος, “de fogo, cor de fogo”; ὑακίνθινος, “cor de jacinto” (azul-escuro ou púrpura); θειώδης, “sulfuroso, cor de enxofre”.\f*\f + \fr 9.17: \ft Acréscimo: verbo ser/estar suprido em “eram como”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:17 \xt EPH 6:14; REV 9:18; 1CH 12:8; REV 14:10; REV 21:8; EXO 28:4\x*
\v 18 \w Por estas três pragas|strong="G575,G3588,G5140,G4127,G3778"\w* \w foi morta|strong="G615"\w* \w a terça parte|strong="G3588,G5154"\w* \w dos seres humanos|strong="G3588,G444"\w*, \w pelo fogo|strong="G1537,G3588,G4442"\w* \w e|strong="G2532"\w* \w pela fumaça|strong="G3588,G2586"\w* \w e|strong="G2532"\w* \w pelo enxofre|strong="G3588,G2303"\w* \w que saía|strong="G3588,G1607"\w* \w das bocas|strong="G1537,G3588,G4750"\w* \w deles|strong="G846"\w*.\f + \fr 9.18: \ft Lit.: o verbo ἀπεκτάνθησαν está no plural e concorda com “seres humanos”, embora o sujeito gramatical seja “a terça parte”.\f*\f + \fr 9.18: \ft Variante: o TR omite “pragas” (πληγῶν), lendo “por estes três”; o RP traz ἀπό (“por”) em lugar de ἐκ antes de “fogo”.\f*\x - \xo 9:18 \xt REV 9:15; REV 9:17; REV 8:7; REV 8:12; REV 6:8; ISA 42:25\x*
\v 19 \w Pois|strong="G1063"\w* \w a autoridade|strong="G3588,G1849"\w* \w dos cavalos|strong="G3588,G2462"\w* \w está|strong="G1510"\w* \w na boca|strong="G1722,G3588,G4750"\w* \w deles|strong="G846"\w* \w e|strong="G2532"\w* \w nas caudas|strong="G1722,G3588,G3769"\w* \w deles|strong="G846"\w*; \w pois|strong="G1063"\w* \w as caudas|strong="G3588,G3769"\w* \w deles|strong="G846"\w* \w são semelhantes|strong="G3664"\w* \w a serpentes|strong="G3789"\w*, \w tendo|strong="G2192"\w* \w cabeças|strong="G2776"\w*, \w e|strong="G2532"\w* \w com elas|strong="G1722,G846"\w* \w danificam|strong="G91"\w*.\f + \fr 9.19: \ft Variante: o TR omite “dos cavalos” (ἵππων); o RP traz “de serpentes” (ὄφεων, genitivo) em lugar de ὄφεσιν.\f*\f + \fr 9.19: \ft Acréscimo: verbo ser/estar suprido em “são semelhantes”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 9:19 \xt REV 9:10; ISA 42:25; ISA 9:15; REV 9:12\x*
\p
\v 20 \w E|strong="G2532"\w* \w os restantes|strong="G3588,G3062"\w* \w dos seres humanos|strong="G3588,G444"\w*, \w que|strong="G3739"\w* \w não|strong="G3756"\w* \w foram mortos|strong="G615"\w* \w por estas pragas|strong="G1722,G3588,G4127,G3778"\w*, \w nem|strong="G3761"\w* \w se arrependeram|strong="G3340"\w* \w das obras|strong="G1537,G3588,G2041"\w* \w das mãos|strong="G3588,G5495"\w* \w deles|strong="G846"\w*, \w para que não|strong="G2443,G3361"\w* \w adorassem|strong="G4352"\w* \w os demônios|strong="G3588,G1140"\w* \w e|strong="G2532"\w* \w os ídolos|strong="G3588,G1497"\w* \w de ouro|strong="G3588,G5552"\w* \w e|strong="G2532"\w* \w de prata|strong="G3588,G693"\w* \w e|strong="G2532"\w* \w de bronze|strong="G3588,G5470"\w* \w e|strong="G2532"\w* \w de pedra|strong="G3588,G3035"\w* \w e|strong="G2532"\w* \w de madeira|strong="G3588,G3585"\w*, \w os quais|strong="G3739"\w* \w nem|strong="G3777"\w* \w podem ver|strong="G991,G1410"\w* \w nem|strong="G3777"\w* \w ouvir|strong="G191"\w* \w nem|strong="G3777"\w* \w andar|strong="G4043"\w*,\f + \fr 9.20: \ft Lit.: ἵνα μὴ προσκυνήσουσιν, “para que não adorassem”, isto é, arrepender-se a ponto de deixar de adorar; δαιμόνιον, “demônio, espírito mau”.\f*\f + \fr 9.20: \ft Nota cultural: a lista de ídolos de ouro, prata, bronze, pedra e madeira e a descrição de ídolos que não veem, ouvem nem andam ecoam Sl 115:4-7 e Dn 5:23.\f*\x - \xo 9:20 \xt DAN 5:23; PSA 115:4-7; 1CO 10:20; DAN 12:10; DEU 31:29; REV 2:21\x*
\v 21 \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w se arrependeram|strong="G3340"\w* \w dos assassinatos|strong="G1537,G3588,G5408"\w* \w deles|strong="G846"\w*, \w nem|strong="G3777"\w* \w das feitiçarias|strong="G1537,G3588,G5331"\w* \w deles|strong="G846"\w*, \w nem|strong="G3777"\w* \w da prostituição|strong="G1537,G3588,G4202"\w* \w deles|strong="G846"\w*, \w nem|strong="G3777"\w* \w dos roubos|strong="G1537,G3588,G2809"\w* \w deles|strong="G846"\w*\f + \fr 9.21: \ft Variante: Treg e o RP trazem φαρμακειῶν (“feitiçarias”, outra forma da mesma palavra) em lugar de φαρμάκων.\f*\f + \fr 9.21: \ft Lit.: Φάρμακον, “droga, poção, magia”; πορνεία, “imoralidade sexual, prostituição”.\f*.\x - \xo 9:21 \xt REV 2:21; REV 21:8; DAN 12:10; REV 22:15; 2CO 12:21; REV 17:5\x*
\c 10
\p
\v 1 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w outro anjo|strong="G243,G32"\w* \w forte|strong="G2478"\w* \w descendo|strong="G2597"\w* \w do céu|strong="G1537,G3588,G3772"\w*, \w envolto|strong="G4016"\w* \w em nuvem|strong="G3507"\w*, \w e|strong="G2532"\w* \w o arco-íris|strong="G3588,G2463"\w* \w sobre a cabeça|strong="G1909,G3588,G2776"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w o rosto|strong="G3588,G4383"\w* \w dele|strong="G846"\w* \w como o sol|strong="G5613,G3588,G2246"\w*, \w e|strong="G2532"\w* \w os pés|strong="G3588,G4228"\w* \w dele|strong="G846"\w* \w como colunas|strong="G5613,G4769"\w* \w de fogo|strong="G4442"\w*,\f + \fr 10.1: \ft Nota cultural: o anjo envolto em nuvem, com o arco-íris e as pernas como colunas de fogo, evoca teofanias do AT (Ez 1:28; Êx 13:21-22).\f*\f + \fr 10.1: \ft Variante: NA28 e o RP trazem o genitivo τῆς κεφαλῆς (“da cabeça”) em lugar de τὴν κεφαλήν; o RP omite “outro” (ἄλλον).\f*\x - \xo 10:1 \xt EZK 1:28; EXO 13:21-22; MAT 17:2; REV 1:15-16; REV 4:3; GEN 9:13\x*
\v 2 \w e|strong="G2532"\w* \w tendo|strong="G2192"\w* \w na mão|strong="G1722,G3588,G5495"\w* \w dele|strong="G846"\w* \w um livrinho|strong="G974"\w* \w aberto|strong="G455"\w*. \w E|strong="G2532"\w* \w pôs|strong="G5087"\w* \w o pé|strong="G3588,G4228"\w* \w direito|strong="G3588,G1188"\w* \w dele|strong="G846"\w* \w sobre o mar|strong="G1909,G3588,G2281"\w*, \w o esquerdo|strong="G3588,G2176"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*,\f + \fr 10.2: \ft Lit.: Βιβλαρίδιον, diminutivo de βιβλίον, “livrinho, pequeno rolo”; εὐώνυμος, “esquerdo” (literalmente “de bom nome”, eufemismo).\f*\f + \fr 10.2: \ft Variante: o RP traz βιβλίον (“livro”) em lugar de βιβλαρίδιον.\f*\x - \xo 10:2 \xt REV 10:5; REV 10:8; REV 5:1; EZK 2:9-10; MAT 28:18; PSA 2:8\x*
\v 3 \w e|strong="G2532"\w* \w clamou|strong="G2896"\w* \w em voz|strong="G5456"\w* \w grande|strong="G3173"\w* \w como um leão|strong="G5618,G3023"\w* \w ruge|strong="G3455"\w*. \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w clamou|strong="G2896"\w*, \w falaram|strong="G2980"\w* \w os sete|strong="G3588,G2033"\w* \w trovões|strong="G1027"\w* \w com as suas próprias|strong="G3588,G1438"\w* \w vozes|strong="G5456"\w*.\x - \xo 10:3 \xt REV 4:5; DAN 10:6; REV 1:10; ISA 31:4; JOS 6:4; REV 14:2\x*
\v 4 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w falaram|strong="G2980"\w* \w os sete|strong="G3588,G2033"\w* \w trovões|strong="G1027"\w*, \w eu estava para|strong="G3195"\w* \w escrever|strong="G1125"\w*; \w e|strong="G2532"\w* \w ouvi|strong="G191"\w* \w uma voz|strong="G5456"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w dizendo|strong="G3004"\w*: “\w Sele|strong="G4972"\w* \w as coisas que|strong="G3739"\w* \w falaram|strong="G2980"\w* \w os sete|strong="G3588,G2033"\w* \w trovões|strong="G1027"\w*, \w e|strong="G2532"\w* \w não|strong="G3361"\w* \w as escreva|strong="G846,G1125"\w*.”\f + \fr 10.4: \ft Variante: o TR acrescenta “as suas vozes” (τὰς φωνὰς ἑαυτῶν) depois de “sete trovões” na primeira oração e “a mim” (μοι) depois de “dizendo”.\f*\x - \xo 10:4 \xt DAN 12:4; DAN 8:26; REV 22:10; DAN 12:9; DAN 10:6; REV 1:10\x*
\v 5 \w e|strong="G2532"\w* \w o anjo|strong="G3588,G32"\w* \w que|strong="G3739"\w* \w vi|strong="G1492"\w* \w de pé|strong="G2476"\w* \w sobre o mar|strong="G1909,G3588,G2281"\w* \w e|strong="G2532"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w levantou|strong="G142"\w* \w a mão|strong="G3588,G5495"\w* \w dele|strong="G846"\w* \w direita|strong="G3588,G1188"\w* \w para o céu|strong="G1519,G3588,G3772"\w*,\f + \fr 10.5: \ft Variante: o TR omite “direita” (τὴν δεξιάν).\f*\x - \xo 10:5 \xt REV 10:8; REV 10:2; DAN 12:7; DEU 32:40; REV 1:10; ACT 14:15\x*
\v 6 \w e|strong="G2532"\w* \w jurou|strong="G3660"\w* \w por aquele que vive|strong="G3588,G2198"\w* \w para os séculos|strong="G1519,G3588,G165"\w* \w dos séculos|strong="G3588,G165"\w*, \w que|strong="G3739"\w* \w criou|strong="G2936"\w* \w o céu|strong="G3588,G3772"\w* \w e|strong="G2532"\w* \w o que há nele|strong="G3588,G1722,G846"\w* \w e|strong="G2532"\w* \w a terra|strong="G3588,G1093"\w* \w e|strong="G2532"\w* \w o que há nela|strong="G3588,G1722,G846"\w* \w e|strong="G2532"\w* \w o mar|strong="G3588,G2281"\w* \w e|strong="G2532"\w* \w o que há nele|strong="G3588,G1722,G846"\w*, \w que|strong="G3754"\w* \w tempo|strong="G5550"\w* \w não haverá mais|strong="G2089,G3756,G1510"\w*;\f + \fr 10.6: \ft Lit.: Χρόνος, “tempo”; “que não haverá mais tempo” pode ser entendido como “não haverá mais demora”.\f*\f + \fr 10.6: \ft Variante: WH, Treg, NA28 e o TR acrescentam “em” (ἐν) depois de “jurou”.\f*\f + \fr 10.6: \ft Nota cultural: Ecoa Dn 12:7, onde o homem vestido de linho ergue as mãos ao céu e jura por aquele que vive para sempre.\f*\f + \fr 10.6: \ft Acréscimo: “o que há nele”, “o que há nela”, “o que há nele”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 10:6 \xt DAN 12:7; GEN 1:1; REV 4:11; REV 12:12; REV 4:9; GEN 1:9\x*
\v 7 \w mas|strong="G235"\w* \w nos dias|strong="G1722,G3588,G2250"\w* \w da voz|strong="G3588,G5456"\w* \w do sétimo|strong="G3588,G1442"\w* \w anjo|strong="G32"\w*, \w quando|strong="G3752"\w* \w estiver para|strong="G3195"\w* \w tocar a trombeta|strong="G4537"\w*, \w então|strong="G2532"\w* \w será consumado|strong="G5055"\w* \w o mistério|strong="G3588,G3466"\w* \w de Deus|strong="G3588,G2316"\w*, \w como|strong="G5613"\w* \w anunciou a boa notícia|strong="G2097"\w* \w aos seus próprios|strong="G3588,G1438"\w* \w servos|strong="G1401"\w*, \w os profetas|strong="G3588,G4396"\w*.\f + \fr 10.7: \ft Lit.: Ἐτελέσθη (aoristo), “foi consumado, foi cumprido”, usado aqui como aoristo profético, que trata o evento futuro como certo; καί depois da oração temporal tem valor de “então”; μυστήριον, “mistério, segredo revelado por Deus”.\f*\f + \fr 10.7: \ft Variante: o RP traz “seus servos” (δούλους αὐτοῦ) em ordem e forma diferentes de τοὺς ἑαυτοῦ δούλους.\f*\x - \xo 10:7 \xt REV 11:15; EPH 3:3-9; ROM 16:25; LUK 24:44-47; AMO 3:7; DAN 12:7\x*
\v 8 \w E|strong="G2532"\w* \w a voz|strong="G3588,G5456"\w* \w que|strong="G3739"\w* \w ouvi|strong="G191"\w* \w do céu|strong="G1537,G3588,G3772"\w*, \w de novo|strong="G3825"\w* \w falando|strong="G2980"\w* \w comigo|strong="G3326,G1473"\w* \w e|strong="G2532"\w* \w dizendo|strong="G3004"\w*: “\w Vá|strong="G5217"\w*, \w tome|strong="G2983"\w* \w o livro|strong="G3588,G975"\w* \w aberto|strong="G3588,G455"\w* \w na mão|strong="G1722,G3588,G5495"\w* \w do anjo|strong="G3588,G32"\w* \w que está de pé|strong="G3588,G2476"\w* \w sobre o mar|strong="G1909,G3588,G2281"\w* \w e|strong="G2532"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*.”\f + \fr 10.8: \ft Lit.: a construção é um anacoluto: “a voz que ouvi… falando” traz o particípio em acusativo, seguido de “dizendo”.\f*\f + \fr 10.8: \ft Variante: o RP traz o nominativo λαλοῦσα e λέγουσα (“falando”, “dizendo”) e βιβλιδάριον (“livrinho”) em lugar de βιβλίον.\f*\x - \xo 10:8 \xt REV 10:2; REV 10:5; REV 5:1; REV 1:10; EZK 2:9; REV 10:4-5\x*
\v 9 \w E|strong="G2532"\w* \w fui|strong="G565"\w* \w ao anjo|strong="G4314,G3588,G32"\w*, \w dizendo|strong="G3004"\w* \w a ele|strong="G846"\w* \w que me desse|strong="G1325,G3165"\w* \w o livrinho|strong="G3588,G974"\w*. \w E|strong="G2532"\w* \w ele me disse|strong="G3004,G3165"\w*: “\w Tome|strong="G2983"\w* \w e|strong="G2532"\w* \w devore|strong="G2719"\w*-\w o|strong="G846"\w*, \w e|strong="G2532"\w* \w ele amargará|strong="G4087"\w* \w o seu ventre|strong="G4771,G3588,G2836"\w*, \w mas|strong="G235"\w* \w na sua boca|strong="G1722,G3588,G4750,G4771"\w* \w será doce|strong="G1510,G1099"\w* \w como mel|strong="G5613,G3192"\w*.”\f + \fr 10.9: \ft Variante: Treg e o RP trazem ἀπῆλθον em lugar de ἀπῆλθα (“fui”), formas do mesmo verbo.\f*\f + \fr 10.9: \ft Nota cultural: Ecoa Ez 2:8-3:3, onde o profeta come um rolo que na boca é doce como mel.\f*\x - \xo 10:9 \xt EZK 2:8; JER 15:16; EZK 3:1; EZK 3:3; EZK 3:14; JOB 23:12\x*
\v 10 \w e|strong="G2532"\w* \w tomei|strong="G2983"\w* \w o livrinho|strong="G3588,G974"\w* \w da mão|strong="G1537,G3588,G5495"\w* \w do anjo|strong="G3588,G32"\w* \w e|strong="G2532"\w* \w o devorei|strong="G2719,G846"\w*, \w e|strong="G2532"\w* \w na minha boca|strong="G1722,G3588,G4750,G3165"\w* \w foi doce|strong="G1510,G1099"\w* \w como mel|strong="G5613,G3192"\w*; \w e|strong="G2532"\w* \w quando|strong="G3753"\w* \w o comi|strong="G5315,G846"\w*, \w ficou amargo|strong="G4087"\w* \w o meu ventre|strong="G3588,G2836,G3165"\w*.\f + \fr 10.10: \ft Nota cultural: o ato de comer o rolo, doce como mel na boca, ecoa Ez 2:8–3:3 (a palavra de Deus engolida pelo profeta).\f*\x - \xo 10:10 \xt EZK 2:8; JER 15:16; EZK 3:3; EZK 3:1; PRO 16:24; PSA 119:103\x*
\v 11 \w E|strong="G2532"\w* \w me disseram|strong="G3004,G3165"\w*: “\w É necessário|strong="G1163"\w* \w que você|strong="G4771"\w* \w de novo|strong="G3825"\w* \w profetize|strong="G4395"\w* \w sobre povos|strong="G1909,G2992"\w* \w e|strong="G2532"\w* \w nações|strong="G1484"\w* \w e|strong="G2532"\w* \w línguas|strong="G1100"\w* \w e|strong="G2532"\w* \w muitos reis|strong="G935,G4183"\w*.”\f + \fr 10.11: \ft Variante: o RP repete “sobre” (ἐπί) antes de “nações”.\f*\x - \xo 10:11 \xt REV 17:15; REV 13:7; EZK 37:4; REV 5:1; JER 1:9-10; EZK 37:9\x*
\c 11
\p
\v 1 \w E|strong="G2532"\w* \w foi dado|strong="G1325"\w* \w a mim|strong="G3165"\w* \w uma cana|strong="G2563"\w* \w semelhante|strong="G3664"\w* \w a uma vara|strong="G4464"\w*, \w dizendo|strong="G3004"\w*: “\w Levante-se|strong="G1453"\w* \w e|strong="G2532"\w* \w meça|strong="G3354"\w* \w o santuário|strong="G3588,G3485"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w o altar|strong="G3588,G2379"\w* \w e|strong="G2532"\w* \w os que adoram|strong="G3588,G4352"\w* \w nele|strong="G1722,G846"\w*.”\f + \fr 11.1: \ft Lit.: Κάλαμος, “cana, caniço” (usado como vara de medir); μετρέω, “medir”.\f*\x - \xo 11:1 \xt REV 21:15; EZK 42:15-20; ZEC 2:1; EZK 40:3; EZK 40:1-48; 1CO 3:16-17\x*
\v 2 \w e|strong="G2532"\w* \w o pátio|strong="G3588,G833"\w* \w que está fora|strong="G3588,G1855"\w* \w do santuário|strong="G3588,G3485"\w* \w deixe|strong="G1544"\w* \w de fora|strong="G1855"\w*, \w e|strong="G2532"\w* \w não|strong="G3361"\w* \w o meça|strong="G846,G3354"\w*, \w porque|strong="G3754"\w* \w foi dado|strong="G1325"\w* \w às nações|strong="G3588,G1484"\w*, \w e|strong="G2532"\w* \w a cidade santa|strong="G3588,G4172,G40"\w* \w pisarão|strong="G3961"\w* \w por quarenta e dois|strong="G5062,G1417"\w* \w meses|strong="G3376"\w*.\f + \fr 11.2: \ft Lit.: Ἔκβαλε ἔξωθεν, literalmente “lance para fora”, isto é, “deixe de fora”; αὐλή, “pátio”.\f*\f + \fr 11.2: \ft Nota cultural: os quarenta e dois meses (três anos e meio, 1.260 dias) ecoam Dn 7:25 e 12:7; a cidade santa pisada pelas nações evoca Lc 21:24 e Zc 12:3.\f*\f + \fr 11.2: \ft Variante: WH, NA28 e o RP acrescentam “e” (καί) entre “quarenta” e “dois”; o TR traz ἔσωθεν (“de dentro”) em lugar de ἔξωθεν (“de fora”).\f*\f + \fr 11.2: \ft Acréscimo: “que está fora”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 11:2 \xt LUK 21:24; DAN 7:25; DAN 12:7; ZEC 12:3; REV 13:5; REV 12:6\x*
\v 3 \w E|strong="G2532"\w* \w darei|strong="G1325"\w* \w às minhas|strong="G3588,G3165"\w* \w duas|strong="G1417"\w* \w testemunhas|strong="G3144"\w*, \w e|strong="G2532"\w* \w profetizarão|strong="G4395"\w* \w mil duzentos e sessenta|strong="G5507,G1250,G1835"\w* \w dias|strong="G2250"\w*, \w vestidos|strong="G4016"\w* \w de saco|strong="G4526"\w*.\f + \fr 11.3: \ft Lit.: o verbo δώσω não tem objeto expresso; subentende-se “autoridade” ou “a missão de profetizar”; σάκκος, “saco, veste de pelo grosso” (sinal de luto e arrependimento); μάρτυς, “testemunha”.\f*\x - \xo 11:3 \xt REV 12:6; ACT 1:8; JER 1:10; DAN 7:25; DAN 8:14; REV 11:2\x*
\v 4 \w Estes|strong="G3778"\w* \w são|strong="G1510"\w* \w as duas|strong="G3588,G1417"\w* \w oliveiras|strong="G1636"\w* \w e|strong="G2532"\w* \w os dois|strong="G3588,G1417"\w* \w candelabros|strong="G3087"\w* \w que estão de pé|strong="G3588,G2476"\w* \w diante do Senhor|strong="G1799,G3588,G2962"\w* \w da terra|strong="G3588,G1093"\w*.\f + \fr 11.4: \ft Nota cultural: as duas oliveiras e os dois candelabros ecoam Zc 4:2-3 e 11-14.\f*\f + \fr 11.4: \ft Variante: o TR traz “Deus” (Θεοῦ) em lugar de “Senhor” (κυρίου) e o RP traz o feminino ἑστῶσαι (“que estão de pé”) em lugar de ἑστῶτες.\f*\x - \xo 11:4 \xt ZEC 4:2-3; ACT 1:8; ZEC 4:14; ZEC 4:11; JER 1:10; ZEC 4:3\x*
\v 5 \w E|strong="G2532"\w* \w se alguém|strong="G1487,G5100"\w* \w quer|strong="G2309"\w* \w danificá-los|strong="G846,G91"\w*, \w fogo|strong="G4442"\w* \w sai|strong="G1607"\w* \w da boca|strong="G1537,G3588,G4750"\w* \w deles|strong="G846"\w* \w e|strong="G2532"\w* \w devora|strong="G2719"\w* \w os inimigos|strong="G3588,G2190"\w* \w deles|strong="G846"\w*; \w e|strong="G2532"\w* \w se alguém|strong="G1487,G5100"\w* \w quiser|strong="G2309"\w* \w danificá-los|strong="G846,G91"\w*, \w assim|strong="G3779"\w* \w é necessário|strong="G1163"\w* \w que ele|strong="G846"\w* \w seja morto|strong="G615"\w*.\x - \xo 11:5 \xt LUK 10:19; JER 23:29; ACT 1:8; JER 1:10; JER 5:14; 2KI 1:10\x*
\v 6 \w Estes|strong="G3778"\w* \w têm|strong="G2192"\w* \w a autoridade|strong="G3588,G1849"\w* \w de fechar|strong="G2808"\w* \w o céu|strong="G3588,G3772"\w*, \w para que|strong="G2443"\w* \w não|strong="G3361"\w* \w caia|strong="G1026"\w* \w chuva|strong="G5205"\w* \w nos dias|strong="G3588,G2250"\w* \w da profecia|strong="G3588,G4394"\w* \w deles|strong="G846"\w*, \w e|strong="G2532"\w* \w têm|strong="G2192"\w* \w autoridade|strong="G1849"\w* \w sobre as águas|strong="G1909,G3588,G5204"\w* \w de transformá-las|strong="G4762,G846"\w* \w em sangue|strong="G1519,G129"\w* \w e|strong="G2532"\w* \w ferir|strong="G3960"\w* \w a terra|strong="G3588,G1093"\w* \w com toda praga|strong="G1722,G3956,G4127"\w*, \w sempre que|strong="G3740,G1437"\w* \w quiserem|strong="G2309"\w*.\f + \fr 11.6: \ft Nota cultural: o poder de fechar o céu lembra Elias (1Rs 17:1) e o de transformar águas em sangue e ferir com pragas lembra Moisés (Êx 7:17-20).\f*\x - \xo 11:6 \xt 1KI 17:1; EXO 7:17; ACT 1:8; JAS 5:17; JER 1:10; MAT 16:19\x*
\v 7 \w E|strong="G2532"\w* \w quando|strong="G3752"\w* \w terminarem|strong="G5055"\w* \w o testemunho|strong="G3588,G3141"\w* \w deles|strong="G846"\w*, \w a fera|strong="G3588,G2342"\w* \w que sobe|strong="G3588,G305"\w* \w do abismo|strong="G1537,G3588,G12"\w* \w fará guerra|strong="G4160,G4171"\w* \w contra eles|strong="G3326,G846"\w* \w e|strong="G2532"\w* \w os vencerá|strong="G3528,G846"\w* \w e|strong="G2532"\w* \w os matará|strong="G615,G846"\w*.\f + \fr 11.7: \ft Lit.: Θηρίον, “fera, animal selvagem”: primeira aparição da fera, que retorna nos caps. 13 e 17; μαρτυρία, “testemunho”.\f*\x - \xo 11:7 \xt REV 13:7; REV 12:11; REV 13:1; REV 17:8; REV 12:17; ROM 8:37\x*
\v 8 \w E|strong="G2532"\w* \w o cadáver|strong="G3588,G4430"\w* \w deles|strong="G846"\w* \add estará\add* \w na praça|strong="G1909,G3588,G4113"\w* \w da grande cidade|strong="G3588,G4172,G3173"\w*, \w que|strong="G3748"\w* \w é chamada|strong="G2564"\w* \w simbolicamente|strong="G4153"\w* \w Sodoma|strong="G4670"\w* \w e|strong="G2532"\w* \w Egito|strong="G125"\w*, \w onde|strong="G3699"\w* \w também|strong="G2532"\w* \w o Senhor|strong="G3588,G2962"\w* \w deles|strong="G846"\w* \w foi crucificado|strong="G4717"\w*.\f + \fr 11.8: \ft Lit.: Πνευματικῶς, “espiritualmente, em sentido espiritual (simbólico)”; πλατεῖα, “rua larga, praça”.\f*\f + \fr 11.8: \ft Nota cultural: Sodoma (Is 1:9-10; Ez 16:46-49) e Egito (Êx 1–14) simbolizam corrupção e opressão; o texto não nomeia a “grande cidade” além de dizer que ali o Senhor foi crucificado, e a identificação é discutida.\f*\f + \fr 11.8: \ft Acréscimo: “estará” (em “cadáver deles estará na praça”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige.\f*\x - \xo 11:8 \xt ISA 1:9-10; EZK 16:46; JER 23:14; ROM 8:37; MAT 23:37; ISA 1:10\x*
\v 9 \w E|strong="G2532"\w* \w alguns dos povos|strong="G1537,G3588,G2992"\w* \w e|strong="G2532"\w* \w tribos|strong="G5443"\w* \w e|strong="G2532"\w* \w línguas|strong="G1100"\w* \w e|strong="G2532"\w* \w nações|strong="G1484"\w* \w veem|strong="G991"\w* \w o cadáver|strong="G3588,G4430"\w* \w deles|strong="G846"\w* \w por três dias|strong="G2250,G5140"\w* \w e|strong="G2532"\w* \w meio|strong="G2255"\w*, \w e|strong="G2532"\w* \w os cadáveres|strong="G3588,G4430"\w* \w deles|strong="G846"\w* \w não|strong="G3756"\w* \w permitem|strong="G863"\w* \w que sejam postos|strong="G5087"\w* \w num túmulo|strong="G1519,G3418"\w*.\f + \fr 11.9: \ft Lit.: πτῶμα (singular, “cadáver”) em 11:8 e na primeira parte de 11:9, e πτώματα (plural, “cadáveres”) na segunda parte de 11:9: o grego alterna entre o singular e o plural, e a tradução o segue.\f*\f + \fr 11.9: \ft Variante: Treg e o RP omitem “e” (καί) antes de “tribos”; o TR traz os plurais πτώματα (“cadáveres”) e μνήματα (“túmulos”) em lugar de πτῶμα e μνῆμα; o RP traz o futuro ἀφήσουσιν (“permitirão”).\f*\f + \fr 11.9: \ft Tradução: ἀφίουσιν (ἀφίημι, G863) está aqui como “permitem”; o termo pode ser “deixar”, “perdoar”, “permitir”, “abandonar” ou “mandar embora”, e o contexto decide.\f*\x - \xo 11:9 \xt HEB 11:5; ROM 8:37; REV 5:9; PSA 79:2-3; REV 11:11; 1KI 22:8\x*
\v 10 \w E|strong="G2532"\w* \w os que habitam|strong="G3588,G2730"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w se alegram|strong="G5463"\w* \w por causa deles|strong="G1909,G846"\w* \w e|strong="G2532"\w* \w se regozijam|strong="G2165"\w*, \w e|strong="G2532"\w* \w presentes|strong="G1435"\w* \w enviarão|strong="G3992"\w* \w uns aos outros|strong="G240"\w*, \w porque|strong="G3754"\w* \w estes dois|strong="G3778,G3588,G1417"\w* \w profetas|strong="G4396"\w* \w atormentaram|strong="G928"\w* \w os que habitam|strong="G3588,G2730"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*\f + \fr 11.10: \ft Variante: o RP traz εὐφρανθήσονται (“se regozijarão”, futuro) em lugar de εὐφραίνονται e “darão” (δώσουσιν) em lugar de “enviarão” (πέμψουσιν).\f*.\x - \xo 11:10 \xt HEB 11:5; NEH 8:10; ROM 8:37; 1KI 18:17; REV 12:12; 1KI 22:8\x*
\v 11 \w E|strong="G2532"\w* \w depois|strong="G3326"\w* \w dos três|strong="G3588,G5140"\w* \w dias|strong="G2250"\w* \w e|strong="G2532"\w* \w meio|strong="G2255"\w*, \w um espírito|strong="G4151"\w* \w de vida|strong="G2222"\w* \w vindo de Deus|strong="G1537,G3588,G2316"\w* \w entrou|strong="G1525"\w* \w neles|strong="G1722,G846"\w*, \w e|strong="G2532"\w* \add ficaram de\add* \w pé|strong="G2476"\w* \w sobre os seus pés|strong="G1909,G3588,G4228,G846"\w*, \w e|strong="G2532"\w* \w um grande|strong="G3173"\w* \w medo|strong="G5401"\w* \w caiu|strong="G1968"\w* \w sobre os que|strong="G1909,G3588"\w* \w os observavam|strong="G2334,G846"\w*.\f + \fr 11.11: \ft Nota cultural: o espírito de vida que entra nos corpos mortos, e eles se põem de pé, ecoa Ez 37:5-10.\f*\f + \fr 11.11: \ft Variante: o RP traz εἰς αὐτούς (“para dentro deles”) em lugar de ἐν αὐτοῖς e ἔπεσεν em lugar de ἐπέπεσεν.\f*\f + \fr 11.11: \ft Acréscimo: “ficaram” (em “neles e ficaram de pé”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; “de” (em “e ficaram de pé sobre”): preposição ou artigo que a regência do português exige.\f*\x - \xo 11:11 \xt EZK 37:5-10; ROM 8:11; GEN 2:7; GAL 5:25; HEB 11:5; ROM 8:2\x*
\v 12 \w E|strong="G2532"\w* \w ouviram|strong="G191"\w* \w uma grande|strong="G3173"\w* \w voz|strong="G5456"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w dizendo|strong="G3004"\w* \w a eles|strong="G846"\w*: “\w Subam|strong="G305"\w* \w aqui|strong="G5602"\w*”; \w e|strong="G2532"\w* \w subiram|strong="G305"\w* \w ao céu|strong="G1519,G3588,G3772"\w* \w na nuvem|strong="G1722,G3588,G3507"\w*, \w e|strong="G2532"\w* \w os viram|strong="G2334,G846"\w* \w os inimigos|strong="G3588,G2190"\w* \w deles|strong="G846"\w*.\f + \fr 11.12: \ft Variante: o RP traz “ouvi” (ἤκουσα, primeira pessoa) em lugar de ἤκουσαν (“ouviram”), o acusativo φωνὴν μεγάλην e λέγουσαν em lugar de φωνῆς μεγάλης e λεγούσης, e Ἀνάβητε em lugar de Ἀνάβατε.\f*\x - \xo 11:12 \xt REV 4:1; 1TH 4:17; HEB 11:5; ROM 8:37; 2KI 2:11; ACT 1:9\x*
\v 13 \w E|strong="G2532"\w* \w naquela hora|strong="G1722,G1565,G3588,G5610"\w* \w houve|strong="G1096"\w* \w um grande|strong="G3173"\w* \w terremoto|strong="G4578"\w*, \w e|strong="G2532"\w* \w a décima parte|strong="G3588,G1182"\w* \w da cidade|strong="G3588,G4172"\w* \w caiu|strong="G4098"\w*, \w e|strong="G2532"\w* \w foram mortas|strong="G615"\w* \w no terremoto|strong="G1722,G3588,G4578"\w* \w sete mil|strong="G5505,G2033"\w* \w pessoas|strong="G3686,G444"\w*, \w e|strong="G2532"\w* \w os restantes|strong="G3588,G3062"\w* \w ficaram amedrontados|strong="G1719,G1096"\w* \w e|strong="G2532"\w* \w deram|strong="G1325"\w* \w glória|strong="G1391"\w* \w ao Deus|strong="G3588,G2316"\w* \w do céu|strong="G3588,G3772"\w*\f + \fr 11.13: \ft Variante: o RP traz “dia” (ἡμέρᾳ) em lugar de “hora” (ὥρᾳ).\f*\f + \fr 11.13: \ft Lit.: Ὀνόματα ἀνθρώπων, “nomes de homens”, expressão que designa “pessoas” contadas por nome.\f*.\x - \xo 11:13 \xt ISA 26:9; REV 14:7; PSA 65:8; REV 16:9; REV 6:12; JOS 7:19\x*
\v 14 \w O segundo ai|strong="G3588,G3759,G1208"\w* \w passou|strong="G565"\w*; \w olhem|strong="G2400"\w*, \w o terceiro ai|strong="G3588,G3759,G5154"\w* \w vem|strong="G2064"\w* \w depressa|strong="G5035"\w*.\x - \xo 11:14 \xt REV 9:12; REV 8:13; REV 9:1; REV 12:12; REV 15:1; DAN 12:7\x*
\p
\v 15 \w E|strong="G2532"\w* \w o sétimo|strong="G3588,G1442"\w* \w anjo|strong="G32"\w* \w tocou a trombeta|strong="G4537"\w*; \w e|strong="G2532"\w* \w houve|strong="G1096"\w* \w grandes vozes|strong="G3173,G5456"\w* \w no céu|strong="G1722,G3588,G3772"\w*, \w dizendo|strong="G3004"\w*: “\w O reino|strong="G3588,G932"\w* \w do mundo|strong="G3588,G2889"\w* \w se tornou|strong="G1096"\w* \w do nosso Senhor|strong="G3588,G2962,G3165"\w* \w e|strong="G2532"\w* \w do seu Cristo|strong="G3588,G5547,G846"\w*, \w e|strong="G2532"\w* \w reinará|strong="G936"\w* \w para os séculos|strong="G1519,G3588,G165"\w* \w dos séculos|strong="G3588,G165"\w*.”\f + \fr 11.15: \ft Lit.: Χριστός, “Ungido, Cristo”.\f*\f + \fr 11.15: \ft Variante: Treg e o RP trazem o feminino λέγουσαι (“dizendo”, concordando com “vozes”); o TR traz o plural ἐγένοντο (“se tornaram”) e “os reinos” (βασιλεῖαι) em lugar de “o reino” (βασιλεία).\f*\x - \xo 11:15 \xt REV 10:7; LUK 1:33; REV 16:17; REV 9:13; ZEC 14:9; 1CH 29:11\x*
\v 16 \w E|strong="G2532"\w* \w os vinte|strong="G3588,G1501"\w* \w e quatro|strong="G5064"\w* \w anciãos|strong="G4245"\w* \w que estão|strong="G3588"\w* \w diante de Deus|strong="G1799,G3588,G2316"\w* \w sentados|strong="G2521"\w* \w sobre os seus|strong="G1909,G3588,G846"\w* \w tronos|strong="G2362"\w*, \w caíram|strong="G4098"\w* \w sobre os seus rostos|strong="G1909,G3588,G4383,G846"\w* \w e|strong="G2532"\w* \w adoraram|strong="G4352"\w* \w a Deus|strong="G3588,G2316"\w*,\f + \fr 11.16: \ft Variante: Treg traz “os que estão sentados” (οἳ κάθηνται) em lugar de καθήμενοι; o RP traz “diante do trono de Deus” (τοῦ θρόνου τοῦ θεοῦ).\f*\f + \fr 11.16: \ft Acréscimo: “que estão”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 11:16 \xt REV 4:10; REV 19:4; REV 7:11; REV 4:4; REV 5:14; PSA 102:13\x*
\q1
\v 17 \w dizendo|strong="G3004"\w*: “\w Damos graças|strong="G2168"\w* \w a você|strong="G4771"\w*, \w Senhor|strong="G2962"\w*, \w Deus|strong="G3588,G2316"\w*, \w o Todo-Poderoso|strong="G3588,G3841"\w*, \w o que é|strong="G3588,G1510"\w* \w e|strong="G2532"\w* \w o que era|strong="G3588,G1510"\w*, \w porque|strong="G3754"\w* \w tomou|strong="G2983"\w* \w o seu grande poder|strong="G3588,G1411,G4771,G3173"\w* \w e|strong="G2532"\w* \w reinou|strong="G936"\w*.\f + \fr 11.17: \ft Lit.: Παντοκράτωρ, “Todo-Poderoso, o que tem poder sobre tudo”.\f*\f + \fr 11.17: \ft Variante: o TR acrescenta “e o que vem” (καὶ ὁ ἐρχόμενος) depois de “o que era”.\f*\x - \xo 11:17 \xt REV 19:6; REV 1:8; PSA 102:13; REV 4:8; REV 16:5; ISA 60:15\x*
\q1
\v 18 \w E|strong="G2532"\w* \w as nações|strong="G3588,G1484"\w* \w se irritaram|strong="G3710"\w*, \w e|strong="G2532"\w* \w veio|strong="G2064"\w* \w a sua ira|strong="G3588,G3709,G4771"\w*, \w e|strong="G2532"\w* \w o tempo|strong="G3588,G2540"\w* \w para os mortos|strong="G3588,G3498"\w* \w serem julgados|strong="G2919"\w* \w e|strong="G2532"\w* \w para dar|strong="G1325"\w* \w o salário|strong="G3588,G3408"\w* \w aos seus servos|strong="G3588,G1401,G4771"\w*, \w aos profetas|strong="G3588,G4396"\w* \w e|strong="G2532"\w* \w aos santos|strong="G3588,G40"\w* \w e|strong="G2532"\w* \w aos que temem|strong="G3588,G5399"\w* \w o seu nome|strong="G3588,G3686,G4771"\w*, \w os pequenos|strong="G3588,G3398"\w* \w e|strong="G2532"\w* \w os grandes|strong="G3588,G3173"\w*, \w e|strong="G2532"\w* \w para destruir|strong="G1311"\w* \w os que destroem|strong="G3588,G1311"\w* \w a terra|strong="G3588,G1093"\w*.”\f + \fr 11.18: \ft Variante: o RP traz os dativos τοῖς μικροῖς καὶ τοῖς μεγάλοις (“aos pequenos e aos grandes”).\f*\f + \fr 11.18: \ft Tradução: δούλοις (δοῦλος, G1401) está aqui como “aos seus servos”; o termo pode ser “escravo” (condição social), “servo” ou “servidor”, e o contexto decide.\f*\x - \xo 11:18 \xt REV 22:12; REV 20:12; PSA 102:13; REV 19:5; REV 14:7; REV 6:10\x*
\v 19 \w E|strong="G2532"\w* \w abriu-se|strong="G455"\w* \w o santuário|strong="G3588,G3485"\w* \w de Deus|strong="G3588,G2316"\w* \w que está|strong="G3588,G1722"\w* \w no céu|strong="G3588,G3772"\w*, \w e|strong="G2532"\w* \w foi vista|strong="G3700"\w* \w a arca|strong="G3588,G2787"\w* \w da aliança|strong="G3588,G1242"\w* \w dele|strong="G846"\w* \w no santuário|strong="G1722,G3588,G3485"\w* \w dele|strong="G846"\w*; \w e|strong="G2532"\w* \w houve|strong="G1096"\w* \w relâmpagos|strong="G796"\w* \w e|strong="G2532"\w* \w vozes|strong="G5456"\w* \w e|strong="G2532"\w* \w trovões|strong="G1027"\w* \w e|strong="G2532"\w* \w terremoto|strong="G4578"\w* \w e|strong="G2532"\w* \w granizo|strong="G5464"\w* \w grande|strong="G3173"\w*.\f + \fr 11.19: \ft Nota cultural: a arca da aliança, escondida desde a destruição do primeiro templo, aparece no santuário celeste (Êx 25:10-22; 1Rs 8:6; cf. Hb 9:4).\f*\f + \fr 11.19: \ft Variante: o RP omite “que está” (ὁ) antes de “no céu”, traz “do Senhor” (τοῦ κυρίου) em lugar de “dele” (αὐτοῦ) e omite “e terremoto” (καὶ σεισμός).\f*\f + \fr 11.19: \ft Acréscimo: “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 11:19 \xt HEB 9:4; EXO 25:10; 1KI 8:6; REV 16:18; REV 4:5; REV 8:5\x*
\c 12
\p
\v 1 \w E|strong="G2532"\w* \w um sinal|strong="G4592"\w* \w grande|strong="G3173"\w* \w apareceu|strong="G3700"\w* \w no céu|strong="G1722,G3588,G3772"\w*: \w uma mulher|strong="G1135"\w* \w vestida|strong="G4016"\w* \w do sol|strong="G3588,G2246"\w*, \w e|strong="G2532"\w* \w a lua|strong="G3588,G4582"\w* \w debaixo|strong="G5270"\w* \w dos pés|strong="G3588,G4228"\w* \w dela|strong="G846"\w*, \w e|strong="G2532"\w* \w sobre a cabeça|strong="G1909,G3588,G2776"\w* \w dela|strong="G846"\w* \w uma coroa|strong="G4735"\w* \w de doze estrelas|strong="G792,G1427"\w*,\f + \fr 12.1: \ft Lit.: Σημεῖον, “sinal”: algo visível que aponta para uma realidade maior; ὤφθη, “foi visto, apareceu”.\f*\f + \fr 12.1: \ft Nota cultural: o sol, a lua e as doze estrelas evocam o sonho de José em Gn 37:9-10; a identificação da mulher (Israel, a comunidade do Messias, ou ambos) é discutida.\f*\x - \xo 12:1 \xt GEN 37:9-10; LUK 21:25; EPH 5:32; ISA 62:3; MIC 5:3; LUK 21:11\x*
\v 2 \w e|strong="G2532"\w* \w estando grávida|strong="G1722,G1064,G2192"\w*; \w e|strong="G2532"\w* \w grita|strong="G2896"\w* \w com dores de parto|strong="G5605"\w* \w e|strong="G2532"\w* \w atormentada|strong="G928"\w* \w para dar à luz|strong="G5088"\w*.\f + \fr 12.2: \ft Variante: Treg omite “e” (καί) antes de “grita”; o RP traz o imperfeito ἔκραζεν (“gritava”).\f*\x - \xo 12:2 \xt GAL 4:27; MIC 5:3; ISA 66:7; JHN 16:21; GAL 4:19; LUK 2:6\x*
\v 3 \w E|strong="G2532"\w* \w apareceu|strong="G3700"\w* \w outro sinal|strong="G243,G4592"\w* \w no céu|strong="G1722,G3588,G3772"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w um dragão|strong="G1404"\w* \w grande|strong="G3173"\w* \w vermelho|strong="G4450"\w*, \w tendo|strong="G2192"\w* \w sete cabeças|strong="G2776,G2033"\w* \w e|strong="G2532"\w* \w dez chifres|strong="G2768,G1176"\w* \w e|strong="G2532"\w* \w sobre as cabeças|strong="G1909,G3588,G2776"\w* \w dele|strong="G846"\w* \w sete diademas|strong="G2033,G1238"\w*.\f + \fr 12.3: \ft Lit.: Δράκων, “dragão, serpente enorme”; πυρρός, “vermelho-fogo”; διάδημα, “diadema, coroa real” (distinta de στέφανος, a coroa de vencedor).\f*\x - \xo 12:3 \xt REV 13:1; REV 17:7; REV 17:3; REV 13:11; ISA 27:1; DAN 7:7\x*
\v 4 \w E|strong="G2532"\w* \w a cauda|strong="G3588,G3769"\w* \w dele|strong="G846"\w* \w arrasta|strong="G4951"\w* \w a terça parte|strong="G3588,G5154"\w* \w das estrelas|strong="G3588,G792"\w* \w do céu|strong="G3588,G3772"\w*, \w e|strong="G2532"\w* \w as lançou|strong="G906,G846"\w* \w para a terra|strong="G1519,G3588,G1093"\w*. \w E|strong="G2532"\w* \w o dragão|strong="G3588,G1404"\w* \w está de pé|strong="G2476"\w* \w diante da mulher|strong="G1799,G3588,G1135"\w* \w que está para|strong="G3588,G3195"\w* \w dar à luz|strong="G5088"\w*, \w para que|strong="G2443"\w* \w quando|strong="G3752"\w* \w der à luz|strong="G5088"\w*, \w devore|strong="G2719"\w* \w o filho|strong="G3588,G5043"\w* \w dela|strong="G846"\w*.\x - \xo 12:4 \xt REV 12:13; DAN 8:9-12; ISA 66:7; REV 12:9; REV 12:6; REV 12:7\x*
\v 5 \w E|strong="G2532"\w* \w deu à luz|strong="G5088"\w* \w um filho|strong="G5207"\w*, \w varão|strong="G730"\w*, \w o qual|strong="G3739"\w* \w há de pastorear|strong="G3195,G4165"\w* \w todas as nações|strong="G3956,G3588,G1484"\w* \w com vara|strong="G1722,G4464"\w* \w de ferro|strong="G4603"\w*; \w e|strong="G2532"\w* \w foi arrebatado|strong="G726"\w* \w o filho|strong="G3588,G5043"\w* \w dela|strong="G846"\w* \w para Deus|strong="G4314,G3588,G2316"\w* \w e|strong="G2532"\w* \w para o trono|strong="G4314,G3588,G2362"\w* \w dele|strong="G846"\w*.\f + \fr 12.5: \ft Lit.: Ἄρσεν, “macho, varão”; ποιμαίνω, “pastorear, reger como pastor”; ἁρπάζω, “arrebatar, tomar com força”.\f*\f + \fr 12.5: \ft Nota cultural: “pastorear as nações com vara de ferro” cita Sl 2:9, salmo messiânico.\f*\x - \xo 12:5 \xt PSA 2:9; REV 2:27; REV 19:15; REV 12:13; REV 2:26-27; 1TH 4:17\x*
\v 6 \w E|strong="G2532"\w* \w a mulher|strong="G3588,G1135"\w* \w fugiu|strong="G5343"\w* \w para o deserto|strong="G1519,G3588,G2048"\w*, \w onde|strong="G3699"\w* \w tem|strong="G2192"\w* \w ali|strong="G1563"\w* \w um lugar|strong="G5117"\w* \w preparado|strong="G2090"\w* \w da parte de Deus|strong="G575,G3588,G2316"\w*, \w para que|strong="G2443"\w* \w ali|strong="G1563"\w* \w a alimentem|strong="G5142,G846"\w* \w por mil duzentos e sessenta|strong="G5507,G1250,G1835"\w* \w dias|strong="G2250"\w*.\f + \fr 12.6: \ft Variante: o RP traz “por Deus” (ὑπό) em lugar de “da parte de Deus” (ἀπό) e a forma ἐκτρέφωσιν (“criem”) em lugar de τρέφωσιν.\f*\x - \xo 12:6 \xt REV 11:3; REV 12:14; DAN 7:25; REV 11:2; REV 13:5; HOS 2:14\x*
\p
\v 7 \w E|strong="G2532"\w* \w houve|strong="G1096"\w* \w guerra|strong="G4171"\w* \w no céu|strong="G1722,G3588,G3772"\w*: \w Miguel|strong="G3588,G3413"\w* \w e|strong="G2532"\w* \w os seus anjos|strong="G3588,G32,G846"\w* \add saíram\add* \w para guerrear|strong="G3588,G4170"\w* \w contra o dragão|strong="G3326,G3588,G1404"\w*. \w E|strong="G2532"\w* \w o dragão|strong="G3588,G1404"\w* \w guerreou|strong="G4170"\w*, \w e|strong="G2532"\w* \add também\add* \w os seus anjos|strong="G3588,G32,G846"\w*,\f + \fr 12.7: \ft Lit.: o infinitivo articular τοῦ πολεμῆσαι expressa propósito (“para guerrear”); a tradução acrescenta “saíram” para completar a frase.\f*\f + \fr 12.7: \ft Variante: o RP omite o artigo τοῦ antes de πολεμῆσαι.\f*\f + \fr 12.7: \ft Acréscimo: “saíram” (em “seus anjos saíram para guerrear”): verbo acrescentado: o grego traz a frase sem verbo (construção nominal ou elíptica) e o português exige um, tomado do contexto; “também” (em “guerreou e também os seus”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 12:7 \xt LUK 10:18; GEN 3:15; ISA 14:12; JUD 1:9; DAN 12:1; 2PE 2:4\x*
\v 8 \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w prevaleceu|strong="G2480"\w*, \w nem|strong="G3761"\w* \w se achou|strong="G2147"\w* \w lugar|strong="G5117"\w* \w para eles|strong="G846"\w* \w mais|strong="G2089"\w* \w no céu|strong="G1722,G3588,G3772"\w*.\f + \fr 12.8: \ft Variante: Treg traz o plural ἴσχυσαν (“prevaleceram”); o RP traz “para ele” (αὐτῷ) em lugar de “para eles” (αὐτῶν).\f*\x - \xo 12:8 \xt LUK 10:18; GEN 3:15; ISA 14:12; 2PE 2:4; PSA 129:2; MRK 3:27\x*
\v 9 \w E|strong="G2532"\w* \w foi lançado|strong="G906"\w* \w o grande dragão|strong="G3588,G1404,G3173"\w*, \w a antiga serpente|strong="G3588,G3789,G744"\w*, \w o chamado Diabo|strong="G3588,G2564,G1228"\w* \w e|strong="G2532"\w* \w Satanás|strong="G3588,G4567"\w*, \w o que engana|strong="G3588,G4105"\w* \w o mundo habitado|strong="G3588,G3625"\w* \w todo|strong="G3650"\w* — \w foi lançado|strong="G906"\w* \w para a terra|strong="G1519,G3588,G1093"\w*, \w e|strong="G2532"\w* \w os anjos|strong="G3588,G32"\w* \w dele|strong="G846"\w* \w com ele|strong="G3326,G846"\w* \w foram lançados|strong="G906"\w*.\f + \fr 12.9: \ft Lit.: Διάβολος, “caluniador, acusador”; Σατανᾶς vem do hebraico, “adversário”; οἰκουμένη, “mundo habitado”.\f*\f + \fr 12.9: \ft Nota cultural: “a antiga serpente” remete à serpente de Gn 3:1-5.\f*\x - \xo 12:9 \xt GEN 3:1; REV 20:2; ROM 12:2; LUK 10:18; 1PE 5:8; GEN 3:15\x*
\q1
\v 10 \w E|strong="G2532"\w* \w ouvi|strong="G191"\w* \w uma grande|strong="G3173"\w* \w voz|strong="G5456"\w* \w no céu|strong="G1722,G3588,G3772"\w* \w dizendo|strong="G3004"\w*: “\w Agora|strong="G737"\w* \w veio|strong="G1096"\w* \w a salvação|strong="G3588,G4991"\w* \w e|strong="G2532"\w* \w o poder|strong="G3588,G1411"\w* \w e|strong="G2532"\w* \w o reino|strong="G3588,G932"\w* \w do nosso Deus|strong="G3588,G2316,G3165"\w* \w e|strong="G2532"\w* \w a autoridade|strong="G3588,G1849"\w* \w do seu Cristo|strong="G3588,G5547,G846"\w*, \w porque|strong="G3754"\w* \w foi lançado|strong="G906"\w* \w o acusador|strong="G3588,G6051"\w* \w dos nossos irmãos e irmãs|strong="G3588,G80,G3165"\w*, \w o que os acusa|strong="G3588,G2723,G846"\w* \w diante do nosso Deus|strong="G1799,G3588,G2316,G3165"\w* \w de dia|strong="G2250"\w* \w e|strong="G2532"\w* \w de noite|strong="G3571"\w*\f + \fr 12.10: \ft Variante: WH e NA28 trazem a forma rara κατήγωρ; Treg e o RP trazem κατήγορος (“acusador”); Treg e o RP trazem “acusa-os” no genitivo αὐτῶν.\f*\f + \fr 12.10: \ft Lit.: Κατήγωρ, “acusador” (de κατηγορέω, “acusar diante de um tribunal”), correspondente ao hebraico śāṭān.\f*.\x - \xo 12:10 \xt REV 19:1; ISA 54:17; GEN 3:15; ROM 8:33; ISA 14:12; REV 11:15\x*
\q1
\v 11 \w E|strong="G2532"\w* \w eles|strong="G846"\w* \w o venceram|strong="G3528,G846"\w* \w por causa do sangue|strong="G1223,G3588,G129"\w* \w do cordeiro|strong="G3588,G721"\w* \w e|strong="G2532"\w* \w por causa da palavra|strong="G1223,G3588,G3056"\w* \w do testemunho|strong="G3588,G3141"\w* \w deles|strong="G846"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w amaram|strong="G25"\w* \w a sua vida|strong="G3588,G5590,G846"\w* \w até a morte|strong="G891,G2288"\w*.\x - \xo 12:11 \xt REV 2:26; 2CO 10:3-5; JHN 16:33; 1JN 4:4; 1JN 5:5; REV 7:14\x*
\q1
\v 12 \w Por isso|strong="G1223,G3778"\w* \w alegrem-se|strong="G2165"\w*, \w ó céus|strong="G3588,G3772"\w*, \w e|strong="G2532"\w* \w vocês que neles habitam|strong="G3588,G1722,G846,G4637"\w*. \w Ai|strong="G3759"\w* \w da terra|strong="G3588,G1093"\w* \w e|strong="G2532"\w* \w do mar|strong="G3588,G2281"\w*, \w porque|strong="G3754"\w* \w desceu|strong="G2597"\w* \w o diabo|strong="G3588,G1228"\w* \w até vocês|strong="G4314,G4771"\w*, \w tendo|strong="G2192"\w* \w grande furor|strong="G2372,G3173"\w*, \w sabendo|strong="G6063"\w* \w que|strong="G3754"\w* \w pouco tempo|strong="G3641,G2540"\w* \w tem|strong="G2192"\w*.”\f + \fr 12.12: \ft Lit.: Θυμός, “furor, ardor” (distinto de ὀργή, “ira”); σκηνόω, “habitar em tenda, morar”.\f*\f + \fr 12.12: \ft Variante: o TR acrescenta “aos que habitam” (τοῖς κατοικοῦσιν) depois de “ai”; o RP traz os dativos τῇ γῇ καὶ τῇ θαλάσσῃ (“à terra e ao mar”); NA28 traz o artigo οἱ antes de “céus”.\f*\x - \xo 12:12 \xt 1PE 5:8; GEN 3:15; ISA 49:13; PSA 96:11; REV 18:20; REV 8:13\x*
\p
\v 13 \w E|strong="G2532"\w* \w quando|strong="G3753"\w* \w o dragão|strong="G3588,G1404"\w* \w viu|strong="G1492"\w* \w que|strong="G3754"\w* \w foi lançado|strong="G906"\w* \w para a terra|strong="G1519,G3588,G1093"\w*, \w perseguiu|strong="G1377"\w* \w a mulher|strong="G3588,G1135"\w* \w que deu à luz|strong="G3748,G5088"\w* \w o varão|strong="G3588,G730"\w*.\x - \xo 12:13 \xt GEN 3:15; REV 6:9; JOB 1:7; REV 16:13; ISA 54:11; REV 13:2\x*
\v 14 \w E|strong="G2532"\w* \w foram dadas|strong="G1325"\w* \w à mulher|strong="G3588,G1135"\w* \w as duas|strong="G3588,G1417"\w* \w asas|strong="G4420"\w* \w da grande águia|strong="G3588,G105,G3173"\w*, \w para que|strong="G2443"\w* \w voe|strong="G4072"\w* \w para o deserto|strong="G1519,G3588,G2048"\w*, \w para o seu lugar|strong="G1519,G3588,G5117,G846"\w*, \w onde|strong="G3699"\w* \w é alimentada|strong="G5142"\w* \w ali|strong="G1563"\w* \w por um tempo|strong="G2540"\w* \w e|strong="G2532"\w* \w tempos|strong="G2540"\w* \w e|strong="G2532"\w* \w metade de um tempo|strong="G2255,G2540"\w*, \w longe da face|strong="G575,G4383"\w* \w da serpente|strong="G3588,G3789"\w*.\f + \fr 12.14: \ft Nota cultural: “um tempo, tempos e metade de um tempo” ecoa Dn 7:25 e 12:7 e equivale aos 1.260 dias do v. 6 (três anos e meio).\f*\f + \fr 12.14: \ft Variante: o RP traz ὅπως τρέφηται (“para que seja alimentada”) em lugar de ὅπου τρέφεται (“onde é alimentada”) e omite o artigo αἱ antes de “duas”.\f*\x - \xo 12:14 \xt DAN 7:25; DAN 12:7; REV 12:6; EXO 19:4; ISA 40:31; PSA 55:6\x*
\v 15 \w E|strong="G2532"\w* \w a serpente|strong="G3588,G3789"\w* \w lançou|strong="G906"\w* \w da sua boca|strong="G1537,G3588,G4750,G846"\w*, \w atrás da mulher|strong="G3694,G3588,G1135"\w*, \w água|strong="G5204"\w* \w como um rio|strong="G5613,G4215"\w*, \w para que|strong="G2443"\w* \w a fizesse|strong="G846,G4160"\w* \w arrastada pela correnteza|strong="G4216"\w*.\x - \xo 12:15 \xt ISA 59:19; REV 6:9; ISA 8:7; JOB 1:7; PSA 18:4; PSA 69:15\x*
\v 16 \w E|strong="G2532"\w* \w a terra|strong="G3588,G1093"\w* \w ajudou|strong="G997"\w* \w a mulher|strong="G3588,G1135"\w*, \w e|strong="G2532"\w* \w a terra|strong="G3588,G1093"\w* \w abriu|strong="G455"\w* \w a sua boca|strong="G3588,G4750,G846"\w* \w e|strong="G2532"\w* \w engoliu|strong="G2666"\w* \w o rio|strong="G3588,G4215"\w* \w que|strong="G3739"\w* \w o dragão|strong="G3588,G1404"\w* \w lançou|strong="G906"\w* \w da sua boca|strong="G1537,G3588,G4750,G846"\w*;\x - \xo 12:16 \xt ISA 59:19; REV 6:9; JOB 1:7; PSA 69:15; ISA 54:11; NUM 16:32\x*
\v 17 \w e|strong="G2532"\w* \w o dragão|strong="G3588,G1404"\w* \w se irou|strong="G3710"\w* \w contra a mulher|strong="G1909,G3588,G1135"\w*, \w e|strong="G2532"\w* \w foi|strong="G565"\w* \w fazer guerra|strong="G4160,G4171"\w* \w contra os restantes|strong="G3326,G3588,G3062"\w* \w da descendência|strong="G3588,G4690"\w* \w dela|strong="G846"\w*, \w os que guardam|strong="G3588,G5083"\w* \w os mandamentos|strong="G3588,G1785"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w têm|strong="G2192"\w* \w o testemunho|strong="G3588,G3141"\w* \w de Jesus|strong="G2424"\w*.\f + \fr 12.17: \ft Lit.: Σπέρμα, “semente, descendência”.\f*\f + \fr 12.17: \ft Variante: o TR acrescenta “Cristo” (Χριστοῦ) depois de “Jesus”.\f*\x - \xo 12:17 \xt 1JN 2:3; GEN 3:15; REV 14:12; ISA 59:19; REV 1:2; REV 19:10\x*
\v 18 \w E|strong="G2532"\w* \w ficou de pé|strong="G2476"\w* \w sobre a areia|strong="G1909,G3588,G285"\w* \w do mar|strong="G3588,G2281"\w*.\f + \fr 12.18: \ft Lit.: no texto grego do SBLGNT este versículo termina o cap. 12; em outras edições é o v. 1 do cap. 13.\f*\f + \fr 12.18: \ft Variante: o TR e o RP trazem ἐστάθην (“eu fiquei de pé”), ligando o verbo ao vidente (“e eu fiquei de pé sobre a areia do mar”), em lugar de ἐστάθη (“ele ficou de pé”, o dragão).\f*\x - \xo 12:18 \xt ROM 9:27; REV 20:8; HEB 11:12\x*
\c 13
\p
\v 1 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w subindo|strong="G305"\w* \w do mar|strong="G1537,G3588,G2281"\w* \w uma fera|strong="G2342"\w*, \w tendo|strong="G2192"\w* \w dez chifres|strong="G2768,G1176"\w* \w e|strong="G2532"\w* \w sete cabeças|strong="G2776,G2033"\w*, \w e|strong="G2532"\w* \w sobre os chifres|strong="G1909,G3588,G2768"\w* \w dela|strong="G846"\w* \w dez diademas|strong="G1176,G1238"\w*, \w e|strong="G2532"\w* \w sobre as cabeças|strong="G1909,G3588,G2776"\w* \w dela|strong="G846"\w* \w nomes|strong="G3686"\w* \w de blasfêmia|strong="G988"\w*.\f + \fr 13.1: \ft Nota cultural: a fera com dez chifres e sete cabeças retoma a quarta fera de Dn 7:7 e o dragão de 12:3.\f*\f + \fr 13.1: \ft Variante: o TR traz “nome” (ὄνομα, singular) em lugar de “nomes” (ὀνόματα).\f*\x - \xo 13:1 \xt DAN 7:7; REV 12:3; REV 17:3; REV 17:7; REV 17:12; REV 17:16\x*
\v 2 \w E|strong="G2532"\w* \w a fera|strong="G3588,G2342"\w* \w que|strong="G3739"\w* \w vi|strong="G1492"\w* \w era semelhante|strong="G1510,G3664"\w* \w a um leopardo|strong="G3917"\w*, \w e|strong="G2532"\w* \w os pés|strong="G3588,G4228"\w* \w dela|strong="G846"\w* \w como os de urso|strong="G5613,G715"\w*, \w e|strong="G2532"\w* \w a boca|strong="G3588,G4750"\w* \w dela|strong="G846"\w* \w como boca|strong="G5613,G4750"\w* \w de leão|strong="G3023"\w*. \w E|strong="G2532"\w* \w o dragão|strong="G3588,G1404"\w* \w deu|strong="G1325"\w* \w a ela|strong="G846"\w* \w o seu poder|strong="G3588,G1411,G846"\w* \w e|strong="G2532"\w* \w o seu trono|strong="G3588,G2362,G846"\w* \w e|strong="G2532"\w* \w grande autoridade|strong="G1849,G3173"\w*.\f + \fr 13.2: \ft Nota cultural: leopardo, urso e leão ecoam as três primeiras feras de Dn 7:4-6.\f*\x - \xo 13:2 \xt DAN 7:4-6; REV 13:4; REV 16:13; DAN 7:4-7; DAN 7:6; REV 17:3\x*
\v 3 \w E|strong="G2532"\w* \w uma|strong="G1520"\w* \w das cabeças|strong="G1537,G3588,G2776"\w* \w dela|strong="G846"\w* \w como que ferida|strong="G5613,G4969"\w* \w de morte|strong="G1519,G2288"\w*, \w e|strong="G2532"\w* \w a ferida|strong="G3588,G4127"\w* \w mortal|strong="G3588,G2288"\w* \w dela|strong="G846"\w* \w foi curada|strong="G2323"\w*. \w E|strong="G2532"\w* \w se maravilhou|strong="G2296"\w* \w toda a terra|strong="G3650,G3588,G1093"\w* \w seguindo|strong="G3694"\w* \w a fera|strong="G3588,G2342"\w*,\f + \fr 13.3: \ft Lit.: Ἐσφαγμένην, “imolada, degolada”: o mesmo verbo descreve o cordeiro em 5:6; θεραπεύω, “curar”.\f*\f + \fr 13.3: \ft Variante: o TR acrescenta “e vi” (εἶδον) no começo; o RP traz ὡσεί em lugar de ὡς e ἐθαύμασεν (“admirou-se”) em lugar de ἐθαυμάσθη.\f*\x - \xo 13:3 \xt REV 13:12; PSA 37:7; REV 13:8; LUK 6:26; REV 17:8; REV 17:3\x*
\v 4 \w e|strong="G2532"\w* \w adoraram|strong="G4352"\w* \w o dragão|strong="G3588,G1404"\w*, \w porque|strong="G3754"\w* \w deu|strong="G1325"\w* \w a autoridade|strong="G3588,G1849"\w* \w à fera|strong="G3588,G2342"\w*, \w e|strong="G2532"\w* \w adoraram|strong="G4352"\w* \w a fera|strong="G3588,G2342"\w*, \w dizendo|strong="G3004"\w*: “\w Quem|strong="G5101"\w* \w é semelhante|strong="G3664"\w* \w à fera|strong="G3588,G2342"\w*, \w e|strong="G2532"\w* \w quem|strong="G5101"\w* \w pode|strong="G1410"\w* \w guerrear|strong="G4170"\w* \w contra ela|strong="G3326,G846"\w*?”\f + \fr 13.4: \ft Nota cultural: “Quem é semelhante à fera?” imita a pergunta de Êx 15:11 e Sl 35:10, que se faz a respeito do Senhor.\f*\f + \fr 13.4: \ft Variante: o RP traz “ao que deu” (τῷ δεδωκότι) em lugar de “porque deu” (ὅτι ἔδωκεν).\f*\f + \fr 13.4: \ft Acréscimo: verbo ser/estar suprido em “é semelhante”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:4 \xt EXO 15:11; PSA 35:10; REV 13:2; REV 16:13; REV 13:12; REV 13:15\x*
\v 5 \w E|strong="G2532"\w* \w foi dada|strong="G1325"\w* \w a ela|strong="G846"\w* \w uma boca|strong="G4750"\w* \w que falava|strong="G2980"\w* \w coisas grandes|strong="G3173"\w* \w e|strong="G2532"\w* \w blasfêmias|strong="G988"\w*, \w e|strong="G2532"\w* \w foi dada|strong="G1325"\w* \w a ela|strong="G846"\w* \w autoridade|strong="G1849"\w* \w para agir|strong="G4160"\w* \w por quarenta e dois|strong="G5062,G1417"\w* \w meses|strong="G3376"\w*.\f + \fr 13.5: \ft Variante: alguns manuscritos bizantinos acrescentam “guerra” (πόλεμον) depois de “autoridade”; WH, NA28 e o RP trazem “e” (καί) entre “quarenta” e “dois”.\f*\x - \xo 13:5 \xt REV 11:2; DAN 7:25; PSA 37:7; REV 12:6; DAN 11:36; DAN 7:8\x*
\v 6 \w E|strong="G2532"\w* \w abriu|strong="G455"\w* \w a sua boca|strong="G3588,G4750,G846"\w* \w em blasfêmias|strong="G1519,G988"\w* \w contra Deus|strong="G4314,G3588,G2316"\w*, \w para blasfemar|strong="G987"\w* \w o seu nome|strong="G3588,G3686,G846"\w* \w e|strong="G2532"\w* \w a sua tenda|strong="G3588,G4633,G846"\w*, \w os que habitam|strong="G3588,G4637"\w* \w no céu|strong="G1722,G3588,G3772"\w*.\x - \xo 13:6 \xt JAS 2:7; DAN 7:25; PSA 37:7; 2TH 2:4; DAN 11:36; EZK 9:4\x*
\v 7 \w E|strong="G2532"\w* \w foi dado|strong="G1325"\w* \w a ela|strong="G846"\w* \w fazer guerra|strong="G4160,G4171"\w* \w contra os santos|strong="G3326,G3588,G40"\w* \w e|strong="G2532"\w* \w vencê-los|strong="G3528,G846"\w*, \w e|strong="G2532"\w* \w foi dada|strong="G1325"\w* \w a ela|strong="G846"\w* \w autoridade|strong="G1849"\w* \w sobre toda|strong="G1909,G3956"\w* \w tribo|strong="G5443"\w* \w e|strong="G2532"\w* \w povo|strong="G2992"\w* \w e|strong="G2532"\w* \w língua|strong="G1100"\w* \w e|strong="G2532"\w* \w nação|strong="G1484"\w*.\f + \fr 13.7: \ft Nota cultural: guerra contra os santos e vitória sobre eles retomam Dn 7:21.\f*\f + \fr 13.7: \ft Variante: o TR omite “e povo” (καὶ λαόν).\f*\x - \xo 13:7 \xt DAN 7:21; REV 11:7; REV 14:6; REV 10:11; REV 17:15; REV 5:9\x*
\v 8 \w E|strong="G2532"\w* \w o adorarão|strong="G4352,G846"\w* \w todos|strong="G3956"\w* \w os que habitam|strong="G3588,G2730"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*, \w aqueles cujo nome|strong="G3739,G3588,G3686,G846"\w* \w não|strong="G3756"\w* \w foi escrito|strong="G1125"\w* \w no livro|strong="G1722,G3588,G975"\w* \w da vida|strong="G3588,G2222"\w* \w do cordeiro|strong="G3588,G721"\w* \w que foi morto|strong="G3588,G4969"\w* \w desde a fundação|strong="G575,G2602"\w* \w do mundo|strong="G2889"\w*\f + \fr 13.8: \ft Variante: o RP traz “o adorarão” no dativo (αὐτῷ), “cujos” no plural (ὧν) e omite “dele” (αὐτοῦ).\f*\f + \fr 13.8: \ft Lit.: o singular οὗ (“cujo”) é distributivo; a expressão “desde a fundação do mundo” pode ligar-se a “escrito” (cf. 17:8) ou a “imolado”, e a tradução mantém a ambiguidade.\f*.\x - \xo 13:8 \xt REV 17:8; REV 21:27; 1PE 1:19-20; EPH 1:4; ROM 8:29; MAT 25:34\x*
\v 9 \w Se alguém|strong="G1487,G5100"\w* \w tem|strong="G2192"\w* \w ouvido|strong="G3775"\w*, \w ouça|strong="G191"\w*.\x - \xo 13:9 \xt REV 2:7; DAN 7:25; PSA 37:7; 1CO 15:33; REV 2:11; DAN 7:21\x*
\v 10 \w Se alguém|strong="G1487,G5100"\w* \add está destinado\add* \w ao cativeiro|strong="G1519,G161"\w*, \w ao cativeiro|strong="G1519,G161"\w* \w irá|strong="G5217"\w*; \w se alguém|strong="G1487,G5100"\w* \add está para\add* \w ser morto|strong="G615"\w* \w à espada|strong="G1722,G3162"\w*, \w à espada|strong="G1722,G3162"\w* \w ele deve|strong="G846"\w* \w ser morto|strong="G615"\w*. \w Aqui|strong="G5602"\w* \w está|strong="G1510"\w* \w a perseverança|strong="G3588,G5281"\w* \w e|strong="G2532"\w* \w a fé|strong="G3588,G4102"\w* \w dos santos|strong="G3588,G40"\w*\f + \fr 13.10: \ft Variante: o RP traz “se alguém tem cativeiro” (ἔχει αἰχμαλωσίαν) e o TR “se alguém reúne cativos” (συνάγει αἰχμαλωσίαν) em lugar da primeira oração; Treg traz “para o cativeiro” uma só vez; WH, Treg e o RP trazem “se alguém matar à espada, é preciso que ele seja morto à espada” (ἀποκτενεῖ δεῖ).\f*\f + \fr 13.10: \ft Nota cultural: a sentença ecoa Jr 15:2 (o destino de cada um: morte, espada, fome ou cativeiro).\f*\f + \fr 13.10: \ft Lit.: o texto do SBLGNT é elíptico e a tradução acrescenta verbos para completar o sentido; πίστις pode significar “fé” ou “fidelidade”; ὑπομονή, “perseverança, firmeza sob pressão”.\f*.\f + \fr 13.10: \ft Acréscimo: “está” (em “Se alguém está destinado ao”), “está” (em “se alguém está para ser”): o grego não traz verbo aqui; o verbo ser/estar está subentendido e o português o exige; “destinado” (em “alguém está destinado ao cativeiro”): palavra acrescentada para completar o sentido em português; não corresponde a nenhuma palavra grega neste ponto; “para” (em “alguém está para ser morto”): preposição ou artigo que a regência do português exige.\f*\x - \xo 13:10 \xt JER 15:2; REV 14:12; DAN 7:25; MAT 26:52; HEB 12:1; GEN 9:6\x*
\p
\v 11 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w outra fera|strong="G243,G2342"\w* \w subindo|strong="G305"\w* \w da terra|strong="G1537,G3588,G1093"\w*, \w e|strong="G2532"\w* \w tinha|strong="G2192"\w* \w dois chifres|strong="G2768,G1417"\w* \w semelhantes|strong="G3664"\w* \w a um cordeiro|strong="G721"\w*, \w e|strong="G2532"\w* \w falava|strong="G2980"\w* \w como dragão|strong="G5613,G1404"\w*.\x - \xo 13:11 \xt REV 16:13; REV 12:3; DAN 7:25; EPH 6:11; DAN 8:23; 1CO 15:33\x*
\v 12 \w E|strong="G2532"\w* \w toda a autoridade|strong="G3588,G1849,G3956"\w* \w da primeira fera|strong="G3588,G4413,G2342"\w* \w exerce|strong="G4160"\w* \w diante dela|strong="G1799,G846"\w*. \w E|strong="G2532"\w* \w faz|strong="G4160"\w* \w a terra|strong="G3588,G1093"\w* \w e|strong="G2532"\w* \w os que nela habitam|strong="G3588,G1722,G846,G2730"\w* \w adorar|strong="G2443,G4352"\w* \w a primeira fera|strong="G3588,G2342,G4413"\w*, \w cuja ferida mortal|strong="G3739,G3588,G4127,G2288,G846"\w* \w foi curada|strong="G2323"\w*.\f + \fr 13.12: \ft Variante: o RP traz o imperfeito ἐποίει (“fazia”) em lugar de ποιεῖ e o subjuntivo προσκυνήσωσιν.\f*\x - \xo 13:12 \xt REV 13:14; REV 13:3; REV 13:4; EPH 6:11; DAN 8:23; 1CO 15:33\x*
\v 13 \w E|strong="G2532"\w* \w faz|strong="G4160"\w* \w grandes|strong="G3173"\w* \w sinais|strong="G4592"\w*, \w de modo que|strong="G2443"\w* \w até|strong="G2532"\w* \w fogo|strong="G4442"\w* \w faça|strong="G4160"\w* \w descer|strong="G2597"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w para a terra|strong="G1519,G3588,G1093"\w* \w diante dos seres humanos|strong="G1799,G3588,G444"\w*.\x - \xo 13:13 \xt REV 20:9; MAT 24:24; EPH 6:11; DAN 8:23; 1CO 15:33; 2TH 2:3\x*
\v 14 \w E|strong="G2532"\w* \w engana|strong="G4105"\w* \w os que habitam|strong="G3588,G2730"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w por causa dos sinais|strong="G1223,G3588,G4592"\w* \w que|strong="G3739"\w* \w lhe foi dado|strong="G1325,G846"\w* \w fazer|strong="G4160"\w* \w diante da fera|strong="G1799,G3588,G2342"\w*, \w dizendo|strong="G3004"\w* \w aos que habitam|strong="G3588,G2730"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w que façam|strong="G4160"\w* \w uma imagem|strong="G1504"\w* \w à fera|strong="G3588,G2342"\w* \w que tem|strong="G3739,G2192"\w* \w a ferida|strong="G3588,G4127"\w* \w da espada|strong="G3588,G3162"\w* \w e|strong="G2532"\w* \w tornou a viver|strong="G2198"\w*\f + \fr 13.14: \ft Variante: o RP acrescenta “os meus” (ἐμοὺς τοὺς) depois de “engana”, traz “que tinha” (ὃ εἶχεν) em lugar de “que tem” (ὃς ἔχει) e escreve “e viveu depois da espada” em ordem diferente.\f*\f + \fr 13.14: \ft Lit.: Εἰκών, “imagem, estátua”.\f*.\x - \xo 13:14 \xt REV 13:12; REV 19:20; MAT 24:24; EPH 6:11; DAN 8:23; 1CO 15:33\x*
\v 15 \w E|strong="G2532"\w* \w foi dado|strong="G1325"\w* \w a ela|strong="G846"\w* \w dar|strong="G1325"\w* \w fôlego|strong="G4151"\w* \w à imagem|strong="G3588,G1504"\w* \w da fera|strong="G3588,G2342"\w*, \w para que|strong="G2443"\w* \w também|strong="G2532"\w* \w fale|strong="G2980"\w* \w a imagem|strong="G3588,G1504"\w* \w da fera|strong="G3588,G2342"\w* \w e|strong="G2532"\w* \w faça|strong="G4160"\w* \w que|strong="G2443"\w* \w todos quantos|strong="G3745,G1437"\w* \w não|strong="G3361"\w* \w adorarem|strong="G4352"\w* \w a imagem|strong="G3588,G1504"\w* \w da fera|strong="G3588,G2342"\w* \w sejam mortos|strong="G615"\w*.\f + \fr 13.15: \ft Lit.: Πνεῦμα, “espírito, sopro, fôlego”: aqui o sopro vital que anima a imagem.\f*\f + \fr 13.15: \ft Variante: WH traz o feminino αὐτῇ (“a ela”) em lugar de αὐτῷ; o RP traz a ordem “fôlego dar” (πνεῦμα δοῦναι) e omite o segundo ἵνα.\f*\x - \xo 13:15 \xt REV 14:9; REV 16:2; REV 14:11; REV 20:4; REV 19:20; REV 13:4\x*
\v 16 \w E|strong="G2532"\w* \w faz|strong="G4160"\w* \w todos|strong="G3956"\w*, \w os pequenos|strong="G3588,G3398"\w* \w e|strong="G2532"\w* \w os grandes|strong="G3588,G3173"\w*, \w e|strong="G2532"\w* \w os ricos|strong="G3588,G4145"\w* \w e|strong="G2532"\w* \w os pobres|strong="G3588,G4434"\w*, \w e|strong="G2532"\w* \w os livres|strong="G3588,G1658"\w* \w e|strong="G2532"\w* \w os escravos|strong="G3588,G1401"\w*, \w para que|strong="G2443"\w* \w lhes deem|strong="G1325,G846"\w* \w uma marca|strong="G5480"\w* \w sobre a mão direita|strong="G1909,G3588,G5495,G1188"\w* \w deles|strong="G846"\w* \w ou|strong="G2228"\w* \w sobre a testa|strong="G1909,G3588,G3359"\w* \w deles|strong="G846"\w*,\f + \fr 13.16: \ft Lit.: Χάραγμα, “marca gravada, sinal impresso” (usado para carimbos e selos oficiais).\f*\f + \fr 13.16: \ft Variante: o RP traz o subjuntivo δώσωσιν e o plural χαράγματα (“marcas”); o TR traz “testas” (μετώπων, plural).\f*\x - \xo 13:16 \xt REV 14:9; REV 19:18; REV 20:4; REV 19:20; REV 2:10; REV 7:3\x*
\v 17 \w e|strong="G2532"\w* \w que ninguém|strong="G2443,G3361,G5100"\w* \w possa|strong="G1410"\w* \w comprar|strong="G59"\w* \w ou|strong="G2228"\w* \w vender|strong="G4453"\w*, \w a não ser|strong="G1487,G3361"\w* \w o que tem|strong="G3588,G2192"\w* \w a marca|strong="G3588,G5480"\w*, \w o nome|strong="G3588,G3686"\w* \w da fera|strong="G3588,G2342"\w* \w ou|strong="G2228"\w* \w o número|strong="G3588,G706"\w* \w do nome|strong="G3588,G3686"\w* \w dela|strong="G846"\w*.\f + \fr 13.17: \ft Variante: o TR acrescenta “ou” (ἤ) antes de “o nome da fera”; o RP traz δύναται em lugar do subjuntivo δύνηται.\f*\x - \xo 13:17 \xt REV 14:11; REV 14:9; REV 2:10; 2TH 2:3; MAT 7:15; REV 13:16\x*
\v 18 \w Aqui|strong="G5602"\w* \w está a sabedoria|strong="G3588,G4678,G1510"\w*: \w quem tem|strong="G3588,G2192"\w* \w entendimento|strong="G3563"\w* \w calcule|strong="G5585"\w* \w o número|strong="G3588,G706"\w* \w da fera|strong="G3588,G2342"\w*, \w pois|strong="G1063"\w* \w é número|strong="G706,G1510"\w* \w de ser humano|strong="G444"\w*; \w e|strong="G2532"\w* \w o número|strong="G3588,G706"\w* \w dele|strong="G846"\w* \w é seiscentos e sessenta e seis|strong="G1812,G1835,G1803"\w*.\f + \fr 13.18: \ft Lit.: Ψηφίζω, “calcular” (originalmente, contar com pedrinhas); a numeração de letras gregas e hebraicas servia para somar valores de nomes.\f*\f + \fr 13.18: \ft Variante: Treg escreve o número com letras numéricas (χξϛʹ); o RP traz o neutro ἑξακόσια (“seiscentos”); Treg e o RP acrescentam “é” (ἐστίν) depois de “dele”; o TR acrescenta o artigo τὸν antes de “entendimento” (νοῦν); alguns manuscritos antigos, entre eles o papiro 𝔓115 e o Códice Efraemi (C), trazem 616 em lugar de 666 (essa variante vem do aparato crítico das edições impressas, e não do TAGNT usado aqui).\f*\f + \fr 13.18: \ft Acréscimo: verbo ser/estar suprido em “é seiscentos e sessenta e seis”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 13:18 \xt REV 15:2; 2TH 2:3; REV 17:9; REV 21:17; DAN 12:10; LUK 17:1\x*
\c 14
\p
\v 1 \w E|strong="G2532"\w* \w vi|strong="G1492"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w o cordeiro|strong="G3588,G721"\w* \w de pé|strong="G2476"\w* \w sobre o monte|strong="G1909,G3588,G3735"\w* \w Sião|strong="G4622"\w*, \w e|strong="G2532"\w* \w com ele|strong="G3326,G846"\w* \w cento e quarenta e quatro|strong="G1540,G5062,G5064"\w* \w mil|strong="G5505"\w*, \w tendo|strong="G2192"\w* \w o nome|strong="G3588,G3686"\w* \w dele|strong="G846"\w* \w e|strong="G2532"\w* \w o nome|strong="G3588,G3686"\w* \w do Pai|strong="G3588,G3962"\w* \w dele|strong="G846"\w* \w escrito|strong="G1125"\w* \w sobre as testas|strong="G1909,G3588,G3359"\w* \w deles|strong="G846"\w*\f + \fr 14.1: \ft Variante: o RP traz ἑστηκός (“de pé”) em lugar de ἑστός e acrescenta “número” (ἀριθμός) depois de “com ele”.\f*.\x - \xo 14:1 \xt REV 7:4; REV 22:4; REV 14:3; EZK 9:4; JHN 1:29; JOL 2:32\x*
\v 2 \w E|strong="G2532"\w* \w ouvi|strong="G191"\w* \w uma voz|strong="G5456"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w como voz|strong="G5613,G5456"\w* \w de muitas|strong="G4183"\w* \w águas|strong="G5204"\w* \w e|strong="G2532"\w* \w como voz|strong="G5613,G5456"\w* \w de um grande|strong="G3173"\w* \w trovão|strong="G1027"\w*, \w e|strong="G2532"\w* \w a voz|strong="G3588,G5456"\w* \w que|strong="G3739"\w* \w ouvi|strong="G191"\w* \w era como a de|strong="G5613"\w* \w harpistas|strong="G2790"\w* \w que tocam|strong="G2789"\w* \w em suas harpas|strong="G1722,G3588,G2788,G846"\w*.\f + \fr 14.2: \ft Variante: o TR omite “como” (ὡς) antes de “harpistas”.\f*\f + \fr 14.2: \ft Acréscimo: verbo ser/estar suprido em “era como a de”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 14:2 \xt REV 1:15; REV 12:11; REV 5:8; PSA 87:7; REV 17:14; REV 19:6\x*
\v 3 \w E|strong="G2532"\w* \w cantam|strong="G103"\w* \w como que|strong="G5613"\w* \w um cântico|strong="G5603"\w* \w novo|strong="G2537"\w* \w diante do trono|strong="G1799,G3588,G2362"\w* \w e|strong="G2532"\w* \w diante dos quatro|strong="G1799,G3588,G5064"\w* \w seres vivos|strong="G2226"\w* \w e|strong="G2532"\w* \w dos anciãos|strong="G3588,G4245"\w*; \w e|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w podia|strong="G1410"\w* \w aprender|strong="G3129"\w* \w o cântico|strong="G3588,G5603"\w* \w a não ser|strong="G1487,G3361"\w* \w os cento e quarenta e quatro|strong="G3588,G1540,G5062,G5064"\w* \w mil|strong="G5505"\w*, \w os que foram comprados|strong="G3588,G59"\w* \w da terra|strong="G575,G3588,G1093"\w*.\f + \fr 14.3: \ft Variante: NIV e o RP omitem “como que” (ὡς).\f*\x - \xo 14:3 \xt REV 5:9; REV 7:4; REV 14:1; PSA 116:15; REV 12:11; PSA 96:1\x*
\v 4 \w Estes|strong="G3778"\w* \w são|strong="G1510"\w* \w os que|strong="G3739"\w* \w com mulheres|strong="G3326,G1135"\w* \w não|strong="G3756"\w* \w se contaminaram|strong="G3435"\w*, \w pois|strong="G1063"\w* \w virgens|strong="G3933"\w* \w são|strong="G1510"\w*; \w estes|strong="G3778"\w* \w são os que seguem|strong="G3588,G190"\w* \w o cordeiro|strong="G3588,G721"\w* \w para onde quer que|strong="G3699,G302"\w* \w vá|strong="G5217"\w*; \w estes|strong="G3778"\w* \w foram comprados|strong="G59"\w* \w dentre os seres humanos|strong="G575,G3588,G444"\w* \w como primícias|strong="G536"\w* \w para Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w para o cordeiro|strong="G3588,G721"\w*,\f + \fr 14.4: \ft Lit.: Μολύνω, “contaminar, manchar”; παρθένος, “virgem” (aqui no masculino); ἀπαρχή, “primícias, primeira parte da colheita consagrada a Deus”.\f*\f + \fr 14.4: \ft Nota cultural: “virgens” designa homens (o termo está no masculino); o sentido, literal ou figurado de pureza e fidelidade exclusiva a Deus (cf. 2Co 11:2), é discutido.\f*\f + \fr 14.4: \ft Variante: o RP acrescenta “são” (εἰσίν) depois do primeiro “estes”, traz ὑπάγει em lugar de ὑπάγῃ e acrescenta “por Jesus” (ὑπὸ Ἰησοῦ) depois do último “estes”.\f*\x - \xo 14:4 \xt 2CO 11:2; JHN 1:29; MAT 25:1; REV 12:11; REV 3:4; JAS 1:18\x*
\v 5 \w e|strong="G2532"\w* \w na boca|strong="G1722,G3588,G4750"\w* \w deles|strong="G846"\w* \w não|strong="G3756"\w* \w foi achada|strong="G2147"\w* \w mentira|strong="G5579"\w*; \w irrepreensíveis|strong="G299"\w* \w são|strong="G1510"\w*.\f + \fr 14.5: \ft Lit.: Ἄμωμος, “sem defeito, irrepreensível” (termo usado para animais sacrificiais sem mancha).\f*\f + \fr 14.5: \ft Variante: o TR acrescenta “diante do trono de Deus” (ἐνώπιον τοῦ θρόνου τοῦ θεοῦ) no fim; Treg e o RP acrescentam “pois” (γάρ) depois de “irrepreensíveis”.\f*\x - \xo 14:5 \xt 1PE 2:22; JUD 1:24; PSA 32:2; 1PE 3:10; JHN 1:47; EPH 5:27\x*
\p
\v 6 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w outro anjo|strong="G243,G32"\w* \w voando|strong="G4072"\w* \w no meio do céu|strong="G1722,G3321"\w*, \w tendo|strong="G2192"\w* \w uma boa notícia|strong="G2098"\w* \w eterna|strong="G166"\w* \w para anunciar|strong="G2097"\w* \w aos que estão assentados|strong="G1909,G3588,G2521"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w* \w e|strong="G2532"\w* \w a toda|strong="G1909,G3956"\w* \w nação|strong="G1484"\w* \w e|strong="G2532"\w* \w tribo|strong="G5443"\w* \w e|strong="G2532"\w* \w língua|strong="G1100"\w* \w e|strong="G2532"\w* \w povo|strong="G2992"\w*,\f + \fr 14.6: \ft Lit.: Εὐαγγέλιον, “boa notícia”; εὐαγγελίζω, “anunciar como boa notícia”; καθήμενοι (literalmente “os que estão sentados”) designa aqui os moradores da terra.\f*\f + \fr 14.6: \ft Variante: o RP omite “outro” (ἄλλον) e o segundo ἐπί (“sobre”).\f*\x - \xo 14:6 \xt REV 8:13; REV 13:7; MAT 24:14; REV 5:9; MRK 16:15; PSA 33:8\x*
\v 7 \w dizendo|strong="G3004"\w* \w em voz|strong="G1722,G5456"\w* \w grande|strong="G3173"\w*: “\w Temam|strong="G5399"\w* \w a Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w deem|strong="G1325"\w* \w a ele|strong="G846"\w* \w glória|strong="G1391"\w*, \w porque|strong="G3754"\w* \w chegou|strong="G2064"\w* \w a hora|strong="G3588,G5610"\w* \w do seu julgamento|strong="G3588,G2920,G846"\w*, \w e|strong="G2532"\w* \w adorem|strong="G4352"\w* \w aquele que fez|strong="G3588,G4160"\w* \w o céu|strong="G3588,G3772"\w* \w e|strong="G2532"\w* \w a terra|strong="G3588,G1093"\w* \w e|strong="G2532"\w* \w o mar|strong="G2281"\w* \w e|strong="G2532"\w* \w fontes|strong="G4077"\w* \w de águas|strong="G5204"\w*.”\f + \fr 14.7: \ft Variante: o RP traz “Senhor” (κύριον) em lugar de “Deus” (θεόν), “aquele que fez” em forma diferente (αὐτὸν τὸν ποιήσαντα) e acrescenta o artigo τήν antes de “mar”.\f*\x - \xo 14:7 \xt GEN 1:1; REV 4:11; EXO 20:11; REV 15:4; PSA 34:3; LUK 12:5\x*
\v 8 \w E|strong="G2532"\w* \w outro|strong="G243"\w* \w segundo anjo|strong="G1208,G32"\w* \w seguiu|strong="G190"\w*, \w dizendo|strong="G3004"\w*: “\w Caiu|strong="G4098"\w*, \w caiu|strong="G4098"\w* \w Babilônia|strong="G897"\w*, \w a grande|strong="G3588,G3173"\w*, \w que|strong="G3739"\w* \w do vinho|strong="G1537,G3588,G3631"\w* \w do furor|strong="G3588,G2372"\w* \w da prostituição|strong="G3588,G4202"\w* \w dela|strong="G846"\w* \w deu de beber|strong="G4222"\w* \w a todas as nações|strong="G3956,G3588,G1484"\w*.”\f + \fr 14.8: \ft Lit.: Πορνεία, “prostituição, imoralidade sexual”, aqui em sentido simbólico (idolatria e apostasia); θυμός, “furor”.\f*\f + \fr 14.8: \ft Nota cultural: “Caiu, caiu Babilônia” cita Is 21:9 e Jr 51:7-8; no Apocalipse “Babilônia” é o nome simbólico da potência opressora (caps. 17–18).\f*\f + \fr 14.8: \ft Variante: o TR acrescenta “a cidade” (ἡ πόλις) depois de “a grande”; o RP omite o segundo “caiu” (ἔπεσεν) e o pronome “que” (ἥ); NA28 traz “anjo, um segundo” (ἄγγελος δεύτερος) em ordem diferente.\f*\x - \xo 14:8 \xt JER 51:7; ISA 21:9; JER 29:11; REV 16:19; REV 18:3; REV 18:2\x*
\v 9 \w E|strong="G2532"\w* \w outro|strong="G243"\w* \w terceiro anjo|strong="G32,G5154"\w* \w os seguiu|strong="G190,G846"\w*, \w dizendo|strong="G3004"\w* \w em voz|strong="G1722,G5456"\w* \w grande|strong="G3173"\w*: “\w Se alguém|strong="G1487,G5100"\w* \w adora|strong="G4352"\w* \w a fera|strong="G3588,G2342"\w* \w e|strong="G2532"\w* \w a sua imagem|strong="G3588,G1504,G846"\w*, \w e|strong="G2532"\w* \w recebe|strong="G2983"\w* \w uma marca|strong="G5480"\w* \w sobre a sua testa|strong="G1909,G3588,G3359,G846"\w* \w ou|strong="G2228"\w* \w sobre a sua mão|strong="G1909,G3588,G5495,G846"\w*,\x - \xo 14:9 \xt JER 29:11; REV 13:16; REV 13:15; REV 14:11; REV 20:4; REV 13:17\x*
\v 10 \w também|strong="G2532"\w* \w ele|strong="G846"\w* \w beberá|strong="G4095"\w* \w do vinho|strong="G1537,G3588,G3631"\w* \w do furor|strong="G3588,G2372"\w* \w de Deus|strong="G3588,G2316"\w*, \w preparado|strong="G3588,G2767"\w* \w puro|strong="G194"\w* \w no cálice|strong="G1722,G3588,G4221"\w* \w da sua ira|strong="G3588,G3709,G846"\w*, \w e|strong="G2532"\w* \w será atormentado|strong="G928"\w* \w com fogo|strong="G1722,G4442"\w* \w e|strong="G2532"\w* \w enxofre|strong="G2303"\w* \w diante dos santos anjos|strong="G1799,G32,G40"\w* \w e|strong="G2532"\w* \w diante do cordeiro|strong="G1799,G3588,G721"\w*.\f + \fr 14.10: \ft Lit.: κεκερασμένου ἀκράτου, literalmente “misturado sem mistura”, isto é, preparado sem diluição, em força plena.\f*\f + \fr 14.10: \ft Nota cultural: o cálice do furor de Deus ecoa Is 51:17 e Jr 25:15; o fogo e o enxofre lembram Gn 19:24.\f*\f + \fr 14.10: \ft Variante: o RP traz “os santos anjos” em ordem diferente (τῶν ἁγίων ἀγγέλων).\f*\x - \xo 14:10 \xt ISA 51:17; JER 25:15; GEN 19:24; JER 29:11; REV 16:19; REV 18:6\x*
\v 11 \w E|strong="G2532"\w* \w a fumaça|strong="G3588,G2586"\w* \w do tormento|strong="G3588,G929"\w* \w deles|strong="G846"\w* \w sobe|strong="G305"\w* \w para os séculos|strong="G1519,G165"\w* \w dos séculos|strong="G165"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w têm|strong="G2192"\w* \w descanso|strong="G372"\w* \w de dia|strong="G2250"\w* \w e|strong="G2532"\w* \w de noite|strong="G3571"\w*, \w os que adoram|strong="G3588,G4352"\w* \w a fera|strong="G3588,G2342"\w* \w e|strong="G2532"\w* \w a sua imagem|strong="G3588,G1504,G846"\w*, \w e|strong="G2532"\w* \w se alguém|strong="G1487,G5100"\w* \w recebe|strong="G2983"\w* \w a marca|strong="G3588,G5480"\w* \w do nome|strong="G3588,G3686"\w* \w dela|strong="G846"\w*.”\f + \fr 14.11: \ft Nota cultural: a fumaça que sobe para sempre ecoa Is 34:10 (juízo sobre Edom).\f*\x - \xo 14:11 \xt ISA 34:10; JER 29:11; REV 14:9; REV 13:15; REV 13:17; REV 20:4\x*
\v 12 \w Aqui|strong="G5602"\w* \w está a perseverança|strong="G3588,G5281,G1510"\w* \w dos santos|strong="G3588,G40"\w*, \w os que guardam|strong="G3588,G5083"\w* \w os mandamentos|strong="G3588,G1785"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w a fé|strong="G3588,G4102"\w* \w de Jesus|strong="G2424"\w*.\f + \fr 14.12: \ft Lit.: Πίστιν Ἰησοῦ, “a fé de Jesus”, genitivo ambíguo: pode ser “a fé em Jesus” ou “a fidelidade de Jesus”.\f*\x - \xo 14:12 \xt REV 13:10; JER 29:11; 1JN 2:3; JHN 14:15; REV 3:10; REV 12:17\x*
\v 13 \w E|strong="G2532"\w* \w ouvi|strong="G191"\w* \w uma voz|strong="G5456"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w dizendo|strong="G3004"\w*: “\w Escreva|strong="G1125"\w*: \w Felizes|strong="G3107"\w* \w os mortos|strong="G3588,G3498"\w* \w que morrem|strong="G3588,G599"\w* \w no Senhor|strong="G1722,G2962"\w* \w desde agora|strong="G575,G737"\w*. \w Sim|strong="G3483"\w*, \w diz|strong="G3004"\w* \w o Espírito|strong="G3588,G4151"\w*, \w para que|strong="G2443"\w* \w descansem|strong="G373"\w* \w das suas fadigas|strong="G1537,G3588,G2873,G846"\w*, \w pois|strong="G1063"\w* \w as obras|strong="G3588,G2041"\w* \w deles|strong="G846"\w* \w os acompanham|strong="G190,G3326,G846"\w*.”\f + \fr 14.13: \ft Lit.: Κόπος, “fadiga, trabalho penoso”.\f*\f + \fr 14.13: \ft Variante: o TR acrescenta “a mim” (μοι) depois de “dizendo”; o RP traz “diz: Sim” (λέγει Ναί) em ordem diferente, o subjuntivo ἀναπαύσωνται e “porém” (δέ) em lugar de “pois” (γάρ).\f*\x - \xo 14:13 \xt JER 29:11; PHP 1:21; REV 20:6; HEB 4:10; 1TH 5:10; 2TI 4:7-8\x*
\p
\v 14 \w E|strong="G2532"\w* \w vi|strong="G1492"\w*, \w e|strong="G2532"\w* \w olhem|strong="G2400"\w*, \w uma nuvem|strong="G3507"\w* \w branca|strong="G3022"\w*, \w e|strong="G2532"\w* \w sobre a nuvem|strong="G1909,G3588,G3507"\w* \w alguém sentado|strong="G2521"\w* \w semelhante|strong="G3664"\w* \w a um filho|strong="G5207"\w* \w de homem|strong="G444"\w*, \w tendo|strong="G2192"\w* \w sobre a cabeça|strong="G1909,G3588,G2776"\w* \w dele|strong="G846"\w* \w uma coroa|strong="G4735"\w* \w de ouro|strong="G5552"\w* \w e|strong="G2532"\w* \w na mão|strong="G1722,G3588,G5495"\w* \w dele|strong="G846"\w* \w uma foice|strong="G1407"\w* \w afiada|strong="G3691"\w*\f + \fr 14.14: \ft Variante: Treg e o RP trazem o dativo υἱῷ (“semelhante a um filho”) em lugar do acusativo υἱόν.\f*\f + \fr 14.14: \ft Nota cultural: a figura “semelhante a um filho de ser humano” sobre a nuvem ecoa Dn 7:13.\f*\f + \fr 14.14: \ft Lit.: Υἱὸν ἀνθρώπου sem artigo: “um filho de ser humano”, distinto do título “o Filho do Homem”; στέφανος, “coroa de vencedor”.\f*.\x - \xo 14:14 \xt DAN 7:13; JER 29:11; REV 14:16; REV 14:17; REV 6:2; REV 1:7\x*
\v 15 \w E|strong="G2532"\w* \w outro anjo|strong="G243,G32"\w* \w saiu|strong="G1831"\w* \w do santuário|strong="G1537,G3588,G3485"\w*, \w clamando|strong="G2896"\w* \w em voz|strong="G1722,G5456"\w* \w grande|strong="G3173"\w* \w ao que está sentado|strong="G3588,G2521"\w* \w sobre a nuvem|strong="G1909,G3588,G3507"\w*: “\w Envie|strong="G3992"\w* \w a sua foice|strong="G3588,G1407,G4771"\w* \w e|strong="G2532"\w* \w ceife|strong="G2325"\w*, \w porque|strong="G3754"\w* \w chegou|strong="G2064"\w* \w a hora|strong="G3588,G5610"\w* \w de ceifar|strong="G2325"\w*, \w porque|strong="G3754"\w* \w secou|strong="G3583"\w* \w a colheita|strong="G3588,G2326"\w* \w da terra|strong="G3588,G1093"\w*.”\f + \fr 14.15: \ft Lit.: ἐξηράνθη, “secou”: a seara está seca, isto é, madura para a ceifa; θερισμός, “colheita, ceifa”.\f*\f + \fr 14.15: \ft Nota cultural: a ceifa da terra ecoa Jl 3:13.\f*\f + \fr 14.15: \ft Variante: o TR acrescenta “para você” (σοι) depois de “Envie”.\f*\x - \xo 14:15 \xt JOL 3:13; REV 14:17; MRK 4:29; REV 14:18; MAT 13:39; REV 1:7\x*
\v 16 \w e|strong="G2532"\w* \w o que estava sentado|strong="G3588,G2521"\w* \w sobre a nuvem|strong="G1909,G3588,G3507"\w* \w lançou|strong="G906"\w* \w a sua foice|strong="G3588,G1407,G846"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*, \w e|strong="G2532"\w* \w a terra|strong="G3588,G1093"\w* \w foi ceifada|strong="G2325"\w*.\x - \xo 14:16 \xt REV 14:14; REV 14:19; MAT 13:39; JOL 3:13; REV 1:7; REV 11:19\x*
\v 17 \w E|strong="G2532"\w* \w outro anjo|strong="G243,G32"\w* \w saiu|strong="G1831"\w* \w do santuário|strong="G1537,G3588,G3485"\w* \w que está|strong="G3588,G1722"\w* \w no céu|strong="G3588,G3772"\w*, \w tendo|strong="G2192"\w* \w também|strong="G2532"\w* \w ele|strong="G846"\w* \w uma foice|strong="G1407"\w* \w afiada|strong="G3691"\w*.\f + \fr 14.17: \ft Acréscimo: “que está”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 14:17 \xt REV 14:14; MAT 13:39; JOL 3:13; REV 11:19; REV 19:15; ISA 17:5\x*
\v 18 \w E|strong="G2532"\w* \w outro anjo|strong="G243,G32"\w* \add saiu\add* \w do altar|strong="G1537,G3588,G2379"\w*, \w o que tem|strong="G3588,G2192"\w* \w autoridade|strong="G1849"\w* \w sobre o fogo|strong="G1909,G3588,G4442"\w*, \w e|strong="G2532"\w* \w gritou|strong="G5455"\w* \w em voz|strong="G5456"\w* \w grande|strong="G3173"\w* \w ao que tem|strong="G3588,G2192"\w* \w a foice afiada|strong="G3588,G1407,G3691"\w*, \w dizendo|strong="G3004"\w*: “\w Envie|strong="G3992"\w* \w a sua foice afiada|strong="G4771,G3588,G1407,G3691"\w* \w e|strong="G2532"\w* \w vindime|strong="G5166"\w* \w os cachos|strong="G3588,G1009"\w* \w da vinha|strong="G3588,G288"\w* \w da terra|strong="G3588,G1093"\w*, \w porque|strong="G3754"\w* \w amadureceram|strong="G187"\w* \w as uvas|strong="G3588,G4718"\w* \w dela|strong="G846"\w*.”\f + \fr 14.18: \ft Lit.: τρυγάω, “vindimar, colher uvas”; ἀκμάζω, “estar no auge, amadurecer”.\f*\f + \fr 14.18: \ft Variante: o SBLGNT omite o verbo “saiu” (ἐξήλθεν), que WH, Treg, NA28 e o RP trazem; Treg e o RP omitem o artigo ὁ antes de “que tem”; o RP traz κραυγῇ (“clamor”) em lugar de φωνῇ (“voz”).\f*\f + \fr 14.18: \ft Acréscimo: “saiu” (em “outro anjo saiu do altar”): verbo acrescentado: o grego traz a frase sem verbo (construção nominal ou elíptica) e o português exige um, tomado do contexto.\f*\x - \xo 14:18 \xt REV 14:15; MAT 13:39; JOL 3:13; ISA 5:2; REV 16:8; REV 19:15\x*
\v 19 \w e|strong="G2532"\w* \w o anjo|strong="G3588,G32"\w* \w lançou|strong="G906"\w* \w a sua foice|strong="G3588,G1407,G846"\w* \w sobre a terra|strong="G1519,G3588,G1093"\w*, \w e|strong="G2532"\w* \w vindimou|strong="G5166"\w* \w a vinha|strong="G3588,G288"\w* \w da terra|strong="G3588,G1093"\w*, \w e|strong="G2532"\w* \w a lançou|strong="G906"\w* \w no grande lagar|strong="G1519,G3588,G3025,G3173"\w* \w do furor|strong="G3588,G2372"\w* \w de Deus|strong="G3588,G2316"\w*.\x - \xo 14:19 \xt REV 14:16; MAT 13:39; DEU 32:32-33; ISA 63:3; JOL 3:13; ISA 5:2\x*
\v 20 \w E|strong="G2532"\w* \w foi pisado|strong="G3961"\w* \w o lagar|strong="G3588,G3025"\w* \w fora|strong="G1855"\w* \w da cidade|strong="G3588,G4172"\w*, \w e|strong="G2532"\w* \w saiu|strong="G1831"\w* \w sangue|strong="G129"\w* \w do lagar|strong="G1537,G3588,G3025"\w* \w até|strong="G891"\w* \w os freios|strong="G3588,G5469"\w* \w dos cavalos|strong="G3588,G2462"\w* \w numa extensão de|strong="G575"\w* \w mil e seiscentos|strong="G5507,G1812"\w* \w estádios|strong="G4712"\w*.\f + \fr 14.20: \ft Lit.: Στάδιον, “estádio”, medida de cerca de 185 metros; mil e seiscentos estádios somam cerca de 300 km.\f*\f + \fr 14.20: \ft Nota cultural: o lagar da ira de Deus ecoa Is 63:1-6 e Jl 3:13.\f*\x - \xo 14:20 \xt JOL 3:13; ISA 63:1-6; REV 19:13; ISA 63:3; LAM 1:15; HEB 13:11-12\x*
\c 15
\p
\v 1 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w outro sinal|strong="G243,G4592"\w* \w no céu|strong="G1722,G3588,G3772"\w*, \w grande|strong="G3173"\w* \w e|strong="G2532"\w* \w maravilhoso|strong="G2298"\w*: \w sete anjos|strong="G32,G2033"\w* \w que têm|strong="G2192"\w* \w sete pragas|strong="G4127,G2033"\w*, \w as últimas|strong="G3588,G2078"\w*, \w porque|strong="G3754"\w* \w nelas|strong="G1722,G846"\w* \w se consumou|strong="G5055"\w* \w o furor|strong="G3588,G2372"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 15.1: \ft Lit.: Τελέω, “consumar, levar ao fim”; πληγή, “praga, golpe”.\f*\x - \xo 15:1 \xt REV 16:1; REV 15:8; REV 21:9; LEV 26:21; GEN 3:15; REV 15:6\x*
\v 2 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w como que|strong="G5613"\w* \w um mar|strong="G2281"\w* \w de vidro|strong="G5193"\w* \w misturado|strong="G3396"\w* \w com fogo|strong="G4442"\w*, \w e|strong="G2532"\w* \w os que venceram|strong="G3588,G3528"\w* \w a fera|strong="G1537,G3588,G2342"\w* \w e|strong="G2532"\w* \w a sua imagem|strong="G1537,G3588,G1504,G846"\w* \w e|strong="G2532"\w* \w o número|strong="G1537,G3588,G706"\w* \w do seu nome|strong="G3588,G3686,G846"\w*, \w de pé|strong="G2476"\w* \w sobre o mar|strong="G1909,G3588,G2281"\w* \w de vidro|strong="G3588,G5193"\w*, \w tendo|strong="G2192"\w* \w harpas|strong="G2788"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 15.2: \ft Nota cultural: o mar de vidro misturado com fogo e os vencedores que cantam o cântico de Moisés (v. 3) evocam a travessia do mar Vermelho (Êx 14–15).\f*\f + \fr 15.2: \ft Variante: o TR acrescenta “da sua marca” (χαράγματος) depois de “imagem”.\f*\x - \xo 15:2 \xt 1CO 15:57; REV 4:6; REV 13:18; REV 12:11; PSA 32:7; 1JN 5:4\x*
\q1
\v 3 \w E|strong="G2532"\w* \w cantam|strong="G103"\w* \w o cântico|strong="G3588,G5603"\w* \w de Moisés|strong="G3475"\w*, \w o servo|strong="G3588,G1401"\w* \w de Deus|strong="G3588,G2316"\w*, \w e|strong="G2532"\w* \w o cântico|strong="G3588,G5603"\w* \w do cordeiro|strong="G3588,G721"\w*, \w dizendo|strong="G3004"\w*: “\w Grandes|strong="G3173"\w* \w e|strong="G2532"\w* \w maravilhosas|strong="G2298"\w* \w são as suas obras|strong="G3588,G2041,G4771"\w*, \w Senhor|strong="G2962"\w*, \w Deus|strong="G3588,G2316"\w*, \w o Todo-Poderoso|strong="G3588,G3841"\w*; \w justos|strong="G1342"\w* \w e|strong="G2532"\w* \w verdadeiros|strong="G228"\w* \w são os seus caminhos|strong="G3588,G3598,G4771"\w*, \w o rei|strong="G3588,G935"\w* \w dos séculos|strong="G3588,G165"\w*.\f + \fr 15.3: \ft Nota cultural: o cântico de Moisés (Êx 15:1-18) e as palavras “grandes e maravilhosas são as tuas obras” ecoam também Dt 32:4 e Sl 111:2 e 145:17.\f*\f + \fr 15.3: \ft Variante: Treg, NA28 e o RP trazem “rei das nações” (ἐθνῶν) em lugar de “rei dos séculos” (αἰώνων).\f*\f + \fr 15.3: \ft Acréscimo: verbo ser/estar suprido em “são as suas obras”, “são os seus caminhos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\f + \fr 15.3: \ft Tradução: δούλου (δοῦλος, G1401) está aqui como “o servo”; o termo pode ser “escravo” (condição social), “servo” ou “servidor”, e o contexto decide.\f*\x - \xo 15:3 \xt EXO 15:1; PSA 111:2; DEU 32:4; PSA 145:17; REV 16:7; PSA 46:10\x*
\q1
\v 4 \w Quem|strong="G5101"\w* \w não|strong="G3756,G3361"\w* \w temerá|strong="G5399"\w*, \w Senhor|strong="G2962"\w*, \w e|strong="G2532"\w* \w glorificará|strong="G1392"\w* \w o seu nome|strong="G3588,G3686,G4771"\w*? \w Pois|strong="G3754"\w* \w somente|strong="G3441"\w* \w você é santo|strong="G3741"\w*; \w pois|strong="G3754"\w* \w todas as nações|strong="G3956,G3588,G1484"\w* \w virão|strong="G2240"\w* \w e|strong="G2532"\w* \w adorarão|strong="G4352"\w* \w diante de você|strong="G1799,G4771"\w*, \w porque|strong="G3754"\w* \w as suas sentenças justas|strong="G3588,G1345,G4771"\w* \w foram manifestadas|strong="G5319"\w*.”\f + \fr 15.4: \ft Lit.: Ὅσιος, “santo, leal, piedoso” (distinto de ἅγιος, “santo, separado”); δικαίωμα, “decreto justo, ato de justiça”.\f*\f + \fr 15.4: \ft Nota cultural: o verso ecoa Jr 10:7, Sl 86:9-10 e Is 66:23 (as nações adorando diante do Senhor).\f*\f + \fr 15.4: \ft Variante: o RP traz “você” (σε) depois de “temerá”, o subjuntivo δοξάσῃ e ἅγιος em lugar de ὅσιος.\f*\f + \fr 15.4: \ft Acréscimo: verbo ser/estar suprido em “você é santo”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 15:4 \xt PSA 86:9; JER 10:7; ISA 66:23; PSA 46:10; MAL 1:11; EXO 15:11\x*
\p
\v 5 \w E|strong="G2532"\w* \w depois disto|strong="G3326,G3778"\w* \w vi|strong="G1492"\w*, \w e|strong="G2532"\w* \w abriu-se|strong="G455"\w* \w o santuário|strong="G3588,G3485"\w* \w da tenda|strong="G3588,G4633"\w* \w do testemunho|strong="G3588,G3142"\w* \w no céu|strong="G1722,G3588,G3772"\w*,\f + \fr 15.5: \ft Nota cultural: a “tenda do testemunho” é o tabernáculo do deserto (Êx 38:21; Nm 9:15), onde estava a arca com as tábuas do testemunho.\f*\f + \fr 15.5: \ft Variante: o TR acrescenta “olhem” (ἰδού) depois de “vi”.\f*\x - \xo 15:5 \xt EXO 38:21; NUM 9:15; REV 11:19; NUM 1:50; GEN 3:15; MAT 27:51\x*
\v 6 \w e|strong="G2532"\w* \w saíram|strong="G1831"\w* \w os sete|strong="G3588,G2033"\w* \w anjos|strong="G32"\w* \w que tinham|strong="G3588,G2192"\w* \w as sete pragas|strong="G3588,G2033,G4127"\w* \w do santuário|strong="G1537,G3588,G3485"\w*, \w vestidos|strong="G1746"\w* \w de linho|strong="G3043"\w* \w puro|strong="G2513"\w* \w resplandecente|strong="G2986"\w*, \w e|strong="G2532"\w* \w cingidos|strong="G4024"\w* \w ao redor do peito|strong="G4012,G3588,G4738"\w* \w com cintos|strong="G2223"\w* \w de ouro|strong="G5552"\w*.\f + \fr 15.6: \ft Variante: WH e Treg trazem “pedra” (λίθον) em lugar de “linho” (λίνον); o RP traz “os quais estavam vestidos” (οἳ ἦσαν ἐνδεδυμένοι).\f*\x - \xo 15:6 \xt REV 1:13; REV 11:19; GEN 3:15; REV 15:1; REV 16:1; DAN 10:5\x*
\v 7 \w E|strong="G2532"\w* \w um|strong="G1520"\w* \w dos quatro|strong="G1537,G3588,G5064"\w* \w seres vivos|strong="G2226"\w* \w deu|strong="G1325"\w* \w aos sete|strong="G3588,G2033"\w* \w anjos|strong="G32"\w* \w sete taças|strong="G2033,G5357"\w* \w de ouro|strong="G5552"\w* \w cheias|strong="G1073"\w* \w do furor|strong="G3588,G2372"\w* \w de Deus|strong="G3588,G2316"\w*, \w o que vive|strong="G3588,G2198"\w* \w para os séculos|strong="G1519,G3588,G165"\w* \w dos séculos|strong="G3588,G165"\w*.\f + \fr 15.7: \ft Lit.: Φιάλη, “taça rasa, tigela”.\f*\x - \xo 15:7 \xt REV 5:8; REV 16:1; REV 21:9; REV 11:19; REV 4:9; REV 15:1\x*
\v 8 \w E|strong="G2532"\w* \w se encheu|strong="G1072"\w* \w o santuário|strong="G3588,G3485"\w* \w de fumaça|strong="G2586"\w* \w proveniente da glória|strong="G1537,G3588,G1391"\w* \w de Deus|strong="G3588,G2316"\w* \w e|strong="G2532"\w* \w do poder|strong="G1537,G3588,G1411"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w ninguém|strong="G3762"\w* \w podia|strong="G1410"\w* \w entrar|strong="G1525"\w* \w no santuário|strong="G1519,G3588,G3485"\w* \w até que|strong="G891"\w* \w se consumassem|strong="G5055"\w* \w as sete pragas|strong="G3588,G2033,G4127"\w* \w dos sete anjos|strong="G3588,G2033,G32"\w*.\f + \fr 15.8: \ft Nota cultural: o santuário cheio de fumaça da glória de Deus ecoa Êx 40:34-35, 1Rs 8:10-11 e Is 6:4.\f*\x - \xo 15:8 \xt EXO 40:34; ISA 6:4; 1KI 8:10-11; REV 15:1; ISA 6:1; 2CH 5:14\x*
\c 16
\p
\v 1 \w E|strong="G2532"\w* \w ouvi|strong="G191"\w* \w uma grande|strong="G3173"\w* \w voz|strong="G5456"\w* \w do santuário|strong="G1537,G3588,G3485"\w* \w dizendo|strong="G3004"\w* \w aos sete|strong="G3588,G2033"\w* \w anjos|strong="G32"\w*: “\w Vão|strong="G5217"\w* \w e|strong="G2532"\w* \w derramem|strong="G1632"\w* \w as sete taças|strong="G3588,G2033,G5357"\w* \w do furor|strong="G3588,G2372"\w* \w de Deus|strong="G3588,G2316"\w* \w sobre a terra|strong="G1519,G3588,G1093"\w*.”\f + \fr 16.1: \ft Variante: o TR omite “sete” (ἑπτά) antes de “taças”.\f*\x - \xo 16:1 \xt REV 16:17; REV 15:1; ZEP 3:8; JER 10:25; JOS 6:4; PSA 79:6\x*
\v 2 \w E|strong="G2532"\w* \w foi|strong="G565"\w* \w o primeiro|strong="G3588,G4413"\w* \w e|strong="G2532"\w* \w derramou|strong="G1632"\w* \w a sua taça|strong="G3588,G5357,G846"\w* \w sobre a terra|strong="G1519,G3588,G1093"\w*; \w e|strong="G2532"\w* \w surgiu|strong="G1096"\w* \w uma úlcera|strong="G1668"\w* \w má|strong="G2556"\w* \w e|strong="G2532"\w* \w maligna|strong="G4190"\w* \w sobre os seres humanos|strong="G1909,G3588,G444"\w* \w que tinham|strong="G3588,G2192"\w* \w a marca|strong="G3588,G5480"\w* \w da fera|strong="G3588,G2342"\w* \w e|strong="G2532"\w* \w que adoravam|strong="G3588,G4352"\w* \w a sua imagem|strong="G3588,G1504,G846"\w*.\f + \fr 16.2: \ft Nota cultural: a úlcera lembra a sexta praga do Egito (Êx 9:8-11).\f*\x - \xo 16:2 \xt EXO 9:8-11; REV 13:15; EXO 20:4; REV 8:7; EXO 9:9; REV 21:9\x*
\v 3 \w E|strong="G2532"\w* \w o segundo|strong="G3588,G1208"\w* \w derramou|strong="G1632"\w* \w a sua taça|strong="G3588,G5357,G846"\w* \w sobre o mar|strong="G1519,G3588,G2281"\w*; \w e|strong="G2532"\w* \w se tornou|strong="G1096"\w* \w sangue|strong="G129"\w* \w como de morto|strong="G5613,G3498"\w*, \w e|strong="G2532"\w* \w toda criatura viva|strong="G3956,G5590,G2222"\w* \w morreu|strong="G599"\w*, \w as que estavam|strong="G3588"\w* \w no mar|strong="G1722,G3588,G2281"\w*.\f + \fr 16.3: \ft Lit.: ψυχὴ ζωῆς, literalmente “alma de vida”, isto é, “ser vivo, criatura viva”.\f*\f + \fr 16.3: \ft Nota cultural: o mar que se torna sangue evoca a primeira praga do Egito (Êx 7:20-21).\f*\f + \fr 16.3: \ft Variante: o TR e o RP acrescentam “anjo” (ἄγγελος) depois de “o segundo”; o RP traz ζῶσα (“viva”) em lugar de ζωῆς e omite o artigo τά.\f*\f + \fr 16.3: \ft Acréscimo: “as que estavam”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 16:3 \xt EXO 7:20-21; REV 16:1; REV 21:9; EXO 7:17; REV 8:8; GEN 19:13\x*
\v 4 \w E|strong="G2532"\w* \w o terceiro|strong="G3588,G5154"\w* \w derramou|strong="G1632"\w* \w a sua taça|strong="G3588,G5357,G846"\w* \w sobre os rios|strong="G1519,G3588,G4215"\w* \w e|strong="G2532"\w* \w as fontes|strong="G3588,G4077"\w* \w das águas|strong="G3588,G5204"\w*; \w e|strong="G2532"\w* \w se tornou|strong="G1096"\w* \w sangue|strong="G129"\w*.\f + \fr 16.4: \ft Variante: o TR acrescenta “anjo” (ἄγγελος) depois de “o terceiro”; o RP acrescenta “para” (εἰς) antes de “as fontes”.\f*\x - \xo 16:4 \xt REV 8:10; REV 16:1; REV 21:9; EXO 7:17; HOS 13:15; REV 14:7\x*
\v 5 \w E|strong="G2532"\w* \w ouvi|strong="G191"\w* \w o anjo|strong="G3588,G32"\w* \w das águas|strong="G3588,G5204"\w* \w dizendo|strong="G3004"\w*: “\w Justo|strong="G1342"\w* \w você é|strong="G1510"\w*, \w o que é|strong="G3588,G1510"\w* \w e|strong="G2532"\w* \w o que era|strong="G3588,G1510"\w*, \w o santo|strong="G3588,G3741"\w*, \w porque|strong="G3754"\w* \w julgou|strong="G2919"\w* \w estas coisas|strong="G3778"\w*;\f + \fr 16.5: \ft Variante: o TR acrescenta “Senhor” (κύριε) depois de “Justo”.\f*\x - \xo 16:5 \xt LUK 12:57; REV 6:10; LUK 6:38; PSA 51:4; REV 1:8; REV 11:17\x*
\v 6 \w porque|strong="G3754"\w* \w sangue|strong="G129"\w* \w de santos|strong="G40"\w* \w e|strong="G2532"\w* \w de profetas|strong="G4396"\w* \w derramaram|strong="G1632"\w*, \w e|strong="G2532"\w* \w sangue|strong="G129"\w* \w você lhes deu|strong="G846,G1325"\w* \w para beber|strong="G4095"\w*; \w dignos|strong="G514"\w* \w são|strong="G1510"\w*.”\f + \fr 16.6: \ft Nota cultural: a retribuição em espécie (sangue por sangue) ecoa Is 49:26 e Sl 79:3, 10.\f*\f + \fr 16.6: \ft Variante: o RP traz o aoristo ἔδωκας em lugar do perfeito δέδωκας.\f*\x - \xo 16:6 \xt ISA 49:26; PSA 79:3; REV 18:24; MAT 23:30; REV 17:6; REV 6:10\x*
\v 7 \w e|strong="G2532"\w* \w ouvi|strong="G191"\w* \w o altar|strong="G3588,G2379"\w* \w dizendo|strong="G3004"\w*: “\w Sim|strong="G3483"\w*, \w Senhor|strong="G2962"\w*, \w Deus|strong="G3588,G2316"\w*, \w o Todo-Poderoso|strong="G3588,G3841"\w*, \w verdadeiros|strong="G228"\w* \w e|strong="G2532"\w* \w justos|strong="G1342"\w* \w são os seus julgamentos|strong="G3588,G2920,G4771"\w*.”\f + \fr 16.7: \ft Variante: o TR traz “outro do altar” (ἄλλου ἐκ) em lugar de “o altar”.\f*\f + \fr 16.7: \ft Acréscimo: verbo ser/estar suprido em “são os seus julgamentos”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 16:7 \xt REV 15:3; REV 19:2; REV 15:4; REV 4:8; REV 6:10; ROM 9:14\x*
\v 8 \w E|strong="G2532"\w* \w o quarto|strong="G3588,G5067"\w* \w derramou|strong="G1632"\w* \w a sua taça|strong="G3588,G5357,G846"\w* \w sobre o sol|strong="G1909,G3588,G2246"\w*; \w e|strong="G2532"\w* \w foi dado|strong="G1325"\w* \w a ele|strong="G846"\w* \w queimar|strong="G2739"\w* \w os seres humanos|strong="G3588,G444"\w* \w com fogo|strong="G1722,G4442"\w*.\f + \fr 16.8: \ft Lit.: Καυματίζω, “queimar com calor, abrasar”.\f*\f + \fr 16.8: \ft Variante: o TR e o RP acrescentam “anjo” (ἄγγελος) depois de “o quarto”; o RP inverte a ordem para “com fogo os seres humanos”.\f*\x - \xo 16:8 \xt MAT 13:6; REV 16:1; REV 22:11; REV 21:9; ACT 2:20; JON 4:8\x*
\v 9 \w E|strong="G2532"\w* \w foram queimados|strong="G2739"\w* \w os seres humanos|strong="G3588,G444"\w* \w com grande|strong="G3173"\w* \w calor|strong="G2738"\w*, \w e|strong="G2532"\w* \w blasfemaram|strong="G987"\w* \w o nome|strong="G3588,G3686"\w* \w de Deus|strong="G3588,G2316"\w*, \w o que tem|strong="G3588,G2192"\w* \w a autoridade|strong="G3588,G1849"\w* \w sobre estas pragas|strong="G1909,G3588,G4127,G3778"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w se arrependeram|strong="G3340"\w* \w para dar|strong="G1325"\w* \w a ele|strong="G846"\w* \w glória|strong="G1391"\w*.\f + \fr 16.9: \ft Variante: o RP acrescenta “os seres humanos” (οἱ ἄνθρωποι) depois de “blasfemaram” e omite o artigo τήν antes de “autoridade”.\f*\x - \xo 16:9 \xt REV 16:21; REV 22:11; REV 16:11; PRO 19:3; REV 2:21; REV 21:9\x*
\v 10 \w E|strong="G2532"\w* \w o quinto|strong="G3588,G3991"\w* \w derramou|strong="G1632"\w* \w a sua taça|strong="G3588,G5357,G846"\w* \w sobre o trono|strong="G1909,G3588,G2362"\w* \w da fera|strong="G3588,G2342"\w*; \w e|strong="G2532"\w* \w o reino|strong="G3588,G932"\w* \w dela|strong="G846"\w* \w ficou|strong="G1096"\w* \w escurecido|strong="G4656"\w*, \w e|strong="G2532"\w* \w mordiam|strong="G3145"\w* \w as suas línguas|strong="G3588,G1100,G846"\w* \w de dor|strong="G1537,G3588,G4192"\w*,\f + \fr 16.10: \ft Variante: o TR acrescenta “anjo” (ἄγγελος) depois de “o quinto”.\f*\x - \xo 16:10 \xt REV 22:11; PRO 19:3; REV 21:9; REV 9:2; REV 16:1; REV 16:9\x*
\v 11 \w e|strong="G2532"\w* \w blasfemaram|strong="G987"\w* \w o Deus|strong="G3588,G2316"\w* \w do céu|strong="G3588,G3772"\w* \w por causa das suas dores|strong="G1537,G3588,G4192,G846"\w* \w e|strong="G2532"\w* \w por causa das suas úlceras|strong="G1537,G3588,G1668,G846"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w se arrependeram|strong="G3340"\w* \w das suas obras|strong="G1537,G3588,G2041,G846"\w*.\x - \xo 16:11 \xt REV 22:11; REV 16:9; PRO 19:3; JOB 1:11; REV 21:9; REV 16:1\x*
\v 12 \w E|strong="G2532"\w* \w o sexto|strong="G3588,G1623"\w* \w derramou|strong="G1632"\w* \w a sua taça|strong="G3588,G5357,G846"\w* \w sobre o grande rio|strong="G1909,G3588,G4215,G3173"\w* \w Eufrates|strong="G2166"\w*; \w e|strong="G2532"\w* \w secou|strong="G3583"\w* \w a água|strong="G3588,G5204"\w* \w dele|strong="G846"\w*, \w para que|strong="G2443"\w* \w fosse preparado|strong="G2090"\w* \w o caminho|strong="G3588,G3598"\w* \w dos reis|strong="G3588,G935"\w* \w que vêm do nascente|strong="G3588,G575,G395"\w* \w do sol|strong="G2246"\w*.\f + \fr 16.12: \ft Nota cultural: o Eufrates seco para dar passagem a exércitos lembra a queda de Babilônia (Is 11:15-16; Jr 50–51).\f*\f + \fr 16.12: \ft Variante: o TR acrescenta “anjo” (ἄγγελος) depois de “o sexto”; o RP omite o artigo τόν antes de “grande”.\f*\x - \xo 16:12 \xt ISA 11:15; REV 9:14; REV 21:9; JER 51:36; REV 16:1; DAN 11:40\x*
\v 13 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w da boca|strong="G1537,G3588,G4750"\w* \w do dragão|strong="G3588,G1404"\w* \w e|strong="G2532"\w* \w da boca|strong="G1537,G3588,G4750"\w* \w da fera|strong="G3588,G2342"\w* \w e|strong="G2532"\w* \w da boca|strong="G1537,G3588,G4750"\w* \w do falso profeta|strong="G3588,G5578"\w* \add saírem\add* \w três espíritos|strong="G4151,G5140"\w* \w impuros|strong="G169"\w* \w como rãs|strong="G5613,G944"\w*;\f + \fr 16.13: \ft Acréscimo: “saírem” (em “falso profeta saírem três espíritos”): verbo acrescentado: o grego traz a frase sem verbo (construção nominal ou elíptica) e o português exige um, tomado do contexto.\f*\x - \xo 16:13 \xt REV 13:11; REV 19:20; 2TH 2:9-11; 1JN 4:1-3; REV 20:10; REV 21:9\x*
\v 14 \w pois|strong="G1063"\w* \w são|strong="G1510"\w* \w espíritos|strong="G4151"\w* \w de demônios|strong="G1140"\w* \w que fazem|strong="G4160"\w* \w sinais|strong="G4592"\w*, \w os quais|strong="G3739"\w* \w saem|strong="G1607"\w* \w até os reis|strong="G1909,G3588,G935"\w* \w de todo o mundo habitado|strong="G3588,G3625,G3650"\w*, \w para os reunir|strong="G4863,G846"\w* \w para a guerra|strong="G1519,G3588,G4171"\w* \w do grande dia|strong="G3588,G2250,G3173"\w* \w de Deus|strong="G3588,G2316"\w*, \w o Todo-Poderoso|strong="G3588,G3841"\w*—\f + \fr 16.14: \ft Variante: o TR acrescenta “da terra e” (τῆς γῆς καὶ) antes de “de todo o mundo habitado”; o RP acrescenta “aquele” (ἐκείνης) depois de “dia”.\f*\x - \xo 16:14 \xt REV 19:19; REV 17:14; MAT 24:14; 1TI 4:1; REV 1:8; REV 20:8\x*
\v 15 \w Olhem|strong="G2400"\w*, \w venho|strong="G2064"\w* \w como ladrão|strong="G5613,G2812"\w*. \w Feliz|strong="G3107"\w* \w o que vigia|strong="G3588,G1127"\w* \w e|strong="G2532"\w* \w guarda|strong="G5083"\w* \w as suas roupas|strong="G3588,G2440,G846"\w*, \w para que não|strong="G2443,G3361"\w* \w ande|strong="G4043"\w* \w nu|strong="G1131"\w* \w e|strong="G2532"\w* \w vejam|strong="G991"\w* \w a sua vergonha|strong="G3588,G808,G846"\w*—\f + \fr 16.15: \ft Nota cultural: a vinda como ladrão repete a advertência de Mt 24:43-44 e 1Ts 5:2; ἀσχημοσύνη, “vergonha, nudez”.\f*\x - \xo 16:15 \xt 1TH 5:2; MAT 24:43-44; REV 3:3; 1CO 16:13; MAT 26:41; REV 3:18\x*
\v 16 \w E|strong="G2532"\w* \w os reuniu|strong="G4863,G846"\w* \w no lugar|strong="G1519,G3588,G5117"\w* \w chamado|strong="G3588,G2564"\w* \w em hebraico|strong="G1447"\w* \w Armagedom|strong="G717"\w*.\f + \fr 16.16: \ft Lit.: Ἁρμαγεδών provavelmente transcreve o hebraico har Megiddô, “monte de Megido”; a etimologia é discutida.\f*\f + \fr 16.16: \ft Nota cultural: Megido, planície do norte de Israel, foi cenário de batalhas decisivas (Jz 5:19; 2Rs 23:29).\f*\x - \xo 16:16 \xt JDG 5:19; 2KI 23:29; REV 19:19; ZEC 12:11; REV 21:9; REV 16:14\x*
\v 17 \w E|strong="G2532"\w* \w o sétimo|strong="G3588,G1442"\w* \w derramou|strong="G1632"\w* \w a sua taça|strong="G3588,G5357,G846"\w* \w sobre o ar|strong="G1909,G3588,G109"\w* — \w e|strong="G2532"\w* \w saiu|strong="G1831"\w* \w uma grande|strong="G3173"\w* \w voz|strong="G5456"\w* \w do santuário|strong="G1537,G3588,G3485"\w*, \w do trono|strong="G575,G3588,G2362"\w*, \w dizendo|strong="G3004"\w*: “\w Está feito|strong="G1096"\w*!”\f + \fr 16.17: \ft Lit.: Γέγονεν, “aconteceu, está feito, veio a ser”; cf. 21:6.\f*\f + \fr 16.17: \ft Variante: o TR acrescenta “anjo” (ἄγγελος) depois de “o sétimo” e “do céu” (τοῦ οὐρανοῦ) depois de “santuário”; o RP traz ἀπό em lugar de ἐκ.\f*\x - \xo 16:17 \xt REV 16:1; REV 11:15; DAN 12:1; REV 4:5; JHN 19:30; REV 21:6\x*
\v 18 \w e|strong="G2532"\w* \w houve|strong="G1096"\w* \w relâmpagos|strong="G796"\w* \w e|strong="G2532"\w* \w vozes|strong="G5456"\w* \w e|strong="G2532"\w* \w trovões|strong="G1027"\w*, \w e|strong="G2532"\w* \w houve|strong="G1096"\w* \w um grande|strong="G3173"\w* \w terremoto|strong="G4578"\w*, \w como|strong="G3634"\w* \w não|strong="G3756"\w* \w houve|strong="G1096"\w* \w desde que|strong="G575,G3739"\w* \w existem|strong="G1096"\w* \w seres humanos|strong="G444"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*, \w um terremoto|strong="G4578"\w* \w tão grande|strong="G3779,G3173"\w* \add e\add* \w poderoso|strong="G5082"\w*.\f + \fr 16.18: \ft Variante: WH traz ἄνθρωποι ἐγένοντο (“existiram seres humanos”); o RP traz οἱ ἄνθρωποι ἐγένοντο; Treg e NA28 trazem ἄνθρωπος ἐγένετο (“existiu um ser humano”); o RP inverte “trovões e vozes” e omite “houve” (ἐγένετο) depois de “terremoto”.\f*\f + \fr 16.18: \ft Acréscimo: “e” (em “tão grande e poderoso”): conectivo acrescentado para ligar as orações em português.\f*\x - \xo 16:18 \xt REV 11:19; REV 8:5; REV 4:5; DAN 12:1; REV 6:12; 1KI 19:11\x*
\v 19 \w E|strong="G2532"\w* \w a grande cidade|strong="G3588,G4172,G3173"\w* \w ficou dividida|strong="G1096"\w* \w em três|strong="G1519,G5140"\w* \w partes|strong="G3313"\w*, \w e|strong="G2532"\w* \w as cidades|strong="G3588,G4172"\w* \w das nações|strong="G3588,G1484"\w* \w caíram|strong="G4098"\w*; \w e|strong="G2532"\w* \w Babilônia|strong="G897"\w*, \w a grande|strong="G3588,G3173"\w*, \w foi lembrada|strong="G3403"\w* \w diante de Deus|strong="G1799,G3588,G2316"\w*, \w para dar|strong="G1325"\w* \w a ela|strong="G846"\w* \w o cálice|strong="G3588,G4221"\w* \w do vinho|strong="G3588,G3631"\w* \w do furor|strong="G3588,G2372"\w* \w da ira|strong="G3588,G3709"\w* \w dele|strong="G846"\w*;\x - \xo 16:19 \xt REV 14:8; REV 14:10; PSA 75:8; ZEC 13:8; DAN 12:1; REV 17:18\x*
\v 20 \w e|strong="G2532"\w* \w toda ilha|strong="G3956,G3520"\w* \w fugiu|strong="G5343"\w*, \w e|strong="G2532"\w* \w montes|strong="G3735"\w* \w não|strong="G3756"\w* \w foram achados|strong="G2147"\w*.\x - \xo 16:20 \xt REV 6:14; REV 20:11; MAT 24:16; DAN 12:1; PSA 46:3; ISA 30:30\x*
\v 21 \w E|strong="G2532"\w* \w um grande|strong="G3173"\w* \w granizo|strong="G5464"\w*, \w do peso de um talento|strong="G5613,G5006"\w*, \w desce|strong="G2597"\w* \w do céu|strong="G1537,G3588,G3772"\w* \w sobre os seres humanos|strong="G1909,G3588,G444"\w*; \w e|strong="G2532"\w* \w blasfemaram|strong="G987"\w* \w os seres humanos|strong="G3588,G444"\w* \w contra Deus|strong="G3588,G2316"\w* \w por causa da praga|strong="G1537,G3588,G4127"\w* \w do granizo|strong="G3588,G5464"\w*, \w porque|strong="G3754"\w* \w a sua praga|strong="G3588,G4127,G846"\w* \w é|strong="G1510"\w* \w muito grande|strong="G3173,G4970"\w*.\f + \fr 16.21: \ft Lit.: Ταλαντιαῖος, “do peso de um talento” (cerca de 30 a 40 kg).\f*\x - \xo 16:21 \xt REV 16:9; REV 22:11; DAN 12:1; REV 11:19; JOS 10:11; JOB 38:23\x*
\c 17
\p
\v 1 \w E|strong="G2532"\w* \w veio|strong="G2064"\w* \w um|strong="G1520"\w* \w dos sete|strong="G1537,G3588,G2033"\w* \w anjos|strong="G32"\w* \w que tinham|strong="G3588,G2192"\w* \w as sete taças|strong="G3588,G2033,G5357"\w*, \w e|strong="G2532"\w* \w falou|strong="G2980"\w* \w comigo|strong="G3326,G1473"\w*, \w dizendo|strong="G3004"\w*: “\w Venha|strong="G1204"\w*, \w mostrarei|strong="G1166"\w* \w a você|strong="G4771"\w* \w o julgamento|strong="G3588,G2917"\w* \w da grande prostituta|strong="G3588,G4204,G3173"\w* \w que está sentada|strong="G3588,G2521"\w* \w sobre muitas águas|strong="G1909,G5204,G4183"\w*,\f + \fr 17.1: \ft Lit.: Κρίμα, “julgamento, sentença”; πόρνη, “prostituta”.\f*\f + \fr 17.1: \ft Variante: o TR acrescenta “a mim” (μοι) depois de “dizendo”; o RP traz “as muitas águas” com artigos (τῶν ὑδάτων τῶν πολλῶν).\f*\x - \xo 17:1 \xt REV 21:9; REV 17:15; REV 19:2; JER 51:13; REV 17:1; REV 16:19\x*
\v 2 \w com a qual|strong="G3326,G3739"\w* \w se prostituíram|strong="G4203"\w* \w os reis|strong="G3588,G935"\w* \w da terra|strong="G3588,G1093"\w*, \w e|strong="G2532"\w* \w se embriagaram|strong="G3182"\w* \w os que habitam|strong="G3588,G2730"\w* \w a terra|strong="G3588,G1093"\w* \w com o vinho|strong="G1537,G3588,G3631"\w* \w da sua prostituição|strong="G3588,G4202,G846"\w*.”\f + \fr 17.2: \ft Nota cultural: a prostituição dos reis e das nações com Babilônia ecoa a denúncia de Tiro e de Nínive em Is 23:17 e Na 3:4.\f*\x - \xo 17:2 \xt NAM 3:4; ISA 23:17; REV 18:3; REV 17:1; REV 2:22; REV 14:8\x*
\v 3 \w e|strong="G2532"\w* \w me levou|strong="G667,G3165"\w* \w ao deserto|strong="G1519,G2048"\w* \w em espírito|strong="G1722,G4151"\w*. \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w uma mulher|strong="G1135"\w* \w sentada|strong="G2521"\w* \w sobre uma fera|strong="G1909,G2342"\w* \w escarlate|strong="G2847"\w*, \w cheia|strong="G1073"\w* \w de nomes|strong="G3686"\w* \w de blasfêmia|strong="G988"\w*, \w que tinha|strong="G2192"\w* \w sete cabeças|strong="G2776,G2033"\w* \w e|strong="G2532"\w* \w dez chifres|strong="G2768,G1176"\w*.\f + \fr 17.3: \ft Nota cultural: a fera escarlate com sete cabeças e dez chifres é a mesma de 13:1; a mulher que a cavalga é descrita com as cores e riquezas de uma cidade luxuosa.\f*\x - \xo 17:3 \xt REV 13:1; REV 17:7; REV 12:3; REV 17:1; REV 1:10; REV 12:14\x*
\v 4 \w E|strong="G2532"\w* \w a mulher|strong="G3588,G1135"\w* \w estava|strong="G1510"\w* \w vestida|strong="G4016"\w* \w de púrpura|strong="G4210"\w* \w e|strong="G2532"\w* \w escarlate|strong="G2847"\w*, \w e|strong="G2532"\w* \w adornada|strong="G5558"\w* \w de ouro|strong="G5553"\w* \w e|strong="G2532"\w* \w de pedra|strong="G3037"\w* \w preciosa|strong="G5093"\w* \w e|strong="G2532"\w* \w de pérolas|strong="G3135"\w*, \w tendo|strong="G2192"\w* \w um cálice|strong="G4221"\w* \w de ouro|strong="G5552"\w* \w na mão|strong="G1722,G3588,G5495"\w* \w dela|strong="G846"\w* \w cheio|strong="G1073"\w* \w de abominações|strong="G946"\w* \w e|strong="G2532"\w* \w das impurezas|strong="G3588,G169"\w* \w da sua prostituição|strong="G3588,G4202,G846"\w*,\f + \fr 17.4: \ft Lit.: Βδέλυγμα, “abominação, coisa detestável”, termo ligado à idolatria no AT; ἀκάθαρτα, “impurezas, coisas impuras”.\f*\f + \fr 17.4: \ft Variante: o RP omite “e” (καί) antes de “adornada”; Treg traz “ouro” em outra forma (χρυσῷ) em lugar de χρυσίῳ.\f*\x - \xo 17:4 \xt REV 18:16; JER 51:7; REV 17:1; REV 19:2; REV 18:12; REV 21:21\x*
\v 5 \w e|strong="G2532"\w* \w sobre a testa|strong="G1909,G3588,G3359"\w* \w dela|strong="G846"\w* \w um nome|strong="G3686"\w* \w escrito|strong="G1125"\w*: \w um mistério|strong="G3466"\w*, \w Babilônia|strong="G897"\w*, \w a grande|strong="G3588,G3173"\w*, \w a mãe|strong="G3588,G3384"\w* \w das prostitutas|strong="G3588,G4204"\w* \w e|strong="G2532"\w* \w das abominações|strong="G3588,G946"\w* \w da terra|strong="G3588,G1093"\w*.\f + \fr 17.5: \ft Lit.: Μυστήριον pode fazer parte da inscrição (“Mistério: Babilônia…”) ou qualificar “nome” (“um nome, um mistério”).\f*\f + \fr 17.5: \ft Nota cultural: a mãe das prostitutas e a grande Babilônia: nome simbólico da potência opressora; ecoa Is 47 e Jr 50–51.\f*\x - \xo 17:5 \xt REV 14:8; REV 17:1; REV 18:2; REV 16:19; REV 17:7; 2TH 2:7\x*
\v 6 \w E|strong="G2532"\w* \w vi|strong="G1492"\w* \w a mulher|strong="G3588,G1135"\w* \w embriagada|strong="G3184"\w* \w do sangue|strong="G1537,G3588,G129"\w* \w dos santos|strong="G3588,G40"\w* \w e|strong="G2532"\w* \w do sangue|strong="G1537,G3588,G129"\w* \w das testemunhas|strong="G3588,G3144"\w* \w de Jesus|strong="G2424"\w*. \w E|strong="G2532"\w* \w me maravilhei|strong="G2296"\w* \w ao vê-la|strong="G1492,G846"\w* \w com grande|strong="G3173"\w* \w assombro|strong="G2295"\w*.\f + \fr 17.6: \ft Lit.: Μάρτυς, “testemunha”, aqui também no sentido de quem dá testemunho até a morte.\f*\f + \fr 17.6: \ft Variante: o RP omite “e” (καί) antes de “do sangue das testemunhas”.\f*\x - \xo 17:6 \xt REV 16:6; REV 17:1; REV 18:24; REV 7:14; REV 13:15; DAN 7:25\x*
\v 7 \w E|strong="G2532"\w* \w o anjo|strong="G3588,G32"\w* \w me disse|strong="G2036,G3165"\w*: “\w Por que|strong="G1223,G5101"\w* \w você se maravilhou|strong="G2296"\w*? \w Eu|strong="G1473"\w* \w direi|strong="G4483"\w* \w a você|strong="G4771"\w* \w o mistério|strong="G3588,G3466"\w* \w da mulher|strong="G3588,G1135"\w* \w e|strong="G2532"\w* \w da fera|strong="G3588,G2342"\w* \w que a leva|strong="G3588,G941,G846"\w*, \w a que tem|strong="G3588,G2192"\w* \w as sete cabeças|strong="G3588,G2033,G2776"\w* \w e|strong="G2532"\w* \w os dez chifres|strong="G3588,G1176,G2768"\w*:\x - \xo 17:7 \xt REV 13:1; REV 17:3; REV 12:3; REV 17:1; REV 17:5; 1TI 3:16\x*
\v 8 \w A fera|strong="G3588,G2342"\w* \w que|strong="G3739"\w* \w você viu|strong="G1492"\w* \w era|strong="G1510"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w é|strong="G1510"\w*, \w e|strong="G2532"\w* \w está para|strong="G3195"\w* \w subir|strong="G305"\w* \w do abismo|strong="G1537,G3588,G12"\w*, \w e|strong="G2532"\w* \w vai|strong="G5217"\w* \w para a destruição|strong="G1519,G684"\w*; \w e|strong="G2532"\w* \w se maravilharão|strong="G2296"\w* \w os que habitam|strong="G3588,G2730"\w* \w sobre a terra|strong="G1909,G3588,G1093"\w*, \w cujo nome|strong="G3739,G3588,G3686"\w* \w não|strong="G3756"\w* \w foi escrito|strong="G1125"\w* \w no livro|strong="G1909,G3588,G975"\w* \w da vida|strong="G3588,G2222"\w* \w desde a fundação|strong="G575,G2602"\w* \w do mundo|strong="G2889"\w*, \w ao verem|strong="G991"\w* \w a fera|strong="G3588,G2342"\w*, \w porque|strong="G3754"\w* \w era|strong="G1510"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w é|strong="G1510"\w* \w e|strong="G2532"\w* \w estará presente|strong="G3918"\w*.\f + \fr 17.8: \ft Lit.: Ἀπώλεια, “destruição, perdição”; παρέσται, “estará presente, virá a estar”.\f*\f + \fr 17.8: \ft Nota cultural: o enigma “era, não é e há de reaparecer” parodia o título divino “aquele que é, que era e que vem” (1:4, 8; 4:8).\f*\f + \fr 17.8: \ft Variante: o TR traz ἔστιν (“é”) em lugar de παρέσται (“estará presente”); Treg e o RP trazem ὑπάγειν (“ir”) e θαυμάσονται; o RP traz “os nomes” (τὰ ὀνόματα) em lugar de “o nome”.\f*\x - \xo 17:8 \xt REV 13:8; REV 17:11; EPH 1:4; REV 3:5; REV 11:7; MAT 25:34\x*
\p
\v 9 \w Aqui|strong="G5602"\w* \w está a mente|strong="G3588,G3563"\w* \w que tem|strong="G3588,G2192"\w* \w sabedoria|strong="G4678"\w*: \w as sete cabeças|strong="G3588,G2033,G2776"\w* \w são|strong="G1510"\w* \w sete montes|strong="G2033,G3735"\w*, \w onde|strong="G3699"\w* \w a mulher|strong="G3588,G1135"\w* \w está sentada|strong="G2521"\w* \w sobre eles|strong="G1909,G846"\w*; \w e|strong="G2532"\w* \w são|strong="G1510"\w* \w sete reis|strong="G935,G2033"\w*;\f + \fr 17.9: \ft Nota cultural: os sete montes e a mulher assentada sobre eles sugerem a cidade de Roma, mas o texto não a nomeia; a explicação do anjo mistura montes e reis.\f*\f + \fr 17.9: \ft Acréscimo: verbo ser/estar suprido em “está a mente”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula.\f*\x - \xo 17:9 \xt REV 17:1; REV 13:18; REV 12:3; REV 17:3; ZEC 5:7; DAN 12:4\x*
\v 10 \w os cinco|strong="G3588,G4002"\w* \w caíram|strong="G4098"\w*, \w um|strong="G3588,G1520"\w* \w é|strong="G1510"\w*, \w o outro|strong="G3588,G243"\w* \w ainda não|strong="G3768"\w* \w veio|strong="G2064"\w*, \w e|strong="G2532"\w* \w quando|strong="G3752"\w* \w vier|strong="G2064"\w*, \w é necessário|strong="G1163"\w* \w que ele|strong="G846"\w* \w permaneça|strong="G3306"\w* \w por pouco tempo|strong="G3641"\w*.\x - \xo 17:10 \xt REV 17:1; REV 12:3; REV 13:12; REV 17:3; ZEC 5:7; ISA 13:1\x*
\v 11 \w E|strong="G2532"\w* \w a fera|strong="G3588,G2342"\w* \w que|strong="G3739"\w* \w era|strong="G1510"\w* \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w é|strong="G1510"\w*, \w também|strong="G2532"\w* \w ela mesma|strong="G846"\w* \w é o oitavo|strong="G3590,G1510"\w*, \w e|strong="G2532"\w* \w é|strong="G1510"\w* \w dos sete|strong="G1537,G3588,G2033"\w*, \w e|strong="G2532"\w* \w vai|strong="G5217"\w* \w para a destruição|strong="G1519,G684"\w*.\f + \fr 17.11: \ft Variante: Treg traz οὗτος (“este”) em lugar de αὐτός (“ele mesmo”).\f*\x - \xo 17:11 \xt REV 17:8; REV 17:1; 2TH 2:3; REV 13:12; REV 17:3; ZEC 5:7\x*
\v 12 \w E|strong="G2532"\w* \w os dez|strong="G3588,G1176"\w* \w chifres|strong="G2768"\w* \w que|strong="G3739"\w* \w você viu|strong="G1492"\w* \w são|strong="G1510"\w* \w dez reis|strong="G1176,G935"\w*, \w os quais|strong="G3748"\w* \w ainda não|strong="G3768"\w* \w receberam|strong="G2983"\w* \w reino|strong="G932"\w*, \w mas|strong="G235"\w* \w recebem|strong="G2983"\w* \w autoridade|strong="G1849"\w* \w como reis|strong="G5613,G935"\w* \w por uma hora|strong="G1520,G5610"\w* \w com a fera|strong="G3326,G3588,G2342"\w*.\x - \xo 17:12 \xt REV 13:1; REV 17:16; REV 17:3; PSA 2:2; ACT 4:26; ACT 5:39\x*
\v 13 \w Estes|strong="G3778"\w* \w têm|strong="G2192"\w* \w um só|strong="G1520"\w* \w propósito|strong="G1106"\w*, \w e|strong="G2532"\w* \w entregam|strong="G1325"\w* \w o seu poder|strong="G3588,G1411,G846"\w* \w e|strong="G2532"\w* \w autoridade|strong="G1849"\w* \w à fera|strong="G3588,G2342"\w*.\f + \fr 17.13: \ft Lit.: Γνώμη, “propósito, opinião, parecer”.\f*\x - \xo 17:13 \xt REV 17:17; PSA 2:2; ACT 4:26; ACT 5:39; REV 17:1; PSA 110:5\x*
\v 14 \w Estes|strong="G3778"\w* \w farão guerra|strong="G4170"\w* \w contra o cordeiro|strong="G3326,G3588,G721"\w*, \w e|strong="G2532"\w* \w o cordeiro|strong="G3588,G721"\w* \w os vencerá|strong="G3528,G846"\w*, \w porque|strong="G3754"\w* \w é|strong="G1510"\w* \w Senhor|strong="G2962"\w* \w de senhores|strong="G2962"\w* \w e|strong="G2532"\w* \w Rei|strong="G935"\w* \w de reis|strong="G935"\w*, \w e|strong="G2532"\w* \w os que estão com ele|strong="G3588,G3326,G846"\w* \w são chamados|strong="G2822"\w* \w e|strong="G2532"\w* \w escolhidos|strong="G1588"\w* \w e|strong="G2532"\w* \w fiéis|strong="G4103"\w*.”\f + \fr 17.14: \ft Nota cultural: “Senhor de senhores e Rei de reis” ecoa Dt 10:17 e Dn 2:47; cf. 19:16.\f*\f + \fr 17.14: \ft Acréscimo: verbo ser/estar suprido em “são chamados”: o grego não traz verbo nesses trechos (oração nominal) e o português exige a cópula; “os que estão com ele”: o grego usa artigo e preposição, sem verbo; o português pede “que está/estão”.\f*\x - \xo 17:14 \xt DAN 2:47; DEU 10:17; MAT 22:14; ROM 8:30; REV 1:5; REV 19:16\x*
\v 15 \w E|strong="G2532"\w* \w me disse|strong="G3004,G3165"\w*: “\w As águas|strong="G3588,G5204"\w* \w que|strong="G3739"\w* \w você viu|strong="G1492"\w*, \w onde|strong="G3757"\w* \w a prostituta|strong="G3588,G4204"\w* \w está sentada|strong="G2521"\w*, \w são|strong="G1510"\w* \w povos|strong="G2992"\w* \w e|strong="G2532"\w* \w multidões|strong="G3793"\w* \w e|strong="G2532"\w* \w nações|strong="G1484"\w* \w e|strong="G2532"\w* \w línguas|strong="G1100"\w*.”\x - \xo 17:15 \xt REV 17:1; REV 10:11; REV 13:7; ISA 59:19; 2SA 22:17; ISA 8:7\x*
\v 16 \w E|strong="G2532"\w* \w os dez|strong="G3588,G1176"\w* \w chifres|strong="G2768"\w* \w que|strong="G3739"\w* \w você viu|strong="G1492"\w*, \w e|strong="G2532"\w* \w a fera|strong="G3588,G2342"\w*, \w estes|strong="G3778"\w* \w odiarão|strong="G3404"\w* \w a prostituta|strong="G3588,G4204"\w*, \w e|strong="G2532"\w* \w a deixarão|strong="G4160,G846"\w* \w desolada|strong="G2049"\w* \w e|strong="G2532"\w* \w nua|strong="G1131"\w*, \w e|strong="G2532"\w* \w comerão|strong="G5315"\w* \w as carnes|strong="G3588,G4561"\w* \w dela|strong="G846"\w*, \w e|strong="G2532"\w* \w a queimarão|strong="G846,G2618"\w* \w com fogo|strong="G1722,G4442"\w*;\f + \fr 17.16: \ft Nota cultural: a destruição da prostituta ecoa Ez 16:37-41 e 23:25-29.\f*\f + \fr 17.16: \ft Variante: o TR traz “sobre” (ἐπί) em lugar de “e” (καί) antes de “a fera”: “os dez chifres que você viu sobre a fera”; o RP repete “a deixarão” (ποιήσουσιν αὐτήν) depois de “nua”.\f*\x - \xo 17:16 \xt EZK 16:37; EZK 23:25-29; REV 17:12; REV 13:1; REV 17:1; REV 18:8\x*
\v 17 \w pois|strong="G1063"\w* \w Deus|strong="G3588,G2316"\w* \w pôs|strong="G1325"\w* \w nos corações|strong="G1519,G3588,G2588"\w* \w deles|strong="G846"\w* \w fazer|strong="G4160"\w* \w o propósito|strong="G3588,G1106"\w* \w dele|strong="G846"\w*, \w e|strong="G2532"\w* \w fazer|strong="G4160"\w* \w um só|strong="G1520"\w* \w propósito|strong="G1106"\w*, \w e|strong="G2532"\w* \w dar|strong="G1325"\w* \w o reino|strong="G3588,G932"\w* \w deles|strong="G846"\w* \w à fera|strong="G3588,G2342"\w*, \w até que|strong="G891"\w* \w se cumpram|strong="G5055"\w* \w as palavras|strong="G3588,G3056"\w* \w de Deus|strong="G3588,G2316"\w*.\f + \fr 17.17: \ft Lit.: δίδωμι εἰς, “dar para dentro, pôr”.\f*\x - \xo 17:17 \xt REV 17:13; REV 17:1; 2TH 2:10-12; 2CO 8:16; EZR 7:27; DAN 3:3\x*
\v 18 \w E|strong="G2532"\w* \w a mulher|strong="G3588,G1135"\w* \w que|strong="G3739"\w* \w você viu|strong="G1492"\w* \w é|strong="G1510"\w* \w a grande cidade|strong="G3588,G4172,G3173"\w*, \w a que tem|strong="G3588,G2192"\w* \w reino|strong="G932"\w* \w sobre os reis|strong="G1909,G3588,G935"\w* \w da terra|strong="G3588,G1093"\w*.\x - \xo 17:18 \xt REV 16:19; REV 17:3; REV 18:2; ZEC 5:7; ISA 13:1; REV 14:8\x*
