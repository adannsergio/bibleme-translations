\v 19 \w Conheço|strong="G6063"\w* \w as suas|strong="G4771,G3588"\w* \w obras|strong="G2041"\w*, \w e|strong="G2532"\w* \w o amor|strong="G3588,G26"\w* \w e|strong="G2532"\w* \w a fé|strong="G3588,G4102"\w* \w e|strong="G2532"\w* \w o serviço|strong="G3588,G1248"\w* \w e|strong="G2532"\w* \w a perseverança|strong="G3588,G5281"\w* \w sua|strong="G4771"\w*, \w e|strong="G2532"\w* \w as obras|strong="G3588,G2041"\w* \w suas|strong="G4771"\w* \w as últimas|strong="G3588,G2078"\w* \w mais numerosas|strong="G4119"\w* \w do que as primeiras|strong="G3588,G4413"\w*.\x - \xo 2:19 \xt 1TH 1:3; 1CO 8:3; REV 2:2; REV 3:1; 1TI 1:5; JHN 1:48\x*
\v 20 \w Mas|strong="G235"\w* \w tenho|strong="G2192"\w* \w contra você|strong="G2596,G4771"\w* \w que|strong="G3754"\w* \w tolera|strong="G863"\w* \w a mulher|strong="G3588,G1135"\w* \w Jezabel|strong="G2403"\w*, \w aquela que diz|strong="G3588,G3004"\w* \w a si mesma|strong="G1438"\w* \w profetisa|strong="G4398"\w*, \w e|strong="G2532"\w* \w ensina|strong="G1321"\w* \w e|strong="G2532"\w* \w engana|strong="G4105"\w* \w os meus|strong="G3588,G1473"\w* \w servos|strong="G1401"\w* \w a se prostituírem|strong="G4203"\w* \w e|strong="G2532"\w* \w comerem|strong="G5315"\w* \w coisas sacrificadas a ídolos|strong="G1494"\w*.\f + \fr 2.20: \ft Nota cultural: o nome “Jezabel” evoca a rainha de Israel (1Rs 16:31; 2Rs 9:22), símbolo de idolatria e imoralidade; pode ser nome simbólico.\f*\f + \fr 2.20: \ft Variante: o RP acrescenta “sua” (σοῦ) depois de “mulher” e traz λέγει (“diz”) em lugar de λέγουσα.\f*\f + \fr 2.20: \ft Tradução: ἀφεῖς (ἀφίημι, G863) está aqui como “tolera”; o termo pode ser “deixar”, “perdoar”, “permitir”, “abandonar” ou “mandar embora”, e o contexto decide; δούλους (δοῦλος, G1401) está aqui como “servos”; o termo pode ser “escravo” (condição social), “servo” ou “servidor”, e o contexto decide.\f*\x - \xo 2:20 \xt 1KI 16:31; 2KI 9:22; REV 2:14; 1CO 10:18-21; 2TI 3:8; GAL 3:1\x*
\v 21 \w E|strong="G2532"\w* \w dei|strong="G1325"\w* \w a ela|strong="G846"\w* \w tempo|strong="G5550"\w* \w para que|strong="G2443"\w* \w se arrependesse|strong="G3340"\w*, \w e|strong="G2532"\w* \w não|strong="G3756"\w* \w quer|strong="G2309"\w* \w arrepender-se|strong="G3340"\w* \w da|strong="G1537,G3588"\w* \w prostituição|strong="G4202"\w* \w dela|strong="G846"\w*.\f + \fr 2.21: \ft Variante: o TR omite “quer” (θέλει).\f*\x - \xo 2:21 \xt 2PE 3:9; REV 2:5; 1CO 5:1; JHN 5:14; REV 2:2; ROM 2:4-5\x*
\v 22 \w Olhem|strong="G2400"\w*, \w lanço|strong="G906"\w*-\w a|strong="G846"\w* \w numa cama|strong="G1519,G2825"\w*, \w e|strong="G2532"\w* \w os que cometem adultério|strong="G3588,G3431"\w* \w com ela|strong="G3326,G846"\w* \w em aflição|strong="G1519,G2347"\w* \w grande|strong="G3173"\w*, \w se não|strong="G1437,G3361"\w* \w se arrependerem|strong="G3340"\w* \w das obras|strong="G1537,G3588,G2041"\w* \w dela|strong="G846"\w*;\f + \fr 2.22: \ft Variante: WH traz o futuro μετανοήσουσιν (“se arrependerão”) em lugar do subjuntivo μετανοήσωσιν; o TR traz “delas” (αὐτῶν) em lugar de “dela” (αὐτῆς).\f*\f + \fr 2.22: \ft Lit.: Κλίνη, “cama, leito”: provavelmente um leito de doença ou sofrimento, em contraste com o leito do adultério.\f*\x - \xo 2:22 \xt REV 2:5; JHN 5:14; REV 17:2; EZK 16:37-41; LUK 13:3; LUK 13:5\x*
\v 23 \w e|strong="G2532"\w* \w os filhos|strong="G3588,G5043"\w* \w dela|strong="G846"\w* \w matarei|strong="G615"\w* \w com peste|strong="G1722,G2288"\w*; \w e|strong="G2532"\w* \w saberão|strong="G1097"\w* \w todas|strong="G3956"\w* \w as comunidades|strong="G3588,G1577"\w* \w que|strong="G3754"\w* \w eu|strong="G1473"\w* \w sou|strong="G1510"\w* \w aquele que examina|strong="G3588,G2045"\w* \w rins|strong="G3510"\w* \w e|strong="G2532"\w* \w corações|strong="G2588"\w*, \w e|strong="G2532"\w* \w darei|strong="G1325"\w* \w a vocês|strong="G4771"\w* \w a cada um|strong="G1538"\w* \w segundo|strong="G2596"\w* \w as obras|strong="G3588,G2041"\w* \w de vocês|strong="G4771"\w*\f + \fr 2.23: \ft Nota cultural: ecoa Jr 17:10 e Sl 7:9 (Deus examina rins e coração).\f*\f + \fr 2.23: \ft Lit.: Ἐν θανάτῳ, “com morte”: possivelmente “com peste” (como em 6:8).\f*.\f + \fr 2.23: \ft Lit.: Νεφροὺς καὶ καρδίας, “rins e corações”: na linguagem bíblica, os rins são a sede das emoções e dos pensamentos mais íntimos; a expressão designa o ser interior da pessoa.\f*\x - \xo 2:23 \xt JER 17:10; PSA 7:9; ROM 2:6; ROM 8:27; HEB 4:12; PSA 139:1\x*
\v 24 \w A vocês|strong="G4771"\w*, \w porém|strong="G1161"\w*, \w digo|strong="G3004"\w*, \w aos demais|strong="G3588,G3062"\w* \w em Tiatira|strong="G3588,G1722,G2363"\w*, \w quantos|strong="G3745"\w* \w não|strong="G3756"\w* \w têm|strong="G2192"\w* \w esta doutrina|strong="G3588,G1322,G3778"\w*, \w os quais|strong="G3748"\w* \w não|strong="G3756"\w* \w conheceram|strong="G1097"\w* \w as profundezas|strong="G3588,G901"\w* \w de Satanás|strong="G3588,G4567"\w*, \w como dizem|strong="G5613,G3004"\w*; \w não|strong="G3756"\w* \w lanço|strong="G906"\w* \w sobre vocês|strong="G1909,G4771"\w* \w outro|strong="G243"\w* \w peso|strong="G922"\w*\f + \fr 2.24: \ft Variante: o TR traz “e” (καί) em lugar de “aos” (τοῖς) diante de “demais”.\f*;\x - \xo 2:24 \xt EPH 6:11; LUK 11:9; 2CO 2:11; 2CO 11:3; REV 12:9; 2CO 11:13-15\x*
