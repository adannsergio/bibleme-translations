\c 21
\p
\v 1 \w E David foi|strong="H0935,H1732"\w* \w a Nobe|strong="H5011"\w*, \w a|strong="H0413"\w* \w Aimeleque|strong="H0288"\w*, \w o sacerdote|strong="H3548"\w*; \w e Aimeleque teve medo|strong="H2729,H0288"\w* \w ao encontrar|strong="H7122"\w* \w David|strong="H1732"\w*, \w e lhe disse|strong="H0559,H9033"\w*: \add "Por\add* \w que|strong="H4069"\w* \w você|strong="H0859"\w* \w está sozinho|strong="H0905"\w*, \w e não há|strong="H0376,H0369"\w* ninguém \w com você|strong="H0854"\w*?"\x - \xo 21:1 \xt 1SA 22:11; 1SA 16:4; MRK 2:26; NEH 11:32; 1SA 14:3; ISA 10:32\x*
\v 2 \w E David disse|strong="H0559,H1732"\w* \w a Aimeleque|strong="H0288"\w*, \w o sacerdote|strong="H3548"\w*: "\w O rei|strong="H4428"\w* \w ordenou-me|strong="H6680"\w* \w uma missão|strong="H1697"\w*, \w e disse|strong="H0559"\w* \add a\add* \w mim|strong="H0413"\w*: '\w Ninguém|strong="H0376"\w* \w saiba|strong="H0408,H3045"\w* \w nada|strong="H3972"\w* \w do assunto|strong="H1697"\w* \w que|strong="H0834"\w* \w eu|strong="H0595"\w* \add te\add* \w envio|strong="H7971"\w* \w e do que|strong="H0834"\w* \add te\add* \w ordenei|strong="H6680"\w*; \w e|strong="H0853"\w* \w aos moços|strong="H5288"\w* \w indiquei|strong="H3045"\w* \w um lugar|strong="H0413,H4725"\w* \w tal e tal|strong="H6423,H0492"\w*.'"\x - \xo 21:2 \xt 2KI 6:8; COL 3:9; GAL 2:12; GEN 27:24\x*
\v 3 \w E agora|strong="H6258"\w*, \add o\add* \w que|strong="H4100,H3426"\w* \w tens à mão|strong="H8478,H3027"\w*? \w Dá-me|strong="H5414"\w* \w cinco|strong="H2568"\w* \w pães|strong="H3899"\w* \w na minha mão|strong="H3027"\w*, \w ou|strong="H0176"\w* \w o que se encontrar|strong="H4672"\w*.\x - \xo 21:3 \xt LUK 6:3; MAT 12:3; MRK 2:25\x*
\p
\v 4 \w E o sacerdote respondeu|strong="H6030,H3548"\w* \add a\add* \w David|strong="H1732"\w*, \w e disse|strong="H0559"\w*: "\w Não|strong="H0369"\w* \add há\add* \w pão comum|strong="H3899,H2455"\w* \w à minha mão|strong="H0413,H8478,H3027"\w*; \w mas somente|strong="H3588,H0518"\w* \w pão sagrado|strong="H3899,H6944"\w* \w há|strong="H3426"\w*, \w se|strong="H0518"\w* \add se\add* \w guardaram|strong="H8104"\w* \w os moços|strong="H5288"\w*, \w ao menos|strong="H0389"\w* \w de mulher|strong="H0802"\w*."\x - \xo 21:4 \xt LUK 6:3; MAT 12:3; MRK 2:25; EXO 19:15; EXO 25:30; LEV 24:5\x*
\v 5 \w E David respondeu|strong="H6030,H1732"\w* \w ao sacerdote|strong="H3548"\w*, \w e lhe disse|strong="H0559,H9033"\w*: "\w Certamente|strong="H3588,H0518"\w* \w mulher|strong="H0802"\w* \add nos foi\add* \w vedada|strong="H6113,H9035"\w* \w desde ontem|strong="H8543,H8032"\w*, \w quando|strong="H3318"\w* \w saí|strong="H3318"\w*; \w e eram|strong="H1961"\w* \w os vasos|strong="H3627"\w* \w dos moços|strong="H5288"\w* \w santos|strong="H6944"\w*, \w ainda que|strong="H1931"\w* \add fosse\add* \w uma jornada|strong="H1870"\w* \w comum|strong="H2455"\w*; \w e quanto mais|strong="H0637,H3588"\w* \w hoje|strong="H3117"\w* \add será\add* \w santificado|strong="H6942"\w* \w no vaso|strong="H3627"\w*."\x - \xo 21:5 \xt LUK 6:3; MAT 12:3; MRK 2:25; EXO 19:15; LEV 24:5; 1TH 4:4\x*
\v 6 \w E o sacerdote|strong="H5414,H3548"\w* \w deu-lhe|strong="H5414,H9033"\w* \w coisa sagrada|strong="H6944"\w*, \w pois|strong="H3588"\w* \w não|strong="H3808"\w* \w havia|strong="H1961"\w* \w ali|strong="H8033"\w* \w pão|strong="H3899"\w*, \w senão|strong="H3588,H0518"\w* \w o pão|strong="H3899"\w* \w da presença|strong="H6440"\w*, \add que fora\add* \w removido|strong="H5493"\w* \w de diante|strong="H6440"\w* \w do SENHOR|strong="H3068"\w*, \w para pôr|strong="H7760"\w* \w pão|strong="H3899"\w* \w quente|strong="H2527"\w* \w no dia|strong="H3117"\w* \w em que foi tirado|strong="H3947"\w*.\x - \xo 21:6 \xt LEV 21:22; LUK 6:3; MAT 12:3; MRK 2:25; LEV 24:5-9; 1SA 21:4\x*
\v 7 \w E estava ali|strong="H8033"\w* \w um homem|strong="H0376"\w* \w dos servos|strong="H5650"\w* \w de Saul|strong="H7586"\w*, \w naquele dia|strong="H3117,H1931"\w*, \w detido|strong="H6113"\w* \w diante|strong="H6440"\w* \w do SENHOR|strong="H3068"\w*, \w e seu nome|strong="H8034"\w* \w era Doegue|strong="H1673"\w*, \w o edomita|strong="H0130"\w*, \w o principal|strong="H0047"\w* \w dos pastores|strong="H7462"\w* \w que|strong="H0834"\w* \add pertenciam\add* \w a Saul|strong="H7586"\w*.\x - \xo 21:7 \xt 1SA 22:22; 1SA 22:9; PSA 52:0; PSA 52:1; 1CH 27:29\x*
\v 8 \w E David disse|strong="H0559,H1732"\w* \w a Aimeleque|strong="H0288"\w*: "\w E não há|strong="H0371,H3426"\w* \w aqui|strong="H6311"\w*, \w à sua mão|strong="H8478,H3027"\w*, \w uma lança|strong="H2595"\w* \w ou|strong="H0176"\w* \w uma espada|strong="H2719"\w*? \w Pois|strong="H3588"\w* \w nem|strong="H1571"\w* \w a minha espada|strong="H2719"\w* \w e nem|strong="H1571"\w* \w as minhas armas|strong="H3627"\w* \w não|strong="H3808"\w* \w trouxe|strong="H3947"\w* \w na minha mão|strong="H3027"\w*, \w pois|strong="H3588"\w* \w era|strong="H1961"\w* \w a missão|strong="H1697"\w* \w do rei|strong="H4428"\w* \w urgente|strong="H5169"\w*."\x - \xo 21:8 \xt LUK 10:4; DEU 29:15; 1SA 13:19\x*
\v 9 \w E o sacerdote disse|strong="H0559,H3548"\w*: "\w A espada|strong="H2719"\w* \w de Goliate|strong="H1555"\w*, \w o filisteu|strong="H6430"\w*, \w a quem|strong="H0834"\w* \w feriste|strong="H5221"\w* \w no vale de Elá|strong="H6010,H0425"\w* — \w eis|strong="H2009"\w* \w que|strong="H1931"\w* \add está\add* \w envolta|strong="H3874"\w* \w num manto|strong="H8071"\w*, \w detrás|strong="H0310"\w* \w do éfode|strong="H0646"\w*; \w se|strong="H0518"\w* \add quiser\add* \w tomá-la|strong="H0853,H3947"\w* \w para si|strong="H9031"\w*, \w tome-a|strong="H3947"\w*, \w pois|strong="H3588"\w* \w não|strong="H0369"\w* \add há\add* \w outra|strong="H0312"\w* \add senão\add* \w esta|strong="H2108"\w* \w aqui|strong="H2088"\w*."\w E David disse|strong="H0559,H1732"\w*: "\w Não|strong="H0369"\w* \add há nenhuma\add* \w como ela|strong="H3644"\w* — \w dê-ma|strong="H5414,H9030"\w*."\x - \xo 21:9 \xt 1SA 17:51; 1SA 17:2; 1SA 17:50; 1SA 31:10\x*
\p
\v 10 \w E David se levantou|strong="H6965,H1732"\w* \w e fugiu|strong="H1272"\w* \w naquele dia|strong="H3117,H1931"\w* \w de diante|strong="H6440"\w* \w de Saul|strong="H7586"\w*; \w e foi|strong="H0935"\w* \w a|strong="H0413"\w* \w Aquis|strong="H0397"\w*, \w rei|strong="H4428"\w* \w de Gate|strong="H1661"\w*.\x - \xo 21:10 \xt 1SA 27:2; 1KI 2:39; 1SA 21:12; 1SA 27:4; 1KI 2:40; PSA 56:3\x*
\v 11 \w E os servos|strong="H0559,H5650"\w* \w de Aquis|strong="H0397"\w* \add lhe\add* \w disseram|strong="H0413"\w*: "\w Não|strong="H3808"\w* \w é|strong="H2088"\w* \w este|strong="H2088"\w* \w David|strong="H1732"\w*, \w o rei|strong="H4428"\w* \w da terra|strong="H0776"\w*? \w Não|strong="H3808"\w* \add é por\add* \w este|strong="H2088"\w* \add que\add* \w cantam|strong="H6030"\w* \w nas danças|strong="H4246"\w*, \w dizendo|strong="H0559"\w*: '\w Feriu|strong="H5221"\w* \w Saul|strong="H7586"\w* \w os seus milhares|strong="H0505"\w*\f + \fr 21.11: \ft Variante: a Ketiv tem "em seu milhar" (no singular, בְּאַלְפּוֹ); a Qere, que seguimos, "em seus milhares" (no plural, בַּאֲלָפָיו)\f*, \w e David|strong="H1732"\w*, \w os seus dez mil|strong="H7233"\w*\f + \fr 21.11: \ft Variante: a Ketiv tem "em seu dez mil" (no singular, בְּרִבֹתוֹ); a Qere, que seguimos, "em seus dez mil" (plural, בְּרִבְבֹתָיו)\f*.'"\x - \xo 21:11 \xt 1SA 29:5; 1SA 18:7; 1CH 14:8; PSA 56:1; 1SA 16:1; 1SA 27:1\x*
