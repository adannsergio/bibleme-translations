\c 11
\p
\v 1 \w Subiu|strong="H5927"\w* \w Naás|strong="H5176"\w*, \w o amonita|strong="H5984"\w*, \w e se acampou|strong="H2583"\w* \w contra|strong="H5921"\w* \w Jabes|strong="H3003"\w*-\w Gileade|strong="H1568"\w*; \w e todos|strong="H3605"\w* \w os homens|strong="H0582"\w* \w de Jabes|strong="H3003"\w* \w disseram|strong="H0559"\w* \w a|strong="H0413"\w* \w Naás|strong="H5176"\w*: "\w Faça|strong="H3772"\w* \w para nós|strong="H9035"\w* \w uma aliança|strong="H1285"\w* \w e nós o serviremos|strong="H5647"\w*."\x - \xo 11:1 \xt EXO 23:32; JDG 21:8; JOB 41:4; 1SA 12:12; 2SA 10:2; 1KI 20:34\x*
\v 2 \w E Naás|strong="H5176"\w*, \w o amonita|strong="H5984"\w*, \w disse-lhes|strong="H0559,H0413"\w*: \add "Com\add* \w isto|strong="H2063"\w* \w farei|strong="H3772"\w* \add aliança\add* \w com vocês|strong="H9036"\w*: \w furando|strong="H5365"\w* \w de vocês|strong="H9036"\w* \w a todos|strong="H3605"\w* \w o olho|strong="H5869"\w* \w direito|strong="H3225"\w*; \w e isto porei|strong="H7760"\w* \w como vergonha|strong="H2781"\w* \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w o Israel|strong="H3478"\w*."\x - \xo 11:2 \xt 1SA 17:26; 2SA 10:1; 1SA 12:12; GEN 34:14; JER 40:14; NUM 16:14\x*
