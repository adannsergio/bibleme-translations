\v 1 \w Saul|strong="H7586"\w* \w tinha|strong="H1121"\w* \w trinta|strong="H7970"\w* \w anos|strong="H8141"\w* \add quando começou a\add* \w reinar|strong="H4427"\w*\f + \fr 13.1: \ft Lit.: o texto hebraico de Leningrado traz aqui apenas "um ano", numeral quase certamente corrompido na transmissão; como quase toda tradução, suprimos "trinta" (e, mais adiante, "quarenta") a partir de versões antigas e do contexto, já que o número exato não sobreviveu no texto recebido\f*, \w e reinou|strong="H4427"\w* \w quarenta|strong="H0705"\w* \add e\add* \w dois|strong="H8147"\w* \w anos|strong="H8141"\w* \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w*.\x - \xo 13:1 \xt 2SA 5:4; 1CH 29:27; 1KI 2:11; 2KI 8:17; 2SA 2:10; 1KI 11:42\x*
\v 2 \w Saul escolheu|strong="H0977,H9033,H7586"\w* \w para si|strong="H9033"\w* \w três|strong="H7969"\w* \w mil|strong="H0505"\w* \w de Israel|strong="H3478"\w*, \w e ficaram|strong="H1961"\w* \w com|strong="H5973"\w* \w Saul|strong="H7586"\w* \add dois\add* \w mil|strong="H0505"\w* \w em Micmás|strong="H4363"\w* \w e na região montanhosa|strong="H2022"\w* \w de Betel|strong="H1008"\w*, \w e mil|strong="H0505,H1961"\w* \w ficaram|strong="H1961"\w* \w com|strong="H5973"\w* \w Jônatas|strong="H3129"\w* \w em Gibeá|strong="H1390"\w* \w de Benjamim|strong="H1144"\w*; \w e o resto|strong="H3499,H5971"\w* \w do povo|strong="H5971"\w* \add ele\add* \w despediu|strong="H7971"\w*, \add cada\add* \w um|strong="H0376"\w* \w para a sua tenda|strong="H0168"\w*.\x - \xo 13:2 \xt 1SA 13:15; 1SA 10:26; 1SA 13:11; 1SA 13:5; 1SA 14:31; ISA 10:28\x*
\v 3 \w E Jônatas|strong="H3129"\w* \w atacou|strong="H5221"\w* \w a guarnição|strong="H5333"\w* \w dos filisteus|strong="H6430"\w* \w que|strong="H0834"\w* \add estava em\add* \w Geba|strong="H1387"\w*, \w e os filisteus|strong="H6430"\w* \w ouviram|strong="H8085"\w*; \w e Saul|strong="H7586"\w* \w tocou|strong="H8628"\w* \w a trombeta|strong="H7782"\w* \w por toda|strong="H3605"\w* \w a terra|strong="H0776"\w*, \w dizendo|strong="H0559"\w*: "\w Que|strong="H8085"\w* ouçam \w os hebreus|strong="H5680"\w*!"\x - \xo 13:3 \xt JDG 3:27; 1SA 10:5; JDG 6:34\x*
