\v 32 \w E Samuel disse|strong="H0559,H8050"\w*: "\w Tragam|strong="H5066"\w* \add a\add* \w mim|strong="H0413"\w* \w Agague|strong="H0090"\w*, \w rei|strong="H4428"\w* \w de Amaleque|strong="H6002"\w*."\w E Agague veio|strong="H1980,H0090"\w* \add a\add* \w ele|strong="H0413"\w* \w com grilhões|strong="H4575"\w*\f + \fr 15.32: \ft Lit.: hebraico de sentido incerto, talvez "titubeante" ou "em grilhões"\f*. \w E Agague disse|strong="H0559,H0090"\w*: "\w Certamente|strong="H0403"\w* \w passou|strong="H5493"\w* \w a amargura|strong="H4751"\w* \w da morte|strong="H4194"\w*."\x - \xo 15:32 \xt JER 48:10; 1TH 5:3; 1TI 5:6; JER 48:44; REV 18:7\x*
