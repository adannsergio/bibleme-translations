\v 29 \w E Jônatas disse|strong="H0559,H3129"\w*: "\w Meu pai|strong="H0001"\w* \w perturbou|strong="H5916"\w* \w a terra|strong="H0776"\w*; \w vejam|strong="H7200,H4994"\w* \w como|strong="H3588"\w* \w brilharam|strong="H0215"\w* \w os meus olhos|strong="H5869"\w*, \w porque|strong="H3588"\w* \w provei|strong="H2938"\w* \w um pouco|strong="H4592"\w* \w deste mel|strong="H1706,H2088"\w*.\x - \xo 14:29 \xt 1SA 14:27; 1SA 14:43; PRO 26:2; PSA 13:3; 1KI 18:18; EZR 9:8\x*
\v 30 \add Quanto\add* \w mais|strong="H0637,H3588,H3863"\w* \w se|strong="H3863"\w* \w o povo|strong="H5971"\w* \add tivesse\add* \w comido|strong="H0398"\w* \w hoje|strong="H3117"\w* \w do despojo|strong="H7998"\w* \w dos seus inimigos|strong="H0341"\w* \w que|strong="H0834"\w* \w encontrou|strong="H4672"\w*! \w Porque|strong="H3588"\w* \w agora|strong="H6258"\w* \w não|strong="H3808"\w* \add teria\add* \w sido|strong="H7235"\w* \w grande|strong="H7235"\w* \w a derrota|strong="H4347"\w* \w entre os filisteus|strong="H6430"\w*.\x - \xo 14:30 \xt ECC 5:2; JOS 6:18; JOS 6:26; JDG 14:9; MRK 8:3\x*
\v 31 \w E feriram|strong="H5221"\w* \w naquele|strong="H3117,H1931"\w* \w dia|strong="H3117"\w* \w os filisteus|strong="H6430"\w*, \w desde Micmás|strong="H4363"\w* \w até|strong="H0357"\w* \w Aijalom|strong="H0357"\w*; \w e o povo|strong="H5971"\w* \add estava\add* \w exausto|strong="H5888"\w* \w muitíssimo|strong="H3966"\w*.\x - \xo 14:31 \xt JOS 10:12; 1SA 13:2; ECC 5:2; JOS 6:18; JOS 6:26; MRK 8:3\x*
\v 32 \w E o povo|strong="H5971"\w* \add se\add* \w lançou|strong="H5860"\w*\f + \fr 14.32: \ft Variante: a Ketiv tem "e fez" (וַיַּעַשׂ); a Qere, que seguimos, "e se lançou" (וַיַּעַט)\f* \w sobre|strong="H0413"\w* \w o despojo|strong="H7998"\w*\f + \fr 14.32: \ft Variante: pequena diferença de grafia entre Ketiv e Qere em "despojo"; sem efeito no sentido\f*, \w e tomaram|strong="H3947"\w* \w ovelhas|strong="H6629"\w*, \w e bois|strong="H1241"\w*, \w e novilhos|strong="H1121,H1241"\w*, \w e os abateram|strong="H7819"\w* \w no chão|strong="H0776"\w*, \w e o povo|strong="H5971"\w* \w comeu|strong="H0398"\w* \w com|strong="H5921"\w* \w o sangue|strong="H1818"\w*.\x - \xo 14:32 \xt 1SA 15:19; LEV 3:17; DEU 12:16; GEN 9:4; LEV 17:10-14; LEV 19:26\x*
\p
\v 33 \w E contaram|strong="H5046"\w* \w a|strong="H7586"\w* \w Saul|strong="H7586"\w*, \w dizendo|strong="H0559"\w*: \add "Eis\add* \w que|strong="H2009"\w* \w o povo|strong="H5971"\w* \add está\add* \w pecando|strong="H2398"\w* \w contra o SENHOR|strong="H3068"\w*, \w comendo|strong="H0398"\w* \w com|strong="H5921"\w* \w o sangue|strong="H1818"\w*."\w E ele disse|strong="H0559"\w*: \add "Vocês agiram\add* \w traiçoeiramente|strong="H0898"\w*; \w rolem|strong="H1556"\w* \add a\add* \w mim|strong="H0413"\w* \w hoje|strong="H3117"\w* \w uma grande|strong="H0068,H1419"\w* \w pedra|strong="H0068"\w*."\x - \xo 14:33 \xt LEV 17:10; ECC 5:2; GEN 9:4; JOS 6:18; JOS 6:26\x*
\p
\v 34 \w E Saul disse|strong="H0559,H7586"\w*: "\w Dispersem-se|strong="H6327"\w* \w entre o povo|strong="H5971"\w* \w e digam-lhes|strong="H0559,H9038"\w*: '\w Tragam|strong="H5066"\w* \add a\add* \w mim|strong="H0413"\w* \add cada\add* \w um|strong="H0376"\w* \w o seu boi|strong="H7794"\w* \w e cada um|strong="H0376"\w* \w a sua ovelha|strong="H7716"\w*, \w e abatam|strong="H7819"\w* \w aqui|strong="H2088"\w* \w e comam|strong="H0398"\w*, \w e não|strong="H3808"\w* \w pequem|strong="H2398"\w* \w contra o SENHOR|strong="H3068"\w*, \w comendo|strong="H0398"\w* \w com|strong="H0413"\w* \w o sangue|strong="H1818"\w*.'"\w E todo|strong="H3605,H5971"\w* \w o povo|strong="H5971"\w* \w trouxe|strong="H5066"\w*, \add cada\add* \w um|strong="H0376"\w* \w o seu boi|strong="H7794"\w* \w na sua mão|strong="H3027"\w*, \w naquela noite|strong="H3915"\w*, \w e ali abateram|strong="H7819,H8033"\w*.\x - \xo 14:34 \xt LEV 22:28; ECC 5:2; GEN 9:4; JOS 6:18; JOS 6:26\x*
\v 35 \w E Saul construiu|strong="H1129,H7586"\w* \w um altar|strong="H4196"\w* \w ao SENHOR|strong="H3068"\w*; \w foi então|strong="H0853,H2490"\w* \add que ele\add* \w começou|strong="H2490"\w* \w a construir|strong="H1129"\w* \w um altar|strong="H4196"\w* \w ao SENHOR|strong="H3068"\w*.\x - \xo 14:35 \xt 1SA 7:17; JDG 21:4; 2KI 21:4; 1SA 7:12; 1SA 7:9; 2TI 3:5\x*
\p
\v 36 \w E Saul disse|strong="H0559,H7586"\w*: "\w Desçamos|strong="H3381"\w* \w atrás|strong="H0310"\w* \w dos filisteus|strong="H6430"\w*, \w de noite|strong="H3915"\w*, \w e os despojemos|strong="H0962,H9038"\w* \w até|strong="H5704"\w* \w a luz|strong="H0216"\w* \w da manhã|strong="H1242"\w*, \w e não|strong="H3808"\w* \w deixemos|strong="H7604"\w* \add entre\add* \w eles|strong="H9038"\w* \w ninguém|strong="H0376"\w*."\w E disseram|strong="H0559"\w*: "\w Faça|strong="H6213"\w* \w tudo|strong="H3605"\w* \w o que for bom|strong="H2896"\w* \w aos seus olhos|strong="H5869"\w*."\w E o sacerdote disse|strong="H0559,H3548"\w*: \add "Vamos nos\add* \w aproximar|strong="H7126"\w* \w aqui|strong="H1988"\w* \w de|strong="H0413"\w* \w Deus|strong="H0430"\w*."\x - \xo 14:36 \xt 1CH 13:3; PSA 73:28; 2KI 3:27; ECC 5:2; GEN 27:13; ISA 48:1-2\x*
\v 37 \w E Saul perguntou|strong="H7592,H7586"\w* \w a|strong="H0430"\w* \w Deus|strong="H0430"\w*: "\w Descerei|strong="H3381"\w* \w atrás|strong="H0310"\w* \w dos filisteus|strong="H6430"\w*? \w Entregará|strong="H5414"\w* \w na mão|strong="H3027"\w* \w de Israel|strong="H3478"\w*?"\w Mas ele não|strong="H3808"\w* \w lhe|strong="H6030"\w* \w respondeu|strong="H6030"\w* \w naquele|strong="H3117,H1931"\w* \w dia|strong="H3117"\w*.\x - \xo 14:37 \xt 2SA 5:19; 1SA 23:4; 1SA 28:6; 1CH 14:10; 1SA 14:46; 1SA 30:8\x*
\p
\v 38 \w E Saul disse|strong="H0559,H7586"\w*: "\w Aproximem-se|strong="H5066"\w* \w aqui|strong="H1988"\w*, \w todos|strong="H3605"\w* \w os chefes|strong="H6438"\w* \w do povo|strong="H5971"\w*, \w e saibam|strong="H3045"\w* \w e vejam|strong="H7200"\w* \w em que|strong="H4100"\w* \w esteve|strong="H1961"\w* \w este pecado|strong="H2403,H2063"\w* \w hoje|strong="H3117"\w*.\x - \xo 14:38 \xt JOS 7:15; 2KI 3:27; ECC 5:2; GEN 27:13; JON 1:7; JOS 6:18\x*
\v 39 \w Porque|strong="H3588"\w* \w pela vida|strong="H2416"\w* \w do SENHOR|strong="H3068"\w*, \w que|strong="H3467"\w* livra \w a Israel|strong="H3478"\w*: \add mesmo\add* \w que|strong="H3588,H0518"\w* \w esteja|strong="H3426"\w* \add em\add* \w Jônatas|strong="H3129"\w*, \add meu\add* \w filho|strong="H1121"\w*, \w certamente|strong="H3588,H4191"\w* \add ele\add* \w morrerá|strong="H4191"\w*."\w Mas ninguém|strong="H0369,H6030"\w* \w de todo|strong="H3605"\w* \w o povo|strong="H5971"\w* \add lhe\add* \w respondeu|strong="H6030"\w*.\x - \xo 14:39 \xt GEN 2:17; 1SA 14:44; 2SA 12:5; JOS 7:15; 1SA 14:1; 1SA 14:24\x*
\v 40 \w E ele disse|strong="H0559"\w* \w a|strong="H0413"\w* \w todo|strong="H3605"\w* \w o Israel|strong="H3478"\w*: "\w Vocês|strong="H0859"\w* \w estarão|strong="H1961"\w* \w de um lado|strong="H5676,H0259"\w*, \w e eu|strong="H0589"\w* \w e Jônatas|strong="H3129"\w*, \add meu\add* \w filho|strong="H1121"\w*, \w estaremos|strong="H1961"\w* \w do outro lado|strong="H5676,H0259"\w*."\w E o povo|strong="H5971"\w* \w disse|strong="H0559"\w* \w a|strong="H0413"\w* \w Saul|strong="H7586"\w*: "\w Faça|strong="H6213"\w* \w o que for bom|strong="H2896,H5869"\w* \w aos seus olhos|strong="H5869"\w*."\x - \xo 14:40 \xt 1SA 14:1; 1SA 14:44; 1SA 14:42; 2KI 3:27; ACT 23:12; ECC 5:2\x*
\p
\v 41 \w Saul disse|strong="H0559,H7586"\w* \w a|strong="H0413"\w* \w o SENHOR|strong="H3068"\w*, \w o Deus|strong="H0430"\w* \w de Israel|strong="H3478"\w*: \add "Por\add* \w que|strong="H4100"\w* \w não|strong="H3808"\w* \w respondeste|strong="H6030"\w* \w ao teu servo|strong="H5650"\w* \w hoje|strong="H3117"\w*? \w Se|strong="H0518"\w* \w há|strong="H3426"\w* \add em\add* \w mim|strong="H9030"\w* \w ou|strong="H0176"\w* \w em|strong="H3129"\w* \w Jônatas|strong="H1121"\w*, \add meu\add* \w filho|strong="H1121"\w*, \w esta culpa|strong="H5771,H2088"\w*, \w SENHOR|strong="H3068"\w*, \w Deus|strong="H0430"\w* \w de Israel|strong="H3478"\w*, \w dá|strong="H3051"\w* \w Urim|strong="H0224"\w*\f + \fr 14.41: \ft Variante: as posições 7 a 31 trazem um trecho mais longo, presente na Septuaginta — explicando o mecanismo do sorteio por Urim e Tumim —, mas ausente do Códice de Leningrado, o texto-base desta tradução; mantemos aqui como leitura alternativa, pois esclarece o sentido do versículo\f*; \w mas se|strong="H0518,H3426"\w* \w há|strong="H3426"\w* \w esta culpa|strong="H5771,H2088"\w* \w no teu povo|strong="H5971"\w*, \w Israel|strong="H3478"\w*, \w dá|strong="H3051"\w* \w Tumim|strong="H8549"\w*."\w E foi tomado por sorte|strong="H3920"\w* \w Jônatas|strong="H3129"\w*, \w e Saul|strong="H7586"\w* \w e o povo|strong="H5971"\w* \w saíram|strong="H3318"\w*.\x - \xo 14:41 \xt ACT 1:24; PRO 16:33; 1SA 10:20; JON 1:7; JOS 7:16-18; 1SA 14:1\x*
\v 42 \w E Saul disse|strong="H0559,H7586"\w*: \add "Lancem\add* \w sorte|strong="H5307"\w* \add entre\add* \w mim|strong="H0996"\w* \w e|strong="H0996"\w* \w Jônatas|strong="H3129"\w*, \add meu\add* \w filho|strong="H1121"\w*."\w E foi tomado por sorte|strong="H3920"\w* \w Jônatas|strong="H3129"\w*.\x - \xo 14:42 \xt 1SA 14:44; 1SA 14:40; PRO 16:33; JON 1:7; 1SA 14:1; 2KI 3:27\x*
\p
\v 43 \w E Saul disse|strong="H0559,H7586"\w* \w a|strong="H0413"\w* \w Jônatas|strong="H3129"\w*: "\w Conte-me|strong="H5046,H9030"\w* \add o\add* \w que|strong="H4100"\w* \w fez|strong="H6213"\w*."\w E Jônatas lhe contou|strong="H5046,H9033,H3129"\w* \w e disse|strong="H0559"\w*: \add "Eu\add* \w apenas|strong="H2938"\w* \w provei|strong="H2938"\w* \w com a ponta|strong="H7097,H4294"\w* \w do cajado|strong="H4294"\w* \w que|strong="H0834"\w* \add tinha na\add* \w mão|strong="H3027"\w*, \w um pouco|strong="H4592"\w* \w de mel|strong="H1706"\w*; \w eis-me|strong="H2005"\w*, \w morrerei|strong="H4191"\w*."\x - \xo 14:43 \xt 1SA 14:27; 1SA 14:29; JON 1:8; JOS 7:19; 1SA 14:1; 2KI 3:27\x*
\v 44 \w E Saul disse|strong="H0559,H7586"\w*: "\w Assim me faça|strong="H3541,H6213"\w* \w Deus|strong="H0430"\w*, \w e ainda mais|strong="H3541"\w* \w acrescente|strong="H3254"\w*: \w certamente|strong="H3588,H4191"\w* \add você\add* \w morrerá|strong="H4191"\w*, \w Jônatas|strong="H3129"\w*."\x - \xo 14:44 \xt 1SA 14:40; 1SA 14:42; 1SA 14:1; 1SA 19:1; 1SA 13:22; 1SA 14:39\x*
\p
\v 45 \w E o povo|strong="H0559,H5971"\w* \w disse|strong="H0559"\w* \w a|strong="H0413"\w* \w Saul|strong="H7586"\w*: "\w Morrerá|strong="H3129,H4191"\w* \w Jônatas|strong="H3129"\w*, \w que|strong="H0834"\w* \w fez|strong="H6213"\w* \w esta grande|strong="H3444,H1419,H2063"\w* \w libertação|strong="H3444"\w* \w em Israel|strong="H3478"\w*? \w Longe|strong="H2486"\w* \w esteja|strong="H2486"\w* \add isso!\add* \w Pela vida|strong="H2416,H3068"\w* \w do SENHOR|strong="H3068"\w*, \w não|strong="H0518"\w* \w cairá|strong="H5307"\w* \w um só fio|strong="H8185,H7218"\w* \w de cabelo|strong="H8185"\w* \w de sua cabeça|strong="H7218"\w* \w ao chão|strong="H0776"\w*, \w porque|strong="H3588"\w* \w com|strong="H5973"\w* \w Deus|strong="H0430"\w* \add ele\add* \w agiu|strong="H6213"\w* \w hoje|strong="H3117,H2088"\w*."\w E o povo|strong="H5971"\w* \w resgatou|strong="H6299"\w* \w Jônatas|strong="H3129"\w*, \w e ele não|strong="H3808"\w* \w morreu|strong="H4191"\w*.\x - \xo 14:45 \xt 1KI 1:52; 2SA 14:11; MAT 10:30; ACT 27:34; LUK 21:18; 2CO 6:1\x*
\v 46 \w E Saul subiu|strong="H5927,H7586"\w* \w de|strong="H0310"\w* \w atrás|strong="H0310"\w* \w dos filisteus|strong="H6430"\w*, \w e os filisteus|strong="H6430"\w* \w foram|strong="H1980"\w* \w para o seu lugar|strong="H4725"\w*.\x - \xo 14:46 \xt 1SA 23:28; 1SA 14:37; 1SA 24:1; 2KI 3:27; JOS 6:26\x*
\v 47 \w E Saul|strong="H7586"\w* \w tomou|strong="H3920"\w* \w o reinado|strong="H4410"\w* \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w e guerreou|strong="H3898"\w* \w em redor|strong="H5439"\w* \w contra|strong="H3605"\w* \w todos|strong="H3605"\w* \w os seus inimigos|strong="H0341"\w*: \w contra|strong="H4124"\w* \w Moabe|strong="H4124"\w*, \w e contra os filhos|strong="H1121,H5983"\w* \w de Amom|strong="H5983"\w*, \w e contra Edom|strong="H0123"\w*, \w e contra os reis|strong="H4428"\w* \w de Zobá|strong="H6678"\w*, \w e contra os filisteus|strong="H6430"\w*; \w e por onde|strong="H3605,H0834"\w* \add se\add* \w voltava|strong="H6437"\w*, \w vencia|strong="H7561"\w*.\x - \xo 14:47 \xt 2SA 8:3; 2SA 10:6; 1SA 14:52\x*
\v 48 \w E ele agiu|strong="H6213"\w* \w com valor|strong="H2428"\w* \w e feriu|strong="H5221"\w* \w a Amaleque|strong="H6002"\w*, \w e livrou|strong="H5337"\w* \w a Israel|strong="H3478"\w* \w da mão|strong="H3027"\w* \w dos que o pilhavam|strong="H8154"\w*.\x - \xo 14:48 \xt 1SA 30:18; 1SA 15:7; 1SA 15:3-7; DEU 25:19; EXO 17:14\x*
\v 49 \w E foram|strong="H1961"\w* \w os filhos|strong="H1121"\w* \w de Saul|strong="H7586"\w*: \w Jônatas|strong="H3129"\w*, \w e Isvi|strong="H3440"\w*, \w e Malquisua|strong="H4444"\w*; \w e o nome|strong="H8034,H8147"\w* \w das suas duas|strong="H8147,H1323"\w* \w filhas|strong="H1323"\w*: \w o nome|strong="H8034"\w* \w da primogênita|strong="H1067"\w* \w era Merabe|strong="H4764"\w*, \w e o nome|strong="H8034,H6996"\w* \w da mais jovem|strong="H6996"\w* \w era Mical|strong="H4324"\w*.\x - \xo 14:49 \xt 1CH 8:33; 1SA 31:2; 1CH 9:39; 2SA 6:20-23\x*
\v 50 \w E o nome|strong="H8034,H0802"\w* \w da mulher|strong="H0802"\w* \w de Saul|strong="H7586"\w* \w era Ainoã|strong="H0293"\w*, \w filha|strong="H1323"\w* \add de\add* \w Aimaás|strong="H0290"\w*; \w e o nome|strong="H8034,H8269"\w* \w do comandante|strong="H8269"\w* \w do seu exército|strong="H6635"\w* \w era Abner|strong="H0074"\w*, \w filho|strong="H1121"\w* \add de\add* \w Ner|strong="H5369"\w*, \w tio|strong="H1730"\w* \add de\add* \w Saul|strong="H7586"\w*.\x - \xo 14:50 \xt 2SA 2:8; 1SA 26:5; 2SA 3:37; 1CH 8:33; 1SA 10:14\x*
\v 51 \w E Quis|strong="H7027"\w* \w era pai|strong="H0001,H7586"\w* \add de\add* \w Saul|strong="H7586"\w*, \w e Ner|strong="H5369"\w*, \w pai|strong="H0001"\w* \add de\add* \w Abner|strong="H0074"\w*, \w era filho|strong="H1121"\w* \add de\add* \w Abiel|strong="H0022"\w*.\x - \xo 14:51 \xt 1SA 9:1; 1CH 26:28; 2SA 3:37; 1SA 26:5; 1CH 8:33; 1SA 9:21\x*
\v 52 \w E a guerra|strong="H1961,H4421"\w* \w foi|strong="H1961"\w* \w dura|strong="H2389"\w* \w contra|strong="H5921"\w* \add os\add* \w filisteus|strong="H6430"\w* \w todos|strong="H3605"\w* \w os dias|strong="H3117"\w* \w de Saul|strong="H7586"\w*; \w e Saul via|strong="H7200,H7586"\w* \w todo homem|strong="H3605,H0376"\w* \w valente|strong="H1368"\w*, \w e todo|strong="H3605"\w* \w filho|strong="H1121"\w* \w valoroso|strong="H2428"\w*, \w e os reunia|strong="H0622"\w* \w para si|strong="H0413"\w*.\x - \xo 14:52 \xt 1SA 8:11; 1SA 14:47; 1SA 17:1\x*
\c 15
\p
\v 1 \w Samuel disse|strong="H0559,H8050"\w* \w a|strong="H0413"\w* \w Saul|strong="H7586"\w*: "\w O SENHOR|strong="H3068"\w* \w me|strong="H0853"\w* \w enviou|strong="H7971"\w* \w para o ungir|strong="H4886"\w* \w como rei|strong="H4428"\w* \w sobre|strong="H5921"\w* \w o seu povo|strong="H5971"\w*, \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w*; \w e agora|strong="H6258"\w*, \w escute|strong="H8085"\w* \w a voz|strong="H6963"\w* \w das palavras|strong="H1697"\w* \w do SENHOR|strong="H3068"\w*.\x - \xo 15:1 \xt 1SA 15:17; 1SA 9:15; 1SA 13:13; 1SA 15:16; 2SA 2:7; 1SA 12:1\x*
