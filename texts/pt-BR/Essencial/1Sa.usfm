\v 1 \w E os filisteus|strong="H6430"\w* \w lutavam|strong="H3898"\w* \w contra Israel|strong="H3478"\w*; \w e fugiram|strong="H5127"\w* \w os homens|strong="H0582"\w* \w de Israel|strong="H3478"\w* \w de diante|strong="H6440"\w* \w dos filisteus|strong="H6430"\w*, \w e caíram|strong="H5307"\w* \w mortos|strong="H2491"\w* \w no monte|strong="H2022"\w* \w de Gilboa|strong="H1533"\w*.\x - \xo 31:1 \xt 1CH 10:1; 1CH 10:8; 1SA 31:8; 1SA 28:4; 2SA 1:4; PSA 78:9\x*
\v 2 \w E perseguiram de perto|strong="H1692"\w* \w os filisteus|strong="H6430"\w* \w Saul|strong="H7586"\w* \w e|strong="H0853"\w* \w os seus filhos|strong="H1121"\w*; \w e feriram|strong="H5221"\w* \w os filisteus|strong="H6430"\w* \w Jônatas|strong="H3083"\w*, \w e|strong="H0853"\w* \w Abinadabe|strong="H0041"\w*, \w e|strong="H0853"\w* \w Malquisua|strong="H4444"\w*, \w filhos|strong="H1121"\w* \w de Saul|strong="H7586"\w*.\x - \xo 31:2 \xt 1CH 10:2; 1CH 8:33; 1CH 9:39; 2SA 1:4; 1CH 10:1; 1SA 14:49\x*
\v 3 \w E se tornou pesada|strong="H3513,H4421"\w* \w contra|strong="H0413"\w* \w Saul|strong="H7586"\w*; \w e o encontraram|strong="H4672"\w* \w os archeiros|strong="H3384"\w* \w homens|strong="H0582"\w* \w com o arco|strong="H7198"\w*, \w e ele ficou|strong="H2342"\w* \w gravemente ferido|strong="H3966"\w* \w pelos archeiros|strong="H3384"\w*.\x - \xo 31:3 \xt 1CH 10:3; 2SA 1:4; 1CH 10:1; PSA 7:16; 1SA 12:25; 1CH 17:8\x*
\v 4 \w E Saul disse|strong="H0559,H7586"\w* \w ao seu escudeiro|strong="H5375,H3627"\w*: "\w Desembainha|strong="H8025"\w* \w a tua espada|strong="H2719"\w*, \w e atravessa-me|strong="H1856"\w* \w com ela|strong="H9034"\w*, \add para que\add* \w não|strong="H6435"\w* \w venham|strong="H0935"\w* \w estes incircuncisos|strong="H6189,H0428"\w* \w e me atravessem|strong="H1856"\w*, \w e façam de mim escárnio|strong="H5953,H9030"\w*."\w Mas não|strong="H3808"\w* \w quis|strong="H0014"\w* \w o seu escudeiro|strong="H5375,H3627"\w*, \w pois|strong="H3588"\w* \add tinha\add* \w medo|strong="H3372"\w* \w muito|strong="H3966"\w*. \w E Saul tomou|strong="H3947,H7586"\w* \w a espada|strong="H2719"\w*, \w e caiu|strong="H5307"\w* \add sobre\add* \w ela|strong="H5921"\w*.\x - \xo 31:4 \xt 1CH 10:4; JDG 9:54; 2SA 1:4; 1CH 10:1; 2SA 1:14; 2SA 1:6\x*
\v 5 \w E viu|strong="H7200"\w* \w o seu escudeiro|strong="H5375,H3627"\w* \w que|strong="H3588"\w* \add tinha\add* \w morrido|strong="H4191"\w* \w Saul|strong="H7586"\w*, \w e caiu|strong="H5307"\w* \w também|strong="H1571"\w* \w ele|strong="H1931"\w* \w sobre|strong="H5921"\w* \w a sua espada|strong="H2719"\w*, \w e morreu|strong="H4191"\w* \add com\add* \w ele|strong="H5973"\w*.\x - \xo 31:5 \xt 1CH 10:5; 2SA 1:4; 1SA 16:21; 1CH 10:1; 1SA 12:25; JDG 9:54\x*
\v 6 \w E morreu|strong="H4191"\w* \w Saul|strong="H7586"\w*, \w e os seus três|strong="H7969,H1121"\w* filhos, \w e o seu escudeiro|strong="H5375,H3627"\w*, \w também|strong="H1571"\w* \w todos|strong="H3605"\w* \w os seus homens|strong="H0582"\w*, \w naquele dia|strong="H3117,H1931"\w*, \w juntos|strong="H3162"\w*.\x - \xo 31:6 \xt 1CH 10:6; 1CH 10:5; 2SA 1:4; 1CH 10:1; 1SA 26:10; ACT 13:22\x*
\v 7 \w E viram|strong="H7200"\w* \w os homens|strong="H0582,H3478"\w* \w que|strong="H0834"\w* \w estavam no outro lado|strong="H5676,H6010"\w* \w e que|strong="H0834"\w* \w estavam no outro lado|strong="H5676,H3383"\w* do Jordão \w que|strong="H3588"\w* \add tinham\add* \w fugido|strong="H5127"\w* \w os homens|strong="H0582,H3478"\w* de Israel, \w e que|strong="H3588"\w* \add tinham\add* \w morrido|strong="H4191"\w* \w Saul|strong="H7586"\w* \w e os seus filhos|strong="H1121"\w*; \w e abandonaram|strong="H5800,H0853"\w* \w as cidades|strong="H5892"\w*, \w e fugiram|strong="H5127"\w*; \w e vieram|strong="H0935"\w* \w os filisteus|strong="H6430"\w*, \w e habitaram|strong="H3427"\w* \w nelas|strong="H9039"\w*.\x - \xo 31:7 \xt 1CH 10:7; 1CH 10:1; 2SA 4:3; 2SA 4:4; PSA 64:8\x*
\v 8 \w E aconteceu|strong="H1961"\w*, \w no dia seguinte|strong="H4283"\w*, \w que vieram|strong="H0935"\w* \w os filisteus|strong="H6430"\w* \w para despojar|strong="H6584"\w* \w os mortos|strong="H2491"\w*, \w e encontraram|strong="H4672"\w* \w Saul|strong="H7586"\w*, \w e|strong="H0853"\w* \w os seus três|strong="H7969,H1121"\w* filhos, \w caídos|strong="H5307"\w* \w no monte|strong="H2022"\w* \w de Gilboa|strong="H1533"\w*.\x - \xo 31:8 \xt 1CH 10:8; 1CH 10:1; 1SA 31:1; 2SA 1:19; 2SA 4:4\x*
\v 9 \w E cortaram|strong="H3772"\w* \w a sua cabeça|strong="H7218"\w*, \w e o despojaram|strong="H6584"\w* \w das suas armas|strong="H3627"\w*, \w e enviaram|strong="H7971"\w* \w pela terra|strong="H0776"\w* \w dos filisteus|strong="H6430"\w* \w em redor|strong="H5439"\w*, \w para levar a notícia|strong="H1319"\w* \w à casa|strong="H1004"\w* \w dos seus ídolos|strong="H6091"\w*, \w e|strong="H0853"\w* \w ao povo|strong="H5971"\w*.\x - \xo 31:9 \xt 1CH 10:9; 1CH 10:1; 2SA 1:20; JDG 16:23-24; 2SA 4:4; DAN 1:2\x*
\v 10 \w E puseram|strong="H7760,H0853"\w* \w as suas armas|strong="H3627"\w* \w na casa|strong="H1004"\w* \w de Astarote|strong="H6252"\w*, \w e|strong="H0853"\w* \w o seu corpo|strong="H1472"\w* \w penduraram|strong="H8628"\w* \w no muro|strong="H2346"\w* \w de Bete-Seã|strong="H1052"\w*.\x - \xo 31:10 \xt 1SA 31:12; 1SA 7:3; 1CH 10:1; 2SA 21:12; JOS 17:11; JDG 2:13\x*
\v 11 \w E ouviram|strong="H8085"\w* \w sobre ele|strong="H0413"\w* \w os habitantes|strong="H3427"\w* \w de Jabes|strong="H3003"\w* \w de Gileade|strong="H1568"\w* \w o que|strong="H0834"\w* \add tinham\add* \w feito|strong="H6213"\w* \w os filisteus|strong="H6430"\w* \w a Saul|strong="H7586"\w*.\x - \xo 31:11 \xt 1CH 10:11; 2SA 2:4; JDG 21:8; JDG 21:9; 2SA 21:12; 2SA 2:5\x*
\v 12 \w E se levantaram|strong="H6965"\w* \w todos|strong="H3605"\w* \w os homens|strong="H0376"\w* \w valentes|strong="H2428"\w*, \w e andaram|strong="H1980"\w* \w toda|strong="H3605"\w* \w a noite|strong="H3915"\w*, \w e tomaram|strong="H3947"\w* \w o corpo|strong="H1472"\w* \w de Saul|strong="H7586"\w*, \w e|strong="H0853"\w* \w os corpos|strong="H1472"\w* \w dos seus filhos|strong="H1121"\w* \w do muro|strong="H2346"\w* \w de Bete-Seã|strong="H1052"\w*; \w e vieram|strong="H0935"\w* \w a Jabes|strong="H3003"\w*, \w e os queimaram|strong="H8313,H0853"\w* \w ali|strong="H8033"\w*.\x - \xo 31:12 \xt 2SA 21:12; 1SA 31:10; 1CH 10:1; 2CH 16:14; 2SA 2:4; AMO 6:10\x*
\v 13 \w E tomaram|strong="H3947"\w* \w os seus ossos|strong="H6106"\w*, \w e os sepultaram|strong="H6912"\w* \w debaixo|strong="H8478"\w* \w do tamarindo|strong="H0815"\w* \w em Jabes|strong="H3003"\w*, \w e jejuaram|strong="H6684"\w* \w sete|strong="H7651"\w* \w dias|strong="H3117"\w*.\x - \xo 31:13 \xt 1CH 10:12; 2SA 2:4; 1SA 22:6; 1CH 10:1; 2SA 21:12; GEN 50:10\x*
