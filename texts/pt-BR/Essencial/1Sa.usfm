\v 26 \w O menino|strong="H5288"\w* \w Samuel|strong="H8050"\w* \w ia|strong="H1980"\w* \w crescendo|strong="H1432"\w* \w e se tornando agradável|strong="H2895"\w*, \w tanto|strong="H1571"\w* \w diante do SENHOR|strong="H5973,H3068"\w* \w como|strong="H1571"\w* \w diante dos homens|strong="H5973,H0582"\w*.\x - \xo 2:26 \xt LUK 2:52; PRO 22:6; PRO 3:4; LUK 2:40; 1SA 2:21; ACT 2:47\x*
\p
\v 27 \w Veio|strong="H0935"\w* \w um homem|strong="H0376"\w* \w de Deus|strong="H0430"\w* \w a|strong="H0413"\w* \w Eli|strong="H5941"\w* \w e disse-lhe|strong="H0559,H0413"\w*: "\w Assim|strong="H3541"\w* \w diz|strong="H0559"\w* \w o SENHOR|strong="H3068"\w*: '\w Não|strong="H1540"\w* \add me revelei eu\add* \w claramente|strong="H1540"\w* \w à casa|strong="H0413,H1004"\w* \w do seu pai|strong="H0001"\w*, \w quando|strong="H1961"\w* \add eles\add* \w estavam|strong="H1961"\w* \w no Egito|strong="H4714"\w*, \w sujeitos à casa|strong="H1004"\w* \w de Faraó|strong="H6547"\w*?\x - \xo 2:27 \xt EXO 6:11; EXO 6:29; 1KI 2:27; 1SA 3:12; 1TI 6:11; JDG 13:6\x*
\v 28 \w E o escolhi|strong="H0977,H0853"\w* \w de entre todas|strong="H3605"\w* \w as tribos|strong="H7626"\w* \w de Israel|strong="H3478"\w* \w para mim|strong="H9030"\w* \w como sacerdote|strong="H3548"\w*, \w para subir|strong="H5927"\w* \w ao meu altar|strong="H5921,H4196"\w*, \w para queimar|strong="H6999"\w* \w incenso|strong="H7004"\w*, \w para usar|strong="H5375,H0646"\w* \w éfode|strong="H5375"\w* \w diante de mim|strong="H6440"\w*; \w e dei|strong="H5414"\w* \w à casa|strong="H1004"\w* \w do seu pai|strong="H0001"\w* \w todas|strong="H3605"\w* \w as ofertas queimadas|strong="H0801"\w* \w dos filhos|strong="H1121"\w* \w de Israel|strong="H3478"\w*.'\x - \xo 2:28 \xt LEV 3:11; LEV 7:5; 1KI 2:27; HOS 4:6; EXO 28:1; MAL 1:6\x*
