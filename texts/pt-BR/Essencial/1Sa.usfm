\v 19 \add 'Mas\add* \w vocês|strong="H0859"\w* \w hoje|strong="H3117"\w* \w rejeitaram|strong="H3988"\w* \w o seu Deus|strong="H0430"\w*, \w que|strong="H0834"\w* \w ele|strong="H1931"\w* \w é quem os salva|strong="H3467,H9036"\w* \w de todas|strong="H3605"\w* \w as suas calamidades|strong="H7451"\w* \w e angústias|strong="H6869"\w*, \w e disseram-lhe|strong="H0559,H9033"\w*: "\w Não|strong="H3588"\w*, \w ponha|strong="H7760"\w* \w um rei|strong="H4428"\w* \add sobre\add* \w nós|strong="H5921"\w*!"\w E agora|strong="H6258"\w*, \w apresentem-se|strong="H3320"\w* \w diante do SENHOR|strong="H6440,H3068"\w*, \w por suas tribos|strong="H7626"\w* \w e por seus milhares|strong="H0505"\w*.'\x - \xo 10:19 \xt 1SA 8:7; JHN 12:48; 1SA 12:12; JOS 24:1; MRK 8:31; HOS 13:11\x*
