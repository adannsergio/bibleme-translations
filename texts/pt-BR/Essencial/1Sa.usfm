\v 15 \w E David disse|strong="H0559,H1732"\w* \w a|strong="H0413"\w* \w Abner|strong="H0074"\w*: "\w Não|strong="H3808"\w* \add é\add* \w um homem|strong="H0376,H0859"\w* \add você?\add* \w E quem|strong="H4310,H3644"\w* \w é como você|strong="H3644"\w* \w em Israel|strong="H3478"\w*? \w E por que|strong="H4100,H3808"\w* \add não\add* \w guardou|strong="H8104"\w* \w a|strong="H0413"\w* \w o teu senhor|strong="H0113"\w*, \w o rei|strong="H4428"\w*? \w Pois|strong="H3588"\w* \w veio|strong="H0935"\w* \w um do povo|strong="H0259,H5971"\w* \w para destruir|strong="H7843"\w* \w o rei|strong="H4428"\w*, \w teu senhor|strong="H0113"\w*."\x - \xo 26:15 \xt PSA 140:2; PSA 7:4; 2SA 3:24\x*
