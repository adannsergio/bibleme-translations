\v 16 \w O homem|strong="H0376"\w* \w disse|strong="H0559"\w* \w a|strong="H0413"\w* \w Eli|strong="H5941"\w*: "\w Eu sou|strong="H0595"\w* \w o que vem|strong="H0935"\w* \w da batalha|strong="H4480,H4634"\w*; \w e eu|strong="H0589"\w* \w fugi|strong="H5127"\w* \w da batalha|strong="H4480,H4634"\w* \w hoje|strong="H3117"\w*."\w E Eli disse|strong="H0559"\w*: \add "O\add* \w que|strong="H4100"\w* \w aconteceu|strong="H1961,H1697"\w*, \add meu\add* \w filho|strong="H1121"\w*?"\x - \xo 4:16 \xt 2SA 1:4; JER 48:19; 1SA 2:31\x*
\v 17 \w E o portador da notícia|strong="H1319"\w* \w respondeu|strong="H6030"\w* \w e disse|strong="H0559"\w*: "\w Israel fugiu|strong="H5127,H3478"\w* \w diante dos filisteus|strong="H6440,H6430"\w*, \w e também|strong="H1571"\w* \w houve|strong="H1961"\w* \w uma grande|strong="H4046,H1419"\w* \w matança|strong="H4046"\w* \w no povo|strong="H5971"\w*, \w e também|strong="H1571"\w* \w os seus dois|strong="H8147"\w* \w filhos|strong="H1121"\w*, \w Hofni|strong="H2652"\w* \w e Fineias|strong="H6372"\w*, \w morreram|strong="H4191"\w*, \w e a arca|strong="H0727"\w* \w de Deus|strong="H0430"\w* \add foi\add* \w tomada|strong="H3947"\w*."\x - \xo 4:17 \xt 1SA 2:34; 1SA 4:11; PSA 78:64; 1SA 2:31; JOB 1:14; PSA 78:61\x*
\v 18 \w E aconteceu|strong="H1961"\w* \add que,\add* \w quando ele mencionou|strong="H2142"\w* \w a arca|strong="H0727"\w* \w de Deus|strong="H0430"\w*, \w ele caiu|strong="H5307"\w* \w de costas|strong="H0322"\w* \w da cadeira|strong="H5921,H3678"\w*, \w ao lado|strong="H1157,H3027"\w* \w do portão|strong="H8179"\w*, \w e quebrou|strong="H7665"\w* \w o pescoço|strong="H4665"\w* \w e morreu|strong="H4191"\w*; \w porque|strong="H3588"\w* \w já estava|strong="H2204"\w* \w velho|strong="H2204"\w* \w aquele homem|strong="H0376"\w*, \w e pesado|strong="H3515"\w*; \w e ele|strong="H1931"\w* \add tinha\add* \w julgado|strong="H8199"\w* \w a Israel|strong="H3478"\w* \w por quarenta|strong="H0705"\w* \w anos|strong="H8141"\w*.\x - \xo 4:18 \xt 1SA 4:21-22; 1PE 4:17-18; ECC 12:2; PSA 71:18; 1SA 2:31; 1SA 4:13\x*
\v 19 \w E a sua nora|strong="H3618"\w*, \w a mulher|strong="H0802"\w* \w de Fineias|strong="H6372"\w*, \add estava\add* \w grávida|strong="H2030"\w*, \w perto de dar à luz|strong="H3205"\w*; \w e quando ouviu|strong="H8085"\w* \w a notícia|strong="H8052"\w* \w de que a arca|strong="H0413,H3947,H0727"\w* \w de Deus|strong="H0430"\w* \w tinha sido tomada|strong="H3947"\w* \w e de que|strong="H4191"\w* \w o seu sogro|strong="H2524"\w* \w e o seu marido|strong="H0376"\w* \w tinham morrido|strong="H4191"\w*, \w ela se dobrou|strong="H3766"\w* \w e deu à luz|strong="H3205"\w*, \w porque|strong="H3588"\w* \w lhe sobrevieram|strong="H2015,H5921"\w* \w as dores do parto|strong="H6735"\w*.\x - \xo 4:19 \xt GEN 3:16; 1SA 2:31; JER 26:6\x*
\v 20 \w E quase na hora|strong="H6256"\w* \w da sua morte|strong="H4191"\w*, \w as mulheres|strong="H5324"\w* \w que estavam junto|strong="H5921"\w* \w a ela|strong="H5921"\w* \w disseram|strong="H1696"\w*: "\w Não|strong="H0408"\w* \w tema|strong="H3372"\w*, \w porque|strong="H3588"\w* \add deu à\add* \w luz|strong="H3205"\w* \w um filho|strong="H1121"\w*."\w Mas ela não|strong="H3808"\w* \w respondeu|strong="H6030"\w* \w e não|strong="H3808"\w* \w deu atenção|strong="H7896,H3820"\w*.\x - \xo 4:20 \xt GEN 35:17; GEN 3:16; 1SA 2:31; 1SA 9:20; JER 26:6; JHN 16:21\x*
\v 21 \w E ela chamou|strong="H7121"\w* \w o menino|strong="H5288"\w* \w Icabode|strong="H0350"\w*, \w dizendo|strong="H0559"\w*: \add "A\add* \w glória|strong="H3519"\w* \add se\add* \w foi|strong="H1540"\w* \w de Israel|strong="H3478"\w* ", \add por\add* \w causa|strong="H0413"\w* \w da tomada|strong="H3947"\w* \w da arca|strong="H0727"\w* \w de Deus|strong="H0430"\w* \w e por causa|strong="H0413"\w* \w do seu sogro|strong="H2524"\w* \w e do seu marido|strong="H0376"\w*.\x - \xo 4:21 \xt PSA 26:8; 1CH 4:9; JER 2:11; PSA 78:61; 1SA 4:18; PSA 78:64\x*
\v 22 \w Ela disse|strong="H0559"\w*: \add "A\add* \w glória|strong="H3519"\w* \add se\add* \w foi|strong="H1540"\w* \w de Israel|strong="H3478"\w*, \w porque|strong="H3588"\w* \w a arca|strong="H0727"\w* \w de Deus|strong="H0430"\w* \add foi\add* \w tomada|strong="H3947"\w*."\x - \xo 4:22 \xt ISA 40:5; 1SA 4:18; HOS 10:5; JER 7:12; 1SA 5:1; JER 26:6\x*
