\v 13 \w E Samuel disse|strong="H0559,H8050"\w* \w a|strong="H0413"\w* \w Saul|strong="H7586"\w*: \add "Agiu\add* \w tolamente|strong="H5528"\w*; \w não|strong="H3808"\w* \w guardou|strong="H8104"\w* \w o mandamento|strong="H4687"\w* \w do SENHOR|strong="H3068"\w*, \w seu Deus|strong="H0430"\w*, \w que|strong="H0834"\w* \add ele lhe\add* \w ordenou|strong="H6680"\w*; \w porque|strong="H3588"\w* \w agora|strong="H6258"\w* \w o SENHOR|strong="H3068"\w* \add teria\add* \w estabelecido|strong="H3559"\w* \w o seu reino|strong="H4467"\w* \w sobre|strong="H0413"\w* \w Israel|strong="H3478"\w* \w para|strong="H5704"\w* \w sempre|strong="H5769"\w*.\x - \xo 13:13 \xt GEN 31:28; 1SA 15:1; 2SA 24:10; 2CH 16:9; ACT 13:22; 1SA 15:22\x*
\v 14 \w E agora|strong="H6258"\w*, \w o seu reino|strong="H4467"\w* \w não|strong="H3808"\w* \w subsistirá|strong="H6965"\w*; \w o SENHOR|strong="H3068"\w* \add já\add* \w buscou|strong="H1245"\w* \w para si|strong="H9033"\w* \w um homem|strong="H0376"\w* \w segundo o seu coração|strong="H3824"\w*, \w e o SENHOR|strong="H3068"\w* \add já o\add* \w designou|strong="H6680"\w* \w como líder|strong="H5057"\w* \w sobre|strong="H5921"\w* \w o seu povo|strong="H5971"\w*, \w porque|strong="H3588"\w* \w não|strong="H3808"\w* \w guardou|strong="H8104"\w* \w o que|strong="H0834"\w* \w o SENHOR|strong="H3068"\w* \add lhe\add* \w ordenou|strong="H6680"\w*."\x - \xo 13:14 \xt 1SA 24:20; 1SA 25:30; 2SA 6:21; ACT 13:22; 1SA 15:28; 1SA 15:23\x*
\v 15 \w Samuel se levantou|strong="H6965,H8050"\w* \w e subiu|strong="H5927"\w* \w de|strong="H4480"\w* \w Gilgal|strong="H1537"\w* — \w e foi|strong="H1980"\w* \w pelo seu caminho|strong="H1870"\w*, \w e o resto|strong="H3499"\w* \w do povo|strong="H5971"\w* \w subiu|strong="H5927"\w* \w atrás|strong="H0310"\w* \w de Saul|strong="H7586"\w* \w ao encontro|strong="H7122"\w* \w do povo|strong="H5971"\w* \w de guerra|strong="H4421"\w*, \w e vieram|strong="H0935"\w* \w de|strong="H4480"\w* \w Gilgal|strong="H1537"\w*\f + \fr 13.15: \ft Variante: as posições 6 a 18 trazem um trecho mais longo, presente em 4QSamᵃ e na Septuaginta, mas ausente do Códice de Leningrado, o texto-base desta tradução; seguindo a prática de versões críticas modernas, mantemos esse trecho aqui, como leitura alternativa\f* — \w a Gibeá|strong="H1390"\w* \w de Benjamim|strong="H1144"\w*; \w e Saul contou|strong="H6485,H7586"\w* \w o povo|strong="H5971"\w* \w que se achava|strong="H4672"\w* \add com\add* \w ele|strong="H5973"\w*, \add cerca\add* \w de|strong="H8337,H3967"\w* \w seiscentos|strong="H8337,H3967"\w* \w homens|strong="H0376"\w*.\x - \xo 13:15 \xt 1SA 13:2; 1SA 14:2; 1SA 10:8; 1SA 13:6-7\x*
\v 16 \w E Saul|strong="H7586"\w* \w e Jônatas|strong="H3129"\w*, \w seu filho|strong="H1121"\w*, \w e o povo|strong="H5971"\w* \w que se achava|strong="H4672"\w* \add com\add* \w eles|strong="H5973"\w* \w ficaram|strong="H3427"\w* \w em Geba|strong="H1387"\w* \w de Benjamim|strong="H1144"\w*; \w e os filisteus|strong="H6430"\w* \w se acamparam|strong="H2583"\w* \w em Micmás|strong="H4363"\w*.\x - \xo 13:16 \xt 1SA 13:11; NEH 11:31; 1SA 14:2\x*
\v 17 \w E saiu|strong="H3318"\w* \w o destruidor|strong="H7843"\w* \w do acampamento|strong="H4264"\w* \w dos filisteus|strong="H6430"\w* \w em três|strong="H7969,H7218"\w* \w grupos|strong="H7218"\w*: \w um grupo|strong="H7218,H0259"\w* \w virava-se|strong="H6437"\w* \w para o caminho|strong="H0413,H1870"\w* \w de Ofra|strong="H6084"\w*, \w para a terra|strong="H0413,H0776"\w* \w de Sual|strong="H7777"\w*;\x - \xo 13:17 \xt 1SA 14:15; JOS 18:23; JDG 20:42\x*
\v 18 \w e um grupo|strong="H7218,H0259"\w* \w virava-se|strong="H6437"\w* \w pelo caminho|strong="H1870"\w* \w de Bete-Horom|strong="H1032"\w*, \w e um grupo|strong="H7218,H0259"\w* \w virava-se|strong="H6437"\w* \w pelo caminho|strong="H1870"\w* \w do limite|strong="H1366"\w* \w que olha|strong="H8259"\w* \w sobre|strong="H5921"\w* \w o vale|strong="H1516"\w* \w de Zeboim|strong="H6650"\w*, \w para o deserto|strong="H4057"\w*.\x - \xo 13:18 \xt NEH 11:34; JOS 18:13-14; JOS 16:3\x*
\v 19 \w E ferreiro|strong="H2796"\w* \w não|strong="H3808"\w* \add se\add* \w achava|strong="H4672"\w* \w em toda|strong="H3605"\w* \w a terra|strong="H0776"\w* \w de Israel|strong="H3478"\w*, \w porque|strong="H3588"\w* \w os filisteus tinham dito|strong="H0559,H6430"\w*\f + \fr 13.19: \ft Variante: a Ketiv tem o singular "ele disse"; a Qere, que seguimos, o plural "disseram"\f*: \add "Para\add* \w que|strong="H6435"\w* não \w façam|strong="H6213"\w* \w os hebreus|strong="H5680"\w* \w espada|strong="H2719"\w* \w ou|strong="H0176"\w* \w lança|strong="H2595"\w*."\x - \xo 13:19 \xt 2KI 24:14; JER 24:1; JDG 5:8; 1CH 17:10; DEU 28:43; JDG 3:31\x*
\v 20 \w E todo|strong="H3381,H3605"\w* \w o Israel|strong="H3478"\w* \w descia|strong="H3381"\w* \w aos filisteus|strong="H6430"\w* \w para afiar|strong="H3913"\w*, \add cada\add* \w um|strong="H0376"\w*, \w a sua enxada|strong="H4281"\w* \w e|strong="H0853"\w* \w a sua picareta|strong="H0855"\w* \w e|strong="H0853"\w* \w o seu machado|strong="H7134"\w* \w e|strong="H0853"\w* \w a sua relha|strong="H4281"\w*.\x - \xo 13:20 \xt PRO 27:17; 1CH 17:10; DEU 28:43; JDG 3:31\x*
