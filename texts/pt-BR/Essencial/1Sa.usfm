\v 4 \w E os homens|strong="H0559,H0582"\w* \w de David|strong="H1732"\w* \add lhe\add* \w disseram|strong="H0413"\w*: "\w Eis|strong="H2009"\w* \w o dia|strong="H3117"\w* \add em\add* \w que|strong="H0834"\w* \add te\add* \w disse|strong="H0559,H3068,H0413"\w*: '\w Eis|strong="H2009"\w* \add que\add* \w eu|strong="H0595"\w* \w entregarei|strong="H5414"\w* \w o teu inimigo|strong="H0341"\w*\f + \fr 24.4: \ft Variante: a Ketiv tem "os teus inimigos" (no plural, אֹיְבֶיךָ); a Qere, que seguimos, "o teu inimigo" (no singular, אֹיִבְךָ)\f* \w na tua mão|strong="H3027"\w*; \w e lhe farás|strong="H6213,H9033"\w* \w assim como|strong="H0834"\w* \add for\add* \w bom|strong="H3190"\w* \w aos teus olhos|strong="H5869"\w*.'"\w E David se levantou|strong="H6965,H1732"\w*, \w e cortou|strong="H3772,H0853"\w* \w a orla|strong="H3671"\w* \w do manto|strong="H4598"\w* \w que|strong="H0834"\w* \add pertencia\add* \w a Saul|strong="H7586"\w*, \w secretamente|strong="H3909"\w*.\x - \xo 24:4 \xt 1SA 26:8; 1SA 24:10; 1SA 26:23; 1SA 25:28-30; 1SA 23:7; EXO 21:13\x*
\v 5 \w E aconteceu|strong="H1961"\w*, \w depois|strong="H0310"\w* \w disso|strong="H3651"\w*, \w que o feriu|strong="H5221,H0853"\w* \w o coração|strong="H3820"\w* \w de David|strong="H1732"\w*, \w por|strong="H5921"\w* \add ter\add* \w cortado|strong="H0834,H3772"\w* \w a orla|strong="H3671"\w* \w que|strong="H0834"\w* \add pertencia\add* \w a Saul|strong="H7586"\w*.\x - \xo 24:5 \xt 2SA 24:10; 2KI 22:19; 1JN 3:20-21; 1SA 23:7; 2SA 12:9; ROM 13:5\x*
\v 6 \w E disse|strong="H0559"\w* \w aos seus homens|strong="H0582"\w*: "\w Guarde-me|strong="H2486,H9030"\w* \w o SENHOR|strong="H3068"\w* \w de|strong="H0518"\w* \w fazer|strong="H6213"\w* \w esta coisa|strong="H1697,H2088"\w* \w ao meu senhor|strong="H0113"\w*, \w ao ungido|strong="H4899"\w* \w do SENHOR|strong="H3068"\w*, \w estendendo|strong="H7971"\w* \w a minha mão|strong="H3027"\w* \add contra\add* \w ele|strong="H9033"\w*; \w pois|strong="H3588"\w* \add é\add* \w o ungido|strong="H4899"\w* \w do SENHOR|strong="H3068"\w* \w ele|strong="H1931"\w*."\x - \xo 24:6 \xt 1SA 26:11; GEN 44:7; 1SA 12:3; 2SA 1:14; EXO 22:28; 1SA 23:7\x*
\v 7 \w Assim David reprimiu|strong="H8156,H1732"\w* \w os seus homens|strong="H0582"\w* \w com essas palavras|strong="H1697"\w*, \w e não|strong="H3808"\w* \w os deixou|strong="H5414"\w* \w se levantarem|strong="H6965"\w* \w contra|strong="H0413"\w* \w Saul|strong="H7586"\w*; \w e Saul|strong="H7586"\w* \add se\add* \w levantou|strong="H6965"\w* \w da caverna|strong="H4631"\w*, \w e foi|strong="H1980"\w* \w pelo caminho|strong="H1870"\w*.\x - \xo 24:7 \xt 1SA 26:23; 1SA 26:9; ISA 33:15; MAT 5:44; PSA 7:4\x*
\p
\v 8 \w E David se levantou|strong="H6965,H1732"\w* \w depois|strong="H0310,H3651"\w*, \w e saiu|strong="H3318"\w* \w da caverna|strong="H4631"\w*\f + \fr 24.8: \ft Variante: a Ketiv separa em duas palavras "de" (מִן) e "a caverna" (הַמְּעָרָה); a Qere, que seguimos, lê como uma só palavra "da caverna" (מֵהַמְּעָרָה)\f*, \w e gritou|strong="H7121"\w* \w atrás|strong="H0310"\w* \w de Saul|strong="H7586"\w*, \w dizendo|strong="H0559"\w*: "\w Meu senhor|strong="H0113"\w*, \w ó rei|strong="H4428"\w*!"\w E Saul olhou|strong="H5027,H7586"\w* \w para trás|strong="H0310"\w*, \w e David se inclinou|strong="H6915,H1732"\w* \w com o rosto|strong="H0639"\w* \w em terra|strong="H0776"\w*, \w e se prostrou|strong="H7812"\w*.\x - \xo 24:8 \xt 1KI 1:16; GEN 24:26; 1KI 1:31; 1SA 25:23; PSA 57:1\x*
