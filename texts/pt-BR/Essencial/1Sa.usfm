\v 25 \w E Saul disse|strong="H0559,H7586"\w* \w a|strong="H0413"\w* \w David|strong="H1732"\w*: "\w Bendito|strong="H1288"\w* \w sejas tu|strong="H0859"\w*, \w meu filho|strong="H1121"\w* \w David|strong="H1732"\w*; \w também|strong="H1571"\w* \w certamente|strong="H6213"\w* \w farás|strong="H6213"\w*, \w e também|strong="H1571"\w* \w certamente|strong="H3201"\w* \w prevalecerás|strong="H3201"\w*."\w E David foi|strong="H1980,H1732"\w* \w pelo seu caminho|strong="H1870"\w*; \w e Saul|strong="H7586"\w* \w voltou|strong="H7725"\w* \w ao seu lugar|strong="H4725"\w*.\x - \xo 26:25 \xt DEU 14:24; EXO 18:23; GEN 32:28; NUM 24:9-10; PRO 19:19; 1SA 24:19\x*
