\v 7 \w E os filisteus|strong="H6430"\w* \w temeram|strong="H3372"\w*, \w porque|strong="H3588"\w* \w disseram|strong="H0559"\w*: \add "Um\add* \w deus|strong="H0430"\w* \w entrou|strong="H0935"\w* \w no acampamento|strong="H0413,H4264"\w*!"\w E disseram|strong="H0559"\w*: "\w Ai|strong="H0188"\w* \w de nós|strong="H9035"\w*! \w Porque|strong="H3588"\w* \w nunca|strong="H3808,H1961,H0865,H8032"\w* \w aconteceu|strong="H1961"\w* \w coisa assim|strong="H2063"\w* \w antes|strong="H0865,H8032"\w*."\x - \xo 4:7 \xt 1SA 14:21; EXO 14:25; PSA 78:60; ISA 41:6; NUM 14:44\x*
\v 8 \w Ai|strong="H0188"\w* \w de nós|strong="H9035"\w*! \w Quem|strong="H4310"\w* \add nos\add* \w livrará|strong="H5337"\w* \w da mão|strong="H3027"\w* \w destes deuses|strong="H0430,H0117,H0428"\w* \w tão|strong="H0117"\w* \w poderosos|strong="H0117"\w*? \w Estes são|strong="H0428,H1992"\w* \w os deuses|strong="H0430"\w* \w que feriram|strong="H5221"\w* \w o Egito|strong="H4714"\w* \w com toda|strong="H3605"\w* \w praga|strong="H4347"\w* \w no deserto|strong="H4057"\w*.\x - \xo 4:8 \xt EXO 14:25; 1KI 20:23; DEU 32:31; PSA 78:60; ROM 9:17; DEU 7:21\x*
\v 9 \w Encorajem-se|strong="H2388"\w* \w e sejam|strong="H1961"\w* \w homens|strong="H0582"\w*, \w filisteus|strong="H6430"\w*, \w para que não|strong="H6435"\w* \w sirvam|strong="H5647"\w* \w aos hebreus|strong="H5680"\w* \w como|strong="H0834"\w* \add eles\add* \w serviram|strong="H5647"\w* \w a vocês|strong="H9036"\w*; \w sejam|strong="H1961"\w* \w homens|strong="H0582"\w* \w e lutem|strong="H3898"\w*.\x - \xo 4:9 \xt 1CO 16:13; JOS 1:6; 2SA 10:12; JDG 13:1; 1CH 19:13; EPH 6:10-11\x*
\v 10 \w Os filisteus lutaram|strong="H3898,H6430"\w*, \w e Israel|strong="H3478"\w* \add foi\add* \w derrotado|strong="H5062"\w*, \w e cada um|strong="H0376"\w* \w fugiu|strong="H5127"\w* \w para a sua tenda|strong="H0168"\w*; \w e a derrota|strong="H1961,H4347"\w* \w foi|strong="H1961"\w* \w muito|strong="H3966"\w* \w grande|strong="H1419"\w*, \w e caíram|strong="H5307"\w* \w de Israel|strong="H3478"\w* \w trinta|strong="H7970"\w* \w mil|strong="H0505"\w* \w homens|strong="H7273"\w* \w a pé|strong="H7273"\w*.\x - \xo 4:10 \xt 2KI 14:12; 2CH 25:22; 1SA 19:8; JER 7:12; 1SA 4:2; DEU 28:25\x*
