\p
\v 11 \w E Samuel disse|strong="H0559,H8050"\w*: "\w Que|strong="H4100"\w* \add fez\add* \w você|strong="H6213"\w*?"\w E Saul disse|strong="H0559,H7586"\w*: "\w Porque|strong="H3588"\w* \w vi|strong="H7200"\w* \w que|strong="H3588"\w* \w o povo|strong="H5971"\w* \add se\add* \w dispersava|strong="H5310"\w* \add de\add* \w mim|strong="H5921"\w*, \w e você|strong="H0859"\w* \w não|strong="H3808"\w* \w chegava|strong="H0935"\w* \w no prazo|strong="H4150"\w* \w marcado|strong="H3117"\w*, \w e os filisteus|strong="H6430"\w* \add se\add* \w reuniam|strong="H0622"\w* \w em Micmás|strong="H4363"\w*,\x - \xo 13:11 \xt 1SA 13:16; 1SA 13:23; 1SA 10:8; 1SA 13:2; 1SA 13:5; 2KI 5:25\x*
\v 12 \add eu\add* \w disse|strong="H0559"\w*: '\w Agora|strong="H6258"\w* \w descerão|strong="H3381"\w* \w os filisteus|strong="H6430"\w* \add contra\add* \w mim|strong="H0413"\w* \w em Gilgal|strong="H1537"\w*, \w e eu não|strong="H3808"\w* \w implorei|strong="H2470"\w* \w o favor|strong="H6440,H3068"\w* \w do SENHOR|strong="H3068"\w*.' \w E me contive|strong="H0662"\w* \w e ofereci|strong="H5927"\w* \w o holocausto|strong="H5930"\w*."\x - \xo 13:12 \xt 1SA 10:8; ECC 5:1; ZEC 7:2; 1KI 12:26-27; 2CO 9:7; AMO 8:5\x*
