\v 9 \w Então Ana|strong="H2584"\w* \w levantou-se|strong="H6965"\w* \w depois|strong="H0310"\w* \w de comer|strong="H0398"\w* \w em Siló|strong="H7887"\w* \w e depois|strong="H0310"\w* \w de beber|strong="H8354"\w*. \w E Eli|strong="H5941"\w*, \w o sacerdote|strong="H3548"\w*, \add estava\add* \w sentado|strong="H3427"\w* \w na cadeira|strong="H5921,H3678"\w*, \w junto ao batente|strong="H5921,H4201"\w* \w do templo|strong="H1964"\w* \w do SENHOR|strong="H3068"\w*.\x - \xo 1:9 \xt 1SA 1:3; 1SA 3:3; PSA 27:4; 1SA 4:13; PSA 5:7; 2SA 7:2\x*
\v 10 \w E ela|strong="H1931"\w* \w estava amargurada de alma|strong="H4751,H5315"\w* \w e orava|strong="H6419"\w* \w ao SENHOR|strong="H5921,H3068"\w*, \w chorando|strong="H1058"\w* \w muito|strong="H1058"\w*.\x - \xo 1:10 \xt JOB 10:1; JOB 7:11; JOB 21:25; PRO 31:6; ISA 38:15; JOB 3:20\x*
\v 11 \w Ela fez|strong="H5087"\w* \w um voto|strong="H5088"\w* \w e disse|strong="H0559"\w*: "\w SENHOR|strong="H3068"\w* \w dos Exércitos|strong="H6635"\w*, \w se|strong="H0518"\w* \w realmente olhares|strong="H7200"\w* \w para a aflição|strong="H6040"\w* \w da sua serva|strong="H0519"\w* \w e se lembrares de mim|strong="H2142"\w* \w e não|strong="H3808"\w* \w esqueceres|strong="H7911"\w* \w a sua serva|strong="H0519"\w*, \w e deres|strong="H5414"\w* \w à sua serva|strong="H0519"\w* \w descendência masculina|strong="H2233,H0582"\w*, \w eu o darei|strong="H5414"\w* \w ao SENHOR|strong="H3068"\w* \w todos|strong="H3605"\w* \w os dias|strong="H3117"\w* \w da sua vida|strong="H2416"\w*, \w e a navalha|strong="H4177"\w* \w não|strong="H3808"\w* \w subirá|strong="H5927"\w* \w sobre|strong="H5921"\w* \w a sua cabeça|strong="H7218"\w*."\x - \xo 1:11 \xt NUM 21:2; JDG 11:30; 1PE 5:7; JDG 13:5; NUM 6:5; GEN 25:21\x*
\v 12 \w E aconteceu|strong="H1961"\w* \w que|strong="H3588"\w*, \w enquanto ela orava|strong="H7235,H6419"\w* \w longamente|strong="H7235"\w* \w diante do SENHOR|strong="H6440,H3068"\w*, \w Eli observava|strong="H5941,H8104"\w* \w a sua boca|strong="H6310"\w*.\x - \xo 1:12 \xt 1PE 5:7; 1SA 1:27; 1TH 5:17; JAS 5:16; COL 4:2; EPH 6:18\x*
\v 13 \w E Ana|strong="H2584"\w* \w ela|strong="H1931"\w* \w falava|strong="H1696"\w* \w no seu coração|strong="H5921,H3820"\w*; \w só|strong="H7535"\w* \w os seus lábios|strong="H8193"\w* \w se moviam|strong="H5128"\w*, \w e a sua voz|strong="H6963"\w* \w não|strong="H3808"\w* \add se\add* \w ouvia|strong="H8085"\w*; \w por isso Eli|strong="H5941"\w* \w a considerou|strong="H2803"\w* \w embriagada|strong="H7910"\w*.\x - \xo 1:13 \xt 1PE 5:7; ROM 8:26; ACT 2:13; GEN 24:42-45; 1SA 1:27; PSA 25:1\x*
\p
\v 14 \w Eli disse-lhe|strong="H0559,H0413,H5941"\w*: "\w Até|strong="H5704"\w* \w quando|strong="H4970"\w* \add estarás\add* \w embriagada|strong="H7937"\w*? \w Afasta|strong="H5493"\w* \w o seu vinho|strong="H3196"\w* \w de si|strong="H5921"\w*!"\x - \xo 1:14 \xt 1PE 5:7; ACT 2:13; ISA 51:21\x*
\p
\v 15 \w Ana respondeu|strong="H6030,H2584,H0559"\w*: "\w Não|strong="H3808"\w*, \add meu\add* \w senhor|strong="H0113"\w*; \w eu|strong="H0595"\w* \w sou uma mulher|strong="H0802"\w* \w de espírito angustiado|strong="H7186,H7307"\w*; \w vinho|strong="H3196"\w* \w e bebida forte|strong="H7941"\w* \w não|strong="H3808"\w* \w bebi|strong="H8354"\w*, \w mas derramei|strong="H8210"\w* \w a minha alma|strong="H5315"\w* \w diante do SENHOR|strong="H6440,H3068"\w*.\x - \xo 1:15 \xt PHP 4:6; 1PE 5:7; PSA 62:8; LAM 2:19; PSA 25:1; PSA 42:4\x*
\v 16 \w Não|strong="H0408"\w* \w considere|strong="H5414"\w* \w a sua serva|strong="H0519"\w* \w como uma filha|strong="H6440,H1323"\w* \w de Belial|strong="H1100"\w*\f + \fr 1.16: \ft Lit.: hebraico "filha de Belial", pessoa vil, sem valor\f*, \w pois|strong="H3588"\w* \w pela grandeza|strong="H7230"\w* \w da minha aflição|strong="H7879"\w* \w e da minha provocação|strong="H3708"\w* \w é que tenho falado|strong="H1696"\w* \w até|strong="H5704"\w* \w agora|strong="H2008"\w*."\x - \xo 1:16 \xt 1PE 5:7; PSA 5:1; PSA 142:2; 1SA 2:12; JHN 20:15; PSA 42:4\x*
\p
\v 17 \w Eli respondeu|strong="H6030,H5941,H0559"\w*: "\w Vá|strong="H1980"\w* \w em paz|strong="H7965"\w*; \w e o Deus|strong="H0430"\w* \w de Israel|strong="H3478"\w* \w conceda|strong="H5414"\w* \w a sua petição|strong="H7596"\w* \w que|strong="H0834"\w* \w pediu|strong="H7592"\w* \w a ele|strong="H5973"\w*."\x - \xo 1:17 \xt 1SA 2:20; 1KI 2:16; 1SA 1:27; 1PE 5:7; MRK 5:34; JDG 18:6\x*
\v 18 \w Ela disse|strong="H0559"\w*: \add "Que\add* \w ache|strong="H4672"\w* \w a sua serva|strong="H8198"\w* \w favor|strong="H2580"\w* \w aos seus olhos|strong="H5869"\w*."\w Então a mulher|strong="H0802"\w* \w foi|strong="H1980"\w* \w pelo seu caminho|strong="H1870"\w* \w e comeu|strong="H0398"\w*, \w e o seu rosto|strong="H6440"\w* \w não foi mais|strong="H3808,H1961,H9034,H5750"\w* \add triste.\add*\x - \xo 1:18 \xt RUT 2:13; GEN 32:5; EXO 33:12; EXO 33:17; GEN 33:15; GEN 33:8\x*
\p
\v 19 \w Eles se levantaram|strong="H7925"\w* \w de madrugada|strong="H1242"\w* \w e se prostraram|strong="H7812"\w* \w diante do SENHOR|strong="H6440,H3068"\w*, \w e voltaram|strong="H7725"\w* \w e foram|strong="H0935"\w* \w para a sua casa|strong="H0413,H1004"\w*, \w em Ramá|strong="H7414"\w*. \w E Elcana|strong="H0511"\w* \w conheceu|strong="H3045"\w* \w Ana|strong="H2584"\w*, \w sua mulher|strong="H0802"\w*, \w e o SENHOR|strong="H3068"\w* \w se lembrou|strong="H2142"\w* \w dela|strong="H2142"\w*.\x - \xo 1:19 \xt 1SA 2:11; GEN 8:1; PSA 127:3; GEN 30:22; GEN 21:1; LUK 1:25\x*
\v 20 \w E aconteceu|strong="H1961"\w* \add que,\add* \w ao fim|strong="H8622"\w* \w de um certo tempo|strong="H3117"\w*, \w Ana|strong="H2584"\w* \w concebeu|strong="H2029"\w* \w e deu à luz|strong="H3205"\w* \w um filho|strong="H1121"\w*; \w e chamou|strong="H7121"\w* \w o seu nome|strong="H8034"\w* \w Samuel|strong="H8050"\w*, \w porque|strong="H3588"\w* \add disse:\add* "\w Ao SENHOR|strong="H3068"\w* \add o\add* \w pedi|strong="H7592"\w*."\x - \xo 1:20 \xt 1SA 2:21; PSA 127:3; EXO 2:10; GEN 30:22; LUK 1:13; LUK 1:25\x*
\v 21 \w E o homem|strong="H0376"\w* \w Elcana|strong="H0511"\w* \w subiu|strong="H5927"\w*, \w com toda|strong="H3605"\w* \w a sua casa|strong="H1004"\w*, \w para sacrificar|strong="H2076"\w* \w ao SENHOR|strong="H3068"\w* \w o sacrifício|strong="H2077"\w* \w anual|strong="H3117"\w* \w e|strong="H0853"\w* \w o seu voto|strong="H5088"\w*.\x - \xo 1:21 \xt 1KI 8:62; 2CH 7:4; 1SA 2:19; JON 1:16; LUK 1:13; 1SA 1:3\x*
\v 22 \w Mas Ana|strong="H2584"\w* \w não|strong="H3808"\w* \w subiu|strong="H5927"\w*, \w pois|strong="H3588"\w* \add tinha\add* \w dito|strong="H0559"\w* \w ao seu marido|strong="H0376"\w*: "\w Até que|strong="H5704"\w* \w o menino|strong="H5288"\w* \add seja\add* \w desmamado|strong="H1580"\w*, \add então eu o\add* \w levarei|strong="H0935"\w*, \w para que ele apareça|strong="H7200"\w* \w perante|strong="H0854,H6440"\w* \w o SENHOR|strong="H3068"\w* \w e lá|strong="H8033"\w* \w fique|strong="H3427"\w* \w para|strong="H5704"\w* \w sempre|strong="H5769"\w*."\x - \xo 1:22 \xt LUK 1:13; 1SA 1:11; 1SA 1:28; MRK 10:14; LUK 2:22; GEN 21:8\x*
\p
\v 23 \w Elcana, seu marido, disse-lhe|strong="H0559,H9034,H0511,H0376"\w*: "\w Faça|strong="H6213"\w* \w o que bem lhe parecer|strong="H2896,H5869"\w*; \w fique|strong="H3427"\w* \w até|strong="H5704"\w* \w o desmamar|strong="H1580,H0853"\w*; \w somente|strong="H0389"\w* \w cumpra|strong="H6965"\w* \w o SENHOR|strong="H3068"\w* \w a sua palavra|strong="H1697"\w*."\w E a mulher|strong="H0802"\w* \w ficou|strong="H3427"\w* \w e amamentou|strong="H3243"\w* \w o seu filho|strong="H1121"\w* \w até|strong="H5704"\w* \w o desmamar|strong="H1580,H0853"\w*.\x - \xo 1:23 \xt LUK 1:13; 2SA 7:25; 1KI 3:21\x*
\p
\v 24 \w E ela o levou|strong="H5927"\w* \w consigo|strong="H5973"\w*, \w assim que|strong="H0834"\w* \w o desmamou|strong="H1580"\w*, \w com três|strong="H6499,H7969"\w* \w touros|strong="H6499"\w*, \w um efa|strong="H0374,H0259"\w* \w de farinha|strong="H7058"\w* \w e um odre|strong="H5035"\w* \w de vinho|strong="H3196"\w*, \w e o levou|strong="H0935"\w* \w à casa|strong="H1004"\w* \w do SENHOR|strong="H3068"\w* \w em Siló|strong="H7887"\w*; \w e o menino|strong="H5288"\w* \w ainda era criança|strong="H5288"\w*.\x - \xo 1:24 \xt NUM 15:9-10; 1SA 4:3-4; JOS 18:1; DEU 12:5-6; LUK 18:15; PSA 56:12\x*
\v 25 \w Eles imolaram|strong="H7819"\w* \w o touro|strong="H6499"\w* \w e trouxeram|strong="H0935"\w* \w o menino|strong="H5288"\w* \w a|strong="H0413"\w* \w Eli|strong="H5941"\w*.\x - \xo 1:25 \xt LUK 18:15-16; PSA 56:12; LUK 2:22\x*
\p
\v 26 \w Ela disse|strong="H0559"\w*: \add "Com\add* \w licença|strong="H0994"\w*, \add meu\add* \w senhor|strong="H0113"\w*! \w Pela vida|strong="H2416"\w* \w da sua alma|strong="H5315"\w*, \add meu\add* \w senhor|strong="H0113"\w*, \w eu|strong="H0589"\w* \w sou a mulher|strong="H0802"\w* \w que esteve aqui|strong="H5324,H2088"\w* \w com você|strong="H5973"\w*, \w orando|strong="H6419"\w* \w ao|strong="H0413"\w* \w SENHOR|strong="H3068"\w*.\x - \xo 1:26 \xt 1KI 3:17; GEN 21:6; PRO 13:12; PSA 116:1; 2KI 2:2; 2KI 2:4\x*
\v 27 \w Por este|strong="H0413,H2088"\w* \w menino|strong="H5288"\w* \w orei|strong="H6419"\w*, \w e o SENHOR|strong="H3068"\w* \w concedeu-me|strong="H5414,H9030"\w* \w a petição|strong="H7596"\w* \w que|strong="H0834"\w* \w lhe pedi|strong="H7592,H5973"\w*.\x - \xo 1:27 \xt 1KI 2:16; 1SA 2:20; 1SA 1:17; 1KI 2:20; PSA 127:3; GEN 25:21\x*
\v 28 \w E também eu|strong="H1571,H0595"\w* \w o entrego|strong="H7592"\w* \w ao SENHOR|strong="H3068"\w*; \w por todos|strong="H3605"\w* \w os dias|strong="H3117"\w* \w que|strong="H0834"\w* \w ele|strong="H1931"\w* \w viver|strong="H1961"\w*, \w estará dedicado|strong="H7592"\w* \w ao SENHOR|strong="H3068"\w*."\w E ele se prostrou|strong="H7812"\w* \w ali|strong="H8033"\w* \w diante do SENHOR|strong="H3068"\w*.\x - \xo 1:28 \xt JOB 42:4; PRO 22:6; GEN 24:26; 1SA 1:22; ECC 12:1; MRK 10:14\x*
\c 2
\q1
\v 1 \w Ana orou|strong="H6419,H2584"\w* \w e disse|strong="H0559"\w*: "\w O meu coração|strong="H3820"\w* \w exulta|strong="H5970"\w* \w no SENHOR|strong="H3068"\w*; \w o meu poder|strong="H7161"\w*\f + \fr 2.1: \ft Lit.: hebraico "o meu chifre", símbolo de força\f* \add se\add* \w exalta|strong="H7311"\w* \w no SENHOR|strong="H3068"\w*; \w a minha boca|strong="H6310"\w* \w se abre larga|strong="H7337"\w* \w contra|strong="H5921"\w* \w os meus inimigos|strong="H0341"\w*, \w porque|strong="H3588"\w* \w eu me alegro|strong="H8055"\w* \w na tua salvação|strong="H3444"\w*.\x - \xo 2:1 \xt LUK 1:46; PSA 13:5; PSA 28:7; PSA 92:10; HAB 3:18; 1PE 1:6\x*
\q1
