\v 13 \w E David disse|strong="H0559,H1732"\w* \w aos seus homens|strong="H0582"\w*: "\w Cinjam|strong="H2296"\w* \add cada\add* \w um|strong="H0376"\w* \w a sua espada|strong="H2719"\w*!"\w E cingiram|strong="H2296"\w* \add cada\add* \w um|strong="H0376"\w* \w a sua espada|strong="H2719"\w*; \w e David|strong="H1732"\w* \w também|strong="H1571"\w* \w cingiu|strong="H2296"\w* \w a sua espada|strong="H2719"\w*. \w E subiram|strong="H5927"\w* \w após|strong="H0310"\w* \w David|strong="H1732"\w* \w cerca de quatrocentos|strong="H0702,H3967"\w* \w homens|strong="H0376"\w*, \w e duzentos|strong="H3967"\w* \w ficaram|strong="H3427"\w* \w com|strong="H5921"\w* \w a bagagem|strong="H3627"\w*.\x - \xo 25:13 \xt PRO 15:1; 1SA 22:2; 1SA 23:13; 1SA 27:2\x*
