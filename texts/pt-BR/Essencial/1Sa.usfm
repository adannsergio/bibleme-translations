\v 1 \w E a palavra|strong="H1961,H1697"\w* \w de Samuel|strong="H8050"\w* \w veio|strong="H1961"\w* \w a todo|strong="H3605"\w* \w o Israel|strong="H3478"\w*. \w E Israel|strong="H3478"\w* \w saiu|strong="H3318"\w* \w ao encontro|strong="H7122"\w* \w dos filisteus|strong="H6430"\w* \w para a batalha|strong="H4421"\w* \w e se acampou|strong="H2583"\w* \w junto|strong="H5921"\w* \w a Ebenézer|strong="H0072"\w*, \w e os filisteus|strong="H6430"\w* \w se acamparam|strong="H2583"\w* \w em Afeque|strong="H0663"\w*.\x - \xo 4:1 \xt 1SA 29:1; 1SA 5:1; 1SA 7:12; JOS 13:4\x*
\v 2 \w E os filisteus|strong="H6430"\w* \add se puseram em\add* \w linha|strong="H6186"\w* \w ao encontro|strong="H7122"\w* \w de Israel|strong="H3478"\w*, \w e a batalha|strong="H4421"\w* \add se\add* \w estendeu|strong="H5203"\w*, \w e Israel|strong="H3478"\w* \add foi\add* \w derrotado|strong="H5062"\w* \w diante dos filisteus|strong="H6440,H6430"\w*, \w que mataram|strong="H5221"\w* \w no campo de batalha|strong="H4634,H7704"\w* \w cerca de quatro|strong="H0702"\w* \w mil|strong="H0505"\w* \w homens|strong="H0376"\w*.\x - \xo 4:2 \xt 1SA 17:21; 1SA 4:10; JDG 18:30; LAM 3:40; PSA 78:62\x*
