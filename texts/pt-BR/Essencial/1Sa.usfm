\v 13 \w Assim foram subjugados|strong="H3665"\w* \w os filisteus|strong="H6430"\w*, \w e não|strong="H3808"\w* \w voltaram|strong="H3254,H5750"\w* \w mais|strong="H5750"\w* \w a entrar|strong="H0935"\w* \w no território|strong="H1366"\w* \w de Israel|strong="H3478"\w*; \w e a mão|strong="H3027,H3068"\w* \w do SENHOR|strong="H3068"\w* \w esteve|strong="H1961"\w* \w contra|strong="H6430"\w* \w os filisteus|strong="H6430"\w* \w todos|strong="H3605"\w* \w os dias|strong="H3117"\w* \w de Samuel|strong="H8050"\w*.\x - \xo 7:13 \xt JDG 13:1; 2SA 8:1; EXO 10:29; ISA 8:5; 1SA 5:9; JDG 13:5\x*
