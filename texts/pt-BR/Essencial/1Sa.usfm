\c 22
\p
\v 1 \w E David foi|strong="H1980,H1732"\w* \w dali|strong="H8033"\w*, \w e se escapou|strong="H4422"\w* \w para a caverna|strong="H0413,H4631"\w* \w de Adulão|strong="H5725"\w*; \w e seus irmãos|strong="H0251"\w* \w e toda|strong="H3605"\w* \w a casa|strong="H1004"\w* \w de seu pai|strong="H0001"\w* \w ouviram|strong="H8085"\w*, \w e desceram|strong="H3381"\w* \add a\add* \w ele|strong="H0413"\w* \w ali|strong="H8033"\w*.\x - \xo 22:1 \xt 2SA 23:13; 1CH 11:15; PSA 56:8; HEB 11:38; JOS 15:35; PSA 57:1\x*
\v 2 \w E se reuniram|strong="H6908"\w* \add a\add* \w ele|strong="H0413"\w* \w todo homem|strong="H3605,H0376"\w* \w em aflição|strong="H4689"\w*, \w e todo homem|strong="H3605,H0376"\w* \w que|strong="H0834"\w* \w tinha|strong="H9033"\w* \w um credor|strong="H5378"\w*, \w e todo|strong="H3605"\w* \w homem|strong="H0376"\w* \w de alma amargurada|strong="H4751,H5315"\w*; \w e ele se tornou|strong="H1961"\w* \add sobre\add* \w eles|strong="H5921"\w* \w em comandante|strong="H8269"\w*; \w e estavam|strong="H1961"\w* \add com\add* \w ele|strong="H5973"\w* \w cerca de quatrocentos|strong="H0702,H3967"\w* \w homens|strong="H0376"\w*.\x - \xo 22:2 \xt 1SA 1:10; PSA 56:8; MAT 11:28; PSA 72:12-14; 1SA 23:13; 1SA 25:13\x*
