\v 4 \w Chegaram|strong="H0935"\w* \w os mensageiros|strong="H4397"\w* \w a Gibeá|strong="H1390"\w* \w de Saul|strong="H7586"\w* \w e falaram|strong="H1696"\w* \w as palavras|strong="H1697"\w* \w aos ouvidos|strong="H0241"\w* \w do povo|strong="H5971"\w*; \w e todo|strong="H3605,H5971"\w* \w o povo|strong="H5971"\w* \w levantou|strong="H5375"\w* \w a sua voz|strong="H6963"\w* \w e chorou|strong="H1058"\w*.\x - \xo 11:4 \xt JDG 2:4; 1SA 30:4; 1SA 15:34; 1SA 10:26; 1SA 24:16; JDG 21:2\x*
\v 5 \w E eis que|strong="H2009"\w* \w Saul|strong="H7586"\w* \w vinha|strong="H0935"\w* \w atrás do gado|strong="H0310,H1241"\w* \w do campo|strong="H4480,H7704"\w*, \w e Saul disse|strong="H0559,H7586"\w*: "\w Que|strong="H4100,H5971"\w* \add tem o\add* \w povo|strong="H5971"\w*, \w que|strong="H3588"\w* \add está\add* \w chorando|strong="H1058"\w*?"\w E lhe contaram|strong="H5608,H9033"\w* \w as palavras|strong="H1697"\w* \w dos homens|strong="H0582"\w* \w de Jabes|strong="H3003"\w*.\x - \xo 11:5 \xt 1KI 19:19; 1CH 10:11; 1SA 31:11\x*
\v 6 \w E se apossou|strong="H6743"\w* \w o espírito|strong="H7307,H0430"\w* \w de Deus|strong="H0430"\w* \w de Saul|strong="H5921,H7586"\w*, \w quando ele ouviu|strong="H8085"\w*\f + \fr 11.6: \ft Variante: pequena diferença de grafia entre Ketiv e Qere na forma do verbo "ouvir"; sem efeito no sentido\f* \w aquelas palavras|strong="H1697,H0428"\w*, \w e se acendeu|strong="H2734"\w* \w a sua ira|strong="H0639"\w* \w muito|strong="H3966"\w*.\x - \xo 11:6 \xt 2SA 13:21; JDG 14:19; NUM 12:9; GEN 39:19; 1SA 10:10; JDG 3:10\x*
\v 7 \w E ele tomou|strong="H3947"\w* \w uma junta|strong="H6776"\w* \w de bois|strong="H1241"\w* \w e a cortou em pedaços|strong="H5408"\w* \w e os enviou|strong="H7971"\w* \w por todo|strong="H3605"\w* \w o território|strong="H1366"\w* \w de Israel|strong="H3478"\w*, \w pela mão|strong="H3027,H4397"\w* \w dos mensageiros|strong="H4397"\w*, \w dizendo|strong="H0559"\w*: "\w Quem|strong="H0834"\w* \w não|strong="H0369"\w* \w saia|strong="H3318"\w* \w atrás|strong="H0310"\w* \w de Saul|strong="H7586"\w* \w e atrás|strong="H0310"\w* \w de Samuel|strong="H8050"\w*, \w assim|strong="H3541"\w* \add se\add* \w fará|strong="H6213"\w* \w ao seu gado|strong="H1241"\w*."\w E caiu|strong="H5307"\w* \w o terror|strong="H6343"\w* \w do SENHOR|strong="H3068"\w* \w sobre|strong="H5921"\w* \w o povo|strong="H5971"\w*, \w e saíram|strong="H3318"\w* \w como|strong="H0376"\w* \w um|strong="H0259"\w* \w só homem|strong="H0259"\w*.\x - \xo 11:7 \xt JDG 19:29; JDG 20:1; GEN 35:5; JDG 21:10\x*
\v 8 \w E ele os contou|strong="H6485"\w* \w em Bezeque|strong="H0966"\w*, \w e eram|strong="H1961"\w* \w os filhos|strong="H1121"\w* \w de Israel|strong="H3478"\w* \w trezentos|strong="H7969,H3967"\w* \w mil|strong="H0505"\w*, \w e os homens|strong="H0376"\w* \w de Judá|strong="H3063"\w*, \w trinta|strong="H7970"\w* \w mil|strong="H0505"\w*.\x - \xo 11:8 \xt JDG 1:4; NUM 2:21; NUM 4:44; NUM 4:40; NUM 26:51; NUM 2:23\x*
\p
