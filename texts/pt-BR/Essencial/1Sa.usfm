\v 3 \w Os de Asdode|strong="H0796"\w* \add se\add* \w levantaram|strong="H7925"\w* \w no dia seguinte|strong="H4283"\w*, \w e eis que|strong="H2009"\w* \w Dagom|strong="H1712"\w* \add estava\add* \w caído|strong="H5307"\w*, \w de rosto|strong="H6440"\w* \w em terra|strong="H0776"\w*, \w diante da arca|strong="H6440,H0727"\w* \w do SENHOR|strong="H3068"\w*; \w e tomaram|strong="H3947"\w* \w Dagom|strong="H1712"\w* \w e o puseram de volta|strong="H7725,H0853"\w* \w no seu lugar|strong="H4725"\w*.\x - \xo 5:3 \xt ISA 19:1; ISA 46:1; 2CO 6:14; ISA 46:7; 1CH 10:10; 1SA 6:5\x*
\v 4 \w E se levantaram|strong="H7925"\w* \w de madrugada|strong="H1242"\w* \w no dia seguinte|strong="H4283"\w*, \w e eis que|strong="H2009"\w* \w Dagom|strong="H1712"\w* \add estava\add* \w caído|strong="H5307"\w* \add outra vez,\add* \w de rosto|strong="H6440"\w* \w em terra|strong="H0776"\w*, \w diante da arca|strong="H6440,H0727"\w* \w do SENHOR|strong="H3068"\w*; \w e a cabeça de Dagom|strong="H7218,H1712"\w* \w e as duas|strong="H8147"\w* \w palmas|strong="H3709"\w* \w das suas mãos|strong="H3027"\w* \add estavam\add* \w cortadas|strong="H3772"\w* \w sobre o limiar|strong="H0413,H4670"\w*; \w só|strong="H7535"\w* \w o tronco|strong="H1712"\w* \w de Dagom|strong="H1712"\w* \w restava|strong="H7604"\w* \add sobre\add* \w ele|strong="H5921"\w*.\x - \xo 5:4 \xt MIC 1:7; 1CH 10:10; 1SA 6:5; 2CO 6:15; GEN 31:30; ISA 2:18-19\x*
