\v 13 \w E ele mudou|strong="H8138"\w* \w o seu comportamento|strong="H2940"\w* \w diante deles|strong="H5869"\w*, \w e se fingiu de louco|strong="H1984"\w* \w entre as mãos deles|strong="H3027"\w*, \w e fez marcas|strong="H8427"\w* \w nas portas|strong="H5921,H1817"\w* \w do portão|strong="H8179"\w*, \w e deixou escorrer|strong="H3381"\w* \w a sua saliva|strong="H7388"\w* \w pela sua barba|strong="H0413,H2206"\w*.\x - \xo 21:13 \xt PRO 29:25; PSA 34:1; ECC 7:7; PSA 56:1; 1SA 27:1; GEN 27:24\x*
\v 14 \w E Aquis disse|strong="H0559,H0397"\w* \w aos seus servos|strong="H0413,H5650"\w*: "\w Eis|strong="H2009"\w* \add que vocês\add* \w veem|strong="H7200"\w* \w um homem|strong="H0376"\w* \w que se comporta como louco|strong="H7696"\w*; \add por\add* \w que|strong="H4100"\w* \w trazem|strong="H0935"\w* \add a\add* \w mim|strong="H0413"\w*?"\x - \xo 21:14 \xt PSA 34:1; PSA 56:1; 1SA 27:1\x*
