\v 9 \w E Samuel|strong="H8050"\w* \w tomou|strong="H3947"\w* \w um cordeiro|strong="H2924,H2461"\w* \w de leite|strong="H2461"\w* \w só|strong="H0259"\w* \w e o ofereceu|strong="H5927"\w* \w em holocausto|strong="H5930"\w*\f + \fr 7.9: \ft Variante: a Ketiv tem "e ele ofereceu" (וַיַּעֲלֶה); a Qere, que seguimos, "e ele o ofereceu" (וַיַּעֲלֵהוּ)\f*, \w todo ele|strong="H3632"\w*, \w ao SENHOR|strong="H3068"\w*, \w e Samuel|strong="H8050"\w* \w clamou|strong="H2199"\w* \w a|strong="H0413"\w* \w o SENHOR|strong="H3068"\w* \w por|strong="H1157"\w* \w Israel|strong="H3478"\w*, \w e o SENHOR|strong="H3068"\w* \w lhe|strong="H6030"\w* \w respondeu|strong="H6030"\w*.\x - \xo 7:9 \xt JER 15:1; PSA 99:6; 1SA 12:17; 1SA 7:17; PSA 50:15; 1KI 17:20\x*
