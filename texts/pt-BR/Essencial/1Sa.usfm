\v 9 \w E David disse|strong="H0559,H1732"\w* \w a|strong="H0413"\w* \w Abisai|strong="H0052"\w*: "\w Não|strong="H0408"\w* \add o\add* \w destrua|strong="H7843"\w*; \w pois|strong="H3588"\w* \w quem|strong="H4310"\w* \w estenderia|strong="H7971"\w* \w a sua mão|strong="H3027"\w* \w contra o ungido|strong="H4899"\w* \w do SENHOR|strong="H3068"\w*, \w e ficaria impune|strong="H5352"\w*?"\x - \xo 26:9 \xt 2SA 1:14; 2SA 19:21; PSA 105:15; 1SA 24:4; 2SA 1:16; EXO 22:28\x*
\v 10 \w E David disse|strong="H0559,H1732"\w*: "\w Pela vida|strong="H2416"\w* \w do SENHOR|strong="H3068"\w*, \w que|strong="H3588"\w* \w certamente|strong="H0518"\w* \w o SENHOR|strong="H3068"\w* \add o\add* \w ferirá|strong="H5062"\w*; \w ou|strong="H0176"\w* \w chegará|strong="H0935"\w* \w o seu dia|strong="H3117"\w* \w e morrerá|strong="H4191"\w*; \w ou|strong="H0176"\w* \w na batalha|strong="H4421"\w* \w descerá|strong="H3381"\w* \w e perecerá|strong="H5595"\w*."\x - \xo 26:10 \xt LUK 18:7; PSA 37:13; 1SA 24:4; DEU 31:14; GEN 47:29; PRO 24:16\x*
