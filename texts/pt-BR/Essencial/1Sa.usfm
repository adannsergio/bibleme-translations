\v 41 \w O moço foi|strong="H5288,H0935"\w*, \w e David se levantou|strong="H1732,H6965"\w* \w do lado|strong="H0681"\w* \w do sul|strong="H5045"\w*, \w e caiu|strong="H5307"\w* \w com o rosto|strong="H0639"\w* \w em terra|strong="H0776"\w*, \w e se prostrou|strong="H7812"\w* \w três|strong="H7969"\w* \w vezes|strong="H6471"\w*; \w e beijaram|strong="H5401"\w* \w um|strong="H0376"\w* \w ao outro|strong="H7453"\w*, \w e choraram|strong="H1058"\w* \w um|strong="H0376"\w* \w pelo outro|strong="H7453"\w*, \add até\add* \w que|strong="H5704"\w* \w David|strong="H1732"\w* \add chorou\add* \w muito|strong="H1431"\w*.\x - \xo 20:41 \xt GEN 29:11; 2SA 1:26; 1SA 25:23; 1KI 1:16; 1SA 18:3\x*
