\v 18 \w E ele disse|strong="H0559"\w*: \add "Por\add* \w que|strong="H4100,H2088"\w* \w meu senhor|strong="H0113"\w* \w persegue|strong="H7291"\w* \w após|strong="H0310"\w* \w o seu servo|strong="H5650"\w*? \w Pois|strong="H3588"\w* \add o\add* \w que|strong="H4100"\w* \w fiz|strong="H6213"\w*, \w e o que|strong="H4100"\w* \add há\add* \w na minha mão|strong="H3027"\w* \w de mal|strong="H7451"\w*?"\x - \xo 26:18 \xt 1SA 24:9; ZEC 4:13; 1SA 24:11; DAN 6:22; PSA 119:161; PSA 119:78\x*
\v 19 \w E agora|strong="H6258"\w*, \w ouça|strong="H8085"\w*, \w por favor|strong="H4994"\w*, \w meu senhor|strong="H0113"\w*, \w o rei|strong="H4428"\w*, \w as palavras|strong="H1697"\w* \w do seu servo|strong="H5650"\w*: \w se|strong="H0518"\w* \w o SENHOR|strong="H3068"\w* \add te\add* \w incitou|strong="H5496"\w* \add contra\add* \w mim|strong="H9030"\w*, \w aceite|strong="H7306"\w* \w uma oferta|strong="H4503"\w*; \w e se|strong="H0518"\w* \w foram filhos|strong="H1121"\w* \w dos homens|strong="H0120"\w*, \w sejam malditos|strong="H0779,H1992"\w* \w diante|strong="H6440"\w* \w do SENHOR|strong="H3068"\w*, \w pois|strong="H3588"\w* \add me\add* \w expulsaram|strong="H1644"\w* \w hoje|strong="H3117"\w* \w de ter parte|strong="H5596"\w* \w na herança|strong="H5159"\w* \w do SENHOR|strong="H3068"\w*, \w dizendo|strong="H0559"\w*: "\w Vai|strong="H1980"\w*, \w serve|strong="H5647"\w* \w a deuses|strong="H0430"\w* \w outros|strong="H0312"\w*."\x - \xo 26:19 \xt DEU 4:28; PSA 37:3; 2SA 14:16; 2SA 16:11; 2SA 20:19; PSA 27:12\x*
\v 20 \w E agora|strong="H6258"\w*, \w não|strong="H0408"\w* \w caia|strong="H5307"\w* \w o meu sangue|strong="H1818"\w* \w em terra|strong="H0776"\w*, \w de diante|strong="H5048,H6440"\w* \w do SENHOR|strong="H3068"\w*; \w pois|strong="H3588"\w* \w saiu|strong="H3318"\w* \w o rei|strong="H4428"\w* \w de Israel|strong="H3478"\w* \w para buscar|strong="H1245"\w* \w uma pulga|strong="H6550,H0259"\w*, \w assim como|strong="H0834"\w* \w persegue|strong="H7291"\w* \w a perdiz|strong="H7124"\w* \w nos montes|strong="H2022"\w*.\x - \xo 26:20 \xt 1SA 24:14; 1SA 24:11; JER 16:16; PSA 124:6; PSA 140:2\x*
\v 21 \w E Saul disse|strong="H0559,H7586"\w*: "\w Pequei|strong="H2398"\w*; \w volta|strong="H7725"\w*, \w meu filho|strong="H1121"\w* \w David|strong="H1732"\w*, \w pois|strong="H3588"\w* \w não|strong="H3808"\w* \w te farei mal|strong="H7489,H9031"\w* \w outra vez|strong="H5750"\w*, \w porque|strong="H8478"\w* \w foi|strong="H0834,H3365"\w* \w preciosa a minha vida|strong="H5315"\w* \w aos teus olhos|strong="H5869"\w* \w neste dia|strong="H3117,H2088"\w*. \w Eis|strong="H2009"\w* \add que agi como\add* \w tolo|strong="H5528"\w* \w e errei|strong="H7686"\w* \w muito|strong="H7235,H3966"\w*."\x - \xo 26:21 \xt ROM 12:20; 1SA 24:17; 1SA 15:24; EXO 9:27; PRO 19:19; 1SA 15:30\x*
\v 22 \w E David respondeu|strong="H6030,H1732"\w* \w e disse|strong="H0559"\w*: "\w Eis|strong="H2009"\w* \w a lança|strong="H2595"\w*\f + \fr 26.22: \ft Variante: a Ketiv tem a forma sem artigo (חֲנִית); a Qere, que seguimos, a forma com artigo (הַחֲנִית)\f* \w do rei|strong="H4428"\w*; \w e que passe|strong="H5674"\w* \w um|strong="H0259"\w* \w dos moços|strong="H5288"\w* \w e a tome|strong="H3947"\w*."\x - \xo 26:22 \xt PRO 19:19; PSA 140:2; PSA 62:9\x*
