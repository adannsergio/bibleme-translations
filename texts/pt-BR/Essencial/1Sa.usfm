\v 1 \w E David disse|strong="H0559,H1732"\w* \w a|strong="H0413"\w* \w seu coração|strong="H3820"\w*: "\w Agora|strong="H6258"\w* \add serei\add* \w exterminado|strong="H5595"\w* \w em um só dia|strong="H3117,H0259"\w* \w pela mão|strong="H3027"\w* \w de Saul|strong="H7586"\w*; \w não|strong="H0369"\w* \add há\add* \w nada|strong="H9030"\w* \w melhor|strong="H2896"\w* \add para mim,\add* \w pois|strong="H3588"\w* \w escapar|strong="H4422"\w* \w a|strong="H0413"\w* \w a terra|strong="H0776"\w* \w dos filisteus|strong="H6430"\w* \w e desistirá|strong="H2976"\w* \add de\add* \w mim|strong="H4480"\w* \w Saul|strong="H7586"\w* \w de me buscar|strong="H1245"\w* \w mais|strong="H5750"\w* \w em todo|strong="H3605"\w* \w o território|strong="H1366"\w* \w de Israel|strong="H3478"\w*; \w e assim serei livre|strong="H4422"\w* \w da sua mão|strong="H3027"\w*."\x - \xo 27:1 \xt PSA 34:4; PRO 24:10; PRO 29:25; PSA 56:8; 2CO 1:8; ISA 40:27-31\x*
