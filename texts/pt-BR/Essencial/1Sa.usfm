\c 20
\p
\v 1 \w E David fugiu|strong="H1272,H1732"\w* \w de Naiote|strong="H5121"\w*, \w em Ramá|strong="H7414"\w*, \w e foi|strong="H0935"\w* \w e disse|strong="H0559"\w* \w diante de Jônatas|strong="H6440,H3083"\w*: "\w Que|strong="H4100"\w* \add fiz\add* \w eu|strong="H6213"\w*? \w Qual é|strong="H4100"\w* \w a minha iniquidade|strong="H5771"\w*, \w e qual é|strong="H4100"\w* \w o meu pecado|strong="H2403"\w* \w diante de|strong="H6440"\w* \w teu pai|strong="H0001"\w*, \w que|strong="H3588"\w* \add está\add* \w buscando|strong="H1245"\w* \w a minha vida|strong="H5315"\w*?"\x - \xo 20:1 \xt 1SA 19:19; 1SA 19:18; 1SA 19:23; 2PE 2:9; 1JN 3:21; 2CO 1:12\x*
\v 2 \w E ele lhe disse|strong="H0559,H9033"\w*: "\w De modo nenhum|strong="H2486"\w*! \w Não|strong="H3808"\w* \w morrerás|strong="H4191"\w*. \w Eis|strong="H2009"\w* \add que\add* \w não|strong="H3808"\w*\f + \fr 20.2: \ft Variante: a Ketiv tem "a ele, fez" (לוֹ עָשָׂה); a Qere, que seguimos, "não fará" (לֹא יַעֲשֶׂה)\f* \w fará|strong="H6213"\w* \w meu pai|strong="H0001"\w* \w nenhuma coisa|strong="H1697"\w* \w grande|strong="H1419"\w* \w ou|strong="H0176"\w* \w coisa|strong="H1697"\w* \w pequena|strong="H6996"\w*, \w e não|strong="H3808"\w* \w revelará|strong="H1540"\w* \w ao meu ouvido|strong="H0241"\w*; \w e por que|strong="H4069"\w* \w ocultaria|strong="H5641"\w* \w meu pai|strong="H0001"\w* \add de\add* \w mim|strong="H4480"\w* \w este assunto|strong="H1697,H2088"\w*? \w Não|strong="H0369"\w* \w é assim|strong="H2063"\w*."\x - \xo 20:2 \xt 1SA 22:15; 1SA 9:15; JHN 17:8; GEN 44:7; 1SA 14:45; 1SA 20:12\x*
\v 3 \w E David jurou|strong="H7650,H5750,H1732"\w* \w ainda, e disse|strong="H0559"\w*: "\w Teu pai|strong="H0001"\w* \add sabe muito\add* \w bem|strong="H3045"\w* \w que|strong="H3588"\w* \w achei|strong="H4672"\w* \w favor|strong="H2580"\w* \w aos teus olhos|strong="H5869"\w*; \w e ele disse|strong="H0559"\w*: '\w Não|strong="H0408"\w* \w saiba|strong="H3045"\w* \w disto|strong="H2063"\w* \w Jônatas|strong="H3083"\w*, \w para que não|strong="H6435"\w* \add se\add* \w entristeça|strong="H6087"\w*.' \w Mas|strong="H0199"\w*, \w pela vida|strong="H2416"\w* \w do SENHOR|strong="H3068"\w* \w e pela vida|strong="H2416"\w* \w da tua alma|strong="H5315"\w*, \w pois|strong="H3588"\w* \w há apenas um passo|strong="H6587"\w* \add entre\add* \w mim|strong="H0996"\w* \w e entre|strong="H0996"\w* \w a morte|strong="H4194"\w*."\x - \xo 20:3 \xt 1SA 2:6; 1SA 25:26; 1SA 27:1; 2CO 1:8; 2KI 2:6; DEU 6:13\x*
\p
\v 4 \w E Jônatas disse|strong="H0559,H3083"\w* \w a|strong="H0413"\w* \w David|strong="H1732"\w*: "\w O que quer|strong="H4100"\w* \w que deseje|strong="H0559"\w* \w a tua alma|strong="H5315"\w*, \w eu farei|strong="H6213"\w* \w por você|strong="H9032"\w*."\x - \xo 20:4 \xt 1SA 20:32; JDG 18:24; 1SA 18:3\x*
\v 5 \w E David disse|strong="H0559,H1732"\w* \w a|strong="H0413"\w* \w Jônatas|strong="H3083"\w*: "\w Eis|strong="H2009"\w* \add que\add* \w amanhã será lua nova|strong="H2320,H4279"\w*, \w e eu|strong="H0595"\w* \add deveria\add* \w sentar-me|strong="H3427"\w* \w com|strong="H5973"\w* \w o rei|strong="H4428"\w* \w para comer|strong="H0398"\w*; \w mas deixa-me ir|strong="H7971"\w*, \w e eu me esconderei|strong="H5641"\w* \w no campo|strong="H7704"\w* \w até|strong="H5704"\w* \w a tarde|strong="H6153"\w* \w do terceiro dia|strong="H7992"\w*."\x - \xo 20:5 \xt 1SA 20:18; 1SA 20:24; NUM 10:10; 1SA 19:2; NUM 28:11; COL 2:16\x*
\v 6 \w Se|strong="H0518"\w* \w notar a minha ausência|strong="H6485"\w* \w teu pai|strong="H0001"\w*, \w dirás|strong="H0559"\w*: \add 'Pediu-me\add* \w insistentemente|strong="H7592"\w* \w David|strong="H1732"\w* \w para correr|strong="H7323"\w* \w a Belém|strong="H1035"\w*, \w sua cidade|strong="H5892"\w*, \w pois|strong="H3588"\w* \add há\add* \w um sacrifício|strong="H2077"\w* \w anual|strong="H3117"\w* \w ali|strong="H8033"\w* \w para todo|strong="H3605"\w* \w o clã|strong="H4940"\w*.'\x - \xo 20:6 \xt 1SA 20:28; 1SA 17:58; 1SA 9:12; LUK 2:4\x*
