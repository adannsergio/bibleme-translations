\v 20 \w E Eli bendisse|strong="H1288,H5941"\w* \w Elcana|strong="H0511"\w* \w e|strong="H0853"\w* \w a sua mulher|strong="H0802"\w*, \w e disse|strong="H0559"\w*: "\w Que o SENHOR|strong="H3068"\w* \w lhe|strong="H9031"\w* \w dê|strong="H7760"\w* \w descendência|strong="H2233"\w* \w por meio desta|strong="H4480,H0802,H2063"\w* \w mulher|strong="H0802"\w*, \w em lugar|strong="H8478"\w* \w da petição|strong="H7596"\w* \w que|strong="H0834"\w* \w ele|strong="H7592"\w* \w fez|strong="H7592"\w* \w ao SENHOR|strong="H3068"\w*."\w E voltaram|strong="H1980"\w* \w para o seu lugar|strong="H4725"\w*.\x - \xo 2:20 \xt 1SA 1:27; 1SA 1:17; PSA 127:3; RUT 4:12; LUK 2:34\x*
